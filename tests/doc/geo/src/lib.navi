//! Geometry for the examples: points, [`Shape`]s and their areas.
//!
//! # Examples
//!
//! ```
//! use geo::{Area, Shape};
//! let s = Shape::Circle { r: 1.0 };
//! assert(s.area() > 3.0);
//! ```

pub mod util;

/// A point in the plane.
///
/// Made by [`Point::new`]; see also [`origin`].
#[derive(Debug, Clone, PartialEq)]
pub struct Point {
    /// The horizontal coordinate.
    pub x: f64,
    pub y: f64,
    tag: u32,
}

impl Point {
    /// A point at (x, y).
    ///
    /// ```
    /// # use geo::Point;
    /// let p = Point::new(1.0, 2.0);
    /// assert_eq(p.x, 1.0);
    /// let s = "a
    /// b";
    /// assert_eq(s.len(), 3);
    /// ```
    ///
    /// ```should_panic
    /// let p = geo::Point::new(1.0, 2.0);
    /// assert_eq(p.y, 3.0);
    /// ```
    ///
    /// ```compile_fail
    /// let p = geo::Point::new(1.0);
    /// ```
    ///
    /// ```no_run
    /// loop {}
    /// ```
    ///
    /// ```
    /// use geo::{origin, Point};
    /// fn twice(p: &Point) -> f64 { p.x * 2.0 }
    /// fn main() {
    ///     assert_eq(twice(&origin()), 0.0);
    /// }
    /// ```
    pub fn new(x: f64, y: f64) -> Point { Point { x, y, tag: 0 } }

    /// The distance to `other`.
    pub fn dist(&self, other: &Point) -> f64 { ((self.x - other.x) * (self.x - other.x) + (self.y - other.y) * (self.y - other.y)).sqrt() }

    fn hidden(&self) {}
}

/// Shapes.
pub enum Shape {
    /// A circle of radius `r`.
    Circle { r: f64 },
    Rect(f64, f64),
    Empty,
}

/// Something with an area.
pub trait Area {
    /// The area.
    fn area(&self) -> f64;
    /// Twice [`Area::area`].
    fn double(&self) -> f64 { self.area() * 2.0 }
}

impl Area for Shape {
    fn area(&self) -> f64 {
        match self { Shape::Circle { r } => 3.14159 * r * r, Shape::Rect(w, h) => w * h, Shape::Empty => 0.0 }
    }
}

impl std::fmt::Display for Point {
    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result { f.write_fmt(`(${self.x}, ${self.y})`) }
}

/// The origin.
pub fn origin() -> Point { Point::new(0.0, 0.0) }

/// The largest of `xs` by `key` (a [link](https://example.com) and a [`Vec`]).
pub fn max_by<T: Clone, K: PartialOrd>(xs: &[T], key: fn(&T) -> K) -> Option<T> where T: std::fmt::Debug { None }

pub const MAX: usize = 1024;
pub type Points = Vec<Point>;
pub use util::helper as help;
pub use std::collections::HashMap;
