// Option and Result from std: collecting into them, as_deref, transpose,
// take_if, unzip, or, map_or_else, inspect_err, iteration, copied, flatten,
// get_or_insert_default.
fn parse_all(v: &[&str]) -> Result<Vec<i32>, std::str::ParseIntError> { v.iter().map(|s| s.parse::<i32>()).collect() }

#[test]
fn collect_into_result_and_option() {
    let ok = parse_all(&["1", "2", "3"]);
    let bad = parse_all(&["1", "x", "3"]);
    assert_eq(`${ok:?}`.to_string().as_str(), "Ok([1, 2, 3])");
    assert(bad.is_err());
    let o: Option<Vec<i32>> = [Some(1), Some(2)].iter().cloned().collect();
    let n: Option<Vec<i32>> = [Some(1), None].iter().cloned().collect();
    assert_eq(o, Some(Vec::from([1, 2])));
    assert_eq(n, None);
}

#[test]
fn as_deref_and_transpose() {
    let s: Option<String> = Some("hey".to_string());
    let d: Option<&str> = s.as_deref();
    assert_eq(d, Some("hey"));
    let t: Option<Result<i32, String>> = Some(Ok(3));
    assert_eq(t.transpose(), Ok(Some(3)));
    let r: Result<Option<i32>, String> = Ok(None);
    assert_eq(r.transpose(), None);
}

#[test]
fn take_if_and_unzip() {
    let mut m = Some(4);
    assert_eq(m.take_if(|x| *x > 10), None);
    assert_eq(m, Some(4));
    assert_eq(m.take_if(|x| *x == 4), Some(4));
    assert_eq(m, None);
    let z = Some((1, "a")).unzip();
    assert_eq(z, (Some(1), Some("a")));
}

#[test]
fn result_combinators_and_iteration() {
    let e: Result<i32, String> = Err("bad".to_string());
    assert_eq(e.clone().or(Ok::<i32, i32>(5)), Ok(5));
    assert_eq(e.clone().map_or_else(|x| x.len() as i32, |v| v), 3);
    let mut saw = String::new();
    let e2 = e.inspect_err(|x| { saw = `saw ${x}`.to_string(); });
    assert_eq(saw.as_str(), "saw bad");
    let mut total = 0;
    for x in Ok::<i32, String>(7) { total += x; }
    for x in &Some(8) { total += *x; }
    assert_eq(total, 15);
    assert(e2.is_err());
    let rr: Result<&i32, String> = Ok(&9);
    assert_eq(rr.copied(), Ok(9));
    assert_eq(Ok::<Result<i32, String>, String>(Ok(1)).flatten(), Ok(1));
    let mut q: Option<i32> = None;
    *q.get_or_insert_default() += 3;
    assert_eq(q, Some(3));
}
