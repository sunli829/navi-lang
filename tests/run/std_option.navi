// stage0: skip (Option and Result methods added for navic: std hides them from stage0)
// out: Ok([1, 2, 3]) true
// out: Some([1, 2]) None
// out: Some("hey")
// out: Ok(Some(3))
// out: None
// out: None Some(4) Some(4) None
// out: (Some(1), Some("a"))
// out: Ok(5) 3
// out: saw bad
// out: 15 true
// out: Ok(9) Ok(1)
// out: Some(3)
fn parse_all(v: &[&str]) -> Result<Vec<i32>, std::str::ParseIntError> { v.iter().map(|s| s.parse::<i32>()).collect() }
fn main() {
    let ok = parse_all(&["1", "2", "3"]);
    let bad = parse_all(&["1", "x", "3"]);
    println(`${ok:?} ${bad.is_err()}`);
    let o: Option<Vec<i32>> = [Some(1), Some(2)].iter().cloned().collect();
    let n: Option<Vec<i32>> = [Some(1), None].iter().cloned().collect();
    println(`${o:?} ${n:?}`);
    let s: Option<String> = Some("hey".to_string());
    let d: Option<&str> = s.as_deref();
    println(`${d:?}`);
    let t: Option<Result<i32, String>> = Some(Ok(3));
    println(`${t.transpose():?}`);
    let r: Result<Option<i32>, String> = Ok(None);
    println(`${r.transpose():?}`);
    let mut m = Some(4);
    println(`${m.take_if(|x| *x > 10):?} ${m:?} ${m.take_if(|x| *x == 4):?} ${m:?}`);
    let z = Some((1, "a")).unzip();
    println(`${z:?}`);
    let e: Result<i32, String> = Err("bad".to_string());
    println(`${e.clone().or(Ok::<i32, i32>(5)):?} ${e.clone().map_or_else(|x| x.len() as i32, |v| v)}`);
    let e2 = e.inspect_err(|x| println(`saw ${x}`));
    let mut total = 0;
    for x in Ok::<i32, String>(7) { total += x; }
    for x in &Some(8) { total += *x; }
    println(`${total} ${e2.is_err()}`);
    let rr: Result<&i32, String> = Ok(&9);
    println(`${rr.copied():?} ${Ok::<Result<i32, String>, String>(Ok(1)).flatten():?}`);
    let mut q: Option<i32> = None;
    *q.get_or_insert_default() += 3;
    println(`${q:?}`);
}
