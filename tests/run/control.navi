// out: 0 1 2 found 3
// out: 42
// out: outer 1
// out: even odd even
// out: Ok(5) Err("bad")
// out: end of f
// out: deferred 2
// out: deferred 1
fn parse(s: &str) -> Result<i32, String> {
    let n: i32 = match s.parse() { Ok(n) => n, Err(_) => return Err(String::from("bad")) };
    Ok(n)
}

fn twice(s: &str) -> Result<i32, String> {
    let n = parse(s)?;
    Ok(n)
}

fn f() {
    defer println("deferred 1");
    defer println("deferred 2");
    println("end of f");
}

fn main() {
    let mut out = String::new();
    for i in 0..10 {
        if i == 3 { out.push_str("found 3"); break; }
        out.push_str(&`${i} `);
    }
    println(out);
    let v = loop { break 42; };
    println(v);
    let mut n = 0;
    'outer: for i in 0..5 {
        for j in 0..5 {
            if i * j == 2 { n = i; break 'outer; }
        }
    }
    println(`outer ${n}`);
    let words: Vec<&str> = (0..3).map(|i| if i % 2 == 0 { "even" } else { "odd" }).collect();
    println(`${words[0]} ${words[1]} ${words[2]}`);
    println(`${twice("5"):?} ${twice("x"):?}`);
    f();
}
