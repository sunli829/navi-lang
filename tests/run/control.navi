// Control flow: break out of for, break with a value from loop, labeled
// break, if as an expression, ? on Result, defer (run in reverse order
// when the function returns).
fn parse(s: &str) -> Result<i32, String> {
    let n: i32 = match s.parse() { Ok(n) => n, Err(_) => return Err(String::from("bad")) };
    Ok(n)
}

fn twice(s: &str) -> Result<i32, String> {
    let n = parse(s)?;
    Ok(n)
}

fn f(log: &mut Vec<String>) {
    defer log.push(String::from("deferred 1"));
    defer log.push(String::from("deferred 2"));
    log.push(String::from("end of f"));
}

#[test]
fn break_out_of_for() {
    let mut out = String::new();
    for i in 0..10 {
        if i == 3 { out.push_str("found 3"); break; }
        out.push_str(&`${i} `.to_string());
    }
    assert_eq(out, String::from("0 1 2 found 3"));
}

#[test]
fn break_with_value() {
    let v = loop { break 42; };
    assert_eq(v, 42);
}

#[test]
fn labeled_break() {
    let mut n = 0;
    'outer: for i in 0..5 {
        for j in 0..5 {
            if i * j == 2 { n = i; break 'outer; }
        }
    }
    assert_eq(n, 1);
}

#[test]
fn if_expression_in_closure() {
    let words: Vec<&str> = (0..3).map(|i| if i % 2 == 0 { "even" } else { "odd" }).collect();
    assert_eq(words, Vec::from(["even", "odd", "even"]));
}

#[test]
fn question_mark() {
    assert_eq(twice("5"), Ok(5));
    assert_eq(twice("x"), Err(String::from("bad")));
    assert_eq(`${twice("5"):?} ${twice("x"):?}`.to_string().as_str(), "Ok(5) Err(\"bad\")");
}

#[test]
fn defer_runs_in_reverse_at_return() {
    let mut log = Vec::new();
    f(&mut log);
    assert_eq(log, Vec::from([String::from("end of f"), String::from("deferred 2"), String::from("deferred 1")]));
}
