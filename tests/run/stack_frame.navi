// stage0: skip (spawned stacks grow only in navic builds)
// out: 1000 1000 500500
// out: 1001 1001 501501
// Frames a little larger than 4 KiB (the stack check subtracts the frame
// size in two immediates) recursing on a fresh 64 KiB stack: each call must
// grow the stack, not run past its end.
use std::thread;

fn mid_frame(d: u64) -> u64 {
    let mut buf = [0u64; 600];
    buf[0] = d;
    buf[599] = d;
    if d == 0 { return 0; }
    mid_frame(d - 1) + buf[0] + buf[599] - d
}

fn main() {
    let mut hs = Vec::new();
    let mut k = 0u64;
    while k < 2 {
        let n = 1000 + k;
        hs.push(thread::spawn(|| (n, mid_frame(n))));
        k += 1;
    }
    for h in hs.iter() {
        let (n, r) = h.join().unwrap();
        println(`${n} ${n} ${r}`);
    }
}
