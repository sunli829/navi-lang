// Iterator adapters and consumers over a Vec and a string's chars.
#[test]
fn iterate_and_fold() {
    let v: Vec<i32> = (1..=5).collect();
    let mut s = String::new();
    for x in v.iter() { s.push_str(&`${x} `); }
    assert_eq(s.trim(), "1 2 3 4 5");
    let sum = v.iter().fold(0, |a, b| a + *b);
    let prod = v.iter().fold(1, |a, b| a * *b);
    assert_eq((sum, prod), (15, 120));
}

#[test]
fn filter_map_find() {
    let v: Vec<i32> = (1..=5).collect();
    let evens: Vec<i32> = v.iter().filter(|x| **x % 2 == 0).map(|x| *x).collect();
    assert_eq(evens, Vec::from([2, 4]));
    assert_eq(v.iter().find(|x| **x > 3).map(|x| *x), Some(4));
    assert_eq(v.iter().find(|x| **x > 9).map(|x| *x), None);
    assert_eq(`${v.iter().find(|x| **x > 3):?} ${v.iter().find(|x| **x > 9):?}`.as_str(), "Some(4) None");
}

#[test]
fn enumerate_chars() {
    let mut out = String::new();
    for (i, c) in "abc".chars().enumerate() { out.push_str(&`${(i, c):?} `); }
    assert_eq(out.trim(), "(0, 'a') (1, 'b') (2, 'c')");
    let pairs: Vec<(usize, char)> = "abc".chars().enumerate().collect();
    assert_eq(pairs, Vec::from([(0usize, 'a'), (1, 'b'), (2, 'c')]));
}

#[test]
fn take_skip_any_all() {
    let v: Vec<i32> = (1..=5).collect();
    let rest: Vec<i32> = v.iter().skip(3).map(|x| *x).collect();
    assert_eq(v.iter().take(3).count(), 3);
    assert_eq(rest, Vec::from([4, 5]));
    assert(v.iter().any(|x| *x == 3));
    assert(!v.iter().all(|x| *x < 3));
}

#[test]
fn peekable() {
    let v: Vec<i32> = (1..=5).collect();
    let mut p = v.iter().peekable();
    let a = p.peek().map(|x| **x);
    let b = p.next().map(|x| *x);
    let c = p.peek().map(|x| **x);
    assert_eq((a, b, c), (Some(1), Some(1), Some(2)));
}
