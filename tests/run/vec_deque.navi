// stage0: skip
// out: empty 0 true None None None None
// out: [0, 1, 2, 3] 4 Some(0) Some(3)
// out: [-3, -2, -1, 0, 1, 2, 3, 4, 5]
// out: wrap [5, 7, 8, 9, 10] cap 8 slices 2+3
// out: get Some(70) None 9 [5, 7, 70, 9, 10]
// out: front Some(50) back Some(100)
// out: iter 50,7,70,9,100 rev 100,9,70,7,50
// out: mut [51, 8, 71, 10, 101]
// out: contains true false
// out: insert [0, 51, 8, 71, 99, 10, 101, -1] remove Some(99) Some(0) None
// out: [51, 8, 71, 10, 101, -1]
// out: rotl [10, 101, -1, 51, 8, 71] rotr [101, -1, 51, 8, 71, 10]
// out: rot0 [101, -1, 51, 8, 71, 10]
// out: contiguous [101, -1, 51, 8, 71, 10] slices 6+0
// out: retain [101, 51, 71, 10] truncate [101, 51]
// out: swap [51, 101]
// out: collect [1, 2, 3] eq true false clone [1, 2, 3, 4] [1, 2, 3]
// out: shared [1, 2, 3, 4]
// out: into_iter 1 2 3 4 back 4 3 2 1
// out: extend [1, 2, 3, 4, 5, 6]
// out: vec [1, 2, 3, 4, 5, 6] from [7, 8]
// out: default [] true
// out: queue 100000 4999950000
// out: random ok
// out: split [0, 1] [2, 3, 4] append [0, 1, 2, 3, 4] []
use std::collections::VecDeque;

fn main() {
    let mut e: VecDeque<i32> = VecDeque::new();
    println(`empty ${e.len()} ${e.is_empty()} ${e.pop_front():?} ${e.pop_back():?} ${e.front():?} ${e.back():?}`);

    let mut d: VecDeque<i32> = VecDeque::new();
    for i in 0..4 { d.push_back(i); }
    println(`${d:?} ${d.len()} ${d.front():?} ${d.back():?}`);
    for i in 1..4 { d.push_front(-i); }
    d.push_back(4);
    d.push_back(5);
    println(`${d:?}`);

    // Wraparound: pop from the front and push at the back of a small ring.
    let mut w: VecDeque<i32> = VecDeque::with_capacity(8);
    for i in 0..8 { w.push_back(i); }
    for _ in 0..5 { w.pop_front(); }
    for i in 8..11 { w.push_back(i); }
    w.pop_front();
    w.pop_front();
    w.push_front(5);
    w.push_front(4);
    w.pop_front();
    let (a, b) = w.as_slices();
    println(`wrap ${w:?} cap ${w.capacity()} slices ${a.len()}+${b.len()}`);
    w[2] = 70;
    println(`get ${w.get(2):?} ${w.get(6):?} ${w[3]} ${w:?}`);
    *w.front_mut().unwrap() = 50;
    *w.back_mut().unwrap() = 100;
    println(`front ${w.front():?} back ${w.back():?}`);
    let fw: Vec<String> = w.iter().map(|x| x.to_string()).collect();
    let bw: Vec<String> = w.iter().rev().map(|x| x.to_string()).collect();
    println(`iter ${fw.join(",")} rev ${bw.join(",")}`);
    for x in w.iter_mut() { *x += 1; }
    println(`mut ${w:?}`);
    println(`contains ${w.contains(&71)} ${w.contains(&70)}`);

    w.insert(0, 0);
    w.insert(4, 99);
    let n = w.len();
    w.insert(n, -1);
    print(`insert ${w:?}`);
    let r1 = w.remove(4);
    let r2 = w.remove(0);
    let r3 = w.remove(100);
    println(` remove ${r1:?} ${r2:?} ${r3:?}`);
    println(`${w:?}`);
    w.rotate_left(3);
    print(`rotl ${w:?}`);
    w.rotate_right(5);
    println(` rotr ${w:?}`);
    w.rotate_left(0);
    w.rotate_right(6);
    println(`rot0 ${w:?}`);
    let s = w.make_contiguous();
    let sl = s.to_vec();
    let (a2, b2) = w.as_slices();
    println(`contiguous ${sl:?} slices ${a2.len()}+${b2.len()}`);
    w.retain(|x| *x >= 10);
    print(`retain ${w:?}`);
    w.truncate(2);
    println(` truncate ${w:?}`);
    w.swap(0, 1);
    println(`swap ${w:?}`);

    let c: VecDeque<i32> = vec_of(3).into_iter().collect();
    let mut c2 = c.clone();
    c2.push_back(4);
    println(`collect ${c:?} eq ${c == vec_of(3).into_iter().collect()} ${c == c2} clone ${c2:?} ${c:?}`);
    let mut sh = c;
    sh.push_back(4);
    println(`shared ${c:?}`);
    let mut line = String::from("into_iter");
    for x in c2.clone() { line.push_str(&` ${x}`); }
    line.push_str(" back");
    let mut it = c2.into_iter();
    while let Some(x) = it.next_back() { line.push_str(&` ${x}`); }
    println(line);
    let mut ex = c.clone();
    ex.extend(vec_of(6).into_iter().skip(4));
    println(`extend ${ex:?}`);
    let v: Vec<i32> = Vec::from(ex);
    let fv = VecDeque::from(vec_of(8).split_off(6));
    println(`vec ${v:?} from ${fv:?}`);
    let df: VecDeque<String> = VecDeque::default();
    println(`default ${df:?} ${df.is_empty()}`);

    // A long-running queue through a ring that wraps many times.
    let mut q: VecDeque<u64> = VecDeque::new();
    let mut sum: u64 = 0;
    let mut i: u64 = 0;
    while i < 100000 {
        q.push_back(i);
        q.push_back(i + 1);
        if let Some(x) = q.pop_front() { sum += x; }
        i += 2;
    }
    let n = q.len();
    while let Some(x) = q.pop_front() { sum += x; }
    println(`queue ${n * 2} ${sum}`);

    // Random operations checked against a Vec.
    let mut d: VecDeque<i64> = VecDeque::new();
    let mut m: Vec<i64> = Vec::new();
    let mut seed: u64 = 12345;
    let mut k = 0;
    while k < 20000 {
        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
        let r = (seed >> 33) as usize;
        let op = r % 9;
        let val = (r / 9 % 1000) as i64;
        if op == 0 || op == 1 { d.push_back(val); m.push(val); }
        else if op == 2 || op == 3 { d.push_front(val); m.insert(0, val); }
        else if op == 4 { let a = d.pop_back(); let b = m.pop(); assert_eq(a, b); }
        else if op == 5 { let a = d.pop_front(); let b = if m.is_empty() { None } else { Some(m.remove(0)) }; assert_eq(a, b); }
        else if op == 6 { let i = (r / 9000) % (m.len() + 1); d.insert(i, val); m.insert(i, val); }
        else if op == 7 && !m.is_empty() { let i = (r / 9000) % m.len(); assert_eq(d.remove(i), Some(m.remove(i))); }
        else if op == 8 && !m.is_empty() { let i = (r / 9000) % m.len(); d.rotate_left(i); m.rotate_left(i); }
        assert_eq(d.len(), m.len());
        if k % 97 == 0 {
            let got: Vec<i64> = d.iter().map(|x| *x).collect();
            assert(got == m);
        }
        if k % 101 == 0 {
            let got = d.make_contiguous().to_vec();
            assert(got == m);
            let (a, b) = d.as_slices();
            assert_eq(a.len(), m.len());
            assert_eq(b.len(), 0);
        }
        k += 1;
    }
    let got: Vec<i64> = d.into_iter().collect();
    assert(got == m);
    println("random ok");

    let mut s = vec_of(5).into_iter().map(|x| x - 1).collect::<VecDeque<i32>>();
    let mut t = s.split_off(2);
    print(`split ${s:?} ${t:?}`);
    s.append(&mut t);
    println(` append ${s:?} ${t:?}`);
}

fn vec_of(n: i32) -> Vec<i32> {
    let mut v = Vec::new();
    for i in 1..n + 1 { v.push(i); }
    v
}
