// std::collections::VecDeque: push/pop at both ends, wraparound, indexing,
// iteration, insert/remove, rotation, make_contiguous, retain, conversions,
// a long-running queue, and random operations checked against a Vec.
use std::collections::VecDeque;

fn vec_of(n: i32) -> Vec<i32> {
    let mut v = Vec::new();
    for i in 1..n + 1 { v.push(i); }
    v
}

#[test]
fn empty() {
    let mut e: VecDeque<i32> = VecDeque::new();
    assert_eq(e.len(), 0);
    assert(e.is_empty());
    assert_eq(e.pop_front(), None);
    assert_eq(e.pop_back(), None);
    assert_eq(e.front(), None);
    assert_eq(e.back(), None);
}

#[test]
fn push_both_ends() {
    let mut d: VecDeque<i32> = VecDeque::new();
    for i in 0..4 { d.push_back(i); }
    assert_eq(`${d:?}`.as_str(), "[0, 1, 2, 3]");
    assert_eq(d.len(), 4);
    assert_eq(d.front(), Some(&0));
    assert_eq(d.back(), Some(&3));
    for i in 1..4 { d.push_front(-i); }
    d.push_back(4);
    d.push_back(5);
    assert_eq(`${d:?}`.as_str(), "[-3, -2, -1, 0, 1, 2, 3, 4, 5]");
}

#[test]
fn ring_operations() {
    // Wraparound: pop from the front and push at the back of a small ring.
    let mut w: VecDeque<i32> = VecDeque::with_capacity(8);
    for i in 0..8 { w.push_back(i); }
    for _ in 0..5 { w.pop_front(); }
    for i in 8..11 { w.push_back(i); }
    w.pop_front();
    w.pop_front();
    w.push_front(5);
    w.push_front(4);
    w.pop_front();
    let (a, b) = w.as_slices();
    assert_eq(`${w:?}`.as_str(), "[5, 7, 8, 9, 10]");
    assert_eq(w.capacity(), 8);
    assert_eq((a.len(), b.len()), (2, 3));
    w[2] = 70;
    assert_eq(w.get(2), Some(&70));
    assert_eq(w.get(6), None);
    assert_eq(w[3], 9);
    assert_eq(`${w:?}`.as_str(), "[5, 7, 70, 9, 10]");
    *w.front_mut().unwrap() = 50;
    *w.back_mut().unwrap() = 100;
    assert_eq(w.front(), Some(&50));
    assert_eq(w.back(), Some(&100));
    let fw: Vec<String> = w.iter().map(|x| x.to_string()).collect();
    let bw: Vec<String> = w.iter().rev().map(|x| x.to_string()).collect();
    assert_eq(fw.join(",").as_str(), "50,7,70,9,100");
    assert_eq(bw.join(",").as_str(), "100,9,70,7,50");
    for x in w.iter_mut() { *x += 1; }
    assert_eq(`${w:?}`.as_str(), "[51, 8, 71, 10, 101]");
    assert(w.contains(&71));
    assert(!w.contains(&70));

    w.insert(0, 0);
    w.insert(4, 99);
    let n = w.len();
    w.insert(n, -1);
    assert_eq(`${w:?}`.as_str(), "[0, 51, 8, 71, 99, 10, 101, -1]");
    assert_eq(w.remove(4), Some(99));
    assert_eq(w.remove(0), Some(0));
    assert_eq(w.remove(100), None);
    assert_eq(`${w:?}`.as_str(), "[51, 8, 71, 10, 101, -1]");
    w.rotate_left(3);
    assert_eq(`${w:?}`.as_str(), "[10, 101, -1, 51, 8, 71]");
    w.rotate_right(5);
    assert_eq(`${w:?}`.as_str(), "[101, -1, 51, 8, 71, 10]");
    w.rotate_left(0);
    w.rotate_right(6);
    assert_eq(`${w:?}`.as_str(), "[101, -1, 51, 8, 71, 10]");
    let s = w.make_contiguous();
    let sl = s.to_vec();
    let (a2, b2) = w.as_slices();
    assert_eq(sl, Vec::from([101, -1, 51, 8, 71, 10]));
    assert_eq((a2.len(), b2.len()), (6, 0));
    w.retain(|x| *x >= 10);
    assert_eq(`${w:?}`.as_str(), "[101, 51, 71, 10]");
    w.truncate(2);
    assert_eq(`${w:?}`.as_str(), "[101, 51]");
    w.swap(0, 1);
    assert_eq(`${w:?}`.as_str(), "[51, 101]");
}

#[test]
fn collect_clone_iterate_convert() {
    let c: VecDeque<i32> = vec_of(3).into_iter().collect();
    let mut c2 = c.clone();
    c2.push_back(4);
    assert_eq(`${c:?}`.as_str(), "[1, 2, 3]");
    assert(c == vec_of(3).into_iter().collect());
    assert(!(c == c2));
    assert_eq(`${c2:?}`.as_str(), "[1, 2, 3, 4]");
    // A plain assignment shares the deque; clone copies it.
    let mut sh = c;
    sh.push_back(4);
    assert_eq(`${c:?}`.as_str(), "[1, 2, 3, 4]");
    let mut line = String::from("into_iter");
    for x in c2.clone() { line.push_str(&` ${x}`); }
    line.push_str(" back");
    let mut it = c2.into_iter();
    while let Some(x) = it.next_back() { line.push_str(&` ${x}`); }
    assert_eq(line.as_str(), "into_iter 1 2 3 4 back 4 3 2 1");
    let mut ex = c.clone();
    ex.extend(vec_of(6).into_iter().skip(4));
    assert_eq(`${ex:?}`.as_str(), "[1, 2, 3, 4, 5, 6]");
    let v: Vec<i32> = Vec::from(ex);
    let fv = VecDeque::from(vec_of(8).split_off(6));
    assert_eq(v, Vec::from([1, 2, 3, 4, 5, 6]));
    assert_eq(`${fv:?}`.as_str(), "[7, 8]");
    let df: VecDeque<String> = VecDeque::default();
    assert_eq(`${df:?}`.as_str(), "[]");
    assert(df.is_empty());
}

#[test]
fn long_running_queue() {
    // A long-running queue through a ring that wraps many times.
    let mut q: VecDeque<u64> = VecDeque::new();
    let mut sum: u64 = 0;
    let mut i: u64 = 0;
    while i < 100000 {
        q.push_back(i);
        q.push_back(i + 1);
        if let Some(x) = q.pop_front() { sum += x; }
        i += 2;
    }
    let n = q.len();
    while let Some(x) = q.pop_front() { sum += x; }
    assert_eq(n * 2, 100000);
    assert_eq(sum, 4999950000);
}

#[test]
fn random_operations_match_vec() {
    let mut d: VecDeque<i64> = VecDeque::new();
    let mut m: Vec<i64> = Vec::new();
    let mut seed: u64 = 12345;
    let mut k = 0;
    while k < 20000 {
        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
        let r = (seed >> 33) as usize;
        let op = r % 9;
        let val = (r / 9 % 1000) as i64;
        if op == 0 || op == 1 { d.push_back(val); m.push(val); }
        else if op == 2 || op == 3 { d.push_front(val); m.insert(0, val); }
        else if op == 4 { let a = d.pop_back(); let b = m.pop(); assert_eq(a, b); }
        else if op == 5 { let a = d.pop_front(); let b = if m.is_empty() { None } else { Some(m.remove(0)) }; assert_eq(a, b); }
        else if op == 6 { let i = (r / 9000) % (m.len() + 1); d.insert(i, val); m.insert(i, val); }
        else if op == 7 && !m.is_empty() { let i = (r / 9000) % m.len(); assert_eq(d.remove(i), Some(m.remove(i))); }
        else if op == 8 && !m.is_empty() { let i = (r / 9000) % m.len(); d.rotate_left(i); m.rotate_left(i); }
        assert_eq(d.len(), m.len());
        if k % 97 == 0 {
            let got: Vec<i64> = d.iter().map(|x| *x).collect();
            assert(got == m);
        }
        if k % 101 == 0 {
            let got = d.make_contiguous().to_vec();
            assert(got == m);
            let (a, b) = d.as_slices();
            assert_eq(a.len(), m.len());
            assert_eq(b.len(), 0);
        }
        k += 1;
    }
    let got: Vec<i64> = d.into_iter().collect();
    assert(got == m);
}

#[test]
fn split_off_and_append() {
    let mut s = vec_of(5).into_iter().map(|x| x - 1).collect::<VecDeque<i32>>();
    let mut t = s.split_off(2);
    assert_eq(`${s:?} ${t:?}`.as_str(), "[0, 1] [2, 3, 4]");
    s.append(&mut t);
    assert_eq(`${s:?} ${t:?}`.as_str(), "[0, 1, 2, 3, 4] []");
}
