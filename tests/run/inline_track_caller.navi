// Inlined #[track_caller] functions (Vec indexing, Option::unwrap) report
// their caller's location, as they do when called. Location::caller() on
// the same line gives the line expected.
use std::panic::{Location, catch_unwind};

#[test]
fn vec_index_reports_the_caller() {
    let v: Vec<i32> = Vec::from([1, 2, 3]);
    let i = v.len() + 2;
    let (here, r) = (Location::caller(), catch_unwind(|| v[i]));
    let p = r.unwrap_err();
    assert_eq(
        p.message(),
        "index out of bounds: the len is 3 but the index is 5",
    );
    assert_eq(p.location().file(), here.file());
    assert_eq(p.location().line(), here.line());
}

#[test]
fn unwrap_reports_the_caller() {
    let o: Option<i32> = std::hint::black_box(None);
    let (here, r) = (Location::caller(), catch_unwind(|| o.unwrap()));
    let p = r.unwrap_err();
    assert_eq(p.message(), "called Option::unwrap() on a None value");
    assert_eq(p.location().file(), here.file());
    assert_eq(p.location().line(), here.line());
}

#[track_caller]
fn checked(x: i32) -> i32 {
    if x < 0 {
        panic("negative");
    }
    x
}

#[test]
fn own_track_caller_function() {
    let (here, r) = (Location::caller(), catch_unwind(|| checked(-1)));
    let p = r.unwrap_err();
    assert_eq(p.message(), "negative");
    assert_eq(p.location().line(), here.line());
}

// A small function inlined into its caller (in the same file) reports its
// own line, not its call's.
fn third(v: &Vec<i32>, at: &mut u32) -> i32 {
    *at = Location::caller().line() + 1;
    v[2]
}

fn calls_third(v: &Vec<i32>, at: &mut u32) -> i32 {
    third(v, at) + 1
}

#[test]
fn inlined_function_reports_its_line() {
    let v: Vec<i32> = Vec::from([1]);
    let mut at = 0;
    let r = catch_unwind(|| calls_third(&v, &mut at));
    let p = r.unwrap_err();
    assert(at > 0);
    assert_eq(p.location().line(), at);
}

// One inlined from another file (std's) reports its own file and line.
#[test]
fn inlined_std_function_reports_its_file() {
    let v: Vec<i32> = Vec::from([1, 2, 3]);
    let r = catch_unwind(|| {
        let _ = v.windows(0);
    });
    let p = r.unwrap_err();
    assert_eq(p.message(), "window size must be non-zero");
    assert(p.location().file().ends_with("slice.navi"));
}
