// Inlined #[track_caller] functions (Vec indexing, Option::unwrap) report
// their caller's location, as they do when called.
// out: caught true
// exit: 101
// stderr: inline_track_caller.navi:13:42:
// stderr: index out of bounds: the len is 3 but the index is 5
// stderr: inline_track_caller.navi:16:15:
// stderr: called Option::unwrap() on a None value
fn main() {
    let v: Vec<i32> = Vec::from([1, 2, 3]);
    let i = v.len() + 2;
    // (the index below is at column 42)
    let r = std::panic::catch_unwind(|| v[i]);
    println(`caught ${r.is_err()}`);
    let o: Option<i32> = None;
    let x = o.unwrap();
    println(`${x}`);
}
