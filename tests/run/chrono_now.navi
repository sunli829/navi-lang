// stage0: skip
// std::chrono: the clock and the local zone (properties only: the machine's
// zone is unknown), SystemTime conversions.
// out: now ok true
// out: local ok true
// out: system time ok true
use std::chrono::prelude::*;

fn main() {
    let a = Utc::now();
    let b = Utc::now();
    println(`now ok ${b >= a && a.year() >= 2024}`);
    let l = Local::now();
    let off = l.offset().local_minus_utc();
    let back = l.naive_local() - l.naive_utc();
    println(`local ok ${back.num_seconds() == off as i64 && (l.to_utc() - a).num_seconds().abs() < 60}`);
    let st: std::time::SystemTime = a.into();
    let c: DateTime<Utc> = DateTime::from(st);
    println(`system time ok ${c == a}`);
}
