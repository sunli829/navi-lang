// The atomic types.
use std::sync::atomic::{AtomicBool, AtomicI32, AtomicU64, AtomicIsize, AtomicUsize, AtomicPtr, Ordering};
use std::marker::PhantomData;

#[test]
fn atomic_bool() {
    let b = AtomicBool::new(false);
    assert_eq(b.swap(true, Ordering::SeqCst), false);
    assert_eq(b.load(Ordering::SeqCst), true);
    assert_eq(b.fetch_xor(true, Ordering::SeqCst), true);
    assert_eq(`${b:?}`.as_str(), "false");
}

#[test]
fn atomic_i32() {
    let i = AtomicI32::new(-5);
    assert_eq(i.fetch_add(3, Ordering::SeqCst), -5);
    assert_eq(i.load(Ordering::SeqCst), -2);
    assert_eq(i.fetch_max(10, Ordering::SeqCst), -2);
    assert_eq(i.fetch_min(-100, Ordering::SeqCst), 10);
    assert_eq(`${i:?}`.as_str(), "-100");
    assert_eq(i.compare_exchange(-100, 7, Ordering::SeqCst, Ordering::SeqCst), Ok(-100));
    assert_eq(i.compare_exchange(1, 2, Ordering::SeqCst, Ordering::SeqCst), Err(7));
}

#[test]
fn atomic_u64_wraps() {
    let u = AtomicU64::new(u64::MAX);
    assert_eq(u.fetch_add(1, Ordering::SeqCst), 18446744073709551615u64);
    assert_eq(u.load(Ordering::SeqCst), 0);
}

#[test]
fn atomic_isize_fetch_update() {
    let z = AtomicIsize::new(-1);
    assert_eq(z.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |x| if x < 0 { Some(x * 10) } else { None }), Ok(-1));
    assert_eq(`${z:?}`.as_str(), "-10");
}

#[test]
fn atomic_usize() {
    let n = AtomicUsize::new(6);
    assert_eq(n.fetch_sub(2, Ordering::SeqCst), 6);
    assert_eq(n.fetch_or(1, Ordering::SeqCst), 4);
    assert_eq(`${n:?}`.as_str(), "5");
}

#[test]
fn atomic_ptr() {
    let mut x = 5;
    let p = AtomicPtr::new(&mut x as *mut i32);
    assert_eq(unsafe { *p.load(Ordering::SeqCst) }, 5);
    let _m: PhantomData<String> = PhantomData;
}

#[test]
fn atomic_get_mut_and_into_inner() {
    let mut gi = AtomicI32::new(1);
    *gi.get_mut() = -9;
    assert_eq(gi.load(Ordering::SeqCst), -9);
    assert_eq(gi.into_inner(), -9);
}
