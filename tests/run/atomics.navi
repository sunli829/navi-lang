// stage0: skip
// The atomic types.
// out: false true true false
// out: -5 -2 -2 10 -100
// out: Ok(-100) Err(7)
// out: 18446744073709551615 0
// out: Ok(-1) -10
// out: 6 4 5
// out: 5
// out: -9 -9
use std::sync::atomic::{AtomicBool, AtomicI32, AtomicU64, AtomicIsize, AtomicUsize, AtomicPtr, Ordering};
use std::marker::PhantomData;

fn main() {
    let b = AtomicBool::new(false);
    println(`${b.swap(true, Ordering::SeqCst)} ${b.load(Ordering::SeqCst)} ${b.fetch_xor(true, Ordering::SeqCst)} ${b:?}`);
    let i = AtomicI32::new(-5);
    println(`${i.fetch_add(3, Ordering::SeqCst)} ${i.load(Ordering::SeqCst)} ${i.fetch_max(10, Ordering::SeqCst)} ${i.fetch_min(-100, Ordering::SeqCst)} ${i:?}`);
    println(`${i.compare_exchange(-100, 7, Ordering::SeqCst, Ordering::SeqCst):?} ${i.compare_exchange(1, 2, Ordering::SeqCst, Ordering::SeqCst):?}`);
    let u = AtomicU64::new(u64::MAX);
    println(`${u.fetch_add(1, Ordering::SeqCst)} ${u.load(Ordering::SeqCst)}`);
    let z = AtomicIsize::new(-1);
    println(`${z.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |x| if x < 0 { Some(x * 10) } else { None }):?} ${z:?}`);
    let n = AtomicUsize::new(6);
    println(`${n.fetch_sub(2, Ordering::SeqCst)} ${n.fetch_or(1, Ordering::SeqCst)} ${n:?}`);
    let mut x = 5;
    let p = AtomicPtr::new(&mut x as *mut i32);
    println(`${unsafe { *p.load(Ordering::SeqCst) }}`);
    let _m: PhantomData<String> = PhantomData;
    let mut gi = AtomicI32::new(1);
    *gi.get_mut() = -9;
    println(`${gi.load(Ordering::SeqCst)} ${gi.into_inner()}`);
}
