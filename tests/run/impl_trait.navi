// stage0: skip (stage0 cannot call trait methods on impl Trait values)
// out: 3 [7, 7, 7] 12
// out: 3 15 square t7
// out: 18
// impl Trait results: iterated, from generic functions (the hidden type
// depends on the type arguments), and returned by trait methods (each
// impl decides the type: its own impl Trait or a named type).
fn evens() -> impl Iterator<Item = i32> { 0..3 }

fn repeat<T: Clone>(x: T, n: usize) -> impl Iterator<Item = T> {
    let mut v = Vec::new();
    let mut i = 0;
    while i < n {
        v.push(x.clone());
        i += 1;
    }
    v.into_iter()
}

trait Shape {
    fn parts(&self) -> impl Iterator<Item = i32>;
    fn name(&self) -> impl std::fmt::Display;
}

struct S;
struct T { n: i32 }

impl Shape for S {
    fn parts(&self) -> impl Iterator<Item = i32> { 0..3 }
    fn name(&self) -> impl std::fmt::Display { "square" }
}

impl Shape for T {
    fn parts(&self) -> impl Iterator<Item = i32> {
        let mut v = Vec::new();
        v.push(self.n);
        v.push(self.n * 2);
        v.into_iter()
    }
    fn name(&self) -> String { `t${self.n}` }
}

fn total<X: Shape>(x: &X) -> i32 {
    let mut t = 0;
    for p in x.parts() { t += p; }
    t
}

fn show<X: Shape>(x: &X) -> String { `${x.name()}` }

fn main() {
    let mut a = 0;
    for x in evens() { a += x; }
    let sevens: Vec<i32> = repeat(7, 3).collect();
    let mut b = 0usize;
    for s in repeat("ab", 6) { b += s.len(); }
    println(`${a} ${sevens:?} ${b}`);
    println(`${total(&S)} ${total(&T { n: 5 })} ${show(&S)} ${show(&T { n: 7 })}`);
    let mut c = 0;
    for p in S.parts() { c += p; }
    for p in (T { n: 5 }).parts() { c += p; }
    println(`${c}`);
}
