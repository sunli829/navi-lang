// std::http::hpack: the examples of RFC 7541 Appendix C (checked against
// Go's golang.org/x/net/http2/hpack), round trips, bad blocks.

use std::http::hpack::{Decoder, Encoder, HeaderField};

fn unhex(s: &str) -> Vec<u8> {
    let d: Vec<u8> = s.bytes().filter(|c: &u8| -> bool { *c != b' ' }).collect();
    let mut out: Vec<u8> = Vec::new();
    let mut i = 0;
    while i < d.len() {
        out.push(u8::from_str_radix(std::str::from_utf8(&d[i..i + 2]).unwrap(), 16).unwrap());
        i += 2;
    }
    out
}

fn fields(pairs: &[(&str, &str)]) -> Vec<HeaderField> {
    pairs.iter().map(|p: &(&str, &str)| -> HeaderField { HeaderField::new(p.0, p.1) }).collect()
}

fn decodes(d: &mut Decoder, block: &str, want: &[(&str, &str)]) {
    let got = d.decode_full(unhex(block).as_slice()).unwrap();
    assert_eq(got, fields(want));
}

fn encodes(e: &mut Encoder, want: &str, fs: &[(&str, &str)]) {
    let mut out: Vec<u8> = Vec::new();
    for f in fields(fs).iter() { e.write_field(&mut out, f); }
    assert_eq(out, unhex(want));
}

const REQ1: [(&str, &str); 4] = [(":method", "GET"), (":scheme", "http"), (":path", "/"), (":authority", "www.example.com")];
const REQ2: [(&str, &str); 5] = [(":method", "GET"), (":scheme", "http"), (":path", "/"), (":authority", "www.example.com"), ("cache-control", "no-cache")];
const REQ3: [(&str, &str); 5] = [(":method", "GET"), (":scheme", "https"), (":path", "/index.html"), (":authority", "www.example.com"), ("custom-key", "custom-value")];

const RESP1: [(&str, &str); 4] = [(":status", "302"), ("cache-control", "private"), ("date", "Mon, 21 Oct 2013 20:13:21 GMT"), ("location", "https://www.example.com")];
const RESP2: [(&str, &str); 4] = [(":status", "307"), ("cache-control", "private"), ("date", "Mon, 21 Oct 2013 20:13:21 GMT"), ("location", "https://www.example.com")];
const RESP3: [(&str, &str); 6] = [(":status", "200"), ("cache-control", "private"), ("date", "Mon, 21 Oct 2013 20:13:22 GMT"), ("location", "https://www.example.com"), ("content-encoding", "gzip"), ("set-cookie", "foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1")];

const C3: [&str; 3] = [
    "8286 8441 0f77 7777 2e65 7861 6d70 6c65 2e63 6f6d",
    "8286 84be 5808 6e6f 2d63 6163 6865",
    "8287 85bf 400a 6375 7374 6f6d 2d6b 6579 0c63 7573 746f 6d2d 7661 6c75 65",
];
const C4: [&str; 3] = [
    "8286 8441 8cf1 e3c2 e5f2 3a6b a0ab 90f4 ff",
    "8286 84be 5886 a8eb 1064 9cbf",
    "8287 85bf 4088 25a8 49e9 5ba9 7d7f 8925 a849 e95b b8e8 b4bf",
];
const C5: [&str; 3] = [
    "4803 3330 3258 0770 7269 7661 7465 611d 4d6f 6e2c 2032 3120 4f63 7420 3230 3133 2032 303a 3133 3a32 3120 474d 546e 1768 7474 7073 3a2f 2f77 7777 2e65 7861 6d70 6c65 2e63 6f6d",
    "4803 3330 37c1 c0bf",
    "88c1 611d 4d6f 6e2c 2032 3120 4f63 7420 3230 3133 2032 303a 3133 3a32 3220 474d 54c0 5a04 677a 6970 7738 666f 6f3d 4153 444a 4b48 514b 425a 584f 5157 454f 5049 5541 5851 5745 4f49 553b 206d 6178 2d61 6765 3d33 3630 303b 2076 6572 7369 6f6e 3d31",
];
const C6: [&str; 3] = [
    "4882 6402 5885 aec3 771a 4b61 96d0 7abe 9410 54d4 44a8 2005 9504 0b81 66e0 82a6 2d1b ff6e 919d 29ad 1718 63c7 8f0b 97c8 e9ae 82ae 43d3",
    "4883 640e ffc1 c0bf",
    "88c1 6196 d07a be94 1054 d444 a820 0595 040b 8166 e084 a62d 1bff c05a 839b d9ab 77ad 94e7 821d d7f2 e6c7 b335 dfdf cd5b 3960 d5af 2708 7f36 72c1 ab27 0fb5 291f 9587 3160 65c0 03ed 4ee5 b106 3d50 07",
];

#[test]
fn rfc7541_requests() {
    // C.3 (literals), C.4 (Huffman): a decoder each, its table carried
    // from block to block.
    for blocks in [C3, C4].iter() {
        let mut d = Decoder::new(4096);
        decodes(&mut d, blocks[0], &REQ1);
        decodes(&mut d, blocks[1], &REQ2);
        decodes(&mut d, blocks[2], &REQ3);
    }
    // The encoder writes C.4 (Huffman when shorter).
    let mut e = Encoder::new();
    encodes(&mut e, C4[0], &REQ1);
    encodes(&mut e, C4[1], &REQ2);
    encodes(&mut e, C4[2], &REQ3);
}

#[test]
fn rfc7541_responses() {
    // C.5, C.6: a 256-byte table, so entries are evicted.
    for blocks in [C5, C6].iter() {
        let mut d = Decoder::new(256);
        decodes(&mut d, blocks[0], &RESP1);
        decodes(&mut d, blocks[1], &RESP2);
        decodes(&mut d, blocks[2], &RESP3);
    }
    // The encoder: the size update (to 256) first, then C.6.
    let mut e = Encoder::new();
    e.set_max_dynamic_table_size(256);
    assert_eq(e.max_dynamic_table_size(), 256);
    let mut want = "3fe101".to_string();
    want.push_str(C6[0]);
    encodes(&mut e, want.as_str(), &RESP1);
    encodes(&mut e, C6[1], &RESP2);
    encodes(&mut e, C6[2], &RESP3);
}

#[test]
fn round_trips() {
    let mut e = Encoder::new();
    let mut d = Decoder::new(4096);
    let long = "x".repeat(1337);
    let mut all = String::new();
    for c in 32u8..127u8 { all.push(c as char); }
    let ctl = "\u{1}\u{7f}é中".to_string();
    let fs = [("a", "b"), ("long", long.as_str()), ("all", all.as_str()), ("ctl", ctl.as_str()), ("", ""), (":path", "/")];
    for _ in 0..3 {
        let mut block: Vec<u8> = Vec::new();
        for f in fields(&fs).iter() { e.write_field(&mut block, f); }
        assert_eq(d.decode_full(block.as_slice()).unwrap(), fields(&fs));
    }
    // A sensitive field: never indexed, and so again in full.
    let mut s = HeaderField::new("authorization", "secret");
    s.sensitive = true;
    let mut b1: Vec<u8> = Vec::new();
    e.write_field(&mut b1, &s);
    assert_eq(b1[0] & 0xf0, 0x10);
    let mut b2: Vec<u8> = Vec::new();
    e.write_field(&mut b2, &s);
    assert_eq(b1, b2);
    let got = d.decode_full(b1.as_slice()).unwrap();
    assert(got[0].sensitive && got[0].value == "secret".to_string());
    // A table shrunk by the peer's settings: the encoder says so first.
    e.set_max_dynamic_table_size_limit(100);
    let mut b3: Vec<u8> = Vec::new();
    e.write_field(&mut b3, &HeaderField::new("a", "b"));
    assert_eq(b3[0] & 0xe0, 0x20);
    assert_eq(d.decode_full(b3.as_slice()).unwrap(), fields(&[("a", "b")]));
    // A field bigger than the table is not put in it.
    let big = "y".repeat(200);
    let mut b4: Vec<u8> = Vec::new();
    e.write_field(&mut b4, &HeaderField::new("big", big.as_str()));
    assert_eq(b4[0] & 0xf0, 0x00);
    assert_eq(d.decode_full(b4.as_slice()).unwrap(), fields(&[("big", big.as_str())]));
}

#[test]
fn bad_blocks() {
    let bad = [
        "80",                 // index 0
        "be",                 // past the dynamic table (empty)
        "ff",                 // truncated integer
        "ffffffffff0f",       // integer too large
        "4005 6162",          // string past the end
        "0081 00",            // Huffman padding not all ones
        "0084 ffff ffff 0161", // EOS in a Huffman string
        "3fe21f",             // size update past the allowed 4096 (4097)
        "82 20",              // size update after a field
    ];
    for b in bad.iter() {
        let mut d = Decoder::new(4096);
        assert(d.decode_full(unhex(*b).as_slice()).is_err());
    }
    let mut d = Decoder::new(4096);
    d.set_max_string_length(3);
    assert(d.decode_full(unhex("0001 6104 6162 6364").as_slice()).is_err());
    assert(d.decode_full(unhex("0001 6103 6162 63").as_slice()).is_ok());
}
