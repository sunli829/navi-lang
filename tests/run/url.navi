// std::url: parsing, resolution, setters, queries and percent-encoding.
use std::url::{Url, Position, form_urlencoded};
use std::url::percent_encoding::{utf8_percent_encode, percent_decode_str, NON_ALPHANUMERIC};

#[test]
fn parse_components() {
    let u = Url::parse("HTTPS://user:pw@Example.COM:8443/a/./b?x=1&y= z#top").unwrap();
    assert_eq(u.scheme(), "https");
    assert_eq(u.username(), "user");
    assert_eq(u.password(), Some("pw"));
    assert_eq(u.host_str(), Some("example.com"));
    assert_eq(u.port(), Some(8443u16));
    assert_eq(u.path(), "/a/b");
    assert_eq(u.query(), Some("x=1&y=%20z"));
    assert_eq(u.fragment(), Some("top"));
    assert_eq(u.as_str(), "https://user:pw@example.com:8443/a/b?x=1&y=%20z#top");
    let mut pairs = Vec::new();
    for (k, v) in u.query_pairs() { pairs.push(`${k}=${v}`); }
    assert_eq(pairs.join(" | "), String::from("x=1 | y= z"));
}

#[test]
fn default_port() {
    let d = Url::parse("http://example.com:80").unwrap();
    assert_eq(`${d}`.as_str(), "http://example.com/");
    assert_eq(d.port(), None);
    assert_eq(d.port_or_known_default(), Some(80u16));
}

#[test]
fn join() {
    let b = Url::parse("http://h/a/b?q#f").unwrap();
    let joins = ["c", "./", "/x/y?q", "?n", "", "//other/z", "https://h/s"];
    let mut out = Vec::new();
    for j in joins.iter() { out.push(b.join(*j).unwrap().to_string()); }
    assert_eq(out, Vec::from([
        String::from("http://h/a/c"),
        String::from("http://h/a/"),
        String::from("http://h/x/y?q"),
        String::from("http://h/a/b?n"),
        String::from("http://h/a/b?q"),
        String::from("http://other/z"),
        String::from("https://h/s"),
    ]));
}

#[test]
fn query_pairs_mut() {
    let mut p = Url::parse("http://h/p?a=1").unwrap();
    p.query_pairs_mut().append_pair("q", "a b&c").append_key_only("k");
    assert_eq(p.as_str(), "http://h/p?a=1&q=a+b%26c&k");
}

#[test]
fn ip_hosts() {
    let i4 = Url::parse("http://127.0.0.1:8080").unwrap();
    let i6 = Url::parse("http://[0:0::1]").unwrap();
    let n = Url::parse("http://0x0A.1/").unwrap();
    assert_eq(`${i4} ${i6} ${n}`.as_str(), "http://127.0.0.1:8080/ http://[::1]/ http://10.0.0.1/");
}

#[test]
fn non_hierarchical_and_file() {
    let m = Url::parse("mailto:joe@example.com").unwrap();
    assert_eq(m.as_str(), "mailto:joe@example.com");
    assert(m.cannot_be_a_base());
    assert_eq(m.host_str(), None);
    let f = Url::parse("file://localhost/etc/passwd").unwrap();
    assert_eq(f.as_str(), "file:///etc/passwd");
    assert_eq(f.host_str(), Some(""));
}

#[test]
fn parse_errors() {
    assert_eq(`${Url::parse("http://").map(|x| x.to_string()):?}`.as_str(), "Err(EmptyHost)");
    assert_eq(`${Url::parse("http://h:99999/").map(|x| x.to_string()):?}`.as_str(), "Err(InvalidPort)");
    assert_eq(`${Url::parse("/rel").map(|x| x.to_string()):?}`.as_str(), "Err(RelativeUrlWithoutBase)");
    assert_eq(`${Url::parse("http://[::1/").map(|x| x.to_string()):?}`.as_str(), "Err(InvalidIpv6Address)");
    assert_eq(`${Url::parse("http://日本.jp/").map(|x| x.to_string()):?}`.as_str(), "Err(IdnaError)");
}

#[test]
fn setters() {
    let mut s = Url::parse("https://example.com/old?x#y").unwrap();
    s.set_host(Some("new.example")).unwrap();
    s.set_port(Some(99)).unwrap();
    s.set_path("new path");
    s.set_query(Some("a b"));
    s.set_fragment(Some("c d"));
    s.set_username("u").unwrap();
    s.set_password(Some("p")).unwrap();
    assert_eq(s.as_str(), "https://u:p@new.example:99/new%20path?a%20b#c%20d");
}

#[test]
fn percent_encoding() {
    let e = utf8_percent_encode("a b&c/d", NON_ALPHANUMERIC).to_string();
    assert_eq(e, String::from("a%20b%26c%2Fd"));
    assert_eq(`${percent_decode_str(e.as_str()).decode_utf8().unwrap()}`.as_str(), "a b&c/d");
    let w = Url::parse("http://h/a b/{x}?q=\"#`").unwrap();
    assert_eq(w.slice(Position::BeforeScheme, Position::AfterFragment), "http://h/a%20b/%7Bx%7D?q=%22#%60");
    let enc = form_urlencoded::Serializer::new(String::new()).append_pair("q", "a&b").finish();
    assert_eq(enc, "q=a%26b".to_string());
}

#[test]
fn path_segments_and_origin() {
    let segs: Vec<&str> = Url::parse("http://h/a/b/").unwrap().path_segments().unwrap().collect();
    assert_eq(segs, Vec::from(["a", "b", ""]));
    assert_eq(Url::parse("https://example.com:443/x?y").unwrap().origin().ascii_serialization(), String::from("https://example.com"));
}
