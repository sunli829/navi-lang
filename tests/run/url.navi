// std::url: parsing, resolution, setters, queries and percent-encoding.
// out: https|user|Some("pw")|Some("example.com")|Some(8443)|/a/b|Some("x=1&y=%20z")|Some("top")
// out: https://user:pw@example.com:8443/a/b?x=1&y=%20z#top
// out: http://example.com/ None Some(80)
// out: http://h/a/c http://h/a/ http://h/x/y?q http://h/a/b?n http://h/a/b?q http://other/z https://h/s
// out: x=1 | y= z
// out: http://h/p?a=1&q=a+b%26c&k
// out: http://127.0.0.1:8080/ http://[::1]/ http://10.0.0.1/
// out: mailto:joe@example.com true None
// out: file:///etc/passwd Some("")
// out: Err(EmptyHost) Err(InvalidPort) Err(RelativeUrlWithoutBase) Err(InvalidIpv6Address) Err(IdnaError)
// out: https://u:p@new.example:99/new%20path?a%20b#c%20d
// out: a%20b%26c%2Fd a b&c/d
// out: ["a", "b", ""]
// out: https://example.com
// out: http://h/a%20b/%7Bx%7D?q=%22#%60
use std::url::{Url, Position, form_urlencoded};
use std::url::percent_encoding::{utf8_percent_encode, percent_decode_str, NON_ALPHANUMERIC};

fn main() {
    let u = Url::parse("HTTPS://user:pw@Example.COM:8443/a/./b?x=1&y= z#top").unwrap();
    println(`${u.scheme()}|${u.username()}|${u.password():?}|${u.host_str():?}|${u.port():?}|${u.path()}|${u.query():?}|${u.fragment():?}`);
    println(u.as_str());
    let d = Url::parse("http://example.com:80").unwrap();
    println(`${d} ${d.port():?} ${d.port_or_known_default():?}`);

    let b = Url::parse("http://h/a/b?q#f").unwrap();
    let joins = ["c", "./", "/x/y?q", "?n", "", "//other/z", "https://h/s"];
    let mut out = Vec::new();
    for j in joins.iter() { out.push(b.join(*j).unwrap().to_string()); }
    let mut line = String::new();
    for (i, s) in out.iter().enumerate() {
        if i > 0 { line.push(' '); }
        line.push_str(s.as_str());
    }
    println(line);

    let mut pairs = Vec::new();
    for (k, v) in u.query_pairs() { pairs.push(`${k}=${v}`); }
    println(pairs.join(" | "));

    let mut p = Url::parse("http://h/p?a=1").unwrap();
    p.query_pairs_mut().append_pair("q", "a b&c").append_key_only("k");
    println(p.as_str());

    let i4 = Url::parse("http://127.0.0.1:8080").unwrap();
    let i6 = Url::parse("http://[0:0::1]").unwrap();
    let n = Url::parse("http://0x0A.1/").unwrap();
    println(`${i4} ${i6} ${n}`);

    let m = Url::parse("mailto:joe@example.com").unwrap();
    println(`${m} ${m.cannot_be_a_base()} ${m.host_str():?}`);
    let f = Url::parse("file://localhost/etc/passwd").unwrap();
    println(`${f} ${f.host_str():?}`);

    println(`${Url::parse("http://").map(|x| x.to_string()):?} ${Url::parse("http://h:99999/").map(|x| x.to_string()):?} ${Url::parse("/rel").map(|x| x.to_string()):?} ${Url::parse("http://[::1/").map(|x| x.to_string()):?} ${Url::parse("http://日本.jp/").map(|x| x.to_string()):?}`);

    let mut s = Url::parse("https://example.com/old?x#y").unwrap();
    s.set_host(Some("new.example")).unwrap();
    s.set_port(Some(99)).unwrap();
    s.set_path("new path");
    s.set_query(Some("a b"));
    s.set_fragment(Some("c d"));
    s.set_username("u").unwrap();
    s.set_password(Some("p")).unwrap();
    println(s.as_str());

    let e = utf8_percent_encode("a b&c/d", NON_ALPHANUMERIC).to_string();
    println(`${e} ${percent_decode_str(e.as_str()).decode_utf8().unwrap()}`);

    let segs: Vec<&str> = Url::parse("http://h/a/b/").unwrap().path_segments().unwrap().collect();
    println(`${segs:?}`);
    println(Url::parse("https://example.com:443/x?y").unwrap().origin().ascii_serialization());
    let w = Url::parse("http://h/a b/{x}?q=\"#`").unwrap();
    println(w.slice(Position::BeforeScheme, Position::AfterFragment));
    let enc = form_urlencoded::Serializer::new(String::new()).append_pair("q", "a&b").finish();
    assert_eq(enc, "q=a%26b".to_string());
}
