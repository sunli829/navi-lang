// out: 3 Some(2) None true false
// out: counts a=3 b=2 c=1
// out: removed Some(20) len 2
// out: big 10000 sum 49995000 missing None
// out: set 3 true false
// out: {"k": 1}
// out: entry 15 [1, 2]
use std::collections::{HashMap, HashSet};

fn main() {
    let mut m: HashMap<&str, i32> = HashMap::new();
    m.insert("one", 1);
    m.insert("two", 2);
    m.insert("three", 3);
    println(`${m.len()} ${m.get(&"two"):?} ${m.get(&"four"):?} ${m.contains_key(&"one")} ${m.contains_key(&"x")}`);

    let mut counts: HashMap<String, i32> = HashMap::new();
    for w in "a b a c b a".split_whitespace() {
        *counts.entry(w.to_string()).or_insert(0) += 1;
    }
    let mut keys: Vec<String> = counts.keys().map(|k| k.clone()).collect();
    keys.sort();
    let mut out = String::from("counts");
    for k in keys.iter() { out.push_str(&` ${k}=${counts[k]}`); }
    println(out);

    let mut n: HashMap<i32, i32> = HashMap::new();
    n.insert(1, 10);
    n.insert(2, 20);
    n.insert(3, 30);
    println(`removed ${n.remove(&2):?} len ${n.len()}`);

    let mut big: HashMap<u64, u64> = HashMap::new();
    let mut i = 0u64;
    while i < 10000 { big.insert(i, i); i += 1; }
    let mut sum = 0u64;
    for (_, v) in big.iter() { sum += *v; }
    println(`big ${big.len()} sum ${sum} missing ${big.get(&10000):?}`);

    let mut s: HashSet<i32> = HashSet::new();
    s.insert(1);
    s.insert(2);
    s.insert(2);
    s.insert(3);
    println(`set ${s.len()} ${s.contains(&2)} ${s.contains(&5)}`);

    let mut d: HashMap<String, i32> = HashMap::new();
    d.insert("k".to_string(), 1);
    println(`${d:?}`);

    let mut e: HashMap<i32, Vec<i32>> = HashMap::new();
    e.entry(7).or_default().push(1);
    e.entry(7).or_default().push(2);
    *e.entry(8).or_insert(Vec::new()) = vec_of(5);
    println(`entry ${7 + e[&8][0] + 3} ${e[&7]:?}`);
}

fn vec_of(x: i32) -> Vec<i32> { let mut v = Vec::new(); v.push(x); v }
