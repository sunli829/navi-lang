// HashMap and HashSet: insert, get, contains, entry API, remove, iteration,
// many entries, Debug.
use std::collections::{HashMap, HashSet};

fn vec_of(x: i32) -> Vec<i32> { let mut v = Vec::new(); v.push(x); v }

#[test]
fn insert_get_contains() {
    let mut m: HashMap<&str, i32> = HashMap::new();
    m.insert("one", 1);
    m.insert("two", 2);
    m.insert("three", 3);
    assert_eq(m.len(), 3);
    assert_eq(m.get(&"two"), Some(&2));
    assert_eq(m.get(&"four"), None);
    assert(m.contains_key(&"one"));
    assert(!m.contains_key(&"x"));
}

#[test]
fn count_with_entry() {
    let mut counts: HashMap<String, i32> = HashMap::new();
    for w in "a b a c b a".split_whitespace() {
        *counts.entry(w.to_string()).or_insert(0) += 1;
    }
    let mut keys: Vec<String> = counts.keys().map(|k| k.clone()).collect();
    keys.sort();
    let mut out = String::from("counts");
    for k in keys.iter() { out.push_str(&` ${k}=${counts[k]}`.to_string()); }
    assert_eq(out.as_str(), "counts a=3 b=2 c=1");
}

#[test]
fn remove() {
    let mut n: HashMap<i32, i32> = HashMap::new();
    n.insert(1, 10);
    n.insert(2, 20);
    n.insert(3, 30);
    assert_eq(n.remove(&2), Some(20));
    assert_eq(n.len(), 2);
}

#[test]
fn many_entries() {
    let mut big: HashMap<u64, u64> = HashMap::new();
    let mut i = 0u64;
    while i < 10000 { big.insert(i, i); i += 1; }
    let mut sum = 0u64;
    for (_, v) in big.iter() { sum += *v; }
    assert_eq(big.len(), 10000);
    assert_eq(sum, 49995000);
    assert_eq(big.get(&10000), None);
}

#[test]
fn hash_set() {
    let mut s: HashSet<i32> = HashSet::new();
    s.insert(1);
    s.insert(2);
    s.insert(2);
    s.insert(3);
    assert_eq(s.len(), 3);
    assert(s.contains(&2));
    assert(!s.contains(&5));
}

#[test]
fn debug() {
    let mut d: HashMap<String, i32> = HashMap::new();
    d.insert("k".to_string(), 1);
    assert_eq(`${d:?}`.to_string().as_str(), "{\"k\": 1}");
}

#[test]
fn entry_or_default() {
    let mut e: HashMap<i32, Vec<i32>> = HashMap::new();
    e.entry(7).or_default().push(1);
    e.entry(7).or_default().push(2);
    *e.entry(8).or_insert(Vec::new()) = vec_of(5);
    assert_eq(7 + e[&8][0] + 3, 15);
    assert_eq(e[&7], Vec::from([1, 2]));
}
