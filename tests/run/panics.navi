// Panics: the checks that panic (as Rust's debug builds; navi has one build
// mode), and a panic nothing catches (exit code 101, the message on
// stderr, defers run, output so far kept).
use std::hint::black_box;

#[test]
#[should_panic(expected = "index out of bounds: the len is 3 but the index is 5")]
fn index_out_of_bounds() {
    let v = [1, 2, 3];
    let i = black_box(5);
    let _ = v[i];
}

#[test]
#[should_panic(expected = "attempt to add with overflow")]
fn add_overflow() {
    let x: u8 = 250;
    let _ = x + black_box(10u8);
}

#[test]
#[should_panic(expected = "attempt to subtract with overflow")]
fn subtract_overflow() {
    let x: u32 = 1;
    let _ = x - black_box(2u32);
}

#[test]
#[should_panic(expected = "attempt to multiply with overflow")]
fn multiply_overflow() {
    let x: i64 = i64::MAX;
    let _ = x * black_box(2i64);
}

#[test]
#[should_panic(expected = "attempt to negate with overflow")]
fn negate_overflow() {
    let x = black_box(i32::MIN);
    let _ = -x;
}

#[test]
#[should_panic(expected = "attempt to divide by zero")]
fn divide_by_zero() {
    let _ = 7 / black_box(0);
}

#[test]
#[should_panic(expected = "attempt to shift with overflow")]
fn shift_overflow() {
    let _ = 1u32 << black_box(40u32);
}

#[test]
#[should_panic(expected = "called Option::unwrap() on a None value")]
fn unwrap_none() {
    let o: Option<i32> = black_box(None);
    o.unwrap();
}

#[test]
fn wrapping_is_explicit() {
    assert_eq(250u8.wrapping_add(10), 4);
    assert_eq(250u8.checked_add(10), None);
    assert_eq(250u8.saturating_add(10), 255);
}

// Builds and runs a program (as Go's runtime tests build theirs): navi test
// sets NAVI to the navi running it (as Cargo sets CARGO).
fn run_program(name: &str, src: &str) -> std::process::Output {
    let dir = std::env::temp_dir().join(`navi-${name}-${std::process::id()}`.to_string());
    std::fs::create_dir_all(&dir).unwrap();
    let file = dir.join("main.navi");
    std::fs::write(&file, src).unwrap();
    let exe = dir.join(`prog${std::env::consts::EXE_SUFFIX}`.to_string());
    let navi = std::env::var("NAVI").unwrap();
    let b = std::process::Command::new(navi).arg("build").arg("-o").arg(exe.to_str().unwrap()).arg(file.to_str().unwrap()).output().unwrap();
    assert_msg(b.status.success(), String::from_utf8_lossy(&b.stderr));
    let out = std::process::Command::new(exe.to_str().unwrap()).output().unwrap();
    let _ = std::fs::remove_dir_all(&dir);
    out
}

#[test]
fn uncaught_panic_exits_101() {
    let out = run_program("uncaught", r#"
fn main() {
    defer println("cleanup");
    println("before");
    let v = [1, 2, 3];
    let i = std::hint::black_box(5);
    let _ = v[i];
    println("not reached");
}
"#);
    assert_eq(out.status.code(), Some(101));
    assert_eq(String::from_utf8(out.stdout).unwrap(), "before\ncleanup\n");
    let err = String::from_utf8(out.stderr).unwrap();
    assert_msg(err.contains("thread 'main' panicked at") && err.contains("index out of bounds: the len is 3 but the index is 5"), err);
}
