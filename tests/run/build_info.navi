// std::build for a single file: the crate's name as the package's, no
// version or description, no --var.

#[test]
fn single_file() {
    assert_eq(std::build::package_name(), "build_info");
    assert_eq(std::build::package_version(), "");
    assert_eq(std::build::package_description(), "");
    assert_eq(std::build::package_authors(), "");
    assert_eq(std::build::package_license(), "");
    assert_eq(std::build::package_repository(), "");
    assert_eq(std::build::package_homepage(), "");
    assert_eq(std::build::var("nope"), None);
}
