// std::rand: the OS source, the shared thread generator from many green
// threads at once, and random() of several types.
use std::rand::{self, Rng, RngCore, TryRngCore};
use std::rand::rngs::OsRng;
use std::sync::Mutex;

#[test]
fn os_source() {
    let mut a = [0u8; 300];
    let mut b = [0u8; 300];
    let r1 = OsRng.try_fill_bytes(&mut a);
    let r2 = OsRng.try_fill_bytes(&mut b);
    assert(r1.is_ok());
    assert(r2.is_ok());
    assert(a != b);
}

#[test]
fn thread_generator_from_many_threads() {
    let seen: &Mutex<Vec<u64>> = &Mutex::new(Vec::new());
    let mut hs = Vec::new();
    for _ in 0..8 {
        hs.push(std::thread::spawn(|| {
            let mut r = rand::rng();
            let mut mine = Vec::new();
            for _ in 0..1000 { mine.push(r.next_u64()); }
            let v = seen.lock();
            v.extend_from_slice(mine.as_slice());
            seen.unlock();
        }));
    }
    for h in hs { h.join().unwrap(); }
    let mut v = seen.lock().clone();
    seen.unlock();
    let n = v.len();
    v.sort();
    v.dedup();
    assert_eq(n, 8000);
    assert_eq(v.len(), n);
}

#[test]
fn random_values_in_range() {
    for _ in 0..2000 {
        let x: f64 = rand::random();
        let d = rand::random_range(1..=6);
        let c: char = rand::random();
        let k = rand::rng().random_range(-3i64..3);
        assert(x >= 0.0 && x < 1.0);
        assert(d >= 1 && d <= 6);
        assert(!(c as u32 >= 0xd800 && (c as u32) < 0xe000));
        assert(k >= -3 && k < 3);
    }
}
