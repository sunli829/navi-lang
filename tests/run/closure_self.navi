// A closure capturing self (and a local Vec) inside a &mut self method.
struct P { n: u64 }

fn run(n: usize, f: fn(usize)) {
    let mut i = 0;
    while i < n { f(i); i += 1; }
}

impl P {
    fn go(&mut self, roots: Vec<u64>, extra: u64) -> (usize, Vec<u64>, usize, u64) {
        let before = roots.len();
        let mut acc: Vec<u64> = Vec::new();
        for _ in roots.iter() { acc.push(0); }
        run(roots.len(), |i| { acc[i] = self.n + i as u64; });
        (before, acc, roots.len(), extra)
    }
}

#[test]
fn closure_captures_self() {
    let p = &mut P { n: 10 };
    let mut r = Vec::new();
    r.push(1u64);
    r.push(2u64);
    let (before, acc, after, extra) = p.go(r, 5);
    assert_eq(before, 2);
    assert_eq(after, 2);
    assert_eq(acc, Vec::from([10u64, 11]));
    assert_eq(extra, 5);
}
