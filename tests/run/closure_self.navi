// out: before 2
// out: after 2 [10, 11] 5
struct P { n: u64 }

fn run(n: usize, f: fn(usize)) {
    let mut i = 0;
    while i < n { f(i); i += 1; }
}

impl P {
    fn go(&mut self, roots: Vec<u64>, extra: u64) {
        println(`before ${roots.len()}`);
        let mut acc: Vec<u64> = Vec::new();
        for _ in roots.iter() { acc.push(0); }
        run(roots.len(), |i| { acc[i] = self.n + i as u64; });
        println(`after ${roots.len()} ${acc:?} ${extra}`);
    }
}

fn main() {
    let p = &mut P { n: 10 };
    let mut r = Vec::new();
    r.push(1u64);
    r.push(2u64);
    p.go(r, 5);
}
