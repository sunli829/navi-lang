// RwLock, Condvar, Once, OnceLock, LazyLock, Barrier and atomics across threads.
use std::sync::{Mutex, RwLock, Condvar, Once, OnceLock, LazyLock, Barrier};
use std::sync::atomic::{AtomicUsize, Ordering};
use std::thread;

#[test]
fn rwlock_readers_and_writers() {
    // RwLock: many readers, writers exclusive.
    let rw = &RwLock::new(0i64);
    let bad = &AtomicUsize::new(0);
    let mut hs = Vec::new();
    let mut t = 0;
    while t < 8 {
        hs.push(thread::spawn(|| {
            let mut i = 0;
            while i < 1000 {
                if i % 10 == 0 {
                    let d = rw.write();
                    *d += 1;
                    rw.write_unlock();
                } else {
                    let v = *rw.read();
                    if v < 0 { bad.fetch_add(1, Ordering::SeqCst); }
                    rw.read_unlock();
                }
                i += 1;
            }
        }));
        t += 1;
    }
    for h in hs.iter() { h.join().unwrap(); }
    assert_eq(bad.load(Ordering::SeqCst), 0);
    assert_eq(rw.with_read(|v| *v), 800);
}

#[test]
fn condvar_queue_handoff() {
    let m = &Mutex::new(Vec::<i32>::new());
    let cv = &Condvar::new();
    let consumer = thread::spawn(|| {
        let mut got = 0;
        let mut sum = 0;
        while got < 100 {
            let q = m.lock();
            while q.len() == 0 { cv.wait(m); }
            sum += q.remove(0);
            got += 1;
            m.unlock();
        }
        sum
    });
    let mut i = 1;
    while i <= 100 {
        let q = m.lock();
        q.push(i);
        m.unlock();
        cv.notify_one();
        i += 1;
    }
    assert_eq(consumer.join().unwrap(), 5050);
}

#[test]
fn once_runs_once_across_threads() {
    let once = &Once::new();
    let count = &AtomicUsize::new(0);
    let mut hs2 = Vec::new();
    let mut t = 0;
    while t < 8 {
        hs2.push(thread::spawn(|| { once.call_once(|| { count.fetch_add(1, Ordering::SeqCst); }); }));
        t += 1;
    }
    for h in hs2.iter() { h.join().unwrap(); }
    assert_eq(count.load(Ordering::SeqCst), 1);
    assert(once.is_completed());
}

#[test]
fn once_lock() {
    let cell: OnceLock<i32> = OnceLock::new();
    assert_eq(cell.get(), None);
    assert_eq(cell.set(5), Ok(()));
    assert_eq(cell.set(6), Err(6));
    assert_eq(cell.get(), Some(&5));
    assert_eq(*cell.get_or_init(|| 7), 5);
}

#[test]
fn lazy_lock_initializes_once() {
    let inits = &AtomicUsize::new(0);
    let lazy = LazyLock::new(|| { inits.fetch_add(1, Ordering::SeqCst); 42 });
    assert_eq(inits.load(Ordering::SeqCst), 0);
    let a = *lazy;
    let b = *lazy;
    assert_eq((a, b), (42, 42));
    assert_eq(inits.load(Ordering::SeqCst), 1);
}

#[test]
fn barrier_has_one_leader() {
    let b = &Barrier::new(4);
    let leaders = &AtomicUsize::new(0);
    let mut hs3 = Vec::new();
    let mut t = 0;
    while t < 4 {
        hs3.push(thread::spawn(|| { if b.wait().is_leader() { leaders.fetch_add(1, Ordering::SeqCst); } }));
        t += 1;
    }
    for h in hs3.iter() { h.join().unwrap(); }
    assert_eq(leaders.load(Ordering::SeqCst), 1);
}
