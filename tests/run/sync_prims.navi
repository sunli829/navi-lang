// stage0: skip
// RwLock, Condvar, Once, OnceLock, LazyLock, Barrier and atomics across threads.
// out: rw 800
// out: cv 5050
// out: once 1 true
// out: cell None Ok(()) Err(6) Some(5) 5
// out: init
// out: lazy 42 42
// out: barrier leaders 1
use std::sync::{Mutex, RwLock, Condvar, Once, OnceLock, LazyLock, Barrier};
use std::sync::atomic::{AtomicUsize, Ordering};
use std::thread;


fn main() {
    // RwLock: many readers, writers exclusive.
    let rw = &RwLock::new(0i64);
    let mut hs = Vec::new();
    let mut t = 0;
    while t < 8 {
        hs.push(thread::spawn(|| {
            let mut i = 0;
            while i < 1000 {
                if i % 10 == 0 {
                    let d = rw.write();
                    *d += 1;
                    rw.write_unlock();
                } else {
                    let v = *rw.read();
                    if v < 0 { println("bad"); }
                    rw.read_unlock();
                }
                i += 1;
            }
        }));
        t += 1;
    }
    for h in hs.iter() { h.join().unwrap(); }
    println(`rw ${rw.with_read(|v| *v)}`);
    // Condvar: a queue handoff.
    let m = &Mutex::new(Vec::<i32>::new());
    let cv = &Condvar::new();
    let consumer = thread::spawn(|| {
        let mut got = 0;
        let mut sum = 0;
        while got < 100 {
            let q = m.lock();
            while q.len() == 0 { cv.wait(m); }
            sum += q.remove(0);
            got += 1;
            m.unlock();
        }
        sum
    });
    let mut i = 1;
    while i <= 100 {
        let q = m.lock();
        q.push(i);
        m.unlock();
        cv.notify_one();
        i += 1;
    }
    println(`cv ${consumer.join().unwrap()}`);
    // Once / OnceLock / LazyLock.
    let once = &Once::new();
    let count = &AtomicUsize::new(0);
    let mut hs2 = Vec::new();
    t = 0;
    while t < 8 {
        hs2.push(thread::spawn(|| { once.call_once(|| { count.fetch_add(1, Ordering::SeqCst); }); }));
        t += 1;
    }
    for h in hs2.iter() { h.join().unwrap(); }
    println(`once ${count.load(Ordering::SeqCst)} ${once.is_completed()}`);
    let cell: OnceLock<i32> = OnceLock::new();
    println(`cell ${cell.get():?} ${cell.set(5):?} ${cell.set(6):?} ${cell.get():?} ${cell.get_or_init(|| 7)}`);
    let lazy = LazyLock::new(|| { println("init"); 42 });
    println(`lazy ${*lazy} ${*lazy}`);
    // Barrier.
    let b = &Barrier::new(4);
    let leaders = &AtomicUsize::new(0);
    let mut hs3 = Vec::new();
    t = 0;
    while t < 4 {
        hs3.push(thread::spawn(|| { if b.wait().is_leader() { leaders.fetch_add(1, Ordering::SeqCst); } }));
        t += 1;
    }
    for h in hs3.iter() { h.join().unwrap(); }
    println(`barrier leaders ${leaders.load(Ordering::SeqCst)}`);
}
