// out: empty 0 true None None [] []
// out: peek Some(9) len 8
// out: pop [9, 8, 8, 7, 5, 3, 2, 1] true
// out: sorted [1, 3, 4, 7, 7, 10] 6 Some(10) sum 102 vec [1, 3, 4, 7, 7, 10]
// out: min-heap 1 [1, 3, 5, 8]
// out: reverse false true Equal Reverse("a")
// out: jobs ["deploy", "build", "write", "rest"]
// out: append 8 0 Some(100) [0, 1, 2, 3, 4, 5, 6, 100]
// out: retain [0, 2, 4, 6, 100]
// out: drain 5 0
// out: default []
// out: random true 0
use std::cmp::Reverse;
use std::collections::BinaryHeap;

fn main() {
    let mut e: BinaryHeap<i32> = BinaryHeap::new();
    println(`empty ${e.len()} ${e.is_empty()} ${e.peek():?} ${e.pop():?} ${e:?} ${e.clone().into_sorted_vec():?}`);

    let mut h: BinaryHeap<i32> = BinaryHeap::new();
    for x in vec_of(&[5, 1, 8, 3, 9, 2, 8, 7]) { h.push(x); }
    println(`peek ${h.peek():?} len ${h.len()}`);
    let mut out: Vec<i32> = Vec::new();
    while let Some(x) = h.pop() { out.push(x); }
    println(`pop ${out:?} ${h.is_empty()}`);

    let h2: BinaryHeap<i32> = vec_of(&[4, 10, 1, 7, 7, 3]).into_iter().collect();
    let sorted = h2.clone().into_sorted_vec();
    let mut it_sum = 0;
    for x in h2.iter() { it_sum += *x; }
    for x in &h2 { it_sum += *x; }
    let into_sum: i32 = h2.clone().into_iter().sum();
    it_sum += into_sum + h2.iter().rev().count() as i32;
    let mut v = h2.clone().into_vec();
    v.sort();
    println(`sorted ${sorted:?} ${h2.len()} ${h2.peek():?} sum ${it_sum} vec ${v:?}`);

    // A min-heap with Reverse.
    let mut mh: BinaryHeap<Reverse<i32>> = BinaryHeap::new();
    for x in vec_of(&[5, 1, 8, 3]) { mh.push(Reverse(x)); }
    let top = mh.peek().unwrap().0;
    let mut mins: Vec<i32> = Vec::new();
    while let Some(Reverse(x)) = mh.pop() { mins.push(x); }
    println(`min-heap ${top} ${mins:?}`);
    println(`reverse ${Reverse(1) < Reverse(2)} ${Reverse(2) < Reverse(1)} ${Reverse(1).cmp(&Reverse(1)):?} ${Reverse("a"):?}`);

    // Tuples: by priority, then name.
    let mut jobs: BinaryHeap<(u32, String)> = BinaryHeap::new();
    jobs.push((2, String::from("write")));
    jobs.push((5, String::from("deploy")));
    jobs.push((1, String::from("rest")));
    jobs.push((5, String::from("build")));
    let mut order: Vec<String> = Vec::new();
    while let Some((_, name)) = jobs.pop() { order.push(name); }
    println(`jobs ${order:?}`);

    let mut a = BinaryHeap::from(vec_of(&[1, 5, 2]));
    let mut b = BinaryHeap::from(vec_of(&[4, 3]));
    a.append(&mut b);
    a.extend(vec_of(&[0, 6]));
    let shared = a;
    let mut s2 = shared;
    s2.push(100);
    println(`append ${a.len()} ${b.len()} ${a.peek():?} ${a.clone().into_sorted_vec():?}`);
    a.retain(|x| *x % 2 == 0);
    println(`retain ${a.clone().into_sorted_vec():?}`);
    let drained: Vec<i32> = a.drain().collect();
    println(`drain ${drained.len()} ${a.len()}`);
    let d: BinaryHeap<i32> = BinaryHeap::default();
    println(`default ${d:?}`);

    // Heap order on many values (a heap sort checked against sort).
    let mut big: BinaryHeap<u64> = BinaryHeap::new();
    let mut model: Vec<u64> = Vec::new();
    let mut seed: u64 = 5;
    let mut i = 0;
    while i < 50000 {
        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
        let x = (seed >> 33) % 100000;
        big.push(x);
        model.push(x);
        if i % 3 == 0 {
            model.sort();
            assert_eq(big.pop(), model.pop());
        }
        i += 1;
    }
    model.sort();
    assert(big.clone().into_sorted_vec() == model);
    let mut ok = true;
    while let Some(x) = big.pop() { if Some(x) != model.pop() { ok = false; } }
    println(`random ${ok} ${model.len()}`);
}

fn vec_of(a: &[i32]) -> Vec<i32> { a.to_vec() }
