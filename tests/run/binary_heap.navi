// std::collections::BinaryHeap: push/pop/peek, into_sorted_vec, iteration,
// a min-heap with Reverse, tuple priorities, append/extend, retain, drain,
// Debug output, and a heap sort of many values checked against sort.
use std::cmp::Reverse;
use std::collections::BinaryHeap;

fn vec_of(a: &[i32]) -> Vec<i32> { a.to_vec() }

#[test]
fn empty_heap() {
    let mut e: BinaryHeap<i32> = BinaryHeap::new();
    assert_eq(e.len(), 0);
    assert(e.is_empty());
    assert_eq(e.peek(), None);
    assert_eq(e.pop(), None);
    assert_eq(`${e:?}`.to_string().as_str(), "[]");
    assert_eq(e.clone().into_sorted_vec(), Vec::new());
}

#[test]
fn push_peek_pop() {
    let mut h: BinaryHeap<i32> = BinaryHeap::new();
    for x in vec_of(&[5, 1, 8, 3, 9, 2, 8, 7]) { h.push(x); }
    assert_eq(h.peek(), Some(&9));
    assert_eq(h.len(), 8);
    let mut out: Vec<i32> = Vec::new();
    while let Some(x) = h.pop() { out.push(x); }
    assert_eq(out, Vec::from([9, 8, 8, 7, 5, 3, 2, 1]));
    assert(h.is_empty());
}

#[test]
fn sorted_vec_and_iteration() {
    let h2: BinaryHeap<i32> = vec_of(&[4, 10, 1, 7, 7, 3]).into_iter().collect();
    let sorted = h2.clone().into_sorted_vec();
    let mut it_sum = 0;
    for x in h2.iter() { it_sum += *x; }
    for x in &h2 { it_sum += *x; }
    let into_sum: i32 = h2.clone().into_iter().sum();
    it_sum += into_sum + h2.iter().rev().count() as i32;
    let mut v = h2.clone().into_vec();
    v.sort();
    assert_eq(sorted, Vec::from([1, 3, 4, 7, 7, 10]));
    assert_eq(h2.len(), 6);
    assert_eq(h2.peek(), Some(&10));
    assert_eq(it_sum, 102);
    assert_eq(v, Vec::from([1, 3, 4, 7, 7, 10]));
}

#[test]
fn min_heap_with_reverse() {
    let mut mh: BinaryHeap<Reverse<i32>> = BinaryHeap::new();
    for x in vec_of(&[5, 1, 8, 3]) { mh.push(Reverse(x)); }
    let top = mh.peek().unwrap().0;
    let mut mins: Vec<i32> = Vec::new();
    while let Some(Reverse(x)) = mh.pop() { mins.push(x); }
    assert_eq(top, 1);
    assert_eq(mins, Vec::from([1, 3, 5, 8]));
    assert(!(Reverse(1) < Reverse(2)));
    assert(Reverse(2) < Reverse(1));
    assert_eq(`${Reverse(1).cmp(&Reverse(1)):?}`.to_string().as_str(), "Equal");
    assert_eq(`${Reverse("a"):?}`.to_string().as_str(), "Reverse(\"a\")");
}

// Tuples: by priority, then name.
#[test]
fn tuple_priorities() {
    let mut jobs: BinaryHeap<(u32, String)> = BinaryHeap::new();
    jobs.push((2, String::from("write")));
    jobs.push((5, String::from("deploy")));
    jobs.push((1, String::from("rest")));
    jobs.push((5, String::from("build")));
    let mut order: Vec<String> = Vec::new();
    while let Some((_, name)) = jobs.pop() { order.push(name); }
    assert_eq(`${order:?}`.to_string().as_str(), "[\"deploy\", \"build\", \"write\", \"rest\"]");
}

#[test]
fn append_retain_drain_default() {
    let mut a = BinaryHeap::from(vec_of(&[1, 5, 2]));
    let mut b = BinaryHeap::from(vec_of(&[4, 3]));
    a.append(&mut b);
    a.extend(vec_of(&[0, 6]));
    // The heap is shared, not copied: a push through s2 is seen in a.
    let shared = a;
    let mut s2 = shared;
    s2.push(100);
    assert_eq(a.len(), 8);
    assert_eq(b.len(), 0);
    assert_eq(a.peek(), Some(&100));
    assert_eq(a.clone().into_sorted_vec(), Vec::from([0, 1, 2, 3, 4, 5, 6, 100]));
    a.retain(|x| *x % 2 == 0);
    assert_eq(a.clone().into_sorted_vec(), Vec::from([0, 2, 4, 6, 100]));
    let drained: Vec<i32> = a.drain().collect();
    assert_eq(drained.len(), 5);
    assert_eq(a.len(), 0);
    let d: BinaryHeap<i32> = BinaryHeap::default();
    assert_eq(`${d:?}`.to_string().as_str(), "[]");
}

// Heap order on many values (a heap sort checked against sort).
#[test]
fn random_heap_sort() {
    let mut big: BinaryHeap<u64> = BinaryHeap::new();
    let mut model: Vec<u64> = Vec::new();
    let mut seed: u64 = 5;
    let mut i = 0;
    while i < 50000 {
        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
        let x = (seed >> 33) % 100000;
        big.push(x);
        model.push(x);
        if i % 3 == 0 {
            model.sort();
            assert_eq(big.pop(), model.pop());
        }
        i += 1;
    }
    model.sort();
    assert(big.clone().into_sorted_vec() == model);
    let mut ok = true;
    while let Some(x) = big.pop() { if Some(x) != model.pop() { ok = false; } }
    assert(ok);
    assert_eq(model.len(), 0);
}
