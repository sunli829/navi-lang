// std::crypto::x25519 against RFC 7748 and outputs of Go's crypto/ecdh
// (the constants at the end).

use std::crypto::x25519::{x25519, StaticSecret, PublicKey, X25519_BASEPOINT_BYTES};
use std::hex;

fn h(s: &str) -> Vec<u8> { hex::decode(s).unwrap() }

#[test]
fn rfc7748() {
    // 5.2.
    let out = x25519(h("a546e36bf0527c9d3b16154b82465edd62144c0ac1fc5a18506a2244ba449ac4").as_slice(), h("e6db6867583030db3594c1a424b15f7c726624ec26b3353b10a903a6d0ab1c4c").as_slice());
    assert_eq(hex::encode(&out), "c3da55379de9c6908e94ea4df28d084f32eccf03491c71f754b4075577a28552".to_string());
    // 6.1: Alice and Bob.
    let a = StaticSecret::from_bytes(h("77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a").as_slice());
    let b = StaticSecret::from_bytes(h("5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb").as_slice());
    let pa = PublicKey::from(&a);
    let pb = PublicKey::from(&b);
    assert_eq(hex::encode(pa.as_bytes()), "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a".to_string());
    assert_eq(hex::encode(pb.as_bytes()), "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f".to_string());
    let s1 = a.diffie_hellman(&pb);
    let s2 = b.diffie_hellman(&pa);
    assert_eq(hex::encode(s1.as_bytes()), "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742".to_string());
    assert_eq(hex::encode(s2.as_bytes()), hex::encode(s1.as_bytes()));
    assert(s1.was_contributory());
    // 5.2's iterated function, 1 and 1000 times.
    let mut k = X25519_BASEPOINT_BYTES.to_vec();
    let mut u = X25519_BASEPOINT_BYTES.to_vec();
    let mut i = 0;
    while i < 1000 {
        let r = x25519(k.as_slice(), u.as_slice());
        u = k;
        k = r.to_vec();
        i += 1;
        if i == 1 { assert_eq(hex::encode(&k), "422c8e7a6227d7bca1350b3e2bb7279f7897b87bb6854b783c60e80311ae3079".to_string()); }
    }
    assert_eq(hex::encode(&k), "684cf59ba83309552800ef566f2f4d3c1c3887c49360e3875f2eb94d99532c51".to_string());
}

#[test]
fn against_go() {
    for v in X25519.iter() {
        let f: Vec<&str> = v.split(' ').collect();
        let s = StaticSecret::from_bytes(h(f[0]).as_slice());
        let shared = s.diffie_hellman(&PublicKey::from_bytes(h(f[1]).as_slice()));
        assert_eq(hex::encode(shared.as_bytes()), f[2].to_string());
        assert_eq(hex::encode(PublicKey::from(&s).as_bytes()), f[3].to_string());
    }
}

#[test]
fn random_secrets_agree() {
    let a = StaticSecret::random();
    let b = StaticSecret::random();
    let ab = a.diffie_hellman(&PublicKey::from(&b));
    let ba = b.diffie_hellman(&PublicKey::from(&a));
    assert_eq(ab.to_bytes(), ba.to_bytes());
    // A low-order point gives zeros.
    let zero = a.diffie_hellman(&PublicKey::from_bytes(&[0u8; 32]));
    assert(!zero.was_contributory());
}

