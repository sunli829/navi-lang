// out: [   42] [42   ] [ 42  ] [00042]
// out: ff FF 0xff 0o17 0b101
// out: 3.142 1.5e3 +7
// out: "quoted" 'c' [1, 2] (1, "a")
// out: [**hi**] hi
fn main() {
    let n = 42;
    println(`[${n:>5}] [${n:<5}] [${n:^5}] [${n:05}]`);
    println(`${255:x} ${255:X} ${255:#x} ${15:#o} ${5:#b}`);
    let pi = 3.14159;
    println(`${pi:.3} ${1500.0:e} ${7:+}`);
    println(`${"quoted":?} ${'c':?} ${[1, 2]:?} ${(1, "a"):?}`);
    let s = "hi";
    println(`[${s:*^6}] ${s}`);
}
