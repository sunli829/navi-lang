// Template strings: width, alignment, fill, zero padding, radix, precision,
// exponent, sign and Debug formatting.
#[test]
fn width_and_alignment() {
    let n = 42;
    assert_eq(`[${n:>5}] [${n:<5}] [${n:^5}] [${n:05}]`.to_string().as_str(), "[   42] [42   ] [ 42  ] [00042]");
    let s = "hi";
    assert_eq(`[${s:*^6}] ${s}`.to_string().as_str(), "[**hi**] hi");
}

#[test]
fn radix() {
    assert_eq(`${255:x} ${255:X} ${255:#x} ${15:#o} ${5:#b}`.to_string().as_str(), "ff FF 0xff 0o17 0b101");
}

#[test]
fn precision_exponent_sign() {
    let pi = 3.14159;
    assert_eq(`${pi:.3} ${1500.0:e} ${7:+}`.to_string().as_str(), "3.142 1.5e3 +7");
}

#[test]
fn debug() {
    assert_eq(`${"quoted":?} ${'c':?} ${[1, 2]:?} ${(1, "a"):?}`.to_string().as_str(), "\"quoted\" 'c' [1, 2] (1, \"a\")");
}
