// out: 1 3 2 5
// out: all 5
// out: 10 20
// out: 1 2 3
// out: 4 5 6 7
// `name @ ..` in slice patterns: a slice of the middle (by reference, also
// mutable), or an array (by value).
fn main() {
    let v = [1, 2, 3, 4, 5];
    match &v[..] {
        [a, rest @ .., z] => println(`${a} ${rest.len()} ${rest[0]} ${z}`),
        _ => {}
    }
    match &v[..] { [rest @ ..] => println(`all ${rest.len()}`) }
    let mut w = vec_of();
    match w.as_mut_slice() { [first, rest @ ..] => { *first = 10; rest[0] = 20; } [] => {} }
    println(`${w[0]} ${w[1]}`);
    let [a, rest @ ..] = [1, 2, 3];
    println(`${a} ${rest.len()} ${rest[1]}`);
    match [4, 5, 6, 7] { [x, mid @ .., y] => println(`${x} ${mid[0]} ${mid[1]} ${y}`) }
}

fn vec_of() -> Vec<i32> {
    let mut v = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    v
}
