// `name @ ..` in slice patterns: a slice of the middle (by reference, also
// mutable), or an array (by value).
fn vec_of() -> Vec<i32> {
    let mut v = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    v
}

#[test]
fn rest_in_the_middle() {
    let v = [1, 2, 3, 4, 5];
    let mut got = (0, 0, 0, 0);
    match &v[..] {
        [a, rest @ .., z] => { got = (*a, rest.len(), rest[0], *z); }
        _ => {}
    }
    assert_eq(got, (1, 3, 2, 5));
}

#[test]
fn rest_is_the_whole_slice() {
    let v = [1, 2, 3, 4, 5];
    let n = match &v[..] { [rest @ ..] => rest.len() };
    assert_eq(n, 5);
}

#[test]
fn mutable_rest() {
    let mut w = vec_of();
    match w.as_mut_slice() { [first, rest @ ..] => { *first = 10; rest[0] = 20; } [] => {} }
    assert_eq(w[0], 10);
    assert_eq(w[1], 20);
}

#[test]
fn rest_of_an_array_by_value() {
    let [a, rest @ ..] = [1, 2, 3];
    assert_eq(a, 1);
    assert_eq(rest.len(), 2);
    assert_eq(rest[1], 3);
    let got = match [4, 5, 6, 7] { [x, mid @ .., y] => (x, mid[0], mid[1], y) };
    assert_eq(got, (4, 5, 6, 7));
}
