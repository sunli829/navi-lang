// skip: windows
// std::fs on the OS layer: File, OpenOptions, Metadata, directories, links.
use std::fs::{self, File, OpenOptions};
use std::io::{ErrorKind, Read, Seek, SeekFrom, Write};
use std::os::unix::fs::MetadataExt;
use std::time::{Duration, UNIX_EPOCH};

fn kind<T>(r: std::io::Result<T>) -> ErrorKind {
    match r {
        Ok(_) => ErrorKind::Other,
        Err(e) => e.kind(),
    }
}

// One test: each step works on the files the previous steps left.
#[test]
fn file_and_directory_operations() {
    let dir = std::env::temp_dir().join(`navi-fs-ops-${std::process::id()}`.to_string());
    let _ = fs::remove_dir_all(&dir);
    fs::create_dir_all(dir.join("a/b/c")).unwrap();
    let p = dir.join("f.txt");
    fs::write(&p, "hello\nworld\n").unwrap();
    let text = fs::read_to_string(&p).unwrap();
    assert_eq(text, String::from("hello\nworld\n"));
    assert_eq(text.len(), 12);

    let mut f = File::open(&p).unwrap();
    let pos = f.seek(SeekFrom::End(-6)).unwrap();
    let mut rest = String::new();
    f.read_to_string(&mut rest).unwrap();
    assert_eq(rest, String::from("world\n"));
    assert_eq(pos, 6);
    let m = f.metadata().unwrap();
    assert_eq((m.len(), m.is_file(), m.is_dir(), m.is_symlink()), (12u64, true, false, false));
    f.close();

    let f = OpenOptions::new().write(true).open(&p).unwrap();
    f.set_len(3).unwrap();
    let mut f2 = f;
    f2.close();
    assert_eq(fs::read_to_string(&p).unwrap(), String::from("hel"));
    let mut a = OpenOptions::new().append(true).open(&p).unwrap();
    a.write_all(b"+more").unwrap();
    a.close();
    assert_eq(fs::read_to_string(&p).unwrap(), String::from("hel+more"));

    let e = File::open(dir.join("missing")).unwrap_err();
    assert_eq(e.kind(), ErrorKind::NotFound);
    assert(e.raw_os_error().is_some());
    assert_eq(kind(File::create_new(&p)), ErrorKind::AlreadyExists);
    assert_eq(kind(OpenOptions::new().open(&p)), ErrorKind::InvalidInput);
    assert_eq(kind(OpenOptions::new().read(true).truncate(true).open(&p)), ErrorKind::InvalidInput);

    let q = dir.join("rw.bin");
    let mut rw = OpenOptions::new().read(true).write(true).create(true).open(&q).unwrap();
    rw.write_all(b"abcdef").unwrap();
    rw.seek(SeekFrom::Start(3)).unwrap();
    rw.write_all(b"XYZ").unwrap();
    rw.rewind().unwrap();
    let mut all = Vec::new();
    rw.read_to_end(&mut all).unwrap();
    rw.close();
    assert_eq(String::from_utf8(all).unwrap(), String::from("abcXYZ"));
    fs::remove_file(&q).unwrap();

    assert_eq(fs::copy(&p, dir.join("copy.txt")).unwrap(), 8);
    assert_eq(fs::read_to_string(dir.join("copy.txt")).unwrap(), String::from("hel+more"));
    fs::write(dir.join("tmp.txt"), "x").unwrap();
    fs::rename(dir.join("tmp.txt"), dir.join("moved.txt")).unwrap();
    std::os::unix::fs::symlink("f.txt", dir.join("link")).unwrap();
    let mut names: Vec<String> = Vec::new();
    for e in fs::read_dir(&dir).unwrap() {
        let e = e.unwrap();
        let t = e.file_type().unwrap();
        let k = if t.is_symlink() { "symlink" } else if t.is_dir() { "dir" } else { "file" };
        names.push(`${e.file_name()}:${k}`.to_string());
    }
    names.sort();
    assert_eq(`${names:?}`.to_string(), "[\"a:dir\", \"copy.txt:file\", \"f.txt:file\", \"link:symlink\", \"moved.txt:file\"]");
    let link = dir.join("link");
    assert_eq(fs::read_link(&link).unwrap().display().to_string(), String::from("f.txt"));
    assert_eq(fs::read_to_string(&link).unwrap(), String::from("hel+more"));
    assert(fs::symlink_metadata(&link).unwrap().is_symlink());
    let c = fs::canonicalize(dir.join("a/b/../b/c")).unwrap();
    assert(c.is_absolute() && c.as_str().ends_with("/a/b/c"));

    let mut perm = fs::metadata(&p).unwrap().permissions();
    perm.set_readonly(true);
    fs::set_permissions(&p, perm.clone()).unwrap();
    assert(fs::metadata(&p).unwrap().permissions().readonly());
    assert(perm.readonly());
    perm.set_readonly(false);
    fs::set_permissions(&p, perm).unwrap();

    let f = File::options().write(true).open(&p).unwrap();
    f.set_modified(UNIX_EPOCH + Duration::from_secs(1000000000)).unwrap();
    let mut f3 = f;
    f3.close();
    let mt = fs::metadata(&p).unwrap().modified().unwrap();
    assert_eq(mt.duration_since(UNIX_EPOCH).unwrap().as_secs(), 1000000000);
    assert(fs::exists(&p).unwrap());
    assert(!fs::exists(dir.join("nope")).unwrap());
    assert_eq(kind(fs::remove_dir(dir.join("a"))), ErrorKind::DirectoryNotEmpty);
    fs::hard_link(&p, dir.join("hard")).unwrap();
    assert_eq(fs::metadata(&p).unwrap().nlink(), 2);

    fs::remove_dir_all(&dir).unwrap();
    assert(!dir.exists());
}
