// stage0: skip
// std::fs on the OS layer: File, OpenOptions, Metadata, directories, links.
// out: read "hello\nworld\n" 12
// out: seek "world\n" 6
// out: len 12 true false false
// out: set_len "hel"
// out: append "hel+more"
// out: open NotFound true
// out: create_new AlreadyExists
// out: options InvalidInput InvalidInput
// out: rw "abcXYZ"
// out: copy 8 "hel+more"
// out: entries ["a:dir", "copy.txt:file", "f.txt:file", "link:symlink", "moved.txt:file"]
// out: link target "f.txt" "hel+more" true
// out: canonical true
// out: readonly true true
// out: mtime 1000000000
// out: exists true false
// out: remove_dir DirectoryNotEmpty
// out: hard 2
// out: gone false
use std::fs::{self, File, OpenOptions};
use std::io::{ErrorKind, Read, Seek, SeekFrom, Write};
use std::os::unix::fs::MetadataExt;
use std::time::{Duration, UNIX_EPOCH};

fn kind<T>(r: std::io::Result<T>) -> ErrorKind {
    match r {
        Ok(_) => ErrorKind::Other,
        Err(e) => e.kind(),
    }
}

fn main() {
    let dir = std::env::temp_dir().join(`navi-fs-ops-${std::process::id()}`);
    let _ = fs::remove_dir_all(&dir);
    fs::create_dir_all(dir.join("a/b/c")).unwrap();
    let p = dir.join("f.txt");
    fs::write(&p, "hello\nworld\n").unwrap();
    let text = fs::read_to_string(&p).unwrap();
    println(`read ${text:?} ${text.len()}`);

    let mut f = File::open(&p).unwrap();
    let pos = f.seek(SeekFrom::End(-6)).unwrap();
    let mut rest = String::new();
    f.read_to_string(&mut rest).unwrap();
    println(`seek ${rest:?} ${pos}`);
    let m = f.metadata().unwrap();
    println(`len ${m.len()} ${m.is_file()} ${m.is_dir()} ${m.is_symlink()}`);
    f.close();

    let f = OpenOptions::new().write(true).open(&p).unwrap();
    f.set_len(3).unwrap();
    let mut f2 = f;
    f2.close();
    println(`set_len ${fs::read_to_string(&p).unwrap():?}`);
    let mut a = OpenOptions::new().append(true).open(&p).unwrap();
    a.write_all(b"+more").unwrap();
    a.close();
    println(`append ${fs::read_to_string(&p).unwrap():?}`);

    let e = File::open(dir.join("missing")).unwrap_err();
    println(`open ${e.kind():?} ${e.raw_os_error().is_some()}`);
    println(`create_new ${kind(File::create_new(&p)):?}`);
    println(`options ${kind(OpenOptions::new().open(&p)):?} ${kind(OpenOptions::new().read(true).truncate(true).open(&p)):?}`);

    let q = dir.join("rw.bin");
    let mut rw = OpenOptions::new().read(true).write(true).create(true).open(&q).unwrap();
    rw.write_all(b"abcdef").unwrap();
    rw.seek(SeekFrom::Start(3)).unwrap();
    rw.write_all(b"XYZ").unwrap();
    rw.rewind().unwrap();
    let mut all = Vec::new();
    rw.read_to_end(&mut all).unwrap();
    rw.close();
    println(`rw ${String::from_utf8(all).unwrap():?}`);
    fs::remove_file(&q).unwrap();

    println(`copy ${fs::copy(&p, dir.join("copy.txt")).unwrap()} ${fs::read_to_string(dir.join("copy.txt")).unwrap():?}`);
    fs::write(dir.join("tmp.txt"), "x").unwrap();
    fs::rename(dir.join("tmp.txt"), dir.join("moved.txt")).unwrap();
    std::os::unix::fs::symlink("f.txt", dir.join("link")).unwrap();
    let mut names: Vec<String> = Vec::new();
    for e in fs::read_dir(&dir).unwrap() {
        let e = e.unwrap();
        let t = e.file_type().unwrap();
        let k = if t.is_symlink() { "symlink" } else if t.is_dir() { "dir" } else { "file" };
        names.push(`${e.file_name()}:${k}`);
    }
    names.sort();
    println(`entries ${names:?}`);
    let link = dir.join("link");
    println(`link target ${fs::read_link(&link).unwrap().display().to_string():?} ${fs::read_to_string(&link).unwrap():?} ${fs::symlink_metadata(&link).unwrap().is_symlink()}`);
    let c = fs::canonicalize(dir.join("a/b/../b/c")).unwrap();
    println(`canonical ${c.is_absolute() && c.as_str().ends_with("/a/b/c")}`);

    let mut perm = fs::metadata(&p).unwrap().permissions();
    perm.set_readonly(true);
    fs::set_permissions(&p, perm.clone()).unwrap();
    println(`readonly ${fs::metadata(&p).unwrap().permissions().readonly()} ${perm.readonly()}`);
    perm.set_readonly(false);
    fs::set_permissions(&p, perm).unwrap();

    let f = File::options().write(true).open(&p).unwrap();
    f.set_modified(UNIX_EPOCH + Duration::from_secs(1000000000)).unwrap();
    let mut f3 = f;
    f3.close();
    let mt = fs::metadata(&p).unwrap().modified().unwrap();
    println(`mtime ${mt.duration_since(UNIX_EPOCH).unwrap().as_secs()}`);
    println(`exists ${fs::exists(&p).unwrap()} ${fs::exists(dir.join("nope")).unwrap()}`);
    println(`remove_dir ${kind(fs::remove_dir(dir.join("a"))):?}`);
    fs::hard_link(&p, dir.join("hard")).unwrap();
    println(`hard ${fs::metadata(&p).unwrap().nlink()}`);

    fs::remove_dir_all(&dir).unwrap();
    println(`gone ${dir.exists()}`);
}
