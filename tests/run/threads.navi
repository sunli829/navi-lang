// native: skip (threads arrive in native code with M6)
// out: joined 42
// out: sum 4950
// out: got 1 2 3
// out: select: one
fn main() {
    let h = std::thread::spawn(|| 40 + 2);
    println(`joined ${h.join().unwrap()}`);

    let (tx, rx) = std::sync::mpmc::channel::<i32>();
    for w in 0..4 {
        let t = tx.clone();
        std::thread::spawn(|| {
            let mut i = w;
            while i < 100 { t.send(i).unwrap(); i += 4; }
        });
    }
    let mut sum = 0;
    let mut n = 0;
    while n < 100 { sum += rx.recv().unwrap(); n += 1; }
    println(`sum ${sum}`);

    let (tx2, rx2) = std::sync::mpmc::sync_channel::<i32>(0);
    std::thread::spawn(|| { tx2.send(1).unwrap(); tx2.send(2).unwrap(); tx2.send(3).unwrap(); tx2.close(); });
    let mut got = String::from("got");
    for v in rx2.iter() { got.push_str(&` ${v}`); }
    println(got);

    let (a_tx, a_rx) = std::sync::mpmc::channel::<String>();
    let (b_tx, b_rx) = std::sync::mpmc::channel::<i32>();
    a_tx.send(String::from("one")).unwrap();
    select {
        v = a_rx.recv() => println(`select: ${v.unwrap()}`),
        w = b_rx.recv() => println(`select: ${w.unwrap()}`),
    }
}
