// Threads and channels: join a thread's result, many senders to one
// receiver, an unbuffered channel closed by its sender, select.
#[test]
fn join_returns_result() {
    let h = std::thread::spawn(|| 40 + 2);
    assert_eq(h.join().unwrap(), 42);
}

#[test]
fn many_senders_one_receiver() {
    let (tx, rx) = std::sync::mpmc::channel::<i32>();
    for w in 0..4 {
        let t = tx.clone();
        std::thread::spawn(|| {
            let mut i = w;
            while i < 100 {
                t.send(i).unwrap();
                i += 4;
            }
        });
    }
    let mut sum = 0;
    let mut n = 0;
    while n < 100 {
        sum += rx.recv().unwrap();
        n += 1;
    }
    assert_eq(sum, 4950);
}

#[test]
fn unbuffered_channel_iter_until_close() {
    let (tx2, rx2) = std::sync::mpmc::sync_channel::<i32>(0);
    std::thread::spawn(|| {
        tx2.send(1).unwrap();
        tx2.send(2).unwrap();
        tx2.send(3).unwrap();
        tx2.close();
    });
    let got: Vec<i32> = rx2.iter().collect();
    assert_eq(got, Vec::from([1, 2, 3]));
}

#[test]
fn select_takes_ready_channel() {
    let (a_tx, a_rx) = std::sync::mpmc::channel::<String>();
    let (b_tx, b_rx) = std::sync::mpmc::channel::<i32>();
    a_tx.send(String::from("one")).unwrap();
    let got = select {
        v = a_rx.recv() => `a: ${v.unwrap()}`.to_string(),
        w = b_rx.recv() => `b: ${w.unwrap()}`.to_string(),
    };
    assert_eq(got, String::from("a: one"));
}

// try_send: Full when a bounded channel has no room (or an unbuffered one
// no receiver), the value back; Disconnected once closed.
#[test]
fn try_send_full_and_closed() {
    use std::sync::mpmc::{TrySendError, sync_channel};
    let (tx, rx) = sync_channel::<i32>(1);
    assert_eq(tx.try_send(1), Ok(()));
    let e = tx.try_send(2).unwrap_err();
    assert(e.is_full());
    assert_eq(e.to_string(), "sending on a full channel");
    assert_eq(e.into_inner(), 2);
    assert_eq(rx.recv().unwrap(), 1);
    assert_eq(tx.try_send(3), Ok(()));
    tx.close();
    assert_eq(tx.try_send(4), Err(TrySendError::Disconnected(4)));
    let (u, _ur) = sync_channel::<i32>(0);
    assert(u.try_send(5).unwrap_err().is_full());
}

// select's guards: a case whose `if` is false takes no part (as tokio's
// preconditions, Go's nil channel); the guards are evaluated first.
#[test]
fn select_guards() {
    use std::sync::mpmc::channel;
    let (a_tx, a_rx) = channel::<i32>();
    let (b_tx, b_rx) = channel::<i32>();
    a_tx.send(1).unwrap();
    b_tx.send(2).unwrap();
    let mut got = 0;
    // a is ready, but left out: b.
    select {
        v = a_rx.recv() if false => got = v.unwrap(),
        v = b_rx.recv() if 1 + 1 == 2 => got = 10 * v.unwrap(),
    }
    assert_eq(got, 20);
    // Every case left out: the default.
    let mut d = false;
    select {
        v = a_rx.recv() if got < 0 => got = v.unwrap(),
        default => d = true,
    }
    assert(d);
    // A send case's guard; the queue pattern (send only when there is
    // something to send).
    let (out_tx, out_rx) = channel::<i32>();
    let mut queue: Vec<i32> = Vec::from([5, 6]);
    while queue.len() > 0 {
        let x = queue[0];
        select {
            out_tx.send(x) if queue.len() > 0 => {
                queue.remove(0);
            }
        }
    }
    assert_eq(out_rx.recv().unwrap(), 5);
    assert_eq(out_rx.recv().unwrap(), 6);
    assert_eq(a_rx.recv().unwrap(), 1);
}

// The receiving side gone: Receiver::close, or no Receiver left (the
// collector closes it): senders get Disconnected, blocked ones too.
#[test]
fn receivers_gone() {
    use std::sync::mpmc::{SendTimeoutError, TrySendError, channel, sync_channel};
    let (tx, rx) = sync_channel::<i32>(1);
    tx.send(1).unwrap();
    // A sender blocked on the full channel is woken by close.
    let t2 = tx.clone();
    let h = std::thread::spawn(|| t2.send(2));
    std::thread::sleep(std::time::Duration::from_millis(10));
    rx.close();
    assert(h.join().unwrap().is_err());
    assert_eq(tx.try_send(3), Err(TrySendError::Disconnected(3)));
    assert(rx.recv().is_err());
    // No Receiver referred to: closed after a collection. (Made on another
    // thread, which ends: copies of the Receiver's words a frame of this
    // one left on its stack, which the collector scans conservatively in
    // the runtime's frames, would keep it.)
    let tx2 = std::thread::spawn(|| make_sender()).join().unwrap();
    let mut n = 0;
    let mut gone = false;
    while n < 200 && !gone {
        std::gc::collect();
        std::thread::sleep(std::time::Duration::from_millis(5));
        gone = tx2.send(1).is_err();
        n += 1;
    }
    assert(gone);
    assert_eq(
        tx2.send_timeout(4, std::time::Duration::from_secs(5)),
        Err(SendTimeoutError::Disconnected(4)),
    );
    // A Receiver still held keeps it open.
    let (tx3, rx3) = channel::<i32>();
    std::gc::collect();
    std::thread::sleep(std::time::Duration::from_millis(20));
    assert(tx3.send(5).is_ok());
    assert_eq(rx3.recv().unwrap(), 5);
}

#[inline(never)]
fn make_sender() -> std::sync::mpmc::Sender<i32> {
    let (tx, _rx) = std::sync::mpmc::channel::<i32>();
    tx
}
