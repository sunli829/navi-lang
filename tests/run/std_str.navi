// stage0: skip (str, String and char methods added for navic: std hides them from stage0)
// out: ["", "c", "", "b", "a"] ["", "a,b,,c"] ["a", "b", "", "c"] ["one\n", "two\n", "three"]
// out: ["ab", "ab", "ab"] [(2, "c"), (5, "c")] [(6, "ab"), (3, "ab"), (0, "ab")]
// out: bbaa hi hi
// out: ["a", "b", "c"] ["a", "b", "c"]
// out: Some("h") None Some("é") Some("héllo") None
// out: [(5, 'o'), (4, 'l'), (3, 'l'), (1, 'é'), (0, 'h')] [99, 98, 97] 3
// out: STRASSE ÀÉ ΑΒΓ ПРИВЕТ àéî αβγ οδος привет SS true true
// out: HELLO x! true false
// out: hello |world
// out: WorldWorl Some('d')
// out: é 2 true A 97 Ok('A')
// out: true Ok("hi") �i
// out: ab ab true
fn main() {
    let s = "a,b,,c,";
    let r: Vec<&str> = s.rsplit(',').collect();
    let rn: Vec<&str> = s.rsplitn(2, ',').collect();
    let st: Vec<&str> = s.split_terminator(',').collect();
    let si: Vec<&str> = "one\ntwo\nthree".split_inclusive('\n').collect();
    println(`${r:?} ${rn:?} ${st:?} ${si:?}`);
    let m: Vec<&str> = "abcabcab".matches("ab").collect();
    let mi: Vec<(usize, &str)> = "abcabcab".match_indices('c').collect();
    let rmi: Vec<(usize, &str)> = "abcabcab".rmatch_indices("ab").collect();
    println(`${m:?} ${mi:?} ${rmi:?}`);
    println(`${"aaaa".replacen("a", "b", 2)} ${"xxhixx".trim_matches('x')} ${"12hi34".trim_matches(|c: char| c.is_ascii_digit())}`);
    let w: Vec<&str> = "a b;c".split(&[' ', ';']).collect();
    let w2: Vec<&str> = "a b;c".split([' ', ';']).collect();
    println(`${w:?} ${w2:?}`);
    let h = "héllo";
    println(`${h.get(0..1):?} ${h.get(0..2):?} ${h.get(1..3):?} ${h.get(..):?} ${h.split_at_checked(2):?}`);
    let ci: Vec<(usize, char)> = h.char_indices().rev().collect();
    let b: Vec<u8> = "abc".bytes().rev().collect();
    println(`${ci:?} ${b:?} ${"abc".bytes().len()}`);
    println(`${"Straße ÀÉ αβγ привет".to_uppercase()} ${"ÀÉÎ ΑΒΓ ΟΔΟΣ ПРИВЕТ".to_lowercase()} ${'ß'.to_uppercase()} ${'Σ'.is_uppercase()} ${'é'.is_lowercase()}`);
    println(`${"Hello".to_ascii_uppercase()} ${"  x  ".trim_ascii()}! ${"abc".is_ascii()} ${"é".is_ascii()}`);
    let mut t = String::from("hello world");
    let d: String = t.drain(0..6).collect();
    println(`${d}|${t}`);
    t.replace_range(0..1, "W");
    t.extend_from_within(..);
    let popped = t.pop();
    println(`${t} ${popped:?}`);
    let mut buf = [0u8; 4];
    let e = 'é'.encode_utf8(&mut buf);
    println(`${e} ${e.len()} ${'a'.is_digit(16)} ${char::from(65u8)} ${u32::from('a')} ${char::try_from(0x41u32):?}`);
    let x: Result<char, std::char::CharTryFromError> = 0xD800u32.try_into();
    println(`${x.is_err()} ${String::from_utf16(&[0x68, 0x69]):?} ${String::from_utf16_lossy(&[0xD800, 0x69])}`);
    let chars = ['a', 'b'];
    let cs: String = chars.iter().collect();
    let mut c2 = String::new();
    c2.extend(chars.iter());
    println(`${cs} ${c2} ${'\u{2003}'.is_whitespace()}`);
}
