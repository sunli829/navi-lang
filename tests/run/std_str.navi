// str, String and char methods: splitting from the right and with
// terminators, matches, trimming with patterns, checked slicing, Unicode
// case mapping, drain/replace_range/extend_from_within, UTF-8/UTF-16
// conversion, collecting chars.
#[test]
fn split_variants() {
    let s = "a,b,,c,";
    let r: Vec<&str> = s.rsplit(',').collect();
    assert_eq(r, Vec::from(["", "c", "", "b", "a"]));
    let rn: Vec<&str> = s.rsplitn(2, ',').collect();
    assert_eq(rn, Vec::from(["", "a,b,,c"]));
    let st: Vec<&str> = s.split_terminator(',').collect();
    assert_eq(st, Vec::from(["a", "b", "", "c"]));
    let si: Vec<&str> = "one\ntwo\nthree".split_inclusive('\n').collect();
    assert_eq(si, Vec::from(["one\n", "two\n", "three"]));
    let w: Vec<&str> = "a b;c".split(&[' ', ';']).collect();
    let w2: Vec<&str> = "a b;c".split([' ', ';']).collect();
    assert_eq(w, Vec::from(["a", "b", "c"]));
    assert_eq(w2, Vec::from(["a", "b", "c"]));
}

#[test]
fn matches_and_indices() {
    let m: Vec<&str> = "abcabcab".matches("ab").collect();
    assert_eq(m, Vec::from(["ab", "ab", "ab"]));
    let mi: Vec<(usize, &str)> = "abcabcab".match_indices('c').collect();
    assert_eq(mi, Vec::from([(2usize, "c"), (5, "c")]));
    let rmi: Vec<(usize, &str)> = "abcabcab".rmatch_indices("ab").collect();
    assert_eq(rmi, Vec::from([(6usize, "ab"), (3, "ab"), (0, "ab")]));
}

#[test]
fn replacen_and_trim_matches() {
    assert_eq("aaaa".replacen("a", "b", 2), String::from("bbaa"));
    assert_eq("xxhixx".trim_matches('x'), "hi");
    assert_eq("12hi34".trim_matches(|c: char| c.is_ascii_digit()), "hi");
}

#[test]
fn checked_slicing() {
    let h = "héllo";
    assert_eq(h.get(0..1), Some("h"));
    assert_eq(h.get(0..2), None);
    assert_eq(h.get(1..3), Some("é"));
    assert_eq(h.get(..), Some("héllo"));
    assert_eq(`${h.split_at_checked(2):?}`.as_str(), "None");
}

#[test]
fn char_indices_and_bytes() {
    let h = "héllo";
    let ci: Vec<(usize, char)> = h.char_indices().rev().collect();
    assert_eq(ci, Vec::from([(5usize, 'o'), (4, 'l'), (3, 'l'), (1, 'é'), (0, 'h')]));
    let b: Vec<u8> = "abc".bytes().rev().collect();
    assert_eq(b, Vec::from([99u8, 98, 97]));
    assert_eq("abc".bytes().len(), 3);
}

#[test]
fn unicode_case() {
    assert_eq("Straße ÀÉ αβγ привет".to_uppercase(), String::from("STRASSE ÀÉ ΑΒΓ ПРИВЕТ"));
    assert_eq("ÀÉÎ ΑΒΓ ΟΔΟΣ ПРИВЕТ".to_lowercase(), String::from("àéî αβγ οδος привет"));
    assert_eq(`${'ß'.to_uppercase()}`.as_str(), "SS");
    assert('Σ'.is_uppercase());
    assert('é'.is_lowercase());
}

#[test]
fn ascii_methods() {
    assert_eq("Hello".to_ascii_uppercase(), String::from("HELLO"));
    assert_eq("  x  ".trim_ascii(), "x");
    assert("abc".is_ascii());
    assert(!"é".is_ascii());
}

#[test]
fn drain_replace_range_extend_from_within() {
    let mut t = String::from("hello world");
    let d: String = t.drain(0..6).collect();
    assert_eq(d, String::from("hello "));
    assert_eq(t, String::from("world"));
    t.replace_range(0..1, "W");
    t.extend_from_within(..);
    let popped = t.pop();
    assert_eq(t, String::from("WorldWorl"));
    assert_eq(popped, Some('d'));
}

#[test]
fn char_conversions() {
    let mut buf = [0u8; 4];
    let e = 'é'.encode_utf8(&mut buf);
    assert_eq(`${e}`.as_str(), "é");
    assert_eq(e.len(), 2);
    assert('a'.is_digit(16));
    assert_eq(char::from(65u8), 'A');
    assert_eq(u32::from('a'), 97);
    assert_eq(`${char::try_from(0x41u32):?}`.as_str(), "Ok('A')");
    let x: Result<char, std::char::CharTryFromError> = 0xD800u32.try_into();
    assert(x.is_err());
}

#[test]
fn utf16() {
    assert_eq(`${String::from_utf16(&[0x68, 0x69]):?}`.as_str(), "Ok(\"hi\")");
    assert_eq(String::from_utf16_lossy(&[0xD800, 0x69]), String::from("\u{FFFD}i"));
}

#[test]
fn collect_chars() {
    let chars = ['a', 'b'];
    let cs: String = chars.iter().collect();
    let mut c2 = String::new();
    c2.extend(chars.iter());
    assert_eq(cs, String::from("ab"));
    assert_eq(c2, String::from("ab"));
    assert('\u{2003}'.is_whitespace());
}
