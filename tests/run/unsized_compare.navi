// Comparisons whose sides are unsized places ([T], str): compared through
// references to the places (Rust's autoref), as &a[..] == &*r would be.

fn eq_slice(a: [u8; 4], r: &[u8]) -> bool { a[..] == *r }

fn ne_slice(a: &[u8], r: &[u8]) -> bool { *a != *r }

fn lt_str(a: &str, b: &String) -> bool { *a < **b }

#[test]
fn slices_and_strs() {
    let x: [u8; 4] = [1, 2, 3, 4];
    let v: Vec<u8> = vec_of(&[1, 2, 3, 4]);
    let w: Vec<u8> = vec_of(&[1, 2, 3, 5]);
    assert(eq_slice(x, &v));
    assert(!eq_slice(x, &w));
    assert(!ne_slice(&x, &v[..]));
    assert(ne_slice(&x, &v[..3]));
    assert(x[1..3] == v[1..3]);
    assert(x[..] < w[..]);
    assert(w[..] >= x[..]);
    let s = "abc".to_string();
    assert(lt_str("abb", &s));
    assert(!lt_str("abd", &s));
    assert(*"abc" == *s.as_str());
    assert(s[1..] == *"bc");
}

fn vec_of(b: &[u8]) -> Vec<u8> { b.to_vec() }
