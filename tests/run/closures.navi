// Closures: captured by reference, a new loop variable each iteration,
// passed as fn values.
fn apply(f: fn(i32) -> i32, x: i32) -> i32 { f(x) }

fn make_adder(n: i32) -> fn(i32) -> i32 { |x| x + n }

#[test]
fn returned_closure_keeps_its_capture() {
    let add10 = make_adder(10);
    assert_eq(apply(add10, 1), 11);
}

#[test]
fn closure_mutates_captured_local() {
    let mut count = 0;
    let mut inc = || { count += 1; };
    inc(); inc(); inc();
    assert_eq(count, 3);
}

#[test]
fn loop_variable_is_new_each_iteration() {
    let mut fs: Vec<fn() -> i32> = Vec::new();
    for i in 0..3 { fs.push(|| i); }
    assert_eq((fs[0](), fs[1](), fs[2]()), (0, 1, 2));
}

#[test]
fn closure_in_iterator_adapter() {
    let sq: Vec<i32> = [1, 2, 3].iter().map(|x| x * x).collect();
    assert_eq(sq, Vec::from([1, 4, 9]));
}
