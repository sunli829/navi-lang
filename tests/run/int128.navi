// i128 and u128: arithmetic beyond 64 bits, Display and hex formatting,
// shifts, casts to and from 64-bit integers and floats, match on ranges,
// derives, hashing, checked/wrapping operations and overflow panics.
fn fact(n: u32) -> u128 {
    let mut r: u128 = 1;
    let mut i = 1u32;
    while i <= n {
        r = r * (i as u128);
        i += 1;
    }
    r
}

fn classify(x: i128) -> &str {
    match x {
        -1 => "minus one",
        0 => "zero",
        1..=9 => "digit",
        _ => "other",
    }
}

#[derive(Debug, Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]
struct Big { id: u128, delta: i128 }

fn vec_of() -> Vec<Big> {
    let mut v = Vec::new();
    v.push(Big { id: 3, delta: -2 });
    v.push(Big { id: 1, delta: 5 });
    v.push(Big { id: 2, delta: 0 });
    v
}

#[test]
fn display_of_wide_values() {
    let a: u128 = 18446744073709551615;
    let b = a + 1;
    assert_eq(`${b}`.as_str(), "18446744073709551616");
    assert_eq(`${fact(30)}`.as_str(), "265252859812191058636308480000000");
    assert_eq(`${u128::MAX}`.as_str(), "340282366920938463463374607431768211455");
    assert_eq(`${i128::MIN} ${i128::MAX}`.as_str(), "-170141183460469231731687303715884105728 170141183460469231731687303715884105727");
}

#[test]
fn arithmetic_shifts_and_hex() {
    let a: u128 = 18446744073709551615;
    let b = a + 1;
    let x: i128 = -12345678901234567890;
    assert_eq(`${x} ${x * x} ${x / 7} ${x % 7}`.as_str(), "-12345678901234567890 152415787532388367501905199875019052100 -1763668414462081127 -1");
    assert_eq(`${b >> 3} ${(b << 10) | 5} ${b:x} ${-x:#X}`.as_str(), "2305843009213693952 18889465931478580854789 10000000000000000 0xAB54A98CEB1F0AD2");
}

#[test]
fn casts() {
    let a: u128 = 18446744073709551615;
    let b = a + 1;
    let x: i128 = -12345678901234567890;
    assert_eq(`${a as u64} ${(b - 1) as u64} ${(x as i64)} ${(-5i32 as i128) * 3}`.as_str(), "18446744073709551615 18446744073709551615 6101065172474983726 -15");
    let f = (b as f64) * 2.0;
    assert_eq(`${f} ${(1e30 as u128)} ${(-1e20 as i128)}`.as_str(), "36893488147419103000 1000000000000000019884624838656 -100000000000000000000");
}

#[test]
fn match_and_comparisons() {
    let a: u128 = 18446744073709551615;
    let b = a + 1;
    let x: i128 = -12345678901234567890;
    assert_eq(`${classify(-1)} ${classify(0)} ${classify(7)} ${classify(x)}`.as_str(), "minus one zero digit other");
    assert(fact(34) > fact(33));
    assert(x < 0);
    assert(b == a + 1);
    assert(b != a);
}

#[test]
fn checked_wrapping_and_pow() {
    assert(u128::MAX.checked_add(1).is_none());
    assert(i128::MAX.wrapping_add(1) == i128::MIN);
    assert_eq(`${(7u128).pow(40)}`.as_str(), "6366805760909027985741435139224001");
}

#[test]
fn derives_and_hash_keys() {
    let mut v = vec_of();
    v.sort();
    assert_eq(`${v:?}`.as_str(), "[Big { id: 1, delta: 5 }, Big { id: 2, delta: 0 }, Big { id: 3, delta: -2 }]");
    let b: u128 = 18446744073709551616;
    let mut m = std::collections::HashMap::new();
    m.insert(b, "two to the 64");
    assert_eq(m[&b], "two to the 64");
}

#[test]
fn overflow_panics() {
    let r = std::panic::catch_unwind(|| u128::MAX + 1);
    assert(r.is_err());
}
