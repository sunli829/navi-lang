// out: 18446744073709551616
// out: 265252859812191058636308480000000
// out: 340282366920938463463374607431768211455
// out: -170141183460469231731687303715884105728 170141183460469231731687303715884105727
// out: -12345678901234567890 152415787532388367501905199875019052100 -1763668414462081127 -1
// out: 2305843009213693952 18889465931478580854789 10000000000000000 0xAB54A98CEB1F0AD2
// out: 18446744073709551615 18446744073709551615 6101065172474983726 -15
// out: minus one zero digit other
// out: true true true true
// out: 36893488147419103000 1000000000000000019884624838656 -100000000000000000000
// out: true true 6366805760909027985741435139224001
// out: [Big { id: 1, delta: 5 }, Big { id: 2, delta: 0 }, Big { id: 3, delta: -2 }]
// out: two to the 64
// out: overflow caught: true
fn fact(n: u32) -> u128 {
    let mut r: u128 = 1;
    let mut i = 1u32;
    while i <= n {
        r = r * (i as u128);
        i += 1;
    }
    r
}

fn classify(x: i128) -> &str {
    match x {
        -1 => "minus one",
        0 => "zero",
        1..=9 => "digit",
        _ => "other",
    }
}

#[derive(Debug, Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]
struct Big { id: u128, delta: i128 }

fn main() {
    let a: u128 = 18446744073709551615;
    let b = a + 1;
    println(`${b}`);
    println(`${fact(30)}`);
    println(`${u128::MAX}`);
    println(`${i128::MIN} ${i128::MAX}`);
    let x: i128 = -12345678901234567890;
    println(`${x} ${x * x} ${x / 7} ${x % 7}`);
    println(`${b >> 3} ${(b << 10) | 5} ${b:x} ${-x:#X}`);
    println(`${a as u64} ${(b - 1) as u64} ${(x as i64)} ${(-5i32 as i128) * 3}`);
    println(`${classify(-1)} ${classify(0)} ${classify(7)} ${classify(x)}`);
    println(`${fact(34) > fact(33)} ${x < 0} ${b == a + 1} ${b != a}`);
    let f = (b as f64) * 2.0;
    println(`${f} ${(1e30 as u128)} ${(-1e20 as i128)}`);
    println(`${u128::MAX.checked_add(1).is_none()} ${i128::MAX.wrapping_add(1) == i128::MIN} ${(7u128).pow(40)}`);
    let mut v = vec_of();
    v.sort();
    println(`${v:?}`);
    let mut m = std::collections::HashMap::new();
    m.insert(b, "two to the 64");
    println(`${m[&b]}`);
    let r = std::panic::catch_unwind(|| u128::MAX + 1);
    println(`overflow caught: ${r.is_err()}`);
}

fn vec_of() -> Vec<Big> {
    let mut v = Vec::new();
    v.push(Big { id: 3, delta: -2 });
    v.push(Big { id: 1, delta: 5 });
    v.push(Big { id: 2, delta: 0 });
    v
}
