// std::cli's derives (clap's): Parser, Args, Subcommand, ValueEnum; the
// field types' meaning, attributes, /// comments as help, errors.

use std::cli::{Parser, Subcommand, ValueEnum, Args, CommandFactory, ErrorKind};

/// A tool that copies things.
///
/// More text about it.
#[derive(Parser, Debug)]
#[command(name = "tool", version = "1.2.3")]
struct Cli {
    /// Say more.
    #[arg(short, long)]
    verbose: bool,
    /// The port
    #[arg(short, long, default_value = "8080")]
    port: u16,
    #[arg(long, value_enum)]
    mode: Option<Mode>,
    #[arg(short = 'I', long = "include")]
    includes: Vec<String>,
    #[arg(short, action = std::cli::ArgAction::Count)]
    quiet: u8,
    #[arg(skip)]
    extra: i32,
    #[command(subcommand)]
    cmd: Cmd,
}

#[derive(Subcommand, Debug, PartialEq)]
enum Cmd {
    /// Builds it
    Build {
        #[arg(short)]
        o: Option<String>,
        files: Vec<String>,
    },
    /// Runs tests
    Test(TestArgs),
    #[command(name = "rm")]
    Clean,
}

#[derive(Args, Debug, PartialEq)]
struct TestArgs {
    #[arg(long, default_value = "10m")]
    timeout: String,
    filter: Option<String>,
}

#[derive(ValueEnum, Debug, Clone, PartialEq)]
enum Mode {
    Fast,
    SlowAndSafe,
    #[value(name = "x")]
    Other,
}

fn parse(args: &[&str]) -> Result<Cli, std::cli::Error> {
    let mut v: Vec<String> = Vec::from(["tool".to_string()]);
    for a in args.iter() { v.push(a.to_string()); }
    Cli::try_parse_from(v)
}

#[test]
fn values_by_field_type() {
    let c = parse(&["-v", "-p", "9000", "--mode", "slow-and-safe", "-I", "x", "--include", "y", "-qqq", "build", "-o", "out", "f1", "f2"]).unwrap();
    assert(c.verbose);
    assert_eq(c.port, 9000u16);
    assert_eq(c.mode, Some(Mode::SlowAndSafe));
    assert_eq(c.includes, Vec::from(["x".to_string(), "y".to_string()]));
    assert_eq(c.quiet, 3u8);
    assert_eq(c.extra, 0);
    assert_eq(c.cmd, Cmd::Build { o: Some("out".to_string()), files: Vec::from(["f1".to_string(), "f2".to_string()]) });
    let d = parse(&["test", "abc"]).unwrap();
    assert(!d.verbose);
    assert_eq(d.port, 8080u16);
    assert_eq(d.mode, None);
    assert_eq(d.cmd, Cmd::Test(TestArgs { timeout: "10m".to_string(), filter: Some("abc".to_string()) }));
    assert_eq(parse(&["--mode", "x", "rm"]).unwrap().cmd, Cmd::Clean);
}

#[test]
fn errors() {
    assert_eq(parse(&["--mode", "bad", "rm"]).unwrap_err().kind(), ErrorKind::InvalidValue);
    assert_eq(parse(&["-p", "99999", "rm"]).unwrap_err().kind(), ErrorKind::InvalidValue);
    assert_eq(parse(&["--nope", "rm"]).unwrap_err().kind(), ErrorKind::UnknownArgument);
    assert_eq(parse(&["frobnicate"]).unwrap_err().kind(), ErrorKind::InvalidSubcommand);
    assert_eq(parse(&["--version"]).unwrap_err().render(), "tool 1.2.3\n");
}

#[test]
fn help_from_doc_comments() {
    let h = Cli::command().render_help();
    assert_msg(h.starts_with("A tool that copies things.\n"), h.clone());
    assert_msg(h.contains("  build  Builds it\n"), h.clone());
    assert_msg(h.contains("  test   Runs tests\n"), h.clone());
    assert_msg(h.contains("  rm"), h.clone());
    assert_msg(h.contains("-v, --verbose"), h.clone());
    assert_msg(h.contains("Say more\n"), h.clone());
    assert_msg(h.contains("-p, --port <PORT>"), h.clone());
    assert_msg(h.contains("The port [default: 8080]"), h.clone());
    assert_msg(h.contains("[possible values: fast, slow-and-safe, x]"), h.clone());
}

#[test]
fn value_enum_from_str_and_display() {
    assert_eq("slow-and-safe".parse::<Mode>(), Ok(Mode::SlowAndSafe));
    assert(("nope".parse::<Mode>()).is_err());
    assert_eq(Mode::Other.to_string(), "x");
    assert_eq(<Mode as ValueEnum>::value_names(), Vec::from(["fast", "slow-and-safe", "x"]));
}

// last (only what follows "--"), trailing_var_arg, allow_hyphen_values,
// hidden subcommands.
#[derive(Parser, Debug)]
#[command(name = "runner")]
struct Runner {
    #[command(subcommand)]
    cmd: RunCmd,
}

#[derive(Subcommand, Debug, PartialEq)]
enum RunCmd {
    /// Runs a program
    Run {
        #[arg(short)]
        p: Option<String>,
        path: Option<String>,
        /// The program's arguments
        #[arg(last)]
        args: Vec<String>,
    },
    #[command(hide, trailing_var_arg)]
    Debug {
        #[arg(allow_hyphen_values)]
        rest: Vec<String>,
    },
}

fn run_parse(args: &[&str]) -> Result<Runner, std::cli::Error> {
    let mut v: Vec<String> = Vec::from(["runner".to_string()]);
    for a in args.iter() { v.push(a.to_string()); }
    Runner::try_parse_from(v)
}

#[test]
fn last_trailing_and_hidden() {
    let r = run_parse(&["run", "-p", "x", "dir", "--", "-a", "--b", "c"]).unwrap();
    assert_eq(r.cmd, RunCmd::Run { p: Some("x".to_string()), path: Some("dir".to_string()), args: Vec::from(["-a".to_string(), "--b".to_string(), "c".to_string()]) });
    let r = run_parse(&["run", "--", "only"]).unwrap();
    assert_eq(r.cmd, RunCmd::Run { p: None, path: None, args: Vec::from(["only".to_string()]) });
    // (Not after "--": a second positional is an error.)
    assert(run_parse(&["run", "dir", "extra"]).is_err());
    let r = run_parse(&["debug", "-x", "file", "--y", "-z"]).unwrap();
    assert_eq(r.cmd, RunCmd::Debug { rest: Vec::from(["-x".to_string(), "file".to_string(), "--y".to_string(), "-z".to_string()]) });
    let h = Runner::command().render_help();
    assert_msg(h.contains("  run ") && !h.contains("debug"), h.clone());
    let sub = run_parse(&["run", "--help"]).err().unwrap().render();
    assert_msg(sub.contains("[PATH] [-- <ARGS>...]"), sub.clone());
}
