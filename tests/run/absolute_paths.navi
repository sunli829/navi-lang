// ::crate::... paths: from a crate's root whatever the module calls that
// name (a local module std here), in expressions, types, patterns and use.

mod std {
    pub fn max(a: i32, b: i32) -> i32 { a - b }
}

mod inner {
    pub fn f() -> i32 { 7 }
}

use ::std::collections::HashMap;

fn first(x: ::std::option::Option<i32>) -> i32 {
    match x {
        ::std::option::Option::Some(v) => v,
        _ => 0,
    }
}

#[test]
fn rooted_paths() {
    assert_eq(::std::cmp::max(1, 2), 2);
    assert_eq(std::max(1, 2), -1);
    assert_eq(first(Some(5)), 5);
    let mut m: HashMap<i32, i32> = HashMap::new();
    m.insert(1, 2);
    assert_eq(m[&1], 2);
    assert_eq(::absolute_paths::inner::f(), 7);
}
