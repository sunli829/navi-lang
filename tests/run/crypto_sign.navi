// Signing: keys made by Go 1.26 in every PEM form (PKCS#8, PKCS#1, SEC 1)
// parse to the same keys; RSA PKCS#1 v1.5 signatures equal Go's (they are
// deterministic); Go's ECDSA signatures verify under the parsed keys'
// public halves; our ECDSA and PSS signatures verify, and fail for another
// message.

use std::crypto::Digest;
use std::crypto::rsa::{Pkcs1v15Sign, Pss, RsaPublicKey};
use std::crypto::sha2::{Sha256, Sha384};
use std::crypto::x509::{self, PrivateKey};
use std::crypto::{p256, p384};
use std::hex;

const MSG: &[u8] = b"navi signs this";

fn rsa_key(pem: &str) -> std::crypto::rsa::RsaPrivateKey {
    match x509::parse_private_key_pem(pem.as_bytes()).unwrap() {
        PrivateKey::Rsa(k) => k,
        _ => panic("not RSA"),
    }
}

#[test]
fn rsa() {
    let k8 = rsa_key(RSA_PKCS8);
    let k1 = rsa_key(RSA_PKCS1);
    assert(k8.d() == k1.d());
    let public = RsaPublicKey::from_pkcs1_der(std::pem::parse(RSA_PUBLIC).unwrap().contents()).unwrap();
    assert(k8.to_public_key().n() == public.n());
    let h = Sha256::digest(MSG);
    let s = k8.sign(Pkcs1v15Sign::new::<Sha256>(), h.as_slice()).unwrap();
    assert_eq(hex::encode(&s), RSA_V15_SHA256.to_string());
    let h384 = Sha384::digest(MSG);
    assert_eq(hex::encode(&k1.sign(Pkcs1v15Sign::new::<Sha384>(), h384.as_slice()).unwrap()), RSA_V15_SHA384.to_string());
    // PSS: random salts, so two signatures differ; both verify.
    let a = k8.sign(Pss::new::<Sha256>(), h.as_slice()).unwrap();
    let b = k8.sign(Pss::new::<Sha256>(), h.as_slice()).unwrap();
    assert(a != b);
    assert(public.verify(Pss::new::<Sha256>(), h.as_slice(), a.as_slice()).is_ok());
    assert(public.verify(Pss::new::<Sha256>(), h.as_slice(), b.as_slice()).is_ok());
    let other = Sha256::digest(b"another message");
    assert(public.verify(Pss::new::<Sha256>(), other.as_slice(), a.as_slice()).is_err());
}

#[test]
fn ecdsa() {
    // P-256: both encodings, the public key, Go's signature, ours.
    let (a, b) = match (x509::parse_private_key_pem(P256_PKCS8.as_bytes()).unwrap(), x509::parse_private_key_pem(P256_SEC1.as_bytes()).unwrap()) {
        (PrivateKey::P256(a), PrivateKey::P256(b)) => (a, b),
        _ => panic("not P-256"),
    };
    assert(a.to_bytes() == b.to_bytes());
    let vk = a.verifying_key();
    assert_eq(hex::encode(&vk.to_sec1_bytes()), P256_PUBLIC.to_string());
    let h = Sha256::digest(MSG);
    let go_sig = p256::ecdsa::Signature::from_der(hex::decode(P256_SIG).unwrap().as_slice()).unwrap();
    assert(vk.verify_prehash(h.as_slice(), &go_sig).is_ok());
    let mine = a.sign(MSG);
    assert(vk.verify(MSG, &mine).is_ok());
    assert(vk.verify(b"another message", &mine).is_err());
    // DER round trip.
    assert(p256::ecdsa::Signature::from_der(mine.to_der().as_slice()).unwrap() == mine);
    // P-384.
    let (c, d) = match (x509::parse_private_key_pem(P384_PKCS8.as_bytes()).unwrap(), x509::parse_private_key_pem(P384_SEC1.as_bytes()).unwrap()) {
        (PrivateKey::P384(c), PrivateKey::P384(d)) => (c, d),
        _ => panic("not P-384"),
    };
    assert(c.to_bytes() == d.to_bytes());
    let vk3 = c.verifying_key();
    assert_eq(hex::encode(&vk3.to_sec1_bytes()), P384_PUBLIC.to_string());
    let h3 = Sha384::digest(MSG);
    let go3 = p384::ecdsa::Signature::from_der(hex::decode(P384_SIG).unwrap().as_slice()).unwrap();
    assert(vk3.verify_prehash(h3.as_slice(), &go3).is_ok());
    let mine3 = c.sign_prehash(h3.as_slice()).unwrap();
    assert(vk3.verify_prehash(h3.as_slice(), &mine3).is_ok());
    // Random keys.
    let r = p256::ecdsa::SigningKey::random();
    assert(r.verifying_key().verify(MSG, &r.sign(MSG)).is_ok());
}

#[test]
fn bad_keys() {
    assert(x509::parse_private_key_pem(b"no key here").is_err());
    let mut der = std::pem::parse(P256_SEC1).unwrap().contents().to_vec();
    der[7] = der[7] ^ 0xff;
    let _ = x509::parse_ec_private_key(der.as_slice());
    assert(p256::ecdsa::SigningKey::from_bytes(&[0u8; 32]).is_err());
}

