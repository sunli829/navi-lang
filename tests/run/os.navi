// std::env, std::fs and std::path: process arguments, creating, reading and
// removing files, path components, environment variables, a BufWriter.
use std::fs;
use std::path::{Path, PathBuf};
use std::env;
use std::io::Write;

#[test]
fn args_has_program_name() {
    // navi test passes test-name filters as further arguments, so only the
    // program name is certain.
    let args: Vec<String> = env::args().collect();
    assert(args.len() >= 1);
    assert(!args[0].is_empty());
}

#[test]
fn create_read_remove_files() {
    let dir = env::temp_dir().join("navi-os-golden");
    fs::create_dir_all(dir.join("a/b")).unwrap();
    let file = dir.join("a/b/hello.txt");
    fs::write(&file, "hello\nworld\n").unwrap();
    let text = fs::read_to_string(&file).unwrap();
    assert_eq(text.len(), 12);
    assert_eq(text.lines().count(), 2);
    assert(file.exists());
    assert(file.is_file());
    assert(dir.is_dir());
    fs::remove_file(&file).unwrap();
    assert(!file.exists());
    assert(fs::read_to_string(&file).is_err());
}

#[test]
fn path_components() {
    let p = Path::new("x/y/z.navi");
    assert_eq(`${p.file_name():?} ${p.extension():?} ${p.file_stem():?} ${p.parent():?}`.to_string().as_str(), "Some(\"z.navi\") Some(\"navi\") Some(\"z\") Some(\"x/y\")");
    let mut o = PathBuf::from("out/prog.o");
    o.set_extension("exe");
    assert_eq(`${o.display()}`.to_string().as_str(), "out/prog.exe");
    assert_eq(`${Path::new("a").join("b").join("/abs").display()}`.to_string().as_str(), "/abs");
}

#[test]
fn unset_env_var() {
    assert_eq(`${env::var("NAVI_SURELY_UNSET_VAR"):?}`.to_string().as_str(), "Err(NotPresent)");
}

#[test]
fn buf_writer() {
    let mut out = std::io::BufWriter::new(Vec::new());
    out.write_all(b"buffered\n").unwrap();
    out.flush().unwrap();
    assert_eq(out.get_ref().clone(), b"buffered\n".to_vec());
}
