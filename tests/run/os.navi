// out: args 1
// out: read 12 2 true true true
// out: Some("z.navi") Some("navi") Some("z") Some("x/y")
// out: out/prog.exe /abs
// out: removed false true
// out: Err(NotPresent)
// out: buffered
use std::fs;
use std::path::{Path, PathBuf};
use std::env;
use std::io::Write;

fn main() {
    println(`args ${env::args().count()}`);
    let dir = env::temp_dir().join("navi-os-golden");
    fs::create_dir_all(dir.join("a/b")).unwrap();
    let file = dir.join("a/b/hello.txt");
    fs::write(&file, "hello\nworld\n").unwrap();
    let text = fs::read_to_string(&file).unwrap();
    println(`read ${text.len()} ${text.lines().count()} ${file.exists()} ${file.is_file()} ${dir.is_dir()}`);
    let p = Path::new("x/y/z.navi");
    println(`${p.file_name():?} ${p.extension():?} ${p.file_stem():?} ${p.parent():?}`);
    let mut o = PathBuf::from("out/prog.o");
    o.set_extension("exe");
    println(`${o.display()} ${Path::new("a").join("b").join("/abs").display()}`);
    fs::remove_file(&file).unwrap();
    println(`removed ${file.exists()} ${fs::read_to_string(&file).is_err()}`);
    println(`${env::var("NAVI_SURELY_UNSET_VAR"):?}`);
    let mut out = std::io::BufWriter::new(std::io::stdout());
    out.write_all(b"buffered\n").unwrap();
    out.flush().unwrap();
}
