// std::crypto::rsa against signatures made by Go's crypto/rsa (the
// constants at the end): PKCS#1 v1.5 and PSS, SHA-1 and SHA-2, 2048 and
// 3072-bit keys.

use std::crypto::rsa::{RsaPublicKey, Pkcs1v15Sign, Pss, SignatureScheme};
use std::crypto::sha1::Sha1;
use std::crypto::sha2::{Sha256, Sha384, Sha512};
use std::hex;

fn h(s: &str) -> Vec<u8> { hex::decode(s).unwrap() }

fn scheme(hash: &str, kind: &str) -> (Pkcs1v15Sign, Pss) {
    // (The v15 scheme and the PSS one of the hash; kind picks the salt.)
    // (pssmax: Go's PSSSaltLengthAuto, the longest salt that fits.)
    let salt: Option<usize> = if kind.starts_with("pss") && kind != "pssmax" { Some(kind[3..].parse::<usize>().unwrap()) } else { None };
    match hash {
        "1" => (Pkcs1v15Sign::new::<Sha1>(), match salt { Some(s) => Pss::new_with_salt::<Sha1>(s), None => Pss::new::<Sha1>() }),
        "256" => (Pkcs1v15Sign::new::<Sha256>(), match salt { Some(s) => Pss::new_with_salt::<Sha256>(s), None => Pss::new::<Sha256>() }),
        "384" => (Pkcs1v15Sign::new::<Sha384>(), match salt { Some(s) => Pss::new_with_salt::<Sha384>(s), None => Pss::new::<Sha384>() }),
        _ => (Pkcs1v15Sign::new::<Sha512>(), match salt { Some(s) => Pss::new_with_salt::<Sha512>(s), None => Pss::new::<Sha512>() }),
    }
}

fn any_salt(hash: &str) -> Pss {
    match hash {
        "1" => Pss::new_with_any_salt::<Sha1>(),
        "256" => Pss::new_with_any_salt::<Sha256>(),
        "384" => Pss::new_with_any_salt::<Sha384>(),
        _ => Pss::new_with_any_salt::<Sha512>(),
    }
}

#[test]
fn against_go() {
    for v in RSA.iter() {
        let f: Vec<&str> = v.split(' ').collect();
        let key = RsaPublicKey::from_pkcs1_der(h(f[0]).as_slice()).unwrap();
        let hashed = h(f[3]);
        let sig = h(f[4]);
        let (v15, pss0) = scheme(f[1], f[2]);
        let pss = if f[2] == "pssmax" { any_salt(f[1]) } else { pss0 };
        let mut bad = sig.clone();
        bad[10] = bad[10] ^ 1;
        let mut other = hashed.clone();
        other[0] = other[0] ^ 1;
        if f[2] == "v15" {
            assert(key.verify(v15.clone(), hashed.as_slice(), sig.as_slice()).is_ok());
            assert(key.verify(v15.clone(), hashed.as_slice(), bad.as_slice()).is_err());
            assert(key.verify(v15.clone(), other.as_slice(), sig.as_slice()).is_err());
            // Not a PSS signature.
            assert(key.verify(any_salt(f[1]), hashed.as_slice(), sig.as_slice()).is_err());
        } else {
            assert(key.verify(pss.clone(), hashed.as_slice(), sig.as_slice()).is_ok());
            assert(key.verify(any_salt(f[1]), hashed.as_slice(), sig.as_slice()).is_ok());
            assert(key.verify(pss.clone(), hashed.as_slice(), bad.as_slice()).is_err());
            assert(key.verify(pss.clone(), other.as_slice(), sig.as_slice()).is_err());
            if f[2] != "pssmax" {
                // The salt's length is checked.
                let n = f[2][3..].parse::<usize>().unwrap();
                let kind = `pss${n + 1}`.to_string();
                let (_, wrong) = scheme(f[1], kind.as_str());
                assert(key.verify(wrong, hashed.as_slice(), sig.as_slice()).is_err());
            }
            assert(key.verify(v15.clone(), hashed.as_slice(), sig.as_slice()).is_err());
        }
    }
}

#[test]
fn bad_keys_and_lengths() {
    assert(RsaPublicKey::from_be_bytes(&[0xffu8; 64], &[1, 0, 1]).is_ok());
    assert(RsaPublicKey::from_be_bytes(&[0xfeu8; 64], &[1, 0, 1]).is_err());   // even
    assert(RsaPublicKey::from_be_bytes(&[0xffu8; 32], &[1, 0, 1]).is_err());   // short
    assert(RsaPublicKey::from_be_bytes(&[0xffu8; 64], &[2]).is_err());         // even e
    assert(RsaPublicKey::from_pkcs1_der(&[0x30, 0x00]).is_err());
    let f: Vec<&str> = RSA[0].split(' ').collect();
    let key = RsaPublicKey::from_pkcs1_der(h(f[0]).as_slice()).unwrap();
    assert_eq(key.size(), 256);
    assert_eq(key.e().to_vec(), vec_of(&[1, 0, 1]));
    // A signature of the wrong length or not below n.
    let short: Vec<u8> = h(f[4])[1..].to_vec();
    assert(key.verify(Pkcs1v15Sign::new::<Sha256>(), h(f[3]).as_slice(), short.as_slice()).is_err());
    let big: Vec<u8> = vec_of(&[0xffu8; 256]);
    assert(key.verify(Pkcs1v15Sign::new::<Sha256>(), h(f[3]).as_slice(), big.as_slice()).is_err());
}

fn vec_of(b: &[u8]) -> Vec<u8> { b.to_vec() }

// Generated by Go 1.26's crypto/rsa: PKCS#1 public key DER, hash (1 SHA-1, 256, 384, 512), scheme (v15 or pss<salt>), message hash, signature.
const RSA: [&str; 16] = [
    " 256 v15 e3a65f918d4443f475b9d70e5901f4c2a28470c5e077eb20d1dce74bea2e0d80 ",
    " 256 pss32 e3a65f918d4443f475b9d70e5901f4c2a28470c5e077eb20d1dce74bea2e0d80 ",
    " 384 v15 79f773025fe0ab36dc5bc9c8b3c0dd94cf2f9917cfa1a27d10aee38d7f26de1297e6204b44d642cac511811b56fd2eef ",
    " 384 pss48 79f773025fe0ab36dc5bc9c8b3c0dd94cf2f9917cfa1a27d10aee38d7f26de1297e6204b44d642cac511811b56fd2eef ",
    " 512 v15 c4eea2f8137833fa169fd43c3c930b0c6c34dcb56d6747225157f076ef9f4eb160e583cb2fea737a6fb2b880c1f919063d8d7fa7755fcdab68ed405af4593248 ",
    " 512 pss20 c4eea2f8137833fa169fd43c3c930b0c6c34dcb56d6747225157f076ef9f4eb160e583cb2fea737a6fb2b880c1f919063d8d7fa7755fcdab68ed405af4593248 ",
    " 1 v15 e5fa60c1c37f44014dbd6fe6b76a64d88e5a1bd5 ",
    " 1 pssmax e5fa60c1c37f44014dbd6fe6b76a64d88e5a1bd5 ",
    " 256 v15 c8fc8ce14530be0e3fa1af4485ef643bc78a1c51c268fc020478189b508b180e ",
    " 256 pss32 c8fc8ce14530be0e3fa1af4485ef643bc78a1c51c268fc020478189b508b180e ",
    " 384 v15 0b4141b15ea6d316323f2d9d6f4b06244e8084561bc9bd4618d40a9e98baeaade296990312ab9fc9cbeae070f3ef67d8 ",
    " 384 pss48 0b4141b15ea6d316323f2d9d6f4b06244e8084561bc9bd4618d40a9e98baeaade296990312ab9fc9cbeae070f3ef67d8 ",
    " 512 v15 c998f89a5f1d3456661ea1d6c13f2eecec0b3d7f8ee1739e1b3f5c508a6f023273fa27d7bda8242afe968b79caaad9f28ea8628adc448594872af10d9642f487 ",
    " 512 pss20 c998f89a5f1d3456661ea1d6c13f2eecec0b3d7f8ee1739e1b3f5c508a6f023273fa27d7bda8242afe968b79caaad9f28ea8628adc448594872af10d9642f487 ",
    " 1 v15 a53681092420a6f0503ae318e5ee44388d712c46 ",
    " 1 pssmax a53681092420a6f0503ae318e5ee44388d712c46 ",
];
