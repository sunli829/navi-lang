// #[asm] functions (compiler/src/asm): asm_arm64.s and asm_amd64.s next to
// this file define them.

#[asm]
fn add3(a: i64, b: i64, c: i64) -> i64;

#[asm]
fn sum_bytes(p: *const u8, n: usize) -> u64;

// One AES round without its round key: MixColumns(ShiftRows(SubBytes(
// state ^ key))), in place.
#[asm]
fn aes_round(state: *mut u8, key: *const u8);

// (k1 ^ k2) & 0xff00ff00ff00ff00, the two from the function's constants.
#[asm]
fn consts() -> u64;

#[test]
fn arguments_and_result() {
    assert_eq(add3(1, 2, 3), 6);
    assert_eq(add3(-10, 4, 1), -5);
}

#[test]
fn loops_and_labels() {
    let v: Vec<u8> = vec_of(300);
    let mut want = 0u64;
    for b in v.iter() { want += *b as u64; }
    assert_eq(sum_bytes(v.as_ptr(), v.len()), want);
    assert_eq(sum_bytes(v.as_ptr(), 0), 0);
}

fn vec_of(n: usize) -> Vec<u8> {
    let mut v: Vec<u8> = Vec::new();
    let mut i = 0;
    while i < n {
        v.push((i * 7 + 3) as u8);
        i += 1;
    }
    v
}

fn hex(s: &str) -> Vec<u8> {
    let mut v: Vec<u8> = Vec::new();
    let b = s.as_bytes();
    let mut i = 0;
    while i + 1 < b.len() {
        v.push(u8::from_str_radix(&s[i..i + 2], 16).unwrap());
        i += 2;
    }
    v
}

#[test]
fn aes() {
    // FIPS-197 appendix B: the input and the first round key, and the
    // state after round 1's MixColumns.
    let mut state = hex("3243f6a8885a308d313198a2e0370734");
    let key = hex("2b7e151628aed2a6abf7158809cf4f3c");
    aes_round(state.as_mut_ptr(), key.as_ptr());
    assert_eq(state, hex("046681e5e0cb199a48f8d37a2806264c"));
}

#[test]
fn constants() {
    assert_eq(consts(), 0x1d0059009f00c200);
}
