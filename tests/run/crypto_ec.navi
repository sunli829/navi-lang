// std::crypto::p256 and p384 (ECDSA verification, ECDH) against outputs of
// Go's crypto/ecdsa and crypto/ecdh (the constants at the end).

use std::crypto::p256;
use std::crypto::p384;
use std::hex;

fn h(s: &str) -> Vec<u8> { hex::decode(s).unwrap() }

#[test]
fn p256_ecdsa_against_go() {
    for v in ECDSA_P256.iter() {
        let f: Vec<&str> = v.split(' ').collect();
        let msg = h(f[2]);
        let sig = p256::ecdsa::Signature::from_der(h(f[3]).as_slice()).unwrap();
        for key in [h(f[0]), h(f[1])].iter() {
            let vk = p256::ecdsa::VerifyingKey::from_sec1_bytes(key.as_slice()).unwrap();
            assert_eq(vk.to_sec1_bytes(), h(f[0]));
            assert(vk.verify(msg.as_slice(), &sig).is_ok());
            let mut other = msg.clone();
            other[0] = other[0] ^ 1;
            assert(vk.verify(other.as_slice(), &sig).is_err());
        }
        // Another key does not verify it.
        let w: Vec<&str> = ECDSA_P256[(ECDSA_P256.iter().position(|x| x == v).unwrap() + 1) % 8].split(' ').collect();
        let vk2 = p256::ecdsa::VerifyingKey::from_sec1_bytes(h(w[0]).as_slice()).unwrap();
        assert(vk2.verify(msg.as_slice(), &sig).is_err());
        // r || s round trip.
        let sig2 = p256::ecdsa::Signature::from_slice(sig.to_bytes().as_slice()).unwrap();
        assert(sig2 == sig);
    }
}

#[test]
fn p384_ecdsa_against_go() {
    for v in ECDSA_P384.iter() {
        let f: Vec<&str> = v.split(' ').collect();
        let msg = h(f[2]);
        let sig = p384::ecdsa::Signature::from_der(h(f[3]).as_slice()).unwrap();
        for key in [h(f[0]), h(f[1])].iter() {
            let vk = p384::ecdsa::VerifyingKey::from_sec1_bytes(key.as_slice()).unwrap();
            assert(vk.verify(msg.as_slice(), &sig).is_ok());
            let mut other = msg.clone();
            other[msg.len() - 1] = other[msg.len() - 1] ^ 0x80;
            assert(vk.verify(other.as_slice(), &sig).is_err());
        }
    }
}

#[test]
fn ecdh_against_go() {
    for v in ECDH_P256.iter() {
        let f: Vec<&str> = v.split(' ').collect();
        let s = p256::ecdh::EphemeralSecret::from_bytes(h(f[0]).as_slice()).unwrap();
        let theirs = p256::ecdh::PublicKey::from_sec1_bytes(h(f[1]).as_slice()).unwrap();
        assert_eq(hex::encode(s.diffie_hellman(&theirs).raw_secret_bytes()), f[2].to_string());
        assert_eq(hex::encode(&s.public_key().to_sec1_bytes()), f[3].to_string());
    }
    for v in ECDH_P384.iter() {
        let f: Vec<&str> = v.split(' ').collect();
        let s = p384::ecdh::EphemeralSecret::from_bytes(h(f[0]).as_slice()).unwrap();
        let theirs = p384::ecdh::PublicKey::from_sec1_bytes(h(f[1]).as_slice()).unwrap();
        assert_eq(hex::encode(s.diffie_hellman(&theirs).raw_secret_bytes()), f[2].to_string());
        assert_eq(hex::encode(&s.public_key().to_sec1_bytes()), f[3].to_string());
    }
}

#[test]
fn random_ecdh_and_bad_points() {
    let a = p256::ecdh::EphemeralSecret::random();
    let b = p256::ecdh::EphemeralSecret::random();
    assert_eq(a.diffie_hellman(&b.public_key()).raw_secret_bytes().to_vec(), b.diffie_hellman(&a.public_key()).raw_secret_bytes().to_vec());
    // A point off the curve, a bad prefix, a short one.
    let mut pk = a.public_key().to_sec1_bytes();
    pk[64] = pk[64] ^ 1;
    assert(p256::ecdh::PublicKey::from_sec1_bytes(pk.as_slice()).is_err());
    pk[0] = 5;
    assert(p256::ecdh::PublicKey::from_sec1_bytes(pk.as_slice()).is_err());
    assert(p256::ecdh::PublicKey::from_sec1_bytes(&pk[..10]).is_err());
    // Scalars out of range.
    assert(p256::ecdh::EphemeralSecret::from_bytes(&[0u8; 32]).is_err());
    assert(p256::ecdh::EphemeralSecret::from_bytes(&[0xffu8; 32]).is_err());
    // Malformed DER.
    assert(p256::ecdsa::Signature::from_der(&[0x30, 0x02, 0x02, 0x00]).is_err());
}

