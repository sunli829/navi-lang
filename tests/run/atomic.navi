// out: 800000 true true Ok(800000) Err(5)
use std::thread;
use std::sync::atomic::{AtomicUsize, Ordering};
fn main() {
    let c = &AtomicUsize::new(0);
    let mut hs = Vec::new();
    let mut k = 0;
    while k < 8 {
        hs.push(thread::spawn(|| {
            let mut i = 0;
            while i < 100000 { c.fetch_add(1, Ordering::Relaxed); i += 1; }
            thread::current().id()
        }));
        k += 1;
    }
    let mut ids = Vec::new();
    for h in hs.iter() { ids.push(h.join().unwrap()); }
    let mut distinct = true;
    let mut i = 0;
    while i < ids.len() { let mut j = i + 1; while j < ids.len() { if ids[i] == ids[j] { distinct = false; } j += 1; } i += 1; }
    println(`${c.load(Ordering::SeqCst)} ${distinct} ${thread::current().id() == thread::current().id()} ${c.compare_exchange(800000, 5, Ordering::SeqCst, Ordering::SeqCst):?} ${c.compare_exchange(1, 2, Ordering::SeqCst, Ordering::SeqCst):?}`);
}
