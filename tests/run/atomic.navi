// Atomic counter shared by 8 threads; thread ids; compare_exchange.
use std::thread;
use std::sync::atomic::{AtomicUsize, Ordering};

#[test]
fn atomic_counter_and_thread_ids() {
    let c = &AtomicUsize::new(0);
    let mut hs = Vec::new();
    let mut k = 0;
    while k < 8 {
        hs.push(thread::spawn(|| {
            let mut i = 0;
            while i < 100000 { c.fetch_add(1, Ordering::Relaxed); i += 1; }
            thread::current().id()
        }));
        k += 1;
    }
    let mut ids = Vec::new();
    for h in hs.iter() { ids.push(h.join().unwrap()); }
    let mut distinct = true;
    let mut i = 0;
    while i < ids.len() { let mut j = i + 1; while j < ids.len() { if ids[i] == ids[j] { distinct = false; } j += 1; } i += 1; }
    assert_eq(c.load(Ordering::SeqCst), 800000);
    assert(distinct);
    assert(thread::current().id() == thread::current().id());
    assert_eq(`${c.compare_exchange(800000, 5, Ordering::SeqCst, Ordering::SeqCst):?}`.as_str(), "Ok(800000)");
    assert_eq(`${c.compare_exchange(1, 2, Ordering::SeqCst, Ordering::SeqCst):?}`.as_str(), "Err(5)");
}
