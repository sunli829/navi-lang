// stage0: skip
// std::io: BufRead, BufReader, Cursor, Seek, adapters, copy, errors.
// out: lines ["one", "two", "", "three"]
// out: split ["a", "b", "c"]
// out: until 4 "abc," 3 "def"
// out: bufreader 5 "hello" "hello world"
// out: cursor 3 "abc" 1 "bc"
// out: write "xyZW" 4
// out: seek 6 InvalidInput
// out: take "hel" 0
// out: chain "abcdef"
// out: bytes [104, 105]
// out: copy 11 "hello world"
// out: empty 0 sink 3 repeat [7, 7, 7]
// out: slice 2 "cde"
// out: exact UnexpectedEof Ok(())
// out: fmt "x=1 y=two"
// out: linewriter "a\nb\n" "c"
// out: bufwriter 3 "abc" 16
// out: errors entity not found|Kind(NotFound)|oops|Custom { kind: Other, error: "oops" }
// out: os true NotFound
// out: read_to_string "all of it"
use std::io::{self, BufRead, BufReader, BufWriter, Cursor, ErrorKind, LineWriter, Read, Seek, SeekFrom, Write};

fn main() {
    let r = BufReader::new(Cursor::new(b"one\ntwo\r\n\nthree".to_vec()));
    let lines: Vec<String> = r.lines().map(|l| l.unwrap()).collect();
    println(`lines ${lines:?}`);
    let parts: Vec<String> = Cursor::new(b"a;b;c").split(b';').map(|p| String::from_utf8(p.unwrap()).unwrap()).collect();
    println(`split ${parts:?}`);
    let mut c = Cursor::new(b"abc,def".to_vec());
    let mut v = Vec::new();
    let n1 = c.read_until(b',', &mut v).unwrap();
    let s1 = String::from_utf8(v.clone()).unwrap();
    v.clear();
    let n2 = c.read_until(b',', &mut v).unwrap();
    println(`until ${n1} ${s1:?} ${n2} ${String::from_utf8(v).unwrap():?}`);

    let mut br = BufReader::with_capacity(4, "hello world".as_bytes());
    let mut buf = [0u8; 5];
    let n = br.read(&mut buf).unwrap();
    let mut first = String::new();
    first.push_str(std::str::from_utf8(&buf[0..n]).unwrap());
    let mut rest = String::new();
    br.read_to_string(&mut rest).unwrap();
    println(`bufreader ${n} ${first:?} ${(first.clone() + rest.as_str()):?}`);

    let mut cur = Cursor::new("abc".as_bytes());
    let mut s = String::new();
    cur.read_to_string(&mut s).unwrap();
    cur.set_position(1);
    let mut t = String::new();
    cur.read_to_string(&mut t).unwrap();
    println(`cursor ${s.len()} ${s:?} 1 ${t:?}`);

    let mut w = Cursor::new(Vec::new());
    w.write_all(b"xyz").unwrap();
    w.seek(SeekFrom::Current(-1)).unwrap();
    w.write_all(b"ZW").unwrap();
    println(`write ${String::from_utf8(w.get_ref().clone()).unwrap():?} ${w.position()}`);
    let p = w.seek(SeekFrom::End(2)).unwrap();
    println(`seek ${p} ${w.seek(SeekFrom::Current(-100)).unwrap_err().kind():?}`);

    let mut tk = "hello".as_bytes().take(3);
    let mut ts = String::new();
    tk.read_to_string(&mut ts).unwrap();
    println(`take ${ts:?} ${tk.limit()}`);
    let mut ch = "abc".as_bytes().chain("def".as_bytes());
    let mut cs = String::new();
    ch.read_to_string(&mut cs).unwrap();
    println(`chain ${cs:?}`);
    let bs: Vec<u8> = "hi".as_bytes().bytes().map(|b| b.unwrap()).collect();
    println(`bytes ${bs:?}`);

    let mut src = "hello world".as_bytes();
    let mut dst: Vec<u8> = Vec::new();
    let copied = io::copy(&mut src, &mut dst).unwrap();
    println(`copy ${copied} ${String::from_utf8(dst).unwrap():?}`);
    let mut e = io::empty();
    let mut eb = [0u8; 4];
    let en = e.read(&mut eb).unwrap();
    let sn = io::sink().write(b"abc").unwrap();
    let mut rb = [0u8; 3];
    io::repeat(7).read_exact(&mut rb).unwrap();
    println(`empty ${en} sink ${sn} repeat ${rb:?}`);

    let mut sl: &[u8] = b"abcde";
    let mut two = [0u8; 2];
    let k = sl.read(&mut two).unwrap();
    println(`slice ${k} ${std::str::from_utf8(sl).unwrap():?}`);
    let mut short: &[u8] = b"ab";
    let mut four = [0u8; 4];
    let mut exact2 = [0u8; 2];
    let mut ok: &[u8] = b"xy";
    println(`exact ${short.read_exact(&mut four).unwrap_err().kind():?} ${ok.read_exact(&mut exact2):?}`);

    let mut out: Vec<u8> = Vec::new();
    let y = "two";
    out.write_fmt(`x=${1} y=${y}`).unwrap();
    println(`fmt ${String::from_utf8(out).unwrap():?}`);

    let mut lw = LineWriter::new(Vec::new());
    lw.write_all(b"a\nb\nc").unwrap();
    let flushed = String::from_utf8(lw.get_ref().clone()).unwrap();
    lw.flush().unwrap();
    let all = String::from_utf8(lw.get_ref().clone()).unwrap();
    println(`linewriter ${flushed:?} ${all[flushed.len()..].to_string():?}`);
    let mut bw = BufWriter::with_capacity(16, Vec::new());
    bw.write_all(b"abc").unwrap();
    let pending = bw.buffer().len();
    let inner = bw.into_inner().unwrap();
    println(`bufwriter ${pending} ${String::from_utf8(inner).unwrap():?} 16`);

    let a = io::Error::from(ErrorKind::NotFound);
    let b = io::Error::other("oops");
    println(`errors ${a}|${a:?}|${b}|${b:?}`);
    let os = std::fs::File::open("/surely/not/here").unwrap_err();
    println(`os ${os.raw_os_error() == Some(2)} ${os.kind():?}`);
    println(`read_to_string ${io::read_to_string("all of it".as_bytes()).unwrap():?}`);
}
