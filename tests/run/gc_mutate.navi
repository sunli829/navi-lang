// Rewires pointers between old objects on several OS threads while
// collections run (concurrently marking: the write barrier must catch every
// stored pointer).
use std::thread;

struct Node { k: u64, s: String, kids: Vec<&mut Node> }

fn check(nodes: &Vec<&mut Node>) -> bool {
    for n in nodes.iter() {
        if n.s != `n${n.k}` { return false; }
        for c in n.kids.iter() { if c.s != `n${c.k}` { return false; } }
    }
    true
}

fn churn(id: u64) -> u64 {
    let n = 2000usize;
    let mut nodes: Vec<&mut Node> = Vec::new();
    let mut i = 0usize;
    while i < n {
        nodes.push(&mut Node { k: i as u64, s: `n${i}`, kids: Vec::new() });
        i += 1;
    }
    let mut x = id * 7919 + 1;
    let mut bad = 0u64;
    let mut it = 0u64;
    while it < 150000 {
        x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
        let a = ((x >> 33) % n as u64) as usize;
        let b = ((x >> 13) % n as u64) as usize;
        match it % 4 {
            0 => {
                // Swap the strings (and keys) of two old nodes.
                let t = nodes[a].s.clone();
                let tk = nodes[a].k;
                nodes[a].s = nodes[b].s.clone();
                nodes[a].k = nodes[b].k;
                nodes[b].s = t;
                nodes[b].k = tk;
            }
            1 => {
                let k = nodes[a].k + 1000000;
                nodes[a].k = k;
                nodes[a].s = `n${k}`;
            }
            2 => {
                let c = nodes[b];
                nodes[a].kids.push(c);
                if nodes[a].kids.len() > 4 { nodes[a].kids.remove(0); }
            }
            _ => {
                // Replace a node with a fresh one (old one may stay as a kid).
                let k = nodes[a].k;
                nodes[a] = &mut Node { k, s: `n${k}`, kids: Vec::new() };
            }
        }
        let g = `garbage ${it} ${a} ${b}`;
        if g.len() == 0 { bad += 1; }
        if it % 50000 == 0 && !check(&nodes) { bad += 1; }
        it += 1;
    }
    if !check(&nodes) { bad += 1; }
    bad
}

#[test]
fn write_barrier_catches_stored_pointers() {
    let mut hs = Vec::new();
    let mut k = 0u64;
    while k < 4 {
        let id = k;
        hs.push(thread::spawn(|| churn(id)));
        k += 1;
    }
    let mut bad = 0u64;
    for h in hs.iter() { bad += h.join().unwrap(); }
    assert_eq(bad, 0);
}
