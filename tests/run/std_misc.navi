// Arrays and Vec from std: iteration, map, drain, split_off, sorting by key
// (stable), sort_by, binary_search, position, cmp::max_by_key.
#[test]
fn array_iteration_and_map() {
    let mut n = 0;
    for x in [1, 2, 3] { n += x; }
    let sq = [1, 2, 3].map(|x| x * x);
    let back: Vec<i32> = [4, 5, 6].into_iter().rev().collect();
    assert_eq(n, 6);
    assert_eq(sq, [1, 4, 9]);
    assert_eq(back, Vec::from([6, 5, 4]));
}

#[test]
fn drain_and_split_off() {
    let mut v: Vec<i32> = (0..10).collect();
    let d: Vec<i32> = v.drain(2..5).collect();
    let tail = v.split_off(5);
    assert_eq(d, Vec::from([2, 3, 4]));
    assert_eq(v, Vec::from([0, 1, 5, 6, 7]));
    assert_eq(tail, Vec::from([8, 9]));
}

#[test]
fn sort_by_key_position_binary_search() {
    let words = ["apple", "Bob", "cat"];
    let mut sorted = words.to_vec();
    sorted.sort_by_key(|w| w.to_lowercase());
    let lens: Vec<usize> = words.iter().map(|w| w.len()).collect();
    assert_eq(sorted, Vec::from(["apple", "Bob", "cat"]));
    assert_eq(lens, Vec::from([5, 3, 3]));
    assert_eq(words.iter().position(|w| *w == "cat"), Some(2));
    assert_eq(words.binary_search(&"Bob"), Ok(1));
}

#[test]
fn sort_by_key_is_stable() {
    let mut stable: Vec<(i32, i32)> = Vec::new();
    let mut i = 0;
    while i < 40 { stable.push((i % 3, i)); i += 1; }
    stable.sort_by_key(|p| p.0);
    let mut ok = true;
    let mut j = 1;
    while j < stable.len() {
        if stable[j - 1].0 == stable[j].0 && stable[j - 1].1 > stable[j].1 { ok = false; }
        j += 1;
    }
    assert(ok);
    assert_eq(stable[0], (0, 0));
    assert_eq(stable[39], (2, 38));
}

#[test]
fn sort_by_and_max_by_key() {
    let mut r = [5, 1, 4];
    r.sort_by(|a, b| b.cmp(a));
    assert_eq(r, [5, 4, 1]);
    assert_eq(std::cmp::max_by_key(3, -5, |x| (*x as i32).abs()), -5);
}
