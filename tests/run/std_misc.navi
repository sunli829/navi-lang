// stage0: skip (arrays by value, drain, stable sorts: std hides them from stage0)
// out: 6 [1, 4, 9] [6, 5, 4]
// out: [2, 3, 4] [0, 1, 5, 6, 7] [8, 9]
// out: ["apple", "Bob", "cat"] [5, 3, 3] Some(2) Ok(1)
// out: stable true (0, 0) (2, 38)
// out: [5, 4, 1] -5
fn main() {
    let mut n = 0;
    for x in [1, 2, 3] { n += x; }
    let sq = [1, 2, 3].map(|x| x * x);
    let back: Vec<i32> = [4, 5, 6].into_iter().rev().collect();
    println(`${n} ${sq:?} ${back:?}`);
    let mut v: Vec<i32> = (0..10).collect();
    let d: Vec<i32> = v.drain(2..5).collect();
    let tail = v.split_off(5);
    println(`${d:?} ${v:?} ${tail:?}`);
    let words = ["apple", "Bob", "cat"];
    let mut sorted = words.to_vec();
    sorted.sort_by_key(|w| w.to_lowercase());
    let lens: Vec<usize> = words.iter().map(|w| w.len()).collect();
    println(`${sorted:?} ${lens:?} ${words.iter().position(|w| *w == "cat"):?} ${words.binary_search(&"Bob"):?}`);
    let mut stable: Vec<(i32, i32)> = Vec::new();
    let mut i = 0;
    while i < 40 { stable.push((i % 3, i)); i += 1; }
    stable.sort_by_key(|p| p.0);
    let mut ok = true;
    let mut j = 1;
    while j < stable.len() {
        if stable[j - 1].0 == stable[j].0 && stable[j - 1].1 > stable[j].1 { ok = false; }
        j += 1;
    }
    println(`stable ${ok} ${stable[0]:?} ${stable[39]:?}`);
    let mut r = [5, 1, 4];
    r.sort_by(|a, b| b.cmp(a));
    println(`${r:?} ${std::cmp::max_by_key(3, -5, |x| (*x as i32).abs())}`);
}
