// out: 80000 80000 true
use std::thread;
use std::sync::Mutex;

struct Counter { n: u64, log: Vec<u64> }

fn main() {
    let m = &Mutex::new(Counter { n: 0, log: Vec::new() });
    let plain = &Mutex::new(0u64);
    let mut hs = Vec::new();
    let mut k = 0;
    while k < 8 {
        hs.push(thread::spawn(|| {
            let mut i = 0;
            while i < 10000 {
                m.with_lock(|c| {
                    c.n += 1;
                    if c.n % 1000 == 0 { c.log.push(c.n); }
                });
                plain.lock();
                let p = plain as *const Mutex<u64> as *mut Mutex<u64>;
                unsafe { *(*p).get_mut() += 1; }
                plain.unlock();
                i += 1;
            }
        }));
        k += 1;
    }
    for h in hs.iter() { h.join().unwrap(); }
    let n = m.with_lock(|c| c.n);
    let p = plain as *const Mutex<u64> as *mut Mutex<u64>;
    let v = unsafe { *(*p).get_mut() };
    let ok = m.with_lock(|c| c.log.len() == 80 && plain.try_lock());
    println(`${n} ${v} ${ok}`);
}
