// Integer literals at the limits: 128-bit literals wider than 64 bits,
// and negated literals of the minimum values (constants, not negations
// that overflow). Literals that do not fit their types are errors.
const A: i8 = -128;
const B: u128 = 1_000_000_000_000_000_000_000;

#[test]
fn negated_minimum_literals() {
    assert_eq(`${-128i8} ${-32768i16} ${-2147483648i32} ${-9223372036854775808i64}`.as_str(), "-128 -32768 -2147483648 -9223372036854775808");
    assert_eq(-128i8, i8::MIN);
    assert_eq(-32768i16, i16::MIN);
    assert_eq(-2147483648i32, i32::MIN);
    assert_eq(-9223372036854775808i64, i64::MIN);
}

#[test]
fn wide_128_bit_literals() {
    let lo = -170141183460469231731687303715884105728i128;
    let hi: i128 = 170141183460469231731687303715884105727;
    assert_eq(`${lo} ${hi}`.as_str(), "-170141183460469231731687303715884105728 170141183460469231731687303715884105727");
    let m = 0xffff_ffff_ffff_ffff_ffff_ffff_ffff_ffffu128;
    let n: i128 = -18446744073709551616;
    assert_eq(`${m} ${B} ${n}`.as_str(), "340282366920938463463374607431768211455 1000000000000000000000 -18446744073709551616");
}

#[test]
fn literals_in_constants_and_patterns() {
    let v = -128i8;
    let s = match v { -128 => "min", _ => "other" };
    assert_eq(`${A} ${B} ${s}`.as_str(), "-128 1000000000000000000000 min");
    assert_eq(A, -128);
    assert_eq(s, "min");
}
