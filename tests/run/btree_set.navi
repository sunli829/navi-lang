// out: empty {} 0 true None None None false false
// out: insert true true true false {1, 3, 5}
// out: contains true false get Some(3) first Some(1) last Some(5)
// out: remove true false {1, 5}
// out: union [1, 3, 4, 5, 6, 7, 9, 11, 20]
// out: intersection [3, 5, 7] difference [1, 9, 11] [4, 6, 20]
// out: symmetric [1, 4, 6, 9, 11, 20]
// out: with empty 6 0 6 0
// out: subset true false true false true
// out: range [3, 5, 7] [9, 7, 5] [1, 3]
// out: iter 6 rev [11, 9, 7, 5, 3, 1]
// out: strings {"apple", "banana", "cherry", "fig", "pear"}
// out: pop Some("apple") Some("pear") 3
// out: retain {"banana", "cherry"}
// out: clone false 2 3 take Some("kiwi") true
// out: split {1, 2, 3, 10, 11} {4, 5, 6} {}
// out: extend {1, 2, 3} [1, 2, 3] 6
// out: replace Some(2) None {1, 2, 3, 9}
// out: random ok 1029 1029
use std::collections::{BTreeMap, BTreeSet};

fn main() {
    let mut e: BTreeSet<i32> = BTreeSet::new();
    println(`empty ${e:?} ${e.len()} ${e.is_empty()} ${e.first():?} ${e.last():?} ${e.pop_first():?} ${e.contains(&1)} ${e.remove(&1)}`);

    let mut s: BTreeSet<i32> = BTreeSet::new();
    println(`insert ${s.insert(5)} ${s.insert(1)} ${s.insert(3)} ${s.insert(5)} ${s:?}`);
    println(`contains ${s.contains(&3)} ${s.contains(&4)} get ${s.get(&3):?} first ${s.first():?} last ${s.last():?}`);
    println(`remove ${s.remove(&3)} ${s.remove(&3)} ${s:?}`);

    let a: BTreeSet<i32> = vec_of(&[1, 3, 5, 7, 9, 11]).into_iter().collect();
    let b: BTreeSet<i32> = vec_of(&[3, 4, 5, 6, 7, 20]).into_iter().collect();
    let u: Vec<i32> = a.r#union(&b).map(|x| *x).collect();
    let i: Vec<i32> = a.intersection(&b).map(|x| *x).collect();
    let d: Vec<i32> = a.difference(&b).map(|x| *x).collect();
    let d2: Vec<i32> = b.difference(&a).map(|x| *x).collect();
    let sd: Vec<i32> = a.symmetric_difference(&b).map(|x| *x).collect();
    println(`union ${u:?}`);
    println(`intersection ${i:?} difference ${d:?} ${d2:?}`);
    println(`symmetric ${sd:?}`);
    let empty: BTreeSet<i32> = BTreeSet::new();
    println(`with empty ${a.r#union(&empty).count()} ${a.intersection(&empty).count()} ${a.difference(&empty).count()} ${empty.difference(&a).count()}`);
    let sub: BTreeSet<i32> = BTreeSet::from([3, 5]);
    println(`subset ${sub.is_subset(&a)} ${a.is_subset(&sub)} ${a.is_superset(&sub)} ${sub.is_disjoint(&a)} ${sub.is_disjoint(&BTreeSet::from([4, 6]))}`);

    let r: Vec<i32> = a.range(3..9).map(|x| *x).collect();
    let r2: Vec<i32> = a.range(4..=9).rev().map(|x| *x).collect();
    let r3: Vec<i32> = a.range(..=3).map(|x| *x).collect();
    println(`range ${r:?} ${r2:?} ${r3:?}`);
    let rev: Vec<i32> = a.iter().rev().map(|x| *x).collect();
    println(`iter ${a.iter().len()} rev ${rev:?}`);

    let mut p: BTreeSet<String> = BTreeSet::new();
    for w in "pear apple fig banana apple cherry".split_whitespace() { p.insert(w.to_string()); }
    println(`strings ${p:?}`);
    println(`pop ${p.pop_first():?} ${p.pop_last():?} ${p.len()}`);
    p.retain(|w| w.len() > 3);
    println(`retain ${p:?}`);
    let mut q = p.clone();
    q.insert(String::from("kiwi"));
    println(`clone ${p == q} ${p.len()} ${q.len()} take ${q.take(&String::from("kiwi")):?} ${p == q}`);
    let mut m = BTreeSet::from([1, 2, 3, 4, 5, 6]);
    let hi = m.split_off(&4);
    let mut more = BTreeSet::from([10, 11]);
    m.append(&mut more);
    println(`split ${m:?} ${hi:?} ${more:?}`);
    let mut x: BTreeSet<i32> = BTreeSet::default();
    x.extend(vec_of(&[3, 1, 2, 3]));
    let owned: Vec<i32> = x.clone().into_iter().collect();
    let mut sum = 0;
    for v in &x { sum += *v; }
    println(`extend ${x:?} ${owned:?} ${sum}`);
    let r1 = x.replace(2);
    let r2 = x.replace(9);
    println(`replace ${r1:?} ${r2:?} ${x:?}`);

    // Many random operations with String keys, checked against a sorted
    // Vec, with collections in between.
    let mut t: BTreeSet<String> = BTreeSet::new();
    let mut tm: BTreeMap<String, Vec<i32>> = BTreeMap::new();
    let mut model: Vec<String> = Vec::new();
    let mut seed: u64 = 99;
    let mut step = 0;
    while step < 20000 {
        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
        let r = (seed >> 33) as usize;
        let key = `k${r % 1500}`;
        let pos = model.binary_search(&key);
        if r / 1500 % 3 != 0 {
            let fresh = t.insert(key.clone());
            tm.entry(key.clone()).or_insert_with(|| Vec::new()).push(step);
            assert_eq(fresh, pos.is_err());
            if let Err(i) = pos { model.insert(i, key); }
        } else {
            let had = t.remove(&key);
            let v = tm.remove(&key);
            assert_eq(had, pos.is_ok());
            assert_eq(had, v.is_some());
            if let Ok(i) = pos { model.remove(i); }
        }
        if step % 2000 == 0 {
            std::gc::collect();
            let got: Vec<String> = t.iter().map(|s| s.clone()).collect();
            assert(got == model);
            let keys: Vec<String> = tm.keys().map(|s| s.clone()).collect();
            assert(keys == model);
        }
        step += 1;
    }
    println(`random ok ${t.len()} ${tm.len()}`);
}

fn vec_of(a: &[i32]) -> Vec<i32> { a.to_vec() }
