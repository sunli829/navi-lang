// std::collections::BTreeSet: insert/remove/lookup, set operations,
// subset tests, ranges, iteration, String elements, retain, clone, split_off
// and append, extend, replace, Debug output, and many random operations
// checked against a sorted Vec.
use std::collections::{BTreeMap, BTreeSet};

fn vec_of(a: &[i32]) -> Vec<i32> { a.to_vec() }

#[test]
fn empty_set() {
    let mut e: BTreeSet<i32> = BTreeSet::new();
    assert_eq(`${e:?}`.to_string(), "{}");
    assert_eq(e.len(), 0);
    assert(e.is_empty());
    assert_eq(e.first(), None);
    assert_eq(e.last(), None);
    assert_eq(e.pop_first(), None);
    assert(!e.contains(&1));
    assert(!e.remove(&1));
}

#[test]
fn insert_contains_remove() {
    let mut s: BTreeSet<i32> = BTreeSet::new();
    assert(s.insert(5));
    assert(s.insert(1));
    assert(s.insert(3));
    assert(!s.insert(5));
    assert_eq(`${s:?}`.to_string(), "{1, 3, 5}");
    assert(s.contains(&3));
    assert(!s.contains(&4));
    assert_eq(s.get(&3), Some(&3));
    assert_eq(s.first(), Some(&1));
    assert_eq(s.last(), Some(&5));
    assert(s.remove(&3));
    assert(!s.remove(&3));
    assert_eq(`${s:?}`.to_string(), "{1, 5}");
}

#[test]
fn set_operations() {
    let a: BTreeSet<i32> = vec_of(&[1, 3, 5, 7, 9, 11]).into_iter().collect();
    let b: BTreeSet<i32> = vec_of(&[3, 4, 5, 6, 7, 20]).into_iter().collect();
    let u: Vec<i32> = a.r#union(&b).map(|x| *x).collect();
    let i: Vec<i32> = a.intersection(&b).map(|x| *x).collect();
    let d: Vec<i32> = a.difference(&b).map(|x| *x).collect();
    let d2: Vec<i32> = b.difference(&a).map(|x| *x).collect();
    let sd: Vec<i32> = a.symmetric_difference(&b).map(|x| *x).collect();
    assert_eq(u, Vec::from([1, 3, 4, 5, 6, 7, 9, 11, 20]));
    assert_eq(i, Vec::from([3, 5, 7]));
    assert_eq(d, Vec::from([1, 9, 11]));
    assert_eq(d2, Vec::from([4, 6, 20]));
    assert_eq(sd, Vec::from([1, 4, 6, 9, 11, 20]));
    let empty: BTreeSet<i32> = BTreeSet::new();
    assert_eq(a.r#union(&empty).count(), 6);
    assert_eq(a.intersection(&empty).count(), 0);
    assert_eq(a.difference(&empty).count(), 6);
    assert_eq(empty.difference(&a).count(), 0);
    let sub: BTreeSet<i32> = BTreeSet::from([3, 5]);
    assert(sub.is_subset(&a));
    assert(!a.is_subset(&sub));
    assert(a.is_superset(&sub));
    assert(!sub.is_disjoint(&a));
    assert(sub.is_disjoint(&BTreeSet::from([4, 6])));
}

#[test]
fn ranges_and_iteration() {
    let a: BTreeSet<i32> = vec_of(&[1, 3, 5, 7, 9, 11]).into_iter().collect();
    let r: Vec<i32> = a.range(3..9).map(|x| *x).collect();
    let r2: Vec<i32> = a.range(4..=9).rev().map(|x| *x).collect();
    let r3: Vec<i32> = a.range(..=3).map(|x| *x).collect();
    assert_eq(r, Vec::from([3, 5, 7]));
    assert_eq(r2, Vec::from([9, 7, 5]));
    assert_eq(r3, Vec::from([1, 3]));
    let rev: Vec<i32> = a.iter().rev().map(|x| *x).collect();
    assert_eq(a.iter().len(), 6);
    assert_eq(rev, Vec::from([11, 9, 7, 5, 3, 1]));
}

#[test]
fn string_elements() {
    let mut p: BTreeSet<String> = BTreeSet::new();
    for w in "pear apple fig banana apple cherry".split_whitespace() { p.insert(w.to_string()); }
    assert_eq(`${p:?}`.to_string(), "{\"apple\", \"banana\", \"cherry\", \"fig\", \"pear\"}");
    assert_eq(p.pop_first(), Some(String::from("apple")));
    assert_eq(p.pop_last(), Some(String::from("pear")));
    assert_eq(p.len(), 3);
    p.retain(|w| w.len() > 3);
    assert_eq(`${p:?}`.to_string(), "{\"banana\", \"cherry\"}");
    let mut q = p.clone();
    q.insert(String::from("kiwi"));
    assert(p != q);
    assert_eq(p.len(), 2);
    assert_eq(q.len(), 3);
    assert_eq(q.take(&String::from("kiwi")), Some(String::from("kiwi")));
    assert(p == q);
}

#[test]
fn split_off_append_extend_replace() {
    let mut m = BTreeSet::from([1, 2, 3, 4, 5, 6]);
    let hi = m.split_off(&4);
    let mut more = BTreeSet::from([10, 11]);
    m.append(&mut more);
    assert_eq(`${m:?} ${hi:?} ${more:?}`.to_string(), "{1, 2, 3, 10, 11} {4, 5, 6} {}");
    let mut x: BTreeSet<i32> = BTreeSet::default();
    x.extend(vec_of(&[3, 1, 2, 3]));
    let owned: Vec<i32> = x.clone().into_iter().collect();
    let mut sum = 0;
    for v in &x { sum += *v; }
    assert_eq(`${x:?}`.to_string(), "{1, 2, 3}");
    assert_eq(owned, Vec::from([1, 2, 3]));
    assert_eq(sum, 6);
    let r1 = x.replace(2);
    let r2 = x.replace(9);
    assert_eq(r1, Some(2));
    assert_eq(r2, None);
    assert_eq(`${x:?}`.to_string(), "{1, 2, 3, 9}");
}

// Many random operations with String keys, checked against a sorted
// Vec, with collections in between.
#[test]
fn random_operations() {
    let mut t: BTreeSet<String> = BTreeSet::new();
    let mut tm: BTreeMap<String, Vec<i32>> = BTreeMap::new();
    let mut model: Vec<String> = Vec::new();
    let mut seed: u64 = 99;
    let mut step = 0;
    while step < 20000 {
        seed = seed.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
        let r = (seed >> 33) as usize;
        let key = `k${r % 1500}`.to_string();
        let pos = model.binary_search(&key);
        if r / 1500 % 3 != 0 {
            let fresh = t.insert(key.clone());
            tm.entry(key.clone()).or_insert_with(|| Vec::new()).push(step);
            assert_eq(fresh, pos.is_err());
            if let Err(i) = pos { model.insert(i, key); }
        } else {
            let had = t.remove(&key);
            let v = tm.remove(&key);
            assert_eq(had, pos.is_ok());
            assert_eq(had, v.is_some());
            if let Ok(i) = pos { model.remove(i); }
        }
        if step % 2000 == 0 {
            std::gc::collect();
            let got: Vec<String> = t.iter().map(|s| s.clone()).collect();
            assert(got == model);
            let keys: Vec<String> = tm.keys().map(|s| s.clone()).collect();
            assert(keys == model);
        }
        step += 1;
    }
    assert_eq(t.len(), 1029);
    assert_eq(tm.len(), 1029);
}
