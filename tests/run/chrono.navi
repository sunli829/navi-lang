// std::chrono: formatting (every specifier and padding), RFC 3339/2822,
// parsing and its errors, calendar arithmetic, TimeDelta; the expected
// values are chrono 0.4.44's output for the same program.
use std::chrono::prelude::*;
use std::chrono::{TimeDelta, Days, Months, NaiveDate, NaiveTime, NaiveDateTime, FixedOffset, SecondsFormat};

fn tz() -> FixedOffset { FixedOffset::east_opt(5 * 3600 + 30 * 60).unwrap() }

// Formats d with each format string, then with Display, Debug and the RFC
// serializations, in UTC, and its calendar parts; compares each line.
fn check_formats(d: DateTime<FixedOffset>, want_formats: [&str; 10], want: [&str; 3]) {
    let fmts: Vec<&str> = Vec::from(["%Y-%m-%d %H:%M:%S", "%C %y %m %b %B %h %d %e", "%a %A %w %u %U %W %G %g %V %j", "%D|%x|%F|%v|%R|%T|%X|%r|%c", "%H %k %I %l %P %p %M %S", "%f|%.f|%.3f|%.6f|%.9f|%3f|%6f|%9f", "%Z|%z|%:z|%::z|%:::z", "%+|%s|%%|%t|%n|", "%-d %_d %0e %-m %-H %_H %-j %-I", "literal text %Y!"]);
    let mut i = 0;
    while i < fmts.len() {
        assert_eq(`${d.format(fmts[i])}`.to_string(), want_formats[i]);
        i += 1;
    }
    assert_eq(`${d} | ${d:?} | ${d.to_rfc3339()} | ${d.to_rfc2822()} | ${d.to_rfc3339_opts(SecondsFormat::Millis, true)}`.to_string(), want[0]);
    let u = d.with_timezone(&Utc);
    assert_eq(`${u} | ${u:?} | ${u.to_rfc3339_opts(SecondsFormat::Secs, true)} | ${u.timestamp()}`.to_string(), want[1]);
    assert_eq(`${d.iso_week():?} ${d.ordinal()} ${d.weekday()} ${d.date_naive()} ${d.time():?} ${d.naive_utc()}`.to_string(), want[2]);
}

#[test]
fn format_leap_day_with_nanoseconds() {
    check_formats(
        tz().with_ymd_and_hms(2024, 2, 29, 13, 5, 9).unwrap() + TimeDelta::nanoseconds(123_456_789),
        [
            "2024-02-29 13:05:09",
            "20 24 02 Feb February Feb 29 29",
            "Thu Thursday 4 4 08 09 2024 24 09 060",
            "02/29/24|02/29/24|2024-02-29|29-Feb-2024|13:05|13:05:09|13:05:09|01:05:09 PM|Thu Feb 29 13:05:09 2024",
            "13 13 01  1 pm PM 05 09",
            "123456789|.123456789|.123|.123456|.123456789|123|123456|123456789",
            "+05:30|+0530|+05:30|+05:30:00|+05",
            "2024-02-29T13:05:09.123456789+05:30|1709192109|%|\t|\n|",
            "29 29 29 2 13 13 60 1",
            "literal text 2024!",
        ],
        [
            "2024-02-29 13:05:09.123456789 +05:30 | 2024-02-29T13:05:09.123456789+05:30 | 2024-02-29T13:05:09.123456789+05:30 | Thu, 29 Feb 2024 13:05:09 +0530 | 2024-02-29T13:05:09.123+05:30",
            "2024-02-29 07:35:09.123456789 UTC | 2024-02-29T07:35:09.123456789Z | 2024-02-29T07:35:09Z | 1709192109",
            "2024-W09 60 Thu 2024-02-29 13:05:09.123456789 2024-02-29 07:35:09.123456789",
        ],
    );
}

#[test]
fn format_end_of_1999() {
    check_formats(
        tz().with_ymd_and_hms(1999, 12, 31, 0, 0, 0).unwrap(),
        [
            "1999-12-31 00:00:00",
            "19 99 12 Dec December Dec 31 31",
            "Fri Friday 5 5 52 52 1999 99 52 365",
            "12/31/99|12/31/99|1999-12-31|31-Dec-1999|00:00|00:00:00|00:00:00|12:00:00 AM|Fri Dec 31 00:00:00 1999",
            "00  0 12 12 am AM 00 00",
            "000000000||.000|.000000|.000000000|000|000000|000000000",
            "+05:30|+0530|+05:30|+05:30:00|+05",
            "1999-12-31T00:00:00+05:30|946578600|%|\t|\n|",
            "31 31 31 12 0  0 365 12",
            "literal text 1999!",
        ],
        [
            "1999-12-31 00:00:00 +05:30 | 1999-12-31T00:00:00+05:30 | 1999-12-31T00:00:00+05:30 | Fri, 31 Dec 1999 00:00:00 +0530 | 1999-12-31T00:00:00.000+05:30",
            "1999-12-30 18:30:00 UTC | 1999-12-30T18:30:00Z | 1999-12-30T18:30:00Z | 946578600",
            "1999-W52 365 Fri 1999-12-31 00:00:00 1999-12-30 18:30:00",
        ],
    );
}

#[test]
fn format_iso_week_of_previous_year_with_milliseconds() {
    check_formats(
        tz().with_ymd_and_hms(2021, 1, 3, 23, 59, 59).unwrap() + TimeDelta::milliseconds(5),
        [
            "2021-01-03 23:59:59",
            "20 21 01 Jan January Jan 03  3",
            "Sun Sunday 0 7 01 00 2020 20 53 003",
            "01/03/21|01/03/21|2021-01-03| 3-Jan-2021|23:59|23:59:59|23:59:59|11:59:59 PM|Sun Jan  3 23:59:59 2021",
            "23 23 11 11 pm PM 59 59",
            "005000000|.005|.005|.005000|.005000000|005|005000|005000000",
            "+05:30|+0530|+05:30|+05:30:00|+05",
            "2021-01-03T23:59:59.005+05:30|1609698599|%|\t|\n|",
            "3  3 03 1 23 23 3 11",
            "literal text 2021!",
        ],
        [
            "2021-01-03 23:59:59.005 +05:30 | 2021-01-03T23:59:59.005+05:30 | 2021-01-03T23:59:59.005+05:30 | Sun, 3 Jan 2021 23:59:59 +0530 | 2021-01-03T23:59:59.005+05:30",
            "2021-01-03 18:29:59.005 UTC | 2021-01-03T18:29:59.005Z | 2021-01-03T18:29:59Z | 1609698599",
            "2020-W53 3 Sun 2021-01-03 23:59:59.005 2021-01-03 18:29:59.005",
        ],
    );
}

#[test]
fn format_year_one() {
    check_formats(
        tz().with_ymd_and_hms(1, 1, 1, 12, 0, 0).unwrap(),
        [
            "0001-01-01 12:00:00",
            "00 01 01 Jan January Jan 01  1",
            "Mon Monday 1 1 00 01 0001 01 01 001",
            "01/01/01|01/01/01|0001-01-01| 1-Jan-0001|12:00|12:00:00|12:00:00|12:00:00 PM|Mon Jan  1 12:00:00 0001",
            "12 12 12 12 pm PM 00 00",
            "000000000||.000|.000000|.000000000|000|000000|000000000",
            "+05:30|+0530|+05:30|+05:30:00|+05",
            "0001-01-01T12:00:00+05:30|-62135573400|%|\t|\n|",
            "1  1 01 1 12 12 1 12",
            "literal text 0001!",
        ],
        [
            "0001-01-01 12:00:00 +05:30 | 0001-01-01T12:00:00+05:30 | 0001-01-01T12:00:00+05:30 | Mon, 1 Jan 0001 12:00:00 +0530 | 0001-01-01T12:00:00.000+05:30",
            "0001-01-01 06:30:00 UTC | 0001-01-01T06:30:00Z | 0001-01-01T06:30:00Z | -62135573400",
            "0001-W01 1 Mon 0001-01-01 12:00:00 0001-01-01 06:30:00",
        ],
    );
}

#[test]
fn format_end_of_leap_year_with_microseconds() {
    check_formats(
        tz().with_ymd_and_hms(2020, 12, 31, 7, 7, 7).unwrap() + TimeDelta::microseconds(250),
        [
            "2020-12-31 07:07:07",
            "20 20 12 Dec December Dec 31 31",
            "Thu Thursday 4 4 52 52 2020 20 53 366",
            "12/31/20|12/31/20|2020-12-31|31-Dec-2020|07:07|07:07:07|07:07:07|07:07:07 AM|Thu Dec 31 07:07:07 2020",
            "07  7 07  7 am AM 07 07",
            "000250000|.000250|.000|.000250|.000250000|000|000250|000250000",
            "+05:30|+0530|+05:30|+05:30:00|+05",
            "2020-12-31T07:07:07.000250+05:30|1609378627|%|\t|\n|",
            "31 31 31 12 7  7 366 7",
            "literal text 2020!",
        ],
        [
            "2020-12-31 07:07:07.000250 +05:30 | 2020-12-31T07:07:07.000250+05:30 | 2020-12-31T07:07:07.000250+05:30 | Thu, 31 Dec 2020 07:07:07 +0530 | 2020-12-31T07:07:07.000+05:30",
            "2020-12-31 01:37:07.000250 UTC | 2020-12-31T01:37:07.000250Z | 2020-12-31T01:37:07Z | 1609378627",
            "2020-W53 366 Thu 2020-12-31 07:07:07.000250 2020-12-31 01:37:07.000250",
        ],
    );
}

#[test]
fn calendar_arithmetic() {
    let n = NaiveDate::from_ymd_opt(2024, 1, 31).unwrap();
    assert_eq(`${n.checked_add_months(Months::new(1)):?} ${n + Days::new(30):?} ${n.checked_sub_months(Months::new(13)):?} ${n.pred_opt():?}`.to_string(), "Some(2024-02-29) 2024-03-01 Some(2022-12-31) Some(2024-01-30)");
    assert_eq(`${NaiveDate::from_isoywd_opt(2020, 53, Weekday::Fri):?} ${NaiveDate::from_yo_opt(2023, 365):?} ${NaiveDate::from_ymd_opt(2023, 2, 29):?}`.to_string(), "Some(2021-01-01) Some(2023-12-31) None");
    assert_eq(`${Weekday::Sun.succ()} ${"fri".parse::<Weekday>().unwrap()}`.to_string(), "Mon Fri");
    let a = NaiveDate::from_ymd_opt(2000, 2, 29).unwrap();
    assert_eq(`${NaiveDate::from_ymd_opt(2024, 2, 29).unwrap().years_since(a):?} ${NaiveDate::from_ymd_opt(-5, 3, 1).unwrap()}`.to_string(), "Some(24) -0005-03-01");
}

#[test]
fn time_delta() {
    assert_eq(`${TimeDelta::seconds(90061)} ${TimeDelta::milliseconds(-1500)} ${TimeDelta::zero()}`.to_string(), "PT90061S -PT1.5S P0D");
    assert_eq(`${TimeDelta::days(3).num_hours()} ${(TimeDelta::seconds(-5) + TimeDelta::milliseconds(200)).num_milliseconds()} ${TimeDelta::nanoseconds(-1).num_nanoseconds():?}`.to_string(), "72 -4800 Some(-1)");
}

#[test]
fn parse_naive() {
    let parses: Vec<(&str, &str, &str)> = Vec::from([
        ("2024-03-05 07:08:09", "%Y-%m-%d %H:%M:%S", "Ok(2024-03-05T07:08:09)"),
        ("5/3/24 7:8", "%d/%m/%y %H:%M", "Ok(2024-03-05T07:08:00)"),
        ("Tue, 5 Mar 2024 07:08:09", "%a, %d %b %Y %H:%M:%S", "Ok(2024-03-05T07:08:09)"),
        ("2024-13-01 00:00:00", "%Y-%m-%d %H:%M:%S", "Err(ParseError(OutOfRange))"),
        ("2024-02-30 00:00:00", "%Y-%m-%d %H:%M:%S", "Err(ParseError(OutOfRange))"),
        ("2024-03-05", "%Y-%m-%d %H", "Err(ParseError(TooShort))"),
        ("2024-03-05 01:02:03 extra", "%Y-%m-%d %H:%M:%S", "Err(ParseError(TooLong))"),
        ("2024-03-05x", "%Y-%m-%d", "Err(ParseError(TooLong))"),
        ("2024-03-05 01:02:03.25", "%Y-%m-%d %H:%M:%S%.f", "Ok(2024-03-05T01:02:03.250)"),
        ("2024-03-05 01:02:03 PM", "%Y-%m-%d %I:%M:%S %p", "Ok(2024-03-05T13:02:03)"),
        ("2024-03-05   01:02", "%Y-%m-%d %H:%M", "Ok(2024-03-05T01:02:00)"),
        ("1709622489", "%s", "Ok(2024-03-05T07:08:09)"),
        ("2024-065", "%Y-%j", "Err(ParseError(NotEnough))"),
        ("Wed 2024-03-05", "%a %Y-%m-%d", "Err(ParseError(Impossible))"),
    ]);
    for (s, f, want) in parses.iter() {
        assert_eq(`${NaiveDateTime::parse_from_str(*s, *f):?}`.to_string(), *want);
    }
    assert_eq(`${NaiveDate::parse_from_str("2024-065", "%Y-%j"):?}`.to_string(), "Ok(2024-03-05)");
    assert_eq(`${NaiveTime::parse_from_str("23:59:60.5", "%H:%M:%S%.f"):?}`.to_string(), "Ok(23:59:60.500)");
}

#[test]
fn parse_rfc3339() {
    let cases: Vec<(&str, &str)> = Vec::from([
        ("2024-03-05T07:08:09Z", "Ok(2024-03-05T07:08:09+00:00)"),
        ("2024-03-05T07:08:09.5+09:00", "Ok(2024-03-05T07:08:09.500+09:00)"),
        ("2024-03-05 07:08:09-05:30", "Ok(2024-03-05T07:08:09-05:30)"),
        ("2024-03-05T07:08:09", "Err(ParseError(TooShort))"),
        ("2024-03-05T25:08:09Z", "Err(ParseError(OutOfRange))"),
    ]);
    for (s, want) in cases.iter() {
        assert_eq(`${DateTime::parse_from_rfc3339(*s):?}`.to_string(), *want);
    }
}

#[test]
fn parse_rfc2822() {
    let cases: Vec<(&str, &str)> = Vec::from([
        ("Tue, 5 Mar 2024 07:08:09 +0200", "Ok(2024-03-05T07:08:09+02:00)"),
        ("5 Mar 24 07:08 GMT", "Ok(2024-03-05T07:08:00+00:00)"),
        ("Tue, 05 Mar 2024 07:08:09 EST", "Ok(2024-03-05T07:08:09-05:00)"),
        ("Wed, 5 Mar 2024 07:08:09 +0000", "Err(ParseError(Impossible))"),
    ]);
    for (s, want) in cases.iter() {
        assert_eq(`${DateTime::parse_from_rfc2822(*s):?}`.to_string(), *want);
    }
}

#[test]
fn parse_with_offset() {
    assert_eq(`${DateTime::parse_from_str("2024-03-05 07:08:09 +0900", "%Y-%m-%d %H:%M:%S %z"):?}`.to_string(), "Ok(2024-03-05T07:08:09+09:00)");
    assert_eq(`${DateTime::parse_from_str("2024-03-05 07:08:09", "%Y-%m-%d %H:%M:%S"):?}`.to_string(), "Err(ParseError(NotEnough))");
    assert_eq(`${"2024-03-05T07:08:09+09:00".parse::<DateTime<Utc>>():?} ${"2024-03-05 07:08:09 +09:00".parse::<DateTime<FixedOffset>>():?}`.to_string(), "Ok(2024-03-04T22:08:09Z) Ok(2024-03-05T07:08:09+09:00)");
    assert_eq(`${DateTime::from_timestamp(-1, 500):?} ${DateTime::from_timestamp_millis(-86_400_001):?}`.to_string(), "Some(1969-12-31T23:59:59.000000500Z) Some(1969-12-30T23:59:59.999Z)");
}
