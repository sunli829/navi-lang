// out: 2024-02-30 00:00:00 => Err(ParseError(OutOfRange))
// out: 2024-03-05 => Err(ParseError(TooShort))
// out: 2024-03-05 01:02:03 extra => Err(ParseError(TooLong))
// out: 2024-03-05x => Err(ParseError(TooLong))
// out: 2024-03-05 01:02:03.25 => Ok(2024-03-05T01:02:03.250)
// out: 2024-03-05 01:02:03 PM => Ok(2024-03-05T13:02:03)
// out: 2024-03-05   01:02 => Ok(2024-03-05T01:02:00)
// out: 1709622489 => Ok(2024-03-05T07:08:09)
// out: 2024-065 => Err(ParseError(NotEnough))
// out: Wed 2024-03-05 => Err(ParseError(Impossible))
// out: Ok(2024-03-05)
// out: Ok(23:59:60.500)
// out: 2024-03-05T07:08:09Z => Ok(2024-03-05T07:08:09+00:00)
// out: 2024-03-05T07:08:09.5+09:00 => Ok(2024-03-05T07:08:09.500+09:00)
// out: 2024-03-05 07:08:09-05:30 => Ok(2024-03-05T07:08:09-05:30)
// out: 2024-03-05T07:08:09 => Err(ParseError(TooShort))
// out: 2024-03-05T25:08:09Z => Err(ParseError(OutOfRange))
// out: Tue, 5 Mar 2024 07:08:09 +0200 => Ok(2024-03-05T07:08:09+02:00)
// out: 5 Mar 24 07:08 GMT => Ok(2024-03-05T07:08:00+00:00)
// out: Tue, 05 Mar 2024 07:08:09 EST => Ok(2024-03-05T07:08:09-05:00)
// out: Wed, 5 Mar 2024 07:08:09 +0000 => Err(ParseError(Impossible))
// out: 2024-03-05 07:08:09 +0900 => Ok(2024-03-05T07:08:09+09:00)
// out: 2024-03-05 07:08:09 => Err(ParseError(NotEnough))
// out: Ok(2024-03-04T22:08:09Z) Ok(2024-03-05T07:08:09+09:00)
// out: Some(1969-12-31T23:59:59.000000500Z) Some(1969-12-30T23:59:59.999Z)
// out: Mon Fri
// out: Some(24) -0005-03-01
use std::chrono::prelude::*;
use std::chrono::{TimeDelta, Days, Months, NaiveDate, NaiveTime, NaiveDateTime, FixedOffset, SecondsFormat};
fn main() {
    let fmts: Vec<&str> = Vec::from(["%Y-%m-%d %H:%M:%S", "%C %y %m %b %B %h %d %e", "%a %A %w %u %U %W %G %g %V %j", "%D|%x|%F|%v|%R|%T|%X|%r|%c", "%H %k %I %l %P %p %M %S", "%f|%.f|%.3f|%.6f|%.9f|%3f|%6f|%9f", "%Z|%z|%:z|%::z|%:::z", "%+|%s|%%|%t|%n|", "%-d %_d %0e %-m %-H %_H %-j %-I", "literal text %Y!"]);
    let tz = FixedOffset::east_opt(5 * 3600 + 30 * 60).unwrap();
    let dts = Vec::from([
        tz.with_ymd_and_hms(2024, 2, 29, 13, 5, 9).unwrap() + TimeDelta::nanoseconds(123_456_789),
        tz.with_ymd_and_hms(1999, 12, 31, 0, 0, 0).unwrap(),
        tz.with_ymd_and_hms(2021, 1, 3, 23, 59, 59).unwrap() + TimeDelta::milliseconds(5),
        tz.with_ymd_and_hms(1, 1, 1, 12, 0, 0).unwrap(),
        tz.with_ymd_and_hms(2020, 12, 31, 7, 7, 7).unwrap() + TimeDelta::microseconds(250),
    ]);
    for d in dts.iter() {
        for f in fmts.iter() { println(`${d.format(*f)}`); }
        println(`${d} | ${d:?} | ${d.to_rfc3339()} | ${d.to_rfc2822()} | ${d.to_rfc3339_opts(SecondsFormat::Millis, true)}`);
        let u = d.with_timezone(&Utc);
        println(`${u} | ${u:?} | ${u.to_rfc3339_opts(SecondsFormat::Secs, true)} | ${u.timestamp()}`);
        println(`${d.iso_week():?} ${d.ordinal()} ${d.weekday()} ${d.date_naive()} ${d.time():?} ${d.naive_utc()}`);
    }
    let n = NaiveDate::from_ymd_opt(2024, 1, 31).unwrap();
    println(`${n.checked_add_months(Months::new(1)):?} ${n + Days::new(30):?} ${n.checked_sub_months(Months::new(13)):?} ${n.pred_opt():?}`);
    println(`${NaiveDate::from_isoywd_opt(2020, 53, Weekday::Fri):?} ${NaiveDate::from_yo_opt(2023, 365):?} ${NaiveDate::from_ymd_opt(2023, 2, 29):?}`);
    println(`${TimeDelta::seconds(90061)} ${TimeDelta::milliseconds(-1500)} ${TimeDelta::zero()}`);
    println(`${TimeDelta::days(3).num_hours()} ${(TimeDelta::seconds(-5) + TimeDelta::milliseconds(200)).num_milliseconds()} ${TimeDelta::nanoseconds(-1).num_nanoseconds():?}`);
    let parses: Vec<(&str, &str)> = Vec::from([
        ("2024-03-05 07:08:09", "%Y-%m-%d %H:%M:%S"),
        ("5/3/24 7:8", "%d/%m/%y %H:%M"),
        ("Tue, 5 Mar 2024 07:08:09", "%a, %d %b %Y %H:%M:%S"),
        ("2024-13-01 00:00:00", "%Y-%m-%d %H:%M:%S"),
        ("2024-02-30 00:00:00", "%Y-%m-%d %H:%M:%S"),
        ("2024-03-05", "%Y-%m-%d %H"),
        ("2024-03-05 01:02:03 extra", "%Y-%m-%d %H:%M:%S"),
        ("2024-03-05x", "%Y-%m-%d"),
        ("2024-03-05 01:02:03.25", "%Y-%m-%d %H:%M:%S%.f"),
        ("2024-03-05 01:02:03 PM", "%Y-%m-%d %I:%M:%S %p"),
        ("2024-03-05   01:02", "%Y-%m-%d %H:%M"),
        ("1709622489", "%s"),
        ("2024-065", "%Y-%j"),
        ("Wed 2024-03-05", "%a %Y-%m-%d"),
    ]);
    for (s, f) in parses.iter() {
        println(`${s} => ${NaiveDateTime::parse_from_str(*s, *f):?}`);
    }
    println(`${NaiveDate::parse_from_str("2024-065", "%Y-%j"):?}`);
    println(`${NaiveTime::parse_from_str("23:59:60.5", "%H:%M:%S%.f"):?}`);
    for s in ["2024-03-05T07:08:09Z", "2024-03-05T07:08:09.5+09:00", "2024-03-05 07:08:09-05:30", "2024-03-05T07:08:09", "2024-03-05T25:08:09Z"].iter() {
        println(`${s} => ${DateTime::parse_from_rfc3339(*s):?}`);
    }
    for s in ["Tue, 5 Mar 2024 07:08:09 +0200", "5 Mar 24 07:08 GMT", "Tue, 05 Mar 2024 07:08:09 EST", "Wed, 5 Mar 2024 07:08:09 +0000"].iter() {
        println(`${s} => ${DateTime::parse_from_rfc2822(*s):?}`);
    }
    for s in [("2024-03-05 07:08:09 +0900", "%Y-%m-%d %H:%M:%S %z"), ("2024-03-05 07:08:09", "%Y-%m-%d %H:%M:%S")].iter() {
        println(`${s.0} => ${DateTime::parse_from_str(s.0, s.1):?}`);
    }
    println(`${"2024-03-05T07:08:09+09:00".parse::<DateTime<Utc>>():?} ${"2024-03-05 07:08:09 +09:00".parse::<DateTime<FixedOffset>>():?}`);
    println(`${DateTime::from_timestamp(-1, 500):?} ${DateTime::from_timestamp_millis(-86_400_001):?}`);
    println(`${Weekday::Sun.succ()} ${"fri".parse::<Weekday>().unwrap()}`);
    let a = NaiveDate::from_ymd_opt(2000, 2, 29).unwrap();
    println(`${NaiveDate::from_ymd_opt(2024, 2, 29).unwrap().years_since(a):?} ${NaiveDate::from_ymd_opt(-5, 3, 1).unwrap()}`);
}
