#![cfg(not(target_os = "windows"))]
// std::env and std::process: variables, directories, Command with pipes,
// environment, working directory; Child wait/kill; stdin of a child.
use std::env;
use std::io::{BufRead, Read, Write};
use std::os::unix::process::ExitStatusExt;
use std::process::{Command, Stdio};

#[test]
fn variables() {
    unsafe { env::set_var("NAVI_EP_VAR", "1"); }
    let listed = env::vars().any(|kv| kv.0 == "NAVI_EP_VAR" && kv.1 == "1");
    let v = env::var("NAVI_EP_VAR");
    unsafe { env::remove_var("NAVI_EP_VAR"); }
    assert_eq(v, Ok("1".to_string()));
    assert(listed);
    assert_eq(env::var("NAVI_EP_VAR").unwrap_err(), env::VarError::NotPresent);
    assert(!env::vars().any(|kv| kv.0 == "NAVI_EP_VAR"));
}

#[test]
fn directories() {
    let start = env::current_dir().unwrap();
    let tmp = std::fs::canonicalize(env::temp_dir()).unwrap();
    env::set_current_dir(&tmp).unwrap();
    let now = env::current_dir().unwrap();
    env::set_current_dir(&start).unwrap();
    assert(now == tmp);
    assert(env::current_dir().unwrap() == start);
    assert_eq(env::consts::FAMILY, "unix");
    assert(env::current_exe().unwrap().is_absolute());
}

#[test]
fn status_and_output() {
    let st = Command::new("sh").args(["-c", "exit 3"]).status().unwrap();
    assert_eq(st.code(), Some(3));
    assert(!st.success());
    assert_eq(st.to_string(), "exit status: 3");
    let out = Command::new("sh").arg("-c").arg("echo out; echo err 1>&2").output().unwrap();
    assert_eq(String::from_utf8(out.stdout).unwrap(), "out\n");
    assert_eq(String::from_utf8(out.stderr).unwrap(), "err\n");
    assert(out.status.success());
}

#[test]
fn environment_and_working_directory() {
    let e1 = Command::new("sh").arg("-c").arg("echo set:$NAVI_EP_X").env("NAVI_EP_X", "").env_remove("NAVI_EP_X").output().unwrap();
    let e2 = Command::new("sh").arg("-c").arg("if [ -z \"$HOME\" ]; then echo cleared; fi").env_clear().output().unwrap();
    assert_eq(String::from_utf8(e1.stdout).unwrap().trim(), "set:");
    assert_eq(String::from_utf8(e2.stdout).unwrap().trim(), "cleared");
    let tmp = std::fs::canonicalize(env::temp_dir()).unwrap();
    let pwd = Command::new("pwd").current_dir(&tmp).output().unwrap();
    let shown = String::from_utf8(pwd.stdout).unwrap();
    assert(std::fs::canonicalize(shown.trim()).unwrap() == tmp);
}

#[test]
fn pipes() {
    let mut tr = Command::new("tr").arg("a-z").arg("A-Z").stdin(Stdio::piped()).stdout(Stdio::piped()).spawn().unwrap();
    let mut tin = tr.stdin.take().unwrap();
    tin.write_all(b"hello pipe").unwrap();
    tin.close();
    let mut upper = String::new();
    tr.stdout.take().unwrap().read_to_string(&mut upper).unwrap();
    tr.wait().unwrap();
    assert_eq(upper, "HELLO PIPE");

    let mut producer = Command::new("sh").arg("-c").arg("echo a; echo b; echo c").stdout(Stdio::piped()).spawn().unwrap();
    let pout = producer.stdout.take().unwrap();
    let counted = Command::new("wc").arg("-l").stdin(pout).output().unwrap();
    producer.wait().unwrap();
    assert_eq(String::from_utf8(counted.stdout).unwrap().trim(), "3");
}

// The child of stdin_of_a_child: this test binary again, running only this
// test (the harness's argument filters the tests by name).
#[test]
fn child_echoes_stdin() {
    if env::var("NAVI_EP_CHILD").is_err() { return; }
    let mut lines: Vec<String> = Vec::new();
    for l in std::io::stdin().lines() { lines.push(l.unwrap()); }
    print(`read ${lines.len()} lines: ${lines.join("|")}\n`);
}

#[test]
fn stdin_of_a_child() {
    let mut me = Command::new(env::current_exe().unwrap().as_str()).arg("child_echoes_stdin").env("NAVI_EP_CHILD", "1")
        .stdin(Stdio::piped()).stdout(Stdio::piped()).spawn().unwrap();
    let mut min = me.stdin.take().unwrap();
    min.write_all(b"alpha\nbeta\r\ngamma").unwrap();
    min.close();
    let mo = me.wait_with_output().unwrap();
    let out = String::from_utf8(mo.stdout).unwrap();
    assert_msg(out.starts_with("read 3 lines: alpha|beta|gamma\n"), out);
}

#[test]
fn kill_and_try_wait() {
    let mut sl = Command::new("sleep").arg("10").spawn().unwrap();
    sl.kill().unwrap();
    let ks = sl.wait().unwrap();
    assert_eq(ks.code(), None);
    assert_eq(ks.signal(), Some(9));
    assert_eq(ks.to_string(), "signal: 9 (SIGKILL)");
    let mut quick = Command::new("sh").arg("-c").arg("exit 0").spawn().unwrap();
    let mut done = false;
    let mut tries = 0;
    while !done && tries < 1000 {
        match quick.try_wait().unwrap() {
            Some(s) => { done = s.success(); }
            None => { std::thread::sleep(std::time::Duration::from_millis(5)); }
        }
        tries += 1;
    }
    assert(done);
}

#[test]
fn missing_program() {
    assert_eq(Command::new("navi-surely-missing-program").output().unwrap_err().kind(), std::io::ErrorKind::NotFound);
}
