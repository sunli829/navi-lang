// out: Point { x: 1, y: 2 }
// out: (4, 6)
// out: true false
// out: Circle(1.5) Rect { w: 2.0, h: 3.0 } Empty
// out: 7.0685773 6
// out: Point {
// out:     x: 1,
// out:     y: 2,
// out: }
use std::fmt;
use std::ops::Add;

#[derive(Debug, Clone, PartialEq)]
struct Point { x: i32, y: i32 }

impl Add for Point {
    type Output = Point;
    fn add(self, o: Point) -> Point { Point { x: self.x + o.x, y: self.y + o.y } }
}

impl fmt::Display for Point {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result { f.write_fmt(`(${self.x}, ${self.y})`) }
}

#[derive(Debug)]
enum Shape { Circle(f64), Rect { w: f64, h: f64 }, Empty }

fn area(s: &Shape) -> f64 {
    match s {
        Shape::Circle(r) => 3.14159 * r * r,
        Shape::Rect { w, h } => w * h,
        Shape::Empty => 0.0,
    }
}

fn main() {
    let p = Point { x: 1, y: 2 };
    println(`${p:?}`);
    let q = p.clone() + Point { x: 3, y: 4 };
    println(`${q}`);
    println(`${p == p.clone()} ${p == q}`);
    let shapes = [Shape::Circle(1.5), Shape::Rect { w: 2.0, h: 3.0 }, Shape::Empty];
    println(`${shapes[0]:?} ${shapes[1]:?} ${shapes[2]:?}`);
    println(`${area(&shapes[0]) as f32} ${area(&shapes[1])}`);
    println(`${p:#?}`);
}
