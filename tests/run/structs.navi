// Structs and enums: derived Debug/Clone/PartialEq, operator overloading
// (Add), a Display impl, matching on enum variants, pretty Debug ({:#?}).
use std::fmt;
use std::ops::Add;

#[derive(Debug, Clone, PartialEq)]
struct Point { x: i32, y: i32 }

impl Add for Point {
    type Output = Point;
    fn add(self, o: Point) -> Point { Point { x: self.x + o.x, y: self.y + o.y } }
}

impl fmt::Display for Point {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result { f.write_fmt(`(${self.x}, ${self.y})`) }
}

#[derive(Debug)]
enum Shape { Circle(f64), Rect { w: f64, h: f64 }, Empty }

fn area(s: &Shape) -> f64 {
    match s {
        Shape::Circle(r) => 3.14159 * r * r,
        Shape::Rect { w, h } => w * h,
        Shape::Empty => 0.0,
    }
}

#[test]
fn derived_debug_and_eq() {
    let p = Point { x: 1, y: 2 };
    assert_eq(`${p:?}`.as_str(), "Point { x: 1, y: 2 }");
    assert(p == p.clone());
    let q = p.clone() + Point { x: 3, y: 4 };
    assert(!(p == q));
    assert_eq(q, Point { x: 4, y: 6 });
}

#[test]
fn display_impl() {
    let q = Point { x: 1, y: 2 } + Point { x: 3, y: 4 };
    assert_eq(`${q}`.as_str(), "(4, 6)");
}

#[test]
fn enum_debug_and_match() {
    let shapes = [Shape::Circle(1.5), Shape::Rect { w: 2.0, h: 3.0 }, Shape::Empty];
    assert_eq(`${shapes[0]:?} ${shapes[1]:?} ${shapes[2]:?}`.as_str(), "Circle(1.5) Rect { w: 2.0, h: 3.0 } Empty");
    assert_eq(`${area(&shapes[0]) as f32} ${area(&shapes[1])}`.as_str(), "7.0685773 6");
    assert_eq(area(&shapes[1]), 6.0);
    assert_eq(area(&shapes[2]), 0.0);
}

#[test]
fn pretty_debug() {
    let p = Point { x: 1, y: 2 };
    assert_eq(`${p:#?}`.as_str(), "Point {\n    x: 1,\n    y: 2,\n}");
}
