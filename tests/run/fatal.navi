// Fatal errors end the process with exit code 2 and a message on stderr
// (as Go's runtime): no panic, nothing can catch them.

// Builds and runs a program (as Go's runtime tests build theirs): navi test
// sets NAVI to the navi running it (as Cargo sets CARGO).
fn run_program(name: &str, src: &str) -> std::process::Output {
    let dir = std::env::temp_dir().join(`navi-${name}-${std::process::id()}`.to_string());
    std::fs::create_dir_all(&dir).unwrap();
    let file = dir.join("main.navi");
    std::fs::write(&file, src).unwrap();
    let exe = dir.join(`prog${std::env::consts::EXE_SUFFIX}`.to_string());
    let navi = std::env::var("NAVI").unwrap();
    let b = std::process::Command::new(navi).arg("build").arg("-o").arg(exe.to_str().unwrap()).arg(file.to_str().unwrap()).output().unwrap();
    assert_msg(b.status.success(), String::from_utf8_lossy(&b.stderr));
    let out = std::process::Command::new(exe.to_str().unwrap()).output().unwrap();
    let _ = std::fs::remove_dir_all(&dir);
    out
}

fn assert_fatal(out: &std::process::Output, message: &str) {
    let err = String::from_utf8_lossy(&out.stderr);
    assert_msg(err.contains(message), err);
    assert_eq(out.status.code(), Some(2));
    assert_eq(out.stdout.len(), 0);
}

#[test]
fn deadlock() {
    let out = run_program("deadlock", r#"
use std::sync::mpmc::sync_channel;

fn main() {
    let (tx, rx) = sync_channel::<i32>(0);
    std::thread::spawn(|| { let _ = rx.recv(); });
    tx.send(1).unwrap();
    tx.send(2).unwrap();
    println("unreachable");
}
"#);
    assert_fatal(&out, "fatal error: all goroutines are asleep - deadlock!");
}

#[test]
fn stack_overflow() {
    let out = run_program("stackoverflow", r#"
fn down(n: i64) -> i64 { if n == 0 { 0 } else { 1 + down(n - 1) } }

fn main() {
    let h = std::thread::spawn(|| down(1000000000));
    println(h.join().unwrap());
}
"#);
    assert_fatal(&out, "fatal error: stack overflow");
}
