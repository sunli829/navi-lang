// std::crypto's AES, AES-GCM, ChaCha20-Poly1305 and HKDF against FIPS 197,
// RFC 5869 and outputs of Go's crypto (the constants at the end).

use std::crypto::aead::{Aead, AeadInPlace, KeyInit, Payload};
use std::crypto::aes::{Aes128, Aes192, Aes256, Key};
use std::crypto::aes_gcm::{AesGcm, Aes128Gcm, Aes256Gcm};
use std::crypto::chacha20poly1305::ChaCha20Poly1305;
use std::crypto::hkdf::Hkdf;
use std::crypto::sha2::{Sha256, Sha384};
use std::hex;

fn h(s: &str) -> Vec<u8> { hex::decode(s).unwrap() }

// The fields of a vector (empty ones too).
fn fields(v: &str) -> Vec<Vec<u8>> {
    let mut out: Vec<Vec<u8>> = Vec::new();
    for f in v.split(' ') { out.push(h(f)); }
    out
}

#[test]
fn aes_fips197() {
    let pt = h("00112233445566778899aabbccddeeff");
    let cases = [
        ("000102030405060708090a0b0c0d0e0f", "69c4e0d86a7b0430d8cdb78070b4c55a"),
        ("000102030405060708090a0b0c0d0e0f1011121314151617", "dda97ca4864cdfe06eaf70a0ec0d7191"),
        ("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f", "8ea2b7ca516745bfeafc49904b496089"),
    ];
    for (k, want) in cases.iter() {
        let key = Key::new(h(*k).as_slice()).unwrap();
        for kk in [key.clone(), key.software()].iter() {
            let mut b = pt.clone();
            kk.encrypt_block(b.as_mut_slice());
            assert_eq(hex::encode(&b), want.to_string());
            kk.decrypt_block(b.as_mut_slice());
            assert_eq(b, pt);
        }
    }
    let mut b = pt.clone();
    Aes128::new_from_slice(h(cases[0].0).as_slice()).unwrap().encrypt_block(b.as_mut_slice());
    assert_eq(hex::encode(&b), cases[0].1.to_string());
    let mut b2 = pt.clone();
    Aes192::new_from_slice(h(cases[1].0).as_slice()).unwrap().encrypt_block(b2.as_mut_slice());
    assert_eq(hex::encode(&b2), cases[1].1.to_string());
    let mut b3 = pt.clone();
    Aes256::new_from_slice(h(cases[2].0).as_slice()).unwrap().encrypt_block(b3.as_mut_slice());
    assert_eq(hex::encode(&b3), cases[2].1.to_string());
    assert(Aes128::new_from_slice(&[0u8; 15]).is_err());
}

#[test]
fn aes_gcm_against_go() {
    for v in GCM.iter() {
        let f = fields(*v);
        let (key, nonce, aad, pt, want) = (&f[0], &f[1], &f[2], &f[3], &f[4]);
        let g = AesGcm::new_any(key.as_slice()).unwrap();
        for c in [g.clone(), g.software()].iter() {
            let mut buf = pt.clone();
            let tag = c.encrypt_in_place_detached(nonce.as_slice(), aad.as_slice(), buf.as_mut_slice()).unwrap();
            buf.extend_from_slice(tag.as_slice());
            assert_eq(hex::encode(&buf), hex::encode(want));
            let n = want.len() - 16;
            let mut back = want[..n].to_vec();
            c.decrypt_in_place_detached(nonce.as_slice(), aad.as_slice(), back.as_mut_slice(), &want[n..]).unwrap();
            assert_eq(back, pt.clone());
        }
    }
}

#[test]
fn aead_api_and_tampering() {
    let f = fields(GCM[35]);
    let c = Aes256Gcm::new_from_slice(f[0].as_slice()).unwrap();
    let ct = c.encrypt(f[1].as_slice(), Payload { msg: f[3].as_slice(), aad: f[2].as_slice() }).unwrap();
    assert_eq(hex::encode(&ct), hex::encode(&f[4]));
    let pt = c.decrypt(f[1].as_slice(), Payload { msg: ct.as_slice(), aad: f[2].as_slice() }).unwrap();
    assert_eq(pt, f[3].clone());
    // A flipped bit anywhere, other data or another nonce: an error.
    let mut bad = ct.clone();
    bad[3] = bad[3] ^ 1;
    assert(c.decrypt(f[1].as_slice(), Payload { msg: bad.as_slice(), aad: f[2].as_slice() }).is_err());
    let mut badtag = ct.clone();
    let last = badtag.len() - 1;
    badtag[last] = badtag[last] ^ 0x80;
    assert(c.decrypt(f[1].as_slice(), Payload { msg: badtag.as_slice(), aad: f[2].as_slice() }).is_err());
    assert(c.decrypt(f[1].as_slice(), Payload { msg: ct.as_slice(), aad: b"other" }).is_err());
    let mut n2 = f[1].clone();
    n2[0] = n2[0] ^ 1;
    assert(c.decrypt(n2.as_slice(), Payload { msg: ct.as_slice(), aad: f[2].as_slice() }).is_err());
    assert(c.encrypt(&[0u8; 8], b"x").is_err());
    assert(Aes128Gcm::new_from_slice(&[0u8; 32]).is_err());
    let c128 = Aes128Gcm::new_from_slice(&[7u8; 16]).unwrap();
    let rt = c128.encrypt(&[1u8; 12], b"hello").unwrap();
    assert_eq(c128.decrypt(&[1u8; 12], rt.as_slice()).unwrap(), b"hello".to_vec());
}

// The CPU's instructions (on arm64 counter mode and GHASH in one pass,
// eight blocks at a time) against software AES-GCM, over lengths around
// the groups of eight; a wrong tag leaves the buffer as it was.
#[test]
fn aes_gcm_hardware_matches_software() {
    let keys = [16, 24, 32];
    for kl in keys.iter() {
        let mut key: Vec<u8> = Vec::new();
        let mut i = 0;
        while i < *kl {
            key.push((i * 7 + 3) as u8);
            i += 1;
        }
        let hw = AesGcm::new_any(key.as_slice()).unwrap();
        let sw = hw.software();
        let nonce = h("cafebabefacedbaddecaf888");
        let aad = h("feedfacedeadbeeffeedfacedeadbeefabaddad2");
        let mut n = 0;
        while n <= 1100 {
            let mut pt: Vec<u8> = Vec::new();
            i = 0;
            while i < n {
                pt.push((i * 31 + n) as u8);
                i += 1;
            }
            let mut a = pt.clone();
            let mut b = pt.clone();
            let ta = hw.encrypt_in_place_detached(nonce.as_slice(), aad.as_slice(), a.as_mut_slice()).unwrap();
            let tb = sw.encrypt_in_place_detached(nonce.as_slice(), aad.as_slice(), b.as_mut_slice()).unwrap();
            assert_eq(&a, &b);
            assert_eq(&ta, &tb);
            let mut bad = ta.clone();
            bad[0] = bad[0] ^ 1;
            assert(hw.decrypt_in_place_detached(nonce.as_slice(), aad.as_slice(), a.as_mut_slice(), bad.as_slice()).is_err());
            assert_eq(&a, &b);
            hw.decrypt_in_place_detached(nonce.as_slice(), aad.as_slice(), a.as_mut_slice(), ta.as_slice()).unwrap();
            assert_eq(&a, &pt);
            n += if n < 300 { 1 } else { 37 };
        }
    }
}

#[test]
fn chacha20poly1305_against_go() {
    for v in CHACHA.iter() {
        let f = fields(*v);
        let c = ChaCha20Poly1305::new_from_slice(f[0].as_slice()).unwrap();
        let ct = c.encrypt(f[1].as_slice(), Payload { msg: f[3].as_slice(), aad: f[2].as_slice() }).unwrap();
        assert_eq(hex::encode(&ct), hex::encode(&f[4]));
        let pt = c.decrypt(f[1].as_slice(), Payload { msg: ct.as_slice(), aad: f[2].as_slice() }).unwrap();
        assert_eq(pt, f[3].clone());
        let mut bad = ct.clone();
        bad[0] = bad[0] ^ 4;
        assert(c.decrypt(f[1].as_slice(), Payload { msg: bad.as_slice(), aad: f[2].as_slice() }).is_err());
    }
}

#[test]
fn hkdf_rfc5869_and_go() {
    // RFC 5869 A.1.
    let hk = Hkdf::<Sha256>::new(Some(h("000102030405060708090a0b0c").as_slice()), h("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b").as_slice());
    let mut okm: [u8; 42] = [0; 42];
    hk.expand(h("f0f1f2f3f4f5f6f7f8f9").as_slice(), &mut okm).unwrap();
    assert_eq(hex::encode(&okm), "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865".to_string());
    for v in HKDF256.iter() {
        let f = fields(*v);
        let hk = Hkdf::<Sha256>::new(Some(f[0].as_slice()), f[1].as_slice());
        let mut out: Vec<u8> = Vec::new();
        out.resize(f[3].len(), 0);
        hk.expand(f[2].as_slice(), out.as_mut_slice()).unwrap();
        assert_eq(hex::encode(&out), hex::encode(&f[3]));
    }
    for v in HKDF384.iter() {
        let f = fields(*v);
        let hk = Hkdf::<Sha384>::new(Some(f[0].as_slice()), f[1].as_slice());
        let mut out: Vec<u8> = Vec::new();
        out.resize(f[3].len(), 0);
        hk.expand(f[2].as_slice(), out.as_mut_slice()).unwrap();
        assert_eq(hex::encode(&out), hex::encode(&f[3]));
    }
    let mut too_long: Vec<u8> = Vec::new();
    too_long.resize(255 * 32 + 1, 0);
    assert(hk.expand(b"", too_long.as_mut_slice()).is_err());
}

