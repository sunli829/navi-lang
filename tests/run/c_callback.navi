// C calling back into navi (qsort's comparator): callbacks that allocate
// and collect, grow their stack, call C again, wait for another thread, and
// run on several threads at once; extern "C" fn values called from navi;
// callbacks allocating while a collection marks (their mark assists scan
// their stacks on the system stack below C's frames).
use std::sync::atomic::{AtomicUsize, Ordering};
use std::sync::mpmc::sync_channel;

extern "C" {
    fn qsort(base: *mut u8, n: usize, size: usize, cmp: extern "C" fn(*const u8, *const u8) -> i32);
}

static mut CALLS: usize = 0;

fn deep(n: u64) -> u64 { if n == 0 { 0 } else { 1 + deep(n - 1) } }

// Compares two i32 (allocating and collecting meanwhile).
extern "C" fn cmp_i32(a: *const u8, b: *const u8) -> i32 {
    let x = unsafe { *(a as *const i32) };
    let y = unsafe { *(b as *const i32) };
    let mut v: Vec<String> = Vec::new();
    v.push(`${x} ${y}`.to_string());
    CALLS += 1;
    if CALLS % 5 == 0 { std::gc::collect(); }
    if x < y { -1 } else if x > y { 1 } else { 0 }
}

// Grows its stack well past the first one.
extern "C" fn cmp_deep(a: *const u8, b: *const u8) -> i32 {
    let d = deep(3000);
    if d != 3000 { return 0; }
    let x = unsafe { *(a as *const i32) };
    let y = unsafe { *(b as *const i32) };
    x - y
}

// Sorts each pair (a C call from a callback, calling back in turn).
extern "C" fn cmp_rows(a: *const u8, b: *const u8) -> i32 {
    let pa = a as *mut [i32; 2];
    let pb = b as *mut [i32; 2];
    unsafe {
        qsort(pa as *mut u8, 2, 4, cmp_i32);
        qsort(pb as *mut u8, 2, 4, cmp_i32);
        (*pa)[0] - (*pb)[0]
    }
}

extern "C" fn scale(x: f64, k: i32) -> f64 { x * k as f64 }

// Compares two i32 after allocating a few KiB (some kept a while).
extern "C" fn cmp_alloc(a: *const u8, b: *const u8) -> i32 {
    let x = unsafe { *(a as *const i32) };
    let y = unsafe { *(b as *const i32) };
    let mut v: Vec<u64> = Vec::new();
    v.resize(512, x as u64);
    let mut keep: Vec<Vec<u64>> = Vec::new();
    keep.push(v);
    let mut w: Vec<u64> = Vec::new();
    w.resize(256, y as u64);
    keep.push(w);
    if keep[0][0] as i32 != x || keep[1][255] as i32 != y {
        return 0;
    }
    if x < y { -1 } else if x > y { 1 } else { 0 }
}

static mut WAITED: i32 = 0;

// Waits for another thread inside a callback.
extern "C" fn cmp_wait(a: *const u8, b: *const u8) -> i32 {
    if WAITED == 0 {
        let (tx, rx) = sync_channel::<i32>(0);
        std::thread::spawn(|| { tx.send(42).unwrap(); });
        WAITED = rx.recv().unwrap();
    }
    unsafe { *(a as *const i32) - *(b as *const i32) }
}

#[test]
fn callback_allocates_and_collects() {
    let mut v = Vec::from([5i32, 3, 9, 1, 8, 2]);
    unsafe { qsort(v.as_mut_ptr() as *mut u8, v.len(), 4, cmp_i32); }
    assert_eq(v, Vec::from([1i32, 2, 3, 5, 8, 9]));
}

#[test]
fn callback_grows_its_stack() {
    let mut w = Vec::from([4i32, 2, 7, 1]);
    unsafe { qsort(w.as_mut_ptr() as *mut u8, w.len(), 4, cmp_deep); }
    assert_eq(w, Vec::from([1i32, 2, 4, 7]));
    assert_eq(deep(3000), 3000);
}

#[test]
fn callback_calls_c_again() {
    let mut rows = Vec::from([[4i32, 3], [2, 1]]);
    unsafe { qsort(rows.as_mut_ptr() as *mut u8, 2, 8, cmp_rows); }
    assert_eq(rows, Vec::from([[1i32, 2], [3, 4]]));
}

#[test]
fn extern_c_fn_value() {
    let f: extern "C" fn(f64, i32) -> f64 = scale;
    assert_eq(`${f(2.5, 3)}`.to_string(), "7.5");
}

#[test]
fn callback_waits_for_another_thread() {
    let mut z = Vec::from([3i32, 1, 2]);
    unsafe { qsort(z.as_mut_ptr() as *mut u8, z.len(), 4, cmp_wait); }
    assert_eq(WAITED, 42);
}

#[test]
fn callbacks_on_several_threads() {
    let total = &AtomicUsize::new(0);
    let mut hs = Vec::new();
    let mut t = 0;
    while t < 8 {
        hs.push(std::thread::spawn(|| {
            let mut r = 0;
            while r < 100 {
                let mut u: Vec<i32> = Vec::new();
                let mut i = 0;
                while i < 10 {
                    u.push((i * 7 + r) % 10);
                    i += 1;
                }
                unsafe { qsort(u.as_mut_ptr() as *mut u8, u.len(), 4, cmp_i32); }
                total.fetch_add(u.len(), Ordering::Relaxed);
                r += 1;
            }
        }));
        t += 1;
    }
    for h in hs.iter() { h.join().unwrap(); }
    assert_eq(total.load(Ordering::Relaxed), 8000);
}

#[test]
fn callbacks_allocate_while_a_collection_marks() {
    let mut hs = Vec::new();
    let mut t = 0;
    while t < 8 {
        hs.push(std::thread::spawn(|| -> bool {
            let mut ok = true;
            let mut r = 0;
            while r < 20 {
                let mut u: Vec<i32> = Vec::new();
                let mut i = 0;
                while i < 500 {
                    u.push((i * 7919 + r * 31) % 1000);
                    i += 1;
                }
                unsafe { qsort(u.as_mut_ptr() as *mut u8, u.len(), 4, cmp_alloc); }
                let mut k = 1;
                while k < u.len() {
                    if u[k - 1] > u[k] {
                        ok = false;
                    }
                    k += 1;
                }
                r += 1;
            }
            ok
        }));
        t += 1;
    }
    for h in hs.iter() { assert(h.join().unwrap()); }
}

