// Runtime reflection (std::reflect, std::any::type_name): no annotations.
use std::reflect::{self, Kind};
use std::collections::HashMap;

#[derive(Debug)]
struct Point { x: i32, y: f64, name: String }

#[derive(Debug)]
enum Shape { Circle(f64), Rect { w: i32, h: i32 }, Empty }

fn show<T>(x: &T) -> String {
    let v = reflect::value_of(x);
    `${std::any::type_name::<T>()} kind=${v.kind():?}`.to_string()
}

#[test]
fn struct_type_and_fields() {
    let t = reflect::type_of::<Point>();
    assert_eq(`${t} ${t.kind():?} size=${t.size()}`.to_string(), "Point Struct size=24");
    let mut fs: Vec<String> = Vec::new();
    for f in t.fields().iter() { fs.push(`${f.name}: ${f.ty} @${f.offset}`.to_string()); }
    assert_eq(fs, Vec::from([String::from("x: i32 @0"), String::from("y: f64 @8"), String::from("name: String @16")]));
}

#[test]
fn set_struct_fields() {
    let mut p = Point { x: 1, y: 2.5, name: String::from("a") };
    let mut v = reflect::value_of_mut(&mut p);
    v.field_named("x").unwrap().set_i64(42);
    v.field_named("name").unwrap().set_str("hello");
    assert_eq(`${p:?}`.to_string(), "Point { x: 42, y: 2.5, name: \"hello\" }");
    assert_eq(reflect::value_of(&p).field(1).as_f64(), 2.5);
}

#[test]
fn enum_variants() {
    let st = reflect::type_of::<Shape>();
    let mut vs: Vec<String> = Vec::new();
    for var in st.variants().iter() { vs.push(`variant ${var.name} discr=${var.discr} fields=${var.fields.len()}`.to_string()); }
    assert_eq(vs, Vec::from([
        String::from("variant Circle discr=0 fields=1"),
        String::from("variant Rect discr=1 fields=2"),
        String::from("variant Empty discr=2 fields=0"),
    ]));
    let mut s = Shape::Empty;
    let mut sv = reflect::value_of_mut(&mut s);
    assert_eq(`${sv.variant_name()}`.to_string(), "Empty");
    sv.set_variant(1);
    sv.variant_field(1).set_i64(7);
    assert_eq(`${s:?}`.to_string(), "Rect { w: 0, h: 7 }");
    let o: Option<&Point> = None;
    assert_eq(`${reflect::value_of(&o).variant_name()}`.to_string(), "None");
}

#[test]
fn vec_push_through_reflection() {
    let mut xs: Vec<i64> = Vec::new();
    let mut xv = reflect::value_of_mut(&mut xs);
    let mut i = 0;
    while i < 5 { xv.push().set_i64(i * 10); i += 1; }
    assert_eq(xs, Vec::from([0i64, 10, 20, 30, 40]));
    assert_eq(reflect::value_of(&xs).len(), 5);
}

#[test]
fn map_insert_through_reflection() {
    let mut m: HashMap<String, i32> = HashMap::new();
    m.insert(String::from("one"), 1);
    let mut mv = reflect::value_of_mut(&mut m);
    let mut k = reflect::Value::new(reflect::type_of::<String>());
    k.set_str("two");
    let mut val = reflect::Value::new(reflect::type_of::<i32>());
    val.set_i64(2);
    mv.map_insert(&k, &val);
    let mut keys: Vec<String> = Vec::new();
    for (kk, vv) in reflect::value_of(&m).map_entries().iter() { keys.push(`${kk.as_str()}=${vv.as_i64()}`.to_string()); }
    keys.sort();
    assert_eq(keys, Vec::from([String::from("one=1"), String::from("two=2")]));
}

#[test]
fn type_names_and_kinds() {
    let p = Point { x: 42, y: 2.5, name: String::from("hello") };
    assert_eq(show(&3u8).as_str(), "u8 kind=U8");
    assert_eq(show(&"str").as_str(), "&str kind=Ref");
    assert_eq(show(&(1, true)).as_str(), "(i32, bool) kind=Tuple");
    assert_eq(show(&p).as_str(), "Point kind=Struct");
    let r = &p;
    assert_eq(show(&r).as_str(), "&Point kind=Ref");
}
