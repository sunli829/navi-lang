// stage0: skip
// Runtime reflection (std::reflect, std::any::type_name): no annotations.
// out: Point Struct size=24
// out:   x: i32 @0
// out:   y: f64 @8
// out:   name: String @16
// out: Point { x: 42, y: 2.5, name: "hello" } y=2.5
// out:   variant Circle discr=0 fields=1
// out:   variant Rect discr=1 fields=2
// out:   variant Empty discr=2 fields=0
// out: variant Empty
// out: Rect { w: 0, h: 7 }
// out: opt None
// out: [0, 10, 20, 30, 40] len=5
// out: ["one=1", "two=2"]
// out: u8 kind=U8
// out: &str kind=Ref
// out: (i32, bool) kind=Tuple
// out: Point kind=Struct
// out: &Point kind=Ref
use std::reflect::{self, Kind};
use std::collections::HashMap;

#[derive(Debug)]
struct Point { x: i32, y: f64, name: String }

#[derive(Debug)]
enum Shape { Circle(f64), Rect { w: i32, h: i32 }, Empty }

fn show<T>(x: &T) {
    let v = reflect::value_of(x);
    println(`${std::any::type_name::<T>()} kind=${v.kind():?}`);
}

fn main() {
    let t = reflect::type_of::<Point>();
    println(`${t} ${t.kind():?} size=${t.size()}`);
    for f in t.fields().iter() { println(`  ${f.name}: ${f.ty} @${f.offset}`); }
    let mut p = Point { x: 1, y: 2.5, name: String::from("a") };
    let mut v = reflect::value_of_mut(&mut p);
    v.field_named("x").unwrap().set_i64(42);
    v.field_named("name").unwrap().set_str("hello");
    println(`${p:?} y=${reflect::value_of(&p).field(1).as_f64()}`);
    let st = reflect::type_of::<Shape>();
    for var in st.variants().iter() { println(`  variant ${var.name} discr=${var.discr} fields=${var.fields.len()}`); }
    let mut s = Shape::Empty;
    let mut sv = reflect::value_of_mut(&mut s);
    println(`variant ${sv.variant_name()}`);
    sv.set_variant(1);
    sv.variant_field(1).set_i64(7);
    println(`${s:?}`);
    let o: Option<&Point> = None;
    println(`opt ${reflect::value_of(&o).variant_name()}`);
    let mut xs: Vec<i64> = Vec::new();
    let mut xv = reflect::value_of_mut(&mut xs);
    let mut i = 0;
    while i < 5 { xv.push().set_i64(i * 10); i += 1; }
    println(`${xs:?} len=${reflect::value_of(&xs).len()}`);
    let mut m: HashMap<String, i32> = HashMap::new();
    m.insert(String::from("one"), 1);
    let mut mv = reflect::value_of_mut(&mut m);
    let mut k = reflect::Value::new(reflect::type_of::<String>());
    k.set_str("two");
    let mut val = reflect::Value::new(reflect::type_of::<i32>());
    val.set_i64(2);
    mv.map_insert(&k, &val);
    let mut keys: Vec<String> = Vec::new();
    for (kk, vv) in reflect::value_of(&m).map_entries().iter() { keys.push(`${kk.as_str()}=${vv.as_i64()}`); }
    keys.sort();
    println(`${keys:?}`);
    show(&3u8);
    show(&"str");
    show(&(1, true));
    show(&p);
    let r = &p;
    show(&r);
}
