// u64::carrying_add / borrowing_sub (the add_carry / sub_borrow
// intrinsics: adds/adcs and subs/sbcs chains, add/adc and sub/sbb) against
// the same by comparisons, on edge and random words and four-limb chains.

fn ref_add(a: u64, b: u64, c: bool) -> (u64, bool) {
    let s = a.wrapping_add(b);
    let s2 = s.wrapping_add(c as u64);
    (s2, s < a || s2 < s)
}

fn ref_sub(a: u64, b: u64, c: bool) -> (u64, bool) {
    let d = a.wrapping_sub(b);
    let d2 = d.wrapping_sub(c as u64);
    (d2, a < b || d < c as u64)
}

// A chain whose carries stay in the flags (loads in between).
fn add4(a: &[u64; 4], b: &[u64; 4]) -> ([u64; 4], bool) {
    let (s0, c) = a[0].carrying_add(b[0], false);
    let (s1, c) = a[1].carrying_add(b[1], c);
    let (s2, c) = a[2].carrying_add(b[2], c);
    let (s3, c) = a[3].carrying_add(b[3], c);
    ([s0, s1, s2, s3], c)
}

fn sub4(a: &[u64; 4], b: &[u64; 4]) -> ([u64; 4], bool) {
    let (s0, c) = a[0].borrowing_sub(b[0], false);
    let (s1, c) = a[1].borrowing_sub(b[1], c);
    let (s2, c) = a[2].borrowing_sub(b[2], c);
    let (s3, c) = a[3].borrowing_sub(b[3], c);
    ([s0, s1, s2, s3], c)
}

#[test]
fn carries() {
    let picks = [0u64, 1, 2, u64::MAX, u64::MAX - 1, 1 << 63];
    let mut x = 88172645463325252u64;
    let mut i = 0;
    while i < 20000 {
        let mut v: [u64; 9] = [0; 9];
        let mut k = 0;
        while k < 9 {
            x ^= x << 13;
            x ^= x >> 7;
            x ^= x << 17;
            v[k] = if (x & 3) == 0 { picks[((x >> 8) % 6) as usize] } else { x };
            k += 1;
        }
        let c = (v[8] & 1) == 1;
        assert_eq(v[0].carrying_add(v[1], c), ref_add(v[0], v[1], c));
        assert_eq(v[0].borrowing_sub(v[1], c), ref_sub(v[0], v[1], c));
        let a = [v[0], v[1], v[2], v[3]];
        let b = [v[4], v[5], v[6], v[7]];
        let (s, sc) = add4(&a, &b);
        let (d, db) = sub4(&a, &b);
        let mut cs = false;
        let mut cd = false;
        let mut j = 0;
        while j < 4 {
            let (w, c2) = ref_add(a[j], b[j], cs);
            assert_eq(s[j], w);
            cs = c2;
            let (w2, b2) = ref_sub(a[j], b[j], cd);
            assert_eq(d[j], w2);
            cd = b2;
            j += 1;
        }
        assert_eq(sc, cs);
        assert_eq(db, cd);
        i += 1;
    }
}
