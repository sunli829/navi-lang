// stage0: skip
// thread::sleep (timers park green threads), Condvar::wait_timeout, SystemTime, Duration.
// out: slept true
// out: 1000 sleepers 499500 true
// out: order [1, 2, 3, 4, 5]
// out: timeout true
// out: notified true
// out: epoch true
// out: dur 1.5 3000 None
use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
use std::thread;
use std::sync::{Mutex, Condvar};

fn main() {
    let t0 = Instant::now();
    thread::sleep(Duration::from_millis(50));
    let e = t0.elapsed();
    println(`slept ${e >= Duration::from_millis(50) && e < Duration::from_millis(500)}`);
    // Many sleeping threads do not need many OS threads.
    let t1 = Instant::now();
    let mut hs = Vec::new();
    let mut i = 0;
    while i < 1000 {
        let k = i;
        hs.push(thread::spawn(|| { thread::sleep(Duration::from_millis(100 + (k % 10) as u64)); k }));
        i += 1;
    }
    let mut sum = 0;
    for h in hs.iter() { sum += h.join().unwrap(); }
    let e1 = t1.elapsed();
    println(`1000 sleepers ${sum} ${e1 < Duration::from_millis(1000)}`);
    // Ordering of wakeups.
    let m = &Mutex::new(Vec::<i32>::new());
    let mut hs2 = Vec::new();
    let mut j = 5;
    while j > 0 {
        let d = j;
        hs2.push(thread::spawn(|| { thread::sleep(Duration::from_millis(30 * d as u64)); m.lock().push(d); m.unlock(); }));
        j -= 1;
    }
    for h in hs2.iter() { h.join().unwrap(); }
    println(`order ${m.lock():?}`);
    m.unlock();
    // Condvar timeout and notification.
    let cm = &Mutex::new(false);
    let cv = &Condvar::new();
    cm.lock();
    let r = cv.wait_timeout(cm, Duration::from_millis(30));
    cm.unlock();
    println(`timeout ${r.timed_out()}`);
    let h = thread::spawn(|| { thread::sleep(Duration::from_millis(20)); *cm.lock() = true; cm.unlock(); cv.notify_all(); });
    let flag = cm.lock();
    let mut timed = false;
    while !*flag {
        timed = cv.wait_timeout(cm, Duration::from_secs(5)).timed_out();
    }
    cm.unlock();
    h.join().unwrap();
    println(`notified ${!timed}`);
    let now = SystemTime::now();
    let since = now.duration_since(UNIX_EPOCH).unwrap();
    println(`epoch ${since.as_secs() > 1700000000}`);
    println(`dur ${Duration::new(1, 500000000).as_secs_f64()} ${(Duration::from_millis(1500) * 2).as_millis()} ${Duration::from_secs(1).checked_sub(Duration::from_secs(2)):?}`);
}
