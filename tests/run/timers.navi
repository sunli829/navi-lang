// thread::sleep (timers park green threads), Condvar::wait_timeout, SystemTime, Duration.
// (Bounds are loose: CI machines are slow and shared.)
use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
use std::thread;
use std::sync::{Mutex, Condvar};

#[test]
fn sleep() {
    let t0 = Instant::now();
    thread::sleep(Duration::from_millis(50));
    let e = t0.elapsed();
    assert(e >= Duration::from_millis(50) && e < Duration::from_millis(3000));
}

#[test]
fn many_sleepers() {
    // Many sleeping threads do not need many OS threads.
    let t1 = Instant::now();
    let mut hs = Vec::new();
    let mut i = 0;
    while i < 1000 {
        let k = i;
        hs.push(thread::spawn(|| { thread::sleep(Duration::from_millis(100 + (k % 10) as u64)); k }));
        i += 1;
    }
    let mut sum = 0;
    for h in hs.iter() { sum += h.join().unwrap(); }
    let e1 = t1.elapsed();
    assert_eq(sum, 499500);
    assert(e1 < Duration::from_millis(5000));
}

#[test]
fn deadlines() {
    // Sleepers started at once wake no earlier than their deadlines. (Not
    // checked: that they wake in deadline order, which a machine that stops
    // a thread for longer than the gap breaks.)
    let t2 = Instant::now();
    let mut hs2 = Vec::new();
    let mut j = 5;
    while j > 0 {
        let d = j;
        hs2.push(thread::spawn(|| { thread::sleep(Duration::from_millis(30 * d as u64)); (d, t2.elapsed() >= Duration::from_millis(30 * d as u64)) }));
        j -= 1;
    }
    let mut on_time = Vec::new();
    for h in hs2.iter() { on_time.push(h.join().unwrap()); }
    on_time.sort();
    assert_eq(on_time, Vec::from([(1, true), (2, true), (3, true), (4, true), (5, true)]));
}

#[test]
fn condvar_timeout_and_notify() {
    let cm = &Mutex::new(false);
    let cv = &Condvar::new();
    cm.lock();
    let r = cv.wait_timeout(cm, Duration::from_millis(30));
    cm.unlock();
    assert(r.timed_out());
    let h = thread::spawn(|| { thread::sleep(Duration::from_millis(20)); *cm.lock() = true; cm.unlock(); cv.notify_all(); });
    let flag = cm.lock();
    let mut timed = false;
    while !*flag {
        timed = cv.wait_timeout(cm, Duration::from_secs(5)).timed_out();
    }
    cm.unlock();
    h.join().unwrap();
    assert(!timed);
}

#[test]
fn system_time() {
    let now = SystemTime::now();
    let since = now.duration_since(UNIX_EPOCH).unwrap();
    assert(since.as_secs() > 1700000000);
}

#[test]
fn duration() {
    assert_eq(Duration::new(1, 500000000).as_secs_f64(), 1.5);
    assert_eq(`${Duration::new(1, 500000000).as_secs_f64()}`.to_string(), "1.5");
    assert_eq((Duration::from_millis(1500) * 2).as_millis(), 3000);
    assert_eq(Duration::from_secs(1).checked_sub(Duration::from_secs(2)), None);
}

// Timer channels in select: a timeout (after), periodic ticks (Ticker,
// stopped), and a message winning over a later timeout.
#[test]
fn timer_channels() {
    let (tx, rx) = std::sync::mpmc::channel::<i32>();
    let t0 = Instant::now();
    let mut timed_out = false;
    select {
        v = rx.recv() => panic(`unexpected ${v:?}`),
        t = std::time::after(Duration::from_millis(30)).recv() => timed_out = t.is_ok(),
    }
    assert(timed_out);
    assert(t0.elapsed() >= Duration::from_millis(30));
    tx.send(7).unwrap();
    let mut got = 0;
    select {
        v = rx.recv() => got = v.unwrap(),
        t = std::time::after(Duration::from_secs(5)).recv() => panic("timed out"),
    }
    assert_eq(got, 7);
    let tk = std::time::Ticker::new(Duration::from_millis(10));
    let t1 = Instant::now();
    let mut n = 0;
    while n < 3 {
        tk.recv();
        n += 1;
    }
    tk.stop();
    assert(t1.elapsed() >= Duration::from_millis(30));
    let ch = std::time::tick(Duration::from_millis(5));
    ch.recv().unwrap();
    ch.recv().unwrap();
}
