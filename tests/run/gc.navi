// The collector must keep reachable objects (through stack, statics,
// interior pointers, closures and dyn) and reclaim the rest: about 2 GB is
// allocated in total while the peak memory stays small.

use std::panic::assert_msg;

struct Node { value: i64, next: Option<&Node> }

static mut KEEP: Option<&Node> = None;

#[cfg(target_os = "macos")]
extern "C" {
    fn getrusage(who: i32, usage: *mut u8) -> i32;
}

#[cfg(target_os = "windows")]
fn max_rss_mb() -> i64 { 0 }

// The peak of this process: ru_maxrss (bytes on macOS).
#[cfg(target_os = "macos")]
fn max_rss_mb() -> i64 {
    let mut buf = [0u8; 256];
    unsafe { getrusage(0, &mut buf as *mut [u8; 256] as *mut u8); }
    let mut v: i64 = 0;
    let mut i = 7;
    loop {
        v = v * 256 + buf[32 + i] as i64;
        if i == 0 { break; }
        i -= 1;
    }
    v / 1048576
}

// On Linux ru_maxrss survives exec: a program started with posix_spawn
// (as navi test starts this one) would report its parent's peak. VmHWM is
// this process's own.
#[cfg(target_os = "linux")]
fn max_rss_mb() -> i64 {
    let status = std::fs::read_to_string("/proc/self/status").unwrap();
    for line in status.lines() {
        if let Some(kb) = line.strip_prefix("VmHWM:") {
            return kb.trim().trim_end_matches(" kB").parse::<i64>().unwrap() / 1024;
        }
    }
    0
}

fn churn(n: i64) -> i64 {
    let mut total = 0;
    let mut i = 0;
    while i < n {
        let mut v: Vec<i64> = Vec::new();
        let mut j = 0;
        while j < 100 { v.push(j); j += 1; }
        let s = `temporary string number ${i} with some padding to make it longer`.to_string();
        total += v.len() as i64 + s.len() as i64;
        i += 1;
    }
    total
}

#[test]
fn reachable_objects_survive_and_garbage_is_reclaimed() {
    // A list reachable only from a static.
    let mut head: Option<&Node> = None;
    let mut i = 0;
    while i < 1000 {
        head = Some(&Node { value: i, next: head });
        i += 1;
    }
    KEEP = head;
    // Interior pointer into a vector, a closure environment and a dyn.
    let words: Vec<String> = vec_of_strings();
    let inner: &String = &words[500];
    let count = 1000;
    let f = |x: i64| x + count;
    let d: &dyn std::fmt::Display = &words[999];

    let mut t = 0;
    let mut round = 0;
    while round < 20 {
        t += churn(10000);
        round += 1;
    }

    let mut sum = 0;
    let mut cur = KEEP;
    while let Some(n) = cur {
        sum += n.value;
        cur = n.next;
    }
    assert_eq(sum, 499500);
    assert_eq(inner.as_str(), "word 500");
    assert_eq(d.to_string(), "word 999");
    assert_eq(f(0), 1000);
    let rss = max_rss_mb();
    assert_msg(rss < 300, `rss too high: ${rss} MB (allocated ${t})`);
}

fn vec_of_strings() -> Vec<String> {
    let mut v = Vec::new();
    let mut i = 0;
    while i < 1000 {
        v.push(`word ${i}`.to_string());
        i += 1;
    }
    v
}
