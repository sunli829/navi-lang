// out: HELLO hello
// out: ["a", "b", "c"]
// out: [one] [two]
// out: true true false Some(6)
// out: 42 Err(ParseIntError)
// out: héllo 6 5
// out: abc!
fn main() {
    let s = "Hello";
    println(`${s.to_uppercase()} ${s.to_lowercase()}`);
    let parts: Vec<&str> = "a,b,c".split(",").collect();
    println(`${parts:?}`);
    let mut out = String::new();
    for w in "  one   two ".split_whitespace() { out.push_str(&`[${w}] `); }
    println(out.trim_end());
    let t = "hello world";
    println(`${t.starts_with("hell")} ${t.contains("o w")} ${t.ends_with("x")} ${t.find("world"):?}`);
    let n: i32 = "42".parse().unwrap();
    let bad: Result<i32, std::str::ParseIntError> = "4x".parse();
    println(`${n} ${bad:?}`);
    let u = String::from("héllo");
    println(`${u} ${u.len()} ${u.chars().count()}`);
    let mut x = String::from("abc");
    x.push('!');
    println(x);
}
