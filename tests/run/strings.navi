// String and &str methods: case, split, search, parse, UTF-8 lengths, push.
#[test]
fn case_conversion() {
    let s = "Hello";
    assert_eq(s.to_uppercase(), String::from("HELLO"));
    assert_eq(s.to_lowercase(), String::from("hello"));
}

#[test]
fn split_and_split_whitespace() {
    let parts: Vec<&str> = "a,b,c".split(",").collect();
    assert_eq(parts, Vec::from(["a", "b", "c"]));
    assert_eq(`${parts:?}`.to_string(), "[\"a\", \"b\", \"c\"]");
    let mut out = String::new();
    for w in "  one   two ".split_whitespace() { out.push_str(&`[${w}] `.to_string()); }
    assert_eq(out.trim_end(), "[one] [two]");
}

#[test]
fn search() {
    let t = "hello world";
    assert(t.starts_with("hell"));
    assert(t.contains("o w"));
    assert(!t.ends_with("x"));
    assert_eq(t.find("world"), Some(6));
}

#[test]
fn parse() {
    let n: i32 = "42".parse().unwrap();
    assert_eq(n, 42);
    let bad: Result<i32, std::str::ParseIntError> = "4x".parse();
    assert(bad.is_err());
    assert_eq(`${bad:?}`.to_string(), "Err(ParseIntError)");
}

#[test]
fn utf8_lengths() {
    let u = String::from("héllo");
    assert_eq(`${u}`.to_string(), "héllo");
    assert_eq(u.len(), 6);
    assert_eq(u.chars().count(), 5);
}

#[test]
fn push_char() {
    let mut x = String::from("abc");
    x.push('!');
    assert_eq(x, String::from("abc!"));
}
