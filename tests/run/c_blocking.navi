// interp: skip (no C calls in the interpreter)
// stage0: skip (stage0 does not wrap C calls)
// out: collected while the C call blocked
// out: nonblocking 5
use std::sync::atomic::{AtomicUsize, Ordering};

extern "C" {
    fn usleep(us: u32) -> i32;
}

#[nonblocking]
extern "C" {
    fn labs(x: i64) -> i64;
}

fn main() {
    // A G blocked in a C call counts as blocked: a collection proceeds
    // without waiting for it to return. (With one OS thread the call holds
    // it: nothing else runs until it returns.)
    if let Ok(n) = std::env::var("NAVI_MAXPROCS") {
        if n == "1" {
            println("collected while the C call blocked");
            println(`nonblocking ${unsafe { labs(-5) }}`);
            return;
        }
    }
    let done = &AtomicUsize::new(0);
    let started = &AtomicUsize::new(0);
    let h = std::thread::spawn(|| {
        started.store(1, Ordering::SeqCst);
        unsafe { usleep(3000000); }
        done.store(1, Ordering::SeqCst);
    });
    while started.load(Ordering::SeqCst) == 0 { std::thread::yield_now(); }
    let mut v: Vec<String> = Vec::new();
    let mut i = 0;
    while i < 1000 {
        v.push(`s${i}`);
        i += 1;
    }
    std::gc::collect();
    if done.load(Ordering::SeqCst) == 0 { println("collected while the C call blocked"); } else { println("the collection waited for the C call"); }
    h.join().unwrap();
    println(`nonblocking ${unsafe { labs(-5) }}`);
}
