// A G blocked in a C call counts as blocked: a collection does not wait
// for the call to return; #[nonblocking] C functions are called directly.
use std::sync::atomic::{AtomicUsize, Ordering};
use std::panic::assert_msg;

#[cfg(not(target_os = "windows"))]
extern "C" {
    fn usleep(us: u32) -> i32;
}
// Windows has no usleep (ucrtbase.dll): Sleep from kernel32.dll.
#[cfg(target_os = "windows")]
extern "C" {
    fn Sleep(ms: u32);
}
#[cfg(target_os = "windows")]
unsafe fn usleep(us: u32) -> i32 {
    Sleep(us / 1000);
    0
}

#[nonblocking]
extern "C" {
    fn labs(x: i64) -> i64;
}

#[test]
fn collection_does_not_wait_for_blocking_c_call() {
    // A G blocked in a C call counts as blocked: a collection proceeds
    // without waiting for it to return. (With one OS thread, the monitor
    // starts another to run the rest meanwhile.)
    let done = &AtomicUsize::new(0);
    let started = &AtomicUsize::new(0);
    let h = std::thread::spawn(|| {
        started.store(1, Ordering::SeqCst);
        unsafe { usleep(3000000); }
        done.store(1, Ordering::SeqCst);
    });
    while started.load(Ordering::SeqCst) == 0 { std::thread::yield_now(); }
    let mut v: Vec<String> = Vec::new();
    let mut i = 0;
    while i < 1000 {
        v.push(`s${i}`.to_string());
        i += 1;
    }
    std::gc::collect();
    assert_msg(done.load(Ordering::SeqCst) == 0, "the collection waited for the C call");
    h.join().unwrap();
}

#[test]
fn nonblocking_c_call() {
    assert_eq(unsafe { labs(-5) }, 5);
}
