// Deep recursion on spawned threads (their stacks start at 64 KiB and are
// copied as they grow): pointers to outer locals, catch_unwind records and
// frames larger than the red zone move with the stack.
use std::thread;
use std::panic;

struct Acc { n: u64, path: Vec<u64> }

// Deep recursion holding pointers to locals of outer frames.
fn deep(d: u64, acc: &mut Acc, prev: &u64) -> u64 {
    let here = d * 3 + *prev;
    if d == 0 { acc.n += 1; return here; }
    let mut big = [0u64; 64];
    big[(d % 64) as usize] = d;
    if d % 1000 == 0 { acc.path.push(d); }
    let r = deep(d - 1, acc, &here);
    r + big[(d % 64) as usize] - d
}

fn boom(d: u64) -> u64 {
    if d == 0 { panic("bottom"); }
    let local = d;
    boom(d - 1) + local
}

fn big_frame(d: u64) -> u64 {
    // A frame larger than the red zone.
    let mut buf = [0u64; 8192];
    buf[0] = d;
    buf[8191] = d;
    if d == 0 { return buf[0] + buf[8191]; }
    big_frame(d - 1) + buf[0]
}

#[test]
fn deep_recursion_on_spawned_threads() {
    let mut hs = Vec::new();
    let mut k = 0u64;
    while k < 8 {
        let id = k;
        hs.push(thread::spawn(|| {
            let mut acc = Acc { n: 0, path: Vec::new() };
            let start = id;
            let r = deep(20000 + id, &mut acc, &start);
            let caught = panic::catch_unwind(|| boom(5000)).is_err();
            let r2 = deep(30000, &mut acc, &start);
            let b = big_frame(20);
            (r, r2, acc.n, acc.path.len(), caught, b)
        }));
        k += 1;
    }
    let want: [(u64, u64); 8] = [
        (600030000, 1350045000),
        (600090004, 1350045001),
        (600150011, 1350045002),
        (600210021, 1350045003),
        (600270034, 1350045004),
        (600330050, 1350045005),
        (600390069, 1350045006),
        (600450091, 1350045007),
    ];
    let mut i = 0;
    for h in hs.iter() {
        let (r, r2, n, p, c, b) = h.join().unwrap();
        assert_eq((r, r2), want[i]);
        assert_eq((n, p, c, b), (2u64, 50usize, true, 210u64));
        i += 1;
    }
    assert_eq(i, 8);
}
