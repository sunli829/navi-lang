// stage0: skip
// The item of a range of integer literals is not decided by a cast of it
// (i stays i32: the bound {integer}: Step is still open at the cast).
// out: 3 255 0 1
fn main() {
    let mut v: Vec<u8> = Vec::new();
    for i in 0..3 { v.push((i * 255) as u8); }
    let mut w: Vec<i64> = Vec::new();
    for i in 0..2 { w.push(i as i64); }
    println(`${v.len()} ${v[1]} ${w[0]} ${w[1]}`);
}
