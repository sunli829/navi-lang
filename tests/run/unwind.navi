// out: inner cleanup
// out: middle cleanup 2
// out: outer cleanup
// exit: 101
// stderr: panicked at
// stderr: deep failure
fn inner(n: i32) {
    defer println("inner cleanup");
    if n > 1 { panic("deep failure"); }
}

fn middle() {
    let mut count = 1;
    defer { println(`middle cleanup ${count}`); }
    count += 1;
    inner(count);
}

fn main() {
    defer println("outer cleanup");
    middle();
    println("not reached");
}
