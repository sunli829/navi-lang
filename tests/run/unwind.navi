// A panic unwinds the stack running each function's defers (innermost
// first, LIFO within a function); a deferred block sees the variables'
// values when it runs. tests/run/panics.navi checks the uncaught case.

fn inner(log: &mut Vec<String>, n: i32) {
    defer log.push("inner cleanup".to_string());
    if n > 1 { panic("deep failure"); }
}

fn middle(log: &mut Vec<String>) {
    let mut count = 1;
    defer { log.push(`middle cleanup ${count}`.to_string()); }
    defer log.push("middle second defer".to_string());
    count += 1;
    inner(log, count);
}

fn outer(log: &mut Vec<String>) {
    defer log.push("outer cleanup".to_string());
    middle(log);
    log.push("not reached".to_string());
}

#[test]
fn defers_run_while_unwinding() {
    let mut log: Vec<String> = Vec::new();
    let r = std::panic::catch_unwind(|| outer(&mut log));
    assert_eq(r.unwrap_err().message(), "deep failure");
    assert_eq(log, Vec::from(["inner cleanup", "middle second defer", "middle cleanup 2", "outer cleanup"].map(|s| s.to_string())));
}

#[test]
fn defers_run_without_a_panic() {
    let mut log: Vec<String> = Vec::new();
    inner(&mut log, 1);
    assert_eq(log, Vec::from(["inner cleanup".to_string()]));
}
