// stage0: skip
// std::log: a Log of its own with set_logger; records carry the level,
// the target (the file's module path) and the caller's line.
// out: INFO log_custom one line 27
// out: ERROR log_custom three 3 line 29
use std::log::{self, Level, LevelFilter, Log, Record, Metadata};
use std::sync::Mutex;

struct Collect { lines: &Mutex<Vec<String>> }

impl Log for Collect {
    fn enabled(&self, m: &Metadata) -> bool { m.level() <= Level::Info }
    fn log(&self, r: &Record) {
        if !self.enabled(r.metadata()) { return; }
        let v = self.lines.lock();
        v.push(`${r.level()} ${r.target()} ${r.args()} line ${r.line().unwrap_or(0)}`);
        self.lines.unlock();
    }
    fn flush(&self) {}
}

fn main() {
    let lines: &Mutex<Vec<String>> = &Mutex::new(Vec::new());
    let c: &Collect = &Collect { lines };
    log::set_logger(c).unwrap();
    log::set_max_level(LevelFilter::Trace);
    log::info("one");
    log::debug("two (the logger drops it)");
    log::error(`three ${3}`);
    let v = lines.lock().clone();
    lines.unlock();
    for l in v.iter() { println(l); }
}
