// std::rand: seeded generators give rand 0.9's values (checked against the
// crate): StdRng (ChaCha12), SmallRng (Xoshiro256++), integer and float
// ranges, Uniform, Alphanumeric, Bernoulli, shuffle, choose, fill.
// The generators are drawn from in sequence, so the checks stay in one
// function per seed.
use std::rand::{Rng, RngCore, SeedableRng};
use std::rand::rngs::{StdRng, SmallRng};
use std::rand::seq::{SliceRandom, IndexedRandom};
use std::rand::distr::{Uniform, Distribution, Alphanumeric, Bernoulli};
use std::rand::distr::weighted::WeightedIndex;

#[test]
fn std_rng_seed_from_u64_and_shuffle() {
    let mut r = StdRng::seed_from_u64(42);
    let a: u64 = r.random();
    let b = r.random_range(1..=6);
    let f: f64 = r.random();
    assert_eq(a, 9713269763989775522);
    assert_eq(b, 2);
    assert_eq(`${f}`.to_string().as_str(), "0.8684266101435584");
    let mut v = Vec::from([1, 2, 3, 4, 5]);
    v.shuffle(&mut r);
    assert_eq(v, Vec::from([5, 1, 2, 3, 4]));
    let mut big: Vec<u32> = (0..40).collect();
    big.shuffle(&mut r);
    assert_eq(big, Vec::from([2u32, 13, 1, 38, 24, 39, 9, 18, 8, 14, 32, 11, 17, 16, 29, 37, 12, 20, 4, 31, 23, 21, 10, 30, 6, 25, 3, 26, 36, 15, 7, 27, 33, 19, 28, 34, 22, 35, 5, 0]));
}

#[test]
fn small_rng_next_u64() {
    let mut s = SmallRng::seed_from_u64(1);
    assert_eq(s.next_u64(), 14971601782005023387);
}

#[test]
fn std_rng_random_types_ranges_choose_fill() {
    let mut q = StdRng::seed_from_u64(7);
    let x: (u8, i16, u32, i64, bool, char) = q.random();
    assert_eq((x.0, x.1, x.2, x.3, x.4), (190u8, -7959i16, 612261766u32, 1120196522304943336i64, false));
    assert_eq(x.5 as u32, 726946);
    let fl: f32 = q.random();
    assert_eq(`${fl}`.to_string().as_str(), "0.5425172");
    assert_eq(q.random_range(-5i64..5), -3i64);
    assert_eq(`${q.random_range(0.0..10.0f64)}`.to_string().as_str(), "9.511313028021405");
    assert_eq(q.random_range(0u8..=255), 210u8);
    assert_eq(q.random_range(1000u32..1001), 1000u32);
    assert_eq(q.random_bool(0.3), true);
    let arr: [u16; 3] = q.random();
    assert_eq(arr, [38823u16, 29915, 29035]);
    assert_eq([1, 2, 3, 4].choose(&mut q).map(|x| *x), Some(3));
    let mut buf = [0u8; 10];
    q.fill(&mut buf);
    assert_eq(buf, [210u8, 54, 127, 128, 12, 100, 141, 163, 5, 32]);
}

#[test]
fn small_rng_range_and_ratio() {
    let mut z = SmallRng::seed_from_u64(99);
    let mut zs: Vec<u32> = Vec::new();
    for _ in 0..3 { zs.push(z.random_range(0..100)); }
    assert_eq(zs, Vec::from([17u32, 79, 48]));
    assert_eq(z.random_ratio(2, 3), true);
}

#[test]
fn std_rng_from_seed_and_distributions() {
    let mut c = StdRng::from_seed([1u8; 32]);
    assert_eq(c.next_u32(), 3622306099);
    assert_eq(c.next_u64(), 5479328189599405287);
    let u = Uniform::new(10i32, 1000).unwrap();
    let uf = Uniform::new_inclusive(-1.0f64, 1.0).unwrap();
    let mut us: Vec<i32> = Vec::new();
    for _ in 0..5 { us.push(u.sample(&mut c)); }
    assert_eq(us, Vec::from([242, 178, 472, 155, 619]));
    assert_eq(`${uf.sample(&mut c)}`.to_string().as_str(), "0.3553800966877534");
    let mut s = String::new();
    for _ in 0..12 { s.push(Alphanumeric.sample(&mut c) as char); }
    assert_eq(s, String::from("twucSnWMtwld"));
    assert_eq(Bernoulli::new(0.9).unwrap().sample(&mut c), true);
    assert_eq(c.random_range('a'..='z'), 'i');
    assert_eq(c.random_range(0usize..10), 8usize);
    assert_eq(c.random_range(-3i8..=3), 3i8);
    assert_eq(c.random_range(0u128..1000000000000000000000), 593104703813178287517u128);
    assert_eq(`${c.random_range(1.5f32..2.5)}`.to_string().as_str(), "1.5481693");
}

#[test]
fn weighted_index() {
    let mut r = StdRng::seed_from_u64(5);
    let w = WeightedIndex::new([2, 1, 0, 7]).unwrap();
    let mut a: Vec<usize> = Vec::new();
    for _ in 0..12 { a.push(w.sample(&mut r)); }
    let f = WeightedIndex::new([0.5, 2.5, 1.0]).unwrap();
    let mut b: Vec<usize> = Vec::new();
    for _ in 0..12 { b.push(f.sample(&mut r)); }
    assert_eq(a, Vec::from([0usize, 3, 0, 0, 3, 3, 3, 3, 1, 3, 3, 3]));
    assert_eq(b, Vec::from([1usize, 1, 1, 2, 1, 2, 1, 2, 1, 2, 1, 0]));
    assert_eq(`${WeightedIndex::<i32>::new([0, 0]).err():?}`.to_string().as_str(), "Some(InsufficientNonZero)");
    assert_eq(`${WeightedIndex::new([1, -1]).err():?}`.to_string().as_str(), "Some(InvalidWeight)");
}
