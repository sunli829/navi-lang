// A tour of std: iterator adapters and consumers, sorting and searching
// slices, Vec editing, joining, str and String methods, HashMap entries,
// Option and Result combinators, partition, UTF-8 validation.
use std::collections::HashMap;

fn vec_of(xs: &[i32]) -> Vec<i32> { xs.to_vec() }
fn vec_u8(xs: &[u8]) -> Vec<u8> { xs.to_vec() }
fn vec_str(xs: &[&str]) -> Vec<String> { xs.iter().map(|s| s.to_string()).collect() }

#[test]
fn rev() {
    let v = vec_of(&[1, 2, 3, 4, 5]);
    let r: Vec<i32> = v.iter().rev().map(|x| *x).collect();
    let r2: Vec<i32> = (0..5).rev().collect();
    let s: String = "hello".chars().rev().collect();
    assert_eq(r, Vec::from([5, 4, 3, 2, 1]));
    assert_eq(r2, Vec::from([4, 3, 2, 1, 0]));
    assert_eq(s, String::from("olleh"));
}

#[test]
fn zip_chain_step_by() {
    let v = vec_of(&[1, 2, 3, 4, 5]);
    let z: Vec<(i32, char)> = v.iter().map(|x| *x).zip("ab".chars()).collect();
    let c: Vec<i32> = (1..3).chain(3..5).collect();
    let st: Vec<i32> = (0..10).step_by(3).collect();
    assert_eq(z, Vec::from([(1, 'a'), (2, 'b')]));
    assert_eq(c, Vec::from([1, 2, 3, 4]));
    assert_eq(st, Vec::from([0, 3, 6, 9]));
}

#[test]
fn filter_map_flat_map_take_skip_while() {
    let v = vec_of(&[1, 2, 3, 4, 5]);
    let fm: Vec<i32> = v.iter().filter_map(|x| if *x % 2 == 0 { Some(*x) } else { None }).collect();
    let flat: Vec<i32> = (1..4).flat_map(|n| 1..n + 1).collect();
    let tw: Vec<i32> = v.iter().map(|x| *x).take_while(|x| *x < 3).collect();
    let sw: Vec<i32> = vec_of(&[1, 2, 3, 1]).into_iter().skip_while(|x| *x < 3).collect();
    assert_eq(fm, Vec::from([2, 4]));
    assert_eq(flat, Vec::from([1, 1, 2, 1, 2, 3]));
    assert_eq(tw, Vec::from([1, 2]));
    assert_eq(sw, Vec::from([3, 1]));
}

#[test]
fn max_min_sum_product() {
    let v = vec_of(&[1, 2, 3, 4, 5]);
    let words = vec_str(&["a", "ccc", "bb"]);
    let total: i32 = v.iter().sum();
    let prod: i32 = v.iter().map(|x| *x).product();
    let fsum: f64 = [0.5, 1.0].iter().sum();
    assert_eq(vec_of(&[3, 9, 1]).into_iter().max(), Some(9));
    assert_eq(vec_of(&[3, 9, 1]).into_iter().min(), Some(1));
    assert_eq(`${words.iter().max_by_key(|w| w.len()):?}`.to_string().as_str(), "Some(\"ccc\")");
    assert_eq(total, 15);
    assert_eq(prod, 120);
    assert_eq(fsum, 1.5);
}

#[test]
fn sort_and_search() {
    let mut so = vec_of(&[5, 3, 8, 1, 2]);
    so.sort();
    let mut bk = vec_str(&["ccc", "b", "aa"]);
    bk.sort_by_key(|w| w.len());
    let mut desc = so.clone();
    desc.sort_by(|a, b| b.cmp(a));
    assert_eq(so, Vec::from([1, 2, 3, 5, 8]));
    assert_eq(bk, vec_str(&["b", "aa", "ccc"]));
    assert_eq(desc, Vec::from([8, 5, 3, 2, 1]));
    let w: Vec<&[i32]> = so.windows(4).collect();
    let ch: Vec<Vec<i32>> = vec_of(&[1, 2, 3]).chunks(2).map(|c| c.to_vec()).collect();
    assert_eq(so.binary_search(&3), Ok(2));
    assert_eq(so.binary_search(&4), Err(3));
    assert_eq(w.len(), 2);
    assert_eq(ch, Vec::from([Vec::from([1, 2]), Vec::from([3])]));
}

#[test]
fn vec_editing() {
    let mut re = vec_of(&[1, 2, 3, 4, 5, 6]);
    re.retain(|x| *x % 2 == 0);
    let mut dd = vec_of(&[1, 1, 2, 2, 2, 3]);
    dd.dedup();
    let mut dr = vec_of(&[1, 2, 3, 4, 5]);
    let drained: Vec<i32> = dr.drain(1..3).collect();
    let mut so2 = vec_of(&[1, 2, 3]);
    let tail = so2.split_off(2);
    let mut sr = vec_of(&[1, 2, 4]);
    let removed = sr.swap_remove(0);
    assert_eq(re, Vec::from([2, 4, 6]));
    assert_eq(dd, Vec::from([1, 2, 3]));
    assert_eq(drained, Vec::from([2, 3]));
    assert_eq(dr, Vec::from([1, 4, 5]));
    assert_eq(tail, Vec::from([3]));
    assert_eq(removed, 1);
    assert_eq(sr, Vec::from([4, 2]));
}

#[test]
fn join_and_concat() {
    let parts = vec_str(&["a", "b", "c"]);
    let ws: Vec<&str> = "one two".split(' ').collect();
    assert_eq(parts.join("-"), String::from("a-b-c"));
    assert_eq(parts.concat(), String::from("abc"));
    assert_eq(ws.join(", "), String::from("one, two"));
}

#[test]
fn str_methods() {
    let text = "a.b c";
    assert_eq(text.len(), 5);
    assert_eq(text.find(' '), Some(3));
    assert_eq(text.rfind('.'), Some(1));
    assert_eq(`${text}`.to_string().as_str(), "a.b c");
    assert(text.contains("b c"));
    assert_eq("hello".replace('l', "L"), String::from("heLLo"));
}

#[test]
fn string_editing_and_entry() {
    let mut sm = String::from("hello");
    sm.insert(1, 'X');
    let mut eu = String::from("hello!");
    eu.remove(1);
    eu.insert(1, '€');
    let ab: String = vec_str(&["a", "b", "c"]).into_iter().collect();
    let mut counts: HashMap<char, Vec<i32>> = HashMap::new();
    counts.entry('x').or_default().push(1);
    counts.entry('x').or_default().push(2);
    assert_eq(sm, String::from("hXello"));
    assert_eq(eu, String::from("h€llo!"));
    assert_eq("a€b".chars().count(), 3);
    assert_eq(ab, String::from("abc"));
    assert_eq(counts[&'x'].clone(), Vec::from([1, 2]));
}

#[test]
fn option_combinators() {
    let none: Option<i32> = None;
    assert_eq(Some(5).map_or(0, |x| x * 2), 10);
    assert_eq(none.map_or(0, |x| x * 2), 0);
    assert_eq(Some(1).zip(Some(2)), Some((1, 2)));
    assert_eq(none.or(Some(3)), Some(3));
    assert_eq(Some(7).into_iter().collect::<Vec<i32>>(), Vec::from([7]));
    assert(Some(4).is_some_and(|x| x > 3));
}

#[test]
fn result_combinators() {
    let ok: Result<i32, i32> = Ok(5);
    let er: Result<i32, i32> = Err(1);
    assert_eq(ok.unwrap_or_else(|e| -e), 5);
    assert_eq(er.unwrap_or_else(|e| -e), -1);
    assert_eq(ok.and_then(|x| Ok(x - 3)), Ok(2));
    assert(ok.is_ok_and(|x| x == 5));
}

#[test]
fn partition_and_count() {
    let (even, odd): (Vec<i32>, Vec<i32>) = (1..5).partition(|x| *x % 2 == 0);
    assert_eq(even, Vec::from([2, 4]));
    assert_eq(odd, Vec::from([1, 3]));
    assert_eq((1..4).map(|x| x * 2).filter(|x| *x > 2).count() + 1, 3);
}

#[test]
fn utf8_validation() {
    let good = vec_u8(&[104, 105]);
    let bad = vec_u8(&[0xff, 104]);
    assert(String::from_utf8(good).is_ok());
    assert(!String::from_utf8(bad.clone()).is_ok());
    assert_eq(String::from_utf8_lossy(bad.as_slice()).chars().next().unwrap(), '\u{FFFD}');
}
