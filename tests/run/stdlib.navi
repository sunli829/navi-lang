// out: rev [5, 4, 3, 2, 1] [4, 3, 2, 1, 0] olleh
// out: zip [(1, 'a'), (2, 'b')] chain [1, 2, 3, 4] step [0, 3, 6, 9]
// out: fm [2, 4] flat [1, 1, 2, 1, 2, 3] tw [1, 2] sw [3, 1]
// out: max Some(9) min Some(1) mbk Some("ccc") sum 15 prod 120 fsum 1.5
// out: sorted [1, 2, 3, 5, 8] by-key ["b", "aa", "ccc"] desc [8, 5, 3, 2, 1]
// out: bsearch Ok(2) Err(3) windows 2 chunks [[1, 2], [3]]
// out: retain [2, 4, 6] dedup [1, 2, 3] drain [2, 3] rest [1, 4, 5] split_off [3] swap_remove 1 [4, 2]
// out: join a-b-c concat abc words [one, two]
// out: str 5 Some(3) Some(1) a.b c true heLLo
// out: string hXello h€llo! 3 abc [1, 2]
// out: opt 10 0 Some((1, 2)) Some(3) [7] true
// out: res 5 -1 Ok(2) true
// out: partition [2, 4] [1, 3] unzip-free 3
// out: utf8 true false � ok
use std::collections::HashMap;

fn main() {
    let v = vec_of(&[1, 2, 3, 4, 5]);
    let r: Vec<i32> = v.iter().rev().map(|x| *x).collect();
    let r2: Vec<i32> = (0..5).rev().collect();
    let s: String = "hello".chars().rev().collect();
    println(`rev ${r:?} ${r2:?} ${s}`);

    let z: Vec<(i32, char)> = v.iter().map(|x| *x).zip("ab".chars()).collect();
    let c: Vec<i32> = (1..3).chain(3..5).collect();
    let st: Vec<i32> = (0..10).step_by(3).collect();
    println(`zip ${z:?} chain ${c:?} step ${st:?}`);

    let fm: Vec<i32> = v.iter().filter_map(|x| if *x % 2 == 0 { Some(*x) } else { None }).collect();
    let flat: Vec<i32> = (1..4).flat_map(|n| 1..n + 1).collect();
    let tw: Vec<i32> = v.iter().map(|x| *x).take_while(|x| *x < 3).collect();
    let sw: Vec<i32> = vec_of(&[1, 2, 3, 1]).into_iter().skip_while(|x| *x < 3).collect();
    println(`fm ${fm:?} flat ${flat:?} tw ${tw:?} sw ${sw:?}`);

    let words = vec_str(&["a", "ccc", "bb"]);
    let total: i32 = v.iter().sum();
    let prod: i32 = v.iter().map(|x| *x).product();
    let fsum: f64 = [0.5, 1.0].iter().sum();
    println(`max ${vec_of(&[3, 9, 1]).into_iter().max():?} min ${vec_of(&[3, 9, 1]).into_iter().min():?} mbk ${words.iter().max_by_key(|w| w.len()):?} sum ${total} prod ${prod} fsum ${fsum}`);

    let mut so = vec_of(&[5, 3, 8, 1, 2]);
    so.sort();
    let mut bk = vec_str(&["ccc", "b", "aa"]);
    bk.sort_by_key(|w| w.len());
    let mut desc = so.clone();
    desc.sort_by(|a, b| b.cmp(a));
    println(`sorted ${so:?} by-key ${bk:?} desc ${desc:?}`);

    let w: Vec<&[i32]> = so.windows(4).collect();
    let ch: Vec<Vec<i32>> = vec_of(&[1, 2, 3]).chunks(2).map(|c| c.to_vec()).collect();
    println(`bsearch ${so.binary_search(&3):?} ${so.binary_search(&4):?} windows ${w.len()} chunks ${ch:?}`);

    let mut re = vec_of(&[1, 2, 3, 4, 5, 6]);
    re.retain(|x| *x % 2 == 0);
    let mut dd = vec_of(&[1, 1, 2, 2, 2, 3]);
    dd.dedup();
    let mut dr = vec_of(&[1, 2, 3, 4, 5]);
    let drained: Vec<i32> = dr.drain(1..3).collect();
    let mut so2 = vec_of(&[1, 2, 3]);
    let tail = so2.split_off(2);
    let mut sr = vec_of(&[1, 2, 4]);
    let removed = sr.swap_remove(0);
    println(`retain ${re:?} dedup ${dd:?} drain ${drained:?} rest ${dr:?} split_off ${tail:?} swap_remove ${removed} ${sr:?}`);

    let parts = vec_str(&["a", "b", "c"]);
    let ws: Vec<&str> = "one two".split(' ').collect();
    println(`join ${parts.join("-")} concat ${parts.concat()} words [${ws.join(", ")}]`);

    let text = "a.b c";
    println(`str ${text.len()} ${text.find(' '):?} ${text.rfind('.'):?} ${text} ${text.contains("b c")} ${"hello".replace('l', "L")}`);

    let mut sm = String::from("hello");
    sm.insert(1, 'X');
    let mut eu = String::from("hello!");
    eu.remove(1);
    eu.insert(1, '€');
    let ab: String = vec_str(&["a", "b", "c"]).into_iter().collect();
    let mut counts: HashMap<char, Vec<i32>> = HashMap::new();
    counts.entry('x').or_default().push(1);
    counts.entry('x').or_default().push(2);
    println(`string ${sm} ${eu} ${"a€b".chars().count()} ${ab} ${counts[&'x']:?}`);

    let none: Option<i32> = None;
    println(`opt ${Some(5).map_or(0, |x| x * 2)} ${none.map_or(0, |x| x * 2)} ${Some(1).zip(Some(2)):?} ${none.or(Some(3)):?} ${Some(7).into_iter().collect::<Vec<i32>>():?} ${Some(4).is_some_and(|x| x > 3)}`);

    let ok: Result<i32, i32> = Ok(5);
    let er: Result<i32, i32> = Err(1);
    println(`res ${ok.unwrap_or_else(|e| -e)} ${er.unwrap_or_else(|e| -e)} ${ok.and_then(|x| Ok(x - 3)):?} ${ok.is_ok_and(|x| x == 5)}`);

    let (even, odd): (Vec<i32>, Vec<i32>) = (1..5).partition(|x| *x % 2 == 0);
    println(`partition ${even:?} ${odd:?} unzip-free ${(1..4).map(|x| x * 2).filter(|x| *x > 2).count() + 1}`);

    let good = vec_u8(&[104, 105]);
    let bad = vec_u8(&[0xff, 104]);
    println(`utf8 ${String::from_utf8(good).is_ok()} ${String::from_utf8(bad.clone()).is_ok()} ${String::from_utf8_lossy(bad.as_slice()).chars().next().unwrap()} ok`);
}

fn vec_of(xs: &[i32]) -> Vec<i32> { xs.to_vec() }
fn vec_u8(xs: &[u8]) -> Vec<u8> { xs.to_vec() }
fn vec_str(xs: &[&str]) -> Vec<String> { xs.iter().map(|s| s.to_string()).collect() }
