// Associated functions of enums by path (E::new).
enum E { A(i32), B }
impl E { pub fn new(x: i32) -> E { E::A(x) } }
mod m {
    pub enum F { A(i32), B }
    impl F { pub fn new(x: i32) -> F { F::A(x) } }
}

#[test]
fn enum_assoc_fn_by_path() {
    let e = E::new(3);
    let f = m::F::new(4);
    let fx = match f { m::F::A(x) => x, _ => -1 };
    assert_eq(fx, 4);
    let ex = match e { E::A(x) => x, _ => -1 };
    assert_eq(ex, 3);
}
