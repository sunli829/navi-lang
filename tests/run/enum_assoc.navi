// Associated functions of enums by path (E::new).
// out: 4
// out: 3
enum E { A(i32), B }
impl E { pub fn new(x: i32) -> E { E::A(x) } }
mod m {
    pub enum F { A(i32), B }
    impl F { pub fn new(x: i32) -> F { F::A(x) } }
}
fn main() {
    let e = E::new(3);
    let f = m::F::new(4);
    match f { m::F::A(x) => println(`${x}`), _ => {} }
    match e { E::A(x) => println(`${x}`), _ => {} }
}
