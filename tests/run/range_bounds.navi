// Inclusive ranges up to a type's maximum (or down to its minimum) end
// without overflowing, forward and backward; char ranges skip the
// surrogates.
#[test]
fn inclusive_ranges_at_type_bounds() {
    let a: Vec<u8> = (250u8..=255).collect();
    assert_eq(a, Vec::from([250u8, 251, 252, 253, 254, 255]));
    let b: Vec<i8> = (-128i8..=-126).rev().collect();
    assert_eq(b, Vec::from([-126i8, -127, -128]));
    let c: Vec<u8> = (0u8..=0).collect();
    assert_eq(c, Vec::from([0u8]));
    let d: Vec<u8> = (0u8..=0).rev().collect();
    assert_eq(d, Vec::from([0u8]));
    assert_eq((0u8..=255).count(), 256);
    let g: Vec<u32> = (5u32..=3).collect();
    assert(g.is_empty());
    assert_eq(`${g:?}`.to_string(), "[]");
    assert_eq((0usize..5).rev().count(), 5);
}

#[test]
fn inclusive_range_from_both_ends() {
    let mut h = 1u8..=3;
    let x = (h.next(), h.next_back(), h.next(), h.next_back());
    assert_eq(x, (Some(1u8), Some(3u8), Some(2u8), None));
}

#[test]
fn char_ranges_skip_surrogates() {
    let e: Vec<char> = ('\u{D7FE}'..='\u{E001}').collect();
    assert_eq(e.len(), 4);
    let r: Vec<char> = ('\u{D7FE}'..'\u{E001}').rev().collect();
    assert_eq(r.len(), 3);
}
