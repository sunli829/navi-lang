// A unit struct or a constant used where &mut is taken (a method with
// &mut self, or &mut X) borrows a temporary, as in Rust.
struct Counter;

impl Counter {
    fn bump(&mut self) -> i32 { 1 }
}

const START: i32 = 4;

fn add_one(x: &mut i32) -> i32 {
    *x += 1;
    *x
}

#[test]
fn unit_struct_borrows_a_temporary() {
    let a = Counter.bump();
    let b = Counter.bump();
    assert_eq(a, 1);
    assert_eq(b, 1);
}

#[test]
fn constant_borrows_a_temporary() {
    assert_eq(add_one(&mut START), 5);
    assert_eq(add_one(&mut START), 5);
    assert_eq(START, 4);
}
