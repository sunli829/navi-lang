// Edge cases of std that differed from Rust's: the environment read and
// written on several threads at once, next_power_of_two past the type,
// chunks and windows of size 0, the 8-bit from_*_bytes.

use std::crypto::{
    Digest,
    rsa::{Error, Pkcs1v15Sign, Pss, RsaPrivateKey},
    sha2::{Sha256, Sha512},
};

#[test]
fn env_set_and_read_on_several_threads() {
    let mut hs = Vec::new();
    for t in 0..8 {
        hs.push(std::thread::spawn(|| {
            let key = `NAVI_STD_EDGES_${t}`.to_string();
            let mut i = 0;
            while i < 300 {
                unsafe { std::env::set_var(key.as_str(), `${i}`.to_string()) };
                assert_eq(std::env::var(key.as_str()), Ok(`${i}`.to_string()));
                let n = std::env::vars().count();
                assert(n > 0);
                if i % 3 == 0 {
                    unsafe { std::env::remove_var(key.as_str()) };
                }
                i += 1;
            }
        }));
    }
    for h in hs.iter() {
        h.join().unwrap();
    }
}

#[test]
fn next_power_of_two_in_range() {
    assert_eq(128u8.next_power_of_two(), 128);
    assert_eq(0u8.next_power_of_two(), 1);
    assert_eq((1u64 << 63).next_power_of_two(), 1u64 << 63);
    assert_eq(129u8.checked_next_power_of_two(), None);
}

#[test]
#[should_panic(expected = "attempt to add with overflow")]
fn next_power_of_two_past_u8() {
    let x = 129u8;
    let _ = x.next_power_of_two();
}

#[test]
#[should_panic(expected = "attempt to add with overflow")]
fn next_power_of_two_past_u128() {
    let x = u128::MAX;
    let _ = x.next_power_of_two();
}

#[test]
#[should_panic(expected = "chunk size must be non-zero")]
fn chunks_of_zero() {
    let a = [1, 2, 3];
    let _ = a.chunks(0);
}

#[test]
#[should_panic(expected = "window size must be non-zero")]
fn windows_of_zero() {
    let a = [1, 2, 3];
    let _ = a.windows(0);
}

#[test]
fn eight_bit_from_bytes() {
    assert_eq(u8::from_le_bytes([0x12]), 0x12);
    assert_eq(u8::from_be_bytes([0xff]), 0xff);
    assert_eq(u8::from_ne_bytes([7]), 7);
    assert_eq(i8::from_le_bytes([0xff]), -1);
    assert_eq(i8::from_be_bytes([0x80]), i8::MIN);
    assert_eq(i8::from_ne_bytes([5]), 5);
}

#[test]
#[should_panic(expected = "from_str_radix_int: must lie in the range `[2, 36]` - found 37")]
fn from_str_radix_checks_the_radix() {
    let _ = i32::from_str_radix("1", 37);
}

#[test]
fn powi_by_squaring() {
    assert_eq(2.0f64.powi(10), 1024.0);
    assert_eq(2.0f64.powi(-2), 0.25);
    assert_eq(1.0f64.powi(i32::MIN), 1.0);
    assert_eq(2.0f64.powi(i32::MIN), 0.0);
    assert_eq(3.0f32.powi(3), 27.0);
    assert_eq(f64::NAN.powi(0), 1.0);
}

#[test]
#[should_panic(expected = "`at` split index (is 4) should be <= len (is 3)")]
fn split_off_past_the_end() {
    let mut v = Vec::from([1, 2, 3]);
    let _ = v.split_off(4);
}

#[test]
#[should_panic(expected = "assertion failed: mid <= self.len()")]
fn rotate_left_past_the_end() {
    let mut a = [1, 2, 3];
    a.rotate_left(4);
}

#[test]
fn rotate_by_the_length() {
    let mut a = [1, 2, 3];
    a.rotate_left(3);
    assert_eq(a, [1, 2, 3]);
    a.rotate_right(1);
    assert_eq(a, [3, 1, 2]);
}

#[test]
#[should_panic(expected = "append: `other` is the vector itself")]
fn append_to_itself() {
    let mut v = Vec::from([1, 2]);
    let mut w = v;
    v.append(&mut w);
}

#[test]
fn is_sorted_with_nan() {
    assert(![1.0, f64::NAN, 2.0].is_sorted());
    assert([1.0, 2.0, 2.0].is_sorted());
}

#[test]
#[should_panic(expected = "assertion failed: step != 0")]
fn step_by_zero() {
    let _ = (0..10).step_by(0);
}

#[test]
fn range_size_hint() {
    assert_eq((3..10).size_hint(), (7, Some(7)));
    assert_eq((10..3).size_hint(), (0, Some(0)));
    assert_eq((-5i64..5).size_hint(), (10, Some(10)));
    assert_eq((0u8..=255).size_hint(), (256, Some(256)));
    assert_eq(('a'..='z').size_hint(), (26, Some(26)));
    assert_eq(
        (0..10).map(|x| x * 2).collect::<Vec<i32>>().capacity() >= 10,
        true,
    );
}

struct Failing;

impl std::fmt::Display for Failing {
    fn fmt(&self, _f: &mut std::fmt::Formatter) -> std::fmt::Result {
        Err(std::fmt::Error)
    }
}

#[test]
#[should_panic(
    expected = "a formatting trait implementation returned an error when the underlying stream did not"
)]
fn to_string_of_a_failing_display() {
    let _ = Failing.to_string();
}

#[test]
fn form_urlencoded_serializer_new() {
    use std::url::form_urlencoded::Serializer;
    assert_eq(
        Serializer::new("a=1".to_string())
            .append_pair("b", "2")
            .finish(),
        "a=1&b=2",
    );
    assert_eq(
        Serializer::new("a=1".to_string())
            .clear()
            .append_pair("b", "2")
            .finish(),
        "b=2",
    );
}

#[test]
fn duration_debug() {
    use std::time::Duration;
    assert_eq(`${Duration::from_secs(1):?}`.to_string(), "1s");
    assert_eq(`${Duration::from_millis(1500):?}`.to_string(), "1.5s");
    assert_eq(
        `${Duration::from_nanos(1_000_001):?}`.to_string(),
        "1.000001ms",
    );
    assert_eq(`${Duration::from_nanos(150):?}`.to_string(), "150ns");
    assert_eq(`${Duration::from_micros(42):?}`.to_string(), "42µs");
    assert_eq(`${Duration::from_millis(1999):.1?}`.to_string(), "2.0s");
    assert_eq(`${Duration::from_millis(1234):.5?}`.to_string(), "1.23400s");
    assert_eq(`${Duration::ZERO:?}`.to_string(), "0ns");
    assert_eq(`${Duration::from_secs(1):>6?}`.to_string(), "    1s");
    assert_eq(`${Duration::from_secs(1):<6?}|`.to_string(), "1s    |");
    assert_eq(`${Duration::from_secs(1):+?}`.to_string(), "+1s");
}

#[test]
fn system_time_checked() {
    use std::time::{Duration, UNIX_EPOCH};
    let t = UNIX_EPOCH.checked_add(Duration::MAX).unwrap();
    assert_eq(t.duration_since(UNIX_EPOCH).unwrap(), Duration::MAX);
    let before = UNIX_EPOCH.checked_sub(Duration::MAX).unwrap();
    assert(before < UNIX_EPOCH);
}

#[test]
fn unwrap_or_default_without_debug() {
    struct NoDebug;
    let r: Result<i32, NoDebug> = Err(NoDebug);
    assert_eq(r.unwrap_or_default(), 0);
}

#[test]
fn vec_from_array_without_clone() {
    struct NoClone {
        v: i32,
    }
    let v = Vec::from([NoClone { v: 1 }, NoClone { v: 2 }]);
    assert_eq(v.len(), 2);
    assert_eq(v[1].v, 2);
}

#[test]
fn rsa_sign_errors() {
    // A 512-bit key (n, e, d, p, q).
    let x = |s: &str| -> Vec<u8> { std::hex::decode(s).unwrap() };
    let key = RsaPrivateKey::from_components(
        x("e0ef37513a6851fcb8a20d6f764786255cce3539c4b4b2fe88ad64b2aa89872f133d3d3b1c0ef7dbcc4613eb168dfb9899459267e3d4e423b2c3b51c225fbd25").as_slice(),
        &[1, 0, 1],
        x("45bde608e9732ef88cc6b223bd28b00f25974a297f3407cba3d51f43c65c9ded059ca1ed3842d05060adbc6bdc310c81ae8325c6979c78d31aa746dba8bab001").as_slice(),
        Vec::from([
            x("e28defe39bf0027312476f57a5e5a5abaefcfad8efc89849b3aa7efe4458a885"),
            x("fe2b6091a092f52ad4a057a7b0cc1b3b9793b9b41374814632c5bd89b70b3421"),
        ]),
    )
    .unwrap();
    let h = Sha512::digest(b"x");
    assert_eq(
        key.sign(Pss::new::<Sha512>(), h.as_slice()),
        Err(Error::InvalidKey),
    );
    assert_eq(
        key.sign(Pss::new::<Sha256>(), h.as_slice()),
        Err(Error::InputNotHashed),
    );
    assert_eq(
        key.sign(Pkcs1v15Sign::new::<Sha256>(), &[1, 2, 3]),
        Err(Error::InputNotHashed),
    );
    let h2 = Sha256::digest(b"x");
    assert(
        key.sign(Pss::new_with_salt::<Sha256>(20), h2.as_slice())
            .is_ok(),
    );
    assert(
        key.sign(Pkcs1v15Sign::new::<Sha256>(), h2.as_slice())
            .is_ok(),
    );
}

#[test]
fn make_ascii_case_in_place() {
    let mut s = String::from("Grüße, Jürgen");
    s.make_ascii_uppercase();
    assert_eq(s, "GRüßE, JüRGEN");
    s.make_ascii_lowercase();
    assert_eq(s, "grüße, jürgen");
}

#[test]
fn shift_assign_methods() {
    use std::ops::{ShlAssign, ShrAssign};
    let mut a = 3u32;
    a.shl_assign(2);
    assert_eq(a, 12);
    a.shr_assign(1u8);
    assert_eq(a, 6);
}

#[test]
fn as_mut_impls() {
    let mut v = Vec::from([1, 2, 3]);
    let s: &mut [i32] = v.as_mut();
    s[0] = 9;
    assert_eq(v[0], 9);
    let mut t = String::from("ab");
    let m: &mut str = t.as_mut();
    m.make_ascii_uppercase();
    assert_eq(t, "AB");
}

#[test]
fn ordering_is_ordered() {
    use std::cmp::Ordering;
    assert(Ordering::Less < Ordering::Equal);
    assert(Ordering::Equal < Ordering::Greater);
    assert_eq(Ordering::Less.cmp(&Ordering::Greater), Ordering::Less);
    let mut v = Vec::from([Ordering::Greater, Ordering::Less, Ordering::Equal]);
    v.sort();
    assert_eq(v, [Ordering::Less, Ordering::Equal, Ordering::Greater]);
}

#[test]
fn hash_map_additions() {
    use std::collections::HashMap;
    let mut m = HashMap::from([("a", 1), ("b", 2)]);
    assert(m.capacity() >= 2);
    let mut n = 0;
    for (_, v) in &m {
        n += *v;
    }
    assert_eq(n, 3);
    for (_, v) in &mut m {
        *v += 10;
    }
    assert_eq(m[&"a"], 11);
    assert_eq(m.remove_entry(&"a"), Some(("a", 11)));
    let mut keys: Vec<&str> = m.clone().into_keys().collect();
    keys.sort();
    assert_eq(keys, ["b"]);
    let d: Vec<(&str, i32)> = m.drain().collect();
    assert_eq(d, [("b", 12)]);
    assert(m.is_empty());
}

#[test]
fn hash_set_operations() {
    use std::collections::HashSet;
    let a = HashSet::from([1, 2, 3]);
    let b = HashSet::from([2, 3, 4]);
    let mut u: Vec<i32> = a.union(&b).copied().collect();
    u.sort();
    assert_eq(u, [1, 2, 3, 4]);
    let mut i: Vec<i32> = a.intersection(&b).copied().collect();
    i.sort();
    assert_eq(i, [2, 3]);
    let mut d: Vec<i32> = a.difference(&b).copied().collect();
    d.sort();
    assert_eq(d, [1]);
    let mut s: Vec<i32> = a.symmetric_difference(&b).copied().collect();
    s.sort();
    assert_eq(s, [1, 4]);
    assert(HashSet::from([2]).is_subset(&a));
    assert(a.is_superset(&HashSet::from([1, 3])));
    assert(a.is_disjoint(&HashSet::from([7])));
    let mut n = 0;
    for x in &a {
        n += *x;
    }
    assert_eq(n, 6);
}

#[test]
fn vec_deque_drain() {
    use std::collections::VecDeque;
    let mut d: VecDeque<i32> = [1, 2, 3, 4].into_iter().collect();
    let x: Vec<i32> = d.drain(1..3).collect();
    assert_eq(x, [2, 3]);
    assert_eq(d, VecDeque::from(Vec::from([1, 4])));
}

#[test]
fn socket_addresses() {
    use std::net::{IpAddr, Ipv4Addr, Ipv6Addr, SocketAddr, SocketAddrV6, ToSocketAddrs};
    let a = SocketAddr::new(IpAddr::V4(Ipv4Addr::new(127, 0, 0, 1)), 80);
    let r = &a;
    assert_eq(r.to_socket_addrs().unwrap().next(), Some(a.clone()));
    let mut v6 = SocketAddrV6::new(Ipv6Addr::LOCALHOST, 1, 0, 0);
    v6.set_ip(Ipv6Addr::UNSPECIFIED);
    v6.set_flowinfo(5);
    v6.set_scope_id(7);
    assert_eq(
        (v6.ip().clone(), v6.flowinfo(), v6.scope_id()),
        (Ipv6Addr::UNSPECIFIED, 5, 7),
    );
    let mut b = a.clone();
    b.set_ip(IpAddr::V6(Ipv6Addr::LOCALHOST));
    assert(b.is_ipv6());
    assert_eq(b.port(), 80);
    assert_eq(
        (Ipv6Addr::LOCALHOST, 9).to_socket_addrs().unwrap().count(),
        1,
    );
    let l = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
    assert(
        `${l:?}`
            .to_string()
            .starts_with("TcpListener { addr: 127.0.0.1:"),
    );
    l.close();
}

// Type inference: a literal before a number of a known type; a trait method
// with one impl deciding an index's type; an IntoIterator with bounds on a
// literal's collection; traits imported inside a function.
#[test]
fn inference_cases() {
    let v = Vec::from([1, 2, 3]);
    assert_eq(3, v.len());
    assert(2 < v.len());
    use std::rand::distr::{Distribution, WeightedIndex};
    let choices = ['a', 'b', 'c'];
    let dist = WeightedIndex::new([2, 1, 1]).unwrap();
    let mut rng = std::rand::rng();
    let c = choices[dist.sample(&mut rng)];
    assert(c == 'a' || c == 'b' || c == 'c');
    let mut it = std::collections::HashSet::from([7]).into_iter();
    assert_eq(it.next(), Some(7));
}
