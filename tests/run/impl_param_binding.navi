// An impl parameter decided only by an associated type binding of a bound.
struct Cl<I> { iter: I }
impl<T: Clone, I: Iterator<Item = &T>> Iterator for Cl<I> {
    type Item = T;
    fn next(&mut self) -> Option<T> { match self.iter.next() { Some(x) => Some(x.clone()), None => None } }
}

#[test]
fn item_type_from_bound_binding() {
    let v: Vec<i32> = (1..=5).collect();
    let c: Vec<i32> = Cl { iter: v.iter() }.collect();
    assert_eq(c, Vec::from([1, 2, 3, 4, 5]));
}
