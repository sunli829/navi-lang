fn vec_of<T: Clone>(v: &[T]) -> Vec<T> { v.to_vec() }

// Generated by /tmp/goref5 (Go 1.26's crypto/x509): certificate name and
// base64 DER.
const CERTS: [&str; 34] = [
    "root ",
    "root2 ",
    "inter ",
    "leaf ",
    "leaf_rsa ",
    "inter_rsa ",
    "leaf_384 ",
    "leaf_512 ",
    "leaf_pss ",
    "leaf_pss384 ",
    "inter_384 ",
    "leaf_e512 ",
    "inter_old ",
    "leaf_old ",
    "inter_noca ",
    "leaf_noca ",
    "inter_len0 ",
    "inter_sub ",
    "leaf_deep ",
    "leaf_shallow ",
    "inter_nc ",
    "leaf_nc_ok ",
    "leaf_nc_org ",
    "leaf_nc_bad ",
    "leaf_nc_ip ",
    "leaf_client ",
    "inter_server ",
    "leaf_client2 ",
    "leaf_crit ",
    "leaf_noncrit ",
    "selfsigned ",
    "inter_x ",
    "fake_inter ",
    "leaf_forged ",
];

// leaf|intermediates|roots|unix time|DNS name|usages|what Go's Verify says
// ("ok" and each chain's names, or the error).
const CASES: [&str; 40] = [
    "leaf|inter|root|1748736000|example.com||ok leaf>inter>root",
    "leaf|inter|root|1748736000|EXAMPLE.com.||ok leaf>inter>root",
