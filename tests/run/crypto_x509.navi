    "leaf|inter|root|1748736000|127.0.0.1||ok leaf>inter>root",
    "leaf|inter|root|1748736000|::1||ok leaf>inter>root",
    "leaf|inter|root|1748736000|10.0.0.1||x509: certificate is valid for 127.0.0.1, ::1, not 10.0.0.1",
    "leaf|inter|root|1748736000|||ok leaf>inter>root",
    "leaf|inter|root|1717200000|example.com||x509: certificate has expired or is not yet valid: current time 2024-06-01T00:00:00Z is before 2025-01-01T00:00:00Z",
    "leaf|inter|root|1780272000|example.com||x509: certificate has expired or is not yet valid: current time 2026-06-01T00:00:00Z is after 2026-01-01T00:00:00Z",
    "leaf||root|1748736000|example.com||x509: certificate signed by unknown authority",
    "leaf|inter|root2|1748736000|example.com||x509: certificate signed by unknown authority",
    "leaf|inter,inter_x|root2|1748736000|example.com||ok leaf>inter_x>root2",
    "leaf|inter,inter_x|root,root2|1748736000|example.com||ok leaf>inter>root leaf>inter_x>root2",
    "leaf_rsa|inter|root|1748736000|rsa.example.com||ok leaf_rsa>inter>root",
    "leaf_384|inter_rsa|root2|1748736000|example.net||ok leaf_384>inter_rsa>root2",
    "leaf_512|inter_rsa|root2|1748736000|example.net||ok leaf_512>inter_rsa>root2",
    "leaf_pss|inter_rsa|root2|1748736000|example.net||ok leaf_pss>inter_rsa>root2",
    "leaf_pss384|inter_rsa|root2|1748736000|example.net||ok leaf_pss384>inter_rsa>root2",
