// std::crypto::x509 against Go's crypto/x509 (the constants at the end,
// generated by Go 1.26): certificates of RSA, P-256 and P-384 keys signed
// with PKCS#1 v1.5, PSS and ECDSA, and what Verify says of 40 chains
// (host names, validity, CA and path length constraints, name
// constraints, key usages, critical extensions, cross-signing, forged
// signatures), compared with Go's results and error messages.

use std::base64::prelude::*;
use std::collections::HashMap;
use std::crypto::x509::{Certificate, CertPool, Error, ExtKeyUsage, VerifyOptions};

fn certs_by_name() -> HashMap<String, Certificate> { certs() }

fn certs() -> HashMap<String, Certificate> {
    let mut m: HashMap<String, Certificate> = HashMap::new();
    for line in CERTS.iter() {
        let f: Vec<&str> = line.split(' ').collect();
        let der = BASE64_STANDARD.decode(f[1]).unwrap();
        m.insert(f[0].to_string(), Certificate::from_der(der.as_slice()).unwrap());
    }
    m
}

fn pool(all: &HashMap<String, Certificate>, names: &str) -> CertPool {
    let mut p = CertPool::new();
    for n in names.split(',') {
        if n.len() > 0 { p.add_cert(all.get(&n.to_string()).unwrap().clone()); }
    }
    p
}

fn name_of(all: &HashMap<String, Certificate>, c: &Certificate) -> String {
    for (n, x) in all.iter() {
        if x == c { return n.clone(); }
    }
    "?".to_string()
}

#[test]
fn against_go() {
    let all = certs();
    let mut failed = 0;
    for line in CASES.iter() {
        let f: Vec<&str> = line.splitn(7, '|').collect();
        let mut opts = VerifyOptions::default();
        opts.intermediates = pool(&all, f[1]);
        opts.roots = Some(pool(&all, f[2]));
        opts.current_time = Some(f[3].parse::<i64>().unwrap());
        if f[4].len() > 0 { opts.dns_name = Some(f[4].to_string()); }
        if f[5] == "client" { opts.key_usages.push(ExtKeyUsage::ClientAuth); }
        if f[5] == "server" { opts.key_usages.push(ExtKeyUsage::ServerAuth); }
        if f[5] == "any" { opts.key_usages.push(ExtKeyUsage::Any); }
        let got = match all.get(&f[0].to_string()).unwrap().verify(&opts) {
            Ok(chains) => {
                let mut s = "ok".to_string();
                for ch in chains.iter() {
                    let names: Vec<String> = ch.iter().map(|c: &Certificate| -> String { name_of(&all, c) }).collect();
                    s.push_str(" ");
                    s.push_str(names.join(">").as_str());
                }
                s
            }
            Err(e) => e.to_string(),
        };
        if got != f[6] {
            println(`${line}\n    got  ${got}`);
            failed += 1;
        }
    }
    assert_eq(failed, 0);
}

#[test]
fn fields() {
    let all = certs();
    let leaf = all.get(&"leaf".to_string()).unwrap();
    assert_eq(leaf.version(), 3);
    assert_eq(leaf.subject().common_name(), "leaf");
    assert_eq(leaf.subject().to_string(), "CN=leaf,O=Navi Test");
    assert_eq(leaf.issuer().common_name(), "inter");
    assert_eq(leaf.dns_names().to_vec(), vec_of(&["example.com".to_string(), "*.example.org".to_string()]));
    assert_eq(leaf.ip_addresses().len(), 2);
    assert_eq(`${leaf.ip_addresses()[1]}`.to_string(), "::1");
    assert_eq(leaf.not_before(), 1735689600);
    assert_eq(leaf.not_after(), 1767225600);
    assert(!leaf.is_ca());
    assert_eq(leaf.ext_key_usage().to_vec(), vec_of(&[ExtKeyUsage::ServerAuth]));
    assert_eq(`${leaf.signature_algorithm()}`.to_string(), "ECDSA-SHA256");
    let root = all.get(&"root".to_string()).unwrap();
    assert(root.is_ca());
    assert_eq(`${root.signature_algorithm()}`.to_string(), "SHA256-RSA");
    assert(leaf.check_signature_from(all.get(&"inter".to_string()).unwrap()).is_ok());
    assert(leaf.check_signature_from(root).is_err());
    let len0 = all.get(&"inter_len0".to_string()).unwrap();
    assert_eq(len0.max_path_len(), Some(0));
    assert_eq(root.max_path_len(), None);
    // PEM round trip.
    let pem = std::pem::encode(&std::pem::Pem::new("CERTIFICATE", leaf.raw().to_vec()));
    let again = Certificate::from_pem(pem.as_bytes()).unwrap();
    assert(again == *leaf);
    // Bad encodings.
    assert(Certificate::from_der(&[0x30, 0x00]).is_err());
    let mut cut = leaf.raw().to_vec();
    cut.pop();
    assert(Certificate::from_der(cut.as_slice()).is_err());
}

#[test]
fn system_roots() {
    // github.com's chain (from its server, 2026-11-24) against the system's
    // roots (macOS's and Windows' verifiers, the CA files elsewhere) on
    // 2026-12-01, within the leaf's validity.
    let certs = Certificate::from_pem_many(GITHUB.as_bytes()).unwrap();
    assert_eq(certs.len(), 3);
    let mut opts = VerifyOptions::default();
    opts.intermediates.add_cert(certs[1].clone());
    opts.intermediates.add_cert(certs[2].clone());
    opts.current_time = Some(1796083200);
    opts.dns_name = Some("github.com".to_string());
    match certs[0].verify(&opts) {
        Ok(chains) => {
            assert(chains[0][0] == certs[0]);
            assert(chains[0].len() >= 3);
        }
        Err(e) => panic(`github.com: ${e}`),
    }
    opts.dns_name = Some("example.com".to_string());
    match certs[0].verify(&opts) {
        Err(Error::Hostname { host, .. }) => assert_eq(host, "example.com".to_string()),
        r => panic(`example.com: ${r.is_ok()}`),
    }
    // A root no system trusts.
    let all = certs_by_name();
    let mut o2 = VerifyOptions::default();
    o2.intermediates.add_cert(all.get(&"inter".to_string()).unwrap().clone());
    o2.current_time = Some(1748736000);
    o2.dns_name = Some("example.com".to_string());
    // (Each platform's verifier says why in its own words, as with Go.)
    assert(all.get(&"leaf".to_string()).unwrap().verify(&o2).is_err());
    // The system pool as Go: certificates added to it are trusted too.
    let mut pool = std::crypto::x509::system_cert_pool().unwrap();
    pool.add_cert(all.get(&"root".to_string()).unwrap().clone());
    o2.roots = Some(pool);
    assert(all.get(&"leaf".to_string()).unwrap().verify(&o2).is_ok());
}

