// Const generics: a matrix whose transpose swaps its const parameters,
// functions generic over array length (inferred or explicit), a fixed-size
// buffer.
#[derive(Debug, Clone, PartialEq)]
struct Matrix<const R: usize, const C: usize> {
    cells: [[i64; C]; R],
}

impl<const R: usize, const C: usize> Matrix<R, C> {
    fn zero() -> Matrix<R, C> { Matrix { cells: [[0; C]; R] } }
    fn rows(&self) -> usize { R }
    fn cols(&self) -> usize { C }
    fn transpose(&self) -> Matrix<C, R> {
        let mut t = Matrix::<C, R>::zero();
        let mut i = 0;
        while i < R {
            let mut j = 0;
            while j < C {
                t.cells[j][i] = self.cells[i][j];
                j += 1;
            }
            i += 1;
        }
        t
    }
}

fn sum<const N: usize>(xs: [i32; N]) -> i32 {
    let mut s = 0;
    for x in xs.iter() { s += *x; }
    s
}

fn first_n<T: Clone, const N: usize>(v: &Vec<T>) -> [T; N] where T: Default {
    let mut out: [T; N] = [T::default(); N];
    let mut i = 0;
    while i < N && i < v.len() {
        out[i] = v[i].clone();
        i += 1;
    }
    out
}

struct Buf<const N: usize> { data: [u8; N], len: usize }

impl<const N: usize> Buf<N> {
    fn new() -> Buf<N> { Buf { data: [0; N], len: 0 } }
    fn push(&mut self, b: u8) -> bool {
        if self.len == N { return false; }
        self.data[self.len] = b;
        self.len += 1;
        true
    }
}


#[test]
fn matrix_transpose() {
    let mut m = Matrix::<2, 3>::zero();
    m.cells[0][2] = 7;
    m.cells[1][0] = 5;
    let t = m.transpose();
    assert_eq((m.rows(), m.cols(), t.rows(), t.cols()), (2, 3, 3, 2));
    assert_eq(t.cells, [[0i64, 5], [0, 0], [7, 0]]);
}

#[test]
fn generic_array_length() {
    assert_eq(sum([1, 2, 3]), 6);
    assert_eq(sum([10; 4]), 40);
    assert_eq(sum::<0>([]), 0);
    let v = vec_of();
    let a: [String; 2] = first_n(&v);
    let b = first_n::<String, 4>(&v);
    assert_eq(`${a:?} ${b:?}`.to_string().as_str(), "[\"a\", \"b\"] [\"a\", \"b\", \"c\", \"\"]");
    assert_eq(a, [String::from("a"), String::from("b")]);
}

#[test]
fn fixed_size_buffer() {
    let mut buf = Buf::<3>::new();
    let mut pushed = 0;
    for c in "hello".bytes() { if buf.push(c) { pushed += 1; } }
    assert_eq(pushed, 3);
    assert_eq(buf.data, [104u8, 101, 108]);
    assert_eq(std::mem::size_of::<Buf<16>>(), 24);
}

#[test]
fn slices_and_vec_from_array() {
    let s: &[i32] = &[4, 5, 6];
    assert_eq(s.len(), 3);
    assert_eq(vec_from_array(), Vec::from([7, 8, 9]));
}

fn vec_of() -> Vec<String> {
    let mut v = Vec::new();
    v.push("a".to_string());
    v.push("b".to_string());
    v.push("c".to_string());
    v
}

fn vec_from_array() -> Vec<i32> { Vec::from([7, 8, 9]) }
