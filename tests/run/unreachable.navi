// Arms no value reaches get a warning; the program still builds.
// warn: 15:9 unreachable pattern
// warn: 17:9 unreachable pattern
// warn: 24:9 unreachable pattern
// warn: 26:77 unreachable pattern
// out: a
// out: t
// out: 1
enum E { A(i32), B, C }
fn main() {
    match E::A(3) {
        E::A(1) | E::B => println("x"),
        E::A(_) => println("a"),
        E::B => println("b"),
        _ => println("rest"),
        E::A(2) | E::C => println("y"),
    }
    let t = (1, true);
    match t {
        (_, true) => println("t"),
        (n, _) if n > 0 => println("g"),
        (_, false) => println("f"),
        (0, _) => println("z"),
    }
    let s: &[i32] = &[1, 2]; match s { [] => {} [x, ..] => println(`${x}`), [_, _] => {} }
}
