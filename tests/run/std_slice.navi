// Slice and Vec methods: rotation, split_at_mut, chunk/window iterators,
// split, partition_point, sorting by key, select_nth, concat/join,
// fill/swap, ASCII byte methods, dedup/retain/extend/pop_if/resize, ordering.
#[test]
fn rotate_split_chunks_windows() {
    let mut v: Vec<i32> = (1..=7).collect();
    v.rotate_right(2);
    assert_eq(v, Vec::from([6, 7, 1, 2, 3, 4, 5]));
    let (a, b) = v.split_at_mut(3);
    a[0] = 100;
    b[0] = 200;
    assert_eq(v, Vec::from([100, 7, 1, 200, 3, 4, 5]));
    let ce: Vec<&[i32]> = v.chunks_exact(3).collect();
    assert_eq(`${ce:?} ${v.chunks_exact(3).remainder():?}`.to_string(), "[[100, 7, 1], [200, 3, 4]] [5]");
    let rc: Vec<&[i32]> = v.rchunks(3).collect();
    assert_eq(`${rc:?}`.to_string(), "[[3, 4, 5], [7, 1, 200], [100]]");
    let cr: Vec<&[i32]> = v.chunks(3).rev().collect();
    assert_eq(`${cr:?}`.to_string(), "[[5], [200, 3, 4], [100, 7, 1]]");
    assert_eq(v.chunks(3).len(), 3);
    assert_eq(v.windows(3).len(), 5);
    let wr: Vec<&[i32]> = v.windows(5).rev().collect();
    assert_eq(`${wr:?}`.to_string(), "[[1, 200, 3, 4, 5], [7, 1, 200, 3, 4], [100, 7, 1, 200, 3]]");
    for c in v.chunks_mut(2) { c[0] = 0; }
    assert_eq(v, Vec::from([0, 7, 0, 200, 0, 4, 0]));
}

#[test]
fn split_partition_point_repeat() {
    let parts: Vec<&[i32]> = [1, 0, 2, 3, 0, 4].split(|x| *x == 0).collect();
    assert_eq(`${parts:?}`.to_string(), "[[1], [2, 3], [4]]");
    let s = [1, 2, 4, 8, 16];
    assert_eq(s.partition_point(|x| *x < 5), 3);
    assert(s.is_sorted());
    assert(![3, 1].is_sorted());
    assert_eq(`${s.repeat(2):?}`.to_string(), "[1, 2, 4, 8, 16, 1, 2, 4, 8, 16]");
}

#[test]
fn sort_by_cached_key_and_select_nth() {
    let mut w = ["bb", "a", "ccc"];
    w.sort_by_cached_key(|x| x.len());
    assert_eq(`${w:?}`.to_string(), "[\"a\", \"bb\", \"ccc\"]");
    let mut big: Vec<i32> = Vec::new();
    let mut i = 0;
    while i < 1000 { big.push((i * 7919) % 1000); i += 1; }
    let (_, m, _) = big.select_nth_unstable(500);
    assert_eq(*m, 500);
}

#[test]
fn concat_and_join() {
    let vv: Vec<Vec<i32>> = [[1, 2].to_vec(), [3].to_vec()].to_vec();
    assert_eq(`${vv.concat():?} ${vv.join(&0):?} ${vv.join(&[9, 9][..]):?} ${[[1, 2], [3, 4]].concat():?}`.to_string(),
        "[1, 2, 3] [1, 2, 0, 3] [1, 2, 9, 9, 3] [1, 2, 3, 4]");
    let names = ["x".to_string(), "y".to_string()];
    assert_eq(names.join("+").as_str(), "x+y");
    assert_eq(names.concat().as_str(), "xy");
    assert_eq(["p", "q"].join(", ").as_str(), "p, q");
}

#[test]
fn fill_with_and_swap_with_slice() {
    let mut f = [0; 4];
    f.fill_with(|| 3);
    let mut g = [1, 2, 3, 4];
    f.swap_with_slice(&mut g);
    assert_eq(`${f:?} ${g:?}`.to_string(), "[1, 2, 3, 4] [3, 3, 3, 3]");
}

#[test]
fn ascii_bytes() {
    assert_eq(`${b"Hello".to_ascii_uppercase():?} ${b"  hi ".trim_ascii():?}`.to_string(), "[72, 69, 76, 76, 79] [104, 105]");
    assert(b"AbC".eq_ignore_ascii_case(b"aBc"));
}

#[test]
fn dedup_retain_extend_pop_if_resize() {
    let mut d: Vec<i32> = [1, 1, 2, 3, 3, 3, 4].to_vec();
    d.dedup_by(|a, b| *a == *b);
    assert_eq(d, Vec::from([1, 2, 3, 4]));
    d.retain_mut(|x| { *x = *x * 10; *x > 10 });
    assert_eq(d, Vec::from([20, 30, 40]));
    d.extend_from_within(0..2);
    d.extend(&[7, 8]);
    assert_eq(d, Vec::from([20, 30, 40, 20, 30, 7, 8]));
    let p1 = d.pop_if(|x| *x == 8);
    let p2 = d.pop_if(|x| *x == 8);
    assert_eq(d, Vec::from([20, 30, 40, 20, 30, 7]));
    assert_eq(p1, Some(8));
    assert_eq(p2, None);
    d.resize_with(7, || -1);
    assert_eq(d, Vec::from([20, 30, 40, 20, 30, 7, -1]));
}

#[test]
fn vec_ordering_and_conversion() {
    let x: Vec<i32> = [1, 2].to_vec();
    let y: Vec<i32> = [1, 3].to_vec();
    assert(x < y);
    assert_eq(x.cmp(&y), std::cmp::Ordering::Less);
    assert(x == [1, 2]);
    let mut nested: Vec<Vec<i32>> = [y.clone(), x.clone()].to_vec();
    nested.sort();
    assert_eq(`${nested:?}`.to_string(), "[[1, 2], [1, 3]]");
    let bytes: Vec<u8> = Vec::from("hi");
    assert_eq(bytes, Vec::from([104u8, 105]));
    assert_eq(x.into_iter().rev().len(), 2);
}
