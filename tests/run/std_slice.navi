// stage0: skip (slice and Vec methods added for navic: std hides them from stage0)
// out: [6, 7, 1, 2, 3, 4, 5]
// out: [100, 7, 1, 200, 3, 4, 5]
// out: [[100, 7, 1], [200, 3, 4]] [5]
// out: [[3, 4, 5], [7, 1, 200], [100]]
// out: [[5], [200, 3, 4], [100, 7, 1]] 3 5
// out: [[1, 200, 3, 4, 5], [7, 1, 200, 3, 4], [100, 7, 1, 200, 3]]
// out: [0, 7, 0, 200, 0, 4, 0]
// out: [[1], [2, 3], [4]]
// out: 3 true false [1, 2, 4, 8, 16, 1, 2, 4, 8, 16]
// out: ["a", "bb", "ccc"]
// out: 500
// out: [1, 2, 3] [1, 2, 0, 3] [1, 2, 9, 9, 3] [1, 2, 3, 4]
// out: x+y xy p, q
// out: [1, 2, 3, 4] [3, 3, 3, 3]
// out: [72, 69, 76, 76, 79] [104, 105] true
// out: [1, 2, 3, 4]
// out: [20, 30, 40]
// out: [20, 30, 40, 20, 30, 7] Some(8) None
// out: [20, 30, 40, 20, 30, 7, -1]
// out: true Less true
// out: [[1, 2], [1, 3]]
// out: [104, 105] 2
fn main() {
    let mut v: Vec<i32> = (1..=7).collect();
    v.rotate_right(2);
    println(`${v:?}`);
    let (a, b) = v.split_at_mut(3);
    a[0] = 100;
    b[0] = 200;
    println(`${v:?}`);
    let ce: Vec<&[i32]> = v.chunks_exact(3).collect();
    println(`${ce:?} ${v.chunks_exact(3).remainder():?}`);
    let rc: Vec<&[i32]> = v.rchunks(3).collect();
    println(`${rc:?}`);
    let cr: Vec<&[i32]> = v.chunks(3).rev().collect();
    println(`${cr:?} ${v.chunks(3).len()} ${v.windows(3).len()}`);
    let wr: Vec<&[i32]> = v.windows(5).rev().collect();
    println(`${wr:?}`);
    for c in v.chunks_mut(2) { c[0] = 0; }
    println(`${v:?}`);
    let parts: Vec<&[i32]> = [1, 0, 2, 3, 0, 4].split(|x| *x == 0).collect();
    println(`${parts:?}`);
    let s = [1, 2, 4, 8, 16];
    println(`${s.partition_point(|x| *x < 5)} ${s.is_sorted()} ${[3, 1].is_sorted()} ${s.repeat(2):?}`);
    let mut w = ["bb", "a", "ccc"];
    w.sort_by_cached_key(|x| x.len());
    println(`${w:?}`);
    let mut big: Vec<i32> = Vec::new();
    let mut i = 0;
    while i < 1000 { big.push((i * 7919) % 1000); i += 1; }
    let (_, m, _) = big.select_nth_unstable(500);
    println(`${*m}`);
    let vv: Vec<Vec<i32>> = [[1, 2].to_vec(), [3].to_vec()].to_vec();
    println(`${vv.concat():?} ${vv.join(&0):?} ${vv.join(&[9, 9][..]):?} ${[[1, 2], [3, 4]].concat():?}`);
    let names = ["x".to_string(), "y".to_string()];
    println(`${names.join("+")} ${names.concat()} ${["p", "q"].join(", ")}`);
    let mut f = [0; 4];
    f.fill_with(|| 3);
    let mut g = [1, 2, 3, 4];
    f.swap_with_slice(&mut g);
    println(`${f:?} ${g:?}`);
    println(`${b"Hello".to_ascii_uppercase():?} ${b"  hi ".trim_ascii():?} ${b"AbC".eq_ignore_ascii_case(b"aBc")}`);
    let mut d: Vec<i32> = [1, 1, 2, 3, 3, 3, 4].to_vec();
    d.dedup_by(|a, b| *a == *b);
    println(`${d:?}`);
    d.retain_mut(|x| { *x = *x * 10; *x > 10 });
    println(`${d:?}`);
    d.extend_from_within(0..2);
    d.extend(&[7, 8]);
    println(`${d:?} ${d.pop_if(|x| *x == 8):?} ${d.pop_if(|x| *x == 8):?}`);
    d.resize_with(7, || -1);
    println(`${d:?}`);
    let x: Vec<i32> = [1, 2].to_vec();
    let y: Vec<i32> = [1, 3].to_vec();
    println(`${x < y} ${x.cmp(&y):?} ${x == [1, 2]}`);
    let mut nested: Vec<Vec<i32>> = [y.clone(), x.clone()].to_vec();
    nested.sort();
    println(`${nested:?}`);
    let bytes: Vec<u8> = Vec::from("hi");
    println(`${bytes:?} ${x.into_iter().rev().len()}`);
}
