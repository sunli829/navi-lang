// std::tls servers: TlsAcceptor with certificates and keys made by Go
// 1.26 (P-256 in PKCS#8, P-384 in SEC 1, RSA in PKCS#1, Ed25519 in
// PKCS#8), std::tls clients
// over localhost: TLS 1.3, TLS 1.2 with each suite (AES-GCM, ChaCha20,
// AES-CBC), ALPN, SNI, version limits, client certificates in each
// ClientAuth mode; and std::http over https. (Go's
// clients were checked against these servers by hand: /tmp/goref10.)

use std::io::{Read, Write};
use std::net::{TcpListener, TcpStream};
use std::tls::{Certificate, ClientAuth, Identity, Protocol, TlsAcceptor, TlsConnector};
use std::http;

fn identity(cert: &str, key: &str) -> Identity { Identity::from_pkcs8(cert.as_bytes(), key.as_bytes()).unwrap() }

fn root() -> Certificate { Certificate::from_pem(ROOT.as_bytes()).unwrap() }

// A server on a free port: each connection answers "n\n" with SNI, ALPN
// and n bytes, then closes. The port.
fn server(acceptor: TlsAcceptor) -> u16 {
    let l = TcpListener::bind("127.0.0.1:0").unwrap();
    let port = l.local_addr().unwrap().port();
    std::thread::spawn(|| {
        for c in l.incoming() {
            let stream: TcpStream = c.unwrap();
            let a = acceptor.clone();
            std::thread::spawn(|| {
                let mut tls = match a.accept(stream) {
                    Ok(t) => t,
                    Err(_) => return,
                };
                let mut line: Vec<u8> = Vec::new();
                let mut byte = [0u8; 1];
                loop {
                    if tls.read(&mut byte).unwrap_or(0) == 0 { break; }
                    if byte[0] == b'\n' { break; }
                    line.push(byte[0]);
                }
                let n = String::from_utf8_lossy(line.as_slice()).parse::<usize>().unwrap_or(0);
                let alpn = match tls.negotiated_alpn().unwrap() { Some(p) => String::from_utf8_lossy(p.as_slice()), None => "-".to_string() };
                let peer = match tls.peer_certificate().unwrap() { Some(c) => c.subject().common_name().to_string(), None => "-".to_string() };
                let head = `${tls.server_name().unwrap_or("-")} ${alpn} ${peer}\n`.to_string();
                tls.write_all(head.as_bytes()).unwrap();
                let mut data: Vec<u8> = Vec::new();
                let mut i = 0;
                while i < n {
                    data.push((i % 251) as u8);
                    i += 1;
                }
                tls.write_all(data.as_slice()).unwrap();
                let _ = tls.shutdown();
                tls.get_ref().close();
            });
        }
    });
    port
}

// Connects with b, asks for n bytes; the head line.
fn fetch(b: &mut std::tls::TlsConnectorBuilder, port: u16, host: &str, n: usize) -> Result<String, String> {
    b.add_root_certificate(root()).disable_built_in_roots(true);
    let c = b.build().unwrap();
    let s = TcpStream::connect(`127.0.0.1:${port}`.to_string().as_str()).unwrap();
    let mut tls = match c.connect(host, s) {
        Ok(t) => t,
        Err(e) => return Err(e.to_string()),
    };
    if let Err(e) = tls.write_all(`${n}\n`.to_string().as_bytes()) { return Err(e.to_string()); }
    let mut out: Vec<u8> = Vec::new();
    // (TLS 1.3: a server's refusal of the client certificate comes after
    // the client's handshake.)
    if let Err(e) = tls.read_to_end(&mut out) { return Err(e.to_string()); }
    let text_end = out.iter().position(|b: &u8| -> bool { *b == b'\n' }).unwrap();
    let head = String::from_utf8_lossy(&out[..text_end]);
    let data = &out[text_end + 1..];
    assert_eq(data.len(), n);
    let mut i = 0;
    while i < n {
        assert_eq(data[i], (i % 251) as u8);
        i += 1;
    }
    Ok(head)
}

#[test]
fn versions_and_suites() {
    let ids = [(identity(EC256_PEM, EC256_KEY), true), (identity(EC384_PEM, EC384_KEY), true), (identity(RSA_PEM, RSA_KEY), false)];
    for (id, ecdsa) in ids.iter() {
        let port = server(TlsAcceptor::new(id.clone()).unwrap());
        // TLS 1.3, each suite.
        for suite in [0x1301u16, 0x1302, 0x1303].iter() {
            let mut b = TlsConnector::builder();
            b.min_protocol_version(Some(Protocol::Tlsv13)).test_cipher_suites(&[*suite]);
            assert_eq(fetch(&mut b, port, "localhost", 40000).unwrap(), "localhost - -".to_string());
        }
        // TLS 1.2, each suite of the key's kind.
        let suites: [u16; 5] = if *ecdsa { [0xc02b, 0xc02c, 0xcca9, 0xc009, 0xc00a] } else { [0xc02f, 0xc030, 0xcca8, 0xc013, 0xc014] };
        for suite in suites.iter() {
            let mut b = TlsConnector::builder();
            b.max_protocol_version(Some(Protocol::Tlsv12)).test_cipher_suites(&[*suite]);
            assert_eq(fetch(&mut b, port, "localhost", 40000).unwrap(), "localhost - -".to_string());
        }
        // By IP address: no SNI.
        assert_eq(fetch(&mut TlsConnector::builder(), port, "127.0.0.1", 10).unwrap(), "- - -".to_string());
        // Another name.
        assert(fetch(&mut TlsConnector::builder(), port, "example.com", 10).unwrap_err().contains("not example.com"));
    }
}

#[test]
fn alpn_and_limits() {
    let mut ab = TlsAcceptor::builder(identity(EC256_PEM, EC256_KEY));
    ab.alpn_protocols(&["h2", "http/1.1"]);
    let port = server(ab.build().unwrap());
    let mut b = TlsConnector::builder();
    b.request_alpns(&["http/1.1", "h2"]);
    // (The server's preference.)
    assert_eq(fetch(&mut b, port, "localhost", 10).unwrap(), "localhost h2 -".to_string());
    let mut b12 = TlsConnector::builder();
    b12.request_alpns(&["http/1.1"]).max_protocol_version(Some(Protocol::Tlsv12));
    assert_eq(fetch(&mut b12, port, "localhost", 10).unwrap(), "localhost http/1.1 -".to_string());
    // No protocol in common: refused.
    let mut bx = TlsConnector::builder();
    bx.request_alpns(&["spdy/3"]);
    assert(fetch(&mut bx, port, "localhost", 10).is_err());
    // A TLS 1.2-only server and a TLS 1.3-only client.
    let mut a12 = TlsAcceptor::builder(identity(RSA_PEM, RSA_KEY));
    a12.max_protocol_version(Some(Protocol::Tlsv12));
    let p12 = server(a12.build().unwrap());
    assert_eq(fetch(&mut TlsConnector::builder(), p12, "localhost", 10).unwrap(), "localhost - -".to_string());
    let mut c13 = TlsConnector::builder();
    c13.min_protocol_version(Some(Protocol::Tlsv13));
    assert(fetch(&mut c13, p12, "localhost", 10).is_err());
    // A key that is not the certificate's.
    assert(Identity::from_pkcs8(EC256_PEM.as_bytes(), EC384_KEY.as_bytes()).is_err());
}

#[test]
fn client_certificates() {
    let ec = identity(CLIENT_EC_PEM, CLIENT_EC_KEY);
    let rsa = identity(CLIENT_RSA_PEM, CLIENT_RSA_KEY);
    let ca = Certificate::from_pem(CLIENT_ROOT.as_bytes()).unwrap();
    let acceptor = |mode: ClientAuth| -> TlsAcceptor {
        let mut b = TlsAcceptor::builder(identity(EC256_PEM, EC256_KEY));
        b.client_auth(mode).add_client_ca(ca.clone());
        b.build().unwrap()
    };
    let verify = server(acceptor(ClientAuth::RequireAndVerifyClientCert));
    for v12 in [false, true].iter() {
        for (id, cn) in [(ec.clone(), "client_ec"), (rsa.clone(), "client_rsa")].iter() {
            let mut b = TlsConnector::builder();
            b.identity(id.clone());
            if *v12 { b.max_protocol_version(Some(Protocol::Tlsv12)); }
            assert_eq(fetch(&mut b, verify, "localhost", 1000).unwrap(), `localhost - ${cn}`.to_string());
        }
        // None: refused.
        let mut none = TlsConnector::builder();
        if *v12 { none.max_protocol_version(Some(Protocol::Tlsv12)); }
        assert(fetch(&mut none, verify, "localhost", 10).is_err());
        // One the client CAs did not issue (a server certificate).
        let mut other = TlsConnector::builder();
        other.identity(identity(EC384_PEM, EC384_KEY));
        if *v12 { other.max_protocol_version(Some(Protocol::Tlsv12)); }
        assert(fetch(&mut other, verify, "localhost", 10).is_err());
    }
    // Asked but optional: none is fine, one sent is checked (and named).
    let request = server(acceptor(ClientAuth::RequestClientCert));
    assert_eq(fetch(&mut TlsConnector::builder(), request, "localhost", 10).unwrap(), "localhost - -".to_string());
    let if_given = server(acceptor(ClientAuth::VerifyClientCertIfGiven));
    assert_eq(fetch(&mut TlsConnector::builder(), if_given, "localhost", 10).unwrap(), "localhost - -".to_string());
    let mut with = TlsConnector::builder();
    with.identity(rsa.clone());
    assert_eq(fetch(&mut with, if_given, "localhost", 10).unwrap(), "localhost - client_rsa".to_string());
    let mut bad = TlsConnector::builder();
    bad.identity(identity(EC384_PEM, EC384_KEY));
    assert(fetch(&mut bad, if_given, "localhost", 10).is_err());
    // Required, any: an unverifiable one is taken.
    let any = server(acceptor(ClientAuth::RequireAnyClientCert));
    let mut b2 = TlsConnector::builder();
    b2.identity(identity(EC384_PEM, EC384_KEY));
    assert_eq(fetch(&mut b2, any, "localhost", 10).unwrap(), "localhost - localhost".to_string());
    assert(fetch(&mut TlsConnector::builder(), any, "localhost", 10).is_err());
}

#[test]
fn https() {
    let server = http::Server::bind("127.0.0.1:0").unwrap().tls(TlsAcceptor::new(identity(EC256_PEM, EC256_KEY)).unwrap());
    let port = server.local_addr().port();
    let s2 = server.clone();
    std::thread::spawn(|| { let _ = s2.serve(|req: &mut http::Request| -> http::Response { http::Response::from_string(`${req.url().scheme()} ${req.url().path()}`.to_string()) }); });
    let c = http::Client::builder().add_root_certificate(root()).tls_built_in_root_certs(false).build().unwrap();
    let url = `https://localhost:${port}/hello`.to_string();
    assert_eq(c.get(url.as_str()).send().unwrap().text().unwrap(), "https /hello".to_string());
    // Again: the pooled connection.
    assert_eq(c.get(url.as_str()).send().unwrap().text().unwrap(), "https /hello".to_string());
    // Without the root: refused.
    assert(http::get(url.as_str()).is_err());
    server.close();
}

#[test]
fn ed25519() {
    // An Ed25519 chain (the CA's signatures Ed25519 too), TLS 1.3 and 1.2
    // (ECDHE-ECDSA suites), and an Ed25519 client certificate.
    let ca = Certificate::from_pem(ED_ROOT.as_bytes()).unwrap();
    let mut ab = TlsAcceptor::builder(identity(ED_SERVER_PEM, ED_SERVER_KEY));
    ab.client_auth(ClientAuth::VerifyClientCertIfGiven).add_client_ca(ca.clone());
    let port = server(ab.build().unwrap());
    for v12 in [false, true].iter() {
        let mut b = TlsConnector::builder();
        b.add_root_certificate(ca.clone());
        if *v12 { b.max_protocol_version(Some(Protocol::Tlsv12)); }
        assert_eq(fetch(&mut b, port, "localhost", 1000).unwrap(), "localhost - -".to_string());
        let mut c = TlsConnector::builder();
        c.add_root_certificate(ca.clone()).identity(identity(ED_CLIENT_PEM, ED_CLIENT_KEY));
        if *v12 { c.max_protocol_version(Some(Protocol::Tlsv12)); }
        assert_eq(fetch(&mut c, port, "localhost", 10).unwrap(), "localhost - client_ed25519".to_string());
        // Not trusting the Ed25519 root: refused.
        let mut d = TlsConnector::builder();
        if *v12 { d.max_protocol_version(Some(Protocol::Tlsv12)); }
        assert(fetch(&mut d, port, "localhost", 10).is_err());
    }
}


