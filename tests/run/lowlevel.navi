// Low-level semantics: shared generic instances through dictionaries, dyn
// traits, statics, numeric casts, integer division/remainder/shifts, enum
// discriminants, chars, float printing, defer order, Location::caller.
use std::fmt::Display;

trait Named { fn name(&self) -> String; }
struct A;
struct B { s: &str }
impl Named for &A { fn name(&self) -> String { "a".to_string() } }
impl Named for &B { fn name(&self) -> String { self.s.to_string() } }

// Shared shape code: T = &A and T = &B share one instance; name() goes
// through the dictionary.
fn names<T: Named>(xs: &[T]) -> usize {
    let mut n = 0;
    for x in xs { n += x.name().len(); }
    n
}

trait Shape { fn area(&self) -> f64; fn label(&self) -> &str; }
struct Circle;
struct Square { s: f64 }
impl Shape for Circle { fn area(&self) -> f64 { 3.14 } fn label(&self) -> &str { "circle" } }
impl Shape for Square { fn area(&self) -> f64 { self.s * self.s } fn label(&self) -> &str { "square" } }

static mut COUNTER: i32 = 0;
static BASE: i32 = 1 + 2;

fn bump() { COUNTER += 1; }

#[derive(Debug, Clone, PartialEq)]
enum E { One = 10, Two = 20, Neg = -1 }

fn wrap_add(a: u8, b: u8) -> u8 { ((a as u32 + b as u32) & 255) as u8 }

#[test]
fn shared_generic_instances() {
    let a = A;
    let b = B { s: "hi" };
    let refs_a = [&a, &a];
    let refs_b = [&b];
    assert_eq(names(&refs_a) + names(&refs_b), 4);
    assert_eq((&b).name().as_str(), "hi");
}

#[test]
fn dyn_trait() {
    let shapes: [&dyn Shape; 2] = [&Circle, &Square { s: 2.0 }];
    let mut out = String::from("dyn");
    for s in shapes.iter() { out.push_str(&` ${s.label()} ${s.area()}`.to_string()); }
    assert_eq(out.as_str(), "dyn circle 3.14 square 4");
}

#[test]
fn statics() {
    bump();
    bump();
    assert_eq(BASE, 3);
    assert_eq(COUNTER, 2);
}

#[test]
fn casts() {
    let m1: i32 = -1;
    let f = 1e20f64;
    assert_eq(m1 as i8, -1i8);
    assert_eq(m1 as u8, 255u8);
    assert_eq(m1 as u16, 65535u16);
    assert_eq((128u8) as i8, -128i8);
    assert_eq(300u16 as i32, 300);
    assert_eq(3.99f64 as i32, 3);
    assert_eq(300.0f64 as u8, 255u8);
    assert_eq(-5.0f64 as u32, 0u32);
    assert_eq(-3.7f32 as i64, -3i64);
    assert_eq(`${f as f32}`.to_string().as_str(), "100000000000000000000");
}

#[test]
fn integers() {
    let x: i32 = -7;
    let u: u32 = 0;
    assert_eq(`${x}`.to_string().as_str(), "-7");
    assert_eq(x / -3, 2);
    assert_eq(x % -5, -2);
    assert_eq((x % 3 + 3) % 3 - 1, 1);
    assert_eq((u as i64 - 1) as u32, 4294967295u32);
    assert_eq(-1i64 as u64, 18446744073709551615u64);
    assert((-1i64 as u64) > 5);
    let sh: i32 = -16;
    assert_eq(1 << 4, 16);
    assert_eq(sh >> 2, -4);
    assert_eq((4294967295u32 >> 1) as i32, 2147483647);
    assert_eq(wrap_add(200, 55), 255u8);
    assert_eq(wrap_add(200, 56), 0u8);
}

#[test]
fn enum_discriminants() {
    let e = E::Two;
    assert_eq(E::One as i32, 10);
    assert_eq(e as i32, 20);
    assert_eq(E::Neg as i32, -1);
    assert_eq(`${e:?}`.to_string().as_str(), "Two");
}

#[test]
fn chars() {
    let c = 'z';
    assert_eq(`${c:?}`.to_string().as_str(), "'z'");
    assert_eq(c as u32, 122u32);
    assert_eq(`${'é'}`.to_string().as_str(), "é");
}

#[test]
fn floats() {
    let z = -0.0f64;
    assert_eq(`${0.1 + 0.2} ${z} ${1.0 / 0.0} ${0.0f64 / 0.0} ${3.0f64 % 1.5 + 1.5} ${5.0f32 / 2.0}`.to_string().as_str(), "0.30000000000000004 -0 inf NaN 1.5 2.5");
}

fn put(out: &mut String, s: String) { out.push_str(s.as_str()); }

// As defer println(s): the deferred call sees the pushes made after it.
fn defer_order(out: &mut String) {
    let mut s = String::from("defer");
    defer put(out, s);
    defer s.push_str(" b");
    s.push_str(" a");
}

#[test]
fn defer_runs_last_first() {
    let mut out = String::new();
    defer_order(&mut out);
    assert_eq(out.as_str(), "defer a b");
}

#[test]
fn location_caller() {
    let loc = std::panic::Location::caller();
    assert(loc.file().ends_with("lowlevel.navi"));
    assert_eq(loc.line(), 139);
}
