// out: shapes 4 hi
// out: dyn circle 3.14 square 4
// out: static 3 counter 2
// out: casts -1 255 65535 -128 300 3 255 0 -3 100000000000000000000
// out: ints -7 2 -2 1 4294967295 18446744073709551615 true
// out: shifts 16 -4 2147483647
// out: wrap 255 0
// out: enum 10 20 -1 Two
// out: chars 'z' 122 é
// out: floats 0.30000000000000004 -0 inf NaN 1.5 2.5
// out: defer a b
// out: caller true 82
use std::fmt::Display;

trait Named { fn name(&self) -> String; }
struct A;
struct B { s: &str }
impl Named for &A { fn name(&self) -> String { "a".to_string() } }
impl Named for &B { fn name(&self) -> String { self.s.to_string() } }

// Shared shape code: T = &A and T = &B share one instance; name() goes
// through the dictionary.
fn names<T: Named>(xs: &[T]) -> usize {
    let mut n = 0;
    for x in xs { n += x.name().len(); }
    n
}

trait Shape { fn area(&self) -> f64; fn label(&self) -> &str; }
struct Circle;
struct Square { s: f64 }
impl Shape for Circle { fn area(&self) -> f64 { 3.14 } fn label(&self) -> &str { "circle" } }
impl Shape for Square { fn area(&self) -> f64 { self.s * self.s } fn label(&self) -> &str { "square" } }

static mut COUNTER: i32 = 0;
static BASE: i32 = 1 + 2;

fn bump() { COUNTER += 1; }

#[derive(Debug, Clone, PartialEq)]
enum E { One = 10, Two = 20, Neg = -1 }

fn wrap_add(a: u8, b: u8) -> u8 { ((a as u32 + b as u32) & 255) as u8 }

fn main() {
    let a = A;
    let b = B { s: "hi" };
    let refs_a = [&a, &a];
    let refs_b = [&b];
    println(`shapes ${names(&refs_a) + names(&refs_b)} ${(&b).name()}`);

    let shapes: [&dyn Shape; 2] = [&Circle, &Square { s: 2.0 }];
    let mut out = String::from("dyn");
    for s in shapes.iter() { out.push_str(&` ${s.label()} ${s.area()}`); }
    println(out);

    bump();
    bump();
    println(`static ${BASE} counter ${COUNTER}`);

    let m1: i32 = -1;
    let f = 1e20f64;
    println(`casts ${m1 as i8} ${m1 as u8} ${m1 as u16} ${(128u8) as i8} ${300u16 as i32} ${3.99f64 as i32} ${300.0f64 as u8} ${-5.0f64 as u32} ${-3.7f32 as i64} ${f as f32}`);

    let x: i32 = -7;
    let u: u32 = 0;
    println(`ints ${x} ${x / -3} ${x % -5} ${(x % 3 + 3) % 3 - 1} ${(u as i64 - 1) as u32} ${-1i64 as u64} ${(-1i64 as u64) > 5}`);
    let sh: i32 = -16;
    println(`shifts ${1 << 4} ${sh >> 2} ${(4294967295u32 >> 1) as i32}`);
    println(`wrap ${wrap_add(200, 55)} ${wrap_add(200, 56)}`);

    let e = E::Two;
    println(`enum ${E::One as i32} ${e as i32} ${E::Neg as i32} ${e:?}`);

    let c = 'z';
    println(`chars ${c:?} ${c as u32} ${'é'}`);

    let z = -0.0f64;
    println(`floats ${0.1 + 0.2} ${z} ${1.0 / 0.0} ${0.0f64 / 0.0} ${3.0f64 % 1.5 + 1.5} ${5.0f32 / 2.0}`);

    defer_order();
    let loc = std::panic::Location::caller();
    println(`caller ${loc.file().ends_with("lowlevel.navi")} ${loc.line()}`);
}

fn defer_order() {
    let mut s = String::from("defer");
    defer println(s);
    defer s.push_str(" b");
    s.push_str(" a");
}
