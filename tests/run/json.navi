// std::json through std::serde (encoding, decoding, round trip, errors).
use std::json;
use std::serde::{Serialize, Deserialize};
use std::collections::HashMap;

#[derive(Debug, Serialize, Deserialize)]
struct Point { x: i32, y: f64 }

#[derive(Debug, Serialize, Deserialize)]
enum Shape { Circle(f64), Rect { w: i32, h: i32 }, Line(Point, Point), Empty }

#[derive(Debug, Serialize, Deserialize)]
struct Meters(f64);

#[derive(Debug, Serialize, Deserialize)]
struct Doc {
    title: String,
    tags: Vec<String>,
    origin: Point,
    shapes: Vec<Shape>,
    scale: Option<f64>,
    parent: Option<&Point>,
    ok: bool,
    c: char,
    pair: (u8, i64),
    grid: [i16; 3],
    m: HashMap<String, i32>,
    ids: HashMap<u32, String>,
    len: Meters,
    note: &str,
}

fn doc() -> Doc {
    let mut m = HashMap::new();
    m.insert(String::from("b"), 2);
    m.insert(String::from("a"), 1);
    let mut ids = HashMap::new();
    ids.insert(7u32, String::from("seven"));
    Doc {
        title: String::from("q\"uote\n"), tags: vec_of(), origin: Point { x: -3, y: 0.5 },
        shapes: shapes(), scale: None, parent: Some(&Point { x: 9, y: 9.0 }), ok: true, c: 'é',
        pair: (255, -1), grid: [1, -2, 3], m, ids, len: Meters(2.5), note: "hi",
    }
}

#[test]
fn encode_decode_roundtrip() {
    let d = doc();
    let s = json::to_string(&d).unwrap();
    assert_eq(s.as_str(), "{\"title\":\"q\\\"uote\\n\",\"tags\":[\"x\",\"y\"],\"origin\":{\"x\":-3,\"y\":0.5},\"shapes\":[{\"Circle\":1.5},{\"Rect\":{\"w\":2,\"h\":3}},{\"Line\":[{\"x\":0,\"y\":0},{\"x\":1,\"y\":1}]},\"Empty\"],\"scale\":null,\"parent\":{\"x\":9,\"y\":9},\"ok\":true,\"c\":\"é\",\"pair\":[255,-1],\"grid\":[1,-2,3],\"m\":{\"b\":2,\"a\":1},\"ids\":{\"7\":\"seven\"},\"len\":2.5,\"note\":\"hi\"}");
    let back: Doc = json::from_str(s.as_str()).unwrap();
    assert_eq(`${back.title:?} ${back.shapes:?} ${back.parent:?} ${back.grid:?} ${back.len:?}`.to_string(), "\"q\\\"uote\\n\" [Circle(1.5), Rect { w: 2, h: 3 }, Line(Point { x: 0, y: 0.0 }, Point { x: 1, y: 1.0 }), Empty] Some(Point { x: 9, y: 9.0 }) [1, -2, 3] Meters(2.5)");
    let s2 = json::to_string(&back).unwrap();
    assert(s == s2);
}

#[test]
fn pretty() {
    assert_eq(json::to_string_pretty(&Point { x: 1, y: 2.0 }).unwrap().as_str(), "{\n  \"x\": 1,\n  \"y\": 2\n}");
}

#[test]
fn decode_skips_unknown_fields() {
    let p: Point = json::from_str(" { \"y\": 1e2, \"extra\": [1, {\"z\": null}], \"x\": 5 } ").unwrap();
    assert_eq(`${p:?}`.to_string(), "Point { x: 5, y: 100.0 }");
}

#[test]
fn errors() {
    match json::from_str::<Point>("{\"x\": 99999999999}") { Ok(_) => panic("expected an error"), Err(e) => assert_eq(`error: ${e}`.to_string(), "error: json: invalid value: integer `99999999999`, expected i32 at offset 17") }
    match json::from_str::<Vec<i32>>("[1, 2") { Ok(_) => panic("expected an error"), Err(e) => assert_eq(`error: ${e}`.to_string(), "error: json: expected ']' at offset 5") }
}

#[test]
fn unicode_escapes() {
    let v: Vec<Option<String>> = json::from_str("[\"a\\u00e9\\ud83d\\ude00\", null]").unwrap();
    assert_eq(`${v:?}`.to_string(), "[Some(\"aé😀\"), None]");
}

#[derive(Debug, Serialize, Deserialize, PartialEq)]
#[serde(rename_all = "camelCase", deny_unknown_fields)]
struct User {
    user_id: u64,
    #[serde(rename = "name")]
    display_name: String,
    #[serde(skip_serializing_if = "Option::is_none")]
    nick_name: Option<String>,
    #[serde(default)]
    login_count: i32,
    #[serde(skip)]
    cache: Vec<u8>,
}

#[test]
fn attributes() {
    let u = User { user_id: 7, display_name: "Ann".to_string(), nick_name: None, login_count: 3, cache: vec_u8() };
    let s = json::to_string(&u).unwrap();
    assert_eq(s.as_str(), "{\"userId\":7,\"name\":\"Ann\",\"loginCount\":3}");
    let back: User = json::from_str("{\"name\":\"Bo\",\"userId\":1}").unwrap();
    assert_eq(`${back:?}`.to_string(), "User { user_id: 1, display_name: \"Bo\", nick_name: None, login_count: 0, cache: [] }");
    match json::from_str::<User>("{\"userId\":1,\"name\":\"x\",\"age\":3}") { Ok(_) => panic("expected an error"), Err(e) => assert_eq(`${e}`.to_string(), "json: unknown field `age`, expected one of `userId`, `name`, `nickName`, `loginCount` at offset 28") }
    match json::from_str::<User>("{\"name\":\"x\"}") { Ok(_) => panic("expected an error"), Err(e) => assert_eq(`${e}`.to_string(), "json: missing field `userId` at offset 12") }
}

#[derive(Debug, Serialize, Deserialize, PartialEq)]
struct Pair<A, B> { first: A, second: Option<B> }

#[derive(Debug, Serialize, Deserialize, PartialEq)]
struct Unit;

#[derive(Debug, Serialize, Deserialize, PartialEq)]
struct Rgb(u8, u8, u8);

#[test]
fn generics_and_shapes() {
    let p: Pair<String, Vec<i32>> = json::from_str("{\"first\":\"a\"}").unwrap();
    assert_eq(`${p:?}`.to_string(), "Pair { first: \"a\", second: None }");
    assert_eq(json::to_string(&Pair { first: 1, second: Some(Rgb(1, 2, 3)) }).unwrap().as_str(), "{\"first\":1,\"second\":[1,2,3]}");
    assert_eq(json::to_string(&Unit).unwrap().as_str(), "null");
    let u: Unit = json::from_str("null").unwrap();
    assert(u == Unit);
    match json::from_str::<Rgb>("[1,2]") { Ok(_) => panic("expected an error"), Err(e) => assert_eq(`${e}`.to_string(), "json: invalid length 2, expected tuple struct Rgb at offset 5") }
    match json::from_str::<Shape>("{\"Square\":1}") { Ok(_) => panic("expected an error"), Err(e) => assert_eq(`${e}`.to_string(), "json: unknown variant `Square`, expected one of `Circle`, `Rect`, `Line`, `Empty` at offset 10") }
}

#[test]
fn any_value() {
    let v: json::Value = json::from_str("{\"b\":[1,-2,3.5,true,null],\"a\":{\"x\":\"y\"}}").unwrap();
    assert_eq(`${v}`.to_string(), "{\"a\":{\"x\":\"y\"},\"b\":[1,-2,3.5,true,null]}");
    assert_eq(v.get("b").unwrap().as_array().unwrap()[1].as_i64().unwrap(), -2);
    assert_eq(v.get("a").unwrap().get("x").unwrap().as_str().unwrap(), "y");
}

fn vec_u8() -> Vec<u8> { let mut v = Vec::new(); v.push(1); v }

fn vec_of() -> Vec<String> {
    let mut v = Vec::new();
    v.push(String::from("x"));
    v.push(String::from("y"));
    v
}

fn shapes() -> Vec<Shape> {
    let mut v = Vec::new();
    v.push(Shape::Circle(1.5));
    v.push(Shape::Rect { w: 2, h: 3 });
    v.push(Shape::Line(Point { x: 0, y: 0.0 }, Point { x: 1, y: 1.0 }));
    v.push(Shape::Empty);
    v
}

// serde's enum representations (serde_json's output).
#[derive(Serialize, Deserialize, Debug, PartialEq)]
struct Inner {
    id: u32,
}

#[derive(Serialize, Deserialize, Debug, PartialEq)]
#[serde(tag = "type")]
enum Internal {
    Ping,
    Move { x: i32, y: i32 },
    Wrap(Inner),
}

#[derive(Serialize, Deserialize, Debug, PartialEq)]
#[serde(tag = "t", content = "c")]
enum Adjacent {
    A,
    B(i32),
    C(i32, String),
    D { x: bool },
}

#[derive(Serialize, Deserialize, Debug, PartialEq)]
#[serde(untagged)]
enum Untagged {
    Num(i64),
    Text(String),
    Pair(i32, i32),
    Obj { a: i32 },
    Nothing,
}

fn round<T: Serialize + Deserialize + std::fmt::Debug + PartialEq>(x: T, want: &str) {
    let s = json::to_string(&x).unwrap();
    assert_eq(s.as_str(), want);
    let back: T = json::from_str(s.as_str()).unwrap();
    assert_eq(back, x);
}

#[test]
fn internally_tagged() {
    round(Internal::Ping, "{\"type\":\"Ping\"}");
    round(Internal::Move { x: 1, y: 2 }, "{\"type\":\"Move\",\"x\":1,\"y\":2}");
    round(Internal::Wrap(Inner { id: 7 }), "{\"type\":\"Wrap\",\"id\":7}");
    // The tag anywhere in the object.
    let m: Internal = json::from_str("{\"x\": 3, \"type\": \"Move\", \"y\": 4}").unwrap();
    assert_eq(m, Internal::Move { x: 3, y: 4 });
    match json::from_str::<Internal>("{\"type\": \"Fly\"}") {
        Ok(_) => panic("parsed"),
        Err(e) => assert(`${e}`.to_string().contains("unknown variant `Fly`")),
    }
    match json::from_str::<Internal>("{\"x\": 1}") {
        Ok(_) => panic("parsed"),
        Err(e) => assert(`${e}`.to_string().contains("missing field `type`")),
    }
}

#[test]
fn adjacently_tagged() {
    round(Adjacent::A, "{\"t\":\"A\"}");
    round(Adjacent::B(5), "{\"t\":\"B\",\"c\":5}");
    round(Adjacent::C(1, "s".to_string()), "{\"t\":\"C\",\"c\":[1,\"s\"]}");
    round(Adjacent::D { x: true }, "{\"t\":\"D\",\"c\":{\"x\":true}}");
    // The content before the tag.
    let b: Adjacent = json::from_str("{\"c\": 9, \"t\": \"B\"}").unwrap();
    assert_eq(b, Adjacent::B(9));
}

#[test]
fn untagged() {
    round(Untagged::Num(3), "3");
    round(Untagged::Text("x".to_string()), "\"x\"");
    round(Untagged::Pair(1, 2), "[1,2]");
    round(Untagged::Obj { a: 1 }, "{\"a\":1}");
    round(Untagged::Nothing, "null");
    match json::from_str::<Untagged>("true") {
        Ok(_) => panic("parsed"),
        Err(e) => assert(`${e}`.to_string().contains("data did not match any variant of untagged enum Untagged")),
    }
}
