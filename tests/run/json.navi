// std::json through reflection (encoding, decoding, round trip, errors).
use std::json;
use std::collections::HashMap;

#[derive(Debug)]
struct Point { x: i32, y: f64 }

#[derive(Debug)]
enum Shape { Circle(f64), Rect { w: i32, h: i32 }, Line(Point, Point), Empty }

#[derive(Debug)]
struct Meters(f64);

#[derive(Debug)]
struct Doc {
    title: String,
    tags: Vec<String>,
    origin: Point,
    shapes: Vec<Shape>,
    scale: Option<f64>,
    parent: Option<&Point>,
    ok: bool,
    c: char,
    pair: (u8, i64),
    grid: [i16; 3],
    m: HashMap<String, i32>,
    ids: HashMap<u32, String>,
    len: Meters,
    note: &str,
}

fn doc() -> Doc {
    let mut m = HashMap::new();
    m.insert(String::from("b"), 2);
    m.insert(String::from("a"), 1);
    let mut ids = HashMap::new();
    ids.insert(7u32, String::from("seven"));
    Doc {
        title: String::from("q\"uote\n"), tags: vec_of(), origin: Point { x: -3, y: 0.5 },
        shapes: shapes(), scale: None, parent: Some(&Point { x: 9, y: 9.0 }), ok: true, c: 'é',
        pair: (255, -1), grid: [1, -2, 3], m, ids, len: Meters(2.5), note: "hi",
    }
}

#[test]
fn encode_decode_roundtrip() {
    let d = doc();
    let s = json::to_string(&d).unwrap();
    assert_eq(s.as_str(), "{\"title\":\"q\\\"uote\\n\",\"tags\":[\"x\",\"y\"],\"origin\":{\"x\":-3,\"y\":0.5},\"shapes\":[{\"Circle\":1.5},{\"Rect\":{\"w\":2,\"h\":3}},{\"Line\":[{\"x\":0,\"y\":0},{\"x\":1,\"y\":1}]},\"Empty\"],\"scale\":null,\"parent\":{\"x\":9,\"y\":9},\"ok\":true,\"c\":\"é\",\"pair\":[255,-1],\"grid\":[1,-2,3],\"m\":{\"a\":1,\"b\":2},\"ids\":{\"7\":\"seven\"},\"len\":2.5,\"note\":\"hi\"}");
    let back: Doc = json::from_str(s.as_str()).unwrap();
    assert_eq(`${back.title:?} ${back.shapes:?} ${back.parent:?} ${back.grid:?} ${back.len:?}`.to_string().as_str(), "\"q\\\"uote\\n\" [Circle(1.5), Rect { w: 2, h: 3 }, Line(Point { x: 0, y: 0.0 }, Point { x: 1, y: 1.0 }), Empty] Some(Point { x: 9, y: 9.0 }) [1, -2, 3] Meters(2.5)");
    let s2 = json::to_string(&back).unwrap();
    assert(s == s2);
}

#[test]
fn pretty() {
    assert_eq(json::to_string_pretty(&Point { x: 1, y: 2.0 }).unwrap().as_str(), "{\n  \"x\": 1,\n  \"y\": 2\n}");
}

#[test]
fn decode_skips_unknown_fields() {
    let p: Point = json::from_str(" { \"y\": 1e2, \"extra\": [1, {\"z\": null}], \"x\": 5 } ").unwrap();
    assert_eq(`${p:?}`.to_string().as_str(), "Point { x: 5, y: 100.0 }");
}

#[test]
fn errors() {
    match json::from_str::<Point>("{\"x\": 99999999999}") { Ok(_) => panic("expected an error"), Err(e) => assert_eq(`error: ${e}`.to_string().as_str(), "error: json: 99999999999 out of range for i32 at offset 17") }
    match json::from_str::<Vec<i32>>("[1, 2") { Ok(_) => panic("expected an error"), Err(e) => assert_eq(`error: ${e}`.to_string().as_str(), "error: json: expected ']' at offset 5") }
}

#[test]
fn unicode_escapes() {
    let v: Vec<Option<String>> = json::from_str("[\"a\\u00e9\\ud83d\\ude00\", null]").unwrap();
    assert_eq(`${v:?}`.to_string().as_str(), "[Some(\"aé😀\"), None]");
}

fn vec_of() -> Vec<String> {
    let mut v = Vec::new();
    v.push(String::from("x"));
    v.push(String::from("y"));
    v
}

fn shapes() -> Vec<Shape> {
    let mut v = Vec::new();
    v.push(Shape::Circle(1.5));
    v.push(Shape::Rect { w: 2, h: 3 });
    v.push(Shape::Line(Point { x: 0, y: 0.0 }, Point { x: 1, y: 1.0 }));
    v.push(Shape::Empty);
    v
}
