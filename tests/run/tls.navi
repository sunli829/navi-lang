// std::tls against RFC 8448's "Simple 1-RTT Handshake" (section 3): with
// the trace's ClientHello and X25519 key, the client must accept the
// server's records and write exactly the trace's records (its Finished,
// application data and close_notify), and read the server's data. The
// certificate is the trace's own (not verified).

use std::io::{Read, Write};
use std::hex;
use std::tls::TlsConnector;

fn h(parts: &[&str]) -> Vec<u8> { hex::decode(parts.concat()).unwrap() }

// A stream that reads from given bytes and keeps what is written.
struct Pipe {
    input: Vec<u8>,
    at: usize,
    output: Vec<u8>,
}

impl Read for Pipe {
    fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
        // (Few bytes at a time: records arrive in pieces.)
        let n = std::cmp::min(std::cmp::min(buf.len(), 7), self.input.len() - self.at);
        buf[..n].copy_from_slice(&self.input[self.at..self.at + n]);
        self.at += n;
        Ok(n)
    }
}

impl Write for Pipe {
    fn write(&mut self, buf: &[u8]) -> std::io::Result<usize> {
        self.output.extend_from_slice(buf);
        Ok(buf.len())
    }

    fn flush(&mut self) -> std::io::Result<()> { Ok(()) }
}

#[test]
fn rfc8448_simple_1rtt() {
    let hello = h(&CLIENT_HELLO_RECORD)[5..].to_vec();
    let mut input = h(&SERVER_HELLO_RECORD);
    input.extend_from_slice(h(&SERVER_HANDSHAKE_RECORD).as_slice());
    input.extend_from_slice(h(&SERVER_TICKET_RECORD).as_slice());
    input.extend_from_slice(h(&SERVER_DATA_RECORD).as_slice());
    input.extend_from_slice(h(&SERVER_ALERT_RECORD).as_slice());
    let pipe = Pipe { input, at: 0, output: Vec::new() };
    let c = TlsConnector::builder().danger_accept_invalid_certs(true).test_client_hello(hello, h(&CLIENT_PRIVATE)).build().unwrap();
    let mut tls = c.connect("server", pipe).unwrap();
    let mut want = h(&CLIENT_HELLO_RECORD);
    want.extend_from_slice(h(&CLIENT_FINISHED_RECORD).as_slice());
    assert(tls.get_ref().output == want);
    assert_eq(tls.peer_certificates().len(), 1);
    // The client's data: 50 bytes 00..31.
    let mut data: Vec<u8> = Vec::new();
    let mut i = 0u8;
    while i < 50 {
        data.push(i);
        i += 1;
    }
    tls.write_all(data.as_slice()).unwrap();
    want.extend_from_slice(h(&CLIENT_DATA_RECORD).as_slice());
    assert(tls.get_ref().output == want);
    // The server's (after its NewSessionTicket), the same bytes.
    let mut got = [0u8; 50];
    tls.read_exact(&mut got).unwrap();
    assert(got.to_vec() == data);
    tls.shutdown().unwrap();
    want.extend_from_slice(h(&CLIENT_ALERT_RECORD).as_slice());
    assert(tls.get_ref().output == want);
    // The server's close_notify: the end.
    let mut rest: Vec<u8> = Vec::new();
    assert_eq(tls.read_to_end(&mut rest).unwrap(), 0);
}

#[test]
fn tampered_records_fail() {
    let hello = h(&CLIENT_HELLO_RECORD)[5..].to_vec();
    // A flipped bit in the server's encrypted handshake.
    let mut bad = h(&SERVER_HANDSHAKE_RECORD);
    bad[100] = bad[100] ^ 1;
    let mut input = h(&SERVER_HELLO_RECORD);
    input.extend_from_slice(bad.as_slice());
    let pipe = Pipe { input, at: 0, output: Vec::new() };
    let c = TlsConnector::builder().danger_accept_invalid_certs(true).test_client_hello(hello.clone(), h(&CLIENT_PRIVATE)).build().unwrap();
    match c.connect("server", pipe) {
        Ok(_) => panic("accepted a bad record"),
        Err(e) => assert_eq(e.to_string(), "tls: bad record MAC".to_string()),
    }
    // Another X25519 key: another secret, the record does not decrypt.
    let mut key = h(&CLIENT_PRIVATE);
    key[0] = key[0] ^ 8;
    let mut input2 = h(&SERVER_HELLO_RECORD);
    input2.extend_from_slice(h(&SERVER_HANDSHAKE_RECORD).as_slice());
    let pipe2 = Pipe { input: input2, at: 0, output: Vec::new() };
    let c2 = TlsConnector::builder().danger_accept_invalid_certs(true).test_client_hello(hello, key).build().unwrap();
    assert(c2.connect("server", pipe2).is_err());
    // The trace's certificate (self-signed) is not trusted by default.
    let pipe3 = Pipe { input: { let mut v = h(&SERVER_HELLO_RECORD); v.extend_from_slice(h(&SERVER_HANDSHAKE_RECORD).as_slice()); v }, at: 0, output: Vec::new() };
    let c3 = TlsConnector::builder().disable_built_in_roots(true).test_client_hello(h(&CLIENT_HELLO_RECORD)[5..].to_vec(), h(&CLIENT_PRIVATE)).build().unwrap();
    match c3.connect("server", pipe3) {
        Ok(_) => panic("accepted an untrusted certificate"),
        Err(e) => assert(e.certificate_error().is_some()),
    }
}

