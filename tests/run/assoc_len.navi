// stage0: skip (associated constants as array lengths need navic)
// out: 4 6 6 [0, 0, 0, 0, 0, 0] 3
// out: [2, 2, 2]
// T::N and Self::N as array lengths: generic until T is known, then the impl's value.
trait HasN { const N: usize; fn make() -> Self; }
struct A;
struct B;
impl HasN for A { const N: usize = 4; fn make() -> A { A } }
impl HasN for B { const N: usize = 2 * 3; fn make() -> B { B } }
fn build<T: HasN>() -> (T, usize) { let arr = [7u8; T::N]; (T::make(), arr.len()) }
fn zeros<T: HasN>() -> [u32; T::N] { [0u32; T::N] }
trait Buf { const LEN: usize; fn fill(&self) -> [u8; Self::LEN]; }
impl Buf for A { const LEN: usize = 3; fn fill(&self) -> [u8; 3] { [1u8; 3] } }
fn sum<T: Buf>(t: &T) -> u32 { let mut s = 0u32; for x in t.fill().iter() { s += *x as u32; } s }
struct C;
impl Buf for C { const LEN: usize = 3; fn fill(&self) -> [u8; Self::LEN] { [2u8; Self::LEN] } }
fn main() {
    let (_, n) = build::<A>();
    let (_, m) = build::<B>();
    let z = zeros::<B>();
    println(`${n} ${m} ${z.len()} ${z:?} ${sum(&A)}`);
    println(`${C.fill():?}`);
}
