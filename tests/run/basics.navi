// Functions, recursion, integer and float formatting, loops.
fn add(a: i32, b: i32) -> i32 { a + b }
fn fib(n: u64) -> u64 { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }

#[test]
fn calls_and_recursion() {
    assert_eq(add(1, 2), 3);
    assert_eq(fib(20), 6765);
}

#[test]
fn formatting() {
    let x: i64 = -7;
    assert_eq(`${x} ${x < 0} ${x == 0}`.to_string(), "-7 true false");
    let f = 5.0 / 2.0;
    assert_eq(`${f} ${1.0} ${0.1}`.to_string(), "2.5 1 0.1");
}

#[test]
fn loops() {
    let mut i = 0;
    while i < 10 { i += 1; }
    assert_eq(i, 10);
}
