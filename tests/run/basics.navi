// out: 3
// out: -7 true false
// out: 6765
// out: 2.5 1 0.1
// out: done
fn add(a: i32, b: i32) -> i32 { a + b }
fn fib(n: u64) -> u64 { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }

fn main() {
    println(add(1, 2));
    let x: i64 = -7;
    println(`${x} ${x < 0} ${x == 0}`);
    println(fib(20));
    let f = 5.0 / 2.0;
    println(`${f} ${1.0} ${0.1}`);
    let mut i = 0;
    while i < 10 { i += 1; }
    if i == 10 { println("done"); }
}
