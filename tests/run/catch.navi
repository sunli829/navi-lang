// panic::catch_unwind: deferred calls run while unwinding, the payload's
// message and location, runtime panics (index out of bounds), nested
// catches, panics in threads seen by join, and many catches in a loop.
use std::panic;
use std::thread;

fn risky(n: i32, log: &mut Vec<String>) -> i32 {
    defer log.push(String::from("cleanup"));
    if n > 2 { panic(`too big: ${n}`); }
    n * 10
}

#[test]
fn defer_runs_on_return_and_on_panic() {
    let mut log: Vec<String> = Vec::new();
    let ok = panic::catch_unwind(|| risky(1, &mut log));
    assert_eq(log, Vec::from([String::from("cleanup")]));
    assert_eq(ok.unwrap(), 10);
    let r = panic::catch_unwind(|| risky(5, &mut log));
    assert_eq(log, Vec::from([String::from("cleanup"), String::from("cleanup")]));
    match r {
        Ok(_) => panic("not reached"),
        Err(p) => {
            assert_eq(`${p.message()}`.as_str(), "too big: 5");
            assert_eq(p.location().line(), 9);
        }
    }
}

#[test]
fn runtime_panic_is_caught() {
    let v: Vec<i32> = Vec::new();
    let r2 = panic::catch_unwind(|| v[3]);
    match r2 {
        Ok(_) => panic("not reached"),
        Err(p) => assert_eq(`${p}`.as_str(), "index out of bounds: the len is 0 but the index is 3"),
    }
}

#[test]
fn nested_catch_unwind() {
    let mut inner_err = false;
    let r3 = panic::catch_unwind(|| -> () {
        let inner = panic::catch_unwind(|| -> i32 { panic("inner") });
        inner_err = inner.is_err();
        panic("outer");
    });
    assert(inner_err);
    assert(r3.is_err());
}

#[test]
fn thread_panic_seen_by_join() {
    let h = thread::spawn(|| -> i32 { panic("in thread") });
    match h.join() {
        Ok(_) => panic("not reached"),
        Err(p) => assert_eq(`${p}`.as_str(), "in thread"),
    }
    let h2 = thread::spawn(|| 42);
    assert_eq(h2.join().unwrap(), 42);
}

#[test]
fn many_catches_in_a_loop() {
    let mut total = 0;
    let mut i = 0;
    while i < 30 {
        let r = panic::catch_unwind(|| { if i % 3 == 0 { panic("x"); } i });
        if let Ok(x) = r { total += x; }
        i += 1;
    }
    assert_eq(total, 300);
}
