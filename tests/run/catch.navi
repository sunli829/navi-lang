// out: cleanup
// out: ok: 10
// out: cleanup
// out: caught: too big: 5 (line 17)
// out: caught: index out of bounds: the len is 0 but the index is 3
// out: inner err: true
// out: outer err: true
// out: thread panicked: in thread
// out: thread ok: 42
// out: total 300
// out: done
use std::panic;
use std::thread;

fn risky(n: i32) -> i32 {
    defer println("cleanup");
    if n > 2 { panic(`too big: ${n}`); }
    n * 10
}

fn main() {
    let ok = panic::catch_unwind(|| risky(1));
    println(`ok: ${ok.unwrap()}`);
    let r = panic::catch_unwind(|| risky(5));
    match r {
        Ok(_) => println("not reached"),
        Err(p) => println(`caught: ${p.message()} (line ${p.location().line()})`),
    }
    let v: Vec<i32> = Vec::new();
    let r2 = panic::catch_unwind(|| v[3]);
    if let Err(p) = r2 { println(`caught: ${p}`); }
    let r3 = panic::catch_unwind(|| -> () {
        let inner = panic::catch_unwind(|| -> i32 { panic("inner") });
        println(`inner err: ${inner.is_err()}`);
        panic("outer");
    });
    println(`outer err: ${r3.is_err()}`);
    let h = thread::spawn(|| -> i32 { panic("in thread") });
    match h.join() {
        Ok(_) => println("not reached"),
        Err(p) => println(`thread panicked: ${p}`),
    }
    let h2 = thread::spawn(|| 42);
    println(`thread ok: ${h2.join().unwrap()}`);
    let mut total = 0;
    let mut i = 0;
    while i < 30 {
        let r = panic::catch_unwind(|| { if i % 3 == 0 { panic("x"); } i });
        if let Ok(x) = r { total += x; }
        i += 1;
    }
    println(`total ${total}`);
    println("done");
}
