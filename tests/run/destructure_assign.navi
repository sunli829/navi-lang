// stage0: skip
// Destructuring assignment (as Rust): the places are assigned after the
// right-hand side is evaluated, left to right.
// out: swap 2 1
// out: struct 7 8
// out: rest 80
// out: tuple struct 9
// out: array 5 8
// out: tuple rest 100
// out: places 11 22 3
// out: deref 5 6
// out: order 1 0 1
// out: slice 3
struct P { x: i32, y: i32 }
struct W(i32, i32);
struct Q { p: P, v: Vec<i32> }
fn pair() -> (i32, i32) { (3, 4) }
fn main() {
    let (mut a, mut b) = (1, 2);
    (a, b) = (b, a);
    println(`swap ${a} ${b}`);
    let mut x = 0; let mut y = 0;
    P { x, y } = P { x: 7, y: 8 };
    println(`struct ${x} ${y}`);
    P { y: a, .. } = P { x: 70, y: 80 };
    println(`rest ${a}`);
    W(x, _) = W(9, 10);
    println(`tuple struct ${x}`);
    let mut c = 0; let mut d = 0;
    [c, .., d] = [5, 6, 7, 8];
    println(`array ${c} ${d}`);
    (a, ..) = (100, 200, 300);
    println(`tuple rest ${a}`);
    let mut q = Q { p: P { x: 0, y: 0 }, v: Vec::new() };
    q.v.push(0); q.v.push(0);
    (q.p.x, q.v[1], (b, _)) = (11, 22, pair());
    println(`places ${q.p.x} ${q.v[1]} ${b}`);
    let mut r = &mut P { x: 0, y: 0 };
    P { x: r.x, y: r.y } = P { x: 5, y: 6 };
    println(`deref ${r.x} ${r.y}`);
    _ = pair();
    let mut i = 0;
    let mut v = Vec::new(); v.push(0); v.push(0);
    (v[i], i) = (1, 1);
    println(`order ${v[0]} ${v[1]} ${i}`);
    let s: &[i32] = &[1, 2, 3];
    let mut f = 0;
    [f, ..] = [s[2], s[1]];
    println(`slice ${f}`);
}
