// Destructuring assignment (as Rust): the places are assigned after the
// right-hand side is evaluated, left to right.
struct P { x: i32, y: i32 }
struct W(i32, i32);
struct Q { p: P, v: Vec<i32> }
fn pair() -> (i32, i32) { (3, 4) }

#[test]
fn tuples_structs_arrays() {
    let (mut a, mut b) = (1, 2);
    (a, b) = (b, a);
    assert_eq((a, b), (2, 1));
    let mut x = 0; let mut y = 0;
    P { x, y } = P { x: 7, y: 8 };
    assert_eq((x, y), (7, 8));
    P { y: a, .. } = P { x: 70, y: 80 };
    assert_eq(a, 80);
    W(x, _) = W(9, 10);
    assert_eq(x, 9);
    let mut c = 0; let mut d = 0;
    [c, .., d] = [5, 6, 7, 8];
    assert_eq((c, d), (5, 8));
    (a, ..) = (100, 200, 300);
    assert_eq(a, 100);
    assert_eq(b, 1);
}

#[test]
fn places() {
    let mut b = 0;
    let mut q = Q { p: P { x: 0, y: 0 }, v: Vec::new() };
    q.v.push(0); q.v.push(0);
    (q.p.x, q.v[1], (b, _)) = (11, 22, pair());
    assert_eq((q.p.x, q.v[1], b), (11, 22, 3));
    let mut r = &mut P { x: 0, y: 0 };
    P { x: r.x, y: r.y } = P { x: 5, y: 6 };
    assert_eq((r.x, r.y), (5, 6));
    _ = pair();
}

#[test]
fn order() {
    let mut i = 0;
    let mut v = Vec::new(); v.push(0); v.push(0);
    (v[i], i) = (1, 1);
    assert_eq((v[0], v[1], i), (1, 0, 1));
    let s: &[i32] = &[1, 2, 3];
    let mut f = 0;
    [f, ..] = [s[2], s[1]];
    assert_eq(f, 3);
}
