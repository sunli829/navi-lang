// Generic functions with bounds, a generic struct and its impl, a generic
// tuple struct with derived traits, dyn trait objects in a slice.
use std::fmt::Debug;

fn largest<T: PartialOrd + Clone>(xs: &[T]) -> T {
    let mut best = xs[0].clone();
    for x in xs { if *x > best { best = x.clone(); } }
    best
}

#[derive(Debug)]
struct Stack<T> { items: Vec<T> }

impl<T: Clone + Debug> Stack<T> {
    fn new() -> Self { Stack { items: Vec::new() } }
    fn push(&mut self, t: T) { self.items.push(t); }
    fn peek(&self) -> Option<T> { self.items.last().cloned() }
}

#[derive(Debug, Clone, PartialEq, PartialOrd)]
struct Pair<A, B>(A, B);

trait Area { fn area(&self) -> f64; }
struct R(f64, f64);
impl Area for R { fn area(&self) -> f64 { self.0 * self.1 } }

fn total(shapes: &[&dyn Area]) -> f64 {
    let mut t = 0.0;
    for s in shapes { t += s.area(); }
    t
}

fn sorted<T: Ord + Clone>(v: &[T]) -> Vec<T> { let mut out = v.to_vec(); out.sort(); out }

#[test]
fn generic_function_with_bounds() {
    assert_eq(largest(&[3, 7, 2]), 7);
    assert_eq(largest(&["a", "hi", "b"]), "hi");
    assert_eq(sorted(&[3, 1, 2]), Vec::from([1, 2, 3]));
}

#[test]
fn generic_struct() {
    let mut s = Stack::new();
    s.push(1);
    s.push(2);
    assert_eq(s.items, Vec::from([1, 2]));
    assert_eq(s.peek(), Some(2));
}

#[test]
fn generic_tuple_struct_derives() {
    let p = Pair(1, "x");
    let q = Pair(2, "y");
    assert_eq(`${p:?} ${q:?}`.as_str(), "Pair(1, \"x\") Pair(2, \"y\")");
    assert(!(p > q));
}

#[test]
fn dyn_trait_objects() {
    let a = R(1.0, 1.5);
    let b = R(2.0, 1.0);
    assert_eq(`${total(&[&a, &b])}`.as_str(), "3.5");
}
