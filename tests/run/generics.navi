// out: 7 hi
// out: Stack [1, 2] peek Some(2)
// out: Pair(1, "x") Pair(2, "y") false
// out: 3.5
// out: [1, 2, 3]
use std::fmt::Debug;

fn largest<T: PartialOrd + Clone>(xs: &[T]) -> T {
    let mut best = xs[0].clone();
    for x in xs { if *x > best { best = x.clone(); } }
    best
}

#[derive(Debug)]
struct Stack<T> { items: Vec<T> }

impl<T: Clone + Debug> Stack<T> {
    fn new() -> Self { Stack { items: Vec::new() } }
    fn push(&mut self, t: T) { self.items.push(t); }
    fn peek(&self) -> Option<T> { self.items.last().cloned() }
}

#[derive(Debug, Clone, PartialEq, PartialOrd)]
struct Pair<A, B>(A, B);

trait Area { fn area(&self) -> f64; }
struct R(f64, f64);
impl Area for R { fn area(&self) -> f64 { self.0 * self.1 } }

fn total(shapes: &[&dyn Area]) -> f64 {
    let mut t = 0.0;
    for s in shapes { t += s.area(); }
    t
}

fn sorted<T: Ord + Clone>(v: &[T]) -> Vec<T> { let mut out = v.to_vec(); out.sort(); out }

fn main() {
    println(`${largest(&[3, 7, 2])} ${largest(&["a", "hi", "b"])}`);
    let mut s = Stack::new();
    s.push(1);
    s.push(2);
    println(`Stack ${s.items:?} peek ${s.peek():?}`);
    let p = Pair(1, "x");
    let q = Pair(2, "y");
    println(`${p:?} ${q:?} ${p > q}`);
    let a = R(1.0, 1.5);
    let b = R(2.0, 1.0);
    println(total(&[&a, &b]));
    println(`${sorted(&[3, 1, 2]):?}`);
}
