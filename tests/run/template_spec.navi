// Format specs with a width before the type letter (08x was lexed as a
// number with an invalid suffix).
#[test]
fn width_before_type_letter() {
    let x = 255u32;
    let y = 15u8;
    let f = 1000.0f64;
    assert_eq(`${x:08x}|${x:>8x}|${x:#010x}|${x:08b}|${y:#o}|${f:>6e}`.to_string(), "000000ff|      ff|0x000000ff|11111111|0o17|   1e3");
    let c = 0x3b71df88u32;
    assert_eq(`crc ${c:08x}`.to_string(), "crc 3b71df88");
}
