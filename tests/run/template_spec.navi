// stage0: skip
// Format specs with a width before the type letter (08x was lexed as a
// number with an invalid suffix).
// out: 000000ff|      ff|0x000000ff|11111111|0o17|   1e3
// out: crc 3b71df88
fn main() {
    let x = 255u32;
    let y = 15u8;
    let f = 1000.0f64;
    println(`${x:08x}|${x:>8x}|${x:#010x}|${x:08b}|${y:#o}|${f:>6e}`);
    let c = 0x3b71df88u32;
    println(`crc ${c:08x}`);
}
