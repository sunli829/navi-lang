// std::derive (docs/derive.md): quote and the TypeInfo helpers a derive
// macro uses, tried on TypeInfo::of.

use std::derive::{TypeInfo, Code, Ident, Binding, FromAttrs, TypeKind, quote};
use std::serde::Serialize;

#[derive(Debug, Serialize)]
#[serde(rename = "p", deny_unknown_fields)]
struct Point<T: Clone> where T: Default {
    pub x: T,
    #[serde(skip)]
    y: Vec<Option<&str>>,
}

enum Shape {
    Circle { r: f64 },
    Square(i32, [u8; 4]),
    Empty,
}

struct Unit;

#[derive(FromAttrs)]
struct Tag {
    rename: String,
    rename_all: Option<String>,
    deny_unknown_fields: bool,
    skip: bool,
}

#[test]
fn quote_text_and_holes() {
    let name = Ident::new("Foo");
    let s = "a\"b";
    let n = 3usize;
    let c = quote`struct ${name}; const N: usize = ${n}; const S: &str = ${s};`;
    assert_eq(c.text(), "struct Foo; const N: usize = 3usize; const S: &str = \"a\\\"b\";");
    // A template whose code has a template string of its own.
    let t = quote`println(\`x = \${x}\`);`;
    assert_eq(t.text(), "println(`x = ${x}`);");
    // Vectors and options of code.
    let mut parts: Vec<Code> = Vec::new();
    parts.push(quote`a();`);
    parts.push(quote`b();`);
    let none: Option<Code> = None;
    assert_eq(quote`{ ${parts} ${none} }`.text(), "{ a(); b(); }");
    let empty = quote`x`;
    assert_eq(empty.text(), "x");
}

#[test]
fn type_info_of_struct() {
    let t = TypeInfo::of::<Point<i32>>();
    assert_eq(t.name().as_str(), "Point");
    assert(!t.is_enum());
    assert_eq(t.generics().params.len(), 1);
    assert_eq(t.generics().params[0].bounds.as_str(), "Clone");
    assert_eq(t.generics().where_clause.as_str(), "T: Default");
    let fs = t.fields();
    assert_eq(fs.len(), 2);
    assert_eq(fs[0].ident().as_str(), "x");
    assert_eq(fs[0].vis(), "pub");
    assert_eq(fs[1].ty().text(), "Vec<Option<&str>>");
    assert_eq(fs[1].ty().last_name(), Some("Vec"));
    let inner = fs[1].ty().args();
    assert_eq(inner.len(), 1);
    assert(inner[0].is("Option"));
    assert(fs[1].has_attr("serde"));
    let tag: Tag = t.parse_attrs::<Tag>("serde").unwrap();
    assert_eq(tag.rename.as_str(), "p");
    assert_eq(tag.rename_all, None);
    assert(tag.deny_unknown_fields);
    assert(!tag.skip);
    assert_eq(t.self_type().text(), "Point<T>");
    let im = t.impl_for("my::Tr", quote`fn f() {}`);
    assert_eq(im.text(), "impl<T: Clone + my::Tr> my::Tr for Point<T> where T: Default { fn f() {} }");
}

#[test]
fn type_info_of_enum() {
    let t = TypeInfo::of::<Shape>();
    assert(t.is_enum());
    let vs = t.variants();
    assert_eq(vs.len(), 3);
    assert_eq(vs[1].fields().len(), 2);
    match vs[1].fields()[1].ty().kind() {
        TypeKind::Array(e, n) => {
            assert_eq(e.text(), "u8");
            assert_eq(n.as_str(), "4");
        }
        _ => panic("not an array"),
    }
    assert_eq(vs[0].pattern().text(), "Shape::Circle { r: __binding_0 }");
    assert_eq(vs[1].pattern().text(), "Shape::Square(__binding_0, __binding_1)");
    assert_eq(vs[2].pattern().text(), "Shape::Empty");
    let e = t.each(|b: &Binding| quote`f(${b});`);
    assert_eq(e.text(), "match *self { Shape::Circle { r: __binding_0 } => { f(__binding_0); } Shape::Square(__binding_0, __binding_1) => { f(__binding_0); f(__binding_1); } Shape::Empty => { } }");
    let c = t.each_construct(|b: &Binding| quote`${b}.clone()`);
    assert_eq(c.text(), "match *self { Shape::Circle { r: __binding_0 } => Shape::Circle { r: __binding_0.clone() }, Shape::Square(__binding_0, __binding_1) => Shape::Square(__binding_0.clone(), __binding_1.clone()), Shape::Empty => Shape::Empty, }");
    let u = TypeInfo::of::<Unit>();
    let p = u.each_pair(quote`other`, |a: &Binding, b: &Binding| quote`${a} == ${b}`, quote`false`);
    assert_eq(p.text(), "match *self { Unit => match *(other) { Unit => { } }, }");
}

#[test]
fn attr_errors() {
    let t = TypeInfo::of::<Point<i32>>();
    let fs = t.fields();
    // #[serde(skip)]: no rename.
    match fs[1].parse_attrs::<Tag>("serde") {
        Ok(_) => panic("parsed"),
        Err(e) => assert_eq(e.msg.as_str(), "#[serde] needs rename = ..."),
    }
}
