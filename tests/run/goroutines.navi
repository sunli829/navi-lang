// Many green threads, a producer-consumer pipeline over bounded channels,
// and collections while threads hold objects on their stacks.
use std::thread;
use std::sync::mpmc::{channel, sync_channel};

#[test]
fn many_threads_each_send_one_value() {
    let (tx, rx) = channel::<i64>();
    let mut i: i64 = 0;
    while i < 20000 {
        let t = tx.clone();
        let n = i;
        thread::spawn(|| { t.send(n).unwrap(); });
        i += 1;
    }
    let mut sum: i64 = 0;
    let mut got = 0;
    while got < 20000 {
        sum += rx.recv().unwrap();
        got += 1;
    }
    assert_eq(got, 20000);
    assert_eq(sum, 199990000);
}

#[test]
fn pipeline_over_bounded_channels() {
    // A three-stage pipeline over small bounded channels.
    let (a_tx, a_rx) = sync_channel::<i64>(4);
    let (b_tx, b_rx) = sync_channel::<i64>(0);
    thread::spawn(|| {
        let mut k: i64 = 1;
        while k <= 1000000 { a_tx.send(k).unwrap(); k += 1; }
        a_tx.close();
    });
    thread::spawn(|| {
        for v in a_rx.iter() { b_tx.send(v).unwrap(); }
        b_tx.close();
    });
    let mut total: i64 = 0;
    for v in b_rx.iter() { total += v; }
    assert_eq(total, 500000500000);
}

#[test]
fn gc_across_threads() {
    // Threads keep strings alive on their stacks while others allocate.
    let (r_tx, r_rx) = channel::<bool>();
    let mut w = 0;
    while w < 50 {
        let t = r_tx.clone();
        let id = w;
        thread::spawn(|| {
            let mine = `thread ${id} keeps this string`.to_string();
            let mut j = 0;
            while j < 2000 {
                let junk = `garbage ${j} ${id}`.to_string();
                if junk.len() == 0 { panic("impossible"); }
                if j % 100 == 0 { thread::yield_now(); }
                j += 1;
            }
            t.send(mine == `thread ${id} keeps this string`.to_string()).unwrap();
        });
        w += 1;
    }
    let mut ok = true;
    let mut k = 0;
    while k < 50 { if !r_rx.recv().unwrap() { ok = false; } k += 1; }
    assert(ok);
}
