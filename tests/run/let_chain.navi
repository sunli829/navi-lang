// Let chains (Rust 2024): lets and conditions joined by && in if and while.
fn get(i: i32) -> Option<i32> { if i > 0 { Some(i * 10) } else { None } }

#[test]
fn if_let_chains() {
    let o = Some(2);
    let mut r = 0;
    if let Some(x) = o && x > 1 { r = x; }
    assert_eq(r, 2);
    let s = if let Some(x) = o && x > 5 { "no" } else { "else" };
    assert_eq(s, "else");
    let mut three = (0, 0);
    if o.is_some() && let Some(x) = o && let Some(y) = get(x) && y == 20 { three = (x, y); }
    assert_eq(three, (2, 20));
}

#[test]
fn plain_or_and_precedence() {
    let a = true;
    let b = false;
    let mut hit = false;
    if a || b && false { hit = true; }
    assert(hit);
}

#[test]
fn while_let_chain() {
    let mut n = 3;
    let mut sum = 0;
    while let Some(v) = get(n) && v > 10 {
        sum += v;
        n -= 1;
    }
    assert_eq((sum, n), (50, 1));
}
