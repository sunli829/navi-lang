// stage0: skip (let chains are navic's)
// out: chain 2
// out: else
// out: three 2 20
// out: plain or
// out: while 50 1
// Let chains (Rust 2024): lets and conditions joined by && in if and while.
fn get(i: i32) -> Option<i32> { if i > 0 { Some(i * 10) } else { None } }

fn main() {
    let o = Some(2);
    if let Some(x) = o && x > 1 { println(`chain ${x}`); }
    if let Some(x) = o && x > 5 { println("no"); } else { println("else"); }
    if o.is_some() && let Some(x) = o && let Some(y) = get(x) && y == 20 { println(`three ${x} ${y}`); }
    let a = true;
    let b = false;
    if a || b && false { println("plain or"); }
    let mut n = 3;
    let mut sum = 0;
    while let Some(v) = get(n) && v > 10 {
        sum += v;
        n -= 1;
    }
    println(`while ${sum} ${n}`);
}
