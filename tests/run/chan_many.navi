// interp: skip (the interpreter wakes every waiter)
// out: 159900
// 10000 threads wait on one unbuffered channel: each element wakes one
// receiver (not all of them).
use std::thread;
use std::sync::mpmc::{channel, sync_channel};

fn rec(d: u64) -> u64 { if d == 0 { 0 } else { rec(d - 1) + 1 } }

fn main() {
    let n = 10000u64;
    let (start_tx, start_rx) = sync_channel::<u64>(0);
    let (done_tx, done_rx) = channel::<u64>();
    let mut i = 0u64;
    while i < n {
        let rx = start_rx.clone();
        let tx = done_tx.clone();
        let id = i;
        thread::spawn(|| {
            let v = rx.recv().unwrap();
            // Some of them recurse deep enough to grow.
            let d = if id % 1000 == 0 { 5000 } else { 10 };
            tx.send(v + rec(d)).unwrap();
        });
        i += 1;
    }
    i = 0;
    while i < n { start_tx.send(1).unwrap(); i += 1; }
    let mut sum = 0u64;
    i = 0;
    while i < n { sum += done_rx.recv().unwrap(); i += 1; }
    println(`${sum}`);
}
