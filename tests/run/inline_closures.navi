// Closures inlined where they are called (crate::mir::devirt) and values
// left in the frame by escape analysis keep their meaning.

struct Holder {
    f: fn(i64) -> i64,
}

#[test]
fn captured_values_are_read_when_called() {
    let v: Vec<i64> = (0..20).collect();
    let mut limit = 10;
    let n = v.iter().filter(|x: &&i64| -> bool { **x < limit }).count();
    assert_eq(n, 10);
    limit = 5;
    let m = v.iter().filter(|x: &&i64| -> bool { **x < limit }).count();
    assert_eq(m, 5);
    let mut calls = 0;
    let s: i64 = v
        .iter()
        .map(|x: &i64| -> i64 {
            calls += 1;
            *x * 2
        })
        .sum();
    assert_eq(s, 380);
    assert_eq(calls, 20);
}

#[test]
fn a_reassigned_closure_is_called_as_it_is() {
    let mut h = Holder {
        f: |x: i64| -> i64 { x + 1 },
    };
    assert_eq((h.f)(1), 2);
    h.f = |x: i64| -> i64 { x * 10 };
    assert_eq((h.f)(1), 10);
    let mut g = |x: i64| -> i64 { x - 1 };
    let mut i = 0;
    while i < 3 {
        if i == 1 {
            g = |x: i64| -> i64 { x * x };
        }
        i += 1;
    }
    assert_eq(g(4), 16);
}

#[test]
fn closures_made_in_a_loop_keep_their_iteration() {
    let mut fs: Vec<fn() -> i64> = Vec::new();
    let mut i = 0;
    while i < 4 {
        let y = i * 10;
        fs.push(|| y);
        i += 1;
    }
    let mut last = || 0;
    for k in 0..3 {
        let z = k + 100;
        last = || z;
    }
    assert_eq(
        fs.iter()
            .map(|f: &fn() -> i64| -> i64 { (*f)() })
            .sum::<i64>(),
        60,
    );
    assert_eq(last(), 102);
}

#[test]
fn addresses_kept_across_iterations_stay_apart() {
    let mut keep: Vec<&i64> = Vec::new();
    let mut i = 0;
    while i < 5 {
        let x = i * 3;
        let r = &x;
        keep.push(r);
        i += 1;
    }
    let mut s = 0;
    for r in keep.iter() {
        s += **r;
    }
    assert_eq(s, 30);
    let mut p: &i64 = &0;
    let mut j = 0;
    while j < 3 {
        let y = j + 7;
        if j == 0 {
            p = &y;
        }
        j += 1;
    }
    assert_eq(*p, 7);
}
