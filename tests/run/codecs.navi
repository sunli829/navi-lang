use std::base64::prelude::*;
use std::base64::Engine;
use std::base64::engine::general_purpose::{STANDARD, STANDARD_NO_PAD, URL_SAFE, URL_SAFE_NO_PAD};
use std::crypto::Digest;
use std::crypto::md5::Md5;
use std::crypto::sha1::Sha1;
use std::crypto::sha2::{Sha224, Sha256, Sha384, Sha512};
use std::crypto::hmac::{Hmac, Mac};
use std::hash::{crc32, adler32};

fn main() {
    for s in ["", "f", "fo", "foo", "foob", "fooba", "foobar"].iter() {
        println(`${STANDARD.encode(*s)} ${STANDARD_NO_PAD.encode(*s)}`);
    }
    let bin: Vec<u8> = (0..=255u8).collect();
    println(URL_SAFE.encode(&bin));
    println(URL_SAFE_NO_PAD.encode(&[0xfbu8, 0xff, 0xfe]));
    println(`${String::from_utf8(BASE64_STANDARD.decode("Zm9vYmFy").unwrap()).unwrap()} ${STANDARD.decode("Zm9vYg").is_err()} ${STANDARD.decode("Zm9v!mFy"):?}`);
    println(`${std::hex::encode("hello")} ${std::hex::encode_upper(&[0xdeu8, 0xad])} ${std::hex::decode("48656c6c6f"):?} ${std::hex::decode("zz"):?}`);
    let mut million = Vec::new();
    million.resize(1000000, b'a');
    for data in [b"".to_vec(), b"abc".to_vec(), b"abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".to_vec(), million].iter() {
        println(`${std::hex::encode(Md5::digest(data))} ${std::hex::encode(Sha1::digest(data))}`);
        println(`${std::hex::encode(Sha224::digest(data))} ${std::hex::encode(Sha256::digest(data))}`);
        println(`${std::hex::encode(Sha384::digest(data))}`);
        println(`${std::hex::encode(Sha512::digest(data))}`);
    }
    let mut h = Sha256::new();
    h.update("ab");
    h.update("c");
    println(std::hex::encode(h.finalize()));
    let mut m = Hmac::<Sha256>::new_from_slice(b"key").unwrap();
    m.update(b"The quick brown fox jumps over the lazy dog");
    println(std::hex::encode(m.finalize()));
    let m2 = Hmac::<Sha512>::new_from_slice(&[0xaau8; 131]).unwrap().chain_update(b"Test Using Larger Than Block-Size Key - Hash Key First");
    println(std::hex::encode(m2.finalize()));
    println(`${crc32::hash(b"123456789"):08x} ${adler32::hash(b"Wikipedia"):08x} ${crc32::hash(million_ref()):08x}`);
}

fn million_ref() -> &[u8] {
    let mut v = Vec::new();
    v.resize(100000, 7u8);
    v.as_slice()
}
