// x.clone() on x: &T or &mut T clones the T, as in Rust.
// out: 1 [1, 2] 5 [1, 2, 3] 1 [1, 2]
#[derive(Clone, Debug)]
struct P { v: Vec<i32>, n: i32 }

fn main() {
    let mut a = P { v: Vec::from([1, 2]), n: 1 };
    let r: &mut P = &mut a;
    let mut c = r.clone();
    c.n = 5;
    c.v.push(3);
    let s: &P = &a;
    let d: P = s.clone();
    let o: Option<&mut P> = Some(&mut a);
    let oc: Option<P> = o.cloned();
    println(`${a.n} ${a.v:?} ${c.n} ${c.v:?} ${oc.unwrap().n} ${d.v:?}`);
}
