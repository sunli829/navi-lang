// stage0: skip
// x.clone() on x: &mut T clones the T (as Rust, where &mut T is not
// Clone); for a T without Clone it copies the reference.
// out: 1 [1, 2] 5 [1, 2, 3] 8 1
#[derive(Clone, Debug)]
struct P { v: Vec<i32>, n: i32 }

struct NoClone { n: i32 }

fn main() {
    let mut a = P { v: Vec::from([1, 2]), n: 1 };
    let r: &mut P = &mut a;
    let mut c = r.clone();
    c.n = 5;
    c.v.push(3);
    let rr = &mut NoClone { n: 7 };
    let same = rr.clone();
    same.n = 8;
    let o: Option<&mut P> = Some(&mut a);
    let oc: Option<P> = o.cloned();
    println(`${a.n} ${a.v:?} ${c.n} ${c.v:?} ${rr.n} ${oc.unwrap().n}`);
}
