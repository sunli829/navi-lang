// x.clone() on x: &T or &mut T clones the T, as in Rust.
#[derive(Clone, Debug)]
struct P { v: Vec<i32>, n: i32 }

#[test]
fn clone_through_ref_clones_the_value() {
    let mut a = P { v: Vec::from([1, 2]), n: 1 };
    let r: &mut P = &mut a;
    let mut c = r.clone();
    c.n = 5;
    c.v.push(3);
    let s: &P = &a;
    let d: P = s.clone();
    let o: Option<&mut P> = Some(&mut a);
    let oc: Option<P> = o.cloned();
    assert_eq(a.n, 1);
    assert_eq(a.v, Vec::from([1, 2]));
    assert_eq(c.n, 5);
    assert_eq(c.v, Vec::from([1, 2, 3]));
    assert_eq(oc.unwrap().n, 1);
    assert_eq(d.v, Vec::from([1, 2]));
}
