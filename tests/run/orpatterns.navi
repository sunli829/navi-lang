// Or-patterns binding the same name in struct and tuple variants.
enum E { A { p: i32, x: i64 }, B { x: i64 }, C(i8, i8, i64) }
fn get(e: &E) -> i64 {
    match e {
        E::A { x, .. } | E::B { x, .. } => *x,
        E::C(_, _, x) => *x,
    }
}
fn get2(e: &E) -> i64 {
    match e {
        E::A { x, .. } | E::B { x } | E::C(_, _, x) => *x,
    }
}

#[test]
fn or_patterns_bind_field() {
    let a = E::A { p: 1, x: 10 };
    let b = E::B { x: 20 };
    let c = E::C(1, 2, 30);
    assert_eq((get(&a), get(&b), get(&c)), (10, 20, 30));
    assert_eq((get2(&a), get2(&b), get2(&c)), (10, 20, 30));
}
