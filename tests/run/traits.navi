// out: Sq area 4
// out: total 13
// out: dyn 9
// out: shape with 3 sides
// out: max 5 min 1
trait Shape {
    const SIDES: u32;
    fn area(&self) -> f64;
    fn name(&self) -> String { `shape with ${Self::SIDES} sides` }
}

struct Sq(f64);
struct Tri(f64, f64);

impl Shape for Sq {
    const SIDES: u32 = 4;
    fn area(&self) -> f64 { self.0 * self.0 }
    fn name(&self) -> String { String::from("Sq") }
}

impl Shape for Tri {
    const SIDES: u32 = 3;
    fn area(&self) -> f64 { self.0 * self.1 / 2.0 }
}

fn total<S: Shape>(shapes: &[S]) -> f64 {
    let mut t = 0.0;
    for s in shapes { t += s.area(); }
    t
}

fn show(s: &dyn Display) -> String { s.to_string() }

use std::fmt::Display;

fn main() {
    let s = Sq(2.0);
    println(`${s.name()} area ${s.area()}`);
    println(`total ${total(&[Sq(2.0), Sq(3.0)])}`);
    let d: &dyn Display = &9;
    println(`dyn ${show(d)}`);
    let t = Tri(3.0, 4.0);
    println(t.name());
    println(`max ${std::cmp::max(1, 5)} min ${std::cmp::min(1, 5)}`);
}
