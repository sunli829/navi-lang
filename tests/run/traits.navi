// Traits: associated consts, default methods using them, overrides,
// generic bounds, &dyn Display, std::cmp::{max, min}.
trait Shape {
    const SIDES: u32;
    fn area(&self) -> f64;
    fn name(&self) -> String { `shape with ${Self::SIDES} sides`.to_string() }
}

struct Sq(f64);
struct Tri(f64, f64);

impl Shape for Sq {
    const SIDES: u32 = 4;
    fn area(&self) -> f64 { self.0 * self.0 }
    fn name(&self) -> String { String::from("Sq") }
}

impl Shape for Tri {
    const SIDES: u32 = 3;
    fn area(&self) -> f64 { self.0 * self.1 / 2.0 }
}

fn total<S: Shape>(shapes: &[S]) -> f64 {
    let mut t = 0.0;
    for s in shapes { t += s.area(); }
    t
}

fn show(s: &dyn Display) -> String { s.to_string() }

use std::fmt::Display;

#[test]
fn overridden_method() {
    let s = Sq(2.0);
    assert_eq(s.name().as_str(), "Sq");
    assert_eq(s.area(), 4.0);
    assert_eq(`${s.area()}`.to_string(), "4");
}

#[test]
fn generic_bound() {
    assert_eq(total(&[Sq(2.0), Sq(3.0)]), 13.0);
    assert_eq(`${total(&[Sq(2.0), Sq(3.0)])}`.to_string(), "13");
}

#[test]
fn dyn_display() {
    let d: &dyn Display = &9;
    assert_eq(show(d).as_str(), "9");
}

#[test]
fn default_method_uses_assoc_const() {
    let t = Tri(3.0, 4.0);
    assert_eq(t.name().as_str(), "shape with 3 sides");
}

#[test]
fn cmp_max_min() {
    assert_eq(std::cmp::max(1, 5), 5);
    assert_eq(std::cmp::min(1, 5), 1);
}
