// A closure whose body never returns, with no type to say what it returns:
// its result type falls back to (), as Rust's never type fallback.

fn forever() -> ! {
    loop {
        std::thread::sleep(std::time::Duration::from_secs(1000));
    }
}

fn fail(msg: &str) -> ! {
    panic(msg)
}

fn call<T>(f: fn() -> T, run: bool) -> Option<T> {
    if run { Some(f()) } else { None }
}

fn main() {
    let f = || forever();
    if std::hint::black_box(false) {
        f();
    }
    let _ = std::thread::spawn(|| forever());
    let r = call(|| fail("no"), false);
    println(`${r.is_none()}`);
    let r2 = std::panic::catch_unwind(|| fail("caught"));
    println(`${r2.is_err()}`);
    let g = |x: i32| if x > 0 { fail("positive") } else { fail("not positive") };
    if std::hint::black_box(false) {
        g(1);
    }
    println("ok");
}
// out: true
// out: true
// out: ok
