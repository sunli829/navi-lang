// A G in a loop that calls nothing still stops for a collector: loops
// check the G's stack limit at their head, as prologues do.
use std::sync::atomic::{AtomicBool, Ordering};

static DONE: AtomicBool = AtomicBool::new(false);

// Seconds of arithmetic, no calls.
fn spin() -> u64 {
    let mut x: u64 = std::hint::black_box(1);
    let mut i: u64 = 0;
    while i < 20000000000 {
        x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
        i += 1;
    }
    x
}

#[test]
fn a_collection_does_not_wait_for_a_loop() {
    let _ = std::thread::spawn(|| {
        let x = spin();
        DONE.store(true, Ordering::SeqCst);
        x
    });
    std::thread::sleep(std::time::Duration::from_millis(50));
    std::gc::collect();
    // (The loop runs on; the process ends with the tests.)
    assert(!DONE.load(Ordering::SeqCst));
}

// Builds and runs a program with one M (as Go's runtime tests build
// theirs): navi test sets NAVI to the navi running it.
fn run_program(name: &str, src: &str) -> std::process::Output {
    let dir = std::env::temp_dir().join(`navi-${name}-${std::process::id()}`.to_string());
    std::fs::create_dir_all(&dir).unwrap();
    let file = dir.join("main.navi");
    std::fs::write(&file, src).unwrap();
    let exe = dir.join(`prog${std::env::consts::EXE_SUFFIX}`.to_string());
    let b = std::process::Command::new(std::env::var("NAVI").unwrap()).arg("build").arg("-o").arg(exe.to_str().unwrap()).arg(file.to_str().unwrap()).output().unwrap();
    assert_msg(b.status.success(), String::from_utf8_lossy(&b.stderr));
    let out = std::process::Command::new(exe.to_str().unwrap()).env("NAVI_MAXPROCS", "1").output().unwrap();
    let _ = std::fs::remove_dir_all(&dir);
    out
}

// A G that has run for a time slice (10 ms) yields at its next check, so a
// loop does not keep the others from running on its M.
#[test]
fn a_loop_yields_after_a_time_slice() {
    let out = run_program("slice", r#"
use std::sync::mpmc::channel;
fn spin() -> u64 {
    let mut x: u64 = std::hint::black_box(1);
    let mut i: u64 = 0;
    while i < 100000000000 {
        x = x.wrapping_mul(6364136223846793005).wrapping_add(1442695040888963407);
        i += 1;
    }
    x
}
fn main() {
    let t = std::time::Instant::now();
    let (tx, rx) = channel::<u32>();
    let _ = std::thread::spawn(|| spin());
    std::thread::yield_now();
    let _ = std::thread::spawn(|| { tx.send(1).unwrap(); });
    rx.recv().unwrap();
    println(`${t.elapsed().as_millis() < 5000}`);
    std::process::exit(0);
}
"#);
    assert_eq(String::from_utf8(out.stdout).unwrap(), "true\n");
}
