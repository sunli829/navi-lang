// Non-ASCII file names, environment variables and arguments reach the OS
// and come back (on Windows through the UTF-16 W functions).
use std::env;
use std::fs;
use std::process::Command;

const NAME: &str = "数据-é-😀";

#[test]
fn file_names() {
    let dir = env::temp_dir().join(`navi-unicode-${std::process::id()}-${NAME}`.to_string());
    fs::create_dir_all(&dir).unwrap();
    let f = dir.join(`${NAME}.txt`.to_string());
    fs::write(&f, "内容").unwrap();
    assert_eq(fs::read_to_string(&f).unwrap(), "内容");
    let names: Vec<String> = fs::read_dir(&dir).unwrap().map(|e| e.unwrap().file_name()).collect();
    assert_eq(names, Vec::from([`${NAME}.txt`.to_string()]));
    assert(fs::metadata(&f).unwrap().is_file());
    let c = fs::canonicalize(&f).unwrap();
    assert_msg(c.as_str().ends_with(`${NAME}.txt`.to_string().as_str()), c.display());
    let prev = env::current_dir().unwrap();
    env::set_current_dir(&dir).unwrap();
    let here = env::current_dir().unwrap();
    env::set_current_dir(&prev).unwrap();
    assert_msg(here.as_str().ends_with(NAME), here.display());
    fs::remove_dir_all(&dir).unwrap();
    assert(!dir.exists());
}

#[test]
fn variables() {
    unsafe { env::set_var("NAVI_UNICODE_值", NAME); }
    assert_eq(env::var("NAVI_UNICODE_值"), Ok(NAME.to_string()));
    assert(env::vars().any(|kv| kv.0 == "NAVI_UNICODE_值" && kv.1 == NAME));
    unsafe { env::remove_var("NAVI_UNICODE_值"); }
    assert(env::var("NAVI_UNICODE_值").is_err());
}

// The child of arguments_and_child_environment (this test binary again,
// running only this test): prints its arguments and a variable.
#[test]
fn child_echoes() {
    let v = match env::var("NAVI_UNICODE_CHILD") { Ok(v) => v, Err(_) => return };
    let a: Vec<String> = env::args().collect();
    print(`${a[2..].join("|")}|${v}\n`);
}

#[test]
fn arguments_and_child_environment() {
    let out = Command::new(env::current_exe().unwrap().as_str()).arg("child_echoes").arg(NAME).arg("a b \"c\" \\").arg("")
        .env("NAVI_UNICODE_CHILD", "环境").output().unwrap();
    let s = String::from_utf8(out.stdout).unwrap();
    assert_msg(s.starts_with(`${NAME}|a b "c" \\||环境\n`.to_string().as_str()), s);
}
