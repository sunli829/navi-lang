// std::regex API: captures by name, replacement expansion, iterators,
// split, builder flags, RegexSet, escape, NoExpand, closures, errors.
use std::regex::{Regex, RegexBuilder, RegexSet, NoExpand, escape};

#[test]
fn named_captures_and_replacement_expansion() {
    let re = Regex::new(r"(?P<y>\d{4})-(?P<m>\d{2})").unwrap();
    assert(re.is_match("on 2024-05"));
    let c = re.captures("on 2024-05!").unwrap();
    assert_eq(c.name("y").unwrap().as_str(), "2024");
    assert_eq(`${c.at(2)}`.to_string().as_str(), "05");
    assert_eq(c.get(0).unwrap().start(), 3);
    assert_eq(c.get(0).unwrap().end(), 10);
    assert_eq(`${re.replace_all("2024-05 and 2025-01", "$m/$y")}`.to_string().as_str(), "05/2024 and 01/2025");
}

#[test]
fn find_iter_and_split() {
    let w = Regex::new(r"\w+").unwrap();
    let v: Vec<&str> = w.find_iter("héllo, wörld 42").map(|m| m.as_str()).collect();
    assert_eq(v, Vec::from(["héllo", "wörld", "42"]));
    let e = Regex::new(r"a*").unwrap();
    let ms: Vec<(usize, usize)> = e.find_iter("baaab").map(|m| (m.start(), m.end())).collect();
    assert_eq(ms, Vec::from([(0usize, 0usize), (1, 4), (5, 5)]));
    let sp: Vec<&str> = Regex::new(r"[,;]\s*").unwrap().split("a, b;c,,d").collect();
    assert_eq(sp, Vec::from(["a", "b", "c", "", "d"]));
}

#[test]
fn nested_star_on_long_input_is_linear() {
    let p = Regex::new(r"(a*)*b").unwrap();
    let long = "a".repeat(5000);
    assert(!p.is_match(long.as_str()));
}

#[test]
fn builder_set_escape() {
    assert(RegexBuilder::new("HELLO").case_insensitive(true).build().unwrap().is_match("say hello"));
    let set = RegexSet::new(["foo", r"\d+", "bar$"]).unwrap();
    let hits: Vec<usize> = set.matches("foo 12").into_iter().collect();
    assert_eq(hits, Vec::from([0usize, 1]));
    assert_eq(`${escape("a.b*c")}`.to_string().as_str(), r"a\.b\*c");
}

#[test]
fn no_expand_and_closure_replacement() {
    assert_eq(`${Regex::new("x").unwrap().replace_all("axbx", NoExpand("$1"))}`.to_string().as_str(), "a$1b$1");
    assert_eq(`${Regex::new(r"(\w+) (\w+)").unwrap().replace_all_with("ab cd", |c| `${c.at(2)} ${c.at(1)}`.to_string())}`.to_string().as_str(), "cd ab");
}

#[test]
fn parse_error_message() {
    let msg = match Regex::new("a(b") { Ok(_) => String::from("?"), Err(e) => `${e}`.to_string() };
    assert_eq(msg.as_str(), "regex parse error:\n    a(b\n     ^\nerror: unclosed group");
}
