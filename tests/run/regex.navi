// std::regex API: captures by name, replacement expansion, iterators,
// split, builder flags, RegexSet, escape, NoExpand, closures, errors.
// out: true
// out: 2024 05 3..10
// out: 05/2024 and 01/2025
// out: ["héllo", "wörld", "42"]
// out: [(0, 0), (1, 4), (5, 5)]
// out: ["a", "b", "c", "", "d"]
// out: false
// out: true
// out: [0, 1]
// out: a\.b\*c
// out: a$1b$1
// out: cd ab
// out: regex parse error:
// out:     a(b
// out:      ^
// out: error: unclosed group
use std::regex::{Regex, RegexBuilder, RegexSet, NoExpand, escape};
fn main() {
    let re = Regex::new(r"(?P<y>\d{4})-(?P<m>\d{2})").unwrap();
    println(`${re.is_match("on 2024-05")}`);
    let c = re.captures("on 2024-05!").unwrap();
    println(`${c.name("y").unwrap().as_str()} ${c.at(2)} ${c.get(0).unwrap().start()}..${c.get(0).unwrap().end()}`);
    println(re.replace_all("2024-05 and 2025-01", "$m/$y"));
    let w = Regex::new(r"\w+").unwrap();
    let v: Vec<&str> = w.find_iter("héllo, wörld 42").map(|m| m.as_str()).collect();
    println(`${v:?}`);
    let e = Regex::new(r"a*").unwrap();
    let ms: Vec<(usize, usize)> = e.find_iter("baaab").map(|m| (m.start(), m.end())).collect();
    println(`${ms:?}`);
    let sp: Vec<&str> = Regex::new(r"[,;]\s*").unwrap().split("a, b;c,,d").collect();
    println(`${sp:?}`);
    let p = Regex::new(r"(a*)*b").unwrap();
    let long = "a".repeat(5000);
    println(`${p.is_match(long.as_str())}`);
    println(`${RegexBuilder::new("HELLO").case_insensitive(true).build().unwrap().is_match("say hello")}`);
    let set = RegexSet::new(["foo", r"\d+", "bar$"]).unwrap();
    let hits: Vec<usize> = set.matches("foo 12").into_iter().collect();
    println(`${hits:?}`);
    println(escape("a.b*c"));
    println(Regex::new("x").unwrap().replace_all("axbx", NoExpand("$1")));
    println(Regex::new(r"(\w+) (\w+)").unwrap().replace_all_with("ab cd", |c| `${c.at(2)} ${c.at(1)}`));
    match Regex::new("a(b") { Ok(_) => println("?"), Err(e) => println(`${e}`) }
}
