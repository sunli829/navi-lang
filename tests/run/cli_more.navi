// std::cli: possible values, ranges, conflicts, requirements, environment
// variables, value names, the help subcommand, a required subcommand; the
// expected texts are clap 4.6's output for the same program.
use std::cli::{Arg, ArgAction, Command, ValueParser};
fn cmd() -> Command {
    Command::new("tool")
        .about("A tool")
        .subcommand_required(true)
        .arg(Arg::new("mode").long("mode").value_parser(ValueParser::possible(&["fast", "slow"])).help("Mode"))
        .arg(Arg::new("level").short('l').long("level").value_parser(ValueParser::i64_range(1, 9)).help("Level"))
        .arg(Arg::new("json").long("json").action(ArgAction::SetTrue).conflicts_with("yaml"))
        .arg(Arg::new("yaml").long("yaml").action(ArgAction::SetTrue))
        .arg(Arg::new("user").long("user").requires("pass"))
        .arg(Arg::new("pass").long("pass").env("TOOL_PASS_XYZ"))
        .arg(Arg::new("secret").long("secret").hide(true))
        .arg(Arg::new("list").long("list").value_delimiter(',').action(ArgAction::Append))
        .arg(Arg::new("pair").long("pair").num_args(2).value_names(&["K", "V"]))
        .subcommand(Command::new("run").about("Runs").arg(Arg::new("n").long("n").value_parser(ValueParser::u64())))
        .subcommand(Command::new("stop").about("Stops"))
}
fn many(m: &std::cli::ArgMatches, id: &str) -> Option<Vec<String>> { match m.get_many::<String>(id) { Some(x) => Some(x.collect()), None => None } }

// What the program prints for these arguments: the matches, or the error's
// exit code and rendered text.
fn run(args: &[&str]) -> String {
    let mut v = Vec::from(["tool"]);
    v.extend_from_slice(args);
    let mut out = `$ ${args.join(" ")}\n`;
    match cmd().try_get_matches_from(v) {
        Ok(m) => out.push_str(`mode=${m.get_one::<String>("mode"):?} level=${m.get_one::<i64>("level"):?} json=${m.get_flag("json")} user=${m.get_one::<String>("user"):?} pass=${m.get_one::<String>("pass"):?} list=${many(&m, "list"):?} pair=${many(&m, "pair"):?} sub=${m.subcommand_name():?}\n`.as_str()),
        Err(e) => {
            out.push_str(`exit ${e.exit_code()} ---\n`.as_str());
            out.push_str(e.render().as_str());
            out.push_str("---\n");
        }
    }
    out
}

#[test]
fn parsed_matches() {
    assert_eq(run(&["--mode", "fast", "-l", "3", "--list", "a,b", "--list", "c", "--pair", "k", "v", "run"]).as_str(), "$ --mode fast -l 3 --list a,b --list c --pair k v run\nmode=Some(\"fast\") level=Some(3) json=false user=None pass=None list=Some([\"a\", \"b\", \"c\"]) pair=Some([\"k\", \"v\"]) sub=Some(\"run\")\n");
}

#[test]
fn invalid_values() {
    assert_eq(run(&["--mode", "fats", "run"]).as_str(), "$ --mode fats run\nexit 2 ---\nerror: invalid value 'fats' for '--mode <mode>'\n  [possible values: fast, slow]\n\n  tip: a similar value exists: 'fast'\n\nFor more information, try '--help'.\n---\n");
    assert_eq(run(&["--level", "0", "run"]).as_str(), "$ --level 0 run\nexit 2 ---\nerror: invalid value '0' for '--level <level>': 0 is not in 1..=9\n\nFor more information, try '--help'.\n---\n");
    assert_eq(run(&["--level", "x", "run"]).as_str(), "$ --level x run\nexit 2 ---\nerror: invalid value 'x' for '--level <level>': invalid digit found in string\n\nFor more information, try '--help'.\n---\n");
}

#[test]
fn conflicts_and_requirements() {
    assert_eq(run(&["--json", "--yaml", "run"]).as_str(), "$ --json --yaml run\nexit 2 ---\nerror: the argument '--json' cannot be used with '--yaml'\n\nUsage: tool --json <COMMAND>\n\nFor more information, try '--help'.\n---\n");
    assert_eq(run(&["--user", "u", "run"]).as_str(), "$ --user u run\nexit 2 ---\nerror: the following required arguments were not provided:\n  --pass <pass>\n\nUsage: tool --pass <pass> --user <user> <COMMAND>\n\nFor more information, try '--help'.\n---\n");
}

#[test]
fn missing_subcommand() {
    assert_eq(run(&["--mode", "slow"]).as_str(), "$ --mode slow\nexit 2 ---\nerror: 'tool' requires a subcommand but one was not provided\n  [subcommands: run, stop, help]\n\nUsage: tool [OPTIONS] <COMMAND>\n\nFor more information, try '--help'.\n---\n");
}

#[test]
fn help() {
    assert_eq(run(&["--help"]).as_str(), "$ --help\nexit 0 ---\nA tool\n\nUsage: tool [OPTIONS] <COMMAND>\n\nCommands:\n  run   Runs\n  stop  Stops\n  help  Print this message or the help of the given subcommand(s)\n\nOptions:\n      --mode <mode>    Mode [possible values: fast, slow]\n  -l, --level <level>  Level\n      --json           \n      --yaml           \n      --user <user>    \n      --pass <pass>    [env: TOOL_PASS_XYZ=]\n      --list <list>    \n      --pair <K> <V>   \n  -h, --help           Print help\n---\n");
    assert_eq(run(&["help", "run"]).as_str(), "$ help run\nexit 0 ---\nRuns\n\nUsage: tool run [OPTIONS]\n\nOptions:\n      --n <n>  \n  -h, --help   Print help\n---\n");
    assert_eq(run(&["help"]).as_str(), "$ help\nexit 0 ---\nA tool\n\nUsage: tool [OPTIONS] <COMMAND>\n\nCommands:\n  run   Runs\n  stop  Stops\n  help  Print this message or the help of the given subcommand(s)\n\nOptions:\n      --mode <mode>    Mode [possible values: fast, slow]\n  -l, --level <level>  Level\n      --json           \n      --yaml           \n      --user <user>    \n      --pass <pass>    [env: TOOL_PASS_XYZ=]\n      --list <list>    \n      --pair <K> <V>   \n  -h, --help           Print help\n---\n");
}

#[test]
fn unknown_subcommand_and_arguments() {
    assert_eq(run(&["rnu"]).as_str(), "$ rnu\nexit 2 ---\nerror: unrecognized subcommand 'rnu'\n\nUsage: tool [OPTIONS] <COMMAND>\n\nFor more information, try '--help'.\n---\n");
    assert_eq(run(&["run", "--n", "-5"]).as_str(), "$ run --n -5\nexit 2 ---\nerror: unexpected argument '-5' found\n\nUsage: tool run [OPTIONS]\n\nFor more information, try '--help'.\n---\n");
    assert_eq(run(&["--pair", "k"]).as_str(), "$ --pair k\nexit 2 ---\nerror: 2 values required for '--pair <K> <V>' but 1 was provided\n\nUsage: tool [OPTIONS] <COMMAND>\n\nFor more information, try '--help'.\n---\n");
}
