// out: Options:
// out:       --n <n>  
// out:   -h, --help   Print help
// out: ---
// out: $ help
// out: exit 0 ---
// out: A tool
// out:
// out: Usage: tool [OPTIONS] <COMMAND>
// out:
// out: Commands:
// out:   run   Runs
// out:   stop  Stops
// out:   help  Print this message or the help of the given subcommand(s)
// out:
// out: Options:
// out:       --mode <mode>    Mode [possible values: fast, slow]
// out:   -l, --level <level>  Level
// out:       --json           
// out:       --yaml           
// out:       --user <user>    
// out:       --pass <pass>    [env: TOOL_PASS_XYZ=]
// out:       --list <list>    
// out:       --pair <K> <V>   
// out:   -h, --help           Print help
// out: ---
// out: $ rnu
// out: exit 2 ---
// out: error: unrecognized subcommand 'rnu'
// out:
// out: Usage: tool [OPTIONS] <COMMAND>
// out:
// out: For more information, try '--help'.
// out: ---
// out: $ run --n -5
// out: exit 2 ---
// out: error: unexpected argument '-5' found
// out:
// out: Usage: tool run [OPTIONS]
// out:
// out: For more information, try '--help'.
// out: ---
// out: $ --pair k
// out: exit 2 ---
// out: error: 2 values required for '--pair <K> <V>' but 1 was provided
// out:
// out: Usage: tool [OPTIONS] <COMMAND>
// out:
// out: For more information, try '--help'.
// out: ---
use std::cli::{Arg, ArgAction, Command, ValueParser};
fn cmd() -> Command {
    Command::new("tool")
        .about("A tool")
        .subcommand_required(true)
        .arg(Arg::new("mode").long("mode").value_parser(ValueParser::possible(&["fast", "slow"])).help("Mode"))
        .arg(Arg::new("level").short('l').long("level").value_parser(ValueParser::i64_range(1, 9)).help("Level"))
        .arg(Arg::new("json").long("json").action(ArgAction::SetTrue).conflicts_with("yaml"))
        .arg(Arg::new("yaml").long("yaml").action(ArgAction::SetTrue))
        .arg(Arg::new("user").long("user").requires("pass"))
        .arg(Arg::new("pass").long("pass").env("TOOL_PASS_XYZ"))
        .arg(Arg::new("secret").long("secret").hide(true))
        .arg(Arg::new("list").long("list").value_delimiter(',').action(ArgAction::Append))
        .arg(Arg::new("pair").long("pair").num_args(2).value_names(&["K", "V"]))
        .subcommand(Command::new("run").about("Runs").arg(Arg::new("n").long("n").value_parser(ValueParser::u64())))
        .subcommand(Command::new("stop").about("Stops"))
}
fn many(m: &std::cli::ArgMatches, id: &str) -> Option<Vec<String>> { match m.get_many::<String>(id) { Some(x) => Some(x.collect()), None => None } }
fn run(args: &[&str]) {
    let mut v = Vec::from(["tool"]);
    v.extend_from_slice(args);
    println(`$ ${args.join(" ")}`);
    match cmd().try_get_matches_from(v) {
        Ok(m) => println(`mode=${m.get_one::<String>("mode"):?} level=${m.get_one::<i64>("level"):?} json=${m.get_flag("json")} user=${m.get_one::<String>("user"):?} pass=${m.get_one::<String>("pass"):?} list=${many(&m, "list"):?} pair=${many(&m, "pair"):?} sub=${m.subcommand_name():?}`),
        Err(e) => { println(`exit ${e.exit_code()} ---`); std::io::print(e.render()); println("---"); }
    }
}
fn main() {
    run(&["--mode", "fast", "-l", "3", "--list", "a,b", "--list", "c", "--pair", "k", "v", "run"]);
    run(&["--mode", "fats", "run"]);
    run(&["--level", "0", "run"]);
    run(&["--level", "x", "run"]);
    run(&["--json", "--yaml", "run"]);
    run(&["--user", "u", "run"]);
    run(&["--mode", "slow"]);
    run(&["--help"]);
    run(&["help", "run"]);
    run(&["help"]);
    run(&["rnu"]);
    run(&["run", "--n", "-5"]);
    run(&["--pair", "k"]);
}
