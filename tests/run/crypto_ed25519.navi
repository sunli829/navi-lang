// std::crypto::ed25519 against RFC 8032 (7.1) and outputs of Go's
// crypto/ed25519 (keys, signatures and verdicts, some tampered).

use std::crypto::ed25519::{SigningKey, VerifyingKey, Signature};
use std::hex;

fn key(seed: &str) -> SigningKey {
    let b = hex::decode(seed).unwrap();
    let mut s: [u8; 32] = [0; 32];
    s.copy_from_slice(&b);
    SigningKey::from_bytes(&s)
}

fn vkey(pk: &str) -> VerifyingKey {
    let b = hex::decode(pk).unwrap();
    let mut s: [u8; 32] = [0; 32];
    s.copy_from_slice(&b);
    VerifyingKey::from_bytes(&s).unwrap()
}

#[test]
fn rfc8032() {
    // (seed, public key, message, signature)
    let cases = [
        ("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60", "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a", "",
            "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"),
        ("4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb", "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c", "72",
            "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"),
        ("c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7", "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025", "af82",
            "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a"),
    ];
    for c in cases.iter() {
        let k = key(c.0);
        assert_eq(hex::encode(&k.verifying_key().to_bytes()), c.1.to_string());
        let msg = hex::decode(c.2).unwrap();
        let sig = k.sign(&msg);
        assert_eq(hex::encode(&sig.to_bytes()), c.3.to_string());
        assert(k.verifying_key().verify(&msg, &sig).is_ok());
        let mut other = msg.clone();
        other.push(1);
        assert(k.verifying_key().verify(&other, &sig).is_err());
    }
}

#[test]
fn go_outputs() {
    // seed, public key, message ("-": empty), signature, whether valid
    let lines = [
        "57db38069ab2c6bffdbc10d4025042aba23a5231c73b1a2a50e868ef577d408d 28c4ca9ea38bf9e8c950afa66eaf226ae60a22debeea440a2fd55acac10200d6  8b011784348121dca5c9cb77fed5e0610fa4411806843916b6663f8018e0075ca58bb9cb9db2c56be805abe2012a695db5bac5d4b58312f232269f2a3ebdcb0f 1",
        "07e91074b71318b4d34bc739682b9fa8136217c64f66e47e044ffda61419fd96 665549aa3ee79c0c2a8beeee7ac9caa70987e6df833d8b60146d58834cff3abd 8ea99bdf7bc6fa315c7cfa95880cbbc33b96a9527fb898ea97519d6094174d78649944538d5ffcdf50ccc248903d9ce2441017a4b5bae4f845874d179fa723264cf6c8dc705486c2b74ea45c8a 29aa9115ea0646a725d0c735ff93b04cf5505e9892270bfb6a5d302e9911fe542ab1be6af43daefa21fcb9ee78c638f0bddb59a38a2936eab7d292a6ba8d6b09 0",
        "ff7bb4edcd7a93b91ed3cc826714213ffe5516f20db3fcc99366f3de72c6a114 84340f64cb8614473f03d081687fbe0302b0fbe8bf2d8c161b065883d5cd5ecd 26b65752b66ef9831605816ab27c5c6ca7a4fb1dec787a32284e4a83367e61aad1a39f06294073f5a0a629e0a256e321b596f927523c1cfd302091efaf896e24df4b0ef4ed04a7ce6f999cf91c 72eda67fa81eaf87a5801ce41d4377f42bfb9912dafffb40772ec7cba3d7f26b4043ed3a3924de82648d108bd07da5fd8d292ff6524503689935ba393a83520e 0",
        "09509f73b562e3460aa4c59b910643732a997c17bbc5015028e02b8d88a4b65a 5729e5b9bb770a8999d3aed13f0fa956e2e568353dcba93be55160681a2bdebc  35cc253a84b235c4dafba449cbc3a15a6dd2c3d87e26eb1ca35c5eb81cacb9c494a4c7c0f52b9593c11ccab3ae7f61c9b04b680bce3ce9134aa69bc73c84cf09 1",
        "3e670d42c84ae96da9526dcc573dcc994d9f2e251031a2a7fb525a6c3cff60af c0c8c37976f34c35a8e796946288fcece206ffb4e167e45c25f9ffba6382215a  b60f9a1de9afe3dd2ad1fae0962448b3791fd51fb97be77435f0d14779d26d325bdc087dd4aceae6a78952beba1201c041dd3aafbbedd5367da870c907f7a90a 1",
        "adb4927a65e4d95aee5308b58f958b8a6f2ceda051c3c2ce582a3d8011a21b5b 8a271962e8fe494f7ef5436d5e99d75c16233f3d849f7ee4b8f030195b86c8f3 52af574cff5960f9495cd13e65d28bc99db83ed1dee3a3caa305974a2ea543ac985fa28bf80bf15b69e9f9a7ab580188e2fb8e3295069a5cff9cceeaeee390688b9033f0c3f38d043d97d2e3adce5841e4586853af31376f6c16e56be980a826e294a6539e58a6caf781364b939d4ac58fec1b0144 5721e852d3381f35fc710364ef951e96913b6cf3ffe89e78f05c6d68be7c52876de22aaa7137635d7479acd7a3362897255943262869dbfc30df60f5fb899e04 1",
    ];
    for l in lines.iter() {
        let f: Vec<&str> = l.split_whitespace().collect();
        let k = key(f[0]);
        assert_eq(hex::encode(&k.verifying_key().to_bytes()), f[1].to_string());
        let msg = if f[2] == "-" { Vec::new() } else { hex::decode(f[2]).unwrap() };
        let sig = Signature::from_slice(&hex::decode(f[3]).unwrap()).unwrap();
        let valid = f[4] == "1";
        if valid { assert_eq(hex::encode(&k.sign(&msg).to_bytes()), f[3].to_string()); }
        assert_eq(vkey(f[1]).verify(&msg, &sig).is_ok(), valid);
    }
}

#[test]
fn malleability() {
    // Go's TestMalleability: S above the order is rejected (RFC 8032 5.1.7).
    let sig = Signature::from_slice(&hex::decode("7c38e026f29e14aabd059a0f2db8b0cd783040609a8be684db12f82a27774ab067654bce3832c2d76f8f6f5dafc08d9339d4eef676573336a5c51eb6f946b31d").unwrap()).unwrap();
    let pk = vkey("7d4d0e7f6153a69b6242b522abbee685fda4420f8834b108c3bdae369ef549fa");
    assert(pk.verify(b"Test", &sig).is_err());
}
