// Vec and String basics: push, iteration, map/collect, sort, get, and
// a Vec's value shared between aliases (Vec has reference semantics).
fn vec_of<T: Clone>(s: &[T]) -> Vec<T> { Vec::from(s) }

#[test]
fn vec_push_iterate_map() {
    let mut v = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    assert_eq(`${v:?}`.to_string().as_str(), "[1, 2, 3]");
    assert_eq(v.len(), 3);
    let mut sum = 0;
    for x in &v { sum += *x; }
    assert_eq(sum, 6);
    let doubled: Vec<i32> = v.iter().map(|x| *x * 2).collect();
    assert_eq(`${doubled:?}`.to_string().as_str(), "[2, 4, 6]");
    assert_eq(`${v.get(2):?} ${v.get(9):?}`.to_string().as_str(), "Some(3) None");
}

#[test]
fn string_push_str() {
    let mut s = String::from("hello");
    s.push_str(" world");
    assert_eq(s.as_str(), "hello world");
    assert_eq(s.len(), 11);
}

#[test]
fn vec_from_slice_and_sort() {
    let mut w = vec_of(&[5, 3, 1, 4, 2]);
    w.sort();
    assert_eq(`${w:?}`.to_string().as_str(), "[1, 2, 3, 4, 5]");
    let names = vec_of(&["a", "b"]);
    assert_eq(`${names:?}`.to_string().as_str(), "[\"a\", \"b\"]");
}

#[test]
fn vec_aliases_share() {
    let v = Vec::from([1, 2, 3]);
    let alias = v;
    let mut a2 = alias;
    a2.push(99);
    assert_eq(`${v:?}`.to_string().as_str(), "[1, 2, 3, 99]");
}
