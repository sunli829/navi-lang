// out: [1, 2, 3] 3
// out: 6
// out: [2, 4, 6]
// out: hello world 11
// out: [1, 2, 3, 4, 5]
// out: Some(3) None
// out: shared: [1, 2, 3, 99]
// out: ["a", "b"]
fn main() {
    let mut v = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    println(`${v:?} ${v.len()}`);
    let mut sum = 0;
    for x in &v { sum += *x; }
    println(sum);
    let doubled: Vec<i32> = v.iter().map(|x| *x * 2).collect();
    println(`${doubled:?}`);
    let mut s = String::from("hello");
    s.push_str(" world");
    println(`${s} ${s.len()}`);
    let mut w = vec_of(&[5, 3, 1, 4, 2]);
    w.sort();
    println(`${w:?}`);
    println(`${v.get(2):?} ${v.get(9):?}`);
    let alias = v;
    let mut a2 = alias;
    a2.push(99);
    println(`shared: ${v:?}`);
    let names = vec_of(&["a", "b"]);
    println(`${names:?}`);
}

fn vec_of<T: Clone>(s: &[T]) -> Vec<T> { Vec::from(s) }
