// std::log: levels, filters (as env_logger's), the built-in logger without
// timestamps on stdout, nothing logged before init. The logger is global,
// so the program runs on its own.

// Builds and runs a program (as Go's runtime tests build theirs): navi test
// sets NAVI to the navi running it (as Cargo sets CARGO).
fn run_program(name: &str, src: &str) -> std::process::Output {
    let dir = std::env::temp_dir().join(`navi-${name}-${std::process::id()}`.to_string());
    std::fs::create_dir_all(&dir).unwrap();
    let file = dir.join("log_builder.navi");
    std::fs::write(&file, src).unwrap();
    let exe = dir.join(`prog${std::env::consts::EXE_SUFFIX}`.to_string());
    let navi = std::env::var("NAVI").unwrap();
    let b = std::process::Command::new(navi).arg("build").arg("-o").arg(exe.to_str().unwrap()).arg(file.to_str().unwrap()).output().unwrap();
    assert_msg(b.status.success(), String::from_utf8_lossy(&b.stderr));
    let out = std::process::Command::new(exe.to_str().unwrap()).output().unwrap();
    let _ = std::fs::remove_dir_all(&dir);
    out
}

#[test]
fn builder_filters_and_stdout_target() {
    let out = run_program("log_builder", r#"
use std::log::{self, Level, LevelFilter, Builder, Target};


fn main() {
    println(`${log::max_level():?} ${"warn".parse::<LevelFilter>():?} ${"x".parse::<Level>().is_err()} ${Level::Debug < Level::Info} ${LevelFilter::Info >= Level::Debug}`);
    log::info("dropped: no logger yet");
    let mut b = Builder::new();
    b.parse_filters("info,log_builder::quiet=error").format_timestamp(None).target(Target::Stdout);
    b.init();
    log::info(`hello ${1 + 1}`);
    log::debug("not shown");
    log::warn("careful");
    log::log_target("log_builder::quiet", Level::Warn, "filtered out");
    log::log_target("log_builder::quiet", Level::Error, "kept");
    log::log_target("other", Level::Debug, "not shown");
    println(`${log::log_enabled(Level::Info)} ${log::log_enabled(Level::Debug)} ${log::max_level()}`);
    println(`second init: ${Builder::new().try_init().is_err()}`);
}
"#);
    assert(out.status.success());
    assert_eq(String::from_utf8(out.stdout).unwrap(), "Off Ok(Warn) true false false\n[INFO  log_builder] hello 2\n[WARN  log_builder] careful\n[ERROR log_builder::quiet] kept\ntrue false INFO\nsecond init: true\n");
}
