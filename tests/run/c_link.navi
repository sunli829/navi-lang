// Functions of a library other than the C library (#[link]): navi's
// linkers import them from it.
#[cfg(not(target_os = "windows"))]
#[link(name = "z")]
#[nonblocking]
extern "C" {
    fn zlibVersion() -> *const u8;
    fn crc32(crc: u64, buf: *const u8, len: u32) -> u64;
}

#[cfg(not(target_os = "windows"))]
#[test]
fn zlib_functions() {
    let v = unsafe { zlibVersion() };
    assert(unsafe { *v } != 0);
    let s = "hello";
    let c = unsafe { crc32(0, s.as_ptr(), 5) };
    assert_eq(c, 907060870);
}

// Windows: ntdll.dll's CRC-32 (zlib's).
#[cfg(target_os = "windows")]
#[link(name = "ntdll")]
#[nonblocking]
extern "C" {
    fn RtlComputeCrc32(initial: u32, buf: *const u8, len: i32) -> u32;
}

#[cfg(target_os = "windows")]
#[test]
fn ntdll_function() {
    let s = "hello";
    assert_eq(unsafe { RtlComputeCrc32(0, s.as_ptr(), 5) }, 907060870);
}
