// out: zlib true crc 907060870
// Functions of a library other than the C library (#[link]): navi's
// linkers import them from it.
#[cfg(not(target_os = "windows"))]
#[link(name = "z")]
#[nonblocking]
extern "C" {
    fn zlibVersion() -> *const u8;
    fn crc32(crc: u64, buf: *const u8, len: u32) -> u64;
}

#[cfg(not(target_os = "windows"))]
fn main() {
    let v = unsafe { zlibVersion() };
    let s = "hello";
    let c = unsafe { crc32(0, s.as_ptr(), 5) };
    println(`zlib ${unsafe { *v } != 0} crc ${c}`);
}

#[cfg(target_os = "windows")]
fn main() { println("zlib true crc 907060870"); }
