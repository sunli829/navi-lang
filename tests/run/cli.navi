// std::cli: options, flags, counters, positionals, subcommands, help, version and
// errors; the expected lines are clap 4.6's
// output for the same program.
// out: $ a.txt
// out: file=Some("a.txt") rest=None name=Some("world") verbose=0 quiet=false port=None tags=None
// out: no sub
// out: $ a.txt b c -vvv -q --name=bob -p 80 -t x --tag y
// out: file=Some("a.txt") rest=Some(["b", "c"]) name=Some("bob") verbose=3 quiet=true port=Some("80") tags=Some(["x", "y"])
// out: no sub
// out: $ -n al -- -file --x
// out: file=Some("-file") rest=Some(["--x"]) name=Some("al") verbose=0 quiet=false port=None tags=None
// out: no sub
// out: $ a.txt -pp80
// out: file=Some("a.txt") rest=None name=Some("world") verbose=0 quiet=false port=Some("p80") tags=None
// out: no sub
// out: $ a.txt add thing -f
// out: file=Some("a.txt") rest=None name=Some("world") verbose=0 quiet=false port=None tags=None
// out: sub add item=Some("thing") force=Some(true)
// out: $ a.txt list
// out: file=Some("a.txt") rest=None name=Some("world") verbose=0 quiet=false port=None tags=None
// out: sub list item=None force=None
// out: $ 
// out: exit 2 ---
// out: error: the following required arguments were not provided:
// out:   <file>
// out:
// out: Usage: prog <file> [rest]...
// out:
// out: For more information, try '--help'.
// out: ---
// out: $ a.txt --nme x
// out: exit 2 ---
// out: error: unexpected argument '--nme' found
// out:
// out:   tip: a similar argument exists: '--name'
// out:
// out: Usage: prog --name <name> <file> [rest]...
// out:
// out: For more information, try '--help'.
// out: ---
// out: $ a.txt --bogus
// out: exit 2 ---
// out: error: unexpected argument '--bogus' found
// out:
// out:   tip: to pass '--bogus' as a value, use '-- --bogus'
// out:
// out: Usage: prog <file> [rest]...
// out:
// out: For more information, try '--help'.
// out: ---
// out: $ a.txt -x
// out: exit 2 ---
// out: error: unexpected argument '-x' found
// out:
// out:   tip: to pass '-x' as a value, use '-- -x'
// out:
// out: Usage: prog [OPTIONS] <file> [rest]... [COMMAND]
// out:
// out: For more information, try '--help'.
// out: ---
// out: $ a.txt --name
// out: exit 2 ---
// out: error: a value is required for '--name <name>' but none was supplied
// out:
// out: For more information, try '--help'.
// out: ---
// out: $ a.txt --quiet=yes
// out: exit 2 ---
// out: error: unexpected value 'yes' for '--quiet' found; no more were expected
// out:
// out: Usage: prog --quiet <file> [rest]...
// out:
// out: For more information, try '--help'.
// out: ---
// out: $ a.txt add
// out: exit 2 ---
// out: error: the following required arguments were not provided:
// out:   <item>
// out:
// out: Usage: prog <file> add <item>
// out:
// out: For more information, try '--help'.
// out: ---
// out: $ --help
// out: exit 0 ---
// out: Does awesome things
// out:
// out: Usage: prog [OPTIONS] <file> [rest]... [COMMAND]
// out:
// out: Commands:
// out:   add   Adds things
// out:   list  Lists things
// out:   help  Print this message or the help of the given subcommand(s)
// out:
// out: Arguments:
// out:   <file>     The input file
// out:   [rest]...  More files
// out:
// out: Options:
// out:   -n, --name <name>  Your name [default: world]
// out:   -v, --verbose...   More output
// out:   -q, --quiet        Less output
// out:   -p, --port <PORT>  Port to use
// out:   -t, --tag <tag>    Tags (repeatable)
// out:   -h, --help         Print help
// out:   -V, --version      Print version
// out: ---
// out: $ -h
// out: exit 0 ---
// out: Does awesome things
// out:
// out: Usage: prog [OPTIONS] <file> [rest]... [COMMAND]
// out:
// out: Commands:
// out:   add   Adds things
// out:   list  Lists things
// out:   help  Print this message or the help of the given subcommand(s)
// out:
// out: Arguments:
// out:   <file>     The input file
// out:   [rest]...  More files
// out:
// out: Options:
// out:   -n, --name <name>  Your name [default: world]
// out:   -v, --verbose...   More output
// out:   -q, --quiet        Less output
// out:   -p, --port <PORT>  Port to use
// out:   -t, --tag <tag>    Tags (repeatable)
// out:   -h, --help         Print help
// out:   -V, --version      Print version
// out: ---
// out: $ a.txt add --help
// out: exit 0 ---
// out: Adds things
// out:
// out: Usage: prog <file> add [OPTIONS] <item>
// out:
// out: Arguments:
// out:   <item>  What to add
// out:
// out: Options:
// out:   -f, --force  
// out:   -h, --help   Print help
// out: ---
// out: $ --version
// out: exit 0 ---
// out: prog 1.2.3
// out: ---
// out: $ a.txt -q -q
// out: exit 2 ---
// out: error: the argument '--quiet' cannot be used multiple times
// out:
// out: Usage: prog [OPTIONS] <file> [rest]... [COMMAND]
// out:
// out: For more information, try '--help'.
// out: ---
// out: $ a.txt lst
// out: file=Some("a.txt") rest=Some(["lst"]) name=Some("world") verbose=0 quiet=false port=None tags=None
// out: no sub
use std::cli::{Arg, ArgAction, Command};
fn cmd() -> Command {
    Command::new("prog")
        .version("1.2.3")
        .about("Does awesome things")
        .arg(Arg::new("file").help("The input file").required(true))
        .arg(Arg::new("rest").help("More files").num_args(0..).action(ArgAction::Append))
        .arg(Arg::new("name").short('n').long("name").help("Your name").default_value("world"))
        .arg(Arg::new("verbose").short('v').long("verbose").action(ArgAction::Count).help("More output"))
        .arg(Arg::new("quiet").short('q').long("quiet").action(ArgAction::SetTrue).help("Less output"))
        .arg(Arg::new("port").short('p').long("port").value_name("PORT").help("Port to use"))
        .arg(Arg::new("tag").short('t').long("tag").action(ArgAction::Append).help("Tags (repeatable)"))
        .subcommand(Command::new("add").about("Adds things").arg(Arg::new("item").required(true).help("What to add")).arg(Arg::new("force").short('f').long("force").action(ArgAction::SetTrue)))
        .subcommand(Command::new("list").about("Lists things"))
}
fn run(args: &[&str]) {
    let mut v = Vec::from(["prog"]);
    v.extend_from_slice(args);
    println(`$ ${args.join(" ")}`);
    match cmd().try_get_matches_from(v) {
        Ok(m) => {
            let rest: Option<Vec<String>> = match m.get_many::<String>("rest") { Some(x) => Some(x.collect()), None => None };
            let tags: Option<Vec<String>> = match m.get_many::<String>("tag") { Some(x) => Some(x.collect()), None => None };
            println(`file=${m.get_one::<String>("file"):?} rest=${rest:?} name=${m.get_one::<String>("name"):?} verbose=${m.get_count("verbose")} quiet=${m.get_flag("quiet")} port=${m.get_one::<String>("port"):?} tags=${tags:?}`);
            match m.subcommand() {
                Some((n, s)) => println(`sub ${n} item=${s.try_get_one::<String>("item").ok().flatten():?} force=${s.try_get_one::<bool>("force").ok().flatten():?}`),
                None => println("no sub"),
            }
        }
        Err(e) => { println(`exit ${e.exit_code()} ---`); std::io::print(e.render()); println("---"); }
    }
}
fn main() {
    run(&["a.txt"]);
    run(&["a.txt", "b", "c", "-vvv", "-q", "--name=bob", "-p", "80", "-t", "x", "--tag", "y"]);
    run(&["-n", "al", "--", "-file", "--x"]);
    run(&["a.txt", "-pp80"]);
    run(&["a.txt", "add", "thing", "-f"]);
    run(&["a.txt", "list"]);
    run(&[]);
    run(&["a.txt", "--nme", "x"]);
    run(&["a.txt", "--bogus"]);
    run(&["a.txt", "-x"]);
    run(&["a.txt", "--name"]);
    run(&["a.txt", "--quiet=yes"]);
    run(&["a.txt", "add"]);
    run(&["--help"]);
    run(&["-h"]);
    run(&["a.txt", "add", "--help"]);
    run(&["--version"]);
    run(&["a.txt", "-q", "-q"]);
    run(&["a.txt", "lst"]);
}
