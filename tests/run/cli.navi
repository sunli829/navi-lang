// std::cli: options, flags, counters, positionals, subcommands, help, version and
// errors; the expected lines are clap 4.6's
// output for the same program.
use std::cli::{Arg, ArgAction, Command};
fn cmd() -> Command {
    Command::new("prog")
        .version("1.2.3")
        .about("Does awesome things")
        .arg(Arg::new("file").help("The input file").required(true))
        .arg(Arg::new("rest").help("More files").num_args(0..).action(ArgAction::Append))
        .arg(Arg::new("name").short('n').long("name").help("Your name").default_value("world"))
        .arg(Arg::new("verbose").short('v').long("verbose").action(ArgAction::Count).help("More output"))
        .arg(Arg::new("quiet").short('q').long("quiet").action(ArgAction::SetTrue).help("Less output"))
        .arg(Arg::new("port").short('p').long("port").value_name("PORT").help("Port to use"))
        .arg(Arg::new("tag").short('t').long("tag").action(ArgAction::Append).help("Tags (repeatable)"))
        .subcommand(Command::new("add").about("Adds things").arg(Arg::new("item").required(true).help("What to add")).arg(Arg::new("force").short('f').long("force").action(ArgAction::SetTrue)))
        .subcommand(Command::new("list").about("Lists things"))
}

// What the program prints for these arguments: the matches, or the exit
// code and the rendered error (or help, or version).
fn run(args: &[&str]) -> String {
    let mut v = Vec::from(["prog"]);
    v.extend_from_slice(args);
    match cmd().try_get_matches_from(v) {
        Ok(m) => {
            let rest: Option<Vec<String>> = match m.get_many::<String>("rest") { Some(x) => Some(x.collect()), None => None };
            let tags: Option<Vec<String>> = match m.get_many::<String>("tag") { Some(x) => Some(x.collect()), None => None };
            let mut out = `file=${m.get_one::<String>("file"):?} rest=${rest:?} name=${m.get_one::<String>("name"):?} verbose=${m.get_count("verbose")} quiet=${m.get_flag("quiet")} port=${m.get_one::<String>("port"):?} tags=${tags:?}\n`.to_string();
            match m.subcommand() {
                Some((n, s)) => out.push_str(`sub ${n} item=${s.try_get_one::<String>("item").ok().flatten():?} force=${s.try_get_one::<bool>("force").ok().flatten():?}\n`.to_string().as_str()),
                None => out.push_str("no sub\n"),
            }
            out
        }
        Err(e) => `exit ${e.exit_code()}\n${e.render()}`.to_string(),
    }
}

// The lines, each ended by a newline.
fn lines(ls: &[&str]) -> String {
    let mut s = String::new();
    for l in ls { s.push_str(l); s.push_str("\n"); }
    s
}

#[test]
fn positional_with_defaults() {
    assert_eq(run(&["a.txt"]), lines(&["file=Some(\"a.txt\") rest=None name=Some(\"world\") verbose=0 quiet=false port=None tags=None", "no sub"]));
}

#[test]
fn options_flags_counters_and_appends() {
    assert_eq(run(&["a.txt", "b", "c", "-vvv", "-q", "--name=bob", "-p", "80", "-t", "x", "--tag", "y"]), lines(&["file=Some(\"a.txt\") rest=Some([\"b\", \"c\"]) name=Some(\"bob\") verbose=3 quiet=true port=Some(\"80\") tags=Some([\"x\", \"y\"])", "no sub"]));
    assert_eq(run(&["a.txt", "-pp80"]), lines(&["file=Some(\"a.txt\") rest=None name=Some(\"world\") verbose=0 quiet=false port=Some(\"p80\") tags=None", "no sub"]));
}

#[test]
fn double_dash_ends_options() {
    assert_eq(run(&["-n", "al", "--", "-file", "--x"]), lines(&["file=Some(\"-file\") rest=Some([\"--x\"]) name=Some(\"al\") verbose=0 quiet=false port=None tags=None", "no sub"]));
}

#[test]
fn subcommands() {
    assert_eq(run(&["a.txt", "add", "thing", "-f"]), lines(&["file=Some(\"a.txt\") rest=None name=Some(\"world\") verbose=0 quiet=false port=None tags=None", "sub add item=Some(\"thing\") force=Some(true)"]));
    assert_eq(run(&["a.txt", "list"]), lines(&["file=Some(\"a.txt\") rest=None name=Some(\"world\") verbose=0 quiet=false port=None tags=None", "sub list item=None force=None"]));
}

#[test]
fn unknown_subcommand_is_a_positional() {
    assert_eq(run(&["a.txt", "lst"]), lines(&["file=Some(\"a.txt\") rest=Some([\"lst\"]) name=Some(\"world\") verbose=0 quiet=false port=None tags=None", "no sub"]));
}

#[test]
fn missing_required_argument() {
    assert_eq(run(&[]), lines(&[
        "exit 2",
        "error: the following required arguments were not provided:",
        "  <file>",
        "",
        "Usage: prog <file> [rest]...",
        "",
        "For more information, try '--help'.",
    ]));
    assert_eq(run(&["a.txt", "add"]), lines(&[
        "exit 2",
        "error: the following required arguments were not provided:",
        "  <item>",
        "",
        "Usage: prog <file> add <item>",
        "",
        "For more information, try '--help'.",
    ]));
}

#[test]
fn unexpected_arguments_with_tips() {
    assert_eq(run(&["a.txt", "--nme", "x"]), lines(&[
        "exit 2",
        "error: unexpected argument '--nme' found",
        "",
        "  tip: a similar argument exists: '--name'",
        "",
        "Usage: prog --name <name> <file> [rest]...",
        "",
        "For more information, try '--help'.",
    ]));
    assert_eq(run(&["a.txt", "--bogus"]), lines(&[
        "exit 2",
        "error: unexpected argument '--bogus' found",
        "",
        "  tip: to pass '--bogus' as a value, use '-- --bogus'",
        "",
        "Usage: prog <file> [rest]...",
        "",
        "For more information, try '--help'.",
    ]));
    assert_eq(run(&["a.txt", "-x"]), lines(&[
        "exit 2",
        "error: unexpected argument '-x' found",
        "",
        "  tip: to pass '-x' as a value, use '-- -x'",
        "",
        "Usage: prog [OPTIONS] <file> [rest]... [COMMAND]",
        "",
        "For more information, try '--help'.",
    ]));
}

#[test]
fn value_errors() {
    assert_eq(run(&["a.txt", "--name"]), lines(&[
        "exit 2",
        "error: a value is required for '--name <name>' but none was supplied",
        "",
        "For more information, try '--help'.",
    ]));
    assert_eq(run(&["a.txt", "--quiet=yes"]), lines(&[
        "exit 2",
        "error: unexpected value 'yes' for '--quiet' found; no more were expected",
        "",
        "Usage: prog --quiet <file> [rest]...",
        "",
        "For more information, try '--help'.",
    ]));
    assert_eq(run(&["a.txt", "-q", "-q"]), lines(&[
        "exit 2",
        "error: the argument '--quiet' cannot be used multiple times",
        "",
        "Usage: prog [OPTIONS] <file> [rest]... [COMMAND]",
        "",
        "For more information, try '--help'.",
    ]));
}

#[test]
fn help() {
    assert_eq(run(&["--help"]), lines(&[
        "exit 0",
        "Does awesome things",
        "",
        "Usage: prog [OPTIONS] <file> [rest]... [COMMAND]",
        "",
        "Commands:",
        "  add   Adds things",
        "  list  Lists things",
        "  help  Print this message or the help of the given subcommand(s)",
        "",
        "Arguments:",
        "  <file>     The input file",
        "  [rest]...  More files",
        "",
        "Options:",
        "  -n, --name <name>  Your name [default: world]",
        "  -v, --verbose...   More output",
        "  -q, --quiet        Less output",
        "  -p, --port <PORT>  Port to use",
        "  -t, --tag <tag>    Tags (repeatable)",
        "  -h, --help         Print help",
        "  -V, --version      Print version",
    ]));
    assert_eq(run(&["-h"]), lines(&[
        "exit 0",
        "Does awesome things",
        "",
        "Usage: prog [OPTIONS] <file> [rest]... [COMMAND]",
        "",
        "Commands:",
        "  add   Adds things",
        "  list  Lists things",
        "  help  Print this message or the help of the given subcommand(s)",
        "",
        "Arguments:",
        "  <file>     The input file",
        "  [rest]...  More files",
        "",
        "Options:",
        "  -n, --name <name>  Your name [default: world]",
        "  -v, --verbose...   More output",
        "  -q, --quiet        Less output",
        "  -p, --port <PORT>  Port to use",
        "  -t, --tag <tag>    Tags (repeatable)",
        "  -h, --help         Print help",
        "  -V, --version      Print version",
    ]));
    assert_eq(run(&["a.txt", "add", "--help"]), lines(&[
        "exit 0",
        "Adds things",
        "",
        "Usage: prog <file> add [OPTIONS] <item>",
        "",
        "Arguments:",
        "  <item>  What to add",
        "",
        "Options:",
        "  -f, --force  ",
        "  -h, --help   Print help",
    ]));
}

#[test]
fn version() {
    assert_eq(run(&["--version"]), lines(&[
        "exit 0",
        "prog 1.2.3",
    ]));
}
