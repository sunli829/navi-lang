// std::net: addresses, a TCP echo server with 100 clients, read timeouts, refused connections, UDP.
use std::net::{TcpListener, TcpStream, UdpSocket, SocketAddr, IpAddr, Ipv4Addr, Ipv6Addr, ToSocketAddrs, Shutdown};
use std::io::{Read, Write};
use std::thread;
use std::time::{Duration, Instant};

#[test]
fn addresses() {
    let a: SocketAddr = "127.0.0.1:8080".parse().unwrap();
    let b: SocketAddr = "[2001:db8::1]:443".parse().unwrap();
    let c: Ipv6Addr = "fe80:0:0:0:1:0:0:1".parse().unwrap();
    let d: IpAddr = "::ffff:10.0.0.1".parse().unwrap();
    assert_eq(`${a} ${b} ${c} ${d}`.as_str(), "127.0.0.1:8080 [2001:db8::1]:443 fe80::1:0:0:1 ::ffff:10.0.0.1");
    assert_eq(a.port(), 8080);
    assert(b.is_ipv6());
    assert("1.2.3".parse::<Ipv4Addr>().is_err());
    assert("1::2::3".parse::<Ipv6Addr>().is_err());
    assert_eq(`${Ipv6Addr::LOCALHOST} ${Ipv6Addr::UNSPECIFIED}`.as_str(), "::1 ::");
    assert(Ipv4Addr::new(192, 168, 1, 1).is_private());
}

#[test]
fn resolve_localhost() {
    let mut found = false;
    for x in "localhost:80".to_socket_addrs().unwrap() { if x.ip().is_loopback() && x.port() == 80 { found = true; } }
    assert(found);
}

#[test]
fn tcp_echo_many_clients() {
    let l = TcpListener::bind("127.0.0.1:0").unwrap();
    let addr = l.local_addr().unwrap();
    assert(l.set_ttl(64).is_ok());
    let server = thread::spawn(|| {
        let mut n = 0;
        while n < 100 {
            let (s, _) = l.accept().unwrap();
            thread::spawn(|| {
                let mut s2 = s;
                let mut buf = [0u8; 64];
                loop {
                    let k = s2.read(&mut buf).unwrap();
                    if k == 0 { break; }
                    s2.write_all(&buf[0..k]).unwrap();
                }
                s2.close();
            });
            n += 1;
        }
    });
    let mut hs = Vec::new();
    let mut i = 0;
    while i < 100 {
        let k = i;
        hs.push(thread::spawn(|| {
            let mut s = TcpStream::connect(addr.clone()).unwrap();
            let msg = `hello ${k}`;
            s.write_all(msg.as_bytes()).unwrap();
            s.shutdown(Shutdown::Write).unwrap();
            let mut got = String::new();
            s.read_to_string(&mut got).unwrap();
            s.close();
            got == msg
        }));
        i += 1;
    }
    let mut ok = 0;
    for h in hs.iter() { if h.join().unwrap() { ok += 1; } }
    server.join().unwrap();
    l.close();
    assert_eq(ok, 100);
}

#[test]
fn read_timeout_and_refused() {
    let l2 = TcpListener::bind("127.0.0.1:0").unwrap();
    let a2 = l2.local_addr().unwrap();
    let keep = thread::spawn(|| { let (s, _) = l2.accept().unwrap(); thread::sleep(Duration::from_millis(300)); s.close(); });
    let mut c2 = TcpStream::connect(a2).unwrap();
    c2.set_read_timeout(Some(Duration::from_millis(50))).unwrap();
    let t0 = Instant::now();
    let mut buf = [0u8; 8];
    let r = c2.read(&mut buf);
    let elapsed = t0.elapsed();
    assert(r.is_err());
    assert(elapsed < Duration::from_millis(250));
    c2.close();
    keep.join().unwrap();
    l2.close();
    // Connection refused.
    assert(TcpStream::connect(a2).is_err());
}

#[test]
fn udp() {
    let u1 = UdpSocket::bind("127.0.0.1:0").unwrap();
    let u2 = UdpSocket::bind("127.0.0.1:0").unwrap();
    let p2 = u2.local_addr().unwrap();
    let rx = thread::spawn(|| {
        let mut b = [0u8; 32];
        let (n, from) = u2.recv_from(&mut b).unwrap();
        u2.send_to(&b[0..n], from).unwrap();
        n
    });
    u1.send_to("ping".as_bytes(), p2).unwrap();
    let mut rb = [0u8; 32];
    let (n, _) = u1.recv_from(&mut rb).unwrap();
    assert_eq(rx.join().unwrap(), 4);
    assert_eq(std::str::from_utf8(&rb[0..n]).unwrap(), "ping");
    // A datagram longer than the buffer: what fits, and no error.
    let u3 = UdpSocket::bind("127.0.0.1:0").unwrap();
    u1.send_to("long datagram".as_bytes(), u3.local_addr().unwrap()).unwrap();
    let mut small = [0u8; 4];
    let (k, _) = u3.recv_from(&mut small).unwrap();
    assert_eq(k, 4);
    assert_eq(std::str::from_utf8(&small[0..k]).unwrap(), "long");
    u3.close();
    u1.close();
    u2.close();
}
