// std numeric methods: integer pow/euclid/bit/log/checked/saturating/wrapping
// operations, 128-bit integers, conversions, f64/f32 math and printing,
// comparisons and Ordering.
use std::f64::consts::PI;
use std::cmp::Ordering;

#[test]
fn int_pow() {
    assert_eq(2i32.pow(10), 1024);
    assert_eq(3u64.pow(0), 1);
    assert_eq((-2i64).pow(3), -8);
    assert_eq(2i32.checked_pow(31), None);
    assert_eq(2i32.checked_pow(30), Some(1073741824));
    assert_eq(2u8.saturating_pow(9), 255);
    assert_eq((-2i8).saturating_pow(9), -128);
}

#[test]
fn int_euclid_and_rounding_up() {
    assert_eq((-7i32).rem_euclid(3), 2);
    assert_eq((-7i32).div_euclid(3), -3);
    assert_eq(7i32.div_euclid(-3), -2);
    assert_eq((-7i32).rem_euclid(-3), 2);
    assert_eq(7u32.div_ceil(2), 4);
    assert_eq(7u32.next_multiple_of(4), 8);
}

#[test]
fn int_bytes_and_bits() {
    assert_eq(`${0x1234u16.swap_bytes():x}`.to_string(), "3412");
    assert_eq(0x12345678u32.to_be_bytes(), [18u8, 52, 86, 120]);
    assert_eq(`${u32::from_be_bytes([0x12, 0x34, 0x56, 0x78]):x}`.to_string(), "12345678");
    assert_eq(1u8.reverse_bits(), 128);
    assert_eq(0b1011u8.trailing_ones(), 2);
}

#[test]
fn int_logs_and_sqrt() {
    assert_eq(1000u32.ilog10(), 3);
    assert_eq(1024u64.ilog2(), 10);
    assert_eq(81i32.ilog(3), 4);
    assert_eq(0u32.checked_ilog2(), None);
    assert_eq(99u64.isqrt(), 9);
    assert_eq(1000000000000i64.isqrt(), 1000000);
    assert_eq((-5i32).abs_diff(10), 15);
}

#[test]
fn int_checked_saturating_wrapping() {
    assert_eq(i32::MIN.checked_abs(), None);
    assert_eq(i32::MIN.saturating_neg(), 2147483647);
    assert_eq(5i32.checked_neg(), Some(-5));
    assert_eq(1u32.checked_shl(32), None);
    assert_eq(1u32.wrapping_shl(33), 2);
    assert_eq(i32::MIN.wrapping_div(-1), -2147483648);
    assert_eq(200u8.checked_next_power_of_two(), None);
    assert_eq(5u32.checked_next_power_of_two(), Some(8));
    assert_eq(i32::MIN.overflowing_neg(), (-2147483648, true));
    assert_eq(3u8.overflowing_pow(6), (217u8, true));
}

#[test]
fn int128() {
    let big: u128 = "340282366920938463463374607431768211455".parse().unwrap();
    let neg: i128 = "-170141183460469231731687303715884105728".parse().unwrap();
    assert_eq(`${big}`.to_string(), "340282366920938463463374607431768211455");
    assert_eq(`${neg}`.to_string(), "-170141183460469231731687303715884105728");
    assert(big == u128::MAX);
    assert(neg == i128::MIN);
    assert("340282366920938463463374607431768211456".parse::<u128>().is_err());
    assert_eq(`${u128::from_str_radix("ff", 16):?}`.to_string(), "Ok(255)");
    assert_eq((1u128 << 100).ilog2(), 100);
    assert_eq(`${3u128.pow(70)}`.to_string(), "2503155504993241601315571986085849");
    assert_eq((5i128).rem_euclid(-3), 2);
    assert_eq(u128::from_le_bytes(7u128.to_le_bytes()), 7);
}

#[test]
fn int_conversions() {
    let a: i64 = i64::from(5i32);
    let b: Result<u8, std::num::TryFromIntError> = u8::try_from(300i32);
    let c: Result<i8, std::num::TryFromIntError> = (-5i64).try_into();
    let d: u32 = u32::try_from(-1i32).unwrap_or(7);
    assert_eq(a, 5);
    assert(b.is_err());
    assert_eq(`${c:?}`.to_string(), "Ok(-5)");
    assert_eq(d, 7);
    assert_eq(u64::from(true), 1);
    assert_eq(`${f64::from(3u32)}`.to_string(), "3");
    assert_eq(i128::from(-3i64), -3);
    assert_eq(`${u16::try_from(65535u128):?}`.to_string(), "Ok(65535)");
}

#[test]
fn f64_math() {
    assert_eq(`${(PI / 2.0).sin()} ${0.0f64.cos()} ${1.0f64.exp()} ${std::f64::consts::E.ln()} ${8.0f64.log2()} ${1000.0f64.log10()} ${2.0f64.powf(0.5)}`.to_string(),
        "1 1 2.718281828459045 1 3 3 1.4142135623730951");
    assert_eq(`${3.0f64.hypot(4.0)} ${1.0f64.atan2(1.0) * 4.0} ${180.0f64.to_radians()} ${PI.to_degrees()} ${27.0f64.cbrt()} ${5.5f64.clamp(1.0, 3.0)}`.to_string(),
        "5 3.141592653589793 3.141592653589793 180 3 3");
    assert_eq(`${(-3.7f64).fract()} ${(-0.0f64).signum()} ${2.5f64.round_ties_even()} ${3.5f64.round_ties_even()} ${(-7.5f64).rem_euclid(2.0)} ${(-7.5f64).div_euclid(2.0)}`.to_string(),
        "-0.7000000000000002 -1 2 4 0.5 -4");
}

#[test]
fn f64_classification_and_total_cmp() {
    assert_eq(1.0f64.total_cmp(&f64::NAN), Ordering::Less);
    assert_eq((-0.0f64).total_cmp(&0.0), Ordering::Less);
    assert_eq(`${f64::NAN.classify():?}`.to_string(), "Nan");
    assert(1e-310f64.is_subnormal());
    assert(1.0f64.is_normal());
}

#[test]
fn f32_math() {
    assert_eq(`${2.5f32.round()} ${2.0f32.powi(3)} ${2.0f32.sqrt()} ${std::f32::consts::PI} ${1.5f32.max(2.5)} ${f32::MAX} ${2.0f32.mul_add(3.0, 1.0)}`.to_string(),
        "3 8 1.4142135 3.1415927 2.5 340282350000000000000000000000000000000 7");
}

#[test]
fn bits_bytes_clamp_and_ordering() {
    assert_eq(`${f64::from_bits(1.5f64.to_bits())} ${f64::from_le_bytes(2.25f64.to_le_bytes())}`.to_string(), "1.5 2.25");
    assert_eq(7i32.clamp(1, 5), 5);
    assert_eq((-3i64).clamp(0, 9), 0);
    assert_eq(std::cmp::Reverse(3) < std::cmp::Reverse(5), false);
    assert_eq(1.cmp(&2).then(Ordering::Greater), Ordering::Less);
}
