// stage0: skip (integer and float methods and conversions added for navic: std hides them from stage0)
// out: 1024 1 -8 None Some(1073741824) 255 -128
// out: 2 -3 -2 2 4 8
// out: 3412 [18, 52, 86, 120] 12345678 128 2
// out: 3 10 4 None 9 1000000 15
// out: None 2147483647 Some(-5) None 2 -2147483648
// out: None Some(8) (-2147483648, true) (217, true)
// out: 340282366920938463463374607431768211455 -170141183460469231731687303715884105728 true true true
// out: Ok(255) 100 2503155504993241601315571986085849 2 7
// out: 5 true Ok(-5) 7 1 3 -3 Ok(65535)
// out: 1 1 2.718281828459045 1 3 3 1.4142135623730951
// out: 5 3.141592653589793 3.141592653589793 180 3 3
// out: -0.7000000000000002 -1 2 4 0.5 -4
// out: Less Less Nan true true
// out: 3 8 1.4142135 3.1415927 2.5 340282350000000000000000000000000000000 7
// out: 1.5 2.25 5 0 false Less
use std::f64::consts::PI;

fn main() {
    println(`${2i32.pow(10)} ${3u64.pow(0)} ${(-2i64).pow(3)} ${2i32.checked_pow(31):?} ${2i32.checked_pow(30):?} ${2u8.saturating_pow(9)} ${(-2i8).saturating_pow(9)}`);
    println(`${(-7i32).rem_euclid(3)} ${(-7i32).div_euclid(3)} ${7i32.div_euclid(-3)} ${(-7i32).rem_euclid(-3)} ${7u32.div_ceil(2)} ${7u32.next_multiple_of(4)}`);
    println(`${0x1234u16.swap_bytes():x} ${0x12345678u32.to_be_bytes():?} ${u32::from_be_bytes([0x12, 0x34, 0x56, 0x78]):x} ${1u8.reverse_bits()} ${0b1011u8.trailing_ones()}`);
    println(`${1000u32.ilog10()} ${1024u64.ilog2()} ${81i32.ilog(3)} ${0u32.checked_ilog2():?} ${99u64.isqrt()} ${1000000000000i64.isqrt()} ${(-5i32).abs_diff(10)}`);
    println(`${i32::MIN.checked_abs():?} ${i32::MIN.saturating_neg()} ${5i32.checked_neg():?} ${1u32.checked_shl(32):?} ${1u32.wrapping_shl(33)} ${i32::MIN.wrapping_div(-1)}`);
    println(`${200u8.checked_next_power_of_two():?} ${5u32.checked_next_power_of_two():?} ${i32::MIN.overflowing_neg():?} ${3u8.overflowing_pow(6):?}`);
    let big: u128 = "340282366920938463463374607431768211455".parse().unwrap();
    let neg: i128 = "-170141183460469231731687303715884105728".parse().unwrap();
    println(`${big} ${neg} ${big == u128::MAX} ${neg == i128::MIN} ${"340282366920938463463374607431768211456".parse::<u128>().is_err()}`);
    println(`${u128::from_str_radix("ff", 16):?} ${(1u128 << 100).ilog2()} ${3u128.pow(70)} ${(5i128).rem_euclid(-3)} ${u128::from_le_bytes(7u128.to_le_bytes())}`);
    let a: i64 = i64::from(5i32);
    let b: Result<u8, std::num::TryFromIntError> = u8::try_from(300i32);
    let c: Result<i8, std::num::TryFromIntError> = (-5i64).try_into();
    let d: u32 = u32::try_from(-1i32).unwrap_or(7);
    println(`${a} ${b.is_err()} ${c:?} ${d} ${u64::from(true)} ${f64::from(3u32)} ${i128::from(-3i64)} ${u16::try_from(65535u128):?}`);
    println(`${(PI / 2.0).sin()} ${0.0f64.cos()} ${1.0f64.exp()} ${std::f64::consts::E.ln()} ${8.0f64.log2()} ${1000.0f64.log10()} ${2.0f64.powf(0.5)}`);
    println(`${3.0f64.hypot(4.0)} ${1.0f64.atan2(1.0) * 4.0} ${180.0f64.to_radians()} ${PI.to_degrees()} ${27.0f64.cbrt()} ${5.5f64.clamp(1.0, 3.0)}`);
    println(`${(-3.7f64).fract()} ${(-0.0f64).signum()} ${2.5f64.round_ties_even()} ${3.5f64.round_ties_even()} ${(-7.5f64).rem_euclid(2.0)} ${(-7.5f64).div_euclid(2.0)}`);
    println(`${1.0f64.total_cmp(&f64::NAN):?} ${(-0.0f64).total_cmp(&0.0):?} ${f64::NAN.classify():?} ${1e-310f64.is_subnormal()} ${1.0f64.is_normal()}`);
    println(`${2.5f32.round()} ${2.0f32.powi(3)} ${2.0f32.sqrt()} ${std::f32::consts::PI} ${1.5f32.max(2.5)} ${f32::MAX} ${2.0f32.mul_add(3.0, 1.0)}`);
    println(`${f64::from_bits(1.5f64.to_bits())} ${f64::from_le_bytes(2.25f64.to_le_bytes())} ${7i32.clamp(1, 5)} ${(-3i64).clamp(0, 9)} ${std::cmp::Reverse(3) < std::cmp::Reverse(5)} ${1.cmp(&2).then(std::cmp::Ordering::Greater):?}`);
}
