// Calls of C variadic functions (on Apple arm64 the variadic arguments go
// on the stack; floats are promoted to double; on Windows a variadic float
// goes in both its integer and its float register).
mod c {
    #[cfg(not(target_os = "windows"))]
    extern "C" {
        pub fn snprintf(buf: *mut u8, n: usize, fmt: *const u8, ...) -> i32;
    }
    // ucrtbase.dll has no snprintf (the UCRT headers define it inline);
    // msvcrt.dll has _snprintf.
    #[cfg(target_os = "windows")]
    #[link(name = "msvcrt")]
    extern "C" {
        #[link_name = "_snprintf"]
        pub fn snprintf(buf: *mut u8, n: usize, fmt: *const u8, ...) -> i32;
    }
}

#[test]
fn snprintf_with_variadic_args() {
    let mut buf = [0u8; 64];
    let n = unsafe { c::snprintf(&mut buf as *mut [u8; 64] as *mut u8, 64, "%d %s %.2f %lld %.2f [%d]\0".as_ptr(), 42, "x\0".as_ptr(), 3.5f64, -7i64, 1.25f32, 9) };
    let s = std::str::from_utf8(&buf[0..n as usize]).unwrap();
    assert_eq(s, "42 x 3.50 -7 1.25 [9]");
    assert_eq(n, 21);
}
