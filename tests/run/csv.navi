// std::csv: reading (quotes, escapes, CRLF, blank and comment lines, trimming,
// positions, unequal lengths), records into structs by header names,
// writing (quote styles, serialize with a header row); the expected values
// are the csv crate 1.4's output for the same program but for the
// positions of records after a CRLF or a quoted line break (navi gives the
// record's first byte and its line).
use std::csv::{ReaderBuilder, WriterBuilder, QuoteStyle, Trim, StringRecord};

#[derive(Debug, Clone, Default)]
struct Person { name: String, age: u32, score: Option<f64>, active: bool }

fn lines(xs: &[&str]) -> String {
    let mut s = String::new();
    for x in xs { s.push_str(x); s.push('\n'); }
    s
}

fn written(w: std::csv::Writer<Vec<u8>>) -> String { String::from_utf8(w.into_inner().unwrap()).unwrap() }

#[test]
fn read_quotes_and_positions() {
    let data = "name,age,note\r\nalice,30,\"likes, commas\"\nbob,25,\"multi\nline \"\"quoted\"\"\"\n\ncarol,41,plain";
    let mut r = ReaderBuilder::new().from_reader(data.as_bytes());
    assert_eq(`${r.headers().unwrap():?}`.as_str(), "StringRecord([\"name\", \"age\", \"note\"])");
    let mut out = String::new();
    for rec in r.records() {
        let rec = rec.unwrap();
        let p = rec.position().unwrap();
        out.push_str(&`${rec:?} len=${rec.len()} line=${p.line()} byte=${p.byte()} record=${p.record()}\n`);
    }
    assert_eq(out, lines(&[
        "StringRecord([\"alice\", \"30\", \"likes, commas\"]) len=3 line=2 byte=15 record=1",
        "StringRecord([\"bob\", \"25\", \"multi\\nline \\\"quoted\\\"\"]) len=3 line=3 byte=40 record=2",
        "StringRecord([\"carol\", \"41\", \"plain\"]) len=3 line=6 byte=72 record=3",
    ]));
}

#[test]
fn unequal_lengths() {
    let bad = "a,b\n1,2\n3,4,5\n";
    let mut r = ReaderBuilder::new().from_reader(bad.as_bytes());
    let mut out = String::new();
    for rec in r.records() { match rec { Ok(x) => out.push_str(&`ok ${x:?}\n`), Err(e) => out.push_str(&`err ${e}\n`) } }
    assert_eq(out, lines(&[
        "ok StringRecord([\"1\", \"2\"])",
        "err CSV error: record 2 (line: 3, byte: 8): found record with 3 fields, but the previous record has 2 fields",
    ]));
    let mut r = ReaderBuilder::new().flexible(true).from_reader(bad.as_bytes());
    let mut out = String::new();
    for rec in r.records() { out.push_str(&`flex ${rec.unwrap():?}\n`); }
    assert_eq(out.as_str(), "flex StringRecord([\"1\", \"2\"])\nflex StringRecord([\"3\", \"4\", \"5\"])\n");
}

#[test]
fn delimiter_comment_trim() {
    let semi = "# comment\n x ; y \n1;  2 \n";
    let mut r = ReaderBuilder::new().delimiter(b';').has_headers(false).comment(Some(b'#')).trim(Trim::All).from_reader(semi.as_bytes());
    let mut out = String::new();
    for rec in r.records() { out.push_str(&`semi ${rec.unwrap():?}\n`); }
    assert_eq(out.as_str(), "semi StringRecord([\"x\", \"y\"])\nsemi StringRecord([\"1\", \"2\"])\n");
}

#[test]
fn quote_char_and_no_quoting() {
    let q = "\"a\"b,\"c\nd\",'e,f'\n";
    let mut r = ReaderBuilder::new().has_headers(false).from_reader(q.as_bytes());
    let mut out = String::new();
    for rec in r.records() { out.push_str(&`q ${rec.unwrap():?}\n`); }
    assert_eq(out.as_str(), "q StringRecord([\"ab\", \"c\\nd\", \"'e\", \"f'\"])\n");
    let mut r = ReaderBuilder::new().has_headers(false).quote(b'\'').from_reader(q.as_bytes());
    let mut out = String::new();
    for rec in r.records() { out.push_str(&`q' ${rec.unwrap():?}\n`); }
    assert_eq(out.as_str(), "q' StringRecord([\"\\\"a\\\"b\", \"\\\"c\"])\nq' StringRecord([\"d\\\"\", \"e,f\"])\n");
    let mut r = ReaderBuilder::new().has_headers(false).quoting(false).from_reader("\"a,b\"\n".as_bytes());
    let mut out = String::new();
    for rec in r.records() { out.push_str(&`noq ${rec.unwrap():?}\n`); }
    assert_eq(out.as_str(), "noq StringRecord([\"\\\"a\", \"b\\\"\"])\n");
}

#[test]
fn deserialize() {
    let people = "name,active,age,score\nann,true,30,1.5\nben,false,40,\n";
    let mut r = ReaderBuilder::new().from_reader(people.as_bytes());
    let mut out = String::new();
    for p in r.deserialize::<Person>() { out.push_str(&`${p.unwrap():?}\n`); }
    assert_eq(out, lines(&[
        "Person { name: \"ann\", age: 30, score: Some(1.5), active: true }",
        "Person { name: \"ben\", age: 40, score: None, active: false }",
    ]));
    let badp = "name,active,age,score\nann,true,thirty,1.5\ncat,maybe,3,\n";
    let mut r = ReaderBuilder::new().from_reader(badp.as_bytes());
    let mut out = String::new();
    for p in r.deserialize::<Person>() { match p { Ok(x) => out.push_str(&`${x:?}\n`), Err(e) => out.push_str(&`err ${e}\n`) } }
    assert_eq(out, lines(&[
        "err CSV deserialize error: record 1 (line: 2, byte: 22): field 2: invalid digit found in string",
        "err CSV deserialize error: record 2 (line: 3, byte: 42): field 1: provided string was not `true` or `false`",
    ]));
    let mut r = ReaderBuilder::new().has_headers(false).from_reader("x,1\n".as_bytes());
    let mut out = String::new();
    for p in r.deserialize::<(String, i32)>() { out.push_str(&`tuple ${p.unwrap():?}\n`); }
    assert_eq(out.as_str(), "tuple (\"x\", 1)\n");
}

#[test]
fn write_records() {
    let mut w = WriterBuilder::new().from_writer(Vec::new());
    w.write_record(&["plain", "with,comma", "with \"quote\"", "line\nbreak", "", " pad "]).unwrap();
    w.write_record(&["1", "2.5", "x", "y", "z", "w"]).unwrap();
    assert_eq(written(w).as_str(), "plain,\"with,comma\",\"with \"\"quote\"\"\",\"line\nbreak\",, pad \n1,2.5,x,y,z,w\n");
}

#[test]
fn quote_styles() {
    let mut out = String::new();
    for (n, qs) in [("always", QuoteStyle::Always), ("nonnumeric", QuoteStyle::NonNumeric), ("never", QuoteStyle::Never)].iter() {
        let mut w = WriterBuilder::new().quote_style(qs.clone()).delimiter(b'\t').from_writer(Vec::new());
        w.write_record(&["a b", "12", "-3.5", "x\ty"]).unwrap();
        out.push_str(&`${n} ${written(w):?}\n`);
    }
    assert_eq(out, lines(&[
        "always \"\\\"a b\\\"\\t\\\"12\\\"\\t\\\"-3.5\\\"\\t\\\"x\\ty\\\"\\n\"",
        "nonnumeric \"\\\"a b\\\"\\t12\\t-3.5\\t\\\"x\\ty\\\"\\n\"",
        "never \"a b\\t12\\t-3.5\\tx\\ty\\n\"",
    ]));
}

#[test]
fn serialize_with_header() {
    let mut w = WriterBuilder::new().from_writer(Vec::new());
    w.serialize(&Person { name: "ann".to_string(), age: 30, score: Some(1.0), active: true }).unwrap();
    w.serialize(&Person { name: "b,n".to_string(), age: 4, score: None, active: false }).unwrap();
    assert_eq(written(w).as_str(), "name,age,score,active\nann,30,1.0,true\n\"b,n\",4,,false\n");
}

#[test]
fn write_errors_and_edge_cases() {
    let mut w = WriterBuilder::new().from_writer(Vec::new());
    w.write_record(&["a", "b"]).unwrap();
    match w.write_record(&["1"]) {
        Ok(_) => panic("expected an error"),
        Err(e) => assert_eq(`werr ${e}`.as_str(), "werr CSV error: found record with 1 fields, but the previous record has 2 fields"),
    }
    let mut w = WriterBuilder::new().from_writer(Vec::new());
    w.write_record(&[""]).unwrap();
    assert_eq(written(w).as_str(), "\"\"\n");
    let mut w = WriterBuilder::new().from_writer(Vec::new());
    w.write_field("f1").unwrap();
    w.write_field("f2").unwrap();
    let none: Vec<&str> = Vec::new();
    w.write_record(none).unwrap();
    assert_eq(written(w).as_str(), "f1,f2\n");
}

#[test]
fn string_record() {
    let r = StringRecord::from(Vec::from(["a", " b ", "c"]));
    let all: Vec<&str> = r.iter().collect();
    assert_eq(r.get(1), Some(" b "));
    assert_eq(r.get(5), None);
    assert_eq(all, Vec::from(["a", " b ", "c"]));
    assert_eq(`${r.as_slice()}`.as_str(), "a b c");
}
