// Many OS threads allocating at once (collections stop the world) sending
// results over channels, and a pipeline of producers and workers with select.
use std::thread;
use std::sync::mpmc::{channel, sync_channel};
use std::collections::HashMap;

// Allocates on every OS thread at once (collections stop the world).
fn churn(id: u64) -> u64 {
    let mut keep: Vec<String> = Vec::new();
    let mut m: HashMap<u64, Vec<u64>> = HashMap::new();
    let mut sum = 0u64;
    let mut i = 0u64;
    while i < 40000 {
        let s = `t${id}-${i}`;
        if i % 100 == 0 { keep.push(s.clone()); }
        let mut v = Vec::new();
        let mut j = 0;
        while j < (i % 7) { v.push(i + j); j += 1; }
        m.insert(i % 1000, v);
        sum = sum + s.len() as u64;
        i += 1;
    }
    for k in keep.iter() { sum = sum + k.len() as u64; }
    for (_, v) in m.iter() { for x in v.iter() { sum = sum + *x; } }
    sum
}

#[test]
fn churn_on_every_thread() {
    let (tx, rx) = sync_channel::<u64>(2);
    let mut hs = Vec::new();
    let mut k = 0u64;
    while k < 8 {
        let id = k;
        let t = tx.clone();
        hs.push(thread::spawn(|| { let r = churn(id); t.send(r).unwrap(); r }));
        k += 1;
    }
    let mut got = 0u64;
    let mut n = 0;
    while n < 8 { got = got + rx.recv().unwrap(); n += 1; }
    let mut total = 0u64;
    for h in hs.iter() { total = total + h.join().unwrap(); }
    assert_eq(got, total);
    assert_eq(total, 950827840);
}

// A pipeline with select.
#[test]
fn pipeline_with_select() {
    let (a_tx, a_rx) = sync_channel::<Vec<u64>>(4);
    let (out_tx, out_rx) = channel::<u64>();
    let mut p = 0u64;
    while p < 4 {
        let tx2 = a_tx.clone();
        let id = p;
        thread::spawn(|| {
            let mut i = 0u64;
            while i < 5000 {
                let mut v = Vec::new();
                v.push(id);
                v.push(i);
                tx2.send(v).unwrap();
                i += 1;
            }
        });
        p += 1;
    }
    let mut w = 0;
    while w < 4 {
        let ar = a_rx.clone();
        let ot = out_tx.clone();
        thread::spawn(|| {
            loop {
                select {
                    v = ar.recv() => match v {
                        Ok(x) => { ot.send(x[0] + x[1]).unwrap(); }
                        Err(_) => break,
                    },
                }
            }
        });
        w += 1;
    }
    let mut sum = 0u64;
    let mut c = 0;
    while c < 20000 { sum += out_rx.recv().unwrap(); c += 1; }
    assert_eq(c, 20000);
    assert_eq(sum, 50020000);
}
