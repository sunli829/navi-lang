//! What nightly rustfmt does with navi's configuration (edition 2024,
//! normalize_comments, wrap_comments, format_code_in_doc_comments,
//! imports_granularity = "Crate", group_imports = "StdExternalCrate").

use crate::util::x;
use regex::Regex;
use std::io::Write;
use std::collections::HashMap;
use crate::util::{y, z};

/* A block comment on lines of its own becomes line comments. */

#[cfg(not(any(target_arch = "x86_64", all(target_arch = "aarch64", any(target_os = "macos", target_os = "linux")))))]
fn detect() -> bool { false }

#[derive(Codec)]
#[derive(Clone, Debug)]
pub struct Name { x: i32 }

#[allow(dead_code,)]
#[command(name = "navi", arg_required_else_help, after_help = "Compiler switches: -d name[=value],... (navi help debug lists them).")]
pub struct Cli { cmd: i32 }

impl Name {
    #[doc(hidden)]
    /// Documented after an attribute.
    pub fn test_client_hello(&mut self, hello: Vec<u8>, x25519_private: Vec<u8>) -> &mut TlsConnectorBuilder { self }
}

impl<I> ExactSizeIterator for Rev<I> where I: ExactSizeIterator + DoubleEndedIterator {}

