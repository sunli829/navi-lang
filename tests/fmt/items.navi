//! Items: use and mod sorting, structs, enums, impls, traits, signatures.
use std::fmt::{Display,self};
use crate::b::{z, a::{y, x}};
use crate::a;

mod zeta; mod alpha;
pub mod beta;

#[derive(Clone, Debug)]
pub struct Point { pub x: i32, pub y: i32 }
struct Unit;
struct Pair(pub i32,String);
struct Wrap<T> where T: Clone { inner: T }

enum Shape { Circle { r: f64 }, Rect { w: f64, h: f64, label: String, filled: bool }, Empty }
enum Small { A, B(i32), C { x: i32 } }

const LIMIT: usize = 1 << 20;
static mut COUNT: i32 = 0;
type Map<K> = std::collections::HashMap<K, Vec<K>>;

pub trait Area: Display { fn area(&self) -> f64; fn name(&self) -> String { "shape".to_string() } }

impl<T: Clone> Wrap<T> where T: Display {
    pub fn new(inner: T) -> Wrap<T> { Wrap { inner } }
    fn long_signature(&self, first_argument: i32, second_argument: String, third_argument: &Vec<i32>) -> Option<String> { None }
}

impl Area for Point {}

extern "C" { fn abs(x: i32) -> i32; static errno: i32; }
