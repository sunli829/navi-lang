/// Doc comment on a function.
fn commented(
    a: i32, // first
    b: i32,
) -> i32 {
    // after the brace

    // own line before a statement
    let x = a + b; // trailing, spaces normalized
    /* block */
    let y = 2;
    let z = foo(
        x, // after x
        y,
    );
    if x > 0 {
        1
    }
    // before else
    else {
        2
    };
    x + y + z
    // before the closing brace
}

struct S {
    a: i32,         // c1
    bbbbbb: String, // c2

    c: u8,
}
