// navi's own syntax: defer, select, templates, destructuring assignment.
fn main() {
    defer println("done");
    defer { cleanup(); report(); }
    let (mut a, mut b) = (1, 2);
    (a, b) = (b, a);
    [a, _] = [b, a];
    let msg = `a=${a} b=${b:?}`;
    let long = `first line
second line ${a}`;
    select { v = rx.recv() => println(`got ${v}`), tx.send(1) => {}, default => { idle(); } }
    if let Some(x) = opt && let Some(y) = other && x < y { println(`${x} ${y}`); }
}
