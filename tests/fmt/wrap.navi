//! Comments wider than the comment width (80 by default) wrap at spaces, and what a broken line leaves over
//! joins the next line of its paragraph.

// --- A section rule wraps like prose (as rustfmt's) when it is wider than the comment width ---------

/// Returns the thing. A long doc comment that goes on and on past the eightieth column of the line.
/// The second line of the paragraph.
///
/// - a list item that is long enough to need wrapping onto a second line of the comment
/// - a short item
///
/// ```
/// let code = "is formatted as code, at 100 columns, not wrapped at the comment width";
/// ```
///     an indented line wraps too when it is wider than the comment width, as in rustfmt
///
/// See https://example.com/a/very/long/url/that/cannot/be/broken/anywhere/because/it/has/no/spaces
fn thing() {
    // A comment inside a function body, indented, that runs well past the comment width.
    let x = 1; // A trailing comment after code stays on its line even when it is long.
}
