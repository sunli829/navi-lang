// quote`...` templates (std::derive) stay as written, holes and all.
use std::derive::{quote, Code};

fn f(t: Code, name: Code, a: Code, many: bool) -> Code {
    let x = match many { true => Some(quote`::std::cli::ValueParser::i64_range(${t}::MIN as i64, ${t}::MAX as i64)`), false => None };
    if many { return quote`${a}.action(::std::cli::ArgAction::Append)`; }
    let long = quote`fn command() -> ::std::cli::Command { <Self as ::std::cli::Args>::augment_args(::std::cli::Command::new(${name})) }`;
    quote`${long} ${x.unwrap()}`.at(a)
}
