enum E { A, B(i32), C { x: bool } }

fn matches(o: Option<i32>, b: bool, e: E, x: u8, t: (bool, bool), s: &[i32], st: &str) {
    match o { Some(_) => {} } // error: non-exhaustive patterns: None not covered
    match b { true => {} } // error: non-exhaustive patterns: false not covered
    match e { E::A => {}, E::B(_) => {} } // error: non-exhaustive patterns: E::C { .. } not covered
    match x { 0..=100 => {} } // error: non-exhaustive patterns: 101..=u8::MAX not covered
    match t { (true, _) => {}, (false, true) => {} } // error: non-exhaustive patterns: (false, false) not covered
    match s { [] => {}, [_] => {} } // error: non-exhaustive patterns: &[_, _, ..] not covered
    match st { "a" => {} } // error: non-exhaustive patterns: &_ not covered
    match o { Some(1) => {}, None => {} } // error: non-exhaustive patterns: Some(i32::MIN..=0) not covered
    let Some(v) = o; // error: refutable pattern in this binding: None not covered
    match e { E::A | E::B(_) | E::C { x: true } => {} } // error: E::C { .. } not covered
}
