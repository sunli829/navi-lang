struct P { x: i32, pub y: i32 }
mod m { pub struct Q { a: i32, pub b: i32 } }

fn want_i32(x: i32) {}
fn returns() -> i32 { "no" } //~ ERROR mismatched types: expected i32, found &str

fn errors(v: Vec<i32>, o: Option<i32>) {
    want_i32("x"); //~ ERROR mismatched types: expected i32, found &str
    want_i32(1, 2); //~ ERROR takes 1 argument but 2 were supplied
    let a: bool = 1; //~ ERROR mismatched types: expected bool, found {integer}
    v.nosuch(); //~ ERROR no method named nosuch found for Vec<i32>
    let p = P { x: 1, y: 2 };
    let z = p.z; //~ ERROR no field z on type P
    let q = m::Q { a: 1, b: 2 }; //~ ERROR field a of Q is private
    let r = P { x: 1 }; //~ ERROR missing field y
    let s = P { x: 1, y: 2, w: 3 }; //~ ERROR P has no field named w
    let t = if true { 1 } else { "s" }; //~ ERROR mismatched types
    let u = 5; u = 6; //~ ERROR cannot assign to immutable variable u
    let w = Vec::new(); w.push(1); //~ ERROR cannot borrow as mutable immutable variable w
    let rr = &mut p; //~ ERROR cannot borrow as mutable immutable variable p
    let k = *5; //~ ERROR type {integer} cannot be dereferenced
    let c = "s" as i32; //~ ERROR invalid cast from &str to i32
    let x = o?; //~ ERROR the ? operator on an Option can only be used in a function that returns Option
    while true { break 5; } //~ ERROR break with a value is only allowed in loop
    let ff = 1.5 + true; //~ ERROR cannot apply + to {float} and bool
    if 1 { } //~ ERROR mismatched types: expected bool, found {integer}
    let n = -5u32; //~ ERROR cannot negate unsigned integer type u32
}

fn shared(p: &P) { p.x = 3; } //~ ERROR cannot assign to data behind a & reference

trait Tr { fn need(&self); }
fn bound<T: Tr>(t: T) {}
fn unsatisfied() { bound(5); } //~ ERROR the trait bound i32: Tr is not satisfied

extern "C" { fn ext(x: i32) -> i32; }
unsafe fn danger() {}
fn unsafe_ops(p: *const u8) {
    ext(1); //~ ERROR call to unsafe function ext requires an unsafe block
    danger(); //~ ERROR requires an unsafe block
    let b = *p; //~ ERROR dereference of raw pointer requires an unsafe block
    unsafe { ext(2); danger(); let c = *p; }
}

trait Sig { type A; fn f(&self, x: i32) -> Self::A; fn g<T>(&self, t: T); }
struct SS;
impl Sig for SS {
    type A = bool;
    fn f(&self, x: u8) -> bool { true } //~ ERROR method f has an incompatible signature for trait Sig
    fn g(&self, t: i32) {} //~ ERROR method g has 0 type parameters but its declaration in trait Sig has 1
}

trait Over {}
impl<T> Over for T {}
impl Over for SS {} //~ ERROR conflicting implementations of trait Over

fn dyn_iter(it: &mut dyn Iterator) {} //~ ERROR the associated type Item of trait Iterator must be specified
fn dyn_map(it: &dyn Iterator<Item = i32>) { it.map(|x| x + 1); } //~ ERROR method map cannot be called on dyn Iterator
fn generic_body<T>(x: T) { x.foo(); } //~ ERROR no method named foo found for T
