#[derive(Debug, Clone)]
enum Token { Ident(String), Num(i64), Sym(char) }

enum Shape { Circle { r: f64 }, Rect(f64, f64), Empty }

fn tokens(ts: &Vec<Token>) -> usize {
    let mut n = 0;
    for t in ts.iter() {
        match t {
            Token::Ident(name) => { let l: &String = name; n += l.len(); }
            Token::Num(v) => { let x: &i64 = v; }
            Token::Sym(_) => {}
        }
        if let Token::Ident(name) = t { let s: &String = name; }
    }
    n
}

fn shapes(s: Shape) -> f64 {
    match s {
        Shape::Circle { r } => r * r,
        Shape::Rect(w, h) if w > 0.0 => w * h,
        Shape::Rect(..) => 0.0,
        Shape::Empty => 0.0,
    }
}

fn ints(x: u8, c: char, b: bool, t: (i32, bool), s: &[i32]) -> i32 {
    let a = match x { 0 => 1, 1..=127 => 2, 128..=255 => 3 };
    let d = match c { 'a'..='z' => 1, _ => 2 };
    let e = match b { true => 1, false => 0 };
    let f = match t { (0, _) => 0, (_, true) => 1, (_, false) => 2 };
    let g = match s { [] => 0, [x] => *x, [first, .., last] => *first + *last };
    let h = match Some(3) { Some(n @ 1..=5) => n, Some(_) | None => 0 };
    a + d + e + f + g + h
}

fn names(s: &str) -> i32 { match s { "admin" => 1, _ => 0 } }

fn opt_ref(o: Option<&Shape>) -> bool {
    match o { Some(&Shape::Empty) => true, Some(_) => false, None => false }
}

fn lets(p: (i32, (i32, i32))) -> i32 {
    let (a, (b, c)) = p;
    let Some(x) = Some(1) else { return 0; };
    a + b + c + x
}
