use std::ops::Add;
use std::fmt;

#[derive(Debug, Clone, PartialEq)]
struct Point { x: f64, y: f64 }

impl Add for Point {
    type Output = Point;
    fn add(self, o: Point) -> Point { Point { x: self.x + o.x, y: self.y + o.y } }
}

impl fmt::Display for Point {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        f.write_fmt(`(${self.x}, ${self.y})`)
    }
}

trait Shape {
    const SIDES: u32;
    fn area(&self) -> f64;
    fn describe(&self) -> String { `${Self::SIDES} sides, area ${self.area()}`.to_string() }
}

struct Sq(f64);
impl Shape for Sq {
    const SIDES: u32 = 4;
    fn area(&self) -> f64 { self.0 * self.0 }
}

impl Sq {
    fn new(s: f64) -> Self { Sq(s) }
    fn grow(&mut self) { self.0 = self.0 * 2.0; }
}

fn total<S: Shape>(shapes: &[S]) -> f64 {
    let mut t = 0.0;
    for s in shapes { t += s.area(); }
    t
}

fn sum_all<I: Iterator<Item = i32>>(it: I) -> i32 { it.fold(0, |a, b| a + b) }

fn items<I>(it: I) -> Option<I::Item> where I: Iterator { let mut i = it; i.next() }

fn dynamic(s: &dyn Shape) -> f64 { s.area() }

fn evens(v: &Vec<i32>) -> impl Iterator<Item = &i32> { v.iter().filter(|x| **x % 2 == 0) }

fn uses() {
    let p = Point { x: 1.0, y: 2.0 } + Point { x: 3.0, y: 4.0 }; // type: Point
    let q = p.clone(); // type: Point
    let same = p == q; // type: bool
    let s = p.to_string(); // type: String
    let mut sq = Sq::new(2.0);
    sq.grow();
    let a = sq.area(); // type: f64
    let d = sq.describe(); // type: String
    let n = Sq::SIDES; // type: u32
    let t = total(&[Sq(1.0), Sq(2.0)]); // type: f64
    let x = dynamic(&sq); // type: f64
    let v = vec_of();
    let e = evens(&v).count(); // type: usize
    let m = sum_all(v.iter().map(|x| *x)); // type: i32
    let f = items(v.iter()); // type: Option<&i32>
    let st = String::from("hi");
    let len = takes_str(&st); // type: usize
    let def: i32 = Default::default();
    let c = std::cmp::max(3, 4); // type: i32
}

fn vec_of() -> Vec<i32> { let mut v = Vec::new(); v.push(1); v }
fn takes_str(s: &str) -> usize { s.len() }
