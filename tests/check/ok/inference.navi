use std::fmt::Display;

fn id<T>(x: T) -> T { x }
fn pair<A, B>(a: A, b: B) -> (A, B) { (a, b) }
fn first<T: Clone>(v: &Vec<T>) -> Option<T> { v.first().cloned() }

fn literals() {
    let a = 1; // type: i32
    let b = 2.5; // type: f64
    let c: u8 = 7; // type: u8
    let d = 3u64 + 4; // type: u64
    let e = id(5i16); // type: i16
    let f = pair("x", 'c'); // type: (&str, char)
    let g = [1, 2, 3]; // type: [i32; 3]
    let h = [0u8; 16]; // type: [u8; 16]
    let i = a as f64 / b; // type: f64
    let j = !true; // type: bool
    let k = -a; // type: i32
    let l = 1 << 3; // type: i32
    let m = a == 2 && b > 1.0; // type: bool
    let n = (); // type: ()
}

fn collections() {
    let mut v = Vec::new(); // type: Vec<i32>
    v.push(1);
    let n = v.len(); // type: usize
    let x = v[0]; // type: i32
    let s = &v[0..2]; // type: &[i32]
    let o = first(&v); // type: Option<i32>
    let mut names: Vec<String> = Vec::new();
    names.push(String::from("a"));
    let r: &str = &names[0];
    let t = v.iter().map(|x| *x * 2).count(); // type: usize
    for e in &v { let y = *e + 1; }
    for e in &mut v { *e += 1; }
    for i in 0..10 { let z = i; }
    let w = v.iter().enumerate(); // type: Enumerate<Iter<i32>>
}

fn options(o: Option<i32>, r: Result<i32, String>) -> Result<i32, String> {
    let a = o.unwrap_or(0); // type: i32
    let b = o.map(|x| x > 1); // type: Option<bool>
    let c = r.clone()?; // type: i32
    let d = o.is_some(); // type: bool
    if let Some(x) = o { let y = x; }
    match r {
        Ok(v) => Ok(v + a),
        Err(e) => Err(e),
    }
}

fn templates(n: i32, s: &str) -> String {
    let a = `n = ${n}, s = ${s:?}`; // type: String
    println(`direct ${n:>8}`);
    show(`also ${n}`);
    a
}

fn show(x: impl Display) {}

fn closures() {
    let add = |a: i32, b: i32| a + b; // type: fn(i32, i32) -> i32
    let inc = |x: i32| -> i32 { x + 1 };
    let r = add(1, inc(2)); // type: i32
    let f: fn(&str) -> usize = |s| s.len();
    let h = std::thread::spawn(|| 42); // type: JoinHandle<i32>
}
