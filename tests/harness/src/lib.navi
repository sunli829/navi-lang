//! A crate for navi test and navi bench (tools/navictest.sh).

pub fn fib(n: u64) -> u64 { if n < 2 { n } else { fib(n - 1) + fib(n - 2) } }

#[cfg(test)]
mod tests {
    use super::*;
    use std::bench::Bencher;

    #[test]
    fn fib_small() { assert_eq(fib(10), 55); }

    #[test]
    fn fails() { assert_eq(fib(3), 3); }

    #[test]
    fn out_of_bounds() {
        let v: Vec<u64> = Vec::new();
        defer println("cleanup ran");
        let _ = v[1];
    }

    #[bench]
    fn bench_fib(b: &mut Bencher) { b.iter(|| fib(15)); }

    #[bench]
    fn bench_plain() { let _ = fib(10); }
}
