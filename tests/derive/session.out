{"jsonrpc":"2.0","id":2,"result":{"contents":{"kind":"markdown","value":"`derive Describe for Point` expands to:\n\n```navi\nimpl macros::Describe for Point {\n    fn describe(&self) -> String {\n        {\n            let mut s = String::from(\"the Point\");\n            s.push_str(\" \");\n            s.push_str(\"x\");\n            s.push_str(`=${macros::debug_str(&self.x)}`.to_string().as_str());\n            s.push_str(\" \");\n            s.push_str(\"why\");\n            s.push_str(`=${macros::debug_str(&self.y)}`.to_string().as_str());\n            s\n        }\n    }\n}\n```"},"range":{"start":{"line":3,"character":9},"end":{"line":3,"character":17}}}}
{"jsonrpc":"2.0","id":3,"result":{"contents":{"kind":"markdown","value":"`derive Debug for Point` expands to:\n\n```navi\nimpl std::fmt::Debug for Point {\n    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {\n        {\n            let mut __w = f.debug_struct(\"Point\");\n            __w.field(\"x\", &self.x);\n            __w.field(\"y\", &self.y);\n            __w.field(\"secret\", &self.secret);\n            __w.finish()\n        }\n    }\n}\n```"},"range":{"start":{"line":3,"character":26},"end":{"line":3,"character":31}}}}
