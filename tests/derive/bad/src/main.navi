use macros::{Describe, Count, Unrooted};

#[derive(Count)]
enum E { A } //~ ERROR Count is for structs

#[derive(Describe)]
struct Unknown {
    #[describe(colour = "red")] //~ ERROR unknown argument colour in #[describe]
    a: i32,
}

#[derive(Describe)]
struct NeedsValue {
    #[describe(rename)] //~ ERROR rename in #[describe] needs a value
    a: i32,
}

#[derive(Count)]
struct Untaken {
    #[describe(skip)] //~ ERROR unknown attribute describe: no derive of Untaken takes it
    a: i32,
}

#[derive(Nope)] //~ ERROR cannot find derive macro Nope in this scope
struct N;

struct NoDebug;

#[derive(Describe)]
struct Holder {
    a: NoDebug, //~ ERROR the trait bound NoDebug: Debug is not satisfied
}

fn main() {}

#[derive(Unrooted)] //~ ERROR derive Unrooted generated a path starting with the crate std: derived code writes ::std::...
struct Rootless;
