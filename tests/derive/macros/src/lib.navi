//! A derive macro for tests/derive/app (docs/derive.md).

use std::derive::{TypeInfo, Code, Error, FromAttrs, quote};

pub trait Describe {
    fn describe(&self) -> String;
}

/// The field attribute #[describe(rename = "...", skip)].
#[derive(FromAttrs)]
struct FieldAttr {
    rename: Option<String>,
    skip: bool,
}

/// The type attribute #[describe(prefix = "...")].
#[derive(FromAttrs)]
struct TypeAttr {
    prefix: Option<String>,
}

pub fn debug_str<T: std::fmt::Debug>(x: &T) -> String { `${x:?}`.to_string() }

/// #[derive(Describe)]: "Name key=value ..." with the fields' Debug.
#[derive_macro(Describe, attrs = [describe])]
pub fn describe(t: &TypeInfo) -> Result<Code, Error> {
    let ta: TypeAttr = t.parse_attrs("describe")?;
    let prefix = ta.prefix.unwrap_or(String::new());
    let body = t.each_variant(|v| {
        let mut parts: Vec<Code> = Vec::new();
        for b in v.bindings().iter() {
            let a: FieldAttr = b.field().parse_attrs("describe")?;
            if a.skip { continue; }
            let key = match a.rename {
                Some(r) => r,
                None => b.field().ident().to_string(),
            };
            parts.push(quote`s.push_str(" "); s.push_str(${key}); s.push_str(\`=\${::macros::debug_str(&${b})}\`.to_string().as_str());`.at(b));
        }
        let name = `${prefix}${v.name()}`.to_string();
        Ok(quote`let mut s = String::from(${name}); ${parts} s`)
    })?;
    let item = quote`fn describe(&self) -> String {
        ${body}
    }`;
    Ok(t.impl_for_with("::macros::Describe", quote`::std::fmt::Debug`, item))
}

/// #[derive(Count)]: fn count() -> usize, the number of fields (structs
/// only: an enum is an error at its name).
#[derive_macro(Count)]
pub fn count(t: &TypeInfo) -> Result<Code, Error> {
    if t.is_enum() { return Err(Error::at(t, "Count is for structs")); }
    let n = t.fields().len();
    Ok(t.impl_for("::macros::Count", quote`fn count() -> usize { ${n} }`))
}

pub trait Count {
    fn count() -> usize;
}

/// The derives and their traits again (a pub use takes both).
pub mod prelude {
    pub use crate::{Describe, Count};
}

// Names a crate without :: (std::mem), which the compiler refuses: derived
// code is read in the type's module, where std may be something else
// (tests/derive/bad).
#[derive_macro(Unrooted)]
pub fn unrooted(t: &TypeInfo) -> Result<Code, Error> {
    Ok(t.impl_for("::macros::Count", quote`fn count() -> usize { std::mem::size_of::<u8>() }`))
}
