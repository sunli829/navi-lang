use macros::{Describe, Count};
use std::derive::TypeInfo;

#[derive(Describe, Count, Debug)]
#[describe(prefix = "the ")]
struct Point {
    x: i32,
    #[describe(rename = "why")]
    y: i32,
    #[describe(skip)]
    secret: String,
}

#[derive(Describe)]
enum Shape {
    Circle { r: f64 },
    Square(i32),
    Empty,
}

#[derive(Describe, Count)]
struct Pair<T>(T, T);

// Through a re-export, and by path.
mod other {
    use macros::prelude::Describe;

    #[derive(Describe)]
    pub struct Q(pub i32);
}

#[derive(macros::Count)]
struct R {
    a: i32,
}

fn main() {
    let p = Point { x: 1, y: 2, secret: "s".to_string() };
    println(p.describe());
    println(Shape::Circle { r: 1.5 }.describe());
    println(Shape::Square(3).describe());
    println(Shape::Empty.describe());
    println(Pair("a", "b").describe());
    println(`${Point::count()} ${Pair::<Point>::count()}`);
    let t = TypeInfo::of::<Point>();
    let mut names: Vec<String> = Vec::new();
    for f in t.fields().iter() { names.push(`${f.ident()}: ${f.ty().text()}`.to_string()); }
    println(`${t.name()} ${names.join(", ")} attrs=${t.attrs().len()}`);
    let s = TypeInfo::of::<Shape>();
    println(`${s.name()} enum=${s.is_enum()} variants=${s.variants().len()}`);
    println(other::Q(7).describe());
    println(`${R::count()}`);
}
