// Locals, shadowing, patterns, closures, labels, block items, Self.
const LIMIT: i32 = 10;
struct Unit;
#[derive(Clone)]
struct Pair(i32, i32);
enum Op { Nop, Add(i32), Named { x: i32 } }

trait Shape {
    type Unit;
    const SIDES: u32;
    fn area(&self) -> f64;
    fn sides() -> u32 { Self::SIDES }
    fn unit(&self) -> Option<Self::Unit> { None }
}

struct Sq(f64);
impl Shape for Sq {
    type Unit = f64;
    const SIDES: u32 = 4;
    fn area(&self) -> f64 { self.0 * self.0 }
}

impl Sq {
    fn new(side: f64) -> Self { Self(side) }
    fn doubled(&self) -> Self { Sq::new(self.0 * 2.0) }
    fn sides_of<T: Shape>(t: &T) -> u32 { T::SIDES + <T as Shape>::SIDES }
}

fn scopes(v: Vec<i32>, op: Op) -> i32 {
    let x = 1;
    let x = x + 1;
    let y = { let x = 10; x * 2 };
    let add = |a: i32| a + x + y;
    let n = match op {
        Op::Nop => 0,
        Op::Add(n) | Op::Named { x: n } => n,
    };
    match 5 { LIMIT => {}, Unit => {}, other => { let z = other; } }
    if let Some(first) = v.first() { let f = *first; }
    let Some(last) = v.last() else { return 0; };
    'outer: for i in 0..LIMIT {
        for j in 0..i {
            if j == 3 { continue 'outer; }
            if j == 4 { break 'outer; }
        }
    }
    let k = loop { break 7; };
    fn helper(a: i32) -> i32 { a * 2 }
    use std::cmp::max;
    let m = max(helper(1), i32::MAX);
    let p = Pair(1, 2);
    let Pair(a, b) = p;
    let mut acc = Vec::new();
    for e in &v { acc.push(*e); }
    let h = std::thread::spawn(|| helper(3));
    let c = |q: i32| -> i32 { let w = q; w + a };
    add(n) + k + m + b + c(1)
}

fn generics<T: Clone + Default, I>(it: I) -> T where I: Iterator<Item = T> {
    let d = T::default();
    let v: Vec<T> = Vec::new();
    d
}
