// Imports: groups, self, aliases, globs, re-exports, enums, visibility.
use std::fmt::{self, Debug, Display as Show};
use std::sync::mpmc::*;
use std::iter::Iterator as _;
use crate::shapes::Shape::{self, *};
use crate::shapes::area;
pub use self::shapes::Kind as PublicKind;

mod shapes {
    pub enum Shape { Circle(f64), Square(f64), Empty }
    pub enum Kind { Round, Angular }
    pub fn area(s: &Shape) -> f64 {
        match s {
            Shape::Circle(r) => 3.14 * r * r,
            Shape::Square(a) => a * a,
            Shape::Empty => 0.0,
        }
    }
    pub(crate) fn crate_only() {}
    pub(super) fn parent_only() {}
    pub mod nested {
        pub fn up() { super::crate_only(); super::super::shapes::parent_only(); crate::top(); }
        pub(super) fn to_shapes() {}
    }
    fn uses_nested() { nested::to_shapes(); }
}

fn top() {}

fn uses(f: &dyn Show, g: &dyn Debug) -> fmt::Result {
    let s = Circle(1.0);
    let t = Shape::Square(2.0);
    let e = Empty;
    let a = area(&s);
    shapes::crate_only();
    shapes::parent_only();
    shapes::nested::up();
    let (tx, rx) = channel::<i32>();
    let k: PublicKind = PublicKind::Round;
    Ok(())
}
