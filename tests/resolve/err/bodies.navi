use std::fmt::Display;

enum E { A, B(i32) }

fn bodies() {
    let x = undefined + 1; // error: cannot find value undefined
    let s = Display; // error: expected value, found trait Display
    break; // error: break outside of a loop
    continue; // error: continue outside of a loop
    'a: loop { continue 'b; } // error: use of undeclared label 'b
    let y = self; // error: self value is only available in methods
    let (a, a) = (1, 2); // error: bound more than once
    match E::A { E::B(n) | E::A => {} } // error: variable n is not bound in all alternatives
    let t: Self = 1; // error: Self is only available in impls and traits
    let c = || { break; }; // error: break outside of a loop
    let z = if let Some(q) = None { q } else { q }; // error: cannot find value q
}

fn bounds<T: Vec<i32>>() {} // error: expected trait, found struct Vec
fn notype(d: Display) {} // error: trait Display used as a type
fn method(&self) {} // error: self parameter is only allowed in impl and trait methods
