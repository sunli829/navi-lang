// std::js in a browser (docs/wasm.md): values, calls, exceptions, and Funcs
// JS calls from a call to JS (nested) and while the program waits.
use std::js::{self, Func, Type, Value};

#[test]
fn values_and_calls() {
    let g = js::global();
    assert_eq(g.get("Math").call("max", &[Value::from(3), Value::from(7)]).int(), 7);
    let arr = g.get("Array").new(&[]);
    arr.call("push", &[Value::from("a"), Value::from("b")]);
    assert_eq(arr.length(), 2);
    assert_eq(arr.index(1).string(), "b");
    assert_eq(arr.type_of(), Type::Object);
    let o = g.get("Object").new(&[]);
    o.set("x", Value::from(1.5));
    assert_eq(o.get("x").float(), 1.5);
    assert(o.get("y").is_undefined());
    o.delete("x");
    assert(o.get("x").is_undefined());
    assert(Value::null().is_null());
    assert(Value::from(true).bool() && Value::from(1).truthy());
    assert_eq(Value::from("héllo").string(), "héllo");
    assert(o.instance_of(&g.get("Object")));
    assert(arr.equal(&arr));
}

#[test]
fn exceptions_panic() {
    let r = std::panic::catch_unwind(|| {
        js::global().get("JSON").call("parse", &[Value::from("{bad")])
    });
    assert(r.is_err());
}

#[test]
fn nested_callbacks() {
    let seen = Vec::new();
    let f = Func::new(|_this: Value, args: Vec<Value>| -> Value {
        let mut s = seen;
        s.push(args[0].int());
        Value::undefined()
    });
    let nums = js::global().get("Array").call("of", &[Value::from(1), Value::from(2), Value::from(3)]);
    nums.call("forEach", &[f.value()]);
    assert_eq(seen, [1, 2, 3]);
    let dbl = Func::new(|_t: Value, a: Vec<Value>| -> Value { Value::from(a[0].int() * 2) });
    let joined = nums.call("map", &[dbl.value()]).call("join", &[Value::from(",")]);
    assert_eq(joined.string(), "2,4,6");
    f.release();
    dbl.release();
}

#[test]
fn callback_while_waiting() {
    let (tx, rx) = std::sync::mpmc::sync_channel::<i64>(1);
    let t = Func::new(|_t: Value, a: Vec<Value>| -> Value {
        tx.send(a[0].int()).unwrap();
        Value::undefined()
    });
    js::global().call("setTimeout", &[t.value(), Value::from(5), Value::from(42)]);
    assert_eq(rx.recv().unwrap(), 42);
    t.release();
}

#[test]
fn bytes() {
    let g = js::global();
    let a = g.get("Uint8Array").new(&[Value::from(4)]);
    assert_eq(js::copy_bytes_to_js(&a, &[1, 2, 3]), 3);
    let mut out = [0u8; 4];
    assert_eq(js::copy_bytes_to_navi(&mut out, &a), 4);
    assert_eq(out, [1, 2, 3, 0]);
}
