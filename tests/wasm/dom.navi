// The DOM through std::js: elements made and changed, and an event handler
// (a click, dispatched synchronously: a Func called from a call to JS).
use std::js::{self, Func, Value};

#[test]
fn elements_and_events() {
    let doc = js::global().get("document");
    let p = doc.call("createElement", &[Value::from("p")]);
    p.set("textContent", "hello");
    p.call("setAttribute", &[Value::from("id"), Value::from("greeting")]);
    doc.get("body").call("appendChild", &[p.clone()]);
    let found = doc.call("getElementById", &[Value::from("greeting")]);
    assert_eq(found.get("textContent").string(), "hello");
    let clicks = Vec::new();
    let on = Func::new(|_this: Value, args: Vec<Value>| -> Value {
        let mut c = clicks;
        c.push(args[0].get("type").string());
        Value::undefined()
    });
    p.call("addEventListener", &[Value::from("click"), on.value()]);
    p.call("click", &[]);
    p.call("click", &[]);
    assert_eq(clicks, ["click", "click"]);
    on.release();
}
