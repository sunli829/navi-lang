// http::Client over the browser's fetch (docs/wasm.md): requests to the
// page's server (crate::wasmrun's test endpoints), a streamed body, a
// timeout, a status.
use std::{
    http::{self, Client, ErrorKind},
    js,
    time::Duration,
};

fn origin() -> String {
    js::global().get("location").get("origin").string()
}

#[test]
fn get_and_post() {
    let o = origin();
    let t = http::get(`${o}/__navi/echo?x=1`.to_string()).unwrap().text().unwrap();
    assert(t.starts_with("GET /__navi/echo?x=1\n"));
    let r = Client::new()
        .post(`${o}/__navi/echo`.to_string())
        .header("x-navi", "yes")
        .body("hello")
        .send()
        .unwrap();
    assert_eq(r.status().as_u16(), 200);
    assert_eq(r.headers().get("access-control-allow-origin"), Some("*"));
    let t = r.text().unwrap();
    assert(t.starts_with("POST /__navi/echo\n"));
    assert(t.contains("x-navi: yes\n"));
    assert(t.ends_with("\nhello"));
}

#[test]
fn streamed_body() {
    let r = http::get(`${origin()}/__navi/big?n=300000`.to_string()).unwrap();
    let b = r.bytes().unwrap();
    assert_eq(b.len(), 300000);
    assert_eq(b[26], b'a');
}

#[test]
fn timeout() {
    let c = Client::builder().timeout(Duration::from_millis(50)).build().unwrap();
    let e = c.get(`${origin()}/__navi/slow?ms=2000`.to_string()).send().unwrap_err();
    assert(e.kind() == ErrorKind::Timeout);
}

#[test]
fn not_found() {
    let r = http::get(`${origin()}/__navi/nothing`.to_string()).unwrap();
    assert_eq(r.status().as_u16(), 404);
}
