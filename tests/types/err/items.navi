struct Inf2 { next: Option<Inf2> } //~ ERROR recursive type Inf2 has infinite size
struct Ok1 { next: Option<&Ok1> }
struct Two<A, B>(A, B);
type Bad1 = Two<i32>; //~ ERROR missing generic argument for struct Two
type Bad2 = Vec<i32, i32>; //~ ERROR takes 1 generic argument but 2 were supplied
type Bad3 = Vec; //~ ERROR missing generic argument for struct Vec
type Bad4 = i32<u8>; //~ ERROR primitive type i32 takes no generic arguments
type Loop = Loop; //~ ERROR type alias Loop refers to itself
struct F { f: impl Display } //~ ERROR impl Trait is only allowed in function parameter and return types
const C: [u8; X] = [0; 1]; //~ ERROR expected a constant integer expression
enum E { A = 1, B = 1 } //~ ERROR discriminant value 1 is already used by variant A
fn nobody(); //~ ERROR function nobody has no body
fn defaults<T = i32>() {} //~ ERROR default type parameters are only allowed on structs
fn bad_assoc<T>(t: T) -> T::Item { t } //~ ERROR associated type Item not found for T
fn ambiguous(v: Vec<i32>) -> Vec<i32>::Item { v } //~ ERROR ambiguous associated type
fn dyn_default(x: &dyn PartialEq) {} //~ ERROR must be specified explicitly here
fn nope<I: Iterator<Itm = u8>>(i: I) {} //~ ERROR trait Iterator has no associated type Itm

trait T1 { fn m(&self); fn n(&self, a: i32); const K: i32; type A; }
struct X;
impl T1 for X { //~ ERROR missing: A, K
    fn m(self) {} //~ ERROR method m takes self but the declaration in trait T1 takes &self
    fn n(&self) {} //~ ERROR method n has 0 parameters but the declaration in trait T1 has 1
    fn extra(&self) {} //~ ERROR extra is not a member of trait T1
}
impl Display for i32 { fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result { Ok(()) } } //~ ERROR only traits defined in this crate can be implemented
impl i32 {} //~ ERROR inherent impls for i32 can only be defined in std
impl Vec<i32> {} //~ ERROR defined in crate std
impl<T> T {} //~ ERROR cannot define an inherent impl for the type parameter T
impl X { type A = i32; } //~ ERROR associated types are only allowed in trait impls
unsafe trait U {}
impl U for X {} //~ ERROR implementing the unsafe trait U requires an unsafe impl
