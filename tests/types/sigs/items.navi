use std::fmt::{Debug, Display};

struct Point { x: f64, y: f64 } // sig: struct Point { x: f64, y: f64 }
struct Meters(f64); // sig: struct Meters(f64)
struct Unit; // sig: struct Unit
struct Wrap<T>(T); // sig: struct Wrap<T>(T)
struct Pair<A, B = A> { a: A, b: B } // sig: struct Pair<A, B = A> { a: A, b: B }
enum Shape { Circle { r: f64 }, Rect(f64, f64), Empty } // sig: enum Shape { Circle { r: f64 }, Rect(f64, f64), Empty = 2 }
enum Color { Red = 1, Green, Blue = 10 } // sig: enum Color { Red = 1, Green = 2, Blue = 10 }
type Grid = [[u8; 4]; 2 * 2]; // sig: type Grid = [[u8; 4]; 4]
type Res<T> = Result<T, String>; // sig: type Res<T> = Result<T, String>
const N: usize = 3 + 1; // sig: const N: usize
static mut COUNT: i64 = 0; // sig: static mut COUNT: i64
const ARR: [i32; N] = [0; N]; // sig: const ARR: [i32; 4]

fn add(a: i32, b: i32) -> i32 { a + b } // sig: fn add(i32, i32) -> i32
fn largest<T: PartialOrd>(xs: &[T]) -> &T { &xs[0] } // sig: fn largest<T: PartialOrd<T>>(&[T]) -> &T
fn show(x: impl Display) {} // sig: fn show<impl Display: Display>(impl Display)
fn evens(v: &[i32]) -> impl Iterator<Item = i32> { todo() } // sig: fn evens(&[i32]) -> impl Iterator<Item = i32>
fn items<I>(it: I) where I: Iterator, I::Item: Debug {} // sig: fn items<I: Iterator>(I) where I::Item: Debug
fn first<I: Iterator>(it: I) -> Option<I::Item> { todo() } // sig: fn first<I: Iterator>(I) -> Option<I::Item>
fn cb(f: fn(i32) -> bool, g: extern "C" fn(i32)) {} // sig: fn cb(fn(i32) -> bool, extern "C" fn(i32))
fn dynamic(d: &dyn Display, e: &mut dyn Iterator<Item = u8>) {} // sig: fn dynamic(&dyn Display, &mut dyn Iterator<Item = u8>)
fn tuple(t: (i32, &str), u: (), v: (u8,)) -> ! { loop {} } // sig: fn tuple((i32, &str), (), (u8,)) -> !
fn raw(p: *const u8, q: *mut Point) {} // sig: fn raw(*const u8, *mut Point)

trait Figure: Debug { // sig: trait Figure: Debug
    type Unit: Clone; // sig: type Figure::Unit: Clone
    const SIDES: u32; // sig: const Figure::SIDES: u32
    fn area(&self) -> f64; // sig: fn Figure::area(&Self) -> f64
    fn unit(&self) -> Option<Self::Unit> { None } // sig: fn Figure::unit(&Self) -> Option<<Self as Figure>::Unit>
    fn scale(&mut self, k: f64); // sig: fn Figure::scale(&mut Self, f64)
    fn make() -> Self; // sig: fn Figure::make() -> Self
}

trait Cmp<Rhs = Self> { // sig: trait Cmp<Rhs = Self>
    fn cmp_with(&self, other: &Rhs) -> bool; // sig: fn Cmp::cmp_with(&Self, &Rhs) -> bool
}

#[derive(Debug)]
struct Sq(f64);

impl Figure for Sq { // sig: impl Figure for Sq
    type Unit = f64; // sig: type Unit = f64
    const SIDES: u32 = 4;
    fn area(&self) -> f64 { self.0 * self.0 }
    fn scale(&mut self, k: f64) { self.0 = self.0 * k; }
    fn make() -> Sq { Sq(1.0) }
}

impl Sq { // sig: impl Sq
    fn new(s: f64) -> Self { Sq(s) } // sig: fn new(f64) -> Sq
    fn get(self) -> f64 { self.0 } // sig: fn get(Sq) -> f64
}

impl<T: Display> Cmp for Wrap<T> { // sig: impl<T: Display> Cmp<Wrap<T>> for Wrap<T>
    fn cmp_with(&self, other: &Wrap<T>) -> bool { true }
}

impl<T> Cmp<i32> for Pair<T> { // sig: impl<T> Cmp<i32> for Pair<T, T>
    fn cmp_with(&self, other: &i32) -> bool { true }
}
