// 1.15 属性 / 1.16 unsafe 与 FFI
#[derive(Debug, Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]
#[repr(C)]
struct Pair { a: i32, b: i32 }

#[repr(u8)]
enum Small { A, B }

#[inline]
fn fast() {}
#[inline(never)]
#[cold]
fn slow() {}
#[track_caller]
#[must_use]
#[deprecated]
#[allow(unused)]
fn tracked() -> i32 { 1 }

#[bench]
fn bench_it() {}

unsafe fn danger(p: *mut u8) { *p = 0; }

fn use_raw(p: *const u8, n: usize) -> u8 {
    unsafe {
        let q = p.add(n);
        *q
    }
}

extern "C" fn cb(x: i32) -> i32 { x }

fn register(f: extern "C" fn(i32) -> i32) {}
