//! 1.1 词法
/* block comment /* nested */ still comment */

/// doc comment on an item
fn literals() {
    let a = 42;
    let b = 1_000_000;
    let c = 0xff;
    let d = 0o17;
    let e = 0b1010;
    let f = 10u8;
    let g = 3i64;
    let h = 7usize;
    let i = 1.5;
    let j = 2e10;
    let k = 1.0e-3f32;
    let l = 'a';
    let m = '\n';
    let n = '\u{1F600}';
    let o = b'a';
    let p = "hello\n";
    let q = r"C:\path";
    let r = r#"has "quotes""#;
    let s = b"abc";
    let t = `hello ${p}`;
    let u = `escaped \` and \${not a hole}`;
    let r#match = 1;
    'outer: loop { break 'outer; }
}
