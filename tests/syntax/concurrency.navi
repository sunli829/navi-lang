// 1.11 并发 / 1.12 错误处理
use std::thread;
use std::sync::mpmc::{channel, sync_channel};

fn heavy(n: i32) -> i32 { n * 2 }

fn concurrency(s: String) {
    let h = thread::spawn(|| heavy(42));
    let r = h.join().unwrap();

    let (tx, rx) = sync_channel::<i32>(16);
    let (tx2, rx2) = channel::<String>();
    thread::spawn(|| { tx.send(1).unwrap(); tx.close(); });
    let v: Result<i32, RecvError> = rx.recv();
    for v in rx.iter() { }

    select {
        v = rx.recv() => println(`got ${v:?}`),
        tx2.send(s) => {},
        default => {},
    }

    for i in 0..4 { thread::spawn(|| heavy(i)); }
}

fn errors(x: i32) -> Option<i32> {
    if x < 0 { panic(`bad value ${x}`); }
    let y = Some(x)?;
    Some(y)
}
