// 1.9 模式匹配
fn patterns(v: i32, p: Point, e: Shape, t: (i32, i32), s: &[i32], opt_ref: Option<&Point>, name: &str) {
    match v {
        0 => {}
        1 | 2 | 3 => {}
        4..=9 => {}
        n @ 10..=99 => {}
        n if n < 0 => {}
        _ => {}
    }
    match p {
        Point { x: 0.0, y } => {}
        Point { x, .. } => {}
    }
    match e {
        Shape::Circle { r } => {}
        Shape::Rect(w, h) => {}
        Shape::Empty => {}
    }
    match t { (0, _) => {}, (x, y) => {} }
    match s { [] => {}, [first, .., last] => {}, [x] => {} }
    match opt_ref { Some(&Point { x, .. }) => {}, None => {} }
    match name { "admin" => {}, _ => {} }
    let (a, mut b) = t;
    match v { -1 => {}, i32::MIN..=-2 => {}, _ => {} }
}

fn param_pattern((a, b): (i32, i32), Point { x, y }: Point) -> f64 { x + y }
