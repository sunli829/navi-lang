// 1.6 泛型
fn largest<T: PartialOrd>(xs: &[T]) -> &T {
    let mut best = &xs[0];
    for x in xs.iter() {
        if x > best { best = x; }
    }
    best
}

fn print_all<I>(it: I) where I: Iterator, I::Item: Display {
    for x in it { println(`${x}`); }
}

struct Stack<T> { items: Vec<T> }
impl<T: Clone> Stack<T> {
    fn peek(&self) -> Option<T> { self.items.last().cloned() }
}

enum Tree<K: Ord, V> { Leaf, Node(&Tree<K, V>, K, V, &Tree<K, V>) }

fn evens(v: &[i32]) -> impl Iterator<Item = i32> { v.iter().filter(|x| *x % 2 == 0).map(|x| *x) }
fn sum(it: impl Iterator<Item = i32>) -> i32 { it.fold(0, |a, b| a + b) }

trait Iter2 {
    type Item;
    fn next(&mut self) -> Option<Self::Item>;
    fn map<B>(self, f: fn(Self::Item) -> B) -> Map<Self, B>;
}

fn use_generics<T: Figure + Clone>() {
    let v = parse::<i64>("42");
    let n = <T as Figure>::SIDES;
    let w: Vec<Vec<u8>> = Vec::new();
    let e = Vec::<i32>::with_capacity(4);
}
