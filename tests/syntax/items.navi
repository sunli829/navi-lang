// 1.4 条目
pub fn add(a: i32, b: i32) -> i32 { a + b }

fn main() -> Result<(), Error> { Ok(()) }

const MAX: usize = 1024;
const TABLE: [u32; 4] = make_table();
static mut COUNTER: i64 = 0;

const fn make_table() -> [u32; 4] { [1, 2, 3, 4] }

struct Point { x: f64, y: f64 }
struct Meters(f64);
struct Unit;
pub struct Visible { pub(crate) a: i32, pub(super) b: i32, c: i32 }

enum Shape {
    Circle { r: f64 },
    Rect(f64, f64),
    Empty,
}
enum Color { Red = 1, Green = 2 }

type Result<T> = std::result::Result<T, Error>;

mod parser;
mod util { pub fn clamp(x: i32) -> i32 { if x < 0 { 0 } else { x } } }

#[link(name = "c")]
extern "C" {
    fn write(fd: i32, buf: *const u8, n: usize) -> isize;
}
#[export_name = "navi_cb"]
extern "C" fn callback(x: i32) -> i32 { x }

#[asm]
fn memmove(dst: *mut u8, src: *const u8, n: usize);
