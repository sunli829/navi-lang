// 1.2 基本类型 / 1.3 复合类型与引用
struct Point { x: f64, y: f64 }

#[link(name = "c")]
extern "C" {
    fn abs(x: i32) -> i32;
}

extern "C" fn callback(x: i32) -> i32 { x }

fn types(pt: Point, a: [u8; 4]) {
    let x: i8 = 1;
    let y: u64 = 2;
    let z: isize = 3;
    let w: f32 = 1.0;
    let b: bool = true;
    let c: char = 'c';
    let unit: () = ();
    let t: (i32, &str) = (1, "a");
    let arr: [u8; 4] = [0; 4];
    let s: &[u8] = &arr[1..3];
    let p: &Point = &Point { x: 1.0, y: 2.0 };
    let mut pt2 = pt;
    let q: &mut Point = &mut pt2;
    let r: *const u8 = s.as_ptr();
    let f: fn(i32) -> i32 = |x| x + 1;
    let cb: extern "C" fn(i32) -> i32 = callback;
    let d: &dyn Display = &pt;
    let n: Option<&Point> = None;
    let big = y as i64 + x as i64;
}

fn never() -> ! { loop {} }
