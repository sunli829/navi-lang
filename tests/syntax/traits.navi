// 1.5 impl 与 trait
use std::fmt::{self, Debug, Display};

struct Point { x: f64, y: f64 }
struct Circle { r: f64 }
struct Meters(f64);

impl Point {
    pub fn new(x: f64, y: f64) -> Self { Point { x, y } }
    pub fn len(&self) -> f64 { (self.x * self.x + self.y * self.y).sqrt() }
    pub fn scale(&mut self, k: f64) { self.x *= k; self.y *= k; }
    pub fn into_tuple(self) -> (f64, f64) { (self.x, self.y) }
}

pub trait Figure: Debug {
    type Unit;
    const SIDES: u32;
    fn area(&self) -> f64;
    fn describe(&self) -> String { `area ${self.area()}` }
}

impl Figure for Circle {
    type Unit = Meters;
    const SIDES: u32 = 0;
    fn area(&self) -> f64 { 3.14159 * self.r * self.r }
}

impl<T: Display> ToString for T {
    fn to_string(&self) -> String { `${self}` }
}

unsafe trait Raw {}
unsafe impl Raw for Point {}

fn dynamic(f: &dyn Figure<Unit = Meters>) -> f64 { f.area() }
