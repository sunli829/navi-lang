use std::serde::{Serialize, Deserialize};

#[derive(Serialize)]
#[serde(tag = "t")]
enum A { X(i32, i32) } //~ ERROR an internally tagged enum cannot have tuple variants

#[derive(Deserialize)]
#[serde(content = "c")]
enum B { Y } //~ ERROR content needs tag

#[derive(Serialize)]
#[serde(tag = "t")]
struct S { a: i32 } //~ ERROR tag is for enums

#[derive(Serialize)]
#[serde(untagged, tag = "t")]
enum C { Z } //~ ERROR untagged cannot be used with tag or content

#[derive(Serialize)]
#[serde(colour = "red")] //~ ERROR unknown argument colour in #[serde]
struct D { a: i32 }

fn main() {}
