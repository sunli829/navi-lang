// x.clone() on a reference to a type without Clone is an error (Rust: &mut
// T is not Clone; for &T rustc warns): copy references by assigning them.
struct NoClone { n: i32 }

fn generic<T>(x: &T) {
    let _y = x.clone(); //~ ERROR T does not implement Clone, so &T cannot be cloned (copy the reference by assigning it)
}

fn main() {
    let a = NoClone { n: 1 };
    let r = &a;
    let _x = r.clone(); //~ ERROR NoClone does not implement Clone, so &NoClone cannot be cloned (copy the reference by assigning it)
    let m = &mut NoClone { n: 2 };
    let _z = m.clone(); //~ ERROR NoClone does not implement Clone, so &mut NoClone cannot be cloned (copy the reference by assigning it)
    let s: &str = "text";
    let _t = s.clone(); //~ ERROR str does not implement Clone, so &str cannot be cloned (copy the reference by assigning it)
    let ok = r;
    println(`${ok.n}`);
    generic(&1);
}
