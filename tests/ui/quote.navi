use std::derive::{Code, quote};

fn open() -> Code { quote`fn f() {` } //~ ERROR unclosed bracket in quote template

fn mismatched() -> Code { quote`let x = (1];` } //~ ERROR unmatched ] in quote template

fn spec(n: i32) -> Code { quote`${n:x}` } //~ ERROR a quote hole takes no format spec

fn other(n: i32) { let _ = format`${n}`; } //~ ERROR only quote can tag a template string

fn main() {}
