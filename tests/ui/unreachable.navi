// Arms no value reaches get a warning; the program still builds.
enum E { A(i32), B, C }
fn main() {
    match E::A(3) {
        E::A(1) | E::B => println("x"),
        E::A(_) => println("a"),
        E::B => println("b"), //~ WARN unreachable pattern
        _ => println("rest"),
        E::A(2) | E::C => println("y"), //~ WARN unreachable pattern
    }
    let t = (1, true);
    match t {
        (_, true) => println("t"),
        (n, _) if n > 0 => println("g"),
        (_, false) => println("f"),
        (0, _) => println("z"), //~ WARN unreachable pattern
    }
    let s: &[i32] = &[1, 2]; match s { [] => {} [x, ..] => println(`${x}`), [_, _] => {} } //~ WARN unreachable pattern
}
