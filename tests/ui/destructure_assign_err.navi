struct P { x: i32, y: i32 }
fn main() {
    let mut a = 0;
    let b = 0;
    let p = P { x: 1, y: 2 };
    let n = 1;
    let z = _; //~ ERROR in expressions, _ can only be used on the left-hand side of an assignment
    P { x: a, ..p } = p; //~ ERROR functional record updates are not allowed in destructuring assignments
    (a, b) = (1, 2); //~ ERROR cannot assign to immutable variable b (declare it with let mut)
    (a, 1) = (1, 2); //~ ERROR invalid left-hand side of assignment
    n + 1 = 2; //~ ERROR invalid left-hand side of assignment
    (a, a) += (1, 2); //~ ERROR invalid left-hand side of assignment
    //~| ERROR cannot apply += to (i32, i32) and (i32, i32)
}
