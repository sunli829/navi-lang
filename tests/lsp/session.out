{"jsonrpc":"2.0","id":24,"result":[{"range":{"start":{"line":0,"character":0},"end":{"line":16,"character":0}},"newText":"mod shapes;\n\nuse shapes::{Shape, area};\n\n/// Adds two numbers.\nfn add(a: i32, b: i32) -> i32 {\n    a + b\n}\n\nfn main() {\n    let total = add(1, 2);\n    let s = Shape::Circle { r: 2.0 };\n    let p = shapes::Point { x: 1, y: 2 };\n    let x: bool = p.x;\n    println(`${total} ${area(&s)} ${x}`);\n}\n"}]}
