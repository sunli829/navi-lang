//! Shapes and their areas.

/// A point.
pub struct Point {
    /// The x coordinate.
    pub x: i32,
    pub y: i32,
}

pub enum Shape {
    Circle { r: f64 },
    Square(f64),
}

/// The area of a shape.
pub fn area(s: &Shape) -> f64 {
    match s {
        Shape::Circle { r } => 3.14 * r * r,
        Shape::Square(a) => a * a,
    }
}

impl Shape {
    /// The name of the shape.
    pub fn name(&self) -> String {
        match self {
            Shape::Circle { .. } => "circle".to_string(),
            Shape::Square(_) => "square".to_string(),
        }
    }
}
