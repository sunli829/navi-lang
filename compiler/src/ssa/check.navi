//! Checks that a function is well-formed SSA (Go's check.go): edges agree,
//! blocks end as their kind says, every argument is defined before its use
//! (dominates it), phis match their predecessors, use counts are right and
//! memory arguments are memory.

use crate::ssa::*;
use crate::ssa::dom;

/// The problems found ("" if none).
pub fn check(f: &Func) -> String {
    let mut errs = String::new();
    let n = f.values.len();
    let mut uses: Vec<i32> = Vec::new();
    uses.resize(n, 0);
    // The position of each value in its block, for uses in the same block.
    let mut at: Vec<i32> = Vec::new();
    at.resize(n, -1);
    for b in f.blocks.iter() {
        let mut i = 0;
        while i < b.values.len() {
            let v = b.values[i];
            if v.op == OP_INVALID { errs.push_str(&`b${b.id}: removed value v${v.id}\n`); }
            match v.block {
                Some(vb) => if vb.id != b.id { errs.push_str(&`v${v.id} is in b${b.id} but says b${vb.id}\n`); },
                None => errs.push_str(&`v${v.id} has no block\n`),
            }
            if f.values[v.id as usize].id != v.id { errs.push_str(&`v${v.id} is not values[${v.id}]\n`); }
            at[v.id as usize] = i as i32;
            for a in v.args.iter() { uses[a.id as usize] += 1; }
            i += 1;
        }
        if let Some(c) = b.control { uses[c.id as usize] += 1; }
        for s in b.succs.iter() {
            let mut k = 0;
            for p in s.preds.iter() { if p.id == b.id { k += 1; } }
            let mut m = 0;
            for t in b.succs.iter() { if t.id == s.id { m += 1; } }
            if k != m { errs.push_str(&`edge b${b.id} -> b${s.id} is not among b${s.id}'s predecessors\n`); }
        }
        let want = match b.kind { B_PLAIN => 1, B_IF => 2, _ => 0 };
        if b.succs.len() != want { errs.push_str(&`b${b.id}: ${b.succs.len()} successors\n`); }
        match b.kind {
            B_PLAIN => if b.control.is_some() { errs.push_str(&`b${b.id}: plain block with a control\n`); },
            B_IF => match b.control {
                Some(c) => if c.ty != T_BOOL && c.ty != T_FLAGS { errs.push_str(&`b${b.id}: if on v${c.id} of type ${ty_name(c.ty)}\n`); },
                None => errs.push_str(&`b${b.id}: if without a control\n`),
            },
            _ => match b.control {
                Some(c) => if c.ty != T_MEM { errs.push_str(&`b${b.id}: ends with v${c.id}, not memory\n`); },
                None => errs.push_str(&`b${b.id}: no memory at the end\n`),
            },
        }
    }
    if errs.len() > 0 { return errs; }
    for v in f.values.iter() {
        if v.op == OP_INVALID { continue; }
        if v.block.is_none() { continue; }
        if uses[v.id as usize] != v.uses { errs.push_str(&`v${v.id}: ${v.uses} uses recorded, ${uses[v.id as usize]} found\n`); }
    }
    let d = dom::dominators(f);
    for b in f.blocks.iter() {
        if d.order[b.id as usize] < 0 { continue; }
        let mut seen_other = false;
        for v in b.values.iter() {
            if v.op == OP_FWDREF { errs.push_str(&`v${v.id}: forward reference left\n`); }
            if v.op == OP_PHI {
                if seen_other { errs.push_str(&`v${v.id}: phi after other values\n`); }
                if v.args.len() != b.preds.len() { errs.push_str(&`v${v.id}: phi with ${v.args.len()} args, b${b.id} has ${b.preds.len()} predecessors\n`); }
            } else if !(v.op == OP_COPY && v.uses == 0) {
                // Dead copies (trivial phis) go before code generation.
                seen_other = true;
            }
            let mut i = 0;
            while i < v.args.len() {
                let a = v.args[i];
                if a.op == OP_INVALID {
                    errs.push_str(&`v${v.id}: argument v${a.id} was removed\n`);
                    i += 1;
                    continue;
                }
                let ab = a.block.unwrap();
                if v.op == OP_PHI {
                    if i < b.preds.len() {
                        let p = b.preds[i];
                        if d.order[p.id as usize] >= 0 && !d.dominates(ab.id, p.id) { errs.push_str(&`v${v.id}: v${a.id} does not reach b${p.id}\n`); }
                    }
                } else if ab.id == b.id {
                    if at[a.id as usize] >= at[v.id as usize] { errs.push_str(&`v${v.id}: v${a.id} is used before it is defined\n`); }
                } else if !d.dominates(ab.id, b.id) {
                    errs.push_str(&`v${v.id}: v${a.id} (b${ab.id}) does not dominate b${b.id}\n`);
                }
                i += 1;
            }
            check_types(v, &mut errs);
        }
        if let Some(c) = b.control {
            let cb = c.block.unwrap();
            if !d.dominates(cb.id, b.id) { errs.push_str(&`b${b.id}: control v${c.id} does not dominate it\n`); }
        }
    }
    errs
}

fn check_types(v: &Value, errs: &mut String) {
    let n = v.args.len();
    // The memory argument of ops that take one: the last.
    let takes_mem = v.op == OP_LOAD || v.op == OP_STORE || v.op == OP_MOVE || v.op == OP_ZERO || v.op == OP_WB || v.op == OP_DISCR
        || v.op == OP_SETDISCR || v.op == OP_CALL || v.op == OP_INTRINSIC || v.op == OP_ALLOC || v.op == OP_CLOSURE || v.op == OP_DEFER
        || v.op == OP_PANIC || v.op == OP_RETURN;
    if takes_mem {
        if n == 0 || v.args[n - 1].ty != T_MEM { errs.push_str(&`v${v.id} (${op_name(v.op)}): last argument is not memory\n`); }
    }
    let mut i = 0;
    while i < n {
        if v.args[i].ty == T_MEM && (!takes_mem || i != n - 1) && v.op != OP_PHI && v.op != OP_COPY {
            errs.push_str(&`v${v.id} (${op_name(v.op)}): memory as argument ${i}\n`);
        }
        if v.args[i].ty == T_TUPLE && v.op != OP_SELECT { errs.push_str(&`v${v.id}: a tuple as argument ${i}\n`); }
        i += 1;
    }
    let want: i64 = match v.op {
        OP_INITMEM | OP_ARG | OP_CONST | OP_CONSTSYM | OP_LOCALADDR | OP_RESADDR | OP_RETPTR | OP_CONSTPARAM | OP_CLOSURECODE | OP_VTABLE => 0,
        OP_COPY | OP_OFFPTR | OP_NEG | OP_NOT | OP_FNEG | OP_SEXT | OP_ZEXT | OP_TRUNC | OP_ITOF | OP_FTOI | OP_FCONV | OP_FBITS | OP_FFROMBITS
            | OP_SELECT | OP_RETYPE | OP_ALLOC => 1,
        OP_INDEXPTR | OP_LOAD | OP_ZERO | OP_WB | OP_DISCR | OP_SETDISCR => 2,
        OP_STORE | OP_MOVE => 3,
        _ => -1,
    };
    if want < 0 {
        if v.op >= OP_ADD && v.op <= OP_FLE && v.op != OP_NEG && v.op != OP_NOT && v.op != OP_FNEG && n != 2 {
            errs.push_str(&`v${v.id} (${op_name(v.op)}): ${n} arguments\n`);
        }
    } else if n as i64 != want {
        errs.push_str(&`v${v.id} (${op_name(v.op)}): ${n} arguments, want ${want}\n`);
    }
    let mem_result = v.op == OP_STORE || v.op == OP_MOVE || v.op == OP_ZERO || v.op == OP_WB || v.op == OP_SETDISCR || v.op == OP_CALL
        || v.op == OP_DEFER || v.op == OP_PANIC || v.op == OP_INITMEM || v.op == OP_RETURN;
    if mem_result && v.ty != T_MEM { errs.push_str(&`v${v.id} (${op_name(v.op)}): type ${ty_name(v.ty)}, want mem\n`); }
    if (v.op == OP_INTRINSIC || v.op == OP_ALLOC || v.op == OP_CLOSURE) && v.ty != T_TUPLE {
        errs.push_str(&`v${v.id} (${op_name(v.op)}): type ${ty_name(v.ty)}, want tuple\n`);
    }
    if v.op == OP_SELECT && (n != 1 || v.args[0].ty != T_TUPLE) { errs.push_str(&`v${v.id}: select of a non-tuple\n`); }
    if v.op == OP_PHI || v.op == OP_COPY {
        for a in v.args.iter() {
            if a.ty != v.ty { errs.push_str(&`v${v.id} (${op_name(v.op)} ${ty_name(v.ty)}): argument v${a.id} is ${ty_name(a.ty)}\n`); }
        }
    }
}
