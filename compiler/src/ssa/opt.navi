//! Machine-independent optimizations: common subexpression elimination by
//! value numbering over the dominator tree (Go's cse: loads take part with
//! their memory, so two loads of one address with no store between are
//! one), and branch facts (a small part of Go's prove: below the edge of a
//! branch its condition is known; a branch on a known condition becomes a
//! jump, which removes repeated bounds checks).

use crate::ssa::*;
use crate::ssa::dom;

/// Whether two values with the same operation and arguments are equal.
fn pure(v: &Value) -> bool {
    match v.op {
        OP_CONST | OP_LOCALADDR | OP_RESADDR | OP_RETPTR | OP_OFFPTR | OP_INDEXPTR | OP_ADD | OP_SUB | OP_MUL | OP_DIV | OP_REM | OP_AND
            | OP_OR | OP_XOR | OP_SHL | OP_SHR | OP_NEG | OP_NOT | OP_EQ | OP_NE | OP_LT | OP_LE | OP_FADD | OP_FSUB | OP_FMUL | OP_FDIV
            | OP_FNEG | OP_FEQ | OP_FNE | OP_FLT | OP_FLE | OP_SEXT | OP_ZEXT | OP_TRUNC | OP_ITOF | OP_FTOI | OP_FCONV | OP_FBITS
            | OP_FFROMBITS | OP_LOAD | OP_DISCR | OP_RETYPE | OP_CONSTPARAM | OP_CONSTSYM | OP_VTABLE | OP_CLOSURECODE => true,
        _ => false,
    }
}

fn aux_id(a: &Aux) -> u64 {
    match a {
        Aux::Ty(t) => (t.id as u64) << 2 | 1,
        Aux::Cnst(c) => (c.id as u64) << 2 | 2,
        Aux::None => 0,
        // Statements and terms: never equal (their values are unique).
        _ => 3,
    }
}

fn same(a: &Value, b: &Value) -> bool {
    if a.op != b.op || a.ty != b.ty || a.aux_int != b.aux_int || a.args.len() != b.args.len() { return false; }
    let x = aux_id(&a.aux);
    if x == 3 || x != aux_id(&b.aux) { return false; }
    let mut i = 0;
    while i < a.args.len() {
        if a.args[i].id != b.args[i].id { return false; }
        i += 1;
    }
    true
}

fn hash(v: &Value) -> u64 {
    let mut h = (v.op as u64).wrapping_mul(0x9E3779B97F4A7C15) ^ (v.ty as u64) << 16 ^ (v.aux_int as u64).wrapping_mul(31) ^ aux_id(&v.aux).wrapping_mul(1000003);
    for a in v.args.iter() { h = (h ^ a.id as u64).wrapping_mul(0x100000001B3); }
    h ^ h >> 29
}

/// The dominator tree: by block id its first child and next sibling
/// (indexes into rpo + 1; 0: none).
fn children(f: &Func, d: &dom::Dom) -> (Vec<u32>, Vec<u32>) {
    let mut first: Vec<u32> = Vec::new();
    let mut sib: Vec<u32> = Vec::new();
    first.resize(f.blocks.len(), 0);
    sib.resize(f.blocks.len(), 0);
    let mut i = d.rpo.len();
    while i > 0 {
        i -= 1;
        let b = d.rpo[i];
        let p = d.idom[b.id as usize];
        if p >= 0 {
            sib[b.id as usize] = first[p as usize];
            first[p as usize] = (i + 1) as u32;
        }
    }
    (first, sib)
}

/// Replaces values equal to one that dominates them with copies of it.
pub fn cse(f: &mut Func, d: &dom::Dom) {
    let ch = children(f, d);
    // Buckets (a power of two, at least twice the values) hold the latest
    // entry (index + 1); entries chain to the one they hid, and are popped
    // when their block is left. Both are the cache's buffers.
    let mut nbits = 4u32;
    while (1usize << nbits) < 2 * f.values.len() { nbits += 1; }
    let mask = (1u64 << nbits) - 1;
    let c = f.cache.unwrap();
    let mut table = c.cse_heads;
    table.clear();
    table.resize(1usize << nbits, 0);
    let mut entries = c.cse_entries;
    entries.clear();
    // (block, marks): the walk, with where each block's additions start.
    let mut stack: Vec<(&mut Block, usize, bool)> = Vec::new();
    stack.push((f.entry.unwrap(), 0, false));
    while let Some((b, mark, done)) = stack.pop() {
        if done {
            while entries.len() > mark {
                let e = entries.pop().unwrap();
                table[e.0 as usize] = e.2;
            }
            continue;
        }
        let m = entries.len();
        stack.push((b, m, true));
        for vv in b.values.iter() {
            let v = *vv;
            if !pure(v) { continue; }
            // Arguments are already replaced (dominators come first).
            let mut i = 0;
            while i < v.args.len() {
                let a = v.args[i];
                if a.op == OP_COPY { v.set_arg(i, copy_source(a)); }
                i += 1;
            }
            let bkt = (hash(v) & mask) as usize;
            let head = table[bkt];
            let mut found: Option<&mut Value> = None;
            let mut k = head as usize;
            while k > 0 {
                if same(entries[k - 1].1, v) {
                    found = Some(entries[k - 1].1);
                    break;
                }
                k = entries[k - 1].2 as usize;
            }
            match found {
                Some(w) => v.become_copy(w),
                None => {
                    entries.push((bkt as u32, v, head));
                    table[bkt] = entries.len() as u32;
                }
            }
        }
        let mut k = ch.0[b.id as usize];
        while k > 0 {
            let c = d.rpo[(k - 1) as usize];
            stack.push((c, 0, false));
            k = ch.1[c.id as usize];
        }
    }
    copyelim(f);
}

/// Removes the i-th successor edge of b (and the phi arguments for it).
fn remove_edge(b: &mut Block, i: usize) {
    let s = b.succs[i];
    b.succs.remove(i);
    let mut k = 0;
    while k < s.preds.len() {
        if s.preds[k].id == b.id { break; }
        k += 1;
    }
    s.preds.remove(k);
    for vv in s.values.iter() {
        let v = *vv;
        if v.op != OP_PHI { continue; }
        let a = v.args[k];
        a.uses -= 1;
        v.args.remove(k);
    }
}

/// Drops blocks no longer reachable from the entry and renumbers.
pub fn prune(f: &mut Func) {
    let rpo = dom::postorder_rev(f);
    if rpo.len() == f.blocks.len() { return; }
    let mut seen: Vec<bool> = Vec::new();
    seen.resize(f.blocks.len(), false);
    for b in rpo.iter() { seen[b.id as usize] = true; }
    for bb in f.blocks.iter() {
        let b = *bb;
        if seen[b.id as usize] { continue; }
        // Its edges into live blocks.
        while b.succs.len() > 0 {
            let s = b.succs[0];
            if seen[s.id as usize] {
                remove_edge(b, 0);
            } else {
                b.succs.remove(0);
            }
        }
        for vv in b.values.iter() {
            let v = *vv;
            for aa in v.args.iter() {
                let a = *aa;
                a.uses -= 1;
            }
            v.args.clear();
            v.op = OP_INVALID;
            v.block = None;
        }
        b.values.clear();
        if let Some(c) = b.control { c.uses -= 1; }
        b.control = None;
    }
    let mut kept: Vec<&mut Block> = Vec::new();
    for bb in f.blocks.iter() {
        let b = *bb;
        if seen[b.id as usize] {
            let mut ps: Vec<&mut Block> = Vec::new();
            for p in b.preds.iter() { if seen[p.id as usize] { ps.push(*p); } }
            b.preds = ps;
            kept.push(b);
        }
    }
    let mut i = 0;
    while i < kept.len() {
        kept[i].id = i as u32;
        i += 1;
    }
    f.blocks = kept;
}

/// Branch facts: below an edge of a branch on c, c is known; branches on a
/// known value become jumps.
pub fn prove(f: &mut Func, d: &dom::Dom) {
    let ch = children(f, d);
    // Known booleans: (value id, truth), a stack the walk unwinds.
    let mut facts: Vec<(u32, bool)> = Vec::new();
    // Known unsigned orders (a, b, strict: a < b, else a <= b), unwound
    // alongside.
    let mut rel: Vec<(u32, u32, bool)> = Vec::new();
    let mut rel_marks: Vec<usize> = Vec::new();
    let low = lower_bounds(f);
    let mut changed = false;
    let mut stack: Vec<(&mut Block, usize, bool)> = Vec::new();
    stack.push((f.entry.unwrap(), 0, false));
    while let Some((b, mark, done)) = stack.pop() {
        if done {
            facts.truncate(mark);
            let rm = rel_marks.pop().unwrap();
            rel.truncate(rm);
            continue;
        }
        let m = facts.len();
        stack.push((b, m, true));
        rel_marks.push(rel.len());
        // Entered from a branch only: its condition holds here.
        if b.preds.len() == 1 {
            let p = b.preds[0];
            if p.kind == B_IF && p.succs[0].id != p.succs[1].id {
                let c = p.control.unwrap();
                let t = p.succs[0].id == b.id;
                add_fact(&mut facts, c, t);
                add_rel(&mut rel, c, t);
            }
        }
        if b.kind == B_IF {
            let c = b.control.unwrap();
            let mut known = -1;
            for fc in facts.iter() {
                if fc.0 == c.id { known = if fc.1 { 1 } else { 0 }; }
            }
            // x < len from the orders known (bounds checks).
            if known < 0 && c.op == OP_LT && c.aux_int & 2 == 0 && lt_known(&rel, &low, c.args[0], c.args[1]) { known = 1; }
            if known >= 0 {
                // Keep the successor taken.
                let drop = if known == 1 { 1 } else { 0 };
                remove_edge(b, drop);
                b.kind = B_PLAIN;
                c.uses -= 1;
                b.control = None;
                changed = true;
            }
        }
        let mut k = ch.0[b.id as usize];
        while k > 0 {
            let c = d.rpo[(k - 1) as usize];
            stack.push((c, 0, false));
            k = ch.1[c.id as usize];
        }
    }
    if changed {
        prune(f);
        copyelim(f);
    }
}

/// The unsigned order a branch on c tells (c is t).
fn add_rel(rel: &mut Vec<(u32, u32, bool)>, c: &Value, t: bool) {
    if c.aux_int & 2 != 0 || c.args.len() != 2 { return; }
    let x = c.args[0].id;
    let y = c.args[1].id;
    if c.op == OP_LT {
        if t { rel.push((x, y, true)); } else { rel.push((y, x, false)); }
    } else if c.op == OP_LE {
        if t { rel.push((x, y, false)); } else { rel.push((y, x, true)); }
    }
}

// Whether a < b (or a <= b when !strict) directly.
fn has_rel(rel: &Vec<(u32, u32, bool)>, a: u32, b: u32, strict: bool) -> bool {
    for r in rel.iter() {
        if r.0 == a && r.1 == b && (r.2 || !strict) { return true; }
    }
    false
}

/// Whether x < len (unsigned) follows: known, through one other value
/// (x < y <= len, x <= y < len), or x = i - k with i < len and i >= k (an
/// induction variable's start).
fn lt_known(rel: &Vec<(u32, u32, bool)>, low: &Vec<i64>, x: &Value, len: &Value) -> bool {
    if has_rel(rel, x.id, len.id, true) { return true; }
    for r in rel.iter() {
        if r.0 == x.id {
            if r.2 && has_rel(rel, r.1, len.id, false) { return true; }
            if !r.2 && has_rel(rel, r.1, len.id, true) { return true; }
        }
    }
    if x.op == OP_SUB && x.args[1].op == OP_CONST && x.args[1].aux_int >= 1 {
        let i = x.args[0];
        let k = x.args[1].aux_int;
        if low[i.id as usize] >= k && (has_rel(rel, i.id, len.id, true) || has_rel(rel, i.id, len.id, false)) { return true; }
    }
    false
}

/// By value: a lower bound of induction variables (phi(c0, phi + s) with
/// c0 >= 0 a constant and s > 0: they only grow while the loop runs), -1
/// for others.
fn lower_bounds(f: &Func) -> Vec<i64> {
    let mut low: Vec<i64> = Vec::new();
    low.resize(f.values.len(), -1);
    for b in f.blocks.iter() {
        for v in b.values.iter() {
            if v.op != OP_PHI || v.args.len() != 2 { continue; }
            let mut c0 = -1i64;
            let mut step = false;
            for a in v.args.iter() {
                if a.op == OP_CONST && a.aux_int >= 0 {
                    c0 = a.aux_int;
                } else if a.op == OP_ADD && a.args[0].id == v.id && a.args[1].op == OP_CONST && a.args[1].aux_int > 0 {
                    step = true;
                }
            }
            if c0 >= 0 && step { low[v.id as usize] = c0; }
        }
    }
    low
}

/// Records that c is t, and what follows: not c is !t, and a comparison and
/// its negation.
fn add_fact(facts: &mut Vec<(u32, bool)>, c: &Value, t: bool) {
    facts.push((c.id, t));
    if c.op == OP_NOT && c.ty == T_BOOL { facts.push((c.args[0].id, !t)); }
}

/// Whether v may run where it was not going to (no panic, no memory).
fn safe_anywhere(v: &Value) -> bool {
    match v.op {
        OP_CONST | OP_LOCALADDR | OP_RESADDR | OP_RETPTR | OP_OFFPTR | OP_INDEXPTR | OP_AND | OP_OR | OP_XOR | OP_NOT | OP_SEXT | OP_ZEXT
            | OP_TRUNC | OP_RETYPE | OP_CONSTPARAM | OP_CONSTSYM | OP_VTABLE | OP_CLOSURECODE => true,
        OP_ADD | OP_SUB | OP_MUL | OP_NEG => v.aux_int & 1 == 0,
        _ => false,
    }
}

/// Loop-invariant code motion (Go's tighten in reverse; a part of LLVM's
/// LICM): values of a natural loop whose arguments come from outside it
/// move to the loop's preheader. All of the header's pure values may move
/// (the header runs whenever the loop is entered), loads included when
/// their memory is from outside; elsewhere only values that cannot panic
/// or read memory. Comparisons stay (they are fused into branches).
pub fn licm(f: &mut Func) {
    let d = dom::dominators(f);
    let n = f.blocks.len();
    let mut in_loop: Vec<bool> = Vec::new();
    in_loop.resize(n, false);
    let mut work: Vec<&mut Block> = Vec::new();
    let mut outside: Vec<bool> = Vec::new();
    for hh in d.rpo.iter() {
        let h = *hh;
        // Latches: predecessors the header dominates.
        let mut latches = false;
        for p in h.preds.iter() {
            if d.order[p.id as usize] >= 0 && d.dominates(h.id, p.id) { latches = true; }
        }
        if !latches { continue; }
        let mut k = 0;
        while k < n {
            in_loop[k] = false;
            k += 1;
        }
        in_loop[h.id as usize] = true;
        for p in h.preds.iter() {
            if d.order[p.id as usize] >= 0 && d.dominates(h.id, p.id) && !in_loop[p.id as usize] {
                in_loop[p.id as usize] = true;
                work.push(*p);
            }
        }
        while let Some(b) = work.pop() {
            for p in b.preds.iter() {
                if !in_loop[p.id as usize] && d.order[p.id as usize] >= 0 {
                    in_loop[p.id as usize] = true;
                    work.push(*p);
                }
            }
        }
        // The preheader: the one predecessor from outside, ending in a jump.
        let mut pre: Option<&mut Block> = None;
        let mut entries = 0;
        for p in h.preds.iter() {
            if !in_loop[p.id as usize] {
                entries += 1;
                pre = Some(*p);
            }
        }
        if entries != 1 { continue; }
        let ph = pre.unwrap();
        if ph.kind != B_PLAIN { continue; }
        // Blocks in dominator order, header first (arguments move before
        // their uses).
        outside.clear();
        outside.resize(f.values.len(), false);
        for bb in d.rpo.iter() {
            let b = *bb;
            if !in_loop[b.id as usize] { continue; }
            let header = b.id == h.id;
            let mut kept = 0;
            let mut i = 0;
            while i < b.values.len() {
                let v = b.values[i];
                let mut moves = (header && pure(v) || safe_anywhere(v)) && !(v.op == OP_EQ || v.op == OP_NE || v.op == OP_LT || v.op == OP_LE);
                if moves {
                    for a in v.args.iter() {
                        let ab = a.block.unwrap();
                        if in_loop[ab.id as usize] && !outside[a.id as usize] { moves = false; }
                    }
                }
                if moves {
                    outside[v.id as usize] = true;
                    v.block = Some(ph);
                    ph.values.push(v);
                } else {
                    b.values[kept] = v;
                    kept += 1;
                }
                i += 1;
            }
            b.values.truncate(kept);
        }
    }
}
