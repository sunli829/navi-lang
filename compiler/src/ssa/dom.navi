//! Dominators (Cooper, Harvey and Kennedy, "A Simple, Fast Dominance
//! Algorithm"), over the blocks reachable from the entry.

use crate::ssa::*;

/// Immediate dominators and the reverse postorder.
pub struct Dom {
    /// By block id: the immediate dominator's id (-1: the entry or
    /// unreachable).
    pub idom: Vec<i32>,
    /// By block id: the position in the reverse postorder (-1:
    /// unreachable).
    pub order: Vec<i32>,
    /// The reachable blocks in reverse postorder.
    pub rpo: Vec<&mut Block>,
}

/// The reachable blocks in reverse postorder.
pub fn postorder_rev(f: &Func) -> Vec<&mut Block> {
    let n = f.blocks.len();
    let mut seen: Vec<bool> = Vec::new();
    seen.resize(n, false);
    let mut post: Vec<&mut Block> = Vec::new();
    // An explicit stack of (block, next successor).
    let mut stack: Vec<(&mut Block, usize)> = Vec::new();
    let e = f.entry.unwrap();
    seen[e.id as usize] = true;
    stack.push((e, 0));
    while stack.len() > 0 {
        let top = stack.len() - 1;
        let (b, i) = stack[top];
        if i < b.succs.len() {
            stack[top] = (b, i + 1);
            let s = b.succs[i];
            if !seen[s.id as usize] {
                seen[s.id as usize] = true;
                stack.push((s, 0));
            }
        } else {
            post.push(b);
            stack.pop();
        }
    }
    post.reverse();
    post
}

pub fn dominators(f: &Func) -> &mut Dom {
    let n = f.blocks.len();
    let rpo = postorder_rev(f);
    let mut order: Vec<i32> = Vec::new();
    order.resize(n, -1);
    let mut i = 0;
    while i < rpo.len() {
        order[rpo[i].id as usize] = i as i32;
        i += 1;
    }
    let mut idom: Vec<i32> = Vec::new();
    idom.resize(n, -1);
    let e = f.entry.unwrap().id as usize;
    idom[e] = e as i32;
    let mut changed = true;
    while changed {
        changed = false;
        let mut k = 1;
        while k < rpo.len() {
            let b = rpo[k];
            let mut nd = -1i32;
            for p in b.preds.iter() {
                let pi = p.id as usize;
                if idom[pi] < 0 {
                    continue;
                }
                if nd < 0 {
                    nd = pi as i32;
                    continue;
                }
                // Intersect.
                let mut x = nd as usize;
                let mut y = pi;
                while x != y {
                    while order[x] > order[y] {
                        x = idom[x] as usize;
                    }
                    while order[y] > order[x] {
                        y = idom[y] as usize;
                    }
                }
                nd = x as i32;
            }
            if nd >= 0 && idom[b.id as usize] != nd {
                idom[b.id as usize] = nd;
                changed = true;
            }
            k += 1;
        }
    }
    idom[e] = -1;
    &mut Dom { idom, order, rpo }
}

impl Dom {
    /// Whether block a dominates block b (both reachable).
    pub fn dominates(&self, a: u32, b: u32) -> bool {
        let mut x = b as i32;
        while x >= 0 {
            if x == a as i32 {
                return true;
            }
            x = self.idom[x as usize];
        }
        false
    }
}
