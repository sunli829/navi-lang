//! Preparation for register allocation: critical edges split (moves for
//! phis go at the end of the predecessor), comparisons only a branch reads
//! fused into it, and constant offsets folded into loads and stores.

use crate::ssa::*;

/// Splits the edges from blocks with several successors to blocks with
/// phis and several predecessors (Go's critical, for the phis' moves).
pub fn split_critical(f: &mut Func) {
    let n = f.blocks.len();
    let mut bi = 0;
    while bi < n {
        let b = f.blocks[bi];
        bi += 1;
        if b.succs.len() < 2 { continue; }
        let mut i = 0;
        while i < b.succs.len() {
            let s = b.succs[i];
            i += 1;
            if s.preds.len() < 2 { continue; }
            let mut phis = false;
            for v in s.values.iter() { if v.op == OP_PHI { phis = true; } }
            if !phis { continue; }
            let e = f.new_block(B_PLAIN);
            e.pos = b.pos;
            // The edge's place among s's predecessors (the k-th edge from
            // b is the k-th time b appears there).
            let mut k = 0;
            let mut j = 0;
            while j + 1 < i {
                if b.succs[j].id == s.id { k += 1; }
                j += 1;
            }
            let mut p = 0;
            while p < s.preds.len() {
                if s.preds[p].id == b.id {
                    if k == 0 { break; }
                    k -= 1;
                }
                p += 1;
            }
            s.preds[p] = e;
            e.preds.push(b);
            e.succs.push(s);
            b.succs[i - 1] = e;
        }
    }
}

/// Marks comparisons whose only use is their block's branch and moves them
/// to the end of the block (the branch tests the flags; no register).
pub fn fuse_compares(f: &mut Func) -> Vec<bool> {
    let mut fused: Vec<bool> = Vec::new();
    fused.resize(f.values.len(), false);
    for bb in f.blocks.iter() {
        let b = *bb;
        if b.kind != B_IF { continue; }
        let c = b.control.unwrap();
        if c.uses != 1 || c.block.unwrap().id != b.id { continue; }
        if !(c.op == OP_EQ || c.op == OP_NE || c.op == OP_LT || c.op == OP_LE) { continue; }
        let mut i = 0;
        while i < b.values.len() {
            if b.values[i].id == c.id { break; }
            i += 1;
        }
        b.values.remove(i);
        b.values.push(c);
        fused[c.id as usize] = true;
    }
    fused
}

/// Folds OffPtr into the offset (aux_int) of loads and stores.
pub fn fold_offsets(f: &mut Func) {
    for bb in f.blocks.iter() {
        for vv in bb.values.iter() {
            let v = *vv;
            if v.op != OP_LOAD && v.op != OP_STORE { continue; }
            loop {
                let a = v.args[0];
                if a.op != OP_OFFPTR { break; }
                v.aux_int = v.aux_int + a.aux_int;
                v.set_arg(0, a.args[0]);
            }
        }
    }
}
