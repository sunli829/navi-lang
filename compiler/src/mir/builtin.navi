//! Calls of compiler-provided trait methods on primitive types as the
//! operations they are: `a < b` through PartialOrd::lt on usize is a
//! comparison, x.clone() a copy. Inlined generic code (Range::next) is full
//! of them; no one else can implement these traits for primitives.

use crate::{mir::*, types};

fn primitive(t: &types::Type) -> bool {
    let k = t.kind;
    (k == types::K_INT && crate::layout::int_size(t.int) <= 8)
        || k == types::K_BOOL
        || k == types::K_CHAR
        || k == types::K_FLOAT
}

/// The operand reading what a reference operand points to.
fn deref_op(x: &Operand) -> Option<Operand> {
    if x.kind != OP_COPY {
        return None;
    }
    Some(copy(x.place.deref()))
}

/// Rewrites f's calls of builtin comparisons and clones on primitives;
/// whether it changed f.
pub fn lower_builtin_calls(f: &mut Func) -> bool {
    let mut changed = false;
    let mut bi = 0;
    while bi < f.blocks.len() {
        let b = f.blocks[bi];
        bi += 1;
        let (fn_op, args, dest, target, pos) = match &b.term {
            Term::Call {
                fn_op,
                args,
                dest,
                target,
                pos,
            } => (fn_op, args, dest, *target, *pos),
            _ => continue,
        };
        if target < 0 || fn_op.kind != OP_CONST {
            continue;
        }
        let c = fn_op.cnst.unwrap();
        if c.kind != C_FN {
            continue;
        }
        let r = c.fn_ref.unwrap();
        if r.closure.is_some() || r.ctor {
            continue;
        }
        let d = match r.def {
            Some(d) => d,
            None => continue,
        };
        let tr = match d.parent {
            Some(p) => p,
            None => continue,
        };
        if tr.kind != crate::resolve::DEF_TRAIT {
            continue;
        }
        let st = match r.self_ty {
            Some(t) => t,
            None => continue,
        };
        if !primitive(st) || r.args.len() > 1 {
            continue;
        }
        let tn = tr.name.as_str();
        let mn = d.name.as_str();
        let rv = if (tn == "PartialOrd" || tn == "PartialEq") && args.len() == 2 {
            let op = match mn {
                "lt" => LT,
                "le" => LE,
                "gt" => GT,
                "ge" => GE,
                "eq" => EQ,
                "ne" => NE,
                _ => continue,
            };
            // Rust's comparisons take &Rhs: only Rhs = Self here.
            if r.args.len() == 1 && r.args[0].id != st.id {
                continue;
            }
            let x = match deref_op(&args[0]) {
                Some(x) => x,
                None => continue,
            };
            let y = match deref_op(&args[1]) {
                Some(y) => y,
                None => continue,
            };
            Rvalue::Bin {
                op,
                x,
                y,
                ty: st,
                pos: 0,
            }
        } else if tn == "Clone" && mn == "clone" && args.len() == 1 {
            let x = match deref_op(&args[0]) {
                Some(x) => x,
                None => continue,
            };
            Rvalue::Use(x)
        } else {
            continue;
        };
        let _ = pos;
        // Blocks may be shared with other functions (inlined copies): a new
        // one.
        let mut stmts = b.stmts.clone();
        stmts.push(Stmt::Assign {
            place: dest.clone(),
            rv,
        });
        f.blocks[bi - 1] = &mut Block {
            stmts,
            term: Term::Goto(target as usize),
        };
        changed = true;
    }
    changed
}
