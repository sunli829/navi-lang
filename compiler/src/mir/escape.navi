//! Escape analysis: finds the address-taken locals whose address never
//! outlives the function's frame, so they need no heap cell.
//!
//! Within a function this is Steensgaard's points-to analysis: every
//! local has a location node, every node (class) has one pointee class,
//! assignments unify pointee classes (field-insensitively), and the heap,
//! statics and anything unknown are one escaped class H whose pointee is
//! itself. A local escapes if its location ends up in H, or is reachable
//! from memory the function does not own (what its parameters, closure
//! environment or result point to).
//!
//! Calls use per-function summaries, computed for all functions to a fixed
//! point: for each parameter, the depth at which its pointee chain escapes,
//! and which levels of parameter and result chains are unified (up to depth
//! D). Trait and dyn calls merge the summaries of every impl of the method
//! (plus a conservative shape for builtin and derived impls); calls of
//! closures, extern functions and unknown intrinsics escape everything.
//!
//! A local declared inside a loop is a new variable in every iteration; if
//! its address is reachable from a named variable or argument (which could
//! carry it into a later iteration), it keeps its heap cell.

use std::collections::HashMap;

use crate::{
    mir::*,
    resolve::{self, Def, Node},
    syntax::ast::Item,
    types::{
        self, Type,
        collect::{Info, has_attr},
    },
};

const D: usize = 3;

/// The effect of a call on its arguments and result: esc[k] is the depth
/// (1..=D) from which chain k escapes (0: never; chain n is the result);
/// pairs unify level d of chain a with level e of chain b.
#[derive(Clone)]
pub struct Summary {
    esc: Vec<u8>,
    pairs: Vec<(u8, u8, u8, u8)>,
}

/// A summary's parts (to store it: crate::libcache).
pub fn summary_parts(s: &Summary) -> (Vec<u8>, Vec<(u8, u8, u8, u8)>) {
    (s.esc, s.pairs)
}

/// The summary of the parts summary_parts gave.
pub fn summary_from(esc: Vec<u8>, pairs: Vec<(u8, u8, u8, u8)>) -> Summary {
    Summary { esc, pairs }
}

fn empty_summary(nargs: usize) -> Summary {
    let mut esc = Vec::new();
    let mut i = 0;
    while i <= nargs {
        esc.push(0u8);
        i += 1;
    }
    Summary {
        esc,
        pairs: Vec::new(),
    }
}

fn summary_eq(a: &Summary, b: &Summary) -> bool {
    if a.esc != b.esc || a.pairs.len() != b.pairs.len() {
        return false;
    }
    let mut i = 0;
    while i < a.pairs.len() {
        if a.pairs[i] != b.pairs[i] {
            return false;
        }
        i += 1;
    }
    true
}

/// The union-find points-to graph of one function.
struct Graph {
    parent: Vec<usize>,
    pt: Vec<i64>,
    escaped: Vec<bool>,
    h: usize,
}

fn new_graph(nlocals: usize) -> &mut Graph {
    let g = &mut Graph {
        parent: Vec::new(),
        pt: Vec::new(),
        escaped: Vec::new(),
        h: 0,
    };
    let mut i = 0;
    while i <= nlocals {
        g.parent.push(i);
        g.pt.push(-1);
        g.escaped.push(false);
        i += 1;
    }
    // Node nlocals is H: escaped, pointing to itself.
    g.h = nlocals;
    g.escaped[nlocals] = true;
    g.pt[nlocals] = nlocals as i64;
    g
}

impl Graph {
    fn find(&mut self, x: usize) -> usize {
        let mut r = x;
        while self.parent[r] != r {
            r = self.parent[r];
        }
        let mut y = x;
        while self.parent[y] != r {
            let n = self.parent[y];
            self.parent[y] = r;
            y = n;
        }
        r
    }

    fn new_node(&mut self) -> usize {
        let n = self.parent.len();
        self.parent.push(n);
        self.pt.push(-1);
        self.escaped.push(false);
        n
    }

    /// The pointee class of x (created on first use).
    fn deref(&mut self, x: usize) -> usize {
        let r = self.find(x);
        if self.pt[r] < 0 {
            let n = self.new_node();
            self.pt[r] = n as i64;
        }
        let p = self.pt[r] as usize;
        self.find(p)
    }

    /// The pointee of x if it has one.
    fn pointee(&mut self, x: usize) -> Option<usize> {
        let r = self.find(x);
        if self.pt[r] < 0 {
            return None;
        }
        let p = self.pt[r] as usize;
        Some(self.find(p))
    }

    /// Unifies two classes and, recursively, their pointees.
    fn join(&mut self, a0: usize, b0: usize) {
        let mut work: Vec<(usize, usize)> = Vec::new();
        work.push((a0, b0));
        while work.len() > 0 {
            let (a, b) = work.pop().unwrap();
            let ra = self.find(a);
            let rb = self.find(b);
            if ra == rb {
                continue;
            }
            // Keep H as the root.
            let (keep, gone) = if rb == self.h { (rb, ra) } else { (ra, rb) };
            self.parent[gone] = keep;
            if self.escaped[gone] {
                self.escaped[keep] = true;
            }
            let pk = self.pt[keep];
            let pg = self.pt[gone];
            if pk < 0 {
                self.pt[keep] = pg;
            } else if pg >= 0 {
                work.push((pk as usize, pg as usize));
            }
        }
    }

    /// Level d (1 = what x points to) of the chain from x.
    fn level(&mut self, x: usize, d: usize) -> usize {
        let mut n = x;
        let mut i = 0;
        while i < d {
            n = self.deref(n);
            i += 1;
        }
        n
    }
}

fn first_param(f: &Func) -> usize {
    if f.closure { 2 } else { 1 }
}

/// Intrinsics that keep no pointer: some return pointers into what
/// argument 0 points to.
fn intrinsic_summary(name: &str, nargs: usize) -> Option<Summary> {
    let mut s = empty_summary(nargs);
    match name {
        // The result points into what argument 0 points to.
        "ptr_offset" | "slice_from_raw" | "slice_from_raw_mut" | "str_from_raw" | "slice_ptr"
        | "str_as_bytes" => {
            let mut d = 1;
            while d <= D {
                s.pairs.push((0, d as u8, nargs as u8, d as u8));
                d += 1;
            }
        }
        "size_of" | "align_of" | "slice_len" | "wrapping_add" | "wrapping_sub" | "wrapping_mul"
        | "mul_hi" | "add_carry" | "sub_borrow" | "has_pointers" | "is_copy_clone"
        | "type_desc" | "type_info" | "write" | "fmt_float" | "float_op" | "monotonic_nanos"
        | "panic_raw" | "exit" | "os_arg_count" | "os_arg" | "os_getenv" | "os_system" => {}
        n if n.starts_with("fs_") => {}
        // Fresh heap memory.
        "alloc" | "alloc_array" => s.esc[nargs] = 1,
        // Copies what src points to into what dst points to.
        "copy" => {
            let mut d = 2;
            while d <= D {
                s.pairs.push((0, d as u8, 1, d as u8));
                d += 1;
            }
        }
        _ => return None,
    }
    Some(s)
}

/// The conservative shape of builtin and derived impls of a lang trait's
/// methods.
fn builtin_pairs(trait_name: &str, s: &mut Summary, nargs: usize) {
    let r = nargs as u8;
    match trait_name {
        // The result is (a copy of) what self points to.
        "Clone" | "Deref" | "DerefMut" => {
            let mut d = 2;
            while d <= D {
                s.pairs.push((0, d as u8, r, (d - 1) as u8));
                d += 1;
            }
        }
        "Index" | "IndexMut" => {
            let mut d = 1;
            while d <= D {
                s.pairs.push((0, d as u8, r, d as u8));
                d += 1;
            }
        }
        _ => {}
    }
}

// Whether the shims of a lang trait call the method on the parts of the
// self type (a reference's referent, a tuple's or an array's elements).
fn forwards(trait_name: &str) -> bool {
    match trait_name {
        "Clone" | "PartialEq" | "PartialOrd" | "Ord" | "Hash" | "Default" | "Debug" | "Display"
        | "LowerHex" | "UpperHex" | "Octal" | "Binary" | "LowerExp" | "UpperExp" => true,
        _ => false,
    }
}

/// The head of a self type that selects impls (-1: any impl may apply).
/// Impls do not overlap, so a call whose self type has a concrete head can
/// only reach impls with that head or blanket impls.
fn head(t: &Type) -> i64 {
    let k = t.kind;
    if k == types::K_ADT {
        return t.d().id as i64 * 32 + 31;
    }
    if k == types::K_PARAM
        || k == types::K_PROJ
        || k == types::K_DYN
        || k == types::K_OPAQUE
        || k == types::K_INFER
        || k == types::K_ERROR
    {
        return -1;
    }
    k as i64
}

struct Escape {
    summaries: HashMap<u32, Summary>,
    /// The summaries of finished functions, read under this (a worker's
    /// summaries are its own).
    shared: Option<HashMap<u32, Summary>>,
    by_def: HashMap<u32, &mut Func>,
    impls: HashMap<String, Vec<(&mut Func, i64)>>,
    lang_of: HashMap<u32, String>,
    changed: bool,
    debug: String,
    /// The functions whose summaries the graph being built used.
    used: Vec<u32>,
    /// Per function id, the functions whose graphs use its summary.
    users: HashMap<u32, Vec<u32>>,
}

fn unknown_summary(nargs: usize) -> Summary {
    let mut s = empty_summary(nargs);
    let mut k = 0;
    while k <= nargs {
        s.esc[k] = 1;
        k += 1;
    }
    s
}

fn merge(s: &mut Summary, t: Summary) {
    let mut k = 0;
    while k < s.esc.len() && k < t.esc.len() {
        if t.esc[k] != 0 && (s.esc[k] == 0 || t.esc[k] < s.esc[k]) {
            s.esc[k] = t.esc[k];
        }
        k += 1;
    }
    for p in t.pairs.iter() {
        if !s.pairs.contains(p) {
            s.pairs.push(*p);
        }
    }
}

impl Escape {
    // A worker's copy: its own summaries over the finished ones.
    fn copy(&mut self) -> &mut Escape {
        &mut Escape {
            summaries: HashMap::new(),
            shared: Some(self.summaries),
            by_def: self.by_def,
            impls: self.impls,
            lang_of: self.lang_of,
            changed: false,
            used: Vec::new(),
            users: self.users,
            debug: self.debug.clone(),
        }
    }

    /// The summary of a call through fn_op with nargs arguments (None:
    /// unknown callee).
    fn callee(&mut self, fn_op: &Operand, nargs: usize) -> Option<Summary> {
        if fn_op.kind != OP_CONST {
            return None;
        }
        let c = fn_op.cnst.unwrap();
        if c.kind != C_FN {
            return None;
        }
        let r = c.fn_ref.unwrap();
        if r.closure.is_some() {
            return None;
        }
        if r.ctor {
            // The result holds the arguments.
            let mut s = empty_summary(nargs);
            let mut k = 0;
            while k < nargs {
                let mut d = 1;
                while d <= D {
                    s.pairs.push((k as u8, d as u8, nargs as u8, d as u8));
                    d += 1;
                }
                k += 1;
            }
            return Some(s);
        }
        let d = r.def?;
        if let Node::Item(Item::Fn(fd)) = &d.node {
            if has_attr(&fd.base.attrs, "intrinsic") {
                return intrinsic_summary(d.name.as_str(), nargs);
            }
        }
        let asm = match &d.node {
            Node::Item(Item::Fn(fd)) => has_attr(&fd.base.attrs, "asm"),
            _ => false,
        };
        if d.kind == resolve::DEF_EXTERN_FN || asm {
            // C code cannot keep GC pointers (the collector does not see
            // its memory); a returned pointer may point into an argument.
            let mut s = empty_summary(nargs);
            let mut k = 0;
            while k < nargs {
                let mut d = 1;
                while d <= D {
                    s.pairs.push((k as u8, d as u8, nargs as u8, d as u8));
                    d += 1;
                }
                k += 1;
            }
            return Some(s);
        }
        let in_trait = match d.parent {
            Some(p) => p.kind == resolve::DEF_TRAIT,
            None => false,
        };
        if in_trait {
            let p = d.parent.unwrap();
            let mut s = empty_summary(nargs);
            if let Some(ln) = self.lang_of.get(&p.id) {
                builtin_pairs(ln.as_str(), &mut s, nargs);
            }
            let key = `${p.id}.${d.name}`.to_string();
            // The impls the call may reach: those for the self type's head
            // (and blanket ones); for a builtin impl (a shim, made later by
            // the code generator), those of the parts it calls the method of
            // (<&T as Display>::fmt calls T's); any, for a type parameter.
            let fwd = match self.lang_of.get(&p.id) {
                Some(n) => forwards(n.as_str()),
                None => false,
            };
            let shim = match r.self_ty {
                Some(t) => self.merge_for(&key, t, nargs, &mut s, fwd, 0),
                None => {
                    self.merge_all(&key, nargs, &mut s);
                    true
                }
            };
            // Debug's shims keep the Formatter in a boxed builder
            // (Formatter::debug_tuple).
            let debug = match self.lang_of.get(&p.id) {
                Some(n) => n == "Debug",
                None => false,
            };
            if debug && shim && nargs > 1 {
                s.esc[1] = 1;
            }
            return Some(s);
        }
        match self.by_def.get(&d.id) {
            Some(f) => Some(self.summary_of(*f, nargs)),
            None => None,
        }
    }

    // Merges into s the summaries of key's impls a call with self type t
    // may reach; whether it may reach a shim (an impl no source has).
    fn merge_for(
        &mut self,
        key: &String,
        t: &Type,
        nargs: usize,
        s: &mut Summary,
        fwd: bool,
        depth: usize,
    ) -> bool {
        let h = head(t);
        if h < 0 || depth > 4 {
            self.merge_all(key, nargs, s);
            return true;
        }
        let mut exact = false;
        if let Some(fs) = self.impls.get(key) {
            for (f, fh) in fs.iter() {
                if *fh < 0 || *fh == h {
                    merge(s, self.summary_of(*f, nargs));
                    if *fh == h {
                        exact = true;
                    }
                }
            }
        }
        if exact {
            return false;
        }
        // A shim: its parts' impls, if its trait's shims call them (scalars'
        // call std::fmt::rt's helpers, which keep nothing).
        if !fwd {
            return true;
        }
        let k = t.kind;
        if k == types::K_REF || k == types::K_PTR || k == types::K_ARRAY || k == types::K_SLICE {
            self.merge_for(key, t.el(), nargs, s, fwd, depth + 1);
        } else if k == types::K_TUPLE {
            for e in t.elems.iter() {
                self.merge_for(key, *e, nargs, s, fwd, depth + 1);
            }
        }
        true
    }

    fn merge_all(&mut self, key: &String, nargs: usize, s: &mut Summary) {
        if let Some(fs) = self.impls.get(key) {
            for (f, _) in fs.iter() {
                merge(s, self.summary_of(*f, nargs));
            }
        }
    }

    fn summary_of(&mut self, f: &Func, nargs: usize) -> Summary {
        self.used.push(f.id);
        let found = match self.summaries.get(&f.id) {
            Some(s) => Some(s.clone()),
            None => match self.shared {
                Some(sh) => match sh.get(&f.id) {
                    Some(s) => Some(s.clone()),
                    None => None,
                },
                None => None,
            },
        };
        match found {
            Some(s) => {
                if s.esc.len() == nargs + 1 {
                    s
                } else {
                    unknown_summary(nargs)
                }
            }
            None => empty_summary(nargs),
        }
    }

    /// Builds the points-to graph of f.
    fn graph(&mut self, f: &Func) -> &mut Graph {
        let n = f.locals.len();
        let g = new_graph(n);
        for b in f.blocks.iter() {
            for s in b.stmts.iter() {
                match s {
                    Stmt::Assign { place, rv } => {
                        let dl = loc(g, place);
                        let dv = g.deref(dl);
                        match rv {
                            Rvalue::Use(x)
                            | Rvalue::Cast { x, .. }
                            | Rvalue::Unsize { x, .. }
                            | Rvalue::MakeDyn { x, .. } => flow(g, dv, x),
                            Rvalue::Ref { place: p, .. } => {
                                let l = loc(g, p);
                                g.join(dv, l);
                            }
                            Rvalue::Bin { op, x, y, .. } => {
                                if *op == OFFSET {
                                    flow(g, dv, x);
                                    flow(g, dv, y);
                                }
                            }
                            Rvalue::Aggregate { ops, closure, .. } => {
                                if closure.is_some() {
                                    for o in ops.iter() {
                                        escape_op(g, o);
                                    }
                                    let h = g.h;
                                    g.join(dv, h);
                                } else {
                                    for o in ops.iter() {
                                        flow(g, dv, o);
                                    }
                                }
                            }
                            _ => {}
                        }
                    }
                    Stmt::Box { local, .. } => {
                        let p = g.deref(*local);
                        let h = g.h;
                        g.join(p, h);
                    }
                    Stmt::PushDefer { fn_op, args } => {
                        escape_op(g, fn_op);
                        for a in args.iter() {
                            escape_op(g, a);
                        }
                    }
                    _ => {}
                }
            }
            if let Term::Call {
                fn_op, args, dest, ..
            } = &b.term
            {
                if self.debug.len() > 0 && f.name.contains(self.debug.as_str()) {
                    let sm = match self.callee(fn_op, args.len()) {
                        Some(s) => `${s.esc:?}`.to_string(),
                        None => "unknown".to_string(),
                    };
                    eprintln(`  call in ${f.name}: ${operand_string(fn_op)} ${sm}`);
                }
                match self.callee(fn_op, args.len()) {
                    None => {
                        for a in args.iter() {
                            escape_op(g, a);
                        }
                        let dl = loc(g, dest);
                        let dv = g.deref(dl);
                        let h = g.h;
                        g.join(dv, h);
                    }
                    Some(s) => {
                        // A result without pointers holds no argument's address
                        // (an asm or C function's summary assumes it may).
                        if dest.proj.len() == 0 && pointer_free(f.locals[dest.local].ty) {
                            let n = args.len() as u8;
                            let mut t = empty_summary(args.len());
                            t.esc = s.esc;
                            for p in s.pairs.iter() {
                                if p.0 != n && p.2 != n {
                                    t.pairs.push(*p);
                                }
                            }
                            apply(g, &t, args, dest);
                        } else {
                            apply(g, &s, args, dest);
                        }
                    }
                }
            }
        }
        g
    }

    /// Recomputes the summary of f.
    fn summarize(&mut self, f: &Func) {
        let g = self.graph(f);
        let mut roots: Vec<usize> = Vec::new();
        let mut i = first_param(f);
        while i <= f.nargs {
            roots.push(i);
            i += 1;
        }
        roots.push(0);
        let nargs = roots.len() - 1;
        let mut s = empty_summary(nargs);
        let mut chains: Vec<Vec<usize>> = Vec::new();
        for r in roots.iter() {
            let mut c = Vec::new();
            let mut d = 1;
            while d <= D {
                c.push(g.level(*r, d));
                d += 1;
            }
            chains.push(c);
        }
        let mut k = 0;
        while k < chains.len() {
            let mut d = 0;
            while d < D {
                let r = g.find(chains[k][d]);
                if g.escaped[r] && s.esc[k] == 0 {
                    s.esc[k] = (d + 1) as u8;
                }
                d += 1;
            }
            k += 1;
        }
        // Unified levels between different chains.
        let mut a = 0;
        while a < chains.len() {
            let mut b = a + 1;
            while b < chains.len() {
                let mut d = 0;
                while d < D {
                    let mut e = 0;
                    while e < D {
                        let ca = g.find(chains[a][d]);
                        let cb = g.find(chains[b][e]);
                        if ca == cb && !g.escaped[ca] {
                            s.pairs
                                .push((a as u8, (d + 1) as u8, b as u8, (e + 1) as u8));
                        }
                        e += 1;
                    }
                    d += 1;
                }
                b += 1;
            }
            a += 1;
        }
        let same = match self.summaries.get(&f.id) {
            Some(o) => summary_eq(o, &s),
            None => false,
        };
        if !same {
            self.summaries.insert(f.id, s);
            self.changed = true;
        }
    }

    /// The locals of f whose address may stay in the frame.
    fn keep(&mut self, f: &Func) -> Vec<bool> {
        let g = self.graph(f);
        let n = f.locals.len();
        // Memory f does not own: reachable from what its parameters, closure
        // environment and result point to.
        let mut external: HashMap<usize, bool> = HashMap::new();
        let mut work: Vec<usize> = Vec::new();
        let mut i = 0;
        while i <= f.nargs && i < n {
            if let Some(p) = g.pointee(i) {
                work.push(p);
            }
            i += 1;
        }
        while work.len() > 0 {
            let x = work.pop().unwrap();
            let r = g.find(x);
            if external.contains_key(&r) {
                continue;
            }
            external.insert(r, true);
            if let Some(p) = g.pointee(r) {
                work.push(p);
            }
        }
        let in_loop = loop_blocks(f);
        let mut decl_block: Vec<i64> = Vec::new();
        i = 0;
        while i < n {
            decl_block.push(-1);
            i += 1;
        }
        let mut bi = 0;
        while bi < f.blocks.len() {
            for s in f.blocks[bi].stmts.iter() {
                if let Stmt::StorageLive(l) = s {
                    decl_block[*l] = bi as i64;
                }
            }
            bi += 1;
        }
        // For each class: a named variable or argument whose value reaches
        // it through pointees, and whether more than one does.
        let nn = g.parent.len();
        let mut root_of: Vec<i64> = Vec::new();
        let mut multi: Vec<bool> = Vec::new();
        let mut last: Vec<i64> = Vec::new();
        let mut computed = false;
        let mut out: Vec<bool> = Vec::new();
        i = 0;
        while i < n {
            let r = g.find(i);
            let mut ok = !g.escaped[r] && !external.contains_key(&r);
            if ok && decl_block[i] >= 0 && in_loop[decl_block[i] as usize] {
                if !computed {
                    let mut k = 0;
                    while k < nn {
                        root_of.push(-1);
                        multi.push(false);
                        last.push(-1);
                        k += 1;
                    }
                    let mut j = 0;
                    while j < n {
                        if j <= f.nargs || f.locals[j].name.len() > 0 {
                            let mut cur = g.pointee(j);
                            while let Some(c0) = cur {
                                let c = g.find(c0);
                                if last[c] == j as i64 {
                                    break;
                                }
                                last[c] = j as i64;
                                if root_of[c] < 0 {
                                    root_of[c] = j as i64;
                                } else if root_of[c] != j as i64 {
                                    multi[c] = true;
                                }
                                cur = g.pointee(c);
                            }
                        }
                        j += 1;
                    }
                    computed = true;
                }
                // Reachable from another named variable or an argument?
                if multi[r] || root_of[r] >= 0 && root_of[r] != i as i64 {
                    ok = false;
                }
            }
            out.push(ok);
            i += 1;
        }
        out
    }
}

/// The location node of a place (field-insensitive: only derefs move).
fn loc(g: &mut Graph, p: &Place) -> usize {
    let mut n = p.local;
    for pr in p.proj.iter() {
        if pr.kind == P_DEREF {
            n = g.deref(n);
        }
    }
    g.find(n)
}

/// The value of operand x flows into a value whose pointee is dv.
fn flow(g: &mut Graph, dv: usize, x: &Operand) {
    if x.kind == OP_COPY {
        let l = loc(g, &x.place);
        let p = g.deref(l);
        g.join(dv, p);
        return;
    }
    let c = x.cnst.unwrap();
    if c.kind == C_STATIC || c.kind == C_STR || c.kind == C_BYTES || c.kind == C_FN {
        let h = g.h;
        g.join(dv, h);
    }
}

fn escape_op(g: &mut Graph, x: &Operand) {
    if x.kind == OP_COPY {
        let l = loc(g, &x.place);
        let p = g.deref(l);
        let h = g.h;
        g.join(p, h);
    }
}

/// Applies a callee summary at a call.
/// Whether values of t hold no pointers (scalars, and tuples and arrays of
/// them).
fn pointer_free(t: &Type) -> bool {
    let k = t.kind;
    if k == types::K_INT
        || k == types::K_FLOAT
        || k == types::K_BOOL
        || k == types::K_CHAR
        || k == types::K_NEVER
    {
        return true;
    }
    if k == types::K_ARRAY {
        return pointer_free(t.el());
    }
    if k == types::K_TUPLE {
        for e in t.elems.iter() {
            if !pointer_free(*e) {
                return false;
            }
        }
        return true;
    }
    false
}

fn apply(g: &mut Graph, s: &Summary, args: &Vec<Operand>, dest: &Place) {
    let n = args.len();
    // The chain roots: each argument's value and the result.
    let mut nodes: Vec<i64> = Vec::new();
    for a in args.iter() {
        if a.kind == OP_COPY {
            let l = loc(g, &a.place);
            nodes.push(l as i64);
        } else {
            nodes.push(-1);
        }
    }
    let dl = loc(g, dest);
    nodes.push(dl as i64);
    let mut k = 0;
    while k <= n {
        if nodes[k] >= 0 && k < s.esc.len() && s.esc[k] != 0 {
            let x = g.level(nodes[k] as usize, s.esc[k] as usize);
            let h = g.h;
            g.join(x, h);
        }
        k += 1;
    }
    for p in s.pairs.iter() {
        let (a, d, b, e) = *p;
        if (a as usize) <= n
            && (b as usize) <= n
            && nodes[a as usize] >= 0
            && nodes[b as usize] >= 0
        {
            let x = g.level(nodes[a as usize] as usize, d as usize);
            let y = g.level(nodes[b as usize] as usize, e as usize);
            g.join(x, y);
        }
    }
}

fn successors(t: &Term) -> Vec<usize> {
    let mut out = Vec::new();
    match t {
        Term::Goto(b) => out.push(*b),
        Term::Switch { targets, els, .. } => {
            for b in targets.iter() {
                out.push(*b);
            }
            out.push(*els);
        }
        Term::Call { target, .. } => {
            if *target >= 0 {
                out.push(*target as usize);
            }
        }
        Term::Assert { target, .. } => out.push(*target),
        _ => {}
    }
    out
}

/// Which blocks lie on a cycle of the control flow graph (Tarjan).
fn loop_blocks(f: &Func) -> Vec<bool> {
    let n = f.blocks.len();
    let mut succ: Vec<Vec<usize>> = Vec::new();
    for b in f.blocks.iter() {
        succ.push(successors(&b.term));
    }
    let mut index: Vec<i64> = Vec::new();
    let mut low: Vec<i64> = Vec::new();
    let mut on_stack: Vec<bool> = Vec::new();
    let mut out: Vec<bool> = Vec::new();
    let mut i = 0;
    while i < n {
        index.push(-1);
        low.push(0);
        on_stack.push(false);
        out.push(false);
        i += 1;
    }
    let mut next_index = 0i64;
    let mut stack: Vec<usize> = Vec::new();
    let mut root = 0;
    while root < n {
        if index[root] >= 0 {
            root += 1;
            continue;
        }
        let mut work: Vec<(usize, usize)> = Vec::new();
        work.push((root, 0));
        index[root] = next_index;
        low[root] = next_index;
        next_index += 1;
        stack.push(root);
        on_stack[root] = true;
        while work.len() > 0 {
            let top = work.len() - 1;
            let (v, k) = work[top];
            if k < succ[v].len() {
                work[top] = (v, k + 1);
                let w = succ[v][k];
                if index[w] < 0 {
                    index[w] = next_index;
                    low[w] = next_index;
                    next_index += 1;
                    stack.push(w);
                    on_stack[w] = true;
                    work.push((w, 0));
                } else if on_stack[w] {
                    if index[w] < low[v] {
                        low[v] = index[w];
                    }
                }
                continue;
            }
            work.pop();
            if work.len() > 0 {
                let u = work[work.len() - 1].0;
                if low[v] < low[u] {
                    low[u] = low[v];
                }
            }
            if low[v] == index[v] {
                let mut members: Vec<usize> = Vec::new();
                loop {
                    let w = stack.pop().unwrap();
                    on_stack[w] = false;
                    members.push(w);
                    if w == v {
                        break;
                    }
                }
                let cyclic = members.len() > 1 || succ[v].contains(&v);
                if cyclic {
                    for m in members.iter() {
                        out[*m] = true;
                    }
                }
            }
        }
        root += 1;
    }
    out
}

/// Runs the analysis over all functions and returns, per function id, the
/// locals whose address may stay in the frame.
/// ext: functions of crates compiled separately (bodiless stand-ins), with
/// the summaries their compilation found (docs/crates.md); they are called
/// and implement traits as the program's own. Returns what each function
/// keeps in its frame and each function's summary.
pub fn analyze_program(
    info: &Info,
    funcs: &Vec<&mut Func>,
    ext: &Vec<(&mut Func, Summary)>,
) -> (HashMap<u32, Vec<bool>>, HashMap<u32, Summary>) {
    let e = &mut Escape {
        summaries: HashMap::new(),
        shared: None,
        by_def: HashMap::new(),
        impls: HashMap::new(),
        lang_of: HashMap::new(),
        changed: true,
        used: Vec::new(),
        users: HashMap::new(),
        debug: match crate::dflags::value("escdebug") {
            Some(v) => {
                if v == "1" {
                    String::new()
                } else {
                    v
                }
            }
            None => String::new(),
        },
    };
    for (name, d) in info.lang.iter() {
        e.lang_of.insert(d.id, name.clone());
    }
    let mut known: Vec<&mut Func> = funcs.clone();
    for (f, sm) in ext.iter() {
        known.push(*f);
        e.summaries.insert(f.id, sm.clone());
    }
    for f in known.iter() {
        if let Some(d) = f.def {
            e.by_def.insert(d.id, *f);
            if let Some(p) = d.parent {
                // Trait impl methods and trait default bodies.
                let mut trait_id: i64 = -1;
                let mut h: i64 = -1;
                if p.kind == resolve::DEF_TRAIT {
                    trait_id = p.id as i64;
                }
                if p.kind == resolve::DEF_IMPL {
                    if let Some(ii) = info.impls.get(&p.id) {
                        if let Some(tr) = ii.trait_ref {
                            trait_id = tr.trait_def().id as i64;
                            h = head(ii.self_ty);
                        }
                    }
                }
                if trait_id >= 0 {
                    let key = `${trait_id}.${d.name}`.to_string();
                    if !e.impls.contains_key(&key) {
                        e.impls.insert(key.clone(), Vec::new());
                    }
                    let mut list = e.impls[&key];
                    list.push((*f, h));
                }
            }
        }
    }
    // Summaries bottom-up over the call graph (as Go does): the functions
    // whose summaries a function's graph uses do not depend on summary
    // values, so they are found first (on several threads); then each
    // strongly connected component is summarized after the components it
    // calls, a single function once, a recursive set until no summary
    // changes. Components at the same depth are summarized on several
    // threads.
    let n = funcs.len();
    let mut index: HashMap<u32, usize> = HashMap::new();
    let mut fi = 0;
    while fi < n {
        index.insert(funcs[fi].id, fi);
        fi += 1;
    }
    let mut deps: Vec<Vec<usize>> = Vec::new();
    for _ in funcs.iter() {
        deps.push(Vec::new());
    }
    crate::util::par_for(n, 16, |i| {
        let w = e.copy();
        w.graph(funcs[i]);
        let mut ds: Vec<usize> = Vec::new();
        for u in w.used.iter() {
            if let Some(j) = index.get(u) {
                if !ds.contains(j) {
                    ds.push(*j);
                }
            }
        }
        deps[i] = ds;
    });
    let sccs = components(&deps);
    let mut comp: Vec<usize> = Vec::new();
    for _ in funcs.iter() {
        comp.push(0);
    }
    let mut ci = 0;
    while ci < sccs.len() {
        for m in sccs[ci].iter() {
            comp[*m] = ci;
        }
        ci += 1;
    }
    // Depth: 1 + the deepest component called (components come callees
    // first).
    let mut depth: Vec<usize> = Vec::new();
    let mut levels: Vec<Vec<usize>> = Vec::new();
    ci = 0;
    while ci < sccs.len() {
        let mut d = 0;
        for m in sccs[ci].iter() {
            for j in deps[*m].iter() {
                if comp[*j] != ci && depth[comp[*j]] + 1 > d {
                    d = depth[comp[*j]] + 1;
                }
            }
        }
        depth.push(d);
        while levels.len() <= d {
            levels.push(Vec::new());
        }
        let mut lv = levels[d];
        lv.push(ci);
        ci += 1;
    }
    for lv in levels.iter() {
        let mut out: Vec<HashMap<u32, Summary>> = Vec::new();
        for _ in lv.iter() {
            out.push(HashMap::new());
        }
        crate::util::par_for(lv.len(), 4, |k| {
            let w = e.copy();
            let members = sccs[lv[k]];
            let recursive = members.len() > 1 || deps[members[0]].contains(&members[0]);
            let mut rounds = 0;
            loop {
                w.changed = false;
                for m in members.iter() {
                    w.summarize(funcs[*m]);
                }
                rounds += 1;
                if !recursive || !w.changed || rounds >= 30 {
                    break;
                }
            }
            out[k] = w.summaries;
        });
        for o in out.iter() {
            for (id, sm) in o.iter() {
                e.summaries.insert(*id, sm.clone());
            }
        }
    }
    // What each function keeps in its frame, on several threads (each with
    // its own scratch; the summaries are final).
    let mut ks: Vec<Vec<bool>> = Vec::new();
    for _ in funcs.iter() {
        ks.push(Vec::new());
    }
    crate::util::par_for(funcs.len(), 16, |i| {
        let w = &mut Escape {
            summaries: e.summaries,
            shared: None,
            by_def: e.by_def,
            impls: e.impls,
            lang_of: e.lang_of,
            changed: false,
            used: Vec::new(),
            users: e.users,
            debug: e.debug.clone(),
        };
        ks[i] = w.keep(funcs[i]);
    });
    let mut keep: HashMap<u32, Vec<bool>> = HashMap::new();
    let debug = crate::dflags::on("escdebug");
    let mut fi = 0;
    for f in funcs.iter() {
        let k = ks[fi];
        fi += 1;
        if debug {
            let s = e.summary_of(*f, f.nargs + 1 - first_param(*f));
            let mut boxed = String::new();
            let mut i = 0;
            while i < k.len() {
                if !k[i] {
                    boxed.push_str(` ${i}`.to_string().as_str());
                }
                i += 1;
            }
            eprintln(`esc ${f.name} ${s.esc:?} boxed:${boxed}`);
        }
        keep.insert(f.id, k);
    }
    (keep, e.summaries)
}

// The strongly connected components of the graph i -> deps[i] (Tarjan),
// each listed after the components it reaches (callees first), members in
// index order.
pub fn components(deps: &Vec<Vec<usize>>) -> Vec<Vec<usize>> {
    let n = deps.len();
    let t = &mut Tarjan {
        index: Vec::new(),
        low: Vec::new(),
        on: Vec::new(),
        stack: Vec::new(),
        next: 0,
        out: Vec::new(),
    };
    for _ in deps.iter() {
        t.index.push(-1);
        t.low.push(0);
        t.on.push(false);
    }
    let mut i = 0;
    while i < n {
        if t.index[i] < 0 {
            t.visit(deps, i);
        }
        i += 1;
    }
    t.out
}

struct Tarjan {
    index: Vec<i64>,
    low: Vec<i64>,
    on: Vec<bool>,
    stack: Vec<usize>,
    next: i64,
    out: Vec<Vec<usize>>,
}

impl Tarjan {
    fn visit(&mut self, deps: &Vec<Vec<usize>>, v: usize) {
        self.index[v] = self.next;
        self.low[v] = self.next;
        self.next += 1;
        self.stack.push(v);
        self.on[v] = true;
        for w in deps[v].iter() {
            if self.index[*w] < 0 {
                self.visit(deps, *w);
                if self.low[*w] < self.low[v] {
                    self.low[v] = self.low[*w];
                }
            } else if self.on[*w] && self.index[*w] < self.low[v] {
                self.low[v] = self.index[*w];
            }
        }
        if self.low[v] == self.index[v] {
            let mut c: Vec<usize> = Vec::new();
            loop {
                let w = self.stack.pop().unwrap();
                self.on[w] = false;
                c.push(w);
                if w == v {
                    break;
                }
            }
            c.sort();
            self.out.push(c);
        }
    }
}
