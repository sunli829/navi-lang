//! Jump threading on known variants: a block that switches on the variant
//! of an enum its predecessor has just built (`e = Some(x)` then
//! `match e`, as an inlined Iterator::next returns into a for loop) is
//! copied into that predecessor, which then jumps to the arm directly. The
//! payload then reaches the arm without a merge (and its facts with it).

use crate::mir::*;

// The most statements of a block copied into its predecessors.
const MAX_STMTS: usize = 8;

/// Threads f's jumps into switches on variants known in the predecessor.
pub fn thread_jumps(f: &mut Func) -> bool {
    let mut changed = false;
    let n = f.blocks.len();
    // Predecessors that only jump (Goto) to each block.
    let mut preds: Vec<Vec<usize>> = Vec::new();
    let mut i = 0;
    while i < n {
        preds.push(Vec::new());
        i += 1;
    }
    i = 0;
    while i < n {
        if let Term::Goto(t) = &f.blocks[i].term { preds[*t].push(i); }
        i += 1;
    }
    let mut bi = 0;
    while bi < n {
        let b = f.blocks[bi];
        bi += 1;
        let (x, vals, targets, els) = match &b.term {
            Term::Switch { x, vals, targets, els, .. } => (x, vals, targets, *els),
            _ => continue,
        };
        if x.kind != OP_COPY || x.place.proj.len() != 0 || b.stmts.len() > MAX_STMTS { continue; }
        let d = x.place.local;
        for pp in preds[bi - 1].iter() {
            let p = f.blocks[*pp];
            // Variants known at the end of p, then through b's statements.
            let mut known: Vec<(usize, i64)> = Vec::new();
            for st in p.stmts.iter() { track(&mut known, st); }
            let mut dv = -1i64;
            for st in b.stmts.iter() {
                if let Stmt::Assign { place, rv } = st {
                    if place.proj.len() == 0 && place.local == d {
                        dv = -1;
                        if let Rvalue::Discr(e) = rv {
                            if e.proj.len() == 0 { dv = get(&known, e.local); }
                        }
                    }
                }
                track(&mut known, st);
            }
            if dv < 0 { continue; }
            let mut target = els;
            let mut k = 0;
            while k < vals.len() {
                if vals[k] == dv { target = targets[k]; }
                k += 1;
            }
            let mut stmts = p.stmts.clone();
            for st in b.stmts.iter() { stmts.push(st.clone()); }
            f.blocks[*pp] = &mut Block { stmts, term: Term::Goto(target) };
            changed = true;
        }
    }
    changed
}

fn get(known: &Vec<(usize, i64)>, l: usize) -> i64 {
    let mut i = known.len();
    while i > 0 {
        i -= 1;
        if known[i].0 == l { return known[i].1; }
    }
    -1
}

fn forget(known: &mut Vec<(usize, i64)>, l: usize) { known.push((l, -1)); }

// A write through a pointer may change any local whose address was taken:
// nothing is known after it.
fn through_pointer(p: &Place) -> bool {
    for pr in p.proj.iter() {
        if pr.kind == P_DEREF { return true; }
    }
    false
}

/// What a statement tells of locals' variants.
fn track(known: &mut Vec<(usize, i64)>, st: &Stmt) {
    match st {
        Stmt::Assign { place, rv } => {
            if let Rvalue::Ref { place: r, .. } = rv { forget(known, r.local); }
            if through_pointer(place) {
                known.clear();
                return;
            }
            if place.proj.len() != 0 {
                // Writing a field of a variant keeps it; anything else
                // through a projection is unknown.
                if !(place.proj.len() == 2 && place.proj[0].kind == P_DOWNCAST) { forget(known, place.local); }
                return;
            }
            let l = place.local;
            match rv {
                Rvalue::Aggregate { kind, variant, .. } => {
                    if *kind == AGG_ADT { known.push((l, *variant as i64)); } else { forget(known, l); }
                }
                Rvalue::Use(x) => {
                    if x.kind == OP_COPY && x.place.proj.len() == 0 {
                        let v = get(known, x.place.local);
                        known.push((l, v));
                    } else {
                        forget(known, l);
                    }
                }
                _ => forget(known, l),
            }
        }
        Stmt::SetDiscr { place, variant } => {
            if through_pointer(place) {
                known.clear();
                return;
            }
            if place.proj.len() == 0 { known.push((place.local, *variant as i64)); } else { forget(known, place.local); }
        }
        Stmt::Box { local, .. } => forget(known, *local),
        _ => {}
    }
}
