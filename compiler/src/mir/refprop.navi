//! Reference forwarding: a local p assigned once `p = &r` (r a local and
//! fields or variants of it: a fixed place) and otherwise only dereferenced
//! has its places `(*p).x` read as `r.x`. Inlined methods take `self` this way
//! (Range::next's &mut self), so the local they work on is then used only
//! through its fields and can be split into variables (backend/ssagen).

use crate::mir::*;

/// Forwards f's single-assignment references to fixed places, until none
/// is left (forwarding one can make another's place fixed: &(*p).f).
pub fn forward_refs(f: &mut Func) -> bool {
    let mut k = 0;
    while k < 4 && forward_once(f) {
        k += 1;
    }
    k > 0
}

fn forward_once(f: &mut Func) -> bool {
    let n = f.locals.len();
    let mut defs: Vec<u32> = Vec::new();
    defs.resize(n, 0);
    let mut target: Vec<i64> = Vec::new();
    target.resize(n, -1);
    let mut tplace: Vec<Option<Place>> = Vec::new();
    tplace.resize(n, None);
    let mut bad: Vec<bool> = Vec::new();
    bad.resize(n, false);
    // Arguments and the result are defined outside.
    let mut i = 0;
    while i <= f.nargs && i < n {
        bad[i] = true;
        i += 1;
    }
    for b in f.blocks.iter() {
        for st in b.stmts.iter() {
            match st {
                Stmt::Assign { place, rv } => {
                    if place.proj.len() == 0 {
                        defs[place.local] += 1;
                        if let Rvalue::Ref { place: src, .. } = rv {
                            if fixed(src) && src.local != place.local {
                                target[place.local] = src.local as i64;
                                tplace[place.local] = Some(src.clone());
                            }
                        }
                    } else {
                        use_place(&mut bad, place);
                    }
                    visit_rv(&mut bad, rv);
                }
                Stmt::SetDiscr { place, .. } => use_place(&mut bad, place),
                Stmt::Box { local, .. } => bad[*local] = true,
                Stmt::PushDefer { fn_op, args } => {
                    use_op(&mut bad, fn_op);
                    for a in args.iter() {
                        use_op(&mut bad, a);
                    }
                }
                _ => {}
            }
        }
        match &b.term {
            Term::Switch { x, .. } => use_op(&mut bad, x),
            Term::Call {
                fn_op, args, dest, ..
            } => {
                use_op(&mut bad, fn_op);
                for a in args.iter() {
                    use_op(&mut bad, a);
                }
                if dest.proj.len() == 0 {
                    bad[dest.local] = true;
                } else {
                    use_place(&mut bad, dest);
                }
            }
            Term::Assert {
                cond, len, index, ..
            } => {
                use_op(&mut bad, cond);
                use_op(&mut bad, len);
                use_op(&mut bad, index);
            }
            _ => {}
        }
    }
    // The forwarded locals: one definition, a reference to a whole local
    // that is not itself forwarded.
    let mut fwd: Vec<i64> = Vec::new();
    fwd.resize(n, -1);
    let mut any = false;
    i = 0;
    while i < n {
        if !bad[i] && defs[i] == 1 && target[i] >= 0 && f.locals[i].boxed == false {
            fwd[i] = target[i];
            any = true;
        }
        i += 1;
    }
    if !any {
        return false;
    }
    i = 0;
    while i < n {
        if fwd[i] >= 0 && fwd[fwd[i] as usize] >= 0 {
            fwd[i] = -1;
        }
        i += 1;
    }
    let mut bi = 0;
    while bi < f.blocks.len() {
        let b = f.blocks[bi];
        if mentions(b, &fwd) {
            let mut stmts: Vec<Stmt> = Vec::new();
            for st in b.stmts.iter() {
                // The reference itself is no longer read.
                if let Stmt::Assign { place, .. } = st {
                    if place.proj.len() == 0 && fwd[place.local] >= 0 {
                        continue;
                    }
                }
                stmts.push(map_stmt(st, &fwd, &tplace));
            }
            f.blocks[bi] = &mut Block {
                stmts,
                term: map_term(&b.term, &fwd, &tplace),
            };
        }
        bi += 1;
    }
    true
}

// A place read or written in part: fine if it dereferences first.
fn use_place(bad: &mut Vec<bool>, p: &Place) {
    if p.proj.len() == 0 || p.proj[0].kind != P_DEREF {
        bad[p.local] = true;
    }
}

fn use_op(bad: &mut Vec<bool>, x: &Operand) {
    if x.kind == OP_COPY {
        use_place(bad, &x.place);
    }
}

fn visit_rv(bad: &mut Vec<bool>, rv: &Rvalue) {
    match rv {
        Rvalue::Use(x)
        | Rvalue::Un { x, .. }
        | Rvalue::Cast { x, .. }
        | Rvalue::Unsize { x, .. }
        | Rvalue::MakeDyn { x, .. } => use_op(bad, x),
        Rvalue::Bin { x, y, .. } => {
            use_op(bad, x);
            use_op(bad, y);
        }
        Rvalue::Ref { place, .. } | Rvalue::Discr(place) | Rvalue::Len(place) => {
            use_place(bad, place)
        }
        Rvalue::Aggregate { ops, .. } => {
            for o in ops.iter() {
                use_op(bad, o);
            }
        }
    }
}

fn place_hit(p: &Place, fwd: &Vec<i64>) -> bool {
    p.proj.len() > 0 && fwd[p.local] >= 0
}

fn op_hit(x: &Operand, fwd: &Vec<i64>) -> bool {
    x.kind == OP_COPY && place_hit(&x.place, fwd)
}

fn mentions(b: &Block, fwd: &Vec<i64>) -> bool {
    for st in b.stmts.iter() {
        match st {
            Stmt::Assign { place, rv } => {
                if place_hit(place, fwd) || (place.proj.len() == 0 && fwd[place.local] >= 0) {
                    return true;
                }
                match rv {
                    Rvalue::Use(x)
                    | Rvalue::Un { x, .. }
                    | Rvalue::Cast { x, .. }
                    | Rvalue::Unsize { x, .. }
                    | Rvalue::MakeDyn { x, .. } => {
                        if op_hit(x, fwd) {
                            return true;
                        }
                    }
                    Rvalue::Bin { x, y, .. } => {
                        if op_hit(x, fwd) || op_hit(y, fwd) {
                            return true;
                        }
                    }
                    Rvalue::Ref { place: p, .. } | Rvalue::Discr(p) | Rvalue::Len(p) => {
                        if place_hit(p, fwd) {
                            return true;
                        }
                    }
                    Rvalue::Aggregate { ops, .. } => {
                        for o in ops.iter() {
                            if op_hit(o, fwd) {
                                return true;
                            }
                        }
                    }
                }
            }
            Stmt::SetDiscr { place, .. } => {
                if place_hit(place, fwd) {
                    return true;
                }
            }
            Stmt::PushDefer { fn_op, args } => {
                if op_hit(fn_op, fwd) {
                    return true;
                }
                for a in args.iter() {
                    if op_hit(a, fwd) {
                        return true;
                    }
                }
            }
            _ => {}
        }
    }
    match &b.term {
        Term::Switch { x, .. } => op_hit(x, fwd),
        Term::Call {
            fn_op, args, dest, ..
        } => {
            if op_hit(fn_op, fwd) || place_hit(dest, fwd) {
                return true;
            }
            for a in args.iter() {
                if op_hit(a, fwd) {
                    return true;
                }
            }
            false
        }
        Term::Assert {
            cond, len, index, ..
        } => op_hit(cond, fwd) || op_hit(len, fwd) || op_hit(index, fwd),
        _ => false,
    }
}

// A place at a fixed address: a local and fields or variants of it.
fn fixed(p: &Place) -> bool {
    for pr in p.proj.iter() {
        if pr.kind != P_FIELD && pr.kind != P_DOWNCAST {
            return false;
        }
    }
    true
}

/// (*p).rest as r.path.rest.
fn map_place(p: &Place, fwd: &Vec<i64>, tp: &Vec<Option<Place>>) -> Place {
    if !place_hit(p, fwd) {
        return p.clone();
    }
    let mut ps: Vec<Proj> = Vec::new();
    for pr in tp[p.local].unwrap().proj.iter() {
        ps.push(pr.clone());
    }
    let mut i = 1;
    while i < p.proj.len() {
        ps.push(p.proj[i].clone());
        i += 1;
    }
    Place {
        local: fwd[p.local] as usize,
        proj: ps,
    }
}

fn map_op(x: &Operand, fwd: &Vec<i64>, tp: &Vec<Option<Place>>) -> Operand {
    if !op_hit(x, fwd) {
        return x.clone();
    }
    copy(map_place(&x.place, fwd, tp))
}

fn map_ops(xs: &Vec<Operand>, fwd: &Vec<i64>, tp: &Vec<Option<Place>>) -> Vec<Operand> {
    let mut out: Vec<Operand> = Vec::new();
    for x in xs.iter() {
        out.push(map_op(x, fwd, tp));
    }
    out
}

fn map_rv(rv: &Rvalue, fwd: &Vec<i64>, tp: &Vec<Option<Place>>) -> Rvalue {
    match rv {
        Rvalue::Use(x) => Rvalue::Use(map_op(x, fwd, tp)),
        Rvalue::Ref { is_mut, place } => Rvalue::Ref {
            is_mut: *is_mut,
            place: map_place(place, fwd, tp),
        },
        Rvalue::Bin { op, x, y, ty, pos } => Rvalue::Bin {
            op: *op,
            x: map_op(x, fwd, tp),
            y: map_op(y, fwd, tp),
            ty: *ty,
            pos: *pos,
        },
        Rvalue::Un { op, x, ty, pos } => Rvalue::Un {
            op: *op,
            x: map_op(x, fwd, tp),
            ty: *ty,
            pos: *pos,
        },
        Rvalue::Cast { kind, x, from, to } => Rvalue::Cast {
            kind: *kind,
            x: map_op(x, fwd, tp),
            from: *from,
            to: *to,
        },
        Rvalue::Aggregate {
            kind,
            ty,
            variant,
            ops,
            closure,
        } => Rvalue::Aggregate {
            kind: *kind,
            ty: *ty,
            variant: *variant,
            ops: map_ops(ops, fwd, tp),
            closure: *closure,
        },
        Rvalue::Discr(p) => Rvalue::Discr(map_place(p, fwd, tp)),
        Rvalue::Len(p) => Rvalue::Len(map_place(p, fwd, tp)),
        Rvalue::Unsize { x, len, to } => Rvalue::Unsize {
            x: map_op(x, fwd, tp),
            len: *len,
            to: *to,
        },
        Rvalue::MakeDyn { x, concrete, to } => Rvalue::MakeDyn {
            x: map_op(x, fwd, tp),
            concrete: *concrete,
            to: *to,
        },
    }
}

fn map_stmt(st: &Stmt, fwd: &Vec<i64>, tp: &Vec<Option<Place>>) -> Stmt {
    match st {
        Stmt::Assign { place, rv } => Stmt::Assign {
            place: map_place(place, fwd, tp),
            rv: map_rv(rv, fwd, tp),
        },
        Stmt::SetDiscr { place, variant } => Stmt::SetDiscr {
            place: map_place(place, fwd, tp),
            variant: *variant,
        },
        Stmt::PushDefer { fn_op, args } => Stmt::PushDefer {
            fn_op: map_op(fn_op, fwd, tp),
            args: map_ops(args, fwd, tp),
        },
        _ => st.clone(),
    }
}

fn map_term(t: &Term, fwd: &Vec<i64>, tp: &Vec<Option<Place>>) -> Term {
    match t {
        Term::Switch {
            x,
            ty,
            vals,
            targets,
            els,
        } => Term::Switch {
            x: map_op(x, fwd, tp),
            ty: *ty,
            vals: vals.clone(),
            targets: targets.clone(),
            els: *els,
        },
        Term::Call {
            fn_op,
            args,
            dest,
            target,
            pos,
        } => Term::Call {
            fn_op: map_op(fn_op, fwd, tp),
            args: map_ops(args, fwd, tp),
            dest: map_place(dest, fwd, tp),
            target: *target,
            pos: *pos,
        },
        Term::Assert {
            cond,
            msg,
            target,
            pos,
            bounds,
            len,
            index,
        } => Term::Assert {
            cond: map_op(cond, fwd, tp),
            msg: msg.clone(),
            target: *target,
            pos: *pos,
            bounds: *bounds,
            len: map_op(len, fwd, tp),
            index: map_op(index, fwd, tp),
        },
        _ => t.clone(),
    }
}
