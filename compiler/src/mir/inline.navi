//! Inlines calls of small functions (after escape analysis and boxing):
//! the callee's blocks are copied into the caller with its locals renamed,
//! its types instantiated with the call's generic arguments and its
//! positions kept (a panic in it reports its line, as Rust's; positions in
//! another file go in the caller's Func::ext), but a #[track_caller]
//! function's, which are the call's. Calls through traits,
//! closures and function values are left alone, and so are callees that create
//! closures, register defers, use #[track_caller] or #[inline(never)], or
//! belong to the runtime (which relies on its frames), but for its leaves
//! (functions that call nothing); runtime functions only get leaves.

use std::collections::HashMap;

use crate::{
    mir::*,
    resolve::{self, Def, Node},
    syntax::{
        ast::Item,
        source::{File, Pos},
    },
    types::{
        self, Type,
        collect::{Info, has_attr},
        lower::{ParamMap, subst},
    },
};

/// Callees larger than this (statements plus terminators, plain copies
/// free) are not inlined. (6 and 3 kept a rotation or a carry add out of
/// loops; 16 and 5 made X25519 4.5 times and RSA 2.2 times faster and
/// navic itself 9%, for 7% more code; more gained nothing.)
const MAX_SIZE: usize = 16;
const MAX_BLOCKS: usize = 5;
/// The limits for functions marked #[inline].
const HINT_SIZE: usize = 24;
const HINT_BLOCKS: usize = 6;

fn size(f: &Func) -> usize {
    let mut n = 0;
    for b in f.blocks.iter() {
        for s in b.stmts.iter() {
            // Plain copies between locals (parameters into their named
            // locals, results out) are gone after copy propagation: free.
            if let Stmt::Assign { place, rv } = s {
                if place.proj.len() == 0 {
                    if let Rvalue::Use(x) = rv {
                        if x.kind != OP_CONST && x.place.proj.len() == 0 {
                            continue;
                        }
                    }
                }
            }
            if let Stmt::StorageLive(_) = s {
                continue;
            }
            n += 1;
        }
        n += 1;
    }
    n
}

pub fn in_runtime(d: &Def) -> bool {
    if !d.krate.is_std {
        return false;
    }
    let mut p = d.parent;
    while let Some(x) = p {
        if x.kind == resolve::DEF_MOD && x.name == "rt" {
            return true;
        }
        p = x.parent;
    }
    false
}

// Whether d is marked #[inline(always)]: inlined whatever its size (small
// generic code that is large before its calls become operations, like
// Range::next).
fn inline_always(d: &Def) -> bool {
    let attrs = match &d.node {
        Node::Item(Item::Fn(f)) => f.base.attrs.clone(),
        _ => return false,
    };
    for a in attrs.iter() {
        if a.path.segments.len() == 1 && a.path.segments[0].name.value == "inline" {
            for t in a.args.iter() {
                if t.text == "always" {
                    return true;
                }
            }
        }
    }
    false
}

/// Whether d is marked #[inline] (not #[inline(never)]): also what makes a
/// function's body cross crates (as Rust).
pub fn inline_hint(d: &Def) -> bool {
    let attrs = match &d.node {
        Node::Item(Item::Fn(f)) => f.base.attrs.clone(),
        _ => return false,
    };
    for a in attrs.iter() {
        if a.path.segments.len() == 1 && a.path.segments[0].name.value == "inline" {
            for t in a.args.iter() {
                if t.text == "never" {
                    return false;
                }
            }
            return true;
        }
    }
    false
}

fn is_track_caller(d: &Def) -> bool {
    match &d.node {
        Node::Item(Item::Fn(f)) => has_attr(&f.base.attrs, "track_caller"),
        _ => false,
    }
}

fn never_inline(d: &Def) -> bool {
    let attrs = match &d.node {
        Node::Item(Item::Fn(f)) => f.base.attrs.clone(),
        _ => return true,
    };
    // #[track_caller] functions inline: the copy's positions are the call
    // site's, which is the location they would report (Copier::same_file).
    if has_attr(&attrs, "intrinsic") {
        return true;
    }
    for a in attrs.iter() {
        if a.path.segments.len() == 1 && a.path.segments[0].name.value == "inline" {
            for t in a.args.iter() {
                if t.text == "never" {
                    return true;
                }
            }
        }
    }
    false
}

// Whether f calls nothing.
fn leaf(f: &Func) -> bool {
    for b in f.blocks.iter() {
        if let Term::Call { .. } = &b.term {
            return false;
        }
    }
    true
}

/// Whether f may be copied into its callers.
fn inlinable(f: &Func) -> bool {
    let d = match f.def {
        Some(d) => d,
        None => return false,
    };
    let (max_size, max_blocks) = if inline_always(d) {
        (1000, 1000)
    } else if inline_hint(d) {
        (HINT_SIZE, HINT_BLOCKS)
    } else {
        (MAX_SIZE, MAX_BLOCKS)
    };
    if f.closure || f.shim || f.has_defer || f.blocks.len() > max_blocks || size(f) > max_size {
        return false;
    }
    if d.kind != resolve::DEF_FN && d.kind != resolve::DEF_ASSOC_FN {
        return false;
    }
    if let Some(p) = d.parent {
        if p.kind == resolve::DEF_TRAIT {
            return false;
        }
    }
    if never_inline(d) {
        return false;
    }
    // The runtime relies on its frames, but not in leaves (no call at all:
    // its word accessors and the like).
    if in_runtime(d) && !leaf(f) {
        return false;
    }
    for b in f.blocks.iter() {
        for s in b.stmts.iter() {
            match s {
                Stmt::Assign { rv, .. } => {
                    if let Rvalue::Aggregate { closure, .. } = rv {
                        if closure.is_some() {
                            return false;
                        }
                    }
                }
                Stmt::PushDefer { .. } => return false,
                _ => {}
            }
        }
    }
    true
}

/// Copies a callee's MIR into a caller.
struct Copier {
    // Option: a &mut field read through &self would be read-only.
    ctx: Option<&mut types::Ctx>,
    m: ParamMap,
    base: usize,
    block_base: usize,
    pos: Pos,
    /// The callee is #[track_caller]: its positions are the call's.
    track: bool,
    callee: &Func,
    caller_file: Option<&File>,
    /// The caller's positions in other files (shared with its Body).
    ext: Vec<(&File, Pos)>,
}

impl Copier {
    fn ty(&self, t: &Type) -> &Type {
        if self.m.len() == 0 {
            t
        } else {
            subst(self.ctx.unwrap(), t, &self.m, None)
        }
    }

    fn place(&self, p: &Place) -> Place {
        let mut ps = Vec::new();
        for x in p.proj.iter() {
            let mut y = x.clone();
            if y.kind == P_INDEX {
                y.index = y.index + self.base;
            }
            ps.push(y);
        }
        Place {
            local: p.local + self.base,
            proj: ps,
        }
    }

    fn cnst(&self, c: &Const) -> &Const {
        if self.m.len() == 0 {
            return c;
        }
        let n = cnst(
            c.kind,
            match c.ty {
                Some(t) => Some(self.ty(t)),
                None => None,
            },
        );
        n.int = c.int;
        n.float = c.float;
        n.bytes = c.bytes;
        n.static_def = c.static_def;
        n.param = match c.param {
            Some(t) => Some(self.ty(t)),
            None => None,
        };
        n.fn_ref = match c.fn_ref {
            Some(r) => {
                let mut args = Vec::new();
                for a in r.args.iter() {
                    args.push(self.ty(*a));
                }
                let st = match r.self_ty {
                    Some(t) => Some(self.ty(t)),
                    None => None,
                };
                Some(&FnRef {
                    def: r.def,
                    args,
                    self_ty: st,
                    closure: r.closure,
                    ctor: r.ctor,
                })
            }
            None => None,
        };
        n
    }

    fn op(&self, o: &Operand) -> Operand {
        if o.kind == OP_COPY {
            return copy(self.place(&o.place));
        }
        const_op(self.cnst(o.cnst.unwrap()))
    }

    fn ops(&self, os: &Vec<Operand>) -> Vec<Operand> {
        let mut out = Vec::new();
        for o in os.iter() {
            out.push(self.op(o));
        }
        out
    }

    fn rv(&self, rv: &Rvalue) -> Rvalue {
        match rv {
            Rvalue::Use(x) => Rvalue::Use(self.op(x)),
            Rvalue::Ref { is_mut, place } => Rvalue::Ref {
                is_mut: *is_mut,
                place: self.place(place),
            },
            Rvalue::Bin { op, x, y, ty, pos } => Rvalue::Bin {
                op: *op,
                x: self.op(x),
                y: self.op(y),
                ty: self.ty(*ty),
                pos: if *pos > 0 { self.at(*pos) } else { 0 },
            },
            Rvalue::Un { op, x, ty, pos } => Rvalue::Un {
                op: *op,
                x: self.op(x),
                ty: self.ty(*ty),
                pos: if *pos > 0 { self.at(*pos) } else { 0 },
            },
            Rvalue::Cast { kind, x, from, to } => Rvalue::Cast {
                kind: *kind,
                x: self.op(x),
                from: self.ty(*from),
                to: self.ty(*to),
            },
            Rvalue::Aggregate {
                kind,
                ty,
                variant,
                ops,
                closure,
            } => Rvalue::Aggregate {
                kind: *kind,
                ty: self.ty(*ty),
                variant: *variant,
                ops: self.ops(ops),
                closure: *closure,
            },
            Rvalue::Discr(pl) => Rvalue::Discr(self.place(pl)),
            Rvalue::Len(pl) => Rvalue::Len(self.place(pl)),
            Rvalue::Unsize { x, len, to } => Rvalue::Unsize {
                x: self.op(x),
                len: *len,
                to: self.ty(*to),
            },
            Rvalue::MakeDyn { x, concrete, to } => Rvalue::MakeDyn {
                x: self.op(x),
                concrete: self.ty(*concrete),
                to: self.ty(*to),
            },
        }
    }

    fn stmt(&self, s: &Stmt) -> Stmt {
        match s {
            Stmt::Assign { place, rv } => Stmt::Assign {
                place: self.place(place),
                rv: self.rv(rv),
            },
            Stmt::SetDiscr { place, variant } => Stmt::SetDiscr {
                place: self.place(place),
                variant: *variant,
            },
            Stmt::Box { local, ty } => Stmt::Box {
                local: *local + self.base,
                ty: self.ty(*ty),
            },
            Stmt::PushDefer { fn_op, args } => Stmt::PushDefer {
                fn_op: self.op(fn_op),
                args: self.ops(args),
            },
            Stmt::StorageLive(l) => Stmt::StorageLive(*l + self.base),
        }
    }

    // A position of the callee in the caller.
    fn at(&self, pos: Pos) -> Pos {
        if self.track || pos <= 0 {
            return self.pos;
        }
        let (f, p) = self.callee.file_pos(pos);
        let f = match f {
            Some(f) => f,
            None => return self.pos,
        };
        if let Some(cf) = self.caller_file {
            if std::ptr::eq(cf, f) {
                return p;
            }
        }
        let mut ext = self.ext;
        let mut i = 0;
        while i < ext.len() {
            if std::ptr::eq(ext[i].0, f) && ext[i].1 == p {
                return EXT_POS + i as Pos;
            }
            i += 1;
        }
        ext.push((f, p));
        EXT_POS + i as Pos
    }

    fn blk(&self, b: usize) -> usize {
        b + self.block_base
    }

    /// The callee's terminator t; Return goes to ret.
    fn term(&self, t: &Term, ret: usize) -> Term {
        match t {
            Term::None => Term::None,
            Term::Goto(b) => Term::Goto(self.blk(*b)),
            Term::Switch {
                x,
                ty,
                vals,
                targets,
                els,
            } => {
                let mut ts = Vec::new();
                for b in targets.iter() {
                    ts.push(self.blk(*b));
                }
                Term::Switch {
                    x: self.op(x),
                    ty: self.ty(*ty),
                    vals: vals.clone(),
                    targets: ts,
                    els: self.blk(*els),
                }
            }
            Term::Return => Term::Goto(ret),
            Term::Unreachable => Term::Unreachable,
            Term::Call {
                fn_op,
                args,
                dest,
                target,
                pos,
            } => {
                let tg = if *target < 0 {
                    *target
                } else {
                    self.blk(*target as usize) as i64
                };
                Term::Call {
                    fn_op: self.op(fn_op),
                    args: self.ops(args),
                    dest: self.place(dest),
                    target: tg,
                    pos: self.at(*pos),
                }
            }
            Term::Assert {
                cond,
                msg,
                target,
                bounds,
                len,
                index,
                pos,
            } => Term::Assert {
                cond: self.op(cond),
                msg: msg.clone(),
                target: self.blk(*target),
                pos: self.at(*pos),
                bounds: *bounds,
                len: self.op(len),
                index: self.op(index),
            },
        }
    }
}

/// The function a call statically targets, if it may be inlined.
fn concrete(t: &Type) -> bool {
    let m = crate::types::lower::mentions;
    !(m(t, types::K_INFER, false)
        || m(t, types::K_PARAM, false)
        || m(t, types::K_PROJ, false)
        || m(t, types::K_OPAQUE, false)
        || m(t, types::K_ERROR, false))
}

// The function a call runs and its generic arguments: a trait method on a
// concrete type is its impl's method (v[i] is <Vec<T> as Index>::index).
fn callee_of(info: &mut Info, t: &Term) -> Option<(&mut Def, Vec<&Type>)> {
    let fn_op = match t {
        Term::Call { fn_op, .. } => fn_op,
        _ => return None,
    };
    if fn_op.kind != OP_CONST {
        return None;
    }
    let c = fn_op.cnst.unwrap();
    if c.kind != C_FN {
        return None;
    }
    let r = c.fn_ref.unwrap();
    if r.closure.is_some() || r.ctor {
        return None;
    }
    let d = r.def?;
    let p = match d.parent {
        Some(p) => p,
        None => return Some((d, r.args.clone())),
    };
    if p.kind != resolve::DEF_TRAIT {
        return Some((d, r.args.clone()));
    }
    let st = r.self_ty?;
    if !concrete(st) {
        return None;
    }
    for a in r.args.iter() {
        if !concrete(*a) {
            return None;
        }
    }
    let inst = info.resolve_method(d, st, &r.args)?;
    if inst.is_virtual || inst.builtin.len() > 0 || inst.self_ty.is_some() {
        return None;
    }
    Some((inst.def, inst.args.clone()))
}

// The resolved callees of the calls ending each block of each function
// (by function index and block), when they may be inlined.
fn plan_calls(
    info: &mut Info,
    funcs: &Vec<&mut Func>,
    by_def: &HashMap<u32, &mut Func>,
    ok: &HashMap<u32, bool>,
    only: Option<&Vec<bool>>,
) -> HashMap<u64, (u32, Vec<&Type>)> {
    let mut out: HashMap<u64, (u32, Vec<&Type>)> = HashMap::new();
    let mut i = 0;
    while i < funcs.len() {
        if let Some(o) = only {
            if !o[i] {
                i += 1;
                continue;
            }
        }
        let f = funcs[i];
        let mut bi = 0;
        while bi < f.blocks.len() {
            if let Some((d, args)) = callee_of(info, &f.blocks[bi].term) {
                if ok.contains_key(&d.id) && by_def.contains_key(&d.id) {
                    out.insert((i as u64) << 32 | bi as u64, (d.id, args));
                }
            }
            bi += 1;
        }
        i += 1;
    }
    out
}

/// Inlines the small direct callees of every function in funcs, callees
/// before their callers (as Go does): a callee is copied with its own
/// callees already inlined. The functions of a level (whose callees are all
/// on lower ones) are done on several threads, each making its new blocks
/// and locals from the bodies as they were before the level; then they are
/// installed. Within a cycle of calls the copies are of bodies not inlined
/// into yet (so mutually recursive callees end).
/// only: the callers to look at (all if none). Returns the callers that
/// got code inlined (for another round: calls in that code may have become
/// concrete).
pub fn inline_program(
    info: &mut Info,
    funcs: &Vec<&mut Func>,
    only: Option<&Vec<bool>>,
) -> Vec<bool> {
    let mut by_def: HashMap<u32, &mut Func> = HashMap::new();
    let mut index: HashMap<u32, usize> = HashMap::new();
    let mut ok: HashMap<u32, bool> = HashMap::new();
    let mut i = 0;
    while i < funcs.len() {
        let f = funcs[i];
        if let Some(d) = f.def {
            by_def.insert(d.id, f);
            index.insert(f.id, i);
            if inlinable(f) {
                ok.insert(d.id, true);
            }
        }
        i += 1;
    }
    // The calls to inline, and the levels: a cycle of calls (a component)
    // is one above the highest of the components it calls.
    let calls = plan_calls(info, funcs, &by_def, &ok, only);
    let mut changed: Vec<bool> = Vec::new();
    changed.resize(funcs.len(), false);
    for k in calls.keys() {
        changed[(*k >> 32) as usize] = true;
    }
    let mut skip: Vec<bool> = Vec::new();
    let mut deps: Vec<Vec<usize>> = Vec::new();
    let mut fi = 0;
    for f in funcs.iter() {
        let caller = *f;
        let mut ds: Vec<usize> = Vec::new();
        // Runtime functions only get leaves.
        let rt = match caller.def {
            Some(d) => in_runtime(d),
            None => false,
        };
        skip.push(false);
        let mut bi = 0;
        while bi < caller.blocks.len() {
            if let Some((did, _)) = calls.get(&((fi as u64) << 32 | bi as u64)) {
                let callee = by_def[did];
                if callee.id != caller.id && (!rt || leaf(callee)) {
                    if let Some(j) = index.get(&callee.id) {
                        ds.push(*j);
                    }
                }
            }
            bi += 1;
        }
        deps.push(ds);
        fi += 1;
    }
    let comps = crate::mir::escape::components(&deps);
    let mut comp_of: Vec<usize> = Vec::new();
    let mut level: Vec<usize> = Vec::new();
    for _ in funcs.iter() {
        comp_of.push(0);
    }
    let mut ci = 0;
    while ci < comps.len() {
        for v in comps[ci].iter() {
            comp_of[*v] = ci;
        }
        ci += 1;
    }
    let mut levels: Vec<Vec<usize>> = Vec::new();
    // Components come callees first.
    ci = 0;
    while ci < comps.len() {
        let mut h = 0;
        for v in comps[ci].iter() {
            for w in deps[*v].iter() {
                if comp_of[*w] != ci && level[comp_of[*w]] + 1 > h {
                    h = level[comp_of[*w]] + 1;
                }
            }
        }
        level.push(h);
        while levels.len() <= h {
            levels.push(Vec::new());
        }
        for v in comps[ci].iter() {
            if !skip[*v] && deps[*v].len() > 0 {
                levels[h].push(*v);
            }
        }
        ci += 1;
    }
    info.ctx.par = true;
    for lv in levels.iter() {
        let mut outs: Vec<Option<&mut Body>> = Vec::new();
        for _ in lv.iter() {
            outs.push(None);
        }
        crate::util::par_for(lv.len(), 16, |k| {
            let caller = funcs[lv[k]];
            let rt = match caller.def {
                Some(d) => in_runtime(d),
                None => false,
            };
            let body = &mut Body {
                blocks: caller.blocks.clone(),
                locals: caller.locals.clone(),
                ext: caller.ext.clone(),
            };
            let n = body.blocks.len();
            let mut bi = 0;
            while bi < n {
                if let Some((did, args)) = calls.get(&((lv[k] as u64) << 32 | bi as u64)) {
                    let callee = by_def[did];
                    if callee.id != caller.id && (!rt || leaf(callee)) {
                        inline_call(info, body, bi, caller, callee, args);
                    }
                }
                bi += 1;
            }
            outs[k] = Some(body);
        });
        let mut k = 0;
        while k < lv.len() {
            let b = outs[k].unwrap();
            funcs[lv[k]].blocks = b.blocks;
            funcs[lv[k]].locals = b.locals;
            funcs[lv[k]].ext = b.ext;
            k += 1;
        }
    }
    info.ctx.par = false;
    changed
}

// A caller's blocks and locals while calls are inlined (the function
// itself is left as it is: others copy it meanwhile).
struct Body {
    blocks: Vec<&mut Block>,
    locals: Vec<&mut Local>,
    ext: Vec<(&File, Pos)>,
}

/// Replaces the call ending block bi of the body with a copy of callee.
fn inline_call(
    info: &mut Info,
    body: &mut Body,
    bi: usize,
    caller: &Func,
    callee: &Func,
    targs: &Vec<&Type>,
) {
    let call = body.blocks[bi];
    let (args, dest, target, pos) = match &call.term {
        Term::Call {
            args,
            dest,
            target,
            pos,
            ..
        } => (args.clone(), dest.clone(), *target, *pos),
        _ => return,
    };
    let d = callee.def.unwrap();
    let mut m: ParamMap = HashMap::new();
    let all = info.generics_of(d).all();
    let mut i = 0;
    while i < all.len() && i < targs.len() {
        m.insert(all[i].def.id, targs[i]);
        i += 1;
    }
    let cp = &Copier {
        ctx: Some(info.ctx),
        m,
        base: body.locals.len(),
        block_base: body.blocks.len(),
        pos,
        track: is_track_caller(d),
        callee,
        caller_file: caller.file,
        ext: body.ext,
    };
    for l in callee.locals.iter() {
        body.locals.push(&mut Local {
            ty: cp.ty(l.ty),
            name: l.name.clone(),
            boxed: l.boxed,
        });
    }
    // The continuation: the callee's result goes to dest.
    let ret_blk = body.blocks.len() + callee.blocks.len();
    for b in callee.blocks.iter() {
        let mut stmts = Vec::new();
        for s in b.stmts.iter() {
            stmts.push(cp.stmt(s));
        }
        body.blocks.push(&mut Block {
            stmts,
            term: cp.term(&b.term, ret_blk),
        });
    }
    let mut rstmts = Vec::new();
    rstmts.push(Stmt::Assign {
        place: dest,
        rv: Rvalue::Use(copy(local_place(cp.base))),
    });
    let rterm = if target < 0 {
        Term::Unreachable
    } else {
        Term::Goto(target as usize)
    };
    body.blocks.push(&mut Block {
        stmts: rstmts,
        term: rterm,
    });
    // The call becomes the argument moves and a jump to the callee's entry
    // (a new block: the old one may be read as a callee's).
    let mut stmts = call.stmts.clone();
    let first = if callee.closure { 2 } else { 1 };
    let mut k = 0;
    while k < args.len() {
        stmts.push(Stmt::Assign {
            place: local_place(cp.base + first + k),
            rv: Rvalue::Use(args[k].clone()),
        });
        k += 1;
    }
    body.blocks[bi] = &mut Block {
        stmts,
        term: Term::Goto(cp.block_base),
    };
}
