//! Inlines calls of small functions (after escape analysis and boxing):
//! the callee's blocks are copied into the caller with its locals renamed,
//! its types instantiated with the call's generic arguments and its
//! positions moved to the call site. Calls through traits, closures and
//! function values are left alone, and so are callees that create
//! closures, register defers, use #[track_caller] or #[inline(never)], or
//! belong to the runtime (which relies on its frames).

use std::collections::HashMap;
use crate::resolve::{self, Def, Node};
use crate::syntax::ast::Item;
use crate::syntax::source::Pos;
use crate::types::{self, Type};
use crate::types::collect::{Info, has_attr};
use crate::types::lower::{subst, ParamMap};
use crate::mir::*;

/// Callees larger than this (statements plus terminators) are not inlined.
const MAX_SIZE: usize = 6;
const MAX_BLOCKS: usize = 3;

fn size(f: &Func) -> usize {
    let mut n = 0;
    for b in f.blocks.iter() { n += b.stmts.len() + 1; }
    n
}

fn in_runtime(d: &Def) -> bool {
    if !d.krate.is_std { return false; }
    let mut p = d.parent;
    while let Some(x) = p {
        if x.kind == resolve::DEF_MOD && x.name == "rt" { return true; }
        p = x.parent;
    }
    false
}

fn never_inline(d: &Def) -> bool {
    let attrs = match &d.node { Node::Item(Item::Fn(f)) => f.base.attrs.clone(), _ => return true };
    if has_attr(&attrs, "track_caller") || has_attr(&attrs, "intrinsic") { return true; }
    for a in attrs.iter() {
        if a.path.segments.len() == 1 && a.path.segments[0].name.value == "inline" {
            for t in a.args.iter() {
                if t.text == "never" { return true; }
            }
        }
    }
    false
}

/// Whether f may be copied into its callers.
fn inlinable(f: &Func) -> bool {
    let d = match f.def { Some(d) => d, None => return false };
    if f.closure || f.shim || f.has_defer || f.blocks.len() > MAX_BLOCKS || size(f) > MAX_SIZE { return false; }
    if d.kind != resolve::DEF_FN && d.kind != resolve::DEF_ASSOC_FN { return false; }
    if let Some(p) = d.parent {
        if p.kind == resolve::DEF_TRAIT { return false; }
    }
    if in_runtime(d) || never_inline(d) { return false; }
    for b in f.blocks.iter() {
        for s in b.stmts.iter() {
            match s {
                Stmt::Assign { rv, .. } => {
                    if let Rvalue::Aggregate { closure, .. } = rv {
                        if closure.is_some() { return false; }
                    }
                }
                Stmt::PushDefer { .. } => return false,
                _ => {}
            }
        }
    }
    true
}

/// Copies a callee's MIR into a caller.
struct Copier {
    // Option: a &mut field read through &self would be read-only.
    ctx: Option<&mut types::Ctx>,
    m: ParamMap,
    base: usize,
    block_base: usize,
    pos: Pos,
}

impl Copier {
    fn ty(&self, t: &Type) -> &Type { if self.m.len() == 0 { t } else { subst(self.ctx.unwrap(), t, &self.m, None) } }

    fn place(&self, p: &Place) -> Place {
        let mut ps = Vec::new();
        for x in p.proj.iter() {
            let mut y = x.clone();
            if y.kind == P_INDEX { y.index = y.index + self.base; }
            ps.push(y);
        }
        Place { local: p.local + self.base, proj: ps }
    }

    fn cnst(&self, c: &Const) -> &Const {
        if self.m.len() == 0 { return c; }
        let n = cnst(c.kind, match c.ty { Some(t) => Some(self.ty(t)), None => None });
        n.int = c.int;
        n.float = c.float;
        n.bytes = c.bytes.clone();
        n.static_def = c.static_def;
        n.param = match c.param { Some(t) => Some(self.ty(t)), None => None };
        n.fn_ref = match c.fn_ref {
            Some(r) => {
                let mut args = Vec::new();
                for a in r.args.iter() { args.push(self.ty(*a)); }
                let st = match r.self_ty { Some(t) => Some(self.ty(t)), None => None };
                Some(&FnRef { def: r.def, args, self_ty: st, closure: r.closure, ctor: r.ctor })
            }
            None => None,
        };
        n
    }

    fn op(&self, o: &Operand) -> Operand {
        if o.kind == OP_COPY { return copy(self.place(&o.place)); }
        const_op(self.cnst(o.cnst.unwrap()))
    }

    fn ops(&self, os: &Vec<Operand>) -> Vec<Operand> {
        let mut out = Vec::new();
        for o in os.iter() { out.push(self.op(o)); }
        out
    }

    fn rv(&self, rv: &Rvalue) -> Rvalue {
        let p = self.pos;
        match rv {
            Rvalue::Use(x) => Rvalue::Use(self.op(x)),
            Rvalue::Ref { is_mut, place } => Rvalue::Ref { is_mut: *is_mut, place: self.place(place) },
            Rvalue::Bin { op, x, y, ty, pos } => Rvalue::Bin { op: *op, x: self.op(x), y: self.op(y), ty: self.ty(*ty), pos: if *pos > 0 { p } else { 0 } },
            Rvalue::Un { op, x, ty, pos } => Rvalue::Un { op: *op, x: self.op(x), ty: self.ty(*ty), pos: if *pos > 0 { p } else { 0 } },
            Rvalue::Cast { kind, x, from, to } => Rvalue::Cast { kind: *kind, x: self.op(x), from: self.ty(*from), to: self.ty(*to) },
            Rvalue::Aggregate { kind, ty, variant, ops, closure } =>
                Rvalue::Aggregate { kind: *kind, ty: self.ty(*ty), variant: *variant, ops: self.ops(ops), closure: *closure },
            Rvalue::Discr(pl) => Rvalue::Discr(self.place(pl)),
            Rvalue::Len(pl) => Rvalue::Len(self.place(pl)),
            Rvalue::Unsize { x, len, to } => Rvalue::Unsize { x: self.op(x), len: *len, to: self.ty(*to) },
            Rvalue::MakeDyn { x, concrete, to } => Rvalue::MakeDyn { x: self.op(x), concrete: self.ty(*concrete), to: self.ty(*to) },
        }
    }

    fn stmt(&self, s: &Stmt) -> Stmt {
        match s {
            Stmt::Assign { place, rv } => Stmt::Assign { place: self.place(place), rv: self.rv(rv) },
            Stmt::SetDiscr { place, variant } => Stmt::SetDiscr { place: self.place(place), variant: *variant },
            Stmt::Box { local, ty } => Stmt::Box { local: *local + self.base, ty: self.ty(*ty) },
            Stmt::PushDefer { fn_op, args } => Stmt::PushDefer { fn_op: self.op(fn_op), args: self.ops(args) },
            Stmt::StorageLive(l) => Stmt::StorageLive(*l + self.base),
        }
    }

    fn blk(&self, b: usize) -> usize { b + self.block_base }

    /// The callee's terminator t; Return goes to ret.
    fn term(&self, t: &Term, ret: usize) -> Term {
        let p = self.pos;
        match t {
            Term::None => Term::None,
            Term::Goto(b) => Term::Goto(self.blk(*b)),
            Term::Switch { x, ty, vals, targets, els } => {
                let mut ts = Vec::new();
                for b in targets.iter() { ts.push(self.blk(*b)); }
                Term::Switch { x: self.op(x), ty: self.ty(*ty), vals: vals.clone(), targets: ts, els: self.blk(*els) }
            }
            Term::Return => Term::Goto(ret),
            Term::Unreachable => Term::Unreachable,
            Term::Call { fn_op, args, dest, target, .. } => {
                let tg = if *target < 0 { *target } else { self.blk(*target as usize) as i64 };
                Term::Call { fn_op: self.op(fn_op), args: self.ops(args), dest: self.place(dest), target: tg, pos: p }
            }
            Term::Assert { cond, msg, target, bounds, len, index, .. } =>
                Term::Assert { cond: self.op(cond), msg: msg.clone(), target: self.blk(*target), pos: p, bounds: *bounds, len: self.op(len), index: self.op(index) },
        }
    }
}

/// The function a call statically targets, if it may be inlined.
fn target(t: &Term, by_def: &HashMap<u32, &mut Func>, ok: &HashMap<u32, bool>) -> Option<&mut Func> {
    let fn_op = match t { Term::Call { fn_op, .. } => fn_op, _ => return None };
    if fn_op.kind != OP_CONST { return None; }
    let c = fn_op.cnst.unwrap();
    if c.kind != C_FN { return None; }
    let r = c.fn_ref.unwrap();
    if r.closure.is_some() || r.ctor { return None; }
    let d = r.def?;
    if !ok.contains_key(&d.id) { return None; }
    match by_def.get(&d.id) { Some(f) => Some(*f), None => None }
}

/// Inlines the small direct callees of every function in funcs.
pub fn inline_program(info: &mut Info, funcs: &Vec<&mut Func>) {
    let mut by_def: HashMap<u32, &mut Func> = HashMap::new();
    let mut ok: HashMap<u32, bool> = HashMap::new();
    for f in funcs.iter() {
        if let Some(d) = f.def {
            by_def.insert(d.id, *f);
            if inlinable(*f) { ok.insert(d.id, true); }
        }
    }
    for f in funcs.iter() {
        let caller = *f;
        if let Some(d) = caller.def {
            if in_runtime(d) { continue; }
        }
        // Only the caller's own calls: copies are not inlined into again
        // (mutually recursive callees would never end).
        let n = caller.blocks.len();
        let mut bi = 0;
        while bi < n {
            let callee = match target(&caller.blocks[bi].term, &by_def, &ok) { Some(c) => c, None => { bi += 1; continue; } };
            if callee.id == caller.id { bi += 1; continue; }
            inline_call(info, caller, bi, callee);
            bi += 1;
        }
    }
}

/// Replaces the call ending block bi of caller with a copy of callee.
fn inline_call(info: &mut Info, caller: &mut Func, bi: usize, callee: &Func) {
    let (fn_op, args, dest, target, pos) = match &caller.blocks[bi].term {
        Term::Call { fn_op, args, dest, target, pos } => (fn_op.clone(), args.clone(), dest.clone(), *target, *pos),
        _ => return,
    };
    let r = fn_op.cnst.unwrap().fn_ref.unwrap();
    let d = r.def.unwrap();
    let mut m: ParamMap = HashMap::new();
    let all = info.generics_of(d).all();
    let mut i = 0;
    while i < all.len() && i < r.args.len() {
        m.insert(all[i].def.id, r.args[i]);
        i += 1;
    }
    let cp = &Copier { ctx: Some(info.ctx), m, base: caller.locals.len(), block_base: caller.blocks.len(), pos };
    for l in callee.locals.iter() {
        caller.locals.push(&mut Local { ty: cp.ty(l.ty), name: l.name.clone(), boxed: l.boxed });
    }
    // The continuation: the callee's result goes to dest.
    let ret_blk = caller.blocks.len() + callee.blocks.len();
    for b in callee.blocks.iter() {
        let mut stmts = Vec::new();
        for s in b.stmts.iter() { stmts.push(cp.stmt(s)); }
        caller.blocks.push(&mut Block { stmts, term: cp.term(&b.term, ret_blk) });
    }
    let mut rstmts = Vec::new();
    rstmts.push(Stmt::Assign { place: dest, rv: Rvalue::Use(copy(local_place(cp.base))) });
    let rterm = if target < 0 { Term::Unreachable } else { Term::Goto(target as usize) };
    caller.blocks.push(&mut Block { stmts: rstmts, term: rterm });
    // The call becomes the argument moves and a jump to the callee's entry.
    let b = caller.blocks[bi];
    let first = if callee.closure { 2 } else { 1 };
    let mut k = 0;
    while k < args.len() {
        b.stmts.push(Stmt::Assign { place: local_place(cp.base + first + k), rv: Rvalue::Use(args[k].clone()) });
        k += 1;
    }
    b.term = Term::Goto(cp.block_base);
}
