//! std::build's functions, made constants where they are called: the
//! package of the crate the call is in (its navi.toml: package_name,
//! package_version, package_description, package_authors, package_license,
//! package_repository, package_homepage) and navi build's --var values
//! (var, whose name must be a string literal). The driver knows them
//! (crate::driver::package_of, build_var); a crate whose source names
//! std::build has them in its cache key.

use crate::mir::*;
use crate::types::collect::Info;

// The std::build function a call is to ("" if none).
fn build_fn(fn_op: &Operand) -> String {
    if fn_op.kind != OP_CONST { return String::new(); }
    let c = fn_op.cnst.unwrap();
    if c.kind != C_FN { return String::new(); }
    let d = match c.fn_ref { Some(r) => match r.def { Some(d) => d, None => return String::new() }, None => return String::new() };
    if !crate::codegen::fn_has_attr(d, "intrinsic") { return String::new(); }
    match crate::resolve::module_of(d) {
        Some(m) => if m.path() == "std::build" { d.name.clone() } else { String::new() },
        None => String::new(),
    }
}

// The crate f's code is in.
fn crate_of(f: &Func) -> String {
    let d = match &f.def { Some(d) => *d, None => match &f.owner { Some(o) => *o, None => return String::new() } };
    match crate::resolve::module_of(d) {
        Some(m) => {
            let p = m.path();
            match p.find("::") { Some(i) => p[..i].to_string(), None => p }
        }
        None => String::new(),
    }
}

fn str_op(s: &str, t: &Type) -> Operand {
    let c = cnst(C_STR, Some(t));
    c.bytes = s.as_bytes().to_vec();
    const_op(c)
}

/// Replaces f's calls of std::build's functions by their values.
pub fn rewrite(info: &mut Info, f: &mut Func) {
    let mut bi = 0;
    while bi < f.blocks.len() {
        let b = f.blocks[bi];
        if let Term::Call { fn_op, args, dest, target, .. } = &b.term {
            let name = build_fn(fn_op);
            if name.len() > 0 && *target >= 0 {
                // &str, and Option<&str> for var.
                let str_ = info.ctx.str_;
                let dt = info.ctx.reference(false, str_);
                let od = info.lang_def("Option").unwrap();
                let mut oargs: Vec<&Type> = Vec::new();
                oargs.push(dt);
                let ot = info.ctx.adt(od, oargs);
                let pk = crate::driver::package_of(crate_of(f).as_str());
                let rv = match name.as_str() {
                    "package_name" => Some(Rvalue::Use(str_op(pk.name.as_str(), dt))),
                    "package_version" => Some(Rvalue::Use(str_op(pk.version.as_str(), dt))),
                    "package_description" => Some(Rvalue::Use(str_op(pk.description.as_str(), dt))),
                    "package_authors" => Some(Rvalue::Use(str_op(pk.authors.as_str(), dt))),
                    "package_license" => Some(Rvalue::Use(str_op(pk.license.as_str(), dt))),
                    "package_repository" => Some(Rvalue::Use(str_op(pk.repository.as_str(), dt))),
                    "package_homepage" => Some(Rvalue::Use(str_op(pk.homepage.as_str(), dt))),
                    "var" => {
                        let lit = if args.len() == 1 && args[0].kind == OP_CONST && args[0].cnst.unwrap().kind == C_STR {
                            Some(String::from_utf8_lossy(args[0].cnst.unwrap().bytes.as_slice()).to_string())
                        } else { None };
                        // (Not a literal: left, and code generation reports it.)
                        match lit {
                            None => None,
                            Some(n) => {
                                // Option<&str>: Some(value) or None.
                                let opt = ot;
                                let ai = info.adts[&opt.d().id];
                                let mut some = 0usize;
                                let mut none = 0usize;
                                let mut i = 0;
                                while i < ai.variants.len() {
                                    if ai.variants[i].def.name == "Some" { some = i; } else { none = i; }
                                    i += 1;
                                }
                                let st = dt;
                                match crate::driver::build_var(n.as_str()) {
                                    Some(v) => {
                                        let mut ops = Vec::new();
                                        ops.push(str_op(v.as_str(), st));
                                        Some(aggregate(AGG_ADT, opt, some, ops))
                                    }
                                    None => Some(aggregate(AGG_ADT, opt, none, Vec::new())),
                                }
                            }
                        }
                    }
                    _ => None,
                };
                if let Some(r) = rv {
                    let mut stmts = b.stmts.clone();
                    stmts.push(Stmt::Assign { place: dest.clone(), rv: r });
                    // Blocks may be shared with other functions: a new one.
                    f.blocks[bi] = &mut Block { stmts, term: Term::Goto(*target as usize) };
                }
            }
        }
        bi += 1;
    }
}
