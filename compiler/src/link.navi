//! A linker for macOS arm64: turns the object model into a position
//! independent Mach-O executable that imports its C functions from
//! libSystem, with an ad-hoc code signature (the kernel requires one on
//! Apple silicon). It replaces `cc`/`ld` for navic's own output.
//!
//! Layout (16 KiB pages): __PAGEZERO; __TEXT (header and load commands,
//! __text, __stubs, __const); __DATA_CONST (__got, __const); __DATA
//! (__data); __LINKEDIT (rebase and bind opcodes, symbol table, string
//! table, code signature). Imported functions are called through stubs
//! that jump via the GOT, which dyld fills (non-lazy binding); absolute
//! pointers in data are rebased by dyld.

use std::collections::HashMap;
use crate::obj::{self, Object};
use crate::sha256;

const PAGE: u64 = 16384;
const BASE: u64 = 0x100000000;
const STUB_SIZE: u64 = 12;

fn align_up(x: u64, a: u64) -> u64 { (x + a - 1) / a * a }

/// A little-endian byte buffer.
struct Buf { b: Vec<u8> }

impl Buf {
    fn u8(&mut self, v: u8) { self.b.push(v); }
    fn u32(&mut self, v: u32) {
        let mut i = 0;
        while i < 4 { self.b.push((v >> (8 * i) as u32) as u8); i += 1; }
    }
    fn u64(&mut self, v: u64) {
        let mut i = 0;
        while i < 8 { self.b.push((v >> (8 * i) as u32) as u8); i += 1; }
    }
    fn be32(&mut self, v: u32) {
        let mut i = 0;
        while i < 4 { self.b.push((v >> (24 - 8 * i) as u32) as u8); i += 1; }
    }
    fn be64(&mut self, v: u64) {
        let mut i = 0;
        while i < 8 { self.b.push((v >> (56 - 8 * i) as u32) as u8); i += 1; }
    }
    fn name16(&mut self, s: &str) {
        let bs = s.as_bytes();
        let mut i = 0;
        while i < 16 { self.b.push(if i < bs.len() { bs[i] } else { 0 }); i += 1; }
    }
    fn uleb(&mut self, v0: u64) {
        let mut v = v0;
        loop {
            let byte = (v & 0x7f) as u8;
            v = v >> 7;
            if v == 0 {
                self.b.push(byte);
                return;
            }
            self.b.push(byte | 0x80);
        }
    }
    fn cstr(&mut self, s: &str) {
        self.b.extend_from_slice(s.as_bytes());
        self.b.push(0);
    }
    fn pad_to(&mut self, n: u64) { while (self.b.len() as u64) < n { self.b.push(0); } }
    fn put32(&mut self, at: usize, v: u32) {
        let mut i = 0;
        while i < 4 { self.b[at + i] = (v >> (8 * i) as u32) as u8; i += 1; }
    }
    fn put64(&mut self, at: usize, v: u64) {
        let mut i = 0;
        while i < 8 { self.b[at + i] = (v >> (8 * i) as u32) as u8; i += 1; }
    }
}

fn get32(b: &Vec<u8>, at: usize) -> u32 {
    (b[at] as u32) | (b[at + 1] as u32) << 8 | (b[at + 2] as u32) << 16 | (b[at + 3] as u32) << 24
}

fn set32(b: &mut Vec<u8>, at: usize, v: u32) {
    let mut i = 0;
    while i < 4 { b[at + i] = (v >> (8 * i) as u32) as u8; i += 1; }
}

fn set64(b: &mut Vec<u8>, at: usize, v: u64) {
    let mut i = 0;
    while i < 8 { b[at + i] = (v >> (8 * i) as u32) as u8; i += 1; }
}

/// Patches an adrp at pc to address the page of target.
fn patch_page21(code: &mut Vec<u8>, at: usize, pc: u64, target: u64) -> Result<(), String> {
    let delta = ((target & !0xfff) as i64 - (pc & !0xfff) as i64) >> 12;
    if delta >= 1 << 20 || delta < -(1 << 20) { return Err("link: adrp out of range".to_string()); }
    let d = delta as u32;
    let w = get32(code, at) | (d & 3) << 29 | ((d >> 2) & 0x7ffff) << 5;
    set32(code, at, w);
    Ok(())
}

/// Patches an add (immediate) at pc with the low 12 bits of target.
fn patch_pageoff12(code: &mut Vec<u8>, at: usize, target: u64) {
    let w = get32(code, at) | ((target & 0xfff) as u32) << 10;
    set32(code, at, w);
}

fn patch_branch26(code: &mut Vec<u8>, at: usize, pc: u64, target: u64) -> Result<(), String> {
    let delta = (target as i64 - pc as i64) >> 2;
    if delta >= 1 << 25 || delta < -(1 << 25) { return Err("link: branch out of range".to_string()); }
    let w = get32(code, at) | (delta as u32) & 0x3ffffff;
    set32(code, at, w);
    Ok(())
}

fn max_u64(a: u64, b: u64) -> u64 { if a > b { a } else { b } }

fn segment(w: &mut Buf, name: &str, vmaddr: u64, vmsize: u64, fileoff: u64, filesize: u64, prot: u32, sects: &Vec<&Sect>) {
    w.u32(0x19);
    w.u32(72 + 80 * sects.len() as u32);
    w.name16(name);
    w.u64(vmaddr);
    w.u64(vmsize);
    w.u64(fileoff);
    w.u64(filesize);
    w.u32(prot);
    w.u32(prot);
    w.u32(sects.len() as u32);
    w.u32(0);
    for s in sects.iter() {
        w.name16(s.name);
        w.name16(s.seg);
        w.u64(s.addr);
        w.u64(s.data.len() as u64);
        w.u32(s.off as u32);
        w.u32(s.align);
        w.u32(0);
        w.u32(0);
        w.u32(s.flags);
        w.u32(0);
        w.u32(0);
        w.u32(0);
    }
}

/// One section of the output with its contents and address.
struct Sect {
    seg: &str,
    name: &str,
    data: Vec<u8>,
    addr: u64,
    off: u64,
    align: u32,
    flags: u32,
}

/// Links o (arm64) into an executable; identifier names it in the code
/// signature (the output's file name, as ld does).
pub fn link(o: &Object, identifier: &str) -> Result<Vec<u8>, String> {
    // Imports: undefined symbols, sorted.
    let mut imports: Vec<String> = o.undef.keys().map(|k| k.clone()).collect();
    imports.sort();
    let mut import_index: HashMap<String, usize> = HashMap::new();
    let mut ii = 0;
    while ii < imports.len() {
        import_index.insert(imports[ii].clone(), ii);
        ii += 1;
    }
    let nimp = imports.len() as u64;

    // Load command sizes (fixed set of commands).
    let nsects_text = 3u32;
    let nsects_dc = 2u32;
    let nsects_data = 1u32;
    let mut cmds_size = 72 + 72 + 80 * nsects_text + 72 + 80 * nsects_dc + 72 + 80 * nsects_data + 72; // segments
    cmds_size += 48; // LC_DYLD_INFO_ONLY
    cmds_size += 24; // LC_SYMTAB
    cmds_size += 80; // LC_DYSYMTAB
    let dylinker = "/usr/lib/dyld";
    let dylinker_size = align_up((12 + dylinker.len() + 1) as u64, 8) as u32;
    cmds_size += dylinker_size;
    cmds_size += 24; // LC_UUID
    cmds_size += 24; // LC_BUILD_VERSION
    cmds_size += 24; // LC_MAIN
    let libsystem = "/usr/lib/libSystem.B.dylib";
    let dylib_size = align_up((24 + libsystem.len() + 1) as u64, 8) as u32;
    cmds_size += dylib_size;
    cmds_size += 16; // LC_CODE_SIGNATURE
    let ncmds = 5 + 1 + 1 + 1 + 1 + 1 + 1 + 1 + 1 + 1;

    // __TEXT: header, commands, __text, __stubs, __const.
    let text = &mut Sect { seg: "__TEXT", name: "__text", data: o.sects[obj::TEXT].clone(), addr: 0, off: 0, align: 2, flags: 0x80000400 };
    let stubs = &mut Sect { seg: "__TEXT", name: "__stubs", data: Vec::new(), addr: 0, off: 0, align: 2, flags: 0x80000400 };
    let cstr = &mut Sect { seg: "__TEXT", name: "__const", data: o.sects[obj::RO_DATA].clone(), addr: 0, off: 0, align: 3, flags: 0 };
    let got = &mut Sect { seg: "__DATA_CONST", name: "__got", data: Vec::new(), addr: 0, off: 0, align: 3, flags: 0 };
    let dconst = &mut Sect { seg: "__DATA_CONST", name: "__const", data: o.sects[obj::DATA_CONST].clone(), addr: 0, off: 0, align: 3, flags: 0 };
    let data = &mut Sect { seg: "__DATA", name: "__data", data: o.sects[obj::DATA].clone(), addr: 0, off: 0, align: 3, flags: 0 };
    let mut k = 0;
    while k < nimp * STUB_SIZE { stubs.data.push(0); k += 1; }
    k = 0;
    while k < nimp * 8 { got.data.push(0); k += 1; }

    let mut pos = 32 + cmds_size as u64;
    text.off = align_up(pos, 16);
    pos = text.off + text.data.len() as u64;
    stubs.off = align_up(pos, 4);
    pos = stubs.off + stubs.data.len() as u64;
    cstr.off = align_up(pos, 8);
    pos = cstr.off + cstr.data.len() as u64;
    let text_size = align_up(pos, PAGE);
    let dc_off = text_size;
    got.off = dc_off;
    dconst.off = align_up(got.off + got.data.len() as u64, 8);
    let dc_size = max_u64(align_up(dconst.off + dconst.data.len() as u64 - dc_off, PAGE), PAGE);
    let data_off = dc_off + dc_size;
    data.off = data_off;
    let data_size = max_u64(align_up(data.data.len() as u64, PAGE), PAGE);
    let linkedit_off = data_off + data_size;
    // File offsets equal address offsets from BASE.
    text.addr = BASE + text.off;
    stubs.addr = BASE + stubs.off;
    cstr.addr = BASE + cstr.off;
    got.addr = BASE + got.off;
    dconst.addr = BASE + dconst.off;
    data.addr = BASE + data.off;

    // Symbol addresses.
    let sect_addr = |sec: obj::Section| -> u64 {
        if sec == obj::TEXT { text.addr } else if sec == obj::RO_DATA { cstr.addr } else if sec == obj::DATA_CONST { dconst.addr } else { data.addr }
    };
    let mut addr_of: HashMap<String, u64> = HashMap::new();
    for sy in o.syms.iter() { addr_of.insert(sy.name.clone(), sect_addr(sy.sec) + sy.off); }
    let entry = match addr_of.get(&"_main".to_string()) { Some(a) => *a, None => return Err("link: no _main".to_string()) };

    // Stubs: adrp x16, got@PAGE; ldr x16, [x16, got@PAGEOFF]; br x16.
    let mut i = 0u64;
    while i < nimp {
        let at = (i * STUB_SIZE) as usize;
        let pc = stubs.addr + i * STUB_SIZE;
        let slot = got.addr + i * 8;
        set32(&mut stubs.data, at, 0x90000010);
        patch_page21(&mut stubs.data, at, pc, slot)?;
        set32(&mut stubs.data, at + 4, 0xF9400210 | (((slot & 0xfff) >> 3) as u32) << 10);
        set32(&mut stubs.data, at + 8, 0xD61F0200);
        i += 1;
    }

    // Relocations: code is patched; data pointers are written and rebased
    // (internal) or bound (imports).
    let mut rebases: Vec<(u32, u64)> = Vec::new(); // (segment index, offset)
    let mut binds: Vec<(u32, u64, String)> = Vec::new();
    i = 0;
    while i < nimp {
        binds.push((2, got.off + i * 8 - dc_off, imports[i as usize].clone()));
        i += 1;
    }
    for r in o.relocs.iter() {
        let target = match addr_of.get(&r.sym) {
            Some(a) => *a,
            None => match import_index.get(&r.sym) {
                Some(ix) => stubs.addr + (*ix as u64) * STUB_SIZE,
                None => return Err(`link: undefined symbol ${r.sym}`),
            },
        };
        if r.sec == obj::TEXT {
            let at = r.off as usize;
            let pc = text.addr + r.off as u64;
            if r.kind == obj::BRANCH26 {
                patch_branch26(&mut text.data, at, pc, target)?;
            } else if r.kind == obj::PAGE21 {
                patch_page21(&mut text.data, at, pc, target)?;
            } else if r.kind == obj::PAGE_OFF12 {
                patch_pageoff12(&mut text.data, at, target);
            } else {
                return Err("link: unsupported code relocation".to_string());
            }
            continue;
        }
        if r.kind != obj::ABS64 { return Err("link: unsupported data relocation".to_string()); }
        if r.sec != obj::DATA_CONST && r.sec != obj::DATA { return Err("link: relocation in read-only data".to_string()); }
        let seg_no: u32 = if r.sec == obj::DATA_CONST { 2 } else { 3 };
        let seg_rel = if r.sec == obj::DATA_CONST { dconst.off + r.off as u64 - dc_off } else { data.off + r.off as u64 - data_off };
        if let Some(ix) = import_index.get(&r.sym) {
            if !addr_of.contains_key(&r.sym) {
                binds.push((seg_no, seg_rel, imports[*ix].clone()));
                continue;
            }
        }
        if r.sec == obj::DATA_CONST { set64(&mut dconst.data, r.off as usize, target); } else { set64(&mut data.data, r.off as usize, target); }
        rebases.push((seg_no, seg_rel));
    }
    rebases.sort_by(|a, b| if a.0 != b.0 { a.0.cmp(&b.0) } else { a.1.cmp(&b.1) });

    // __LINKEDIT: rebase opcodes, bind opcodes, symbols, strings, signature.
    let le = &mut Buf { b: Vec::new() };
    let rebase_off = linkedit_off;
    le.u8(0x11); // REBASE_OPCODE_SET_TYPE_IMM | REBASE_TYPE_POINTER
    for rb in rebases.iter() {
        le.u8(0x20 | rb.0 as u8); // SET_SEGMENT_AND_OFFSET_ULEB
        le.uleb(rb.1);
        le.u8(0x51); // DO_REBASE_IMM_TIMES 1
    }
    le.u8(0);
    le.pad_to(align_up(le.b.len() as u64, 8));
    let rebase_size = le.b.len() as u64;
    let bind_off = linkedit_off + rebase_size;
    le.u8(0x11); // BIND_OPCODE_SET_DYLIB_ORDINAL_IMM 1
    le.u8(0x51); // BIND_OPCODE_SET_TYPE_IMM POINTER
    for bd in binds.iter() {
        le.u8(0x40); // SET_SYMBOL_TRAILING_FLAGS_IMM
        le.cstr(bd.2.as_str());
        le.u8(0x70 | bd.0 as u8); // SET_SEGMENT_AND_OFFSET_ULEB
        le.uleb(bd.1);
        le.u8(0x90); // DO_BIND
    }
    le.u8(0);
    le.pad_to(align_up(le.b.len() as u64, 8));
    let bind_size = le.b.len() as u64 - rebase_size;
    // Symbols: the defined symbols (local; _main external), then imports.
    let sym_off = linkedit_off + le.b.len() as u64;
    let strtab = &mut Buf { b: Vec::new() };
    strtab.u8(0x20);
    strtab.u8(0);
    let mut nsyms = 0u32;
    let mut nlocal = 0u32;
    for pass in [false, true].iter() {
        for sy in o.syms.iter() {
            if sy.global != *pass { continue; }
            let sect_no: u8 = if sy.sec == obj::TEXT { 1 } else if sy.sec == obj::RO_DATA { 3 } else if sy.sec == obj::DATA_CONST { 5 } else { 6 };
            le.u32(strtab.b.len() as u32);
            le.u8(if sy.global { 0x0f } else { 0x0e });
            le.u8(sect_no);
            le.u8(0);
            le.u8(0);
            le.u64(sect_addr(sy.sec) + sy.off);
            strtab.cstr(sy.name.as_str());
            nsyms += 1;
            if !sy.global { nlocal += 1; }
        }
    }
    let nextdef = nsyms - nlocal;
    for name in imports.iter() {
        le.u32(strtab.b.len() as u32);
        le.u8(0x01); // N_UNDF | N_EXT
        le.u8(0);
        le.u8(0);
        le.u8(1); // library ordinal 1 (n_desc high byte)
        le.u64(0);
        strtab.cstr(name.as_str());
        nsyms += 1;
    }
    let str_off = linkedit_off + le.b.len() as u64;
    le.b.extend_from_slice(strtab.b.as_slice());
    le.pad_to(align_up(le.b.len() as u64, 16));
    let str_size = linkedit_off + le.b.len() as u64 - str_off;
    let sig_off = linkedit_off + le.b.len() as u64;
    let id = identifier.as_bytes();
    let n_pages = (sig_off + 4095) / 4096;
    let cd_header = 88u64;
    let hash_off = cd_header + id.len() as u64 + 1;
    let cd_len = hash_off + 32 * n_pages;
    let sig_len = 12 + 8 + cd_len;
    let sig_size = align_up(sig_len, 16);
    let linkedit_size = le.b.len() as u64 + sig_size;

    // Header and load commands.
    let w = &mut Buf { b: Vec::new() };
    w.u32(0xfeedfacf);
    w.u32(0x0100000c);
    w.u32(0);
    w.u32(2); // MH_EXECUTE
    w.u32(ncmds);
    w.u32(cmds_size);
    w.u32(0x200085); // MH_NOUNDEFS | MH_DYLDLINK | MH_TWOLEVEL | MH_PIE
    w.u32(0);
    let mut tsects: Vec<&Sect> = Vec::new();
    tsects.push(text);
    tsects.push(stubs);
    tsects.push(cstr);
    let mut dsects: Vec<&Sect> = Vec::new();
    dsects.push(got);
    dsects.push(dconst);
    let mut wsects: Vec<&Sect> = Vec::new();
    wsects.push(data);
    segment(w, "__PAGEZERO", 0, BASE, 0, 0, 0, &Vec::new());
    segment(w, "__TEXT", BASE, text_size, 0, text_size, 5, &tsects);
    segment(w, "__DATA_CONST", BASE + dc_off, dc_size, dc_off, dc_size, 3, &dsects);
    segment(w, "__DATA", BASE + data_off, data_size, data_off, data_size, 3, &wsects);
    segment(w, "__LINKEDIT", BASE + linkedit_off, align_up(linkedit_size, PAGE), linkedit_off, linkedit_size, 1, &Vec::new());
    // LC_DYLD_INFO_ONLY
    w.u32(0x80000022);
    w.u32(48);
    w.u32(rebase_off as u32);
    w.u32(rebase_size as u32);
    w.u32(bind_off as u32);
    w.u32(bind_size as u32);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    w.u32(0);
    // LC_SYMTAB
    w.u32(0x2);
    w.u32(24);
    w.u32(sym_off as u32);
    w.u32(nsyms);
    w.u32(str_off as u32);
    w.u32(str_size as u32);
    // LC_DYSYMTAB
    w.u32(0xb);
    w.u32(80);
    w.u32(0);
    w.u32(nlocal);
    w.u32(nlocal);
    w.u32(nextdef);
    w.u32(nlocal + nextdef);
    w.u32(nimp as u32);
    let mut z = 0;
    while z < 12 { w.u32(0); z += 1; }
    // LC_LOAD_DYLINKER
    let start = w.b.len();
    w.u32(0xe);
    w.u32(dylinker_size);
    w.u32(12);
    w.cstr(dylinker);
    w.pad_to((start as u64) + dylinker_size as u64);
    // LC_UUID (filled in from the hash of the contents below)
    w.u32(0x1b);
    w.u32(24);
    let uuid_at = w.b.len();
    w.u64(0);
    w.u64(0);
    // LC_BUILD_VERSION: macOS 11.0
    w.u32(0x32);
    w.u32(24);
    w.u32(1);
    w.u32(11 << 16);
    w.u32(11 << 16);
    w.u32(0);
    // LC_MAIN
    w.u32(0x80000028);
    w.u32(24);
    w.u64(entry - BASE);
    w.u64(0);
    // LC_LOAD_DYLIB libSystem
    let start2 = w.b.len();
    w.u32(0xc);
    w.u32(dylib_size);
    w.u32(24);
    w.u32(2);
    w.u32(0x050c6405); // current version 1292.100.5
    w.u32(0x00010000);
    w.cstr(libsystem);
    w.pad_to((start2 as u64) + dylib_size as u64);
    // LC_CODE_SIGNATURE
    w.u32(0x1d);
    w.u32(16);
    w.u32(sig_off as u32);
    w.u32(sig_size as u32);
    if w.b.len() as u64 != 32 + cmds_size as u64 { return Err("link: load command size mismatch".to_string()); }

    // Contents.
    w.pad_to(text.off);
    w.b.extend_from_slice(text.data.as_slice());
    w.pad_to(stubs.off);
    w.b.extend_from_slice(stubs.data.as_slice());
    w.pad_to(cstr.off);
    w.b.extend_from_slice(cstr.data.as_slice());
    w.pad_to(got.off);
    w.b.extend_from_slice(got.data.as_slice());
    w.pad_to(dconst.off);
    w.b.extend_from_slice(dconst.data.as_slice());
    w.pad_to(data.off);
    w.b.extend_from_slice(data.data.as_slice());
    w.pad_to(linkedit_off);
    w.b.extend_from_slice(le.b.as_slice());
    if w.b.len() as u64 != sig_off { return Err("link: layout mismatch".to_string()); }
    // The UUID: from the hash of everything before the signature.
    let digest = sha256::sum(w.b.as_slice());
    let mut u = 0;
    while u < 16 {
        w.b[uuid_at + u] = digest[u];
        u += 1;
    }
    w.b[uuid_at + 6] = (w.b[uuid_at + 6] & 0x0f) | 0x40;
    w.b[uuid_at + 8] = (w.b[uuid_at + 8] & 0x3f) | 0x80;

    // Ad-hoc signature: a SuperBlob holding one CodeDirectory (big endian).
    w.be32(0xfade0cc0);
    w.be32(sig_len as u32);
    w.be32(1);
    w.be32(0); // CSSLOT_CODEDIRECTORY
    w.be32(20);
    w.be32(0xfade0c02);
    w.be32(cd_len as u32);
    w.be32(0x20400);
    w.be32(0x20002); // CS_ADHOC | CS_LINKER_SIGNED
    w.be32(hash_off as u32);
    w.be32(cd_header as u32);
    w.be32(0); // special slots
    w.be32(n_pages as u32);
    w.be32(sig_off as u32); // code limit
    w.u8(32); // hash size
    w.u8(2); // SHA-256
    w.u8(0); // platform
    w.u8(12); // page size 4096
    w.be32(0);
    w.be32(0); // scatter
    w.be32(0); // team
    w.be32(0);
    w.be64(0); // code limit 64
    w.be64(0); // exec segment base
    w.be64(text_size); // exec segment limit
    w.be64(1); // CS_EXECSEG_MAIN_BINARY
    w.b.extend_from_slice(id);
    w.u8(0);
    let mut p = 0u64;
    while p < n_pages {
        let lo = (p * 4096) as usize;
        let hi = if (p + 1) * 4096 < sig_off { ((p + 1) * 4096) as usize } else { sig_off as usize };
        let h = sha256::sum(&w.b[lo..hi]);
        w.b.extend_from_slice(&h);
        p += 1;
    }
    w.pad_to(sig_off + sig_size);
    Ok(w.b)
}
