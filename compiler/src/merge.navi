//! Several objects as one (docs/crates.md): each crate's code is an object
//! of its own; before linking they become one object, which the linkers
//! (Mach-O, ELF, PE) take as before.
//!
//! - Each part's sections are cut into atoms, one per symbol (a function with
//!   its inner labels, a string, a static, a table); the atoms nothing reaches
//!   from the program's entry point are left out (a crate compiled alone has
//!   every function a program might call). -d nostrip keeps them all. A
//!   static's initialization in a crate's initializer counts as reached only if
//!   the static is. A vtable's slot (obj::DYN_SLOT) reaches its method's code
//!   only if a function reached calls that method through dyn (obj::DYN_USE),
//!   as Go's linker keeps an itab's methods: the other slots are left 0.
//! - A part's numbered symbols (strings, locations: their names say nothing
//!   about what they are) are its own: renamed with the part's number. Every
//!   other name means the same thing in every part (stable names,
//!   crate::symbols): defined in several (a generic instance, a type descriptor
//!   or vtable each part needed), the first part's stays.
//! - The program-wide tables are made again for the whole: the stack map table
//!   (_navi_ftab: its entries are offsets from _navi_text0, the start of the
//!   text, and from the start of the maps) and the range of writable data the
//!   collector scans (_navi_data_start to _navi_data_end).

use std::collections::HashMap;

use crate::{
    backend::lower::INIT_NOP,
    obj::{self, Object},
};

// Names each part defines for itself that the merged object defines once.
fn program_wide(name: &str) -> bool {
    name == "_navi_ftab"
        || name == "_navi_text0"
        || name == "_navi_data_start"
        || name == "_navi_data_end"
}

// A name numbered by the object that made it (its own, not shared):
// _navi_strN, _navi_locN.
fn part_local(name: &str) -> bool {
    numbered(name, "_navi_str") || numbered(name, "_navi_loc")
}

fn numbered(name: &str, prefix: &str) -> bool {
    if !name.starts_with(prefix) || name.len() == prefix.len() {
        return false;
    }
    for c in name[prefix.len()..].bytes() {
        if c < b'0' || c > b'9' {
            return false;
        }
    }
    true
}

// A label inside a function (where it saves its registers, its C call),
// not the start of an atom.
fn inner_label(name: &str, sec: obj::Section) -> bool {
    sec == obj::TEXT && (name.ends_with(".r") || name.ends_with(".c"))
}

fn rd(b: &Vec<u8>, at: usize, n: usize) -> u64 {
    let mut v = 0u64;
    let mut i = 0;
    while i < n {
        v = v | (b[at + i] as u64) << (8 * i) as u32;
        i += 1;
    }
    v
}

fn put(b: &mut Vec<u8>, v: u64, n: usize) {
    let mut i = 0;
    while i < n {
        b.push((v >> (8 * i) as u32) as u8);
        i += 1;
    }
}

fn align_to(s: &mut Vec<u8>, a: usize) {
    while s.len() % a != 0 {
        s.push(0);
    }
}

// The index of the last of the sorted starts at or before off.
fn find(starts: &Vec<u64>, off: u64) -> usize {
    let mut lo = 0usize;
    let mut hi = starts.len();
    while hi - lo > 1 {
        let mid = (lo + hi) / 2;
        if starts[mid] <= off {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    lo
}

// A part cut into atoms: per section, the atoms' starts (sorted; the first
// at 0), whether each is reached and where it went.
struct Part {
    starts: Vec<Vec<u64>>,
    live: Vec<Vec<bool>>,
    to: Vec<Vec<u64>>,
    // The relocations of each atom: rels[sec][first[sec][a]..first[sec][a + 1]].
    first: Vec<Vec<u32>>,
    rels: Vec<Vec<u32>>,
    // The merged name (Names) of each of the part's names.
    gid: Vec<u32>,
    // The atom of the stack map table (DATA_CONST; -1: none): never
    // copied, its entries and maps are taken one function at a time.
    ftab: i64,
    // The table's entries (text offset, size, map offset from the maps).
    entries: Vec<(u64, u64, u64)>,
    // Where the maps start in DATA_CONST and end.
    maps: u64,
    maps_end: u64,
    // Whether no symbol starts a section (its first atom has none).
    bare: Vec<bool>,
}

impl Part {
    fn end(&self, p: &Object, s: usize, a: usize) -> u64 {
        if a + 1 < self.starts[s].len() {
            self.starts[s][a + 1]
        } else {
            p.sects[s].len() as u64
        }
    }

    // Where offset off of section s went (its atom reached).
    fn at(&self, s: usize, off: u64) -> u64 {
        let a = find(&self.starts[s], off);
        self.to[s][a] + off - self.starts[s][a]
    }

    fn reached(&self, s: usize, off: u64) -> bool {
        self.live[s][find(&self.starts[s], off)]
    }
}

// The merged object's names, numbered (the parts' names map to them once,
// so the rest looks nothing up by name).
struct Names {
    ids: HashMap<String, u32>,
    names: Vec<String>,
}

impl Names {
    fn id_of(&mut self, n: &String) -> u32 {
        if let Some(i) = self.ids.get(n) {
            return *i;
        }
        self.id(n.clone())
    }

    fn id(&mut self, n: String) -> u32 {
        if let Some(i) = self.ids.get(&n) {
            return *i;
        }
        let i = self.names.len() as u32;
        self.ids.insert(n.clone(), i);
        self.names.push(n);
        i
    }
}

fn cut(p: &Object, pi: usize, g: &mut Names) -> &mut Part {
    let mut starts: Vec<Vec<u64>> = Vec::new();
    let mut s = 0;
    while s < obj::NUM_SECTIONS {
        starts.push(Vec::new());
        s += 1;
    }
    let mut ftab_off = -1i64;
    for sy in p.syms.iter() {
        if sy.name == "_navi_ftab" {
            ftab_off = sy.off as i64;
        }
        if (program_wide(sy.name.as_str()) && sy.name != "_navi_ftab")
            || inner_label(sy.name.as_str(), sy.sec)
        {
            continue;
        }
        let mut v = starts[sy.sec];
        v.push(sy.off);
    }
    let mut live: Vec<Vec<bool>> = Vec::new();
    let mut to: Vec<Vec<u64>> = Vec::new();
    let mut bare: Vec<bool> = Vec::new();
    s = 0;
    while s < obj::NUM_SECTIONS {
        let mut v = starts[s];
        bare.push(!v.contains(&0));
        v.push(0);
        v.sort();
        v.dedup();
        let mut l: Vec<bool> = Vec::new();
        let mut t: Vec<u64> = Vec::new();
        for _ in v.iter() {
            l.push(false);
            t.push(0);
        }
        live.push(l);
        to.push(t);
        s += 1;
    }
    let mut gid: Vec<u32> = Vec::with_capacity(p.names.len());
    for n in p.names.iter() {
        if part_local(n.as_str()) {
            gid.push(g.id(`${n}.p${pi}`.to_string()));
        } else {
            gid.push(g.id_of(n));
        }
    }
    let part = &mut Part {
        starts,
        live,
        to,
        first: Vec::new(),
        rels: Vec::new(),
        gid,
        ftab: -1,
        entries: Vec::new(),
        maps: 0,
        maps_end: 0,
        bare,
    };
    // Each atom's relocations (counted, then placed).
    let mut ra: Vec<u32> = Vec::with_capacity(p.relocs.len());
    s = 0;
    while s < obj::NUM_SECTIONS {
        let mut first: Vec<u32> = Vec::new();
        let mut k = 0;
        while k <= part.starts[s].len() {
            first.push(0);
            k += 1;
        }
        part.first.push(first);
        part.rels.push(Vec::new());
        s += 1;
    }
    for r in p.relocs.iter() {
        let a = find(&part.starts[r.sec], r.off as u64);
        ra.push(a as u32);
        let mut f = part.first[r.sec];
        f[a + 1] += 1;
    }
    s = 0;
    while s < obj::NUM_SECTIONS {
        let mut f = part.first[s];
        let mut k = 1;
        while k < f.len() {
            f[k] += f[k - 1];
            k += 1;
        }
        let mut rl = part.rels[s];
        let mut k2 = 0;
        while k2 < f[f.len() - 1] {
            rl.push(0);
            k2 += 1;
        }
        s += 1;
    }
    let mut fill: Vec<Vec<u32>> = Vec::new();
    for f in part.first.iter() {
        fill.push(f.clone());
    }
    let mut i = 0;
    while i < p.relocs.len() {
        let sec = p.relocs[i].sec;
        let a = ra[i] as usize;
        let mut fl = fill[sec];
        let mut rl = part.rels[sec];
        rl[fl[a] as usize] = i as u32;
        fl[a] += 1;
        i += 1;
    }
    // The stack map table.
    if ftab_off >= 0 {
        let dc = p.sects[obj::DATA_CONST];
        let off = ftab_off as u64;
        let a = find(&part.starts[obj::DATA_CONST], off);
        part.ftab = a as i64;
        let n = rd(&dc, off as usize, 8);
        part.maps = off + rd(&dc, off as usize + 16, 8);
        part.maps_end = part.end(p, obj::DATA_CONST, a);
        let mut e = 0;
        while e < n as usize {
            let at = off as usize + 24 + 12 * e;
            part.entries
                .push((rd(&dc, at, 4), rd(&dc, at + 4, 4), rd(&dc, at + 8, 4)));
            e += 1;
        }
    }
    part
}

fn reached(cuts: &Vec<&mut Part>, defs: &Vec<(i64, usize, usize)>, id: usize) -> bool {
    let d = defs[id];
    d.0 >= 0 && cuts[d.0 as usize].live[d.1][d.2]
}

// The method of the vtable slot whose code or context word is at off.
fn slot_of(slots: &HashMap<u64, u32>, off: u64) -> Option<u32> {
    if let Some(k) = slots.get(&off) {
        return Some(*k);
    }
    if off >= 8 {
        if let Some(k) = slots.get(&(off - 8)) {
            return Some(*k);
        }
    }
    None
}

// Whether a relocation kept refers to name.
fn is_used(g: &Names, used: &Vec<bool>, n: &String) -> bool {
    match g.ids.get(n) {
        Some(i) => used[*i as usize],
        None => false,
    }
}

// wasm: calls name an import with its signature (name#sig,
// crate::backend::wasm), whose library is name's.
fn wasm_import_used(g: &Names, used: &Vec<bool>, n: &String) -> bool {
    let prefix = `${n}#`.to_string();
    for (name, i) in g.ids.iter() {
        if used[*i as usize] && name.starts_with(prefix.as_str()) {
            return true;
        }
    }
    false
}

/// The parts as one object.
pub fn merge(parts: &Vec<&mut Object>) -> Result<&mut Object, String> {
    if parts.len() == 0 {
        return Err("merge: no objects".to_string());
    }
    let arch = parts[0].arch.clone();
    let o = obj::new_object(arch.as_str());
    let mut k = 0;
    while k < obj::NUM_SECTIONS {
        let mut a = o.align[k];
        for p in parts.iter() {
            if p.align[k] > a {
                a = p.align[k];
            }
        }
        o.align[k] = a;
        k += 1;
    }
    let g = &mut Names {
        ids: HashMap::new(),
        names: Vec::new(),
    };
    let mut cuts: Vec<&mut Part> = Vec::new();
    let mut pi = 0;
    while pi < parts.len() {
        cuts.push(cut(parts[pi], pi, g));
        pi += 1;
    }
    let ng = g.names.len();
    // Each name's definition (part, section, atom; part -1: none): the
    // first part's.
    let mut defs: Vec<(i64, usize, usize)> = Vec::with_capacity(ng);
    // The static a name initializes (lower::static_init_sym; -1: none).
    let mut init_of: Vec<i64> = Vec::with_capacity(ng);
    let mut k2 = 0;
    while k2 < ng {
        defs.push((-1, 0, 0));
        let n = g.names[k2];
        let st = if n.ends_with(".i") {
            match g.ids.get(&n[..n.len() - 2].to_string()) {
                Some(i) => *i as i64,
                None => -1,
            }
        } else {
            -1
        };
        init_of.push(st);
        k2 += 1;
    }
    pi = 0;
    while pi < parts.len() {
        let c = cuts[pi];
        for sy in parts[pi].syms.iter() {
            if program_wide(sy.name.as_str()) {
                continue;
            }
            let id = c.gid[sy.id as usize] as usize;
            if defs[id].0 >= 0 {
                continue;
            }
            defs[id] = (pi as i64, sy.sec, find(&c.starts[sy.sec], sy.off));
        }
        pi += 1;
    }
    // The atoms reached: from the global symbols (the entry point) and any
    // bytes before a section's first symbol, through relocations.
    let all = crate::dflags::on("nostrip");
    let mut work: Vec<(i64, usize, usize)> = Vec::new();
    pi = 0;
    while pi < parts.len() {
        let p = parts[pi];
        let c = cuts[pi];
        for sy in p.syms.iter() {
            if sy.global {
                work.push(defs[c.gid[sy.id as usize] as usize]);
            }
        }
        let mut s = 0;
        while s < obj::NUM_SECTIONS {
            let mut a = 0;
            while a < c.starts[s].len() {
                let skip = s == obj::DATA_CONST && a as i64 == c.ftab;
                let bare = a == 0 && c.bare[s] && p.sects[s].len() > 0;
                if !skip && (all || bare) {
                    work.push((pi as i64, s, a));
                }
                a += 1;
            }
            s += 1;
        }
        pi += 1;
    }
    // A static's initialization (lower::static_init_sym) counts only if
    // the static is reached: the crate's initializer calls
    // lower::INIT_NOP instead.
    let nop = match g.ids.get(&INIT_NOP.to_string()) {
        Some(i) => *i as i64,
        None => -1,
    };
    if nop >= 0 {
        work.push(defs[nop as usize]);
    }
    // Each part's vtable slots: the offset of a slot (in DATA_CONST) and
    // its method's name.
    let mut slots: Vec<HashMap<u64, u32>> = Vec::new();
    for (k, p) in parts.iter().enumerate() {
        let mut m: HashMap<u64, u32> = HashMap::new();
        for r in p.relocs.iter() {
            if r.kind == obj::DYN_SLOT {
                m.insert(r.off as u64, cuts[k].gid[r.sym as usize]);
            }
        }
        slots.push(m);
    }
    // The dyn methods called (by name), and the slots' code waiting for
    // their method to be.
    let mut called: Vec<bool> = Vec::with_capacity(ng);
    k2 = 0;
    while k2 < ng {
        called.push(false);
        k2 += 1;
    }
    let mut pending: HashMap<u32, Vec<u32>> = HashMap::new();
    let mut weak: Vec<u32> = Vec::new();
    loop {
        while let Some((wp, ws, wa)) = work.pop() {
            if wp < 0 {
                continue;
            }
            let c = cuts[wp as usize];
            let mut lv = c.live[ws];
            if lv[wa] {
                continue;
            }
            lv[wa] = true;
            let p = parts[wp as usize];
            let f = c.first[ws];
            let rl = c.rels[ws];
            let mut i = f[wa];
            while i < f[wa + 1] {
                let r = p.relocs[rl[i as usize] as usize];
                let id = c.gid[r.sym as usize];
                i += 1;
                if r.kind == obj::DYN_SLOT {
                    continue;
                }
                if r.kind == obj::DYN_USE {
                    if !called[id as usize] {
                        called[id as usize] = true;
                        if let Some(ts) = pending.remove(&id) {
                            for t in ts.iter() {
                                work.push(defs[*t as usize]);
                            }
                        }
                    }
                    continue;
                }
                if !all && ws == obj::DATA_CONST {
                    if let Some(key) = slot_of(&slots[wp as usize], r.off as u64) {
                        if !called[key as usize] {
                            if !pending.contains_key(&key) {
                                pending.insert(key, Vec::new());
                            }
                            pending.get_mut(&key).unwrap().push(id);
                            continue;
                        }
                    }
                }
                if init_of[id as usize] >= 0 {
                    weak.push(id);
                } else {
                    work.push(defs[id as usize]);
                }
            }
        }
        // (Those whose static is not reached yet wait for the next round.)
        let mut wait: Vec<u32> = Vec::new();
        for si in weak.iter() {
            if reached(&cuts, &defs, init_of[*si as usize] as usize) {
                work.push(defs[*si as usize]);
            } else {
                wait.push(*si);
            }
        }
        weak = wait;
        if work.len() == 0 {
            break;
        }
    }
    // Stack map entries of the functions reached; the merged table first
    // in DATA_CONST, then their maps, then the parts' data.
    let mut nentries = 0usize;
    for c in cuts.iter() {
        for e in c.entries.iter() {
            if c.reached(obj::TEXT, e.0) {
                nentries += 1;
            }
        }
    }
    let mut head_len = 24 + 12 * nentries;
    while head_len % 8 != 0 {
        head_len += 1;
    }
    o.define("_navi_ftab", obj::DATA_CONST, 8, false);
    o.zeros(obj::DATA_CONST, head_len as i64);
    // The maps: per part, each reached function's (until the next map).
    let mut map_at: Vec<HashMap<u64, u64>> = Vec::new();
    pi = 0;
    while pi < parts.len() {
        let c = cuts[pi];
        let dc = parts[pi].sects[obj::DATA_CONST];
        let mut mos: Vec<u64> = Vec::new();
        for e in c.entries.iter() {
            mos.push(e.2);
        }
        mos.sort();
        mos.dedup();
        let mut at: HashMap<u64, u64> = HashMap::new();
        for e in c.entries.iter() {
            if !c.reached(obj::TEXT, e.0) || at.contains_key(&e.2) {
                continue;
            }
            let i = find(&mos, e.2);
            let from = c.maps + e.2;
            let to = if i + 1 < mos.len() {
                c.maps + mos[i + 1]
            } else {
                c.maps_end
            };
            let mut sect = o.sects[obj::DATA_CONST];
            at.insert(e.2, sect.len() as u64 - head_len as u64);
            sect.extend_from_slice(&dc[from as usize..to as usize]);
            align_to(&mut sect, 8);
        }
        map_at.push(at);
        pi += 1;
    }
    o.define("_navi_text0", obj::TEXT, 4, false);
    o.define("_navi_data_start", obj::DATA, 8, false);
    // The atoms reached, in order, each as aligned as it was.
    pi = 0;
    while pi < parts.len() {
        let p = parts[pi];
        let c = cuts[pi];
        let mut s = 0;
        while s < obj::NUM_SECTIONS {
            let src = p.sects[s];
            let mut sect = o.sects[s];
            let cap = 1u64 << o.align[s];
            let mut to = c.to[s];
            let mut a = 0;
            while a < c.starts[s].len() {
                if c.live[s][a] {
                    let st = c.starts[s][a];
                    let mut al = 1u64;
                    while al < cap && st % (al * 2) == 0 {
                        al = al * 2;
                    }
                    align_to(&mut sect, al as usize);
                    to[a] = sect.len() as u64;
                    let en = c.end(p, s, a);
                    sect.extend_from_slice(&src[st as usize..en as usize]);
                }
                a += 1;
            }
            s += 1;
        }
        pi += 1;
    }
    o.define("_navi_data_end", obj::DATA, 8, false);
    o.zeros(obj::DATA, 8);
    // The merged table: [count, text start (relocated), maps offset from
    // the table], the entries.
    {
        let mut t: Vec<u8> = Vec::new();
        put(&mut t, nentries as u64, 8);
        put(&mut t, 0, 8);
        put(&mut t, head_len as u64, 8);
        pi = 0;
        while pi < parts.len() {
            let c = cuts[pi];
            for e in c.entries.iter() {
                if !c.reached(obj::TEXT, e.0) {
                    continue;
                }
                let fo = c.at(obj::TEXT, e.0);
                let mo = map_at[pi][&e.2];
                if fo > 0xffffffff || mo > 0xffffffff {
                    return Err("merge: the text or the stack maps exceed 4 GiB".to_string());
                }
                put(&mut t, fo, 4);
                put(&mut t, e.1, 4);
                put(&mut t, mo, 4);
            }
            pi += 1;
        }
        let mut dc = o.sects[obj::DATA_CONST];
        let mut i = 0;
        while i < t.len() {
            dc[i] = t[i];
            i += 1;
        }
        o.reloc(obj::DATA_CONST, 8, obj::ABS64, "_navi_text0");
    }
    // Symbols (each name once), relocations and debug information of the
    // atoms reached.
    let mut defined: Vec<bool> = Vec::with_capacity(ng);
    let mut used: Vec<bool> = Vec::with_capacity(ng);
    let mut oid: Vec<i64> = Vec::with_capacity(ng);
    k2 = 0;
    while k2 < ng {
        defined.push(false);
        used.push(false);
        oid.push(-1);
        k2 += 1;
    }
    pi = 0;
    while pi < parts.len() {
        let p = parts[pi];
        let c = cuts[pi];
        for sy in p.syms.iter() {
            let id = c.gid[sy.id as usize] as usize;
            if program_wide(sy.name.as_str()) || defined[id] || !c.reached(sy.sec, sy.off) {
                continue;
            }
            defined[id] = true;
            o.define_at(
                g.names[id].as_str(),
                sy.sec,
                c.at(sy.sec, sy.off),
                sy.global,
            );
        }
        // Each atom's relocations, moved with it.
        let mut s = 0;
        while s < obj::NUM_SECTIONS {
            let f = c.first[s];
            let rl = c.rels[s];
            let mut a = 0;
            while a < c.starts[s].len() {
                if c.live[s][a] {
                    let delta = c.to[s][a] as i64 - c.starts[s][a] as i64;
                    let mut i = f[a];
                    while i < f[a + 1] {
                        let r = p.relocs[rl[i as usize] as usize];
                        let mut id = c.gid[r.sym as usize] as usize;
                        i += 1;
                        if r.kind == obj::DYN_USE || r.kind == obj::DYN_SLOT {
                            continue;
                        }
                        // (A slot of a method nothing calls: left 0.)
                        if s == obj::DATA_CONST && !reached(&cuts, &defs, id) {
                            if let Some(key) = slot_of(&slots[pi], r.off as u64) {
                                if !called[key as usize] {
                                    continue;
                                }
                            }
                        }
                        if init_of[id] >= 0 && !reached(&cuts, &defs, id) {
                            id = nop as usize;
                        }
                        used[id] = true;
                        if oid[id] < 0 {
                            oid[id] = o.id_s(&g.names[id]) as i64;
                        }
                        let off = r.off as i64 + delta;
                        if off > 0xffffffff {
                            return Err("merge: a section exceeds 4 GiB".to_string());
                        }
                        o.reloc_id(r.sec, off as u32, r.kind, oid[id] as u32);
                    }
                }
                a += 1;
            }
            s += 1;
        }
        for (n, _) in p.undef.iter() {
            if is_used(g, &used, n) {
                o.undefined(n.as_str());
            }
        }
        for (n, l) in p.libs.iter() {
            if is_used(g, &used, n) || wasm_import_used(g, &used, n) {
                o.import_from(n.as_str(), l.as_str());
            }
        }
        let mut fmap: HashMap<u32, u32> = HashMap::new();
        // (Lines come by address: the atom found once for each run.)
        let ts = c.starts[obj::TEXT];
        let mut a = 0usize;
        for l in p.lines.iter() {
            if l.off < ts[a] || a + 1 < ts.len() && l.off >= ts[a + 1] {
                a = find(&ts, l.off);
            }
            if !c.live[obj::TEXT][a] {
                continue;
            }
            let fi = match fmap.get(&l.file) {
                Some(f) => *f,
                None => {
                    let f = o.file_id(&p.files[l.file as usize]);
                    fmap.insert(l.file, f);
                    f
                }
            };
            o.lines.push(obj::Line {
                off: c.to[obj::TEXT][a] + l.off - ts[a],
                file: fi,
                line: l.line,
            });
        }
        for f in p.funcs.iter() {
            if !c.reached(obj::TEXT, f.off) {
                continue;
            }
            o.funcs.push(obj::FuncRange {
                name: f.name.clone(),
                off: c.at(obj::TEXT, f.off),
                size: f.size,
            });
        }
        for (off, size, push) in p.frames.iter() {
            if !c.reached(obj::TEXT, *off) {
                continue;
            }
            o.frames.push((c.at(obj::TEXT, *off), *size, *push));
        }
        pi += 1;
    }
    // Symbols defined by some part are not undefined.
    let mut gone: Vec<String> = Vec::new();
    for (n, _) in o.undef.iter() {
        if let Some(i) = g.ids.get(n) {
            if defined[*i as usize] {
                gone.push(n.clone());
            }
        }
    }
    for n in gone.iter() {
        o.undef.remove(n);
    }
    Ok(o)
}
