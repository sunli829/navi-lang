//! #[cfg(...)] evaluation.

use crate::syntax::ast::Attr;
use crate::syntax::token::*;
use crate::syntax::source::File;
use crate::resolve::{Resolver, Config};
use crate::util;

impl Resolver {
    /// Evaluates every #[cfg] in attrs; malformed predicates are reported
    /// and count as false.
    pub fn cfg_enabled(&mut self, file: &File, attrs: &Vec<&Attr>) -> bool {
        let (ok, bad, err) = eval_cfg(&self.cfg, attrs);
        if err.len() > 0 {
            self.errorf(Some(file), bad, `malformed cfg predicate: ${err}`);
        }
        ok
    }

    pub fn cfg_enabled_quiet(&self, attrs: &Vec<&Attr>) -> bool {
        let (ok, _, _) = eval_cfg(&self.cfg, attrs);
        ok
    }
}

// Returns (enabled, position of a bad attribute, error message).
fn eval_cfg(cfg: &Config, attrs: &Vec<&Attr>) -> (bool, i32, String) {
    for a in attrs.iter() {
        if a.path.segments.len() != 1 || a.path.segments[0].name.value != "cfg" { continue; }
        let mut p = CfgParser { toks: &a.args, i: 0, err: String::new() };
        let mut ok = p.pred(cfg);
        if p.err.len() == 0 && p.i != p.toks.len() {
            p.err = `unexpected ${tok_text(&p.toks[p.i])}`;
        }
        if p.err.len() > 0 { return (false, a.hash, p.err); }
        if !ok { return (false, 0, String::new()); }
        ok = true;
    }
    (true, 0, String::new())
}

fn tok_text(t: &Token) -> String {
    if t.text.len() > 0 { t.text.to_string() } else { kind_name(t.kind).to_string() }
}

struct CfgParser {
    toks: &Vec<Token>,
    i: usize,
    err: String,
}

impl CfgParser {
    fn fail(&mut self, msg: String) -> bool {
        if self.err.len() == 0 { self.err = msg; }
        false
    }

    // name | name = "value" | all(p, ...) | any(p, ...) | not(p)
    fn pred(&mut self, cfg: &Config) -> bool {
        if self.i >= self.toks.len() || self.toks[self.i].kind != IDENT { return self.fail("expected a cfg option".to_string()); }
        let name = self.toks[self.i].text;
        self.i += 1;
        if name == "all" || name == "any" || name == "not" {
            if self.i >= self.toks.len() || self.toks[self.i].kind != L_PAREN {
                return self.fail(`expected '(' after ${name}`);
            }
            self.i += 1;
            let mut vals: Vec<bool> = Vec::new();
            while self.i < self.toks.len() && self.toks[self.i].kind != R_PAREN {
                let v = self.pred(cfg);
                if self.err.len() > 0 { return false; }
                vals.push(v);
                if self.i < self.toks.len() && self.toks[self.i].kind == COMMA { self.i += 1; }
            }
            if self.i >= self.toks.len() { return self.fail("missing ')'".to_string()); }
            self.i += 1;
            if name == "all" {
                for v in vals.iter() { if !*v { return false; } }
                return true;
            }
            if name == "any" {
                for v in vals.iter() { if *v { return true; } }
                return false;
            }
            if vals.len() != 1 { return self.fail("not() takes exactly one predicate".to_string()); }
            return !vals[0];
        }
        if self.i < self.toks.len() && self.toks[self.i].kind == EQ {
            self.i += 1;
            if self.i >= self.toks.len() || self.toks[self.i].kind != STRING {
                return self.fail(`expected a string after ${name} =`);
            }
            let val = self.toks[self.i].text.trim_matches('"');
            self.i += 1;
            if name == "target_os" { return cfg.target_os == val; }
            if name == "target_arch" { return cfg.target_arch == val; }
            if name == "feature" { return val == "navic" && !stage0_mode(); }
            return self.fail(`unknown cfg option ${util::quote(name)}`);
        }
        if name == "test" { return cfg.test; }
        if name == "debug_assertions" { return cfg.debug; }
        self.fail(`unknown cfg option ${util::quote(name)}`)
    }
}

/// NAVI_STAGE0=1 makes navic behave like stage0 where they may differ
/// (for comparing their dumps): the "navic" feature, with which std hides
/// what stage0 cannot compile, is off.
pub fn stage0_mode() -> bool { std::env::var("NAVI_STAGE0").is_ok() }
