//! #[cfg(...)] evaluation.

use crate::{
    resolve::{Config, Resolver},
    syntax::{ast::Attr, source::File, token::*},
    util,
};

impl Resolver {
    /// Evaluates every #[cfg] in attrs; malformed predicates are reported
    /// and count as false.
    pub fn cfg_enabled(&mut self, file: &File, attrs: &Vec<&Attr>) -> bool {
        let (ok, bad, err) = eval_cfg(&self.cfg, attrs);
        if err.len() > 0 {
            self.errorf(
                Some(file),
                bad,
                `malformed cfg predicate: ${err}`.to_string(),
            );
        }
        ok
    }

    pub fn cfg_enabled_quiet(&self, attrs: &Vec<&Attr>) -> bool {
        let (ok, _, _) = eval_cfg(&self.cfg, attrs);
        ok
    }

    /// cfg_enabled_quiet for an item in scope s's crate (cfg(test) holds in
    /// one crate only).
    pub fn cfg_in(&self, s: &crate::resolve::body::Scope, attrs: &Vec<&Attr>) -> bool {
        if attrs.len() == 0 {
            return true;
        }
        let mut c = self.cfg.clone();
        c.test = s.module.krate.name == self.test_crate;
        let (ok, _, _) = eval_cfg(&c, attrs);
        ok
    }
}

// Returns (enabled, position of a bad attribute, error message).
fn eval_cfg(cfg: &Config, attrs: &Vec<&Attr>) -> (bool, i32, String) {
    for a in attrs.iter() {
        if a.path.segments.len() != 1 || a.path.segments[0].name.value != "cfg" {
            continue;
        }
        let mut p = CfgParser {
            toks: &a.args,
            i: 0,
            err: String::new(),
        };
        let mut ok = p.pred(cfg);
        if p.err.len() == 0 && p.i != p.toks.len() {
            p.err = `unexpected ${tok_text(&p.toks[p.i])}`.to_string();
        }
        if p.err.len() > 0 {
            return (false, a.hash, p.err);
        }
        if !ok {
            return (false, 0, String::new());
        }
        ok = true;
    }
    (true, 0, String::new())
}

fn tok_text(t: &Token) -> String {
    if t.text.len() > 0 {
        t.text.to_string()
    } else {
        kind_name(t.kind).to_string()
    }
}

struct CfgParser {
    toks: &Vec<Token>,
    i: usize,
    err: String,
}

impl CfgParser {
    fn fail(&mut self, msg: String) -> bool {
        if self.err.len() == 0 {
            self.err = msg;
        }
        false
    }

    // name | name = "value" | all(p, ...) | any(p, ...) | not(p)
    fn pred(&mut self, cfg: &Config) -> bool {
        if self.i >= self.toks.len() || self.toks[self.i].kind != IDENT {
            return self.fail("expected a cfg option".to_string());
        }
        let name = self.toks[self.i].text;
        self.i += 1;
        let combinator = match name {
            "all" | "any" | "not" => true,
            _ => false,
        };
        if combinator {
            if self.i >= self.toks.len() || self.toks[self.i].kind != L_PAREN {
                return self.fail(`expected '(' after ${name}`.to_string());
            }
            self.i += 1;
            let mut vals: Vec<bool> = Vec::new();
            while self.i < self.toks.len() && self.toks[self.i].kind != R_PAREN {
                let v = self.pred(cfg);
                if self.err.len() > 0 {
                    return false;
                }
                vals.push(v);
                if self.i < self.toks.len() && self.toks[self.i].kind == COMMA {
                    self.i += 1;
                }
            }
            if self.i >= self.toks.len() {
                return self.fail("missing ')'".to_string());
            }
            self.i += 1;
            return match name {
                "all" => vals.iter().all(|v| *v),
                "any" => vals.iter().any(|v| *v),
                _ => {
                    if vals.len() != 1 {
                        return self.fail("not() takes exactly one predicate".to_string());
                    }
                    !vals[0]
                }
            };
        }
        if self.i < self.toks.len() && self.toks[self.i].kind == EQ {
            self.i += 1;
            if self.i >= self.toks.len() || self.toks[self.i].kind != STRING {
                return self.fail(`expected a string after ${name} =`.to_string());
            }
            let val = self.toks[self.i].text.trim_matches('"');
            self.i += 1;
            return match name {
                "target_os" => cfg.target_os == val,
                "target_arch" => cfg.target_arch == val,
                // No features are defined.
                "feature" => false,
                _ => self.fail(`unknown cfg option ${util::quote(name)}`.to_string()),
            };
        }
        match name {
            "test" => cfg.test,
            // One build mode (as Go): no debug-only code.
            "debug_assertions" => self.fail("unknown cfg option \"debug_assertions\" (navi has one build mode: overflow and assertions are always checked)".to_string()),
            _ => self.fail(`unknown cfg option ${util::quote(name)}`.to_string()),
        }
    }
}
