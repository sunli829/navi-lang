//! Derives (docs/derive.md). A crate's derives are expanded when it is
//! loaded: the built-in ones (crate::derive) unless the module imports a
//! derive of the same name. Those, and derives not built in, may be derive
//! macros (#[derive_macro] functions of another crate, in MACRO_NS): they
//! are found once imports are resolved, and each macro crate is built
//! into a program for the host (navi derive-build) that is sent all its
//! requests at once.
//!
//! Generated code is parsed as a file of its own (named after the type's
//! file, the derive and the type's position) whose positions map to the
//! user's file (source::Origin). A derive macro generates impls and its
//! own helper types and functions (no use, mod or extern items).
//!
//! The attributes of a struct or enum, its variants and its fields that
//! the compiler does not read must be taken by one of its derives
//! (#[derive_macro(X, attrs = [ns])], serde for Serialize/Deserialize).

use std::collections::HashMap;

use crate::{
    derive::{DeriveRef, builtin_attrs, info, macro_decl},
    resolve::*,
    syntax::{
        ast::*,
        parser, print,
        source::{File, Origin, Pos},
    },
    util,
};

/// Set by navi expand: each expansion is recorded in EXPANDED as (crate,
/// what, code).
pub static mut RECORD: bool = false;
pub static mut EXPANDED: Vec<(String, String, String)> = Vec::new();

/// A derive named in #[derive(...)]: where (the name's position in file),
/// the derive macro (None: built in) and the code it generated.
#[derive(Clone)]
pub struct DeriveUse {
    pub file: String,
    pub pos: Pos,
    pub def: Option<&mut Def>,
    pub what: String,
    pub code: String,
}

/// A struct's or enum's derives.
pub struct Pending {
    pub m: &mut Module,
    pub file: &File,
    pub it: Item,
    pub refs: Vec<DeriveRef>,
    /// The built-in derives expanded already.
    pub done: Vec<String>,
    pub krate: String,
}

// Attributes the compiler reads on structs and enums, and on variants and
// fields.
const TYPE_ATTRS: [&str; 10] = [
    "derive",
    "cfg",
    "doc",
    "repr",
    "allow",
    "warn",
    "deny",
    "deprecated",
    "must_use",
    "non_exhaustive",
];
const FIELD_ATTRS: [&str; 6] = ["cfg", "doc", "allow", "warn", "deny", "deprecated"];

fn attr_name(a: &Attr) -> String {
    print::path(a.path)
}

fn known(list: &[&str], name: &str) -> bool {
    for x in list.iter() {
        if *x == name {
            return true;
        }
    }
    false
}

// Each attribute of it the compiler does not read (with whether it is on
// the type itself).
fn odd_list(it: &Item) -> Vec<&Attr> {
    let mut out: Vec<&Attr> = Vec::new();
    let (attrs, fields, variants) = match it {
        Item::Struct(s) => (s.base.attrs.clone(), s.fields.clone(), Vec::new()),
        Item::Enum(e) => (e.base.attrs.clone(), Vec::new(), e.variants.clone()),
        _ => return out,
    };
    for a in attrs.iter() {
        if !known(&TYPE_ATTRS, attr_name(*a).as_str()) {
            out.push(*a);
        }
    }
    let mut fs = fields;
    for v in variants.iter() {
        for a in v.attrs.iter() {
            if !known(&FIELD_ATTRS, attr_name(*a).as_str()) {
                out.push(*a);
            }
        }
        for f in v.fields.iter() {
            fs.push(*f);
        }
    }
    for f in fs.iter() {
        for a in f.attrs.iter() {
            if !known(&FIELD_ATTRS, attr_name(*a).as_str()) {
                out.push(*a);
            }
        }
    }
    out
}

/// Whether it has attributes a derive must take.
pub fn odd_attrs(it: &Item) -> bool {
    odd_list(it).len() > 0
}

fn type_name(it: &Item) -> String {
    match it {
        Item::Struct(s) => s.name.value.clone(),
        Item::Enum(e) => e.name.value.clone(),
        _ => String::new(),
    }
}

// A request to a macro program.
struct Req {
    p: &mut Pending,
    name: String,
    at: Pos,
    def: Option<&mut Def>,
}

// A macro crate's macros (name, function path) and requests.
struct Group {
    krate: String,
    macros: Vec<(String, String)>,
    reqs: Vec<&mut Req>,
}

impl Resolver {
    /// Expands the derives of the crate just loaded: the built-in ones now,
    /// unless the module imports the name (expand_macros decides then).
    pub fn decide_derives(&mut self) {
        let mut list = self.derives.clone();
        self.derives = Vec::new();
        for p in list.iter_mut() {
            let mut now: Vec<String> = Vec::new();
            let mut later: Vec<DeriveRef> = Vec::new();
            for r in p.refs.iter() {
                let n = r.text();
                if r.segs.len() == 1
                    && crate::derive::expanded(n.as_str())
                    && !self.imports_name(p.m, n.as_str())
                {
                    now.push(n);
                } else {
                    later.push(DeriveRef {
                        segs: r.segs.clone(),
                    });
                }
            }
            let code = self.expand_builtin(p.m, p.file, &p.it, &now);
            for r in p.refs.iter() {
                let n = r.text();
                if now.contains(&n) {
                    self.use_of(p, r.last().pos, None, n.as_str(), code.clone());
                }
            }
            p.done = now;
            if later.len() > 0 {
                p.refs = later;
                self.pending.push(*p);
            } else {
                let claims = self.builtin_claims(*p);
                self.check_attrs(*p, &claims);
            }
        }
    }

    // Records a derive's use (DeriveUse).
    fn use_of(&mut self, p: &Pending, pos: Pos, def: Option<&mut Def>, name: &str, code: String) {
        let what = `derive ${name} for ${type_name(&p.it)}`.to_string();
        self.info.derive_uses.push(DeriveUse {
            file: p.file.name.clone(),
            pos,
            def,
            what,
            code,
        });
    }

    fn builtin_claims(&self, p: &Pending) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        for n in p.done.iter() {
            for a in builtin_attrs(n.as_str()).iter() {
                out.push(a.clone());
            }
        }
        out
    }

    // Whether module m imports name (not by a glob).
    fn imports_name(&self, m: &Module, name: &str) -> bool {
        for imp in self.imports.iter() {
            if imp.module.id == m.id && !imp.glob && imp.name == name {
                return true;
            }
        }
        false
    }

    // Reports the attributes of p's item that none of its derives take.
    fn check_attrs(&mut self, p: &Pending, claims: &Vec<String>) {
        let tn = type_name(&p.it);
        for a in odd_list(&p.it).iter() {
            let n = attr_name(*a);
            if claims.contains(&n) {
                continue;
            }
            self.errorf(
                Some(p.file),
                a.path.pos(),
                `unknown attribute ${n}: no derive of ${tn} takes it`.to_string(),
            );
        }
    }

    /// Finds the derive macro r names, as seen from m.
    fn find_macro(&self, m: &mut Module, r: &DeriveRef) -> Option<&mut Def> {
        let last = r.last();
        let res = if r.segs.len() == 1 {
            self.import_scope(m, last.value.as_str(), MACRO_NS)?
        } else {
            let mut prefix = r.segs.clone();
            prefix.pop();
            let src = match self.module_path(m, &prefix) {
                Ok(s) => s,
                Err(_) => return None,
            };
            let (b, st) = self.lookup_in(src, last.value.as_str(), MACRO_NS, m);
            if st != imports::FOUND {
                return None;
            }
            b?.res.clone()
        };
        if res.kind != RES_DEF {
            return None;
        }
        res.def
    }

    /// Expands the derives left for after imports: derive macros, and the
    /// built-in ones whose name a module imports but that no macro has.
    pub fn expand_macros(&mut self) {
        let mut list = self.pending.clone();
        self.pending = Vec::new();
        if list.len() == 0 {
            return;
        }
        let mut groups: Vec<&mut Group> = Vec::new();
        for p in list.iter_mut() {
            let mut claims = self.builtin_claims(*p);
            self.cfg.test = self.test_crate == p.krate;
            for r in p.refs.iter() {
                let n = r.text();
                let at = r.last().pos;
                let d = match self.find_macro(p.m, r) {
                    Some(d) => d,
                    None => {
                        if r.segs.len() == 1 && crate::derive::expanded(n.as_str()) {
                            let mut one: Vec<String> = Vec::new();
                            one.push(n.clone());
                            let code = self.expand_builtin(p.m, p.file, &p.it, &one);
                            self.use_of(*p, at, None, n.as_str(), code);
                            for a in builtin_attrs(n.as_str()).iter() {
                                claims.push(a.clone());
                            }
                        } else {
                            self.errorf(
                                Some(p.file),
                                at,
                                `cannot find derive macro ${n} in this scope`.to_string(),
                            );
                        }
                        continue;
                    }
                };
                let md = match &d.node {
                    Node::Item(Item::Fn(f)) => macro_decl(&f.base.attrs),
                    _ => None,
                };
                let md = match md {
                    Some(x) => x,
                    None => continue,
                };
                for a in md.attrs.iter() {
                    claims.push(a.clone());
                }
                // A crate read from its export data has the code there.
                if p.m.krate.preloaded {
                    let stored = `${p.file.name}[derive ${md.name.value} for ${type_name(&p.it)}@${p.it.pos()}]`.to_string();
                    if self.collect_stored(p.m, stored.as_str()) {
                        self.info.derive_uses.push(DeriveUse {
                            file: p.file.name.clone(),
                            pos: at,
                            def: Some(d),
                            what: `derive ${md.name.value} for ${type_name(&p.it)}`.to_string(),
                            code: String::new(),
                        });
                        continue;
                    }
                }
                if d.krate.name == p.krate {
                    self.errorf(Some(p.file), at, `derive macro ${n} is defined in this crate: a derive macro is used from other crates`.to_string());
                    continue;
                }
                let path = match self.macro_path(d) {
                    Some(x) => x,
                    None => {
                        self.errorf(Some(p.file), at, `derive macro ${n} is not public: its function and the modules to it must be pub`.to_string());
                        continue;
                    }
                };
                let mut g: Option<&mut Group> = None;
                for x in groups.iter() {
                    if x.krate == d.krate.name {
                        g = Some(*x);
                    }
                }
                let grp = match g {
                    Some(x) => x,
                    None => {
                        let x = &mut Group {
                            krate: d.krate.name.clone(),
                            macros: Vec::new(),
                            reqs: Vec::new(),
                        };
                        groups.push(x);
                        x
                    }
                };
                let mut have = false;
                for (mn, _) in grp.macros.iter() {
                    if *mn == md.name.value {
                        have = true;
                    }
                }
                if !have {
                    grp.macros.push((md.name.value.clone(), path));
                }
                grp.reqs.push(&mut Req {
                    p: *p,
                    name: md.name.value.clone(),
                    at,
                    def: Some(d),
                });
            }
            self.check_attrs(*p, &claims);
        }
        for g in groups.iter() {
            self.run_group(*g);
        }
    }

    // The path of macro function d from outside its crate, if public.
    fn macro_path(&self, d: &Def) -> Option<String> {
        if d.vis.restricted.is_some() {
            return None;
        }
        let mut x = module_of(d);
        while let Some(m) = x {
            if m.anonymous {
                return None;
            }
            if let Some(md) = m.def {
                if md.vis.restricted.is_some() && m.parent.is_some() {
                    return None;
                }
            }
            x = m.parent;
        }
        let m = module_of(d)?;
        Some(`${m.path()}::${d.name}`.to_string())
    }

    // Builds g's macro program, sends it the requests and collects what
    // they generate. Each request's answer is cached under the macro
    // crate's sources (and its dependencies'), the program's main and the
    // request: when all are, the program is neither built nor run.
    fn run_group(&mut self, g: &mut Group) {
        let (lines, src) = self.program_source(g);
        let gkey = self.group_key(g, lines.as_str(), src.as_str());
        let mut reqs: Vec<String> = Vec::new();
        let mut keys: Vec<String> = Vec::new();
        let mut answers: Vec<String> = Vec::new();
        let mut missing = false;
        for r in g.reqs.iter_mut() {
            let e = info::Enc::new();
            e.open();
            e.str(r.name.as_str());
            let mp = r.p.m.path();
            let module = match mp.find("::") {
                Some(i) => mp[i + 2..].to_string(),
                None => String::new(),
            };
            info::encode(e, &r.p.it, module.as_str(), r.p.file.src.as_str());
            e.close();
            let k = match &gkey {
                Some(gk) => {
                    crate::cache::hex(&crate::sha256::sum(`${gk}\n${e.s}`.to_string().as_bytes()))
                }
                None => String::new(),
            };
            let cached = if k.len() > 0 {
                answer_cache(k.as_str(), None)
            } else {
                None
            };
            match cached {
                Some(a) => answers.push(a),
                None => {
                    answers.push(String::new());
                    missing = true;
                }
            }
            reqs.push(e.s.clone());
            keys.push(k);
        }
        if missing {
            match self.run_program(g, lines, src, &reqs) {
                Ok(list) => {
                    let mut i = 0;
                    while i < list.len() && i < answers.len() {
                        answers[i] = list[i].clone();
                        if keys[i].len() > 0 {
                            answer_cache(keys[i].as_str(), Some(list[i].as_str()));
                        }
                        i += 1;
                    }
                }
                Err(msg) => {
                    for r in g.reqs.iter() {
                        self.errorf(Some(r.p.file), r.at, msg.clone());
                    }
                    return;
                }
            }
        }
        let mut i = 0;
        for r in g.reqs.iter_mut() {
            let a = answers[i].clone();
            i += 1;
            let mut d = Dec {
                b: a.as_bytes(),
                i: 0,
                bad: false,
            };
            if d.b.len() == 0 {
                self.errorf(
                    Some(r.p.file),
                    r.at,
                    `derive macro ${r.name}: the program's output is malformed`.to_string(),
                );
                continue;
            }
            let tag = d.b[0];
            d.i = 1;
            if tag == b'e' {
                let pos = d.int() as Pos;
                let msg = d.str();
                self.errorf(Some(r.p.file), if pos >= 0 { pos } else { r.at }, msg);
                continue;
            }
            let code = d.str();
            let mut spans: Vec<(Pos, Pos, Pos)> = Vec::new();
            d.byte(b'[');
            while !d.bad && d.i < d.b.len() && d.b[d.i] != b']' {
                let st = d.int() as Pos;
                let en = d.int() as Pos;
                let p = d.int() as Pos;
                spans.push((st, en, p));
            }
            d.byte(b']');
            if d.bad {
                self.errorf(
                    Some(r.p.file),
                    r.at,
                    `derive macro ${r.name}: the program's output is malformed`.to_string(),
                );
                continue;
            }
            self.collect_generated(*r, code, spans);
        }
    }

    // Builds and runs g's program on the requests: each one's answer (its
    // part of the output: o<code>[spans] or e<pos><message>).
    fn run_program(
        &self,
        g: &Group,
        lines: String,
        src: String,
        reqs: &Vec<String>,
    ) -> Result<Vec<String>, String> {
        let exe = self.macro_program(g, lines, src)?;
        let mut all = String::new();
        all.push('[');
        for r in reqs.iter() {
            all.push_str(r.as_str());
        }
        all.push(']');
        let req_file = `${exe}.req`.to_string();
        if let Err(err) = std::fs::write(req_file.as_str(), all.as_bytes()) {
            return Err(`derive macro: ${req_file}: ${err}`.to_string());
        }
        let out = std::process::Command::new(exe.as_str())
            .arg(req_file.as_str())
            .output();
        let _ = std::fs::remove_file(req_file.as_str());
        let out = match out {
            Ok(o) => o,
            Err(err) => return Err(`derive macro: running ${exe}: ${err}`.to_string()),
        };
        if !out.status.success() {
            let msg = String::from_utf8_lossy(out.stderr.as_slice())
                .trim()
                .to_string();
            return Err(`derive macro of crate ${g.krate} failed: ${msg}`.to_string());
        }
        let text = String::from_utf8_lossy(out.stdout.as_slice());
        let mut d = Dec {
            b: text.as_bytes(),
            i: 0,
            bad: false,
        };
        let mut list: Vec<String> = Vec::new();
        while !d.bad && d.i < d.b.len() {
            let start = d.i;
            let tag = d.b[d.i];
            d.i += 1;
            if tag == b'e' {
                d.int();
                d.str();
            } else if tag == b'o' {
                d.str();
                d.byte(b'[');
                while !d.bad && d.i < d.b.len() && d.b[d.i] != b']' {
                    d.int();
                    d.int();
                    d.int();
                }
                d.byte(b']');
            } else {
                d.bad = true;
            }
            if !d.bad {
                list.push(text[start..d.i].to_string());
            }
        }
        if d.bad || list.len() != reqs.len() {
            return Err(
                `derive macro of crate ${g.krate}: the program's output is malformed`.to_string(),
            );
        }
        Ok(list)
    }

    // The key of g's macros: each crate's (crate::libcache, as built for the
    // host) and the program's.
    fn group_key(&self, g: &Group, lines: &str, src: &str) -> Option<String> {
        crate::cache::dir()?;
        let need = self.program_crates(g);
        let mut keys: HashMap<String, String> = HashMap::new();
        let mut text = String::new();
        for s in self.specs.iter() {
            if !need.contains(&s.name) {
                continue;
            }
            let mut dep_keys: Vec<String> = Vec::new();
            for d in s.deps.iter() {
                let (alias, n) = match d.split_once('=') {
                    Some((a, n)) => (a.to_string(), n.to_string()),
                    None => (d.clone(), d.clone()),
                };
                dep_keys.push(
                    `${alias} ${keys.get(&n).map(|k| k.clone()).unwrap_or("-".to_string())}`
                        .to_string(),
                );
            }
            if s.name != "std" {
                if let Some(k) = keys.get(&"std".to_string()) {
                    dep_keys.push(`std ${k}`.to_string());
                }
            }
            dep_keys.sort();
            let k = crate::libcache::key(
                s.name.as_str(),
                util::path_clean(s.fs_root.as_str()).as_str(),
                "host",
                &dep_keys,
            )?;
            text.push_str(`${s.name} ${k}\n`.to_string().as_str());
            keys.insert(s.name.clone(), k);
        }
        text.push_str(lines);
        text.push_str(src);
        Some(crate::cache::hex(&crate::sha256::sum(text.as_bytes())))
    }

    // Parses what derive r generated and collects its impls into the
    // type's module.
    fn collect_generated(&mut self, r: &mut Req, code: String, spans: Vec<(Pos, Pos, Pos)>) {
        let p = r.p;
        let tn = type_name(&p.it);
        let what = `derive ${r.name} for ${tn}`.to_string();
        let name = `${p.file.name}[${what}@${p.it.pos()}]`.to_string();
        if RECORD {
            EXPANDED.push((p.krate.clone(), what.clone(), code.clone()));
        }
        self.info.derive_uses.push(DeriveUse {
            file: p.file.name.clone(),
            pos: r.at,
            def: r.def,
            what: what.clone(),
            code: code.clone(),
        });
        let origin = &Origin {
            file: p.file,
            at: r.at,
            spans,
            what,
        };
        let f = File::generated(name.as_str(), code, origin);
        let (sf, errs) = parser::parse_file(f);
        for d in errs.diags.iter() {
            self.errorf(Some(sf.file), d.pos, d.msg.clone());
        }
        self.check_absolute(r, sf);
        self.keep_generated(p.m, name.as_str(), sf);
        self.cfg.test = self.test_crate == p.krate;
        let mut files: HashMap<String, &SourceFile> = HashMap::new();
        for gi in sf.items.iter() {
            match gi {
                Item::Use(_) | Item::Mod(_) | Item::Extern(_) => {
                    self.errorf(Some(sf.file), gi.pos(), `derive macro ${r.name} generated a use, mod or extern item: only items of its own (impls, helper types and functions) are allowed`.to_string());
                }
                _ => self.collect_item(p.m, sf.file, gi, &mut files),
            }
        }
    }

    // Derived code names other crates from their roots (::std::fmt::Debug,
    // ::serde::Serialize, docs/derive.md): a crate's name starting a path
    // is an error, since the type's module may mean something else by it.
    fn check_absolute(&mut self, r: &Req, sf: &SourceFile) {
        let m = r.p.m;
        let errs = crate::syntax::source::Errors::new(sf.file);
        let toks = crate::syntax::lexer::tokenize(sf.file.src.as_str(), errs);
        // (Code the user wrote, as attribute values, is read where they
        // wrote it: not checked.)
        let spans = match sf.file.origin {
            Some(o) => o.spans.clone(),
            None => Vec::new(),
        };
        let mut i = 0;
        while i + 1 < toks.len() {
            let t = toks[i];
            let mut users = false;
            for (a, b, _) in spans.iter() {
                if t.pos >= *a && t.pos < *b {
                    users = true;
                }
            }
            if users {
                i += 1;
                continue;
            }
            if t.kind == crate::syntax::token::IDENT
                && toks[i + 1].kind == crate::syntax::token::PATH_SEP
                && (i == 0
                    || (toks[i - 1].kind != crate::syntax::token::PATH_SEP
                        && toks[i - 1].kind != crate::syntax::token::DOT))
            {
                let n = t.text;
                if n == "std" || m.krate.deps.contains_key(&n.to_string()) {
                    self.errorf(Some(sf.file), t.pos, `derive ${r.name} generated a path starting with the crate ${n}: derived code writes ::${n}::..., which means the crate whatever the type's module calls ${n}`.to_string());
                    return;
                }
            }
            i += 1;
        }
    }

    // The crates g's program is built from: the macro crate, what it
    // depends on, and std.
    fn program_crates(&self, g: &Group) -> Vec<String> {
        let mut need: Vec<String> = Vec::new();
        need.push(g.krate.clone());
        need.push("std".to_string());
        let mut i = self.specs.len();
        while i > 0 {
            i -= 1;
            let s = self.specs[i];
            if !need.contains(&s.name) {
                continue;
            }
            for d in s.deps.iter() {
                let n = match d.split_once('=') {
                    Some((_, n)) => n.to_string(),
                    None => d.clone(),
                };
                if !need.contains(&n) {
                    need.push(n);
                }
            }
        }
        need
    }

    // The specs (lines for navi derive-build, but the program's own) and
    // main of g's program.
    fn program_source(&self, g: &Group) -> (String, String) {
        let need = self.program_crates(g);
        let mut lines = String::new();
        for s in self.specs.iter() {
            if !need.contains(&s.name) {
                continue;
            }
            lines.push_str(
                `${s.name}\t${s.fs_root}\t${s.root}\t${s.dir}\t${s.deps.join(",")}\n`
                    .to_string()
                    .as_str(),
            );
        }
        let mut src = String::new();
        src.push_str("// Generated by navi: the program of a crate's derive macros.\n");
        src.push_str("fn main() {\n    std::derive::serve(|name: &str, t: &std::derive::TypeInfo| -> Result<std::derive::Code, std::derive::Error> {\n        match name {\n");
        for (n, path) in g.macros.iter() {
            src.push_str(
                `            ${util::quote(n.as_str())} => ${path}(t),\n`
                    .to_string()
                    .as_str(),
            );
        }
        src.push_str("            _ => Err(std::derive::Error::new(\"no such derive macro\")),\n        }\n    });\n}\n");
        (lines, src)
    }

    // The macro program of g (built by a navi derive-build of its own,
    // which uses the build cache).
    fn macro_program(&self, g: &Group, lines_in: String, src: String) -> Result<String, String> {
        let mut lines = lines_in;
        // main.navi lives where its path is the same each build (the cache
        // key names it).
        let tag = crate::cache::hex(&crate::sha256::sum(`${lines}${src}`.to_string().as_bytes()));
        let base = match crate::cache::dir() {
            Some(d) => util::path_join(d.as_str(), "derive"),
            None => util::path_join(
                std::env::temp_dir().to_str().unwrap_or("."),
                `navi-derive-${std::process::id()}`.to_string().as_str(),
            ),
        };
        let dir = util::path_join(base.as_str(), tag.as_str());
        if let Err(e) = std::fs::create_dir_all(dir.as_str()) {
            return Err(`derive macro: ${dir}: ${e}`.to_string());
        }
        let main = util::path_join(dir.as_str(), "main.navi");
        let same = match std::fs::read_to_string(main.as_str()) {
            Ok(s) => s == src,
            Err(_) => false,
        };
        if !same {
            if let Err(e) = std::fs::write(main.as_str(), src.as_bytes()) {
                return Err(`derive macro: ${main}: ${e}`.to_string());
            }
        }
        lines.push_str(
            `navi_derive_main\t${dir}\tmain.navi\t${dir}\t${g.krate}\n`
                .to_string()
                .as_str(),
        );
        let tmp = util::path_join(
            std::env::temp_dir().to_str().unwrap_or("."),
            `navi-derive-${std::process::id()}`.to_string().as_str(),
        );
        if let Err(e) = std::fs::create_dir_all(tmp.as_str()) {
            return Err(`derive macro: ${tmp}: ${e}`.to_string());
        }
        let specs = util::path_join(tmp.as_str(), `${g.krate}.specs`.to_string().as_str());
        if let Err(e) = std::fs::write(specs.as_str(), lines.as_bytes()) {
            return Err(`derive macro: ${specs}: ${e}`.to_string());
        }
        let exe = util::path_join(
            tmp.as_str(),
            `${g.krate}${crate::driver::host_exe_suffix()}`
                .to_string()
                .as_str(),
        );
        let navi = match crate::driver::exe_path() {
            Some(p) => p,
            None => return Err("derive macro: cannot find the navi executable".to_string()),
        };
        let st = std::process::Command::new(navi.as_str())
            .arg("derive-build")
            .arg(specs.as_str())
            .arg(exe.as_str())
            .status();
        let _ = std::fs::remove_file(specs.as_str());
        match st {
            Ok(s) => {
                if !s.success() {
                    return Err(
                        `the derive macros of crate ${g.krate} failed to build (errors above)`
                            .to_string(),
                    );
                }
            }
            Err(e) => return Err(`derive macro: running ${navi}: ${e}`.to_string()),
        }
        Ok(exe)
    }
}

// The cached answer of request key (or, given one, stores it).
fn answer_cache(key: &str, store: Option<&str>) -> Option<String> {
    let p = util::path_join(
        crate::cache::dir()?.as_str(),
        `${key}.dx`.to_string().as_str(),
    );
    match store {
        Some(a) => {
            let _ = std::fs::write(p.as_str(), a.as_bytes());
            None
        }
        None => std::fs::read_to_string(p.as_str()).ok(),
    }
}

// The macro program's output (std::derive::serve).
struct Dec {
    b: &[u8],
    i: usize,
    bad: bool,
}

impl Dec {
    fn byte(&mut self, c: u8) {
        if self.i < self.b.len() && self.b[self.i] == c {
            self.i += 1;
        } else {
            self.bad = true;
        }
    }

    fn str(&mut self) -> String {
        let mut n = 0usize;
        while self.i < self.b.len() && self.b[self.i] >= b'0' && self.b[self.i] <= b'9' {
            n = n * 10 + (self.b[self.i] - b'0') as usize;
            self.i += 1;
        }
        self.byte(b':');
        if self.bad || self.i + n > self.b.len() {
            self.bad = true;
            return String::new();
        }
        let s = String::from_utf8_lossy(&self.b[self.i..self.i + n]);
        self.i += n;
        s
    }

    fn int(&mut self) -> i64 {
        self.byte(b'i');
        let mut neg = false;
        if self.i < self.b.len() && self.b[self.i] == b'-' {
            neg = true;
            self.i += 1;
        }
        let mut n = 0i64;
        while self.i < self.b.len() && self.b[self.i] >= b'0' && self.b[self.i] <= b'9' {
            n = n * 10 + (self.b[self.i] - b'0') as i64;
            self.i += 1;
        }
        self.byte(b';');
        if neg { -n } else { n }
    }
}
