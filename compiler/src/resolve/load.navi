//! Loading a crate's files and collecting its items into modules.

use std::collections::HashMap;
use std::sync::Mutex;
use std::thread;
use crate::syntax::ast::*;
use crate::syntax::token::{IDENT, EQ, STRING, COMMA};
use crate::syntax::source::{File, Errors};
use crate::syntax::parser;
use crate::resolve::*;
use crate::util;

impl Resolver {
    /// Parses the crate's files and builds its module tree, following Rust's
    /// rules for `mod name;`.
    pub fn load(&mut self, c: &mut Crate, root: &str) {
        let mut files: HashMap<String, &SourceFile> = HashMap::new();
        self.parse_levels(c, root, util::path_dir(root).as_str(), &mut files);
        let root_file = match files.get(&root.to_string()) { Some(f) => *f, None => return };
        let rm = new_module(c, None, c.name.as_str());
        c.root = Some(rm);
        rm.dir = util::path_dir(root);
        let root_def = self.new_def(DEF_MOD, c.name.as_str(), Some(root_file.file), Node::None, 0, None, c);
        root_def.module = Some(rm);
        rm.def = Some(root_def);
        rm.file = Some(root_file.file);
        c.files.push(root_file);
        if self.cfg_enabled(root_file.file, &root_file.attrs) {
            self.collect_items(rm, root_file.file, &root_file.items, &mut files);
        }
    }

    // parse_tree parses p and every file reachable through mod declarations.
    fn parse_tree(&mut self, c: &mut Crate, p: &str, dir: &str, files: &mut HashMap<String, &SourceFile>) {
        let full = util::path_join(c.fs_root.as_str(), p);
        let src = match crate::cache::read_source(full.as_str()) {
            Ok(s) => s,
            Err(e) => {
                self.errorf(None, 0, `crate ${c.name}: open ${p}: no such file or directory`.to_string());
                return;
            }
        };
        crate::cache::note(full.as_str(), &src);
        let f = File::new(util::path_join(c.dir.as_str(), p).as_str(), src);
        let (sf, errs) = parser::parse_file(f);
        for d in errs.diags.iter() { self.errorf(Some(sf.file), d.pos, d.msg.clone()); }
        files.insert(p.to_string(), sf);
        if !self.cfg_enabled_quiet(&sf.attrs) { return; }
        let mut found: Vec<(String, String)> = Vec::new();
        self.find_mod_files(c, &sf.items, dir, &mut found);
        for (child, child_dir) in found.iter() {
            if !files.contains_key(child) {
                self.parse_tree(c, child.as_str(), child_dir.as_str(), files);
            }
        }
    }

    // Parses root, then the files its mod declarations name, and so on, a
    // level at a time: the files of a level are parsed on several threads.
    // Each file numbers its nodes from its own range of ids, given in order
    // and sized by the file, so the ids do not depend on the threads.
    fn parse_levels(&mut self, c: &mut Crate, root: &str, dir: &str, files: &mut HashMap<String, &SourceFile>) {
        let mut level: Vec<(String, String)> = Vec::new();
        level.push((root.to_string(), dir.to_string()));
        let mut queued: HashMap<String, bool> = HashMap::new();
        queued.insert(root.to_string(), true);
        while level.len() > 0 {
            let mut srcs: Vec<&File> = Vec::new();
            let mut paths: Vec<(String, String)> = Vec::new();
            let mut bases: Vec<u32> = Vec::new();
            for (p, d) in level.iter() {
                let full = util::path_join(c.fs_root.as_str(), p.as_str());
                let src = match crate::cache::read_source(full.as_str()) {
                    Ok(s) => s,
                    Err(_) => {
                        self.errorf(None, 0, `crate ${c.name}: open ${p}: no such file or directory`.to_string());
                        continue;
                    }
                };
                crate::cache::note(full.as_str(), &src);
                let base = next_id();
                set_next_id(base + id_bound(src.len()));
                srcs.push(File::new(util::path_join(c.dir.as_str(), p.as_str()).as_str(), src));
                paths.push((p.clone(), d.clone()));
                bases.push(base);
            }
            let parsed = parse_all(&srcs, &bases);
            let mut next: Vec<(String, String)> = Vec::new();
            let mut i = 0;
            while i < parsed.len() {
                let (sf, errs, end) = parsed[i];
                if end > bases[i] + id_bound(srcs[i].src.len()) { panic("parse: more nodes than ids reserved for the file"); }
                for d in errs.diags.iter() { self.errorf(Some(sf.file), d.pos, d.msg.clone()); }
                let (p, d) = &paths[i];
                files.insert(p.clone(), sf);
                i += 1;
                if !self.cfg_enabled_quiet(&sf.attrs) { continue; }
                let mut found: Vec<(String, String)> = Vec::new();
                self.find_mod_files(c, &sf.items, d.as_str(), &mut found);
                for (child, child_dir) in found.iter() {
                    if queued.contains_key(child) { continue; }
                    queued.insert(child.clone(), true);
                    next.push((child.clone(), child_dir.clone()));
                }
            }
            level = next;
        }
    }

    fn find_mod_files(&self, c: &Crate, items: &Vec<Item>, dir: &str, found: &mut Vec<(String, String)>) {
        for it in items.iter() {
            if let Item::Mod(m) = it {
                if !self.cfg_enabled_quiet(&m.base.attrs) { continue; }
                if m.inline {
                    self.find_mod_files(c, &m.items, util::path_join(dir, m.name.value.as_str()).as_str(), found);
                    continue;
                }
                let (p, _) = mod_file(c, dir, m.name.value.as_str());
                if p.len() > 0 {
                    let cd = child_dir(p.as_str(), false);
                    found.push((p, cd));
                }
            }
        }
    }

    pub fn collect_items(&mut self, m: &mut Module, file: &File, items: &Vec<Item>, files: &mut HashMap<String, &SourceFile>) {
        m.file = Some(file);
        for it in items.iter() { self.collect_item(m, file, it, files); }
    }

    fn define(&mut self, m: &mut Module, file: &File, it: &Item, kind: DefKind, name: &Name, vis: &Visibility, nss: &[Namespace]) -> &mut Def {
        let d = self.new_def(kind, name.value.as_str(), Some(file), Node::Item(it.clone()), name.pos, m.def, m.krate);
        d.vis = vis.clone();
        for ns in nss.iter() { self.bind(m, file, *ns, name, res_def(d), vis.clone()); }
        d
    }

    pub fn collect_item(&mut self, m: &mut Module, file: &File, it: &Item, files: &mut HashMap<String, &SourceFile>) {
        let base = it.base();
        if !self.cfg_enabled(file, &base.attrs) { return; }
        m.items.push(it.clone());
        let c = m.krate;
        let vis = self.visibility(m, file, base);
        match it {
            Item::Fn(f) => { self.define(m, file, it, DEF_FN, f.name, &vis, &[VALUE_NS]); }
            Item::Struct(s) => {
                if s.kind == StructKind::Named {
                    self.define(m, file, it, DEF_STRUCT, s.name, &vis, &[TYPE_NS]);
                } else {
                    let d = self.define(m, file, it, DEF_STRUCT, s.name, &vis, &[TYPE_NS, VALUE_NS]);
                    d.ctor = true;
                }
            }
            Item::Enum(e) => {
                let d = self.define(m, file, it, DEF_ENUM, e.name, &vis, &[TYPE_NS]);
                let em = new_module(c, Some(m), e.name.value.as_str());
                em.is_enum = true;
                em.def = Some(d);
                d.module = Some(em);
                for v in e.variants.iter() {
                    let vd = self.new_def(DEF_VARIANT, v.name.value.as_str(), Some(file), Node::Variant(*v), v.name.pos, Some(d), c);
                    vd.vis = vis.clone();
                    self.bind(em, file, TYPE_NS, v.name, res_def(vd), public());
                    if v.kind != StructKind::Named {
                        vd.ctor = true;
                        self.bind(em, file, VALUE_NS, v.name, res_def(vd), public());
                    }
                }
            }
            Item::Trait(t) => {
                let d = self.define(m, file, it, DEF_TRAIT, t.name, &vis, &[TYPE_NS]);
                self.collect_assoc(m, d, file, &t.items);
            }
            Item::TypeAlias(t) => { self.define(m, file, it, DEF_TYPE_ALIAS, t.name, &vis, &[TYPE_NS]); }
            Item::Const(k) => {
                if k.name.value == "_" {
                    self.new_def(DEF_CONST, "_", Some(file), Node::Item(it.clone()), k.name.pos, m.def, c);
                } else {
                    self.define(m, file, it, DEF_CONST, k.name, &vis, &[VALUE_NS]);
                }
            }
            Item::Static(s) => { self.define(m, file, it, DEF_STATIC, s.name, &vis, &[VALUE_NS]); }
            Item::Impl(im) => {
                let d = self.new_def(DEF_IMPL, "", Some(file), Node::Item(it.clone()), it.pos(), m.def, c);
                d.vis = public();
                self.collect_assoc(m, d, file, &im.items);
            }
            Item::Extern(eb) => {
                let lib = self.link_attr(file, &eb.base.attrs);
                for ei in eb.items.iter() {
                    if !self.cfg_enabled(file, &ei.base().attrs) { continue; }
                    let evis = self.visibility(m, file, ei.base());
                    match ei {
                        Item::Fn(f) => {
                            let d = self.new_def(DEF_EXTERN_FN, f.name.value.as_str(), Some(file), Node::Item(ei.clone()), f.name.pos, m.def, c);
                            d.vis = evis.clone();
                            d.nonblocking = attr_named(&eb.base.attrs, "nonblocking") || attr_named(&f.base.attrs, "nonblocking");
                            d.link = lib.clone();
                            self.bind(m, file, VALUE_NS, f.name, res_def(d), evis);
                        }
                        Item::Static(s) => {
                            let d = self.new_def(DEF_EXTERN_STATIC, s.name.value.as_str(), Some(file), Node::Item(ei.clone()), s.name.pos, m.def, c);
                            d.vis = evis.clone();
                            self.bind(m, file, VALUE_NS, s.name, res_def(d), evis);
                        }
                        _ => {}
                    }
                }
            }
            Item::Mod(md) => {
                let d = self.define(m, file, it, DEF_MOD, md.name, &vis, &[TYPE_NS]);
                let child = new_module(c, Some(m), md.name.value.as_str());
                child.def = Some(d);
                d.module = Some(child);
                if md.inline {
                    child.dir = util::path_join(m.dir.as_str(), md.name.value.as_str());
                    self.collect_items(child, file, &md.items, files);
                    return;
                }
                let (p, candidates) = mod_file(c, m.dir.as_str(), md.name.value.as_str());
                if p.len() == 0 {
                    if candidates.len() == 2 && file_exists(c, candidates[0].as_str()) {
                        self.errorf(Some(file), md.name.pos, `module ${md.name.value} is defined in both ${candidates[0]} and ${candidates[1]}`.to_string());
                    } else {
                        self.errorf(Some(file), md.name.pos, `file not found for module ${md.name.value} (looked for ${candidates[0]} and ${candidates[1]})`.to_string());
                    }
                    return;
                }
                let pf = match files.get(&p) { Some(f) => *f, None => return };
                child.dir = child_dir(p.as_str(), false);
                child.file = Some(pf.file);
                c.files.push(pf);
                if self.cfg_enabled(pf.file, &pf.attrs) {
                    self.collect_items(child, pf.file, &pf.items, files);
                }
            }
            Item::Use(u) => {
                self.collect_use(m, file, u.tree, &Vec::new(), &vis);
            }
        }
    }

    // collect_assoc creates defs for the items of an impl or trait.
    fn collect_assoc(&mut self, m: &mut Module, parent: &mut Def, file: &File, items: &Vec<Item>) {
        for it in items.iter() {
            let base = it.base();
            if !self.cfg_enabled(file, &base.attrs) { continue; }
            let mut vis = public();
            if parent.kind == DEF_IMPL && !is_trait_impl(parent) { vis = self.visibility(m, file, base); }
            let d = match it {
                Item::Fn(f) => self.new_def(DEF_ASSOC_FN, f.name.value.as_str(), Some(file), Node::Item(it.clone()), f.name.pos, Some(parent), parent.krate),
                Item::Const(k) => self.new_def(DEF_ASSOC_CONST, k.name.value.as_str(), Some(file), Node::Item(it.clone()), k.name.pos, Some(parent), parent.krate),
                Item::TypeAlias(t) => self.new_def(DEF_ASSOC_TYPE, t.name.value.as_str(), Some(file), Node::Item(it.clone()), t.name.pos, Some(parent), parent.krate),
                _ => {
                    self.errorf(Some(file), it.pos(), `only functions, constants and types are allowed in ${def_kind_name(parent.kind)} blocks`.to_string());
                    continue;
                }
            };
            d.vis = vis;
        }
    }

    pub fn visibility(&mut self, m: &mut Module, file: &File, base: &ItemBase) -> Visibility {
        let named = m.nearest_named();
        match base.vis {
            Vis::Pub => public(),
            Vis::Crate => Visibility { restricted: m.krate.root },
            Vis::Super => match named.parent {
                None => {
                    self.errorf(Some(file), base.start, "pub(super) is not allowed in the crate root".to_string());
                    Visibility { restricted: Some(named) }
                }
                Some(p) => Visibility { restricted: Some(p.nearest_named()) },
            },
            Vis::Private => Visibility { restricted: Some(m) },
        }
    }

    pub fn bind(&mut self, m: &mut Module, file: &File, ns: Namespace, name: &Name, res: Res, vis: Visibility) {
        if m.bindings[ns].contains_key(&name.value) {
            self.errorf(Some(file), name.pos, `the name ${name.value} is defined multiple times in ${m.path()}`.to_string());
            return;
        }
        m.bindings[ns].insert(name.value.clone(), &mut Binding { res, vis, import: None });
    }

    // collect_use flattens a use tree into imports.
    fn collect_use(&mut self, m: &mut Module, file: &File, t: &UseTree, prefix: &Vec<&Name>, vis: &Visibility) {
        let mut segs: Vec<&Name> = prefix.clone();
        if let Some(p) = t.prefix {
            for s in p.segments.iter() { segs.push(s.name); }
        }
        if t.glob {
            if segs.len() == 0 {
                let rp = m.krate.root.unwrap().def.unwrap().pos;
                self.errorf(Some(file), rp, "glob import needs a path".to_string());
                return;
            }
            let imp = &mut Import { module: m, file, segs: segs.clone(), name: String::new(), pos: segs[0].pos, glob: true, vis: vis.clone(), done: false };
            self.imports.push(imp);
            m.glob_srcs.push(imp);
            return;
        }
        if t.group {
            for ch in t.children.iter() { self.collect_use(m, file, *ch, &segs, vis); }
            return;
        }
        let mut last = segs[segs.len() - 1];
        if last.value == "self" {
            if segs.len() == 1 {
                self.errorf(Some(file), last.pos, "self import can only appear in a group with a non-empty prefix".to_string());
                return;
            }
            segs.pop();
            last = segs[segs.len() - 1];
        }
        let name = match t.alias { Some(a) => a.value.clone(), None => last.value.clone() };
        self.imports.push(&mut Import { module: m, file, segs, name, pos: last.pos, glob: false, vis: vis.clone(), done: false });
    }
}

pub fn is_trait_impl(d: &Def) -> bool {
    match &d.node {
        Node::Item(Item::Impl(im)) => im.trait_path.is_some(),
        _ => false,
    }
}

fn file_exists(c: &Crate, p: &str) -> bool {
    std::path::Path::new(util::path_join(c.fs_root.as_str(), p).as_str()).exists()
}

// mod_file returns the file holding module name declared in a module whose
// child directory is dir, or "" and the candidates if none or both exist.
fn mod_file(c: &Crate, dir: &str, name: &str) -> (String, Vec<String>) {
    let a = util::path_join(dir, `${name}.navi`.to_string().as_str());
    let b = util::path_join(util::path_join(dir, name).as_str(), "mod.navi");
    let ea = file_exists(c, a.as_str());
    let eb = file_exists(c, b.as_str());
    let mut cands = Vec::new();
    if ea && eb {
        cands.push(a);
        cands.push(b);
        return (String::new(), cands);
    }
    if ea { return (a, cands); }
    if eb { return (b, cands); }
    cands.push(a);
    cands.push(b);
    (String::new(), cands)
}

// child_dir is the directory for modules declared in the file at p.
fn child_dir(p: &str, is_root: bool) -> String {
    if is_root || util::path_base(p) == "mod.navi" { return util::path_dir(p); }
    let base = util::path_base(p);
    let stem = &base[0..base.len() - 5];
    util::path_join(util::path_dir(p).as_str(), stem)
}

// The ids a file of n bytes may use (a node per byte is far more than any
// file has).
fn id_bound(n: usize) -> u32 { (2 * n + 64) as u32 }

// Parses srcs[i] with ids from bases[i], on as many threads as can run;
// (file, errors, the id after its last) in order.
fn parse_all(srcs: &Vec<&File>, bases: &Vec<u32>) -> Vec<(&SourceFile, &mut Errors, u32)> {
    let n = srcs.len();
    let mut nw = match thread::available_parallelism() { Ok(k) => k, Err(_) => 1 };
    if nw > n { nw = n; }
    let next = &std::sync::atomic::AtomicUsize::new(0);
    let mut done: Vec<(usize, &SourceFile, &mut Errors, u32)> = Vec::new();
    if nw <= 1 {
        done = parse_some(srcs, bases, next);
    } else {
        let mut hs = Vec::new();
        let mut k = 0;
        while k < nw {
            hs.push(thread::spawn(|| parse_some(srcs, bases, next)));
            k += 1;
        }
        for h in hs.iter() {
            for d in h.join().unwrap().iter() { done.push(*d); }
        }
    }
    let mut out: Vec<Option<(&SourceFile, &mut Errors, u32)>> = Vec::new();
    for _ in srcs.iter() { out.push(None); }
    for (i, sf, e, end) in done.iter() { out[*i] = Some((*sf, *e, *end)); }
    let mut res = Vec::new();
    for o in out.iter() { res.push(o.unwrap()); }
    res
}

fn parse_some(srcs: &Vec<&File>, bases: &Vec<u32>, next: &std::sync::atomic::AtomicUsize) -> Vec<(usize, &SourceFile, &mut Errors, u32)> {
    let mut res = Vec::new();
    loop {
        let i = next.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
        if i >= srcs.len() { return res; }
        let ids = &mut IdGen { next: bases[i] };
        let (sf, errs) = parser::parse_file_ids(srcs[i], ids);
        res.push((i, sf, errs, ids.next));
    }
}

// Whether attrs has #[name].
fn attr_named(attrs: &Vec<&Attr>, name: &str) -> bool {
    for a in attrs.iter() {
        if a.path.segments.len() == 1 && a.path.segments[0].name.value == name { return true; }
    }
    false
}

impl Resolver {
    /// The library of an extern block: #[link(name = "...", kind = "dylib"
    /// or "framework")] as "kind:name"; "" without one or for the C library
    /// itself (name "c"). navi links no static libraries.
    fn link_attr(&mut self, file: &File, attrs: &Vec<&Attr>) -> String {
        for a in attrs.iter() {
            if a.path.segments.len() != 1 || a.path.segments[0].name.value != "link" { continue; }
            let t = &a.args;
            let mut name = String::new();
            let mut kind = "dylib".to_string();
            let mut i = 0;
            while i < t.len() {
                if i + 2 >= t.len() || t[i].kind != IDENT || t[i + 1].kind != EQ || t[i + 2].kind != STRING {
                    self.errorf(Some(file), a.hash, "malformed #[link]: expected name = \"...\"".to_string());
                    return String::new();
                }
                let v = t[i + 2].text.trim_matches('"').to_string();
                match t[i].text {
                    "name" => name = v,
                    "kind" => kind = v,
                    _ => {
                        self.errorf(Some(file), a.hash, `unknown #[link] option ${t[i].text}`.to_string());
                        return String::new();
                    }
                }
                i += 3;
                if i < t.len() && t[i].kind == COMMA { i += 1; }
            }
            if name.len() == 0 {
                self.errorf(Some(file), a.hash, "#[link] needs a name".to_string());
                return String::new();
            }
            if kind == "static" {
                self.errorf(Some(file), a.hash, "navi links only dynamic libraries: kind = \"static\" is not supported".to_string());
                return String::new();
            }
            if kind != "dylib" && kind != "framework" {
                self.errorf(Some(file), a.hash, `unknown #[link] kind ${util::quote(kind.as_str())} (dylib or framework)`.to_string());
                return String::new();
            }
            if name == "c" && kind == "dylib" { return String::new(); }
            return `${kind}:${name}`.to_string();
        }
        String::new()
    }
}
