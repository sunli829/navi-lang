//! navi doc: HTML documentation of a crate, its dependencies and std (as
//! rustdoc's), and doctests (docs/doc.md).

pub mod markdown;
pub mod model;
pub mod render;
pub mod page;
pub mod doctest;

use crate::driver;
use crate::resolve;
use crate::util;

const USAGE: &str = "usage: navi doc [path] [-p name] [--no-deps] [--open] [-o dir]";

/// navi doc [path] [-p name] [--no-deps] [--open] [-o dir]
pub fn doc_command(args: &Vec<String>) -> i32 {
    let mut path = ".".to_string();
    let mut package = String::new();
    let mut no_deps = false;
    let mut open = false;
    let mut out = String::new();
    let mut i = 0;
    while i < args.len() {
        let a = args[i].as_str();
        match a {
            "--no-deps" => no_deps = true,
            "--open" => open = true,
            "-p" | "-o" if i + 1 < args.len() => {
                if a == "-p" { package = args[i + 1].clone(); } else { out = args[i + 1].clone(); }
                i += 1;
            }
            "-h" | "--help" => {
                println(USAGE);
                return 0;
            }
            _ => {
                if a.starts_with("-") {
                    eprintln(`navi doc: unknown flag ${a}\n${USAGE}`.to_string());
                    return 2;
                }
                path = a.to_string();
            }
        }
        i += 1;
    }
    let units = match driver::units(path.as_str(), package.as_str()) {
        Ok(u) => u,
        Err(e) => {
            eprintln(e);
            return 1;
        }
    };
    let t0 = driver::now_nanos();
    let mut code = 0;
    for u in units.iter() {
        let mut names: Vec<String> = Vec::new();
        if no_deps {
            names.push(u.name.clone());
        } else {
            for s in u.specs.iter() { names.push(s.name.clone()); }
        }
        let mut cfg = driver::host_config();
        cfg.test = false;
        let (res, errs) = resolve::resolve(cfg, &u.specs);
        if driver::report(&errs) {
            code = 1;
            continue;
        }
        let m = model::Model::new(res, &names);
        let dir = if out.len() > 0 { util::arg_path(out.as_str()) } else { util::path_join(u.out_dir.as_str(), "doc") };
        page::BROKEN = Vec::new();
        let n = match page::write_all(m, dir.as_str()) {
            Ok(n) => n,
            Err(e) => {
                eprintln(`navi doc: ${e}`.to_string());
                code = 1;
                continue;
            }
        };
        for (f, line, text) in page::BROKEN.iter() {
            eprintln(`warning: unresolved link to \`${text}\`\n  --> ${f}:${line}`.to_string());
        }
        let index = util::path_join(dir.as_str(), `${u.name}/index.html`.to_string().as_str());
        let ms = (driver::now_nanos() - t0) / 1000000;
        eprintln(`Documented ${names.len()} crate${if names.len() == 1 { "" } else { "s" }} (${n} pages) in ${ms}ms: ${index}`.to_string());
        if open { open_page(index.as_str()); }
    }
    code
}

// Opens a page in the browser (open, xdg-open, start).
fn open_page(path: &str) {
    let mut cmd = std::process::Command::new(opener());
    cmd.arg(path);
    let _ = cmd.status();
}

#[cfg(target_os = "macos")]
fn opener() -> &str { "open" }

#[cfg(target_os = "windows")]
fn opener() -> &str { "explorer" }

#[cfg(not(target_os = "macos"))]
#[cfg(not(target_os = "windows"))]
fn opener() -> &str { "xdg-open" }
