//! navi doc: HTML documentation of a crate, its dependencies and std (as
//! rustdoc's), and doctests (docs/doc.md).

pub mod coverage;
pub mod doctest;
pub mod markdown;
pub mod model;
pub mod page;
pub mod render;

use crate::{driver, resolve, util};

/// navi doc [path] [-p name] [--no-deps] [--open] [-o dir]
pub fn doc_command(a: &crate::cli::DocArgs) -> i32 {
    let path = a.path.clone().unwrap_or(".".to_string());
    let package = a.p.clone().unwrap_or(String::new());
    let no_deps = a.no_deps;
    let open = a.open;
    let out = a.o.clone().unwrap_or(String::new());
    let units = match driver::units(path.as_str(), package.as_str()) {
        Ok(u) => u,
        Err(e) => {
            eprintln(e);
            return 1;
        }
    };
    let t0 = driver::now_nanos();
    let mut code = 0;
    for u in units.iter() {
        let mut names: Vec<String> = Vec::new();
        if no_deps {
            names.push(u.name.clone());
        } else {
            for s in u.specs.iter() {
                names.push(s.name.clone());
            }
        }
        let mut cfg = driver::host_config();
        cfg.test = false;
        let (res, errs) = resolve::resolve(cfg, &u.specs);
        if driver::report(&errs) {
            code = 1;
            continue;
        }
        let m = model::Model::new(res, &names);
        if a.show_coverage || a.show_missing {
            print(coverage::report(m, u.name.as_str(), a.show_missing));
            continue;
        }
        let dir = if out.len() > 0 {
            util::arg_path(out.as_str())
        } else {
            util::path_join(u.out_dir.as_str(), "doc")
        };
        page::BROKEN = Vec::new();
        page::WARN_CRATE = u.name.clone();
        let n = match page::write_all(m, dir.as_str()) {
            Ok(n) => n,
            Err(e) => {
                eprintln(`navi doc: ${e}`.to_string());
                code = 1;
                continue;
            }
        };
        for (f, line, text) in page::BROKEN.iter() {
            eprintln(`warning: unresolved link to \`${text}\`\n  --> ${f}:${line}`.to_string());
        }
        let index = util::path_join(dir.as_str(), `${u.name}/index.html`.to_string().as_str());
        let ms = (driver::now_nanos() - t0) / 1000000;
        eprintln(`Documented ${names.len()} crate${if names.len() == 1 { "" } else { "s" }} (${n} pages) in ${ms}ms: ${index}`.to_string());
        if open {
            open_page(index.as_str());
        }
    }
    code
}

// Opens a page in the browser (open, xdg-open, start).
fn open_page(path: &str) {
    let mut cmd = std::process::Command::new(opener());
    cmd.arg(path);
    let _ = cmd.status();
}

#[cfg(target_os = "macos")]
fn opener() -> &str {
    "open"
}

#[cfg(target_os = "windows")]
fn opener() -> &str {
    "explorer"
}

#[cfg(not(target_os = "macos"))]
#[cfg(not(target_os = "windows"))]
fn opener() -> &str {
    "xdg-open"
}
