//! What is documented and where (as rustdoc): the items a path of pub
//! modules reaches, at their definition; those reached only through
//! `pub use`, at the re-export; impls by the type and the trait.

use std::collections::HashMap;
use crate::syntax::ast::*;
use crate::syntax::source::{File, Pos};
use crate::resolve::{self, Def, Module, Crate, Binding, TYPE_NS, VALUE_NS, RES_DEF, RES_PRIM};
use crate::util;

/// A page: a module, an item, or a primitive type.
pub struct Page {
    /// "mod", "struct", "enum", "trait", "fn", "type", "constant",
    /// "static", "derive", "primitive" (rustdoc's file name prefixes).
    pub kind: String,
    pub name: String,
    /// The directory of the module it is in (its own for a module), from
    /// the documentation's root: "std/collections".
    pub dir: String,
    /// The module path it is documented at: std::collections::HashMap.
    pub path: String,
    pub def: Option<&mut Def>,
    pub item: Option<Item>,
    /// A module: its resolver module (for an item: the module defining it,
    /// the scope of its documentation's links).
    pub module: Option<&mut Module>,
    pub file: Option<&File>,
    pub krate: String,
    /// A module's pages and re-exports (`pub use` lines, as HTML).
    pub children: Vec<&mut Page>,
    pub reexports: Vec<(&mut Binding, String)>,
    /// (For links to it from elsewhere.)
    pub parent: Option<&mut Page>,
}

impl Page {
    /// Its file from the documentation's root.
    pub fn url(&self) -> String {
        if self.kind == "mod" { return `${self.dir}/index.html`.to_string(); }
        `${self.dir}/${self.kind}.${self.name}.html`.to_string()
    }
}

/// An impl and where it is.
#[derive(Clone)]
pub struct ImplRef {
    pub decl: &mut ImplDecl,
    pub module: &mut Module,
    pub file: &File,
    pub krate: String,
    /// The trait it implements (None: inherent).
    pub trait_def: Option<&mut Def>,
    /// The type it is for (None: a primitive or a type parameter).
    pub self_def: Option<&mut Def>,
}

pub struct Model {
    pub info: &mut resolve::Info,
    /// The crates documented, and the root pages.
    pub crates: Vec<&mut Crate>,
    pub roots: Vec<&mut Page>,
    pub pages: Vec<&mut Page>,
    /// Where each documented definition's page is (by Def id).
    pub loc: HashMap<u32, &mut Page>,
    /// Impls by the type (Def id), primitives by name, trait impls by trait.
    pub impls: HashMap<u32, Vec<ImplRef>>,
    pub prim_impls: HashMap<String, Vec<ImplRef>>,
    pub implementors: HashMap<u32, Vec<ImplRef>>,
}

pub fn kind_of(it: &Item) -> &str {
    match it {
        Item::Fn(_) => "fn",
        Item::Struct(_) => "struct",
        Item::Enum(_) => "enum",
        Item::Trait(_) => "trait",
        Item::TypeAlias(_) => "type",
        Item::Const(_) => "constant",
        Item::Static(_) => "static",
        Item::Mod(_) => "mod",
        _ => "",
    }
}

fn def_kind_page(d: &Def) -> &str {
    match d.kind {
        resolve::DEF_MOD => "mod",
        resolve::DEF_STRUCT => "struct",
        resolve::DEF_ENUM => "enum",
        resolve::DEF_TRAIT => "trait",
        resolve::DEF_TYPE_ALIAS => "type",
        resolve::DEF_FN => "fn",
        resolve::DEF_EXTERN_FN => "fn",
        resolve::DEF_CONST => "constant",
        resolve::DEF_STATIC => "static",
        resolve::DEF_EXTERN_STATIC => "static",
        _ => "",
    }
}

/// Whether attrs hold #[doc(hidden)].
pub fn hidden(attrs: &Vec<&Attr>) -> bool {
    for a in attrs.iter() {
        if a.path.segments.len() == 1 && a.path.segments[0].name.value == "doc" {
            for t in a.args.iter() {
                if t.text == "hidden" { return true; }
            }
        }
    }
    false
}

/// Whether attrs hold attribute name (#[name] or #[name(...)]); its
/// arguments' text.
pub fn attr_args(attrs: &Vec<&Attr>, name: &str) -> Option<String> {
    for a in attrs.iter() {
        if a.path.segments.len() == 1 && a.path.segments[0].name.value == name {
            let mut s = String::new();
            for t in a.args.iter() { s.push_str(t.text); }
            return Some(s);
        }
    }
    None
}

impl Model {
    /// The model of crates (by name; their dependencies are linked to
    /// when they are documented too).
    pub fn new(info: &mut resolve::Info, names: &Vec<String>) -> &mut Model {
        let m = &mut Model { info, crates: Vec::new(), roots: Vec::new(), pages: Vec::new(), loc: HashMap::new(), impls: HashMap::new(),
            prim_impls: HashMap::new(), implementors: HashMap::new() };
        for c in info.crates.iter() {
            if names.contains(&c.name) { m.crates.push(*c); }
        }
        // Definitions reached by pub modules, then re-exports (which may
        // inline what has no page yet), then impls.
        for c in m.crates.iter() {
            let root = match c.root { Some(r) => r, None => continue };
            let p = m.module_page(root, c.name.clone(), c.name.clone(), None, c.name.as_str());
            m.roots.push(p);
        }
        let mut i = 0;
        while i < m.pages.len() {
            let p = m.pages[i];
            if p.kind == "mod" { m.reexports(p); }
            i += 1;
        }
        for c in info.crates.iter() {
            if let Some(root) = c.root { m.collect_impls(root, *c); }
        }
        // Primitive pages (std's impls on them).
        let mut prims: Vec<String> = m.prim_impls.keys().map(|k: &String| -> String { k.clone() }).collect();
        prims.sort();
        let mut k = 0;
        while k < m.roots.len() {
            let r = m.roots[k];
            k += 1;
            if r.krate != "std" { continue; }
            for name in prims.iter() {
                let pg = &mut Page { kind: "primitive".to_string(), name: name.clone(), dir: r.dir.clone(), path: name.clone(), def: None, item: None,
                    module: r.module, file: None, krate: "std".to_string(), children: Vec::new(), reexports: Vec::new(), parent: Some(r) };
                r.children.push(pg);
                m.pages.push(pg);
            }
        }
        m
    }

    // A module's page at dir (path: its module path) and its items'.
    fn module_page(&mut self, rm: &mut Module, dir: String, path: String, parent: Option<&mut Page>, krate: &str) -> &mut Page {
        let item = match rm.def { Some(d) => match &d.node { resolve::Node::Item(it) => Some(it.clone()), _ => None }, None => None };
        let p = &mut Page { kind: "mod".to_string(), name: rm.name.clone(), dir: dir.clone(), path: path.clone(), def: rm.def, item, module: Some(rm),
            file: rm.file, krate: krate.to_string(), children: Vec::new(), reexports: Vec::new(), parent };
        if let Some(d) = rm.def { self.loc.insert(d.id, p); }
        self.pages.push(p);
        for it in rm.items.iter() {
            let b = it.base();
            if b.vis != Vis::Pub || hidden(&b.attrs) { continue; }
            match it {
                Item::Mod(md) => {
                    let mut child: Option<&mut Module> = None;
                    for c in rm.children.iter() {
                        if c.name == md.name.value && !c.anonymous { child = Some(*c); }
                    }
                    if let Some(c) = child {
                        let cp = self.module_page(c, `${dir}/${c.name}`.to_string(), `${path}::${c.name}`.to_string(), Some(p), krate);
                        p.children.push(cp);
                    }
                }
                Item::Extern(eb) => {
                    for x in eb.items.iter() {
                        let xb = x.base();
                        if xb.vis != Vis::Pub || hidden(&xb.attrs) { continue; }
                        self.leaf(p, x.clone(), rm, krate);
                    }
                }
                Item::Use(_) => {}
                Item::Impl(_) => {}
                _ => self.leaf(p, it.clone(), rm, krate),
            }
        }
        p
    }

    // An item's page in module page p.
    fn leaf(&mut self, p: &mut Page, it: Item, rm: &mut Module, krate: &str) {
        let def = match self.info.def_of.get(&it.id()) { Some(d) => Some(*d), None => None };
        let mut kind = kind_of(&it).to_string();
        if let Item::Fn(f) = &it {
            if attr_args(&f.base.attrs, "derive_macro").is_some() { kind = "derive".to_string(); }
        }
        if kind.len() == 0 { return; }
        let name = match def {
            Some(d) => d.name.clone(),
            None => return,
        };
        let name = if kind == "derive" {
            match &it { Item::Fn(f) => attr_args(&f.base.attrs, "derive_macro").unwrap_or(name).trim().to_string(), _ => name }
        } else {
            name
        };
        if let Some(d) = def {
            if self.loc.contains_key(&d.id) { return; }
        }
        let pg = &mut Page { kind, name: name.clone(), dir: p.dir.clone(), path: `${p.path}::${name}`.to_string(), def, item: Some(it), module: Some(rm),
            file: match def { Some(d) => d.file, None => None }, krate: krate.to_string(), children: Vec::new(), reexports: Vec::new(), parent: Some(p) };
        if let Some(d) = def { self.loc.insert(d.id, pg); }
        p.children.push(pg);
        self.pages.push(pg);
    }

    // A module page's pub use bindings: a link to a documented item, else
    // the item inlined here.
    fn reexports(&mut self, p: &mut Page) {
        let rm = match p.module { Some(m) => m, None => return };
        let mut cands: Vec<(String, &mut Binding)> = Vec::new();
        let mut ns = 0;
        while ns < 2 {
            let n = if ns == 0 { TYPE_NS } else { VALUE_NS };
            for (name, b) in rm.bindings[n].iter() {
                if b.import.is_some() { cands.push((name.clone(), *b)); }
            }
            for (name, bs) in rm.globs[n].iter() {
                if bs.len() == 1 && !rm.bindings[n].contains_key(name) { cands.push((name.clone(), bs[0])); }
            }
            ns += 1;
        }
        cands.sort_by(|a: &(String, &mut Binding), b: &(String, &mut Binding)| -> std::cmp::Ordering { a.0.cmp(&b.0) });
        let mut seen: HashMap<u32, bool> = HashMap::new();
        for (name, b) in cands.iter() {
            if b.vis.restricted.is_some() || b.res.kind != RES_DEF { continue; }
            let d = match b.res.def { Some(d) => d, None => continue };
            if seen.contains_key(&d.id) { continue; }
            seen.insert(d.id, true);
            if name.starts_with("_") && name.len() == 1 { continue; }
            let kind = def_kind_page(d);
            if kind.len() == 0 { continue; }
            if self.loc.contains_key(&d.id) {
                // (A glob of a public module: its items are documented there.)
                let glob = match b.import { Some(imp) => imp.glob, None => false };
                if !glob { p.reexports.push((*b, name.clone())); }
                continue;
            }
            // Inlined: hidden items stay hidden.
            if let resolve::Node::Item(it) = &d.node {
                if hidden(&it.base().attrs) { continue; }
            }
            if d.kind == resolve::DEF_MOD {
                if let Some(m) = d.module {
                    let cp = self.module_page(m, `${p.dir}/${name}`.to_string(), `${p.path}::${name}`.to_string(), Some(p), p.krate.as_str());
                    cp.name = name.clone();
                    p.children.push(cp);
                }
                continue;
            }
            let it = match &d.node { resolve::Node::Item(it) => it.clone(), _ => continue };
            let home = self.home_module(d);
            let before = p.children.len();
            self.leaf(p, it, home, p.krate.as_str());
            // (Under the name it is re-exported as.)
            if p.children.len() > before {
                let pg = p.children[p.children.len() - 1];
                if pg.kind != "derive" {
                    pg.name = name.clone();
                    pg.path = `${p.path}::${name}`.to_string();
                }
            }
        }
    }

    // The module a definition is in (the scope of its docs' links).
    pub fn home_module(&self, d: &Def) -> &mut Module {
        let mut x = d.parent;
        while let Some(pd) = x {
            if let Some(m) = pd.module { return m; }
            x = pd.parent;
        }
        // (A crate's root.)
        d.krate.root.unwrap()
    }

    // The impls of module rm and the modules in it.
    fn collect_impls(&mut self, rm: &mut Module, c: &mut Crate) {
        for it in rm.items.iter() {
            if let Item::Impl(d) = it {
                if hidden(&d.base.attrs) { continue; }
                let file = match self.info.def_of.get(&d.base.id) { Some(def) => def.file, None => rm.file };
                let file = match file { Some(f) => f, None => continue };
                let trait_def = match d.trait_path {
                    Some(tp) => match self.info.paths.get(&tp.id) { Some(r) => if r.kind == RES_DEF { r.def } else { None }, None => None },
                    None => None,
                };
                let (self_def, prim) = self.self_of(d.ty);
                let r = ImplRef { decl: *d, module: rm, file, krate: c.name.clone(), trait_def, self_def };
                match self_def {
                    Some(sd) => {
                        if !self.impls.contains_key(&sd.id) { self.impls.insert(sd.id, Vec::new()); }
                        self.impls.get_mut(&sd.id).unwrap().push(r.clone());
                    }
                    None => {
                        if prim.len() > 0 && c.is_std {
                            if !self.prim_impls.contains_key(&prim) { self.prim_impls.insert(prim.clone(), Vec::new()); }
                            self.prim_impls.get_mut(&prim).unwrap().push(r.clone());
                        }
                    }
                }
                if let Some(td) = trait_def {
                    if !self.implementors.contains_key(&td.id) { self.implementors.insert(td.id, Vec::new()); }
                    self.implementors.get_mut(&td.id).unwrap().push(r);
                }
            }
        }
        for ch in rm.children.iter() { self.collect_impls(*ch, c); }
    }

    // The definition an impl's type names, or the primitive's name.
    fn self_of(&self, t: &Type) -> (Option<&mut Def>, String) {
        match &t.kind {
            TypeKind::Path(p) => match self.info.paths.get(&p.id) {
                Some(r) => {
                    if r.kind == RES_DEF && r.rest.len() == 0 {
                        match r.def {
                            Some(d) => if d.kind == resolve::DEF_TYPE_PARAM { (None, String::new()) } else { (Some(d), String::new()) },
                            None => (None, String::new()),
                        }
                    } else if r.kind == RES_PRIM {
                        (None, r.prim.clone())
                    } else {
                        (None, String::new())
                    }
                }
                None => (None, String::new()),
            },
            TypeKind::Slice { .. } => (None, "slice".to_string()),
            TypeKind::Array { .. } => (None, "array".to_string()),
            TypeKind::Tuple { elems, .. } => (None, if elems.len() == 0 { "unit".to_string() } else { "tuple".to_string() }),
            TypeKind::Ref { .. } => (None, "reference".to_string()),
            TypeKind::Ptr { .. } => (None, "pointer".to_string()),
            TypeKind::Fn { .. } => (None, "fn".to_string()),
            TypeKind::Never(_) => (None, "never".to_string()),
            _ => (None, String::new()),
        }
    }

    /// The page of a definition (a struct's for a method or field: then the
    /// anchor in it).
    pub fn url_of(&self, d: &Def) -> Option<String> {
        if let Some(p) = self.loc.get(&d.id) { return Some(p.url()); }
        let parent = match d.parent { Some(pd) => pd, None => return None };
        let anchor = match d.kind {
            resolve::DEF_VARIANT => `variant.${d.name}`.to_string(),
            resolve::DEF_ASSOC_FN => `method.${d.name}`.to_string(),
            resolve::DEF_ASSOC_CONST => `associatedconstant.${d.name}`.to_string(),
            resolve::DEF_ASSOC_TYPE => `associatedtype.${d.name}`.to_string(),
            _ => return None,
        };
        // A variant's enum; an associated item's trait, or its impl's type.
        let owner = if parent.kind == resolve::DEF_IMPL {
            match &parent.node {
                resolve::Node::Item(Item::Impl(im)) => match self.self_of(im.ty).0 { Some(sd) => sd, None => return None },
                _ => return None,
            }
        } else {
            parent
        };
        match self.loc.get(&owner.id) {
            Some(p) => Some(`${p.url()}#${anchor}`.to_string()),
            None => None,
        }
    }

    /// An intra-doc link's target from module scope (self_def: what Self
    /// names), its URL from the root; None when it names nothing documented.
    pub fn link(&self, scope: Option<&mut Module>, self_def: Option<&mut Def>, text: &str) -> Option<String> {
        // (Disambiguators and call parentheses.)
        let mut t = text.trim();
        if let Some(k) = t.find('@') { t = &t[k + 1..]; }
        let t = t.trim_end_matches("()").trim_end_matches('!');
        // (Generic arguments: Vec::<T>::new, Vec<T>.)
        let mut clean = String::new();
        let mut depth = 0;
        for ch in t.chars() {
            if ch == '<' { depth += 1; continue; }
            if ch == '>' { if depth > 0 { depth -= 1; } continue; }
            if depth == 0 { clean.push(ch); }
        }
        let clean = clean.replace("::::", "::");
        let segs: Vec<&str> = clean.trim_end_matches(':').split("::").collect();
        if segs.len() == 0 || segs[0].len() == 0 && segs.len() < 2 { return None; }
        let scope = match scope { Some(s) => s, None => return None };
        // The first segment.
        let mut i = 1;
        let mut cur: Option<&mut Def> = None;
        let mut cur_mod: Option<&mut Module> = None;
        let first = segs[0];
        if first == "" {
            // ::name: a crate's root.
            if segs.len() < 2 { return None; }
            cur_mod = self.crate_root(scope, segs[1]);
            i = 2;
        } else if first == "crate" {
            cur_mod = scope.krate.root;
        } else if first == "self" {
            cur_mod = Some(scope);
        } else if first == "super" {
            cur_mod = scope.parent;
        } else if first == "Self" {
            cur = self_def;
        } else {
            match self.lookup_scoped(scope, first) {
                Some(d) => {
                    if d.kind == resolve::DEF_MOD { cur_mod = d.module; } else { cur = Some(d); }
                }
                None => {
                    cur_mod = self.crate_root(scope, first);
                    if cur_mod.is_none() { return None; }
                }
            }
        }
        while i < segs.len() {
            let s = segs[i];
            i += 1;
            if let Some(m) = cur_mod {
                if s == "super" {
                    cur_mod = m.parent;
                    continue;
                }
                let b = match m.lookup(s, TYPE_NS) {
                    Some(b) => Some(b),
                    None => m.lookup(s, VALUE_NS),
                };
                let d = match b { Some(b) => match b.res.def { Some(d) => d, None => return None }, None => return None };
                if d.kind == resolve::DEF_MOD {
                    cur_mod = d.module;
                    cur = None;
                } else {
                    cur_mod = None;
                    cur = Some(d);
                }
                continue;
            }
            // A member of a type: a variant, a method, an associated item.
            let d = match cur { Some(d) => d, None => return None };
            let page = match self.loc.get(&d.id) { Some(p) => p.url(), None => return None };
            let anchor = self.member_anchor(d, s)?;
            if i < segs.len() { return None; }
            return Some(`${page}#${anchor}`.to_string());
        }
        if let Some(d) = cur { return self.url_of(d); }
        if let Some(m) = cur_mod {
            if let Some(d) = m.def { return self.url_of(d); }
            // (A crate's root module has no definition.)
            for r in self.roots.iter() {
                if let Some(rm) = r.module {
                    if rm.id == m.id { return Some(r.url()); }
                }
            }
        }
        None
    }

    // A crate's root by name, as seen from module m (its dependencies,
    // itself, std).
    fn crate_root(&self, m: &Module, name: &str) -> Option<&mut Module> {
        if m.krate.name == name { return m.krate.root; }
        if let Some(c) = m.krate.deps.get(&name.to_string()) { return c.root; }
        for c in self.info.crates.iter() {
            if c.name == name && (c.is_std || name == "std") { return c.root; }
        }
        None
    }

    // name in module m or the modules enclosing its blocks, then the
    // prelude.
    fn lookup_scoped(&self, m: &mut Module, name: &str) -> Option<&mut Def> {
        let mut x: Option<&mut Module> = Some(m);
        while let Some(mm) = x {
            for ns in [TYPE_NS, VALUE_NS].iter() {
                if let Some(b) = mm.lookup(name, *ns) {
                    if let Some(d) = b.res.def { return Some(d); }
                }
            }
            if !mm.anonymous { break; }
            x = mm.parent;
        }
        if let Some(p) = m.krate.prelude {
            for ns in [TYPE_NS, VALUE_NS].iter() {
                if let Some(b) = p.lookup(name, *ns) {
                    if let Some(d) = b.res.def { return Some(d); }
                }
            }
        }
        None
    }

    // The anchor of member name of type (or trait) d on its page.
    fn member_anchor(&self, d: &Def, name: &str) -> Option<String> {
        if let resolve::Node::Item(it) = &d.node {
            match it {
                Item::Enum(e) => {
                    for v in e.variants.iter() {
                        if v.name.value == name { return Some(`variant.${name}`.to_string()); }
                    }
                }
                Item::Struct(s) => {
                    for f in s.fields.iter() {
                        if let Some(n) = f.name {
                            if n.value == name { return Some(`structfield.${name}`.to_string()); }
                        }
                    }
                }
                Item::Trait(t) => {
                    for x in t.items.iter() {
                        if let Some(a) = member_kind_anchor(x, name) { return Some(a); }
                    }
                }
                _ => {}
            }
        }
        if let Some(rs) = self.impls.get(&d.id) {
            for r in rs.iter() {
                for x in r.decl.items.iter() {
                    if let Some(a) = member_kind_anchor(x, name) { return Some(a); }
                }
            }
        }
        None
    }
}

fn member_kind_anchor(x: &Item, name: &str) -> Option<String> {
    match x {
        Item::Fn(f) => if f.name.value == name { Some(if f.body.is_none() { `tymethod.${name}`.to_string() } else { `method.${name}`.to_string() }) } else { None },
        Item::Const(c) => if c.name.value == name { Some(`associatedconstant.${name}`.to_string()) } else { None },
        Item::TypeAlias(t) => if t.name.value == name { Some(`associatedtype.${name}`.to_string()) } else { None },
        _ => None,
    }
}

/// The documentation (/// above it, //! at the top of a module's file) of
/// what starts at pos in file.
pub fn docs_at(file: Option<&File>, pos: Pos) -> String {
    match file {
        Some(f) => if f.origin.is_some() || pos < 0 { String::new() } else { util::doc_comment(f.src.as_str(), pos as usize) },
        None => String::new(),
    }
}

/// A module's documentation: /// on its declaration, then //! in its file.
pub fn module_docs(p: &Page) -> String {
    let mut out = String::new();
    if let Some(it) = &p.item {
        if let Some(d) = p.def {
            out = docs_at(d.file, it.pos());
        }
    }
    if let Some(m) = p.module {
        if let Some(f) = m.file {
            let inner = inner_docs(f.src.as_str());
            if inner.len() > 0 {
                if out.len() > 0 { out.push_str("\n\n"); }
                out.push_str(inner.as_str());
            }
        }
    }
    out
}

// The //! comments at the top of a module's file.
fn inner_docs(src: &str) -> String {
    let mut lines: Vec<String> = Vec::new();
    for l in src.lines() {
        let t = l.trim();
        if t.starts_with("//!") {
            let x = &t[3..];
            lines.push((if x.starts_with(" ") { &x[1..] } else { x }).to_string());
        } else if t.len() > 0 {
            break;
        }
    }
    lines.join("\n")
}
