//! navi doc --show-coverage (as rustdoc's): how much of a crate's public
//! API is documented and has examples, by file; --show-missing lists what
//! has no documentation.

use std::collections::HashMap;
use crate::syntax::ast::*;
use crate::syntax::source::{File, Pos};
use crate::resolve::Def;
use crate::doc::model::{Model, Page, docs_at, module_docs, hidden};
use crate::doc::markdown;

struct Count {
    total: usize,
    documented: usize,
    examples: usize,
}

struct Cov {
    by_file: HashMap<String, &mut Count>,
    missing: Vec<(String, u32, String)>,
    root: String,
}

impl Cov {
    fn note(&mut self, file: Option<&File>, pos: Pos, what: String, docs: &str) {
        let f = match file {
            Some(f) => f,
            None => return,
        };
        // (Derived code is documented by what it derives from.)
        if f.origin.is_some() { return; }
        let name = if self.root.len() > 0 && f.name.starts_with(self.root.as_str()) { f.name[self.root.len()..].trim_start_matches('/').to_string() } else { f.name.clone() };
        if !self.by_file.contains_key(&name) { self.by_file.insert(name.clone(), &mut Count { total: 0, documented: 0, examples: 0 }); }
        let c = *self.by_file.get(&name).unwrap();
        c.total += 1;
        if docs.trim().len() > 0 {
            c.documented += 1;
            if markdown::code_blocks(docs).len() > 0 { c.examples += 1; }
        } else {
            self.missing.push((name, f.line_of(pos), what));
        }
    }
}

/// The table (and with missing, the list) for crate krate.
pub fn report(m: &Model, krate: &str, missing: bool) -> String {
    let mut root = String::new();
    for c in m.crates.iter() {
        if c.name == krate { root = c.fs_root.clone(); }
    }
    let cov = &mut Cov { by_file: HashMap::new(), missing: Vec::new(), root };
    for p in m.pages.iter() {
        if p.krate != krate { continue; }
        // (A page reached twice, by re-exports, counts once: at its file.)
        page(m, cov, p);
    }
    let mut files: Vec<String> = cov.by_file.keys().map(|k: &String| -> String { k.clone() }).collect();
    files.sort();
    let mut out = String::new();
    let line = "+-------------------------------------------------+------------+------------+------------+------------+\n";
    out.push_str(line);
    out.push_str("| File                                            | Documented | Percentage |   Examples | Percentage |\n");
    out.push_str(line);
    let (mut t, mut d, mut e) = (0, 0, 0);
    for f in files.iter() {
        let c = *cov.by_file.get(f).unwrap();
        out.push_str(row(f.as_str(), c.documented, c.total, c.examples).as_str());
        t += c.total;
        d += c.documented;
        e += c.examples;
    }
    out.push_str(line);
    out.push_str(row("Total", d, t, e).as_str());
    out.push_str(line);
    if missing {
        cov.missing.sort_by(|a: &(String, u32, String), b: &(String, u32, String)| -> std::cmp::Ordering { (a.0.clone(), a.1).cmp(&(b.0.clone(), b.1)) });
        for (f, l, w) in cov.missing.iter() { out.push_str(`${f}:${l}: no documentation: ${w}\n`.to_string().as_str()); }
    }
    out
}

fn row(name: &str, documented: usize, total: usize, examples: usize) -> String {
    let pct = |n: usize| -> String { if total == 0 { "0.0%".to_string() } else { `${(n as f64) * 100.0 / (total as f64):.1}%`.to_string() } };
    let mut n = name.to_string();
    if n.chars().count() > 47 { n = `...${&n[n.len() - 44..]}`.to_string(); }
    `| ${n:<47} | ${documented:>10} | ${pct(documented):>10} | ${examples:>10} | ${pct(examples):>10} |\n`.to_string()
}

fn page(m: &Model, cov: &mut Cov, p: &Page) {
    if p.kind == "primitive" {
        // std's inherent impls on it (str, i32, ...).
        if let Some(rs) = m.prim_impls.get(&p.name) {
            for r in rs.iter() {
                if r.decl.trait_path.is_some() { continue; }
                for x in r.decl.items.iter() {
                    if x.base().vis != Vis::Pub || hidden(&x.base().attrs) { continue; }
                    let n = member_name(x);
                    if n.len() == 0 { continue; }
                    cov.note(Some(r.file), x.pos(), `${p.name}::${n}`.to_string(), docs_at(Some(r.file), x.pos()).as_str());
                }
            }
        }
        return;
    }
    if p.kind == "mod" {
        let file = match p.def { Some(d) => d.file, None => match p.module { Some(rm) => rm.file, None => None } };
        let pos = match &p.item { Some(it) => it.pos(), None => 0 };
        cov.note(file, pos, `mod ${p.path}`.to_string(), module_docs(p).as_str());
        return;
    }
    let (it, d) = match (&p.item, p.def) { (Some(it), Some(d)) => (it, d), _ => return };
    // (Inlined at a re-export: counted where it is defined.)
    if !same_def_page(m, d, p) { return; }
    let file = d.file;
    cov.note(file, it.pos(), `${p.kind} ${p.path}`.to_string(), docs_at(file, it.pos()).as_str());
    match it {
        Item::Struct(s) => {
            for f in s.fields.iter() {
                if f.vis != Vis::Pub || hidden(&f.attrs) { continue; }
                let n = match f.name { Some(n) => n, None => continue };
                cov.note(file, n.pos, `field ${p.path}::${n.value}`.to_string(), docs_at(file, n.pos).as_str());
            }
        }
        Item::Enum(e) => {
            for v in e.variants.iter() {
                if hidden(&v.attrs) { continue; }
                cov.note(file, v.name.pos, `variant ${p.path}::${v.name.value}`.to_string(), docs_at(file, v.name.pos).as_str());
            }
        }
        Item::Trait(t) => {
            for x in t.items.iter() {
                if hidden(&x.base().attrs) { continue; }
                let n = member_name(x);
                if n.len() == 0 { continue; }
                cov.note(file, x.pos(), `${p.path}::${n}`.to_string(), docs_at(file, x.pos()).as_str());
            }
        }
        _ => {}
    }
    // Inherent impls' pub items (in this crate).
    if let Some(rs) = m.impls.get(&d.id) {
        for r in rs.iter() {
            if r.decl.trait_path.is_some() || r.krate != p.krate { continue; }
            for x in r.decl.items.iter() {
                if x.base().vis != Vis::Pub || hidden(&x.base().attrs) { continue; }
                let n = member_name(x);
                if n.len() == 0 { continue; }
                cov.note(Some(r.file), x.pos(), `${p.path}::${n}`.to_string(), docs_at(Some(r.file), x.pos()).as_str());
            }
        }
    }
}

// Whether p is d's own page (not one inlined elsewhere).
fn same_def_page(m: &Model, d: &Def, p: &Page) -> bool {
    match m.loc.get(&d.id) {
        Some(q) => q.url() == p.url(),
        None => true,
    }
}

fn member_name(x: &Item) -> String {
    match x {
        Item::Fn(f) => f.name.value.clone(),
        Item::Const(c) => c.name.value.clone(),
        Item::TypeAlias(a) => a.name.value.clone(),
        _ => String::new(),
    }
}
