//! Paths, types, generics and bounds (rustfmt's types.rs).

use crate::syntax::token::*;
use crate::syntax::ast::*;
use crate::fmt::ctx::*;
use crate::fmt::lists::*;
use crate::fmt::overflow::*;

impl Ctx {
    /// A path; with :: before generic arguments in expressions.
    pub fn path(&self, p: &Path, expr_ctx: bool, sh: Shape) -> Option<String> {
        let mut out = String::new();
        if let Some(q) = p.qself {
            out.push('<');
            out.push_str(self.typ(q.ty, sh.clone())?.as_str());
            if let Some(tp) = q.trait_path {
                out.push_str(" as ");
                out = self.path_segments(false, out, &tp.segments, sh.sub_width(3)?)?;
            }
            out.push_str(">::");
        }
        self.path_segments(expr_ctx, out, &p.segments, sh)
    }

    fn path_segments(&self, expr_ctx: bool, buf0: String, segs: &Vec<&PathSegment>, sh0: Shape) -> Option<String> {
        let sh = sh0.visual_indent(0);
        let mut buf = buf0;
        let mut first = true;
        for seg in segs.iter() {
            if !first { buf.push_str("::"); }
            first = false;
            let extra = extra_offset(buf.as_str(), &sh);
            let nsh = sh.shrink_left(extra)?;
            let name = self.ident(seg.name);
            let mut out = name.clone();
            if let Some(ga) = seg.args {
                if ga.args.len() > 0 || ga.bindings.len() > 0 {
                    let gsh = nsh.shrink_left(name.len())?;
                    let g = self.generic_args(ga, gsh)?;
                    if expr_ctx { out.push_str("::"); }
                    out.push_str(g.as_str());
                }
            }
            buf.push_str(out.as_str());
        }
        Some(buf)
    }

    pub fn generic_args(&self, ga: &GenericArgs, sh: Shape) -> Option<String> {
        let mut items = Vec::new();
        for t in ga.args.iter() { items.push(Node::T(*t)); }
        for b in ga.bindings.iter() { items.push(Node::B(*b)); }
        self.with_angles("", &items, sh, ga.lt)
    }

    pub fn typ(&self, t: &Type, sh: Shape) -> Option<String> {
        match &t.kind {
            TypeKind::Path(p) => self.path(*p, false, sh),
            TypeKind::Ref { is_mut, elem, .. } => {
                let mut out = s("&");
                if *is_mut { out.push_str("mut "); }
                let budget = sub_opt3(sh.width, out.len())?;
                let a = sh.align + out.len();
                let es = self.elem_type(*elem, Shape { width: budget, block: sh.block, align: a, offset: a })?;
                out.push_str(es.as_str());
                Some(out)
            }
            TypeKind::Ptr { is_mut, elem, .. } => {
                let prefix = if *is_mut { "*mut " } else { "*const " };
                let s2 = sh.offset_left(prefix.len())?;
                let es = self.elem_type(*elem, s2)?;
                Some(cat(prefix, es.as_str()))
            }
            TypeKind::Slice { elem, .. } => {
                let budget = sub_opt3(sh.width, 4)?;
                let a = sh.align + 1;
                let es = self.typ(*elem, Shape { width: budget, block: sh.block, align: a, offset: a })?;
                Some(cat3("[", es.as_str(), "]"))
            }
            TypeKind::Array { elem, len, .. } => self.pair(&Node::T(*elem), &Node::E(*len), "[", "; ", "]", sh, false),
            TypeKind::Tuple { lparen, elems } => {
                let mut items = Vec::new();
                for e in elems.iter() { items.push(Node::T(*e)); }
                let force = if elems.len() == 1 { Some(Trailing::Always) } else { None };
                self.with_parens("", &items, sh, *lparen, FN_CALL_WIDTH, force)
            }
            TypeKind::Fn { start, abi, params, result } => {
                let mut out = String::new();
                if abi.len() > 0 {
                    out.push_str("extern \"");
                    out.push_str(abi.as_str());
                    out.push_str("\" ");
                }
                out.push_str("fn");
                let fsh = sh.offset_left(out.len())?;
                let open = self.find(*start, L_PAREN);
                let rest = self.fn_type(params, *result, open, fsh)?;
                out.push_str(rest.as_str());
                Some(out)
            }
            TypeKind::Dyn { bounds, .. } => {
                let b = self.bounds(bounds, sh.offset_left(4)?)?;
                Some(cat("dyn ", b.as_str()))
            }
            TypeKind::Impl { bounds, .. } => {
                let b = self.bounds(bounds, sh.offset_left(5)?)?;
                Some(cat("impl ", b.as_str()))
            }
            TypeKind::Never(_) => Some(s("!")),
            TypeKind::Infer(_) => Some(s("_")),
            TypeKind::Const(x) => self.expr(*x, sh),
        }
    }

    // A type after & or *: dyn A + B needs parentheses there.
    fn elem_type(&self, t: &Type, sh: Shape) -> Option<String> {
        let paren = match &t.kind {
            TypeKind::Dyn { bounds, .. } => bounds.len() > 1,
            TypeKind::Impl { bounds, .. } => bounds.len() > 1,
            _ => false,
        };
        if !paren { return self.typ(t, sh); }
        let inner = self.typ(t, sh.offset_left(1)?.sub_width(1)?)?;
        Some(cat3("(", inner.as_str(), ")"))
    }

    fn fn_type(&self, params: &Vec<&Type>, result: Option<&Type>, open: crate::syntax::source::Pos, sh: Shape) -> Option<String> {
        let output = match result {
            Some(r) => {
                let ts = self.typ(r, sh.offset_left(4)?)?;
                cat(" -> ", ts.as_str())
            }
            None => String::new(),
        };
        let list_shape = Shape::indented(sh.block + TAB).with_align(sh.align);
        let close = self.close_end(open) - 1;
        let mut spans = Vec::new();
        for p in params.iter() { spans.push((p.pos(), self.type_end(*p))); }
        let mut items = self.itemize(&spans, open + 1, close);
        let mut i = 0;
        for p in params.iter() {
            items[i].item = self.typ(*p, list_shape.clone());
            i += 1;
        }
        let tactic = if output.contains('\n') { Tactic::Vertical } else {
            definitive_tactic(&items, ListTactic::HorizontalVertical, 2, sub(sh.width, 2 + output.len()))
        };
        let list_str = if params.len() == 0 { String::new() } else {
            let mut f = ListFormatting::new(list_shape.clone());
            f.tactic = tactic.clone();
            f.trailing = Trailing::Vertical;
            f.ends_with_newline = tactic != Tactic::Horizontal;
            f.preserve_newline = true;
            write_list(&items, &f)?
        };
        let args = if tactic == Tactic::Horizontal || params.len() == 0 {
            cat3("(", list_str.as_str(), ")")
        } else {
            let mut a = s("(");
            a.push_str(list_shape.nl_indent().as_str());
            a.push_str(list_str.as_str());
            a.push_str(sh.block_only().nl_indent().as_str());
            a.push(')');
            a
        };
        if output.len() == 0 || last_line_width(args.as_str()) + first_line_width(output.as_str()) <= sh.width {
            return Some(cat(args.as_str(), output.as_str()));
        }
        let mut out = args;
        out.push('\n');
        out.push_str(list_shape.indent_str().as_str());
        out.push_str(output.trim_start());
        Some(out)
    }

    /// Trait bounds joined by +.
    pub fn bounds(&self, bs: &Vec<&Path>, sh: Shape) -> Option<String> {
        let mut parts = Vec::new();
        for b in bs.iter() { parts.push(self.path(*b, false, sh.clone())?); }
        let one = parts.join(" + ");
        if !one.contains('\n') && str_width(one.as_str()) <= sh.width { return Some(one); }
        let mut out = String::new();
        let ind = Shape::indented(sh.block + TAB).with_align(sh.align).nl_indent();
        let mut first = true;
        for p in parts.iter() {
            if !first {
                out.push_str(ind.as_str());
                out.push_str("+ ");
            }
            out.push_str(p.as_str());
            first = false;
        }
        Some(out)
    }

    pub fn generic_param(&self, g: &GenericParam, sh: Shape) -> Option<String> {
        let mut out = String::new();
        if let Some(t) = g.ty {
            out.push_str("const ");
            out.push_str(self.ident(g.name).as_str());
            out.push_str(": ");
            out.push_str(self.typ(t, sh.clone())?.as_str());
        } else {
            out.push_str(self.ident(g.name).as_str());
        }
        if g.bounds.len() > 0 {
            out.push_str(": ");
            out.push_str(self.bounds(&g.bounds, sh.clone())?.as_str());
        }
        if let Some(d) = g.default {
            out.push_str(" = ");
            let budget = sub_opt3(sh.width, out.len())?;
            let a = sh.align + out.len();
            out.push_str(self.typ(d, Shape { width: budget, block: sh.block, align: a, offset: a })?.as_str());
        }
        Some(out)
    }

    /// ident<params> (rustfmt's rewrite_generics).
    pub fn generics(&self, ident: &str, g: &Generics, sh: Shape) -> Option<String> {
        if g.params.len() == 0 { return Some(ident.to_string()); }
        let mut items = Vec::new();
        for p in g.params.iter() { items.push(Node::G(*p)); }
        self.with_angles(ident, &items, sh, g.lt)
    }

    /// A where clause on lines of its own (rustfmt's rfc style), or "".
    pub fn where_clause(&self, g: &Generics, sh: Shape, snuggle_space: bool, suppress_comma: bool) -> Option<String> {
        if g.wheres.len() == 0 { return Some(String::new()); }
        let block = sh.block_only().with_max_width();
        let clause = block.block_left(TAB)?.sub_width(1)?;
        let mut parts = Vec::new();
        for w in g.wheres.iter() {
            let t = self.typ(w.ty, clause.clone())?;
            let lhs = cat(t.as_str(), ":");
            let b = self.bounds(&w.bounds, clause.offset_left(lhs.len() + 1)?)?;
            parts.push(cat3(lhs.as_str(), " ", b.as_str()));
        }
        let mut out = if snuggle_space { s(" ") } else { block.nl_indent() };
        out.push_str("where");
        let ind = clause.nl_indent();
        let mut i = 0;
        for p in parts.iter() {
            out.push_str(ind.as_str());
            out.push_str(p.as_str());
            if !suppress_comma || i + 1 < parts.len() { out.push(','); }
            i += 1;
        }
        Some(out)
    }
}

pub fn sub_opt3(a: usize, b: usize) -> Option<usize> { if a >= b { Some(a - b) } else { None } }
