//! use items: normalizing, sorting and writing their trees (rustfmt's
//! imports.rs and reorder.rs, 2024 style: version sorting).

use crate::{
    fmt::{ctx::*, items::vis_str, lists::*},
    syntax::ast::*,
};

/// A segment of a use path.
#[derive(Clone)]
pub enum Seg {
    Slf(Option<String>),
    Super(Option<String>),
    Crate(Option<String>),
    Ident(String, Option<String>),
    Glob,
    List(Vec<UseKey>),
}

/// A use tree as segments, the last of which may be a list.
#[derive(Clone)]
pub struct UseKey {
    pub segs: Vec<Seg>,
}

impl Ctx {
    pub fn use_key(&self, t: &UseTree) -> UseKey {
        let mut segs = Vec::new();
        if let Some(p) = t.prefix {
            let n = p.segments.len();
            let mut i = 0;
            for sg in p.segments.iter() {
                let name = if sg.name.value.len() == 0 {
                    String::new()
                } else {
                    self.ident(sg.name)
                };
                let alias = if i + 1 == n && !t.glob && !t.group {
                    match t.alias {
                        Some(a) => Some(self.ident(a)),
                        None => None,
                    }
                } else {
                    None
                };
                segs.push(match name.as_str() {
                    "self" => Seg::Slf(alias),
                    "super" => Seg::Super(alias),
                    "crate" => Seg::Crate(alias),
                    _ => Seg::Ident(name.clone(), alias),
                });
                i += 1;
            }
        }
        if t.glob {
            segs.push(Seg::Glob);
        }
        if t.group {
            let mut list = Vec::new();
            for c in t.children.iter() {
                list.push(self.use_key(*c));
            }
            segs.push(Seg::List(list));
        }
        UseKey { segs }
    }

    pub fn use_keys(&self, items: &Vec<Item>, i: usize, j: usize) -> Vec<UseKey> {
        let mut out = Vec::new();
        let mut k = i;
        while k < j {
            match &items[k] {
                Item::Use(u) => out.push(normalize(self.use_key(u.tree))),
                _ => out.push(UseKey { segs: Vec::new() }),
            }
            k += 1;
        }
        out
    }

    pub fn reorder_key(&self, it: &Item) -> String {
        match it {
            Item::Mod(m) => self.ident(m.name),
            _ => String::new(),
        }
    }

    pub fn use_item(&self, u: &UseDecl, indent: usize) -> Option<String> {
        let lo = u.base.start;
        let hi = self.item_close(self.use_end(u.tree));
        if self.has_comment(lo, hi) {
            return None;
        }
        let vis = vis_str(&u.base.vis);
        let key = normalize(self.use_key(u.tree));
        use_text(vis.as_str(), &key, indent)
    }
}

/// vis use tree; at indent.
pub fn use_text(vis: &str, key: &UseKey, indent: usize) -> Option<String> {
    let sh = Shape::indented(indent)
        .offset_left(4)?
        .sub_width(1)?
        .offset_left(vis.len())?;
    let t = render_tree(key, sh, 0)?;
    let mut out = vis.to_string();
    out.push_str("use ");
    out.push_str(t.as_str());
    out.push(';');
    Some(out)
}

// --- imports_granularity = "Crate", group_imports = "StdExternalCrate" -----

/// The group of a use tree (group_imports = "StdExternalCrate"): 0 std,
/// core and alloc, 1 other crates, 2 self, super and crate.
pub fn import_group(k: &UseKey) -> i32 {
    if k.segs.len() == 0 {
        return 1;
    }
    match &k.segs[0] {
        Seg::Ident(n, _) => {
            if n == "std" || n == "core" || n == "alloc" {
                0
            } else {
                1
            }
        }
        Seg::Slf(_) | Seg::Super(_) | Seg::Crate(_) => 2,
        _ => 1,
    }
}

fn seg_eq(a: &Seg, b: &Seg, alias: bool) -> bool {
    match (a, b) {
        (Seg::Slf(x), Seg::Slf(y)) => !alias || x == y,
        (Seg::Super(x), Seg::Super(y)) => !alias || x == y,
        (Seg::Crate(x), Seg::Crate(y)) => !alias || x == y,
        (Seg::Ident(x, xa), Seg::Ident(y, ya)) => x == y && (!alias || xa == ya),
        (Seg::Glob, Seg::Glob) => true,
        (Seg::List(x), Seg::List(y)) => {
            if x.len() != y.len() {
                return false;
            }
            let mut i = 0;
            while i < x.len() {
                if !key_eq(&x[i], &y[i]) {
                    return false;
                }
                i += 1;
            }
            true
        }
        _ => false,
    }
}

fn key_eq(a: &UseKey, b: &UseKey) -> bool {
    if a.segs.len() != b.segs.len() {
        return false;
    }
    let mut i = 0;
    while i < a.segs.len() {
        if !seg_eq(&a.segs[i], &b.segs[i], true) {
            return false;
        }
        i += 1;
    }
    true
}

/// rustfmt's UseTree::flatten: one tree per path (a lone {self} kept).
pub fn flatten(k: &UseKey) -> Vec<UseKey> {
    let n = k.segs.len();
    let mut out = Vec::new();
    if n == 0 {
        out.push(k.clone());
        return out;
    }
    if let Seg::List(list) = &k.segs[n - 1] {
        if list.len() == 1 && list[0].segs.len() == 1 {
            if let Seg::Slf(_) = &list[0].segs[0] {
                out.push(k.clone());
                return out;
            }
        }
        for c in list.iter() {
            for f in flatten(c).iter() {
                let mut segs: Vec<Seg> = Vec::new();
                let mut i = 0;
                while i + 1 < n {
                    segs.push(k.segs[i].clone());
                    i += 1;
                }
                for s in f.segs.iter() {
                    segs.push(s.clone());
                }
                out.push(UseKey { segs });
            }
        }
        return out;
    }
    out.push(k.clone());
    out
}

// Whether two trees merge (imports_granularity = "Crate"): the same first
// segment.
fn share_prefix(a: &UseKey, b: &UseKey) -> bool {
    a.segs.len() > 0 && b.segs.len() > 0 && seg_eq(&a.segs[0], &b.segs[0], true)
}

/// rustfmt's UseTree::merge: other into t.
pub fn merge_key(t: &mut UseKey, other: &UseKey) {
    let mut prefix = 0;
    while prefix < t.segs.len() && prefix < other.segs.len() {
        let a = &t.segs[prefix];
        let b = &other.segs[prefix];
        // (Only the root's alias is set aside.)
        if (prefix == 0 && seg_eq(a, b, false)) || seg_eq(a, b, true) {
            prefix += 1;
        } else {
            break;
        }
    }
    if let Some(p) = merge_rest(&t.segs, &other.segs, prefix) {
        t.segs = p;
    }
}

fn slice_key(s: &Vec<Seg>, from: usize, to: usize) -> UseKey {
    let mut segs = Vec::new();
    let mut i = from;
    while i < to {
        segs.push(s[i].clone());
        i += 1;
    }
    UseKey { segs }
}

fn merge_rest(a: &Vec<Seg>, b: &Vec<Seg>, len0: usize) -> Option<Vec<Seg>> {
    let mut len = len0;
    if a.len() == len && b.len() == len {
        return None;
    }
    if a.len() != len && b.len() != len {
        if let Seg::List(list) = &a[len] {
            let mut l2 = list.clone();
            merge_inner(&mut l2, slice_key(b, len, b.len()));
            let mut p = slice_key(b, 0, len).segs;
            p.push(Seg::List(l2));
            return Some(p);
        }
    } else if len == 1 {
        let (common, rest) = if a.len() == len {
            (&a[0], slice_key(b, 1, b.len()))
        } else {
            (&b[0], slice_key(a, 1, a.len()))
        };
        let alias = match common {
            Seg::Ident(_, x) => x.clone(),
            Seg::Slf(x) => x.clone(),
            Seg::Super(x) => x.clone(),
            Seg::Crate(x) => x.clone(),
            _ => None,
        };
        let mut s1 = Vec::new();
        s1.push(Seg::Slf(alias));
        let mut list = Vec::new();
        list.push(UseKey { segs: s1 });
        list.push(rest);
        sort_keys(&mut list);
        let mut p = Vec::new();
        p.push(b[0].clone());
        p.push(Seg::List(list));
        return Some(p);
    } else {
        len -= 1;
    }
    let mut list = Vec::new();
    list.push(slice_key(a, len, a.len()));
    list.push(slice_key(b, len, b.len()));
    sort_keys(&mut list);
    let mut p = slice_key(b, 0, len).segs;
    p.push(Seg::List(list));
    Some(p)
}

// rustfmt's merge_use_trees_inner (SharedPrefix::Crate): in a list, a path
// of one segment stays apart if a tree of one segment shares it; another
// merges into the longest tree sharing its prefix, if longer than one.
fn merge_inner(list: &mut Vec<UseKey>, t: UseKey) {
    let mut best: Option<usize> = None;
    let mut shortest: Option<usize> = None;
    let mut i = 0;
    while i < list.len() {
        if share_prefix(&list[i], &t) {
            match best {
                Some(b) => {
                    if list[i].segs.len() > list[b].segs.len() {
                        best = Some(i);
                    }
                }
                None => best = Some(i),
            }
            match shortest {
                Some(b) => {
                    if list[i].segs.len() < list[b].segs.len() {
                        shortest = Some(i);
                    }
                }
                None => shortest = Some(i),
            }
        }
        i += 1;
    }
    if t.segs.len() == 1 {
        if let Some(s1) = shortest {
            if list[s1].segs.len() == 1 {
                return;
            }
        }
    } else if let Some(b) = best {
        if list[b].segs.len() > 1 {
            let mut x = list[b].clone();
            merge_key(&mut x, &t);
            list[b] = x;
            return;
        }
    }
    list.push(t);
    sort_keys(list);
}

/// Merges trees (imports_granularity = "Crate"): each of keys (in order)
/// flattened into the first tree it shares a prefix with.
pub fn merge_keys(keys: &Vec<UseKey>) -> Vec<UseKey> {
    let mut out: Vec<UseKey> = Vec::new();
    for k in keys.iter() {
        for f in flatten(k).iter() {
            let mut done = false;
            let mut i = 0;
            while i < out.len() {
                if share_prefix(&out[i], f) {
                    let mut x = out[i].clone();
                    merge_key(&mut x, f);
                    out[i] = x;
                    done = true;
                    break;
                }
                i += 1;
            }
            if !done {
                out.push(f.clone());
            }
        }
    }
    out
}

fn render_tree(k: &UseKey, sh0: Shape, depth: usize) -> Option<String> {
    let mut out = String::new();
    let mut sh = sh0;
    let mut i = 0;
    while i < k.segs.len() {
        let s1 = render_seg(&k.segs[i], sh.clone(), depth)?;
        out.push_str(s1.as_str());
        if i + 1 < k.segs.len() {
            out.push_str("::");
            sh = sh.offset_left(2 + s1.len())?;
        }
        i += 1;
    }
    Some(out)
}

fn with_alias(name: &str, a: &Option<String>) -> String {
    match a {
        Some(x) => cat3(name, " as ", x.as_str()),
        None => name.to_string(),
    }
}

// depth: how many lists the tree is in.
fn render_seg(sg: &Seg, sh: Shape, depth: usize) -> Option<String> {
    match sg {
        Seg::Slf(a) => Some(with_alias("self", a)),
        Seg::Super(a) => Some(with_alias("super", a)),
        Seg::Crate(a) => Some(with_alias("crate", a)),
        Seg::Ident(n, a) => Some(with_alias(n.as_str(), a)),
        Seg::Glob => Some(s("*")),
        Seg::List(list) => {
            let nested = sh.block_indent(TAB).with_max_width().sub_width(1)?;
            let mut items = Vec::new();
            let mut has_nested = false;
            for t in list.iter() {
                items.push(ListItem::of(render_tree(t, nested.clone(), depth + 1)?));
                if let Some(Seg::List(l)) = t.segs.last() {
                    if l.len() > 0 {
                        has_nested = true;
                    }
                }
            }
            // (A list in a list has 2 less, as rustfmt measures it.)
            let remaining = if has_nested {
                0
            } else {
                sub(sh.width, if depth > 0 { 4 } else { 2 })
            };
            let tactic = definitive_tactic(&items, ListTactic::Mixed, 2, remaining);
            let ends = tactic != Tactic::Horizontal;
            let mut f = ListFormatting::new(nested.clone());
            f.tactic = tactic.clone();
            f.trailing = if ends {
                Trailing::Vertical
            } else {
                Trailing::Never
            };
            f.ends_with_newline = ends;
            f.preserve_newline = true;
            f.nested = has_nested;
            let ls = write_list(&items, &f)?;
            if ls.contains('\n') || ls.len() > remaining || tactic == Tactic::Vertical {
                let mut out = s("{\n");
                out.push_str(nested.indent_str().as_str());
                out.push_str(ls.as_str());
                out.push('\n');
                out.push_str(sh.indent_str().as_str());
                out.push('}');
                return Some(out);
            }
            Some(cat3("{", ls.as_str(), "}"))
        }
    }
}

fn is_just_self(k: &UseKey) -> bool {
    if k.segs.len() != 1 {
        return false;
    }
    match &k.segs[0] {
        Seg::Slf(None) => true,
        _ => false,
    }
}

/// rustfmt's UseTree::normalize.
pub fn normalize(k: UseKey) -> UseKey {
    let mut segs = k.segs;
    let last = match segs.pop() {
        Some(l) => l,
        None => return UseKey { segs },
    };
    match &last {
        Seg::Slf(None) => {
            if segs.len() > 0 {
                segs.push(last);
                return UseKey { segs };
            }
        }
        Seg::Slf(Some(a)) => {
            let n = segs.len();
            if n > 0 {
                let mut repl: Option<String> = None;
                if let Seg::Ident(name, None) = &segs[n - 1] {
                    repl = Some(name.clone());
                }
                if let Some(name) = repl {
                    segs[n - 1] = Seg::Ident(name, Some(a.clone()));
                    return UseKey { segs };
                }
            }
        }
        Seg::List(list) => {
            if list.len() == 1 && !is_just_self(&list[0]) {
                for sg in list[0].segs.iter() {
                    segs.push(sg.clone());
                }
                return normalize(UseKey { segs });
            }
            let mut l2 = Vec::new();
            for t in list.iter() {
                l2.push(normalize(t.clone()));
            }
            sort_keys(&mut l2);
            segs.push(Seg::List(l2));
            return UseKey { segs };
        }
        _ => {}
    }
    segs.push(last);
    UseKey { segs }
}

fn sort_keys(l: &mut Vec<UseKey>) {
    let n = l.len();
    let mut i = 1;
    while i < n {
        let mut j = i;
        while j > 0 && cmp_use(&l[j - 1], &l[j]) > 0 {
            let t = l[j - 1].clone();
            l[j - 1] = l[j].clone();
            l[j] = t;
            j -= 1;
        }
        i += 1;
    }
}

fn seg_rank(sg: &Seg) -> i32 {
    match sg {
        Seg::Slf(_) => 0,
        Seg::Super(_) => 1,
        Seg::Crate(_) => 2,
        Seg::Ident(_, _) => 3,
        Seg::Glob => 4,
        Seg::List(_) => 5,
    }
}

fn cmp_alias(a: &Option<String>, b: &Option<String>) -> i32 {
    match (a, b) {
        (None, None) => 0,
        (None, Some(_)) => -1,
        (Some(_), None) => 1,
        (Some(x), Some(y)) => version_cmp(x.as_str(), y.as_str()),
    }
}

fn cmp_seg(a: &Seg, b: &Seg, aliases: bool) -> i32 {
    let ra = seg_rank(a);
    let rb = seg_rank(b);
    if ra != rb {
        return if ra < rb { -1 } else { 1 };
    }
    match (a, b) {
        (Seg::Slf(x), Seg::Slf(y)) => {
            if aliases {
                cmp_alias(x, y)
            } else {
                0
            }
        }
        (Seg::Super(x), Seg::Super(y)) => {
            if aliases {
                cmp_alias(x, y)
            } else {
                0
            }
        }
        (Seg::Crate(x), Seg::Crate(y)) => {
            if aliases {
                cmp_alias(x, y)
            } else {
                0
            }
        }
        (Seg::Ident(x, xa), Seg::Ident(y, ya)) => {
            let o = version_cmp(x.as_str(), y.as_str());
            if o != 0 || !aliases {
                return o;
            }
            cmp_alias(xa, ya)
        }
        (Seg::List(x), Seg::List(y)) => {
            let mut i = 0;
            while i < x.len() && i < y.len() {
                let o = cmp_use(&x[i], &y[i]);
                if o != 0 {
                    return o;
                }
                i += 1;
            }
            if x.len() < y.len() {
                -1
            } else if x.len() > y.len() {
                1
            } else {
                0
            }
        }
        _ => 0,
    }
}

/// The order of two use trees (-1, 0 or 1).
pub fn cmp_use(a: &UseKey, b: &UseKey) -> i32 {
    let mut i = 0;
    while i < a.segs.len() && i < b.segs.len() {
        let o = cmp_seg(&a.segs[i], &b.segs[i], true);
        if o != 0 && cmp_seg(&a.segs[i], &b.segs[i], false) != 0 {
            return o;
        }
        i += 1;
    }
    if a.segs.len() < b.segs.len() {
        -1
    } else if a.segs.len() > b.segs.len() {
        1
    } else {
        0
    }
}

/// rustfmt's version_sort: _ first, digit runs by value, the rest by bytes.
pub fn version_cmp(a: &str, b: &str) -> i32 {
    let x = a.as_bytes();
    let y = b.as_bytes();
    let mut i = 0;
    let mut j = 0;
    let mut tie = 0;
    loop {
        let ea = i >= x.len();
        let eb = j >= y.len();
        if ea && eb {
            return tie;
        }
        if ea {
            return -1;
        }
        if eb {
            return 1;
        }
        let ca = x[i];
        let cb = y[j];
        if ca == b'_' || cb == b'_' {
            if ca == b'_' && cb == b'_' {
                i += 1;
                j += 1;
                continue;
            }
            return if ca == b'_' { -1 } else { 1 };
        }
        let da = is_digit(ca);
        let db = is_digit(cb);
        if da && db {
            let si = i;
            while i < x.len() && is_digit(x[i]) {
                i += 1;
            }
            let sj = j;
            while j < y.len() && is_digit(y[j]) {
                j += 1;
            }
            // Compare by value: strip leading zeros, then length, then bytes.
            let mut za = si;
            while za + 1 < i && x[za] == b'0' {
                za += 1;
            }
            let mut zb = sj;
            while zb + 1 < j && y[zb] == b'0' {
                zb += 1;
            }
            let la = i - za;
            let lb = j - zb;
            if la != lb {
                return if la < lb { -1 } else { 1 };
            }
            let mut k = 0;
            while k < la {
                if x[za + k] != y[zb + k] {
                    return if x[za + k] < y[zb + k] { -1 } else { 1 };
                }
                k += 1;
            }
            let lza = za - si;
            let lzb = zb - sj;
            if lza != lzb && tie == 0 {
                tie = if lzb < lza { -1 } else { 1 };
            }
            continue;
        }
        if da != db {
            return if da { -1 } else { 1 };
        }
        // Runs of other bytes.
        let si = i;
        while i < x.len() && x[i] != b'_' && !is_digit(x[i]) {
            i += 1;
        }
        let sj = j;
        while j < y.len() && y[j] != b'_' && !is_digit(y[j]) {
            j += 1;
        }
        let ra = &x[si..i];
        let rb = &y[sj..j];
        let mut k = 0;
        while k < ra.len() && k < rb.len() {
            if ra[k] != rb[k] {
                return if ra[k] < rb[k] { -1 } else { 1 };
            }
            k += 1;
        }
        if ra.len() != rb.len() {
            return if ra.len() < rb.len() { -1 } else { 1 };
        }
    }
}

fn is_digit(c: u8) -> bool {
    c >= b'0' && c <= b'9'
}

/// A use tree on one line (a::{b, c as d, *}).
pub fn key_string(k: &UseKey) -> String {
    let mut parts: Vec<String> = Vec::new();
    for sg in k.segs.iter() {
        parts.push(match sg {
            Seg::Slf(a) => with_alias("self", a),
            Seg::Super(a) => with_alias("super", a),
            Seg::Crate(a) => with_alias("crate", a),
            Seg::Ident(n, a) => with_alias(n.as_str(), a),
            Seg::Glob => "*".to_string(),
            Seg::List(l) => {
                let v: Vec<String> = l
                    .iter()
                    .map(|x: &UseKey| -> String { key_string(x) })
                    .collect();
                `{${v.join(", ")}}`.to_string()
            }
        });
    }
    parts.join("::")
}
