//! Closures (rustfmt's closures.rs).

use crate::{
    fmt::{ctx::*, lists::*},
    syntax::{ast::*, source::Pos, token::*},
};

impl Ctx {
    pub fn closure(&self, x: &Expr, sh: Shape) -> Option<String> {
        let (params, result, body) = match &x.kind {
            ExprKind::Closure {
                params,
                result,
                body,
                ..
            } => (params, *result, *body),
            _ => return None,
        };
        let (prefix, extra) = self.closure_decl(x, params, result, body, sh.clone())?;
        let body_shape = sh.offset_left(extra)?;
        let plain_block = match &body.kind {
            ExprKind::Block(b) => destructure(*b).is_none(),
            _ => false,
        };
        if let ExprKind::Block(b) = &body.kind {
            if !plain_block {
                return self.closure_expr(body, prefix.as_str(), body_shape);
            }
            if b.stmts.len() == 0 && b.tail.is_none() && !self.has_comment(b.lbrace + 1, b.rbrace) {
                let bs = self.expr(body, sh)?;
                return Some(cat3(prefix.as_str(), " ", bs.as_str()));
            }
            let r = if result.is_none() {
                self.closure_without_block(body, prefix.as_str(), sh, body_shape.clone())
            } else {
                None
            };
            if r.is_some() {
                return r;
            }
            let bs = self.block(*b, None, body_shape)?;
            return Some(cat3(prefix.as_str(), " ", bs.as_str()));
        }
        match self.closure_expr(body, prefix.as_str(), body_shape.clone()) {
            Some(r) => Some(r),
            None => self.closure_with_block(body, prefix.as_str(), body_shape),
        }
    }

    fn closure_without_block(
        &self,
        body: &Expr,
        prefix: &str,
        sh: Shape,
        body_shape: Shape,
    ) -> Option<String> {
        let inner = self.inner_closure_expr(body, prefix);
        if is_block_closure_forced(inner) {
            return self.closure_with_block(inner, prefix, sh);
        }
        self.closure_expr(inner, prefix, body_shape)
    }

    fn inner_closure_expr(&self, x: &Expr, prefix: &str) -> &Expr {
        if let ExprKind::Block(b) = &x.kind {
            if !b.is_unsafe && !prefix.contains('\n') && destructure(*b).is_none() {
                if let Some(t) = self.simple_block_expr(*b) {
                    return self.inner_closure_expr(t, prefix);
                }
            }
        }
        x
    }

    fn closure_expr(&self, x: &Expr, prefix: &str, sh: Shape) -> Option<String> {
        let veto_multiline = !allow_multi_line(x);
        let r = self.expr(x, sh)?;
        if veto_multiline && r.contains('\n') {
            return None;
        }
        Some(cat3(prefix, " ", r.as_str()))
    }

    // A closure whose body gets braces it did not have.
    fn closure_with_block(&self, body: &Expr, prefix: &str, sh: Shape) -> Option<String> {
        let left = left_most_sub_expr(body);
        if veto_block(body) && !requires_semi(left) {
            return None;
        }
        let ind = sh.indent_width();
        let e = self.format_expr(body, false, Shape::indented(ind + TAB))?;
        let mut out = s(prefix);
        out.push_str(" {\n");
        push_spaces(&mut out, ind + TAB);
        out.push_str(e.as_str());
        out.push('\n');
        push_spaces(&mut out, ind);
        out.push('}');
        Some(out)
    }

    // |params| -> result, and the width of its last line plus a space.
    fn closure_decl(
        &self,
        x: &Expr,
        params: &Vec<&Param>,
        result: Option<&Type>,
        body: &Expr,
        sh: Shape,
    ) -> Option<(String, usize)> {
        let nested = sh.shrink_left(0)?.sub_width(4)?;
        let psh = nested.offset_left(1)?;
        let ret = match result {
            Some(t) => {
                let w = sub_opt2(psh.width, 3)?;
                let r = self.typ(
                    t,
                    Shape {
                        width: w,
                        block: psh.block,
                        align: psh.align + 3,
                        offset: psh.offset,
                    },
                )?;
                cat("-> ", r.as_str())
            }
            None => String::new(),
        };
        let open = x.pos();
        let close = if self.kind_at(open) == OR_OR {
            open + 1
        } else {
            let from = if params.len() > 0 {
                self.param_end(params[params.len() - 1])
            } else {
                open + 1
            };
            self.find(from, OR)
        };
        let mut spans = Vec::new();
        for p in params.iter() {
            spans.push((self.pat_start(p.pat), self.param_end(*p)));
        }
        let mut items = self.itemize(&spans, open + 1, close);
        let mut i = 0;
        for p in params.iter() {
            items[i].item = self.closure_param(*p, psh.clone());
            i += 1;
        }
        let budget = sub(nested.width, ret.len() + 1);
        let tactic = definitive_tactic(&items, ListTactic::HorizontalVertical, 2, budget);
        let psh2 = if tactic == Tactic::Horizontal {
            psh.sub_width(ret.len() + 1)?
        } else {
            psh.clone()
        };
        let mut f = ListFormatting::new(psh2);
        f.tactic = tactic;
        f.preserve_newline = true;
        let list = write_list(&items, &f)?;
        let mut prefix = cat3("|", list.as_str(), "|");
        if ret.len() > 0 {
            if prefix.contains('\n') {
                prefix.push('\n');
                push_spaces(&mut prefix, nested.indent_width() + 1);
            } else {
                prefix.push(' ');
            }
            prefix.push_str(ret.as_str());
        }
        let extra = last_line_width(prefix.as_str()) + 1;
        Some((prefix, extra))
    }

    fn param_end(&self, p: &Param) -> Pos {
        match p.ty {
            Some(t) => self.type_end(t),
            None => self.pat_end(p.pat),
        }
    }

    fn closure_param(&self, p: &Param, sh: Shape) -> Option<String> {
        let ps = self.pat(p.pat, sh.clone())?;
        match p.ty {
            Some(t) => {
                let w = sub_opt2(sh.width, last_line_width(ps.as_str()) + 2)?;
                let ts = self.typ(t, Shape::legacy(w, sh.indent_width()))?;
                Some(cat3(ps.as_str(), ": ", ts.as_str()))
            }
            None => Some(ps),
        }
    }

    /// A closure as the last argument of a call (rustfmt's
    /// rewrite_last_closure).
    pub fn rewrite_last_closure(&self, x: &Expr, sh: Shape) -> Option<String> {
        let (params, result, body0) = match &x.kind {
            ExprKind::Closure {
                params,
                result,
                body,
                ..
            } => (params, *result, *body),
            _ => return None,
        };
        let body = match &body0.kind {
            ExprKind::Block(b) => {
                if !b.is_unsafe && destructure(*b).is_none() {
                    match self.simple_block_expr(*b) {
                        Some(t) => t,
                        None => body0,
                    }
                } else {
                    body0
                }
            }
            _ => body0,
        };
        let (prefix, extra) = self.closure_decl(x, params, result, body, sh.clone())?;
        if prefix.contains('\n') {
            return None;
        }
        let body_shape = sh.offset_left(extra)?;
        if is_block_closure_forced(body) {
            let bs = self.closure_with_block(body, prefix.as_str(), body_shape)?;
            if result.is_none() && count_newlines(bs.as_str()) + 1 <= 7 {
                if let Some(one) = self.closure_expr(body, prefix.as_str(), sh) {
                    if !one.contains('\n') {
                        return Some(one);
                    }
                }
            }
            return Some(bs);
        }
        let multi = match self.rewrite_cond(body, body_shape.clone()) {
            Some(c) => c.contains('\n'),
            None => false,
        };
        if multi {
            return self.closure_with_block(body, prefix.as_str(), body_shape);
        }
        self.expr(x, sh)
    }
}

pub fn sub_opt2(a: usize, b: usize) -> Option<usize> {
    if a >= b { Some(a - b) } else { None }
}

pub fn is_block_closure_forced(x: &Expr) -> bool {
    match &x.kind {
        ExprKind::If { .. }
        | ExprKind::While { .. }
        | ExprKind::For { .. }
        | ExprKind::Loop { .. } => true,
        ExprKind::Ref { x, .. } => is_block_closure_forced(*x),
        ExprKind::Try { x, .. } => is_block_closure_forced(*x),
        ExprKind::Unary { x, .. } => is_block_closure_forced(*x),
        ExprKind::Cast { x, .. } => is_block_closure_forced(*x),
        _ => false,
    }
}

fn allow_multi_line(x: &Expr) -> bool {
    match &x.kind {
        ExprKind::Match { .. }
        | ExprKind::Block(_)
        | ExprKind::Loop { .. }
        | ExprKind::StructLit { .. }
        | ExprKind::Select { .. } => true,
        ExprKind::Ref { x, .. } => allow_multi_line(*x),
        ExprKind::Try { x, .. } => allow_multi_line(*x),
        ExprKind::Unary { x, .. } => allow_multi_line(*x),
        ExprKind::Cast { x, .. } => allow_multi_line(*x),
        _ => false,
    }
}

fn veto_block(x: &Expr) -> bool {
    match &x.kind {
        ExprKind::Call { .. }
        | ExprKind::Binary { .. }
        | ExprKind::Cast { .. }
        | ExprKind::Assign { .. }
        | ExprKind::Field { .. }
        | ExprKind::Index { .. }
        | ExprKind::Range { .. }
        | ExprKind::Try { .. } => true,
        _ => false,
    }
}

pub fn left_most_sub_expr(x: &Expr) -> &Expr {
    match &x.kind {
        ExprKind::Call { fun, .. } => left_most_sub_expr(*fun),
        ExprKind::Binary { x: l, .. } => left_most_sub_expr(*l),
        ExprKind::Cast { x: l, .. } => left_most_sub_expr(*l),
        ExprKind::Assign { x: l, .. } => left_most_sub_expr(*l),
        ExprKind::Field { x: l, .. } => left_most_sub_expr(*l),
        ExprKind::Index { x: l, .. } => left_most_sub_expr(*l),
        ExprKind::Range { lo: Some(l), .. } => left_most_sub_expr(*l),
        ExprKind::Try { x: l, .. } => left_most_sub_expr(*l),
        _ => x,
    }
}

/// Whether x as a statement needs a ; (it is not block-like).
pub fn requires_semi(x: &Expr) -> bool {
    match &x.kind {
        ExprKind::If { .. }
        | ExprKind::Match { .. }
        | ExprKind::Block(_)
        | ExprKind::While { .. }
        | ExprKind::Loop { .. }
        | ExprKind::For { .. }
        | ExprKind::Select { .. } => false,
        _ => true,
    }
}
