//! Checks that formatting kept a file's meaning: the AST dumps (see
//! syntax::dump) of the source and the formatted text agree, once what
//! formatting may change is undone in both: the order of use items and
//! module declarations and the shape of use trees, braces around a single
//! expression (closure and match arm bodies), ; after loops and around
//! return, empty statements and doubled parentheses.

/// A node of a dump: an atom, or a list (with the ; after it).
struct Node {
    atom: String,
    list: Vec<Node>,
    is_list: bool,
    semi: bool,
}

/// Whether two dumps agree up to what formatting may change.
pub fn same_dump(a: &str, b: &str) -> bool { canon(a) == canon(b) }

pub fn canon(d: &str) -> String {
    let b = d.as_bytes();
    let mut i = 0;
    let mut top = Vec::new();
    while i < b.len() {
        match parse(b, &mut i) {
            Some(n) => top.push(n),
            None => {}
        }
    }
    let mut out = String::new();
    for n in top.iter() {
        let m = norm(n);
        write(&m, &mut out);
    }
    out
}

fn parse(b: &[u8], i: &mut usize) -> Option<Node> {
    while *i < b.len() && b[*i] == b' ' { *i += 1; }
    if *i >= b.len() { return None; }
    let c = b[*i];
    if c == b')' {
        *i += 1;
        return None;
    }
    if c == b';' {
        *i += 1;
        return Some(Node { atom: ";".to_string(), list: Vec::new(), is_list: false, semi: false });
    }
    if c == b'(' {
        *i += 1;
        let mut list = Vec::new();
        loop {
            while *i < b.len() && b[*i] == b' ' { *i += 1; }
            if *i >= b.len() { break; }
            if b[*i] == b')' {
                *i += 1;
                break;
            }
            if let Some(n) = parse(b, i) { list.push(n); }
        }
        let mut semi = false;
        if *i < b.len() && b[*i] == b';' {
            semi = true;
            *i += 1;
        }
        return Some(Node { atom: String::new(), list, is_list: true, semi });
    }
    let start = *i;
    if c == b'"' {
        *i += 1;
        while *i < b.len() && b[*i] != b'"' {
            if b[*i] == b'\\' { *i += 1; }
            *i += 1;
        }
        *i += 1;
    } else {
        while *i < b.len() && b[*i] != b' ' && b[*i] != b'(' && b[*i] != b')' && b[*i] != b';' { *i += 1; }
    }
    let end = if *i < b.len() { *i } else { b.len() };
    Some(Node { atom: String::from_utf8_lossy(&b[start..end]), list: Vec::new(), is_list: false, semi: false })
}

fn head(n: &Node) -> &str {
    if n.is_list && n.list.len() > 0 && !n.list[0].is_list { n.list[0].atom.as_str() } else { "" }
}

fn norm(n: &Node) -> Node {
    if !n.is_list { return Node { atom: n.atom.clone(), list: Vec::new(), is_list: false, semi: false }; }
    let mut list = Vec::new();
    for c in n.list.iter() {
        // Empty statements go.
        if !c.is_list && c.atom == ";" { continue; }
        list.push(norm(c));
    }
    let mut out = Node { atom: String::new(), list, is_list: true, semi: n.semi };
    let h = head(&out).to_string();
    if h == "loop" || h == "while" || h == "for" { out.semi = false; }
    if h == "block" {
        let k = out.list.len();
        if k > 1 {
            let lh = head(&out.list[k - 1]).to_string();
            if lh == "return" || lh == "break" || lh == "continue" { out.list[k - 1].semi = false; }
            if !out.list[k - 1].is_list && (out.list[k - 1].atom == "return" || out.list[k - 1].atom == "break" || out.list[k - 1].atom == "continue") {
                out.list[k - 1].semi = false;
            }
        }
        if k == 2 && !out.list[1].semi {
            let ch = head(&out.list[1]).to_string();
            if ch != "let" && ch != "fn" && ch != "struct" && ch != "enum" && ch != "use" && ch != "impl" && ch != "trait"
                && ch != "const" && ch != "static" && ch != "type" && ch != "mod" && ch != "defer" {
                let semi = out.semi;
                let mut inner = take(&mut out.list, 1);
                inner.semi = inner.semi || semi;
                return inner;
            }
        }
    }
    if h == "paren" && out.list.len() == 2 && head(&out.list[1]) == "paren" {
        let semi = out.semi;
        let mut inner = take(&mut out.list, 1);
        inner.semi = inner.semi || semi;
        return inner;
    }
    if h == "use" {
        // The tree is the rest (an alias makes it several atoms).
        let mut t = String::new();
        let mut k = 1;
        let mut atoms = true;
        while k < out.list.len() {
            if out.list[k].is_list { atoms = false; }
            if k > 1 { t.push(' '); }
            t.push_str(out.list[k].atom.as_str());
            k += 1;
        }
        if atoms && out.list.len() > 1 {
            let paths = expand_use(t.as_str());
            let semi = out.semi;
            let mut list = Vec::new();
            list.push(take(&mut out.list, 0));
            list.push(Node { atom: paths.join(";"), list: Vec::new(), is_list: false, semi: false });
            return Node { atom: String::new(), list, is_list: true, semi };
        }
    }
    if h == "file" || h == "mod" {
        let skip = if h == "file" { 1 } else { 2 };
        let mut keyed: Vec<(String, Node)> = Vec::new();
        let mut rest = Vec::new();
        let mut k = 0;
        let n2 = out.list.len();
        let mut items = out.list;
        while k < n2 {
            let nd = take(&mut items, k);
            if k < skip {
                rest.push(nd);
            } else {
                let mut key = String::new();
                write(&nd, &mut key);
                keyed.push((key, nd));
            }
            k += 1;
        }
        keyed.sort_by(|x, y| x.0.cmp(&y.0));
        for kv in keyed.iter() { rest.push(copy(&kv.1)); }
        return Node { atom: String::new(), list: rest, is_list: true, semi: out.semi };
    }
    out
}

fn take(v: &mut Vec<Node>, i: usize) -> Node { copy(&v[i]) }

fn copy(n: &Node) -> Node {
    let mut list = Vec::new();
    for c in n.list.iter() { list.push(copy(c)); }
    Node { atom: n.atom.clone(), list, is_list: n.is_list, semi: n.semi }
}

fn write(n: &Node, out: &mut String) {
    if !n.is_list {
        out.push_str(n.atom.as_str());
        return;
    }
    out.push('(');
    let mut first = true;
    for c in n.list.iter() {
        if !first { out.push(' '); }
        write(c, out);
        first = false;
    }
    out.push(')');
    if n.semi { out.push(';'); }
}

/// The paths of a use tree written as a::{b,c::{d}}, sorted.
fn expand_use(t: &str) -> Vec<String> {
    let mut out = Vec::new();
    expand_into("", t, &mut out);
    out.sort();
    out
}

fn expand_into(prefix: &str, t: &str, out: &mut Vec<String>) {
    let t = t.trim();
    match t.find('{') {
        None => {
            let mut p = prefix.to_string();
            p.push_str(t);
            // a::self is a.
            if p.ends_with("::self") { p.truncate(p.len() - 6); }
            out.push(p);
        }
        Some(i) => {
            let mut p = prefix.to_string();
            p.push_str(&t[..i]);
            let inner = &t[i + 1..t.len() - 1];
            let b = inner.as_bytes();
            let mut depth = 0;
            let mut start = 0;
            let mut j = 0;
            while j <= b.len() {
                if j == b.len() || (b[j] == b',' && depth == 0) {
                    let part = &inner[start..j];
                    if part.trim().len() > 0 { expand_into(p.as_str(), part, out); }
                    start = j + 1;
                } else if b[j] == b'{' {
                    depth += 1;
                } else if b[j] == b'}' {
                    depth -= 1;
                }
                j += 1;
            }
        }
    }
}
