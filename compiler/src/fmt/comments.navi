//! Wrapping // comments wider than the comment width (rustfmt's
//! wrap_comments): lines break at spaces, and what a broken line leaves
//! over joins the next line of its paragraph. Code blocks, indented code,
//! headings, tables and quotes stay as they are; continuation lines of a
//! list item line up with its text. Code blocks of navi in documentation
//! (/// and //!) are formatted (rustfmt's format_code_in_doc_comments).

use std::sync::atomic::{AtomicUsize, Ordering};
use crate::fmt::ctx::*;

/// rustfmt's comment_width: the column comments wrap at (counted from the
/// start of the line).
pub const DEFAULT_COMMENT_WIDTH: usize = 80;

static COMMENT_WIDTH: AtomicUsize = AtomicUsize::new(80);

pub fn set_comment_width(w: usize) { COMMENT_WIDTH.store(w, Ordering::Relaxed); }

pub fn comment_width() -> usize { COMMENT_WIDTH.load(Ordering::Relaxed) }

// A part of a broken line waiting to join the next one.
struct Carry {
    marker: String,
    indent: usize,
    text: String,
}

/// The lines of consecutive comments (joined by \n, not indented), wrapped
/// for a block at indent.
pub fn wrap_comments(text: &str, indent: usize) -> String { wrap_comments_at(text, indent, comment_width()) }

/// wrap_comments at column width (a list's comments wrap at its width, as
/// rustfmt's write_list rewrites them in the list's shape).
pub fn wrap_comments_at(text: &str, indent: usize, width: usize) -> String {
    let mut out: Vec<String> = Vec::new();
    let mut carry: Option<Carry> = None;
    let mut in_fence = false;
    // A code block of documentation to format: its lines (without the
    // marker) and as written.
    let mut code: Option<(String, Vec<String>, Vec<String>)> = None;
    let all: Vec<&str> = text.split('\n').collect();
    let mut li = 0;
    while li < all.len() {
        let l = all[li];
        li += 1;
        let marker = line_marker(l);
        if marker.len() == 0 {
            flush(&mut out, &mut carry);
            out.push(l.to_string());
            continue;
        }
        let rest = &l[marker.len()..];
        let content = match rest.strip_prefix(" ") { Some(r) => r, None => rest };
        if content.trim_start().starts_with("```") {
            flush(&mut out, &mut carry);
            if let Some((m, lines, raw)) = code {
                match format_doc_code(&lines) {
                    Some(f) => {
                        for x in f.iter() { out.push(if x.len() == 0 { m.clone() } else { cat3(m.as_str(), " ", x.as_str()) }); }
                    }
                    None => { for x in raw.iter() { out.push(x.clone()); } }
                }
                code = None;
            } else if !in_fence && (marker == "///" || marker == "//!") && rust_info(&content.trim_start()[3..]) {
                code = Some((marker.to_string(), Vec::new(), Vec::new()));
            }
            in_fence = !in_fence;
            out.push(l.to_string());
            continue;
        }
        if in_fence {
            match &mut code {
                Some((_, lines, raw)) => {
                    lines.push(content.to_string());
                    raw.push(l.to_string());
                }
                None => out.push(l.to_string()),
            }
            continue;
        }
        let lead = leading_spaces(content);
        let body = &content[lead..];
        // What the line before left over joins this one, as it is (rustfmt
        // joins it to any line but an empty one or a list item's).
        let mut joined: Option<Carry> = None;
        if let Some(c) = &carry {
            if c.marker == marker && body.len() > 0 && list_marker(body) == 0 {
                joined = Some(Carry { marker: marker.to_string(), indent: c.indent, text: cat3(c.text.as_str(), " ", content.trim_end()) });
            }
        }
        if let Some(j) = joined {
            carry = None;
            if no_wrap(j.text.as_str()) {
                out.push(cat3(marker, " ", cat(spaces(j.indent).as_str(), j.text.as_str()).as_str()));
                continue;
            }
            // (rustfmt counts the indentation twice for a line that took
            // over what the one before left: it wraps at width - indent.)
            let w2 = if width > indent { width - indent } else { width };
            wrap_line(&mut out, &mut carry, marker, j.indent, j.indent, j.text.as_str(), indent, w2);
            continue;
        }
        flush(&mut out, &mut carry);
        if body.len() == 0 {
            out.push(l.to_string());
            continue;
        }
        // A list item (rustfmt's ItemizedBlock): its lines and the lines
        // indented under its text, joined and wrapped again.
        let item = list_marker(body);
        if item > 0 {
            let mut joined = body.trim_end().to_string();
            while li < all.len() {
                let m2 = line_marker(all[li]);
                if m2 != marker { break; }
                let r2 = &all[li][m2.len()..];
                let c2 = match r2.strip_prefix(" ") { Some(r) => r, None => r2 };
                let l2 = leading_spaces(c2);
                let b2 = &c2[l2..];
                if b2.len() == 0 || l2 < lead + item || list_marker(b2) > 0 || !plain(b2) { break; }
                joined.push(' ');
                joined.push_str(b2.trim_end());
                li += 1;
            }
            if no_wrap(joined.as_str()) {
                out.push(cat3(marker, " ", cat(spaces(lead).as_str(), joined.as_str()).as_str()));
            } else {
                wrap_line(&mut out, &mut carry, marker, lead, lead + item, joined.as_str(), indent, width);
            }
            flush(&mut out, &mut carry);
            continue;
        }
        let first = cat3(marker, " ", content);
        if indent + str_width(first.as_str()) <= width || no_wrap(body) || body.starts_with("#") {
            out.push(l.to_string());
            continue;
        }
        // (Its later lines start at the margin, as rustfmt's.)
        wrap_line(&mut out, &mut carry, marker, lead, 0, body, indent, width);
    }
    flush(&mut out, &mut carry);
    // (A block left open: as written.)
    if let Some((_, _, raw)) = code { for x in raw.iter() { out.push(x.clone()); } }
    out.join("\n")
}

// Whether a code block's info string makes it code to format (rustfmt's
// CodeBlockAttribute: none, or only rust, navi, should_panic, no_run,
// edition20xx).
fn rust_info(info: &str) -> bool {
    let t = info.trim().trim_start_matches('`');
    for a in t.split(',') {
        match a.trim() {
            "" | "rust" | "navi" | "should_panic" | "no_run" | "edition2015" | "edition2018" | "edition2021" | "edition2024" => {}
            _ => return false,
        }
    }
    true
}

const HIDDEN: &str = "//#### ";

const MIN_STRING: usize = 10;

// A documentation code block formatted as rustfmt's format_code_block: in
// fn main() { }, at width 100, without wrapping its comments; lines rustdoc
// hides (# ...) as they are. None (left as it is) if it does not format or
// a line is too wide.
fn format_doc_code(lines: &Vec<String>) -> Option<Vec<String>> {
    if lines.iter().all(|l: &String| -> bool { l.trim().len() == 0 }) { return None; }
    let mut src = "fn main() {\n".to_string();
    for l in lines.iter() {
        let t = l.trim();
        src.push_str("    ");
        if t.starts_with("# ") || t == "#" { src.push_str(HIDDEN); }
        src.push_str(l.as_str());
        src.push('\n');
    }
    src.push_str("}\n");
    let w = comment_width();
    set_comment_width(1000000);
    let r = crate::fmt::format_source("doc", src);
    set_comment_width(w);
    let f = match r { Ok(f) => f, Err(_) => return None };
    let start = match f.find('\n') { Some(k) => k + 1, None => return None };
    let end = match f.rfind('}') { Some(k) => k, None => return None };
    if end < start { return None; }
    let mut out: Vec<String> = Vec::new();
    for l in f[start..end].split('\n') {
        if l.len() > 100 { return None; }
        let x = if l.starts_with("    ") { &l[4..] } else { l };
        let t = x.trim_start();
        out.push(if t.starts_with(HIDDEN) { t[HIDDEN.len()..].to_string() } else { x.to_string() });
    }
    while out.len() > 0 && out[out.len() - 1].len() == 0 { out.pop(); }
    Some(out)
}

// Breaks one line of text after marker and lead spaces; a list item's later
// lines are indented past its marker. The last piece waits in carry.
fn wrap_line(out: &mut Vec<String>, carry: &mut Option<Carry>, marker: &str, lead: usize, cont: usize, text: &str,
    indent: usize, width: usize) {
    let mut lines: Vec<String> = Vec::new();
    let mut cur = String::new();
    let mut cur_lead = lead;
    for w in text.split(' ') {
        if w.len() == 0 { continue; }
        let used = indent + marker.len() + 1 + cur_lead;
        // (rustfmt's break_string breaks only where at least MIN_STRING, 10,
        // characters stay before it; else at the next space, past the width.)
        if cur.len() >= MIN_STRING && used + str_width(cur.as_str()) + 1 + str_width(w) > width {
            lines.push(cur);
            cur = String::new();
            cur_lead = cont;
        }
        if cur.len() > 0 { cur.push(' '); }
        cur.push_str(w);
    }
    let first_lead = lead;
    if lines.len() == 0 {
        // Nothing to break at: as it is.
        out.push(cat3(marker, " ", cat(spaces(first_lead).as_str(), cur.as_str()).as_str()));
        return;
    }
    let mut i = 0;
    for l in lines.iter() {
        let ld = if i == 0 { first_lead } else { cont };
        out.push(cat3(marker, " ", cat(spaces(ld).as_str(), l.as_str()).as_str()));
        i += 1;
    }
    *carry = Some(Carry { marker: marker.to_string(), indent: cont, text: cur });
}

fn flush(out: &mut Vec<String>, carry: &mut Option<Carry>) {
    if let Some(c) = carry {
        out.push(cat3(c.marker.as_str(), " ", cat(spaces(c.indent).as_str(), c.text.as_str()).as_str()));
    }
    *carry = None;
}

// The // of a line comment ("///", "//!" or "//"), or "" for anything else.
fn line_marker(l: &str) -> &str {
    if l.starts_with("////") { return ""; }
    if l.starts_with("///") { return "///"; }
    if l.starts_with("//!") { return "//!"; }
    if l.starts_with("//") { return "//"; }
    ""
}

// Whether a line is left unwrapped (rustfmt's has_url, is_table_item).
fn no_wrap(t: &str) -> bool {
    if t.contains("https://") || t.contains("http://") || t.contains("ftp://") || t.contains("file://") { return true; }
    let s1 = t.trim_start();
    // A reference link's definition ([name]: url).
    if s1.starts_with("[") {
        if let Some(k) = s1.find("]") {
            let r = &s1[k + 1..];
            if k > 1 && (r.starts_with(":") || r.starts_with(" :")) { return true; }
        }
    }
    // A table row: two | at least.
    s1.starts_with("|") && match s1.rfind('|') { Some(0) | None => false, _ => true }
}

// Whether a line's text is prose for a list item's later lines.
fn plain(body: &str) -> bool { body.len() > 0 && !body.starts_with("```") }

// The width of a list item's marker ("- ", "* ", "> ", "1. "), or 0.
fn list_marker(body: &str) -> usize {
    if body.starts_with("- ") || body.starts_with("* ") || body.starts_with("+ ") || body.starts_with("> ") { return 2; }
    let b = body.as_bytes();
    let mut i = 0;
    while i < b.len() && b[i] >= b'0' && b[i] <= b'9' { i += 1; }
    if i > 0 && i + 1 < b.len() && (b[i] == b'.' || b[i] == b')') && b[i + 1] == b' ' { return i + 2; }
    0
}
