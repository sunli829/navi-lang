//! Item-level checks: ADTs, impls and traits.

use std::collections::HashMap;
use crate::resolve::{self, Def, Crate, Node};
use crate::syntax::ast;
use crate::syntax::ast::Item;
use crate::types::*;
use crate::types::lower::*;
use crate::types::collect::*;

/// Reports whether t counts as defined in crate cr for the orphan rule: a
/// struct or enum of the crate, possibly behind & or &mut, or a dyn type of
/// one of its traits.
fn is_local(t: &Type, cr: &Crate) -> bool {
    match t.kind {
        K_ADT => std::ptr::eq(t.d().krate, cr),
        K_REF => is_local(t.el(), cr),
        K_DYN => t.bounds.len() > 0 && std::ptr::eq(t.bounds[0].trait_def().krate, cr),
        _ => false,
    }
}

/// The type parameter t is, possibly behind & or &mut (fundamental, as
/// Rust's): one no other type covers.
fn uncovered_param(t: &Type) -> Option<&Type> {
    match t.kind {
        K_PARAM => Some(t),
        K_REF => uncovered_param(t.el()),
        _ => None,
    }
}

fn self_desc(s: &ast::SelfParam) -> &str {
    if s.is_ref && s.is_mut { return "&mut self"; }
    if s.is_ref { return "&self"; }
    "self"
}

/// A struct or enum's field types, flattened (for the infinite size check).
struct FieldTypes { def: &mut Def, types: Vec<&Type> }

impl Collector {
    /// Reports duplicate fields and types of infinite size.
    pub fn check_adt(&mut self, d: &mut Def) {
        let ai = self.adt(d);
        self.check_dup_fields(d, &ai.fields);
        for v in ai.variants.iter() { self.check_dup_fields(d, &v.fields); }
        let ft = adt_field_types(ai);
        let mut on_stack: HashMap<u32, bool> = HashMap::new();
        if self.contains_by_value(ft, d, &mut on_stack, 0) {
            self.errorf(d.file, d.pos, `recursive type ${d.name} has infinite size; put the recursive field behind a reference (&${d.name})`.to_string());
        }
    }

    fn check_dup_fields(&mut self, d: &Def, fields: &Vec<&mut Field>) {
        let mut seen: HashMap<String, bool> = HashMap::new();
        for f in fields.iter() {
            if seen.contains_key(&f.name) {
                self.errorf(d.file, f.pos, `field ${f.name} is declared more than once`.to_string());
            }
            seen.insert(f.name.clone(), true);
        }
    }

    /// Reports whether the fields contain target by value (not behind a
    /// reference, pointer or slice).
    fn contains_by_value(&mut self, ft: FieldTypes, target: &Def, on_stack: &mut HashMap<u32, bool>, depth: i32) -> bool {
        if depth > 64 || on_stack.contains_key(&ft.def.id) { return false; }
        on_stack.insert(ft.def.id, true);
        let mut hit = false;
        for t in ft.types.iter() {
            if self.type_contains(*t, target, on_stack, depth) { hit = true; break; }
        }
        on_stack.remove(&ft.def.id);
        hit
    }

    fn type_contains(&mut self, t: &Type, target: &Def, on_stack: &mut HashMap<u32, bool>, depth: i32) -> bool {
        match t.kind {
            K_ADT => {
                if t.d().id == target.id { return true; }
                let inner = self.adt(t.d());
                // Check the definition with these arguments substituted.
                let m = param_map(Some(inner.generics), &t.args);
                let raw = adt_field_types(inner);
                let mut types = Vec::new();
                for x in raw.types.iter() { types.push(subst(self.ctx(), *x, &m, None)); }
                self.contains_by_value(FieldTypes { def: inner.def, types }, target, on_stack, depth + 1)
            }
            K_TUPLE => {
                for e in t.elems.iter() {
                    if self.type_contains(*e, target, on_stack, depth) { return true; }
                }
                false
            }
            K_ARRAY => t.len > 0 && self.type_contains(t.el(), target, on_stack, depth),
            _ => false,
        }
    }

    pub fn check_impl(&mut self, d: &mut Def) {
        let ii = self.impl_info(d);
        let n = impl_decl(d);
        if n.trait_path.is_none() {
            self.check_inherent_impl(d, ii);
            return;
        }
        let itr = match ii.trait_ref { Some(t) => t, None => return }; // the trait path was already reported
        let ti = match self.trait_info(itr.trait_def()) { Some(t) => t, None => return };
        let tn = match &ti.def.node { Node::Item(Item::Trait(x)) => *x, _ => return };
        if tn.is_unsafe && !n.is_unsafe {
            self.errorf(d.file, d.pos, `implementing the unsafe trait ${ti.def.name} requires an unsafe impl`.to_string());
        } else if !tn.is_unsafe && n.is_unsafe {
            self.errorf(d.file, d.pos, `trait ${ti.def.name} is not unsafe, so it cannot have an unsafe impl`.to_string());
        }
        // The orphan rule (Rust's, RFC 2451): a trait of another crate
        // takes a local type among the self type and the trait's arguments,
        // and no type parameter uncovered before the first one (else
        // another crate could write an impl overlapping this one).
        if !d.krate.is_std && !std::ptr::eq(ti.def.krate, d.krate) {
            let mut tys: Vec<&Type> = Vec::new();
            tys.push(ii.self_ty);
            for a in itr.args.iter() { tys.push(*a); }
            let mut local = false;
            for t in tys.iter() {
                if is_local(*t, d.krate) {
                    local = true;
                    break;
                }
                if let Some(p) = uncovered_param(*t) {
                    self.errorf(d.file, d.pos, `type parameter ${p} must be covered by another type when it appears before the first local type (impl ${trait_ref_string(itr)} for ${ii.self_ty}); only traits defined in this crate can be implemented for a type parameter`.to_string());
                    local = true;
                    break;
                }
            }
            if !local {
                self.errorf(d.file, d.pos, `only traits defined in this crate can be implemented for types defined outside of it (impl ${trait_ref_string(itr)} for ${ii.self_ty})`.to_string());
            }
        }
        let tname = itr.trait_def().name.clone();
        for (name, item) in ii.items.iter() {
            let tit = match ti.items.get(name) {
                Some(x) => *x,
                None => {
                    self.errorf(item.file, item.pos, `${name} is not a member of trait ${tname}`.to_string());
                    continue;
                }
            };
            if tit.kind != item.kind {
                self.errorf(item.file, item.pos, `${name} is an ${resolve::def_kind_name(tit.kind)} in trait ${tname}, but an ${resolve::def_kind_name(item.kind)} here`.to_string());
                continue;
            }
            if item.kind == resolve::DEF_ASSOC_FN { self.check_method_shape(*item, tit, itr.trait_def()); }
        }
        let mut missing: Vec<String> = Vec::new();
        for it in ti.order.iter() {
            if ii.items.contains_key(&it.name) || self.has_default(*it) { continue; }
            missing.push(it.name.clone());
        }
        if missing.len() > 0 {
            missing.sort();
            self.errorf(d.file, d.pos, `not all items of trait ${tname} are implemented; missing: ${missing.join(", ")}`.to_string());
        }
    }

    /// Reports whether a trait item has a default (body, value or type).
    fn has_default(&self, it: &Def) -> bool {
        match &it.node {
            Node::Item(Item::Fn(n)) => n.body.is_some(),
            Node::Item(Item::Const(n)) => n.value.is_some(),
            Node::Item(Item::TypeAlias(n)) => n.ty.is_some(),
            _ => false,
        }
    }

    /// Compares the receiver and parameter count of an impl method with the
    /// trait declaration; full signature comparison happens later.
    fn check_method_shape(&mut self, imp: &Def, decl: &Def, trait_def: &Def) {
        let is = fn_decl(imp);
        let ds = fn_decl(decl);
        match (is.self_param, ds.self_param) {
            (None, Some(_)) => {
                self.errorf(imp.file, imp.pos, `method ${imp.name} has a self parameter in trait ${trait_def.name} but not here`.to_string());
                return;
            }
            (Some(_), None) => {
                self.errorf(imp.file, imp.pos, `method ${imp.name} has a self parameter here but not in trait ${trait_def.name}`.to_string());
                return;
            }
            (Some(a), Some(b)) => {
                if a.is_ref != b.is_ref || a.is_ref && a.is_mut != b.is_mut {
                    self.errorf(imp.file, imp.pos, `method ${imp.name} takes ${self_desc(a)} but the declaration in trait ${trait_def.name} takes ${self_desc(b)}`.to_string());
                    return;
                }
            }
            _ => {}
        }
        if is.params.len() != ds.params.len() {
            self.errorf(imp.file, imp.pos, `method ${imp.name} has ${is.params.len()} parameter${plural(is.params.len())} but the declaration in trait ${trait_def.name} has ${ds.params.len()}`.to_string());
        }
    }

    fn check_inherent_impl(&mut self, d: &mut Def, ii: &mut ImplInfo) {
        let t = ii.self_ty;
        match t.kind {
            K_ERROR => {
            }
            K_ADT => {
                if !std::ptr::eq(t.d().krate, d.krate) {
                    self.errorf(d.file, d.pos, `cannot define an inherent impl for ${t}, which is defined in crate ${t.d().krate.name}; use a trait instead`.to_string());
                }
            }
            K_PARAM | K_PROJ | K_OPAQUE => {
                self.errorf(d.file, d.pos, `cannot define an inherent impl for the type parameter ${t}`.to_string());
            }
            _ if !d.krate.is_std => {
                self.errorf(d.file, d.pos, `inherent impls for ${t} can only be defined in std; use a trait instead`.to_string());
            }
            _ => {}
        }
        for (_, it) in ii.items.iter() {
            if it.kind == resolve::DEF_ASSOC_TYPE {
                self.errorf(it.file, it.pos, "associated types are only allowed in trait impls".to_string());
            }
        }
    }

    pub fn check_trait(&mut self, d: &mut Def) {
        let ti = match self.trait_info(d) { Some(t) => t, None => return };
        // Supertrait cycles: the walk stops at repeats, so look for d among
        // its own supertraits.
        let mut cycle = false;
        for s in ti.supers.iter() {
            for t in self.supertraits(*s).iter() {
                if t.trait_def().id == d.id { cycle = true; }
            }
        }
        if cycle {
            self.errorf(d.file, d.pos, `trait ${d.name} is its own supertrait (through a cycle)`.to_string());
        }
    }
}

fn adt_field_types(ai: &mut AdtInfo) -> FieldTypes {
    let mut types = Vec::new();
    for f in ai.fields.iter() { types.push(f.ty); }
    for v in ai.variants.iter() {
        for f in v.fields.iter() { types.push(f.ty); }
    }
    FieldTypes { def: ai.def, types }
}

// --- Signatures as text ------------------------------------------------------

fn qual_name(d: &Def) -> String {
    if let Some(p) = d.parent {
        if p.kind == resolve::DEF_TRAIT { return `${p.name}::${d.name}`.to_string(); }
    }
    d.name.clone()
}

fn bounds_string(bs: &Vec<&TraitRef>) -> String {
    let mut parts: Vec<String> = Vec::new();
    for b in bs.iter() { parts.push(trait_ref_string(*b)); }
    parts.join(" + ")
}

impl Info {
    /// The collected signature of a definition, for tests and dumps ("" for
    /// definitions without a signature).
    pub fn sig_string(&self, d: &Def) -> String {
        let k = d.kind;
        match k {
            resolve::DEF_STRUCT | resolve::DEF_ENUM => {
                return match self.adts.get(&d.id) { Some(ai) => adt_sig(*ai), None => String::new() };
            }
            resolve::DEF_FN | resolve::DEF_ASSOC_FN | resolve::DEF_EXTERN_FN => {
                return match self.fns.get(&d.id) { Some(fs) => self.fn_sig_string(*fs), None => String::new() };
            }
            resolve::DEF_TRAIT => {
                let ti = match self.traits.get(&d.id) { Some(t) => *t, None => return String::new() };
                let mut b = `trait ${d.name}`.to_string();
                write_generics(&mut b, ti.generics);
                if ti.supers.len() > 0 {
                    b.push_str(": ");
                    b.push_str(bounds_string(&ti.supers).as_str());
                }
                write_where(&mut b, ti.generics);
                return b;
            }
            resolve::DEF_IMPL => {
                let ii = match self.impls.get(&d.id) { Some(t) => *t, None => return String::new() };
                let mut b = "impl".to_string();
                write_generics(&mut b, ii.generics);
                b.push(' ');
                if let Some(tr) = ii.trait_ref {
                    b.push_str(trait_ref_string(tr).as_str());
                    b.push_str(" for ");
                }
                b.push_str(type_string(ii.self_ty).as_str());
                write_where(&mut b, ii.generics);
                return b;
            }
            resolve::DEF_TYPE_ALIAS => {
                let ai = match self.aliases.get(&d.id) { Some(t) => *t, None => return String::new() };
                let mut b = `type ${d.name}`.to_string();
                write_generics(&mut b, ai.generics);
                b.push_str(&` = ${ai.ty}`.to_string());
                return b;
            }
            resolve::DEF_ASSOC_TYPE => {
                let ai = match self.assoc.get(&d.id) { Some(t) => *t, None => return String::new() };
                let mut s = `type ${qual_name(d)}`.to_string();
                if ai.bounds.len() > 0 { s.push_str(&`: ${bounds_string(&ai.bounds)}`.to_string()); }
                if let Some(v) = ai.value { s.push_str(&` = ${v}`.to_string()); }
                return s;
            }
            resolve::DEF_CONST | resolve::DEF_ASSOC_CONST => {
                return `const ${qual_name(d)}: ${self.consts[&d.id].ty}`.to_string();
            }
            resolve::DEF_STATIC | resolve::DEF_EXTERN_STATIC => {
                let ci = self.consts[&d.id];
                if ci.is_mut { return `static mut ${d.name}: ${ci.ty}`.to_string(); }
                return `static ${d.name}: ${ci.ty}`.to_string();
            }
            _ => {}
        }
        String::new()
    }

    fn fn_sig_string(&self, fs: &FnSig) -> String {
        let mut b = String::new();
        if fs.abi.len() > 0 { b.push_str(&`extern ${crate::util::quote(fs.abi.as_str())} `.to_string()); }
        if fs.is_const { b.push_str("const "); }
        if fs.is_unsafe { b.push_str("unsafe "); }
        b.push_str(&`fn ${qual_name(fs.def)}`.to_string());
        write_generics(&mut b, fs.generics);
        b.push('(');
        let mut parts: Vec<String> = Vec::new();
        if let Some(s) = fs.self_ty { parts.push(type_string(s)); }
        for p in fs.params.iter() { parts.push(type_string(*p)); }
        b.push_str(parts.join(", ").as_str());
        b.push(')');
        if !same(fs.ret, self.ctx.unit) { b.push_str(&` -> ${fs.ret}`.to_string()); }
        write_where(&mut b, fs.generics);
        b
    }
}

fn adt_sig(ai: &AdtInfo) -> String {
    let mut b = if ai.is_enum { "enum ".to_string() } else { "struct ".to_string() };
    b.push_str(ai.def.name.as_str());
    write_generics(&mut b, ai.generics);
    if !ai.is_enum {
        write_fields(&mut b, ai.kind.clone(), &ai.fields);
        return b;
    }
    b.push_str(" { ");
    let mut i = 0;
    while i < ai.variants.len() {
        let v = ai.variants[i];
        if i > 0 { b.push_str(", "); }
        b.push_str(v.def.name.as_str());
        write_fields(&mut b, v.kind.clone(), &v.fields);
        if v.kind == ast::StructKind::Unit { b.push_str(&` = ${v.discr}`.to_string()); }
        i += 1;
    }
    b.push_str(" }");
    b
}

fn write_fields(b: &mut String, kind: ast::StructKind, fields: &Vec<&mut Field>) {
    let mut parts: Vec<String> = Vec::new();
    match kind {
        ast::StructKind::Tuple => {
            for f in fields.iter() { parts.push(type_string(f.ty)); }
            b.push('(');
            b.push_str(parts.join(", ").as_str());
            b.push(')');
        }
        ast::StructKind::Named => {
            for f in fields.iter() { parts.push(`${f.name}: ${f.ty}`.to_string()); }
            b.push_str(" { ");
            b.push_str(parts.join(", ").as_str());
            b.push_str(" }");
        }
        ast::StructKind::Unit => {}
    }
}

/// The item's own parameters with their simple bounds.
fn write_generics(b: &mut String, g: &Generics) {
    if g.params.len() == 0 { return; }
    b.push('<');
    let mut i = 0;
    while i < g.params.len() {
        let p = g.params[i];
        if i > 0 { b.push_str(", "); }
        b.push_str(p.def.name.as_str());
        let mut bounds: Vec<&TraitRef> = Vec::new();
        for pr in g.preds.iter() {
            if same_opt(pr.trait_ref.self_ty, Some(p.ty)) { bounds.push(pr.trait_ref); }
        }
        if bounds.len() > 0 {
            b.push_str(": ");
            b.push_str(bounds_string(&bounds).as_str());
        }
        if let Some(dt) = p.default { b.push_str(&` = ${dt}`.to_string()); }
        i += 1;
    }
    b.push('>');
}

/// Predicates whose self type is not one of the item's own parameters.
fn write_where(b: &mut String, g: &Generics) {
    let mut own: HashMap<u32, bool> = HashMap::new();
    for p in g.params.iter() { own.insert(p.ty.id, true); }
    let mut parts: Vec<String> = Vec::new();
    for pr in g.preds.iter() {
        let s = pr.trait_ref.self_ty.unwrap();
        if own.contains_key(&s.id) { continue; }
        parts.push(`${s}: ${trait_ref_string(pr.trait_ref)}`.to_string());
    }
    if parts.len() > 0 {
        b.push_str(" where ");
        b.push_str(parts.join(", ").as_str());
    }
}
