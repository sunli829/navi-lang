//! Method lookup and method calls.

use std::collections::HashMap;
use crate::resolve::{self, Def};
use crate::syntax::ast::{Expr, Name, GenericArgs};
use crate::syntax::source::Pos;
use crate::types::*;
use crate::types::lower::*;
use crate::types::collect::*;
use crate::types::infer::*;
use crate::types::body::*;
use crate::types::solve::*;
use crate::types::path::own_generics;

/// The result of method lookup.
pub struct MethodPick {
    pub def: &mut Def,
    /// The inherent or trait impl owning def (none for trait methods).
    pub impl_info: Option<&mut ImplInfo>,
    /// The trait, for trait methods.
    pub trait_d: Option<&mut Def>,
    /// The receiver type after autoderef.
    pub step: Option<&Type>,
    pub derefs: i32,
    /// 0, 1 (&), 2 (&mut).
    pub autoref: i32,
    pub unsize: bool,
}

fn pick(def: &mut Def, impl_info: Option<&mut ImplInfo>, trait_def: Option<&mut Def>) -> &mut MethodPick {
    &mut MethodPick { def, impl_info, trait_d: trait_def, step: None, derefs: 0, autoref: 0, unsize: false }
}

impl FnCtx {
    /// Finds the method name for a receiver of type recv, following Rust's
    /// probe order: for each autoderef step, by value, then &, then &mut;
    /// inherent methods before trait methods.
    pub fn lookup_method(&mut self, recv: &Type, name: &str, pos: Pos) -> Option<&mut MethodPick> {
        let mut steps = self.autoderef(recv, false);
        let last = self.inf.shallow(steps[steps.len() - 1]);
        let mut unsized = -1i32;
        if last.kind == K_ARRAY {
            steps.push(self.ctx().slice(last.el()));
            unsized = steps.len() as i32 - 1;
        }
        // x.clone() with x: &T or &mut T clones the T. References are Clone
        // in navi (for bounds and derives), but x.clone() of a T without
        // Clone is an error (Rust: &mut T is not Clone, rustc warns for &T).
        let clone_trait = self.lang("Clone");
        let mut held: Option<&mut MethodPick> = None;
        let mut i = 0;
        while i < steps.len() {
            let s = self.inf.shallow(steps[i]);
            if s.kind == K_INFER && self.inf.vars[s.var as usize].kind == VAR_GENERAL { return self.clone_of_ref(held, pos); }
            let mut autoref = 0;
            while autoref <= 2 {
                let adjusted = if autoref == 1 { self.ctx().reference(false, s) } else if autoref == 2 { self.ctx().reference(true, s) } else { s };
                if let Some(p) = self.method_at(adjusted, s, name, pos) {
                    p.step = Some(s);
                    p.derefs = i as i32;
                    p.autoref = autoref;
                    if i as i32 == unsized {
                        p.derefs = i as i32 - 1;
                        p.unsize = true;
                    }
                    let of_ref_mut = s.kind == K_REF && autoref > 0 && held.is_none();
                    let is_clone = match (p.trait_d, clone_trait) {
                        (Some(t), Some(c)) => t.id == c.id,
                        _ => false,
                    };
                    if of_ref_mut && is_clone {
                        held = Some(p);
                        break;
                    }
                    return Some(p);
                }
                autoref += 1;
            }
            i += 1;
        }
        self.clone_of_ref(held, pos)
    }

    // The clone of a reference whose target has no Clone: an error (the
    // pick is kept so that no more errors follow).
    fn clone_of_ref(&mut self, held: Option<&mut MethodPick>, pos: Pos) -> Option<&mut MethodPick> {
        if let Some(p) = &held {
            let r = self.inf.resolve(p.step.unwrap());
            let t = r.el();
            if r.kind != K_ERROR && t.kind != K_ERROR && !has_infer(r) {
                self.errorf(pos, `${t} does not implement Clone, so ${r} cannot be cloned (copy the reference by assigning it)`.to_string());
            }
        }
        held
    }

    fn try_recv(&mut self, fs: &FnSig, m: &ParamMap, self_ty: &Type, adjusted: &Type) -> bool {
        let st = match fs.self_ty { Some(s) => s, None => return false };
        let t = subst(self.ctx(), st, m, Some(self_ty));
        let r = self.normalize(t);
        self.inf.unify(r, adjusted)
    }

    /// Finds a method whose receiver type matches adjusted. base is the step
    /// type without autoref (used to find inherent impls and traits).
    fn method_at(&mut self, adjusted: &Type, base: &Type, name: &str, pos: Pos) -> Option<&mut MethodPick> {
        // The type that owns the method is the receiver without references.
        let mut owner = base;
        loop {
            let o = self.inf.shallow(owner);
            if o.kind != K_REF {
                owner = o;
                break;
            }
            owner = o.el();
        }
        let key = name.to_string();
        let mut cands = Vec::new();
        cands.push(owner);
        cands.push(base);
        for cand in cands.iter() {
            for ii in self.c.inherent_impls(*cand).iter() {
                let it = match ii.items.get(&key) { Some(i) => *i, None => continue };
                if it.kind != resolve::DEF_ASSOC_FN { continue; }
                let fs = self.c.fn_sig(it);
                let snap = self.inf.snapshot();
                let (m, _) = self.instantiate(ii.generics);
                let st = subst(self.ctx(), ii.self_ty, &m, None);
                let self_ty = self.normalize(st);
                let ok = self.try_recv(fs, &m, self_ty, adjusted);
                self.inf.rollback(snap);
                if ok { return Some(pick(it, Some(*ii), None)); }
            }
        }
        let mut picks: Vec<&mut MethodPick> = Vec::new();
        for td in self.candidate_traits(owner).iter() {
            let ti = self.c.trait_info(*td).unwrap();
            let it = match ti.items.get(&key) { Some(i) => *i, None => continue };
            if it.kind != resolve::DEF_ASSOC_FN { continue; }
            let fs = self.c.fn_sig(it);
            let snap = self.inf.snapshot();
            let self_ty = self.inf.fresh();
            let (m, vars) = self.instantiate(own_generics(ti.generics.params));
            let tr = &TraitRef { tdef: Some(*td), self_ty: Some(self_ty), args: vars, bindings: Vec::new() };
            let ok = self.try_recv(fs, &m, self_ty, adjusted) && self.holds(tr) != SEL_NO;
            self.inf.rollback(snap);
            if ok { picks.push(pick(it, None, Some(*td))); }
        }
        if picks.len() > 1 {
            let a = picks[0].trait_d.unwrap().name.clone();
            let b = picks[1].trait_d.unwrap().name.clone();
            self.errorf(pos, `multiple applicable methods named ${name} (from traits ${a} and ${b}); call it as Trait::${name}(...)`.to_string());
        }
        if picks.len() > 0 { return Some(picks[0]); }
        None
    }

    /// Type-checks recv.name::<T>(args).
    pub fn method_call(&mut self, x: &Expr, recv_x: &Expr, name: &Name, type_args: Option<&GenericArgs>, call_args: &Vec<&Expr>) -> &Type {
        let recv = self.infer(recv_x, None);
        self.solve_pending(false);
        let mname = name.value.clone();
        let p = match self.lookup_method(recv, mname.as_str(), name.pos) {
            Some(p) => p,
            None => {
                let r = self.inf.resolve(recv);
                if r.kind != K_ERROR {
                    if has_infer(r) {
                        self.errorf(name.pos, `type annotations needed: the type of the receiver of ${mname} must be known`.to_string());
                    } else if self.has_field(r, mname.as_str()) {
                        self.errorf(name.pos, `${mname} is a field, not a method; to call a function stored in a field write (expr.${mname})(...)`.to_string());
                    } else {
                        self.errorf(name.pos, `no method named ${mname} found for ${r}`.to_string());
                    }
                }
                for a in call_args.iter() { self.infer(*a, None); }
                return self.ctx().err;
            }
        };
        let accessible = match self.module { Some(m) => p.def.vis.accessible_from(m), None => true };
        if !accessible { self.errorf(name.pos, `method ${mname} is private`.to_string()); }
        let st = self.inf.shallow(p.step.unwrap());
        if st.kind == K_DYN && p.trait_d.is_some() && !self.c.dyn_callable(p.def) {
            self.errorf(name.pos, `method ${mname} cannot be called on dyn ${st.bounds[0].trait_def().name}: it is generic, takes self by value or mentions Self`.to_string());
        }
        let fs = self.c.fn_sig(p.def);
        let mut m: ParamMap = HashMap::new();
        let mut args: Vec<&Type> = Vec::new();
        let mut self_ty: &Type = self.ctx().err;
        if let Some(ii) = p.impl_info {
            let (om, vars) = self.instantiate(ii.generics);
            for (k, v) in om.iter() { m.insert(*k, *v); }
            for v in vars.iter() { args.push(*v); }
            let t = subst(self.ctx(), ii.self_ty, &om, None);
            self_ty = self.normalize(t);
            let g = &mut Generics { parent: None, params: Vec::new(), preds: ii.generics.all_preds(), self_trait: None };
            self.require_preds(g, &om, None, x.pos());
        } else {
            let td = p.trait_d.unwrap();
            let ti = self.c.trait_info(td).unwrap();
            self_ty = self.inf.fresh();
            let (tm, vars) = self.instantiate(own_generics(ti.generics.params));
            for (k, v) in tm.iter() { m.insert(*k, *v); }
            for v in vars.iter() { args.push(*v); }
            let tr = &TraitRef { tdef: Some(td), self_ty: Some(self_ty), args: vars, bindings: Vec::new() };
            self.require(tr, x.pos());
        }
        let (own, vars) = self.instantiate(own_generics(fs.generics.params));
        for (k, v) in own.iter() { m.insert(*k, *v); }
        for v in vars.iter() { args.push(*v); }
        self.explicit_args(&fs.generics.params, type_args, &m, `method ${mname}`.to_string());
        let g = &mut Generics { parent: None, params: Vec::new(), preds: fs.generics.preds, self_trait: None };
        self.require_preds(g, &m, Some(self_ty), x.pos());

        let rt = subst(self.ctx(), fs.self_ty.unwrap(), &m, Some(self_ty));
        let recv_ty = self.normalize(rt);
        let step = p.step.unwrap();
        let mut adjusted = step;
        match p.autoref {
            1 => {
                adjusted = self.ctx().reference(false, step);
            }
            2 => {
                adjusted = self.ctx().reference(true, step);
                self.check_mut_place(recv_x, p.derefs, "borrow as mutable", name.pos);
            }
            _ => {}
        }
        if !self.inf.unify(recv_ty, adjusted) { self.mismatch(recv_x.pos(), recv_ty, adjusted); }
        let adj = &mut Adjust { derefs: p.derefs, autoref: p.autoref, unsize: p.unsize, to_dyn: None };
        self.set_callee(x, &mut Callee { def: p.def, args, self_ty: Some(self_ty), recv: Some(adj) });
        if fs.is_unsafe { self.require_unsafe(x.pos(), `call to unsafe method ${mname}`.to_string()); }
        if call_args.len() != fs.params.len() {
            self.errorf(name.pos, `method ${mname} takes ${fs.params.len()} argument${plural(fs.params.len())} but ${call_args.len()} were supplied`.to_string());
        }
        let mut i = 0;
        while i < call_args.len() {
            if i < fs.params.len() {
                let t = subst(self.ctx(), fs.params[i], &m, Some(self_ty));
                let nt = self.normalize(t);
                self.check(call_args[i], nt);
            } else {
                self.infer(call_args[i], None);
            }
            i += 1;
        }
        let r = subst(self.ctx(), fs.ret, &m, Some(self_ty));
        self.normalize(r)
    }

    /// Reports whether t (after autoderef) has a field named name.
    pub fn has_field(&mut self, t: &Type, name: &str) -> bool {
        for s0 in self.autoderef(t, false).iter() {
            let s = self.inf.shallow(*s0);
            if s.kind == K_ADT {
                let ai = self.c.adt(s.d());
                for f in ai.fields.iter() {
                    if f.name == name { return true; }
                }
            }
        }
        false
    }
}
