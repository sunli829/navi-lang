//! Inference variables and unification, local to one function body.

use crate::types::*;
use crate::types::lower::visit;

pub type VarKind = u8;
pub const VAR_GENERAL: VarKind = 0;
/// From an integer literal: only integer types.
pub const VAR_INT: VarKind = 1;
/// From a float literal: only float types.
pub const VAR_FLOAT: VarKind = 2;

pub struct VarInfo {
    pub t: &Type,
    pub kind: VarKind,
    pub bound: Option<&Type>,
}

pub struct Infer {
    pub ctx: &mut Ctx,
    pub vars: Vec<&mut VarInfo>,
    /// Variables bound since the start, for rollback.
    undo: Vec<i32>,
}

pub fn new_infer(ctx: &mut Ctx) -> &mut Infer { &mut Infer { ctx, vars: Vec::new(), undo: Vec::new() } }

/// Reports whether t mentions an inference variable.
pub fn has_infer(t: &Type) -> bool {
    let mut found = false;
    visit(t, |x| { if x.kind == K_INFER { found = true; } });
    found
}

impl Infer {
    pub fn new_var(&mut self, kind: VarKind) -> &Type {
        let t = self.ctx.infer_var(self.vars.len() as i32);
        self.vars.push(&mut VarInfo { t, kind, bound: None });
        t
    }

    pub fn fresh(&mut self) -> &Type { self.new_var(VAR_GENERAL) }

    /// Follows bound variables at the top of t.
    pub fn shallow(&self, t: &Type) -> &Type {
        let mut x = t;
        while x.kind == K_INFER {
            match self.vars[x.var as usize].bound {
                None => return x,
                Some(b) => { x = b; }
            }
        }
        x
    }

    pub fn shallow_opt(&self, t: Option<&Type>) -> Option<&Type> {
        match t { Some(x) => Some(self.shallow(x)), None => None }
    }

    pub fn snapshot(&self) -> usize { self.undo.len() }

    pub fn rollback(&mut self, n: usize) {
        while self.undo.len() > n {
            let i = self.undo.pop().unwrap();
            self.vars[i as usize].bound = None;
        }
    }

    fn bind(&mut self, v: &mut VarInfo, t: &Type) {
        v.bound = Some(t);
        self.undo.push(v.t.var);
    }

    /// Reports whether variable v appears in t.
    fn occurs(&mut self, v: i32, t: &Type) -> bool {
        let mut found = false;
        visit(self.resolve(t), |x| { if x.kind == K_INFER && x.var == v { found = true; } });
        found
    }

    /// Replaces bound variables throughout t.
    pub fn resolve(&mut self, t0: &Type) -> &Type {
        let t = self.shallow(t0);
        if !has_infer(t) { return t; }
        match t.kind {
            K_REF => { let e = self.resolve(t.el()); self.ctx.reference(t.is_mut, e) }
            K_PTR => { let e = self.resolve(t.el()); self.ctx.ptr(t.is_mut, e) }
            K_SLICE => { let e = self.resolve(t.el()); self.ctx.slice(e) }
            K_ARRAY => {
                let e = self.resolve(t.el());
                match t.ret {
                    Some(l) => { let ln = self.resolve(l); self.ctx.array_n(e, ln) }
                    None => self.ctx.array(e, t.len),
                }
            }
            K_TUPLE => { let es = self.resolve_list(&t.elems); self.ctx.tuple(es) }
            K_FN => {
                let ps = self.resolve_list(&t.elems);
                let r = self.resolve(t.ret.unwrap());
                self.ctx.func(ps, r, t.abi.as_str())
            }
            K_ADT => { let args = self.resolve_list(&t.args); self.ctx.adt(t.d(), args) }
            K_PROJ => { let tr = self.resolve_trait_ref(t.tr()); self.ctx.proj(t.d(), tr) }
            K_DYN => {
                let mut bs = Vec::new();
                for b in t.bounds.iter() { bs.push(self.resolve_trait_ref(*b)); }
                self.ctx.dyn_(bs)
            }
            K_OPAQUE => {
                let mut bs = Vec::new();
                for b in t.bounds.iter() { bs.push(self.resolve_trait_ref(*b)); }
                if t.args.len() == 0 { return self.ctx.opaque(t.d(), t.index, bs); }
                let args = self.resolve_list(&t.args);
                self.ctx.opaque_args(t.d(), t.index, bs, args)
            }
            _ => t,
        }
    }

    pub fn resolve_opt(&mut self, t: Option<&Type>) -> Option<&Type> {
        match t { Some(x) => Some(self.resolve(x)), None => None }
    }

    pub fn resolve_list(&mut self, ts: &Vec<&Type>) -> Vec<&Type> {
        let mut out = Vec::new();
        for x in ts.iter() { out.push(self.resolve(*x)); }
        out
    }

    pub fn resolve_trait_ref(&mut self, tr: &TraitRef) -> &TraitRef {
        let s = self.resolve_opt(tr.self_ty);
        let args = self.resolve_list(&tr.args);
        let mut bindings = Vec::new();
        for b in tr.bindings.iter() { bindings.push(AssocBinding { name: b.name.clone(), ty: self.resolve(b.ty) }); }
        &TraitRef { tdef: Some(tr.trait_def()), self_ty: s, args, bindings }
    }

    fn unify_all(&mut self, xs: &Vec<&Type>, ys: &Vec<&Type>) -> bool {
        if xs.len() != ys.len() { return false; }
        let mut i = 0;
        while i < xs.len() {
            if !self.unify(xs[i], ys[i]) { return false; }
            i += 1;
        }
        true
    }

    /// Makes a and b equal, binding variables. It returns false (leaving
    /// partial bindings; callers that probe use snapshots) if they cannot be.
    pub fn unify(&mut self, a0: &Type, b0: &Type) -> bool {
        let a = self.shallow(a0);
        let b = self.shallow(b0);
        if same(a, b) { return true; }
        if a.kind == K_ERROR || b.kind == K_ERROR { return true; }
        if a.kind == K_INFER { return self.bind_var(a, b); }
        if b.kind == K_INFER { return self.bind_var(b, a); }
        if a.kind != b.kind { return false; }
        match a.kind {
            K_INT => a.int == b.int,
            K_FLOAT => a.f64 == b.f64,
            K_REF | K_PTR => a.is_mut == b.is_mut && self.unify(a.el(), b.el()),
            K_SLICE => self.unify(a.el(), b.el()),
            K_ARRAY => {
                if a.ret.is_none() && b.ret.is_none() { return a.len == b.len && self.unify(a.el(), b.el()); }
                let la = self.ctx.array_len(a);
                let lb = self.ctx.array_len(b);
                self.unify(la, lb) && self.unify(a.el(), b.el())
            }
            K_CONST => a.len == b.len,
            K_TUPLE => self.unify_all(&a.elems, &b.elems),
            K_FN => a.abi == b.abi && self.unify_all(&a.elems, &b.elems) && self.unify(a.ret.unwrap(), b.ret.unwrap()),
            K_ADT => a.d().id == b.d().id && self.unify_all(&a.args, &b.args),
            K_PROJ => a.d().id == b.d().id && self.unify_trait_ref(a.tr(), b.tr()),
            K_DYN => {
                if a.bounds.len() != b.bounds.len() { return false; }
                let mut i = 0;
                while i < a.bounds.len() {
                    if !self.unify_trait_ref(a.bounds[i], b.bounds[i]) { return false; }
                    i += 1;
                }
                true
            }
            K_OPAQUE => {
                if a.d().id != b.d().id || a.index != b.index || a.args.len() != b.args.len() { return false; }
                let mut i = 0;
                while i < a.args.len() {
                    if !self.unify(a.args[i], b.args[i]) { return false; }
                    i += 1;
                }
                true
            }
            _ => false, // distinct params, or other mismatches
        }
    }

    pub fn unify_trait_ref(&mut self, a: &TraitRef, b: &TraitRef) -> bool {
        if a.trait_def().id != b.trait_def().id || a.args.len() != b.args.len() { return false; }
        if a.self_ty.is_none() != b.self_ty.is_none() { return false; }
        if let Some(s) = a.self_ty {
            if !self.unify(s, b.self_ty.unwrap()) { return false; }
        }
        if !self.unify_all(&a.args, &b.args) { return false; }
        if a.bindings.len() != b.bindings.len() { return false; }
        let mut i = 0;
        while i < a.bindings.len() {
            if a.bindings[i].name != b.bindings[i].name || !self.unify(a.bindings[i].ty, b.bindings[i].ty) { return false; }
            i += 1;
        }
        true
    }

    fn bind_var(&mut self, v: &Type, t: &Type) -> bool {
        let vi = self.vars[v.var as usize];
        if t.kind == K_INFER {
            let ti = self.vars[t.var as usize];
            // Merge literal kinds: the more specific kind wins.
            if vi.kind == VAR_GENERAL {
                self.bind(vi, t);
                return true;
            }
            if ti.kind == VAR_GENERAL {
                self.bind(ti, v);
                return true;
            }
            if vi.kind == ti.kind {
                self.bind(vi, t);
                return true;
            }
            return false;
        }
        if vi.kind == VAR_INT && t.kind != K_INT { return false; }
        if vi.kind == VAR_FLOAT && t.kind != K_FLOAT { return false; }
        if self.occurs(v.var, t) { return false; }
        self.bind(vi, t);
        true
    }

    /// Runs f and rolls back any bindings it made, returning f's result.
    pub fn probe(&mut self, f: fn() -> bool) -> bool {
        let snap = self.snapshot();
        let ok = f();
        self.rollback(snap);
        ok
    }

    /// Unifies a and b, rolling back on failure.
    pub fn try_unify(&mut self, a: &Type, b: &Type) -> bool {
        let snap = self.snapshot();
        if self.unify(a, b) { return true; }
        self.rollback(snap);
        false
    }

    /// The literal kind of an unresolved variable.
    pub fn var_kind_of(&self, t: &Type) -> Option<VarKind> {
        let x = self.shallow(t);
        if x.kind != K_INFER { return None; }
        Some(self.vars[x.var as usize].kind)
    }
}
