//! Types: their representation, lowering of type syntax, signature
//! collection and body type checking.

pub mod lower;
pub mod collect;
pub mod check;
pub mod infer;
pub mod solve;
pub mod builtin;
pub mod body;
pub mod expr;
pub mod coerce;
pub mod path;
pub mod method;
pub mod pat;
pub mod exhaustive;
pub mod coherence;
pub mod consteval;
pub mod query;
pub mod dump;

use std::collections::HashMap;
use std::sync::Mutex;
use crate::resolve::{self, Def, Visibility};
use crate::syntax::ast::StructKind;
use crate::syntax::source::Pos;

pub type Kind = u8;
pub const K_ERROR: Kind = 0;
pub const K_BOOL: Kind = 1;
pub const K_CHAR: Kind = 2;
pub const K_STR: Kind = 3;
pub const K_INT: Kind = 4;
pub const K_FLOAT: Kind = 5;
pub const K_NEVER: Kind = 6;
pub const K_TUPLE: Kind = 7;
pub const K_REF: Kind = 8;
pub const K_PTR: Kind = 9;
pub const K_SLICE: Kind = 10;
pub const K_ARRAY: Kind = 11;
pub const K_FN: Kind = 12;
pub const K_ADT: Kind = 13;
pub const K_PARAM: Kind = 14;
pub const K_PROJ: Kind = 15;
pub const K_DYN: Kind = 16;
pub const K_OPAQUE: Kind = 17;
pub const K_INFER: Kind = 18;
/// The value of a const generic argument (len holds it).
pub const K_CONST: Kind = 19;

pub type IntKind = u8;
pub const I8: IntKind = 0;
pub const I16: IntKind = 1;
pub const I32: IntKind = 2;
pub const I64: IntKind = 3;
pub const ISIZE: IntKind = 4;
pub const U8: IntKind = 5;
pub const U16: IntKind = 6;
pub const U32: IntKind = 7;
pub const U64: IntKind = 8;
pub const USIZE: IntKind = 9;
pub const I128: IntKind = 10;
pub const U128: IntKind = 11;
/// The number of integer kinds.
pub const NUM_INTS: IntKind = 12;

const INT_NAMES: [&str; 12] = ["i8", "i16", "i32", "i64", "isize", "u8", "u16", "u32", "u64", "usize", "i128", "u128"];

pub fn int_name(k: IntKind) -> &str { INT_NAMES[k as usize] }
pub fn int_signed(k: IntKind) -> bool { k <= ISIZE || k == I128 }

/// An interned type: two interned types are equal iff they are the same
/// object (inference variables are not interned).
pub struct Type {
    pub id: u32,
    pub kind: Kind,
    pub int: IntKind,
    pub f64: bool,
    pub is_mut: bool,
    pub elem: Option<&Type>,
    pub len: i64,
    pub elems: Vec<&Type>,
    pub ret: Option<&Type>,
    pub abi: String,
    pub def: Option<&mut Def>,
    pub args: Vec<&Type>,
    pub is_self: bool,
    pub trait_ref: Option<&TraitRef>,
    pub bounds: Vec<&TraitRef>,
    pub index: i32,
    pub var: i32,
}

pub fn same(a: &Type, b: &Type) -> bool { std::ptr::eq(a, b) }

pub fn same_opt(a: Option<&Type>, b: Option<&Type>) -> bool {
    match (a, b) {
        (Some(x), Some(y)) => same(x, y),
        (None, None) => true,
        _ => false,
    }
}

pub fn same_list(a: &Vec<&Type>, b: &Vec<&Type>) -> bool {
    if a.len() != b.len() { return false; }
    let mut i = 0;
    while i < a.len() {
        if !same(a[i], b[i]) { return false; }
        i += 1;
    }
    true
}

impl Type {
    pub fn el(&self) -> &Type { self.elem.unwrap() }
    pub fn d(&self) -> &mut Def { self.def.unwrap() }
    pub fn tr(&self) -> &TraitRef { self.trait_ref.unwrap() }
}

// Shared empty lists and string for the fields a type does not use (types
// are never changed after creation, so sharing them is safe and saves three
// allocations per type built).
static NO_TYPES: Vec<&Type> = Vec::new();
static NO_BOUNDS: Vec<&TraitRef> = Vec::new();
static NO_ABI: String = String::new();

fn blank(kind: Kind) -> Type {
    Type { id: 0, kind, int: 0, f64: false, is_mut: false, elem: None, len: 0, elems: NO_TYPES, ret: None,
        abi: NO_ABI, def: None, args: NO_TYPES, is_self: false, trait_ref: None, bounds: NO_BOUNDS, index: 0, var: 0 }
}

/// A reference to a trait with its self type and generic arguments; the
/// bindings carry `Item = T` constraints.
pub struct TraitRef {
    pub tdef: Option<&mut Def>,
    pub self_ty: Option<&Type>,
    pub args: Vec<&Type>,
    pub bindings: Vec<AssocBinding>,
}

#[derive(Clone)]
pub struct AssocBinding {
    pub name: String,
    pub ty: &Type,
}

impl TraitRef {
    pub fn trait_def(&self) -> &mut Def { self.tdef.unwrap() }
}

pub fn trait_ref(trait_def: &mut Def, self_ty: Option<&Type>, args: Vec<&Type>) -> &TraitRef {
    &TraitRef { tdef: Some(trait_def), self_ty, args, bindings: Vec::new() }
}

/// Interns types: structurally equal types (by kind and the ids of their
/// parts) are the same object.
pub struct Ctx {
    // The interned types in SHARDS tables by hash, each with its own lock
    // (taken only while par: several threads intern). A type's id is its
    // shard plus SHARDS + 1 times a count in the shard; inference variables
    // use the remainder SHARDS.
    shards: Vec<HashMap<u64, Vec<&Type>>>,
    counts: Vec<u32>,
    locks: Vec<&Mutex<u8>>,
    pub par: bool,
    pub bool_: &Type,
    pub char_: &Type,
    pub str_: &Type,
    pub never: &Type,
    pub unit: &Type,
    pub err: &Type,
    pub f32: &Type,
    pub f64: &Type,
    pub ints: Vec<&Type>,
}

fn mix(h: u64, v: u64) -> u64 { (h.rotate_left(5) ^ v).wrapping_mul(0x517cc1b727220a95) }

fn hash_list(h0: u64, ts: &Vec<&Type>) -> u64 {
    let mut h = mix(h0, ts.len() as u64);
    for t in ts.iter() { h = mix(h, t.id as u64); }
    h
}

fn hash_trait_ref(h0: u64, tr: &TraitRef) -> u64 {
    let mut h = mix(h0, tr.trait_def().id as u64);
    h = mix(h, match tr.self_ty { Some(s) => s.id as u64, None => 0 });
    h = hash_list(h, &tr.args);
    for b in tr.bindings.iter() {
        for c in b.name.bytes() { h = mix(h, c as u64); }
        h = mix(h, b.ty.id as u64);
    }
    h
}

/// The hash of the identity of t (consistent with type_eq).
fn hash_type(t: &Type) -> u64 {
    let h = mix(0, t.kind as u64);
    match t.kind {
        K_INT => mix(h, t.int as u64),
        K_FLOAT => mix(h, if t.f64 { 1 } else { 0 }),
        K_REF | K_PTR => mix(mix(h, if t.is_mut { 1 } else { 0 }), t.el().id as u64),
        K_SLICE => mix(h, t.el().id as u64),
        K_ARRAY => {
            let ha = mix(mix(h, t.el().id as u64), t.len as u64);
            match t.ret { Some(l) => mix(ha, l.id as u64), None => ha }
        }
        K_CONST => mix(h, t.len as u64),
        K_TUPLE => hash_list(h, &t.elems),
        K_FN => {
            let mut hf = h;
            for c in t.abi.bytes() { hf = mix(hf, c as u64); }
            hf = hash_list(hf, &t.elems);
            mix(hf, match t.ret { Some(r) => r.id as u64, None => 0 })
        }
        K_ADT => hash_list(mix(h, t.d().id as u64), &t.args),
        K_PARAM => mix(mix(h, t.d().id as u64), if t.is_self { 1 } else { 0 }),
        K_PROJ => hash_trait_ref(mix(h, t.d().id as u64), t.tr()),
        K_DYN | K_OPAQUE => {
            let mut hd = mix(h, t.index as u64);
            if let Some(d) = t.def { hd = mix(hd, d.id as u64); }
            for b in t.bounds.iter() { hd = hash_trait_ref(hd, *b); }
            hash_list(hd, &t.args)
        }
        _ => h,
    }
}

fn list_eq(a: &Vec<&Type>, b: &Vec<&Type>) -> bool { same_list(a, b) }

fn trait_ref_eq(a: &TraitRef, b: &TraitRef) -> bool {
    if a.trait_def().id != b.trait_def().id || !same_opt(a.self_ty, b.self_ty) || !list_eq(&a.args, &b.args) { return false; }
    if a.bindings.len() != b.bindings.len() { return false; }
    let mut i = 0;
    while i < a.bindings.len() {
        if a.bindings[i].name != b.bindings[i].name || !same(a.bindings[i].ty, b.bindings[i].ty) { return false; }
        i += 1;
    }
    true
}

/// Whether a and b have the same identity (the old string key).
fn type_eq(a: &Type, b: &Type) -> bool {
    if a.kind != b.kind { return false; }
    match a.kind {
        K_INT => a.int == b.int,
        K_FLOAT => a.f64 == b.f64,
        K_REF | K_PTR => a.is_mut == b.is_mut && same(a.el(), b.el()),
        K_SLICE => same(a.el(), b.el()),
        K_ARRAY => a.len == b.len && same(a.el(), b.el()) && same_opt(a.ret, b.ret),
        K_CONST => a.len == b.len,
        K_TUPLE => list_eq(&a.elems, &b.elems),
        K_FN => {
            let ra = match a.ret { Some(r) => r.id, None => 0 };
            let rb = match b.ret { Some(r) => r.id, None => 0 };
            a.abi == b.abi && ra == rb && list_eq(&a.elems, &b.elems)
        }
        K_ADT => a.d().id == b.d().id && list_eq(&a.args, &b.args),
        K_PARAM => a.d().id == b.d().id && a.is_self == b.is_self,
        K_PROJ => a.d().id == b.d().id && trait_ref_eq(a.tr(), b.tr()),
        K_DYN | K_OPAQUE => {
            if a.index != b.index { return false; }
            let da = match a.def { Some(d) => d.id as i64, None => -1 };
            let db = match b.def { Some(d) => d.id as i64, None => -1 };
            if da != db || a.bounds.len() != b.bounds.len() || !list_eq(&a.args, &b.args) { return false; }
            let mut i = 0;
            while i < a.bounds.len() {
                if !trait_ref_eq(a.bounds[i], b.bounds[i]) { return false; }
                i += 1;
            }
            true
        }
        _ => true,
    }
}

const SHARDS: usize = 256;

pub fn new_ctx() -> &mut Ctx {
    let mut shards: Vec<HashMap<u64, Vec<&Type>>> = Vec::new();
    let mut counts: Vec<u32> = Vec::new();
    let mut locks: Vec<&Mutex<u8>> = Vec::new();
    let mut i = 0;
    while i <= SHARDS {
        shards.push(HashMap::new());
        counts.push(0);
        locks.push(&Mutex::new(0u8));
        i += 1;
    }
    let x = &blank(K_ERROR);
    let cx = &mut Ctx { shards, counts, locks, par: false, bool_: x, char_: x, str_: x, never: x, unit: x, err: x, f32: x, f64: x,
        ints: Vec::new() };
    cx.err = cx.intern(blank(K_ERROR));
    cx.bool_ = cx.intern(blank(K_BOOL));
    cx.char_ = cx.intern(blank(K_CHAR));
    cx.str_ = cx.intern(blank(K_STR));
    cx.never = cx.intern(blank(K_NEVER));
    cx.unit = cx.intern(blank(K_TUPLE));
    cx.f32 = cx.intern(blank(K_FLOAT));
    cx.f64 = cx.intern(Type { f64: true, ..blank(K_FLOAT) });
    let mut k = 0u8;
    while k < NUM_INTS {
        let t = cx.intern(Type { int: k, ..blank(K_INT) });
        cx.ints.push(t);
        k += 1;
    }
    cx
}

fn types_key(ts: &Vec<&Type>) -> String {
    let mut b = String::new();
    let mut i = 0;
    while i < ts.len() {
        if i > 0 { b.push(','); }
        b.push_str(&`${ts[i].id}`);
        i += 1;
    }
    b
}

pub fn trait_key(tr: Option<&TraitRef>) -> String {
    match tr {
        None => "-".to_string(),
        Some(t) => {
            let self_key = match t.self_ty { Some(s) => `${s.id}`, None => "-".to_string() };
            let mut b = `${t.trait_def().id}:${self_key}<${types_key(&t.args)}>`;
            for bd in t.bindings.iter() { b.push_str(&`{${bd.name}=${bd.ty.id}}`); }
            b
        }
    }
}

impl Ctx {
    fn intern(&mut self, t: Type) -> &Type {
        let h = hash_type(&t);
        let sh = (h % SHARDS as u64) as usize;
        if !self.par { return self.intern_in(sh, h, t); }
        // While threads share the table the new type is made outside the
        // lock (allocating may take long), then the lookup repeated.
        self.locks[sh].lock();
        let found = self.lookup_in(sh, h, &t);
        self.locks[sh].unlock();
        if let Some(o) = found { return o; }
        let r = &mut Type { id: 0, ..t };
        let fresh: Vec<&Type> = Vec::with_capacity(1);
        self.locks[sh].lock();
        if let Some(o) = self.lookup_in(sh, h, &t) {
            self.locks[sh].unlock();
            return o;
        }
        self.counts[sh] += 1;
        r.id = sh as u32 + (SHARDS as u32 + 1) * self.counts[sh];
        let mut types = self.shards[sh];
        if !types.contains_key(&h) { types.insert(h, fresh); }
        let mut bucket = types[&h];
        bucket.push(r);
        self.locks[sh].unlock();
        r
    }

    fn lookup_in(&self, sh: usize, h: u64, t: &Type) -> Option<&Type> {
        if let Some(bucket) = self.shards[sh].get(&h) {
            for old in bucket.iter() {
                if type_eq(t, *old) { return Some(*old); }
            }
        }
        None
    }

    fn intern_in(&mut self, sh: usize, h: u64, t: Type) -> &Type {
        if let Some(o) = self.lookup_in(sh, h, &t) { return o; }
        self.counts[sh] += 1;
        let r = &Type { id: sh as u32 + (SHARDS as u32 + 1) * self.counts[sh], ..t };
        let mut types = self.shards[sh];
        if !types.contains_key(&h) { types.insert(h, Vec::new()); }
        let mut bucket = types[&h];
        bucket.push(r);
        r
    }

    pub fn int(&self, k: IntKind) -> &Type { self.ints[k as usize] }
    pub fn usize_(&self) -> &Type { self.ints[USIZE as usize] }

    pub fn reference(&mut self, is_mut: bool, elem: &Type) -> &Type {
        self.intern(Type { is_mut, elem: Some(elem), ..blank(K_REF) })
    }
    pub fn ptr(&mut self, is_mut: bool, elem: &Type) -> &Type {
        self.intern(Type { is_mut, elem: Some(elem), ..blank(K_PTR) })
    }
    pub fn slice(&mut self, elem: &Type) -> &Type { self.intern(Type { elem: Some(elem), ..blank(K_SLICE) }) }
    pub fn array(&mut self, elem: &Type, n: i64) -> &Type { self.intern(Type { elem: Some(elem), len: n, ..blank(K_ARRAY) }) }
    /// The value of a const generic argument.
    pub fn const_val(&mut self, v: i64) -> &Type { self.intern(Type { len: v, ..blank(K_CONST) }) }
    /// An array whose length is the type len: a value (K_CONST) gives a
    /// plain array; a const parameter or inference variable is kept (in
    /// ret, with len -1).
    pub fn array_n(&mut self, elem: &Type, len: &Type) -> &Type {
        if len.kind == K_CONST { return self.array(elem, len.len); }
        if len.kind == K_ERROR { return self.err; }
        self.intern(Type { elem: Some(elem), len: -1, ret: Some(len), ..blank(K_ARRAY) })
    }
    /// The length of an array as a type.
    pub fn array_len(&mut self, t: &Type) -> &Type {
        match t.ret { Some(l) => l, None => self.const_val(t.len) }
    }
    pub fn tuple(&mut self, elems: Vec<&Type>) -> &Type {
        if elems.len() == 0 { return self.unit; }
        self.intern(Type { elems, ..blank(K_TUPLE) })
    }
    pub fn func(&mut self, params: Vec<&Type>, ret: &Type, abi: &str) -> &Type {
        self.intern(Type { elems: params, ret: Some(ret), abi: abi.to_string(), ..blank(K_FN) })
    }
    pub fn adt(&mut self, def: &mut Def, args: Vec<&Type>) -> &Type { self.intern(Type { def: Some(def), args, ..blank(K_ADT) }) }
    pub fn param(&mut self, def: &mut Def) -> &Type { self.intern(Type { def: Some(def), ..blank(K_PARAM) }) }
    pub fn self_param(&mut self, trait_def: &mut Def) -> &Type {
        self.intern(Type { def: Some(trait_def), is_self: true, ..blank(K_PARAM) })
    }
    pub fn proj(&mut self, assoc: &mut Def, tr: &TraitRef) -> &Type {
        self.intern(Type { def: Some(assoc), trait_ref: Some(tr), ..blank(K_PROJ) })
    }
    pub fn dyn_(&mut self, bounds: Vec<&TraitRef>) -> &Type { self.intern(Type { bounds, ..blank(K_DYN) }) }
    pub fn opaque(&mut self, f: &mut Def, index: i32, bounds: Vec<&TraitRef>) -> &Type {
        self.intern(Type { def: Some(f), index, bounds, ..blank(K_OPAQUE) })
    }
    /// The impl Trait a trait method returns, for Self and the generic
    /// arguments in args (each impl's method decides the type).
    pub fn opaque_args(&mut self, f: &mut Def, index: i32, bounds: Vec<&TraitRef>, args: Vec<&Type>) -> &Type {
        self.intern(Type { def: Some(f), index, bounds, args, ..blank(K_OPAQUE) })
    }
    /// A fresh (not interned) inference variable.
    pub fn infer_var(&mut self, var: i32) -> &Type {
        if self.par { self.locks[SHARDS].lock(); }
        self.counts[SHARDS] += 1;
        let id = SHARDS as u32 + (SHARDS as u32 + 1) * self.counts[SHARDS];
        if self.par { self.locks[SHARDS].unlock(); }
        &Type { id, var, ..blank(K_INFER) }
    }
}

// --- Printing --------------------------------------------------------------------

pub fn type_string(t: &Type) -> String {
    let mut b = String::new();
    write_type(&mut b, t);
    b
}

fn write_types(b: &mut String, ts: &Vec<&Type>) {
    let mut i = 0;
    while i < ts.len() {
        if i > 0 { b.push_str(", "); }
        write_type(b, ts[i]);
        i += 1;
    }
}

pub fn write_type(b: &mut String, t: &Type) {
    match t.kind {
        K_ERROR => b.push_str("{error}"),
        K_BOOL => b.push_str("bool"),
        K_CHAR => b.push_str("char"),
        K_STR => b.push_str("str"),
        K_INT => b.push_str(int_name(t.int)),
        K_FLOAT => b.push_str(if t.f64 { "f64" } else { "f32" }),
        K_NEVER => b.push('!'),
        K_TUPLE => {
            b.push('(');
            write_types(b, &t.elems);
            if t.elems.len() == 1 { b.push(','); }
            b.push(')');
        }
        K_REF => {
            b.push('&');
            if t.is_mut { b.push_str("mut "); }
            write_type(b, t.el());
        }
        K_PTR => {
            b.push_str(if t.is_mut { "*mut " } else { "*const " });
            write_type(b, t.el());
        }
        K_SLICE => {
            b.push('[');
            write_type(b, t.el());
            b.push(']');
        }
        K_ARRAY => {
            b.push('[');
            write_type(b, t.el());
            match t.ret {
                Some(l) => {
                    b.push_str("; ");
                    write_type(b, l);
                    b.push(']');
                }
                None => b.push_str(&`; ${t.len}]`),
            }
        }
        K_CONST => b.push_str(&`${t.len}`),
        K_FN => {
            if t.abi.len() > 0 { b.push_str(&`extern ${crate::util::quote(t.abi.as_str())} `); }
            b.push_str("fn(");
            write_types(b, &t.elems);
            b.push(')');
            if let Some(r) = t.ret {
                if !(r.kind == K_TUPLE && r.elems.len() == 0) {
                    b.push_str(" -> ");
                    write_type(b, r);
                }
            }
        }
        K_ADT => {
            b.push_str(t.d().name.as_str());
            if t.args.len() > 0 {
                b.push('<');
                write_types(b, &t.args);
                b.push('>');
            }
        }
        K_PARAM => b.push_str(if t.is_self { "Self" } else { t.d().name.as_str() }),
        K_PROJ => {
            let tr = t.tr();
            let plain = match tr.self_ty { Some(s) => s.kind == K_PARAM && !s.is_self, None => false };
            if plain {
                write_type(b, tr.self_ty.unwrap());
            } else {
                b.push('<');
                if let Some(s) = tr.self_ty { write_type(b, s); }
                b.push_str(" as ");
                b.push_str(trait_ref_string(tr).as_str());
                b.push('>');
            }
            b.push_str("::");
            b.push_str(t.d().name.as_str());
        }
        K_DYN => {
            b.push_str("dyn ");
            write_bounds(b, &t.bounds);
        }
        K_OPAQUE => {
            b.push_str("impl ");
            write_bounds(b, &t.bounds);
        }
        K_INFER => b.push_str(&`?${t.var}`),
        _ => {}
    }
}

fn write_bounds(b: &mut String, bounds: &Vec<&TraitRef>) {
    let mut i = 0;
    while i < bounds.len() {
        if i > 0 { b.push_str(" + "); }
        b.push_str(trait_ref_string(bounds[i]).as_str());
        i += 1;
    }
}

/// The trait part of a trait reference (without Self): Iterator<Item = i32>.
pub fn trait_ref_string(tr: &TraitRef) -> String {
    let mut b = tr.trait_def().name.clone();
    if tr.args.len() > 0 || tr.bindings.len() > 0 {
        b.push('<');
        write_types(&mut b, &tr.args);
        let mut i = 0;
        while i < tr.bindings.len() {
            if i > 0 || tr.args.len() > 0 { b.push_str(", "); }
            b.push_str(tr.bindings[i].name.as_str());
            b.push_str(" = ");
            write_type(&mut b, tr.bindings[i].ty);
            i += 1;
        }
        b.push('>');
    }
    b
}

impl std::fmt::Display for Type {
    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result { f.write_str(type_string(self).as_str()) }
}

// --- Item information ---------------------------------------------------------------

/// The type parameters of an item; associated items have the impl/trait
/// generics as parent.
pub struct Generics {
    pub parent: Option<&mut Generics>,
    pub params: Vec<&mut TypeParam>,
    pub preds: Vec<&Pred>,
    pub self_trait: Option<&mut Def>,
}

pub struct TypeParam {
    pub def: &mut Def,
    pub ty: &Type,
    pub default: Option<&Type>,
}

/// A where-clause predicate `Type: Trait<...>`.
pub struct Pred {
    pub trait_ref: &TraitRef,
}

impl Generics {
    /// The parameters of g and its parents, outermost first.
    pub fn all(&self) -> Vec<&mut TypeParam> {
        let mut out = match self.parent { Some(p) => p.all(), None => Vec::new() };
        for p in self.params.iter() { out.push(*p); }
        out
    }

    pub fn all_preds(&self) -> Vec<&Pred> {
        let mut out = match self.parent { Some(p) => p.all_preds(), None => Vec::new() };
        for p in self.preds.iter() { out.push(*p); }
        out
    }
}

pub fn all_params(g: Option<&mut Generics>) -> Vec<&mut TypeParam> {
    match g { Some(x) => x.all(), None => Vec::new() }
}

pub fn all_preds(g: Option<&mut Generics>) -> Vec<&Pred> {
    match g { Some(x) => x.all_preds(), None => Vec::new() }
}

pub struct Field {
    pub name: String,
    pub ty: &Type,
    pub vis: Visibility,
    pub pos: Pos,
}

pub struct AdtInfo {
    pub def: &mut Def,
    pub generics: &mut Generics,
    pub is_enum: bool,
    pub kind: StructKind,
    pub fields: Vec<&mut Field>,
    pub variants: Vec<&mut VariantInfo>,
}

pub struct VariantInfo {
    pub def: &mut Def,
    pub kind: StructKind,
    pub fields: Vec<&mut Field>,
    pub discr: i64,
}

pub struct FnSig {
    pub def: &mut Def,
    pub generics: &mut Generics,
    pub self_ty: Option<&Type>,
    pub params: Vec<&Type>,
    pub ret: &Type,
    pub abi: String,
    pub is_const: bool,
    pub is_unsafe: bool,
    pub has_body: bool,
    pub opaques: Vec<&Type>,
    pub variadic: bool,
}

pub struct TraitInfo {
    pub def: &mut Def,
    pub generics: &mut Generics,
    pub supers: Vec<&TraitRef>,
    pub items: HashMap<String, &mut Def>,
    pub order: Vec<&mut Def>,
}

pub struct ImplInfo {
    pub def: &mut Def,
    pub generics: &mut Generics,
    pub trait_ref: Option<&TraitRef>,
    pub self_ty: &Type,
    pub items: HashMap<String, &mut Def>,
}

pub struct AssocTypeInfo {
    pub def: &mut Def,
    pub bounds: Vec<&TraitRef>,
    pub value: Option<&Type>,
}

pub struct ConstInfo {
    pub def: &mut Def,
    pub ty: &Type,
    pub is_mut: bool,
}

pub struct AliasInfo {
    pub def: &mut Def,
    pub generics: &mut Generics,
    pub ty: &Type,
}
