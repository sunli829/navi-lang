//! Pattern type checking.

use std::collections::HashMap;
use crate::resolve::{self, Def, Res};
use crate::syntax::ast::{self, Expr, ExprKind, Pat, PatKind, Path};
use crate::syntax::dump::dump_path;
use crate::syntax::source::Pos;
use crate::types::*;
use crate::types::lower::*;
use crate::types::builtin::is_num_t;
use crate::types::body::*;

pub type BindMode = u8;
pub const BY_VALUE: BindMode = 0;
pub const BY_REF: BindMode = 1;
pub const BY_REF_MUT: BindMode = 2;

pub fn is_rest(p: &Pat) -> bool {
    match &p.kind {
        PatKind::Rest(_) => true,
        PatKind::Ident { sub, .. } => match sub { Some(s) => match &s.kind { PatKind::Rest(_) => true, _ => false }, None => false },
        _ => false,
    }
}

pub fn is_plain_rest(p: &Pat) -> bool { match &p.kind { PatKind::Rest(_) => true, _ => false } }

fn has_rest_pat(ps: &Vec<&Pat>) -> bool {
    for p in ps.iter() {
        if is_rest(*p) { return true; }
    }
    false
}

/// A path expression standing for a pattern path (to type it as a value).
fn path_expr(p: &Path) -> &Expr { ast::expr(ExprKind::Path(p)) }

impl FnCtx {
    /// Type-checks a pattern against the type of the value it matches.
    pub fn check_pat(&mut self, p: &Pat, expected: &Type, refutable: bool) {
        self.pat(p, expected, BY_VALUE);
        if !refutable { self.check_irrefutable(p, expected, "this"); }
    }

    /// Match ergonomics: a non-reference pattern matching a reference
    /// matches the referent, and bindings inside bind by reference.
    pub fn peel(&mut self, t0: &Type, mode0: BindMode) -> (&Type, BindMode) {
        let mut t = t0;
        let mut mode = mode0;
        loop {
            let s = self.inf.shallow(t);
            if s.kind != K_REF { return (t, mode); }
            if s.is_mut && mode == BY_VALUE {
                mode = BY_REF_MUT;
            } else if !s.is_mut {
                mode = BY_REF;
            }
            t = s.el();
        }
    }

    fn pat(&mut self, p: &Pat, exp0: &Type, mode0: BindMode) {
        let mut exp = exp0;
        let mut mode = mode0;
        self.set_pat(p, exp);
        match &p.kind {
            PatKind::Wild(_) | PatKind::Rest(_) => return,
            PatKind::Ident { sub, .. } => {
                if let Some(res) = self.info.res.pat_consts.get(&p.id) {
                    let (pe, _) = self.peel(exp, mode);
                    let t = self.const_pat_type(p.pos(), res);
                    if !self.inf.try_unify(t, pe) { self.mismatch(p.pos(), pe, t); }
                    return;
                }
                let mut t = exp;
                match mode {
                    BY_REF => {
                        t = self.ctx().reference(false, exp);
                        self.body.ref_bindings.insert(p.id, true);
                    }
                    BY_REF_MUT => {
                        t = self.ctx().reference(true, exp);
                        self.body.ref_bindings.insert(p.id, true);
                    }
                    _ => {}
                }
                if let Some(l) = self.info.res.bindings.get(&p.id) {
                    match self.body.locals.get(&l.id) {
                        Some(old) => {
                            // The same binding in another alternative of an or-pattern.
                            if !self.inf.try_unify(*old, t) { self.mismatch(p.pos(), *old, t); }
                        }
                        None => self.set_local(*l, t),
                    }
                }
                if let Some(s) = sub { self.pat(*s, exp, mode); }
                return;
            }
            PatKind::Ref { amp, pat } => {
                let mut e = self.inf.shallow(exp);
                if e.kind == K_INFER {
                    let elem = self.inf.fresh();
                    let r = self.ctx().reference(false, elem);
                    self.inf.unify(e, r);
                    e = self.inf.shallow(exp);
                }
                if e.kind != K_REF {
                    if e.kind != K_ERROR {
                        let re = self.inf.resolve(e);
                        self.errorf(*amp, `mismatched types: expected ${re}, found a reference pattern`.to_string());
                    }
                    let err = self.ctx().err;
                    self.pat(*pat, err, BY_VALUE);
                    return;
                }
                self.pat(*pat, e.el(), BY_VALUE);
                return;
            }
            PatKind::Or(alts) => {
                for a in alts.iter() { self.pat(*a, exp, mode); }
                return;
            }
            PatKind::Lit(x) => {
                let lt = self.infer(*x, None);
                // String literal patterns have type &str; match ergonomics stop there.
                loop {
                    if self.inf.try_unify(lt, exp) { return; }
                    let s = self.inf.shallow(exp);
                    if s.kind != K_REF { break; }
                    exp = s.el();
                }
                self.mismatch(p.pos(), exp, lt);
                return;
            }
            _ => {}
        }

        let (pe, pm) = self.peel(exp, mode);
        exp = pe;
        mode = pm;
        let mut e = self.inf.shallow(exp);
        match &p.kind {
            PatKind::Range { lo, hi, .. } => {
                if let Some(x) = lo { self.check(*x, exp); }
                if let Some(x) = hi { self.check(*x, exp); }
                if e.kind != K_INFER && e.kind != K_ERROR && !is_num_t(e) && e.kind != K_CHAR {
                    let re = self.inf.resolve(e);
                    self.errorf(p.pos(), `range patterns can only match numbers and chars, not ${re}`.to_string());
                }
            }
            PatKind::Path(path) => {
                let res = match self.info.res.paths.get(&path.id) { Some(r) => r.clone(), None => resolve::res_err() };
                let mut t = self.const_pat_type(p.pos(), &res);
                let ctor_like = res.kind == resolve::RES_DEF && (res.def.unwrap().kind == resolve::DEF_STRUCT || res.def.unwrap().kind == resolve::DEF_VARIANT);
                if ctor_like || res.rest.len() > 0 {
                    t = self.value_path(path_expr(*path), *path);
                    if self.inf.shallow(t).kind == K_FN {
                        let d = dump_path(*path);
                        self.errorf(p.pos(), `${d} is a tuple struct or variant; write ${d}(..)`.to_string());
                        return;
                    }
                }
                if !self.inf.try_unify(t, exp) { self.mismatch(p.pos(), exp, t); }
            }
            PatKind::TupleStruct { path, elems } => {
                let vt = self.value_path(path_expr(*path), *path);
                let ft = self.inf.shallow(vt);
                if ft.kind == K_ERROR {
                    let err = self.ctx().err;
                    for el in elems.iter() { self.pat(*el, err, mode); }
                    return;
                }
                if ft.kind != K_FN {
                    self.errorf(p.pos(), `${dump_path(*path)} is not a tuple struct or tuple variant`.to_string());
                    return;
                }
                let r = ft.ret.unwrap();
                if !self.inf.try_unify(r, exp) { self.mismatch(p.pos(), exp, r); }
                self.tuple_elems(p.pos(), elems, &ft.elems, mode);
            }
            PatKind::Struct { path, fields: fps, rest } => {
                let (oadt, fields) = self.struct_pat_target(p, *path);
                let adt = match oadt {
                    None => {
                        let err = self.ctx().err;
                        for f in fps.iter() { self.pat(f.pat, err, mode); }
                        return;
                    }
                    Some(a) => a,
                };
                if !self.inf.try_unify(adt, exp) { self.mismatch(p.pos(), exp, adt); }
                let sa = self.inf.shallow(adt);
                let ai = self.c.adt(sa.d());
                let m = param_map(Some(ai.generics), &sa.args);
                let mut seen: HashMap<String, bool> = HashMap::new();
                for fp in fps.iter() {
                    let mut f: Option<&mut Field> = None;
                    for x in fields.iter() {
                        if x.name == fp.name.value { f = Some(*x); }
                    }
                    let fd = match f {
                        None => {
                            self.errorf(fp.name.pos, `${dump_path(*path)} has no field named ${fp.name.value}`.to_string());
                            let err = self.ctx().err;
                            self.pat(fp.pat, err, mode);
                            continue;
                        }
                        Some(fd) => fd,
                    };
                    seen.insert(fd.name.clone(), true);
                    let accessible = match self.module { Some(md) => fd.vis.accessible_from(md), None => true };
                    if !accessible { self.errorf(fp.name.pos, `field ${fd.name} is private`.to_string()); }
                    let ft = subst(self.ctx(), fd.ty, &m, None);
                    let nft = self.normalize(ft);
                    self.pat(fp.pat, nft, mode);
                }
                if !*rest {
                    let mut missing: Vec<String> = Vec::new();
                    for f in fields.iter() {
                        if !seen.contains_key(&f.name) { missing.push(f.name.clone()); }
                    }
                    if missing.len() > 0 {
                        self.errorf(p.pos(), `pattern does not mention field${plural(missing.len())} ${missing.join(", ")}; add them or use ..`.to_string());
                    }
                }
            }
            PatKind::Tuple { elems, .. } => {
                if e.kind == K_INFER {
                    let mut has_rest = false;
                    for el in elems.iter() {
                        if is_plain_rest(*el) { has_rest = true; }
                    }
                    if !has_rest {
                        let mut vars = Vec::new();
                        let mut i = 0;
                        while i < elems.len() { vars.push(self.inf.fresh()); i += 1; }
                        let tt = self.ctx().tuple(vars);
                        self.inf.unify(e, tt);
                        e = self.inf.shallow(exp);
                    }
                }
                if e.kind != K_TUPLE {
                    if e.kind != K_ERROR && e.kind != K_INFER {
                        let re = self.inf.resolve(e);
                        self.errorf(p.pos(), `mismatched types: expected ${re}, found a tuple pattern`.to_string());
                    }
                    let err = self.ctx().err;
                    for el in elems.iter() { self.pat(*el, err, mode); }
                    return;
                }
                self.tuple_elems(p.pos(), elems, &e.elems, mode);
            }
            PatKind::Slice { elems, .. } => {
                let elem: &Type = if e.kind == K_ARRAY || e.kind == K_SLICE {
                    e.el()
                } else if e.kind == K_ERROR || e.kind == K_INFER {
                    self.ctx().err
                } else {
                    let re = self.inf.resolve(e);
                    self.errorf(p.pos(), `mismatched types: expected ${re}, found a slice pattern`.to_string());
                    self.ctx().err
                };
                let mut fixed = 0;
                for el in elems.iter() {
                    if is_rest(*el) {
                        match &el.kind {
                            PatKind::Ident { .. } => {
                                if let Some(l) = self.info.res.bindings.get(&el.id) {
                                    let t = self.ctx().slice(elem);
                                    let rt = self.ctx().reference(mode == BY_REF_MUT, t);
                                    self.set_local(*l, rt);
                                    self.body.ref_bindings.insert(el.id, true);
                                }
                            }
                            _ => {}
                        }
                        continue;
                    }
                    fixed += 1;
                    self.pat(*el, elem, mode);
                }
                if e.kind == K_ARRAY && !has_rest_pat(elems) && fixed as i64 != e.len {
                    self.errorf(p.pos(), `pattern has ${fixed} elements but the array has ${e.len}`.to_string());
                }
            }
            _ => {}
        }
    }

    /// Matches tuple-like subpatterns (with an optional ..) against the
    /// element types.
    fn tuple_elems(&mut self, pos: Pos, elems: &Vec<&Pat>, types: &Vec<&Type>, mode: BindMode) {
        let mut rest = -1i32;
        let mut i = 0;
        while i < elems.len() {
            if is_plain_rest(elems[i]) {
                if rest >= 0 { self.errorf(elems[i].pos(), ".. can only be used once per pattern".to_string()); }
                rest = i as i32;
            }
            i += 1;
        }
        if rest < 0 {
            if elems.len() != types.len() {
                self.errorf(pos, `this pattern has ${elems.len()} field${plural(elems.len())}, but the type has ${types.len()}`.to_string());
            }
            i = 0;
            while i < elems.len() {
                if i < types.len() {
                    self.pat(elems[i], types[i], mode);
                } else {
                    let err = self.ctx().err;
                    self.pat(elems[i], err, mode);
                }
                i += 1;
            }
            return;
        }
        let r = rest as usize;
        let after = elems.len() - r - 1;
        if r + after > types.len() {
            self.errorf(pos, `this pattern has ${r + after} fields, but the type has ${types.len()}`.to_string());
            return;
        }
        i = 0;
        while i < r { self.pat(elems[i], types[i], mode); i += 1; }
        i = 0;
        while i < after {
            self.pat(elems[r + 1 + i], types[types.len() - after + i], mode);
            i += 1;
        }
    }

    /// The type of a constant or unit struct/variant used as a pattern.
    pub fn const_pat_type(&mut self, pos: Pos, res: &Res) -> &Type {
        if res.kind != resolve::RES_DEF || res.rest.len() > 0 { return self.ctx().err; }
        let d = res.def.unwrap();
        let k = d.kind;
        match k {
            resolve::DEF_CONST | resolve::DEF_STATIC | resolve::DEF_ASSOC_CONST => {
                let ci = self.c.const_info(d);
                return self.normalize(ci.ty);
            }
            resolve::DEF_STRUCT => {
                let ai = self.c.adt(d);
                let (_, vars) = self.instantiate(ai.generics);
                return self.ctx().adt(d, vars);
            }
            resolve::DEF_VARIANT => {
                let p = d.parent.unwrap();
                let ai = self.c.adt(p);
                let (_, vars) = self.instantiate(ai.generics);
                return self.ctx().adt(p, vars);
            }
            _ => {}
        }
        self.ctx().err
    }

    /// Resolves the path of a struct pattern to its ADT type and fields.
    fn struct_pat_target(&mut self, p: &Pat, path: &Path) -> (Option<&Type>, Vec<&mut Field>) {
        let res = match self.info.res.paths.get(&path.id) { Some(r) => r.clone(), None => resolve::res_err() };
        let mut adt: Option<&Type> = None;
        let mut variant: Option<&mut Def> = None;
        if res.kind == resolve::RES_SELF_TY && res.rest.len() == 0 {
            adt = self.env.unwrap().self_ty;
        } else if res.kind == resolve::RES_DEF && res.rest.len() == 0 {
            let d = res.def.unwrap();
            match d.kind {
                resolve::DEF_STRUCT => {
                    let ai = self.c.adt(d);
                    let (_, vars) = self.instantiate(ai.generics);
                    adt = Some(self.ctx().adt(d, vars));
                }
                resolve::DEF_VARIANT => {
                    let ai = self.c.adt(d.parent.unwrap());
                    let (_, vars) = self.instantiate(ai.generics);
                    adt = Some(self.ctx().adt(d.parent.unwrap(), vars));
                    variant = Some(d);
                }
                _ => {}
            }
        } else if res.rest.len() == 1 {
            let (base, _) = self.base_type(path, &res);
            let b = self.inf.shallow(base);
            if b.kind == K_ADT {
                for v in self.c.adt(b.d()).variants.iter_mut() {
                    if v.def.name == res.rest[0].name.value {
                        adt = Some(b);
                        variant = Some(v.def);
                    }
                }
            }
        }
        let ok = match adt { Some(a) => self.inf.shallow(a).kind == K_ADT, None => false };
        if !ok {
            if res.kind != resolve::RES_ERR { self.errorf(p.pos(), "expected a struct or variant".to_string()); }
            return (None, Vec::new());
        }
        let ai = self.c.adt(self.inf.shallow(adt.unwrap()).d());
        let vd = match variant { Some(v) => v, None => return (adt, ai.fields) };
        for v in ai.variants.iter() {
            if v.def.id == vd.id { return (adt, v.fields); }
        }
        (adt, Vec::new())
    }
}
