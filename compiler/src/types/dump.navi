//! Dumps of type-checking results (to check the port against stage0).

use crate::{
    syntax::{
        ast::{ExprKind, PatKind},
        source::{File, Pos},
    },
    types::{body::*, *},
};

impl BodyInfo {
    /// Every recorded expression, local and pattern in recording order.
    pub fn dump_lines(&self, f: &File) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        for x in self.type_order.iter() {
            let mut s = `e ${f.position(x.pos())} ${self.types[&x.id]}`.to_string();
            if let Some(cl) = self.callees.get(&x.id) {
                s.push_str(&` -> ${callee_string(*cl)}`.to_string());
            }
            if let Some(a) = self.adjust.get(&x.id) {
                s.push_str(&` adj ${adjust_string(*a)}`.to_string());
            }
            if let ExprKind::Field { .. } = &x.kind {
                if let Some(i) = self.fields.get(&x.id) {
                    s.push_str(&` field=${i}`.to_string());
                }
            }
            if let ExprKind::Template { .. } = &x.kind {
                if let Some(t) = self.templates.get(&x.id) {
                    s.push_str(&` tmpl=${t}`.to_string());
                }
            }
            out.push(s);
        }
        for l in self.local_order.iter() {
            out.push(`l ${l.name}@${f.position(l.pos)} ${self.locals[&l.id]}`.to_string());
        }
        for p in self.pat_order.iter() {
            let mut s = `p ${f.position(p.pos())} ${self.pats[&p.id]}`.to_string();
            if let PatKind::Ident { .. } = &p.kind {
                if self.ref_bindings.contains_key(&p.id) {
                    s.push_str(" ref");
                }
            }
            out.push(s);
        }
        out
    }
}

fn callee_string(cl: &Callee) -> String {
    let mut args: Vec<String> = Vec::new();
    for a in cl.args.iter() {
        args.push(type_string(*a));
    }
    let mut s = `${crate::resolve::def_kind_name(cl.def.kind)} ${cl.def.name} [${args.join(", ")}]`
        .to_string();
    if let Some(st) = cl.self_ty {
        s.push_str(&` self=${st}`.to_string());
    }
    if let Some(r) = cl.recv {
        s.push_str(&` recv ${adjust_string(r)}`.to_string());
    }
    s
}

fn adjust_string(a: &Adjust) -> String {
    let mut s = `d=${a.derefs} r=${a.autoref} u=${a.unsize}`.to_string();
    if let Some(t) = a.to_dyn {
        s.push_str(&` dyn=${t}`.to_string());
    }
    s
}
