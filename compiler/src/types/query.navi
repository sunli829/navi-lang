//! Queries used by later phases (MIR building, interpretation, codegen).
//! They run the trait solver outside any function body, on types that are
//! concrete or that mention only the parameters of owner (whose where
//! clauses are assumed).

use std::collections::HashMap;

use crate::{
    resolve::{self, Def},
    types::{body::*, collect::*, solve::*, *},
};

/// The resolution of a (possibly trait) function for concrete types.
pub struct Instance {
    /// The function to run (impl method or trait default).
    pub def: &mut Def,
    /// Generic arguments for def's generics (all levels).
    pub args: Vec<&Type>,
    /// Self for trait default methods.
    pub self_ty: Option<&Type>,
    /// For compiler-provided impls: the trait's lang name.
    pub builtin: String,
    /// For calls through dyn.
    pub is_virtual: bool,
}

fn instance(def: &mut Def, args: Vec<&Type>, self_ty: Option<&Type>) -> &mut Instance {
    &mut Instance {
        def,
        args,
        self_ty,
        builtin: String::new(),
        is_virtual: false,
    }
}

fn cache_key(owner: Option<&mut Def>, t: &Type) -> u64 {
    let o = match owner {
        Some(d) => d.id as u64,
        None => 0xFFFFFFFF,
    };
    o << 32 | t.id as u64
}

/// Whether t mentions a projection (the only thing normalization changes).
fn has_proj_or_opaque(t: &Type) -> bool {
    crate::types::lower::mentions(t, K_PROJ, false)
}

impl Info {
    fn col(&self) -> &mut Collector {
        self.c.unwrap()
    }

    /// Takes the query lock while threads share Info (re-entrant).
    pub fn enter(&mut self) {
        if !self.ctx.par {
            return;
        }
        let me = std::thread::current().id().as_u64() as usize;
        if self.qowner.load(std::sync::atomic::Ordering::SeqCst) == me {
            self.qdepth += 1;
            return;
        }
        self.qlock.lock();
        self.qowner.store(me, std::sync::atomic::Ordering::SeqCst);
        self.qdepth = 1;
    }

    pub fn leave(&mut self) {
        if self.qdepth == 0 {
            return;
        }
        self.qdepth -= 1;
        if self.qdepth == 0 {
            self.qowner.store(0, std::sync::atomic::Ordering::SeqCst);
            self.qlock.unlock();
        }
    }

    /// Checks the std bodies among defs not checked yet (on several
    /// threads), before they are asked for.
    pub fn check_lazily(&mut self, defs: &Vec<&mut Def>) {
        if !self.lazy_std {
            return;
        }
        let mut todo: Vec<&mut Def> = Vec::new();
        for d in defs.iter() {
            if d.krate.lazy() && !self.bodies.contains_key(&d.id) {
                todo.push(*d);
            }
        }
        if todo.len() > 0 {
            self.col().check_defs(todo);
        }
    }

    /// The type-checked body of d (std bodies are checked on first use).
    pub fn body(&mut self, d: &mut Def) -> Option<&mut BodyInfo> {
        self.enter();
        let r = self.body_now(d);
        self.leave();
        r
    }

    fn body_now(&mut self, d: &mut Def) -> Option<&mut BodyInfo> {
        if let Some(b) = self.bodies.get(&d.id) {
            return Some(*b);
        }
        if !self.lazy_std || !d.krate.lazy() {
            return None;
        }
        self.col().check_body_of(d);
        match self.bodies.get(&d.id) {
            Some(b) => Some(*b),
            None => None,
        }
    }

    /// The concrete type behind an opaque type (checking its function's
    /// body first if needed).
    pub fn hidden_of(&mut self, t: &Type) -> Option<&Type> {
        self.enter();
        let r = self.hidden_of_now(t);
        self.leave();
        r
    }

    fn hidden_of_now(&mut self, t: &Type) -> Option<&Type> {
        let d = t.def?;
        if d.kind == resolve::DEF_ASSOC_FN && d.parent.unwrap().kind == resolve::DEF_TRAIT {
            return self.trait_hidden(t, d);
        }
        if let Some(h) = self.hidden.get(&t.id) {
            return Some(*h);
        }
        if d.kind != resolve::DEF_FN && d.kind != resolve::DEF_ASSOC_FN {
            if self.lazy_std {
                self.body(d);
            }
            return match self.hidden.get(&t.id) {
                Some(h) => Some(*h),
                None => None,
            };
        }
        // The opaque type of d's signature (its own parameters as arguments)
        // holds the hidden type; t has d's generic arguments.
        let sig = self.fn_sig_of(d);
        if t.index < 0 || t.index as usize >= sig.opaques.len() {
            return None;
        }
        let ident = sig.opaques[t.index as usize];
        if !self.hidden.contains_key(&ident.id) && self.lazy_std {
            self.body(d);
        }
        let h = match self.hidden.get(&ident.id) {
            Some(h) => *h,
            None => return None,
        };
        if same(ident, t) {
            return Some(h);
        }
        let g = self.generics_of(d);
        let map = crate::types::lower::param_map(Some(g), &t.args);
        Some(crate::types::lower::subst(self.ctx, h, &map, None))
    }

    /// t with every impl Trait type replaced by the type behind it.
    pub fn reveal_all(&mut self, t: &Type) -> &Type {
        let mut cur = t;
        let mut rounds = 0;
        if !crate::types::lower::mentions(cur, K_OPAQUE, false) {
            return cur;
        }
        while rounds < 16 {
            let mut ops: Vec<&Type> = Vec::new();
            crate::types::lower::visit(cur, |x| {
                if x.kind == K_OPAQUE {
                    ops.push(x);
                }
            });
            if ops.len() == 0 {
                return cur;
            }
            let mut changed = false;
            for o in ops.iter() {
                if let Some(h) = self.hidden_of(*o) {
                    cur = crate::types::body::replace_type(self.ctx, cur, *o, h);
                    changed = true;
                }
            }
            if !changed {
                return cur;
            }
            rounds += 1;
        }
        cur
    }

    // The impl Trait trait method m returns for the Self and generic
    // arguments in t: what the impl's method returns (its own impl Trait
    // revealed), with the impl's generic arguments.
    fn trait_hidden(&mut self, t: &Type, m: &mut Def) -> Option<&Type> {
        let st = t.args[0];
        let rest: Vec<&Type> = t.args[1..].to_vec();
        let r = self.resolve_method(m, st, &rest)?;
        if r.def.id == m.id {
            return None;
        }
        let sig = self.fn_sig_of(r.def);
        let g = self.generics_of(r.def);
        let map = crate::types::lower::param_map(Some(g), &r.args);
        if sig.ret.kind == K_OPAQUE && sig.ret.args.len() == 0 {
            let h = self.hidden_of(sig.ret)?;
            return Some(crate::types::lower::subst(self.ctx, h, &map, r.self_ty));
        }
        Some(crate::types::lower::subst(
            self.ctx, sig.ret, &map, r.self_ty,
        ))
    }

    // The Collector a query solves with: while threads share Info, a copy
    // of its own (the caches it reads are complete; its errors are dropped).
    fn solver(&mut self) -> &mut Collector {
        if self.ctx.par {
            self.col().worker(self.clock)
        } else {
            self.col()
        }
    }

    fn scratch(&mut self, c: &mut Collector, owner: Option<&mut Def>) -> &mut FnCtx {
        match owner {
            Some(o) => c.new_fn_ctx(o),
            None => bare_ctx(c, self.res.defs[0], None),
        }
    }

    /// <t as Deref>::Target, or none if t does not implement Deref.
    pub fn deref_target(&mut self, owner: Option<&mut Def>, t: &Type) -> Option<&Type> {
        let key = cache_key(owner, t);
        // The caches are locked while threads share Info; the solving is not
        // (two threads may solve the same query: same answer).
        let par = self.ctx.par;
        if let Some(r) = self.deref_cache.get(&key, par) {
            return r;
        }
        let r = self.deref_target_uncached(owner, t);
        self.deref_cache.insert(key, r, par);
        r
    }

    fn deref_target_uncached(&mut self, owner: Option<&mut Def>, t: &Type) -> Option<&Type> {
        let c = self.solver();
        let fc = self.scratch(c, owner);
        c.quiet += 1;
        let r = match fc.overloaded_deref(t) {
            Some(x) => Some(fc.inf.resolve(x)),
            None => None,
        };
        c.quiet -= 1;
        r
    }

    /// Resolves projections in t as far as possible.
    pub fn normalize(&mut self, owner: Option<&mut Def>, t: &Type) -> &Type {
        if !has_proj_or_opaque(t) {
            return t;
        }
        let key = cache_key(owner, t);
        let par = self.ctx.par;
        if let Some(r) = self.norm_cache.get(&key, par) {
            return r;
        }
        let r = self.normalize_uncached(owner, t);
        self.norm_cache.insert(key, r, par);
        r
    }

    fn normalize_uncached(&mut self, owner: Option<&mut Def>, t: &Type) -> &Type {
        let c = self.solver();
        let fc = self.scratch(c, owner);
        c.quiet += 1;
        let n = fc.normalize(t);
        // The bounds of impls it went through decide their parameters.
        if fc.pending.len() > 0 {
            fc.solve_pending(false);
        }
        let r = fc.inf.resolve(n);
        c.quiet -= 1;
        r
    }

    /// The item of a lang trait by name.
    pub fn trait_item(&self, trait_name: &str, item: &str) -> Option<&mut Def> {
        let d = self.lang_def(trait_name)?;
        let ti = self.traits.get(&d.id)?;
        match ti.items.get(&item.to_string()) {
            Some(x) => Some(*x),
            None => None,
        }
    }

    /// Resolves a trait method for a concrete self type and generic
    /// arguments (trait parameters followed by the method's own).
    pub fn resolve_method(
        &mut self,
        method: &mut Def,
        self_ty: &Type,
        args: &Vec<&Type>,
    ) -> Option<&mut Instance> {
        let mut key = `${method.id}/${self_ty.id}`.to_string();
        for a in args.iter() {
            key.push_str(&`,${a.id}`.to_string());
        }
        let par = self.ctx.par;
        if let Some(r) = self.method_cache.get(&key, par) {
            return r;
        }
        let r = self.resolve_method_uncached(method, self_ty, args);
        self.method_cache.insert(key, r, par);
        r
    }

    fn resolve_method_uncached(
        &mut self,
        method: &mut Def,
        self_ty: &Type,
        args: &Vec<&Type>,
    ) -> Option<&mut Instance> {
        let c = self.solver();
        let trait_def = method.parent.unwrap();
        let ti = self.traits[&trait_def.id];
        let n_trait = ti.generics.params.len();
        let mut trait_args: Vec<&Type> = args.clone();
        let mut own_args: Vec<&Type> = Vec::new();
        if args.len() > n_trait {
            trait_args = args[..n_trait].to_vec();
            own_args = args[n_trait..].to_vec();
        }
        if self_ty.kind == K_DYN {
            // Methods of the dyn's own traits dispatch through the vtable;
            // other traits (ToString for dyn Display) are found through impls.
            for b in self_ty.bounds.iter() {
                let tr = &TraitRef {
                    tdef: Some(b.trait_def()),
                    self_ty: Some(self_ty),
                    args: b.args.clone(),
                    bindings: Vec::new(),
                };
                for sup in c.supertraits(tr).iter() {
                    if sup.trait_def().id == trait_def.id {
                        let inst = instance(method, args.clone(), Some(self_ty));
                        inst.is_virtual = true;
                        return Some(inst);
                    }
                }
            }
        }
        let fc = self.scratch(c, None);
        c.quiet += 1;
        let tr = &TraitRef {
            tdef: Some(trait_def),
            self_ty: Some(self_ty),
            args: trait_args.clone(),
            bindings: Vec::new(),
        };
        // The method may be defined in a supertrait's impl when called
        // through a subtrait bound; the trait here is the method's own trait.
        let (osel, st) = fc.select_trait(tr, 0);
        c.quiet -= 1;
        if st != SEL_YES {
            return None;
        }
        let sel = osel.unwrap();
        match sel.kind {
            SEL_IMPL => {
                let ii = sel.impl_info.unwrap();
                // Impl parameters only the impl's bounds decide
                // (impl<T, I: Iterator<Item = &T>> ... for X<I>): solve them.
                let mut open = false;
                for a in sel.args.iter() {
                    if crate::types::infer::has_infer(fc.inf.resolve(*a)) {
                        open = true;
                    }
                }
                if open {
                    c.quiet += 1;
                    for n in sel.nested.iter() {
                        fc.require(*n, crate::syntax::source::NO_POS);
                    }
                    fc.solve_pending(false);
                    c.quiet -= 1;
                }
                let mut full: Vec<&Type> = Vec::new();
                for a in sel.args.iter() {
                    full.push(fc.inf.resolve(*a));
                }
                if let Some(it) = ii.items.get(&method.name) {
                    for a in own_args.iter() {
                        full.push(*a);
                    }
                    return Some(instance(*it, full, None));
                }
                // Default method from the trait.
                let mut all = trait_args.clone();
                for a in own_args.iter() {
                    all.push(*a);
                }
                return Some(instance(method, all, Some(self_ty)));
            }
            SEL_BUILTIN => {
                let name = c.lang_name(trait_def);
                let inst = instance(method, args.clone(), Some(self_ty));
                inst.builtin = name;
                return Some(inst);
            }
            SEL_DYN => {
                let inst = instance(method, args.clone(), Some(self_ty));
                inst.is_virtual = true;
                return Some(inst);
            }
            _ => {}
        }
        None
    }

    /// The signature of a function definition.
    pub fn fn_sig_of(&mut self, d: &mut Def) -> &mut FnSig {
        self.col().fn_sig(d)
    }

    /// The generics of a definition.
    pub fn generics_of(&mut self, d: &mut Def) -> &mut Generics {
        self.col().generics_of(d)
    }

    /// The impl information for an impl definition.
    pub fn impl_of(&mut self, d: &mut Def) -> &mut ImplInfo {
        self.col().impl_info(d)
    }

    /// The lang name of a std item, or "".
    pub fn lang_name(&self, d: &Def) -> String {
        self.col().lang_name(d)
    }

    /// Whether a trait method can be called through dyn.
    pub fn dyn_callable(&mut self, m: &mut Def) -> bool {
        self.col().dyn_callable(m)
    }

    /// The methods of a trait in declaration order.
    pub fn trait_methods(&self, trait_def: &Def) -> Vec<&mut Def> {
        let mut out = Vec::new();
        for it in self.traits[&trait_def.id].order.iter() {
            if it.kind == resolve::DEF_ASSOC_FN {
                out.push(*it);
            }
        }
        out
    }

    /// tr and all its supertraits.
    pub fn supertraits(&mut self, tr: &TraitRef) -> Vec<&TraitRef> {
        self.col().supertraits(tr)
    }
}
