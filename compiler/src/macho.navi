//! Mach-O relocatable object files (MH_OBJECT) for arm64 and x86_64
//! macOS.

use std::collections::HashMap;
use crate::obj::{self, Object};

const SECT_NAMES: [&str; 8] = ["__TEXT", "__text", "__TEXT", "__const", "__DATA", "__const", "__DATA", "__data"];

/// A little-endian byte buffer.
struct W { b: Vec<u8> }

impl W {
    fn u8(&mut self, v: u8) { self.b.push(v); }
    fn u16(&mut self, v: u16) {
        self.b.push(v as u8);
        self.b.push((v >> 8) as u8);
    }
    fn u32(&mut self, v: u32) {
        let mut i = 0;
        while i < 4 {
            self.b.push((v >> (8 * i) as u32) as u8);
            i += 1;
        }
    }
    fn u64(&mut self, v: u64) {
        let mut i = 0;
        while i < 8 {
            self.b.push((v >> (8 * i) as u32) as u8);
            i += 1;
        }
    }
    fn name16(&mut self, s: &str) {
        let bs = s.as_bytes();
        let mut i = 0;
        while i < 16 {
            self.b.push(if i < bs.len() { bs[i] } else { 0 });
            i += 1;
        }
    }
    fn pad_to(&mut self, n: u32) { while (self.b.len() as u32) < n { self.b.push(0); } }
}

struct Nlist {
    strx: u32,
    typ: u8,
    sect: u8,
    value: u64,
}

/// Encodes o as a Mach-O object file (MH_OBJECT). Sections are not split
/// at symbols (no MH_SUBSECTIONS_VIA_SYMBOLS), so the linker keeps their
/// contents in order.
pub fn write(o: &Object) -> Result<Vec<u8>, String> {
    let n = obj::NUM_SECTIONS;
    // Section addresses (object files lay sections out from 0).
    let mut addr: Vec<u64> = Vec::new();
    let mut cur = 0u64;
    let mut s = 0;
    while s < n {
        let a = 1u64 << o.align[s];
        cur = (cur + a - 1) / a * a;
        addr.push(cur);
        cur += o.sects[s].len() as u64;
        s += 1;
    }
    let vm_size = cur;

    // Symbols: locals, then external definitions, then undefined.
    let mut nlocals = 0u32;
    let mut nglobals = 0u32;
    let mut undef: Vec<String> = o.undef.keys().map(|k| k.clone()).collect();
    undef.sort();
    let mut sym_index: HashMap<String, usize> = HashMap::new();
    let mut strtab: Vec<u8> = Vec::new();
    strtab.push(0);
    strtab.push(0);
    let mut syms: Vec<Nlist> = Vec::new();
    for pass in [false, true].iter() {
        for sy in o.syms.iter() {
            if sy.global != *pass { continue; }
            if sy.global { nglobals += 1; } else { nlocals += 1; }
            sym_index.insert(sy.name.clone(), syms.len());
            let typ = if sy.global { 0x0e | 0x1 } else { 0x0e };
            syms.push(Nlist { strx: strtab.len() as u32, typ, sect: (sy.sec + 1) as u8, value: addr[sy.sec] + sy.off });
            strtab.extend_from_slice(sy.name.as_bytes());
            strtab.push(0);
        }
    }
    for name in undef.iter() {
        sym_index.insert(name.clone(), syms.len());
        syms.push(Nlist { strx: strtab.len() as u32, typ: 0x1, sect: 0, value: 0 });
        strtab.extend_from_slice(name.as_bytes());
        strtab.push(0);
    }

    // Relocations per section.
    let mut relocs: Vec<Vec<u32>> = Vec::new();
    s = 0;
    while s < n { relocs.push(Vec::new()); s += 1; }
    for r in o.relocs.iter() {
        let name = o.names[r.sym as usize].clone();
        let idx = match sym_index.get(&name) { Some(i) => *i as u32, None => return Err(`macho: relocation against unknown symbol ${name}`.to_string()) };
        let (typ, length, pcrel) = if r.kind == obj::BRANCH26 { (2u32, 2u32, 1u32) }
            else if r.kind == obj::PAGE21 { (3, 2, 1) }
            else if r.kind == obj::PAGE_OFF12 || r.kind == obj::PAGE_OFF12_LD64 { (4, 2, 0) }
            else if r.kind == obj::ABS64 { (0, 3, 0) }
            else if r.kind == obj::CALL32 { (2, 2, 1) } // X86_64_RELOC_BRANCH
            else { (1, 2, 1) }; // X86_64_RELOC_SIGNED
        let info = idx | pcrel << 24 | length << 25 | 1 << 27 | typ << 28;
        let mut rl = relocs[r.sec];
        rl.push(r.off);
        rl.push(info);
    }

    // Load commands.
    let nsects = n as u32;
    let seg_cmd_size = 72 + 80 * nsects;
    let cmds_size = seg_cmd_size + 24 + 24 + 80;
    let header_size = 32 + cmds_size;
    // Section contents follow the load commands, at the same relative
    // offsets as their addresses.
    let base = (header_size + 15) / 16 * 16;
    let mut file_off: Vec<u32> = Vec::new();
    s = 0;
    while s < n { file_off.push(base + addr[s] as u32); s += 1; }
    let content_end = base + vm_size as u32;
    let rel_off = (content_end + 7) / 8 * 8;
    let mut rel_file: Vec<u32> = Vec::new();
    let mut pos = rel_off;
    s = 0;
    while s < n {
        rel_file.push(pos);
        pos += (relocs[s].len() * 4) as u32;
        s += 1;
    }
    let sym_off = (pos + 7) / 8 * 8;
    let str_off = sym_off + (syms.len() * 16) as u32;

    let w = &mut W { b: Vec::new() };
    let (cpu, sub) = if o.arch == "amd64" { (0x01000007u32, 3u32) } else { (0x0100000cu32, 0u32) };
    w.u32(0xfeedfacf);
    w.u32(cpu);
    w.u32(sub);
    w.u32(1); // MH_OBJECT
    w.u32(4); // ncmds
    w.u32(cmds_size);
    w.u32(0); // flags
    w.u32(0);
    // LC_SEGMENT_64
    w.u32(0x19);
    w.u32(seg_cmd_size);
    w.name16("");
    w.u64(0);
    w.u64(vm_size);
    w.u64(base as u64);
    w.u64(vm_size);
    w.u32(7); // maxprot rwx
    w.u32(7);
    w.u32(nsects);
    w.u32(0);
    s = 0;
    while s < n {
        w.name16(SECT_NAMES[2 * s + 1]);
        w.name16(SECT_NAMES[2 * s]);
        w.u64(addr[s]);
        w.u64(o.sects[s].len() as u64);
        w.u32(file_off[s]);
        w.u32(o.align[s]);
        w.u32(if relocs[s].len() > 0 { rel_file[s] } else { 0 });
        w.u32((relocs[s].len() / 2) as u32);
        w.u32(if s == obj::TEXT { 0x80000400 } else { 0 }); // pure instructions, some instructions
        w.u32(0);
        w.u32(0);
        w.u32(0);
        s += 1;
    }
    // LC_BUILD_VERSION: macOS 11.0
    w.u32(0x32);
    w.u32(24);
    w.u32(1);
    w.u32(11 << 16);
    w.u32(0);
    w.u32(0);
    // LC_SYMTAB
    w.u32(0x2);
    w.u32(24);
    w.u32(sym_off);
    w.u32(syms.len() as u32);
    w.u32(str_off);
    w.u32(strtab.len() as u32);
    // LC_DYSYMTAB
    w.u32(0xb);
    w.u32(80);
    w.u32(0);
    w.u32(nlocals);
    w.u32(nlocals);
    w.u32(nglobals);
    w.u32(nlocals + nglobals);
    w.u32(undef.len() as u32);
    let mut i = 0;
    while i < 12 { w.u32(0); i += 1; }

    // Section contents.
    s = 0;
    while s < n {
        w.pad_to(file_off[s]);
        w.b.extend_from_slice(o.sects[s].as_slice());
        s += 1;
    }
    w.pad_to(rel_off);
    s = 0;
    while s < n {
        for v in relocs[s].iter() { w.u32(*v); }
        s += 1;
    }
    w.pad_to(sym_off);
    for sy in syms.iter() {
        w.u32(sy.strx);
        w.u8(sy.typ);
        w.u8(sy.sect);
        w.u16(0);
        w.u64(sy.value);
    }
    w.b.extend_from_slice(strtab.as_slice());
    Ok(w.b)
}
