//! navi: the navi compiler written in navi (stage1 and later).

mod asm;
mod backend;
mod cache;
mod cli;
mod codegen;
mod coff;
mod debug;
mod deps;
mod derive;
mod dflags;
mod diag;
mod doc;
mod driver;
mod dwarf;
mod elf;
mod elflink;
mod fmt;
mod init;
mod layout;
mod libcache;
mod link;
mod lsp;
mod macho;
mod manifest;
mod merge;
mod mir;
mod navih;
mod obj;
mod pelink;
mod project;
mod resolve;
mod sha256;
mod ssa;
mod symbols;
mod syntax;
mod toml;
mod types;
mod util;

use std::{cli::Parser, env, fs, process};

use crate::cli::{Cli, Cmd};

const MIN_HEAP: usize = 256 << 20;

fn main() {
    // The compiler's heap only grows for most of a build: start collecting
    // late (as Go's compiler does), and collect half as often (a collection
    // finds little garbage; peak memory grows by less than a tenth).
    std::gc::set_min_heap(MIN_HEAP);
    std::gc::set_percent(200);
    let args: Vec<String> = env::args().collect();
    // -d switches (dflags) for every command, wherever they are.
    let rest: Vec<String> = match dflags::take(&args[1..].to_vec()) {
        Ok(r) => r,
        Err(e) => {
            eprintln(`navi: ${e}`);
            process::exit(2);
        }
    };
    if rest.len() == 2 && rest[0] == "help" && rest[1] == "debug" {
        print(dflags::help());
        process::exit(0);
    }
    let mut argv: Vec<String> = Vec::from(["navi".to_string()]);
    for a in rest.iter() {
        argv.push(a.clone());
    }
    let c = match Cli::try_parse_from(argv) {
        Ok(c) => c,
        Err(e) => {
            e.print();
            process::exit(e.exit_code());
        }
    };
    let code = match &c.cmd {
        Cmd::Build(a) => driver::build_command(a),
        Cmd::Run(a) => driver::run_command(a),
        Cmd::Test(a) => driver::test_command(a, false),
        Cmd::Bench(a) => driver::test_command(a, true),
        Cmd::Doc(a) => doc::doc_command(a),
        Cmd::New(a) => init::new_command(a),
        Cmd::Init(a) => init::init_command(a),
        Cmd::Fmt(a) => fmt::fmt_command(a),
        Cmd::Update { path } => driver::update_command(path.clone()),
        Cmd::Expand(a) => driver::expand_command(a),
        Cmd::Lsp => lsp::lsp_command(&Vec::new()),
        Cmd::Parse { args } => parse_files(args),
        Cmd::ResolveDump { args } => debug::resolve_dump(args),
        Cmd::TypesDump { args } => debug::types_dump(args),
        Cmd::MirDump { args } => debug::mir_dump(args),
        Cmd::NavihCheck { args } => debug::navih_check(args),
        Cmd::DeriveBuild { args } => driver::derive_build_command(args),
        Cmd::AsmDump { args } => debug::asm_dump(args),
    };
    process::exit(code);
}

fn parse_files(paths: &Vec<String>) -> i32 {
    if paths.len() == 0 {
        eprintln("usage: navi parse <file.navi>...");
        return 2;
    }
    let mut code = 0;
    for path in paths.iter() {
        let src = match fs::read_to_string(path) {
            Ok(s) => s,
            Err(e) => {
                eprintln(`open ${path}: ${e}`);
                code = 1;
                continue;
            }
        };
        let f = syntax::source::File::new(path.as_str(), src);
        let (sf, errs) = syntax::parser::parse_file(f);
        if errs.len() > 0 {
            eprintln(errs.to_string());
            code = 1;
            continue;
        }
        println(syntax::dump::dump_file(sf));
    }
    code
}
