//! navic: the navi compiler written in navi (stage1 and later).

mod util;
mod diag;
mod syntax;
mod resolve;
mod types;
mod mir;
mod layout;
mod codegen;
mod obj;
mod macho;
mod link;
mod sha256;
mod cache;
mod dwarf;
mod backend;
mod driver;
mod debug;

use std::env;
use std::fs;
use std::process;

const MIN_HEAP: usize = 256 << 20;

fn main() {
    // The compiler's heap only grows for most of a build: start collecting
    // late (as Go's compiler does).
    std::gc::set_min_heap(MIN_HEAP);
    let args: Vec<String> = env::args().collect();
    if args.len() < 2 {
        eprintln("usage: navic <command> [arguments]");
        process::exit(2);
    }
    let cmd = args[1].as_str();
    let rest: Vec<String> = args[2..].to_vec();
    let code = if cmd == "parse" { parse_files(&rest) } else if cmd == "resolve-dump" { debug::resolve_dump(&rest) } else if cmd == "types-dump" { debug::types_dump(&rest) } else if cmd == "mir-dump" { debug::mir_dump(&rest) } else if cmd == "build" { driver::build_command(&rest) } else if cmd == "test" { driver::test_command(&rest, false) } else if cmd == "bench" { driver::test_command(&rest, true) } else {
        eprintln(`navic: unknown command ${util::quote(cmd)}`);
        2
    };
    process::exit(code);
}

fn parse_files(paths: &Vec<String>) -> i32 {
    if paths.len() == 0 {
        eprintln("usage: navic parse <file.navi>...");
        return 2;
    }
    let mut code = 0;
    for path in paths.iter() {
        let src = match fs::read_to_string(path) {
            Ok(s) => s,
            Err(e) => {
                eprintln(`open ${path}: ${e}`);
                code = 1;
                continue;
            }
        };
        let f = syntax::source::File::new(path.as_str(), src);
        let (sf, errs) = syntax::parser::parse_file(f);
        if errs.len() > 0 {
            eprintln(errs.to_string());
            code = 1;
            continue;
        }
        println(syntax::dump::dump_file(sf));
    }
    code
}
