//! navi: the navi compiler written in navi (stage1 and later).

mod util;
mod diag;
mod syntax;
mod resolve;
mod types;
mod mir;
mod layout;
mod codegen;
mod obj;
mod macho;
mod elf;
mod coff;
mod link;
mod elflink;
mod pelink;
mod sha256;
mod symbols;
mod merge;
mod libcache;
mod navih;
mod derive;
mod asm;
mod cache;
mod dwarf;
mod ssa;
mod backend;
mod driver;
mod deps;
mod toml;
mod manifest;
mod project;
mod init;
mod debug;
mod dflags;
mod fmt;
mod lsp;

use std::env;
use std::fs;
use std::process;

const MIN_HEAP: usize = 256 << 20;

fn main() {
    // The compiler's heap only grows for most of a build: start collecting
    // late (as Go's compiler does), and collect half as often (a collection
    // finds little garbage; peak memory grows by less than a tenth).
    std::gc::set_min_heap(MIN_HEAP);
    std::gc::set_percent(200);
    let args: Vec<String> = env::args().collect();
    if args.len() < 2 {
        eprintln("usage: navi <command> [arguments]");
        process::exit(2);
    }
    let cmd = args[1].as_str();
    // -d switches (dflags) for every command.
    let rest: Vec<String> = match dflags::take(&args[2..].to_vec()) {
        Ok(r) => r,
        Err(e) => {
            eprintln(`navi: ${e}`);
            process::exit(2);
        }
    };
    let code = match cmd {
        "help" if rest.len() == 1 && rest[0] == "debug" => {
            print(dflags::help());
            0
        }
        "build" => driver::build_command(&rest),
        "test" => driver::test_command(&rest, false),
        "bench" => driver::test_command(&rest, true),
        "update" => driver::update_command(&rest),
        "run" => driver::run_command(&rest),
        "new" => init::new_command(&rest),
        "init" => init::init_command(&rest),
        "parse" => parse_files(&rest),
        "fmt" => fmt::fmt_command(&rest),
        "lsp" => lsp::lsp_command(&rest),
        "resolve-dump" => debug::resolve_dump(&rest),
        "types-dump" => debug::types_dump(&rest),
        "mir-dump" => debug::mir_dump(&rest),
        "navih-check" => debug::navih_check(&rest),
        "derive-build" => driver::derive_build_command(&rest),
        "asm-dump" => debug::asm_dump(&rest),
        "expand" => driver::expand_command(&rest),
        _ => {
            eprintln(`navi: unknown command ${util::quote(cmd)}`);
            2
        }
    };
    process::exit(code);
}

fn parse_files(paths: &Vec<String>) -> i32 {
    if paths.len() == 0 {
        eprintln("usage: navi parse <file.navi>...");
        return 2;
    }
    let mut code = 0;
    for path in paths.iter() {
        let src = match fs::read_to_string(path) {
            Ok(s) => s,
            Err(e) => {
                eprintln(`open ${path}: ${e}`);
                code = 1;
                continue;
            }
        };
        let f = syntax::source::File::new(path.as_str(), src);
        let (sf, errs) = syntax::parser::parse_file(f);
        if errs.len() > 0 {
            eprintln(errs.to_string());
            code = 1;
            continue;
        }
        println(syntax::dump::dump_file(sf));
    }
    code
}
