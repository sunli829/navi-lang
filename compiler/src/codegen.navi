//! Code generation planning: walks the MIR from main with concrete types,
//! groups function instances by GC shape, assigns dictionary slots for the
//! call targets and vtables that differ between the instantiations of a
//! group, and collects the data (strings, statics, vtables, dictionaries)
//! the code refers to.

use std::collections::HashMap;
use crate::resolve::{self, Def, Module, Node};
use crate::syntax::ast::Item;
use crate::types::{self, Type, TraitRef};
use crate::types::collect::{Info, has_attr};
use crate::types::lower::ParamMap;
use crate::layout::{self, Computer};
use crate::mir::{self, Func, Const, FnRef, Operand, Rvalue, Stmt, Term};
use crate::mir::build::Program;
use crate::mir::shims::uses_shim;

/// The intrinsics the backends generate inline; the others call the
/// function of the same name in std::rt::native.
pub fn is_inline(name: &str) -> bool {
    match name {
        "size_of" | "align_of" | "has_pointers" | "is_copy_clone"
        | "ptr_offset" | "slice_from_raw" | "slice_from_raw_mut" | "str_from_raw" | "slice_len" | "slice_ptr" | "str_as_bytes"
        | "wrapping_add" | "wrapping_sub" | "wrapping_mul"
        | "caller_location" | "abort" | "run_defers" | "save_context" | "resume_context"
        | "frame_address" | "stack_top" | "stack_pointer" | "spill_registers" | "data_start" | "data_end"
        | "swap_context" | "gstart_address" | "mstart_address" | "set_stack_limit" | "current_g" | "set_current_g"
        | "atomic_load" | "atomic_store" | "atomic_add" | "atomic_cas" => true,
        _ => false,
    }
}

pub type TargetKind = u8;
/// A generated function instance.
pub const T_INST: TargetKind = 0;
/// Handled by the backend.
pub const T_INTRINSIC: TargetKind = 1;
/// Dynamic dispatch through a vtable.
pub const T_VIRTUAL: TargetKind = 2;

/// A resolved function reference.
pub struct Target {
    pub kind: TargetKind,
    pub inst: Option<&mut Inst>,
    pub intrinsic: String,
    /// Concrete type arguments (intrinsics).
    pub type_args: Vec<&Type>,
    /// The vtable slot (virtual).
    pub method: usize,
    /// The referenced item.
    pub def: &mut Def,
}

impl Target {
    fn key(&self) -> String {
        if self.kind == T_INST { return `i${self.inst.unwrap().key}`; }
        if self.kind == T_INTRINSIC { return `x${self.intrinsic}`; }
        `v${self.method}`
    }
}

fn inst_target(inst: &mut Inst, def: &mut Def) -> &mut Target {
    &mut Target { kind: T_INST, inst: Some(inst), intrinsic: String::new(), type_args: Vec::new(), method: 0, def }
}

fn intrinsic_target(name: &str, def: &mut Def) -> &mut Target {
    &mut Target { kind: T_INTRINSIC, inst: None, intrinsic: name.to_string(), type_args: Vec::new(), method: 0, def }
}

/// The key of a function constant site.
pub fn const_site(c: &Const) -> String { `c${c.id}` }

/// The key of a MakeDyn site: statement si of block bi in f.
pub fn dyn_site(f: &Func, bi: usize, si: usize) -> String { `d${f.id}.${bi}.${si}` }

/// One concrete instantiation of a function body.
pub struct Inst {
    pub key: String,
    pub func: &mut Func,
    pub def: Option<&mut Def>,
    pub args: Vec<&Type>,
    pub subst: ParamMap,
    pub self_ty: Option<&Type>,
    pub group: Option<&mut Group>,
    /// The symbol of the dictionary.
    pub dict: String,
    /// #[track_caller] functions receive the caller's location.
    pub track_caller: bool,
    pub targets: HashMap<String, &mut Target>,
    pub vtables: HashMap<String, &mut Vtable>,
    /// The keys of targets and vtables in walk order (slot assignment
    /// follows it).
    pub sites: Vec<String>,
    /// The statics the code reads.
    pub statics: Vec<&mut Def>,
}

impl Inst {
    /// t with the instance's type arguments substituted.
    pub fn concrete(&self, info: &mut Info, t: &Type) -> &Type {
        let s = types::lower::subst(info.ctx, t, &self.subst, self.self_ty);
        info.normalize(None, s)
    }

    pub fn concrete_opt(&self, info: &mut Info, t: Option<&Type>) -> Option<&Type> {
        match t { Some(x) => Some(self.concrete(info, x)), None => None }
    }

    pub fn grp(&self) -> &mut Group { self.group.unwrap() }
}

/// A shape instance: one piece of machine code shared by the
/// instantiations in insts. rep provides the (layout-identical) types.
pub struct Group {
    pub key: String,
    pub sym: String,
    pub rep: &mut Inst,
    pub insts: Vec<&mut Inst>,
    /// Dictionary slots of the dynamic sites (targets or vtables that differ
    /// between the instantiations).
    pub slots: HashMap<String, usize>,
    pub nslots: usize,
    /// The code symbols of closures defined in the function (by func id).
    pub closure_syms: HashMap<u32, String>,
}

/// The vtable of a concrete type for a dyn type.
pub struct Vtable {
    pub sym: String,
    pub concrete: &Type,
    pub dyn_ty: &Type,
    pub methods: Vec<&mut Target>,
}

/// One dictionary entry.
pub enum DictEntry {
    Target(&mut Target),
    Vtable(&mut Vtable),
}

/// The set of functions and data to generate.
pub struct Plan {
    pub mir: &mut Program,
    pub info: &mut Info,
    pub lay: &mut Computer,
    pub groups: Vec<&mut Group>,
    pub insts: HashMap<String, &mut Inst>,
    pub main: Option<&mut Inst>,
    pub statics: Vec<&mut Def>,
    static_ok: HashMap<u32, bool>,
    pub vtables: HashMap<String, &mut Vtable>,
    /// The vtables in creation order.
    pub vtable_list: Vec<&mut Vtable>,
    /// String literal -> symbol.
    pub strings: HashMap<Vec<u8>, String>,
    /// The string literals in creation order.
    pub string_list: Vec<Vec<u8>>,
    pub errors: Vec<String>,
    /// The initializer instance of each static (by def id).
    pub static_init: HashMap<u32, &mut Inst>,
    /// The std::rt::native functions the backend calls directly.
    pub runtime: HashMap<String, &mut Inst>,
    groups_by_key: HashMap<String, &mut Group>,
    native: Option<&mut Module>,
    shapes: HashMap<u64, String>,
}

fn args_key(ts: &Vec<&Type>) -> String {
    let mut parts: Vec<String> = Vec::new();
    for t in ts.iter() { parts.push(`${t.id}`); }
    parts.join(",")
}

fn opt_id(t: Option<&Type>) -> u32 { match t { Some(x) => x.id, None => 0 } }

/// Plans code generation for the program rooted at main.
pub fn build_plan(prog: &mut Program, main: Option<&mut Def>, mf: &mut Func) -> &mut Plan {
    let p = &mut Plan { mir: prog, info: prog.info, lay: layout::new_computer(prog.info), groups: Vec::new(), insts: HashMap::new(),
        main: None, statics: Vec::new(), static_ok: HashMap::new(), vtables: HashMap::new(), vtable_list: Vec::new(),
        strings: HashMap::new(), string_list: Vec::new(), errors: Vec::new(), static_init: HashMap::new(), runtime: HashMap::new(),
        groups_by_key: HashMap::new(), native: None, shapes: HashMap::new() };
    p.find_native();
    for name in ["panic_raw", "panic_bounds", "gc_alloc", "sched_init", "gmain", "set_args", "morestack", "mstart"].iter() {
        match p.native_fn(*name) {
            Some(d) => {
                let f = prog.func(d).unwrap();
                let i = p.inst(Some(d), Vec::new(), None, f);
                p.runtime.insert(name.to_string(), i);
            }
            None => p.errors.push(`std::rt::native::${name} is missing`),
        }
    }
    p.main = Some(p.inst(main, Vec::new(), None, mf));
    p.order_statics();
    p.assign_slots();
    p.groups.sort_by(|a, b| a.sym.cmp(&b.sym));
    p
}

fn sanitize(s: &str) -> String {
    let mut b = String::new();
    for c in s.chars() {
        if c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' || c == '_' { b.push(c); } else { b.push('_'); }
    }
    b
}

fn fn_has_attr(d: &Def, name: &str) -> bool {
    match &d.node {
        Node::Item(Item::Fn(f)) => has_attr(&f.base.attrs, name),
        _ => false,
    }
}

/// The GC shape of a concrete type argument: thin pointers to sized types
/// share one shape, fat pointers another, closures a third; all other types
/// are their own shape.
pub fn shape_of(t: &Type) -> String {
    if t.kind == types::K_REF || t.kind == types::K_PTR {
        let e = t.el().kind;
        if e == types::K_DYN { return "dynptr".to_string(); }
        if e == types::K_STR || e == types::K_SLICE { return "fatptr".to_string(); }
        return "ptr".to_string();
    }
    if t.kind == types::K_FN {
        if t.abi.len() == 0 { return "closure".to_string(); }
        return "ptr".to_string();
    }
    `t${t.id}`
}

impl Plan {
    /// The target of a function constant in inst, and the dictionary slot to
    /// load it from (-1 if the call is static).
    pub fn site_target(&self, inst: &Inst, c: &Const) -> (&mut Target, i64) {
        let k = const_site(c);
        let t = inst.targets[&k];
        match inst.grp().slots.get(&k) { Some(s) => (t, *s as i64), None => (t, -1) }
    }

    /// The vtable for a MakeDyn site and its slot (-1 if static).
    pub fn site_vtable(&self, inst: &Inst, key: &String) -> (&mut Vtable, i64) {
        let v = inst.vtables[key];
        match inst.grp().slots.get(key) { Some(s) => (v, *s as i64), None => (v, -1) }
    }

    /// For each slot of inst's group, the target or vtable of inst.
    pub fn dict_entries(&self, inst: &Inst) -> Vec<DictEntry> {
        let g = inst.grp();
        let mut keys: Vec<String> = Vec::new();
        let mut i = 0;
        while i < g.nslots { keys.push(String::new()); i += 1; }
        for (k, s) in g.slots.iter() { keys[*s] = k.clone(); }
        let mut out = Vec::new();
        for k in keys.iter() {
            match inst.targets.get(k) {
                Some(t) => out.push(DictEntry::Target(*t)),
                None => out.push(DictEntry::Vtable(inst.vtables[k])),
            }
        }
        out
    }

    /// The symbol of a string literal.
    pub fn str_sym(&mut self, s: &Vec<u8>) -> String {
        if let Some(sym) = self.strings.get(s) { return sym.clone(); }
        let sym = `_navi_str${self.strings.len()}`;
        self.strings.insert(s.clone(), sym.clone());
        self.string_list.push(s.clone());
        sym
    }

    fn find_native(&mut self) {
        for c in self.info.res.crates.iter() {
            if !c.is_std { continue; }
            let rt = match c.root.unwrap().lookup("rt", resolve::TYPE_NS) { Some(b) => b, None => return };
            let rd = match rt.res.def { Some(d) => d, None => return };
            if let Some(n) = rd.module.unwrap().lookup("native", resolve::TYPE_NS) {
                if let Some(nd) = n.res.def { self.native = nd.module; }
            }
        }
    }

    fn native_fn(&mut self, name: &str) -> Option<&mut Def> {
        let m = self.native?;
        let b = m.lookup(name, resolve::VALUE_NS)?;
        let d = b.res.def?;
        if self.mir.func(d).is_none() { return None; }
        Some(d)
    }

    /// The instance of f (the body of def, or a shim) for the given type
    /// arguments, creating and walking it the first time.
    fn inst(&mut self, def: Option<&mut Def>, args: Vec<&Type>, self0: Option<&Type>, f: &mut Func) -> &mut Inst {
        let mut self_ty = self0;
        if let Some(d) = def {
            let in_trait = match d.parent { Some(p) => p.kind == resolve::DEF_TRAIT, None => false };
            if !in_trait { self_ty = None; }
        }
        let key = `${f.id}<${args_key(&args)}>${opt_id(self_ty)}`;
        if let Some(i) = self.insts.get(&key) { return *i; }
        let inst = &mut Inst { key: key.clone(), func: f, def, args: args.clone(), subst: HashMap::new(), self_ty, group: None,
            dict: String::new(), track_caller: false, targets: HashMap::new(), vtables: HashMap::new(), sites: Vec::new(),
            statics: Vec::new() };
        if let Some(d) = def {
            let k = d.kind;
            if k == resolve::DEF_FN || k == resolve::DEF_ASSOC_FN || k == resolve::DEF_CONST || k == resolve::DEF_ASSOC_CONST || k == resolve::DEF_STATIC {
                let all = self.info.generics_of(d).all();
                let mut i = 0;
                while i < all.len() && i < args.len() {
                    inst.subst.insert(all[i].def.id, args[i]);
                    i += 1;
                }
            }
            inst.track_caller = fn_has_attr(d, "track_caller");
        }
        if f.shim { inst.track_caller = true; }
        self.insts.insert(key, inst);
        self.walk(inst, f);
        self.add_to_group(inst);
        inst
    }

    fn visit_op(&mut self, inst: &mut Inst, op: &Operand) {
        if op.kind != mir::OP_CONST { return; }
        let c = op.cnst.unwrap();
        match c.kind {
            mir::C_FN => {
                let k = const_site(c);
                if !inst.targets.contains_key(&k) { inst.sites.push(k.clone()); }
                let t = self.resolve(inst, c.fn_ref.unwrap());
                inst.targets.insert(k, t);
            }
            mir::C_STATIC => {
                self.static_def(c.static_def.unwrap());
                inst.statics.push(c.static_def.unwrap());
            }
            mir::C_STR | mir::C_BYTES => {
                self.str_sym(&c.bytes);
            }
            _ => {}
        }
    }

    fn visit_rv(&mut self, inst: &mut Inst, rv: &Rvalue) {
        match rv {
            Rvalue::Use(x) => self.visit_op(inst, x),
            Rvalue::Bin { x, y, .. } => {
                self.visit_op(inst, x);
                self.visit_op(inst, y);
            }
            Rvalue::Un { x, .. } | Rvalue::Cast { x, .. } | Rvalue::Unsize { x, .. } | Rvalue::MakeDyn { x, .. } => self.visit_op(inst, x),
            Rvalue::Aggregate { ops, closure, .. } => {
                for o in ops.iter() { self.visit_op(inst, o); }
                if let Some(cf) = closure { self.walk(inst, *cf); }
            }
            _ => {}
        }
    }

    /// Resolves every function reference and dyn conversion in f (and the
    /// closures it defines) for instance inst.
    fn walk(&mut self, inst: &mut Inst, f: &mut Func) {
        let mut bi = 0;
        while bi < f.blocks.len() {
            let b = f.blocks[bi];
            let mut si = 0;
            while si < b.stmts.len() {
                match &b.stmts[si] {
                    Stmt::Assign { rv, .. } => {
                        self.visit_rv(inst, rv);
                        if let Rvalue::MakeDyn { concrete, to, .. } = rv {
                            let c = inst.concrete(self.info, *concrete);
                            let t = inst.concrete(self.info, *to);
                            let key = dyn_site(f, bi, si);
                            if !inst.vtables.contains_key(&key) { inst.sites.push(key.clone()); }
                            let v = self.vtable(c, t.el());
                            inst.vtables.insert(key, v);
                        }
                    }
                    Stmt::PushDefer { fn_op, args } => {
                        self.visit_op(inst, fn_op);
                        for a in args.iter() { self.visit_op(inst, a); }
                    }
                    _ => {}
                }
                si += 1;
            }
            match &b.term {
                Term::Call { fn_op, args, .. } => {
                    self.visit_op(inst, fn_op);
                    for a in args.iter() { self.visit_op(inst, a); }
                }
                Term::Switch { x, .. } => self.visit_op(inst, x),
                Term::Assert { cond, msg, .. } => {
                    self.visit_op(inst, cond);
                    self.str_sym(&msg.as_bytes().to_vec());
                }
                _ => {}
            }
            bi += 1;
        }
    }

    fn static_def(&mut self, d: &mut Def) {
        if self.static_ok.contains_key(&d.id) { return; }
        self.static_ok.insert(d.id, true);
        self.statics.push(d);
        if let Some(f) = self.mir.func(d) {
            let i = self.inst(Some(d), Vec::new(), None, f);
            self.static_init.insert(d.id, i);
        }
    }

    /// Turns a function reference into a concrete target.
    fn resolve(&mut self, inst: &mut Inst, r: &FnRef) -> &mut Target {
        let mut args: Vec<&Type> = Vec::new();
        for a in r.args.iter() { args.push(inst.concrete(self.info, *a)); }
        let self_ty = inst.concrete_opt(self.info, r.self_ty);
        let def = r.def.unwrap();
        if r.ctor {
            let adt = if def.kind == resolve::DEF_VARIANT { self.info.ctx.adt(def.parent.unwrap(), args) } else { self.info.ctx.adt(def, args) };
            let f = self.mir.ctor_thunk(def, adt);
            let i = self.inst(None, Vec::new(), None, f);
            return inst_target(i, def);
        }
        let in_trait = match def.parent { Some(p) => p.kind == resolve::DEF_TRAIT, None => false };
        if (def.kind == resolve::DEF_ASSOC_FN || def.kind == resolve::DEF_ASSOC_CONST) && in_trait {
            let st = match self_ty {
                None => {
                    self.errors.push(`trait item ${def.name} without a self type`);
                    return intrinsic_target("unreachable", def);
                }
                Some(s) => s,
            };
            let ri = self.info.resolve_method(def, st, &args);
            match ri {
                None => {
                    self.errors.push(`no impl of ${def.parent.unwrap().name}::${def.name} for ${st}`);
                    return intrinsic_target("unreachable", def);
                }
                Some(res) => {
                    if res.is_virtual {
                        let m = self.vtable_index(st, def);
                        let t = &mut Target { kind: T_VIRTUAL, inst: None, intrinsic: String::new(), type_args: args, method: m, def };
                        return t;
                    }
                    return self.resolved(res, def, st, &args);
                }
            }
        }
        if fn_has_attr(def, "intrinsic") {
            if !is_inline(def.name.as_str()) {
                if let Some(nd) = self.native_fn(def.name.as_str()) {
                    let f = self.mir.func(nd).unwrap();
                    let i = self.inst(Some(nd), args, None, f);
                    return inst_target(i, nd);
                }
            }
            let t = intrinsic_target(def.name.as_str(), def);
            t.type_args = args;
            return t;
        }
        if def.kind == resolve::DEF_EXTERN_FN { return intrinsic_target("extern", def); }
        let f = match self.mir.func(def) {
            None => {
                self.errors.push(`no body for ${def.name}`);
                return intrinsic_target("unreachable", def);
            }
            Some(f) => f,
        };
        let i = self.inst(Some(def), args, self_ty, f);
        inst_target(i, def)
    }

    fn resolved(&mut self, r: &mut types::query::Instance, method: &mut Def, self_ty: &Type, args: &Vec<&Type>) -> &mut Target {
        let trait_name = if r.builtin.len() > 0 { r.builtin.clone() } else { r.derived.clone() };
        if trait_name.len() == 0 {
            let f = self.mir.func(r.def).unwrap();
            let i = self.inst(Some(r.def), r.args.clone(), r.self_ty, f);
            return inst_target(i, r.def);
        }
        if !uses_shim(trait_name.as_str(), method.name.as_str()) {
            let f = self.mir.func(method).unwrap();
            let i = self.inst(Some(method), args.clone(), Some(self_ty), f);
            return inst_target(i, method);
        }
        let f = self.mir.shim(trait_name.as_str(), method, self_ty, args);
        let i = self.inst(None, Vec::new(), None, f);
        inst_target(i, method)
    }

    /// The dyn-callable methods of a dyn type's traits, in vtable order.
    pub fn dyn_methods(&mut self, dyn_ty: &Type) -> Vec<&mut Def> {
        let mut out = Vec::new();
        for b in dyn_ty.bounds.iter() {
            let tr = &TraitRef { tdef: b.tdef, self_ty: Some(dyn_ty), args: b.args.clone(), bindings: Vec::new() };
            for s in self.info.supertraits(tr).iter() {
                for m in self.info.trait_methods(s.trait_def()).iter() {
                    if self.info.dyn_callable(*m) { out.push(*m); }
                }
            }
        }
        out
    }

    fn vtable_index(&mut self, dyn_ty: &Type, m: &Def) -> usize {
        let ms = self.dyn_methods(dyn_ty);
        let mut i = 0;
        while i < ms.len() {
            if ms[i].id == m.id { return i; }
            i += 1;
        }
        self.errors.push(`method ${m.name} is not callable through dyn`);
        0
    }

    fn vtable(&mut self, concrete: &Type, dyn_ty: &Type) -> &mut Vtable {
        let key = `${concrete.id}/${dyn_ty.id}`;
        if let Some(v) = self.vtables.get(&key) { return *v; }
        let v = &mut Vtable { sym: `_navi_vt${self.vtables.len()}`, concrete, dyn_ty, methods: Vec::new() };
        self.vtables.insert(key, v);
        self.vtable_list.push(v);
        for m in self.dyn_methods(dyn_ty).iter() {
            match self.info.resolve_method(*m, concrete, &Vec::new()) {
                None => {
                    self.errors.push(`no impl of ${m.name} for ${concrete}`);
                    v.methods.push(intrinsic_target("unreachable", *m));
                }
                Some(r) => {
                    let t = self.resolved(r, *m, concrete, &Vec::new());
                    v.methods.push(t);
                }
            }
        }
        v
    }

    /// The identity of an instance's code: the function and the GC shapes of
    /// every local (including closures').
    fn shape_key(&mut self, inst: &Inst) -> String {
        let mut b = `${inst.func.id}`;
        // The type arguments' shapes (as Go does): generic code may depend
        // on layouts that no local exposes.
        for a in inst.args.iter() {
            b.push('<');
            b.push_str(self.shape(*a, 0).as_str());
        }
        if let Some(s) = inst.self_ty {
            b.push_str("<self ");
            b.push_str(self.shape(s, 0).as_str());
        }
        self.shape_walk(inst, inst.func, &mut b);
        b
    }

    fn shape_walk(&mut self, inst: &Inst, f: &Func, b: &mut String) {
        for l in f.locals.iter() {
            b.push('|');
            let t = inst.concrete(self.info, l.ty);
            b.push_str(self.shape(t, 0).as_str());
        }
        for blk in f.blocks.iter() {
            for s in blk.stmts.iter() {
                if let Stmt::Assign { rv, .. } = s {
                    if let Rvalue::Aggregate { closure, .. } = rv {
                        if let Some(cf) = closure {
                            b.push('{');
                            self.shape_walk(inst, *cf, b);
                            b.push('}');
                        }
                    }
                }
            }
        }
    }

    /// The layout-relevant structure of a type: thin pointers are all
    /// alike, everything else is described structurally.
    fn shape(&mut self, t: &Type, depth: i32) -> String {
        let key = (t.id as u64) << 8 | depth as u64;
        if let Some(s) = self.shapes.get(&key) { return s.clone(); }
        let s = self.shape_uncached(t, depth);
        self.shapes.insert(key, s.clone());
        s
    }

    fn shape_uncached(&mut self, t: &Type, depth: i32) -> String {
        let k = t.kind;
        match k {
            types::K_REF | types::K_PTR | types::K_FN => return shape_of(t),
            types::K_TUPLE => {
                let mut parts: Vec<String> = Vec::new();
                for e in t.elems.iter() { parts.push(self.shape(*e, depth + 1)); }
                return `(${parts.join(",")})`;
            }
            types::K_ARRAY => return `[${self.shape(t.el(), depth + 1)};${t.len}]`,
            types::K_ADT => {
                if depth > 8 { return `t${t.id}`; }
                let ai = self.info.adts[&t.d().id];
                let mut parts: Vec<String> = Vec::new();
                if ai.is_enum {
                    let mut v = 0;
                    while v < ai.variants.len() {
                        for ft in self.lay.field_types(t, v as i64).iter() { parts.push(self.shape(*ft, depth + 1)); }
                        parts.push("|".to_string());
                        v += 1;
                    }
                } else {
                    for ft in self.lay.field_types(t, -1).iter() { parts.push(self.shape(*ft, depth + 1)); }
                }
                return `d${t.d().id}{${parts.join(",")}}`;
            }
            _ => {}
        }
        types::type_string(t)
    }

    fn add_to_group(&mut self, inst: &mut Inst) {
        let key = self.shape_key(inst);
        let g = match self.groups_by_key.get(&key) {
            Some(g) => *g,
            None => {
                let name = match inst.def { Some(d) => d.name.clone(), None => if inst.func.name.len() > 0 { inst.func.name.clone() } else { "anon".to_string() } };
                let g = &mut Group { key: key.clone(), sym: `_navi_${self.groups.len()}_${sanitize(name.as_str())}`, rep: inst,
                    insts: Vec::new(), slots: HashMap::new(), nslots: 0, closure_syms: HashMap::new() };
                self.groups_by_key.insert(key, g);
                self.groups.push(g);
                g
            }
        };
        g.insts.push(inst);
        inst.group = Some(g);
        inst.dict = `${g.sym}_dict${g.insts.len() - 1}`;
    }

    /// Sorts the statics so that each is initialized after the statics its
    /// initializer (and everything it calls) reads.
    fn order_statics(&mut self) {
        let mut order: Vec<&mut Def> = Vec::new();
        let mut state: HashMap<u32, i32> = HashMap::new();
        let mut seen: HashMap<String, bool> = HashMap::new();
        let statics = self.statics.clone();
        for d in statics.iter() { self.visit_static(*d, &mut state, &mut seen, &mut order); }
        self.statics = order;
    }

    fn visit_static(&mut self, d: &mut Def, state: &mut HashMap<u32, i32>, seen: &mut HashMap<String, bool>, order: &mut Vec<&mut Def>) {
        if state.contains_key(&d.id) { return; }
        state.insert(d.id, 1);
        if let Some(i) = self.static_init.get(&d.id) { self.visit_inst(*i, state, seen, order); }
        state.insert(d.id, 2);
        order.push(d);
    }

    fn visit_inst(&mut self, inst: &mut Inst, state: &mut HashMap<u32, i32>, seen: &mut HashMap<String, bool>, order: &mut Vec<&mut Def>) {
        if seen.contains_key(&inst.key) { return; }
        seen.insert(inst.key.clone(), true);
        for d in inst.statics.iter() { self.visit_static(*d, state, seen, order); }
        for k in inst.sites.iter() {
            if let Some(t) = inst.targets.get(k) {
                if t.kind == T_INST { self.visit_inst(t.inst.unwrap(), state, seen, order); }
            }
            if let Some(v) = inst.vtables.get(k) {
                for m in v.methods.iter() {
                    if m.kind == T_INST { self.visit_inst(m.inst.unwrap(), state, seen, order); }
                }
            }
        }
    }

    /// Finds, for every group, the sites whose target or vtable differs
    /// between its instantiations; each gets a dictionary slot.
    fn assign_slots(&mut self) {
        for g in self.groups.iter_mut() {
            if g.insts.len() < 2 { continue; }
            let rep = g.rep;
            for k in rep.sites.iter() {
                let mut differs = false;
                let mut j = 1;
                while j < g.insts.len() {
                    let other = g.insts[j];
                    match rep.targets.get(k) {
                        Some(t) => {
                            match other.targets.get(k) {
                                None => { differs = true; }
                                Some(o) => { if o.key() != t.key() { differs = true; } }
                            }
                        }
                        None => {
                            let a = rep.vtables[k];
                            let same = match other.vtables.get(k) { Some(b) => std::ptr::eq(a, *b), None => false };
                            if !same { differs = true; }
                        }
                    }
                    j += 1;
                }
                if differs {
                    g.slots.insert(k.clone(), g.nslots);
                    g.nslots += 1;
                }
            }
        }
    }
}
