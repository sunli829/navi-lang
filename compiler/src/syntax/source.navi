//! Source files, positions and diagnostics.

use crate::syntax::token::Token;

/// A byte offset into a source file.
pub type Pos = i32;

/// A node or token without a source position.
pub const NO_POS: Pos = -1;

/// A source file being compiled.
pub struct File {
    pub name: String,
    pub src: String,
    lines: Vec<Pos>,
}

/// A human-readable location (line and column count from one; columns
/// count bytes).
#[derive(Clone, Debug, PartialEq)]
pub struct Position {
    pub file: String,
    pub line: i32,
    pub col: i32,
}

impl std::fmt::Display for Position {
    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
        f.write_fmt(`${self.file}:${self.line}:${self.col}`)
    }
}

impl File {
    pub fn new(name: &str, src: String) -> &File {
        let mut lines = Vec::new();
        lines.push(0);
        let b = src.as_bytes();
        let mut i = 0;
        while i < b.len() {
            if b[i] == b'\n' { lines.push((i + 1) as Pos); }
            i += 1;
        }
        &File { name: name.to_string(), src, lines }
    }

    pub fn bytes(&self) -> &[u8] { self.src.as_bytes() }

    /// Converts a byte offset into a line and column.
    /// The line and column of pos (from one), without making a Position.
    pub fn line_col(&self, pos: Pos) -> (u32, u32) {
        let l = self.line_of(pos);
        (l, (pos - self.lines[(l - 1) as usize] + 1) as u32)
    }

    /// The line of pos (from one), without making a Position.
    pub fn line_of(&self, pos: Pos) -> u32 {
        let mut lo = 0;
        let mut hi = self.lines.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if self.lines[mid] > pos { hi = mid; } else { lo = mid + 1; }
        }
        lo as u32
    }

    pub fn position(&self, pos: Pos) -> Position {
        // The last line start <= pos.
        let mut lo = 0;
        let mut hi = self.lines.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if self.lines[mid] > pos { hi = mid; } else { lo = mid + 1; }
        }
        let i = lo - 1;
        Position { file: self.name.clone(), line: (i + 1) as i32, col: pos - self.lines[i] + 1 }
    }
}

/// An error found while compiling a file.
#[derive(Clone, Debug)]
pub struct Diagnostic {
    pub pos: Pos,
    pub msg: String,
}

/// The diagnostics of one file.
pub struct Errors {
    pub file: &File,
    pub diags: Vec<Diagnostic>,
}

impl Errors {
    pub fn new(file: &File) -> &mut Errors { &mut Errors { file, diags: Vec::new() } }

    pub fn add(&mut self, pos: Pos, msg: String) { self.diags.push(Diagnostic { pos, msg }); }

    pub fn len(&self) -> usize { self.diags.len() }

    /// All diagnostics, one per line: file:line:col: message.
    pub fn to_string(&self) -> String {
        let mut out = String::new();
        let mut i = 0;
        while i < self.diags.len() {
            if i > 0 { out.push('\n'); }
            let d = self.diags[i].clone();
            out.push_str(&`${self.file.position(d.pos)}: ${d.msg}`.to_string());
            i += 1;
        }
        out
    }
}
