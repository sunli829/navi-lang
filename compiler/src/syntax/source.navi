//! Source files, positions and diagnostics.

use crate::syntax::token::Token;

/// A byte offset into a source file.
pub type Pos = i32;

/// A node or token without a source position.
pub const NO_POS: Pos = -1;

/// A source file being compiled.
pub struct File {
    pub name: String,
    pub src: String,
    lines: Vec<Pos>,
    /// Its line directives, by line.
    directives: Vec<Directive>,
    /// Code a derive macro generated: where its positions are in the
    /// user's file (crate::derive).
    pub origin: Option<&Origin>,
}

/// Where generated code comes from: bytes start..end of it come from
/// position pos in file (the innermost span holds); the rest from at (the
/// #[derive(...)] attribute).
pub struct Origin {
    pub file: &File,
    pub at: Pos,
    pub spans: Vec<(Pos, Pos, Pos)>,
    /// What generated it (derive X for T), for notes.
    pub what: String,
}

/// A line directive (as Go's): `//line path:line:col` at the start of a
/// line says the next line is line `line` of `path` and starts at its column
/// `col` (`//line path:line` keeps columns). Generated code (doctests) says
/// where its lines come from.
#[derive(Clone)]
struct Directive {
    /// The directive's own line (from one).
    at: i32,
    file: String,
    line: i32,
    col: i32,
}

// The directives of src: lines that start with //line and name a position.
fn parse_directives(src: &str) -> Vec<Directive> {
    let mut out: Vec<Directive> = Vec::new();
    if !src.contains("//line ") {
        return out;
    }
    let mut n = 0;
    for l in src.split('\n') {
        n += 1;
        let rest = match l.strip_prefix("//line ") {
            Some(r) => r.trim_end(),
            None => continue,
        };
        // From the right: path:line:col or path:line (the path may hold
        // colons).
        let (a, last) = match rest.rfind(':') {
            Some(k) => (&rest[..k], &rest[k + 1..]),
            None => continue,
        };
        let last = match last.parse::<i32>() {
            Ok(v) if v > 0 => v,
            _ => continue,
        };
        let mut file = a;
        let mut line = last;
        let mut col = 0;
        if let Some(k) = a.rfind(':') {
            if let Ok(v) = a[k + 1..].parse::<i32>() {
                if v > 0 {
                    file = &a[..k];
                    line = v;
                    col = last;
                }
            }
        }
        if file.len() == 0 {
            continue;
        }
        out.push(Directive {
            at: n,
            file: file.to_string(),
            line,
            col,
        });
    }
    out
}

/// A human-readable location (line and column count from one; columns
/// count bytes).
#[derive(Clone, Debug, PartialEq)]
pub struct Position {
    pub file: String,
    pub line: i32,
    pub col: i32,
}

impl std::fmt::Display for Position {
    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
        f.write_fmt(`${self.file}:${self.line}:${self.col}`)
    }
}

impl File {
    pub fn new(name: &str, src: String) -> &File {
        let mut lines = Vec::new();
        lines.push(0);
        let b = src.as_bytes();
        let mut i = 0;
        while i < b.len() {
            if b[i] == b'\n' {
                lines.push((i + 1) as Pos);
            }
            i += 1;
        }
        let directives = parse_directives(src.as_str());
        &File {
            name: name.to_string(),
            src,
            lines,
            directives,
            origin: None,
        }
    }

    /// Code a derive macro generated (positions map through origin).
    pub fn generated(name: &str, src: String, origin: &Origin) -> &File {
        let f = File::new(name, src);
        &File {
            name: f.name.clone(),
            src: f.src.clone(),
            lines: f.lines.clone(),
            directives: Vec::new(),
            origin: Some(origin),
        }
    }

    /// A file known by its line starts only (from a crate's export data,
    /// crate::navih: positions in it still give lines; it has no text).
    pub fn with_lines(name: &str, lines: Vec<Pos>) -> &File {
        &File {
            name: name.to_string(),
            src: String::new(),
            lines,
            directives: Vec::new(),
            origin: None,
        }
    }

    /// The same for generated code (export data keeps where it comes from).
    pub fn with_lines_origin(name: &str, lines: Vec<Pos>, origin: &Origin) -> &File {
        &File {
            name: name.to_string(),
            src: String::new(),
            lines,
            directives: Vec::new(),
            origin: Some(origin),
        }
    }

    /// Whether line directives say where its lines come from.
    pub fn has_directives(&self) -> bool {
        self.directives.len() > 0
    }

    /// Where each line starts.
    pub fn line_starts(&self) -> &Vec<Pos> {
        &self.lines
    }

    pub fn bytes(&self) -> &[u8] {
        self.src.as_bytes()
    }

    /// Converts a byte offset into a line and column.
    /// The line and column of pos (from one), without making a Position.
    pub fn line_col(&self, pos: Pos) -> (u32, u32) {
        let l = self.line_of(pos);
        (l, (pos - self.lines[(l - 1) as usize] + 1) as u32)
    }

    /// The line of pos (from one), without making a Position.
    pub fn line_of(&self, pos: Pos) -> u32 {
        let mut lo = 0;
        let mut hi = self.lines.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if self.lines[mid] > pos {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
        lo as u32
    }

    pub fn position(&self, pos: Pos) -> Position {
        if let Some(o) = self.origin {
            return o.file.position(self.origin_pos(pos));
        }
        let p = self.own_position(pos);
        if self.directives.len() == 0 {
            return p;
        }
        // The last directive above p's line.
        let mut lo = 0;
        let mut hi = self.directives.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if self.directives[mid].at < p.line {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        if lo == 0 {
            return p;
        }
        let d = &self.directives[lo - 1];
        Position {
            file: d.file.clone(),
            line: d.line + (p.line - d.at - 1),
            col: if d.col > 0 { d.col + p.col - 1 } else { p.col },
        }
    }

    /// The position in the user's file that pos in generated code comes
    /// from.
    pub fn origin_pos(&self, pos: Pos) -> Pos {
        let o = match self.origin {
            Some(o) => o,
            None => return pos,
        };
        let mut best = o.at;
        let mut len: Pos = -1;
        for (s, e, p) in o.spans.iter() {
            if pos >= *s && pos < *e && (len < 0 || *e - *s < len) {
                best = *p;
                len = *e - *s;
            }
        }
        best
    }

    /// A note for a diagnostic at pos in generated code: the line of the
    /// code (empty for other files).
    pub fn origin_note(&self, pos: Pos) -> String {
        let o = match self.origin {
            Some(o) => o,
            None => return String::new(),
        };
        let p = self.own_position(pos);
        let start = self.lines[(p.line - 1) as usize] as usize;
        let mut end = start;
        let b = self.src.as_bytes();
        while end < b.len() && b[end] != b'\n' {
            end += 1;
        }
        let mut line = self.src[start..end].trim().to_string();
        if line.len() > 160 {
            // Around pos.
            let at = if pos as usize > start {
                pos as usize - start
            } else {
                0
            };
            let mut a = if at > 60 { at - 60 } else { 0 };
            while a > 0 && !self.src.is_char_boundary(start + a) {
                a -= 1;
            }
            let mut z = if a + 160 < end - start {
                a + 160
            } else {
                end - start
            };
            while z < end - start && !self.src.is_char_boundary(start + z) {
                z += 1;
            }
            line = `...${self.src[start + a..start + z].trim()}...`.to_string();
        }
        `\n  note: in the code ${o.what} generated: ${line}`.to_string()
    }

    fn own_position(&self, pos: Pos) -> Position {
        // The last line start <= pos.
        let mut lo = 0;
        let mut hi = self.lines.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if self.lines[mid] > pos {
                hi = mid;
            } else {
                lo = mid + 1;
            }
        }
        let i = lo - 1;
        Position {
            file: self.name.clone(),
            line: (i + 1) as i32,
            col: pos - self.lines[i] + 1,
        }
    }
}

/// An error found while compiling a file.
#[derive(Clone, Debug)]
pub struct Diagnostic {
    pub pos: Pos,
    pub msg: String,
}

/// The diagnostics of one file.
pub struct Errors {
    pub file: &File,
    pub diags: Vec<Diagnostic>,
}

impl Errors {
    pub fn new(file: &File) -> &mut Errors {
        &mut Errors {
            file,
            diags: Vec::new(),
        }
    }

    pub fn add(&mut self, pos: Pos, msg: String) {
        self.diags.push(Diagnostic { pos, msg });
    }

    pub fn len(&self) -> usize {
        self.diags.len()
    }

    /// All diagnostics, one per line: file:line:col: message.
    pub fn to_string(&self) -> String {
        let mut out = String::new();
        let mut i = 0;
        while i < self.diags.len() {
            if i > 0 {
                out.push('\n');
            }
            let d = self.diags[i].clone();
            out.push_str(&`${self.file.position(d.pos)}: ${d.msg}`.to_string());
            i += 1;
        }
        out
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn line_directives() {
        let src = "\na\n//line src/x.navi:10:5\nb c\nd\n//line C:\\w\\y.navi:3\n e\n//line bad\nf";
        let f = File::new("gen.navi", src.to_string());
        let at = |s: &str| -> String {
            let k = src.find(`\n${s}`.to_string().as_str()).unwrap() + 1;
            f.position(k as Pos).to_string()
        };
        assert_eq(at("a"), "gen.navi:2:1".to_string());
        assert_eq(at("b"), "src/x.navi:10:5".to_string());
        let c = f
            .position((src.find("b c").unwrap() + 2) as Pos)
            .to_string();
        assert_eq(c, "src/x.navi:10:7".to_string());
        assert_eq(at("d"), "src/x.navi:11:5".to_string());
        // Without a column, columns are the line's own.
        assert_eq(at(" e"), "C:\\w\\y.navi:3:1".to_string());
        // Not a directive: the one above holds.
        assert_eq(at("f"), "C:\\w\\y.navi:5:1".to_string());
    }
}
