//! Tokens.

/// A token kind (one of the constants below).
pub type Kind = u8;

pub const EOF: Kind = 0;
pub const ILLEGAL: Kind = 1;
pub const IDENT: Kind = 2;
pub const LIFETIME: Kind = 3;
pub const INT: Kind = 4;
pub const FLOAT: Kind = 5;
pub const CHAR: Kind = 6;
pub const BYTE: Kind = 7;
pub const STRING: Kind = 8;
pub const RAW_STRING: Kind = 9;
pub const BYTE_STRING: Kind = 10;
pub const TEMPLATE: Kind = 11;
pub const PLUS: Kind = 12;
pub const MINUS: Kind = 13;
pub const STAR: Kind = 14;
pub const SLASH: Kind = 15;
pub const PERCENT: Kind = 16;
pub const CARET: Kind = 17;
pub const NOT: Kind = 18;
pub const AND: Kind = 19;
pub const OR: Kind = 20;
pub const AND_AND: Kind = 21;
pub const OR_OR: Kind = 22;
pub const SHL: Kind = 23;
pub const SHR: Kind = 24;
pub const PLUS_EQ: Kind = 25;
pub const MINUS_EQ: Kind = 26;
pub const STAR_EQ: Kind = 27;
pub const SLASH_EQ: Kind = 28;
pub const PERCENT_EQ: Kind = 29;
pub const CARET_EQ: Kind = 30;
pub const AND_EQ: Kind = 31;
pub const OR_EQ: Kind = 32;
pub const SHL_EQ: Kind = 33;
pub const SHR_EQ: Kind = 34;
pub const EQ: Kind = 35;
pub const EQ_EQ: Kind = 36;
pub const NE: Kind = 37;
pub const GT: Kind = 38;
pub const LT: Kind = 39;
pub const GE: Kind = 40;
pub const LE: Kind = 41;
pub const AT: Kind = 42;
pub const UNDERSCORE: Kind = 43;
pub const DOT: Kind = 44;
pub const DOT_DOT: Kind = 45;
pub const DOT_DOT_EQ: Kind = 46;
pub const COMMA: Kind = 47;
pub const SEMI: Kind = 48;
pub const COLON: Kind = 49;
pub const PATH_SEP: Kind = 50;
pub const R_ARROW: Kind = 51;
pub const FAT_ARROW: Kind = 52;
pub const POUND: Kind = 53;
pub const QUESTION: Kind = 54;
pub const L_PAREN: Kind = 55;
pub const R_PAREN: Kind = 56;
pub const L_BRACKET: Kind = 57;
pub const R_BRACKET: Kind = 58;
pub const L_BRACE: Kind = 59;
pub const R_BRACE: Kind = 60;
pub const KEYWORD_START: Kind = 61;
pub const KW_AS: Kind = 62;
pub const KW_BREAK: Kind = 63;
pub const KW_CONST: Kind = 64;
pub const KW_CONTINUE: Kind = 65;
pub const KW_CRATE: Kind = 66;
pub const KW_DEFER: Kind = 67;
pub const KW_DYN: Kind = 68;
pub const KW_ELSE: Kind = 69;
pub const KW_ENUM: Kind = 70;
pub const KW_EXTERN: Kind = 71;
pub const KW_FALSE: Kind = 72;
pub const KW_FN: Kind = 73;
pub const KW_FOR: Kind = 74;
pub const KW_IF: Kind = 75;
pub const KW_IMPL: Kind = 76;
pub const KW_IN: Kind = 77;
pub const KW_LET: Kind = 78;
pub const KW_LOOP: Kind = 79;
pub const KW_MATCH: Kind = 80;
pub const KW_MOD: Kind = 81;
pub const KW_MUT: Kind = 82;
pub const KW_PUB: Kind = 83;
pub const KW_RETURN: Kind = 84;
pub const KW_SELECT: Kind = 85;
pub const KW_SELF_VALUE: Kind = 86;
pub const KW_SELF_TYPE: Kind = 87;
pub const KW_STATIC: Kind = 88;
pub const KW_STRUCT: Kind = 89;
pub const KW_SUPER: Kind = 90;
pub const KW_TRAIT: Kind = 91;
pub const KW_TRUE: Kind = 92;
pub const KW_TYPE: Kind = 93;
pub const KW_UNSAFE: Kind = 94;
pub const KW_USE: Kind = 95;
pub const KW_WHERE: Kind = 96;
pub const KW_WHILE: Kind = 97;
pub const KEYWORD_END: Kind = 98;

const NAMES: [&str; 99] = [
    "end of file",
    "illegal token",
    "identifier",
    "label",
    "integer literal",
    "float literal",
    "char literal",
    "byte literal",
    "string literal",
    "raw string literal",
    "byte string literal",
    "template string",
    "+",
    "-",
    "*",
    "/",
    "%",
    "^",
    "!",
    "&",
    "|",
    "&&",
    "||",
    "<<",
    ">>",
    "+=",
    "-=",
    "*=",
    "/=",
    "%=",
    "^=",
    "&=",
    "|=",
    "<<=",
    ">>=",
    "=",
    "==",
    "!=",
    ">",
    "<",
    ">=",
    "<=",
    "@",
    "_",
    ".",
    "..",
    "..=",
    ",",
    ";",
    ":",
    "::",
    "->",
    "=>",
    "#",
    "?",
    "(",
    ")",
    "[",
    "]",
    "{",
    "}",
    "",
    "as",
    "break",
    "const",
    "continue",
    "crate",
    "defer",
    "dyn",
    "else",
    "enum",
    "extern",
    "false",
    "fn",
    "for",
    "if",
    "impl",
    "in",
    "let",
    "loop",
    "match",
    "mod",
    "mut",
    "pub",
    "return",
    "select",
    "self",
    "Self",
    "static",
    "struct",
    "super",
    "trait",
    "true",
    "type",
    "unsafe",
    "use",
    "where",
    "while",
    "",
];

/// The spelling of a kind, as in error messages.
pub fn kind_name(k: Kind) -> &str {
    if (k as usize) < 99 { NAMES[k as usize] } else { "?" }
}

pub fn is_keyword(k: Kind) -> bool { k > KEYWORD_START && k < KEYWORD_END }

/// The keyword spelled text, or IDENT.
pub fn keyword(text: &str) -> Kind {
    let mut k = KEYWORD_START + 1;
    while k < KEYWORD_END {
        if NAMES[k as usize] == text { return k; }
        k += 1;
    }
    IDENT
}

/// Words reserved for future use.
pub fn is_reserved(text: &str) -> bool {
    text == "async" || text == "await" || text == "box" || text == "macro" || text == "move" || text == "try" || text == "union" || text == "yield"
}

/// A lexed token. text is the source text of literals, names and template
/// strings (empty for punctuation and keywords).
#[derive(Clone, Debug)]
pub struct Token {
    pub kind: Kind,
    pub pos: i32,
    pub end: i32,
    pub text: &str,
}
