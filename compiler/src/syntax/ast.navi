//! The abstract syntax tree. Nodes that later phases attach information
//! to (expressions, patterns, types, items, ...) carry an id that is
//! unique within a compilation; maps keyed by node use it.

use crate::syntax::source::{File, Pos, NO_POS};
use crate::syntax::token::{Token, Kind};

static NEXT_ID: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(1);

/// A fresh node id (threads may take them at once).
pub fn new_id() -> u32 { NEXT_ID.fetch_add(1, std::sync::atomic::Ordering::Relaxed) as u32 }

/// The next id new_id returns, and setting it (after files were parsed
/// with their own IdGen).
pub fn next_id() -> u32 { NEXT_ID.load(std::sync::atomic::Ordering::SeqCst) as u32 }
pub fn set_next_id(n: u32) { NEXT_ID.store(n as usize, std::sync::atomic::Ordering::SeqCst); }

/// The node ids of one parse.
pub struct IdGen {
    pub next: u32,
}

/// The AST of one file.
pub struct SourceFile {
    pub file: &File,
    pub attrs: Vec<&Attr>,
    pub items: Vec<Item>,
}

/// An identifier with its position.
#[derive(Clone, Debug)]
pub struct Name {
    pub pos: Pos,
    pub value: String,
}

pub fn name(pos: Pos, value: &str) -> &Name { &Name { pos, value: value.to_string() } }

/// #[path], #[path(args)] or #[path = value].
pub struct Attr {
    pub hash: Pos,
    pub inner: bool,
    pub path: &Path,
    pub args: Vec<Token>,
    pub value: Option<&Expr>,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub enum Vis { Private, Pub, Crate, Super }

/// a::b::<T>::c, possibly with a <T as Trait> prefix.
pub struct Path {
    pub id: u32,
    pub segments: Vec<&PathSegment>,
    pub qself: Option<&QSelf>,
}

impl Path {
    pub fn pos(&self) -> Pos {
        match self.qself {
            Some(q) => q.lt,
            None => self.segments[0].name.pos,
        }
    }
}

pub struct PathSegment {
    pub name: &Name,
    pub args: Option<&GenericArgs>,
}

pub struct QSelf {
    pub lt: Pos,
    pub ty: &Type,
    pub trait_path: Option<&Path>,
}

pub struct GenericArgs {
    pub lt: Pos,
    pub args: Vec<&Type>,
    pub bindings: Vec<&AssocBinding>,
}

pub struct AssocBinding {
    pub name: &Name,
    pub ty: &Type,
}

pub struct Generics {
    pub lt: Pos,
    pub params: Vec<&GenericParam>,
    pub wheres: Vec<&WherePredicate>,
}

pub struct GenericParam {
    pub id: u32,
    pub name: &Name,
    pub bounds: Vec<&Path>,
    pub default: Option<&Type>,
    /// The type of a const parameter (const N: usize).
    pub ty: Option<&Type>,
}

pub struct WherePredicate {
    pub ty: &Type,
    pub bounds: Vec<&Path>,
}

// --- Items -------------------------------------------------------------------------

pub struct ItemBase {
    pub id: u32,
    pub attrs: Vec<&Attr>,
    pub vis: Vis,
    pub start: Pos,
}

#[derive(Clone)]
pub enum Item {
    Fn(&mut FnDecl),
    Struct(&mut StructDecl),
    Enum(&mut EnumDecl),
    TypeAlias(&mut TypeAlias),
    Const(&mut ConstDecl),
    Static(&mut StaticDecl),
    Impl(&mut ImplDecl),
    Trait(&mut TraitDecl),
    Mod(&mut ModDecl),
    Use(&mut UseDecl),
    Extern(&mut ExternBlock),
}

impl Item {
    pub fn base(&self) -> &ItemBase {
        match self {
            Item::Fn(x) => &x.base,
            Item::Struct(x) => &x.base,
            Item::Enum(x) => &x.base,
            Item::TypeAlias(x) => &x.base,
            Item::Const(x) => &x.base,
            Item::Static(x) => &x.base,
            Item::Impl(x) => &x.base,
            Item::Trait(x) => &x.base,
            Item::Mod(x) => &x.base,
            Item::Use(x) => &x.base,
            Item::Extern(x) => &x.base,
        }
    }
    pub fn id(&self) -> u32 { self.base().id }
    pub fn pos(&self) -> Pos { self.base().start }
}

pub struct FnDecl {
    pub base: ItemBase,
    pub name: &Name,
    pub is_const: bool,
    pub is_unsafe: bool,
    pub abi: String,
    pub generics: &mut Generics,
    pub self_param: Option<&SelfParam>,
    pub params: Vec<&Param>,
    pub result: Option<&Type>,
    pub body: Option<&Expr>,
}

pub struct SelfParam {
    pub pos: Pos,
    pub is_ref: bool,
    pub is_mut: bool,
}

pub struct Param {
    pub pat: &Pat,
    pub ty: Option<&Type>,
}

#[derive(Clone, Debug, PartialEq, Eq)]
pub enum StructKind { Named, Tuple, Unit }

pub struct StructDecl {
    pub base: ItemBase,
    pub name: &Name,
    pub generics: &mut Generics,
    pub kind: StructKind,
    pub fields: Vec<&Field>,
}

pub struct Field {
    pub id: u32,
    pub attrs: Vec<&Attr>,
    pub vis: Vis,
    pub name: Option<&Name>,
    pub ty: &Type,
}

pub struct EnumDecl {
    pub base: ItemBase,
    pub name: &Name,
    pub generics: &mut Generics,
    pub variants: Vec<&Variant>,
}

pub struct Variant {
    pub id: u32,
    pub attrs: Vec<&Attr>,
    pub name: &Name,
    pub kind: StructKind,
    pub fields: Vec<&Field>,
    pub discriminant: Option<&Expr>,
}

pub struct TypeAlias {
    pub base: ItemBase,
    pub name: &Name,
    pub generics: &mut Generics,
    pub bounds: Vec<&Path>,
    pub ty: Option<&Type>,
}

pub struct ConstDecl {
    pub base: ItemBase,
    pub name: &Name,
    pub ty: &Type,
    pub value: Option<&Expr>,
}

pub struct StaticDecl {
    pub base: ItemBase,
    pub name: &Name,
    pub is_mut: bool,
    pub ty: &Type,
    pub value: Option<&Expr>,
}

pub struct ImplDecl {
    pub base: ItemBase,
    pub is_unsafe: bool,
    pub generics: &mut Generics,
    pub trait_path: Option<&Path>,
    pub ty: &Type,
    pub items: Vec<Item>,
}

pub struct TraitDecl {
    pub base: ItemBase,
    pub is_unsafe: bool,
    pub name: &Name,
    pub generics: &mut Generics,
    pub supers: Vec<&Path>,
    pub items: Vec<Item>,
}

pub struct ModDecl {
    pub base: ItemBase,
    pub name: &Name,
    pub inline: bool,
    pub items: Vec<Item>,
}

pub struct UseDecl {
    pub base: ItemBase,
    pub tree: &UseTree,
}

pub struct UseTree {
    pub prefix: Option<&Path>,
    pub alias: Option<&Name>,
    pub glob: bool,
    pub children: Vec<&UseTree>,
    pub group: bool,
}

pub struct ExternBlock {
    pub base: ItemBase,
    pub abi: String,
    pub items: Vec<Item>,
}

// --- Types ---------------------------------------------------------------------------

pub struct Type {
    pub id: u32,
    pub kind: TypeKind,
}

pub enum TypeKind {
    Path(&Path),
    Ref { amp: Pos, is_mut: bool, elem: &Type },
    Ptr { star: Pos, is_mut: bool, elem: &Type },
    Slice { lbrack: Pos, elem: &Type },
    Array { lbrack: Pos, elem: &Type, len: &Expr },
    Tuple { lparen: Pos, elems: Vec<&Type> },
    Fn { start: Pos, abi: String, params: Vec<&Type>, result: Option<&Type> },
    Dyn { pos: Pos, bounds: Vec<&Path> },
    Impl { pos: Pos, bounds: Vec<&Path> },
    Never(Pos),
    Infer(Pos),
    /// A const generic argument: a literal, -literal or { expr }.
    Const(&Expr),
}

pub fn ty(kind: TypeKind) -> &Type { &Type { id: new_id(), kind } }

impl Type {
    pub fn pos(&self) -> Pos {
        match &self.kind {
            TypeKind::Path(p) => p.pos(),
            TypeKind::Ref { amp, .. } => *amp,
            TypeKind::Ptr { star, .. } => *star,
            TypeKind::Slice { lbrack, .. } => *lbrack,
            TypeKind::Array { lbrack, .. } => *lbrack,
            TypeKind::Tuple { lparen, .. } => *lparen,
            TypeKind::Fn { start, .. } => *start,
            TypeKind::Dyn { pos, .. } => *pos,
            TypeKind::Impl { pos, .. } => *pos,
            TypeKind::Never(p) => *p,
            TypeKind::Infer(p) => *p,
            TypeKind::Const(x) => x.pos(),
        }
    }
}

// --- Expressions -----------------------------------------------------------------------

#[derive(Clone, Debug, PartialEq, Eq)]
pub enum LitKind { Int, Float, Char, Byte, Str, ByteStr, Bool }

pub struct Expr {
    pub id: u32,
    pub kind: ExprKind,
}

pub enum ExprKind {
    Lit { pos: Pos, kind: LitKind, value: String },
    Template { pos: Pos, parts: Vec<&TemplatePart> },
    Path(&Path),
    Unary { op_pos: Pos, op: Kind, x: &Expr },
    Ref { amp: Pos, is_mut: bool, x: &Expr },
    Binary { op: Kind, op_pos: Pos, x: &Expr, y: &Expr },
    Assign { op: Kind, op_pos: Pos, x: &Expr, y: &Expr },
    Cast { x: &Expr, ty: &Type },
    Range { op_pos: Pos, lo: Option<&Expr>, hi: Option<&Expr>, inclusive: bool },
    Call { fun: &Expr, lparen: Pos, args: Vec<&Expr> },
    MethodCall { recv: &Expr, name: &Name, type_args: Option<&GenericArgs>, args: Vec<&Expr> },
    Field { x: &Expr, name: &Name },
    Index { x: &Expr, lbrack: Pos, index: &Expr },
    Try { x: &Expr, question: Pos },
    StructLit { path: &Path, fields: Vec<&FieldInit>, base: Option<&Expr> },
    Tuple { lparen: Pos, elems: Vec<&Expr> },
    Paren { lparen: Pos, x: &Expr },
    Array { lbrack: Pos, elems: Vec<&Expr> },
    ArrayRepeat { lbrack: Pos, value: &Expr, count: &Expr },
    Block(&mut Block),
    If { pos: Pos, cond: &Expr, then: &Expr, els: Option<&Expr> },
    Let { pos: Pos, pat: &Pat, x: &Expr },
    Match { pos: Pos, x: &Expr, arms: Vec<&MatchArm> },
    Loop { label: Option<&Name>, pos: Pos, body: &Expr },
    While { label: Option<&Name>, pos: Pos, cond: &Expr, body: &Expr },
    For { label: Option<&Name>, pos: Pos, pat: &Pat, iter: &Expr, body: &Expr },
    Break { pos: Pos, label: Option<&Name>, value: Option<&Expr> },
    Continue { pos: Pos, label: Option<&Name> },
    Return { pos: Pos, value: Option<&Expr> },
    Closure { pos: Pos, params: Vec<&Param>, result: Option<&Type>, body: &Expr },
    Select { pos: Pos, arms: Vec<&SelectArm> },
    Bad(Pos),
}

/// { stmts; tail } or unsafe { ... }.
pub struct Block {
    pub lbrace: Pos,
    pub rbrace: Pos,
    pub is_unsafe: bool,
    pub stmts: Vec<&Stmt>,
    pub tail: Option<&Expr>,
}

pub fn expr(kind: ExprKind) -> &Expr { &Expr { id: new_id(), kind } }

impl Expr {
    pub fn pos(&self) -> Pos {
        match &self.kind {
            ExprKind::Lit { pos, .. } => *pos,
            ExprKind::Template { pos, .. } => *pos,
            ExprKind::Path(p) => p.pos(),
            ExprKind::Unary { op_pos, .. } => *op_pos,
            ExprKind::Ref { amp, .. } => *amp,
            ExprKind::Binary { x, .. } => x.pos(),
            ExprKind::Assign { x, .. } => x.pos(),
            ExprKind::Cast { x, .. } => x.pos(),
            ExprKind::Range { op_pos, lo, .. } => match lo { Some(l) => l.pos(), None => *op_pos },
            ExprKind::Call { fun, .. } => fun.pos(),
            ExprKind::MethodCall { recv, .. } => recv.pos(),
            ExprKind::Field { x, .. } => x.pos(),
            ExprKind::Index { x, .. } => x.pos(),
            ExprKind::Try { x, .. } => x.pos(),
            ExprKind::StructLit { path, .. } => path.pos(),
            ExprKind::Tuple { lparen, .. } => *lparen,
            ExprKind::Paren { lparen, .. } => *lparen,
            ExprKind::Array { lbrack, .. } => *lbrack,
            ExprKind::ArrayRepeat { lbrack, .. } => *lbrack,
            ExprKind::Block(b) => b.lbrace,
            ExprKind::If { pos, .. } => *pos,
            ExprKind::Let { pos, .. } => *pos,
            ExprKind::Match { pos, .. } => *pos,
            ExprKind::Loop { label, pos, .. } => match label { Some(l) => l.pos, None => *pos },
            ExprKind::While { label, pos, .. } => match label { Some(l) => l.pos, None => *pos },
            ExprKind::For { label, pos, .. } => match label { Some(l) => l.pos, None => *pos },
            ExprKind::Break { pos, .. } => *pos,
            ExprKind::Continue { pos, .. } => *pos,
            ExprKind::Return { pos, .. } => *pos,
            ExprKind::Closure { pos, .. } => *pos,
            ExprKind::Select { pos, .. } => *pos,
            ExprKind::Bad(p) => *p,
        }
    }

    /// The block of a block expression.
    pub fn block(&self) -> &mut Block {
        match &self.kind {
            ExprKind::Block(b) => *b,
            _ => panic("not a block expression"),
        }
    }
}

/// Literal text or an interpolated expression of a template string.
pub struct TemplatePart {
    pub text: String,
    pub x: Option<&Expr>,
    pub spec: String,
}

pub struct FieldInit {
    pub name: &Name,
    pub value: &Expr,
}

pub struct MatchArm {
    pub pat: &Pat,
    pub guard: Option<&Expr>,
    pub body: &Expr,
}

pub struct SelectArm {
    pub pat: Option<&Pat>,
    pub op: Option<&Expr>,
    pub is_default: bool,
    pub body: &Expr,
}

// --- Statements ------------------------------------------------------------------------

pub enum Stmt {
    Let(&LetStmt),
    Expr { x: &Expr, semi: bool },
    Item(Item),
    Defer { pos: Pos, x: &Expr },
    Empty(Pos),
}

pub struct LetStmt {
    pub pos: Pos,
    pub pat: &Pat,
    pub ty: Option<&Type>,
    pub init: Option<&Expr>,
    pub els: Option<&Expr>,
}

impl Stmt {
    pub fn pos(&self) -> Pos {
        match self {
            Stmt::Let(l) => l.pos,
            Stmt::Expr { x, .. } => x.pos(),
            Stmt::Item(it) => it.pos(),
            Stmt::Defer { pos, .. } => *pos,
            Stmt::Empty(p) => *p,
        }
    }
}

// --- Patterns --------------------------------------------------------------------------

pub struct Pat {
    pub id: u32,
    pub kind: PatKind,
}

pub enum PatKind {
    Wild(Pos),
    Rest(Pos),
    Ident { is_mut: bool, name: &Name, sub: Option<&Pat> },
    Lit(&Expr),
    Range { lo: Option<&Expr>, hi: Option<&Expr>, inclusive: bool, op_pos: Pos },
    Path(&Path),
    Tuple { lparen: Pos, elems: Vec<&Pat> },
    TupleStruct { path: &Path, elems: Vec<&Pat> },
    Struct { path: &Path, fields: Vec<&FieldPat>, rest: bool },
    Slice { lbrack: Pos, elems: Vec<&Pat> },
    Ref { amp: Pos, pat: &Pat },
    Or(Vec<&Pat>),
}

pub struct FieldPat {
    pub name: &Name,
    pub pat: &Pat,
}

/// Whether a condition is a let chain (lets joined by &&).
pub fn has_let(c: &Expr) -> bool {
    match &c.kind {
        ExprKind::Let { .. } => true,
        ExprKind::Binary { op, x, y, .. } => *op == crate::syntax::token::AND_AND && (has_let(*x) || has_let(*y)),
        _ => false,
    }
}

pub fn pat(kind: PatKind) -> &Pat { &Pat { id: new_id(), kind } }

impl Pat {
    pub fn pos(&self) -> Pos {
        match &self.kind {
            PatKind::Wild(p) => *p,
            PatKind::Rest(p) => *p,
            PatKind::Ident { name, .. } => name.pos,
            PatKind::Lit(x) => x.pos(),
            PatKind::Range { lo, op_pos, .. } => match lo { Some(l) => l.pos(), None => *op_pos },
            PatKind::Path(p) => p.pos(),
            PatKind::Tuple { lparen, .. } => *lparen,
            PatKind::TupleStruct { path, .. } => path.pos(),
            PatKind::Struct { path, .. } => path.pos(),
            PatKind::Slice { lbrack, .. } => *lbrack,
            PatKind::Ref { amp, .. } => *amp,
            PatKind::Or(alts) => alts[0].pos(),
        }
    }
}

/// A path of one plain segment (struct literal shorthand).
pub fn simple_path(n: &Name) -> &Path {
    let mut segs = Vec::new();
    segs.push(&PathSegment { name: n, args: None });
    &Path { id: new_id(), segments: segs, qself: None }
}

pub fn no_pos() -> Pos { NO_POS }
