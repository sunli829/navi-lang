//! Syntax back to source text: the parts of items a derive repeats in the
//! code it makes (types, paths, generics), from the tree alone (a crate
//! read from its export data has no text).

use crate::syntax::{ast::*, token::kind_name};

/// A type as source.
pub fn ty(t: &Type) -> String {
    let mut b = String::new();
    type_into(&mut b, t);
    b
}

/// A path as source.
pub fn path(p: &Path) -> String {
    let mut b = String::new();
    path_into(&mut b, p);
    b
}

/// An expression as source (the simple ones types hold: array lengths,
/// const arguments).
pub fn expr(x: &Expr) -> String {
    let mut b = String::new();
    expr_into(&mut b, x);
    b
}

fn type_into(b: &mut String, t: &Type) {
    match &t.kind {
        TypeKind::Path(p) => path_into(b, *p),
        TypeKind::Ref { is_mut, elem, .. } => {
            b.push_str(if *is_mut { "&mut " } else { "&" });
            type_into(b, *elem);
        }
        TypeKind::Ptr { is_mut, elem, .. } => {
            b.push_str(if *is_mut { "*mut " } else { "*const " });
            type_into(b, *elem);
        }
        TypeKind::Slice { elem, .. } => {
            b.push('[');
            type_into(b, *elem);
            b.push(']');
        }
        TypeKind::Array { elem, len, .. } => {
            b.push('[');
            type_into(b, *elem);
            b.push_str("; ");
            expr_into(b, *len);
            b.push(']');
        }
        TypeKind::Tuple { elems, .. } => {
            b.push('(');
            let mut i = 0;
            while i < elems.len() {
                if i > 0 {
                    b.push_str(", ");
                }
                type_into(b, elems[i]);
                i += 1;
            }
            if elems.len() == 1 {
                b.push(',');
            }
            b.push(')');
        }
        TypeKind::Fn {
            abi,
            params,
            result,
            ..
        } => {
            if abi.len() > 0 {
                b.push_str(`extern ${quote_str(abi.as_str())} `.to_string().as_str());
            }
            b.push_str("fn(");
            let mut i = 0;
            while i < params.len() {
                if i > 0 {
                    b.push_str(", ");
                }
                type_into(b, params[i]);
                i += 1;
            }
            b.push(')');
            if let Some(r) = result {
                b.push_str(" -> ");
                type_into(b, *r);
            }
        }
        TypeKind::Dyn { bounds, .. } => {
            b.push_str("dyn ");
            bounds_into(b, bounds);
        }
        TypeKind::Impl { bounds, .. } => {
            b.push_str("impl ");
            bounds_into(b, bounds);
        }
        TypeKind::Never(_) => b.push('!'),
        TypeKind::Infer(_) => b.push('_'),
        TypeKind::Const(x) => {
            b.push('{');
            expr_into(b, *x);
            b.push('}');
        }
    }
}

/// Bounds joined by +.
pub fn bounds(bs: &Vec<&Path>) -> String {
    let mut b = String::new();
    bounds_into(&mut b, bs);
    b
}

fn bounds_into(b: &mut String, bs: &Vec<&Path>) {
    let mut i = 0;
    while i < bs.len() {
        if i > 0 {
            b.push_str(" + ");
        }
        path_into(b, bs[i]);
        i += 1;
    }
}

fn path_into(b: &mut String, p: &Path) {
    let mut first = true;
    if let Some(q) = p.qself {
        b.push('<');
        type_into(b, q.ty);
        if let Some(tp) = q.trait_path {
            b.push_str(" as ");
            path_into(b, tp);
        }
        b.push('>');
        first = false;
    }
    for seg in p.segments.iter() {
        if !first {
            b.push_str("::");
        }
        first = false;
        b.push_str(seg.name.value.as_str());
        if let Some(a) = seg.args {
            args_into(b, a);
        }
    }
}

fn args_into(b: &mut String, a: &GenericArgs) {
    b.push('<');
    let mut n = 0;
    for t in a.args.iter() {
        if n > 0 {
            b.push_str(", ");
        }
        type_into(b, *t);
        n += 1;
    }
    for bd in a.bindings.iter() {
        if n > 0 {
            b.push_str(", ");
        }
        b.push_str(bd.name.value.as_str());
        b.push_str(" = ");
        type_into(b, bd.ty);
        n += 1;
    }
    b.push('>');
}

fn expr_into(b: &mut String, x: &Expr) {
    match &x.kind {
        ExprKind::Lit { value, .. } => b.push_str(value.as_str()),
        ExprKind::Path(p) => path_into(b, *p),
        ExprKind::Paren { x, .. } => {
            b.push('(');
            expr_into(b, *x);
            b.push(')');
        }
        ExprKind::Unary { op, x, .. } => {
            b.push_str(kind_name(*op));
            expr_into(b, *x);
        }
        ExprKind::Binary { op, x, y, .. } => {
            expr_into(b, *x);
            b.push(' ');
            b.push_str(kind_name(*op));
            b.push(' ');
            expr_into(b, *y);
        }
        ExprKind::Cast { x, ty: t } => {
            expr_into(b, *x);
            b.push_str(" as ");
            type_into(b, *t);
        }
        ExprKind::Call { fun, args, .. } => {
            expr_into(b, *fun);
            b.push('(');
            let mut i = 0;
            while i < args.len() {
                if i > 0 {
                    b.push_str(", ");
                }
                expr_into(b, args[i]);
                i += 1;
            }
            b.push(')');
        }
        ExprKind::Block(blk) => {
            b.push_str("{ ");
            if let Some(t) = blk.tail {
                expr_into(b, t);
            }
            b.push_str(" }");
        }
        // (Not in a type: a derive repeats types only.)
        _ => b.push_str("_"),
    }
}

/// A string literal of s.
pub fn quote_str(s: &str) -> String {
    let mut b = String::new();
    b.push('"');
    for c in s.chars() {
        match c {
            '"' => b.push_str("\\\""),
            '\\' => b.push_str("\\\\"),
            '\n' => b.push_str("\\n"),
            _ => b.push(c),
        }
    }
    b.push('"');
    b
}
