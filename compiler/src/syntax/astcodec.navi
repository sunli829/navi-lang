    let init = if d.b() { let y: &Expr = dec_Expr(d); Some(y) } else { None };
    let els = if d.b() { let y: &Expr = dec_Expr(d); Some(y) } else { None };
    let x = &mut LetStmt { pos, pat, ty, init, els };
