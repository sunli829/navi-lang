pub fn enc_UseTree(e: &mut Enc, x: &UseTree) {
    match x.prefix { Some(y0) => { e.b(true); enc_Path(e, y0); } None => e.b(false), }
    match x.alias { Some(y0) => { e.b(true); enc_Name(e, y0); } None => e.b(false), }
    e.b(x.glob);
    e.u(x.children.len() as u32); for y0 in x.children.iter() { enc_UseTree(e, *y0); }
    e.b(x.group);
}

pub fn dec_UseTree(d: &mut Dec) -> &mut UseTree {
    let prefix = if d.b() { let y: &Path = dec_Path(d); Some(y) } else { None };
    let alias = if d.b() { let y: &Name = dec_Name(d); Some(y) } else { None };
    let glob = d.b();
    let children = { let n = d.u() as usize; let mut v: Vec<&UseTree> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_UseTree(d)); i += 1; } v };
    let group = d.b();
    let x = &mut UseTree { prefix, alias, glob, children, group };
    x
}

pub fn dec_val_UseTree(d: &mut Dec) -> UseTree { *dec_UseTree(d) }

pub fn enc_ExternBlock(e: &mut Enc, x: &ExternBlock) {
