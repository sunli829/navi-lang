        LitKind::Int => e.u(0),
        LitKind::Float => e.u(1),
        LitKind::Char => e.u(2),
        LitKind::Byte => e.u(3),
        LitKind::Str => e.u(4),
        LitKind::ByteStr => e.u(5),
        LitKind::Bool => e.u(6),
    }
}

pub fn dec_LitKind(d: &mut Dec) -> &mut LitKind {
