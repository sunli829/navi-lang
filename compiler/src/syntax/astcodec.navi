pub fn enc_TypeKind(e: &mut Enc, x: &TypeKind) {
    match x {
        TypeKind::Path(a0) => { e.u(0); enc_Path(e, *a0); }
        TypeKind::Ref { amp, is_mut, elem } => { e.u(1); e.pos(*amp); e.b(*is_mut); enc_Type(e, *elem); }
        TypeKind::Ptr { star, is_mut, elem } => { e.u(2); e.pos(*star); e.b(*is_mut); enc_Type(e, *elem); }
        TypeKind::Slice { lbrack, elem } => { e.u(3); e.pos(*lbrack); enc_Type(e, *elem); }
        TypeKind::Array { lbrack, elem, len } => { e.u(4); e.pos(*lbrack); enc_Type(e, *elem); enc_Expr(e, *len); }
        TypeKind::Tuple { lparen, elems } => { e.u(5); e.pos(*lparen); e.u((*elems).len() as u32); for y0 in (*elems).iter() { enc_Type(e, *y0); } }
        TypeKind::Fn { start, abi, params, result } => { e.u(6); e.pos(*start); e.s(*abi); e.u((*params).len() as u32); for y0 in (*params).iter() { enc_Type(e, *y0); } match *result { Some(y0) => { e.b(true); enc_Type(e, y0); } None => e.b(false), } }
        TypeKind::Dyn { pos, bounds } => { e.u(7); e.pos(*pos); e.u((*bounds).len() as u32); for y0 in (*bounds).iter() { enc_Path(e, *y0); } }
        TypeKind::Impl { pos, bounds } => { e.u(8); e.pos(*pos); e.u((*bounds).len() as u32); for y0 in (*bounds).iter() { enc_Path(e, *y0); } }
        TypeKind::Never(a0) => { e.u(9); e.pos(*a0); }
        TypeKind::Infer(a0) => { e.u(10); e.pos(*a0); }
        TypeKind::Const(a0) => { e.u(11); enc_Expr(e, *a0); }
    }
}

pub fn dec_TypeKind(d: &mut Dec) -> &mut TypeKind {
    let mut v = dec_val_TypeKind(d);
    &mut v
}

pub fn dec_val_TypeKind(d: &mut Dec) -> TypeKind {
    match d.u() {
        0 => { let a0 = dec_Path(d); TypeKind::Path(a0) }
        1 => { let amp = d.pos(); let is_mut = d.b(); let elem = dec_Type(d); TypeKind::Ref { amp, is_mut, elem } }
        2 => { let star = d.pos(); let is_mut = d.b(); let elem = dec_Type(d); TypeKind::Ptr { star, is_mut, elem } }
        3 => { let lbrack = d.pos(); let elem = dec_Type(d); TypeKind::Slice { lbrack, elem } }
        4 => { let lbrack = d.pos(); let elem = dec_Type(d); let len = dec_Expr(d); TypeKind::Array { lbrack, elem, len } }
        5 => { let lparen = d.pos(); let elems = { let n = d.u() as usize; let mut v: Vec<&Type> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Type(d)); i += 1; } v }; TypeKind::Tuple { lparen, elems } }
        6 => { let start = d.pos(); let abi = d.s(); let params = { let n = d.u() as usize; let mut v: Vec<&Type> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Type(d)); i += 1; } v }; let result = if d.b() { let y: &Type = dec_Type(d); Some(y) } else { None }; TypeKind::Fn { start, abi, params, result } }
        7 => { let pos = d.pos(); let bounds = { let n = d.u() as usize; let mut v: Vec<&Path> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Path(d)); i += 1; } v }; TypeKind::Dyn { pos, bounds } }
        8 => { let pos = d.pos(); let bounds = { let n = d.u() as usize; let mut v: Vec<&Path> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Path(d)); i += 1; } v }; TypeKind::Impl { pos, bounds } }
        9 => { let a0 = d.pos(); TypeKind::Never(a0) }
        10 => { let a0 = d.pos(); TypeKind::Infer(a0) }
        11 => { let a0 = dec_Expr(d); TypeKind::Const(a0) }
        _ => panic("navih: bad export data"),
    }
}

pub fn enc_LitKind(e: &mut Enc, x: &LitKind) {
