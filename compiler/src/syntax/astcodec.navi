pub fn enc_Block(e: &mut Enc, x: &Block) {
    e.pos(x.lbrace);
    e.pos(x.rbrace);
    e.b(x.is_unsafe);
    e.u(x.stmts.len() as u32); for y0 in x.stmts.iter() { enc_Stmt(e, *y0); }
    match x.tail { Some(y0) => { e.b(true); enc_Expr(e, y0); } None => e.b(false), }
}

pub fn dec_Block(d: &mut Dec) -> &mut Block {
    let lbrace = d.pos();
    let rbrace = d.pos();
    let is_unsafe = d.b();
    let stmts = { let n = d.u() as usize; let mut v: Vec<&Stmt> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Stmt(d)); i += 1; } v };
    let tail = if d.b() { let y: &Expr = dec_Expr(d); Some(y) } else { None };
    let x = &mut Block { lbrace, rbrace, is_unsafe, stmts, tail };
    x
}

