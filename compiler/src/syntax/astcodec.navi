//! The binary encoding of the AST, for a crate's export data
//! (crate::navih): Codec, implemented here for the scalars and the types
//! that hold values, and by #[derive(Codec)] (compiler/codec) for each
//! node type of ast.navi.

use crate::{
    navih::{Dec, Enc, dec_val_Token, enc_Token},
    syntax::{ast::*, token::Token},
};

/// A value written to and read from export data.
pub trait Codec {
    fn codec_enc(&self, e: &mut Enc);
    fn codec_dec(d: &mut Dec) -> Self;
    /// The value made on the heap (a node with an id: the one decoded
    /// before, if the data refers to it again).
    fn codec_dec_ref(d: &mut Dec) -> &mut Self {
        &mut Self::codec_dec(d)
    }
}

impl Codec for u32 {
    fn codec_enc(&self, e: &mut Enc) {
        e.u(*self);
    }
    fn codec_dec(d: &mut Dec) -> u32 {
        d.u()
    }
}

/// (Positions too: Pos.)
impl Codec for i32 {
    fn codec_enc(&self, e: &mut Enc) {
        e.i(*self);
    }
    fn codec_dec(d: &mut Dec) -> i32 {
        d.i()
    }
}

/// (Token kinds: Kind.)
impl Codec for u8 {
    fn codec_enc(&self, e: &mut Enc) {
        e.k(*self);
    }
    fn codec_dec(d: &mut Dec) -> u8 {
        d.k()
    }
}

impl Codec for bool {
    fn codec_enc(&self, e: &mut Enc) {
        e.b(*self);
    }
    fn codec_dec(d: &mut Dec) -> bool {
        d.b()
    }
}

impl Codec for String {
    fn codec_enc(&self, e: &mut Enc) {
        e.s_str(self.as_str());
    }
    fn codec_dec(d: &mut Dec) -> String {
        d.s()
    }
}

impl Codec for Token {
    fn codec_enc(&self, e: &mut Enc) {
        enc_Token(e, self);
    }
    fn codec_dec(d: &mut Dec) -> Token {
        dec_val_Token(d)
    }
}

impl<T: Codec> Codec for Option<T> {
    fn codec_enc(&self, e: &mut Enc) {
        match self {
            Some(x) => {
                e.b(true);
                x.codec_enc(e);
            }
            None => e.b(false),
        }
    }
    fn codec_dec(d: &mut Dec) -> Option<T> {
        if d.b() { Some(T::codec_dec(d)) } else { None }
    }
}

impl<T: Codec> Codec for Vec<T> {
    fn codec_enc(&self, e: &mut Enc) {
        e.u(self.len() as u32);
        for x in self.iter() {
            x.codec_enc(e);
        }
    }
    fn codec_dec(d: &mut Dec) -> Vec<T> {
        let n = d.u() as usize;
        let mut v: Vec<T> = Vec::with_capacity(n);
        let mut i = 0;
        while i < n {
            v.push(T::codec_dec(d));
            i += 1;
        }
        v
    }
}

impl<T: Codec> Codec for &T {
    fn codec_enc(&self, e: &mut Enc) {
        (**self).codec_enc(e);
    }
    fn codec_dec(d: &mut Dec) -> &T {
        T::codec_dec_ref(d)
    }
}

impl<T: Codec> Codec for &mut T {
    fn codec_enc(&self, e: &mut Enc) {
        (**self).codec_enc(e);
    }
    fn codec_dec(d: &mut Dec) -> &mut T {
        T::codec_dec_ref(d)
    }
}

/// The nodes decoded so far that later ones may refer to again, by kind
/// (the kind numbers of #[codec(kind = n)]).

pub struct Seen {
    pub n_path: Vec<&mut Path>,
    pub n_generic_param: Vec<&mut GenericParam>,
    pub n_item_base: Vec<&mut ItemBase>,
    pub n_field: Vec<&mut Field>,
    pub n_variant: Vec<&mut Variant>,
    pub n_type: Vec<&mut Type>,
    pub n_expr: Vec<&mut Expr>,
    pub n_pat: Vec<&mut Pat>,
}

pub fn new_seen() -> Seen {
    Seen {
        n_path: Vec::new(),
        n_generic_param: Vec::new(),
        n_item_base: Vec::new(),
        n_field: Vec::new(),
        n_variant: Vec::new(),
        n_type: Vec::new(),
        n_expr: Vec::new(),
        n_pat: Vec::new(),
    }
}
