    &mut v
}

pub fn dec_val_Item(d: &mut Dec) -> Item {
    match d.u() {
        0 => { let a0 = dec_FnDecl(d); Item::Fn(a0) }
        1 => { let a0 = dec_StructDecl(d); Item::Struct(a0) }
        2 => { let a0 = dec_EnumDecl(d); Item::Enum(a0) }
        3 => { let a0 = dec_TypeAlias(d); Item::TypeAlias(a0) }
        4 => { let a0 = dec_ConstDecl(d); Item::Const(a0) }
        5 => { let a0 = dec_StaticDecl(d); Item::Static(a0) }
        6 => { let a0 = dec_ImplDecl(d); Item::Impl(a0) }
        7 => { let a0 = dec_TraitDecl(d); Item::Trait(a0) }
        8 => { let a0 = dec_ModDecl(d); Item::Mod(a0) }
        9 => { let a0 = dec_UseDecl(d); Item::Use(a0) }
