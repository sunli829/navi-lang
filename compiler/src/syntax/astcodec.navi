//! The binary encoding of the AST, for a crate's export data
//! (crate::navih). Written by tools/gen_astcodec.py from ast.navi: do
//! not edit, run the script again.

use crate::syntax::ast::*;
use crate::syntax::source::{File, Pos};
use crate::syntax::token::{Token, Kind};
pub use crate::navih::{Enc, Dec, enc_Token, dec_val_Token};

/// The nodes decoded so far that later ones may refer to again, by
/// kind.
pub struct Seen {
    pub n_path: Vec<&mut Path>,
    pub n_generic_param: Vec<&mut GenericParam>,
    pub n_item_base: Vec<&mut ItemBase>,
    pub n_field: Vec<&mut Field>,
    pub n_variant: Vec<&mut Variant>,
    pub n_type: Vec<&mut Type>,
    pub n_expr: Vec<&mut Expr>,
    pub n_pat: Vec<&mut Pat>,
}

pub fn new_seen() -> Seen {
    Seen { n_path: Vec::new(), n_generic_param: Vec::new(), n_item_base: Vec::new(), n_field: Vec::new(), n_variant: Vec::new(), n_type: Vec::new(), n_expr: Vec::new(), n_pat: Vec::new() }
}

pub fn enc_Name(e: &mut Enc, x: &Name) {
    e.pos(x.pos);
    e.s(x.value);
}

pub fn dec_Name(d: &mut Dec) -> &mut Name {
    let pos = d.pos();
    let value = d.s();
    let x = &mut Name { pos, value };
    x
}

pub fn dec_val_Name(d: &mut Dec) -> Name { *dec_Name(d) }

pub fn enc_Attr(e: &mut Enc, x: &Attr) {
    e.pos(x.hash);
    e.b(x.inner);
    enc_Path(e, x.path);
    e.u(x.args.len() as u32); for y0 in x.args.iter() { enc_Token(e, &*y0); }
    match x.value { Some(y0) => { e.b(true); enc_Expr(e, y0); } None => e.b(false), }
}

pub fn dec_Attr(d: &mut Dec) -> &mut Attr {
    let hash = d.pos();
    let inner = d.b();
    let path = dec_Path(d);
    let args = { let n = d.u() as usize; let mut v: Vec<Token> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_val_Token(d)); i += 1; } v };
    let value = if d.b() { let y: &Expr = dec_Expr(d); Some(y) } else { None };
    let x = &mut Attr { hash, inner, path, args, value };
    x
}

pub fn dec_val_Attr(d: &mut Dec) -> Attr { *dec_Attr(d) }

pub fn enc_Path(e: &mut Enc, x: &Path) {
    if e.again(x.id) { return; }
    e.u(x.segments.len() as u32); for y0 in x.segments.iter() { enc_PathSegment(e, *y0); }
    match x.qself { Some(y0) => { e.b(true); enc_QSelf(e, y0); } None => e.b(false), }
    e.done(x.id, 0);
}

pub fn dec_Path(d: &mut Dec) -> &mut Path {
    if let Some(i) = d.again() { return d.seen.n_path[i]; }
    let segments = { let n = d.u() as usize; let mut v: Vec<&PathSegment> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_PathSegment(d)); i += 1; } v };
    let qself = if d.b() { let y: &QSelf = dec_QSelf(d); Some(y) } else { None };
    let x = &mut Path { id: d.id(), segments, qself };
    d.seen.n_path.push(x);
    x
}

pub fn dec_val_Path(d: &mut Dec) -> Path { *dec_Path(d) }

pub fn enc_PathSegment(e: &mut Enc, x: &PathSegment) {
    enc_Name(e, x.name);
    match x.args { Some(y0) => { e.b(true); enc_GenericArgs(e, y0); } None => e.b(false), }
}

pub fn dec_PathSegment(d: &mut Dec) -> &mut PathSegment {
    let name = dec_Name(d);
    let args = if d.b() { let y: &GenericArgs = dec_GenericArgs(d); Some(y) } else { None };
    let x = &mut PathSegment { name, args };
    x
}

pub fn dec_val_PathSegment(d: &mut Dec) -> PathSegment { *dec_PathSegment(d) }

pub fn enc_QSelf(e: &mut Enc, x: &QSelf) {
    e.pos(x.lt);
    enc_Type(e, x.ty);
    match x.trait_path { Some(y0) => { e.b(true); enc_Path(e, y0); } None => e.b(false), }
}

pub fn dec_QSelf(d: &mut Dec) -> &mut QSelf {
    let lt = d.pos();
    let ty = dec_Type(d);
    let trait_path = if d.b() { let y: &Path = dec_Path(d); Some(y) } else { None };
    let x = &mut QSelf { lt, ty, trait_path };
    x
}

pub fn dec_val_QSelf(d: &mut Dec) -> QSelf { *dec_QSelf(d) }

pub fn enc_GenericArgs(e: &mut Enc, x: &GenericArgs) {
    e.pos(x.lt);
    e.u(x.args.len() as u32); for y0 in x.args.iter() { enc_Type(e, *y0); }
    e.u(x.bindings.len() as u32); for y0 in x.bindings.iter() { enc_AssocBinding(e, *y0); }
}

pub fn dec_GenericArgs(d: &mut Dec) -> &mut GenericArgs {
    let lt = d.pos();
    let args = { let n = d.u() as usize; let mut v: Vec<&Type> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Type(d)); i += 1; } v };
    let bindings = { let n = d.u() as usize; let mut v: Vec<&AssocBinding> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_AssocBinding(d)); i += 1; } v };
    let x = &mut GenericArgs { lt, args, bindings };
    x
}

pub fn dec_val_GenericArgs(d: &mut Dec) -> GenericArgs { *dec_GenericArgs(d) }

pub fn enc_AssocBinding(e: &mut Enc, x: &AssocBinding) {
    enc_Name(e, x.name);
    enc_Type(e, x.ty);
}

pub fn dec_AssocBinding(d: &mut Dec) -> &mut AssocBinding {
    let name = dec_Name(d);
    let ty = dec_Type(d);
    let x = &mut AssocBinding { name, ty };
    x
}

pub fn dec_val_AssocBinding(d: &mut Dec) -> AssocBinding { *dec_AssocBinding(d) }

pub fn enc_Generics(e: &mut Enc, x: &Generics) {
    e.pos(x.lt);
    e.u(x.params.len() as u32); for y0 in x.params.iter() { enc_GenericParam(e, *y0); }
    e.u(x.wheres.len() as u32); for y0 in x.wheres.iter() { enc_WherePredicate(e, *y0); }
}

pub fn dec_Generics(d: &mut Dec) -> &mut Generics {
    let lt = d.pos();
    let params = { let n = d.u() as usize; let mut v: Vec<&GenericParam> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_GenericParam(d)); i += 1; } v };
    let wheres = { let n = d.u() as usize; let mut v: Vec<&WherePredicate> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_WherePredicate(d)); i += 1; } v };
    let x = &mut Generics { lt, params, wheres };
    x
}

pub fn dec_val_Generics(d: &mut Dec) -> Generics { *dec_Generics(d) }

pub fn enc_GenericParam(e: &mut Enc, x: &GenericParam) {
    if e.again(x.id) { return; }
    enc_Name(e, x.name);
    e.u(x.bounds.len() as u32); for y0 in x.bounds.iter() { enc_Path(e, *y0); }
    match x.default { Some(y0) => { e.b(true); enc_Type(e, y0); } None => e.b(false), }
    match x.ty { Some(y0) => { e.b(true); enc_Type(e, y0); } None => e.b(false), }
    e.done(x.id, 1);
}

pub fn dec_GenericParam(d: &mut Dec) -> &mut GenericParam {
    if let Some(i) = d.again() { return d.seen.n_generic_param[i]; }
    let name = dec_Name(d);
    let bounds = { let n = d.u() as usize; let mut v: Vec<&Path> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Path(d)); i += 1; } v };
    let default = if d.b() { let y: &Type = dec_Type(d); Some(y) } else { None };
    let ty = if d.b() { let y: &Type = dec_Type(d); Some(y) } else { None };
    let x = &mut GenericParam { id: d.id(), name, bounds, default, ty };
    d.seen.n_generic_param.push(x);
    x
}

pub fn dec_val_GenericParam(d: &mut Dec) -> GenericParam { *dec_GenericParam(d) }

pub fn enc_WherePredicate(e: &mut Enc, x: &WherePredicate) {
    enc_Type(e, x.ty);
    e.u(x.bounds.len() as u32); for y0 in x.bounds.iter() { enc_Path(e, *y0); }
}

pub fn dec_WherePredicate(d: &mut Dec) -> &mut WherePredicate {
    let ty = dec_Type(d);
    let bounds = { let n = d.u() as usize; let mut v: Vec<&Path> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Path(d)); i += 1; } v };
    let x = &mut WherePredicate { ty, bounds };
    x
}

pub fn dec_val_WherePredicate(d: &mut Dec) -> WherePredicate { *dec_WherePredicate(d) }

pub fn enc_ItemBase(e: &mut Enc, x: &ItemBase) {
    if e.again(x.id) { return; }
    e.u(x.attrs.len() as u32); for y0 in x.attrs.iter() { enc_Attr(e, *y0); }
    enc_Vis(e, &x.vis);
    e.pos(x.start);
    e.done(x.id, 2);
}

pub fn dec_ItemBase(d: &mut Dec) -> &mut ItemBase {
    if let Some(i) = d.again() { return d.seen.n_item_base[i]; }
    let attrs = { let n = d.u() as usize; let mut v: Vec<&Attr> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Attr(d)); i += 1; } v };
    let vis = dec_val_Vis(d);
    let start = d.pos();
    let x = &mut ItemBase { id: d.id(), attrs, vis, start };
    d.seen.n_item_base.push(x);
    x
}

pub fn dec_val_ItemBase(d: &mut Dec) -> ItemBase { *dec_ItemBase(d) }

pub fn enc_FnDecl(e: &mut Enc, x: &FnDecl) {
    enc_ItemBase(e, &x.base);
    enc_Name(e, x.name);
    e.b(x.is_const);
    e.b(x.is_unsafe);
    e.s(x.abi);
    enc_Generics(e, x.generics);
    match x.self_param { Some(y0) => { e.b(true); enc_SelfParam(e, y0); } None => e.b(false), }
    e.u(x.params.len() as u32); for y0 in x.params.iter() { enc_Param(e, *y0); }
    e.b(x.variadic);
    match x.result { Some(y0) => { e.b(true); enc_Type(e, y0); } None => e.b(false), }
    e.fn_body(x);
}

pub fn dec_FnDecl(d: &mut Dec) -> &mut FnDecl {
    let base = dec_val_ItemBase(d);
    let name = dec_Name(d);
    let is_const = d.b();
    let is_unsafe = d.b();
    let abi = d.s();
    let generics = dec_Generics(d);
    let self_param = if d.b() { let y: &SelfParam = dec_SelfParam(d); Some(y) } else { None };
    let params = { let n = d.u() as usize; let mut v: Vec<&Param> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Param(d)); i += 1; } v };
    let variadic = d.b();
    let result = if d.b() { let y: &Type = dec_Type(d); Some(y) } else { None };
    let (body, elided) = d.fn_body();
    let x = &mut FnDecl { base, name, is_const, is_unsafe, abi, generics, self_param, params, variadic, result, body, elided };
    x
}

pub fn dec_val_FnDecl(d: &mut Dec) -> FnDecl { *dec_FnDecl(d) }

pub fn enc_SelfParam(e: &mut Enc, x: &SelfParam) {
    e.pos(x.pos);
    e.b(x.is_ref);
    e.b(x.is_mut);
}

pub fn dec_SelfParam(d: &mut Dec) -> &mut SelfParam {
    let pos = d.pos();
    let is_ref = d.b();
    let is_mut = d.b();
    let x = &mut SelfParam { pos, is_ref, is_mut };
    x
}

pub fn dec_val_SelfParam(d: &mut Dec) -> SelfParam { *dec_SelfParam(d) }

pub fn enc_Param(e: &mut Enc, x: &Param) {
    enc_Pat(e, x.pat);
    match x.ty { Some(y0) => { e.b(true); enc_Type(e, y0); } None => e.b(false), }
}

pub fn dec_Param(d: &mut Dec) -> &mut Param {
    let pat = dec_Pat(d);
    let ty = if d.b() { let y: &Type = dec_Type(d); Some(y) } else { None };
    let x = &mut Param { pat, ty };
    x
}

pub fn dec_val_Param(d: &mut Dec) -> Param { *dec_Param(d) }

pub fn enc_StructDecl(e: &mut Enc, x: &StructDecl) {
    enc_ItemBase(e, &x.base);
    enc_Name(e, x.name);
    enc_Generics(e, x.generics);
    enc_StructKind(e, &x.kind);
    e.u(x.fields.len() as u32); for y0 in x.fields.iter() { enc_Field(e, *y0); }
}

pub fn dec_StructDecl(d: &mut Dec) -> &mut StructDecl {
    let base = dec_val_ItemBase(d);
    let name = dec_Name(d);
    let generics = dec_Generics(d);
    let kind = dec_val_StructKind(d);
    let fields = { let n = d.u() as usize; let mut v: Vec<&Field> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Field(d)); i += 1; } v };
    let x = &mut StructDecl { base, name, generics, kind, fields };
    x
}

pub fn dec_val_StructDecl(d: &mut Dec) -> StructDecl { *dec_StructDecl(d) }

pub fn enc_Field(e: &mut Enc, x: &Field) {
    if e.again(x.id) { return; }
    e.u(x.attrs.len() as u32); for y0 in x.attrs.iter() { enc_Attr(e, *y0); }
    enc_Vis(e, &x.vis);
    match x.name { Some(y0) => { e.b(true); enc_Name(e, y0); } None => e.b(false), }
    enc_Type(e, x.ty);
    e.done(x.id, 3);
}

pub fn dec_Field(d: &mut Dec) -> &mut Field {
    if let Some(i) = d.again() { return d.seen.n_field[i]; }
    let attrs = { let n = d.u() as usize; let mut v: Vec<&Attr> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Attr(d)); i += 1; } v };
    let vis = dec_val_Vis(d);
    let name = if d.b() { let y: &Name = dec_Name(d); Some(y) } else { None };
    let ty = dec_Type(d);
    let x = &mut Field { id: d.id(), attrs, vis, name, ty };
    d.seen.n_field.push(x);
    x
}

pub fn dec_val_Field(d: &mut Dec) -> Field { *dec_Field(d) }

pub fn enc_EnumDecl(e: &mut Enc, x: &EnumDecl) {
    enc_ItemBase(e, &x.base);
    enc_Name(e, x.name);
    enc_Generics(e, x.generics);
    e.u(x.variants.len() as u32); for y0 in x.variants.iter() { enc_Variant(e, *y0); }
}

pub fn dec_EnumDecl(d: &mut Dec) -> &mut EnumDecl {
    let base = dec_val_ItemBase(d);
    let name = dec_Name(d);
    let generics = dec_Generics(d);
    let variants = { let n = d.u() as usize; let mut v: Vec<&Variant> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Variant(d)); i += 1; } v };
    let x = &mut EnumDecl { base, name, generics, variants };
    x
}

pub fn dec_val_EnumDecl(d: &mut Dec) -> EnumDecl { *dec_EnumDecl(d) }

pub fn enc_Variant(e: &mut Enc, x: &Variant) {
    if e.again(x.id) { return; }
    e.u(x.attrs.len() as u32); for y0 in x.attrs.iter() { enc_Attr(e, *y0); }
    enc_Name(e, x.name);
    enc_StructKind(e, &x.kind);
    e.u(x.fields.len() as u32); for y0 in x.fields.iter() { enc_Field(e, *y0); }
    match x.discriminant { Some(y0) => { e.b(true); enc_Expr(e, y0); } None => e.b(false), }
    e.done(x.id, 4);
}

pub fn dec_Variant(d: &mut Dec) -> &mut Variant {
    if let Some(i) = d.again() { return d.seen.n_variant[i]; }
    let attrs = { let n = d.u() as usize; let mut v: Vec<&Attr> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Attr(d)); i += 1; } v };
    let name = dec_Name(d);
    let kind = dec_val_StructKind(d);
    let fields = { let n = d.u() as usize; let mut v: Vec<&Field> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Field(d)); i += 1; } v };
    let discriminant = if d.b() { let y: &Expr = dec_Expr(d); Some(y) } else { None };
    let x = &mut Variant { id: d.id(), attrs, name, kind, fields, discriminant };
    d.seen.n_variant.push(x);
    x
}

pub fn dec_val_Variant(d: &mut Dec) -> Variant { *dec_Variant(d) }

