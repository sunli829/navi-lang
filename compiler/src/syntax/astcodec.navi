    &mut v
}

pub fn dec_val_LitKind(d: &mut Dec) -> LitKind {
    match d.u() {
        0 => LitKind::Int,
        1 => LitKind::Float,
        2 => LitKind::Char,
        3 => LitKind::Byte,
        4 => LitKind::Str,
        5 => LitKind::ByteStr,
        6 => LitKind::Bool,
        _ => panic("navih: bad export data"),
    }
}

pub fn enc_ExprKind(e: &mut Enc, x: &ExprKind) {
    match x {
        ExprKind::Lit { pos, kind, value } => { e.u(0); e.pos(*pos); enc_LitKind(e, &*kind); e.s(*value); }
        ExprKind::Template { pos, parts } => { e.u(1); e.pos(*pos); e.u((*parts).len() as u32); for y0 in (*parts).iter() { enc_TemplatePart(e, *y0); } }
        ExprKind::Path(a0) => { e.u(2); enc_Path(e, *a0); }
        ExprKind::Unary { op_pos, op, x } => { e.u(3); e.pos(*op_pos); e.k(*op); enc_Expr(e, *x); }
        ExprKind::Ref { amp, is_mut, x } => { e.u(4); e.pos(*amp); e.b(*is_mut); enc_Expr(e, *x); }
        ExprKind::Binary { op, op_pos, x, y } => { e.u(5); e.k(*op); e.pos(*op_pos); enc_Expr(e, *x); enc_Expr(e, *y); }
        ExprKind::Assign { op, op_pos, x, y } => { e.u(6); e.k(*op); e.pos(*op_pos); enc_Expr(e, *x); enc_Expr(e, *y); }
        ExprKind::Cast { x, ty } => { e.u(7); enc_Expr(e, *x); enc_Type(e, *ty); }
        ExprKind::Range { op_pos, lo, hi, inclusive } => { e.u(8); e.pos(*op_pos); match *lo { Some(y0) => { e.b(true); enc_Expr(e, y0); } None => e.b(false), } match *hi { Some(y0) => { e.b(true); enc_Expr(e, y0); } None => e.b(false), } e.b(*inclusive); }
        ExprKind::Call { fun, lparen, args } => { e.u(9); enc_Expr(e, *fun); e.pos(*lparen); e.u((*args).len() as u32); for y0 in (*args).iter() { enc_Expr(e, *y0); } }
        ExprKind::MethodCall { recv, name, type_args, args } => { e.u(10); enc_Expr(e, *recv); enc_Name(e, *name); match *type_args { Some(y0) => { e.b(true); enc_GenericArgs(e, y0); } None => e.b(false), } e.u((*args).len() as u32); for y0 in (*args).iter() { enc_Expr(e, *y0); } }
        ExprKind::Field { x, name } => { e.u(11); enc_Expr(e, *x); enc_Name(e, *name); }
        ExprKind::Index { x, lbrack, index } => { e.u(12); enc_Expr(e, *x); e.pos(*lbrack); enc_Expr(e, *index); }
        ExprKind::Try { x, question } => { e.u(13); enc_Expr(e, *x); e.pos(*question); }
        ExprKind::StructLit { path, fields, base } => { e.u(14); enc_Path(e, *path); e.u((*fields).len() as u32); for y0 in (*fields).iter() { enc_FieldInit(e, *y0); } match *base { Some(y0) => { e.b(true); enc_Expr(e, y0); } None => e.b(false), } }
        ExprKind::Tuple { lparen, elems } => { e.u(15); e.pos(*lparen); e.u((*elems).len() as u32); for y0 in (*elems).iter() { enc_Expr(e, *y0); } }
        ExprKind::Paren { lparen, x } => { e.u(16); e.pos(*lparen); enc_Expr(e, *x); }
        ExprKind::Array { lbrack, elems } => { e.u(17); e.pos(*lbrack); e.u((*elems).len() as u32); for y0 in (*elems).iter() { enc_Expr(e, *y0); } }
        ExprKind::ArrayRepeat { lbrack, value, count } => { e.u(18); e.pos(*lbrack); enc_Expr(e, *value); enc_Expr(e, *count); }
        ExprKind::Block(a0) => { e.u(19); enc_Block(e, *a0); }
        ExprKind::If { pos, cond, then, els } => { e.u(20); e.pos(*pos); enc_Expr(e, *cond); enc_Expr(e, *then); match *els { Some(y0) => { e.b(true); enc_Expr(e, y0); } None => e.b(false), } }
        ExprKind::Let { pos, pat, x } => { e.u(21); e.pos(*pos); enc_Pat(e, *pat); enc_Expr(e, *x); }
        ExprKind::Match { pos, x, arms } => { e.u(22); e.pos(*pos); enc_Expr(e, *x); e.u((*arms).len() as u32); for y0 in (*arms).iter() { enc_MatchArm(e, *y0); } }
        ExprKind::Loop { label, pos, body } => { e.u(23); match *label { Some(y0) => { e.b(true); enc_Name(e, y0); } None => e.b(false), } e.pos(*pos); enc_Expr(e, *body); }
        ExprKind::While { label, pos, cond, body } => { e.u(24); match *label { Some(y0) => { e.b(true); enc_Name(e, y0); } None => e.b(false), } e.pos(*pos); enc_Expr(e, *cond); enc_Expr(e, *body); }
        ExprKind::For { label, pos, pat, iter, body } => { e.u(25); match *label { Some(y0) => { e.b(true); enc_Name(e, y0); } None => e.b(false), } e.pos(*pos); enc_Pat(e, *pat); enc_Expr(e, *iter); enc_Expr(e, *body); }
        ExprKind::Break { pos, label, value } => { e.u(26); e.pos(*pos); match *label { Some(y0) => { e.b(true); enc_Name(e, y0); } None => e.b(false), } match *value { Some(y0) => { e.b(true); enc_Expr(e, y0); } None => e.b(false), } }
        ExprKind::Continue { pos, label } => { e.u(27); e.pos(*pos); match *label { Some(y0) => { e.b(true); enc_Name(e, y0); } None => e.b(false), } }
        ExprKind::Return { pos, value } => { e.u(28); e.pos(*pos); match *value { Some(y0) => { e.b(true); enc_Expr(e, y0); } None => e.b(false), } }
        ExprKind::Closure { pos, params, result, body } => { e.u(29); e.pos(*pos); e.u((*params).len() as u32); for y0 in (*params).iter() { enc_Param(e, *y0); } match *result { Some(y0) => { e.b(true); enc_Type(e, y0); } None => e.b(false), } enc_Expr(e, *body); }
        ExprKind::Select { pos, arms } => { e.u(30); e.pos(*pos); e.u((*arms).len() as u32); for y0 in (*arms).iter() { enc_SelectArm(e, *y0); } }
        ExprKind::Bad(a0) => { e.u(31); e.pos(*a0); }
    }
}

pub fn dec_ExprKind(d: &mut Dec) -> &mut ExprKind {
    let mut v = dec_val_ExprKind(d);
    &mut v
}

pub fn dec_val_ExprKind(d: &mut Dec) -> ExprKind {
    match d.u() {
        0 => { let pos = d.pos(); let kind = dec_val_LitKind(d); let value = d.s(); ExprKind::Lit { pos, kind, value } }
        1 => { let pos = d.pos(); let parts = { let n = d.u() as usize; let mut v: Vec<&TemplatePart> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_TemplatePart(d)); i += 1; } v }; ExprKind::Template { pos, parts } }
        2 => { let a0 = dec_Path(d); ExprKind::Path(a0) }
        3 => { let op_pos = d.pos(); let op = d.k(); let x = dec_Expr(d); ExprKind::Unary { op_pos, op, x } }
        4 => { let amp = d.pos(); let is_mut = d.b(); let x = dec_Expr(d); ExprKind::Ref { amp, is_mut, x } }
        5 => { let op = d.k(); let op_pos = d.pos(); let x = dec_Expr(d); let y = dec_Expr(d); ExprKind::Binary { op, op_pos, x, y } }
        6 => { let op = d.k(); let op_pos = d.pos(); let x = dec_Expr(d); let y = dec_Expr(d); ExprKind::Assign { op, op_pos, x, y } }
        7 => { let x = dec_Expr(d); let ty = dec_Type(d); ExprKind::Cast { x, ty } }
        8 => { let op_pos = d.pos(); let lo = if d.b() { let y: &Expr = dec_Expr(d); Some(y) } else { None }; let hi = if d.b() { let y: &Expr = dec_Expr(d); Some(y) } else { None }; let inclusive = d.b(); ExprKind::Range { op_pos, lo, hi, inclusive } }
        9 => { let fun = dec_Expr(d); let lparen = d.pos(); let args = { let n = d.u() as usize; let mut v: Vec<&Expr> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Expr(d)); i += 1; } v }; ExprKind::Call { fun, lparen, args } }
        10 => { let recv = dec_Expr(d); let name = dec_Name(d); let type_args = if d.b() { let y: &GenericArgs = dec_GenericArgs(d); Some(y) } else { None }; let args = { let n = d.u() as usize; let mut v: Vec<&Expr> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Expr(d)); i += 1; } v }; ExprKind::MethodCall { recv, name, type_args, args } }
        11 => { let x = dec_Expr(d); let name = dec_Name(d); ExprKind::Field { x, name } }
        12 => { let x = dec_Expr(d); let lbrack = d.pos(); let index = dec_Expr(d); ExprKind::Index { x, lbrack, index } }
        13 => { let x = dec_Expr(d); let question = d.pos(); ExprKind::Try { x, question } }
        14 => { let path = dec_Path(d); let fields = { let n = d.u() as usize; let mut v: Vec<&FieldInit> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_FieldInit(d)); i += 1; } v }; let base = if d.b() { let y: &Expr = dec_Expr(d); Some(y) } else { None }; ExprKind::StructLit { path, fields, base } }
        15 => { let lparen = d.pos(); let elems = { let n = d.u() as usize; let mut v: Vec<&Expr> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Expr(d)); i += 1; } v }; ExprKind::Tuple { lparen, elems } }
        16 => { let lparen = d.pos(); let x = dec_Expr(d); ExprKind::Paren { lparen, x } }
        17 => { let lbrack = d.pos(); let elems = { let n = d.u() as usize; let mut v: Vec<&Expr> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Expr(d)); i += 1; } v }; ExprKind::Array { lbrack, elems } }
        18 => { let lbrack = d.pos(); let value = dec_Expr(d); let count = dec_Expr(d); ExprKind::ArrayRepeat { lbrack, value, count } }
        19 => { let a0 = dec_Block(d); ExprKind::Block(a0) }
        20 => { let pos = d.pos(); let cond = dec_Expr(d); let then = dec_Expr(d); let els = if d.b() { let y: &Expr = dec_Expr(d); Some(y) } else { None }; ExprKind::If { pos, cond, then, els } }
        21 => { let pos = d.pos(); let pat = dec_Pat(d); let x = dec_Expr(d); ExprKind::Let { pos, pat, x } }
        22 => { let pos = d.pos(); let x = dec_Expr(d); let arms = { let n = d.u() as usize; let mut v: Vec<&MatchArm> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_MatchArm(d)); i += 1; } v }; ExprKind::Match { pos, x, arms } }
        23 => { let label = if d.b() { let y: &Name = dec_Name(d); Some(y) } else { None }; let pos = d.pos(); let body = dec_Expr(d); ExprKind::Loop { label, pos, body } }
        24 => { let label = if d.b() { let y: &Name = dec_Name(d); Some(y) } else { None }; let pos = d.pos(); let cond = dec_Expr(d); let body = dec_Expr(d); ExprKind::While { label, pos, cond, body } }
        25 => { let label = if d.b() { let y: &Name = dec_Name(d); Some(y) } else { None }; let pos = d.pos(); let pat = dec_Pat(d); let iter = dec_Expr(d); let body = dec_Expr(d); ExprKind::For { label, pos, pat, iter, body } }
        26 => { let pos = d.pos(); let label = if d.b() { let y: &Name = dec_Name(d); Some(y) } else { None }; let value = if d.b() { let y: &Expr = dec_Expr(d); Some(y) } else { None }; ExprKind::Break { pos, label, value } }
        27 => { let pos = d.pos(); let label = if d.b() { let y: &Name = dec_Name(d); Some(y) } else { None }; ExprKind::Continue { pos, label } }
        28 => { let pos = d.pos(); let value = if d.b() { let y: &Expr = dec_Expr(d); Some(y) } else { None }; ExprKind::Return { pos, value } }
        29 => { let pos = d.pos(); let params = { let n = d.u() as usize; let mut v: Vec<&Param> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Param(d)); i += 1; } v }; let result = if d.b() { let y: &Type = dec_Type(d); Some(y) } else { None }; let body = dec_Expr(d); ExprKind::Closure { pos, params, result, body } }
        30 => { let pos = d.pos(); let arms = { let n = d.u() as usize; let mut v: Vec<&SelectArm> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_SelectArm(d)); i += 1; } v }; ExprKind::Select { pos, arms } }
        31 => { let a0 = d.pos(); ExprKind::Bad(a0) }
        _ => panic("navih: bad export data"),
    }
}

pub fn enc_Stmt(e: &mut Enc, x: &Stmt) {
    match x {
        Stmt::Let(a0) => { e.u(0); enc_LetStmt(e, *a0); }
        Stmt::Expr { x, semi } => { e.u(1); enc_Expr(e, *x); e.b(*semi); }
        Stmt::Item(a0) => { e.u(2); enc_Item(e, &*a0); }
        Stmt::Defer { pos, x } => { e.u(3); e.pos(*pos); enc_Expr(e, *x); }
        Stmt::Empty(a0) => { e.u(4); e.pos(*a0); }
    }
}

pub fn dec_Stmt(d: &mut Dec) -> &mut Stmt {
    let mut v = dec_val_Stmt(d);
    &mut v
}

pub fn dec_val_Stmt(d: &mut Dec) -> Stmt {
    match d.u() {
        0 => { let a0 = dec_LetStmt(d); Stmt::Let(a0) }
        1 => { let x = dec_Expr(d); let semi = d.b(); Stmt::Expr { x, semi } }
        2 => { let a0 = dec_val_Item(d); Stmt::Item(a0) }
        3 => { let pos = d.pos(); let x = dec_Expr(d); Stmt::Defer { pos, x } }
        4 => { let a0 = d.pos(); Stmt::Empty(a0) }
        _ => panic("navih: bad export data"),
    }
}

pub fn enc_PatKind(e: &mut Enc, x: &PatKind) {
    match x {
        PatKind::Wild(a0) => { e.u(0); e.pos(*a0); }
        PatKind::Rest(a0) => { e.u(1); e.pos(*a0); }
        PatKind::Ident { is_mut, name, sub } => { e.u(2); e.b(*is_mut); enc_Name(e, *name); match *sub { Some(y0) => { e.b(true); enc_Pat(e, y0); } None => e.b(false), } }
        PatKind::Lit(a0) => { e.u(3); enc_Expr(e, *a0); }
        PatKind::Range { lo, hi, inclusive, op_pos } => { e.u(4); match *lo { Some(y0) => { e.b(true); enc_Expr(e, y0); } None => e.b(false), } match *hi { Some(y0) => { e.b(true); enc_Expr(e, y0); } None => e.b(false), } e.b(*inclusive); e.pos(*op_pos); }
        PatKind::Path(a0) => { e.u(5); enc_Path(e, *a0); }
        PatKind::Tuple { lparen, elems } => { e.u(6); e.pos(*lparen); e.u((*elems).len() as u32); for y0 in (*elems).iter() { enc_Pat(e, *y0); } }
        PatKind::TupleStruct { path, elems } => { e.u(7); enc_Path(e, *path); e.u((*elems).len() as u32); for y0 in (*elems).iter() { enc_Pat(e, *y0); } }
        PatKind::Struct { path, fields, rest } => { e.u(8); enc_Path(e, *path); e.u((*fields).len() as u32); for y0 in (*fields).iter() { enc_FieldPat(e, *y0); } e.b(*rest); }
        PatKind::Slice { lbrack, elems } => { e.u(9); e.pos(*lbrack); e.u((*elems).len() as u32); for y0 in (*elems).iter() { enc_Pat(e, *y0); } }
        PatKind::Ref { amp, pat } => { e.u(10); e.pos(*amp); enc_Pat(e, *pat); }
        PatKind::Or(a0) => { e.u(11); e.u((*a0).len() as u32); for y0 in (*a0).iter() { enc_Pat(e, *y0); } }
    }
}

pub fn dec_PatKind(d: &mut Dec) -> &mut PatKind {
    let mut v = dec_val_PatKind(d);
    &mut v
}

pub fn dec_val_PatKind(d: &mut Dec) -> PatKind {
    match d.u() {
        0 => { let a0 = d.pos(); PatKind::Wild(a0) }
        1 => { let a0 = d.pos(); PatKind::Rest(a0) }
        2 => { let is_mut = d.b(); let name = dec_Name(d); let sub = if d.b() { let y: &Pat = dec_Pat(d); Some(y) } else { None }; PatKind::Ident { is_mut, name, sub } }
        3 => { let a0 = dec_Expr(d); PatKind::Lit(a0) }
        4 => { let lo = if d.b() { let y: &Expr = dec_Expr(d); Some(y) } else { None }; let hi = if d.b() { let y: &Expr = dec_Expr(d); Some(y) } else { None }; let inclusive = d.b(); let op_pos = d.pos(); PatKind::Range { lo, hi, inclusive, op_pos } }
        5 => { let a0 = dec_Path(d); PatKind::Path(a0) }
        6 => { let lparen = d.pos(); let elems = { let n = d.u() as usize; let mut v: Vec<&Pat> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Pat(d)); i += 1; } v }; PatKind::Tuple { lparen, elems } }
        7 => { let path = dec_Path(d); let elems = { let n = d.u() as usize; let mut v: Vec<&Pat> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Pat(d)); i += 1; } v }; PatKind::TupleStruct { path, elems } }
        8 => { let path = dec_Path(d); let fields = { let n = d.u() as usize; let mut v: Vec<&FieldPat> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_FieldPat(d)); i += 1; } v }; let rest = d.b(); PatKind::Struct { path, fields, rest } }
        9 => { let lbrack = d.pos(); let elems = { let n = d.u() as usize; let mut v: Vec<&Pat> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Pat(d)); i += 1; } v }; PatKind::Slice { lbrack, elems } }
        10 => { let amp = d.pos(); let pat = dec_Pat(d); PatKind::Ref { amp, pat } }
        11 => { let a0 = { let n = d.u() as usize; let mut v: Vec<&Pat> = Vec::with_capacity(n); let mut i = 0; while i < n { v.push(dec_Pat(d)); i += 1; } v }; PatKind::Or(a0) }
        _ => panic("navih: bad export data"),
    }
}
