        Item::Struct(a0) => { e.u(1); enc_StructDecl(e, *a0); }
        Item::Enum(a0) => { e.u(2); enc_EnumDecl(e, *a0); }
        Item::TypeAlias(a0) => { e.u(3); enc_TypeAlias(e, *a0); }
        Item::Const(a0) => { e.u(4); enc_ConstDecl(e, *a0); }
        Item::Static(a0) => { e.u(5); enc_StaticDecl(e, *a0); }
        Item::Impl(a0) => { e.u(6); enc_ImplDecl(e, *a0); }
        Item::Trait(a0) => { e.u(7); enc_TraitDecl(e, *a0); }
        Item::Mod(a0) => { e.u(8); enc_ModDecl(e, *a0); }
        Item::Use(a0) => { e.u(9); enc_UseDecl(e, *a0); }
