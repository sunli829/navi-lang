//! Small helpers shared by the compiler (Go-compatible quoting, so that
//! messages match stage0 byte for byte).

/// Quotes s like Go's strconv.Quote.
pub fn quote(s: &str) -> String {
    let mut out = String::from("\"");
    for c in s.chars() { quote_char_into(&mut out, c, '"'); }
    out.push('"');
    out
}

/// Quotes c like Go's %q for a rune.
pub fn quote_char(c: char) -> String {
    let mut out = String::from("'");
    quote_char_into(&mut out, c, '\'');
    out.push('\'');
    out
}

fn quote_char_into(out: &mut String, c: char, q: char) {
    let v = c as u32;
    if c == q || c == '\\' {
        out.push('\\');
        out.push(c);
    } else if c == '\n' {
        out.push_str("\\n");
    } else if c == '\t' {
        out.push_str("\\t");
    } else if c == '\r' {
        out.push_str("\\r");
    } else if v == 7 {
        out.push_str("\\a");
    } else if v == 8 {
        out.push_str("\\b");
    } else if v == 12 {
        out.push_str("\\f");
    } else if v == 11 {
        out.push_str("\\v");
    } else if v < 0x20 || v == 0x7f {
        out.push_str("\\x");
        out.push(hex_digit(v >> 4));
        out.push(hex_digit(v & 15));
    } else if v == 0xFFFD {
        out.push_str("\\ufffd");
    } else {
        out.push(c);
    }
}

fn hex_digit(v: u32) -> char {
    if v < 10 { (b'0' + v as u8) as char } else { (b'a' + (v - 10) as u8) as char }
}

/// Quotes bytes like Go's %q on a byte slice.
pub fn quote_bytes(b: &[u8]) -> String { quote(String::from_utf8_lossy(b).as_str()) }

/// Decodes the UTF-8 character at b[i] (U+FFFD and size 1 if invalid).
pub fn decode_rune(b: &[u8], i: usize) -> (char, usize) {
    if i >= b.len() { return ('\u{FFFD}', 0); }
    let n = std::str::utf8_seq_len(b, i);
    if n == 0 { return ('\u{FFFD}', 1); }
    let c = unsafe { std::str::from_utf8_unchecked(&b[i..i + n]) }.chars().next().unwrap();
    (c, n)
}
