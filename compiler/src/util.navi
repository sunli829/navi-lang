//! Small helpers shared by the compiler (quoting as Go's strconv.Quote).

/// Quotes s like Go's strconv.Quote.
pub fn quote(s: &str) -> String {
    let mut out = String::from("\"");
    for c in s.chars() { quote_char_into(&mut out, c, '"'); }
    out.push('"');
    out
}

/// Quotes c like Go's %q for a rune.
pub fn quote_char(c: char) -> String {
    let mut out = String::from("'");
    quote_char_into(&mut out, c, '\'');
    out.push('\'');
    out
}

fn quote_char_into(out: &mut String, c: char, q: char) {
    let v = c as u32;
    if c == q || c == '\\' {
        out.push('\\');
        out.push(c);
    } else if c == '\n' {
        out.push_str("\\n");
    } else if c == '\t' {
        out.push_str("\\t");
    } else if c == '\r' {
        out.push_str("\\r");
    } else if v == 7 {
        out.push_str("\\a");
    } else if v == 8 {
        out.push_str("\\b");
    } else if v == 12 {
        out.push_str("\\f");
    } else if v == 11 {
        out.push_str("\\v");
    } else if v < 0x20 || v == 0x7f {
        out.push_str("\\x");
        out.push(hex_digit(v >> 4));
        out.push(hex_digit(v & 15));
    } else if v == 0xFFFD {
        out.push_str("\\ufffd");
    } else {
        out.push(c);
    }
}

fn hex_digit(v: u32) -> char {
    if v < 10 { (b'0' + v as u8) as char } else { (b'a' + (v - 10) as u8) as char }
}

/// Quotes bytes like Go's %q on a byte slice.
pub fn quote_bytes(b: &[u8]) -> String { quote(String::from_utf8_lossy(b).as_str()) }

/// Decodes the UTF-8 character at b[i] (U+FFFD and size 1 if invalid).
pub fn decode_rune(b: &[u8], i: usize) -> (char, usize) {
    if i >= b.len() { return ('\u{FFFD}', 0); }
    let n = std::str::utf8_seq_len(b, i);
    if n == 0 { return ('\u{FFFD}', 1); }
    let c = unsafe { std::str::from_utf8_unchecked(&b[i..i + n]) }.chars().next().unwrap();
    (c, n)
}

/// Joins and cleans slash-separated paths like Go's path.Join.
pub fn path_join(a: &str, b: &str) -> String {
    if a.len() == 0 { return path_clean(b); }
    if b.len() == 0 { return path_clean(a); }
    path_clean(`${a}/${b}`.to_string().as_str())
}

/// Cleans a slash-separated path like Go's path.Clean.
pub fn path_clean(p0: &str) -> String {
    if p0.len() == 0 { return ".".to_string(); }
    // A Windows path (c:\dir or C:/dir) is C:/dir: one spelling of each
    // file (the LSP compares paths from URIs, which spell the drive either
    // way, with paths from NAVI_STD).
    let b = p0.as_bytes();
    let mut fixed = String::new();
    if b.len() >= 2 && b[1] == b':' && ((b[0] >= b'a' && b[0] <= b'z') || (b[0] >= b'A' && b[0] <= b'Z'))
        && (b.len() == 2 || b[2] == b'/' || b[2] == b'\\') {
        fixed.push((b[0] as char).to_ascii_uppercase());
        for c in p0[1..].chars() { fixed.push(if c == '\\' { '/' } else { c }); }
    }
    let p = if fixed.len() > 0 { fixed.as_str() } else { p0 };
    let rooted = p.starts_with('/');
    let mut parts: Vec<&str> = Vec::new();
    for seg in p.split('/') {
        if seg.len() == 0 || seg == "." { continue; }
        if seg == ".." {
            if parts.len() > 0 && *parts.last().unwrap() != ".." {
                parts.pop();
            } else if !rooted {
                parts.push("..");
            }
            continue;
        }
        parts.push(seg);
    }
    let body = parts.join("/");
    if rooted { return `/${body}`.to_string(); }
    if body.len() == 0 { return ".".to_string(); }
    body
}

/// The directory of a slash-separated path (Go's path.Dir).
pub fn path_dir(p: &str) -> String {
    match p.rfind('/') {
        Some(i) => path_clean(&p[0..i + 1]),
        None => ".".to_string(),
    }
}

/// The last element of a slash-separated path (Go's path.Base).
pub fn path_base(p: &str) -> String {
    let t = p.trim_end_matches('/');
    if t.len() == 0 { return if p.len() > 0 { "/".to_string() } else { ".".to_string() }; }
    match t.rfind('/') { Some(i) => t[i + 1..].to_string(), None => t.to_string() }
}

/// Quotes bytes like Go's strconv.Quote on a string holding them: invalid
/// UTF-8 bytes become \x escapes.
pub fn quote_go_bytes(b: &[u8]) -> String {
    let mut out = String::from("\"");
    let mut i = 0;
    while i < b.len() {
        let (c, n) = decode_rune(b, i);
        if c == '\u{FFFD}' && n == 1 {
            out.push_str("\\x");
            out.push(hex_digit((b[i] >> 4) as u32));
            out.push(hex_digit((b[i] & 15) as u32));
        } else {
            quote_char_into(&mut out, c, '"');
        }
        i += n;
    }
    out.push('"');
    out
}

/// Formats f like Go's %g (shortest representation).
pub fn format_g(f: f64) -> String {
    if f != f { return "NaN".to_string(); }
    if f == f64::INFINITY { return "+Inf".to_string(); }
    if f == f64::NEG_INFINITY { return "-Inf".to_string(); }
    let s = `${f}`.to_string();
    let neg = s.starts_with("-");
    let a = if neg { &s[1..] } else { s.as_str() };
    let (ip, fp) = match a.split_once('.') { Some((x, y)) => (x, y), None => (a, "") };
    // Decimal digits d1 d2 ... with the decimal point after dp digits.
    let mut digits = String::new();
    let mut dp: i64;
    if ip != "0" {
        digits.push_str(ip);
        digits.push_str(fp);
        dp = ip.len() as i64;
    } else {
        let fb = fp.as_bytes();
        let mut z = 0;
        while z < fb.len() && fb[z] == b'0' { z += 1; }
        digits.push_str(&fp[z..]);
        dp = -(z as i64);
    }
    while digits.ends_with("0") { digits.pop(); }
    let mut out = if neg { "-".to_string() } else { String::new() };
    let nd = digits.len() as i64;
    if nd == 0 {
        out.push('0');
        return out;
    }
    let exp = dp - 1;
    if exp < -4 || exp >= 6 {
        out.push_str(&digits[0..1]);
        if nd > 1 {
            out.push('.');
            out.push_str(&digits[1..]);
        }
        out.push('e');
        let (sign, e) = if exp < 0 { ('-', -exp) } else { ('+', exp) };
        out.push(sign);
        if e < 10 { out.push('0'); }
        out.push_str(&`${e}`.to_string());
        return out;
    }
    if dp <= 0 {
        out.push_str("0.");
        let mut i = 0;
        while i < -dp { out.push('0'); i += 1; }
        out.push_str(digits.as_str());
        return out;
    }
    if dp >= nd {
        out.push_str(digits.as_str());
        let mut i = nd;
        while i < dp { out.push('0'); i += 1; }
        return out;
    }
    out.push_str(&digits[0..dp as usize]);
    out.push('.');
    out.push_str(&digits[dp as usize..]);
    out
}

/// Runs f(i) for every i < n on as many threads as can run (chunk indexes
/// at a time); f must only write state of its own index. In order on one
/// thread when there is little work.
pub fn par_for(n: usize, chunk: usize, f: fn(usize)) { par_for_w(n, chunk, |w, i| f(i)); }

/// The number of workers par_for_w may use at most.
pub fn max_workers() -> usize { match std::thread::available_parallelism() { Ok(k) => k, Err(_) => 1 } }

/// par_for passing f also the number of the worker (below max_workers())
/// that runs it, for state of the worker's own.
pub fn par_for_w(n: usize, chunk: usize, f: fn(usize, usize)) {
    let mut nw = max_workers();
    if nw > n / chunk { nw = n / chunk; }
    if nw <= 1 {
        let mut i = 0;
        while i < n {
            f(0, i);
            i += 1;
        }
        return;
    }
    let next = &std::sync::atomic::AtomicUsize::new(0);
    let mut hs = Vec::new();
    let mut k = 0;
    while k < nw {
        let w = k;
        hs.push(std::thread::spawn(|| {
            loop {
                let start = next.fetch_add(chunk, std::sync::atomic::Ordering::Relaxed);
                if start >= n { return; }
                let mut i = start;
                while i < start + chunk && i < n {
                    f(w, i);
                    i += 1;
                }
            }
        }));
        k += 1;
    }
    for h in hs.iter() { h.join().unwrap(); }
}
