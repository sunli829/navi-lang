//! Diagnostics shared by the compiler phases.

use crate::syntax::source::{File, Pos, Position};

#[derive(Clone, Debug)]
pub struct Error {
    pub pos: Position,
    pub msg: String,
    /// A warning: printed, but the compilation goes on.
    pub warning: bool,
}

impl std::fmt::Display for Error {
    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
        if self.pos.file.len() == 0 && self.pos.line == 0 {
            return f.write_fmt(`:0:0: ${self.msg}`);
        }
        if self.warning {
            return f.write_fmt(`${self.pos}: warning: ${self.msg}`);
        }
        f.write_fmt(`${self.pos}: ${self.msg}`)
    }
}

/// Collects diagnostics.
pub struct Sink {
    list: Vec<Error>,
}

impl Sink {
    pub fn new() -> &mut Sink {
        &mut Sink { list: Vec::new() }
    }

    /// Records a diagnostic at pos in f (f may be absent).
    pub fn errorf(&mut self, f: Option<&File>, pos: Pos, msg: String) {
        let p = match f {
            Some(file) => file.position(pos),
            None => Position {
                file: String::new(),
                line: 0,
                col: 0,
            },
        };
        let note = match f {
            Some(file) => file.origin_note(pos),
            None => String::new(),
        };
        self.list.push(Error {
            pos: p,
            msg: `${msg}${note}`.to_string(),
            warning: false,
        });
    }

    /// Records a warning at pos in f.
    pub fn warnf(&mut self, f: Option<&File>, pos: Pos, msg: String) {
        let p = match f {
            Some(file) => file.position(pos),
            None => Position {
                file: String::new(),
                line: 0,
                col: 0,
            },
        };
        let note = match f {
            Some(file) => file.origin_note(pos),
            None => String::new(),
        };
        self.list.push(Error {
            pos: p,
            msg: `${msg}${note}`.to_string(),
            warning: true,
        });
    }

    pub fn add(&mut self, e: Error) {
        self.list.push(e);
    }

    /// Adds the diagnostics of another sink.
    pub fn append(&mut self, other: &Sink) {
        for e in other.list.iter() {
            self.list.push(e.clone());
        }
    }

    pub fn len(&self) -> usize {
        self.list.len()
    }

    /// The diagnostics sorted by file, line and column.
    pub fn sorted(&self) -> Vec<Error> {
        let mut l = self.list.clone();
        l.sort_by(|a, b| {
            if a.pos.file != b.pos.file {
                return a.pos.file.cmp(&b.pos.file);
            }
            if a.pos.line != b.pos.line {
                return a.pos.line.cmp(&b.pos.line);
            }
            a.pos.col.cmp(&b.pos.col)
        });
        l
    }
}
