//! Diagnostics shared by the compiler phases.

use crate::syntax::source::{File, Pos, Position};

#[derive(Clone, Debug)]
pub struct Error {
    pub pos: Position,
    pub msg: String,
}

impl std::fmt::Display for Error {
    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
        if self.pos.file.len() == 0 && self.pos.line == 0 {
            return f.write_fmt(`:0:0: ${self.msg}`);
        }
        f.write_fmt(`${self.pos}: ${self.msg}`)
    }
}

/// Collects diagnostics.
pub struct Sink { list: Vec<Error> }

impl Sink {
    pub fn new() -> &mut Sink { &mut Sink { list: Vec::new() } }

    /// Records a diagnostic at pos in f (f may be absent).
    pub fn errorf(&mut self, f: Option<&File>, pos: Pos, msg: String) {
        let p = match f { Some(file) => file.position(pos), None => Position { file: String::new(), line: 0, col: 0 } };
        self.list.push(Error { pos: p, msg });
    }

    pub fn add(&mut self, e: Error) { self.list.push(e); }

    pub fn len(&self) -> usize { self.list.len() }

    /// The diagnostics sorted by file, line and column.
    pub fn sorted(&self) -> Vec<Error> {
        let mut l = self.list.clone();
        l.sort_by(|a, b| {
            if a.pos.file != b.pos.file { return a.pos.file.cmp(&b.pos.file); }
            if a.pos.line != b.pos.line { return a.pos.line.cmp(&b.pos.line); }
            a.pos.col.cmp(&b.pos.col)
        });
        l
    }
}
