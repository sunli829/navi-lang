//! SHA-256 (FIPS 180-4), for code signatures and the build cache.

const K: [u32; 64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
];

const M: u64 = 0xffffffff;

// The rounds keep 32-bit words in u64 (masked), with rotations and
// additions written out: this runs over every page of every executable.
fn block(h: &mut [u32; 8], b: &[u8], at: usize) {
    let mut w = [0u64; 64];
    let mut i = 0;
    while i < 16 {
        let j = at + 4 * i;
        w[i] = (b[j] as u64) << 24 | (b[j + 1] as u64) << 16 | (b[j + 2] as u64) << 8 | b[j + 3] as u64;
        i += 1;
    }
    while i < 64 {
        let x = w[i - 15];
        let y = w[i - 2];
        let s0 = ((x >> 7 | x << 25) ^ (x >> 18 | x << 14) ^ (x >> 3)) & M;
        let s1 = ((y >> 17 | y << 15) ^ (y >> 19 | y << 13) ^ (y >> 10)) & M;
        w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & M;
        i += 1;
    }
    let mut a = h[0] as u64;
    let mut bb = h[1] as u64;
    let mut c = h[2] as u64;
    let mut d = h[3] as u64;
    let mut e = h[4] as u64;
    let mut f = h[5] as u64;
    let mut g = h[6] as u64;
    let mut hh = h[7] as u64;
    i = 0;
    while i < 64 {
        let s1 = ((e >> 6 | e << 26) ^ (e >> 11 | e << 21) ^ (e >> 25 | e << 7)) & M;
        let ch = (e & f) ^ (!e & g & M);
        let t1 = hh + s1 + ch + K[i] as u64 + w[i];
        let s0 = ((a >> 2 | a << 30) ^ (a >> 13 | a << 19) ^ (a >> 22 | a << 10)) & M;
        let maj = (a & bb) ^ (a & c) ^ (bb & c);
        hh = g;
        g = f;
        f = e;
        e = (d + t1) & M;
        d = c;
        c = bb;
        bb = a;
        a = (t1 + s0 + maj) & M;
        i += 1;
    }
    h[0] = ((h[0] as u64 + a) & M) as u32;
    h[1] = ((h[1] as u64 + bb) & M) as u32;
    h[2] = ((h[2] as u64 + c) & M) as u32;
    h[3] = ((h[3] as u64 + d) & M) as u32;
    h[4] = ((h[4] as u64 + e) & M) as u32;
    h[5] = ((h[5] as u64 + f) & M) as u32;
    h[6] = ((h[6] as u64 + g) & M) as u32;
    h[7] = ((h[7] as u64 + hh) & M) as u32;
}

#[cfg(target_os = "macos")]
extern "C" {
    // libSystem's CommonCrypto (with the CPU's SHA-256 instructions).
    fn CC_SHA256(data: *const u8, len: u32, md: *mut u8) -> *mut u8;
}

/// The SHA-256 digest of data.
#[cfg(target_os = "macos")]
pub fn sum(data: &[u8]) -> [u8; 32] {
    if data.len() >= 4294967296 { return soft_sum(data); }
    let mut out = [0u8; 32];
    unsafe { CC_SHA256(data.as_ptr(), data.len() as u32, &mut out as *mut [u8; 32] as *mut u8); }
    out
}

#[cfg(not(target_os = "macos"))]
pub fn sum(data: &[u8]) -> [u8; 32] { soft_sum(data) }

fn soft_sum(data: &[u8]) -> [u8; 32] {
    let mut h: [u32; 8] = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
    let n = data.len();
    let mut at = 0;
    while at + 64 <= n {
        block(&mut h, data, at);
        at += 64;
    }
    // The last block(s): the rest, 0x80, zeros and the bit length.
    let mut tail: Vec<u8> = Vec::new();
    while at < n {
        tail.push(data[at]);
        at += 1;
    }
    tail.push(0x80);
    while tail.len() % 64 != 56 { tail.push(0); }
    let bits = (n as u64) * 8;
    let mut k = 0;
    while k < 8 {
        tail.push((bits >> (56 - 8 * k) as u32) as u8);
        k += 1;
    }
    let mut t = 0;
    while t < tail.len() {
        block(&mut h, tail.as_slice(), t);
        t += 64;
    }
    let mut out = [0u8; 32];
    let mut i = 0;
    while i < 8 {
        out[4 * i] = (h[i] >> 24) as u8;
        out[4 * i + 1] = (h[i] >> 16) as u8;
        out[4 * i + 2] = (h[i] >> 8) as u8;
        out[4 * i + 3] = h[i] as u8;
        i += 1;
    }
    out
}

/// The digest as lowercase hex.
pub fn hex(d: &[u8; 32]) -> String {
    let digits = "0123456789abcdef".as_bytes();
    let mut s = String::new();
    for b in d.iter() {
        s.push(digits[(*b >> 4) as usize] as char);
        s.push(digits[(*b & 15) as usize] as char);
    }
    s
}
