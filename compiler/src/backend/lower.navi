//! Turns the code generation plan into machine code and data for any
//! architecture: lowers MIR to the abstract operations of a Machine and
//! lays out dictionaries, vtables, locations, statics and strings in a
//! format-neutral object.
//!
//! Internal calling convention (all navi functions, closures and shims):
//! CTX is the dictionary of the instance (for closures the environment,
//! whose word at -8 holds the dictionary), RET the address of the result
//! slot, LOC the caller location for #[track_caller]; arguments are on the
//! caller's stack at sp+off, each rounded up to 8 bytes (the callee sees
//! them at FP+16+off). No register survives a call. Every MIR local lives
//! in the frame: FP-8 context, FP-16 result slot address, FP-24 caller
//! location, FP-32 head of the defer list, then locals, the call result
//! buffer and the staging buffer; SP+0 is the outgoing argument area.

use std::collections::HashMap;
use std::sync::Mutex;
use std::sync::mpmc::{channel, Sender};
use std::thread;
use crate::resolve::{Def, Node};
use crate::syntax::ast::{ExprKind, Item, LitKind};
use crate::syntax::source::{File, Pos};
use crate::types::{self, Type};
use crate::layout::{self, Computer, Layout};
use crate::mir::{self, Func, Const, Operand, Place, Rvalue, Stmt, Term};
use crate::codegen::{self, Plan, Group, Inst, Target, Vtable, DictEntry};
use crate::obj::{self, Object};
use crate::backend::machine::*;

const SLOT_CTX: i64 = -8;
const SLOT_RET: i64 = -16;
const SLOT_LOC: i64 = -24;
const SLOT_DEFERS: i64 = -32;
const FIXED_FRAME: i64 = 40;

/// The platform conventions that matter to lowering.
#[derive(Clone)]
pub struct TargetConv {
    /// Prepended to C symbol names ("_" on macOS).
    pub c_prefix: String,
    /// The C function writing to a file descriptor.
    pub write: String,
}

#[derive(Clone)]
struct LocData {
    sym: String,
    file: String,
    line: i64,
    col: i64,
}

/// A function lowered by a worker, waiting to be placed in the object. Its
/// relocations name the strings and locations it uses as %S<i> and %L<i>
/// (indexes into strs and locs): they get their symbols when the functions
/// are merged in order, so the object does not depend on the threads.
// A relocation of a worker's function: against symbol number id (numbered
// before the workers started), else by name (strings, locations and the
// rest get their numbers when merged).
struct OutReloc {
    off: u32,
    kind: obj::RelocKind,
    id: i64,
    /// 1: the function's string ix, 2: its location ix (see FuncOut).
    ph: u8,
    ix: usize,
    name: String,
}

struct FuncOut {
    sym: String,
    name: String,
    code: Vec<u8>,
    relocs: Vec<OutReloc>,
    /// (offset in code, file, line) in debug builds.
    // Offset and line, in file.
    lines: Vec<(u64, u32)>,
    /// The stack map (see stack_meta), with the calls' masks.
    meta: Vec<u64>,
    file: Option<&File>,
    strs: Vec<Vec<u8>>,
    locs: Vec<LocData>,
    undef: Vec<String>,
    errs: Vec<String>,
    failed: bool,
}

/// A function to lower, in the order of the object.
struct Job {
    grp: &mut Group,
    f: &mut Func,
    sym: String,
}

// The runtime symbols generated code refers to by name.
const RUNTIME_SYMS: [&str; 19] = ["_navi_argc", "_navi_argv", "_navi_data_end", "_navi_data_start", "_navi_g0boot", "_navi_gc_marking",
    "_navi_gstart", "_navi_longjmp", "_navi_morestack", "_navi_mstart", "_navi_os_sp", "_navi_overflow", "_navi_rundefers",
    "_navi_saved_greg", "_navi_scanw", "_navi_setjmp", "_navi_stack_lo", "_navi_stack_top", "_navi_swapctx"];

// The functions a worker takes at a time.
const CHUNK: usize = 4;

pub struct Gen {
    /// The function being made's stack map (without its calls), its saved
    /// registers' pointer masks by position, and the mask of every saved
    /// register it uses.
    cur_meta: Vec<u64>,
    cur_masks: Vec<u16>,
    cur_all: u64,
    /// The functions placed with stack maps: (symbol, text offset, size,
    /// map symbol), in text order.
    ftab: Vec<(u64, u64, u64)>,
    /// The stack maps, one after another (ftab has each one's offset).
    fmeta: Vec<u8>,
    /// Placeholder names (%S<k>, %L<k>), made once for each k.
    ph_s: Vec<String>,
    ph_l: Vec<String>,
    /// A number for each file name, and the symbol of each file name.
    file_no: HashMap<String, u32>,
    file_sym: HashMap<String, String>,
    /// A worker's locations in the function by file number and position.
    floc_pos: HashMap<u64, usize>,
    /// Runtime symbols every function refers to (shared by relocations).
    sym_marking: String,
    sym_rundefers: String,
    /// choose_registers' buffers, reused from one function to the next.
    live: &mut Live,
    p: &mut Plan,
    o: &mut Object,
    m: &mut dyn Machine,
    tgt: TargetConv,
    debug: bool,
    lay: &mut Computer,
    locs: HashMap<String, String>,
    loc_list: Vec<LocData>,
    /// Symbol numbers of locations (by key) and strings, for merge.
    loc_ids: HashMap<String, u32>,
    str_ids: HashMap<Vec<u8>, u32>,
    closure: HashMap<String, String>,
    statics: HashMap<u32, String>,
    errs: Vec<String>,
    /// The current function's line rows (code offset, position) and file,
    /// recorded in debug builds.
    cur_lines: Vec<(usize, Pos)>,
    cur_file: Option<&File>,
    cur_name: String,
    /// Held while lowering uses state shared by the threads: the type
    /// context (concrete types are interned), the layouts and the type
    /// checker's caches.
    lock: &Mutex<u8>,
    /// The layouts this generator has used (read without the lock).
    lays: HashMap<u32, &mut Layout>,
    /// Field types by (type id, variant).
    ftypes: HashMap<u64, Vec<&Type>>,
    loc_ty: &Type,
    /// A worker lowers functions into outs; the current function's strings,
    /// locations and C symbols are collected for its FuncOut.
    worker: bool,
    outs: Vec<&mut FuncOut>,
    fstrs: Vec<Vec<u8>>,
    fstr_ix: HashMap<Vec<u8>, usize>,
    flocs: Vec<LocData>,
    floc_ix: HashMap<String, usize>,
    fundef: Vec<String>,
    /// The symbol numbers given before the workers started (read only).
    main_ids: HashMap<String, u32>,
}

fn round8(n: i64) -> i64 { (n + 7) & !7 }

fn int_min(size: i64) -> i64 { -1i64 << (size * 8 - 1) as u32 }

fn put_u64(b: &mut Vec<u8>, at: usize, v: u64) {
    let mut i = 0;
    while i < 8 {
        b[at + i] = (v >> (8 * i) as u32) as u8;
        i += 1;
    }
}

fn put_u32(b: &mut Vec<u8>, at: usize, v: u32) {
    let mut i = 0;
    while i < 4 {
        b[at + i] = (v >> (8 * i) as u32) as u8;
        i += 1;
    }
}

fn zeros(n: i64) -> Vec<u8> {
    let mut v = Vec::new();
    let mut i = 0;
    while i < n { v.push(0u8); i += 1; }
    v
}

/// The C symbol of an extern function (#[link_name = "..."]).
fn link_name(d: &Def) -> String {
    if let Node::Item(Item::Fn(f)) = &d.node {
        for a in f.base.attrs.iter() {
            if a.path.segments.len() == 1 && a.path.segments[0].name.value == "link_name" {
                if let Some(v) = a.value {
                    if let ExprKind::Lit { kind, value, .. } = &v.kind {
                        if *kind == LitKind::Str {
                            return String::from_utf8_lossy(crate::mir::expr::unquote(value.as_str()).as_slice()).to_string();
                        }
                    }
                }
            }
        }
    }
    d.name.clone()
}

fn new_gen(p: &mut Plan, arch: &str, m: &mut dyn Machine, tgt: TargetConv, debug: bool, lock: &Mutex<u8>, loc_ty: &Type) -> &mut Gen {
    &mut Gen { p, o: obj::new_object(arch), m, tgt, debug, lay: p.lay, locs: HashMap::new(), loc_list: Vec::new(),
        loc_ids: HashMap::new(), str_ids: HashMap::new(),
        closure: HashMap::new(), statics: HashMap::new(), errs: Vec::new(), cur_lines: Vec::new(), cur_file: None, cur_name: String::new(),
        lock, lays: HashMap::new(), ftypes: HashMap::new(), loc_ty, worker: false, outs: Vec::new(), fstrs: Vec::new(), fstr_ix: HashMap::new(),
        flocs: Vec::new(), floc_ix: HashMap::new(), fundef: Vec::new(), main_ids: HashMap::new(), live: new_live(), cur_meta: Vec::new(), cur_masks: Vec::new(), cur_all: 0, ftab: Vec::new(), fmeta: Vec::new(), ph_s: Vec::new(), ph_l: Vec::new(), file_no: HashMap::new(),
        file_sym: HashMap::new(), floc_pos: HashMap::new(),
        sym_marking: "_navi_gc_marking".to_string(), sym_rundefers: "_navi_rundefers".to_string() }
}

/// Lowers the plan into a new object for arch, with a machine from new_m
/// per thread: the functions are lowered by as many threads as can run at
/// once (std::thread::available_parallelism) and placed in the object in
/// order.
pub fn generate(p: &mut Plan, arch: &str, new_m: fn() -> &mut dyn Machine, tgt: TargetConv, debug: bool) -> Result<&mut Object, String> {
    if p.errors.len() > 0 { return Err(p.errors.join("\n")); }
    let lock = &Mutex::new(0u8);
    let loc_def = p.info.lang_def("Location").unwrap();
    let loc_ty = p.info.ctx.adt(loc_def, Vec::new());
    let g = new_gen(p, arch, new_m(), tgt.clone(), debug, lock, loc_ty);
    let mut i = 0;
    while i < p.statics.len() {
        let d = p.statics[i];
        g.statics.insert(d.id, `_navi_static${i}_${d.name}`);
        i += 1;
    }
    // Every function with its symbol (a group's closures are numbered
    // within the group).
    let mut jobs: Vec<Job> = Vec::new();
    for gp in p.groups.iter() {
        let grp = *gp;
        let mut todo: Vec<&mut Func> = Vec::new();
        collect_closures(grp.rep.func, &mut todo);
        jobs.push(Job { grp, f: grp.rep.func, sym: grp.sym.clone() });
        let mut k = 0;
        for c in todo.iter() {
            let s = `${grp.sym}_c${k}`;
            g.closure.insert(`${grp.sym}/${c.id}`, s.clone());
            jobs.push(Job { grp, f: *c, sym: s });
            k += 1;
        }
    }
    // Number the symbols functions refer to, so that workers give their
    // relocations numbers (the linker then looks nothing up by name).
    for grp in p.groups.iter() {
        g.o.id(grp.sym.as_str());
        for inst in grp.insts.iter() { g.o.id(inst.dict.as_str()); }
    }
    for j in jobs.iter() { g.o.id(j.sym.as_str()); }
    for v in p.vtable_list.iter() { g.o.id(v.sym.as_str()); }
    for (_, sym) in g.statics.iter() { g.o.id(sym.as_str()); }
    for sym in RUNTIME_SYMS.iter() { g.o.id(*sym); }
    let mut nw = match thread::available_parallelism() { Ok(n) => n, Err(_) => 1 };
    if nw > jobs.len() / CHUNK { nw = jobs.len() / CHUNK; }
    let next = &std::sync::atomic::AtomicUsize::new(0);
    // The largest functions first (as Go does): a large one taken last
    // would keep the others waiting.
    let mut sizes: Vec<(usize, usize)> = Vec::new();
    let mut ji = 0;
    while ji < jobs.len() {
        let mut n = 0;
        for b in jobs[ji].f.blocks.iter() { n += b.stmts.len() + 1; }
        sizes.push((n, ji));
        ji += 1;
    }
    sizes.sort_by(|a, b| if a.0 != b.0 { b.0.cmp(&a.0) } else { a.1.cmp(&b.1) });
    let mut order: Vec<usize> = Vec::new();
    for (_, j) in sizes.iter() { order.push(*j); }
    // Functions are placed in the order they are taken, each as soon as
    // it is done (while the workers lower the rest).
    let ids = g.o.ids.clone();
    let (tx, rx) = channel::<Vec<(usize, &mut FuncOut)>>();
    let mut hs = Vec::new();
    if nw > 1 { p.info.ctx.par = true; }
    let mut k = 0;
    while k < nw || k == 0 {
        let w = g.worker_gen(new_m(), arch, ids);
        if nw <= 1 {
            run_jobs(w, &mut jobs, &order, next, tx);
        } else {
            hs.push(thread::spawn(|| run_jobs(w, &mut jobs, &order, next, tx)));
        }
        k += 1;
    }
    // The start of the text (the stack map table counts from it).
    g.o.define("_navi_text0", obj::TEXT, 4, false);
    let mut outs: Vec<Option<&mut FuncOut>> = Vec::new();
    for _ in jobs.iter() { outs.push(None); }
    for j in order.iter() {
        while outs[*j].is_none() {
            for (d, o) in rx.recv().unwrap().iter() { outs[*d] = Some(*o); }
        }
        g.merge(outs[*j].unwrap());
        outs[*j] = None;
    }
    for h in hs.iter() { h.join().unwrap(); }
    p.info.ctx.par = false;
    g.gen_main();
    g.gen_run_defers();
    g.gen_sched();
    g.gen_data();
    if g.errs.len() > 0 { return Err(g.errs.join("\n")); }
    Ok(g.o)
}

// Lowers jobs, CHUNK at a time, until none is left.
fn run_jobs(w: &mut Gen, jobs: &mut Vec<Job>, order: &Vec<usize>, next: &std::sync::atomic::AtomicUsize, tx: Sender<Vec<(usize, &mut FuncOut)>>) {
    loop {
        let start = next.fetch_add(CHUNK, std::sync::atomic::Ordering::Relaxed);
        if start >= jobs.len() { return; }
        let mut k = start;
        let mut done: Vec<(usize, &mut FuncOut)> = Vec::new();
        while k < start + CHUNK && k < jobs.len() {
            let j = order[k];
            let job = &mut jobs[j];
            w.gen_func(job.grp, job.f, job.sym.clone());
            done.push((j, w.outs.pop().unwrap()));
            k += 1;
        }
        let _ = tx.send(done);
    }
}

// Whether t is its own concrete type in every instance: no type
// parameters, projections or opaque types in it (read only: types never
// change).
fn ground(t: &Type) -> bool {
    match t.kind {
        types::K_PARAM | types::K_PROJ | types::K_OPAQUE | types::K_DYN | types::K_INFER | types::K_CONST => false,
        types::K_REF | types::K_PTR | types::K_SLICE => ground(t.el()),
        types::K_ARRAY => t.ret.is_none() && ground(t.el()),
        types::K_TUPLE => ground_list(&t.elems),
        types::K_FN => ground_list(&t.elems) && ground(t.ret.unwrap()),
        types::K_ADT => ground_list(&t.args),
        _ => true,
    }
}

fn ground_list(ts: &Vec<&Type>) -> bool {
    for t in ts.iter() { if !ground(*t) { return false; } }
    true
}

// %S<k> (1, k) or %L<k> (2, k); (0, 0) for a symbol.
fn placeholder_index(s: &String) -> (u8, usize) {
    let b = s.as_bytes();
    if b.len() < 3 || b[0] != b'%' { return (0, 0); }
    let mut k = 0usize;
    let mut i = 2;
    while i < b.len() {
        k = k * 10 + (b[i] - b'0') as usize;
        i += 1;
    }
    (if b[1] == b'S' { 1 } else { 2 }, k)
}

impl Gen {
    fn errorf(&mut self, msg: String) { self.errs.push(msg); }

    /// A generator for a worker thread (sharing the plan, the statics and
    /// the closure symbols, read only).
    fn worker_gen(&mut self, m: &mut dyn Machine, arch: &str, ids: HashMap<String, u32>) -> &mut Gen {
        let w = new_gen(self.p, arch, m, self.tgt.clone(), self.debug, self.lock, self.loc_ty);
        w.worker = true;
        // Its own layouts (the type context and the type checker's queries
        // are safe to share while ctx.par is set).
        w.lay = layout::new_computer(self.p.info);
        w.statics = self.statics;
        w.closure = self.closure;
        // The symbol numbers before any function is placed (the main
        // thread numbers more while the workers run).
        w.main_ids = ids;
        w
    }

    /// Places a worker's function in the text section.
    fn merge(&mut self, out: &mut FuncOut) {
        for e in out.errs.iter() { self.errorf(e.clone()); }
        if out.failed { return; }
        // Each string and location of the function gets its symbol number
        // once; relocations refer to them by index.
        let mut strs: Vec<u32> = Vec::new();
        for s in out.strs.iter() {
            let id = match self.str_ids.get(s) {
                Some(i) => *i,
                None => {
                    let sym = self.p.str_sym(s);
                    let i = self.o.id_s(&sym);
                    self.str_ids.insert(s.clone(), i);
                    i
                }
            };
            strs.push(id);
        }
        let mut locs: Vec<u32> = Vec::new();
        for l in out.locs.iter() {
            let id = match self.loc_ids.get(&l.sym) {
                Some(i) => *i,
                None => {
                    let sym = self.loc_at(l.file.as_str(), l.line, l.col);
                    let i = self.o.id_s(&sym);
                    self.loc_ids.insert(l.sym.clone(), i);
                    i
                }
            };
            locs.push(id);
        }
        for u in out.undef.iter() { self.o.undefined(u.as_str()); }
        let align = if self.o.arch == "amd64" { 16 } else { 4 };
        let off = self.o.define(out.sym.as_str(), obj::TEXT, align, false);
        self.o.append(obj::TEXT, out.code.as_slice());
        if out.meta.len() > 0 {
            let mo = self.fmeta.len() as u64;
            for w in out.meta.iter() {
                let mut b = 0;
                while b < 8 {
                    self.fmeta.push((*w >> (8 * b) as u32) as u8);
                    b += 1;
                }
            }
            self.ftab.push((off, out.code.len() as u64, mo));
        }
        if self.debug {
            self.o.funcs.push(obj::FuncRange { name: out.name.clone(), off, size: out.code.len() as u64 });
            if let Some(f) = out.file {
                if out.lines.len() > 0 {
                    let fi = self.o.file_id(&f.name);
                    for (o, line) in out.lines.iter() { self.o.lines.push(obj::Line { off: off + *o, file: fi, line: *line }); }
                }
            }
        }
        for r in out.relocs.iter() {
            let id = if r.id >= 0 {
                r.id as u32
            } else if r.ph == 1 {
                strs[r.ix]
            } else if r.ph == 2 {
                locs[r.ix]
            } else {
                self.o.id_s(&r.name)
            };
            self.o.reloc_id(obj::TEXT, off as u32 + r.off, r.kind, id);
        }
    }

    /// A worker's emit_func: the function goes to outs.
    fn emit_out(&mut self, sym: &str) {
        let c = self.m.finish();
        let name = if self.cur_name.len() > 0 { self.cur_name.clone() } else { sym.to_string() };
        // (The names are shared with the machine's relocations.)
        let mut relocs: Vec<OutReloc> = Vec::with_capacity(c.relocs.len());
        for r in c.relocs.iter() {
            let (ph, ix) = placeholder_index(&r.sym);
            if ph > 0 {
                relocs.push(OutReloc { off: r.off, kind: r.kind, id: -1, ph, ix, name: r.sym });
                continue;
            }
            let id = match self.main_ids.get(&r.sym) { Some(i) => *i as i64, None => -1 };
            relocs.push(OutReloc { off: r.off, kind: r.kind, id, ph: 0, ix: 0, name: r.sym });
        }
        let meta = self.finish_meta(&c.calls);
        let out = &mut FuncOut { sym: sym.to_string(), name, code: c.code, relocs, lines: Vec::new(), meta, file: self.cur_file, strs: self.fstrs,
            locs: self.flocs, undef: self.fundef, errs: self.errs, failed: false };
        if c.err.len() > 0 {
            out.errs.push(`${sym}: ${c.err}`);
            out.failed = true;
        }
        if self.debug {
            if let Some(f) = self.cur_file {
                for (o, pos) in self.cur_lines.iter() {
                    out.lines.push((*o as u64, f.line_of(*pos)));
                }
            }
        }
        self.cur_lines = Vec::new();
        self.cur_file = None;
        self.cur_name = String::new();
        self.fstrs = Vec::new();
        self.fstr_ix = HashMap::new();
        self.flocs = Vec::new();
        self.floc_ix = HashMap::new();
        self.floc_pos = HashMap::new();
        self.fundef = Vec::new();
        self.errs = Vec::new();
        self.outs.push(out);
    }

    /// The layout of t (cached here; computed under the lock).
    fn lay_of(&mut self, t: &Type) -> &mut Layout {
        if let Some(l) = self.lays.get(&t.id) { return *l; }
        let l = self.lay.of(t);
        self.lays.insert(t.id, l);
        l
    }

    fn field_types(&mut self, t: &Type, variant: i64) -> Vec<&Type> {
        let k = (t.id as u64) << 24 | (variant + 1) as u64;
        if let Some(r) = self.ftypes.get(&k) { return *r; }
        let r = self.lay.field_types(t, variant);
        self.ftypes.insert(k, r);
        r
    }

    fn hidden_of(&mut self, t: &Type) -> Option<&Type> { self.p.info.hidden_of(t) }

    fn concrete(&mut self, i: &Inst, t: &Type) -> &Type {
        if ground(t) { return t; }
        i.concrete(self.p.info, t)
    }

    fn fn_sig_of(&mut self, d: &mut Def) -> &mut types::FnSig { self.p.info.fn_sig_of(d) }

    /// Places the machine's current function in the text section.
    fn emit_func(&mut self, sym: &str, global: bool) {
        if self.worker {
            self.emit_out(sym);
            return;
        }
        let c = self.m.finish();
        if c.err.len() > 0 {
            self.errorf(`${sym}: ${c.err}`);
            return;
        }
        let align = if self.o.arch == "amd64" { 16 } else { 4 };
        let off = self.o.define(sym, obj::TEXT, align, global);
        self.o.append(obj::TEXT, c.code.as_slice());
        if self.debug {
            let name = if self.cur_name.len() > 0 { self.cur_name.clone() } else { sym.to_string() };
            self.o.funcs.push(obj::FuncRange { name, off, size: c.code.len() as u64 });
            if let Some(f) = self.cur_file {
                if self.cur_lines.len() > 0 {
                    let fi = self.o.file_id(&f.name);
                    for (o, pos) in self.cur_lines.iter() { self.o.lines.push(obj::Line { off: off + *o as u64, file: fi, line: f.line_of(*pos) }); }
                }
            }
            self.cur_lines = Vec::new();
            self.cur_file = None;
            self.cur_name = String::new();
        }
        for r in c.relocs.iter() { self.o.reloc(obj::TEXT, off as u32 + r.off, r.kind, r.sym.as_str()); }
    }

    /// The symbol of a C function, declared undefined.
    fn extern_sym(&mut self, name: &str) -> String {
        let sym = `${self.tgt.c_prefix}${name}`;
        if self.worker { self.fundef.push(sym.clone()); } else { self.o.undefined(sym.as_str()); }
        sym
    }

    /// The symbol of a static Location.
    fn loc(&mut self, file: Option<&File>, pos: Pos) -> String {
        match file {
            Some(f) => {
                // A worker finds a location it has without formatting it.
                if self.worker {
                    let key = (self.file_number(&f.name) as u64) << 32 | pos as u64;
                    if let Some(k) = self.floc_pos.get(&key) { return self.placeholder(2, *k); }
                    let ps = f.position(pos);
                    let p = self.loc_at(ps.file.as_str(), ps.line as i64, ps.col as i64);
                    self.floc_pos.insert(key, self.flocs.len() - 1);
                    return p;
                }
                let ps = f.position(pos);
                self.loc_at(ps.file.as_str(), ps.line as i64, ps.col as i64)
            }
            None => self.loc_at("<unknown>", 0, 0),
        }
    }

    fn loc_at(&mut self, file: &str, line: i64, col: i64) -> String {
        let key = `${file}:${line}:${col}`;
        if self.worker {
            if let Some(k) = self.floc_ix.get(&key) { return self.placeholder(2, *k); }
            let k = self.flocs.len();
            self.floc_ix.insert(key, k);
            // sym: the key, for merge.
            self.flocs.push(LocData { sym: key.clone(), file: file.to_string(), line, col });
            return self.placeholder(2, k);
        }
        if let Some(s) = self.locs.get(&key) { return s.clone(); }
        let s = `_navi_loc${self.locs.len()}`;
        self.locs.insert(key, s.clone());
        self.loc_list.push(LocData { sym: s.clone(), file: file.to_string(), line, col });
        self.p.str_sym(&file.as_bytes().to_vec());
        s
    }

    fn str_sym(&mut self, s: &str) -> String { self.str_bytes(&s.as_bytes().to_vec()) }

    fn str_bytes(&mut self, b: &Vec<u8>) -> String {
        if !self.worker { return self.p.str_sym(b); }
        if let Some(k) = self.fstr_ix.get(b) { return self.placeholder(1, *k); }
        let k = self.fstrs.len();
        self.fstr_ix.insert(b.clone(), k);
        self.fstrs.push(b.clone());
        self.placeholder(1, k)
    }

    // %S<k> (kind 1) or %L<k> (2), made once for each k.
    fn placeholder(&mut self, kind: u8, k: usize) -> String {
        let mut v = if kind == 1 { self.ph_s } else { self.ph_l };
        while v.len() <= k {
            let n = v.len();
            v.push(if kind == 1 { `%S${n}` } else { `%L${n}` });
        }
        v[k]
    }

    fn file_number(&mut self, name: &String) -> u32 {
        if let Some(n) = self.file_no.get(name) { return *n; }
        let n = self.file_no.len() as u32;
        self.file_no.insert(name.clone(), n);
        n
    }

    // The symbol of a file's name (as str_sym), found once per file.
    fn file_name_sym(&mut self, name: &String) -> String {
        if !self.worker {
            if let Some(s) = self.file_sym.get(name) { return *s; }
            let s = self.str_sym(name.as_str());
            self.file_sym.insert(name.clone(), s);
            return s;
        }
        self.str_sym(name.as_str())
    }

    // The stack map of the function just made: its frame part (stack_meta)
    // and each call's return offset and saved-register pointer mask.
    fn finish_meta(&mut self, calls: &Vec<u64>) -> Vec<u64> {
        let mut fm = self.cur_meta;
        self.cur_meta = Vec::new();
        if fm.len() == 0 { return fm; }
        let conservative = fm[1] & 1 != 0;
        // Each call: (return offset / 4) << 9 | mask, two in a word.
        fm.push(calls.len() as u64);
        let mut half = 0u64;
        let mut ci = 0;
        while ci < calls.len() {
            let c = calls[ci];
            let ret = c >> 32;
            let tag = (c & 0xffffffff) as i64 - 1;
            let mask = if conservative || tag < 0 || tag as usize >= self.cur_masks.len() { self.cur_all } else { self.cur_masks[tag as usize] as u64 };
            let e = (ret / 4) << 9 | mask;
            if ci % 2 == 0 { half = e; } else { fm.push(half | e << 32); }
            ci += 1;
        }
        if calls.len() % 2 == 1 { fm.push(half); }
        fm
    }

    /// Writes strings, locations, dictionaries, vtables and statics.
    fn gen_data(&mut self) {
        // The stack maps by code address: [count, the text's start, where
        // the maps start (from the table), then for each function by
        // address its offset in the text, size and map offset (u32 each)],
        // then the maps.
        let off = self.o.define("_navi_ftab", obj::DATA_CONST, 8, false);
        let mut t: Vec<u8> = Vec::new();
        let n = self.ftab.len();
        let mut b = 0;
        while b < 24 {
            t.push(if b < 8 { ((n as u64) >> (8 * b) as u32) as u8 } else { 0 });
            b += 1;
        }
        for e in self.ftab.iter() {
            let (fo, size, mo) = *e;
            for v in [fo, size, mo].iter() {
                let mut k = 0;
                while k < 4 {
                    t.push((*v >> (8 * k) as u32) as u8);
                    k += 1;
                }
            }
        }
        while t.len() % 8 != 0 { t.push(0); }
        let moff = t.len() as u64;
        let mut b2 = 0;
        while b2 < 8 {
            t[16 + b2] = (moff >> (8 * b2) as u32) as u8;
            b2 += 1;
        }
        self.o.append(obj::DATA_CONST, t.as_slice());
        self.o.append(obj::DATA_CONST, self.fmeta.as_slice());
        self.o.reloc(obj::DATA_CONST, (off + 8) as u32, obj::ABS64, "_navi_text0");
        // Locations: { file: &str, line: u32, col: u32 }.
        let loc_def = self.p.info.lang_def("Location").unwrap();
        let loc_ty = self.p.info.ctx.adt(loc_def, Vec::new());
        let ll = self.lay.of(loc_ty);
        let mut li = 0;
        while li < self.loc_list.len() {
            let l = &self.loc_list[li];
            let off = self.o.define(l.sym.as_str(), obj::DATA_CONST, 8, false);
            let mut buf = zeros(ll.size);
            put_u64(&mut buf, (ll.fields[0] + 8) as usize, l.file.len() as u64);
            put_u32(&mut buf, ll.fields[1] as usize, l.line as u32);
            put_u32(&mut buf, ll.fields[2] as usize, l.col as u32);
            self.o.append(obj::DATA_CONST, buf.as_slice());
            let fs = self.p.str_sym(&l.file.as_bytes().to_vec());
            self.o.reloc(obj::DATA_CONST, (off + ll.fields[0] as u64) as u32, obj::ABS64, fs.as_str());
            li += 1;
        }
        // Dictionaries: [code, ctx] per slot (vtables: [vtable, 0]).
        for grp in self.p.groups.iter() {
            for inst in grp.insts.iter() {
                let off = self.o.define(inst.dict.as_str(), obj::DATA_CONST, 8, false);
                let n = grp.nslots as i64;
                if n == 0 {
                    self.o.zeros(obj::DATA_CONST, 8);
                    continue;
                }
                self.o.zeros(obj::DATA_CONST, 16 * n);
                let entries = self.p.dict_entries(*inst);
                let mut i = 0;
                while i < entries.len() {
                    let at = off as u32 + (16 * i) as u32;
                    match &entries[i] {
                        DictEntry::Target(t) => self.target_words(at, *t),
                        DictEntry::Vtable(v) => self.o.reloc(obj::DATA_CONST, at, obj::ABS64, v.sym.as_str()),
                    }
                    i += 1;
                }
            }
        }
        // Vtables: [code, ctx] per dyn method.
        let mut vts: Vec<&mut Vtable> = self.p.vtable_list.clone();
        vts.sort_by(|a, b| a.sym.cmp(&b.sym));
        for v in vts.iter() {
            let off = self.o.define(v.sym.as_str(), obj::DATA_CONST, 8, false);
            self.o.zeros(obj::DATA_CONST, 16 * v.methods.len() as i64 + 8);
            let mut i = 0;
            while i < v.methods.len() {
                self.target_words(off as u32 + (16 * i) as u32, v.methods[i]);
                i += 1;
            }
        }
        // Writable data: the stack top, then the statics (zero-initialized;
        // the entry point runs their initializers). The collector scans from
        // _navi_data_start to _navi_data_end.
        self.o.define("_navi_data_start", obj::DATA, 8, false);
        for sym in ["_navi_stack_top", "_navi_stack_lo", "_navi_os_sp", "_navi_argc", "_navi_argv", "_navi_saved_greg", "_navi_gc_marking"].iter() {
            self.o.define(*sym, obj::DATA, 8, false);
            self.o.zeros(obj::DATA, 8);
        }
        // The G record in use before the scheduler starts (no stack limit).
        self.o.define("_navi_g0boot", obj::DATA, 16, false);
        self.o.zeros(obj::DATA, 512);
        for d in self.p.statics.iter() {
            let ty = self.p.info.consts[&d.id].ty;
            let l = self.lay.of(ty);
            let size = if l.size > 0 { l.size } else { 8 };
            let sym = self.statics[&d.id].clone();
            self.o.define(sym.as_str(), obj::DATA, 8, false);
            self.o.zeros(obj::DATA, size);
        }
        self.o.define("_navi_data_end", obj::DATA, 8, false);
        self.o.zeros(obj::DATA, 8);
        // Strings last: code generation adds file names.
        let mut strs: Vec<(String, Vec<u8>)> = Vec::new();
        for s in self.p.string_list.iter() { strs.push((self.p.strings[s].clone(), s.clone())); }
        strs.sort_by(|a, b| a.0.cmp(&b.0));
        for s in strs.iter() {
            self.o.define(s.0.as_str(), obj::RO_DATA, 1, false);
            self.o.append(obj::RO_DATA, s.1.as_slice());
            self.o.zeros(obj::RO_DATA, 1);
        }
    }

    fn target_words(&mut self, at: u32, t: &Target) {
        match t.kind {
            codegen::T_INST => {
                let i = t.inst.unwrap();
                self.o.reloc(obj::DATA_CONST, at, obj::ABS64, i.grp().sym.as_str());
                self.o.reloc(obj::DATA_CONST, at + 8, obj::ABS64, i.dict.as_str());
            }
            codegen::T_INTRINSIC => {
                if t.intrinsic == "extern" {
                    let s = self.extern_sym(link_name(t.def).as_str());
                    self.o.reloc(obj::DATA_CONST, at, obj::ABS64, s.as_str());
                } else if t.intrinsic != "unreachable" {
                    self.errorf(`intrinsic ${t.intrinsic} cannot be called dynamically`);
                }
            }
            _ => {
                self.errorf("virtual call target in a dictionary".to_string());
            }
        }
    }

    /// Writes the C entry point: record the stack top, initialize the
    /// statics, call main, return 0.
    fn gen_main(&mut self) {
        let m = self.m;
        m.begin();
        let main = self.p.main.unwrap();
        let mut ret_size = 32i64;
        let mt = main.concrete(self.p.info, main.func.locals[0].ty);
        let s = self.size_of(Some(mt));
        if s > ret_size { ret_size = s; }
        let frame = (ret_size + 15) & !15;
        m.entry_prologue(frame);
        // The G register (callee-saved in C: kept for our caller) points to
        // a blank G record until the scheduler starts.
        m.adr_sym(I1, &"_navi_saved_greg".to_string());
        m.store(8, GREG, I1, 0);
        m.adr_sym(GREG, &"_navi_g0boot".to_string());
        m.adr_sym(I1, &"_navi_stack_top".to_string());
        m.store(8, FP, I1, 0);
        let main_loc = self.loc_at("<main>", 0, 0);
        // Keep argc and argv for std::rt::native::set_args (called after the
        // statics are initialized).
        m.entry_args();
        m.load(8, V1, SP, 0);
        m.adr_sym(I1, &"_navi_argc".to_string());
        m.store(8, V1, I1, 0);
        m.load(8, V1, SP, 8);
        m.adr_sym(I1, &"_navi_argv".to_string());
        m.store(8, V1, I1, 0);
        for d in self.p.statics.iter() {
            let inst = match self.p.static_init.get(&d.id) { Some(i) => *i, None => continue };
            m.adr_sym(RET, &self.statics[&d.id]);
            m.adr_sym(LOC, &main_loc);
            m.adr_sym(CTX, &inst.dict);
            m.call(&inst.grp().sym);
        }
        let set_args = self.p.runtime[&"set_args".to_string()];
        m.adr_sym(I1, &"_navi_argc".to_string());
        m.load(8, V1, I1, 0);
        m.store(8, V1, SP, 0);
        m.adr_sym(I1, &"_navi_argv".to_string());
        m.load(8, V1, I1, 0);
        m.store(8, V1, SP, 8);
        m.addr_of(RET, SP, 16);
        m.adr_sym(LOC, &main_loc);
        m.adr_sym(CTX, &set_args.dict);
        m.call(&set_args.grp().sym);
        // Create the main green thread and continue on its stack.
        let init = self.p.runtime[&"sched_init".to_string()];
        m.addr_of(RET, SP, 0);
        m.adr_sym(LOC, &main_loc);
        m.adr_sym(CTX, &init.dict);
        m.call(&init.grp().sym);
        m.load(8, V1, SP, 0);
        m.adr_sym(I1, &"_navi_os_sp".to_string());
        m.mov(I2, SP);
        m.store(8, I2, I1, 0);
        m.mov(SP, V1);
        m.add_imm(SP, -frame);
        m.addr_of(RET, SP, 0);
        m.adr_sym(LOC, &main_loc);
        m.adr_sym(CTX, &main.dict);
        m.call(&main.grp().sym);
        // The main G may finish on another OS thread: exit from here.
        m.mov_imm(V1, 0);
        m.store(8, V1, SP, 0);
        let es = self.extern_sym("exit");
        let mut a1 = Vec::new();
        a1.push(int_arg());
        m.call_c(es.as_str(), 0, &a1, false, false);
        m.trap();
        let name = `${self.tgt.c_prefix}main`;
        self.emit_func(name.as_str(), true);
    }

    /// Writes the scheduler's routines: the context switch, the start of a
    /// new green thread and the stack overflow handler.
    fn gen_sched(&mut self) {
        let m = self.m;
        let rt_loc = self.loc_at("<runtime>", 0, 0);
        let ms = self.p.runtime[&"morestack".to_string()];
        m.begin();
        m.morestack(ms.grp().sym.as_str(), ms.dict.as_str(), rt_loc.as_str());
        self.emit_func("_navi_morestack", false);

        let mst = self.p.runtime[&"mstart".to_string()];
        m.begin();
        m.mstart(mst.grp().sym.as_str(), mst.dict.as_str(), rt_loc.as_str());
        self.emit_func("_navi_mstart", false);

        m.begin();
        m.swap_context();
        self.emit_func("_navi_swapctx", false);

        m.begin();
        m.scan_words();
        self.emit_func("_navi_scanw", false);

        m.begin();
        m.set_jmp();
        self.emit_func("_navi_setjmp", false);

        m.begin();
        m.long_jmp();
        self.emit_func("_navi_longjmp", false);

        m.begin();
        let gm = self.p.runtime[&"gmain".to_string()];
        m.add_imm(SP, -32);
        m.addr_of(RET, SP, 0);
        let tl = self.loc_at("<thread>", 0, 0);
        m.adr_sym(LOC, &tl);
        m.adr_sym(CTX, &gm.dict);
        m.call(&gm.grp().sym);
        m.trap();
        self.emit_func("_navi_gstart", false);

        m.begin();
        m.prologue(32);
        let msg = "fatal error: stack overflow\n";
        m.mov_imm(V1, 2);
        m.store(8, V1, SP, 0);
        let ms = self.str_sym(msg);
        m.adr_sym(V1, &ms);
        m.store(8, V1, SP, 8);
        m.mov_imm(V1, msg.len() as i64);
        m.store(8, V1, SP, 16);
        let w = self.tgt.write.clone();
        let ws = self.extern_sym(w.as_str());
        let mut a3 = Vec::new();
        a3.push(int_arg());
        a3.push(int_arg());
        a3.push(int_arg());
        m.call_c(ws.as_str(), 0, &a3, false, false);
        m.mov_imm(V1, 2);
        m.store(8, V1, SP, 0);
        let es = self.extern_sym("exit");
        let mut a1 = Vec::new();
        a1.push(int_arg());
        m.call_c(es.as_str(), 0, &a1, false, false);
        m.trap();
        self.emit_func("_navi_overflow", false);
    }

    /// Writes _navi_rundefers(CTX = list head).
    fn gen_run_defers(&mut self) {
        self.m.begin();
        self.m.run_defers();
        self.emit_func("_navi_rundefers", false);
    }

    fn size_of(&mut self, t: Option<&Type>) -> i64 {
        let ty = match t { Some(x) => x, None => return 0 };
        if ty.kind == types::K_NEVER { return 0; }
        let l = self.lay_of(ty);
        if l.unsized {
            self.errorf(`size of unsized type ${ty}`);
            return 0;
        }
        l.size
    }

    /// The symbol of a closure of grp (numbered by generate).
    fn closure_sym(&mut self, grp: &Group, f: &Func) -> String {
        let k = `${grp.sym}/${f.id}`;
        match self.closure.get(&k) {
            Some(s) => s.clone(),
            None => {
                self.errorf(`no symbol for closure ${k}`);
                String::new()
            }
        }
    }

    fn gen_func(&mut self, grp: &mut Group, f: &mut Func, sym: String) {
        self.m.begin();
        self.cur_lines = Vec::new();
        self.cur_file = f.file;
        self.cur_name = f.name.clone();
        if self.debug {
            if let Some(d) = f.def { self.cur_lines.push((0, d.pos)); }
        }
        let fg = &mut FnGen { g: self, m: self.m, grp, inst: grp.rep, f, ltypes: Vec::new(), loff: Vec::new(), blocks: Vec::new(),
            res_off: 0, tmp_off: 0, stubs: HashMap::new(), stub_list: Vec::new(), preg: Vec::new(), saved: Vec::new(), concs: HashMap::new(),
            frame: 0, buf_top: 0 };
        fg.gen();
        fg.stack_meta();
        self.emit_func(sym.as_str(), false);
    }
}

fn collect_closures(f: &Func, todo: &mut Vec<&mut Func>) {
    for b in f.blocks.iter() {
        for s in b.stmts.iter() {
            if let Stmt::Assign { rv, .. } = s {
                if let Rvalue::Aggregate { closure, .. } = rv {
                    if let Some(c) = closure {
                        todo.push(*c);
                        collect_closures(*c, todo);
                    }
                }
            }
        }
    }
}

/// Out-of-line code emitted after the function body.
enum Stub {
    /// The stack check's slow path (then the check again).
    Overflow(Label, Label, i64),
    /// A panic with a message at a position.
    Panic { label: Label, msg: String, pos: Pos },
}

/// Generates one function body.
struct FnGen {
    g: &mut Gen,
    m: &mut dyn Machine,
    grp: &mut Group,
    inst: &mut Inst,
    f: &mut Func,
    ltypes: Vec<&Type>,
    /// FP-relative offsets of locals.
    loff: Vec<i64>,
    blocks: Vec<Label>,
    /// The call result buffer.
    res_off: i64,
    /// The staging buffer.
    tmp_off: i64,
    stubs: HashMap<String, Label>,
    stub_list: Vec<Stub>,
    /// The register of each local kept in one (-1: in the frame).
    preg: Vec<i64>,
    /// The saved registers used, with their save slots.
    saved: Vec<(Reg, i64)>,
    /// conc's results, by type id.
    concs: HashMap<u32, &Type>,
    /// The frame's size, and where (from FP) the saved registers end: below
    /// are the buffers and the outgoing area (any word may be a pointer).
    frame: i64,
    buf_top: i64,
}

fn is_signed(t: &Type) -> bool { t.kind == types::K_INT && types::int_signed(t.int) }

impl FnGen {
    fn conc(&mut self, t: &Type) -> &Type {
        if let Some(c) = self.concs.get(&t.id) { return *c; }
        let mut c = self.g.concrete(self.inst, t);
        if c.kind == types::K_OPAQUE {
            if let Some(h) = self.g.hidden_of(c) { c = self.conc(h); }
        }
        self.concs.insert(t.id, c);
        c
    }

    fn conc_opt(&mut self, t: Option<&Type>) -> Option<&Type> {
        match t { Some(x) => Some(self.conc(x)), None => None }
    }

    fn size(&mut self, t: &Type) -> i64 { self.g.size_of(Some(t)) }

    /// The first local passed on the stack (closures receive the
    /// environment in CTX).
    fn first_arg(&self) -> usize { if self.f.closure { 2 } else { 1 } }

    fn gen(&mut self) {
        let m = self.m;
        let f = self.f;
        m.set_tag(0);
        let n = f.locals.len();
        let mut i = 0;
        while i < n {
            let t = self.conc(f.locals[i].ty);
            self.ltypes.push(t);
            self.loff.push(0);
            i += 1;
        }
        // Incoming arguments.
        let mut off = 16i64;
        i = self.first_arg();
        while i <= f.nargs {
            self.loff[i] = off;
            off += round8(self.size(self.ltypes[i]));
            i += 1;
        }
        // Frame locals.
        let mut cur = FIXED_FRAME;
        i = 0;
        while i < n {
            if i >= self.first_arg() && i <= f.nargs {
                i += 1;
                continue;
            }
            let t = self.ltypes[i];
            let mut size = 0i64;
            let mut align = 1i64;
            if t.kind != types::K_NEVER {
                let l = self.g.lay_of(t);
                size = l.size;
                align = l.align;
            }
            if size == 0 { size = 1; }
            if align < 1 { align = 1; }
            cur = (cur + size + align - 1) / align * align;
            self.loff[i] = -cur;
            i += 1;
        }
        // Registers for the most used scalar locals.
        self.choose_registers();
        // Save slots are 8-byte aligned: the collector scans aligned words.
        cur = (cur + 7) / 8 * 8;
        let mut k = 0;
        while k < self.saved.len() {
            cur += 8;
            self.saved[k].1 = -cur;
            k += 1;
        }
        // Buffers and the outgoing argument area.
        let mut max_res = 16i64;
        let mut max_tmp = 16i64;
        let mut max_out = 48i64;
        for b in f.blocks.iter() {
            for s in b.stmts.iter() {
                if let Stmt::Assign { place, .. } = s {
                    // Aggregates and large copies are staged in the buffer.
                    let pt = self.place_type(place);
                    let sz = self.size(pt);
                    if sz > max_tmp { max_tmp = sz; }
                }
            }
            if let Term::Call { args, dest, .. } = &b.term {
                let dt = self.place_type(dest);
                let sz = self.size(dt);
                if sz > max_res { max_res = sz; }
                let mut na = 0i64;
                for a in args.iter() {
                    let at = self.operand_type(a);
                    na += round8(self.size(at));
                }
                if na > max_out { max_out = na; }
            }
        }
        self.buf_top = -cur;
        cur = (cur + max_res + 7) / 8 * 8;
        self.res_off = -cur;
        cur = (cur + max_tmp + 7) / 8 * 8;
        self.tmp_off = -cur;
        let frame = ((cur + 15) & !15) + ((max_out + 15) & !15);
        self.frame = frame;

        // The stack check, before the frame is made: the stack must reach
        // the frame (and the saved FP and LR) above the limit, the first
        // word of the running G. A collector stopping the world sets the
        // limit to the maximum. morestack grows the stack (copying it), stops
        // the G for the collector or fails; the function then goes on (a G
        // that may not stop yet keeps its poisoned limit and passes here).
        let overflow = m.new_label();
        let resume = m.new_label();
        let need = frame + 16;
        m.load(8, I1, GREG, 0);
        m.mov(I2, SP);
        m.add_imm(I2, -need);
        m.cmp(I2, I1);
        m.branch_if(LTU, overflow);
        m.bind(resume);
        self.stub_list.push(Stub::Overflow(overflow, resume, need));
        m.prologue(frame);
        for sv in self.saved.iter() { m.store(8, sv.0, FP, sv.1); }
        if f.closure {
            if self.preg[1] >= 0 { m.mov(self.preg[1] as Reg, CTX); } else { m.store(8, CTX, FP, self.loff[1]); }
            m.load(8, I1, CTX, -8);
            m.store(8, I1, FP, SLOT_CTX);
        } else {
            m.store(8, CTX, FP, SLOT_CTX);
        }
        // Promoted arguments.
        let mut ai = self.first_arg();
        while ai <= f.nargs {
            if self.preg[ai] >= 0 {
                let sz = self.size(self.ltypes[ai]);
                m.load(sz, self.preg[ai] as Reg, FP, self.loff[ai]);
            }
            ai += 1;
        }
        m.store(8, RET, FP, SLOT_RET);
        m.store(8, LOC, FP, SLOT_LOC);
        m.store_zero(8, FP, SLOT_DEFERS);

        i = 0;
        while i < f.blocks.len() {
            self.blocks.push(m.new_label());
            i += 1;
        }
        let refs = local_refs(f);
        let mut pos = 1i64;
        let mut bi = 0;
        while bi < f.blocks.len() {
            m.bind(self.blocks[bi]);
            let b = f.blocks[bi];
            // A block ending in a comparison only its switch reads compares
            // and branches (the bool is not made).
            let fused = fused_compare(b, &refs);
            let mut si = 0;
            let n = if fused { b.stmts.len() - 1 } else { b.stmts.len() };
            while si < n {
                if self.g.debug { self.note_line(stmt_pos(&b.stmts[si])); }
                // Calls are tagged with their position (as choose_registers
                // counts: from 1, statements then the terminator).
                m.set_tag(pos);
                self.stmt(bi, si, &b.stmts[si]);
                si += 1;
                pos += 1;
            }
            if fused {
                if self.g.debug { self.note_line(stmt_pos(&b.stmts[n])); }
                m.set_tag(pos);
                self.compare_branch(bi, &b.stmts[n], &b.term);
                pos += 2;
                bi += 1;
                continue;
            }
            if self.g.debug { self.note_line(term_pos(&b.term)); }
            m.set_tag(pos);
            self.term(bi, &b.term);
            pos += 1;
            bi += 1;
        }
        let mut k = 0;
        while k < self.stub_list.len() {
            match &self.stub_list[k] {
                Stub::Overflow(l, resume, need) => {
                    m.bind(*l);
                    m.set_tag(0);
                    // The bytes needed (the G's third word).
                    m.mov_imm(I1, *need);
                    m.store(8, I1, GREG, 16);
                    m.call_morestack();
                    m.jump(*resume);
                }
                Stub::Panic { label, msg, pos } => {
                    m.bind(*label);
                    m.set_tag(-1);
                    let ms = msg.clone();
                    self.call_panic(ms.as_str(), *pos);
                }
            }
            k += 1;
        }
    }

    // --- Places ------------------------------------------------------------------

    fn local_addr(&mut self, r: Reg, l: usize) { self.m.addr_of(r, FP, self.loff[l]); }

    /// The register holding local l as a whole value, if promoted.
    fn promoted(&self, pl: &Place) -> Option<Reg> {
        if pl.proj.len() == 0 && self.preg[pl.local] >= 0 { return Some(self.preg[pl.local] as Reg); }
        None
    }


    /// The function's stack map (for moving stacks; Go's stack maps, with
    /// the saved registers): [frame size, flags (1: any word or register
    /// may be a pointer: the runtime, which keeps addresses in integers; 2:
    /// std, scanned conservatively by the collector),
    /// the number of words from SP that may all hold pointers (the buffers
    /// and the outgoing area), the length of a bitmap of the words above
    /// them that may, the bitmap, then the number of saved registers and
    /// for each its index (x19 + k) << 32 | its FP offset]. The calls are
    /// added by finish_meta, with masks of the saved registers holding
    /// pointers at each position (cur_masks).
    fn stack_meta(&mut self) {
        let frame = self.frame;
        let nw = frame / 8;
        let rt = match self.f.def {
            Some(d) => crate::mir::inline::in_runtime(d),
            None => match self.f.owner { Some(d) => crate::mir::inline::in_runtime(d), None => false },
        };
        let any = if rt { nw } else { (frame + self.buf_top) / 8 };
        let mut bits: Vec<u64> = Vec::new();
        let mut k = 0;
        while k < (nw - any + 63) / 64 {
            bits.push(0);
            k += 1;
        }
        if !rt {
            let mut set = |off: i64| {
                let w = frame + off;
                if w >= 0 && w < frame && w % 8 == 0 && w / 8 >= any {
                    let i = (w / 8 - any) as usize;
                    bits[i / 64] = bits[i / 64] | 1u64 << (i % 64) as u32;
                }
            };
            set(SLOT_CTX);
            set(SLOT_RET);
            set(SLOT_LOC);
            set(SLOT_DEFERS);
            let n = self.f.locals.len();
            let mut i = 0;
            while i < n {
                if self.loff[i] < 0 {
                    let t = self.ltypes[i];
                    if t.kind != types::K_NEVER {
                        let l = self.g.lay_of(t);
                        for p in l.ptrs.iter() { set(self.loff[i] + *p); }
                    }
                }
                i += 1;
            }
        }
        let mut meta = self.g.cur_meta;
        meta.clear();
        // Flag 2: std code, whose integers may hold the only address of a
        // heap object: the collector scans it conservatively.
        let in_std = match self.f.def {
            Some(d) => d.krate.is_std,
            None => match self.f.owner { Some(d) => d.krate.is_std, None => true },
        };
        meta.push(frame as u64);
        meta.push((if rt { 1 } else { 0 }) | (if in_std { 2 } else { 0 }));
        meta.push(any as u64);
        meta.push(bits.len() as u64);
        for b in bits.iter() { meta.push(*b); }
        meta.push(self.saved.len() as u64);
        let mut all = 0u64;
        for sv in self.saved.iter() {
            let k = (sv.0 - S0) as u64;
            all = all | 1u64 << k as u32;
            meta.push(k << 32 | (sv.1 as u64 & 0xffffffff));
        }
        self.g.cur_all = all;
        // Masks by position: the saved registers holding a live pointer
        // (a local's range covers the position).
        let lv = self.g.live;
        let mut maxp = 0i64;
        let n = self.f.locals.len();
        let mut i = 0;
        while i < n {
            if self.preg[i] >= 0 && lv.hi[i] > maxp { maxp = lv.hi[i]; }
            i += 1;
        }
        let mut masks = self.g.cur_masks;
        masks.clear();
        let mut p = 0;
        while p <= maxp + 2 {
            masks.push(0);
            p += 1;
        }
        i = 0;
        while i < n {
            let t = self.ltypes[i];
            if self.preg[i] >= 0 && (t.kind == types::K_REF || t.kind == types::K_PTR) {
                let bit = 1u16 << (self.preg[i] - S0 as i64) as u32;
                let mut q = lv.lo[i];
                while q <= lv.hi[i] {
                    if q >= 0 { masks[q as usize] = masks[q as usize] | bit; }
                    q += 1;
                }
            }
            i += 1;
        }
        self.g.cur_meta = meta;
        self.g.cur_masks = masks;
    }

    /// Gives scalar locals (used whole, or as pointers to dereference) the
    /// saved registers by linear scan over their live ranges: locals whose
    /// ranges do not overlap share a register (calls preserve them). A
    /// range runs from the first to the last position the local is live
    /// at, in block order, with liveness from the blocks' data flow.
    fn choose_registers(&mut self) {
        let f = self.f;
        let n = f.locals.len();
        let nb = f.blocks.len();
        let words = (n + 63) / 64;
        let lv = self.g.live;
        lv.words = words;
        lv.b = 0;
        lv.pos = 0;
        lv.lo.clear();
        lv.hi.clear();
        lv.bad.clear();
        let mut i = 0;
        while i < n {
            self.preg.push(-1);
            let t = self.ltypes[i];
            let k = t.kind;
            let scalar = k == types::K_INT && layout::int_size(t.int) <= 8 || k == types::K_BOOL || k == types::K_CHAR || k == types::K_FLOAT
                || (k == types::K_REF || k == types::K_PTR) && !layout::is_fat(t.el()) || k == types::K_FN && t.abi == "C";
            lv.lo.push(-1);
            lv.hi.push(-1);
            lv.bad.push(!scalar);
            i += 1;
        }
        lv.gen.clear();
        lv.kill.clear();
        lv.live_in.clear();
        lv.live_out.clear();
        i = 0;
        while i < nb * words {
            lv.gen.push(0);
            lv.kill.push(0);
            lv.live_in.push(0);
            lv.live_out.push(0);
            i += 1;
        }
        // Position 0: the entry, where the arguments arrive.
        i = 1;
        while i <= f.nargs && i < n {
            lv.touch(i);
            i += 1;
        }
        // Per block: its first and last positions, and its successors
        // (succ[succ_at[b]..succ_at[b + 1]]).
        let mut starts = lv.starts;
        let mut ends = lv.ends;
        let mut succ = lv.succ;
        let mut succ_at = lv.succ_at;
        starts.clear();
        ends.clear();
        succ.clear();
        succ_at.clear();
        let mut pos = 1i64;
        let mut bi = 0;
        while bi < nb {
            let b = f.blocks[bi];
            lv.b = bi;
            starts.push(pos);
            for st in b.stmts.iter() {
                lv.pos = pos;
                match st {
                    Stmt::Assign { place, rv } => {
                        match rv {
                            Rvalue::Use(x) => lv.op(x),
                            Rvalue::Ref { place: p, .. } => lv.place(p, true, false),
                            Rvalue::Bin { x, y, .. } => {
                                lv.op(x);
                                lv.op(y);
                            }
                            Rvalue::Un { x, .. } | Rvalue::Cast { x, .. } | Rvalue::Unsize { x, .. } | Rvalue::MakeDyn { x, .. } => lv.op(x),
                            Rvalue::Aggregate { ops, .. } => { for o in ops.iter() { lv.op(o); } }
                            Rvalue::Discr(p) | Rvalue::Len(p) => lv.place(p, true, false),
                        }
                        lv.place(place, false, true);
                    }
                    Stmt::SetDiscr { place, .. } => lv.place(place, true, false),
                    Stmt::Box { local, .. } => lv.def(*local),
                    Stmt::PushDefer { fn_op, args } => {
                        lv.op(fn_op);
                        for a in args.iter() { lv.op(a); }
                    }
                    _ => {}
                }
                pos += 1;
            }
            lv.pos = pos;
            succ_at.push(succ.len());
            match &b.term {
                Term::Goto(t) => succ.push(*t),
                Term::Switch { x, targets, els, .. } => {
                    lv.op(x);
                    for t in targets.iter() { succ.push(*t); }
                    succ.push(*els);
                }
                Term::Call { fn_op, args, dest, target, .. } => {
                    lv.op(fn_op);
                    for a in args.iter() { lv.op(a); }
                    lv.place(dest, false, true);
                    if *target >= 0 { succ.push(*target as usize); }
                }
                Term::Assert { cond, len, index, target, .. } => {
                    lv.op(cond);
                    lv.op(len);
                    lv.op(index);
                    succ.push(*target);
                }
                Term::Return => lv.use_(0),
                _ => {}
            }
            ends.push(pos);
            pos += 1;
            bi += 1;
        }
        succ_at.push(succ.len());
        // Liveness: in = gen | (out & !kill), out = the successors' ins.
        let mut live_in = lv.live_in;
        let mut live_out = lv.live_out;
        let mut changed = true;
        while changed {
            changed = false;
            let mut bj = nb;
            while bj > 0 {
                bj -= 1;
                let o = bj * words;
                let mut w = 0;
                while w < words {
                    let mut out = 0u64;
                    let mut si = succ_at[bj];
                    while si < succ_at[bj + 1] {
                        out = out | live_in[succ[si] * words + w];
                        si += 1;
                    }
                    live_out[o + w] = out;
                    let inn = lv.gen[o + w] | (out & !lv.kill[o + w]);
                    if inn != live_in[o + w] {
                        live_in[o + w] = inn;
                        changed = true;
                    }
                    w += 1;
                }
            }
        }
        bi = 0;
        while bi < nb {
            let o = bi * words;
            let mut w = 0;
            while w < words {
                // Only the set bits (most words are 0).
                let mut bits = live_in[o + w];
                let mut l = w * 64;
                while bits != 0 {
                    if bits & 1 != 0 { lv.touch_at(l, starts[bi]); }
                    bits = bits >> 1;
                    l += 1;
                }
                bits = live_out[o + w];
                l = w * 64;
                while bits != 0 {
                    if bits & 1 != 0 { lv.touch_at(l, ends[bi]); }
                    bits = bits >> 1;
                    l += 1;
                }
                w += 1;
            }
            bi += 1;
        }
        // Linear scan by start; out of registers, the range ending last
        // stays in memory.
        let mut order = lv.order;
        order.clear();
        i = 0;
        while i < n {
            if !lv.bad[i] && lv.lo[i] >= 0 { order.push(i); }
            i += 1;
        }
        order.sort_by(|a, b| if lv.lo[*a] != lv.lo[*b] { lv.lo[*a].cmp(&lv.lo[*b]) } else { a.cmp(b) });
        let mut active = lv.active;
        active.clear();
        let mut free: Vec<Reg> = Vec::new();
        let mut used = [false; 9];
        let mut r = NUM_SAVED;
        while r > 0 {
            r -= 1;
            free.push(S0 + r as Reg);
        }
        for l in order.iter() {
            let cur = *l;
            // Ranges that ended before this one starts give their registers back.
            let mut j = 0;
            let mut kept = 0;
            while j < active.len() {
                let a = active[j];
                if lv.hi[a] < lv.lo[cur] {
                    free.push(self.preg[a] as Reg);
                } else {
                    active[kept] = a;
                    kept += 1;
                }
                j += 1;
            }
            active.truncate(kept);
            if free.len() > 0 {
                let reg = free.pop().unwrap();
                self.preg[cur] = reg as i64;
                used[(reg - S0) as usize] = true;
                active.push(cur);
                continue;
            }
            let mut far = 0;
            let mut j = 1;
            while j < active.len() {
                if lv.hi[active[j]] > lv.hi[active[far]] { far = j; }
                j += 1;
            }
            let victim = active[far];
            if lv.hi[victim] > lv.hi[cur] {
                self.preg[cur] = self.preg[victim];
                self.preg[victim] = -1;
                active[far] = cur;
            }
        }
        let mut k = 0;
        while k < NUM_SAVED {
            if used[k] { self.saved.push((S0 + k as Reg, 0)); }
            k += 1;
        }
    }

    fn field_of(&mut self, ty: &Type, variant: i64, field: usize) -> (i64, &Type) {
        let l = self.g.lay_of(ty);
        if ty.kind == types::K_TUPLE { return (l.fields[field], ty.elems[field]); }
        if ty.kind == types::K_ADT {
            if variant >= 0 {
                let ft = self.g.field_types(ty, variant)[field];
                return (l.variants[variant as usize][field], self.reveal(ft));
            }
            let ft = self.g.field_types(ty, -1)[field];
            return (l.fields[field], self.reveal(ft));
        }
        self.g.errorf(`${self.f.name}: field of ${ty}`);
        (0, ty)
    }

    fn reveal(&mut self, t: &Type) -> &Type {
        if t.kind == types::K_OPAQUE {
            if let Some(h) = self.g.hidden_of(t) { return self.conc(h); }
        }
        t
    }

    /// The type of a place (no code).
    fn place_type(&mut self, pl: &Place) -> &Type {
        let mut ty = self.ltypes[pl.local];
        let mut variant = -1i64;
        for pr in pl.proj.iter() {
            match pr.kind {
                mir::P_DEREF => {
                    ty = self.reveal(ty.el());
                    variant = -1;
                }
                mir::P_DOWNCAST => {
                    variant = pr.variant as i64;
                }
                mir::P_FIELD => {
                    let (_, ft) = self.field_of(ty, variant, pr.field);
                    ty = ft;
                    variant = -1;
                }
                _ => {
                    ty = self.reveal(ty.el());
                }
            }
        }
        ty
    }

    /// The address of a place as base register plus offset (base is FP or
    /// RA), and its type; the metadata of an unsized place is left in RM.
    /// Clobbers RA, I1, I2.
    fn place_addr(&mut self, pl: &Place) -> (Reg, i64, &Type) {
        let m = self.m;
        let mut base = FP;
        let mut off = self.loff[pl.local];
        let mut ty = self.ltypes[pl.local];
        let mut variant = -1i64;
        let mut first = true;
        for pr in pl.proj.iter() {
            if first && self.preg[pl.local] >= 0 {
                // A promoted pointer: its register is the base.
                first = false;
                base = self.preg[pl.local] as Reg;
                off = 0;
                ty = self.reveal(ty.el());
                continue;
            }
            first = false;
            match pr.kind {
                mir::P_DEREF => {
                    let elem = self.reveal(ty.el());
                    if layout::is_fat(elem) { m.load(8, RM, base, off + 8); }
                    m.load(8, RA, base, off);
                    base = RA;
                    off = 0;
                    ty = elem;
                    variant = -1;
                }
                mir::P_DOWNCAST => {
                    variant = pr.variant as i64;
                }
                mir::P_FIELD => {
                    let (foff, ft) = self.field_of(ty, variant, pr.field);
                    ty = ft;
                    variant = -1;
                    off += foff;
                }
                _ => {
                    let elem = self.reveal(ty.el());
                    self.materialize(base, off);
                    base = RA;
                    off = 0;
                    if self.preg[pr.index] >= 0 { m.mov(I1, self.preg[pr.index] as Reg); } else { m.load(8, I1, FP, self.loff[pr.index]); }
                    let es = self.size(elem);
                    m.mov_imm(I2, es);
                    m.mul_add(RA, I1, I2, RA);
                    ty = elem;
                }
            }
        }
        if pl.proj.len() == 0 && self.preg[pl.local] >= 0 { panic(`lower: address of promoted local _${pl.local} in ${self.f.name}`); }
        (base, off, ty)
    }

    /// Sets RA to base + off.
    fn materialize(&mut self, base: Reg, off: i64) {
        if base == RA {
            if off != 0 { self.m.add_imm(RA, off); }
        } else {
            self.m.addr_of(RA, base, off);
        }
    }

    /// Computes the address of a place into RA (and the metadata of an
    /// unsized place into RM). Clobbers I1, I2.
    fn place(&mut self, pl: &Place) -> &Type {
        let (b, o, ty) = self.place_addr(pl);
        self.materialize(b, o);
        ty
    }

    // --- Operands ----------------------------------------------------------------

    fn operand_type(&mut self, op: &Operand) -> &Type {
        if op.kind == mir::OP_COPY { return self.place_type(&op.place); }
        self.conc(op.cnst.unwrap().ty.unwrap())
    }

    /// The size of a scalar used in arithmetic.
    fn scalar_size(&self, t: &Type) -> i64 {
        match t.kind {
            types::K_INT => layout::int_size(t.int),
            types::K_BOOL => 1,
            types::K_CHAR => 4,
            types::K_FLOAT => if t.f64 { 8 } else { 4 },
            _ => 8,
        }
    }

    /// Loads a value of at most 8 bytes, zero-extended, into r (fat values:
    /// their first word). Clobbers RA, RM, I1, I2 (and T1 for function
    /// constants).
    fn load_scalar(&mut self, op: &Operand, r: Reg) -> Option<&Type> {
        let m = self.m;
        if op.kind == mir::OP_COPY {
            if let Some(pr) = self.promoted(&op.place) {
                m.mov(r, pr);
                return Some(self.ltypes[op.place.local]);
            }
            let (b, o, ty) = self.place_addr(&op.place);
            let mut size = self.size(ty);
            if size > 8 { size = 8; }
            match size {
                0 => {
                    m.mov_imm(r, 0);
                }
                1 | 2 | 4 | 8 => {
                    m.load(size, r, b, o);
                }
                _ => {
                    self.g.errorf(`${self.f.name}: scalar load of ${size} bytes`);
                }
            }
            return Some(ty);
        }
        let c = op.cnst.unwrap();
        let ty = self.conc_opt(c.ty);
        let k = c.kind;
        match k {
            mir::C_INT | mir::C_CHAR | mir::C_BOOL => {
                let mut v = c.int;
                if let Some(t) = ty {
                    if t.kind == types::K_INT && !types::int_signed(t.int) {
                        let s = layout::int_size(t.int);
                        if s < 8 { v = v & ((1i64 << (8 * s) as u32) - 1); }
                    }
                }
                m.mov_imm(r, v);
            }
            mir::C_FLOAT => {
                let f64_ = match ty { Some(t) => t.f64, None => true };
                if f64_ {
                    m.mov_imm(r, c.float.to_bits() as i64);
                } else {
                    m.mov_imm(r, (c.float as f32).to_bits() as i64);
                }
            }
            mir::C_STATIC => {
                let s = self.g.statics[&c.static_def.unwrap().id].clone();
                m.adr_sym(r, &s);
            }
            mir::C_STR | mir::C_BYTES => {
                let s = self.g.str_bytes(&c.bytes);
                m.adr_sym(r, &s);
            }
            mir::C_FN => {
                self.fn_value(c, r, T1);
            }
            mir::C_PARAM => {
                let v = self.conc(c.param.unwrap());
                if v.kind != types::K_CONST { self.g.errorf(`${self.f.name}: const parameter without a value`); }
                m.mov_imm(r, v.len);
            }
            _ => {
                m.mov_imm(r, 0);
            }
        }
        ty
    }

    /// Loads a value of 1, 2, 4, 8 or 16 bytes into V1 (and V2).
    fn load_val(&mut self, op: &Operand, size: i64) {
        let m = self.m;
        if size <= 8 {
            self.load_scalar(op, V1);
            return;
        }
        if op.kind == mir::OP_COPY {
            let (b, o, _) = self.place_addr(&op.place);
            m.load(8, V1, b, o);
            m.load(8, V2, b, o + 8);
            return;
        }
        let c = op.cnst.unwrap();
        match c.kind {
            mir::C_STR | mir::C_BYTES => {
                let s = self.g.str_bytes(&c.bytes);
                m.adr_sym(V1, &s);
                m.mov_imm(V2, c.bytes.len() as i64);
            }
            mir::C_FN => {
                self.fn_value(c, V1, V2);
            }
            mir::C_INT => {
                // A 128-bit integer: int holds the low word (literals are at
                // most u64::MAX); bytes, if set, the high word.
                m.mov_imm(V1, c.int);
                let mut h = 0i64;
                if c.bytes.len() == 8 {
                    let mut i = 8;
                    while i > 0 {
                        i -= 1;
                        h = h << 8 | c.bytes[i] as i64;
                    }
                }
                m.mov_imm(V2, h);
            }
            _ => {
                m.mov_imm(V1, 0);
                m.mov_imm(V2, 0);
            }
        }
    }

    /// Materializes a function constant as (code, ctx).
    fn fn_value(&mut self, c: &Const, code: Reg, ctx: Reg) {
        let m = self.m;
        let (t, slot) = self.g.p.site_target(self.inst, c);
        if slot >= 0 {
            m.load(8, I1, FP, SLOT_CTX);
            m.load(8, code, I1, 16 * slot);
            m.load(8, ctx, I1, 16 * slot + 8);
            return;
        }
        match t.kind {
            codegen::T_INST => {
                let i = t.inst.unwrap();
                m.adr_sym(code, &i.grp().sym);
                m.adr_sym(ctx, &i.dict);
            }
            codegen::T_INTRINSIC => {
                if t.intrinsic == "extern" {
                    let s = self.g.extern_sym(link_name(t.def).as_str());
                    m.adr_sym(code, &s);
                    m.mov_imm(ctx, 0);
                    return;
                }
                self.g.errorf(`${self.f.name}: intrinsic ${t.intrinsic} used as a value`);
            }
            _ => {
                self.g.errorf(`${self.f.name}: dynamic method ${t.def.name} used as a value`);
            }
        }
    }

    /// Writes an operand to [dst + off]; dst must be BASE, FP or SP.
    /// Clobbers RA, RM, V1, V2, T1, I1, I2.
    fn store_operand(&mut self, op: &Operand, dst: Reg, off: i64) {
        let m = self.m;
        let ty = self.operand_type(op);
        let mut size = self.size(ty);
        if op.kind == mir::OP_CONST && op.cnst.unwrap().kind == mir::C_FN && ty.kind == types::K_FN && ty.abi == "C" { size = 8; }
        if size == 0 { return; }
        if op.kind == mir::OP_COPY {
            if let Some(pr) = self.promoted(&op.place) {
                m.store(size, pr, dst, off);
                return;
            }
            let (b, o, _) = self.place_addr(&op.place);
            self.copy_mem(dst, off, b, o, size);
            return;
        }
        let ck = op.cnst.unwrap().kind;
        if ck == mir::C_ZERO || ck == mir::C_UNIT {
            self.zero_mem(dst, off, size);
            return;
        }
        match size {
            1 | 2 | 4 | 8 => {
                self.load_scalar(op, V1);
                m.store(size, V1, dst, off);
            }
            16 => {
                self.load_val(op, 16);
                m.store(8, V1, dst, off);
                m.store(8, V2, dst, off + 8);
            }
            _ => {
                self.g.errorf(`${self.f.name}: constant of ${size} bytes`);
            }
        }
    }

    /// Copies size bytes; clobbers V2, T1, I1, I2.
    fn copy_mem(&mut self, dst: Reg, d_off: i64, src: Reg, s_off: i64, size: i64) {
        if size > 256 {
            self.m.addr_of(I1, src, s_off);
            self.m.addr_of(I2, dst, d_off);
            self.m.copy_words(I2, I1, size / 8);
            self.copy_small(I2, 0, I1, 0, size % 8);
            return;
        }
        self.copy_small(dst, d_off, src, s_off, size);
    }

    fn copy_small(&mut self, dst: Reg, d_off: i64, src: Reg, s_off: i64, size: i64) {
        let mut pos = 0i64;
        for chunk in [8i64, 4, 2, 1].iter() {
            while size - pos >= *chunk {
                self.m.load(*chunk, T1, src, s_off + pos);
                self.m.store(*chunk, T1, dst, d_off + pos);
                pos += *chunk;
            }
        }
    }

    fn zero_mem(&mut self, dst: Reg, off: i64, size: i64) {
        let mut pos = 0i64;
        for chunk in [8i64, 4, 2, 1].iter() {
            while size - pos >= *chunk {
                self.m.store_zero(*chunk, dst, off + pos);
                pos += *chunk;
            }
        }
    }

    /// Stores V1 (and V2) into the place; sizes 1, 2, 4, 8, 16.
    fn store_regs(&mut self, pl: &Place, size: i64) {
        let m = self.m;
        if let Some(pr) = self.promoted(pl) {
            if size > 0 { m.zero_ext(pr, V1, size); }
            return;
        }
        let (b, o, _) = self.place_addr(pl);
        match size {
            0 => {
            }
            1 | 2 | 4 | 8 => {
                m.store(size, V1, b, o);
            }
            16 => {
                m.store(8, V1, b, o);
                m.store(8, V2, b, o + 8);
            }
            _ => {
                self.g.errorf(`${self.f.name}: register store of ${size} bytes`);
            }
        }
    }

    // --- Statements --------------------------------------------------------------

    /// Records that the code from here on comes from pos (debug builds).
    fn note_line(&mut self, pos: Pos) {
        if pos <= 0 { return; }
        let off = self.m.offset();
        let mut ls = self.g.cur_lines;
        if ls.len() > 0 && ls[ls.len() - 1].0 == off {
            ls[ls.len() - 1] = (off, pos);
            return;
        }
        ls.push((off, pos));
    }

    fn stmt(&mut self, bi: usize, si: usize, s: &Stmt) {
        let m = self.m;
        match s {
            Stmt::Assign { place, rv } => self.assign(bi, si, place, rv),
            Stmt::SetDiscr { place, variant } => {
                let ty = self.place(place);
                self.write_tag(RA, ty, *variant);
            }
            Stmt::Box { local, ty } => {
                let ct = self.conc(*ty);
                let size = self.g.lay_of(ct).size;
                let ns = self.noscan(ct);
                self.call_alloc(size, ns);
                if self.preg[*local] >= 0 {
                    m.load(8, self.preg[*local] as Reg, FP, self.res_off);
                } else {
                    m.load(8, V1, FP, self.res_off);
                    self.local_addr(RA, *local);
                    m.store(8, V1, RA, 0);
                }
            }
            Stmt::PushDefer { fn_op, args } => self.push_defer(fn_op, args),
            _ => {}
        }
    }

    /// Calls std::rt::native::gc_alloc(size, noscan); the pointer is left in
    /// the result buffer.
    fn call_alloc(&mut self, size: i64, noscan: bool) {
        let m = self.m;
        m.mov_imm(V1, size);
        m.store(8, V1, SP, 0);
        if noscan {
            m.mov_imm(V1, 1);
            m.store(1, V1, SP, 8);
        } else {
            m.store_zero(1, SP, 8);
        }
        self.call_runtime("gc_alloc");
    }

    /// Whether values of t hold no pointers.
    fn noscan(&mut self, t: &Type) -> bool {
        if t.kind == types::K_NEVER { return true; }
        self.g.lay_of(t).ptrs.len() == 0
    }

    fn call_runtime(&mut self, name: &str) {
        let m = self.m;
        let inst = self.g.p.runtime[&name.to_string()];
        m.addr_of(RET, FP, self.res_off);
        let l = self.g.loc_at("<runtime>", 0, 0);
        m.adr_sym(LOC, &l);
        m.adr_sym(CTX, &inst.dict);
        m.call(&inst.grp().sym);
    }

    fn write_tag(&mut self, base: Reg, ty: &Type, variant: usize) {
        let m = self.m;
        let l = self.g.lay_of(ty);
        match l.tag {
            layout::TAG_INT => {
                let d = self.g.p.info.adts[&ty.d().id].variants[variant].discr;
                m.mov_imm(V1, d);
                m.store(l.tag_size, V1, base, l.tag_off);
            }
            layout::TAG_NICHE => {
                if variant == l.niche_variant { m.store_zero(8, base, 0); }
            }
            _ => {}
        }
    }

    /// Leaves the variant index of the enum at RA in V1.
    fn read_variant(&mut self, ty: &Type) {
        let m = self.m;
        let l = self.g.lay_of(ty);
        match l.tag {
            layout::TAG_INT => {
                m.load(l.tag_size, V1, RA, l.tag_off);
                let vs = self.g.p.info.adts[&ty.d().id].variants;
                let mut identity = true;
                let mut i = 0;
                while i < vs.len() {
                    if vs[i].discr != i as i64 { identity = false; }
                    i += 1;
                }
                if identity { return; }
                let mask: u64 = if l.tag_size < 8 { (1u64 << (8 * l.tag_size) as u32) - 1 } else { 0xFFFFFFFFFFFFFFFF };
                m.mov_imm(V2, 0);
                i = 0;
                while i < vs.len() {
                    m.mov_imm(T1, ((vs[i].discr as u64) & mask) as i64);
                    m.cmp(V1, T1);
                    m.mov_imm(I1, i as i64);
                    m.select_reg(V2, I1, V2, EQ);
                    i += 1;
                }
                m.mov(V1, V2);
            }
            layout::TAG_NICHE => {
                m.load(8, V1, RA, 0);
                m.cmp_imm(V1, 0);
                if l.niche_variant == 0 { m.set_cond(V1, NE); } else { m.set_cond(V1, EQ); }
            }
            _ => {
                m.mov_imm(V1, 0);
            }
        }
    }

    fn assign(&mut self, bi: usize, si: usize, place: &Place, rv: &Rvalue) {
        self.assign_value(bi, si, place, rv);
        self.write_barrier(place);
    }

    /// After a write of pointers to a place that may be in the heap: while
    /// a concurrent collection marks, the runtime shades what was written
    /// (Dijkstra's insertion barrier; stacks and statics are rescanned when
    /// marking ends).
    fn write_barrier(&mut self, pl: &Place) {
        let mut heap = false;
        for pj in pl.proj.iter() {
            if pj.kind == mir::P_DEREF { heap = true; }
        }
        if !heap { return; }
        let ty = self.place_type(pl);
        if ty.kind == types::K_NEVER { return; }
        let l = self.g.lay_of(ty);
        if l.ptrs.len() == 0 || l.unsized { return; }
        let m = self.m;
        let skip = m.new_label();
        m.load_sym(I1, &self.g.sym_marking);
        m.branch_zero(I1, skip);
        // No stop for the collector until the marking is done: the G's
        // nopreempt (its second word; gc_wb decrements it).
        m.load(8, I1, GREG, 8);
        m.add_imm(I1, 1);
        m.store(8, I1, GREG, 8);
        self.place(pl);
        m.store(8, RA, SP, 0);
        m.mov_imm(V1, l.size);
        m.store(8, V1, SP, 8);
        self.call_runtime("gc_wb");
        m.bind(skip);
    }

    fn assign_value(&mut self, bi: usize, si: usize, place: &Place, rv: &Rvalue) {
        let m = self.m;
        let dt = self.place_type(place);
        if dt.kind == types::K_NEVER { return; }
        let size = self.size(dt);
        let regs = size == 1 || size == 2 || size == 4 || size == 8 || size == 16;
        match rv {
            Rvalue::Use(x) => {
                if size == 0 { return; }
                if regs {
                    self.load_val(x, size);
                    self.store_regs(place, size);
                    return;
                }
                m.addr_of(BASE, FP, self.tmp_off);
                self.store_operand(x, BASE, 0);
                let (b, o, _) = self.place_addr(place);
                self.copy_mem(b, o, BASE, 0, size);
            }
            Rvalue::Ref { place: src, .. } => {
                let pt = self.place(src);
                m.mov(V1, RA);
                if layout::is_fat(pt) { m.mov(V2, RM); }
                self.store_regs(place, size);
            }
            Rvalue::Bin { op, x, y, ty, pos } => {
                self.binop(*op, x, y, *ty, *pos);
                self.store_regs(place, size);
            }
            Rvalue::Un { op, x, ty, pos } => {
                self.unop(*op, x, *ty, *pos);
                self.store_regs(place, size);
            }
            Rvalue::Cast { kind, x, .. } => {
                self.cast(*kind, x, dt);
                self.store_regs(place, size);
            }
            Rvalue::Discr(p) => {
                let ty = self.place(p);
                self.read_variant(ty);
                self.store_regs(place, size);
            }
            Rvalue::Len(p) => {
                let pt = self.place_type(p);
                if pt.kind == types::K_ARRAY {
                    m.mov_imm(V1, pt.len);
                } else {
                    self.place(p);
                    m.mov(V1, RM);
                }
                self.store_regs(place, size);
            }
            Rvalue::Unsize { x, len, .. } => {
                // A negative len: the array's length is a const parameter.
                let n = if *len >= 0 { *len } else { self.operand_type(x).el().len };
                self.load_scalar(x, V1);
                m.mov_imm(V2, n);
                self.store_regs(place, size);
            }
            Rvalue::MakeDyn { x, .. } => {
                self.load_scalar(x, V1);
                let key = codegen::dyn_site(self.f, bi, si);
                let (vt, slot) = self.g.p.site_vtable(self.inst, &key);
                if slot >= 0 {
                    m.load(8, I1, FP, SLOT_CTX);
                    m.load(8, V2, I1, 16 * slot);
                } else {
                    m.adr_sym(V2, &vt.sym);
                }
                self.store_regs(place, size);
            }
            Rvalue::Aggregate { kind, ty, variant, ops, closure } => {
                if *kind == mir::AGG_CLOSURE {
                    self.closure(ops, closure.unwrap());
                    self.store_regs(place, size);
                    return;
                }
                if size == 0 { return; }
                m.addr_of(BASE, FP, self.tmp_off);
                let aty = self.conc(*ty);
                let l = self.g.lay_of(aty);
                if *kind == mir::AGG_TUPLE {
                    let mut i = 0;
                    while i < ops.len() {
                        self.store_operand(&ops[i], BASE, l.fields[i]);
                        i += 1;
                    }
                } else if *kind == mir::AGG_ARRAY {
                    if ops.len() > 0 {
                        let stride = l.size / ops.len() as i64;
                        let mut i = 0;
                        while i < ops.len() {
                            self.store_operand(&ops[i], BASE, i as i64 * stride);
                            i += 1;
                        }
                    }
                } else {
                    if !self.g.p.info.adts[&aty.d().id].is_enum {
                        let mut i = 0;
                        while i < ops.len() {
                            self.store_operand(&ops[i], BASE, l.fields[i]);
                            i += 1;
                        }
                    } else {
                        let mut i = 0;
                        while i < ops.len() {
                            self.store_operand(&ops[i], BASE, l.variants[*variant][i]);
                            i += 1;
                        }
                        self.write_tag(BASE, aty, *variant);
                    }
                }
                let (b, o, _) = self.place_addr(place);
                self.copy_mem(b, o, BASE, 0, size);
            }
        }
    }

    /// Allocates the environment [dict, captures...] and leaves the closure
    /// value (code, env+8) in V1, V2.
    fn closure(&mut self, ops: &Vec<Operand>, cf: &Func) {
        let m = self.m;
        self.call_alloc((8 + 8 * ops.len()) as i64, false);
        m.load(8, BASE, FP, self.res_off);
        m.load(8, T1, FP, SLOT_CTX);
        m.store(8, T1, BASE, 0);
        let mut i = 0;
        while i < ops.len() {
            self.store_operand(&ops[i], BASE, (8 + 8 * i) as i64);
            i += 1;
        }
        let s = self.g.closure_sym(self.grp, cf);
        m.adr_sym(V1, &s);
        m.addr_of(V2, BASE, 8);
    }

    // --- Arithmetic ----------------------------------------------------------------

    fn panic_stub(&mut self, msg: &str, pos: Pos) -> Label {
        let key = `${msg}@${pos}`;
        if let Some(l) = self.stubs.get(&key) { return *l; }
        let l = self.m.new_label();
        self.stubs.insert(key, l);
        self.stub_list.push(Stub::Panic { label: l, msg: msg.to_string(), pos });
        l
    }

    /// Calls panic_raw(msg, file, line, col). Compiler-generated impls
    /// report their caller's location.
    fn call_panic(&mut self, msg: &str, pos: Pos) {
        let m = self.m;
        let ms = self.g.str_sym(msg);
        m.adr_sym(V1, &ms);
        m.store(8, V1, SP, 0);
        m.mov_imm(V1, msg.len() as i64);
        m.store(8, V1, SP, 8);
        if self.f.shim {
            self.store_caller_loc(16);
        } else {
            match self.f.file {
                Some(file) => self.store_file_pos(16, file, pos),
                None => self.store_file_line(16, "<unknown>", 0, 0),
            }
        }
        self.call_runtime("panic_raw");
        m.trap();
    }

    /// Writes the received caller location as (file, line, col) arguments
    /// at sp+off.
    fn store_caller_loc(&mut self, off: i64) {
        let m = self.m;
        let lt = self.g.loc_ty;
        let ll = self.g.lay_of(lt);
        m.load(8, BASE, FP, SLOT_LOC);
        m.load(8, V1, BASE, ll.fields[0]);
        m.store(8, V1, SP, off);
        m.load(8, V1, BASE, ll.fields[0] + 8);
        m.store(8, V1, SP, off + 8);
        m.load(4, V1, BASE, ll.fields[1]);
        m.store(4, V1, SP, off + 16);
        m.load(4, V1, BASE, ll.fields[2]);
        m.store(4, V1, SP, off + 24);
    }

    // store_file_line for a position in file.
    fn store_file_pos(&mut self, off: i64, file: &File, pos: Pos) {
        let m = self.m;
        let (line, col) = file.line_col(pos);
        let fs = self.g.file_name_sym(&file.name);
        m.adr_sym(V1, &fs);
        m.store(8, V1, SP, off);
        m.mov_imm(V1, file.name.len() as i64);
        m.store(8, V1, SP, off + 8);
        m.mov_imm(V1, line as i64);
        m.store(4, V1, SP, off + 16);
        m.mov_imm(V1, col as i64);
        m.store(4, V1, SP, off + 24);
    }

    fn store_file_line(&mut self, off: i64, file: &str, line: i64, col: i64) {
        let m = self.m;
        let fs = self.g.str_sym(file);
        m.adr_sym(V1, &fs);
        m.store(8, V1, SP, off);
        m.mov_imm(V1, file.len() as i64);
        m.store(8, V1, SP, off + 8);
        m.mov_imm(V1, line);
        m.store(4, V1, SP, off + 16);
        m.mov_imm(V1, col);
        m.store(4, V1, SP, off + 24);
    }

    // A block's last statement `t = x op y` (an integer comparison) and its
    // switch on t: compares and branches.
    fn compare_branch(&mut self, bi: usize, st: &Stmt, t: &Term) {
        let m = self.m;
        let (op, x, y, ty0) = match st { Stmt::Assign { rv: Rvalue::Bin { op, x, y, ty, .. }, .. } => (*op, x, y, *ty), _ => return };
        let (vals, targets, els) = match t { Term::Switch { vals, targets, els, .. } => (vals, targets, *els), _ => return };
        let ty = self.conc(ty0);
        self.load_scalar(x, V1);
        self.load_scalar(y, V2);
        let signed = is_signed(ty);
        if signed {
            let size = self.scalar_size(ty);
            m.sign_ext(V1, V1, size);
            m.sign_ext(V2, V2, size);
        }
        m.cmp(V1, V2);
        let c = if op == mir::EQ { EQ } else if op == mir::NE { NE }
            else if op == mir::LT { if signed { LT } else { LTU } }
            else if op == mir::LE { if signed { LE } else { LEU } }
            else if op == mir::GT { if signed { GT } else { GTU } }
            else if signed { GE } else { GEU };
        // switch t { v => target, _ => els }: v 1 jumps when c holds.
        let jc = if vals[0] != 0 { c } else { invert(c) };
        m.branch_if(jc, self.blocks[targets[0]]);
        if els != bi + 1 { m.jump(self.blocks[els]); }
    }

    /// Leaves the result in V1.
    fn binop(&mut self, op: mir::BinOp, x: &Operand, y: &Operand, ty0: &Type, pos: Pos) {
        let m = self.m;
        let ty = self.conc(ty0);
        if ty.kind == types::K_INT && layout::int_size(ty.int) == 16 {
            self.g.errorf(`${self.f.name}: 128-bit operation not lowered to std::rt::int128`);
            return;
        }
        self.load_scalar(x, V1);
        self.load_scalar(y, V2);
        if ty.kind == types::K_FLOAT {
            let f64_ = ty.f64;
            m.fmov_to(F0, V1, f64_);
            m.fmov_to(F1, V2, f64_);
            match op {
                mir::ADD => {
                    m.farith(ADD, F0, F0, F1, f64_);
                }
                mir::SUB => {
                    m.farith(SUB, F0, F0, F1, f64_);
                }
                mir::MUL => {
                    m.farith(MUL, F0, F0, F1, f64_);
                }
                mir::DIV => {
                    m.farith(FDIV, F0, F0, F1, f64_);
                }
                mir::REM => {
                    m.store(8, V1, SP, 0);
                    m.store(8, V2, SP, 8);
                    let name = if f64_ { "fmod" } else { "fmodf" };
                    let s = self.g.extern_sym(name);
                    let mut args = Vec::new();
                    args.push(CArg { float: true, f64: f64_ });
                    args.push(CArg { float: true, f64: f64_ });
                    m.call_c(s.as_str(), 0, &args, true, f64_);
                    return;
                }
                _ => {
                    let c = if op == mir::EQ { EQ } else if op == mir::NE { NE } else if op == mir::LT { LT } else if op == mir::LE { LE }
                        else if op == mir::GT { GT } else { GE };
                    m.fcompare(V1, c, F0, F1, f64_);
                    return;
                }
            }
            m.fmov_from(V1, F0, f64_);
            return;
        }
        let size = self.scalar_size(ty);
        let signed = is_signed(ty);
        if signed {
            m.sign_ext(V1, V1, size);
            if op != mir::SHL && op != mir::SHR { m.sign_ext(V2, V2, size); }
        }
        let dbg = self.g.debug;
        match op {
            mir::ADD | mir::SUB | mir::MUL => {
                let what = if op == mir::ADD { "add" } else if op == mir::SUB { "subtract" } else { "multiply" };
                let aop = if op == mir::ADD { ADD } else if op == mir::SUB { SUB } else { MUL };
                if size == 8 && dbg {
                    let l = self.panic_stub(`attempt to ${what} with overflow`.as_str(), pos);
                    m.arith_ovf(aop, signed, V1, V1, V2, l);
                    return;
                }
                m.arith(aop, V1, V1, V2);
                if dbg {
                    let l = self.panic_stub(`attempt to ${what} with overflow`.as_str(), pos);
                    self.check_range(size, signed, l);
                }
            }
            mir::DIV | mir::REM => {
                let l = self.panic_stub("attempt to divide by zero", pos);
                m.branch_zero(V2, l);
                if signed {
                    let skip = m.new_label();
                    m.cmp_imm(V2, -1);
                    m.branch_if(NE, skip);
                    m.mov_imm(T1, int_min(size));
                    m.cmp(V1, T1);
                    let l2 = self.panic_stub("attempt to divide with overflow", pos);
                    m.branch_if(EQ, l2);
                    m.bind(skip);
                }
                let aop = if op == mir::DIV && signed { DIV_S } else if op == mir::DIV { DIV_U } else if signed { REM_S } else { REM_U };
                m.arith(aop, V1, V1, V2);
            }
            mir::SHL | mir::SHR => {
                m.cmp_imm(V2, size * 8);
                let l = self.panic_stub("attempt to shift with overflow", pos);
                m.branch_if(GEU, l);
                if op == mir::SHL {
                    m.arith(SHL, V1, V1, V2);
                } else if signed {
                    m.arith(SHR_S, V1, V1, V2);
                } else {
                    m.arith(SHR_U, V1, V1, V2);
                }
            }
            mir::BIT_AND => {
                m.arith(AND, V1, V1, V2);
            }
            mir::BIT_OR => {
                m.arith(OR, V1, V1, V2);
            }
            mir::BIT_XOR => {
                m.arith(XOR, V1, V1, V2);
            }
            mir::OFFSET => {
                let et = self.reveal(ty.el());
                let es = self.size(et);
                m.mov_imm(T1, es);
                m.mul_add(V1, V2, T1, V1);
            }
            _ => {
                m.cmp(V1, V2);
                let c = if op == mir::EQ { EQ } else if op == mir::NE { NE }
                    else if op == mir::LT { if signed { LT } else { LTU } }
                    else if op == mir::LE { if signed { LE } else { LEU } }
                    else if op == mir::GT { if signed { GT } else { GTU } }
                    else if signed { GE } else { GEU };
                m.set_cond(V1, c);
            }
        }
    }

    /// Jumps to l unless V1 fits in size bytes.
    fn check_range(&mut self, size: i64, signed: bool, l: Label) {
        if size >= 8 { return; }
        let m = self.m;
        if signed {
            m.sign_ext(T1, V1, size);
            m.cmp(T1, V1);
            m.branch_if(NE, l);
        } else {
            m.mov_imm(T1, (1i64 << (8 * size) as u32) - 1);
            m.cmp(V1, T1);
            m.branch_if(GTU, l);
        }
    }

    fn unop(&mut self, op: mir::UnOp, x: &Operand, ty0: &Type, pos: Pos) {
        let m = self.m;
        let ty = self.conc(ty0);
        if ty.kind == types::K_INT && layout::int_size(ty.int) == 16 {
            self.g.errorf(`${self.f.name}: 128-bit operation not lowered to std::rt::int128`);
            return;
        }
        self.load_scalar(x, V1);
        match ty.kind {
            types::K_FLOAT => {
                m.fmov_to(F0, V1, ty.f64);
                m.fneg(F0, F0, ty.f64);
                m.fmov_from(V1, F0, ty.f64);
            }
            types::K_BOOL => {
                m.mov_imm(V2, 1);
                m.arith(XOR, V1, V1, V2);
            }
            _ if op == mir::NOT => {
                m.not(V1, V1);
            }
            _ => {
                let size = self.scalar_size(ty);
                if is_signed(ty) && self.g.debug {
                    m.sign_ext(V1, V1, size);
                    m.mov_imm(T1, int_min(size));
                    m.cmp(V1, T1);
                    let l = self.panic_stub("attempt to negate with overflow", pos);
                    m.branch_if(EQ, l);
                }
                m.neg(V1, V1);
            }
        }
    }

    fn cast(&mut self, kind: mir::CastKind, x: &Operand, to: &Type) {
        let m = self.m;
        match kind {
            mir::CAST_PTR => {
                let s = self.size(to);
                self.load_val(x, s);
                return;
            }
            mir::CAST_PTR_INT | mir::CAST_FN_PTR | mir::CAST_INT_PTR => {
                self.load_scalar(x, V1);
                return;
            }
            mir::CAST_ENUM => {
                let from = self.operand_type(x);
                if x.kind != mir::OP_COPY {
                    self.load_scalar(x, V1);
                    return;
                }
                self.place(&x.place);
                let l = self.g.lay_of(from);
                let vs = self.g.p.info.adts[&from.d().id].variants;
                if l.tag != layout::TAG_INT {
                    if vs.len() > 0 { m.mov_imm(V1, vs[0].discr); }
                    return;
                }
                m.load(l.tag_size, V1, RA, l.tag_off);
                for v in vs.iter() {
                    if v.discr < 0 {
                        m.sign_ext(V1, V1, l.tag_size);
                        break;
                    }
                }
                return;
            }
            _ => {}
        }
        let from = self.operand_type(x);
        self.load_scalar(x, V1);
        if from.kind == types::K_FLOAT && to.kind == types::K_FLOAT {
            if from.f64 == to.f64 { return; }
            m.fmov_to(F0, V1, from.f64);
            m.float_conv(F0, F0, to.f64);
            m.fmov_from(V1, F0, to.f64);
        } else if from.kind == types::K_FLOAT {
            m.fmov_to(F0, V1, from.f64);
            let size = self.scalar_size(to);
            if size == 8 {
                m.float_to_int(V1, F0, is_signed(to), from.f64);
                return;
            }
            m.float_to_int(V1, F0, true, from.f64);
            let (lo, hi) = if is_signed(to) { (int_min(size), -int_min(size) - 1) } else { (0, (1i64 << (8 * size) as u32) - 1) };
            m.mov_imm(V2, lo);
            m.cmp(V1, V2);
            m.select_reg(V1, V2, V1, LT);
            m.mov_imm(V2, hi);
            m.cmp(V1, V2);
            m.select_reg(V1, V2, V1, GT);
        } else if to.kind == types::K_FLOAT {
            if is_signed(from) {
                let s = self.scalar_size(from);
                m.sign_ext(V1, V1, s);
                m.int_to_float(F0, V1, true, to.f64);
            } else {
                m.int_to_float(F0, V1, false, to.f64);
            }
            m.fmov_from(V1, F0, to.f64);
        } else {
            if is_signed(from) {
                let s = self.scalar_size(from);
                m.sign_ext(V1, V1, s);
            }
        }
    }

    // --- Terminators ---------------------------------------------------------------

    fn term(&mut self, bi: usize, t: &Term) {
        let m = self.m;
        match t {
            Term::Goto(target) => {
                if *target != bi + 1 { m.jump(self.blocks[*target]); }
            }
            Term::Switch { x, ty, vals, targets, els } => {
                let cty = self.conc(*ty);
                self.load_scalar(x, V1);
                if is_signed(cty) {
                    let s = self.scalar_size(cty);
                    m.sign_ext(V1, V1, s);
                }
                let mut i = 0;
                while i < vals.len() {
                    m.cmp_imm(V1, vals[i]);
                    m.branch_if(EQ, self.blocks[targets[i]]);
                    i += 1;
                }
                if *els != bi + 1 { m.jump(self.blocks[*els]); }
            }
            Term::Return => {
                m.load(8, CTX, FP, SLOT_DEFERS);
                let skip = m.new_label();
                m.branch_zero(CTX, skip);
                m.call(&self.g.sym_rundefers);
                m.bind(skip);
                let size = self.size(self.ltypes[0]);
                if size > 0 {
                    m.load(8, BASE, FP, SLOT_RET);
                    if self.preg[0] >= 0 {
                        m.store(size, self.preg[0] as Reg, BASE, 0);
                    } else {
                        self.local_addr(RA, 0);
                        self.copy_mem(BASE, 0, RA, 0, size);
                    }
                }
                for sv in self.saved.iter() { m.load(8, sv.0, FP, sv.1); }
                m.ret();
            }
            Term::Unreachable => m.trap(),
            Term::Assert { cond, msg, target, pos, bounds, len, index } => {
                self.load_scalar(cond, V1);
                m.branch_non_zero(V1, self.blocks[*target]);
                if *bounds {
                    self.load_scalar(len, V1);
                    m.store(8, V1, SP, 0);
                    self.load_scalar(index, V1);
                    m.store(8, V1, SP, 8);
                    match self.f.file {
                        Some(file) => self.store_file_pos(16, file, *pos),
                        None => self.store_file_line(16, "<unknown>", 0, 0),
                    }
                    self.call_runtime("panic_bounds");
                    m.trap();
                    return;
                }
                self.call_panic(msg.as_str(), *pos);
            }
            Term::Call { fn_op, args, dest, target, pos } => self.call(fn_op, args, dest, *target, *pos),
            Term::None => {
                self.g.errorf(`${self.f.name}: block without terminator`);
            }
        }
    }

    /// Sets LOC to the location passed to a callee.
    fn pass_loc(&mut self, pos: Pos) {
        if self.inst.track_caller && !self.f.closure {
            self.m.load(8, LOC, FP, SLOT_LOC);
            return;
        }
        let l = self.g.loc(self.f.file, pos);
        self.m.adr_sym(LOC, &l);
    }

    /// Writes the arguments to the outgoing area. If thin_recv, the first
    /// argument is a fat pointer of which only the data word is passed.
    fn store_args(&mut self, args: &Vec<Operand>, thin_recv: bool) {
        let mut off = 0i64;
        let mut i = 0;
        while i < args.len() {
            if i == 0 && thin_recv {
                self.load_scalar(&args[0], V1);
                self.m.store(8, V1, SP, 0);
                off = 8;
                i += 1;
                continue;
            }
            self.store_operand(&args[i], SP, off);
            let at = self.operand_type(&args[i]);
            off += round8(self.size(at));
            i += 1;
        }
    }

    fn call(&mut self, fn_op: &Operand, args: &Vec<Operand>, dest: &Place, target: i64, pos: Pos) {
        let m = self.m;
        let dt = self.place_type(dest);
        let mut tgt: Option<&mut Target> = None;
        let mut slot = -1i64;
        if fn_op.kind == mir::OP_CONST && fn_op.cnst.unwrap().kind == mir::C_FN {
            let (t, s) = self.g.p.site_target(self.inst, fn_op.cnst.unwrap());
            tgt = Some(t);
            slot = s;
            if s < 0 && t.kind == codegen::T_INTRINSIC {
                self.intrinsic(t, args, dest, target, pos, dt);
                return;
            }
        }
        match tgt {
            None => {
                let ft = self.operand_type(fn_op);
                if ft.kind == types::K_FN && ft.abi == "C" {
                    self.c_call(fn_op, args, dest, target, dt, "", true);
                    return;
                }
                self.store_args(args, false);
                self.load_val(fn_op, 16);
                m.mov(BASE, V1);
                m.mov(CTX, V2);
                self.pass_loc(pos);
                m.addr_of(RET, FP, self.res_off);
                m.call_reg(BASE);
            }
            Some(t) => {
                if slot >= 0 {
                    self.store_args(args, false);
                    m.load(8, BASE, FP, SLOT_CTX);
                    m.load(8, CTX, BASE, 16 * slot + 8);
                    m.load(8, BASE, BASE, 16 * slot);
                    self.pass_loc(pos);
                    m.addr_of(RET, FP, self.res_off);
                    m.call_reg(BASE);
                } else if t.kind == codegen::T_VIRTUAL {
                    self.store_args(args, true);
                    self.load_val(&args[0], 16);
                    m.load(8, CTX, V2, (16 * t.method + 8) as i64);
                    m.load(8, BASE, V2, (16 * t.method) as i64);
                    self.pass_loc(pos);
                    m.addr_of(RET, FP, self.res_off);
                    m.call_reg(BASE);
                } else {
                    self.store_args(args, false);
                    self.pass_loc(pos);
                    m.addr_of(RET, FP, self.res_off);
                    let i = t.inst.unwrap();
                    m.adr_sym(CTX, &i.dict);
                    m.call(&i.grp().sym);
                }
            }
        }
        self.after_call(dest, target, dt);
    }

    fn after_call(&mut self, dest: &Place, target: i64, dt: &Type) {
        let m = self.m;
        if target < 0 || dt.kind == types::K_NEVER {
            m.trap();
            return;
        }
        let size = self.size(dt);
        if size > 0 {
            if let Some(pr) = self.promoted(dest) {
                m.load(size, pr, FP, self.res_off);
            } else {
                let (b, o, _) = self.place_addr(dest);
                self.copy_mem(b, o, FP, self.res_off, size);
            }
            self.write_barrier(dest);
        }
        m.jump(self.blocks[target as usize]);
    }

    /// Calls a C function (sym, or the C function pointer fn_op when via_fn)
    /// with the platform's C convention.
    fn c_call(&mut self, fn_op: &Operand, args: &Vec<Operand>, dest: &Place, target: i64, dt: &Type, sym: &str, via_fn: bool) {
        let m = self.m;
        let mut cargs: Vec<CArg> = Vec::new();
        let mut i = 0;
        while i < args.len() {
            let ty = self.operand_type(&args[i]);
            if ty.kind == types::K_FLOAT {
                self.load_scalar(&args[i], V1);
                cargs.push(CArg { float: true, f64: ty.f64 });
            } else if self.size(ty) <= 8 {
                self.load_scalar(&args[i], V1);
                if is_signed(ty) {
                    let s = self.scalar_size(ty);
                    m.sign_ext(V1, V1, s);
                }
                cargs.push(int_arg());
            } else {
                self.g.errorf(`${self.f.name}: unsupported C argument type ${ty}`);
                return;
            }
            m.store(8, V1, SP, (8 * i) as i64);
            i += 1;
        }
        let float_ret = dt.kind == types::K_FLOAT;
        let f64_ = float_ret && dt.f64;
        if via_fn {
            self.load_scalar(fn_op, BASE);
            m.call_c("", BASE, &cargs, float_ret, f64_);
        } else {
            m.call_c(sym, 0, &cargs, float_ret, f64_);
        }
        if target < 0 || dt.kind == types::K_NEVER {
            m.trap();
            return;
        }
        let size = self.size(dt);
        if size > 0 {
            self.store_regs(dest, size);
            self.write_barrier(dest);
        }
        m.jump(self.blocks[target as usize]);
    }

    /// Generates an inline intrinsic or a C call.
    fn intrinsic(&mut self, t: &Target, args: &Vec<Operand>, dest: &Place, target: i64, pos: Pos, dt: &Type) {
        let m = self.m;
        let size = self.size(dt);
        let name = t.intrinsic.as_str();
        let targ0: Option<&Type> = if t.type_args.len() > 0 { Some(t.type_args[0]) } else { None };
        match name {
            "extern" => {
                let s = self.g.extern_sym(link_name(t.def).as_str());
                let fo = mir::copy(mir::local_place(0));
                self.c_call(&fo, args, dest, target, dt, s.as_str(), false);
                return;
            }
            "unreachable" => {
                m.trap();
                return;
            }
            "abort" => {
                let s = self.g.extern_sym("abort");
                m.call_c(s.as_str(), 0, &Vec::new(), false, false);
                m.trap();
                return;
            }
            "has_pointers" => {
                let ns = self.noscan(targ0.unwrap());
                m.mov_imm(V1, if ns { 0 } else { 1 });
            }
            "is_copy_clone" => {
                m.mov_imm(V1, if copy_clone(targ0.unwrap()) { 1 } else { 0 });
            }
            "frame_address" => {
                m.mov(V1, FP);
            }
            "stack_top" => {
                m.adr_sym(V1, &"_navi_stack_top".to_string());
                m.load(8, V1, V1, 0);
            }
            "data_start" => {
                m.adr_sym(V1, &"_navi_data_start".to_string());
            }
            "data_end" => {
                m.adr_sym(V1, &"_navi_data_end".to_string());
            }
            "run_defers" => {
                self.load_scalar(&args[0], CTX);
                m.call(&"_navi_rundefers".to_string());
            }
            "swap_context" => {
                self.load_scalar(&args[0], V1);
                m.store(8, V1, SP, 0);
                self.load_scalar(&args[1], V1);
                m.store(8, V1, SP, 8);
                let mut ca = Vec::new();
                ca.push(int_arg());
                ca.push(int_arg());
                m.call_c("_navi_swapctx", 0, &ca, false, false);
            }
            "save_context" => {
                self.load_scalar(&args[0], V1);
                m.store(8, V1, SP, 0);
                let mut ca = Vec::new();
                ca.push(int_arg());
                m.call_c("_navi_setjmp", 0, &ca, false, false);
            }
            "func_table" => {
                m.adr_sym(V1, &"_navi_ftab".to_string());
            }
            "scan_words" => {
                let mut ca = Vec::new();
                let mut k = 0;
                while k < 6 {
                    self.load_scalar(&args[k], V1);
                    m.store(8, V1, SP, (8 * k) as i64);
                    ca.push(int_arg());
                    k += 1;
                }
                m.call_c("_navi_scanw", 0, &ca, false, false);
            }
            "resume_context" => {
                self.load_scalar(&args[0], V1);
                m.store(8, V1, SP, 0);
                self.load_scalar(&args[1], V1);
                m.store(8, V1, SP, 8);
                let mut ca = Vec::new();
                ca.push(int_arg());
                ca.push(int_arg());
                m.call_c("_navi_longjmp", 0, &ca, false, false);
                m.trap();
                return;
            }
            "gstart_address" => {
                m.adr_sym(V1, &"_navi_gstart".to_string());
            }
            "stack_pointer" => {
                m.mov(V1, SP);
            }
            "spill_registers" => {
                self.load_scalar(&args[0], V1);
                let mut k = 0;
                while k < NUM_SAVED {
                    m.store(8, S0 + k as Reg, V1, (8 * k) as i64);
                    k += 1;
                }
            }
            "set_stack_limit" => {
                // The running G's limit (the first word of its record).
                self.load_scalar(&args[0], V1);
                m.store(8, V1, GREG, 0);
            }
            "current_g" => {
                m.mov(V1, GREG);
            }
            "set_current_g" => {
                self.load_scalar(&args[0], GREG);
            }
            "mstart_address" => {
                m.adr_sym(V1, &"_navi_mstart".to_string());
            }
            "gc_marking_flag" => {
                m.adr_sym(V1, &"_navi_gc_marking".to_string());
            }
            "atomic_load" => {
                self.load_scalar(&args[0], I1);
                m.atomic_load(V1, I1);
            }
            "atomic_store" => {
                self.load_scalar(&args[1], V1);
                m.store(8, V1, FP, self.res_off);
                self.load_scalar(&args[0], I1);
                m.load(8, V1, FP, self.res_off);
                m.atomic_store(V1, I1);
            }
            "atomic_add" => {
                self.load_scalar(&args[1], V2);
                m.store(8, V2, FP, self.res_off);
                self.load_scalar(&args[0], I1);
                m.load(8, V2, FP, self.res_off);
                m.atomic_add(V1, V2, I1);
            }
            "atomic_cas" => {
                // V1 = old (replaced by the word read), V2 = new; true if the
                // word was old.
                self.load_scalar(&args[2], V2);
                m.store(8, V2, FP, self.res_off);
                self.load_scalar(&args[1], V1);
                m.store(8, V1, FP, self.res_off + 8);
                self.load_scalar(&args[0], I1);
                m.load(8, V2, FP, self.res_off);
                m.load(8, V1, FP, self.res_off + 8);
                m.mov(T1, V1);
                m.atomic_cas(V1, V2, I1);
                m.cmp(V1, T1);
                m.set_cond(V1, EQ);
            }
            "wrapping_add" | "wrapping_sub" | "wrapping_mul" => {
                self.load_scalar(&args[1], V2);
                m.store(8, V2, FP, self.res_off);
                self.load_scalar(&args[0], V1);
                m.load(8, V2, FP, self.res_off);
                let op = match name { "wrapping_add" => ADD, "wrapping_sub" => SUB, _ => MUL };
                m.arith(op, V1, V1, V2);
            }
            "size_of" => {
                let s = self.size(targ0.unwrap());
                m.mov_imm(V1, s);
            }
            "align_of" => {
                let a = self.g.lay_of(targ0.unwrap()).align;
                m.mov_imm(V1, a);
            }
            "ptr_offset" => {
                self.load_scalar(&args[1], V2);
                m.store(8, V2, FP, self.res_off);
                self.load_scalar(&args[0], V1);
                m.load(8, V2, FP, self.res_off);
                let s = self.size(targ0.unwrap());
                m.mov_imm(T1, s);
                m.mul_add(V1, V2, T1, V1);
            }
            "slice_from_raw" | "slice_from_raw_mut" | "str_from_raw" => {
                self.load_scalar(&args[1], V2);
                m.store(8, V2, FP, self.res_off);
                self.load_scalar(&args[0], V1);
                m.load(8, V2, FP, self.res_off);
            }
            "slice_len" => {
                self.load_val(&args[0], 16);
                m.mov(V1, V2);
            }
            "slice_ptr" => {
                self.load_scalar(&args[0], V1);
            }
            "str_as_bytes" => {
                self.load_val(&args[0], 16);
            }
            "caller_location" => {
                if self.inst.track_caller && !self.f.closure {
                    m.load(8, BASE, FP, SLOT_LOC);
                } else {
                    let l = self.g.loc(self.f.file, pos);
                    m.adr_sym(BASE, &l);
                }
                self.place(dest);
                self.copy_mem(RA, 0, BASE, 0, size);
                if target >= 0 { m.jump(self.blocks[target as usize]); }
                return;
            }
            _ => {
                self.g.errorf(`${self.f.name}: intrinsic ${name} has no native implementation`);
                return;
            }
        }
        self.store_regs(dest, size);
        if size > 0 { self.write_barrier(dest); }
        if target >= 0 { m.jump(self.blocks[target as usize]); } else { m.trap(); }
    }

    // --- Defer ---------------------------------------------------------------------

    /// Allocates a record [next, code, ctx, argsize, retsize, loc, args...]
    /// and links it into the frame's defer list.
    fn push_defer(&mut self, fn_op: &Operand, args: &Vec<Operand>) {
        let m = self.m;
        let mut is_virtual = false;
        let mut tgt: Option<&mut Target> = None;
        let mut ret_ty: Option<&Type> = None;
        if fn_op.kind == mir::OP_CONST && fn_op.cnst.unwrap().kind == mir::C_FN {
            let (t, _) = self.g.p.site_target(self.inst, fn_op.cnst.unwrap());
            tgt = Some(t);
            match t.kind {
                codegen::T_VIRTUAL => {
                    is_virtual = true;
                    let sig = self.g.fn_sig_of(t.def);
                    ret_ty = Some(self.conc(sig.ret));
                }
                codegen::T_INST => {
                    let i = t.inst.unwrap();
                    ret_ty = Some(self.g.concrete(i, i.func.locals[0].ty));
                }
                _ => {
                    self.g.errorf(`${self.f.name}: cannot defer intrinsic ${t.intrinsic}`);
                    return;
                }
            }
        } else {
            let ft = self.operand_type(fn_op);
            if ft.kind == types::K_FN { ret_ty = ft.ret; }
        }
        let mut arg_size = 0i64;
        let mut i = 0;
        while i < args.len() {
            if i == 0 && is_virtual {
                arg_size += 8;
                i += 1;
                continue;
            }
            let at = self.operand_type(&args[i]);
            arg_size += round8(self.size(at));
            i += 1;
        }
        let mut ret_size = 16i64;
        if let Some(rt) = ret_ty {
            let rs = self.size(rt);
            if rs > ret_size { ret_size = rs; }
        }
        ret_size = round8(ret_size);
        self.call_alloc(48 + arg_size, false);
        m.load(8, BASE, FP, self.res_off);
        // Code and context.
        if is_virtual {
            let t = tgt.unwrap();
            self.load_val(&args[0], 16);
            m.store(8, V1, BASE, 48);
            m.load(8, V1, V2, (16 * t.method) as i64);
            m.load(8, V2, V2, (16 * t.method + 8) as i64);
        } else if tgt.is_some() {
            self.fn_value(fn_op.cnst.unwrap(), V1, V2);
        } else {
            self.load_val(fn_op, 16);
        }
        m.store(8, V1, BASE, 8);
        m.store(8, V2, BASE, 16);
        m.mov_imm(V1, arg_size);
        m.store(8, V1, BASE, 24);
        m.mov_imm(V1, ret_size);
        m.store(8, V1, BASE, 32);
        if self.inst.track_caller && !self.f.closure {
            m.load(8, V1, FP, SLOT_LOC);
        } else {
            let l = self.g.loc(self.f.file, 0);
            m.adr_sym(V1, &l);
        }
        m.store(8, V1, BASE, 40);
        let mut off = 48i64;
        i = 0;
        while i < args.len() {
            if i == 0 && is_virtual {
                off += 8;
                i += 1;
                continue;
            }
            self.store_operand(&args[i], BASE, off);
            let at = self.operand_type(&args[i]);
            off += round8(self.size(at));
            i += 1;
        }
        m.load(8, V1, FP, SLOT_DEFERS);
        m.store(8, V1, BASE, 0);
        m.store(8, BASE, FP, SLOT_DEFERS);
    }
}

/// Whether cloning a t is a bitwise copy.
fn copy_clone(t: &Type) -> bool {
    let k = t.kind;
    match k {
        types::K_INT | types::K_FLOAT | types::K_BOOL | types::K_CHAR | types::K_PTR | types::K_FN | types::K_REF => return true,
        types::K_ARRAY => return copy_clone(t.el()),
        types::K_TUPLE => {
            for e in t.elems.iter() {
                if !copy_clone(*e) { return false; }
            }
            return true;
        }
        _ => {}
    }
    false
}

/// The source position of a statement, if it has one.
fn stmt_pos(s: &Stmt) -> Pos {
    if let Stmt::Assign { rv, .. } = s {
        match rv {
            Rvalue::Bin { pos, .. } | Rvalue::Un { pos, .. } => return *pos,
            _ => {}
        }
    }
    0
}

/// The source position of a terminator, if it has one.
fn term_pos(t: &Term) -> Pos {
    match t {
        Term::Call { pos, .. } | Term::Assert { pos, .. } => *pos,
        _ => 0,
    }
}

// The positions and liveness of a function's locals (choose_registers).
fn new_live() -> &mut Live {
    &mut Live { lo: Vec::new(), hi: Vec::new(), bad: Vec::new(), words: 0, gen: Vec::new(), kill: Vec::new(), b: 0, pos: 0,
        live_in: Vec::new(), live_out: Vec::new(), starts: Vec::new(), ends: Vec::new(), succ: Vec::new(), succ_at: Vec::new(),
        order: Vec::new(), active: Vec::new() }
}

struct Live {
    live_in: Vec<u64>,
    live_out: Vec<u64>,
    starts: Vec<i64>,
    ends: Vec<i64>,
    succ: Vec<usize>,
    succ_at: Vec<usize>,
    order: Vec<usize>,
    active: Vec<usize>,
    lo: Vec<i64>,
    hi: Vec<i64>,
    // Not a scalar, or its address is taken: stays in memory.
    bad: Vec<bool>,
    words: usize,
    // Per block: the locals read before written (gen) and written (kill).
    gen: Vec<u64>,
    kill: Vec<u64>,
    b: usize,
    pos: i64,
}

impl Live {
    fn touch_at(&mut self, l: usize, p: i64) {
        if self.lo[l] < 0 || p < self.lo[l] { self.lo[l] = p; }
        if p > self.hi[l] { self.hi[l] = p; }
    }

    fn touch(&mut self, l: usize) { let p = self.pos; self.touch_at(l, p); }

    fn bit(&self, l: usize) -> (usize, u64) { (self.b * self.words + l / 64, 1u64 << (l % 64) as u32) }

    fn use_(&mut self, l: usize) {
        self.touch(l);
        let (w, m) = self.bit(l);
        if self.kill[w] & m == 0 { self.gen[w] = self.gen[w] | m; }
    }

    fn def(&mut self, l: usize) {
        self.touch(l);
        let (w, m) = self.bit(l);
        self.kill[w] = self.kill[w] | m;
    }

    // A place read (or, def, written whole); as_ref: its address is used.
    fn place(&mut self, pl: &Place, as_ref: bool, def: bool) {
        for pr in pl.proj.iter() {
            if pr.kind == mir::P_INDEX { self.use_(pr.index); }
        }
        if pl.proj.len() == 0 {
            if as_ref { self.bad[pl.local] = true; }
            if def && !as_ref { self.def(pl.local); } else { self.use_(pl.local); }
        } else {
            if pl.proj[0].kind != mir::P_DEREF { self.bad[pl.local] = true; }
            self.use_(pl.local);
        }
    }

    fn op(&mut self, x: &Operand) {
        if x.kind == mir::OP_COPY { self.place(&x.place, false, false); }
    }
}

fn invert(c: Cond) -> Cond {
    match c {
        EQ => NE,
        NE => EQ,
        LT => GE,
        GE => LT,
        LE => GT,
        GT => LE,
        LTU => GEU,
        GEU => LTU,
        LEU => GTU,
        _ => LEU,
    }
}

// How many times each local appears in f (written or read, whole or in part).
fn local_refs(f: &Func) -> Vec<u32> {
    let mut n: Vec<u32> = Vec::new();
    for _ in f.locals.iter() { n.push(0); }
    for b in f.blocks.iter() {
        for st in b.stmts.iter() {
            match st {
                Stmt::Assign { place, rv } => {
                    ref_place(&mut n, place);
                    match rv {
                        Rvalue::Use(x) | Rvalue::Un { x, .. } | Rvalue::Cast { x, .. } | Rvalue::Unsize { x, .. } | Rvalue::MakeDyn { x, .. } => ref_op(&mut n, x),
                        Rvalue::Ref { place: p, .. } | Rvalue::Discr(p) | Rvalue::Len(p) => ref_place(&mut n, p),
                        Rvalue::Bin { x, y, .. } => {
                            ref_op(&mut n, x);
                            ref_op(&mut n, y);
                        }
                        Rvalue::Aggregate { ops, .. } => { for o in ops.iter() { ref_op(&mut n, o); } }
                    }
                }
                Stmt::SetDiscr { place, .. } => ref_place(&mut n, place),
                Stmt::Box { local, .. } => { n[*local] += 1; }
                Stmt::PushDefer { fn_op, args } => {
                    ref_op(&mut n, fn_op);
                    for a in args.iter() { ref_op(&mut n, a); }
                }
                Stmt::StorageLive(l) => { n[*l] += 1; }
            }
        }
        match &b.term {
            Term::Switch { x, .. } => ref_op(&mut n, x),
            Term::Call { fn_op, args, dest, .. } => {
                ref_op(&mut n, fn_op);
                for a in args.iter() { ref_op(&mut n, a); }
                ref_place(&mut n, dest);
            }
            Term::Assert { cond, len, index, .. } => {
                ref_op(&mut n, cond);
                ref_op(&mut n, len);
                ref_op(&mut n, index);
            }
            Term::Return => { n[0] += 1; }
            _ => {}
        }
    }
    n
}

fn ref_place(n: &mut Vec<u32>, p: &Place) {
    n[p.local] += 1;
    for pr in p.proj.iter() { if pr.kind == mir::P_INDEX { n[pr.index] += 1; } }
}

fn ref_op(n: &mut Vec<u32>, x: &Operand) { if x.kind == mir::OP_COPY { ref_place(n, &x.place); } }

// Whether b ends in `t = x cmp y` (integers, not 128-bit) and a switch with
// one value on t, t appearing nowhere else.
fn fused_compare(b: &mir::Block, refs: &Vec<u32>) -> bool {
    if b.stmts.len() == 0 { return false; }
    let (place, op, ty) = match &b.stmts[b.stmts.len() - 1] {
        Stmt::Assign { place, rv: Rvalue::Bin { op, ty, .. } } => (place, *op, *ty),
        _ => return false,
    };
    if place.proj.len() != 0 || refs[place.local] != 2 { return false; }
    if !(op == mir::EQ || op == mir::NE || op == mir::LT || op == mir::LE || op == mir::GT || op == mir::GE) { return false; }
    // Known integer-like types only (not a parameter that may be a float).
    let k = ty.kind;
    if !(k == types::K_INT || k == types::K_BOOL || k == types::K_CHAR) { return false; }
    if k == types::K_INT && layout::int_size(ty.int) == 16 { return false; }
    match &b.term {
        Term::Switch { x, vals, .. } => {
            vals.len() == 1 && (vals[0] == 0 || vals[0] == 1) && x.kind == mir::OP_COPY && x.place.local == place.local && x.place.proj.len() == 0
        }
        _ => false,
    }
}
