//! Turns the code generation plan into machine code and data for any
//! architecture: lowers MIR to the abstract operations of a Machine and
//! lays out dictionaries, vtables, locations, statics and strings in a
//! format-neutral object.
//!
//! Internal calling convention (all navi functions, closures and shims):
//! CTX is the dictionary of the instance (for closures the environment,
//! whose word at -8 holds the dictionary), RET the address of the result
//! slot, LOC the caller location for #[track_caller]; arguments are on the
//! caller's stack at sp+off, each rounded up to 8 bytes (the callee sees
//! them at FP+16+off). No register survives a call. Every MIR local lives
//! in the frame: FP-8 context, FP-16 result slot address, FP-24 caller
//! location, FP-32 head of the defer list, then locals, the call result
//! buffer and the staging buffer; SP+0 is the outgoing argument area.

use std::{
    collections::HashMap,
    sync::{
        Mutex,
        mpmc::{Sender, channel},
    },
    thread,
};

use crate::{
    backend::machine::*,
    codegen::{self, DictEntry, Group, Inst, Plan, Target, Vtable},
    layout::{self, Computer, Layout},
    mir::{self, Const, Func, Operand, Place, Rvalue, Stmt, Term},
    obj::{self, Object},
    resolve::{Def, Node},
    syntax::{
        ast::{ExprKind, Item, LitKind},
        source::{File, Pos},
    },
    types::{self, Type},
};

const SLOT_CTX: i64 = -8;
const SLOT_RET: i64 = -16;
const SLOT_LOC: i64 = -24;
const SLOT_DEFERS: i64 = -32;
const FIXED_FRAME: i64 = 40;

/// The platform conventions that matter to lowering.
#[derive(Clone)]
pub struct TargetConv {
    /// Prepended to C symbol names ("_" on macOS).
    pub c_prefix: String,
    /// The C function writing to a file descriptor.
    pub write: String,
    /// macos, linux or windows.
    pub os: String,
    /// How many saved registers (S0..) the register allocator may use.
    pub num_saved: usize,
    /// Stack maps give return offsets in these units (the instruction
    /// alignment: 4 on arm64, 1 on amd64 and wasm, whose offsets are
    /// block numbers).
    pub code_unit: u64,
    /// WebAssembly (docs/wasm.md): no arguments or results in registers
    /// (each function's are its own locals), nothing kept in registers
    /// across calls.
    pub wasm: bool,
}

#[derive(Clone)]
struct LocData {
    sym: String,
    file: String,
    line: i64,
    col: i64,
}

/// A function lowered by a worker, waiting to be placed in the object. Its
/// relocations name the strings and locations it uses as %S<i> and %L<i>
/// (indexes into strs and locs): they get their symbols when the functions
/// are merged in order, so the object does not depend on the threads.
// A relocation of a worker's function: against symbol number id (numbered
// before the workers started), else by name (strings, locations and the
// rest get their numbers when merged).
struct OutReloc {
    off: u32,
    kind: obj::RelocKind,
    id: i64,
    /// 1: the function's string ix, 2: its location ix (see FuncOut).
    ph: u8,
    ix: usize,
    name: String,
}

struct FuncOut {
    sym: String,
    /// The prologue's offset in code (-1: none; see Code::frame).
    frame: i64,
    /// Where the register entry (sym.r) starts in code.
    reg_off: i64,
    /// Where the C entry (sym.c) starts in code (-1: none).
    c_off: i64,
    name: String,
    code: Vec<u8>,
    relocs: Vec<OutReloc>,
    /// (offset in code, file, line) when recording DWARF.
    lines: Vec<(u64, &File, u32)>,
    /// The stack map (see stack_meta), with the calls' masks.
    meta: Vec<u64>,
    file: Option<&File>,
    strs: Vec<Vec<u8>>,
    locs: Vec<LocData>,
    undef: Vec<String>,
    /// (symbol, library) of the undefined symbols from #[link].
    libs: Vec<(String, String)>,
    errs: Vec<String>,
    failed: bool,
}

/// A function to lower, in the order of the object.
struct Job {
    grp: &mut Group,
    f: &mut Func,
    sym: String,
}

// The runtime symbols generated code refers to by name.
const RUNTIME_SYMS: [&str; 20] = [
    "_navi_argc",
    "_navi_argv",
    "_navi_data_end",
    "_navi_data_start",
    "_navi_g0boot",
    "_navi_gc_marking",
    "_navi_gstart",
    "_navi_longjmp",
    "_navi_morestack",
    "_navi_mstart",
    "_navi_os_sp",
    "_navi_overflow",
    "_navi_rundefers",
    "_navi_saved_greg",
    "_navi_scanh",
    "_navi_setjmp",
    "_navi_stack_lo",
    "_navi_stack_top",
    "_navi_swapctx",
    "_navi_tls_key",
];

// The functions a worker takes at a time.
const CHUNK: usize = 4;

pub struct Gen {
    /// The function being made's stack map (without its calls), its saved
    /// registers' pointer masks by position, and the mask of every saved
    /// register it uses.
    cur_meta: Vec<u64>,
    cur_masks: Vec<u16>,
    cur_all: u64,
    /// How many words of its caller's outgoing area the function just made
    /// takes its parameters in, and which of them hold pointers (all of them
    /// past 64 words).
    cur_argw: u64,
    cur_argmask: u64,
    /// The words of its result, in memory at RET (0: in registers), and
    /// which of them hold pointers (all of them past 64 words).
    cur_retw: u64,
    cur_retmask: u64,
    /// The functions placed with stack maps: (symbol, text offset, size,
    /// map symbol), in text order.
    ftab: Vec<(u64, u64, u64)>,
    /// The stack maps, one after another (ftab has each one's offset).
    fmeta: Vec<u8>,
    /// Placeholder names (%S<k>, %L<k>), made once for each k.
    ph_s: Vec<String>,
    ph_l: Vec<String>,
    /// A number for each file name, and the symbol of each file name.
    file_no: HashMap<String, u32>,
    file_sym: HashMap<String, String>,
    /// A worker's locations in the function by file number and position.
    floc_pos: HashMap<u64, usize>,
    /// Runtime symbols every function refers to (shared by relocations).
    sym_marking: String,
    sym_rundefers: String,
    /// -d ssacheck: build and check every function's SSA form (2: also
    /// report the ones not built); -d ssadump: print the SSA form of the
    /// functions whose names contain it.
    ssa_check: i64,
    ssa_dump: String,
    /// -d nossaopt: without the SSA optimizations.
    ssa_noopt: bool,
    /// -d ssatime: report the time of the SSA backend's phases.
    ssa_time: bool,
    /// Where the current function's register entry (.r) starts.
    cur_reg_off: i64,
    cur_c_off: i64,

    /// This thread's reusable SSA values and blocks, and register
    /// allocation.
    pub ssa_cache: &mut crate::ssa::Cache,
    ssa_ra: &mut crate::ssa::regalloc::Alloc,

    pub p: &mut Plan,
    o: &mut Object,
    m: &mut dyn Machine,
    tgt: TargetConv,
    /// Whether to record DWARF (functions and line rows): navi build -s
    /// leaves it out.
    dwarf: bool,
    lay: &mut Computer,
    locs: HashMap<String, String>,
    loc_list: Vec<LocData>,
    /// Symbol numbers of locations (by key) and strings, for merge.
    loc_ids: HashMap<String, u32>,
    str_ids: HashMap<Vec<u8>, u32>,
    closure: HashMap<String, String>,
    statics: HashMap<u32, String>,
    errs: Vec<String>,
    /// The current function's line rows (code offset, file, position in
    /// it) and file, recorded for DWARF.
    cur_lines: Vec<(usize, &File, Pos)>,
    cur_file: Option<&File>,
    cur_name: String,
    /// Held while lowering uses state shared by the threads: the type
    /// context (concrete types are interned), the layouts and the type
    /// checker's caches.
    lock: &Mutex<u8>,
    /// The layouts this generator has used (read without the lock).
    lays: HashMap<u32, &mut Layout>,
    /// Field types by (type id, variant).
    ftypes: HashMap<u64, Vec<&Type>>,
    loc_ty: &Type,
    /// A worker lowers functions into outs; the current function's strings,
    /// locations and C symbols are collected for its FuncOut.
    worker: bool,
    outs: Vec<&mut FuncOut>,
    fstrs: Vec<Vec<u8>>,
    fstr_ix: HashMap<Vec<u8>, usize>,
    flocs: Vec<LocData>,
    floc_ix: HashMap<String, usize>,
    fundef: Vec<String>,
    flibs: Vec<(String, String)>,
    /// The symbol numbers given before the workers started (read only).
    main_ids: HashMap<String, u32>,
}

fn round8(n: i64) -> i64 {
    (n + 7) & !7
}

fn int_min(size: i64) -> i64 {
    -1i64 << (size * 8 - 1) as u32
}

// Descriptor kinds (no reader now; kept so the layout stays): integers are
// DK_INT0 + their IntKind (i8 i16 i32 i64 isize u8 u16 u32 u64 usize i128
// u128).
const DK_BOOL: u64 = 1;
const DK_CHAR: u64 = 2;
const DK_INT0: u64 = 3;
const DK_F32: u64 = 15;
const DK_F64: u64 = 16;
const DK_STR: u64 = 17;
const DK_STRING: u64 = 18;
const DK_TUPLE: u64 = 19;
const DK_ARRAY: u64 = 20;
const DK_SLICE: u64 = 21;
const DK_REF: u64 = 22;
const DK_PTR: u64 = 23;
const DK_STRUCT: u64 = 24;
const DK_ENUM: u64 = 25;
const DK_VEC: u64 = 26;
const DK_FN: u64 = 28;
const DK_DYN: u64 = 29;
const DK_OTHER: u64 = 30;

fn put_u64(b: &mut Vec<u8>, at: usize, v: u64) {
    let mut i = 0;
    while i < 8 {
        b[at + i] = (v >> (8 * i) as u32) as u8;
        i += 1;
    }
}

fn put_u32(b: &mut Vec<u8>, at: usize, v: u32) {
    let mut i = 0;
    while i < 4 {
        b[at + i] = (v >> (8 * i) as u32) as u8;
        i += 1;
    }
}

fn zeros(n: i64) -> Vec<u8> {
    let mut v = Vec::new();
    let mut i = 0;
    while i < n {
        v.push(0u8);
        i += 1;
    }
    v
}

/// The C symbol of an extern function (#[link_name = "..."]).
fn link_name(d: &Def) -> String {
    if let Node::Item(Item::Fn(f)) = &d.node {
        for a in f.base.attrs.iter() {
            if a.path.segments.len() == 1 && a.path.segments[0].name.value == "link_name" {
                if let Some(v) = a.value {
                    if let ExprKind::Lit { kind, value, .. } = &v.kind {
                        if *kind == LitKind::Str {
                            return String::from_utf8_lossy(
                                crate::mir::expr::unquote(value.as_str()).as_slice(),
                            )
                            .to_string();
                        }
                    }
                }
            }
        }
    }
    d.name.clone()
}

fn new_gen(
    p: &mut Plan,
    arch: &str,
    m: &mut dyn Machine,
    tgt: TargetConv,
    dwarf: bool,
    lock: &Mutex<u8>,
    loc_ty: &Type,
) -> &mut Gen {
    &mut Gen {
        p,
        o: obj::new_object(arch),
        m,
        tgt,
        dwarf,
        lay: p.lay,
        locs: HashMap::new(),
        loc_list: Vec::new(),
        loc_ids: HashMap::new(),
        str_ids: HashMap::new(),
        closure: HashMap::new(),
        statics: HashMap::new(),
        errs: Vec::new(),
        cur_lines: Vec::new(),
        cur_file: None,
        cur_name: String::new(),
        lock,
        lays: HashMap::new(),
        ftypes: HashMap::new(),
        loc_ty,
        worker: false,
        outs: Vec::new(),
        fstrs: Vec::new(),
        fstr_ix: HashMap::new(),
        flocs: Vec::new(),
        floc_ix: HashMap::new(),
        fundef: Vec::new(),
        flibs: Vec::new(),
        main_ids: HashMap::new(),
        cur_meta: Vec::new(),
        cur_masks: Vec::new(),
        cur_all: 0,
        cur_argw: 0,
        cur_argmask: 0,
        cur_retw: 0,
        cur_retmask: 0,
        ftab: Vec::new(),
        fmeta: Vec::new(),
        ph_s: Vec::new(),
        ph_l: Vec::new(),
        file_no: HashMap::new(),
        file_sym: HashMap::new(),
        floc_pos: HashMap::new(),
        sym_marking: "_navi_gc_marking".to_string(),
        sym_rundefers: "_navi_rundefers".to_string(),
        ssa_check: match crate::dflags::value("ssacheck") {
            Some(v) => {
                if v == "2" {
                    2
                } else if v == "3" {
                    3
                } else {
                    1
                }
            }
            None => 0,
        },
        ssa_dump: match crate::dflags::value("ssadump") {
            Some(v) => v,
            None => String::new(),
        },
        ssa_noopt: crate::dflags::on("nossaopt"),
        ssa_time: crate::dflags::on("ssatime"),
        ssa_cache: crate::ssa::new_cache(),
        ssa_ra: crate::ssa::regalloc::empty(),
        cur_reg_off: 0,
        cur_c_off: -1,
    }
}

/// Lowers the plan into a new object for arch, with a machine from new_m
/// per thread: the functions are lowered by as many threads as can run at
/// once (std::thread::available_parallelism) and placed in the object in
/// order.
pub fn generate(
    p: &mut Plan,
    arch: &str,
    new_m: fn() -> &mut dyn Machine,
    tgt: TargetConv,
    dwarf: bool,
) -> Result<&mut Object, String> {
    if p.errors.len() > 0 {
        return Err(p.errors.join("\n"));
    }
    check_symbols(p)?;
    let lock = &Mutex::new(0u8);
    let loc_def = p.info.lang_def("Location").unwrap();
    let loc_ty = p.info.ctx.adt(loc_def, Vec::new());
    let g = new_gen(p, arch, new_m(), tgt.clone(), dwarf, lock, loc_ty);
    let mut i = 0;
    while i < p.statics.len() {
        let d = p.statics[i];
        g.statics.insert(
            d.id,
            crate::symbols::symbol(
                "_navi_s_",
                d.name.as_str(),
                crate::symbols::def_id(d).as_str(),
            ),
        );
        i += 1;
    }
    for d in p.ext_statics.iter() {
        g.statics.insert(
            d.id,
            crate::symbols::symbol(
                "_navi_s_",
                d.name.as_str(),
                crate::symbols::def_id(*d).as_str(),
            ),
        );
    }
    // Every function with its symbol (a group's closures are numbered
    // within the group).
    let mut jobs: Vec<Job> = Vec::new();
    for gp in p.groups.iter() {
        let grp = *gp;
        // (A separately compiled crate's: in its object.)
        if grp.external {
            continue;
        }
        let mut todo: Vec<&mut Func> = Vec::new();
        collect_closures(grp.rep.func, &mut todo);
        jobs.push(Job {
            grp,
            f: grp.rep.func,
            sym: grp.sym.clone(),
        });
        let mut k = 0;
        for c in todo.iter() {
            let s = `${grp.sym}_c${k}`.to_string();
            g.closure
                .insert(`${grp.sym}/${c.id}`.to_string(), s.clone());
            jobs.push(Job { grp, f: *c, sym: s });
            k += 1;
        }
    }
    // Number the symbols functions refer to, so that workers give their
    // relocations numbers (the linker then looks nothing up by name).
    for grp in p.groups.iter() {
        g.o.id(grp.sym.as_str());
        for inst in grp.insts.iter() {
            g.o.id(inst.dict.as_str());
        }
    }
    for j in jobs.iter() {
        g.o.id(j.sym.as_str());
    }
    for v in p.vtable_list.iter() {
        g.o.id(v.sym.as_str());
    }
    for (_, sym) in g.statics.iter() {
        g.o.id(sym.as_str());
    }
    for sym in RUNTIME_SYMS.iter() {
        g.o.id(*sym);
    }
    let mut nw = match thread::available_parallelism() {
        Ok(n) => n,
        Err(_) => 1,
    };
    if nw > jobs.len() / CHUNK {
        nw = jobs.len() / CHUNK;
    }
    let next = &std::sync::atomic::AtomicUsize::new(0);
    // The largest functions first (as Go does): a large one taken last
    // would keep the others waiting.
    let mut sizes: Vec<(usize, usize)> = Vec::new();
    let mut ji = 0;
    while ji < jobs.len() {
        let mut n = 0;
        for b in jobs[ji].f.blocks.iter() {
            n += b.stmts.len() + 1;
        }
        sizes.push((n, ji));
        ji += 1;
    }
    sizes.sort_by(|a, b| {
        if a.0 != b.0 {
            b.0.cmp(&a.0)
        } else {
            a.1.cmp(&b.1)
        }
    });
    let mut order: Vec<usize> = Vec::new();
    for (_, j) in sizes.iter() {
        order.push(*j);
    }
    // Functions are placed in the order they are taken, each as soon as
    // it is done (while the workers lower the rest).
    let ids = g.o.ids.clone();
    let (tx, rx) = channel::<Vec<(usize, &mut FuncOut)>>();
    let mut hs = Vec::new();
    if nw > 1 {
        p.info.ctx.par = true;
    }
    let mut k = 0;
    while k < nw || k == 0 {
        let w = g.worker_gen(new_m(), arch, ids);
        if nw <= 1 {
            run_jobs(w, &mut jobs, &order, next, tx);
        } else {
            hs.push(thread::spawn(|| run_jobs(w, &mut jobs, &order, next, tx)));
        }
        k += 1;
    }
    // The start of the text (the stack map table counts from it).
    g.o.define("_navi_text0", obj::TEXT, 4, false);
    let mut outs: Vec<Option<&mut FuncOut>> = Vec::new();
    for _ in jobs.iter() {
        outs.push(None);
    }
    for j in order.iter() {
        while outs[*j].is_none() {
            for (d, o) in rx.recv().unwrap().iter() {
                outs[*d] = Some(*o);
            }
        }
        g.merge(outs[*j].unwrap());
        outs[*j] = None;
    }
    for h in hs.iter() {
        h.join().unwrap();
    }
    p.info.ctx.par = false;
    if p.library.len() == 0 {
        g.gen_main();
        g.gen_run_defers();
        g.gen_sched();
        if g.tgt.wasm {
            g.gen_idle();
        }
    } else {
        g.gen_crate_init();
    }
    g.gen_data();
    if g.errs.len() > 0 {
        return Err(g.errs.join("\n"));
    }
    if g.ssa_check > 0 {
        let (ok, not) = crate::backend::ssagen::counts();
        eprintln(`ssa: ${ok} functions built, ${not} not`);
    }
    if g.ssa_time {
        let ms = |i: usize| crate::backend::ssagen::time(i) / 1000000;
        eprintln(
            `ssa: build ${ms(0)} ms, optimize ${ms(1)} ms, allocate ${ms(2)} ms, emit ${ms(3)} ms (cpu, all threads)`,
        );
    }
    Ok(g.o)
}

/// The symbol of the initializer of crate name's statics (a crate compiled
/// alone, docs/crates.md).
pub fn crate_init_sym(name: &str) -> String {
    `_navi_init_${name}`.to_string()
}

/// The function that initializes static sym (a crate compiled alone).
pub fn static_init_sym(sym: &str) -> String {
    `${sym}.i`.to_string()
}

/// What a crate's initializer calls instead of the initialization of a
/// static the program does not use (crate::merge).
pub const INIT_NOP: &str = "_navi_init_nop";

// The stable names (crate::symbols) of distinct things must differ: a
// clash would bind references to the wrong definition.
fn check_symbols(p: &Plan) -> Result<(), String> {
    let mut seen: HashMap<String, bool> = HashMap::new();
    let mut add = |s: &String| -> Result<(), String> {
        if seen.contains_key(s) {
            return Err(`internal error: two definitions named ${s}`.to_string());
        }
        seen.insert(s.clone(), true);
        Ok(())
    };
    for g in p.groups.iter() {
        if g.external {
            continue;
        }
        add(&g.sym)?;
        for i in g.insts.iter() {
            add(&i.dict)?;
        }
    }
    for d in p.desc_list.iter() {
        add(&d.sym)?;
    }
    for v in p.vtable_list.iter() {
        add(&v.sym)?;
    }
    Ok(())
}

// Lowers jobs, CHUNK at a time, until none is left.
fn run_jobs(
    w: &mut Gen,
    jobs: &mut Vec<Job>,
    order: &Vec<usize>,
    next: &std::sync::atomic::AtomicUsize,
    tx: Sender<Vec<(usize, &mut FuncOut)>>,
) {
    loop {
        let start = next.fetch_add(CHUNK, std::sync::atomic::Ordering::Relaxed);
        if start >= jobs.len() {
            return;
        }
        let mut k = start;
        let mut done: Vec<(usize, &mut FuncOut)> = Vec::new();
        while k < start + CHUNK && k < jobs.len() {
            let j = order[k];
            let job = &mut jobs[j];
            w.gen_func(job.grp, job.f, job.sym.clone());
            done.push((j, w.outs.pop().unwrap()));
            k += 1;
        }
        let _ = tx.send(done);
    }
}

// Whether t is its own concrete type in every instance: no type
// parameters, projections or opaque types in it (read only: types never
// change).
fn ground(t: &Type) -> bool {
    match t.kind {
        types::K_PARAM
        | types::K_PROJ
        | types::K_OPAQUE
        | types::K_DYN
        | types::K_INFER
        | types::K_CONST => false,
        types::K_REF | types::K_PTR | types::K_SLICE => ground(t.el()),
        types::K_ARRAY => t.ret.is_none() && ground(t.el()),
        types::K_TUPLE => ground_list(&t.elems),
        types::K_FN => ground_list(&t.elems) && ground(t.ret.unwrap()),
        types::K_ADT => ground_list(&t.args),
        _ => true,
    }
}

fn ground_list(ts: &Vec<&Type>) -> bool {
    for t in ts.iter() {
        if !ground(*t) {
            return false;
        }
    }
    true
}

// %S<k> (1, k) or %L<k> (2, k); (0, 0) for a symbol.
fn placeholder_index(s: &String) -> (u8, usize) {
    let b = s.as_bytes();
    if b.len() < 3 || b[0] != b'%' {
        return (0, 0);
    }
    let mut k = 0usize;
    let mut i = 2;
    while i < b.len() {
        k = k * 10 + (b[i] - b'0') as usize;
        i += 1;
    }
    (if b[1] == b'S' { 1 } else { 2 }, k)
}

impl Gen {
    fn errorf(&mut self, msg: String) {
        self.errs.push(msg);
    }

    /// A generator for a worker thread (sharing the plan, the statics and
    /// the closure symbols, read only).
    fn worker_gen(
        &mut self,
        m: &mut dyn Machine,
        arch: &str,
        ids: HashMap<String, u32>,
    ) -> &mut Gen {
        let w = new_gen(
            self.p,
            arch,
            m,
            self.tgt.clone(),
            self.dwarf,
            self.lock,
            self.loc_ty,
        );
        w.worker = true;
        // Its own layouts (the type context and the type checker's queries
        // are safe to share while ctx.par is set).
        w.lay = layout::new_computer(self.p.info);
        w.statics = self.statics;
        w.closure = self.closure;
        // The symbol numbers before any function is placed (the main
        // thread numbers more while the workers run).
        w.main_ids = ids;
        w
    }

    /// Places a worker's function in the text section.
    fn merge(&mut self, out: &mut FuncOut) {
        for e in out.errs.iter() {
            self.errorf(e.clone());
        }
        if out.failed {
            return;
        }
        // Each string and location of the function gets its symbol number
        // once; relocations refer to them by index.
        let mut strs: Vec<u32> = Vec::new();
        for s in out.strs.iter() {
            let id = match self.str_ids.get(s) {
                Some(i) => *i,
                None => {
                    let sym = self.p.str_sym(s);
                    let i = self.o.id_s(&sym);
                    self.str_ids.insert(s.clone(), i);
                    i
                }
            };
            strs.push(id);
        }
        let mut locs: Vec<u32> = Vec::new();
        for l in out.locs.iter() {
            let id = match self.loc_ids.get(&l.sym) {
                Some(i) => *i,
                None => {
                    let sym = self.loc_at(l.file.as_str(), l.line, l.col);
                    let i = self.o.id_s(&sym);
                    self.loc_ids.insert(l.sym.clone(), i);
                    i
                }
            };
            locs.push(id);
        }
        for u in out.undef.iter() {
            self.o.undefined(u.as_str());
        }
        for l in out.libs.iter() {
            self.o.import_from(l.0.as_str(), l.1.as_str());
        }
        let align = if self.o.arch == "amd64" {
            16
        } else if self.o.arch == "wasm32" {
            1
        } else {
            4
        };
        let off = self.o.define(out.sym.as_str(), obj::TEXT, align, false);
        let rsym = `${out.sym}.r`.to_string();
        self.o
            .define_at(rsym.as_str(), obj::TEXT, off + out.reg_off as u64, false);
        if out.c_off >= 0 {
            let csym = `${out.sym}.c`.to_string();
            self.o
                .define_at(csym.as_str(), obj::TEXT, off + out.c_off as u64, false);
        }
        self.o.append(obj::TEXT, out.code.as_slice());
        if out.frame >= 0 {
            self.o
                .frames
                .push((off, out.code.len() as u64, out.frame as u64));
        }
        if out.meta.len() > 0 {
            let mo = self.fmeta.len() as u64;
            for w in out.meta.iter() {
                let mut b = 0;
                while b < 8 {
                    self.fmeta.push((*w >> (8 * b) as u32) as u8);
                    b += 1;
                }
            }
            self.ftab.push((off, out.code.len() as u64, mo));
        }
        if self.dwarf {
            self.o.funcs.push(obj::FuncRange {
                name: out.name.clone(),
                off,
                size: out.code.len() as u64,
            });
            for (o, f, line) in out.lines.iter() {
                let fi = self.o.file_id(&f.name);
                self.o.lines.push(obj::Line {
                    off: off + *o,
                    file: fi,
                    line: *line,
                });
            }
        }
        for r in out.relocs.iter() {
            let id = if r.id >= 0 {
                r.id as u32
            } else if r.ph == 1 {
                strs[r.ix]
            } else if r.ph == 2 {
                locs[r.ix]
            } else {
                self.o.id_s(&r.name)
            };
            self.o.reloc_id(obj::TEXT, off as u32 + r.off, r.kind, id);
        }
    }

    /// A worker's emit_func: the function goes to outs.
    fn emit_out(&mut self, sym: &str) {
        let c = self.m.finish();
        let name = if self.cur_name.len() > 0 {
            self.cur_name.clone()
        } else {
            sym.to_string()
        };
        // (The names are shared with the machine's relocations.)
        let mut relocs: Vec<OutReloc> = Vec::with_capacity(c.relocs.len());
        for r in c.relocs.iter() {
            let (ph, ix) = placeholder_index(&r.sym);
            if ph > 0 {
                relocs.push(OutReloc {
                    off: r.off,
                    kind: r.kind,
                    id: -1,
                    ph,
                    ix,
                    name: r.sym,
                });
                continue;
            }
            let id = match self.main_ids.get(&r.sym) {
                Some(i) => *i as i64,
                None => -1,
            };
            relocs.push(OutReloc {
                off: r.off,
                kind: r.kind,
                id,
                ph: 0,
                ix: 0,
                name: r.sym,
            });
        }
        let meta = self.finish_meta(&c.calls);
        let reg_off = self.cur_reg_off;
        self.cur_reg_off = 0;
        let c_off = self.cur_c_off;
        self.cur_c_off = -1;
        let out = &mut FuncOut {
            sym: sym.to_string(),
            frame: c.frame,
            reg_off,
            c_off,
            name,
            code: c.code,
            relocs,
            lines: Vec::new(),
            meta,
            file: self.cur_file,
            strs: self.fstrs,
            locs: self.flocs,
            undef: self.fundef,
            libs: self.flibs,
            errs: self.errs,
            failed: false,
        };
        if c.err.len() > 0 {
            out.errs.push(`${sym}: ${c.err}`.to_string());
            out.failed = true;
        }
        if self.dwarf {
            for (o, f, pos) in self.cur_lines.iter() {
                out.lines.push((*o as u64, *f, f.line_of(*pos)));
            }
        }
        self.cur_lines = Vec::new();
        self.cur_file = None;
        self.cur_name = String::new();
        self.fstrs = Vec::new();
        self.fstr_ix = HashMap::new();
        self.flocs = Vec::new();
        self.floc_ix = HashMap::new();
        self.floc_pos = HashMap::new();
        self.fundef = Vec::new();
        self.flibs = Vec::new();
        self.errs = Vec::new();
        self.outs.push(out);
    }

    /// The layout of t (cached here; computed under the lock).
    pub fn lay_of(&mut self, t: &Type) -> &mut Layout {
        if let Some(l) = self.lays.get(&t.id) {
            return *l;
        }
        let l = self.lay.of(t);
        self.lays.insert(t.id, l);
        l
    }

    pub fn field_types(&mut self, t: &Type, variant: i64) -> Vec<&Type> {
        let k = (t.id as u64) << 24 | (variant + 1) as u64;
        if let Some(r) = self.ftypes.get(&k) {
            return *r;
        }
        let r = self.lay.field_types(t, variant);
        self.ftypes.insert(k, r);
        r
    }

    fn hidden_of(&mut self, t: &Type) -> Option<&Type> {
        self.p.info.hidden_of(t)
    }

    fn concrete(&mut self, i: &Inst, t: &Type) -> &Type {
        if ground(t) {
            return t;
        }
        i.concrete(self.p.info, t)
    }

    fn fn_sig_of(&mut self, d: &mut Def) -> &mut types::FnSig {
        self.p.info.fn_sig_of(d)
    }

    /// Places the machine's current function in the text section.
    fn emit_func(&mut self, sym: &str, global: bool) {
        if self.worker {
            self.emit_out(sym);
            return;
        }
        let c = self.m.finish();
        if c.err.len() > 0 {
            self.errorf(`${sym}: ${c.err}`.to_string());
            return;
        }
        let align = if self.o.arch == "amd64" {
            16
        } else if self.o.arch == "wasm32" {
            1
        } else {
            4
        };
        let off = self.o.define(sym, obj::TEXT, align, global);
        let rsym = `${sym}.r`.to_string();
        self.o.define_at(
            rsym.as_str(),
            obj::TEXT,
            off + self.cur_reg_off as u64,
            false,
        );
        self.cur_reg_off = 0;
        if self.cur_c_off >= 0 {
            let csym = `${sym}.c`.to_string();
            self.o
                .define_at(csym.as_str(), obj::TEXT, off + self.cur_c_off as u64, false);
            self.cur_c_off = -1;
        }
        self.o.append(obj::TEXT, c.code.as_slice());
        if c.frame >= 0 {
            self.o
                .frames
                .push((off, c.code.len() as u64, c.frame as u64));
        }
        if self.dwarf {
            let name = if self.cur_name.len() > 0 {
                self.cur_name.clone()
            } else {
                sym.to_string()
            };
            self.o.funcs.push(obj::FuncRange {
                name,
                off,
                size: c.code.len() as u64,
            });
            for (o, f, pos) in self.cur_lines.iter() {
                let fi = self.o.file_id(&f.name);
                self.o.lines.push(obj::Line {
                    off: off + *o as u64,
                    file: fi,
                    line: f.line_of(*pos),
                });
            }
            self.cur_lines = Vec::new();
            self.cur_file = None;
            self.cur_name = String::new();
        }
        for r in c.relocs.iter() {
            self.o
                .reloc(obj::TEXT, off as u32 + r.off, r.kind, r.sym.as_str());
        }
    }

    /// The symbol of a C function, declared undefined.
    fn extern_sym(&mut self, name: &str) -> String {
        let sym = `${self.tgt.c_prefix}${name}`.to_string();
        if self.worker {
            self.fundef.push(sym.clone());
        } else {
            self.o.undefined(sym.as_str());
        }
        // (wasm: the functions the compiler calls itself are the glue's,
        // module navi.)
        if self.tgt.wasm {
            self.set_lib(sym.as_str(), "wasm:navi");
        }
        sym
    }

    fn set_lib(&mut self, sym: &str, lib: &str) {
        if self.worker {
            self.flibs.push((sym.to_string(), lib.to_string()));
        } else {
            self.o.import_from(sym, lib);
        }
    }

    /// The symbol of an extern function, declared undefined with its
    /// library.
    fn extern_def_sym(&mut self, d: &Def) -> String {
        let sym = self.extern_sym(link_name(d).as_str());
        // (wasm: an extern block without #[link(wasm_import_module)] imports
        // from env, as Rust's.)
        if self.tgt.wasm && d.link.len() == 0 {
            self.set_lib(sym.as_str(), "wasm:env");
        }
        if d.link.len() > 0 {
            if self.worker {
                self.flibs.push((sym.clone(), d.link.clone()));
            } else {
                self.o.import_from(sym.as_str(), d.link.as_str());
            }
        }
        sym
    }

    /// The symbol of a static Location.
    fn loc(&mut self, file: Option<&File>, pos: Pos) -> String {
        match file {
            Some(f) => {
                // A worker finds a location it has without formatting it.
                if self.worker {
                    let key = (self.file_number(&f.name) as u64) << 32 | pos as u64;
                    if let Some(k) = self.floc_pos.get(&key) {
                        return self.placeholder(2, *k);
                    }
                    let ps = f.position(pos);
                    let p = self.loc_at(ps.file.as_str(), ps.line as i64, ps.col as i64);
                    self.floc_pos.insert(key, self.flocs.len() - 1);
                    return p;
                }
                let ps = f.position(pos);
                self.loc_at(ps.file.as_str(), ps.line as i64, ps.col as i64)
            }
            None => self.loc_at("<unknown>", 0, 0),
        }
    }

    fn loc_at(&mut self, file: &str, line: i64, col: i64) -> String {
        let key = `${file}:${line}:${col}`.to_string();
        if self.worker {
            if let Some(k) = self.floc_ix.get(&key) {
                return self.placeholder(2, *k);
            }
            let k = self.flocs.len();
            self.floc_ix.insert(key, k);
            // sym: the key, for merge.
            self.flocs.push(LocData {
                sym: key.clone(),
                file: file.to_string(),
                line,
                col,
            });
            return self.placeholder(2, k);
        }
        if let Some(s) = self.locs.get(&key) {
            return s.clone();
        }
        let s = `_navi_loc${self.locs.len()}`.to_string();
        self.locs.insert(key, s.clone());
        self.loc_list.push(LocData {
            sym: s.clone(),
            file: file.to_string(),
            line,
            col,
        });
        self.p.str_sym(&file.as_bytes().to_vec());
        s
    }

    fn str_sym(&mut self, s: &str) -> String {
        self.str_bytes(&s.as_bytes().to_vec())
    }

    fn str_bytes(&mut self, b: &Vec<u8>) -> String {
        if !self.worker {
            return self.p.str_sym(b);
        }
        if let Some(k) = self.fstr_ix.get(b) {
            return self.placeholder(1, *k);
        }
        let k = self.fstrs.len();
        self.fstr_ix.insert(b.clone(), k);
        self.fstrs.push(b.clone());
        self.placeholder(1, k)
    }

    // %S<k> (kind 1) or %L<k> (2), made once for each k.
    fn placeholder(&mut self, kind: u8, k: usize) -> String {
        let mut v = if kind == 1 { self.ph_s } else { self.ph_l };
        while v.len() <= k {
            let n = v.len();
            v.push(if kind == 1 {
                `%S${n}`.to_string()
            } else {
                `%L${n}`.to_string()
            });
        }
        v[k]
    }

    fn file_number(&mut self, name: &String) -> u32 {
        if let Some(n) = self.file_no.get(name) {
            return *n;
        }
        let n = self.file_no.len() as u32;
        self.file_no.insert(name.clone(), n);
        n
    }

    // The symbol of a file's name (as str_sym), found once per file.
    fn file_name_sym(&mut self, name: &String) -> String {
        if !self.worker {
            if let Some(s) = self.file_sym.get(name) {
                return *s;
            }
            let s = self.str_sym(name.as_str());
            self.file_sym.insert(name.clone(), s);
            return s;
        }
        self.str_sym(name.as_str())
    }

    // The stack map of the function just made: its frame part (stack_meta)
    // and each call's return offset and saved-register pointer mask.
    fn finish_meta(&mut self, calls: &Vec<u64>) -> Vec<u64> {
        let mut fm = self.cur_meta;
        self.cur_meta = Vec::new();
        if fm.len() == 0 {
            return fm;
        }
        // Each call: (return offset / code unit) << 9 | mask, two in a word.
        fm.push(calls.len() as u64);
        let mut half = 0u64;
        let mut ci = 0;
        while ci < calls.len() {
            let c = calls[ci];
            let ret = c >> 32;
            let tag = (c & 0xffffffff) as i64 - 1;
            let mask = if tag < 0 || tag as usize >= self.cur_masks.len() {
                self.cur_all
            } else {
                self.cur_masks[tag as usize] as u64
            };
            let e = (ret / self.tgt.code_unit) << 9 | mask;
            if ci % 2 == 0 {
                half = e;
            } else {
                fm.push(half | e << 32);
            }
            ci += 1;
        }
        if calls.len() % 2 == 1 {
            fm.push(half);
        }
        // Flag 4: the four words after the calls say where this function's
        // parameters are in its caller's outgoing area and its result in the
        // caller's buffer, with their pointer words (a map an older compiler
        // made has none).
        fm[1] = fm[1] | 4;
        fm.push(self.cur_argw);
        fm.push(self.cur_argmask);
        fm.push(self.cur_retw);
        fm.push(self.cur_retmask);
        fm
    }

    /// Writes strings, locations, dictionaries, vtables and statics.
    fn gen_data(&mut self) {
        // The stack maps by code address: [count, the text's start, where
        // the maps start (from the table), then for each function by
        // address its offset in the text, size and map offset (u32 each)],
        // then the maps.
        let off = self.o.define("_navi_ftab", obj::DATA_CONST, 8, false);
        let mut t: Vec<u8> = Vec::new();
        let n = self.ftab.len();
        let mut b = 0;
        while b < 24 {
            t.push(if b < 8 {
                ((n as u64) >> (8 * b) as u32) as u8
            } else {
                0
            });
            b += 1;
        }
        for e in self.ftab.iter() {
            let (fo, size, mo) = *e;
            for v in [fo, size, mo].iter() {
                let mut k = 0;
                while k < 4 {
                    t.push((*v >> (8 * k) as u32) as u8);
                    k += 1;
                }
            }
        }
        while t.len() % 8 != 0 {
            t.push(0);
        }
        let moff = t.len() as u64;
        let mut b2 = 0;
        while b2 < 8 {
            t[16 + b2] = (moff >> (8 * b2) as u32) as u8;
            b2 += 1;
        }
        self.o.append(obj::DATA_CONST, t.as_slice());
        self.o.append(obj::DATA_CONST, self.fmeta.as_slice());
        self.o
            .reloc(obj::DATA_CONST, (off + 8) as u32, obj::ABS64, "_navi_text0");
        // Locations: { file: &str, line: u32, col: u32 }.
        let loc_def = self.p.info.lang_def("Location").unwrap();
        let loc_ty = self.p.info.ctx.adt(loc_def, Vec::new());
        let ll = self.lay.of(loc_ty);
        let mut li = 0;
        while li < self.loc_list.len() {
            let l = &self.loc_list[li];
            let off = self.o.define(l.sym.as_str(), obj::DATA_CONST, 8, false);
            let mut buf = zeros(ll.size);
            put_u64(&mut buf, (ll.fields[0] + 8) as usize, l.file.len() as u64);
            put_u32(&mut buf, ll.fields[1] as usize, l.line as u32);
            put_u32(&mut buf, ll.fields[2] as usize, l.col as u32);
            self.o.append(obj::DATA_CONST, buf.as_slice());
            let fs = self.p.str_sym(&l.file.as_bytes().to_vec());
            self.o.reloc(
                obj::DATA_CONST,
                (off + ll.fields[0] as u64) as u32,
                obj::ABS64,
                fs.as_str(),
            );
            li += 1;
        }
        // Dictionaries: [code, ctx] per slot (vtables: [vtable, 0]).
        for grp in self.p.groups.iter() {
            if grp.external {
                continue;
            }
            for inst in grp.insts.iter() {
                let off = self.o.define(inst.dict.as_str(), obj::DATA_CONST, 8, false);
                let n = grp.nslots as i64;
                if n == 0 {
                    self.o.zeros(obj::DATA_CONST, 8);
                    continue;
                }
                self.o.zeros(obj::DATA_CONST, 16 * n);
                let entries = self.p.dict_entries(*inst);
                let mut i = 0;
                while i < entries.len() {
                    let at = off as u32 + (16 * i) as u32;
                    match &entries[i] {
                        DictEntry::Target(t) => self.target_words(at, *t),
                        DictEntry::Vtable(v) => {
                            self.o
                                .reloc(obj::DATA_CONST, at, obj::ABS64, v.sym.as_str())
                        }
                    }
                    i += 1;
                }
            }
        }
        // Vtables: [code, ctx] per dyn method.
        let mut vts: Vec<&mut Vtable> = self.p.vtable_list.clone();
        vts.sort_by(|a, b| a.sym.cmp(&b.sym));
        for v in vts.iter() {
            let off = self.o.define(v.sym.as_str(), obj::DATA_CONST, 8, false);
            self.o
                .zeros(obj::DATA_CONST, 16 * v.methods.len() as i64 + 8);
            let mut i = 0;
            while i < v.methods.len() {
                self.target_words(off as u32 + (16 * i) as u32, v.methods[i]);
                if i < v.keys.len() {
                    self.o.reloc(
                        obj::DATA_CONST,
                        off as u32 + (16 * i) as u32,
                        obj::DYN_SLOT,
                        v.keys[i].as_str(),
                    );
                }
                i += 1;
            }
        }
        self.gen_descs();
        self.gen_asm();
        // Writable data: the stack top, then the statics (zero-initialized;
        // the entry point runs their initializers). The collector scans from
        // _navi_data_start to _navi_data_end.
        self.o.define("_navi_data_start", obj::DATA, 8, false);
        // (A crate compiled alone has statics only: the program's object
        // has the runtime's words.)
        if self.p.library.len() == 0 {
            for sym in [
                "_navi_stack_top",
                "_navi_stack_lo",
                "_navi_os_sp",
                "_navi_argc",
                "_navi_argv",
                "_navi_saved_greg",
                "_navi_gc_marking",
                "_navi_tls_key",
            ]
            .iter()
            {
                self.o.define(*sym, obj::DATA, 8, false);
                self.o.zeros(obj::DATA, 8);
            }
            // The G record in use before the scheduler starts (no stack limit).
            self.o.define("_navi_g0boot", obj::DATA, 16, false);
            self.o.zeros(obj::DATA, 512);
        }
        for d in self.p.statics.iter() {
            let ty = self.p.info.consts[&d.id].ty;
            let l = self.lay.of(ty);
            let size = if l.size > 0 { l.size } else { 8 };
            let sym = self.statics[&d.id].clone();
            self.o.define(sym.as_str(), obj::DATA, 8, false);
            self.o.zeros(obj::DATA, size);
        }
        self.o.define("_navi_data_end", obj::DATA, 8, false);
        self.o.zeros(obj::DATA, 8);
        // Strings last: code generation adds file names.
        let mut strs: Vec<(String, Vec<u8>)> = Vec::new();
        for s in self.p.string_list.iter() {
            strs.push((self.p.strings[s].clone(), s.clone()));
        }
        strs.sort_by(|a, b| a.0.cmp(&b.0));
        for s in strs.iter() {
            self.o.define(s.0.as_str(), obj::RO_DATA, 1, false);
            self.o.append(obj::RO_DATA, s.1.as_slice());
            self.o.zeros(obj::RO_DATA, 1);
        }
    }

    /// The #[asm] functions of the crate compiled (crate::asm): each
    /// module's <file>_<arch>.s assembled, its functions defined by their
    /// symbols (asm_sym). (Every one: merging drops those not called.)
    fn gen_asm(&mut self) {
        let mut names: Vec<String> = Vec::new();
        let mut decls: HashMap<String, Vec<&mut Def>> = HashMap::new();
        for d in self.p.info.res.defs.iter() {
            if d.kind != crate::resolve::DEF_FN && d.kind != crate::resolve::DEF_ASSOC_FN {
                continue;
            }
            if !codegen::fn_has_attr(*d, "asm") {
                continue;
            }
            if self.p.library.len() > 0 && d.krate.name != self.p.library {
                continue;
            }
            if let Some(x) = self.p.mir.ext {
                if x.crates.contains_key(&d.krate.name) {
                    continue;
                }
            }
            let f = match d.file {
                Some(f) => f,
                None => continue,
            };
            if !decls.contains_key(&f.name) {
                names.push(f.name.clone());
                decls.insert(f.name.clone(), Vec::new());
            }
            decls.get_mut(&f.name).unwrap().push(*d);
        }
        names.sort();
        for name in names.iter() {
            let ds = decls[name].clone();
            let c = ds[0].krate;
            // The file's path (its name is the crate's directory and the path
            // in the crate).
            let prefix = `${c.dir}/`.to_string();
            let path = if name.starts_with("/") || c.fs_root.len() == 0 {
                name.clone()
            } else if name.starts_with(prefix.as_str()) {
                crate::util::path_join(c.fs_root.as_str(), &name[prefix.len()..])
            } else {
                name.clone()
            };
            let stem = if path.ends_with(".navi") {
                path[..path.len() - 5].to_string()
            } else {
                path.clone()
            };
            let spath = `${stem}_${self.o.arch}.s`.to_string();
            let src = match crate::cache::read_source(spath.as_str()) {
                Ok(s) => s,
                Err(e) => {
                    self.errorf(`${name}: #[asm] fn ${ds[0].name}: ${spath}: ${e}`.to_string());
                    continue;
                }
            };
            crate::cache::note(spath.as_str(), &src);
            let funcs = match crate::asm::assemble(self.o.arch.as_str(), src.as_str()) {
                Ok(f) => f,
                Err(errs) => {
                    for e in errs.iter() {
                        self.errorf(`${spath}:${e.line}: ${e.msg}`.to_string());
                    }
                    continue;
                }
            };
            for f in funcs.iter() {
                let mut decl: Option<&mut Def> = None;
                for d in ds.iter() {
                    if d.name == f.name {
                        decl = Some(*d);
                    }
                }
                let d = match decl {
                    Some(d) => d,
                    None => {
                        self.errorf(
                            `${spath}:${f.line}: ${f.name} is not an #[asm] fn of ${name}`
                                .to_string(),
                        );
                        continue;
                    }
                };
                let sym = asm_sym(d);
                let off = self.o.define(sym.as_str(), obj::TEXT, 16, false);
                self.o.append(obj::TEXT, f.code.as_slice());
                if self.dwarf {
                    self.o.funcs.push(obj::FuncRange {
                        name: d.name.clone(),
                        off,
                        size: f.code.len() as u64,
                    });
                }
                for r in f.relocs.iter() {
                    self.o
                        .reloc(obj::TEXT, off as u32 + r.off, r.kind, r.sym.as_str());
                }
            }
            for d in ds.iter() {
                let mut found = false;
                for f in funcs.iter() {
                    if f.name == d.name {
                        found = true;
                    }
                }
                if !found {
                    self.errorf(`${name}: #[asm] fn ${d.name} is not in ${spath}`.to_string());
                }
            }
        }
    }

    /// Type descriptors (type_desc::<T>()), 5 words each: kind, size,
    /// align, name (pointer, length). std::any::type_name reads the name,
    /// std::unique takes the address for the type.
    fn gen_descs(&mut self) {
        let mut ds: Vec<&mut codegen::Desc> = self.p.desc_list.clone();
        ds.sort_by(|a, b| a.sym.cmp(&b.sym));
        for d in ds.iter() {
            if d.info.len() > 0 {
                // A TypeInfo: the string's pointer and length.
                let mut buf = zeros(16);
                put_u64(&mut buf, 8, d.info.len() as u64);
                let off = self.o.define(d.sym.as_str(), obj::DATA_CONST, 8, false);
                self.o.append(obj::DATA_CONST, buf.as_slice());
                let ns = self.p.str_sym(&d.info.as_bytes().to_vec());
                self.o
                    .reloc(obj::DATA_CONST, off as u32, obj::ABS64, ns.as_str());
                continue;
            }
            let t = d.ty;
            let l = self.lay.of(t);
            let name = `${t}`.to_string();
            let mut buf = zeros(40);
            put_u64(&mut buf, 0, self.desc_kind(t));
            put_u64(&mut buf, 8, if l.unsized { 0 } else { l.size as u64 });
            put_u64(&mut buf, 16, l.align as u64);
            put_u64(&mut buf, 32, name.len() as u64);
            let off = self.o.define(d.sym.as_str(), obj::DATA_CONST, 8, false);
            self.o.append(obj::DATA_CONST, buf.as_slice());
            let ns = self.p.str_sym(&name.as_bytes().to_vec());
            self.o
                .reloc(obj::DATA_CONST, (off + 24) as u32, obj::ABS64, ns.as_str());
        }
    }

    // The kind a descriptor records.
    fn desc_kind(&mut self, t: &Type) -> u64 {
        let k = t.kind;
        if k == types::K_BOOL {
            return DK_BOOL;
        }
        if k == types::K_CHAR {
            return DK_CHAR;
        }
        if k == types::K_INT {
            return DK_INT0 + t.int as u64;
        }
        if k == types::K_FLOAT {
            return if t.f64 { DK_F64 } else { DK_F32 };
        }
        if k == types::K_STR {
            return DK_STR;
        }
        if k == types::K_TUPLE {
            return DK_TUPLE;
        }
        if k == types::K_ARRAY {
            return DK_ARRAY;
        }
        if k == types::K_SLICE {
            return DK_SLICE;
        }
        if k == types::K_REF {
            return DK_REF;
        }
        if k == types::K_PTR {
            return DK_PTR;
        }
        if k == types::K_FN {
            return DK_FN;
        }
        if k == types::K_DYN {
            return DK_DYN;
        }
        if k == types::K_ADT {
            if self.p.is_lang(t, "String") {
                return DK_STRING;
            }
            if self.p.is_lang(t, "Vec") {
                return DK_VEC;
            }
            return if self.p.info.adts[&t.d().id].is_enum {
                DK_ENUM
            } else {
                DK_STRUCT
            };
        }
        DK_OTHER
    }

    fn target_words(&mut self, at: u32, t: &Target) {
        match t.kind {
            codegen::T_INST => {
                let i = t.inst.unwrap();
                self.o
                    .reloc(obj::DATA_CONST, at, obj::ABS64, i.grp().sym.as_str());
                self.o
                    .reloc(obj::DATA_CONST, at + 8, obj::ABS64, i.dict.as_str());
            }
            codegen::T_INTRINSIC => {
                if t.intrinsic == "type_desc" || t.intrinsic == "type_info" {
                    let k = if t.intrinsic == "type_info" {
                        codegen::info_key(t.type_args[0])
                    } else {
                        t.type_args[0].id
                    };
                    let d = self.p.descs[&k];
                    self.o
                        .reloc(obj::DATA_CONST, at, obj::ABS64, d.sym.as_str());
                } else if t.intrinsic == "extern" {
                    let s = self.extern_def_sym(t.def);
                    self.o.reloc(obj::DATA_CONST, at, obj::ABS64, s.as_str());
                } else if t.intrinsic != "unreachable" {
                    self.errorf(
                        `intrinsic ${t.intrinsic} cannot be called dynamically`.to_string(),
                    );
                }
            }
            _ => {
                self.errorf("virtual call target in a dictionary".to_string());
            }
        }
    }

    /// Writes the C entry point: record the stack top, initialize the
    /// statics, call main, return 0.
    fn gen_main(&mut self) {
        let m = self.m;
        m.begin();
        let main = self.p.main.unwrap();
        let mut ret_size = 32i64;
        let mt = main.concrete(self.p.info, main.func.locals[0].ty);
        let s = self.size_of(Some(mt));
        if s > ret_size {
            ret_size = s;
        }
        let frame = (ret_size + 15) & !15;
        let wasm = self.tgt.wasm;
        // (wasm: a navi function the run loop starts, wasmlink's run()
        // having set SP and stored argc and argv.)
        if wasm {
            m.prologue(frame);
        } else {
            m.entry_prologue(frame);
        }
        // The G register (callee-saved in C: kept for our caller) points to
        // a blank G record until the scheduler starts.
        m.adr_sym(I1, &"_navi_saved_greg".to_string());
        m.store(8, GREG, I1, 0);
        m.adr_sym(GREG, &"_navi_g0boot".to_string());
        m.adr_sym(I1, &"_navi_stack_top".to_string());
        m.store(8, FP, I1, 0);
        let main_loc = self.loc_at("<main>", 0, 0);
        // Keep argc and argv for std::rt::native::set_args (called after the
        // statics are initialized).
        if !wasm {
            m.entry_args();
            m.load(8, V1, SP, 0);
            m.adr_sym(I1, &"_navi_argc".to_string());
            m.store(8, V1, I1, 0);
            m.load(8, V1, SP, 8);
            m.adr_sym(I1, &"_navi_argv".to_string());
            m.store(8, V1, I1, 0);
        }
        // The statics of crates compiled separately first (they come before
        // this one: std's runtime among them), then this one's.
        for name in self.p.ext_inits.iter() {
            m.adr_sym(LOC, &main_loc);
            m.call(&crate_init_sym(name.as_str()));
        }
        for d in self.p.statics.iter() {
            let inst = match self.p.static_init.get(&d.id) {
                Some(i) => *i,
                None => continue,
            };
            m.adr_sym(RET, &self.statics[&d.id]);
            m.adr_sym(LOC, &main_loc);
            m.adr_sym(CTX, &inst.dict);
            m.call(&inst.grp().sym);
        }
        let set_args = self.p.runtime[&"set_args".to_string()];
        m.adr_sym(I1, &"_navi_argc".to_string());
        m.load(8, V1, I1, 0);
        m.store(8, V1, SP, 0);
        m.adr_sym(I1, &"_navi_argv".to_string());
        m.load(8, V1, I1, 0);
        m.store(8, V1, SP, 8);
        m.addr_of(RET, SP, 16);
        m.adr_sym(LOC, &main_loc);
        m.adr_sym(CTX, &set_args.dict);
        m.call(&set_args.grp().sym);
        // Create the main green thread and continue on its stack.
        let init = self.p.runtime[&"sched_init".to_string()];
        m.addr_of(RET, SP, 0);
        m.adr_sym(LOC, &main_loc);
        m.adr_sym(CTX, &init.dict);
        m.call(&init.grp().sym);
        m.load(8, V1, SP, 0);
        m.adr_sym(I1, &"_navi_os_sp".to_string());
        m.mov(I2, SP);
        m.store(8, I2, I1, 0);
        m.mov(SP, V1);
        m.add_imm(SP, -frame);
        m.addr_of(RET, SP, 0);
        m.adr_sym(LOC, &main_loc);
        m.adr_sym(CTX, &main.dict);
        m.call(&main.grp().sym);
        // The main G may finish on another OS thread: exit from here.
        m.mov_imm(V1, 0);
        m.store(8, V1, SP, 0);
        let es = self.extern_sym("exit");
        let mut a1 = Vec::new();
        a1.push(int_arg());
        m.call_c(es.as_str(), 0, &a1, false, false, false, 0);
        m.trap();
        let name = if wasm {
            "_navi_entry".to_string()
        } else {
            `${self.tgt.c_prefix}main`.to_string()
        };
        self.emit_func(name.as_str(), true);
    }

    /// Writes the scheduler's routines: the context switch, the start of a
    /// new green thread and the stack overflow handler.
    fn gen_sched(&mut self) {
        let m = self.m;
        let rt_loc = self.loc_at("<runtime>", 0, 0);
        let ms = self.p.runtime[&"morestack".to_string()];
        m.begin();
        m.morestack(ms.grp().sym.as_str(), ms.dict.as_str(), rt_loc.as_str());
        self.emit_func("_navi_morestack", false);

        let mst = self.p.runtime[&"mstart".to_string()];
        m.begin();
        m.mstart(mst.grp().sym.as_str(), mst.dict.as_str(), rt_loc.as_str());
        self.emit_func("_navi_mstart", false);

        m.begin();
        m.poll_stub();
        self.emit_func("_navi_poll", false);

        m.begin();
        m.swap_context();
        self.emit_func("_navi_swapctx", false);

        m.begin();
        m.scan_heap();
        self.emit_func("_navi_scanh", false);

        m.begin();
        m.scan_heap_bits();
        self.emit_func("_navi_scanhb", false);

        m.begin();
        m.set_jmp();
        self.emit_func("_navi_setjmp", false);

        m.begin();
        m.long_jmp();
        self.emit_func("_navi_longjmp", false);

        m.begin();
        let gm = self.p.runtime[&"gmain".to_string()];
        m.add_imm(SP, -32);
        m.addr_of(RET, SP, 0);
        let tl = self.loc_at("<thread>", 0, 0);
        m.adr_sym(LOC, &tl);
        m.adr_sym(CTX, &gm.dict);
        m.call(&gm.grp().sym);
        m.trap();
        self.emit_func("_navi_gstart", false);

        m.begin();
        m.prologue(32);
        let msg = "fatal error: stack overflow\n";
        m.mov_imm(V1, 2);
        m.store(8, V1, SP, 0);
        let ms = self.str_sym(msg);
        m.adr_sym(V1, &ms);
        m.store(8, V1, SP, 8);
        m.mov_imm(V1, msg.len() as i64);
        m.store(8, V1, SP, 16);
        let w = self.tgt.write.clone();
        let ws = self.extern_sym(w.as_str());
        let mut a3 = Vec::new();
        a3.push(int_arg());
        a3.push(int_arg());
        a3.push(int_arg());
        m.call_c(ws.as_str(), 0, &a3, false, false, false, 0);
        m.mov_imm(V1, 2);
        m.store(8, V1, SP, 0);
        let es = self.extern_sym("exit");
        let mut a1 = Vec::new();
        a1.push(int_arg());
        m.call_c(es.as_str(), 0, &a1, false, false, false, 0);
        m.trap();
        self.emit_func("_navi_overflow", false);
    }

    /// wasm: _navi_idle, which goes back to JS, and _navi_jscb, which runs
    /// the Funcs JS calls from inside a call to JS (wasmlink's callback
    /// export; docs/wasm.md).
    fn gen_idle(&mut self) {
        self.m.begin();
        self.m.idle();
        self.emit_func("_navi_idle", false);
        let cb = self.p.runtime[&"js_callback".to_string()];
        let loc = self.loc_at("<js>", 0, 0);
        let m = self.m;
        m.begin();
        m.prologue(32);
        m.addr_of(RET, SP, 0);
        m.adr_sym(LOC, &loc);
        m.adr_sym(CTX, &cb.dict);
        m.call(&cb.grp().sym);
        m.ret();
        self.emit_func("_navi_jscb", true);
    }

    /// Writes _navi_rundefers(CTX = list head).
    fn gen_run_defers(&mut self) {
        self.m.begin();
        self.m.run_defers();
        self.emit_func("_navi_rundefers", false);
    }

    /// A crate compiled alone: the function that initializes its statics
    /// (in order), which the program's entry point calls.
    ///
    /// Each static's initialization is a function of its own (static_init_sym)
    /// the crate's initializer calls: the merging keeps it only if the
    /// program uses the static (calling _navi_init_nop instead), as a
    /// program compiled whole initializes only the statics it uses.
    fn gen_crate_init(&mut self) {
        let m = self.m;
        let loc = self.loc_at("<init>", 0, 0);
        let mut calls: Vec<String> = Vec::new();
        for d in self.p.statics.iter() {
            let inst = match self.p.static_init.get(&d.id) {
                Some(i) => *i,
                None => continue,
            };
            m.begin();
            m.prologue(32);
            m.adr_sym(RET, &self.statics[&d.id]);
            m.adr_sym(LOC, &loc);
            m.adr_sym(CTX, &inst.dict);
            m.call(&inst.grp().sym);
            m.ret();
            let si = static_init_sym(self.statics[&d.id].as_str());
            self.emit_func(si.as_str(), false);
            calls.push(si);
        }
        m.begin();
        m.prologue(32);
        m.ret();
        self.emit_func(INIT_NOP, false);
        m.begin();
        m.prologue(32);
        for si in calls.iter() {
            m.call(si);
        }
        m.ret();
        let sym = crate_init_sym(self.p.library.as_str());
        self.emit_func(sym.as_str(), true);
    }

    fn size_of(&mut self, t: Option<&Type>) -> i64 {
        let ty = match t {
            Some(x) => x,
            None => return 0,
        };
        if ty.kind == types::K_NEVER {
            return 0;
        }
        let l = self.lay_of(ty);
        if l.unsized {
            self.errorf(`size of unsized type ${ty}`.to_string());
            return 0;
        }
        l.size
    }

    /// The symbol of a closure of grp (numbered by generate).
    fn closure_sym(&mut self, grp: &Group, f: &Func) -> String {
        let k = `${grp.sym}/${f.id}`.to_string();
        match self.closure.get(&k) {
            Some(s) => s.clone(),
            None => {
                self.errorf(`no symbol for closure ${k}`.to_string());
                String::new()
            }
        }
    }

    fn gen_func(&mut self, grp: &mut Group, f: &mut Func, sym: String) {
        self.m.begin();
        self.cur_reg_off = 0;
        self.cur_lines = Vec::new();
        self.cur_file = f.file;
        self.cur_name = f.name.clone();
        if self.dwarf {
            if let (Some(d), Some(fl)) = (f.def, f.file) {
                self.cur_lines.push((0, fl, d.pos));
            }
        }
        let fg = &mut FnGen {
            g: self,
            m: self.m,
            grp,
            inst: grp.rep,
            f,
            ltypes: Vec::new(),
            loff: Vec::new(),
            blocks: Vec::new(),
            res_off: 0,
            asm_ret: -1,
            nfixed: -1,
            tmp_off: 0,
            stubs: HashMap::new(),
            stub_list: Vec::new(),
            preg: Vec::new(),
            preg2: Vec::new(),
            saved: Vec::new(),
            concs: HashMap::new(),
            frame: 0,
            buf_top: 0,
            ssa_alloc: crate::ssa::regalloc::empty(),
            ssa_slots: 0,
            ptr_slots: Vec::new(),
            ssa_masks: Vec::new(),
            ssa_var0: false,
            ssa_defers: false,
            ssa_sel0: Vec::new(),
            ssa_sel1: Vec::new(),
            ssa_func: None,
            ssa_chained: Vec::new(),
            ssa_need_carry: Vec::new(),
            ssa_bridge: 0,
            ssa_pr: Vec::new(),
        };
        fg.gen();
        fg.stack_meta();
        if c_entry(f.def) {
            fg.gen_c_entry();
        }
        self.emit_func(sym.as_str(), false);
    }
}

/// Whether d is a navi function with the C ABI (extern "C" fn with a body):
/// its code gets a C entry (sym.c), which is its value.
fn c_entry(d: Option<&mut Def>) -> bool {
    let d = match d {
        Some(d) => d,
        None => return false,
    };
    if d.kind != crate::resolve::DEF_FN && d.kind != crate::resolve::DEF_ASSOC_FN {
        return false;
    }
    match &d.node {
        Node::Item(Item::Fn(f)) => f.abi == "C" && f.body.is_some(),
        _ => false,
    }
}

fn collect_closures(f: &Func, todo: &mut Vec<&mut Func>) {
    for b in f.blocks.iter() {
        for s in b.stmts.iter() {
            if let Stmt::Assign { rv, .. } = s {
                if let Rvalue::Aggregate { closure, .. } = rv {
                    if let Some(c) = closure {
                        todo.push(*c);
                        collect_closures(*c, todo);
                    }
                }
            }
        }
    }
}

/// Out-of-line code emitted after the function body.
enum Stub {
    /// The stack check's slow path (then the check again).
    Overflow(Label, Label, i64),
    /// A loop's check's slow path (then back to the loop).
    Poll(Label, Label),
    /// A panic with a message at a position.
    Panic { label: Label, msg: String, pos: Pos },
}

/// Generates one function body.
pub struct FnGen {
    pub g: &mut Gen,
    m: &mut dyn Machine,
    grp: &mut Group,
    pub inst: &mut Inst,
    pub f: &mut Func,
    pub ltypes: Vec<&Type>,
    /// FP-relative offsets of locals.
    loff: Vec<i64>,
    blocks: Vec<Label>,
    /// The call result buffer.
    res_off: i64,
    /// The local an #[asm] call being made writes its result to (-1: the
    /// result buffer).
    asm_ret: i64,
    /// The named parameters of the variadic C function being called (-1:
    /// not variadic).
    nfixed: i64,
    /// The staging buffer.
    tmp_off: i64,
    stubs: HashMap<String, Label>,
    stub_list: Vec<Stub>,
    /// The register of each local kept in one (-1: in the frame).
    preg: Vec<i64>,
    /// The second register of a promoted fat pointer (its length or
    /// vtable), or -1.
    preg2: Vec<i64>,
    /// The saved registers used, with their save slots.
    saved: Vec<(Reg, i64)>,
    /// conc's results, by type id.
    concs: HashMap<u32, &Type>,
    /// The frame's size, and where (from FP) the saved registers end: below
    /// are the buffers and the outgoing area (any word may be a pointer).
    frame: i64,
    buf_top: i64,
    /// The SSA backend's state: whether it made this function, its
    /// allocation, where the spill slots start, the pointer slots, the
    /// calls' masks, whether the result is a variable and whether the
    /// function defers calls.
    ssa_alloc: &mut crate::ssa::regalloc::Alloc,
    ssa_slots: i64,
    ptr_slots: Vec<i64>,
    ssa_masks: Vec<u16>,
    ssa_var0: bool,
    ssa_defers: bool,
    /// The carry plan (ssa_carry_plan), by value id: an AddC/SubB's
    /// selects (-1: none), whether its carry comes in the flags and
    /// whether its carry out is read as a value.
    ssa_sel0: Vec<i64>,
    ssa_sel1: Vec<i64>,
    ssa_func: Option<&mut crate::ssa::Func>,
    ssa_chained: Vec<bool>,
    ssa_need_carry: Vec<bool>,
    /// The area where operands for the old helpers are put (bridge).
    ssa_bridge: i64,
    /// By local: the first argument register its parameter comes in (-1:
    /// on the stack only).
    ssa_pr: Vec<i64>,
}

fn is_signed(t: &Type) -> bool {
    t.kind == types::K_INT && types::int_signed(t.int)
}

impl FnGen {
    pub fn conc(&mut self, t: &Type) -> &Type {
        if let Some(c) = self.concs.get(&t.id) {
            return *c;
        }
        let mut c = self.g.concrete(self.inst, t);
        if c.kind == types::K_OPAQUE {
            if let Some(h) = self.g.hidden_of(c) {
                c = self.conc(h);
            }
        }
        self.concs.insert(t.id, c);
        c
    }

    fn conc_opt(&mut self, t: Option<&Type>) -> Option<&Type> {
        match t {
            Some(x) => Some(self.conc(x)),
            None => None,
        }
    }

    pub fn size(&mut self, t: &Type) -> i64 {
        self.g.size_of(Some(t))
    }

    /// Generates the function with the SSA backend if it can.
    fn try_ssa(&mut self) -> bool {
        let t0 = if self.g.ssa_time {
            Some(std::time::Instant::now())
        } else {
            None
        };
        let built = crate::backend::ssagen::build(self);
        if let Some(t) = t0 {
            crate::backend::ssagen::add_time(0, t.elapsed().as_nanos() as u64);
        }
        let sf = match built {
            Ok(sf) => sf,
            Err(why) => {
                self.g
                    .errorf(`${self.f.name}: SSA form not built: ${why}`.to_string());
                return false;
            }
        };
        // -d ssacheck: check the form as built; -d ssadump: print it.
        let dump = self.g.ssa_dump.len() > 0 && self.f.name.contains(self.g.ssa_dump.as_str());
        if (self.g.ssa_check > 0 && self.g.ssa_check != 3) || dump {
            let errs = crate::ssa::check::check(sf);
            if errs.len() > 0 {
                eprintln(`ssa ${self.f.name}: invalid:\n${errs}${sf.to_string()}`);
            } else if dump {
                eprintln(sf.to_string());
            }
        }
        if let Err(why) = self.ssa_supported(sf) {
            if self.g.ssa_check == 2 {
                eprintln(`ssa ${self.f.name}: not generated: ${why}`);
            }
            crate::backend::ssagen::count(false);
            crate::ssa::recycle(sf);
            return false;
        }
        crate::backend::ssagen::count(true);
        self.ssa_var0 = sf.is_var[0];
        self.ssa_defers = false;
        for b in sf.blocks.iter() {
            for v in b.values.iter() {
                if v.op == crate::ssa::OP_DEFER {
                    self.ssa_defers = true;
                }
            }
        }
        self.gen_ssa(sf);
        crate::ssa::recycle(sf);
        true
    }

    /// The first local passed on the stack (closures receive the
    /// environment in CTX).
    pub fn first_arg(&self) -> usize {
        if self.f.closure { 2 } else { 1 }
    }

    fn gen(&mut self) {
        let m = self.m;
        let f = self.f;
        m.set_tag(0);
        let n = f.locals.len();
        let mut i = 0;
        while i < n {
            let t = self.conc(f.locals[i].ty);
            self.ltypes.push(t);
            self.loff.push(0);
            i += 1;
        }
        // Incoming arguments.
        let mut off = 16i64;
        i = self.first_arg();
        while i <= f.nargs {
            self.loff[i] = off;
            off += round8(self.size(self.ltypes[i]));
            i += 1;
        }
        if !self.try_ssa() {
            self.g.errorf(`${self.f.name}: not compiled`.to_string());
        }
    }

    // --- Places --------------------------------------------------------------

    fn local_addr(&mut self, r: Reg, l: usize) {
        self.m.addr_of(r, FP, self.loff[l]);
    }

    /// The register holding local l as a whole value, if promoted.
    fn promoted(&self, pl: &Place) -> Option<Reg> {
        if pl.proj.len() == 0 && self.preg[pl.local] >= 0 {
            return Some(self.preg[pl.local] as Reg);
        }
        None
    }

    /// The second register of a promoted fat pointer local.
    fn promoted2(&self, pl: &Place) -> Option<Reg> {
        if pl.proj.len() == 0 && self.preg2[pl.local] >= 0 {
            return Some(self.preg2[pl.local] as Reg);
        }
        None
    }

    /// Stores a promoted local's registers (one or two words) at base + off.
    fn store_promoted(&mut self, pl: &Place, size: i64, base: Reg, off: i64) {
        let pr = self.promoted(pl).unwrap();
        if let Some(p2) = self.promoted2(pl) {
            self.m.store(8, pr, base, off);
            self.m.store(8, p2, base, off + 8);
        } else {
            self.m.store(size, pr, base, off);
        }
    }

    /// The function's stack map (for moving stacks; Go's stack maps, with
    /// the saved registers): [frame size, flags (1: any word or register
    /// may be a pointer: the runtime, which keeps addresses in integers; 2:
    /// std, scanned conservatively by the collector),
    /// the number of words from SP that may all hold pointers (the buffers
    /// and the outgoing area), the length of a bitmap of the words above
    /// them that may, the bitmap, then the number of saved registers and
    /// for each its index (x19 + k) << 32 | its FP offset]. The calls are
    /// added by finish_meta, with masks of the saved registers holding
    /// pointers at each position (cur_masks).
    fn stack_meta(&mut self) {
        let frame = self.frame;
        let nw = frame / 8;
        let rt = match self.f.def {
            Some(d) => crate::mir::inline::in_runtime(d),
            None => match self.f.owner {
                Some(d) => crate::mir::inline::in_runtime(d),
                None => false,
            },
        };
        // The runtime's frames get the same map as others: the collector
        // still scans them whole (flag 1: their integers may hold the only
        // address of an object), but a stack move goes by the map, as Go's
        // treats a uintptr as no pointer.
        let any = (frame + self.buf_top) / 8;
        let mut bits: Vec<u64> = Vec::new();
        let mut k = 0;
        while k < (nw - any + 63) / 64 {
            bits.push(0);
            k += 1;
        }
        {
            let mut set = |off: i64| {
                let w = frame + off;
                if w >= 0 && w < frame && w % 8 == 0 && w / 8 >= any {
                    let i = (w / 8 - any) as usize;
                    bits[i / 64] = bits[i / 64] | 1u64 << (i % 64) as u32;
                }
            };
            if self.keeps_ctx() {
                set(SLOT_CTX);
            }
            if self.keeps_ret() {
                set(SLOT_RET);
            }
            if self.keeps_loc() {
                set(SLOT_LOC);
            }
            set(SLOT_DEFERS);
            let n = self.f.locals.len();
            let mut i = 0;
            while i < n {
                if self.loff[i] < 0 {
                    let t = self.ltypes[i];
                    if t.kind != types::K_NEVER {
                        let l = self.g.lay_of(t);
                        for p in l.ptrs.iter() {
                            set(self.loff[i] + *p);
                        }
                    }
                }
                i += 1;
            }
            for o in self.ptr_slots.iter() {
                set(*o);
            }
        }
        // The parameters are in the caller's outgoing area, which starts at
        // its SP, this frame's FP + 16 (the frame record): their pointer
        // words by this frame's own layout, for a stack move to take those
        // words by (as Go's argument maps) instead of every word there that
        // looks like an address in the stack.
        let mut argw = 0i64;
        let mut argmask = 0u64;
        let mut ai = self.first_arg();
        while ai <= self.f.nargs {
            let at = self.ltypes[ai];
            if at.kind != types::K_NEVER {
                let al = self.g.lay_of(at);
                let base = self.loff[ai] - 16;
                let end = (base + al.size + 7) / 8;
                if end > argw {
                    argw = end;
                }
                for q in al.ptrs.iter() {
                    let aw = (base + *q) / 8;
                    if aw >= 0 && aw < 64 {
                        argmask = argmask | 1u64 << aw as u32;
                    }
                }
            }
            ai += 1;
        }
        // More than a word mask describes: those words taken conservatively.
        if argw > 64 {
            argmask = 18446744073709551615;
        }
        self.g.cur_argw = argw as u64;
        self.g.cur_argmask = argmask;
        // The result, when it is in memory: every call passes RET, the
        // address of the caller's result buffer, and the result is made
        // there while this function runs (and calls others). A move adjusts
        // its pointer words by this mask, as Go's argument maps cover the
        // results, instead of every word of the caller's buffer that looks
        // like an address: the buffer holds what earlier calls returned, and
        // the padding of a result made over it keeps their bytes.
        let mut retw = 0u64;
        let mut retmask = 0u64;
        if !self.ssa_var0 {
            let rt0 = self.ltypes[0];
            if rt0.kind != types::K_NEVER {
                let rl = self.g.lay_of(rt0);
                retw = ((rl.size + 7) / 8) as u64;
                if retw > 64 {
                    retmask = 18446744073709551615;
                } else {
                    for q in rl.ptrs.iter() {
                        let rw = *q / 8;
                        if rw >= 0 && rw < 64 {
                            retmask = retmask | 1u64 << rw as u32;
                        }
                    }
                }
            }
        }
        self.g.cur_retw = retw;
        self.g.cur_retmask = retmask;
        let mut meta = self.g.cur_meta;
        meta.clear();
        // Flag 2: std code, whose integers may hold the only address of a
        // heap object: the collector scans it conservatively.
        let in_std = match self.f.def {
            Some(d) => d.krate.is_std,
            None => match self.f.owner {
                Some(d) => d.krate.is_std,
                None => true,
            },
        };
        meta.push(frame as u64);
        meta.push((if rt { 1 } else { 0 }) | (if in_std { 2 } else { 0 }));
        meta.push(any as u64);
        meta.push(bits.len() as u64);
        for b in bits.iter() {
            meta.push(*b);
        }
        meta.push(self.saved.len() as u64);
        let mut all = 0u64;
        for sv in self.saved.iter() {
            let k = (sv.0 - S0) as u64;
            all = all | 1u64 << k as u32;
            meta.push(k << 32 | (sv.1 as u64 & 0xffffffff));
        }
        self.g.cur_all = all;
        // By call tag, from the register allocation.
        let mut masks = self.g.cur_masks;
        masks.clear();
        for x in self.ssa_masks.iter() {
            masks.push(*x);
        }
        self.g.cur_meta = meta;
        self.g.cur_masks = masks;
    }

    pub fn field_of(&mut self, ty: &Type, variant: i64, field: usize) -> (i64, &Type) {
        let l = self.g.lay_of(ty);
        if ty.kind == types::K_TUPLE {
            return (l.fields[field], ty.elems[field]);
        }
        if ty.kind == types::K_ADT {
            if variant >= 0 {
                let ft = self.g.field_types(ty, variant)[field];
                return (l.variants[variant as usize][field], self.reveal(ft));
            }
            let ft = self.g.field_types(ty, -1)[field];
            return (l.fields[field], self.reveal(ft));
        }
        self.g.errorf(`${self.f.name}: field of ${ty}`.to_string());
        (0, ty)
    }

    pub fn reveal(&mut self, t: &Type) -> &Type {
        if t.kind == types::K_OPAQUE {
            if let Some(h) = self.g.hidden_of(t) {
                return self.conc(h);
            }
        }
        t
    }

    /// The type of a place (no code).
    pub fn place_type(&mut self, pl: &Place) -> &Type {
        let mut ty = self.ltypes[pl.local];
        let mut variant = -1i64;
        for pr in pl.proj.iter() {
            match pr.kind {
                mir::P_DEREF => {
                    ty = self.reveal(ty.el());
                    variant = -1;
                }
                mir::P_DOWNCAST => {
                    variant = pr.variant as i64;
                }
                mir::P_FIELD => {
                    let (_, ft) = self.field_of(ty, variant, pr.field);
                    ty = ft;
                    variant = -1;
                }
                _ => {
                    ty = self.reveal(ty.el());
                }
            }
        }
        ty
    }

    /// The address of a place as base register plus offset (base is FP or
    /// RA), and its type; the metadata of an unsized place is left in RM.
    /// Clobbers RA, I1, I2.
    fn place_addr(&mut self, pl: &Place) -> (Reg, i64, &Type) {
        let m = self.m;
        let mut base = FP;
        let mut off = self.loff[pl.local];
        let mut ty = self.ltypes[pl.local];
        let mut variant = -1i64;
        let mut first = true;
        let mut pi = 0;
        for pr in pl.proj.iter() {
            pi += 1;
            // The metadata of an unsized place (in RM) is needed only where
            // the place ends.
            let last = pi == pl.proj.len();
            if first && self.preg[pl.local] >= 0 {
                // A promoted pointer: its register is the base (and a fat
                // one's second register the metadata).
                first = false;
                base = self.preg[pl.local] as Reg;
                off = 0;
                ty = self.reveal(ty.el());
                if last && self.preg2[pl.local] >= 0 {
                    m.mov(RM, self.preg2[pl.local] as Reg);
                }
                continue;
            }
            first = false;
            match pr.kind {
                mir::P_DEREF => {
                    let elem = self.reveal(ty.el());
                    if layout::is_fat(elem) && last {
                        m.load(8, RM, base, off + 8);
                    }
                    m.load(8, RA, base, off);
                    base = RA;
                    off = 0;
                    ty = elem;
                    variant = -1;
                }
                mir::P_DOWNCAST => {
                    variant = pr.variant as i64;
                }
                mir::P_FIELD => {
                    let (foff, ft) = self.field_of(ty, variant, pr.field);
                    ty = ft;
                    variant = -1;
                    off += foff;
                }
                _ => {
                    let elem = self.reveal(ty.el());
                    // A register base is used as is.
                    let b = if off == 0 && base != FP {
                        base
                    } else {
                        self.materialize(base, off);
                        RA
                    };
                    let ix = if self.preg[pr.index] >= 0 {
                        self.preg[pr.index] as Reg
                    } else {
                        m.load(8, I1, FP, self.loff[pr.index]);
                        I1
                    };
                    let es = self.size(elem);
                    if es == 1 || es == 2 || es == 4 || es == 8 {
                        m.add_scaled(
                            RA,
                            b,
                            ix,
                            if es == 1 {
                                0
                            } else if es == 2 {
                                1
                            } else if es == 4 {
                                2
                            } else {
                                3
                            },
                        );
                    } else {
                        m.mov_imm(I2, es);
                        m.mul_add(RA, ix, I2, b);
                    }
                    base = RA;
                    off = 0;
                    ty = elem;
                }
            }
        }
        if pl.proj.len() == 0 && self.preg[pl.local] >= 0 {
            panic(`lower: address of promoted local _${pl.local} in ${self.f.name}`);
        }
        (base, off, ty)
    }

    /// Sets RA to base + off.
    fn materialize(&mut self, base: Reg, off: i64) {
        if base == RA {
            if off != 0 {
                self.m.add_imm(RA, off);
            }
        } else {
            self.m.addr_of(RA, base, off);
        }
    }

    /// Computes the address of a place into RA (and the metadata of an
    /// unsized place into RM). Clobbers I1, I2.
    fn place(&mut self, pl: &Place) -> &Type {
        let (b, o, ty) = self.place_addr(pl);
        self.materialize(b, o);
        ty
    }

    // --- Operands ------------------------------------------------------------

    pub fn operand_type(&mut self, op: &Operand) -> &Type {
        if op.kind == mir::OP_COPY {
            return self.place_type(&op.place);
        }
        self.conc(op.cnst.unwrap().ty.unwrap())
    }

    /// The size of a scalar used in arithmetic.
    fn scalar_size(&self, t: &Type) -> i64 {
        match t.kind {
            types::K_INT => layout::int_size(t.int),
            types::K_BOOL => 1,
            types::K_CHAR => 4,
            types::K_FLOAT => {
                if t.f64 {
                    8
                } else {
                    4
                }
            }
            _ => 8,
        }
    }

    /// Loads a value of at most 8 bytes, zero-extended, into r (fat values:
    /// their first word). Clobbers RA, RM, I1, I2 (and T1 for function
    /// constants).
    fn load_scalar(&mut self, op: &Operand, r: Reg) -> Option<&Type> {
        let m = self.m;
        if op.kind == mir::OP_COPY {
            if let Some(pr) = self.promoted(&op.place) {
                m.mov(r, pr);
                return Some(self.ltypes[op.place.local]);
            }
            let (b, o, ty) = self.place_addr(&op.place);
            let mut size = self.size(ty);
            if size > 8 {
                size = 8;
            }
            match size {
                0 => {
                    m.mov_imm(r, 0);
                }
                1 | 2 | 4 | 8 => {
                    m.load(size, r, b, o);
                }
                _ => {
                    self.g
                        .errorf(`${self.f.name}: scalar load of ${size} bytes`.to_string());
                }
            }
            return Some(ty);
        }
        let c = op.cnst.unwrap();
        let ty = self.conc_opt(c.ty);
        let k = c.kind;
        match k {
            mir::C_INT | mir::C_CHAR | mir::C_BOOL => {
                let mut v = c.int;
                if let Some(t) = ty {
                    if t.kind == types::K_INT && !types::int_signed(t.int) {
                        let s = layout::int_size(t.int);
                        if s < 8 {
                            v = v & ((1i64 << (8 * s) as u32) - 1);
                        }
                    }
                }
                m.mov_imm(r, v);
            }
            mir::C_FLOAT => {
                let f64_ = match ty {
                    Some(t) => t.f64,
                    None => true,
                };
                if f64_ {
                    m.mov_imm(r, c.float.to_bits() as i64);
                } else {
                    m.mov_imm(r, (c.float as f32).to_bits() as i64);
                }
            }
            mir::C_STATIC => {
                let s = self.g.statics[&c.static_def.unwrap().id].clone();
                m.adr_sym(r, &s);
            }
            mir::C_STR | mir::C_BYTES => {
                let s = self.g.str_bytes(&c.bytes);
                m.adr_sym(r, &s);
            }
            mir::C_FN => {
                self.fn_value(c, r, T1);
            }
            mir::C_PARAM => {
                let v = self.conc(c.param.unwrap());
                if v.kind != types::K_CONST {
                    self.g
                        .errorf(`${self.f.name}: const parameter without a value`.to_string());
                }
                m.mov_imm(r, v.len);
            }
            _ => {
                m.mov_imm(r, 0);
            }
        }
        ty
    }

    /// The register holding a scalar operand: its local's register when
    /// promoted, else scratch with the value loaded.
    fn opreg(&mut self, op: &Operand, scratch: Reg) -> Reg {
        if op.kind == mir::OP_COPY {
            if let Some(pr) = self.promoted(&op.place) {
                return pr;
            }
        }
        self.load_scalar(op, scratch);
        scratch
    }

    /// Loads a value of 1, 2, 4, 8 or 16 bytes into V1 (and V2).
    fn load_val(&mut self, op: &Operand, size: i64) {
        let m = self.m;
        if size <= 8 {
            self.load_scalar(op, V1);
            return;
        }
        if op.kind == mir::OP_COPY {
            if let Some(p2) = self.promoted2(&op.place) {
                m.mov(V1, self.preg[op.place.local] as Reg);
                m.mov(V2, p2);
                return;
            }
            let (b, o, _) = self.place_addr(&op.place);
            m.load(8, V1, b, o);
            m.load(8, V2, b, o + 8);
            return;
        }
        let c = op.cnst.unwrap();
        match c.kind {
            mir::C_STR | mir::C_BYTES => {
                let s = self.g.str_bytes(&c.bytes);
                m.adr_sym(V1, &s);
                m.mov_imm(V2, c.bytes.len() as i64);
            }
            mir::C_FN => {
                self.fn_value(c, V1, V2);
            }
            mir::C_INT => {
                // A 128-bit integer: int holds the low word (literals are at
                // most u64::MAX); bytes, if set, the high word.
                m.mov_imm(V1, c.int);
                let mut h = 0i64;
                if c.bytes.len() == 8 {
                    let mut i = 8;
                    while i > 0 {
                        i -= 1;
                        h = h << 8 | c.bytes[i] as i64;
                    }
                }
                m.mov_imm(V2, h);
            }
            _ => {
                m.mov_imm(V1, 0);
                m.mov_imm(V2, 0);
            }
        }
    }

    /// Materializes a function constant as (code, ctx).
    fn fn_value(&mut self, c: &Const, code: Reg, ctx: Reg) {
        let m = self.m;
        let (t, slot) = self.g.p.site_target(self.inst, c);
        if slot >= 0 {
            m.load(8, I1, FP, SLOT_CTX);
            m.load(8, code, I1, 16 * slot);
            m.load(8, ctx, I1, 16 * slot + 8);
            return;
        }
        match t.kind {
            codegen::T_INST => {
                let i = t.inst.unwrap();
                if c_entry(Some(t.def)) {
                    // A C function pointer: its C entry.
                    let cs = `${i.grp().sym}.c`.to_string();
                    m.adr_sym(code, &cs);
                    m.mov_imm(ctx, 0);
                    return;
                }
                m.adr_sym(code, &i.grp().sym);
                m.adr_sym(ctx, &i.dict);
            }
            codegen::T_INTRINSIC => {
                if t.intrinsic == "extern" {
                    let s = self.g.extern_def_sym(t.def);
                    m.adr_sym(code, &s);
                    m.mov_imm(ctx, 0);
                    return;
                }
                self.g
                    .errorf(`${self.f.name}: intrinsic ${t.intrinsic} used as a value`.to_string());
            }
            _ => {
                self.g.errorf(
                    `${self.f.name}: dynamic method ${t.def.name} used as a value`.to_string(),
                );
            }
        }
    }

    /// Appends the function's C entry (see Machine::c_callback).
    fn gen_c_entry(&mut self) {
        let f = self.f;
        let mut args: Vec<CArg> = Vec::new();
        let mut nint = 0;
        let mut nflt = 0;
        let mut i = 1;
        while i <= f.nargs {
            let t = f.locals[i].ty;
            let size = self.size(t);
            if size > 8 || size == 0 {
                self.g.errorf(`${f.name}: a parameter of an extern "C" fn must be a number, bool, char or pointer`.to_string());
                return;
            }
            let float = t.kind == types::K_FLOAT;
            if float {
                nflt += 1;
            } else {
                nint += 1;
            }
            args.push(CArg {
                float,
                f64: t.f64,
                variadic: false,
                size,
            });
            i += 1;
        }
        // The arguments must all come in registers.
        let win = self.g.tgt.os == "windows";
        let amd64 = self.g.o.arch == "amd64";
        let fits = if win {
            nint + nflt <= 4
        } else if amd64 {
            nint <= 6 && nflt <= 8
        } else {
            nint <= 8 && nflt <= 8
        };
        if !fits {
            self.g.errorf(
                `${f.name}: too many parameters for an extern "C" fn called from C`.to_string(),
            );
            return;
        }
        let rt = f.locals[0].ty;
        let rsize = self.size(rt);
        if rsize > 8 {
            self.g.errorf(
                `${f.name}: the result of an extern "C" fn must be a number, bool, char or pointer`
                    .to_string(),
            );
            return;
        }
        let ret = if rsize == 0 {
            0
        } else if rt.kind == types::K_FLOAT {
            2
        } else {
            1
        };
        let enter = self.g.p.runtime[&"cb_enter".to_string()];
        let exit = self.g.p.runtime[&"cb_exit".to_string()];
        let tls_get = self.g.extern_sym(if win {
            "TlsGetValue"
        } else {
            "pthread_getspecific"
        });
        let abort = self.g.extern_sym("abort");
        let loc = self.g.loc_at("<C callback>", 0, 0);
        let cb = &CCallback {
            sym: self.grp.sym.clone(),
            dict: self.inst.dict.clone(),
            loc,
            enter: enter.grp().sym.clone(),
            enter_dict: enter.dict.clone(),
            exit: exit.grp().sym.clone(),
            exit_dict: exit.dict.clone(),
            tls_get,
            abort,
            args,
            ret,
            ret_f64: rt.f64,
        };
        self.g.cur_c_off = self.m.entry_point() as i64;
        self.m.c_callback(cb);
    }

    /// Writes an operand to [dst + off]; dst must be BASE, FP or SP.
    /// Clobbers RA, RM, V1, V2, T1, I1, I2.
    fn store_operand(&mut self, op: &Operand, dst: Reg, off: i64) {
        let m = self.m;
        let ty = self.operand_type(op);
        let mut size = self.size(ty);
        if op.kind == mir::OP_CONST
            && op.cnst.unwrap().kind == mir::C_FN
            && ty.kind == types::K_FN
            && ty.abi == "C"
        {
            size = 8;
        }
        if size == 0 {
            return;
        }
        if op.kind == mir::OP_COPY {
            if self.promoted(&op.place).is_some() {
                self.store_promoted(&op.place, size, dst, off);
                return;
            }
            let (b, o, _) = self.place_addr(&op.place);
            self.copy_mem(dst, off, b, o, size);
            return;
        }
        let ck = op.cnst.unwrap().kind;
        if ck == mir::C_ZERO || ck == mir::C_UNIT {
            self.zero_mem(dst, off, size);
            return;
        }
        match size {
            1 | 2 | 4 | 8 => {
                self.load_scalar(op, V1);
                m.store(size, V1, dst, off);
            }
            16 => {
                self.load_val(op, 16);
                m.store(8, V1, dst, off);
                m.store(8, V2, dst, off + 8);
            }
            _ => {
                self.g
                    .errorf(`${self.f.name}: constant of ${size} bytes`.to_string());
            }
        }
    }

    /// Copies size bytes; clobbers V2, T1, I1, I2.
    fn copy_mem(&mut self, dst: Reg, d_off: i64, src: Reg, s_off: i64, size: i64) {
        if size > 256 {
            self.m.addr_of(I1, src, s_off);
            self.m.addr_of(I2, dst, d_off);
            self.m.copy_words(I2, I1, size / 8);
            self.copy_small(I2, 0, I1, 0, size % 8);
            return;
        }
        self.copy_small(dst, d_off, src, s_off, size);
    }

    fn copy_small(&mut self, dst: Reg, d_off: i64, src: Reg, s_off: i64, size: i64) {
        let mut pos = 0i64;
        for chunk in [8i64, 4, 2, 1].iter() {
            while size - pos >= *chunk {
                self.m.load(*chunk, T1, src, s_off + pos);
                self.m.store(*chunk, T1, dst, d_off + pos);
                pos += *chunk;
            }
        }
    }

    fn zero_mem(&mut self, dst: Reg, off: i64, size: i64) {
        let mut pos = 0i64;
        for chunk in [8i64, 4, 2, 1].iter() {
            while size - pos >= *chunk {
                self.m.store_zero(*chunk, dst, off + pos);
                pos += *chunk;
            }
        }
    }

    // --- Statements ----------------------------------------------------------

    /// Records that the code from here on comes from pos (for DWARF).
    fn note_line(&mut self, pos: Pos) {
        if pos <= 0 {
            return;
        }
        let (file, p) = self.f.file_pos(pos);
        let fl = match file {
            Some(fl) => fl,
            None => return,
        };
        let off = self.m.offset();
        let mut ls = self.g.cur_lines;
        if ls.len() > 0 && ls[ls.len() - 1].0 == off {
            ls[ls.len() - 1] = (off, fl, p);
            return;
        }
        ls.push((off, fl, p));
    }

    /// Calls std::rt::native::gc_alloc(size, noscan); the pointer is left in
    /// the result buffer.
    /// The pointer words of a t for the collector: (mask, words), word k a
    /// pointer if bit k of mask is set; (0, words): none; (all ones, 0):
    /// unknown (over 63 words: every word is scanned).
    pub fn ptr_mask(&mut self, t: &Type) -> (i64, i64) {
        if t.kind == types::K_NEVER {
            return (0, 1);
        }
        let l = self.g.lay_of(t);
        let words = (l.size + 7) / 8;
        if l.ptrs.len() == 0 {
            return (0, if words == 0 { 1 } else { words });
        }
        if words > 63 || l.unsized {
            return (-1, 0);
        }
        let mut mask = 0i64;
        for o in l.ptrs.iter() {
            mask = mask | (1i64 << (*o / 8) as u32);
        }
        (mask, words)
    }

    /// Calls gc_alloc_typed(size in V1, mask, words): an object whose
    /// pointer words the collector knows.
    fn call_alloc_typed(&mut self, mask: i64, words: i64) {
        self.call_alloc_with("gc_alloc_typed", mask, words);
    }

    fn call_alloc_with(&mut self, entry: &str, mask: i64, words: i64) {
        let m = self.m;
        m.store(8, V1, SP, 0);
        m.mov_imm(V1, mask);
        m.store(8, V1, SP, 8);
        m.mov_imm(V1, words);
        m.store(8, V1, SP, 16);
        self.call_runtime(entry);
    }

    fn call_alloc(&mut self, size: i64, noscan: bool) {
        let m = self.m;
        m.mov_imm(V1, size);
        m.store(8, V1, SP, 0);
        if noscan {
            m.mov_imm(V1, 1);
            m.store(1, V1, SP, 8);
        } else {
            m.store_zero(1, SP, 8);
        }
        self.call_runtime("gc_alloc");
    }

    /// Whether values of t hold no pointers.
    pub fn noscan(&mut self, t: &Type) -> bool {
        if t.kind == types::K_NEVER {
            return true;
        }
        self.g.lay_of(t).ptrs.len() == 0
    }

    fn call_runtime(&mut self, name: &str) {
        let m = self.m;
        let inst = self.g.p.runtime[&name.to_string()];
        m.addr_of(RET, FP, self.res_off);
        let l = self.g.loc_at("<runtime>", 0, 0);
        m.adr_sym(LOC, &l);
        m.adr_sym(CTX, &inst.dict);
        m.call(&inst.grp().sym);
    }

    fn write_tag(&mut self, base: Reg, ty: &Type, variant: usize) {
        let m = self.m;
        let l = self.g.lay_of(ty);
        match l.tag {
            layout::TAG_INT => {
                let d = self.g.p.info.adts[&ty.d().id].variants[variant].discr;
                m.mov_imm(V1, d);
                m.store(l.tag_size, V1, base, l.tag_off);
            }
            layout::TAG_NICHE => {
                if variant == l.niche_variant {
                    m.store_zero(8, base, 0);
                }
            }
            _ => {}
        }
    }

    /// Leaves the variant index of the enum at RA in V1.
    fn read_variant(&mut self, ty: &Type) {
        let m = self.m;
        let l = self.g.lay_of(ty);
        match l.tag {
            layout::TAG_INT => {
                m.load(l.tag_size, V1, RA, l.tag_off);
                let vs = self.g.p.info.adts[&ty.d().id].variants;
                let mut identity = true;
                let mut i = 0;
                while i < vs.len() {
                    if vs[i].discr != i as i64 {
                        identity = false;
                    }
                    i += 1;
                }
                if identity {
                    return;
                }
                let mask: u64 = if l.tag_size < 8 {
                    (1u64 << (8 * l.tag_size) as u32) - 1
                } else {
                    0xFFFFFFFFFFFFFFFF
                };
                m.mov_imm(V2, 0);
                i = 0;
                while i < vs.len() {
                    m.mov_imm(T1, ((vs[i].discr as u64) & mask) as i64);
                    m.cmp(V1, T1);
                    m.mov_imm(I1, i as i64);
                    m.select_reg(V2, I1, V2, EQ);
                    i += 1;
                }
                m.mov(V1, V2);
            }
            layout::TAG_NICHE => {
                m.load(8, V1, RA, 0);
                m.cmp_imm(V1, 0);
                if l.niche_variant == 0 {
                    m.set_cond(V1, NE);
                } else {
                    m.set_cond(V1, EQ);
                }
            }
            _ => {
                m.mov_imm(V1, 0);
            }
        }
    }

    /// Allocates the environment [dict, captures...] and leaves the closure
    /// value (code, env+8) in V1, V2.
    /// While a mark runs, shades the pointers in the size bytes at RA (the
    /// runtime's gc_wb; the G does not stop until it is done).
    fn write_barrier(&mut self, size: i64) {
        let m = self.m;
        let skip = m.new_label();
        m.load_sym(I1, &self.g.sym_marking);
        m.branch_zero(I1, skip);
        m.load(8, I1, GREG, 8);
        m.add_imm(I1, 1);
        m.store(8, I1, GREG, 8);
        m.store(8, RA, SP, 0);
        m.mov_imm(V1, size);
        m.store(8, V1, SP, 8);
        self.call_runtime("gc_wb");
        m.bind(skip);
    }

    fn closure(&mut self, ops: &Vec<Operand>, cf: &Func) {
        let m = self.m;
        let size = (8 + 8 * ops.len()) as i64;
        // (The context and the captures: pointers.)
        if ops.len() + 1 <= 63 {
            m.mov_imm(V1, size);
            self.call_alloc_typed((1i64 << (ops.len() + 1) as u32) - 1, (ops.len() + 1) as i64);
        } else {
            self.call_alloc(size, false);
        }
        m.load(8, BASE, FP, self.res_off);
        // The closure's dictionary: this function's (none kept: none read).
        if self.keeps_ctx() {
            m.load(8, T1, FP, SLOT_CTX);
            m.store(8, T1, BASE, 0);
        } else {
            m.store_zero(8, BASE, 0);
        }
        let mut i = 0;
        while i < ops.len() {
            self.store_operand(&ops[i], BASE, (8 + 8 * i) as i64);
            i += 1;
        }
        // The captures were stored into the new environment without a
        // barrier: shaded now (allocated black during a mark, it is not
        // scanned; a capture may be on a stack not scanned yet only).
        m.mov(RA, BASE);
        self.write_barrier(size);
        m.load(8, BASE, FP, self.res_off);
        let s = self.g.closure_sym(self.grp, cf);
        m.adr_sym(V1, &s);
        m.addr_of(V2, BASE, 8);
    }

    // --- Arithmetic ----------------------------------------------------------

    fn panic_stub(&mut self, msg: &str, pos: Pos) -> Label {
        let key = `${msg}@${pos}`.to_string();
        if let Some(l) = self.stubs.get(&key) {
            return *l;
        }
        let l = self.m.new_label();
        self.stubs.insert(key, l);
        self.stub_list.push(Stub::Panic {
            label: l,
            msg: msg.to_string(),
            pos,
        });
        l
    }

    /// Calls panic_raw(msg, file, line, col). Compiler-generated impls
    /// report their caller's location.
    fn call_panic(&mut self, msg: &str, pos: Pos) {
        let m = self.m;
        let ms = self.g.str_sym(msg);
        m.adr_sym(V1, &ms);
        m.store(8, V1, SP, 0);
        m.mov_imm(V1, msg.len() as i64);
        m.store(8, V1, SP, 8);
        if self.f.shim {
            self.store_caller_loc(16);
        } else {
            match self.f.file_pos(pos) {
                (Some(file), p) => self.store_file_pos(16, file, p),
                (None, _) => self.store_file_line(16, "<unknown>", 0, 0),
            }
        }
        self.call_runtime("panic_raw");
        m.trap();
    }

    /// Writes the received caller location as (file, line, col) arguments
    /// at sp+off.
    fn store_caller_loc(&mut self, off: i64) {
        let m = self.m;
        let lt = self.g.loc_ty;
        let ll = self.g.lay_of(lt);
        m.load(8, BASE, FP, SLOT_LOC);
        m.load(8, V1, BASE, ll.fields[0]);
        m.store(8, V1, SP, off);
        m.load(8, V1, BASE, ll.fields[0] + 8);
        m.store(8, V1, SP, off + 8);
        m.load(4, V1, BASE, ll.fields[1]);
        m.store(4, V1, SP, off + 16);
        m.load(4, V1, BASE, ll.fields[2]);
        m.store(4, V1, SP, off + 24);
    }

    // store_file_line for a position in file.
    fn store_file_pos(&mut self, off: i64, file: &File, pos: Pos) {
        if file.has_directives() {
            let p = file.position(pos);
            self.store_file_line(off, p.file.as_str(), p.line as i64, p.col as i64);
            return;
        }
        let m = self.m;
        let (line, col) = file.line_col(pos);
        let fs = self.g.file_name_sym(&file.name);
        m.adr_sym(V1, &fs);
        m.store(8, V1, SP, off);
        m.mov_imm(V1, file.name.len() as i64);
        m.store(8, V1, SP, off + 8);
        m.mov_imm(V1, line as i64);
        m.store(4, V1, SP, off + 16);
        m.mov_imm(V1, col as i64);
        m.store(4, V1, SP, off + 24);
    }

    fn store_file_line(&mut self, off: i64, file: &str, line: i64, col: i64) {
        let m = self.m;
        let fs = self.g.str_sym(file);
        m.adr_sym(V1, &fs);
        m.store(8, V1, SP, off);
        m.mov_imm(V1, file.len() as i64);
        m.store(8, V1, SP, off + 8);
        m.mov_imm(V1, line);
        m.store(4, V1, SP, off + 16);
        m.mov_imm(V1, col);
        m.store(4, V1, SP, off + 24);
    }

    // --- Terminators ---------------------------------------------------------

    /// Whether the function reads its dictionary (CTX): a closure's
    /// environment, or a generic group with dictionary slots.
    fn keeps_ctx(&self) -> bool {
        self.f.closure || self.inst.grp().nslots > 0
    }

    /// Whether the function reads its caller's location (LOC):
    /// #[track_caller] and shims.
    fn keeps_loc(&self) -> bool {
        self.inst.track_caller && !self.f.closure
    }

    /// Whether the function writes a result through RET.
    fn keeps_ret(&mut self) -> bool {
        let rt0 = self.ltypes[0];
        rt0.kind != types::K_NEVER && self.g.lay_of(rt0).size > 0
    }

    /// Sets LOC to the location passed to a callee.
    fn pass_loc(&mut self, pos: Pos) {
        if self.inst.track_caller && !self.f.closure {
            self.m.load(8, LOC, FP, SLOT_LOC);
            return;
        }
        let (lf, lp) = self.f.file_pos(pos);
        let l = self.g.loc(lf, lp);
        self.m.adr_sym(LOC, &l);
    }

    /// Makes a C call; the result (if any) is in V1. False if the call
    /// cannot be made.
    fn c_call_body(
        &mut self,
        fn_op: &Operand,
        args: &Vec<Operand>,
        dt: &Type,
        sym: &str,
        via_fn: bool,
        sys: bool,
    ) -> bool {
        let m = self.m;
        let mut cargs: Vec<CArg> = Vec::new();
        let mut i = 0;
        while i < args.len() {
            let ty = self.operand_type(&args[i]);
            let var = self.nfixed >= 0 && i as i64 >= self.nfixed;
            if ty.kind == types::K_FLOAT {
                self.load_scalar(&args[i], V1);
                if var && !ty.f64 {
                    // C's default promotion: a variadic float is a double.
                    m.fmov_to(F0, V1, false);
                    m.float_conv(F0, F0, true);
                    m.fmov_from(V1, F0, true);
                }
                cargs.push(CArg {
                    float: true,
                    f64: ty.f64 || var,
                    variadic: var,
                    size: if ty.f64 || var { 8 } else { 4 },
                });
            } else if self.size(ty) <= 8 {
                self.load_scalar(&args[i], V1);
                if is_signed(ty) {
                    let s = self.scalar_size(ty);
                    m.sign_ext(V1, V1, s);
                }
                let sz = self.size(ty);
                cargs.push(CArg {
                    float: false,
                    f64: false,
                    variadic: var,
                    size: if sz > 0 { sz } else { 8 },
                });
            } else {
                self.g
                    .errorf(`${self.f.name}: unsupported C argument type ${ty}`.to_string());
                return false;
            }
            m.store(8, V1, SP, (8 * i) as i64);
            i += 1;
        }
        let float_ret = dt.kind == types::K_FLOAT;
        let f64_ = float_ret && dt.f64;
        let ret = if float_ret { 0 } else { self.size(dt) };
        if via_fn {
            self.load_scalar(fn_op, BASE);
            m.call_c("", BASE, &cargs, float_ret, f64_, sys, ret);
        } else {
            m.call_c(sym, 0, &cargs, float_ret, f64_, sys, ret);
        }
        // A result narrower than a register: C leaves the rest undefined
        // (Windows' BOOLEAN is AL alone), extended here to the full word.
        let rsize = self.size(dt);
        if !float_ret
            && rsize > 0
            && rsize < 8
            && (dt.kind == types::K_INT || dt.kind == types::K_BOOL || dt.kind == types::K_CHAR)
        {
            if dt.kind == types::K_INT && is_signed(dt) {
                m.sign_ext(V1, V1, rsize);
            } else {
                m.zero_ext(V1, V1, rsize);
            }
        }
        true
    }

    /// An intrinsic's code: true if its result (if any) is then in V1 (and
    /// V2). Without dest (the SSA backend) C calls leave their result in V1
    /// and results in memory go to the result buffer.
    fn intrinsic_body(
        &mut self,
        t: &Target,
        args: &Vec<Operand>,
        target: i64,
        pos: Pos,
        dt: &Type,
    ) -> bool {
        let m = self.m;
        let size = self.size(dt);
        let name = t.intrinsic.as_str();
        let targ0: Option<&Type> = if t.type_args.len() > 0 {
            Some(t.type_args[0])
        } else {
            None
        };
        match name {
            "asm" => {
                // navi's convention: the arguments at sp, 8 bytes each
                // (already there when args is empty: the SSA backend's),
                // the result to the result buffer (RET), or to the local
                // asm_ret (the function writes it after reading its
                // arguments).
                let mut off = 0i64;
                for a in args.iter() {
                    let at = self.operand_type(a);
                    let sz = self.size(at);
                    self.store_operand(a, SP, off);
                    off += (sz + 7) / 8 * 8;
                }
                if self.asm_ret >= 0 {
                    self.local_addr(RET, self.asm_ret as usize);
                } else {
                    m.addr_of(RET, FP, self.res_off);
                }
                m.call(&asm_sym(t.def));
                if size == 1 || size == 2 || size == 4 || size == 8 {
                    m.load(size, V1, FP, self.res_off);
                    if size < 8 && dt.kind == types::K_INT && is_signed(dt) {
                        m.sign_ext(V1, V1, size);
                    }
                } else if size == 16 {
                    m.load(8, V1, FP, self.res_off);
                    m.load(8, V2, FP, self.res_off + 8);
                }
                return true;
            }
            "extern" => {
                let s = self.g.extern_def_sym(t.def);
                let fo = mir::copy(mir::local_place(0));
                let decl = crate::types::collect::fn_decl(t.def);
                self.nfixed = if decl.variadic {
                    decl.params.len() as i64
                } else {
                    -1
                };
                // Calls that may block run on the C stack (the MIR wraps
                // them in enter_blocked/exit_blocked).
                let ok = self.c_call_body(&fo, args, dt, s.as_str(), false, !t.def.nonblocking);
                self.nfixed = -1;
                if ok && (target < 0 || dt.kind == types::K_NEVER) {
                    m.trap();
                }
                return ok;
            }
            "unreachable" => {
                m.trap();
                return false;
            }
            "abort" => {
                let s = self.g.extern_sym("abort");
                m.call_c(s.as_str(), 0, &Vec::new(), false, false, false, 0);
                m.trap();
                return false;
            }
            "has_pointers" => {
                let ns = self.noscan(targ0.unwrap());
                m.mov_imm(V1, if ns { 0 } else { 1 });
            }
            "alloc_array" => {
                // n elements of T, the collector told T's pointer words.
                let t = targ0.unwrap();
                let es = self.size(t);
                let n = self.opreg(&args[0], V1);
                m.mov_imm(V2, if es == 0 { 1 } else { es });
                m.arith(MUL, V1, n, V2);
                let (mask, words) = self.ptr_mask(t);
                if mask == 0 && words != 0 {
                    m.store(8, V1, SP, 0);
                    m.mov_imm(V1, 1);
                    m.store(1, V1, SP, 8);
                    self.call_runtime("gc_alloc");
                } else if words == 0 {
                    m.store(8, V1, SP, 0);
                    m.store_zero(1, SP, 8);
                    self.call_runtime("gc_alloc");
                } else {
                    self.call_alloc_with("gc_alloc_array", mask, words);
                }
                m.load(8, V1, FP, self.res_off);
            }
            "is_copy_clone" => {
                m.mov_imm(V1, if copy_clone(targ0.unwrap()) { 1 } else { 0 });
            }
            "frame_address" => {
                m.mov(V1, FP);
            }
            "stack_top" => {
                m.adr_sym(V1, &"_navi_stack_top".to_string());
                m.load(8, V1, V1, 0);
            }
            "data_start" => {
                m.adr_sym(V1, &"_navi_data_start".to_string());
            }
            "data_end" => {
                m.adr_sym(V1, &"_navi_data_end".to_string());
            }
            "run_defers" => {
                self.load_scalar(&args[0], CTX);
                m.call(&"_navi_rundefers".to_string());
            }
            "swap_context" => {
                self.load_scalar(&args[0], V1);
                m.store(8, V1, SP, 0);
                self.load_scalar(&args[1], V1);
                m.store(8, V1, SP, 8);
                let mut ca = Vec::new();
                ca.push(int_arg());
                ca.push(int_arg());
                m.call_c("_navi_swapctx", 0, &ca, false, false, false, 0);
            }
            "save_context" => {
                self.load_scalar(&args[0], V1);
                m.store(8, V1, SP, 0);
                let mut ca = Vec::new();
                ca.push(int_arg());
                m.call_c("_navi_setjmp", 0, &ca, false, false, false, 8);
            }
            "func_table" => {
                m.adr_sym(V1, &"_navi_ftab".to_string());
            }
            "scan_heap" | "scan_heap_bits" => {
                let mut ca = Vec::new();
                let mut k = 0;
                while k < 6 {
                    self.load_scalar(&args[k], V1);
                    m.store(8, V1, SP, (8 * k) as i64);
                    ca.push(int_arg());
                    k += 1;
                }
                m.call_c(
                    if name == "scan_heap" {
                        "_navi_scanh"
                    } else {
                        "_navi_scanhb"
                    },
                    0,
                    &ca,
                    false,
                    false,
                    false,
                    8,
                );
            }
            "resume_context" => {
                self.load_scalar(&args[0], V1);
                m.store(8, V1, SP, 0);
                self.load_scalar(&args[1], V1);
                m.store(8, V1, SP, 8);
                let mut ca = Vec::new();
                ca.push(int_arg());
                ca.push(int_arg());
                m.call_c("_navi_longjmp", 0, &ca, false, false, false, 0);
                m.trap();
                return false;
            }
            "gstart_address" => {
                m.adr_sym(V1, &"_navi_gstart".to_string());
            }
            "mem_copy" | "mem_fill" => {
                let mut k = 0;
                while k < 3 {
                    self.load_scalar(&args[k], V1);
                    m.store(8, V1, SP, (8 * k) as i64);
                    k += 1;
                }
                m.load(8, V1, SP, 0);
                m.load(8, V2, SP, 8);
                m.load(8, BASE, SP, 16);
                if name == "mem_copy" {
                    m.memory_copy(V1, V2, BASE);
                } else {
                    m.memory_fill(V1, V2, BASE);
                }
            }
            "type_desc" => {
                let d = self.g.p.descs[&targ0.unwrap().id];
                m.adr_sym(V1, &d.sym);
            }
            "type_info" => {
                let d = self.g.p.descs[&codegen::info_key(targ0.unwrap())];
                m.adr_sym(V1, &d.sym);
            }
            "stack_pointer" => {
                m.mov(V1, SP);
            }
            "spill_registers" => {
                self.load_scalar(&args[0], V1);
                let mut k = 0;
                while k < self.g.tgt.num_saved {
                    m.store(8, S0 + k as Reg, V1, (8 * k) as i64);
                    k += 1;
                }
            }
            "set_stack_limit" => {
                // The running G's limit (the first word of its record).
                self.load_scalar(&args[0], V1);
                m.store(8, V1, GREG, 0);
            }
            "current_g" => {
                m.mov(V1, GREG);
            }
            "set_current_g" => {
                self.load_scalar(&args[0], GREG);
            }
            "mstart_address" => {
                m.adr_sym(V1, &"_navi_mstart".to_string());
            }
            "gc_marking_flag" => {
                m.adr_sym(V1, &"_navi_gc_marking".to_string());
            }
            "tls_key_slot" => {
                m.adr_sym(V1, &"_navi_tls_key".to_string());
            }
            "atomic_load" => {
                self.load_scalar(&args[0], I1);
                m.atomic_load(V1, I1);
            }
            "atomic_store" => {
                self.load_scalar(&args[1], V1);
                m.store(8, V1, FP, self.res_off);
                self.load_scalar(&args[0], I1);
                m.load(8, V1, FP, self.res_off);
                m.atomic_store(V1, I1);
            }
            "atomic_add" => {
                self.load_scalar(&args[1], V2);
                m.store(8, V2, FP, self.res_off);
                self.load_scalar(&args[0], I1);
                m.load(8, V2, FP, self.res_off);
                m.atomic_add(V1, V2, I1);
            }
            "atomic_cas" => {
                // V1 = old (replaced by the word read), V2 = new; true if the
                // word was old.
                self.load_scalar(&args[2], V2);
                m.store(8, V2, FP, self.res_off);
                self.load_scalar(&args[1], V1);
                m.store(8, V1, FP, self.res_off + 8);
                self.load_scalar(&args[0], I1);
                m.load(8, V2, FP, self.res_off);
                m.load(8, V1, FP, self.res_off + 8);
                m.mov(T1, V1);
                m.atomic_cas(V1, V2, I1);
                m.cmp(V1, T1);
                m.set_cond(V1, EQ);
            }
            "mul_hi" => {
                let a = self.opreg(&args[0], V1);
                let b = self.opreg(&args[1], V2);
                m.arith(MULHI_U, V1, a, b);
            }
            "wrapping_add" | "wrapping_sub" | "wrapping_mul" => {
                let a = self.opreg(&args[0], V1);
                let b = self.opreg(&args[1], V2);
                let op = match name {
                    "wrapping_add" => ADD,
                    "wrapping_sub" => SUB,
                    _ => MUL,
                };
                m.arith(op, V1, a, b);
            }
            "size_of" => {
                let s = self.size(targ0.unwrap());
                m.mov_imm(V1, s);
            }
            "align_of" => {
                let a = self.g.lay_of(targ0.unwrap()).align;
                m.mov_imm(V1, a);
            }
            "ptr_offset" => {
                let a = self.opreg(&args[0], V1);
                let b = self.opreg(&args[1], V2);
                let s = self.size(targ0.unwrap());
                m.mov_imm(T1, s);
                m.mul_add(V1, b, T1, a);
            }
            "slice_from_raw" | "slice_from_raw_mut" | "str_from_raw" => {
                self.load_scalar(&args[0], V1);
                self.load_scalar(&args[1], V2);
            }
            "slice_len" => {
                self.load_val(&args[0], 16);
                m.mov(V1, V2);
            }
            "slice_ptr" => {
                self.load_scalar(&args[0], V1);
            }
            "str_as_bytes" => {
                self.load_val(&args[0], 16);
            }
            "caller_location" => {
                if self.inst.track_caller && !self.f.closure {
                    m.load(8, BASE, FP, SLOT_LOC);
                } else {
                    let (lf, lp) = self.f.file_pos(pos);
                    let l = self.g.loc(lf, lp);
                    m.adr_sym(BASE, &l);
                }
                m.addr_of(RA, FP, self.res_off);
                self.copy_mem(RA, 0, BASE, 0, size);
                return false;
            }
            _ => {
                self.g.errorf(
                    `${self.f.name}: intrinsic ${name} has no native implementation`.to_string(),
                );
                return false;
            }
        }
        true
    }

    // --- Defer ---------------------------------------------------------------

    /// Allocates a record [next, code, ctx, argsize, retsize, loc, args...]
    /// and links it into the frame's defer list.
    fn push_defer(&mut self, fn_op: &Operand, args: &Vec<Operand>) {
        let m = self.m;
        let mut is_virtual = false;
        let mut tgt: Option<&mut Target> = None;
        let mut ret_ty: Option<&Type> = None;
        if fn_op.kind == mir::OP_CONST && fn_op.cnst.unwrap().kind == mir::C_FN {
            let (t, _) = self.g.p.site_target(self.inst, fn_op.cnst.unwrap());
            tgt = Some(t);
            match t.kind {
                codegen::T_VIRTUAL => {
                    is_virtual = true;
                    let sig = self.g.fn_sig_of(t.def);
                    ret_ty = Some(self.conc(sig.ret));
                }
                codegen::T_INST => {
                    let i = t.inst.unwrap();
                    // (A separately compiled crate's function has no body
                    // here: its signature's.)
                    let rt = if i.func.locals.len() > 0 {
                        i.func.locals[0].ty
                    } else {
                        self.g.fn_sig_of(t.def).ret
                    };
                    ret_ty = Some(self.g.concrete(i, rt));
                }
                _ => {
                    self.g.errorf(
                        `${self.f.name}: cannot defer intrinsic ${t.intrinsic}`.to_string(),
                    );
                    return;
                }
            }
        } else {
            let ft = self.operand_type(fn_op);
            if ft.kind == types::K_FN {
                ret_ty = ft.ret;
            }
        }
        let mut arg_size = 0i64;
        let mut i = 0;
        while i < args.len() {
            if i == 0 && is_virtual {
                arg_size += 8;
                i += 1;
                continue;
            }
            let at = self.operand_type(&args[i]);
            arg_size += round8(self.size(at));
            i += 1;
        }
        let mut ret_size = 16i64;
        if let Some(rt) = ret_ty {
            let rs = self.size(rt);
            if rs > ret_size {
                ret_size = rs;
            }
        }
        ret_size = round8(ret_size);
        self.call_alloc(48 + arg_size, false);
        m.load(8, BASE, FP, self.res_off);
        // Code and context.
        if is_virtual {
            let t = tgt.unwrap();
            self.load_val(&args[0], 16);
            m.store(8, V1, BASE, 48);
            m.mark(obj::DYN_USE, &codegen::dyn_key(t.def));
            m.load(8, V1, V2, (16 * t.method) as i64);
            m.load(8, V2, V2, (16 * t.method + 8) as i64);
        } else if tgt.is_some() {
            self.fn_value(fn_op.cnst.unwrap(), V1, V2);
        } else {
            self.load_val(fn_op, 16);
        }
        m.store(8, V1, BASE, 8);
        m.store(8, V2, BASE, 16);
        m.mov_imm(V1, arg_size);
        m.store(8, V1, BASE, 24);
        m.mov_imm(V1, ret_size);
        m.store(8, V1, BASE, 32);
        if self.inst.track_caller && !self.f.closure {
            m.load(8, V1, FP, SLOT_LOC);
        } else {
            let l = self.g.loc(self.f.file, 0);
            m.adr_sym(V1, &l);
        }
        m.store(8, V1, BASE, 40);
        let mut off = 48i64;
        i = 0;
        while i < args.len() {
            if i == 0 && is_virtual {
                off += 8;
                i += 1;
                continue;
            }
            self.store_operand(&args[i], BASE, off);
            let at = self.operand_type(&args[i]);
            off += round8(self.size(at));
            i += 1;
        }
        // (As a closure's environment: stored without a barrier.)
        m.mov(RA, BASE);
        self.write_barrier(48 + arg_size);
        m.load(8, BASE, FP, self.res_off);
        m.load(8, V1, FP, SLOT_DEFERS);
        m.store(8, V1, BASE, 0);
        m.store(8, BASE, FP, SLOT_DEFERS);
    }
}

/// Whether cloning a t is a bitwise copy.
fn copy_clone(t: &Type) -> bool {
    let k = t.kind;
    match k {
        types::K_INT
        | types::K_FLOAT
        | types::K_BOOL
        | types::K_CHAR
        | types::K_PTR
        | types::K_FN
        | types::K_REF => return true,
        types::K_ARRAY => return copy_clone(t.el()),
        types::K_TUPLE => {
            for e in t.elems.iter() {
                if !copy_clone(*e) {
                    return false;
                }
            }
            return true;
        }
        _ => {}
    }
    false
}

fn invert(c: Cond) -> Cond {
    match c {
        EQ => NE,
        NE => EQ,
        LT => GE,
        GE => LT,
        LE => GT,
        GT => LE,
        LTU => GEU,
        GEU => LTU,
        LEU => GTU,
        _ => LEU,
    }
}

// --- SSA code generation (docs/ssa.md, stage S2: arm64) ----------------------

/// Where a value is for the moves of phis.
#[derive(Clone)]
struct Loc {
    /// 0: register, 1: stack slot (FP offset), 2: made where used.
    kind: u8,
    /// A floating point value (f64: a double).
    fp: bool,
    f64: bool,
    reg: Reg,
    off: i64,
    val: Option<&mut crate::ssa::Value>,
}

impl FnGen {
    /// The registers direct calls pass argument words in (arm64 x1-x7;
    /// amd64 the scratch registers no call sequence or prologue uses).
    fn arg_regs(&self) -> Vec<Reg> {
        let mut rs: Vec<Reg> = Vec::new();
        if self.g.tgt.wasm {
            return rs;
        }
        if self.g.tgt.code_unit == 4 {
            let mut k = 0;
            while k < NUM_A {
                rs.push(A1 + k as Reg);
                k += 1;
            }
        } else {
            rs.push(V1);
            rs.push(V2);
            rs.push(BASE);
            rs.push(RA);
            rs.push(RM);
        }
        rs
    }

    /// For each parameter type, its first argument register (index into
    /// arg_regs) or -1 (on the stack): values of one or two words, in order,
    /// while registers last. Callers and callees agree (word counts are the
    /// same for every type of a shape).
    fn reg_params(&mut self, types: &Vec<&Type>) -> Vec<i64> {
        let n = self.arg_regs().len() as i64;
        let mut out: Vec<i64> = Vec::new();
        let mut k = 0i64;
        for t in types.iter() {
            let w = if self.size(*t) == 0 {
                0
            } else {
                self.ssa_words(*t)
            };
            if w > 0 && k + w <= n {
                out.push(k);
                k += w;
            } else {
                out.push(-1);
            }
        }
        out
    }

    /// Whether the SSA backend handles every value of sf.
    fn ssa_supported(&mut self, sf: &crate::ssa::Func) -> Result<(), String> {
        for b in sf.blocks.iter() {
            for v in b.values.iter() {
                let op = v.op;
                if op == crate::ssa::OP_INVALID {
                    return Err("invalid value".to_string());
                }
            }
        }
        Ok(())
    }

    /// The register holding v as an operand: its own, else scratch (made or
    /// loaded there).
    fn ssa_in(&mut self, v: &crate::ssa::Value, scratch0: Reg) -> Reg {
        let id = v.id as usize;
        let r = self.ssa_alloc.reg[id];
        if r >= 0 {
            return r as Reg;
        }
        // Floats: scratch V2 or F1 means F1, others F0.
        let fp = crate::ssa::is_float(v.ty);
        let scratch = if !fp {
            scratch0
        } else if scratch0 == V2 || scratch0 == F1 {
            F1
        } else {
            F0
        };
        let s = self.ssa_alloc.slot[id];
        if s >= 0 {
            if fp {
                self.m.fload(8, scratch, FP, self.ssa_slot_off(s));
            } else {
                self.m.load(8, scratch, FP, self.ssa_slot_off(s));
            }
            return scratch;
        }
        self.ssa_remat(v, scratch);
        scratch
    }

    fn ssa_slot_off(&self, s: i32) -> i64 {
        self.ssa_slots - 8 * s as i64
    }

    /// The register v's result is made in: its own, else scratch (stored
    /// to its slot by ssa_out).
    fn ssa_dst(&self, v: &crate::ssa::Value, scratch: Reg) -> Reg {
        let r = self.ssa_alloc.reg[v.id as usize];
        if r >= 0 {
            r as Reg
        } else if crate::ssa::is_float(v.ty) {
            F0
        } else {
            scratch
        }
    }

    fn ssa_out(&mut self, v: &crate::ssa::Value, r: Reg) {
        let s = self.ssa_alloc.slot[v.id as usize];
        if s >= 0 {
            if crate::ssa::is_float(v.ty) {
                self.m.fstore(8, r, FP, self.ssa_slot_off(s));
            } else {
                self.m.store(8, r, FP, self.ssa_slot_off(s));
            }
        }
    }

    /// Stores a value's register (of its class) at base + off.
    fn ssa_store_word(&mut self, v: &crate::ssa::Value, r: Reg, size: i64, base: Reg, off: i64) {
        if crate::ssa::is_float(v.ty) {
            self.m.fstore(size, r, base, off);
        } else {
            self.m.store(size, r, base, off);
        }
    }

    /// Makes a value that has no register in r.
    fn ssa_remat(&mut self, v: &crate::ssa::Value, r: Reg) {
        let m = self.m;
        match v.op {
            crate::ssa::OP_CONST => {
                if crate::ssa::is_float(v.ty) {
                    m.mov_imm(T1, v.aux_int);
                    m.fmov_to(r, T1, v.ty == crate::ssa::T_F64);
                } else {
                    m.mov_imm(r, v.aux_int);
                }
            }
            crate::ssa::OP_LOCALADDR => m.addr_of(r, FP, self.loff[v.aux_int as usize]),
            crate::ssa::OP_RESADDR => m.addr_of(r, FP, self.res_off),
            crate::ssa::OP_CONSTPARAM => {
                if let crate::ssa::Aux::Cnst(c) = &v.aux {
                    let t = self.conc(c.param.unwrap());
                    m.mov_imm(r, t.len);
                }
            }
            crate::ssa::OP_CONSTSYM => {
                let c = match &v.aux {
                    crate::ssa::Aux::Cnst(c) => *c,
                    _ => return,
                };
                match c.kind {
                    mir::C_STATIC => {
                        let s = self.g.statics[&c.static_def.unwrap().id].clone();
                        m.adr_sym(r, &s);
                    }
                    mir::C_STR | mir::C_BYTES => {
                        let s = self.g.str_bytes(&c.bytes);
                        m.adr_sym(r, &s);
                    }
                    _ => {
                        if v.aux_int == 0 {
                            self.fn_value(c, r, T1);
                        } else {
                            self.fn_value(c, T1, r);
                        }
                    }
                }
            }
            crate::ssa::OP_VTABLE => {
                let bi = (v.aux_int >> 32) as usize;
                let si = (v.aux_int & 0xffffffff) as usize;
                let key = codegen::dyn_site(self.f, bi, si);
                let (vt, slot) = self.g.p.site_vtable(self.inst, &key);
                if slot >= 0 {
                    m.load(8, r, FP, SLOT_CTX);
                    m.load(8, r, r, 16 * slot);
                } else {
                    m.adr_sym(r, &vt.sym);
                }
            }
            crate::ssa::OP_CLOSURECODE => {
                if let crate::ssa::Aux::Rv(rv) = &v.aux {
                    if let Rvalue::Aggregate { closure, .. } = *rv {
                        let s = self.g.closure_sym(self.grp, closure.unwrap());
                        m.adr_sym(r, &s);
                    }
                }
            }
            _ => self.g.errorf(
                `${self.f.name}: no register for v${v.id} (${crate::ssa::op_name(v.op)})`
                    .to_string(),
            ),
        }
    }

    /// MIR operands for the old helpers: each non-constant one's words
    /// (v.args from *ai) put in the bridge area, read through a new local.
    fn ssa_bridged(
        &mut self,
        v: &crate::ssa::Value,
        ops: &Vec<Operand>,
        ai: &mut usize,
        off: &mut i64,
    ) -> Vec<Operand> {
        let m = self.m;
        let mut out: Vec<Operand> = Vec::new();
        for op in ops.iter() {
            if op.kind == mir::OP_CONST {
                // Constants stay (the builder gave them words too).
                *ai += self.ssa_const_args(op);
                out.push(op.clone());
                continue;
            }
            let t = self.operand_type(op);
            let size = self.size(t);
            if size == 0 {
                out.push(op.clone());
                continue;
            }
            let words = self.ssa_words(t);
            let nargs = if words == 0 { 1 } else { words as usize };
            let at = self.ssa_bridge + *off;
            if words == 0 {
                let a = self.ssa_in(v.args[*ai], RA);
                if a != RA {
                    m.mov(RA, a);
                }
                self.copy_mem(FP, at, RA, 0, size);
            } else {
                let w0 = self.ssa_in(v.args[*ai], V1);
                self.ssa_store_word(v.args[*ai], w0, if words == 1 { size } else { 8 }, FP, at);
                if words == 2 {
                    let w1 = self.ssa_in(v.args[*ai + 1], V1);
                    self.ssa_store_word(v.args[*ai + 1], w1, 8, FP, at + 8);
                }
            }
            *ai += nargs;
            *off += round8(size);
            let l = self.ltypes.len();
            self.ltypes.push(t);
            self.loff.push(at);
            self.preg.push(-1);
            self.preg2.push(-1);
            out.push(mir::copy(mir::local_place(l)));
        }
        out
    }

    /// How many SSA arguments the builder made for a constant operand (its
    /// words; one for one in memory).
    /// An #[asm] call's arguments stored at sp as its convention has them
    /// (8 bytes each), from their SSA words; false (nothing stored) when
    /// one is in memory.
    fn ssa_asm_args(&mut self, v: &crate::ssa::Value, ops: &Vec<Operand>) -> bool {
        for op in ops.iter() {
            if op.kind == mir::OP_CONST {
                continue;
            }
            let t = self.operand_type(op);
            if self.size(t) > 0 && self.ssa_words(t) == 0 {
                return false;
            }
        }
        let mut ai = 0usize;
        let mut off = 0i64;
        for op in ops.iter() {
            let t = self.operand_type(op);
            let size = self.size(t);
            if op.kind == mir::OP_CONST {
                ai += self.ssa_const_args(op);
                self.store_operand(op, SP, off);
            } else if size > 0 {
                let words = self.ssa_words(t);
                let w0 = self.ssa_in(v.args[ai], V1);
                self.ssa_store_word(v.args[ai], w0, if words == 1 { size } else { 8 }, SP, off);
                if words == 2 {
                    let w1 = self.ssa_in(v.args[ai + 1], V1);
                    self.ssa_store_word(v.args[ai + 1], w1, 8, SP, off + 8);
                }
                ai += words as usize;
            }
            off += round8(size);
        }
        true
    }

    fn ssa_const_args(&mut self, op: &Operand) -> usize {
        let c = op.cnst.unwrap();
        let t = match c.ty {
            Some(t) => self.conc(t),
            None => return 0,
        };
        if self.size(t) == 0 {
            return 0;
        }
        let w = self.ssa_words(t);
        if w == 0 { 1 } else { w as usize }
    }

    /// The bytes the bridge needs for v's operands.
    fn ssa_bridge_size(&mut self, v: &crate::ssa::Value) -> i64 {
        let mut n = 0i64;
        let mut add = |fg: &mut FnGen, ops: &Vec<Operand>| {
            for op in ops.iter() {
                if op.kind == mir::OP_CONST {
                    continue;
                }
                let t = fg.operand_type(op);
                n += round8(fg.size(t));
            }
        };
        match &v.aux {
            crate::ssa::Aux::Call(t, _, _) => {
                if let Term::Call { fn_op, args, .. } = *t {
                    let mut fo: Vec<Operand> = Vec::new();
                    fo.push(fn_op.clone());
                    add(self, &fo);
                    add(self, args);
                }
            }
            crate::ssa::Aux::Stmt(st) => {
                if let Stmt::PushDefer { fn_op, args } = *st {
                    let mut fo: Vec<Operand> = Vec::new();
                    fo.push(fn_op.clone());
                    add(self, &fo);
                    add(self, args);
                }
            }
            crate::ssa::Aux::Rv(rv) => {
                if let Rvalue::Aggregate { ops, .. } = *rv {
                    add(self, ops);
                }
            }
            _ => {}
        }
        n
    }

    /// The base register and offset of a load or store's address.
    fn ssa_addr(&mut self, a: &crate::ssa::Value, off: i64, scratch: Reg) -> (Reg, i64) {
        if self.ssa_alloc.reg[a.id as usize] < 0 && self.ssa_alloc.slot[a.id as usize] < 0 {
            if a.op == crate::ssa::OP_LOCALADDR {
                return (FP, self.loff[a.aux_int as usize] + off);
            }
            if a.op == crate::ssa::OP_RESADDR {
                return (FP, self.res_off + off);
            }
        }
        (self.ssa_in(a, scratch), off)
    }

    /// Generates f from its SSA form.
    fn gen_ssa(&mut self, sf: &mut crate::ssa::Func) {
        let m = self.m;
        let f = self.f;
        let t1 = if self.g.ssa_time {
            Some(std::time::Instant::now())
        } else {
            None
        };
        if !self.g.ssa_noopt {
            if !crate::dflags::on("noshortcircuit") {
                crate::ssa::opt::shortcircuit(sf);
            }
            if !crate::dflags::on("nofold") {
                crate::ssa::opt::fold(sf);
            }
            // CSE keeps the blocks: one dominator tree for both.
            let d = crate::ssa::dom::dominators(sf);
            crate::ssa::opt::cse(sf, d);
            crate::ssa::opt::prove(sf, d);
            crate::ssa::opt::licm(sf);
            if !crate::dflags::on("nofuse") {
                crate::ssa::opt::fuse(sf);
            }
            // Locals whose stores may go: not the result or an argument, no
            // pointers in the stack map.
            let mut quiet: Vec<bool> = Vec::new();
            let mut i = 0;
            while i < f.locals.len() {
                let t = self.ltypes[i];
                quiet.push(
                    i > f.nargs && t.kind != types::K_NEVER && self.g.lay_of(t).ptrs.len() == 0,
                );
                i += 1;
            }
            crate::ssa::opt::dead_stores(sf, &quiet);
        }
        if let Some(t) = t1 {
            crate::backend::ssagen::add_time(1, t.elapsed().as_nanos() as u64);
        }
        let t2 = if self.g.ssa_time {
            Some(std::time::Instant::now())
        } else {
            None
        };
        crate::ssa::prep::split_critical(sf);
        crate::ssa::prep::fold_offsets(sf);
        crate::ssa::deadcode(sf);
        let mut fused = crate::ssa::prep::fuse_compares(sf);
        // Registers calls clobber: CTX, RET and LOC (set only right before
        // calls; their values are in the frame's fixed slots), and on arm64
        // x1-x7. (wasm: locals only, A1-A7 and S0-S8, which calls clobber
        // too; CTX, RET and LOC are globals there, slow.)
        let wasm = self.g.tgt.wasm;
        let mut caller: Vec<u8> = Vec::new();
        if !wasm {
            caller.push(CTX);
            caller.push(RET);
            caller.push(LOC);
        }
        let mut k = 0;
        while k < NUM_A && (self.g.tgt.code_unit == 4 || wasm) {
            caller.push(A1 + k as Reg);
            k += 1;
        }
        k = 0;
        while k < NUM_SAVED && wasm {
            caller.push(S0 + k as Reg);
            k += 1;
        }
        let mut callee: Vec<u8> = Vec::new();
        k = 0;
        while k < self.g.tgt.num_saved {
            callee.push(S0 + k as Reg);
            k += 1;
        }
        let mut fregs: Vec<u8> = Vec::new();
        let nf = if self.g.tgt.code_unit == 4 || self.g.tgt.wasm {
            NUM_FA_ARM64
        } else {
            NUM_FA_AMD64
        };
        k = 0;
        while k < nf {
            fregs.push(FA1 + k as Reg);
            k += 1;
        }
        let cfg = &crate::ssa::regalloc::Config {
            caller,
            callee,
            fregs,
        };
        // Go's allocator (docs/ssa.md 11), the linear scan where it does not
        // apply or with -d oldregalloc.
        let only = match crate::dflags::value("greedyonly") {
            Some(w) => sf.name.contains(w.as_str()),
            None => true,
        };
        if crate::dflags::on("oldregalloc")
            || !only
            || !crate::ssa::greedy::allocate(sf, cfg, &fused, self.g.ssa_ra)
        {
            crate::ssa::regalloc::allocate(sf, cfg, &fused, self.g.ssa_ra);
        }
        if let Some(w) = crate::dflags::value("radump") {
            if sf.name == w {
                eprintln(crate::ssa::greedy::dump(sf, self.g.ssa_ra));
            }
        }
        if crate::dflags::on("racheck") {
            for e in crate::ssa::greedy::check(sf, cfg, self.g.ssa_ra).iter() {
                eprintln(`racheck: ${e}`);
            }
        }
        // (Values the allocation made are not fused compares.)
        while fused.len() < sf.values.len() {
            fused.push(false);
        }
        self.ssa_alloc = self.g.ssa_ra;
        if let Some(t) = t2 {
            crate::backend::ssagen::add_time(2, t.elapsed().as_nanos() as u64);
        }
        let t3 = if self.g.ssa_time {
            Some(std::time::Instant::now())
        } else {
            None
        };
        let al = self.ssa_alloc;
        // The old helpers look for promoted locals: none here.
        let mut li = 0;
        while li < f.locals.len() {
            self.preg.push(-1);
            self.preg2.push(-1);
            li += 1;
        }
        let mut bridge = 0i64;
        for b in sf.blocks.iter() {
            for v in b.values.iter() {
                // Calls use the bridge only through C function pointers.
                let mut bridged = v.op == crate::ssa::OP_INTRINSIC
                    || v.op == crate::ssa::OP_CLOSURE
                    || v.op == crate::ssa::OP_DEFER;
                if v.op == crate::ssa::OP_CALL {
                    if let crate::ssa::Aux::Call(_, None, _) = &v.aux {
                        bridged = true;
                    }
                }
                if bridged {
                    let n = self.ssa_bridge_size(*v);
                    if n > bridge {
                        bridge = n;
                    }
                }
            }
        }
        // The frame: the locals in memory, the saved registers, the spill
        // slots, the buffers and the outgoing area.
        let n = f.locals.len();
        let mut cur = FIXED_FRAME;
        let mut i = 0;
        while i < n {
            if (i >= self.first_arg() && i <= f.nargs) || sf.is_var[i] {
                i += 1;
                continue;
            }
            let t = self.ltypes[i];
            let mut size = 0i64;
            let mut align = 1i64;
            if t.kind != types::K_NEVER {
                let l = self.g.lay_of(t);
                size = l.size;
                align = l.align;
            }
            if size == 0 {
                size = 1;
            }
            if align < 1 {
                align = 1;
            }
            cur = (cur + size + align - 1) / align * align;
            self.loff[i] = -cur;
            i += 1;
        }
        cur = (cur + 7) / 8 * 8;
        for r in al.used_callee.iter() {
            cur += 8;
            self.saved.push((*r, -cur));
        }
        let nslots = al.slot_ptr.len() as i64;
        self.ssa_slots = -(cur + 8);
        cur += 8 * nslots;
        let mut s = 0;
        while s < al.slot_ptr.len() {
            if al.slot_ptr[s] {
                self.ptr_slots.push(self.ssa_slot_off(s as i32));
            }
            s += 1;
        }
        let mut max_res = 16i64;
        let mut max_out = 48i64;
        for b in f.blocks.iter() {
            if let Term::Call { args, dest, .. } = &b.term {
                let dt = self.place_type(dest);
                let sz = self.size(dt);
                if sz > max_res {
                    max_res = sz;
                }
                let mut na = 0i64;
                for a in args.iter() {
                    let at = self.operand_type(a);
                    na += round8(self.size(at));
                }
                if na > max_out {
                    max_out = na;
                }
            }
        }
        self.buf_top = -cur;
        cur = (cur + max_res + 7) / 8 * 8;
        self.res_off = -cur;
        cur = (cur + 16 + 7) / 8 * 8;
        self.tmp_off = -cur;
        cur += bridge;
        self.ssa_bridge = -cur;
        let frame = ((cur + 15) & !15) + ((max_out + 15) & !15);
        self.frame = frame;
        // The stack-ABI entry: the parameters passed in registers to direct
        // calls are loaded from the stack, then the register entry (.r)
        // follows.
        let aregs = self.arg_regs();
        let mut pi = 0;
        while pi < n {
            self.ssa_pr.push(-1);
            pi += 1;
        }
        if !f.closure {
            let mut ts: Vec<&Type> = Vec::new();
            pi = self.first_arg();
            while pi <= f.nargs {
                ts.push(self.ltypes[pi]);
                pi += 1;
            }
            let rp = self.reg_params(&ts);
            let entry_arg = if self.g.tgt.code_unit == 4 || self.g.tgt.wasm {
                -16
            } else {
                -8
            };
            pi = self.first_arg();
            let mut k = 0;
            while pi <= f.nargs {
                self.ssa_pr[pi] = rp[k];
                if rp[k] >= 0 {
                    let t = self.ltypes[pi];
                    let words = self.ssa_words(t);
                    let mut w = 0;
                    while w < words {
                        let size = if words == 1 { self.size(t) } else { 8 };
                        m.load(
                            size,
                            aregs[(rp[k] + w) as usize],
                            SP,
                            self.loff[pi] + entry_arg + 8 * w,
                        );
                        w += 1;
                    }
                }
                pi += 1;
                k += 1;
            }
        }
        self.g.cur_reg_off = m.entry_point() as i64;
        // The prologue (as gen's).
        let overflow = m.new_label();
        let resume = m.new_label();
        let need = frame + 16;
        m.load(8, I1, GREG, 0);
        m.mov(I2, SP);
        m.add_imm(I2, -need);
        m.cmp(I2, I1);
        m.branch_if(LTU, overflow);
        m.bind(resume);
        self.stub_list.push(Stub::Overflow(overflow, resume, need));
        m.prologue(frame);
        for sv in self.saved.iter() {
            m.store(8, sv.0, FP, sv.1);
        }
        // CTX, RET and LOC are kept only by functions that read them
        // (direct callers do not set the others: see ssa_call).
        if f.closure {
            // The environment (CTX) is read by the entry's Arg 1, or kept in
            // its slot.
            if !sf.is_var[1] {
                m.store(8, CTX, FP, self.loff[1]);
            }
            m.load(8, I1, CTX, -8);
            m.store(8, I1, FP, SLOT_CTX);
        } else if self.keeps_ctx() {
            m.store(8, CTX, FP, SLOT_CTX);
        }
        if self.keeps_ret() {
            m.store(8, RET, FP, SLOT_RET);
        }
        if self.keeps_loc() {
            m.store(8, LOC, FP, SLOT_LOC);
        }
        // (The unwinder reads every frame's defer chain.)
        m.store_zero(8, FP, SLOT_DEFERS);
        self.ssa_carry_plan(sf, &fused);
        // The calls' tags (in emission order) index their masks.
        let mut masks: Vec<u16> = Vec::new();
        masks.push(0);
        let mut labels: Vec<Label> = Vec::new();
        for _ in sf.blocks.iter() {
            labels.push(m.new_label());
        }
        let mut call_no = 0i64;
        let nb = sf.blocks.len();
        // Layout: jumps through empty blocks (no values, no phi moves) go
        // straight on; blocks that end in a panic come last (cold).
        let mut to: Vec<usize> = Vec::new();
        let mut i = 0;
        while i < nb {
            to.push(i);
            i += 1;
        }
        i = 0;
        while i < nb {
            let b = sf.blocks[i];
            if b.kind == crate::ssa::B_PLAIN
                && b.values.len() == 0
                && b.id != sf.entry.unwrap().id
                && al.edge_moves[i].len() == 0
            {
                let s = b.succs[0];
                if s.id as usize != i {
                    to[i] = s.id as usize;
                }
            }
            i += 1;
        }
        i = 0;
        while i < nb {
            // Follow chains (a cycle of empty blocks stays put).
            let mut t = to[i];
            let mut hops = 0;
            while to[t] != t && hops < nb {
                t = to[t];
                hops += 1;
            }
            if hops >= nb {
                t = i;
            }
            to[i] = t;
            i += 1;
        }
        // Loop headers (a block that dominates a predecessor) check the G's
        // stack limit as prologues do, so that a loop calling nothing
        // still stops for a collector (as a JVM's safepoint polls; Go
        // interrupts the thread instead). Not in the runtime, whose code
        // relies on having no stopping point between some instructions.
        let mut polls: Vec<bool> = Vec::new();
        polls.resize(nb, false);
        let rt = match self.f.def {
            Some(d) => crate::mir::inline::in_runtime(d),
            None => match self.f.owner {
                Some(d) => crate::mir::inline::in_runtime(d),
                None => true,
            },
        };
        // (-d nopoll: none, for comparing.) None on wasm: one thread, so
        // no collector waits for a loop (as Go's js/wasm).
        if !rt && !self.g.tgt.wasm && !crate::dflags::on("nopoll") {
            let d = crate::ssa::dom::dominators(sf);
            for bb in sf.blocks.iter() {
                let b = *bb;
                if d.order[b.id as usize] < 0 {
                    continue;
                }
                for s in b.succs.iter() {
                    let mut x = b.id as i32;
                    while x >= 0 && x != s.id as i32 {
                        x = d.idom[x as usize];
                    }
                    if x == s.id as i32 {
                        polls[to[s.id as usize]] = true;
                    }
                }
            }
        }
        let mut order: Vec<usize> = Vec::new();
        let mut cold: Vec<usize> = Vec::new();
        i = 0;
        while i < nb {
            let b = sf.blocks[i];
            if to[i] == i {
                let panics =
                    b.kind == crate::ssa::B_EXIT && b.control.unwrap().op == crate::ssa::OP_PANIC;
                if panics && i != 0 {
                    cold.push(i);
                } else {
                    order.push(i);
                }
            }
            i += 1;
        }
        for c in cold.iter() {
            order.push(*c);
        }
        let mut oi = 0;
        while oi < order.len() {
            let bi = order[oi];
            let b = sf.blocks[bi];
            m.bind(labels[bi]);
            if bi == 0 {
                self.ssa_entry_args(sf, b);
            }
            if polls[bi] {
                let slow = m.new_label();
                let back = m.new_label();
                m.poll_check(slow);
                m.bind(back);
                self.stub_list.push(Stub::Poll(slow, back));
            }
            for vv in b.values.iter() {
                let v = *vv;
                if self.g.dwarf && v.pos > 0 {
                    self.note_line(v.pos);
                }
                if crate::ssa::regalloc::is_call(v) {
                    masks.push(al.call_mask[v.id as usize] as u16);
                    call_no += 1;
                    m.set_tag(call_no);
                } else {
                    m.set_tag(-1);
                }
                if fused[v.id as usize] {
                    continue;
                }
                self.ssa_value(v);
            }
            let next = if oi + 1 < order.len() {
                order[oi + 1] as i64
            } else {
                -1
            };
            match b.kind {
                crate::ssa::B_PLAIN => {
                    let s = b.succs[0];
                    self.ssa_edge_moves(sf, b);
                    let t = to[s.id as usize];
                    if t as i64 != next {
                        m.jump(labels[t]);
                    }
                }
                crate::ssa::B_IF => {
                    let c = b.control.unwrap();
                    let yes = to[b.succs[0].id as usize];
                    let no = to[b.succs[1].id as usize];
                    if fused[c.id as usize] {
                        let cond = self.ssa_compare(c);
                        if yes as i64 == next {
                            m.branch_if(invert(cond), labels[no]);
                        } else {
                            m.branch_if(cond, labels[yes]);
                            if no as i64 != next {
                                m.jump(labels[no]);
                            }
                        }
                    } else {
                        let r = self.ssa_in(c, V1);
                        if yes as i64 == next {
                            m.branch_zero(r, labels[no]);
                        } else {
                            m.branch_non_zero(r, labels[yes]);
                            if no as i64 != next {
                                m.jump(labels[no]);
                            }
                        }
                    }
                }
                crate::ssa::B_RET => {}
                _ => {
                    let c = b.control.unwrap();
                    if c.op != crate::ssa::OP_PANIC {
                        m.trap();
                    }
                }
            }
            oi += 1;
        }
        self.ssa_masks = masks;
        self.emit_stubs();
        if let Some(t) = t3 {
            crate::backend::ssagen::add_time(3, t.elapsed().as_nanos() as u64);
        }
    }

    /// Stores (or loads back) the register arguments at their stack slots,
    /// before the frame is made (SP as at the entry).
    fn ssa_spill_args(&mut self, store: bool) {
        let m = self.m;
        let aregs = self.arg_regs();
        let entry_arg = if self.g.tgt.code_unit == 4 || self.g.tgt.wasm {
            -16
        } else {
            -8
        };
        let mut l = 0;
        while l < self.ssa_pr.len() {
            if self.ssa_pr[l] >= 0 {
                let words = self.ssa_words(self.ltypes[l]);
                let mut w = 0;
                while w < words {
                    let r = aregs[(self.ssa_pr[l] + w) as usize];
                    let off = self.loff[l] + entry_arg + 8 * w;
                    if store {
                        m.store(8, r, SP, off);
                    } else {
                        m.load(8, r, SP, off);
                    }
                    w += 1;
                }
            }
            l += 1;
        }
    }

    /// At the register entry: parameters in memory get their register words
    /// stored home; the Arg values of the others are moved from their
    /// registers (a parallel copy).
    fn ssa_entry_args(&mut self, sf: &crate::ssa::Func, b: &crate::ssa::Block) {
        let m = self.m;
        let aregs = self.arg_regs();
        let mut l = 0;
        while l < self.ssa_pr.len() {
            if self.ssa_pr[l] >= 0 && !sf.is_var[l] {
                let words = self.ssa_words(self.ltypes[l]);
                let mut w = 0;
                while w < words {
                    m.store(
                        8,
                        aregs[(self.ssa_pr[l] + w) as usize],
                        FP,
                        self.loff[l] + 8 * w,
                    );
                    w += 1;
                }
            }
            l += 1;
        }
        let mut ds: Vec<Loc> = Vec::new();
        let mut ss: Vec<Loc> = Vec::new();
        for vv in b.values.iter() {
            let v = *vv;
            if v.op != crate::ssa::OP_ARG {
                continue;
            }
            let lv = (v.aux_int >> 1) as usize;
            if self.ssa_pr[lv] < 0 {
                continue;
            }
            let d = self.ssa_loc(v);
            if d.kind == 2 {
                continue;
            }
            let r = aregs[(self.ssa_pr[lv] + (v.aux_int & 1)) as usize];
            let src = Loc {
                kind: 0,
                fp: false,
                f64: false,
                reg: r,
                off: 0,
                val: None,
            };
            if same_loc(&d, &src) {
                continue;
            }
            ds.push(d);
            ss.push(src);
        }
        self.ssa_parallel(&mut ds, &mut ss);
    }

    /// Compares a fused comparison's operands; the condition its value is.
    fn ssa_compare(&mut self, c: &crate::ssa::Value) -> Cond {
        let m = self.m;
        let signed = c.aux_int & 2 != 0;
        let size = crate::ssa::ty_size(c.args[0].ty);
        let mut a = self.ssa_in(c.args[0], V1);
        if signed && size < 8 {
            m.sign_ext(V1, a, size);
            a = V1;
        }
        let k = c.args[1];
        let mut imm = false;
        if k.op == crate::ssa::OP_CONST
            && self.ssa_alloc.reg[k.id as usize] < 0
            && self.ssa_alloc.slot[k.id as usize] < 0
        {
            // The constant as the comparison sees it (signed: extended).
            let mut x = k.aux_int;
            if signed && size < 8 {
                let sh = (64 - 8 * size) as u32;
                x = (x << sh) >> sh;
            }
            if x > -4096 && x < 4096 {
                m.cmp_imm(a, x);
                imm = true;
            }
        }
        if !imm {
            let mut b = self.ssa_in(k, V2);
            if signed && size < 8 {
                m.sign_ext(V2, b, size);
                b = V2;
            }
            m.cmp(a, b);
        }
        match c.op {
            crate::ssa::OP_EQ => EQ,
            crate::ssa::OP_NE => NE,
            crate::ssa::OP_LT => {
                if signed {
                    LT
                } else {
                    LTU
                }
            }
            _ => {
                if signed {
                    LE
                } else {
                    LEU
                }
            }
        }
    }

    /// The location of v for moves.
    fn ssa_loc(&self, v: &mut crate::ssa::Value) -> Loc {
        let id = v.id as usize;
        let fp = crate::ssa::is_float(v.ty);
        let f64 = v.ty == crate::ssa::T_F64;
        let r = self.ssa_alloc.reg[id];
        if r >= 0 {
            return Loc {
                kind: 0,
                fp,
                f64,
                reg: r as Reg,
                off: 0,
                val: None,
            };
        }
        let s = self.ssa_alloc.slot[id];
        if s >= 0 {
            return Loc {
                kind: 1,
                fp,
                f64,
                reg: 0,
                off: self.ssa_slot_off(s),
                val: None,
            };
        }
        Loc {
            kind: 2,
            fp,
            f64,
            reg: 0,
            off: 0,
            val: Some(v),
        }
    }

    fn ssa_move(&mut self, dst: &Loc, src: &Loc) {
        let m = self.m;
        // Argument registers carry floats as bits.
        if dst.fp && src.kind == 0 && !src.fp {
            if dst.kind == 0 {
                m.fmov_to(dst.reg, src.reg, dst.f64);
            } else {
                m.store(8, src.reg, FP, dst.off);
            }
            return;
        }
        if !dst.fp && dst.kind == 0 && src.fp {
            match src.kind {
                0 => m.fmov_from(dst.reg, src.reg, src.f64),
                1 => m.load(8, dst.reg, FP, src.off),
                _ => m.mov_imm(dst.reg, src.val.unwrap().aux_int),
            }
            return;
        }
        if dst.fp {
            // Slots hold 8 bytes; slot to slot copies the bits.
            if dst.kind == 0 {
                match src.kind {
                    0 => m.fmov(dst.reg, src.reg),
                    1 => m.fload(8, dst.reg, FP, src.off),
                    _ => self.ssa_remat(src.val.unwrap(), dst.reg),
                }
                return;
            }
            match src.kind {
                0 => m.fstore(8, src.reg, FP, dst.off),
                1 => {
                    m.load(8, T1, FP, src.off);
                    m.store(8, T1, FP, dst.off);
                }
                _ => {
                    let c = src.val.unwrap();
                    m.mov_imm(T1, c.aux_int);
                    m.store(8, T1, FP, dst.off);
                }
            }
            return;
        }
        if dst.kind == 0 {
            match src.kind {
                0 => m.mov(dst.reg, src.reg),
                1 => m.load(8, dst.reg, FP, src.off),
                _ => self.ssa_remat(src.val.unwrap(), dst.reg),
            }
            return;
        }
        let r = match src.kind {
            0 => src.reg,
            1 => {
                m.load(8, T1, FP, src.off);
                T1
            }
            _ => {
                self.ssa_remat(src.val.unwrap(), T1);
                T1
            }
        };
        m.store(8, r, FP, dst.off);
    }

    /// The moves at the end of plain block b into the places its successor
    /// expects (the allocation's edge moves: a parallel copy).
    fn ssa_edge_moves(&mut self, sf: &crate::ssa::Func, b: &crate::ssa::Block) {
        let al = self.ssa_alloc;
        let ms = al.edge_moves[b.id as usize];
        if ms.len() == 0 {
            return;
        }
        let mut dsts: Vec<Loc> = Vec::new();
        let mut srcs: Vec<Loc> = Vec::new();
        for mv in ms.iter() {
            let v = sf.values[mv.val as usize];
            let fp = crate::ssa::is_float(v.ty);
            let f64 = v.ty == crate::ssa::T_F64;
            let src = if mv.src_reg >= 0 {
                Loc {
                    kind: 0,
                    fp,
                    f64,
                    reg: mv.src_reg as Reg,
                    off: 0,
                    val: None,
                }
            } else if mv.src_slot >= 0 {
                Loc {
                    kind: 1,
                    fp,
                    f64,
                    reg: 0,
                    off: self.ssa_slot_off(mv.src_slot),
                    val: None,
                }
            } else {
                Loc {
                    kind: 2,
                    fp,
                    f64,
                    reg: 0,
                    off: 0,
                    val: Some(v),
                }
            };
            let dst = if mv.dst_reg >= 0 {
                Loc {
                    kind: 0,
                    fp,
                    f64,
                    reg: mv.dst_reg as Reg,
                    off: 0,
                    val: None,
                }
            } else {
                Loc {
                    kind: 1,
                    fp,
                    f64,
                    reg: 0,
                    off: self.ssa_slot_off(mv.dst_slot),
                    val: None,
                }
            };
            dsts.push(dst);
            srcs.push(src);
        }
        self.ssa_parallel(&mut dsts, &mut srcs);
    }

    /// Emits moves dsts[i] <- srcs[i] as if at once: a move whose
    /// destination no other pending move reads first; cycles broken through
    /// I1 (floats: F0).
    fn ssa_parallel(&mut self, dsts: &mut Vec<Loc>, srcs: &mut Vec<Loc>) {
        while dsts.len() > 0 {
            let mut done = false;
            let mut i = 0;
            while i < dsts.len() {
                let mut read = false;
                let mut j = 0;
                while j < srcs.len() {
                    if j != i && same_loc(&srcs[j], &dsts[i]) {
                        read = true;
                    }
                    j += 1;
                }
                if !read {
                    let d = dsts.remove(i);
                    let sv = srcs.remove(i);
                    self.ssa_move(&d, &sv);
                    done = true;
                    break;
                }
                i += 1;
            }
            if done {
                continue;
            }
            // A cycle: park the first source in I1 (floats: F0).
            let t = if srcs[0].fp {
                Loc {
                    kind: 0,
                    fp: true,
                    f64: true,
                    reg: F0,
                    off: 0,
                    val: None,
                }
            } else {
                Loc {
                    kind: 0,
                    fp: false,
                    f64: false,
                    reg: I1,
                    off: 0,
                    val: None,
                }
            };
            let first = srcs[0].clone();
            self.ssa_move(&t, &first);
            let mut j = 0;
            while j < srcs.len() {
                if same_loc(&srcs[j], &first) {
                    srcs[j] = t.clone();
                }
                j += 1;
            }
        }
    }

    /// Generates one value.
    fn ssa_value(&mut self, v: &mut crate::ssa::Value) {
        let m = self.m;
        let op = v.op;
        let nargs = v.args.len();
        match op {
            crate::ssa::OP_INITMEM | crate::ssa::OP_PHI => {}
            crate::ssa::OP_ARG => {
                let l = (v.aux_int >> 1) as usize;
                // Moved from its register at the entry.
                if l < self.ssa_pr.len() && self.ssa_pr[l] >= 0 {
                    return;
                }
                let w = v.aux_int & 1;
                let d = self.ssa_dst(v, V1);
                if self.f.closure && l == 1 {
                    m.mov(d, CTX);
                } else {
                    let size = if w == 0 && !self.ssa_two(v) {
                        self.size(self.ltypes[l])
                    } else {
                        8
                    };
                    let sz = if size > 8 { 8 } else { size };
                    if crate::ssa::is_float(v.ty) {
                        m.fload(sz, d, FP, self.loff[l] + 8 * w);
                    } else {
                        m.load(sz, d, FP, self.loff[l] + 8 * w);
                    }
                }
                self.ssa_out(v, d);
            }
            crate::ssa::OP_COPY | crate::ssa::OP_RETYPE | crate::ssa::OP_ZEXT => {
                let a = self.ssa_in(v.args[0], V1);
                let d = self.ssa_dst(v, V1);
                let fa = crate::ssa::is_float(v.args[0].ty);
                let fd = crate::ssa::is_float(v.ty);
                if fa && fd {
                    m.fmov(d, a);
                } else if fa {
                    m.fmov_from(d, a, v.args[0].ty == crate::ssa::T_F64);
                } else if fd {
                    m.fmov_to(d, a, v.ty == crate::ssa::T_F64);
                } else if a != d {
                    m.mov(d, a);
                }
                self.ssa_out(v, d);
            }
            crate::ssa::OP_CONST
            | crate::ssa::OP_LOCALADDR
            | crate::ssa::OP_RESADDR
            | crate::ssa::OP_CONSTSYM
            | crate::ssa::OP_CONSTPARAM
            | crate::ssa::OP_VTABLE
            | crate::ssa::OP_CLOSURECODE => {
                if self.ssa_alloc.reg[v.id as usize] >= 0 || self.ssa_alloc.slot[v.id as usize] >= 0
                {
                    let d = self.ssa_dst(v, V1);
                    self.ssa_remat(v, d);
                    self.ssa_out(v, d);
                }
            }
            crate::ssa::OP_RETPTR => {
                let d = self.ssa_dst(v, V1);
                m.load(8, d, FP, SLOT_RET);
                self.ssa_out(v, d);
            }
            crate::ssa::OP_OFFPTR => {
                let a = self.ssa_in(v.args[0], V1);
                let d = self.ssa_dst(v, V1);
                if a == d {
                    m.add_imm(d, v.aux_int);
                } else {
                    m.addr_of(d, a, v.aux_int);
                }
                self.ssa_out(v, d);
            }
            crate::ssa::OP_INDEXPTR => {
                let a = self.ssa_in(v.args[0], V1);
                let ix = self.ssa_in(v.args[1], V2);
                let d = self.ssa_dst(v, V1);
                let es = v.aux_int;
                if es == 1 || es == 2 || es == 4 || es == 8 {
                    m.add_scaled(
                        d,
                        a,
                        ix,
                        if es == 1 {
                            0
                        } else if es == 2 {
                            1
                        } else if es == 4 {
                            2
                        } else {
                            3
                        },
                    );
                } else {
                    m.mov_imm(I2, es);
                    m.mul_add(d, ix, I2, a);
                }
                self.ssa_out(v, d);
            }
            crate::ssa::OP_ADD
            | crate::ssa::OP_SUB
            | crate::ssa::OP_MUL
            | crate::ssa::OP_DIV
            | crate::ssa::OP_REM
            | crate::ssa::OP_AND
            | crate::ssa::OP_OR
            | crate::ssa::OP_XOR
            | crate::ssa::OP_SHL
            | crate::ssa::OP_SHR => self.ssa_arith(v),
            crate::ssa::OP_ADDC | crate::ssa::OP_SUBB => {
                // The sum and the carry made straight in the selects'
                // places (see ssa_carry_plan).
                let sub = op == crate::ssa::OP_SUBB;
                let c = v.args[2];
                let zero = c.op == crate::ssa::OP_CONST && c.aux_int == 0;
                let id = v.id as usize;
                let a = self.ssa_in(v.args[0], V1);
                let b = self.ssa_in(v.args[1], V2);
                if !zero && !self.ssa_chained[id] {
                    let cr = self.ssa_in(c, RA);
                    m.carry_in(cr, sub);
                }
                let s0 = self.ssa_sel0[id];
                let d = if s0 >= 0 {
                    self.ssa_dst(self.f_values(s0), V1)
                } else {
                    V1
                };
                m.add_carry(d, a, b, !zero, sub);
                if s0 >= 0 {
                    self.ssa_out(self.f_values(s0), d);
                }
                if self.ssa_need_carry[id] {
                    let s1 = self.ssa_sel1[id];
                    let d1 = self.ssa_dst(self.f_values(s1), V2);
                    m.carry_out(d1, sub);
                    self.ssa_out(self.f_values(s1), d1);
                }
                return;
            }
            crate::ssa::OP_STOREREG => {
                // A spill: the value's register to the StoreReg's slot.
                let x = v.args[0];
                let r = self.ssa_in(x, V1);
                let off = self.ssa_slot_off(self.ssa_alloc.slot[v.id as usize]);
                if crate::ssa::is_float(x.ty) {
                    m.fstore(8, r, FP, off);
                } else {
                    m.store(8, r, FP, off);
                }
            }
            crate::ssa::OP_LOADREG => {
                // A restore from the slot of its argument (a StoreReg, or a
                // phi or an argument kept in a slot).
                let off = self.ssa_slot_off(self.ssa_alloc.slot[v.args[0].id as usize]);
                let d = self.ssa_alloc.reg[v.id as usize] as Reg;
                if crate::ssa::is_float(v.ty) {
                    m.fload(8, d, FP, off);
                } else {
                    m.load(8, d, FP, off);
                }
            }
            crate::ssa::OP_MULHI => {
                let a = self.ssa_in(v.args[0], V1);
                let b = self.ssa_in(v.args[1], V2);
                let d = self.ssa_dst(v, V1);
                m.arith(MULHI_U, d, a, b);
                self.ssa_out(v, d);
            }
            crate::ssa::OP_NEG | crate::ssa::OP_NOT => {
                let a = self.ssa_in(v.args[0], V1);
                let d = self.ssa_dst(v, V1);
                let size = crate::ssa::ty_size(v.ty);
                if op == crate::ssa::OP_NOT {
                    if v.ty == crate::ssa::T_BOOL {
                        m.mov_imm(V2, 1);
                        m.arith(XOR, d, a, V2);
                    } else {
                        m.not(d, a);
                        if size < 8 {
                            m.zero_ext(d, d, size);
                        }
                    }
                } else {
                    if v.aux_int & 2 != 0 {
                        m.sign_ext(V2, a, size);
                        m.mov_imm(T1, int_min(size));
                        m.cmp(V2, T1);
                        let l = self.panic_stub("attempt to negate with overflow", v.pos);
                        m.branch_if(EQ, l);
                    }
                    m.neg(d, a);
                    if size < 8 {
                        m.zero_ext(d, d, size);
                    }
                }
                self.ssa_out(v, d);
            }
            crate::ssa::OP_EQ | crate::ssa::OP_NE | crate::ssa::OP_LT | crate::ssa::OP_LE => {
                let c = self.ssa_compare(v);
                let d = self.ssa_dst(v, V1);
                m.set_cond(d, c);
                self.ssa_out(v, d);
            }
            crate::ssa::OP_FADD
            | crate::ssa::OP_FSUB
            | crate::ssa::OP_FMUL
            | crate::ssa::OP_FDIV => {
                let f64_ = v.ty == crate::ssa::T_F64;
                let a = self.ssa_in(v.args[0], F0);
                let b = self.ssa_in(v.args[1], F1);
                let fop = match op {
                    crate::ssa::OP_FADD => ADD,
                    crate::ssa::OP_FSUB => SUB,
                    crate::ssa::OP_FMUL => MUL,
                    _ => FDIV,
                };
                let d = self.ssa_dst(v, F0);
                m.farith(fop, d, a, b, f64_);
                self.ssa_out(v, d);
            }
            crate::ssa::OP_FNEG => {
                let f64_ = v.ty == crate::ssa::T_F64;
                let a = self.ssa_in(v.args[0], F0);
                let d = self.ssa_dst(v, F0);
                m.fneg(d, a, f64_);
                self.ssa_out(v, d);
            }
            crate::ssa::OP_FEQ | crate::ssa::OP_FNE | crate::ssa::OP_FLT | crate::ssa::OP_FLE => {
                let f64_ = v.args[0].ty == crate::ssa::T_F64;
                let a = self.ssa_in(v.args[0], F0);
                let b = self.ssa_in(v.args[1], F1);
                let c = match op {
                    crate::ssa::OP_FEQ => EQ,
                    crate::ssa::OP_FNE => NE,
                    crate::ssa::OP_FLT => LT,
                    _ => LE,
                };
                let d = self.ssa_dst(v, V1);
                m.fcompare(d, c, a, b, f64_);
                self.ssa_out(v, d);
            }
            crate::ssa::OP_SEXT => {
                let a = self.ssa_in(v.args[0], V1);
                let d = self.ssa_dst(v, V1);
                m.sign_ext(d, a, v.aux_int);
                let size = crate::ssa::ty_size(v.ty);
                if size < 8 {
                    m.zero_ext(d, d, size);
                }
                self.ssa_out(v, d);
            }
            crate::ssa::OP_TRUNC => {
                let a = self.ssa_in(v.args[0], V1);
                let d = self.ssa_dst(v, V1);
                m.zero_ext(d, a, crate::ssa::ty_size(v.ty));
                self.ssa_out(v, d);
            }
            crate::ssa::OP_FCONV => {
                let a = self.ssa_in(v.args[0], F0);
                let to64 = v.ty == crate::ssa::T_F64;
                let d = self.ssa_dst(v, F0);
                m.float_conv(d, a, to64);
                self.ssa_out(v, d);
            }
            crate::ssa::OP_ITOF => {
                let a = self.ssa_in(v.args[0], V1);
                let to64 = v.ty == crate::ssa::T_F64;
                let signed = v.aux_int & 256 != 0;
                let size = v.aux_int & 255;
                let d = self.ssa_dst(v, F0);
                if signed {
                    m.sign_ext(V1, a, size);
                    m.int_to_float(d, V1, true, to64);
                } else {
                    m.int_to_float(d, a, false, to64);
                }
                self.ssa_out(v, d);
            }
            crate::ssa::OP_FTOI => {
                let a = self.ssa_in(v.args[0], F0);
                let from64 = v.args[0].ty == crate::ssa::T_F64;
                let signed = v.aux_int & 256 != 0;
                let size = crate::ssa::ty_size(v.ty);
                let d = self.ssa_dst(v, V1);
                if size == 8 {
                    m.float_to_int(d, a, signed, from64);
                } else {
                    m.float_to_int(d, a, true, from64);
                    let (lo, hi) = if signed {
                        (int_min(size), -int_min(size) - 1)
                    } else {
                        (0, (1i64 << (8 * size) as u32) - 1)
                    };
                    m.mov_imm(V2, lo);
                    m.cmp(d, V2);
                    m.select_reg(d, V2, d, LT);
                    m.mov_imm(V2, hi);
                    m.cmp(d, V2);
                    m.select_reg(d, V2, d, GT);
                    m.zero_ext(d, d, size);
                }
                self.ssa_out(v, d);
            }
            crate::ssa::OP_LOAD => {
                let (b, o) = self.ssa_addr(v.args[0], v.aux_int, V2);
                let d = self.ssa_dst(v, V1);
                if crate::ssa::is_float(v.ty) {
                    m.fload(crate::ssa::ty_size(v.ty), d, b, o);
                } else {
                    m.load(crate::ssa::ty_size(v.ty), d, b, o);
                }
                self.ssa_out(v, d);
            }
            crate::ssa::OP_STORE => {
                let (b, o) = self.ssa_addr(v.args[0], v.aux_int, V2);
                let x = self.ssa_in(v.args[1], V1);
                self.ssa_store_word(v.args[1], x, crate::ssa::ty_size(v.args[1].ty), b, o);
            }
            crate::ssa::OP_MOVE => {
                let d = self.ssa_in(v.args[0], BASE);
                if d != BASE {
                    m.mov(BASE, d);
                }
                let s = self.ssa_in(v.args[1], RA);
                if s != RA {
                    m.mov(RA, s);
                }
                self.copy_mem(BASE, 0, RA, 0, v.aux_int);
            }
            crate::ssa::OP_ZERO => {
                let d = self.ssa_in(v.args[0], BASE);
                if d != BASE {
                    m.mov(BASE, d);
                }
                self.zero_mem(BASE, 0, v.aux_int);
            }
            crate::ssa::OP_WB => {
                let a = self.ssa_in(v.args[0], RA);
                if a != RA {
                    m.mov(RA, a);
                }
                self.write_barrier(v.aux_int);
            }
            crate::ssa::OP_DISCR => {
                let a = self.ssa_in(v.args[0], RA);
                if a != RA {
                    m.mov(RA, a);
                }
                let t = match &v.aux {
                    crate::ssa::Aux::Ty(t) => *t,
                    _ => return,
                };
                self.read_variant(t);
                let d = self.ssa_dst(v, V1);
                if d != V1 {
                    m.mov(d, V1);
                }
                self.ssa_out(v, d);
            }
            crate::ssa::OP_SETDISCR => {
                let a = self.ssa_in(v.args[0], BASE);
                if a != BASE {
                    m.mov(BASE, a);
                }
                let t = match &v.aux {
                    crate::ssa::Aux::Ty(t) => *t,
                    _ => return,
                };
                self.write_tag(BASE, t, v.aux_int as usize);
            }
            crate::ssa::OP_ALLOC => {
                let t = match &v.aux {
                    crate::ssa::Aux::Ty(t) => *t,
                    _ => return,
                };
                let (mask, words) = self.ptr_mask(t);
                if mask == 0 || words == 0 {
                    self.call_alloc(v.aux_int, mask == 0);
                } else {
                    m.mov_imm(V1, v.aux_int);
                    self.call_alloc_typed(mask, words);
                }
            }
            crate::ssa::OP_SELECT => {
                let t = v.args[0];
                if v.ty == crate::ssa::T_MEM {
                    return;
                }
                if t.op == crate::ssa::OP_ALLOC {
                    let d = self.ssa_dst(v, V1);
                    m.load(8, d, FP, self.res_off);
                    self.ssa_out(v, d);
                    return;
                }
                // (An AddC/SubB made its selects.)
                if t.op == crate::ssa::OP_ADDC || t.op == crate::ssa::OP_SUBB {
                    return;
                }
                if t.op == crate::ssa::OP_INTRINSIC
                    || t.op == crate::ssa::OP_CLOSURE
                    || t.op == crate::ssa::OP_CALL
                {
                    // Intrinsics and calls leave their words in V1, V2;
                    // closures their environment in V2.
                    let src = if t.op == crate::ssa::OP_CLOSURE || v.aux_int == 1 {
                        V2
                    } else {
                        V1
                    };
                    let d = self.ssa_dst(v, V1);
                    if crate::ssa::is_float(v.ty) {
                        m.fmov_to(d, src, v.ty == crate::ssa::T_F64);
                    } else if d != src {
                        m.mov(d, src);
                    }
                    self.ssa_out(v, d);
                    return;
                }
                self.g
                    .errorf(`${self.f.name}: select of ${crate::ssa::op_name(t.op)}`.to_string());
            }
            crate::ssa::OP_CALL => self.ssa_call(v),
            crate::ssa::OP_INTRINSIC => {
                let (t, tg, slot) = match &v.aux {
                    crate::ssa::Aux::Call(t, Some(tg), slot) => (*t, *tg, *slot),
                    _ => return,
                };
                let (args, dest, target, pos) = match t {
                    Term::Call {
                        args,
                        dest,
                        target,
                        pos,
                        ..
                    } => (args, dest, *target, *pos),
                    _ => return,
                };
                if slot >= 0 {
                    // type_desc in shared code: from the dictionary.
                    m.load(8, V1, FP, SLOT_CTX);
                    m.load(8, V1, V1, 16 * slot);
                    return;
                }
                let dt = self.place_type(dest);
                if tg.intrinsic == "asm" {
                    // The arguments' words straight to the outgoing area.
                    if self.ssa_asm_args(v, args) {
                        self.asm_ret = v.aux_int - 1;
                        self.intrinsic_body(tg, &Vec::new(), target, pos, dt);
                        self.asm_ret = -1;
                        return;
                    }
                    self.asm_ret = v.aux_int - 1;
                }
                let mut ai = 0usize;
                let mut off = 0i64;
                let bargs = self.ssa_bridged(v, args, &mut ai, &mut off);
                self.intrinsic_body(tg, &bargs, target, pos, dt);
                self.asm_ret = -1;
            }
            crate::ssa::OP_CLOSURE => {
                let rv = match &v.aux {
                    crate::ssa::Aux::Rv(rv) => *rv,
                    _ => return,
                };
                let (ops, cf) = match rv {
                    Rvalue::Aggregate { ops, closure, .. } => (ops, closure.unwrap()),
                    _ => return,
                };
                let mut ai = 0usize;
                let mut off = 0i64;
                let bops = self.ssa_bridged(v, ops, &mut ai, &mut off);
                self.closure(&bops, cf);
            }
            crate::ssa::OP_DEFER => {
                let st = match &v.aux {
                    crate::ssa::Aux::Stmt(st) => *st,
                    _ => return,
                };
                let (fn_op, args) = match st {
                    Stmt::PushDefer { fn_op, args } => (fn_op, args),
                    _ => return,
                };
                let mut ai = 0usize;
                let mut off = 0i64;
                // A constant callee has no SSA arguments.
                let mut fo: Vec<Operand> = Vec::new();
                fo.push(fn_op.clone());
                let bfn = if fn_op.kind == mir::OP_CONST {
                    fo
                } else {
                    self.ssa_bridged(v, &fo, &mut ai, &mut off)
                };
                let bargs = self.ssa_bridged(v, args, &mut ai, &mut off);
                self.push_defer(&bfn[0], &bargs);
            }
            crate::ssa::OP_FREM => {
                let f64_ = v.ty == crate::ssa::T_F64;
                let a = self.ssa_in(v.args[0], F0);
                m.fstore(8, a, SP, 0);
                let b = self.ssa_in(v.args[1], F1);
                m.fstore(8, b, SP, 8);
                let name = if f64_ { "fmod" } else { "fmodf" };
                let sym = self.g.extern_sym(name);
                let mut cargs = Vec::new();
                cargs.push(CArg {
                    float: true,
                    f64: f64_,
                    variadic: false,
                    size: if f64_ { 8 } else { 4 },
                });
                cargs.push(CArg {
                    float: true,
                    f64: f64_,
                    variadic: false,
                    size: if f64_ { 8 } else { 4 },
                });
                m.call_c(sym.as_str(), 0, &cargs, true, f64_, false, 0);
                let d = self.ssa_dst(v, F0);
                m.fmov_to(d, V1, f64_);
                self.ssa_out(v, d);
            }
            crate::ssa::OP_PANIC => {
                if v.aux_int == 1 {
                    let l = self.ssa_in(v.args[0], V1);
                    m.store(8, l, SP, 0);
                    let ix = self.ssa_in(v.args[1], V1);
                    m.store(8, ix, SP, 8);
                    match self.f.file_pos(v.pos) {
                        (Some(file), p) => self.store_file_pos(16, file, p),
                        (None, _) => self.store_file_line(16, "<unknown>", 0, 0),
                    }
                    self.call_runtime("panic_bounds");
                    m.trap();
                    return;
                }
                let msg = match &v.aux {
                    crate::ssa::Aux::Str(s) => s.clone(),
                    _ => String::new(),
                };
                self.call_panic(msg.as_str(), v.pos);
            }
            crate::ssa::OP_RETURN => {
                let size = self.size(self.ltypes[0]);
                let rw = self.reg_words(self.ltypes[0]);
                if rw > 0 {
                    self.ssa_return_regs(v, rw, size);
                    return;
                }
                // The result's words go to the caller's slot first (the
                // defers cannot change a variable).
                if nargs > 1 && size > 0 {
                    m.load(8, BASE, FP, SLOT_RET);
                    let w0 = self.ssa_in(v.args[0], V1);
                    self.ssa_store_word(v.args[0], w0, if nargs > 2 { 8 } else { size }, BASE, 0);
                    if nargs > 2 {
                        let w1 = self.ssa_in(v.args[1], V1);
                        self.ssa_store_word(v.args[1], w1, 8, BASE, 8);
                    }
                }
                self.ssa_run_defers();
                if nargs == 1 && size > 0 && !self.ssa_var0 {
                    m.load(8, BASE, FP, SLOT_RET);
                    self.local_addr(RA, 0);
                    self.copy_mem(BASE, 0, RA, 0, size);
                }
                for sv in self.saved.iter() {
                    m.load(8, sv.0, FP, sv.1);
                }
                m.ret();
            }
            _ => self.g.errorf(
                `${self.f.name}: SSA op ${crate::ssa::op_name(op)} not generated`.to_string(),
            ),
        }
    }

    /// Runs the frame's deferred calls (only a function that defers any
    /// has them).
    fn ssa_run_defers(&mut self) {
        if !self.ssa_defers {
            return;
        }
        let m = self.m;
        m.load(8, CTX, FP, SLOT_DEFERS);
        let skip = m.new_label();
        m.branch_zero(CTX, skip);
        m.call(&self.g.sym_rundefers);
        m.bind(skip);
    }

    /// Returns a result of rw words (size bytes) in V1, V2, as direct
    /// calls take it, and at the caller's slot unless that is 0 (callers
    /// through the stack entry give one).
    fn ssa_return_regs(&mut self, v: &crate::ssa::Value, rw: i64, size: i64) {
        let m = self.m;
        let nargs = v.args.len();
        // The words' sizes (an aggregate's last may be short).
        let ws = if size < 8 { size } else { 8 };
        let ws1 = size - 8;
        if nargs > 1 {
            // Variables: the words are final before the defers.
            let mut w = 0;
            while w < rw {
                let a = v.args[w as usize];
                let dst = if w == 0 { V1 } else { V2 };
                let r = self.ssa_in(a, dst);
                if crate::ssa::is_float(a.ty) {
                    m.fmov_from(dst, r, a.ty == crate::ssa::T_F64);
                } else if r != dst {
                    m.mov(dst, r);
                }
                w += 1;
            }
            if self.ssa_defers {
                m.store(8, V1, FP, self.tmp_off);
                if rw == 2 {
                    m.store(8, V2, FP, self.tmp_off + 8);
                }
                self.ssa_run_defers();
                m.load(8, V1, FP, self.tmp_off);
                if rw == 2 {
                    m.load(8, V2, FP, self.tmp_off + 8);
                }
            }
        } else {
            // In memory: read after the defers.
            self.ssa_run_defers();
            self.local_addr(RA, 0);
            m.load(ws, V1, RA, 0);
            if rw == 2 {
                m.load(ws1, V2, RA, 8);
            }
        }
        m.load(8, BASE, FP, SLOT_RET);
        let skip = m.new_label();
        m.branch_zero(BASE, skip);
        m.store(ws, V1, BASE, 0);
        if rw == 2 {
            m.store(ws1, V2, BASE, 8);
        }
        m.bind(skip);
        for sv in self.saved.iter() {
            m.load(8, sv.0, FP, sv.1);
        }
        m.ret();
    }

    fn f_values(&self, id: i64) -> &mut crate::ssa::Value {
        self.ssa_func.unwrap().values[id as usize]
    }

    /// Plans the AddC/SubB of sf (Go's carry chains): its selects; whether
    /// its carry in is the previous one's still in the flags (nothing in
    /// between sets them: on arm64 loads, stores, moves and unchecked
    /// integer ops do not; on x64 only the selects, and making a constant
    /// operand may xor); whether its carry out is read other than so.
    fn ssa_carry_plan(&mut self, sf: &mut crate::ssa::Func, fused: &Vec<bool>) {
        self.ssa_func = Some(sf);
        let n = sf.values.len();
        let mut sel0 = self.ssa_sel0;
        let mut sel1 = self.ssa_sel1;
        let mut chained = self.ssa_chained;
        let mut need = self.ssa_need_carry;
        sel0.clear();
        sel1.clear();
        chained.clear();
        need.clear();
        sel0.resize(n, -1);
        sel1.resize(n, -1);
        chained.resize(n, false);
        need.resize(n, false);
        let mut any = false;
        for b in sf.blocks.iter() {
            for v in b.values.iter() {
                if v.op == crate::ssa::OP_SELECT
                    && (v.args[0].op == crate::ssa::OP_ADDC || v.args[0].op == crate::ssa::OP_SUBB)
                {
                    let t = v.args[0].id as usize;
                    if v.aux_int == 0 {
                        sel0[t] = v.id as i64;
                    } else if v.aux_int == 1 {
                        sel1[t] = v.id as i64;
                    }
                    any = true;
                }
            }
        }
        if !any {
            return;
        }
        let mut uses: Vec<i32> = Vec::new();
        uses.resize(n, 0);
        let mut chained_uses: Vec<i32> = Vec::new();
        chained_uses.resize(n, 0);
        for b in sf.blocks.iter() {
            for v in b.values.iter() {
                for a in v.args.iter() {
                    uses[a.id as usize] += 1;
                }
            }
            if let Some(c) = b.control {
                uses[c.id as usize] += 1;
            }
        }
        let x64 = self.g.tgt.code_unit != 4 && !self.g.tgt.wasm;
        for b in sf.blocks.iter() {
            let mut flags = -1i64;
            for vv in b.values.iter() {
                let v = *vv;
                if fused[v.id as usize] {
                    continue;
                }
                if v.op == crate::ssa::OP_ADDC || v.op == crate::ssa::OP_SUBB {
                    let c = v.args[2];
                    let zero = c.op == crate::ssa::OP_CONST && c.aux_int == 0;
                    let ch = !zero
                        && c.op == crate::ssa::OP_SELECT
                        && c.aux_int == 1
                        && flags == c.args[0].id as i64
                        && !(x64 && (self.ssa_remade(v.args[0]) || self.ssa_remade(v.args[1])));
                    chained[v.id as usize] = ch;
                    if ch {
                        chained_uses[c.id as usize] += 1;
                    }
                    flags = v.id as i64;
                } else if !(v.op == crate::ssa::OP_SELECT && v.args[0].id as i64 == flags)
                    && !(!x64 && keeps_flags_arm64(v))
                    && v.op != crate::ssa::OP_LOADREG
                    && v.op != crate::ssa::OP_STOREREG
                {
                    flags = -1;
                }
            }
        }
        let mut t = 0;
        while t < n {
            let s1 = sel1[t];
            if s1 >= 0 && uses[s1 as usize] > chained_uses[s1 as usize] {
                need[t] = true;
            }
            t += 1;
        }
        self.ssa_sel0 = sel0;
        self.ssa_sel1 = sel1;
        self.ssa_chained = chained;
        self.ssa_need_carry = need;
    }

    /// Whether v is made where used (no register or slot of its own).
    fn ssa_remade(&self, v: &crate::ssa::Value) -> bool {
        let id = v.id as usize;
        self.ssa_alloc.reg[id] < 0 && self.ssa_alloc.slot[id] < 0
    }

    /// Whether an Arg value is a word of a two-word variable.
    fn ssa_two(&mut self, v: &crate::ssa::Value) -> bool {
        let l = (v.aux_int >> 1) as usize;
        let t = self.ltypes[l];
        self.size(t) == 16
    }

    fn ssa_arith(&mut self, v: &mut crate::ssa::Value) {
        let m = self.m;
        let op = v.op;
        let size = crate::ssa::ty_size(v.ty);
        let signed = v.aux_int & 2 != 0;
        let checked = v.aux_int & 1 != 0;
        // A constant right operand: an immediate.
        let k = v.args[1];
        if k.op == crate::ssa::OP_CONST
            && self.ssa_alloc.reg[k.id as usize] < 0
            && self.ssa_alloc.slot[k.id as usize] < 0
        {
            let c = k.aux_int;
            let shift = op == crate::ssa::OP_SHL || op == crate::ssa::OP_SHR;
            if shift && c >= 0 && c < size * 8 {
                let mut a = self.ssa_in(v.args[0], V1);
                if signed && op == crate::ssa::OP_SHR && size < 8 {
                    m.sign_ext(V1, a, size);
                    a = V1;
                }
                let d = self.ssa_dst(v, V1);
                let sop = if op == crate::ssa::OP_SHL {
                    SHL
                } else if signed {
                    SHR_S
                } else {
                    SHR_U
                };
                m.shift_imm(sop, d, a, c);
                if size < 8 && !(op == crate::ssa::OP_SHR && !signed) {
                    m.zero_ext(d, d, size);
                }
                self.ssa_out(v, d);
                return;
            }
            let plain = !checked;
            if (op == crate::ssa::OP_ADD || op == crate::ssa::OP_SUB) && plain && c >= 0 && c < 4096
            {
                let a = self.ssa_in(v.args[0], V1);
                let d = self.ssa_dst(v, V1);
                m.addr_of(d, a, if op == crate::ssa::OP_ADD { c } else { -c });
                if size < 8 {
                    m.zero_ext(d, d, size);
                }
                self.ssa_out(v, d);
                return;
            }
        }
        let mut a = self.ssa_in(v.args[0], V1);
        let mut b = self.ssa_in(v.args[1], V2);
        let shift = op == crate::ssa::OP_SHL || op == crate::ssa::OP_SHR;
        if signed && size < 8 {
            m.sign_ext(V1, a, size);
            a = V1;
            if !shift {
                m.sign_ext(V2, b, size);
                b = V2;
            }
        }
        let d = self.ssa_dst(v, V1);
        let dbg = checked;
        if op == crate::ssa::OP_ADD || op == crate::ssa::OP_SUB || op == crate::ssa::OP_MUL {
            let what = if op == crate::ssa::OP_ADD {
                "add"
            } else if op == crate::ssa::OP_SUB {
                "subtract"
            } else {
                "multiply"
            };
            let aop = if op == crate::ssa::OP_ADD {
                ADD
            } else if op == crate::ssa::OP_SUB {
                SUB
            } else {
                MUL
            };
            if size == 8 && dbg {
                let l = self.panic_stub(
                    `attempt to ${what} with overflow`.to_string().as_str(),
                    v.pos,
                );
                m.arith_ovf(aop, signed, d, a, b, l);
                self.ssa_out(v, d);
                return;
            }
            m.arith(aop, d, a, b);
            if dbg && size < 8 {
                let l = self.panic_stub(
                    `attempt to ${what} with overflow`.to_string().as_str(),
                    v.pos,
                );
                if signed {
                    m.sign_ext(T1, d, size);
                    m.cmp(T1, d);
                    m.branch_if(NE, l);
                } else {
                    m.mov_imm(T1, (1i64 << (8 * size) as u32) - 1);
                    m.cmp(d, T1);
                    m.branch_if(GTU, l);
                }
            }
        } else if op == crate::ssa::OP_DIV || op == crate::ssa::OP_REM {
            let l = self.panic_stub("attempt to divide by zero", v.pos);
            m.branch_zero(b, l);
            if signed {
                let skip = m.new_label();
                m.cmp_imm(b, -1);
                m.branch_if(NE, skip);
                m.mov_imm(T1, int_min(size));
                m.cmp(a, T1);
                let l2 = self.panic_stub("attempt to divide with overflow", v.pos);
                m.branch_if(EQ, l2);
                m.bind(skip);
            }
            let aop = if op == crate::ssa::OP_DIV && signed {
                DIV_S
            } else if op == crate::ssa::OP_DIV {
                DIV_U
            } else if signed {
                REM_S
            } else {
                REM_U
            };
            m.arith(aop, d, a, b);
        } else if shift {
            if checked {
                m.cmp_imm(b, size * 8);
                let l = self.panic_stub("attempt to shift with overflow", v.pos);
                m.branch_if(GEU, l);
            }
            let aop = if op == crate::ssa::OP_SHL {
                SHL
            } else if signed {
                SHR_S
            } else {
                SHR_U
            };
            m.arith(aop, d, a, b);
        } else {
            let aop = if op == crate::ssa::OP_AND {
                AND
            } else if op == crate::ssa::OP_OR {
                OR
            } else {
                XOR
            };
            m.arith(aop, d, a, b);
        }
        if size < 8
            && op != crate::ssa::OP_AND
            && op != crate::ssa::OP_OR
            && op != crate::ssa::OP_XOR
            && !(op == crate::ssa::OP_SHR && !signed)
        {
            m.zero_ext(d, d, size);
        }
        self.ssa_out(v, d);
    }

    /// A call: the arguments to the outgoing area, then the call as call's.
    fn ssa_call(&mut self, v: &mut crate::ssa::Value) {
        let m = self.m;
        let (t, tgt, slot) = match &v.aux {
            crate::ssa::Aux::Call(t, tg, slot) => (*t, *tg, *slot),
            _ => return,
        };
        let (fn_op, args, pos) = match t {
            Term::Call {
                fn_op, args, pos, ..
            } => (fn_op, args, *pos),
            _ => return,
        };
        if fn_op.kind == mir::OP_COPY {
            let ft = self.operand_type(fn_op);
            if ft.kind == types::K_FN && ft.abi == "C" {
                // Through the old C call: operands bridged, the result to the
                // result buffer.
                let mut ai = 0usize;
                let mut boff = 0i64;
                let mut fo: Vec<Operand> = Vec::new();
                fo.push(fn_op.clone());
                let bfn = self.ssa_bridged(v, &fo, &mut ai, &mut boff);
                let bargs = self.ssa_bridged(v, args, &mut ai, &mut boff);
                let dt = match t {
                    Term::Call { dest, .. } => self.place_type(dest),
                    _ => return,
                };
                if self.c_call_body(&bfn[0], &bargs, dt, "", true, true) && self.size(dt) > 0 {
                    m.store(8, V1, FP, self.res_off);
                }
                return;
            }
        }
        let thin_recv = match tgt {
            Some(tt) => slot < 0 && tt.kind == codegen::T_VIRTUAL,
            None => false,
        };
        // The SSA arguments: the callee's words (not constant), then each
        // argument's words or address.
        let mut ai = 0;
        let mut code: Option<&mut crate::ssa::Value> = None;
        let mut env: Option<&mut crate::ssa::Value> = None;
        if fn_op.kind == mir::OP_COPY {
            code = Some(v.args[0]);
            env = Some(v.args[1]);
            ai = 2;
        }
        let mut vtable: Option<&mut crate::ssa::Value> = None;
        // Direct calls take their words in registers (to the .r entry).
        let direct = match tgt {
            Some(tt) => slot < 0 && tt.kind == codegen::T_INST,
            None => false,
        };

        let aregs = self.arg_regs();
        let mut regp: Vec<i64> = Vec::new();
        if direct {
            let mut ts: Vec<&Type> = Vec::new();
            for a in args.iter() {
                ts.push(self.operand_type(a));
            }
            regp = self.reg_params(&ts);
        }
        let mut mdst: Vec<Loc> = Vec::new();
        let mut msrc: Vec<Loc> = Vec::new();
        let mut off = 0i64;
        let mut i = 0;
        while i < args.len() {
            let at = self.operand_type(&args[i]);
            let size = self.size(at);
            if size == 0 {
                i += 1;
                continue;
            }
            let words = self.ssa_words(at);
            if words == 0 {
                // In memory: v.args[ai] is its address (0: a zero constant).
                let a = v.args[ai];
                ai += 1;
                if a.op == crate::ssa::OP_CONST
                    && a.ty == crate::ssa::T_PTR
                    && a.aux_int == 0
                    && args[i].kind == mir::OP_CONST
                {
                    self.zero_mem(SP, off, size);
                } else {
                    let r = self.ssa_in(a, RA);
                    if r != RA {
                        m.mov(RA, r);
                    }
                    self.copy_mem(SP, off, RA, 0, size);
                }
                off += round8(size);
                i += 1;
                continue;
            }
            if direct && regp[i] >= 0 {
                let mut w = 0;
                while w < words {
                    let r = aregs[(regp[i] + w) as usize];
                    mdst.push(Loc {
                        kind: 0,
                        fp: false,
                        f64: false,
                        reg: r,
                        off: 0,
                        val: None,
                    });
                    msrc.push(self.ssa_loc(v.args[ai + w as usize]));
                    w += 1;
                }
                ai += words as usize;
                off += round8(size);
                i += 1;
                continue;
            }
            let w0 = v.args[ai];
            let r0 = self.ssa_in(w0, V1);
            self.ssa_store_word(w0, r0, if words == 1 { size } else { 8 }, SP, off);
            if words == 2 {
                let w1 = v.args[ai + 1];
                if i == 0 && thin_recv {
                    vtable = Some(w1);
                } else {
                    let r1 = self.ssa_in(w1, V1);
                    self.ssa_store_word(w1, r1, 8, SP, off + 8);
                }
            }
            ai += words as usize;
            off += if i == 0 && thin_recv { 8 } else { round8(size) };
            i += 1;
        }
        if mdst.len() > 0 {
            // Values already where they go need no move.
            let mut ds: Vec<Loc> = Vec::new();
            let mut ss: Vec<Loc> = Vec::new();
            let mut k = 0;
            while k < mdst.len() {
                if !same_loc(&mdst[k], &msrc[k]) {
                    ds.push(mdst[k].clone());
                    ss.push(msrc[k].clone());
                }
                k += 1;
            }
            self.ssa_parallel(&mut ds, &mut ss);
        }
        match tgt {
            None => {
                let c = self.ssa_in(code.unwrap(), BASE);
                if c != BASE {
                    m.mov(BASE, c);
                }
                let e = self.ssa_in(env.unwrap(), CTX);
                if e != CTX {
                    m.mov(CTX, e);
                }
                self.pass_loc(pos);
                self.ssa_ret_addr(v);
                m.call_reg(BASE);
            }
            Some(tt) => {
                if slot >= 0 {
                    m.load(8, BASE, FP, SLOT_CTX);
                    m.load(8, CTX, BASE, 16 * slot + 8);
                    m.load(8, BASE, BASE, 16 * slot);
                    self.pass_loc(pos);
                    self.ssa_ret_addr(v);
                    m.call_reg(BASE);
                } else if tt.kind == codegen::T_VIRTUAL {
                    let mut vt = self.ssa_in(vtable.unwrap(), V2);
                    if vt == CTX {
                        m.mov(V2, vt);
                        vt = V2;
                    }
                    m.mark(obj::DYN_USE, &codegen::dyn_key(tt.def));
                    m.load(8, CTX, vt, (16 * tt.method + 8) as i64);
                    m.load(8, BASE, vt, (16 * tt.method) as i64);
                    self.pass_loc(pos);
                    self.ssa_ret_addr(v);
                    m.call_reg(BASE);
                } else {
                    let ins = tt.inst.unwrap();
                    // A direct call sets only what the callee reads (its
                    // prologue keeps nothing else).
                    if !direct || ins.track_caller {
                        self.pass_loc(pos);
                    }
                    // A result in registers: no buffer (RET 0, see OP_RETURN).
                    if v.ty == crate::ssa::T_TUPLE {
                        m.mov_imm(RET, 0);
                    } else {
                        self.ssa_ret_addr(v);
                    }
                    if !direct || ins.grp().nslots > 0 || ins.func.closure {
                        m.adr_sym(CTX, &ins.dict);
                    }
                    // Register arguments enter at .r, stack ones at the stub.
                    let entry = if direct {
                        `${ins.grp().sym}.r`.to_string()
                    } else {
                        ins.grp().sym.clone()
                    };
                    m.call(&entry);
                }
            }
        }
    }

    /// The words a direct call returns a t in (V1, V2; 0: in the caller's
    /// buffer): a value of one or two registers, or an aggregate of up to
    /// 16 bytes as its words in memory (the last one of 1, 2, 4 or 8
    /// bytes), each a pointer or not as its words in memory are.
    pub fn reg_words(&mut self, t: &Type) -> i64 {
        if self.g.tgt.wasm {
            return 0;
        }
        let size = self.size(t);
        if size == 0 {
            return 0;
        }
        let w = self.ssa_words(t);
        if w > 0 {
            return w;
        }
        if size > 16 {
            return 0;
        }
        let tail = size - (size - 1) / 8 * 8;
        if tail != 1 && tail != 2 && tail != 4 && tail != 8 {
            return 0;
        }
        (size + 7) / 8
    }

    /// Points RET at where the call v's result goes: the destination
    /// local itself when the builder chose so (aux_int: local + 1; the
    /// callee writes it only on returning), else the result buffer.
    fn ssa_ret_addr(&mut self, v: &crate::ssa::Value) {
        if v.aux_int > 0 {
            self.local_addr(RET, (v.aux_int - 1) as usize);
        } else {
            self.m.addr_of(RET, FP, self.res_off);
        }
    }

    /// The words of a type held in registers (0: in memory).
    fn ssa_words(&mut self, t: &Type) -> i64 {
        match t.kind {
            types::K_INT => {
                if layout::int_size(t.int) == 16 {
                    2
                } else {
                    1
                }
            }
            types::K_BOOL | types::K_CHAR | types::K_FLOAT => 1,
            types::K_REF | types::K_PTR => {
                let el = self.reveal(t.el());
                if layout::is_fat(el) { 2 } else { 1 }
            }
            types::K_FN => {
                if t.abi == "C" {
                    1
                } else {
                    2
                }
            }
            _ => 0,
        }
    }

    /// The out-of-line stubs (stack growth, panics).
    fn emit_stubs(&mut self) {
        let m = self.m;
        let mut k = 0;
        while k < self.stub_list.len() {
            match &self.stub_list[k] {
                Stub::Overflow(l, resume, need) => {
                    m.bind(*l);
                    m.set_tag(0);
                    // Register arguments go to their stack slots around
                    // morestack (Go spills them likewise): a moved stack
                    // has the caller's outgoing area adjusted, not these
                    // registers.
                    self.ssa_spill_args(true);
                    m.mov_imm(I1, *need);
                    m.call_morestack();
                    self.ssa_spill_args(false);
                    m.jump(*resume);
                }
                Stub::Poll(l, back) => {
                    m.bind(*l);
                    // The loop's frame by its map, the saved registers
                    // conservatively (tag -1).
                    m.set_tag(-1);
                    m.call_poll();
                    m.jump(*back);
                }
                Stub::Panic { label, msg, pos } => {
                    m.bind(*label);
                    m.set_tag(-1);
                    let ms = msg.clone();
                    self.call_panic(ms.as_str(), *pos);
                }
            }
            k += 1;
        }
    }
}

/// Whether arm64 code for v leaves the flags alone (no compares, checks or
/// calls): loads, stores, addresses, moves and unchecked integer ops.
fn keeps_flags_arm64(v: &crate::ssa::Value) -> bool {
    match v.op {
        crate::ssa::OP_LOAD
        | crate::ssa::OP_STORE
        | crate::ssa::OP_OFFPTR
        | crate::ssa::OP_INDEXPTR
        | crate::ssa::OP_CONST
        | crate::ssa::OP_LOCALADDR
        | crate::ssa::OP_CONSTSYM
        | crate::ssa::OP_COPY
        | crate::ssa::OP_RETYPE
        | crate::ssa::OP_ZEXT
        | crate::ssa::OP_SEXT
        | crate::ssa::OP_TRUNC
        | crate::ssa::OP_MULHI
        | crate::ssa::OP_AND
        | crate::ssa::OP_OR
        | crate::ssa::OP_XOR => !crate::ssa::is_float(v.ty),
        crate::ssa::OP_ADD | crate::ssa::OP_SUB | crate::ssa::OP_MUL => {
            v.aux_int & 1 == 0 && !crate::ssa::is_float(v.ty)
        }
        _ => false,
    }
}

fn same_loc(a: &Loc, b: &Loc) -> bool {
    a.kind == b.kind
        && a.fp == b.fp
        && ((a.kind == 0 && a.reg == b.reg) || (a.kind == 1 && a.off == b.off))
}

/// The symbol of an #[asm] function.
pub fn asm_sym(d: &Def) -> String {
    crate::symbols::symbol(
        "_navi_asm_",
        d.name.as_str(),
        crate::symbols::def_id(d).as_str(),
    )
}
