//! The abstract machine the lowering emits to; each architecture
//! implements it.

use crate::obj::Reloc;

/// An abstract register. Each architecture maps them to physical
/// registers; the lowering only relies on the roles below.
pub type Reg = u8;
/// Address of the place being accessed.
pub const RA: Reg = 0;
/// Metadata (length or vtable) of an unsized place.
pub const RM: Reg = 1;
pub const V1: Reg = 2;
pub const V2: Reg = 3;
/// Temporary (copies).
pub const T1: Reg = 4;
/// Base address kept while operands are loaded.
pub const BASE: Reg = 5;
/// Index and offset computations.
pub const I1: Reg = 6;
/// Index computations; Load/Store may clobber it.
pub const I2: Reg = 7;
/// Call context: dictionary or closure environment.
pub const CTX: Reg = 8;
/// Address of the result slot.
pub const RET: Reg = 9;
/// Caller location for #[track_caller].
pub const LOC: Reg = 10;
pub const FP: Reg = 11;
pub const SP: Reg = 12;
pub const F0: Reg = 13;
pub const F1: Reg = 14;
/// The registers that keep promoted locals; calls preserve them.
pub const S0: Reg = 15;
/// At most (arm64: x19-x27; amd64 has 2: rbx, r12; TargetConv.num_saved).
pub const NUM_SAVED: usize = 9;
/// The running G (green thread) record; every thread keeps its own. Its
/// first word is the stack limit function prologues check.
pub const GREG: Reg = 24;
/// Registers the SSA backend allocates that calls clobber (arm64 x1-x7;
/// amd64 has none to spare yet).
pub const A1: Reg = 25;
pub const NUM_A: usize = 7;
/// Floating point registers the SSA backend allocates (calls clobber
/// them; arm64 v2-v7 and v16-v31, amd64 xmm2-xmm5).
pub const FA1: Reg = 32;
pub const NUM_FA_ARM64: usize = 22;
pub const NUM_FA_AMD64: usize = 4;
pub const NUM_REGS: usize = 54;

/// An integer or floating point operation.
pub type Op = u8;
pub const ADD: Op = 0;
pub const SUB: Op = 1;
pub const MUL: Op = 2;
pub const AND: Op = 3;
pub const OR: Op = 4;
pub const XOR: Op = 5;
pub const SHL: Op = 6;
pub const SHR_U: Op = 7;
pub const SHR_S: Op = 8;
pub const DIV_S: Op = 9;
pub const DIV_U: Op = 10;
pub const REM_S: Op = 11;
pub const REM_U: Op = 12;
pub const FDIV: Op = 13;

/// A comparison result, after cmp(a, b).
pub type Cond = u8;
pub const EQ: Cond = 0;
pub const NE: Cond = 1;
/// Signed.
pub const LT: Cond = 2;
pub const LE: Cond = 3;
pub const GT: Cond = 4;
pub const GE: Cond = 5;
/// Unsigned.
pub const LTU: Cond = 6;
pub const LEU: Cond = 7;
pub const GTU: Cond = 8;
pub const GEU: Cond = 9;

/// A code position within the current function.
pub type Label = usize;

/// One argument of a C call; its value is in the outgoing argument area at
/// sp+8*i (integers zero- or sign-extended to 8 bytes, floats as their
/// bits).
#[derive(Clone)]
pub struct CArg {
    pub float: bool,
    pub f64: bool,
    /// A variadic argument (after the named ones; floats are f64).
    pub variadic: bool,
    /// Its size in bytes (Apple arm64 packs stack arguments by size).
    pub size: i64,
}

pub fn int_arg() -> CArg { CArg { float: false, f64: false, variadic: false, size: 8 } }

/// The code of a finished function: relocation offsets are relative to the
/// function start; err is empty on success.
pub struct Code {
    pub code: Vec<u8>,
    pub relocs: Vec<Reloc>,
    /// Each call's return offset << 32 | (its tag + 1).
    pub calls: Vec<u64>,
    pub err: String,
}

/// Emits the code of one function at a time. Operations may clobber I2
/// (large offsets) and T1 (multiplication, division); calls clobber every
/// register.
pub trait Machine {
    /// Starts a new function.
    fn begin(&mut self);
    /// Ends the function.
    fn finish(&mut self) -> Code;
    /// The size of the code emitted so far for the current function.
    fn offset(&self) -> usize;
    fn new_label(&mut self) -> Label;
    fn bind(&mut self, l: Label);
    /// Saves the frame pointer and return address, sets FP and reserves
    /// frame bytes (a multiple of 16) below FP. Incoming stack arguments are
    /// at FP+16. ret undoes it and returns.
    fn prologue(&mut self, frame: i64);
    fn ret(&mut self);
    /// The same for the C entry point, which also preserves the C
    /// callee-saved registers and returns 0.
    fn entry_prologue(&mut self, frame: i64);
    fn entry_return0(&mut self);
    /// Stores the entry point's C arguments (argc, argv) to sp+0 and sp+8.
    fn entry_args(&mut self);
    fn mov_imm(&mut self, r: Reg, v: i64);
    fn mov(&mut self, dst: Reg, src: Reg);
    /// Reads size bytes (1, 2, 4 or 8), zero-extended.
    fn load(&mut self, size: i64, dst: Reg, base: Reg, off: i64);
    fn store(&mut self, size: i64, src: Reg, base: Reg, off: i64);
    fn store_zero(&mut self, size: i64, base: Reg, off: i64);
    /// dst = base + off.
    fn addr_of(&mut self, dst: Reg, base: Reg, off: i64);
    fn add_imm(&mut self, r: Reg, v: i64);
    /// Loads the address of a symbol.
    fn adr_sym(&mut self, dst: Reg, sym: &String);
    /// Loads the 8-byte word at a symbol (8-aligned).
    fn load_sym(&mut self, dst: Reg, sym: &String);
    fn sign_ext(&mut self, dst: Reg, src: Reg, size: i64);
    fn zero_ext(&mut self, dst: Reg, src: Reg, size: i64);
    /// dst = a op b on 64-bit values.
    fn arith(&mut self, op: Op, dst: Reg, a: Reg, b: Reg);
    /// Add, Sub or Mul that jumps to ovf when the result overflows.
    fn arith_ovf(&mut self, op: Op, signed: bool, dst: Reg, a: Reg, b: Reg, ovf: Label);
    /// dst = c + a*b.
    fn mul_add(&mut self, dst: Reg, a: Reg, b: Reg, c: Reg);
    /// Loads and stores a float of size 4 or 8 in a floating point
    /// register; moves one floating point register to another.
    fn fload(&mut self, size: i64, f: Reg, base: Reg, off: i64);
    fn fstore(&mut self, size: i64, f: Reg, base: Reg, off: i64);
    fn fmov(&mut self, dst: Reg, src: Reg);
    /// dst = src shifted by n (SHL, SHR_U or SHR_S; 0 <= n < 64).
    fn shift_imm(&mut self, op: Op, dst: Reg, src: Reg, n: i64);
    /// dst = base + (index << shift), shift 0 to 3 (index is not SP).
    fn add_scaled(&mut self, dst: Reg, base: Reg, index: Reg, shift: i64);
    fn neg(&mut self, dst: Reg, src: Reg);
    fn not(&mut self, dst: Reg, src: Reg);
    fn cmp(&mut self, a: Reg, b: Reg);
    fn cmp_imm(&mut self, a: Reg, v: i64);
    fn set_cond(&mut self, dst: Reg, c: Cond);
    fn branch_if(&mut self, c: Cond, l: Label);
    /// dst = c ? a : b.
    fn select_reg(&mut self, dst: Reg, a: Reg, b: Reg, c: Cond);
    fn jump(&mut self, l: Label);
    fn branch_zero(&mut self, r: Reg, l: Label);
    fn branch_non_zero(&mut self, r: Reg, l: Label);
    fn fmov_to(&mut self, f: Reg, r: Reg, f64: bool);
    fn fmov_from(&mut self, r: Reg, f: Reg, f64: bool);
    /// Add, Sub, Mul, FDiv.
    fn farith(&mut self, op: Op, dst: Reg, a: Reg, b: Reg, f64: bool);
    fn fneg(&mut self, dst: Reg, src: Reg, f64: bool);
    /// dst = a c b (EQ, NE, LT, LE, GT, GE); comparisons with NaN are false
    /// except NE.
    fn fcompare(&mut self, dst: Reg, c: Cond, a: Reg, b: Reg, f64: bool);
    fn int_to_float(&mut self, f: Reg, r: Reg, signed: bool, f64: bool);
    /// Converts to a 64-bit integer with Rust's saturating semantics.
    fn float_to_int(&mut self, r: Reg, f: Reg, signed: bool, f64: bool);
    fn float_conv(&mut self, dst: Reg, src: Reg, to_f64: bool);
    /// Calls a symbol.
    fn call(&mut self, sym: &String);
    /// Calls the code address in a register.
    fn call_reg(&mut self, r: Reg);
    /// Calls a C function (sym, or the address in fn_reg if sym is "") with
    /// the arguments in the outgoing area; an integer result is left in V1,
    /// a float result's bits too.
    fn call_c(&mut self, sym: &str, fn_reg: Reg, args: &Vec<CArg>, float_ret: bool, f64: bool);
    fn trap(&mut self);
    /// Copies n 8-byte words from [src] to [dst] (both advanced).
    fn copy_words(&mut self, dst: Reg, src: Reg, n: i64);
    /// The body of the deferred call runner.
    fn run_defers(&mut self);
    /// The body of the context switch routine.
    fn swap_context(&mut self);
    /// The collector's scan loop (std::rt::scan_words), a leaf routine.
    fn scan_words(&mut self);
    /// The tag of the calls emitted from now on (the lowering's position in
    /// the function, for stack maps; -1: unknown).
    fn set_tag(&mut self, tag: i64);
    /// Atomic (sequentially consistent) operations on the word at addr:
    /// compare and swap (old is replaced by what was there), fetch and add
    /// (dst gets the old value), load and store.
    fn atomic_cas(&mut self, old: Reg, new: Reg, addr: Reg);
    fn atomic_add(&mut self, dst: Reg, delta: Reg, addr: Reg);
    fn atomic_load(&mut self, dst: Reg, addr: Reg);
    fn atomic_store(&mut self, src: Reg, addr: Reg);
    /// The body of the stack check's slow path: saves every register that
    /// may be live at a function's entry, records its SP in the G (fourth
    /// word), clears the G's stack limit and calls the runtime's morestack
    /// (navi ABI: sym with dict). That returns how far the stack moved
    /// (copied to a larger one): SP and FP move by as much before the
    /// registers (adjusted by the copy) are restored.
    fn morestack(&mut self, sym: &str, dict: &str, loc: &str);
    /// Calls _navi_morestack at a function's entry (keeping its FP and the
    /// return address).
    fn call_morestack(&mut self);
    /// The body of a new OS thread's start routine (C ABI, x0 = its G0
    /// record): installs the G register and calls sym (navi ABI).
    fn mstart(&mut self, sym: &str, dict: &str, loc: &str);
    /// The bodies of setjmp (buf) -> 0 and longjmp (buf, v).
    fn set_jmp(&mut self);
    fn long_jmp(&mut self);
}
