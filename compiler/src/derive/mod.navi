//! Derives (docs/derive.md): #[derive(X)] on a struct or enum expands,
//! before names in bodies are resolved, to impl blocks, which are parsed
//! and collected as any others. Like Rust's, a derive sees the item's
//! syntax only (fields, their types as written, generics, attributes), and
//! the impl requires every type parameter to implement the trait too.
//!
//! The built-in derives are here (Rust's: Clone, Debug, PartialEq, Eq,
//! PartialOrd, Ord, Hash, Default; std's own types use them), written as a
//! derive macro is (std::derive: a TypeInfo in, quote`...` code out) but
//! called in the compiler. Serialize, Deserialize and FromAttrs are std's
//! derive macros.

use std::derive::{TypeInfo, Code, Error, Binding, Variant, Kind, quote};
use crate::syntax::ast::*;
use crate::syntax::token;

pub mod info;

/// Whether name is a built-in derive.
pub fn expanded(name: &str) -> bool {
    match name {
        "Clone" | "Default" | "PartialEq" | "Eq" | "PartialOrd" | "Ord" | "Hash" | "Debug" => true,
        _ => false,
    }
}

/// A derive named in #[derive(...)]: a name or a path (a macro's).
pub struct DeriveRef {
    pub segs: Vec<&Name>,
}

impl DeriveRef {
    pub fn text(&self) -> String {
        let mut v: Vec<String> = Vec::new();
        for s in self.segs.iter() { v.push(s.value.clone()); }
        v.join("::")
    }

    pub fn last(&self) -> &Name { self.segs[self.segs.len() - 1] }
}

/// The derives the item's #[derive(...)] attributes name, in order.
pub fn refs(attrs: &Vec<&Attr>) -> Vec<DeriveRef> {
    let mut out: Vec<DeriveRef> = Vec::new();
    for a in attrs.iter() {
        if a.path.segments.len() != 1 || a.path.segments[0].name.value != "derive" { continue; }
        let mut cur: Vec<&Name> = Vec::new();
        for t in a.args.iter() {
            if t.kind == token::IDENT {
                cur.push(&Name { pos: t.pos, value: t.text.to_string() });
            } else if t.kind == token::COMMA {
                if cur.len() > 0 { out.push(DeriveRef { segs: cur }); }
                cur = Vec::new();
            }
        }
        if cur.len() > 0 { out.push(DeriveRef { segs: cur }); }
    }
    out
}

/// A function's #[derive_macro(Name, attrs = [ns, ...])]: the derive's
/// name and the attribute namespaces it takes.
pub struct MacroDecl {
    pub name: &Name,
    pub attrs: Vec<String>,
}

pub fn macro_decl(attrs: &Vec<&Attr>) -> Option<MacroDecl> {
    for a in attrs.iter() {
        if a.path.segments.len() != 1 || a.path.segments[0].name.value != "derive_macro" { continue; }
        let toks = &a.args;
        if toks.len() == 0 || toks[0].kind != token::IDENT { return None; }
        let name = &Name { pos: toks[0].pos, value: toks[0].text.to_string() };
        let mut claims: Vec<String> = Vec::new();
        let mut i = 1;
        while i < toks.len() {
            if toks[i].kind == token::IDENT && toks[i].text == "attrs" {
                let mut j = i + 1;
                while j < toks.len() && toks[j].kind != token::R_BRACKET {
                    if toks[j].kind == token::IDENT { claims.push(toks[j].text.to_string()); }
                    j += 1;
                }
                i = j;
            }
            i += 1;
        }
        return Some(MacroDecl { name, attrs: claims });
    }
    None
}

/// The attribute namespaces a built-in derive takes (none: serde's are
/// std::serde's derive macros').
pub fn builtin_attrs(name: &str) -> Vec<String> { Vec::new() }

/// The name expand gives the code of the item's built-in derives in only
/// ("" if none), without making it.
pub fn what(it: &Item, only: &Vec<String>) -> String {
    let (names, name, is_enum) = match it {
        Item::Struct(s) => (refs(&s.base.attrs), s.name.value.clone(), false),
        Item::Enum(e) => (refs(&e.base.attrs), e.name.value.clone(), true),
        _ => return String::new(),
    };
    let mut done: Vec<String> = Vec::new();
    for r in names.iter() {
        let n = r.text();
        if !expanded(n.as_str()) || done.contains(&n) || !only.contains(&n) { continue; }
        if n == "Default" && is_enum { continue; }
        done.push(n);
    }
    if done.len() == 0 { return String::new(); }
    `derive ${done.join(", ")} for ${name}`.to_string()
}

/// The code of the item's built-in derives in only (empty if none), a name
/// for it (the derives and the type), and the derives' errors.
pub fn expand(it: &Item, only: &Vec<String>) -> (Code, String, Vec<Error>) {
    let mut code = Code::new();
    let mut errs: Vec<Error> = Vec::new();
    let names = match it {
        Item::Struct(s) => refs(&s.base.attrs),
        Item::Enum(e) => refs(&e.base.attrs),
        _ => return (code, String::new(), errs),
    };
    let e = info::Enc::new();
    info::encode(e, it, "");
    let t = TypeInfo::decode(e.s.as_str());
    let mut done: Vec<String> = Vec::new();
    for r in names.iter() {
        let n = r.text();
        if !expanded(n.as_str()) || done.contains(&n) || !only.contains(&n) { continue; }
        // (Not for an enum: the checker reports it.)
        if n == "Default" && t.is_enum() { continue; }
        done.push(n.clone());
        let made = match n.as_str() {
            "Clone" => Ok(clone(&t)),
            "Default" => Ok(default(&t)),
            "PartialEq" => Ok(partial_eq(&t)),
            "Eq" => Ok(t.impl_for("std::cmp::Eq", Code::new())),
            "PartialOrd" => Ok(ord(&t, true)),
            "Ord" => Ok(ord(&t, false)),
            "Hash" => Ok(hash(&t)),
            "Debug" => debug(&t),
            _ => Ok(Code::new()),
        };
        match made {
            Ok(c) => code.push(&c),
            Err(x) => errs.push(x),
        }
    }
    if done.len() == 0 { return (code, String::new(), errs); }
    (code, `derive ${done.join(", ")} for ${t.name()}`.to_string(), errs)
}

/// Code of text as written (a path, a number).
pub fn c(text: &str) -> Code { Code::from_text(text) }

// #[derive(Clone)]: each field cloned. (From a copy of self, taken apart:
// through &self a &mut field reads as &, which the clone could not be.)
fn clone(t: &TypeInfo) -> Code {
    let body = t.each_construct(|b| quote`std::clone::Clone::clone(&${b})`);
    t.impl_for("std::clone::Clone", quote`fn clone(&self) -> Self { ${body} }`)
}

// #[derive(Default)] (structs only): each field's default.
fn default(t: &TypeInfo) -> Code {
    let v = &t.variants()[0];
    let mut vals: Vec<Code> = Vec::new();
    for _ in v.fields().iter() { vals.push(c("std::default::Default::default()")); }
    let made = v.construct(&vals);
    t.impl_for("std::default::Default", quote`fn default() -> Self { ${made} }`)
}

// #[derive(PartialEq)]: the same variant and equal fields.
fn partial_eq(t: &TypeInfo) -> Code {
    let other = quote`other`;
    let differ = quote`return false;`;
    let body = t.each_pair(other, |a, b| quote`if !std::cmp::PartialEq::eq(&${a}, &${b}) { return false; }`, differ);
    t.impl_for("std::cmp::PartialEq", quote`fn eq(&self, other: &Self) -> bool { ${body} true }`)
}

// #[derive(PartialOrd)] / #[derive(Ord)]: the variant order, then the
// fields in order (the first that differs decides).
fn ord(t: &TypeInfo, partial: bool) -> Code {
    let (tr, m, ret, eq) = if partial {
        ("std::cmp::PartialOrd", "partial_cmp", "std::option::Option<std::cmp::Ordering>", "std::option::Option::Some(std::cmp::Ordering::Equal)")
    } else {
        ("std::cmp::Ord", "cmp", "std::cmp::Ordering", "std::cmp::Ordering::Equal")
    };
    let (trc, mc, retc, eqc) = (c(tr), c(m), c(ret), c(eq));
    let other = quote`other`;
    let same = quote`{}`;
    let fields = t.each_pair(other, |a, b| quote`match ${trc}::${mc}(&${a}, &${b}) { ${eqc} => {} r => return r, }`, same);
    let mut body = Code::new();
    if t.is_enum() {
        let me = quote`self`;
        let them = quote`other`;
        let da = t.variant_index(me);
        let db = t.variant_index(them);
        body = quote`let __da = ${da}; let __db = ${db}; if __da != __db { return ${trc}::${mc}(&__da, &__db); }`;
    }
    t.impl_for(tr, quote`fn ${mc}(&self, other: &Self) -> ${retc} { ${body} ${fields} ${eqc} }`)
}

// #[derive(Hash)]: the variant (its position as an isize), then each field.
fn hash(t: &TypeInfo) -> Code {
    let mut pre = Code::new();
    if t.is_enum() {
        let me = quote`self`;
        let d = t.variant_index(me);
        pre = quote`let __d: isize = ${d}; std::hash::Hash::hash(&__d, state);`;
    }
    let body = t.each(|b| quote`std::hash::Hash::hash(&${b}, state);`);
    t.impl_for("std::hash::Hash", quote`fn hash<__H: std::hash::Hasher>(&self, state: &mut __H) { ${pre} ${body} }`)
}

// #[derive(Debug)]: the name (a variant's, for an enum), then the fields
// through Formatter's debug_tuple or debug_struct.
fn debug(t: &TypeInfo) -> Result<Code, Error> {
    let body = t.each_variant(|v| {
        let name = v.name().to_string();
        let mut calls: Vec<Code> = Vec::new();
        for b in v.bindings().iter() {
            if v.kind() == Kind::Named {
                let key = b.field().ident().to_string();
                calls.push(quote`__w.field(${key}, &${b});`);
            } else {
                calls.push(quote`__w.field(&${b});`);
            }
        }
        Ok(match v.kind() {
            Kind::Unit => quote`f.write_str(${name})`,
            Kind::Tuple => quote`let mut __w = f.debug_tuple(${name}); ${calls} __w.finish()`,
            Kind::Named => quote`let mut __w = f.debug_struct(${name}); ${calls} __w.finish()`,
        })
    })?;
    Ok(t.impl_for("std::fmt::Debug", quote`fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result { ${body} }`))
}
