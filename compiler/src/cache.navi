//! The build cache (like Go's): a successful build records the source
//! files it read, with their SHA-256, under a key made of the compiler, the
//! options and the crate. A later build with the same key whose files are
//! all unchanged copies the recorded output instead of compiling.
//!
//! The cache lives in $NAVI_CACHE (default ~/Library/Caches/navi on macOS,
//! ~/.cache/navi elsewhere); NAVI_CACHE=off disables it. Files that a
//! build looked for but did not find (mod foo; with neither foo.navi nor
//! foo/mod.navi) are not recorded: creating one is noticed only through the
//! file that declares the module.
//!
//! As Go's cache, entries not used for 5 days are removed (a build that
//! stores looks at most once a day; a hit marks its entry used at most once
//! an hour).

use crate::sha256;
use crate::util;

/// The source files read by this run: (path, contents).
pub static mut READ: Vec<(String, String)> = Vec::new();

/// Records a source file read by the build.
pub fn note(path: &str, src: &String) {
    READ.push((path.to_string(), src.clone()));
}

/// Source texts that stand in for files (an editor's unsaved buffers, for
/// navi lsp): (path, contents).
pub static mut OVERLAY: Vec<(String, String)> = Vec::new();

/// The text of a source file: its overlay, or what is on disk.
pub fn read_source(path: &str) -> std::io::Result<String> {
    for (p, src) in OVERLAY.iter() {
        if p == path { return Ok(src.clone()); }
    }
    std::fs::read_to_string(path)
}

pub fn hex(d: &[u8]) -> String {
    let digits = "0123456789abcdef".as_bytes();
    let mut s = String::new();
    for b in d.iter() {
        s.push(digits[(*b >> 4) as usize] as char);
        s.push(digits[(*b & 15) as usize] as char);
    }
    s
}

fn home_cache() -> Option<String> {
    if cfg_windows() { return Some(util::path_join(std::env::var("LOCALAPPDATA").ok()?.as_str(), "navi")); }
    let home = std::env::var("HOME").ok()?;
    if cfg_macos() { Some(util::path_join(home.as_str(), "Library/Caches/navi")) } else { Some(util::path_join(home.as_str(), ".cache/navi")) }
}

#[cfg(target_os = "macos")]
fn cfg_macos() -> bool { true }
#[cfg(not(target_os = "macos"))]
fn cfg_macos() -> bool { false }
#[cfg(target_os = "windows")]
fn cfg_windows() -> bool { true }
#[cfg(not(target_os = "windows"))]
fn cfg_windows() -> bool { false }

/// The directory of the checkouts of git dependencies (see deps): $NAVI_PKG,
/// else pkg in the cache's default place (NAVI_CACHE=off or not).
pub fn pkg_dir() -> Option<String> {
    let d = match std::env::var("NAVI_PKG") { Ok(v) => v, Err(_) => util::path_join(home_cache()?.as_str(), "pkg") };
    if std::fs::create_dir_all(d.as_str()).is_err() { return None; }
    Some(d)
}

/// The cache directory (created on first use), or None if disabled.
pub fn dir() -> Option<String> {
    let d = match std::env::var("NAVI_CACHE") {
        Ok(v) => {
            if v == "off" { return None; }
            v
        }
        Err(_) => home_cache()?,
    };
    if std::fs::create_dir_all(d.as_str()).is_err() { return None; }
    Some(d)
}

/// The path of the running compiler (argv[0], searched in $PATH if it has
/// no slash; Windows: ';' separates PATH, and .exe may be left out).
fn self_path() -> Option<String> {
    let a0 = std::env::args().next()?;
    if a0.contains('/') || cfg_windows() && a0.contains('\\') { return Some(a0); }
    let path = std::env::var("PATH").ok()?;
    let sep = if cfg_windows() { ';' } else { ':' };
    for d in path.split(sep) {
        let p = util::path_join(d, a0.as_str());
        if std::path::Path::new(p.as_str()).exists() { return Some(p); }
        let pe = `${p}.exe`.to_string();
        if cfg_windows() && std::path::Path::new(pe.as_str()).exists() { return Some(pe); }
    }
    None
}

fn rd32(b: &Vec<u8>, at: usize) -> u32 {
    (b[at] as u32) | (b[at + 1] as u32) << 8 | (b[at + 2] as u32) << 16 | (b[at + 3] as u32) << 24
}

/// The identity of the running compiler: the UUID of its Mach-O image (a
/// hash of its contents, written by the linker), else the hash of the
/// whole file.
pub fn compiler_id() -> Option<String> {
    let data = std::fs::read(self_path()?.as_str()).ok()?;
    if data.len() > 32 && rd32(&data, 0) == 0xfeedfacf {
        let ncmds = rd32(&data, 16) as usize;
        let mut at = 32;
        let mut i = 0;
        while i < ncmds && at + 8 <= data.len() {
            let cmd = rd32(&data, at);
            let size = rd32(&data, at + 4) as usize;
            if cmd == 0x1b && at + 24 <= data.len() { return Some(hex(&data[at + 8..at + 24])); }
            if size == 0 { break; }
            at += size;
            i += 1;
        }
    }
    Some(hex(&sha256::sum(data.as_slice())))
}

/// The cache key of a build: the compiler, the options and the crate path.
pub fn key(options: &str, root: &str) -> Option<String> {
    let id = compiler_id()?;
    let pwd = match std::env::var("PWD") { Ok(p) => p, Err(_) => String::new() };
    let mut env = String::new();
    for name in ["NAVI_STD", "NAVI_NOESCAPE", "NAVI_LINKER", "NAVI_LLSC", "NAVI_ELF_LIBC", "NAVI_NOPOLL"].iter() {
        let v = match std::env::var(*name) { Ok(v) => v, Err(_) => "-".to_string() };
        env.push_str(`${name}=${v}\n`.to_string().as_str());
    }
    let text = `navi ${id}\n${options}\n${pwd}\n${root}\n${env}`.to_string();
    Some(hex(&sha256::sum(text.as_bytes())))
}

/// Copies the cached output of key to out if every recorded source file is
/// unchanged.
pub fn lookup(key: &str, out: &str) -> bool {
    let d = match dir() { Some(d) => d, None => return false };
    let manifest = match std::fs::read_to_string(util::path_join(d.as_str(), `${key}.m`.to_string().as_str()).as_str()) { Ok(m) => m, Err(_) => return false };
    for line in manifest.lines() {
        let sp = match line.find(' ') { Some(i) => i, None => return false };
        let want = &line[0..sp];
        let path = &line[sp + 1..];
        let src = match std::fs::read(path) { Ok(s) => s, Err(_) => return false };
        if hex(&sha256::sum(src.as_slice())) != want { return false; }
    }
    let data = match std::fs::read(util::path_join(d.as_str(), `${key}.out`.to_string().as_str()).as_str()) { Ok(b) => b, Err(_) => return false };
    if crate::driver::write_new(out, data.as_slice()).is_err() { return false; }
    for ext in ["m", "out", "w"].iter() { mark_used(util::path_join(d.as_str(), `${key}.${*ext}`.to_string().as_str()).as_str()); }
    // The build's warnings again (as cargo replays them).
    if let Ok(w) = std::fs::read_to_string(util::path_join(d.as_str(), `${key}.w`.to_string().as_str()).as_str()) {
        if w.len() > 0 { eprintln(w); }
    }
    true
}

/// Records the output out of a successful build under key, with the
/// build's warnings.
pub fn store(key: &str, out: &str, warnings: &str) {
    let d = match dir() { Some(d) => d, None => return };
    let data = match std::fs::read(out) { Ok(b) => b, Err(_) => return };
    let mut m = String::new();
    for (path, src) in READ.iter() {
        m.push_str(hex(&sha256::sum(src.as_bytes())).as_str());
        m.push(' ');
        m.push_str(path.as_str());
        m.push('\n');
    }
    if std::fs::write(util::path_join(d.as_str(), `${key}.w`.to_string().as_str()).as_str(), warnings.as_bytes()).is_err() { return; }
    // The output first: a manifest without its output is a miss.
    if std::fs::write(util::path_join(d.as_str(), `${key}.out`.to_string().as_str()).as_str(), data.as_slice()).is_err() { return; }
    let _ = std::fs::write(util::path_join(d.as_str(), `${key}.m`.to_string().as_str()).as_str(), m.as_bytes());
    trim(d.as_str());
}

// Seconds since the Unix epoch.
fn now_secs() -> u64 {
    match std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH) { Ok(t) => t.as_secs(), Err(_) => 0 }
}

// The last modification of path, in seconds since the epoch (0: unknown).
fn mtime(path: &str) -> u64 {
    let m = match std::fs::metadata(path) { Ok(m) => m, Err(_) => return 0 };
    let t = match m.modified() { Ok(t) => t, Err(_) => return 0 };
    match t.duration_since(std::time::UNIX_EPOCH) { Ok(d) => d.as_secs(), Err(_) => 0 }
}

// Marks an entry's file used now, if it was not within the last hour.
pub fn mark_used(path: &str) {
    let t = mtime(path);
    if t == 0 || t + 3600 > now_secs() { return; }
    if let Ok(f) = std::fs::File::options().write(true).open(path) {
        let _ = f.set_modified(std::time::SystemTime::now());
    }
}

// Removes the entries of dir not used for 5 days, at most once a day
// (trim.txt holds when it last did).
pub fn trim(dir: &str) {
    let now = now_secs();
    let mark = util::path_join(dir, "trim.txt");
    if let Ok(s) = std::fs::read_to_string(mark.as_str()) {
        if let Ok(last) = s.trim().parse::<u64>() {
            if last + 86400 > now { return; }
        }
    }
    if std::fs::write(mark.as_str(), `${now}\n`.to_string().as_bytes()).is_err() { return; }
    let rd = match std::fs::read_dir(dir) { Ok(r) => r, Err(_) => return };
    for e in rd {
        let e: std::fs::DirEntry = match e { Ok(e) => e, Err(_) => continue };
        let name: String = e.file_name();
        if !(name.ends_with(".m") || name.ends_with(".out") || name.ends_with(".w") || name.ends_with(".lib")) { continue; }
        let p = util::path_join(dir, name.as_str());
        let t = mtime(p.as_str());
        if t != 0 && t + 5 * 86400 < now { let _ = std::fs::remove_file(p.as_str()); }
    }
}

