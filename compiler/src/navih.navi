//! A crate's export data (docs/crates.md step 4): what a build of a
//! program needs of a crate compiled alone, read instead of the crate's
//! source. For now its files' syntax trees (crate::syntax::astcodec), with
//! the bodies of the functions a user of the crate never builds left out:
//! a crate compiled alone has them in its object (crate::libcache), and
//! its users call them. What a user may build is kept: generic functions
//! (their own type parameters, an impl's or a trait's, impl Trait
//! parameters), const fns, functions returning impl Trait (their hidden
//! types come from the body) and functions declaring items in their body.
//! Resolution and collection then run on these trees as on parsed ones,
//! minus the lexing, parsing and the resolution of the bodies left out.
//!
//! A file: the magic, the SHA-256 of the rest, the number of source files,
//! then for each its path in the crate, how many nodes with an id it has,
//! and its part (its line starts and its tree), written alone so that the
//! files decode on several threads, each node id from the file's own range
//! (the ids do not depend on the threads). (A file's name is not written:
//! the crate may be elsewhere now, and a file's name is the crate's
//! directory and the path, as resolve::load makes it, which symbols::def_id
//! relies on.)

use std::collections::HashMap;
use crate::syntax::ast::*;
use crate::syntax::source::{File, Origin, Pos};
use crate::syntax::token::{Token, Kind};
use crate::syntax::astcodec::{Seen, new_seen, Codec};
use crate::syntax::walk::{self, Visit};
use crate::sha256;
use crate::util;

const MAGIC: &str = "navih3\n";

/// The writing of trees.
pub struct Enc {
    pub b: Vec<u8>,
    // The nodes written (by id): their number among their kind's.
    seen: HashMap<u32, u32>,
    counts: Vec<u32>,
    // The functions whose bodies are written (by item id), and how deep
    // the writing is inside one (everything in a body written is).
    keep: HashMap<u32, bool>,
    inside: u32,
    // The node ids the decoding of the file gives.
    ids: u32,
}

impl Enc {
    pub fn u(&mut self, v: u32) {
        let mut x = v;
        while x >= 0x80 {
            self.b.push((x & 0x7f) as u8 | 0x80);
            x = x >> 7;
        }
        self.b.push(x as u8);
    }

    pub fn i(&mut self, v: i32) { self.u(((v << 1) ^ (v >> 31)) as u32); }

    pub fn pos(&mut self, p: Pos) { self.i(p); }

    pub fn b(&mut self, v: bool) { self.b.push(if v { 1 } else { 0 }); }

    pub fn k(&mut self, v: Kind) { self.b.push(v as u8); }

    pub fn s(&mut self, v: String) { self.s_str(v.as_str()); }

    pub fn s_str(&mut self, v: &str) {
        self.u(v.len() as u32);
        self.b.extend_from_slice(v.as_bytes());
    }

    /// Whether node id was written before (then a reference to it is).
    pub fn again(&mut self, id: u32) -> bool {
        if let Some(i) = self.seen.get(&id) {
            let n = *i;
            self.b(true);
            self.u(n);
            return true;
        }
        self.b(false);
        false
    }

    /// Node id, of the given kind, is written.
    pub fn done(&mut self, id: u32, kind: usize) {
        while self.counts.len() <= kind { self.counts.push(0); }
        self.seen.insert(id, self.counts[kind]);
        self.counts[kind] += 1;
        self.ids += 1;
    }

    /// A function's body: none (0), written (1) or left out (2, with where
    /// its braces were).
    pub fn fn_body(&mut self, f: &FnDecl) {
        let body = match f.body {
            Some(b) => b,
            None => {
                self.u(0);
                return;
            }
        };
        if self.inside > 0 || self.keep.contains_key(&f.base.id) || f.elided {
            if f.elided { panic(`navih: the body of ${f.name.value} was left out already`); }
            self.u(1);
            self.inside += 1;
            body.codec_enc(self);
            self.inside -= 1;
            return;
        }
        self.u(2);
        self.ids += 1;
        let (lo, hi) = match &body.kind {
            ExprKind::Block(blk) => (blk.lbrace, blk.rbrace),
            _ => (body.pos(), body.pos()),
        };
        self.pos(lo);
        self.pos(hi);
    }
}

pub fn enc_Token(e: &mut Enc, t: &Token) {
    e.k(t.kind);
    e.i(t.pos);
    e.i(t.end);
    e.s_str(t.text);
}

/// The reading of trees.
pub struct Dec {
    pub b: Vec<u8>,
    pub at: usize,
    pub bad: bool,
    pub seen: Seen,
    // The next node id (the file's range).
    next: u32,
    end: u32,
}

impl Dec {
    /// A node id.
    pub fn id(&mut self) -> u32 {
        if self.next >= self.end { self.bad = true; return self.end - 1; }
        self.next += 1;
        self.next - 1
    }

    pub fn u(&mut self) -> u32 {
        let mut v = 0u32;
        let mut shift = 0u32;
        loop {
            if self.at >= self.b.len() || shift > 28 {
                self.bad = true;
                return 0;
            }
            let c = self.b[self.at];
            self.at += 1;
            v = v | ((c & 0x7f) as u32) << shift;
            if c < 0x80 { return v; }
            shift += 7;
        }
    }

    pub fn i(&mut self) -> i32 {
        let z = self.u();
        ((z >> 1) as i32) ^ -((z & 1) as i32)
    }

    pub fn pos(&mut self) -> Pos { self.i() }

    pub fn b(&mut self) -> bool {
        if self.at >= self.b.len() {
            self.bad = true;
            return false;
        }
        self.at += 1;
        self.b[self.at - 1] != 0
    }

    pub fn k(&mut self) -> Kind {
        if self.at >= self.b.len() {
            self.bad = true;
            return 0;
        }
        self.at += 1;
        self.b[self.at - 1]
    }

    pub fn s(&mut self) -> String {
        let n = self.u() as usize;
        if n > self.b.len() - self.at {
            self.bad = true;
            return String::new();
        }
        let v = self.b[self.at..self.at + n].to_vec();
        self.at += n;
        match String::from_utf8(v) {
            Ok(s) => s,
            Err(_) => {
                self.bad = true;
                String::new()
            }
        }
    }

    pub fn s_str(&mut self) -> &str {
        let s = self.s();
        s.as_str()
    }

    /// The index of a node read before, if the next one is a reference to
    /// it.
    pub fn again(&mut self) -> Option<usize> {
        if self.b() { Some(self.u() as usize) } else { None }
    }

    /// A function's body (see Enc::fn_body) and whether it was left out.
    pub fn fn_body(&mut self) -> (Option<&Expr>, bool) {
        match self.u() {
            0 => (None, false),
            1 => (Some(Expr::codec_dec_ref(self)), false),
            _ => {
                let lbrace = self.pos();
                let rbrace = self.pos();
                let blk = &mut Block { lbrace, rbrace, is_unsafe: false, stmts: Vec::new(), tail: None };
                let id = self.id();
                (Some(&Expr { id, kind: ExprKind::Block(blk) }), true)
            }
        }
    }
}

pub fn dec_val_Token(d: &mut Dec) -> Token {
    let kind = d.k();
    let pos = d.i();
    let end = d.i();
    let text = d.s_str();
    Token { kind, pos, end, text }
}

// The functions of items whose bodies a user of the crate may build (see
// the top).
fn keep_items(items: &Vec<Item>, generic: bool, keep: &mut HashMap<u32, bool>) {
    for it in items.iter() {
        match it {
            Item::Fn(f) => {
                // (#[inline]: for users to inline, as Rust.)
                if generic || f.is_const || f.generics.params.len() > 0 || has_impl_opt(f.result) || has_items(*f) || inline_attr(&f.base.attrs) {
                    keep.insert(f.base.id, true);
                    continue;
                }
                for p in f.params.iter() {
                    if let Some(t) = p.ty { if has_impl(t) { keep.insert(f.base.id, true); } }
                }
            }
            Item::Impl(im) => keep_items(&im.items, generic || im.generics.params.len() > 0, keep),
            Item::Trait(tr) => keep_items(&tr.items, true, keep),
            Item::Mod(m) => keep_items(&m.items, generic, keep),
            _ => {}
        }
    }
}

// Whether attrs say #[inline] (not #[inline(never)]).
fn inline_attr(attrs: &[&Attr]) -> bool {
    for a in attrs.iter() {
        if a.path.segments.len() == 1 && a.path.segments[0].name.value == "inline" {
            for t in a.args.iter() {
                if t.text == "never" { return false; }
            }
            return true;
        }
    }
    false
}

// Whether a function's body declares items (an impl there counts for the
// whole program).
fn has_items(f: &FnDecl) -> bool {
    let b = match f.body { Some(b) => b, None => return false };
    let mut found = false;
    walk::inspect_expr(b, |v: Visit| -> bool {
        if let Visit::Stmt(s) = v {
            if let Stmt::Item(_) = s { found = true; }
        }
        !found
    });
    found
}

fn has_impl_opt(t: Option<&Type>) -> bool {
    match t { Some(x) => has_impl(x), None => false }
}

// Whether a type mentions impl Trait.
fn has_impl(t: &Type) -> bool {
    match &t.kind {
        TypeKind::Impl { .. } => true,
        TypeKind::Ref { elem, .. } => has_impl(*elem),
        TypeKind::Ptr { elem, .. } => has_impl(*elem),
        TypeKind::Slice { elem, .. } => has_impl(*elem),
        TypeKind::Array { elem, .. } => has_impl(*elem),
        TypeKind::Tuple { elems, .. } => {
            for e in elems.iter() { if has_impl(*e) { return true; } }
            false
        }
        TypeKind::Fn { params, result, .. } => {
            for p in params.iter() { if has_impl(*p) { return true; } }
            has_impl_opt(*result)
        }
        TypeKind::Path(p) => {
            for seg in p.segments.iter() {
                if let Some(a) = seg.args {
                    for x in a.args.iter() { if has_impl(*x) { return true; } }
                    for bd in a.bindings.iter() { if has_impl(bd.ty) { return true; } }
                }
            }
            false
        }
        _ => false,
    }
}

/// The export data of a crate's files (by path in the crate).
pub fn encode(files: &HashMap<String, &SourceFile>) -> Vec<u8> { encode_with(files, false) }

/// encode, every body kept if all (to test the encoding).
pub fn encode_with(files: &HashMap<String, &SourceFile>, all: bool) -> Vec<u8> {
    let mut keep: HashMap<u32, bool> = HashMap::new();
    let mut paths: Vec<String> = Vec::new();
    for (p, sf) in files.iter() {
        paths.push(p.clone());
        keep_items(&sf.items, all, &mut keep);
    }
    paths.sort();
    // (A generated file's origin by its path here.)
    let mut by_name: HashMap<String, String> = HashMap::new();
    for (p, sf) in files.iter() { by_name.insert(sf.file.name.clone(), p.clone()); }
    let out = &mut Enc { b: Vec::new(), seen: HashMap::new(), counts: Vec::new(), keep: HashMap::new(), inside: 0, ids: 0 };
    out.u(paths.len() as u32);
    for p in paths.iter() {
        let sf = files[p];
        let e = &mut Enc { b: Vec::new(), seen: HashMap::new(), counts: Vec::new(), keep, inside: 0, ids: 0 };
        let lines = sf.file.line_starts();
        e.u(lines.len() as u32);
        let mut prev = 0;
        for l in lines.iter() {
            e.u((*l - prev) as u32);
            prev = *l;
        }
        // Derived code: the file it comes from and its spans (positions
        // there are the user's, as when compiled from source).
        let origin_path = match sf.file.origin { Some(o) => by_name.get(&o.file.name), None => None };
        match origin_path {
            Some(op) => {
                let o = sf.file.origin.unwrap();
                e.u(1);
                e.s_str(op.as_str());
                e.u(o.at as u32);
                e.s_str(o.what.as_str());
                e.u(o.spans.len() as u32);
                for (a, b, c) in o.spans.iter() {
                    e.u(*a as u32);
                    e.u(*b as u32);
                    e.u(*c as u32);
                }
            }
            None => e.u(0),
        }
        e.u(sf.attrs.len() as u32);
        for a in sf.attrs.iter() { a.codec_enc(e); }
        e.u(sf.items.len() as u32);
        for it in sf.items.iter() { it.codec_enc(e); }
        out.s_str(p.as_str());
        out.u(e.ids);
        out.u(e.b.len() as u32);
        out.b.extend_from_slice(e.b.as_slice());
    }
    let mut data: Vec<u8> = Vec::new();
    data.extend_from_slice(MAGIC.as_bytes());
    data.extend_from_slice(&sha256::sum(out.b.as_slice()));
    data.extend_from_slice(out.b.as_slice());
    data
}

/// A crate's files again from its export data, the crate's directory dir
/// (resolve::Crate::dir) naming them (None: not export data, or damaged).
pub fn decode(data: Vec<u8>, dir: &str) -> Option<HashMap<String, &SourceFile>> {
    let head = MAGIC.len() + 32;
    if data.len() < head || &data[0..MAGIC.len()] != MAGIC.as_bytes() { return None; }
    let body = data[head..].to_vec();
    if &sha256::sum(body.as_slice())[0..32] != &data[MAGIC.len()..head] { return None; }
    // The files' parts and id ranges, then the parts decoded on several
    // threads.
    let d = &mut Dec { b: body, at: 0, bad: false, seen: new_seen(), next: 0, end: 0 };
    let n = d.u() as usize;
    let mut parts: Vec<(String, u32, usize, usize)> = Vec::new(); // (path, ids, from, to)
    let mut total = 0u64;
    let mut k = 0;
    while k < n && !d.bad {
        let p = d.s();
        let ids = d.u();
        let len = d.u() as usize;
        if len > d.b.len() - d.at { return None; }
        parts.push((p, ids, d.at, d.at + len));
        d.at += len;
        total += ids as u64;
        k += 1;
    }
    if d.bad || d.at != d.b.len() || total > 0x40000000 { return None; }
    let base = next_id();
    set_next_id(base + total as u32);
    let mut bases: Vec<u32> = Vec::new();
    let mut b = base;
    for (_, ids, _, _) in parts.iter() {
        bases.push(b);
        b += *ids;
    }
    let mut outs: Vec<Option<(&SourceFile, Option<&FileOrigin>)>> = Vec::new();
    for _ in parts.iter() { outs.push(None); }
    let all = d.b;
    crate::util::par_for(parts.len(), 1, |i| {
        let (p, ids, from, to) = parts[i];
        let fd = &mut Dec { b: all[from..to].to_vec(), at: 0, bad: false, seen: new_seen(), next: bases[i], end: bases[i] + ids };
        if let Some(x) = decode_file(fd, util::path_join(dir, p.as_str()).as_str()) { outs[i] = Some(x); }
    });
    let mut out: HashMap<String, &SourceFile> = HashMap::new();
    let mut i = 0;
    while i < parts.len() {
        match outs[i] { Some((sf, _)) => { out.insert(parts[i].0.clone(), sf); } None => return None }
        i += 1;
    }
    // Derived code's files mapped to the files they come from.
    i = 0;
    while i < parts.len() {
        if let Some((sf, Some(fo))) = outs[i] {
            let src = match out.get(&fo.path) { Some(s) => *s, None => return None };
            let o = &Origin { file: src.file, at: fo.at, spans: fo.spans.clone(), what: fo.what.clone() };
            let file = File::with_lines_origin(sf.file.name.as_str(), sf.file.line_starts().clone(), o);
            out.insert(parts[i].0.clone(), &SourceFile { file, attrs: sf.attrs.clone(), items: sf.items.clone() });
        }
        i += 1;
    }
    Some(out)
}

// Where a derived code's file comes from (see encode).
struct FileOrigin {
    path: String,
    at: Pos,
    what: String,
    spans: Vec<(Pos, Pos, Pos)>,
}

// One file's part (see decode), and its origin if it is derived code.
fn decode_file(d: &mut Dec, name: &str) -> Option<(&SourceFile, Option<&FileOrigin>)> {
    let nl = d.u() as usize;
    let mut lines: Vec<Pos> = Vec::with_capacity(nl);
    let mut prev = 0;
    let mut i = 0;
    while i < nl && !d.bad {
        prev = prev + d.u() as Pos;
        lines.push(prev);
        i += 1;
    }
    let file = File::with_lines(name, lines);
    let mut fo: Option<&FileOrigin> = None;
    if d.u() == 1 {
        let path = d.s();
        let at = d.u() as Pos;
        let what = d.s();
        let ns = d.u() as usize;
        let mut spans: Vec<(Pos, Pos, Pos)> = Vec::new();
        let mut k = 0;
        while k < ns && !d.bad {
            let a = d.u() as Pos;
            let b = d.u() as Pos;
            let c = d.u() as Pos;
            spans.push((a, b, c));
            k += 1;
        }
        fo = Some(&FileOrigin { path, at, what, spans });
    }
    let na = d.u() as usize;
    let mut attrs: Vec<&Attr> = Vec::with_capacity(na);
    i = 0;
    while i < na && !d.bad {
        attrs.push(Attr::codec_dec_ref(d));
        i += 1;
    }
    let ni = d.u() as usize;
    let mut items: Vec<Item> = Vec::with_capacity(ni);
    i = 0;
    while i < ni && !d.bad {
        items.push(Item::codec_dec(d));
        i += 1;
    }
    if d.bad || d.at != d.b.len() || d.next != d.end { return None; }
    Some((&SourceFile { file, attrs, items }, fo))
}

// The crates whose files come from their export data, by name (set before
// the front end reads them).
static mut PRELOADED: HashMap<String, HashMap<String, &SourceFile>> = HashMap::new();

/// Forgets the crates set to come from their export data.
pub fn clear() { PRELOADED = HashMap::new(); }

/// Crate name's files are to come from export data.
pub fn preload(name: &str, files: HashMap<String, &SourceFile>) { PRELOADED.insert(name.to_string(), files); }

/// Crate name's files from its export data, if so set.
pub fn preloaded(name: &str) -> Option<HashMap<String, &SourceFile>> {
    match PRELOADED.get(&name.to_string()) { Some(f) => Some(f.clone()), None => None }
}

/// The export data stored under a crate's key (crate::libcache).
pub fn load(key: &str, dir: &str) -> Option<HashMap<String, &SourceFile>> {
    let p = path(key)?;
    let data = std::fs::read(p.as_str()).ok()?;
    let out = decode(data, dir)?;
    crate::cache::mark_used(p.as_str());
    Some(out)
}

/// Whether export data is stored under key.
pub fn exists(key: &str) -> bool {
    match path(key) { Some(p) => std::path::Path::new(p.as_str()).exists(), None => false }
}

/// Stores a crate's export data under its key.
pub fn store(key: &str, files: &HashMap<String, &SourceFile>) {
    let p = match path(key) { Some(p) => p, None => return };
    let data = encode(files);
    let tmp = `${p}.${std::process::id()}`.to_string();
    if std::fs::write(tmp.as_str(), data.as_slice()).is_err() { return; }
    if std::fs::rename(tmp.as_str(), p.as_str()).is_err() { let _ = std::fs::remove_file(tmp.as_str()); }
}

fn path(key: &str) -> Option<String> {
    let d = crate::cache::dir()?;
    Some(util::path_join(d.as_str(), `${key}.navih`.to_string().as_str()))
}
