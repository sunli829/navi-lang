//! The compiler driver: crates from command-line paths, the std crate,
//! and the phases.

use crate::resolve::{self, CrateSpec, Config};
use crate::util;
use crate::diag::{Sink, Error};
use crate::types;
use std::path::Path;

/// The targets: os-arch.
fn target_by_id(i: i64) -> &str {
    match i {
        0 => "macos-arm64",
        1 => "macos-x64",
        2 => "linux-x64",
        3 => "linux-arm64",
        4 => "windows-x64",
        _ => "",
    }
}

/// The target (an index of target_by_id): --target, else the host.
static mut TARGET_ID: i64 = -1;

/// --target android-arm64: linux-arm64's code, linked for Android's bionic.
static mut BIONIC: bool = false;

/// --linker cc: the system linker instead of navi's own.
static mut LINKER_CC: bool = false;

pub fn bionic() -> bool { BIONIC }

/// Selects the linker (--linker): navi's own or the system's (cc).
fn set_linker(name: &str) -> bool {
    match name {
        "cc" => LINKER_CC = true,
        "navi" => LINKER_CC = false,
        _ => {
            eprintln(`navi: unknown linker ${name} (navi, cc)`);
            return false;
        }
    }
    true
}

pub fn linker_cc() -> bool { LINKER_CC }

/// Selects the target by name; false if there is no such target.
pub fn set_target(name: &str) -> bool {
    if name == "android-arm64" {
        BIONIC = true;
        return set_target("linux-arm64");
    }
    let mut i = 0;
    while target_by_id(i).len() > 0 {
        if target_by_id(i) == name {
            TARGET_ID = i;
            return true;
        }
        i += 1;
    }
    false
}

/// The target's name (os-arch).
pub fn target_name() -> String {
    if TARGET_ID < 0 {
        let host = `${host_os()}-${if host_arch() == "aarch64" { "arm64" } else { "x64" }}`.to_string();
        if !set_target(host.as_str()) {
            eprintln(`navi: unknown target ${host} (${known_targets()})`);
            std::process::exit(2);
        }
    }
    target_by_id(TARGET_ID).to_string()
}

pub fn known_targets() -> String {
    let mut out: Vec<String> = Vec::new();
    let mut i = 0;
    while target_by_id(i).len() > 0 {
        out.push(target_by_id(i).to_string());
        i += 1;
    }
    out.push("android-arm64".to_string());
    out.join(", ")
}

/// The target's OS: macos, linux or windows.
pub fn target_os() -> String {
    let t = target_name();
    t[0..t.find('-').unwrap()].to_string()
}

/// The target's architecture as objects name it: arm64 or amd64.
pub fn target_arch() -> String {
    if target_name().ends_with("-arm64") { "arm64".to_string() } else { "amd64".to_string() }
}

/// The #[cfg] settings for the target.
pub fn host_config() -> Config {
    let arch = if target_arch() == "arm64" { "aarch64" } else { "x86_64" };
    Config { target_os: target_os(), target_arch: arch.to_string(), test: false }
}

#[cfg(target_os = "macos")]
fn host_os() -> &str { "macos" }
#[cfg(target_os = "linux")]
fn host_os() -> &str { "linux" }
#[cfg(target_os = "windows")]
fn host_os() -> &str { "windows" }
#[cfg(target_arch = "aarch64")]
fn host_arch() -> &str { "aarch64" }
#[cfg(target_arch = "x86_64")]
fn host_arch() -> &str { "x86_64" }

/// The std crate, read from $NAVI_STD (default: see default_std).
pub fn std_crate() -> &CrateSpec {
    let dir = match std::env::var("NAVI_STD") { Ok(d) => d, Err(_) => default_std() };
    if !Path::new(util::path_join(dir.as_str(), "src/lib.navi").as_str()).exists() {
        eprintln(`navi: the standard library is not at ${dir} (set NAVI_STD)`);
        std::process::exit(2);
    }
    &CrateSpec { name: "std".to_string(), fs_root: dir, root: "src/lib.navi".to_string(), deps: Vec::new(), dir: String::new() }
}

/// Where std is without NAVI_STD: lib/std next to the directory holding
/// navi's executable (a release unpacks to bin/navi and lib/std; as Go
/// finds GOROOT from its binary), else lib/std in the current directory (a
/// checkout of the repository).
fn default_std() -> String {
    if let Some(exe) = exe_path() {
        let root = util::path_dir(util::path_dir(util::path_clean(exe.as_str()).as_str()).as_str());
        let d = util::path_join(root.as_str(), "lib/std");
        if Path::new(util::path_join(d.as_str(), "src/lib.navi").as_str()).exists() { return d; }
    }
    "lib/std".to_string()
}

// The running executable, symbolic links resolved (a link in a bin
// directory still finds std).
pub fn exe_path() -> Option<String> {
    let p = std::env::current_exe().ok()?;
    let c = match std::fs::canonicalize(&p) { Ok(c) => c, Err(_) => p };
    Some(util::without_verbatim(c.to_str()?))
}
/// The suffix of the host's executables.
pub fn host_exe_suffix() -> &str { if host_os() == "windows" { ".exe" } else { "" } }

/// navi derive-build specs exe: builds the program of a crate's derive
/// macros (resolve::expand) for the host from the crates in specs (lines of
/// name, fs_root, root, dir and deps separated by tabs; the last is the
/// program's), using the build cache.
pub fn derive_build_command(args: &Vec<String>) -> i32 {
    if args.len() != 2 {
        eprintln("usage: navi derive-build <specs> <exe>");
        return 2;
    }
    let text = match std::fs::read_to_string(args[0].as_str()) {
        Ok(t) => t,
        Err(e) => {
            eprintln(`${args[0]}: ${e}`);
            return 1;
        }
    };
    let exe = args[1].as_str();
    let mut specs: Vec<&CrateSpec> = Vec::new();
    for line in text.lines() {
        let f: Vec<&str> = line.split('\t').collect();
        if f.len() != 5 { continue; }
        let mut deps: Vec<String> = Vec::new();
        for d in f[4].split(',') { if d.len() > 0 { deps.push(d.to_string()); } }
        specs.push(&CrateSpec { name: f[0].to_string(), fs_root: f[1].to_string(), root: f[2].to_string(), dir: f[3].to_string(), deps });
    }
    if specs.len() == 0 { return 2; }
    let last = specs[specs.len() - 1];
    let key = crate::cache::key(`derive-build target=${target_name()}\n${text}`.to_string().as_str(), util::path_join(last.fs_root.as_str(), last.root.as_str()).as_str());
    if let Some(k) = &key {
        if crate::cache::lookup(k.as_str(), exe) {
            chmod_x(exe);
            return 0;
        }
    }
    let (info, errs) = check_specs(host_config(), &specs);
    let (warnings, failed) = diagnostics(&errs);
    if warnings.len() > 0 { eprintln(warnings); }
    if failed { return 1; }
    let main = match find_main(info, last.name.as_str()) {
        Some(m) => m,
        None => {
            eprintln("derive-build: no main");
            return 1;
        }
    };
    if let Err(e) = native(info, main_entry(main), exe, false) {
        eprintln(e);
        return 1;
    }
    if let Some(k) = key { crate::cache::store(k.as_str(), exe, warnings.as_str()); }
    0
}

fn crate_name(s: &str) -> String { s.replace('-', "_") }

/// The crate at path: a single .navi file, or the crate a directory is in
/// (see project::find).
pub fn load_crate(path: &str) -> Result<&mut CrateSpec, String> {
    let p = Path::new(path);
    if !p.exists() { return Err(`stat ${path}: no such file or directory`.to_string()); }
    if !p.is_dir() {
        if !path.ends_with(".navi") { return Err(`${path}: not a .navi file or a crate directory`.to_string()); }
        let base = util::path_base(path);
        let name = crate_name(&base[0..base.len() - 5]);
        let dir = util::path_dir(path);
        return Ok(&mut CrateSpec { name, fs_root: dir.clone(), root: base, deps: Vec::new(), dir });
    }
    let pr = crate::project::find(path)?;
    if pr.selected.len() != 1 { return Err(`${path}: the root of a workspace: name one of its members (${crate::deps::member_names(pr)})`.to_string()); }
    let m = pr.selected[0];
    note_package(m.name.as_str(), m.manifest);
    Ok(&mut CrateSpec { name: m.name.clone(), fs_root: m.dir.clone(), root: m.root.clone(), deps: Vec::new(), dir: m.dir.clone() })
}

// Each crate's package (std::build: name, version, description), by crate
// name; a single file's is its name alone.
static mut PACKAGES: std::collections::HashMap<String, (String, String, String)> = std::collections::HashMap::new();

// navi build --var name=value (std::build::var), in order.
static mut BUILD_VARS: Vec<(String, String)> = Vec::new();

/// Notes crate name's package (its manifest).
pub fn note_package(name: &str, m: &crate::manifest::Manifest) {
    PACKAGES.insert(name.to_string(), (m.name.clone(), m.version.clone(), m.description.clone()));
}

/// Crate name's package: (name, version, description).
pub fn package_of(name: &str) -> (String, String, String) {
    match PACKAGES.get(&name.to_string()) {
        Some(p) => p.clone(),
        None => (if name == "std" { String::new() } else { name.to_string() }, String::new(), String::new()),
    }
}

/// --var name's value (the last given).
pub fn build_var(name: &str) -> Option<String> {
    let mut found: Option<String> = None;
    for (k, v) in BUILD_VARS.iter() { if k.as_str() == name { found = Some(v.clone()); } }
    found
}

/// What std::build gives crate name, for its cache key: its package and,
/// with vars, the --var values.
pub fn build_info_key(name: &str, vars: bool) -> String {
    let (n, v, d) = package_of(name);
    let mut out = `package ${n}\nversion ${v}\ndescription ${d}\n`.to_string();
    if vars {
        for (k, x) in BUILD_VARS.iter() { out.push_str(`var ${k}=${x}\n`.to_string().as_str()); }
    }
    out
}

// --var name=value; false (reported) if not of that form.
fn add_var(spec: &str) -> bool {
    match spec.split_once('=') {
        Some((k, v)) if k.len() > 0 => {
            BUILD_VARS.push((k.to_string(), v.to_string()));
            true
        }
        _ => {
            eprintln(`navi: --var takes name=value, not ${spec}`);
            false
        }
    }
}

static mut TIMINGS: bool = false;
// navi test's -timeout: a test program running longer is killed (0: none).
static mut TIMEOUT_NS: u64 = 600000000000;
static mut TIMEOUT_TEXT: String = "10m".to_string();
// What navi test passes the test programs after its "--".
static mut HARNESS_ARGS: Vec<String> = Vec::new();
static mut PHASE_START: u64 = 0;
static mut PHASE_CPU: u64 = 0;

/// Prints the time since the previous phase ended (with -timings), and the
/// CPU time of all threads in it.
pub fn phase(name: &str) {
    let t = crate::driver::now_nanos();
    let c = cpu_nanos();
    if TIMINGS && PHASE_START != 0 {
        let ms = (t - PHASE_START) / 1000000;
        let cpu = (c - PHASE_CPU) / 1000000;
        let gs = std::gc::stats();
        eprintln(`  ${name}: ${ms} ms (cpu ${cpu} ms, gc ${gs.collections}, live ${gs.live_bytes >> 20} MiB)`);
    }
    PHASE_START = t;
    PHASE_CPU = c;
}

#[cfg(target_os = "macos")]
extern "C" {
    fn clock_gettime_nsec_np(clock: u32) -> u64;
}

#[cfg(target_os = "macos")]
fn cpu_nanos() -> u64 { unsafe { clock_gettime_nsec_np(12) } } // CLOCK_PROCESS_CPUTIME_ID
#[cfg(not(target_os = "macos"))]
fn cpu_nanos() -> u64 { 0 }

pub fn now_nanos() -> u64 {
    let d = std::time::Instant::now().duration_since(START.clone());
    d.as_nanos() as u64 + 1
}

static START: std::time::Instant = std::time::Instant::now();

/// Runs the front end over the given crates.
pub fn check_specs(cfg: Config, specs: &Vec<&CrateSpec>) -> (&mut types::collect::Info, Vec<Error>) {
    phase("start");
    split_prepare(specs, false);
    check_prepared(cfg, specs)
}

/// check_specs for an editor (navi lsp): crates whose export data is in
/// the cache are read from it (it needs no objects), and the export data
/// of those read from source is stored.
pub fn check_specs_for_editor(cfg: Config, specs: &Vec<&CrateSpec>) -> (&mut types::collect::Info, Vec<Error>) {
    split_prepare(specs, true);
    let (info, errs) = check_prepared(cfg, specs);
    for c in info.res.crates.iter() {
        if c.preloaded { continue; }
        if let Some(k) = SPLIT_KEYS.get(&c.name) {
            if !crate::navih::exists(k.as_str()) { crate::navih::store(k.as_str(), &c.sources); }
        }
    }
    (info, errs)
}

fn check_prepared(cfg: Config, specs: &Vec<&CrateSpec>) -> (&mut types::collect::Info, Vec<Error>) {
    let (res, rerrs) = resolve::resolve(cfg, specs);
    phase("parse+resolve");
    let sink = Sink::new();
    for e in rerrs.iter() { sink.add(e.clone()); }
    let info = types::collect::collect(res, sink);
    phase("types");
    (info, sink.sorted())
}

// The crates compiled alone (every one but the program's, the last), by
// name: their cache keys (crate::libcache).
static mut SPLIT_KEYS: std::collections::HashMap<String, String> = std::collections::HashMap::new();

// Each crate compiled alone gets its key, dependencies first; one whose
// object and export data are in the cache (an editor needs the export data
// only) is to be read from its export data (crate::navih) instead of its
// source. (Not with -d checkstd, which checks every body.)
fn split_prepare(specs: &Vec<&CrateSpec>, editor: bool) {
    SPLIT_KEYS = std::collections::HashMap::new();
    crate::navih::clear();
    if specs.len() == 0 { return; }
    let preload = !crate::dflags::on("checkstd");
    let mut by_name: std::collections::HashMap<String, &CrateSpec> = std::collections::HashMap::new();
    for s in specs.iter() { by_name.insert(s.name.clone(), *s); }
    let top = specs[specs.len() - 1];
    let target = target_name();
    // Depth first, dependencies by name; a crate after its dependencies.
    let mut seen: std::collections::HashMap<String, bool> = std::collections::HashMap::new();
    let mut stack: Vec<(&CrateSpec, bool)> = Vec::new();
    stack.push((top, false));
    while let Some((c, after)) = stack.pop() {
        let deps = spec_deps(c);
        if after {
            if c.name == top.name { continue; }
            let mut dep_keys: Vec<String> = Vec::new();
            for d in deps.iter() {
                match SPLIT_KEYS.get(d) { Some(k) => dep_keys.push(`${d} ${k}`.to_string()), None => dep_keys.push(`${d} -`.to_string()) }
            }
            dep_keys.sort();
            let root = util::path_clean(c.fs_root.as_str());
            let key = match crate::libcache::key(c.name.as_str(), root.as_str(), target.as_str(), &dep_keys) { Some(k) => k, None => continue };
            if preload && (editor || crate::libcache::exists(key.as_str())) {
                // (Named as resolve names the files it reads.)
                let dir = if c.dir.len() == 0 { c.name.clone() } else { c.dir.clone() };
                if let Some(files) = crate::navih::load(key.as_str(), dir.as_str()) { crate::navih::preload(c.name.as_str(), files); }
            }
            SPLIT_KEYS.insert(c.name.clone(), key);
            continue;
        }
        if seen.contains_key(&c.name) { continue; }
        seen.insert(c.name.clone(), true);
        stack.push((c, true));
        let mut ds = deps.clone();
        ds.sort_by(|a, b| b.cmp(a));
        for d in ds.iter() {
            if seen.contains_key(d) { continue; }
            if let Some(s) = by_name.get(d) { stack.push((*s, false)); }
        }
    }
}

// The crates a crate depends on, by name (std for every other).
fn spec_deps(c: &CrateSpec) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    if c.name != "std" { out.push("std".to_string()); }
    for d in c.deps.iter() {
        let n = match d.split_once('=') { Some((_, n)) => n.to_string(), None => d.clone() };
        if !out.contains(&n) { out.push(n); }
    }
    out
}

/// The diagnostics to print (std's warnings left out); whether there are
/// errors.
pub fn diagnostics(errs: &Vec<Error>) -> (String, bool) {
    let mut lines: Vec<String> = Vec::new();
    let mut failed = false;
    for e in errs.iter() {
        if e.warning && e.pos.file.starts_with("std/") { continue; }
        if !e.warning { failed = true; }
        lines.push(`${e}`.to_string());
    }
    (lines.join("\n"), failed)
}

/// Prints the diagnostics; whether there are errors.
pub fn report(errs: &Vec<Error>) -> bool {
    let (text, failed) = diagnostics(errs);
    if text.len() > 0 { eprintln(text); }
    failed
}

/// The main function of the crate named name.
pub fn find_main(info: &types::collect::Info, name: &str) -> Option<&mut resolve::Def> {
    for c in info.res.crates.iter() {
        if c.name != name { continue; }
        if let Some(b) = c.root.unwrap().lookup("main", resolve::VALUE_NS) {
            if let Some(d) = b.res.def {
                if d.kind == resolve::DEF_FN { return Some(d); }
            }
        }
    }
    None
}

/// What an executable runs: main, or the harness of navi test / bench.
pub struct Entry {
    pub main: Option<&mut resolve::Def>,
    pub tests: Vec<&mut resolve::Def>,
    pub bench: bool,
}

pub fn main_entry(main: &mut resolve::Def) -> &Entry { &Entry { main: Some(main), tests: Vec::new(), bench: false } }

/// Compiles a checked program into the object model for the target
/// (code_split).
pub fn code(info: &mut types::collect::Info, entry: &Entry, dwarf: bool) -> Result<&mut crate::obj::Object, String> { code_split(info, entry, dwarf) }

// The plan's code for the target as an object.
fn backend(plan: &mut crate::codegen::Plan, dwarf: bool) -> Result<&mut crate::obj::Object, String> {
    let os = target_os();
    let arm = target_arch() == "arm64";
    let tgt = crate::backend::lower::TargetConv {
        c_prefix: if os == "macos" { "_".to_string() } else { String::new() },
        write: if os == "windows" { "_write".to_string() } else { "write".to_string() },
        os: os.clone(),
        num_saved: if arm { 9 } else { 2 },
        code_unit: if arm { 4 } else { 1 },
    };
    if arm {
        // -d llsc tests linux-arm64's atomics on macOS.
        if os == "macos" && !crate::dflags::on("llsc") {
            crate::backend::lower::generate(plan, "arm64", || -> &mut dyn crate::backend::machine::Machine { crate::backend::arm64::new_machine(true, os == "macos") }, tgt, dwarf)
        } else {
            crate::backend::lower::generate(plan, "arm64", || -> &mut dyn crate::backend::machine::Machine { crate::backend::arm64::new_machine(false, os == "macos") }, tgt, dwarf)
        }
    } else if os == "windows" {
        crate::backend::lower::generate(plan, "amd64", || -> &mut dyn crate::backend::machine::Machine { crate::backend::amd64::new_machine(true) }, tgt, dwarf)
    } else {
        crate::backend::lower::generate(plan, "amd64", || -> &mut dyn crate::backend::machine::Machine { crate::backend::amd64::new_machine(false) }, tgt, dwarf)
    }
}

// The errors in std bodies checked on first use (while building MIR).
fn lazy_errors(info: &mut types::collect::Info) -> Result<(), String> {
    if let Some(c) = info.c {
        let mut lines: Vec<String> = Vec::new();
        for e in c.errs.sorted().iter() {
            if !e.warning { lines.push(`${e}`.to_string()); }
        }
        if lines.len() > 0 { return Err(lines.join("\n")); }
    }
    Ok(())
}

/// The definitions a crate compiled alone starts from: its non-generic
/// functions with bodies (outside traits) and its statics.
pub fn crate_roots(info: &mut types::collect::Info, name: &str) -> Vec<&mut resolve::Def> {
    let mut out: Vec<&mut resolve::Def> = Vec::new();
    for d in info.res.defs.iter() {
        if d.krate.name != name { continue; }
        if d.kind == resolve::DEF_STATIC {
            if let resolve::Node::Item(crate::syntax::ast::Item::Static(n)) = &d.node { if n.value.is_some() { out.push(*d); } }
            continue;
        }
        if d.kind != resolve::DEF_FN && d.kind != resolve::DEF_ASSOC_FN { continue; }
        let f = match &d.node { resolve::Node::Item(crate::syntax::ast::Item::Fn(f)) => f, _ => continue };
        if f.body.is_none() || types::collect::has_attr(&f.base.attrs, "intrinsic") || types::collect::has_attr(&f.base.attrs, "test") || types::collect::has_attr(&f.base.attrs, "bench") { continue; }
        if let Some(p) = d.parent { if p.kind == resolve::DEF_TRAIT { continue; } }
        if info.generics_of(*d).all().len() > 0 { continue; }
        out.push(*d);
    }
    out
}

// Each crate the program depends on compiled alone (every
// non-generic function and static, with its functions' escape summaries),
// its dependencies' non-generic functions external, dependencies first;
// then the program's crate so, its main running the crates' initializers
// in that order; the objects merged. A crate comes from the build cache
// when a build (of any program) compiled the same crate the same way, on
// the same dependencies (crate::libcache).
fn code_split(info: &mut types::collect::Info, entry: &Entry, dwarf: bool) -> Result<&mut crate::obj::Object, String> {
    let mut done: std::collections::HashMap<String, bool> = std::collections::HashMap::new();
    let mut sums: std::collections::HashMap<String, crate::mir::escape::Summary> = std::collections::HashMap::new();
    let mut libs: Vec<&mut crate::obj::Object> = Vec::new();
    let order = split_order(info);
    for c in order.iter() {
        let key = SPLIT_KEYS.get(&c.name).map(|k| k.clone());
        let cached = match key { Some(k) => crate::libcache::load(k.as_str()), None => None };
        let (o, s) = match cached {
            Some(x) => x,
            None => {
                if c.preloaded { return Err(`internal error: crate ${c.name} was read from its export data, but its object is not in the cache`.to_string()); }
                let roots = crate_roots(info, c.name.as_str());
                let ext = &mut crate::mir::build::Ext { crates: done.clone(), summaries: sums.clone() };
                let lib = crate::mir::build::build_program(info, Some(roots.clone()), if done.len() > 0 { Some(ext) } else { None });
                lazy_errors(info)?;
                let s = lib.summaries;
                let plan = crate::codegen::build_library_plan(lib, c.name.as_str(), &roots);
                let o = backend(plan, true)?;
                if let Some(k) = key {
                    crate::libcache::store(k.as_str(), o, &s);
                    crate::navih::store(k.as_str(), &c.sources);
                }
                (o, s)
            }
        };
        // (Crates are compiled with debug information: left out here if
        // the program is built without.)
        if !dwarf {
            o.lines = Vec::new();
            o.funcs = Vec::new();
        }
        for (d, sm) in s.iter() { sums.insert(d.clone(), sm.clone()); }
        done.insert(c.name.clone(), true);
        libs.push(o);
        phase(c.name.as_str());
    }
    let mut roots: Vec<&mut resolve::Def> = Vec::new();
    match entry.main {
        Some(m) => roots.push(m),
        None => { for t in entry.tests.iter() { roots.push(*t); } }
    }
    let ext = &mut crate::mir::build::Ext { crates: done, summaries: sums };
    let prog = crate::mir::build::build_program(info, Some(roots), Some(ext));
    lazy_errors(info)?;
    let mf = match entry.main {
        Some(m) => prog.func(m).unwrap(),
        None => crate::mir::harness::harness(prog, &entry.tests, entry.bench),
    };
    phase("mir");
    let plan = crate::codegen::build_plan(prog, entry.main, mf);
    for c in order.iter() { plan.ext_inits.push(c.name.clone()); }
    phase("plan");
    let o = backend(plan, dwarf)?;
    phase("codegen");
    let mut parts: Vec<&mut crate::obj::Object> = Vec::new();
    parts.push(o);
    for l in libs.iter() { parts.push(*l); }
    crate::merge::merge(&parts)
}

// The crates compiled alone (every one but the program's, the last
// loaded), each after its dependencies.
fn split_order(info: &mut types::collect::Info) -> Vec<&mut resolve::Crate> {
    let all = info.res.crates;
    let mut out: Vec<&mut resolve::Crate> = Vec::new();
    if all.len() == 0 { return out; }
    let top = all[all.len() - 1];
    let mut seen: std::collections::HashMap<String, bool> = std::collections::HashMap::new();
    // Depth first, dependencies by name (the same order every time); a
    // crate after all of its dependencies.
    let mut stack: Vec<(&mut resolve::Crate, bool)> = Vec::new();
    stack.push((top, false));
    while let Some((c, after)) = stack.pop() {
        if after {
            if c.name != top.name { out.push(c); }
            continue;
        }
        if seen.contains_key(&c.name) { continue; }
        seen.insert(c.name.clone(), true);
        stack.push((c, true));
        let mut ds: Vec<&mut resolve::Crate> = Vec::new();
        for (_, d) in c.deps.iter() { ds.push(*d); }
        ds.sort_by(|a, b| b.name.cmp(&a.name));
        for d in ds.iter() { if !seen.contains_key(&d.name) { stack.push((*d, false)); } }
    }
    out
}

/// Compiles a checked program into an object file for the target.
pub fn object(info: &mut types::collect::Info, entry: &Entry, dwarf: bool) -> Result<Vec<u8>, String> {
    let o = code(info, entry, dwarf)?;
    let os = target_os();
    if os == "macos" { return crate::macho::write(o); }
    if os == "linux" { return crate::elf::write(o); }
    crate::coff::write(o)
}

/// Compiles a checked program into the executable out with navi's own
/// linker (--linker cc, and targets it does not handle, use the system
/// linker instead).
pub fn native(info: &mut types::collect::Info, entry: &Entry, out: &str, dwarf: bool) -> Result<(), String> {
    let use_cc = LINKER_CC;
    let os = target_os();
    if !use_cc {
        let o = code(info, entry, dwarf)?;
        let exe = if os == "macos" { crate::link::link(o, util::path_base(out).as_str())? }
            else if os == "linux" { crate::elflink::link(o)? }
            else { crate::pelink::link(o)? };
        if let Err(e) = write_new(out, exe.as_slice()) { return Err(`${e}`.to_string()); }
        phase("link");
        chmod_x(out);
        return Ok(());
    }
    let o = code(info, entry, dwarf)?;
    let libs = o.libraries();
    let data = if os == "macos" { crate::macho::write(o)? } else if os == "linux" { crate::elf::write(o)? } else { crate::coff::write(o)? };
    let obj_path = if os == "windows" { `${out}.navi.obj`.to_string() } else { `${out}.navi.o`.to_string() };
    if let Err(e) = std::fs::write(obj_path.as_str(), data.as_slice()) { return Err(`${e}`.to_string()); }
    let _ = std::fs::remove_file(out);
    let mut cmd = std::process::Command::new(if os == "windows" { "clang" } else { "cc" });
    if os == "macos" { cmd.arg("-arch").arg(if target_arch() == "arm64" { "arm64" } else { "x86_64" }); }
    cmd.arg("-o").arg(out).arg(obj_path.as_str());
    if os == "linux" { cmd.arg("-lm"); }
    // The libraries of #[link].
    for l in libs.iter() {
        let (kind, name) = match l.split_once(':') { Some(p) => p, None => ("dylib", l.as_str()) };
        if kind == "framework" {
            cmd.arg("-framework").arg(name);
        } else if name.contains('/') || name.contains(".so") || name.ends_with(".dll") {
            cmd.arg(name);
        } else {
            let flag = `-l${name}`.to_string();
            cmd.arg(flag.as_str());
        }
    }
    let st = cmd.status();
    let _ = std::fs::remove_file(obj_path.as_str());
    phase("link");
    match st {
        Ok(s) => if s.success() { Ok(()) } else { Err(`link: cc exited with status ${s.code().unwrap()}`.to_string()) },
        Err(e) => Err(`link: ${e}`.to_string()),
    }
}

// Builds before 0.0.3 had a --release mode.
const RELEASE_GONE: &str = "navi: there is no --release: navi has one build mode (as Go), with overflow always checked; -s leaves out the debugging information";

/// What a command builds: a crate of the project a directory is in (or one
/// .navi file alone), with the crates of its program.
struct Unit {
    name: String,
    /// The crate's directory (a file's path): the build cache's key.
    root: String,
    specs: Vec<&CrateSpec>,
    /// A program (src/main.navi, or a file).
    bin: bool,
    /// Where outputs go: the project's target/ (a file's: .).
    out_dir: String,
    member: Option<&crate::project::Member>,
    /// The crate's directory relative to the project's root ("" at it).
    rel: String,
}

// The units path (a .navi file or a directory) and -p package name.
fn units(path: &str, package: &str) -> Result<Vec<&Unit>, String> {
    if !Path::new(path).exists() { return Err(`${path}: no such file or directory`.to_string()); }
    let mut out: Vec<&Unit> = Vec::new();
    if !Path::new(path).is_dir() {
        if package.len() > 0 { return Err("-p names a crate of a project, not a file".to_string()); }
        let spec = load_crate(path)?;
        let mut specs: Vec<&CrateSpec> = Vec::new();
        specs.push(std_crate());
        specs.push(spec);
        out.push(&Unit { name: spec.name.clone(), root: path.to_string(), specs, bin: true, out_dir: ".".to_string(), member: None, rel: String::new() });
        return Ok(out);
    }
    let p = crate::project::find(path)?;
    let mut sel: Vec<&crate::project::Member> = Vec::new();
    if package.len() > 0 {
        match p.member(package) {
            Some(m) => sel.push(m),
            None => return Err(`no crate called ${package} in ${p.root} (${crate::deps::member_names(p)})`.to_string()),
        }
    } else {
        sel = p.selected.clone();
    }
    let l = crate::deps::load_project(p, false, false)?;
    for m in sel.iter() {
        out.push(&Unit { name: m.name.clone(), root: m.dir.clone(), specs: crate::deps::program(l, *m), bin: m.is_bin(),
            out_dir: util::path_join(p.root.as_str(), "target"), member: Some(*m), rel: relative(p.root.as_str(), m.dir.as_str()) });
    }
    Ok(out)
}

// dir relative to root, a directory at or below it ("" for root itself).
fn relative(root: &str, dir: &str) -> String {
    if dir == root { return String::new(); }
    match dir.strip_prefix(`${root}/`.to_string().as_str()) { Some(r) => r.to_string(), None => dir.to_string() }
}

// The flags of build and run: what they set.
struct BuildFlags {
    out: String,
    package: String,
    strip: bool,
    obj_only: bool,
    force: bool,
}

// Parses build's (and run's) flags from args; the rest are positional.
fn build_flags(args: &Vec<String>, rest: &mut Vec<String>) -> Result<&mut BuildFlags, i32> {
    let f = &mut BuildFlags { out: String::new(), package: String::new(), strip: false, obj_only: false, force: false };
    let mut i = 0;
    while i < args.len() {
        match args[i].as_str() {
            "-o" | "-p" | "--target" | "--linker" | "--var" => {
                if i + 1 >= args.len() {
                    eprintln(`navi: ${args[i]} needs a value`);
                    return Err(2);
                }
                let v = args[i + 1].clone();
                match args[i].as_str() {
                    "-o" => f.out = v,
                    "-p" => f.package = v,
                    "--linker" => if !set_linker(v.as_str()) { return Err(2); },
                    "--var" => if !add_var(v.as_str()) { return Err(2); },
                    _ => {
                        if !set_target(v.as_str()) {
                            eprintln(`navi: unknown target ${v} (${known_targets()})`);
                            return Err(2);
                        }
                    }
                }
                i += 1;
            }
            "-s" => f.strip = true,
            "--release" => { eprintln(RELEASE_GONE); return Err(2); }
            "-c" => f.obj_only = true,
            "-timings" => TIMINGS = true,
            "-a" => f.force = true,
            "--" => {
                // The rest is the program's (navi run).
                for a in args[i..].iter() { rest.push(a.clone()); }
                return Ok(f);
            }
            a => {
                if a.starts_with("-") {
                    eprintln(`navi: unknown flag ${a}`);
                    return Err(2);
                }
                rest.push(args[i].clone());
            }
        }
        i += 1;
    }
    Ok(f)
}

/// navi build [-p name] [-o output] [-s] [--target os-arch] [--linker
/// navi|cc] [-c] [-a] [-timings] [dir or file] (and main's -d)
///
/// Builds the crate the directory (default .) is in, or every member of a
/// workspace at its root (-p: the member called name), or one .navi file.
/// A program goes to the project's target/name (a file's to ./name), a
/// library is checked. There is one build mode (as Go): overflow is always
/// checked. -s leaves out the debugging information (DWARF; as Go's
/// -ldflags=-s); -c writes an object file; -a rebuilds even if the build
/// cache has the output.
pub fn build_command(args: &Vec<String>) -> i32 {
    let mut rest: Vec<String> = Vec::new();
    let f = match build_flags(args, &mut rest) { Ok(f) => f, Err(c) => return c };
    if rest.len() > 1 {
        eprintln("usage: navi build [-p name] [-o output] [-s] [--target os-arch] [--linker navi|cc] [--var name=value] [-c] [-a] [-timings] [-d switches] [dir or file]");
        return 2;
    }
    let path = if rest.len() > 0 { rest[0].clone() } else { ".".to_string() };
    let us = match units(path.as_str(), f.package.as_str()) {
        Ok(u) => u,
        Err(e) => { eprintln(e); return 1; }
    };
    let bins = us.iter().filter(|u| u.bin).count();
    if f.out.len() > 0 && bins != 1 {
        eprintln(`navi: -o names one output, and ${path} has ${bins} programs: choose one with -p`);
        return 2;
    }
    let mut code = 0;
    for u in us.iter() {
        let r = if u.bin { build_unit(*u, f).map(|_| ()) } else { check_unit(*u) };
        if let Err(e) = r {
            if e.len() > 0 { eprintln(e); }
            code = 1;
        }
    }
    code
}

/// navi expand [-p name] [dir or file] [type]: prints what the derives of
/// the crate (of the type called type) expand to, formatted (as cargo
/// expand, for derives only).
pub fn expand_command(args: &Vec<String>) -> i32 {
    let mut rest: Vec<String> = Vec::new();
    let f = match build_flags(args, &mut rest) { Ok(f) => f, Err(c) => return c };
    let mut path = ".".to_string();
    let mut ty = String::new();
    if rest.len() == 2 {
        path = rest[0].clone();
        ty = rest[1].clone();
    } else if rest.len() == 1 {
        if std::path::Path::new(rest[0].as_str()).exists() { path = rest[0].clone(); } else { ty = rest[0].clone(); }
    } else if rest.len() > 2 {
        eprintln("usage: navi expand [-p name] [dir or file] [type]");
        return 2;
    }
    let us = match units(path.as_str(), f.package.as_str()) {
        Ok(u) => u,
        Err(e) => { eprintln(e); return 1; }
    };
    resolve::expand::RECORD = true;
    let mut code = 0;
    for u in us.iter() {
        resolve::expand::EXPANDED.clear();
        let (_, errs) = resolve::resolve(host_config(), &u.specs);
        let (warnings, failed) = diagnostics(&errs);
        if warnings.len() > 0 { eprintln(warnings); }
        if failed { code = 1; }
        let name = u.specs[u.specs.len() - 1].name.clone();
        for (c, what, src) in resolve::expand::EXPANDED.iter() {
            if *c != name { continue; }
            if ty.len() > 0 && !what.ends_with(` for ${ty}`.to_string().as_str()) { continue; }
            let text = match crate::fmt::format_source(what.as_str(), src.clone()) { Ok(t) => t, Err(_) => src.clone() };
            println(`// ${what}\n${text.trim_end()}\n`);
        }
    }
    code
}

// Type-checks a library unit; its warnings printed.
fn check_unit(u: &Unit) -> Result<(), String> {
    let (_, errs) = check_specs(host_config(), &u.specs);
    let (warnings, failed) = diagnostics(&errs);
    if warnings.len() > 0 { eprintln(warnings); }
    if failed { return Err(String::new()); }
    Ok(())
}

// Builds a program unit (from the build cache if it has it); its output
// file. An error already printed is "".
fn build_unit(u: &Unit, f: &BuildFlags) -> Result<String, String> {
    let mut out = f.out.clone();
    if out.len() == 0 {
        let win = target_os() == "windows";
        let base = if f.obj_only { `${u.name}.${if win { "obj" } else { "o" }}`.to_string() } else if win { `${u.name}.exe`.to_string() } else { u.name.clone() };
        if let Err(e) = std::fs::create_dir_all(u.out_dir.as_str()) { return Err(`${u.out_dir}: ${e}`.to_string()); }
        out = util::path_join(u.out_dir.as_str(), base.as_str());
    }
    // The output's name is in a Mach-O executable (its code signature's
    // identifier).
    let key = crate::cache::key(`${if f.obj_only { "obj" } else { "exe" }} strip=${f.strip} target=${target_name()} name=${util::path_base(out.as_str())}`.to_string().as_str(), u.root.as_str());
    if let Some(k) = key {
        if !f.force && crate::cache::lookup(k.as_str(), out.as_str()) {
            if !f.obj_only { chmod_x(out.as_str()); }
            phase("cached");
            return Ok(out);
        }
    }
    let (info, errs) = check_specs(host_config(), &u.specs);
    let (warnings, failed) = diagnostics(&errs);
    if warnings.len() > 0 { eprintln(warnings); }
    if failed { return Err(String::new()); }
    let main = match find_main(info, u.name.as_str()) {
        Some(m) => m,
        None => return Err(`${u.root}: no main function`.to_string()),
    };
    if f.obj_only {
        let data = object(info, main_entry(main), !f.strip)?;
        if let Err(e) = std::fs::write(out.as_str(), data.as_slice()) { return Err(`${out}: ${e}`.to_string()); }
    } else {
        native(info, main_entry(main), out.as_str(), !f.strip)?;
    }
    if let Some(k) = key { crate::cache::store(k.as_str(), out.as_str(), warnings.as_str()); }
    Ok(out)
}

/// navi run [-p name] [-s] [--target os-arch] [dir or file] [-- args]:
/// builds the program (as navi build) and runs it with args; its exit code.
pub fn run_command(args: &Vec<String>) -> i32 {
    let mut rest: Vec<String> = Vec::new();
    let f = match build_flags(args, &mut rest) { Ok(f) => f, Err(c) => return c };
    let mut prog_args: Vec<String> = Vec::new();
    let mut pos: Vec<String> = Vec::new();
    let mut after = false;
    for a in rest.iter() {
        if after { prog_args.push(a.clone()); } else if a == "--" { after = true; } else { pos.push(a.clone()); }
    }
    if pos.len() > 1 || f.out.len() > 0 || f.obj_only {
        eprintln("usage: navi run [-p name] [-s] [dir or file] [-- arguments]");
        return 2;
    }
    let path = if pos.len() > 0 { pos[0].clone() } else { ".".to_string() };
    let us = match units(path.as_str(), f.package.as_str()) {
        Ok(u) => u,
        Err(e) => { eprintln(e); return 1; }
    };
    let bins: Vec<&Unit> = us.iter().filter(|u| u.bin).map(|u| *u).collect();
    if bins.len() != 1 {
        let names: Vec<String> = bins.iter().map(|u| u.name.clone()).collect();
        eprintln(`navi: ${path} has ${bins.len()} programs${if names.len() > 0 { ` (${names.join(", ")}): choose one with -p`.to_string() } else { String::new() }}`);
        return 1;
    }
    let mut u = *bins[0];
    // A single file builds in a temporary directory (as go run).
    let file_only = u.member.is_none();
    let tmp = util::path_join(std::env::temp_dir().to_str().unwrap(), `navi-run-${std::process::id()}`.to_string().as_str());
    if file_only {
        let _ = std::fs::create_dir_all(tmp.as_str());
        u.out_dir = tmp.clone();
    }
    let out = match build_unit(&u, f) {
        Ok(o) => o,
        Err(e) => {
            if e.len() > 0 { eprintln(e); }
            return 1;
        }
    };
    let mut cmd = std::process::Command::new(out.as_str());
    for a in prog_args.iter() { cmd.arg(a.as_str()); }
    let st = cmd.status();
    if file_only { let _ = std::fs::remove_dir_all(tmp.as_str()); }
    match st {
        Ok(s) => match s.code() { Some(c) => c, None => 1 },
        Err(e) => { eprintln(`${out}: ${e}`); 1 }
    }
}

/// Writes a new file at path (removing an old one first: macOS kills a
/// signed executable rewritten in place while its old signature is cached).
pub fn write_new(path: &str, data: &[u8]) -> std::io::Result<()> {
    let _ = std::fs::remove_file(path);
    std::fs::write(path, data)
}

fn chmod_x(path: &str) {
    if host_os() == "windows" { return; }
    let _ = std::process::Command::new("chmod").arg("755").arg(path).status();
}

/// navi test|bench [-p name] [--no-run] [-j N] [-timeout d] [dir or file ...] [filter]:
/// builds the #[test] (or #[bench]) functions of each crate (as navi build
/// chooses them) with cfg(test) into a harness and runs the ones whose name
/// contains filter; then (navi test) each file of the crate's tests/
/// directory as a crate of its own (as Cargo's integration tests), using
/// the crate if it is a library, with NAVI_BIN_EXE_name naming its program
/// if it is one. The harnesses are cached as navi build's programs.
/// --no-run builds the test programs and prints where they are (as cargo
/// test --no-run), for running them elsewhere.
///
/// With more than one path (the last argument is the filter if it is not a
/// file or directory), navi test tests them in processes of their own, N at
/// a time (-j; the number of CPUs by default, whatever NAVI_MAXPROCS says), printing each one's output
/// when it ends, in the paths' order, as go test does with packages: "ok"
/// and the summary if it passed, all of it and "FAIL" if not. A test
/// program running longer than -timeout (10m by default, as go test's; 0
/// for none) is killed. Arguments after "--" go to the test programs (as
/// cargo test's): --test-threads=N (the tests of a program run in parallel,
/// as Rust's) and --nocapture.
pub fn test_command(args: &Vec<String>, bench: bool) -> i32 {
    let mut rest: Vec<String> = Vec::new();
    let mut package = String::new();
    let mut no_run = false;
    // (The CPUs, not NAVI_MAXPROCS: each process runs that many threads;
    // NAVI_MAXPROCS=16 on a 4-CPU machine ran 16 processes of 16.)
    let mut jobs = std::thread::cpu_count();
    // Passed on to the processes testing one path each.
    let mut pass: Vec<String> = Vec::new();
    let mut i = 0;
    while i < args.len() {
        match args[i].as_str() {
            "--" => {
                // The test programs' own options (as cargo test -- ...).
                while i + 1 < args.len() {
                    HARNESS_ARGS.push(args[i + 1].clone());
                    i += 1;
                }
            }
            "--release" => { eprintln(RELEASE_GONE); return 2; }
            "-timings" => TIMINGS = true,
            "--no-run" => {
                no_run = true;
                pass.push(args[i].clone());
            }
            "-p" if i + 1 < args.len() => {
                package = args[i + 1].clone();
                pass.push(args[i].clone());
                pass.push(args[i + 1].clone());
                i += 1;
            }
            "-j" | "--jobs" if i + 1 < args.len() => {
                jobs = match args[i + 1].parse::<usize>() {
                    Ok(n) if n > 0 => n,
                    _ => { eprintln(`${args[i]}: not a positive number: ${args[i + 1]}`); return 2; }
                };
                i += 1;
            }
            "--target" if i + 1 < args.len() => {
                if !set_target(args[i + 1].as_str()) {
                    eprintln(`navi: unknown target ${args[i + 1]} (${known_targets()})`);
                    return 2;
                }
                pass.push(args[i].clone());
                pass.push(args[i + 1].clone());
                i += 1;
            }
            "--var" if i + 1 < args.len() => {
                if !add_var(args[i + 1].as_str()) { return 2; }
                pass.push(args[i].clone());
                pass.push(args[i + 1].clone());
                i += 1;
            }
            "--linker" if i + 1 < args.len() => {
                if !set_linker(args[i + 1].as_str()) { return 2; }
                pass.push(args[i].clone());
                pass.push(args[i + 1].clone());
                i += 1;
            }
            "-timeout" if i + 1 < args.len() => {
                TIMEOUT_NS = match parse_duration(args[i + 1].as_str()) {
                    Some(n) => n,
                    None => { eprintln(`-timeout: not a duration (as 90s, 10m or 1h30m): ${args[i + 1]}`); return 2; }
                };
                TIMEOUT_TEXT = args[i + 1].clone();
                pass.push(args[i].clone());
                pass.push(args[i + 1].clone());
                i += 1;
            }
            _ => rest.push(args[i].clone()),
        }
        i += 1;
    }
    let mut paths: Vec<String> = Vec::new();
    let mut filter = String::new();
    for (k, a) in rest.iter().enumerate() {
        if k > 0 && k + 1 == rest.len() && !Path::new(a.as_str()).exists() { filter = a.clone(); } else { paths.push(a.clone()); }
    }
    if paths.len() == 0 { paths.push(".".to_string()); }
    if filter.len() > 0 { pass.push(filter.clone()); }
    if HARNESS_ARGS.len() > 0 {
        pass.push("--".to_string());
        for a in HARNESS_ARGS.iter() { pass.push(a.clone()); }
    }
    // (With -j 1 too: a process each, as go test -p 1; one navi building
    // every path in turn holds what it read of all.)
    if paths.len() > 1 && !bench { return test_parallel(&paths, &pass, jobs); }
    let mut code = 0;
    for path in paths.iter() {
        let c = test_path(path.as_str(), package.as_str(), filter.as_str(), bench, no_run);
        if c != 0 { code = c; }
    }
    code
}

// The nanoseconds of a duration as go test's -timeout takes it: numbers
// each with a unit (ms, s, m or h), as 90s or 1h30m.
fn parse_duration(s: &str) -> Option<u64> {
    let b = s.as_bytes();
    let mut total: u64 = 0;
    let mut i = 0;
    if b.len() == 0 { return None; }
    if s == "0" { return Some(0); }
    while i < b.len() {
        let start = i;
        while i < b.len() && b[i] >= b'0' && b[i] <= b'9' { i += 1; }
        if i == start { return None; }
        let n = match s[start..i].parse::<u64>() { Ok(n) => n, Err(_) => return None };
        let u = i;
        while i < b.len() && (b[i] < b'0' || b[i] > b'9') { i += 1; }
        let unit: u64 = match &s[u..i] {
            "ms" => 1000000,
            "s" => 1000000000,
            "m" => 60000000000,
            "h" => 3600000000000,
            _ => return None,
        };
        total += n * unit;
    }
    Some(total)
}

// Tests each of paths with "navi test path pass..." in a process of its
// own, jobs at a time; prints each one's output (stdout and stderr in one
// file, in the order written) when it and those before it have ended.
fn test_parallel(paths: &Vec<String>, pass: &Vec<String>, jobs: usize) -> i32 {
    let me = match exe_path() {
        Some(p) => p,
        None => { eprintln("navi test: cannot find navi's own path"); return 1; }
    };
    let dir = util::path_join(std::env::temp_dir().to_str().unwrap(), `navi-tests-${std::process::id()}`.to_string().as_str());
    if let Err(e) = std::fs::create_dir_all(dir.as_str()) {
        eprintln(`${dir}: ${e}`);
        return 1;
    }
    let (work_tx, work_rx) = std::sync::mpmc::channel::<usize>();
    for i in 0..paths.len() { let _ = work_tx.send(i); }
    work_tx.close();
    // (Each one's exit code and how it ended: "exit N", or the signal.)
    let (done_tx, done_rx) = std::sync::mpmc::channel::<(usize, i32, String, String, f64)>();
    let n = if jobs < paths.len() { jobs } else { paths.len() };
    for _ in 0..n {
        std::thread::spawn(|| {
            for i in work_rx.iter() {
                let out = util::path_join(dir.as_str(), `${i}.out`.to_string().as_str());
                let start = std::time::Instant::now();
                let mut how = String::new();
                let code = match std::fs::File::create(out.as_str()) {
                    Ok(f) => {
                        let mut cmd = std::process::Command::new(me.as_str());
                        cmd.arg("test").arg(paths[i].as_str());
                        // (The -d switches main took out.)
                        for a in crate::dflags::args().iter() { cmd.arg(a.as_str()); }
                        for a in pass.iter() { cmd.arg(a.as_str()); }
                        cmd.stdin(std::process::Stdio::null());
                        cmd.stdout(f);
                        cmd.stderr(f);
                        // (-timeout bounds the test programs; navi itself,
                        // building them, is killed after twice that and a
                        // minute: a hung build must not hang every path.)
                        let limit = if TIMEOUT_NS > 0 { 2 * TIMEOUT_NS + 60000000000 } else { 0 };
                        let c = match run_child(&mut cmd, limit) {
                            Ok((s, killed)) => {
                                how = if killed { `killed after ${limit / 1000000000}s`.to_string() } else { `${s}`.to_string() };
                                match s.code() { Some(c) if !killed => c, _ => 1 }
                            }
                            Err(e) => { eprintln(`${me}: ${e}`); 1 }
                        };
                        let mut f2 = f;
                        f2.close();
                        c
                    }
                    Err(e) => { eprintln(`${out}: ${e}`); 1 }
                };
                let text = match std::fs::read_to_string(out.as_str()) { Ok(t) => t, Err(_) => String::new() };
                let _ = std::fs::remove_file(out.as_str());
                let _ = done_tx.send((i, code, text, how, start.elapsed().as_secs_f64()));
            }
        });
    }
    let mut results: Vec<Option<(i32, String, String, f64)>> = Vec::new();
    for _ in 0..paths.len() { results.push(None); }
    let mut shown = 0;
    let mut code = 0;
    for _ in 0..paths.len() {
        let (i, c, text, how, secs) = match done_rx.recv() { Ok(r) => r, Err(_) => break };
        results[i] = Some((c, text, how, secs));
        while shown < paths.len() {
            let (c, text, how, secs) = match &results[shown] { Some(r) => r.clone(), None => break };
            let t = text.trim_end();
            if c == 0 {
                let last = match t.rfind('\n') { Some(k) => &t[k + 1..], None => t };
                println(`ok   ${paths[shown]} (${last}; ${secs:.2}s)`);
            } else {
                if t.len() > 0 { println(t); }
                println(`FAIL ${paths[shown]} (${how}; ${secs:.2}s)`);
                code = 1;
            }
            shown += 1;
        }
    }
    let _ = std::fs::remove_dir(dir.as_str());
    code
}

// navi test on one path (a file or a project's directory).
fn test_path(path_s: &str, package: &str, filter_s: &str, bench: bool, no_run: bool) -> i32 {
    let path = path_s.to_string();
    let filter = filter_s.to_string();
    let us = match units(path.as_str(), package) {
        Ok(u) => u,
        Err(e) => { eprintln(e); return 1; }
    };
    let mut code = 0;
    for u in us.iter() {
        let mut env: Vec<(String, String)> = Vec::new();
        if let Some(p) = exe_path() { env.push(("NAVI".to_string(), p)); }
        let label = match u.member { Some(m) => `unit tests ${util::path_join(u.rel.as_str(), m.root.as_str())}`.to_string(), None => u.root.clone() };
        let c = run_harness(u.specs.clone(), u.name.as_str(), label.as_str(), filter.as_str(), bench, &env, u.member.is_some(), no_run);
        if c != 0 { code = c; }
        if bench { continue; }
        let m = match u.member { Some(m) => m, None => continue };
        let files = test_files(m.dir.as_str());
        if files.len() == 0 { continue; }
        // The program for NAVI_BIN_EXE_name.
        if m.is_bin() {
            let f = &BuildFlags { out: String::new(), package: String::new(), strip: false, obj_only: false, force: false };
            match build_unit(*u, f) {
                Ok(out) => env.push((`NAVI_BIN_EXE_${m.manifest.name}`.to_string(), out)),
                Err(e) => {
                    if e.len() > 0 { eprintln(e); }
                    code = 1;
                    continue;
                }
            }
        }
        for file in files.iter() {
            let stem = util::path_base(file.as_str());
            let name = crate_name(&stem[0..stem.len() - 5]);
            let mut specs: Vec<&CrateSpec> = Vec::new();
            let mut deps: Vec<String> = Vec::new();
            for s in u.specs.iter() {
                // The crate itself only as a library; its dependencies too.
                if s.name == u.name && !m.is_bin() { deps.push(`${u.name}=${u.name}`.to_string()); }
                if s.name == u.name {
                    for d in s.deps.iter() { deps.push(d.clone()); }
                    if m.is_bin() { continue; }
                }
                specs.push(*s);
            }
            let tests_dir = util::path_join(m.dir.as_str(), "tests");
            // (An integration test's package is the crate's.)
            note_package(name.as_str(), m.manifest);
            specs.push(&CrateSpec { name: name.clone(), fs_root: tests_dir.clone(), root: stem.clone(), deps, dir: tests_dir });
            let c = run_harness(specs, name.as_str(), util::path_join(u.rel.as_str(), `tests/${stem}`.to_string().as_str()).as_str(), filter.as_str(), false, &env, true, no_run);
            if c != 0 { code = c; }
        }
    }
    code
}

// The .navi files of dir/tests (integration tests), sorted.
fn test_files(dir: &str) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let t = util::path_join(dir, "tests");
    if let Ok(rd) = std::fs::read_dir(t.as_str()) {
        for e in rd {
            if let Ok(e) = e {
                let n = e.file_name();
                if n.ends_with(".navi") { out.push(util::path_join(t.as_str(), n.as_str())); }
            }
        }
    }
    out.sort();
    out
}

// Builds the harness of crate name (the last of specs) and runs it with
// filter and env; its exit code. label names it in "Running" (on stderr,
// as Cargo's), printed for a project's crates. no_run: only built, its
// path printed ("Executable label (path)").
fn run_harness(specs: Vec<&CrateSpec>, name: &str, label: &str, filter: &str, bench: bool, env: &Vec<(String, String)>, announce: bool, no_run: bool) -> i32 {
    let attr = if bench { "bench" } else { "test" };
    let ext = if target_os() == "windows" { ".exe" } else { "" };
    // The executable's name is the same every time (a Mach-O executable's
    // code signature names it, and a cached one is reused as it is); a
    // directory of the process's own keeps runs apart.
    let tmp = std::env::temp_dir().to_str().unwrap().to_string();
    let dir = if no_run { tmp.clone() } else { util::path_join(tmp.as_str(), `navi-${attr}-${std::process::id()}`.to_string().as_str()) };
    if let Err(e) = std::fs::create_dir_all(dir.as_str()) {
        eprintln(`${dir}: ${e}`);
        return 1;
    }
    let exe = util::path_join(dir.as_str(), `navi-${attr}-${name}${ext}`.to_string().as_str());
    let mut opts = `harness ${attr} target=${target_name()} name=${util::path_base(exe.as_str())}`.to_string();
    for s in specs.iter() { opts.push_str(`\n${s.name} ${s.fs_root} ${s.root} ${s.deps:?}`.to_string().as_str()); }
    let last = specs[specs.len() - 1];
    let key = crate::cache::key(opts.as_str(), util::path_join(last.fs_root.as_str(), last.root.as_str()).as_str());
    let cached = match &key {
        Some(k) => crate::cache::lookup(k.as_str(), exe.as_str()),
        None => false,
    };
    if cached {
        chmod_x(exe.as_str());
        phase("cached");
    } else {
        let c = build_harness(specs, name, bench, exe.as_str(), key);
        if c != 0 { return c; }
    }
    if no_run {
        eprintln(`  Executable ${label} (${exe})`);
        return 0;
    }
    if announce { eprintln(`     Running ${label}`); }
    let mut cmd = std::process::Command::new(exe.as_str());
    if filter.len() > 0 { cmd.arg(filter); }
    for a in HARNESS_ARGS.iter() { cmd.arg(a.as_str()); }
    // The tests can build programs with navi (as Cargo sets CARGO).
    for (k, v) in env.iter() { cmd.env(k.as_str(), v.as_str()); }
    // The program reports a timeout itself (what runs); killed if it hangs.
    if TIMEOUT_NS > 0 { cmd.arg(`--timeout=${TIMEOUT_NS}ns`.to_string().as_str()); }
    let code = run_timed(&mut cmd, label);
    let _ = std::fs::remove_file(exe.as_str());
    let _ = std::fs::remove_dir(dir.as_str());
    code
}

// Runs cmd to its end, killing it after TIMEOUT_NS (as go test's -timeout);
// its exit code.
fn run_timed(cmd: &mut std::process::Command, label: &str) -> i32 {
    let mut child = match cmd.spawn() {
        Ok(c) => c,
        Err(e) => {
            eprintln(`${label}: ${e}`);
            return 1;
        }
    };
    let mut done = false;
    let mut timed_out = false;
    // (Later than the program's own report.)
    let ns = if TIMEOUT_NS > 0 { TIMEOUT_NS + 30000000000 } else { 0 };
    if ns > 0 {
        let victim = child;
        std::thread::spawn(|| {
            std::thread::sleep(std::time::Duration::from_nanos(ns));
            if !done {
                timed_out = true;
                let mut c = victim;
                let _ = c.kill();
            }
        });
    }
    let st = child.wait();
    done = true;
    if timed_out {
        eprintln(`${label}: timed out after ${TIMEOUT_TEXT}`);
        return 1;
    }
    match st {
        Ok(s) => match s.code() {
            Some(c) => c,
            None => {
                eprintln(`${label}: the test program ended by ${s}`);
                1
            }
        },
        Err(e) => { eprintln(`${label}: ${e}`); 1 }
    }
}

// Runs cmd to its end, killing it after limit nanoseconds (0: none); its
// status and whether it was killed.
fn run_child(cmd: &mut std::process::Command, limit: u64) -> std::io::Result<(std::process::ExitStatus, bool)> {
    let mut child = cmd.spawn()?;
    let mut done = false;
    let mut killed = false;
    if limit > 0 {
        let victim = child;
        std::thread::spawn(|| {
            std::thread::sleep(std::time::Duration::from_nanos(limit));
            if !done {
                killed = true;
                let mut c = victim;
                let _ = c.kill();
            }
        });
    }
    let st = child.wait()?;
    done = true;
    Ok((st, killed))
}

// Checks specs with cfg(test) and builds the harness of crate name's
// #[test] (or #[bench]) functions into exe, cached under key; 0 if built.
fn build_harness(specs: Vec<&CrateSpec>, name: &str, bench: bool, exe: &str, key: Option<String>) -> i32 {
    let mut cfg = host_config();
    cfg.test = true;
    let (info, errs) = check_specs(cfg, &specs);
    let (warnings, failed) = diagnostics(&errs);
    if warnings.len() > 0 { eprintln(warnings); }
    if failed { return 1; }
    let attr = if bench { "bench" } else { "test" };
    let mut fns: Vec<&mut resolve::Def> = Vec::new();
    for d in info.res.defs.iter() {
        if d.krate.name != name || d.kind != resolve::DEF_FN { continue; }
        if let resolve::Node::Item(crate::syntax::ast::Item::Fn(fd)) = &d.node {
            if !types::collect::has_attr(&fd.base.attrs, attr) { continue; }
            let sig = info.fn_sig_of(*d);
            let ok_params = sig.params.len() == 0 || bench && sig.params.len() == 1 && sig.params[0].kind == types::K_REF;
            if sig.generics.params.len() > 0 || !ok_params || sig.ret.kind != types::K_TUPLE || sig.ret.elems.len() != 0 {
                let what = if bench { "fn() or fn(&mut Bencher)" } else { "fn()" };
                eprintln(`${crate::mir::harness::test_name(*d)}: a #[${attr}] function must be ${what}`);
                return 1;
            }
            if let Err(e) = crate::mir::harness::panic_spec(*d) {
                eprintln(e);
                return 1;
            }
            fns.push(*d);
        }
    }
    let entry = &Entry { main: None, tests: fns, bench };
    if let Err(e) = native(info, entry, exe, true) {
        eprintln(e);
        return 1;
    }
    if let Some(k) = key { crate::cache::store(k.as_str(), exe, warnings.as_str()); }
    0
}

/// navi update [dir]: resolves the git dependencies' tags again (and
/// fetches them) for the whole project, rewriting navi.lock.
pub fn update_command(args: &Vec<String>) -> i32 {
    let path = if args.len() > 0 { args[0].clone() } else { ".".to_string() };
    let p = match crate::project::find(path.as_str()) {
        Ok(p) => p,
        Err(e) => { eprintln(e); return 1; }
    };
    match crate::deps::load_project(p, false, true) {
        Ok(_) => 0,
        Err(e) => {
            eprintln(e);
            1
        }
    }
}
