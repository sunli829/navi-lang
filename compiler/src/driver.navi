//! The compiler driver: crates from command-line paths, the std crate,
//! and the phases.

use crate::resolve::{self, CrateSpec, Config};
use crate::util;
use std::path::Path;

/// The #[cfg] settings for the host.
pub fn host_config() -> Config {
    Config { target_os: host_os().to_string(), target_arch: host_arch().to_string(), test: false, debug: true }
}

#[cfg(target_os = "macos")]
fn host_os() -> &str { "macos" }
#[cfg(target_os = "linux")]
fn host_os() -> &str { "linux" }
#[cfg(target_os = "windows")]
fn host_os() -> &str { "windows" }
#[cfg(target_arch = "aarch64")]
fn host_arch() -> &str { "aarch64" }
#[cfg(target_arch = "x86_64")]
fn host_arch() -> &str { "x86_64" }

/// The std crate, read from $NAVI_STD (default lib/std).
pub fn std_crate() -> &CrateSpec {
    let dir = match std::env::var("NAVI_STD") { Ok(d) => d, Err(_) => "lib/std".to_string() };
    &CrateSpec { name: "std".to_string(), fs_root: dir, root: "src/lib.navi".to_string(), deps: Vec::new(), dir: String::new() }
}

fn crate_name(s: &str) -> String { s.replace('-', "_") }

/// The crate at path: a directory with src/main.navi or src/lib.navi, or a
/// single .navi file.
pub fn load_crate(path: &str) -> Result<&CrateSpec, String> {
    let p = Path::new(path);
    if !p.exists() { return Err(`stat ${path}: no such file or directory`); }
    if !p.is_dir() {
        if !path.ends_with(".navi") { return Err(`${path}: not a .navi file or a crate directory`); }
        let base = util::path_base(path);
        let name = crate_name(&base[0..base.len() - 5]);
        let dir = util::path_dir(path);
        return Ok(&CrateSpec { name, fs_root: dir.clone(), root: base, deps: Vec::new(), dir });
    }
    let mut name = util::path_base(util::path_clean(path).as_str());
    if let Ok(manifest) = std::fs::read_to_string(util::path_join(path, "navi.toml")) {
        let n = package_name(manifest.as_str());
        if n.len() > 0 { name = n; }
    }
    for root in ["src/main.navi", "src/lib.navi"].iter() {
        if Path::new(util::path_join(path, *root).as_str()).exists() {
            return Ok(&CrateSpec { name: crate_name(name.as_str()), fs_root: path.to_string(), root: root.to_string(), deps: Vec::new(), dir: path.to_string() });
        }
    }
    Err(`${path}: no src/main.navi or src/lib.navi`)
}

// package_name reads name = "..." from the [package] table of navi.toml.
fn package_name(manifest: &str) -> String {
    let mut in_package = false;
    for raw in manifest.lines() {
        let line = raw.trim();
        if line.starts_with("[") {
            in_package = line == "[package]";
            continue;
        }
        if !in_package { continue; }
        if let Some((k, v)) = line.split_once('=') {
            if k.trim() == "name" { return v.trim().trim_matches('"').to_string(); }
        }
    }
    String::new()
}
