//! The compiler driver: crates from command-line paths, the std crate,
//! and the phases.

use crate::resolve::{self, CrateSpec, Config};
use crate::util;
use crate::diag::{Sink, Error};
use crate::types;
use std::path::Path;

/// The targets: os-arch.
fn target_by_id(i: i64) -> &str {
    match i {
        0 => "macos-arm64",
        1 => "macos-x64",
        2 => "linux-x64",
        3 => "linux-arm64",
        4 => "windows-x64",
        _ => "",
    }
}

/// The target (an index of target_by_id): --target, else $NAVI_TARGET,
/// else the host.
static mut TARGET_ID: i64 = -1;

/// Selects the target by name; false if there is no such target.
pub fn set_target(name: &str) -> bool {
    let mut i = 0;
    while target_by_id(i).len() > 0 {
        if target_by_id(i) == name {
            TARGET_ID = i;
            return true;
        }
        i += 1;
    }
    false
}

/// The target's name (os-arch).
pub fn target_name() -> String {
    if TARGET_ID < 0 {
        let host = `${host_os()}-${if host_arch() == "aarch64" { "arm64" } else { "x64" }}`.to_string();
        let want = match std::env::var("NAVI_TARGET") { Ok(t) => t, Err(_) => host };
        if !set_target(want.as_str()) {
            eprintln(`navi: unknown target ${want} (${known_targets()})`);
            std::process::exit(2);
        }
    }
    target_by_id(TARGET_ID).to_string()
}

pub fn known_targets() -> String {
    let mut out: Vec<String> = Vec::new();
    let mut i = 0;
    while target_by_id(i).len() > 0 {
        out.push(target_by_id(i).to_string());
        i += 1;
    }
    out.join(", ")
}

/// The target's OS: macos, linux or windows.
pub fn target_os() -> String {
    let t = target_name();
    t[0..t.find('-').unwrap()].to_string()
}

/// The target's architecture as objects name it: arm64 or amd64.
pub fn target_arch() -> String {
    if target_name().ends_with("-arm64") { "arm64".to_string() } else { "amd64".to_string() }
}

/// The #[cfg] settings for the target.
pub fn host_config() -> Config {
    let arch = if target_arch() == "arm64" { "aarch64" } else { "x86_64" };
    Config { target_os: target_os(), target_arch: arch.to_string(), test: false }
}

#[cfg(target_os = "macos")]
fn host_os() -> &str { "macos" }
#[cfg(target_os = "linux")]
fn host_os() -> &str { "linux" }
#[cfg(target_os = "windows")]
fn host_os() -> &str { "windows" }
#[cfg(target_arch = "aarch64")]
fn host_arch() -> &str { "aarch64" }
#[cfg(target_arch = "x86_64")]
fn host_arch() -> &str { "x86_64" }

/// The std crate, read from $NAVI_STD (default: see default_std).
pub fn std_crate() -> &CrateSpec {
    let dir = match std::env::var("NAVI_STD") { Ok(d) => d, Err(_) => default_std() };
    if !Path::new(util::path_join(dir.as_str(), "src/lib.navi").as_str()).exists() {
        eprintln(`navi: the standard library is not at ${dir} (set NAVI_STD)`);
        std::process::exit(2);
    }
    &CrateSpec { name: "std".to_string(), fs_root: dir, root: "src/lib.navi".to_string(), deps: Vec::new(), dir: String::new() }
}

/// Where std is without NAVI_STD: lib/std next to the directory holding
/// navi's executable (a release unpacks to bin/navi and lib/std; as Go
/// finds GOROOT from its binary), else lib/std in the current directory (a
/// checkout of the repository).
fn default_std() -> String {
    if let Some(exe) = exe_path() {
        let root = util::path_dir(util::path_dir(util::path_clean(exe.as_str()).as_str()).as_str());
        let d = util::path_join(root.as_str(), "lib/std");
        if Path::new(util::path_join(d.as_str(), "src/lib.navi").as_str()).exists() { return d; }
    }
    "lib/std".to_string()
}

// The running executable, symbolic links resolved (a link in a bin
// directory still finds std).
fn exe_path() -> Option<String> {
    let p = std::env::current_exe().ok()?;
    let c = match std::fs::canonicalize(&p) { Ok(c) => c, Err(_) => p };
    Some(util::without_verbatim(c.to_str()?))
}
fn crate_name(s: &str) -> String { s.replace('-', "_") }

/// The crate at path: a directory with src/main.navi or src/lib.navi, or a
/// single .navi file.
pub fn load_crate(path: &str) -> Result<&mut CrateSpec, String> {
    let p = Path::new(path);
    if !p.exists() { return Err(`stat ${path}: no such file or directory`.to_string()); }
    if !p.is_dir() {
        if !path.ends_with(".navi") { return Err(`${path}: not a .navi file or a crate directory`.to_string()); }
        let base = util::path_base(path);
        let name = crate_name(&base[0..base.len() - 5]);
        let dir = util::path_dir(path);
        return Ok(&mut CrateSpec { name, fs_root: dir.clone(), root: base, deps: Vec::new(), dir });
    }
    let mut name = util::path_base(util::path_clean(path).as_str());
    let toml = util::path_join(path, "navi.toml");
    if let Ok(manifest) = std::fs::read_to_string(toml.as_str()) {
        crate::cache::note(toml.as_str(), &manifest);
        let n = package_name(manifest.as_str());
        if n.len() > 0 { name = n; }
    }
    for root in ["src/main.navi", "src/lib.navi"].iter() {
        if Path::new(util::path_join(path, *root).as_str()).exists() {
            return Ok(&mut CrateSpec { name: crate_name(name.as_str()), fs_root: path.to_string(), root: root.to_string(), deps: Vec::new(), dir: path.to_string() });
        }
    }
    Err(`${path}: no src/main.navi or src/lib.navi`.to_string())
}

// package_name reads name = "..." from the [package] table of navi.toml.
fn package_name(manifest: &str) -> String {
    let mut in_package = false;
    for raw in manifest.lines() {
        let line = raw.trim();
        if line.starts_with("[") {
            in_package = line == "[package]";
            continue;
        }
        if !in_package { continue; }
        if let Some((k, v)) = line.split_once('=') {
            if k.trim() == "name" { return v.trim().trim_matches('"').to_string(); }
        }
    }
    String::new()
}

static mut TIMINGS: bool = false;
static mut PHASE_START: u64 = 0;
static mut PHASE_CPU: u64 = 0;

/// Prints the time since the previous phase ended (with -timings), and the
/// CPU time of all threads in it.
pub fn phase(name: &str) {
    let t = crate::driver::now_nanos();
    let c = cpu_nanos();
    if TIMINGS && PHASE_START != 0 {
        let ms = (t - PHASE_START) / 1000000;
        let cpu = (c - PHASE_CPU) / 1000000;
        let gs = std::gc::stats();
        eprintln(`  ${name}: ${ms} ms (cpu ${cpu} ms, gc ${gs.collections}, live ${gs.live_bytes >> 20} MiB)`);
    }
    PHASE_START = t;
    PHASE_CPU = c;
}

#[cfg(target_os = "macos")]
extern "C" {
    fn clock_gettime_nsec_np(clock: u32) -> u64;
}

#[cfg(target_os = "macos")]
fn cpu_nanos() -> u64 { unsafe { clock_gettime_nsec_np(12) } } // CLOCK_PROCESS_CPUTIME_ID
#[cfg(not(target_os = "macos"))]
fn cpu_nanos() -> u64 { 0 }

pub fn now_nanos() -> u64 {
    let d = std::time::Instant::now().duration_since(START.clone());
    d.as_nanos() as u64 + 1
}

static START: std::time::Instant = std::time::Instant::now();

/// Runs the front end over the given crates.
pub fn check_specs(cfg: Config, specs: &Vec<&CrateSpec>) -> (&mut types::collect::Info, Vec<Error>) {
    phase("start");
    let (res, rerrs) = resolve::resolve(cfg, specs);
    phase("parse+resolve");
    let sink = Sink::new();
    for e in rerrs.iter() { sink.add(e.clone()); }
    let info = types::collect::collect(res, sink);
    phase("types");
    (info, sink.sorted())
}

/// The diagnostics to print (std's warnings left out); whether there are
/// errors.
pub fn diagnostics(errs: &Vec<Error>) -> (String, bool) {
    let mut lines: Vec<String> = Vec::new();
    let mut failed = false;
    for e in errs.iter() {
        if e.warning && e.pos.file.starts_with("std/") { continue; }
        if !e.warning { failed = true; }
        lines.push(`${e}`.to_string());
    }
    (lines.join("\n"), failed)
}

/// Prints the diagnostics; whether there are errors.
pub fn report(errs: &Vec<Error>) -> bool {
    let (text, failed) = diagnostics(errs);
    if text.len() > 0 { eprintln(text); }
    failed
}

/// The main function of the crate named name.
pub fn find_main(info: &types::collect::Info, name: &str) -> Option<&mut resolve::Def> {
    for c in info.res.crates.iter() {
        if c.name != name { continue; }
        if let Some(b) = c.root.unwrap().lookup("main", resolve::VALUE_NS) {
            if let Some(d) = b.res.def {
                if d.kind == resolve::DEF_FN { return Some(d); }
            }
        }
    }
    None
}

/// What an executable runs: main, or the harness of navi test / bench.
pub struct Entry {
    pub main: Option<&mut resolve::Def>,
    pub tests: Vec<&mut resolve::Def>,
    pub bench: bool,
}

pub fn main_entry(main: &mut resolve::Def) -> &Entry { &Entry { main: Some(main), tests: Vec::new(), bench: false } }

/// Compiles a checked program into the object model for the target.
pub fn code(info: &mut types::collect::Info, entry: &Entry, dwarf: bool) -> Result<&mut crate::obj::Object, String> {
    let mut roots: Vec<&mut resolve::Def> = Vec::new();
    match entry.main {
        Some(m) => roots.push(m),
        None => { for t in entry.tests.iter() { roots.push(*t); } }
    }
    let prog = crate::mir::build::build_program(info, Some(roots));
    // Errors in std bodies checked on first use (while building the MIR):
    // the program had none before.
    if let Some(c) = info.c {
        let mut lines: Vec<String> = Vec::new();
        for e in c.errs.sorted().iter() {
            if !e.warning { lines.push(`${e}`.to_string()); }
        }
        if lines.len() > 0 { return Err(lines.join("\n")); }
    }
    let mf = match entry.main {
        Some(m) => prog.func(m).unwrap(),
        None => crate::mir::harness::harness(prog, &entry.tests, entry.bench),
    };
    phase("mir");
    let plan = crate::codegen::build_plan(prog, entry.main, mf);
    phase("plan");
    let os = target_os();
    let arm = target_arch() == "arm64";
    let tgt = crate::backend::lower::TargetConv {
        c_prefix: if os == "macos" { "_".to_string() } else { String::new() },
        write: if os == "windows" { "_write".to_string() } else { "write".to_string() },
        os: os.clone(),
        num_saved: if arm { 9 } else { 2 },
        code_unit: if arm { 4 } else { 1 },
    };
    let o = if arm {
        // NAVI_LLSC=1 tests linux-arm64's atomics on macOS.
        if os == "macos" && std::env::var("NAVI_LLSC").is_err() {
            crate::backend::lower::generate(plan, "arm64", || -> &mut dyn crate::backend::machine::Machine { crate::backend::arm64::new_machine(true, os == "macos") }, tgt, dwarf)
        } else {
            crate::backend::lower::generate(plan, "arm64", || -> &mut dyn crate::backend::machine::Machine { crate::backend::arm64::new_machine(false, os == "macos") }, tgt, dwarf)
        }
    } else if os == "windows" {
        crate::backend::lower::generate(plan, "amd64", || -> &mut dyn crate::backend::machine::Machine { crate::backend::amd64::new_machine(true) }, tgt, dwarf)
    } else {
        crate::backend::lower::generate(plan, "amd64", || -> &mut dyn crate::backend::machine::Machine { crate::backend::amd64::new_machine(false) }, tgt, dwarf)
    };
    phase("codegen");
    o
}

/// Compiles a checked program into an object file for the target.
pub fn object(info: &mut types::collect::Info, entry: &Entry, dwarf: bool) -> Result<Vec<u8>, String> {
    let o = code(info, entry, dwarf)?;
    let os = target_os();
    if os == "macos" { return crate::macho::write(o); }
    if os == "linux" { return crate::elf::write(o); }
    crate::coff::write(o)
}

/// Compiles a checked program into the executable out with navi's own
/// linker (NAVI_LINKER=cc, and targets it does not handle, use the system
/// linker instead).
pub fn native(info: &mut types::collect::Info, entry: &Entry, out: &str, dwarf: bool) -> Result<(), String> {
    let use_cc = match std::env::var("NAVI_LINKER") { Ok(v) => v == "cc", Err(_) => false };
    let os = target_os();
    if !use_cc {
        let o = code(info, entry, dwarf)?;
        let exe = if os == "macos" { crate::link::link(o, util::path_base(out).as_str())? }
            else if os == "linux" { crate::elflink::link(o)? }
            else { crate::pelink::link(o)? };
        if let Err(e) = write_new(out, exe.as_slice()) { return Err(`${e}`.to_string()); }
        phase("link");
        chmod_x(out);
        return Ok(());
    }
    let o = code(info, entry, dwarf)?;
    let libs = o.libraries();
    let data = if os == "macos" { crate::macho::write(o)? } else if os == "linux" { crate::elf::write(o)? } else { crate::coff::write(o)? };
    let obj_path = if os == "windows" { `${out}.navi.obj`.to_string() } else { `${out}.navi.o`.to_string() };
    if let Err(e) = std::fs::write(obj_path.as_str(), data.as_slice()) { return Err(`${e}`.to_string()); }
    let _ = std::fs::remove_file(out);
    let mut cmd = std::process::Command::new(if os == "windows" { "clang" } else { "cc" });
    if os == "macos" { cmd.arg("-arch").arg(if target_arch() == "arm64" { "arm64" } else { "x86_64" }); }
    cmd.arg("-o").arg(out).arg(obj_path.as_str());
    if os == "linux" { cmd.arg("-lm"); }
    // The libraries of #[link].
    for l in libs.iter() {
        let (kind, name) = match l.split_once(':') { Some(p) => p, None => ("dylib", l.as_str()) };
        if kind == "framework" {
            cmd.arg("-framework").arg(name);
        } else if name.contains('/') || name.contains(".so") || name.ends_with(".dll") {
            cmd.arg(name);
        } else {
            let flag = `-l${name}`.to_string();
            cmd.arg(flag.as_str());
        }
    }
    let st = cmd.status();
    let _ = std::fs::remove_file(obj_path.as_str());
    phase("link");
    match st {
        Ok(s) => if s.success() { Ok(()) } else { Err(`link: cc exited with status ${s.code().unwrap()}`.to_string()) },
        Err(e) => Err(`link: ${e}`.to_string()),
    }
}

// Builds before 0.0.3 had a --release mode.
const RELEASE_GONE: &str = "navi: there is no --release: navi has one build mode (as Go), with overflow always checked; -s leaves out the debugging information";

/// navi build [-o output] [-s] [-c] [-a] [-timings] <crate or file>
///
/// There is one build mode (as Go): overflow is always checked. -s leaves
/// out the debugging information (DWARF; as Go's -ldflags=-s); -c writes an
/// object file; -a rebuilds even if the build cache has the output.
pub fn build_command(args: &Vec<String>) -> i32 {
    let mut out = String::new();
    let mut strip = false;
    let mut obj_only = false;
    let mut force = false;
    let mut paths: Vec<String> = Vec::new();
    let mut i = 0;
    while i < args.len() {
        match args[i].as_str() {
            "-o" => {
                if i + 1 < args.len() {
                    out = args[i + 1].clone();
                    i += 1;
                }
            }
            "-s" => strip = true,
            "--release" => { eprintln(RELEASE_GONE); return 2; }
            "-c" => obj_only = true,
            "-timings" => TIMINGS = true,
            "-a" => force = true,
            "--target" => {
                if i + 1 < args.len() {
                    if !set_target(args[i + 1].as_str()) {
                        eprintln(`navi: unknown target ${args[i + 1]} (${known_targets()})`);
                        return 2;
                    }
                    i += 1;
                }
            }
            _ => paths.push(args[i].clone()),
        }
        i += 1;
    }
    if paths.len() != 1 {
        eprintln("usage: navi build [-o output] [-s] [--target os-arch] [-c] [-a] [-timings] <crate or file>");
        return 2;
    }
    let spec = match load_crate(paths[0].as_str()) {
        Ok(s) => s,
        Err(e) => { eprintln(e); return 1; }
    };
    if out.len() == 0 {
        let win = target_os() == "windows";
        out = if obj_only { `${spec.name}.${if win { "obj" } else { "o" }}`.to_string() } else if win { `${spec.name}.exe`.to_string() } else { spec.name.clone() };
    }
    // The output's name is in a Mach-O executable (its code signature's
    // identifier).
    let key = crate::cache::key(`${if obj_only { "obj" } else { "exe" }} strip=${strip} target=${target_name()} name=${util::path_base(out.as_str())}`.to_string().as_str(), paths[0].as_str());
    if let Some(k) = key {
        if !force && crate::cache::lookup(k.as_str(), out.as_str()) {
            if !obj_only { chmod_x(out.as_str()); }
            phase("cached");
            return 0;
        }
    }
    let cfg = host_config();
    let specs = match crate::deps::load_graph(paths[0].as_str(), false, false) {
        Ok(s) => s,
        Err(e) => { eprintln(e); return 1; }
    };
    let (info, errs) = check_specs(cfg, &specs);
    let (warnings, failed) = diagnostics(&errs);
    if warnings.len() > 0 { eprintln(warnings); }
    if failed { return 1; }
    let main = match find_main(info, spec.name.as_str()) {
        Some(m) => m,
        None => { eprintln(`${paths[0]}: no main function`); return 1; }
    };
    if obj_only {
        let r = match object(info, main_entry(main), !strip) {
            Ok(data) => match std::fs::write(out.as_str(), data.as_slice()) { Ok(_) => Ok(()), Err(e) => Err(`${e}`.to_string()) },
            Err(e) => Err(e),
        };
        if let Err(e) = r {
            eprintln(e);
            return 1;
        }
        if let Some(k) = key { crate::cache::store(k.as_str(), out.as_str(), warnings.as_str()); }
        return 0;
    }
    if let Err(e) = native(info, main_entry(main), out.as_str(), !strip) {
        eprintln(e);
        return 1;
    }
    if let Some(k) = key { crate::cache::store(k.as_str(), out.as_str(), warnings.as_str()); }
    0
}

/// Writes a new file at path (removing an old one first: macOS kills a
/// signed executable rewritten in place while its old signature is cached).
pub fn write_new(path: &str, data: &[u8]) -> std::io::Result<()> {
    let _ = std::fs::remove_file(path);
    std::fs::write(path, data)
}

fn chmod_x(path: &str) {
    if host_os() == "windows" { return; }
    let _ = std::process::Command::new("chmod").arg("755").arg(path).status();
}

/// navi test|bench [crate or file] [filter]: builds the
/// #[test] (or #[bench]) functions of the crate with cfg(test) into a
/// harness and runs the ones whose name contains filter.
pub fn test_command(args: &Vec<String>, bench: bool) -> i32 {
    let mut rest: Vec<String> = Vec::new();
    for a in args.iter() {
        match a.as_str() {
            "--release" => { eprintln(RELEASE_GONE); return 2; }
            "-timings" => TIMINGS = true,
            _ => rest.push(a.clone()),
        }
    }
    let path = if rest.len() > 0 { rest[0].clone() } else { ".".to_string() };
    let spec = match load_crate(path.as_str()) {
        Ok(s) => s,
        Err(e) => { eprintln(e); return 1; }
    };
    let mut cfg = host_config();
    cfg.test = true;
    let specs = match crate::deps::load_graph(path.as_str(), false, false) {
        Ok(s) => s,
        Err(e) => { eprintln(e); return 1; }
    };
    let (info, errs) = check_specs(cfg, &specs);
    if report(&errs) { return 1; }
    let attr = if bench { "bench" } else { "test" };
    let mut fns: Vec<&mut resolve::Def> = Vec::new();
    for d in info.res.defs.iter() {
        if d.krate.name != spec.name || d.kind != resolve::DEF_FN { continue; }
        if let resolve::Node::Item(crate::syntax::ast::Item::Fn(fd)) = &d.node {
            if !types::collect::has_attr(&fd.base.attrs, attr) { continue; }
            let sig = info.fn_sig_of(*d);
            let ok_params = sig.params.len() == 0 || bench && sig.params.len() == 1 && sig.params[0].kind == types::K_REF;
            if sig.generics.params.len() > 0 || !ok_params || sig.ret.kind != types::K_TUPLE || sig.ret.elems.len() != 0 {
                let what = if bench { "fn() or fn(&mut Bencher)" } else { "fn()" };
                eprintln(`${crate::mir::harness::test_name(*d)}: a #[${attr}] function must be ${what}`);
                return 1;
            }
            if let Err(e) = crate::mir::harness::panic_spec(*d) {
                eprintln(e);
                return 1;
            }
            fns.push(*d);
        }
    }
    let ext = if target_os() == "windows" { ".exe" } else { "" };
    let exe = util::path_join(std::env::temp_dir().to_str().unwrap(), `navi-${attr}-${spec.name}${ext}`.to_string().as_str());
    let entry = &Entry { main: None, tests: fns, bench };
    if let Err(e) = native(info, entry, exe.as_str(), true) {
        eprintln(e);
        return 1;
    }
    let mut cmd = std::process::Command::new(exe.as_str());
    if rest.len() > 1 { cmd.arg(rest[1].as_str()); }
    // The tests can build programs with navi (as Cargo sets CARGO).
    if let Some(p) = exe_path() { cmd.env("NAVI", p.as_str()); }
    let st = cmd.status();
    let _ = std::fs::remove_file(exe.as_str());
    match st {
        Ok(s) => match s.code() { Some(c) => c, None => 1 },
        Err(e) => { eprintln(`${exe}: ${e}`); 1 }
    }
}

/// navi update [crate]: resolves the git dependencies' tags again (and
/// fetches them), rewriting navi.lock.
pub fn update_command(args: &Vec<String>) -> i32 {
    let path = if args.len() > 0 { args[0].clone() } else { ".".to_string() };
    match crate::deps::load_graph(path.as_str(), false, true) {
        Ok(_) => 0,
        Err(e) => {
            eprintln(e);
            1
        }
    }
}
