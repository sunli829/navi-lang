//! Completion and signature help.

use std::collections::HashMap;
use crate::syntax::source::Pos;
use crate::resolve::*;
use crate::types::{Type, K_ADT, K_REF, K_PTR, K_STR, K_SLICE, K_ARRAY, K_INT, K_FLOAT, K_BOOL, K_CHAR, K_DYN};
use crate::lsp::Server;
use crate::lsp::json::{Json, obj, arr, str, int};
use crate::lsp::analysis::*;
use crate::lsp::index::*;
use crate::lsp::features::*;

const KEYWORDS: [&str; 38] = ["as", "break", "const", "continue", "crate", "defer", "else", "enum", "extern", "false", "fn", "for",
    "if", "impl", "in", "let", "loop", "match", "mod", "mut", "pub", "return", "select", "self", "Self", "static", "struct",
    "super", "trait", "true", "type", "unsafe", "use", "where", "while", "dyn", "i32", "String"];

fn is_word(c: u8) -> bool { c == b'_' || (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9') }

/// The CompletionItemKind of a definition.
fn item_kind(k: DefKind) -> i64 {
    if k == DEF_MOD { 9 }
    else if k == DEF_STRUCT { 22 }
    else if k == DEF_ENUM { 13 }
    else if k == DEF_VARIANT { 20 }
    else if k == DEF_TRAIT { 8 }
    else if k == DEF_TYPE_ALIAS || k == DEF_ASSOC_TYPE { 7 }
    else if k == DEF_FN || k == DEF_EXTERN_FN { 3 }
    else if k == DEF_ASSOC_FN { 2 }
    else if k == DEF_CONST || k == DEF_ASSOC_CONST { 21 }
    else if k == DEF_STATIC || k == DEF_EXTERN_STATIC { 21 }
    else if k == DEF_TYPE_PARAM { 25 }
    else { 1 }
}

// The list being built, without repeated labels.
struct Items {
    out: Json,
    seen: HashMap<String, bool>,
}

impl Items {
    fn add(&mut self, label: &str, kind: i64, detail: String) {
        if label.len() == 0 || self.seen.contains_key(&label.to_string()) { return; }
        self.seen.insert(label.to_string(), true);
        let mut it = obj().set("label", str(label)).set("kind", int(kind));
        if detail.len() > 0 { it = it.set("detail", str(detail.as_str())); }
        self.out = self.out.clone().push(it);
    }
}

impl Analysis {
    fn def_detail(&self, d: &Def) -> String {
        let f = match d.file { Some(f) => f, None => return String::new() };
        let fd = match self.file_of(f) { Some(fd) => fd, None => return String::new() };
        if d.pos < 0 { return String::new(); }
        header(fd.sf.file.src.as_str(), d.pos as usize, d.kind)
    }

    /// The module of a file (its top level).
    pub fn module_of_file(&self, fd: &FileData) -> Option<&mut Module> {
        let info = self.info?;
        for c in info.res.crates.iter() {
            if let Some(r) = c.root {
                if let Some(m) = find_module(r, fd.sf.file.name.as_str()) { return Some(m); }
            }
        }
        None
    }

    fn add_module_names(&self, m: &Module, items: &mut Items) {
        let mut ns = 0;
        while ns < m.bindings.len() {
            for (name, b) in m.bindings[ns].iter() {
                match b.res.def {
                    Some(d) => items.add(name.as_str(), item_kind(d.kind), self.def_detail(d)),
                    None => items.add(name.as_str(), 9, String::new()),
                }
            }
            for (name, bs) in m.globs[ns].iter() {
                if bs.len() == 0 { continue; }
                match bs[0].res.def {
                    Some(d) => items.add(name.as_str(), item_kind(d.kind), self.def_detail(d)),
                    None => items.add(name.as_str(), 9, String::new()),
                }
            }
            ns += 1;
        }
    }

    // The names in a module, type or trait (after Path::).
    fn add_members(&self, d: &Def, items: &mut Items) {
        let info = match self.info { Some(i) => i, None => return };
        if let Some(m) = d.module {
            self.add_module_names(m, items);
            if d.kind == DEF_MOD { return; }
        }
        if d.kind == DEF_ENUM {
            if let Some(adt) = info.adts.get(&d.id) {
                for v in adt.variants.iter() { items.add(v.def.name.as_str(), 20, self.def_detail(v.def)); }
            }
        }
        if d.kind == DEF_TRAIT {
            if let Some(t) = info.traits.get(&d.id) {
                for it in t.order.iter() { items.add(it.name.as_str(), item_kind(it.kind), self.def_detail(*it)); }
            }
            return;
        }
        for (_, im) in info.impls.iter() {
            if im.trait_ref.is_some() { continue; }
            let st = im.self_ty;
            let ok = match st.def { Some(sd) => sd.id == d.id, None => false };
            if !ok { continue; }
            for (name, it) in im.items.iter() { items.add(name.as_str(), item_kind(it.kind), self.def_detail(*it)); }
        }
    }

    // The fields and methods of a value of type t (after value.).
    fn add_methods(&self, t0: &Type, items: &mut Items) {
        let info = match self.info { Some(i) => i, None => return };
        let mut t = t0;
        loop {
            if (t.kind == K_REF || t.kind == K_PTR) && t.elem.is_some() {
                t = t.elem.unwrap();
                continue;
            }
            break;
        }
        if t.kind == K_ADT {
            if let Some(d) = t.def {
                if let Some(adt) = info.adts.get(&d.id) {
                    for f in adt.fields.iter() {
                        items.add(f.name.as_str(), 5, `${f.name}: ${crate::types::type_string(f.ty)}`.to_string());
                    }
                }
            }
        }
        if t.kind == K_DYN {
            for b in t.bounds.iter() {
                let tid = match b.tdef { Some(td) => td.id, None => continue };
                if let Some(ti) = info.traits.get(&tid) {
                    for it in ti.order.iter() { items.add(it.name.as_str(), item_kind(it.kind), self.def_detail(*it)); }
                }
            }
        }
        for (_, im) in info.impls.iter() {
            if !same_head(im.self_ty, t) { continue; }
            for (name, it) in im.items.iter() {
                if it.kind == DEF_ASSOC_FN { items.add(name.as_str(), 2, self.def_detail(*it)); }
            }
            // A trait's provided methods.
            if let Some(tr) = im.trait_ref {
                let tid = match tr.tdef { Some(td) => td.id, None => 0 };
                if let Some(ti) = info.traits.get(&tid) {
                    for it in ti.order.iter() {
                        if it.kind == DEF_ASSOC_FN { items.add(it.name.as_str(), 2, self.def_detail(*it)); }
                    }
                }
            }
        }
    }
}

// Whether an impl's self type is of the same kind as t (the same struct,
// str, slices, the same integer type, ...).
fn same_head(st: &Type, t: &Type) -> bool {
    if st.kind != t.kind { return false; }
    if t.kind == K_ADT {
        return match (st.def, t.def) { (Some(a), Some(b)) => a.id == b.id, _ => false };
    }
    if t.kind == K_INT { return st.int == t.int; }
    if t.kind == K_FLOAT { return st.f64 == t.f64; }
    t.kind == K_STR || t.kind == K_SLICE || t.kind == K_ARRAY || t.kind == K_BOOL || t.kind == K_CHAR
}

fn find_module(m: &mut Module, file: &str) -> Option<&mut Module> {
    if let Some(f) = m.file {
        if f.name == file && !m.anonymous { return Some(m); }
    }
    for c in m.children.iter() {
        if let Some(x) = find_module(*c, file) { return Some(x); }
    }
    None
}

impl Server {
    pub fn completion(&mut self, p: &Json) -> Result<Json, (i64, String)> {
        let at = match self.at(p) { Some(a) => a, None => return Ok(Json::Null) };
        let src = at.fd.sf.file.src.as_str();
        let b = src.as_bytes();
        let off = at.off as usize;
        let mut start = off;
        while start > 0 && is_word(b[start - 1]) { start -= 1; }
        let items = &mut Items { out: arr(), seen: HashMap::new() };
        // value.
        if start > 0 && b[start - 1] == b'.' && !(start > 1 && b[start - 2] == b'.') {
            if let Some(t) = receiver_type(at.idx, src, start - 1) { at.a.add_methods(t, items); }
            return Ok(obj().set("isIncomplete", Json::Bool(false)).set("items", items.out.clone()));
        }
        // a::b::
        if start > 1 && b[start - 1] == b':' && b[start - 2] == b':' {
            let segs = path_before(src, start - 2);
            if let Some(d) = resolve_path(at.a, at.fd, at.idx, &segs, start - 2) { at.a.add_members(d, items); }
            return Ok(obj().set("isIncomplete", Json::Bool(false)).set("items", items.out.clone()));
        }
        // A name: locals of the function, the module's names, the prelude.
        let owner = at.idx.body_at(at.off);
        for r in at.idx.refs.iter() {
            if !r.decl || r.lo as usize >= off { continue; }
            if let Target::Local(l) = &r.target {
                let same = match (r.owner, owner) { (Some(a1), Some(b1)) => a1.id == b1.id, _ => false };
                if !same { continue; }
                let detail = match r.ty { Some(t) => crate::types::type_string(t), None => String::new() };
                items.add(l.name.as_str(), 6, detail);
            }
        }
        if let Some(m) = at.a.module_of_file(at.fd) {
            at.a.add_module_names(m, items);
            if let Some(pm) = m.krate.prelude { at.a.add_module_names(pm, items); }
            // std's prelude for other crates.
            if let Some(info) = at.a.info {
                for c in info.res.crates.iter() {
                    if c.is_std {
                        if let Some(pm) = c.prelude { at.a.add_module_names(pm, items); }
                    }
                }
            }
        }
        for k in KEYWORDS.iter() { items.add(*k, 14, String::new()); }
        Ok(obj().set("isIncomplete", Json::Bool(false)).set("items", items.out.clone()))
    }

    pub fn signature_help(&mut self, p: &Json) -> Result<Json, (i64, String)> {
        let at = match self.at(p) { Some(a) => a, None => return Ok(Json::Null) };
        let src = at.fd.sf.file.src.as_str();
        let b = src.as_bytes();
        // The ( of the call the cursor is in, and the argument it is at.
        let mut i = at.off as usize;
        let mut depth = 0;
        let mut commas = 0;
        let mut open = 0;
        let mut found = false;
        while i > 0 {
            i -= 1;
            let c = b[i];
            if c == b')' || c == b']' || c == b'}' { depth += 1; }
            if c == b'[' || c == b'{' {
                if depth == 0 { break; }
                depth -= 1;
            }
            if c == b'(' {
                if depth == 0 {
                    open = i;
                    found = true;
                    break;
                }
                depth -= 1;
            }
            if c == b',' && depth == 0 { commas += 1; }
            if c == b';' && depth == 0 { break; }
        }
        if !found { return Ok(Json::Null); }
        let mut ne = open;
        while ne > 0 && b[ne - 1] == b' ' { ne -= 1; }
        let mut ns = ne;
        while ns > 0 && is_word(b[ns - 1]) { ns -= 1; }
        if ns == ne { return Ok(Json::Null); }
        let method = ns > 0 && b[ns - 1] == b'.';
        let mut def: Option<&mut Def> = None;
        for r in at.idx.at(ns as Pos).iter() {
            if let Target::Def(d) = &r.target { def = Some(*d); }
        }
        if def.is_none() && !method {
            let segs = path_before(src, ne);
            def = resolve_path(at.a, at.fd, at.idx, &segs, ns);
        }
        let d = match def { Some(d) => d, None => return Ok(Json::Null) };
        let f = match d.file { Some(f) => f, None => return Ok(Json::Null) };
        let fd = match at.a.file_of(f) { Some(x) => x, None => return Ok(Json::Null) };
        let fsrc = fd.sf.file.src.as_str();
        let label = header(fsrc, d.pos as usize, d.kind);
        let params = param_ranges(label.as_str());
        let mut active = commas;
        if method && params.len() > 0 {
            let first = &label[params[0].0..params[0].1];
            if first.ends_with("self") { active += 1; }
        }
        let mut ps = arr();
        for (lo, hi) in params.iter() {
            ps = ps.push(obj().set("label", arr().push(int(utf16_len(&label[..*lo]) as i64)).push(int(utf16_len(&label[..*hi]) as i64))));
        }
        let mut sig = obj().set("label", str(label.as_str())).set("parameters", ps).set("activeParameter", int(active as i64));
        let docs = doc_comment(fsrc, d.pos as usize);
        if docs.len() > 0 { sig = sig.set("documentation", obj().set("kind", str("markdown")).set("value", str(docs.as_str()))); }
        Ok(obj().set("signatures", arr().push(sig)).set("activeSignature", int(0)).set("activeParameter", int(active as i64)))
    }
}

// The type of the expression that ends just before the . at dot.
fn receiver_type(idx: &FileIndex, src: &str, dot: usize) -> Option<&Type> {
    let b = src.as_bytes();
    let mut e = dot;
    while e > 0 && (b[e - 1] == b' ' || b[e - 1] == b'\n') { e -= 1; }
    if e == 0 { return None; }
    let mut t: Option<&Type> = None;
    if b[e - 1] == b')' || b[e - 1] == b']' || b[e - 1] == b'?' {
        // A call or index: the name before its brackets.
        let mut i = e - 1;
        while i > 0 && b[i] == b'?' { i -= 1; }
        let close = b[i];
        let open = if close == b')' { b'(' } else { b'[' };
        let mut depth = 0;
        loop {
            let c = b[i];
            if c == close { depth += 1; }
            if c == open {
                depth -= 1;
                if depth == 0 { break; }
            }
            if i == 0 { return None; }
            i -= 1;
        }
        let mut ne = i;
        while ne > 0 && b[ne - 1] == b' ' { ne -= 1; }
        let mut ns = ne;
        while ns > 0 && is_word(b[ns - 1]) { ns -= 1; }
        if ns == ne { return None; }
        for r in idx.at(ns as Pos).iter() {
            if r.ty.is_some() { t = r.ty; }
        }
        // For the call itself the ref's type is the call's (a method) or the
        // function's path; a ? unwraps nothing here.
        return t;
    }
    let mut s = e;
    while s > 0 && is_word(b[s - 1]) { s -= 1; }
    if s == e { return None; }
    for r in idx.at(s as Pos).iter() {
        if r.ty.is_some() { t = r.ty; }
    }
    t
}

// The segments of the path that ends at end (a::b before ::).
fn path_before(src: &str, end: usize) -> Vec<String> {
    let b = src.as_bytes();
    let mut segs = Vec::new();
    let mut e = end;
    loop {
        let mut s = e;
        while s > 0 && is_word(b[s - 1]) { s -= 1; }
        if s == e { break; }
        segs.push(src[s..e].to_string());
        if s >= 2 && b[s - 1] == b':' && b[s - 2] == b':' { e = s - 2; } else { break; }
    }
    segs.reverse();
    segs
}

// The definition a path names, looked up from the file's module.
fn resolve_path(a: &Analysis, fd: &FileData, idx: &FileIndex, segs: &Vec<String>, at: usize) -> Option<&mut Def> {
    if segs.len() == 0 { return None; }
    // What the index says about the last segment.
    let _ = at;
    let info = a.info?;
    let m = a.module_of_file(fd)?;
    let first = segs[0].as_str();
    let mut cur: Option<&mut Def> = None;
    let mut cur_mod: Option<&mut Module> = None;
    if first == "crate" {
        cur_mod = m.krate.root;
    } else if first == "self" {
        cur_mod = Some(m);
    } else if first == "super" {
        cur_mod = m.parent;
    } else {
        let mut b = m.lookup(first, TYPE_NS);
        if b.is_none() { b = m.lookup(first, VALUE_NS); }
        if b.is_none() {
            if let Some(pm) = m.krate.prelude { b = pm.lookup(first, TYPE_NS); }
        }
        if b.is_none() {
            for c in info.res.crates.iter() {
                if c.name == first { cur_mod = c.root; }
                if c.is_std && b.is_none() {
                    if let Some(pm) = c.prelude {
                        b = pm.lookup(first, TYPE_NS);
                        if b.is_none() { b = pm.lookup(first, VALUE_NS); }
                    }
                }
            }
        }
        match b {
            Some(x) => {
                cur = x.res.def;
                if let Some(d) = cur { cur_mod = d.module; }
            }
            None => {
                if cur_mod.is_none() {
                    // A name the index knows (a local type, an import).
                    for r in idx.refs.iter() {
                        if let Target::Def(d) = &r.target {
                            if d.name == first { cur = Some(*d); }
                        }
                    }
                }
            }
        }
    }
    let mut i = 1;
    while i < segs.len() {
        let name = segs[i].as_str();
        let mut next: Option<&mut Def> = None;
        if let Some(mm) = cur_mod {
            let mut b = mm.lookup(name, TYPE_NS);
            if b.is_none() { b = mm.lookup(name, VALUE_NS); }
            if let Some(x) = b { next = x.res.def; }
        }
        if next.is_none() {
            if let Some(d) = cur {
                if let Some(adt) = info.adts.get(&d.id) {
                    for v in adt.variants.iter() {
                        let vv = *v;
                        if vv.def.name == name { next = Some(vv.def); }
                    }
                }
                for (_, im) in info.impls.iter() {
                    let ok = match im.self_ty.def { Some(sd) => sd.id == d.id, None => false };
                    if ok {
                        if let Some(it) = im.items.get(&name.to_string()) { next = Some(*it); }
                    }
                }
            }
        }
        cur = next;
        cur_mod = match cur { Some(d) => d.module, None => None };
        if cur.is_none() { return None; }
        i += 1;
    }
    match cur {
        Some(d) => Some(d),
        None => match cur_mod { Some(mm) => mm.def, None => None },
    }
}

// The byte ranges of the parameters in a signature (fn f(a: i32, b: T)).
fn param_ranges(label: &str) -> Vec<(usize, usize)> {
    let b = label.as_bytes();
    let mut out = Vec::new();
    let open = match label.find('(') { Some(i) => i, None => return out };
    let mut depth = 0;
    let mut start = open + 1;
    let mut i = open + 1;
    while i < b.len() {
        let c = b[i];
        if c == b'(' || c == b'[' || c == b'<' || c == b'{' { depth += 1; }
        if (c == b')' || c == b']' || c == b'>' || c == b'}') && depth > 0 { depth -= 1; } else if c == b')' && depth == 0 {
            push_param(label, start, i, &mut out);
            break;
        }
        if c == b',' && depth == 0 {
            push_param(label, start, i, &mut out);
            start = i + 1;
        }
        i += 1;
    }
    out
}

fn push_param(label: &str, lo: usize, hi: usize, out: &mut Vec<(usize, usize)>) {
    let b = label.as_bytes();
    let mut a = lo;
    let mut e = hi;
    while a < e && (b[a] == b' ' || b[a] == b'\n') { a += 1; }
    while e > a && (b[e - 1] == b' ' || b[e - 1] == b'\n') { e -= 1; }
    if e > a { out.push((a, e)); }
}
