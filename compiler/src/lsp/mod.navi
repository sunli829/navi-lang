//! navi lsp: a language server (LSP over standard input and output) on
//! top of the compiler's front end: diagnostics, formatting, definitions,
//! references, rename, hover, symbols, completion, signature help, inlay
//! hints, folding and semantic tokens.

mod analysis;
mod complete;
mod features;
mod index;
mod json;

use std::{
    collections::HashMap,
    io::{Read, Write},
};

use crate::lsp::{
    analysis::{Analysis, Doc},
    json::{Json, arr, int, obj, str},
};

/// The server's state.
pub struct Server {
    /// Open documents by URI.
    pub docs: HashMap<String, &mut Doc>,
    /// The latest analysis of each crate, by its root.
    pub analyses: HashMap<String, &mut Analysis>,
    /// Crates whose documents changed since they were analyzed.
    pub dirty: HashMap<String, bool>,
    /// The analyzed crates, least recently analyzed first.
    pub order: Vec<String>,
    pub root: String,
    pub shutdown: bool,
}

pub fn lsp_command(args: &Vec<String>) -> i32 {
    let _ = args;
    // A long-running process: collect as usual, not as a compile does.
    std::gc::set_percent(100);
    let (tx, rx) = std::sync::mpmc::channel::<Option<Json>>();
    std::thread::spawn(|| {
        read_loop(tx);
    });
    let s = &mut Server {
        docs: HashMap::new(),
        analyses: HashMap::new(),
        dirty: HashMap::new(),
        order: Vec::new(),
        root: String::new(),
        shutdown: false,
    };
    loop {
        let first = match rx.recv() {
            Ok(m) => m,
            Err(_) => return 1,
        };
        // Take what else is waiting: changes in a row are analyzed once.
        let mut batch = Vec::new();
        batch.push(first);
        loop {
            match rx.try_recv() {
                Ok(m) => batch.push(m),
                Err(_) => break,
            }
        }
        for m in batch.iter() {
            match m {
                Some(msg) => {
                    if let Some(code) = s.handle(msg) {
                        return code;
                    }
                }
                None => return if s.shutdown { 0 } else { 1 },
            }
        }
        s.refresh();
    }
}

// Reads messages (Content-Length framed) and sends them on; None at the
// end of input.
fn read_loop(tx: std::sync::mpmc::Sender<Option<Json>>) {
    let mut f = std::io::stdin();
    read_messages(&mut f, tx);
}
fn read_messages<R: Read>(f: &mut R, tx: std::sync::mpmc::Sender<Option<Json>>) {
    loop {
        let mut len: usize = 0;
        let mut ok = false;
        // Headers.
        loop {
            let line = match read_line(f) {
                Some(l) => l,
                None => {
                    let _ = tx.send(None);
                    return;
                }
            };
            if line.len() == 0 {
                ok = true;
                break;
            }
            if let Some((k, v)) = line.split_once(':') {
                if k.trim().eq_ignore_ascii_case("content-length") {
                    if let Ok(n) = v.trim().parse::<usize>() {
                        len = n;
                    }
                }
            }
        }
        if !ok || len == 0 {
            continue;
        }
        let mut body: Vec<u8> = Vec::with_capacity(len);
        let mut buf = [0u8; 4096];
        while body.len() < len {
            let want = if len - body.len() < 4096 {
                len - body.len()
            } else {
                4096
            };
            let n = match f.read(&mut buf[0..want]) {
                Ok(n) => n,
                Err(_) => 0,
            };
            if n == 0 {
                let _ = tx.send(None);
                return;
            }
            let mut i = 0;
            while i < n {
                body.push(buf[i]);
                i += 1;
            }
        }
        let text = String::from_utf8_lossy(body.as_slice());
        match json::parse(text.as_str()) {
            Ok(v) => {
                if tx.send(Some(v)).is_err() {
                    return;
                }
            }
            Err(e) => log(`bad message: ${e}`.to_string()),
        }
    }
}

// A header line without its \r\n; None at the end of input.
fn read_line<R: Read>(f: &mut R) -> Option<String> {
    let mut b: Vec<u8> = Vec::new();
    let mut one = [0u8; 1];
    loop {
        let n = match f.read(&mut one) {
            Ok(n) => n,
            Err(_) => 0,
        };
        if n == 0 {
            return None;
        }
        if one[0] == b'\n' {
            break;
        }
        if one[0] != b'\r' {
            b.push(one[0]);
        }
    }
    Some(String::from_utf8_lossy(b.as_slice()))
}

/// Writes a message.
pub fn send(msg: &Json) {
    let body = msg.to_string();
    let mut out = `Content-Length: ${body.len()}\r\n\r\n`.to_string();
    out.push_str(body.as_str());
    let _ = std::io::stdout().write_all(out.as_bytes());
}

pub fn log(msg: String) {
    eprintln(`navi lsp: ${msg}`);
}

pub fn notify(method: &str, params: Json) {
    send(
        &obj()
            .set("jsonrpc", str("2.0"))
            .set("method", str(method))
            .set("params", params),
    );
}

fn reply(id: &Json, result: Json) {
    send(
        &obj()
            .set("jsonrpc", str("2.0"))
            .set("id", id.clone())
            .set("result", result),
    );
}

fn reply_error(id: &Json, code: i64, msg: &str) {
    let e = obj().set("code", int(code)).set("message", str(msg));
    send(
        &obj()
            .set("jsonrpc", str("2.0"))
            .set("id", id.clone())
            .set("error", e),
    );
}

impl Server {
    // Handles a message; Some(exit code) when the server should stop.
    fn handle(&mut self, msg: &Json) -> Option<i32> {
        let method = match msg.get("method") {
            Some(m) => m.as_str().unwrap_or(""),
            None => "",
        };
        let id = msg.get("id");
        let params = match msg.get("params") {
            Some(p) => p.clone(),
            None => Json::Null,
        };
        match id {
            Some(i) => {
                if method.len() == 0 {
                    return None;
                } // a response to us
                let idc = i.clone();
                if method == "exit" {
                    return Some(if self.shutdown { 0 } else { 1 });
                }
                let me = self;
                let r = std::panic::catch_unwind(|| me.request(method, &params));
                match r {
                    Ok(Ok(v)) => reply(&idc, v),
                    Ok(Err((code, m))) => reply_error(&idc, code, m.as_str()),
                    Err(_) => reply_error(&idc, -32603, "internal error"),
                }
                None
            }
            None => {
                if method == "exit" {
                    return Some(if self.shutdown { 0 } else { 1 });
                }
                let me = self;
                let r = std::panic::catch_unwind(|| {
                    me.notification(method, &params);
                });
                if r.is_err() {
                    log(`${method}: internal error`.to_string());
                }
                None
            }
        }
    }

    fn request(&mut self, method: &str, p: &Json) -> Result<Json, (i64, String)> {
        match method {
            "initialize" => {
                if let Some(u) = p.get("rootUri") {
                    if let Some(s) = u.as_str() {
                        self.root = analysis::uri_to_path(s);
                    }
                }
                Ok(obj()
                    .set("capabilities", capabilities())
                    .set("serverInfo", obj().set("name", str("navi lsp"))))
            }
            "shutdown" => {
                self.shutdown = true;
                Ok(Json::Null)
            }
            "textDocument/formatting" => self.formatting(p),
            "textDocument/rangeFormatting" => self.formatting(p),
            "textDocument/definition" => self.definition(p, false),
            "textDocument/typeDefinition" => self.definition(p, true),
            "textDocument/declaration" => self.definition(p, false),
            "textDocument/references" => self.references(p),
            "textDocument/implementation" => self.implementation(p),
            "textDocument/documentHighlight" => self.highlights(p),
            "textDocument/prepareRename" => self.prepare_rename(p),
            "textDocument/rename" => self.rename(p),
            "textDocument/hover" => self.hover(p),
            "textDocument/documentSymbol" => self.document_symbols(p),
            "workspace/symbol" => self.workspace_symbols(p),
            "textDocument/completion" => self.completion(p),
            "textDocument/signatureHelp" => self.signature_help(p),
            "textDocument/inlayHint" => self.inlay_hints(p),
            "textDocument/foldingRange" => self.folding(p),
            "textDocument/semanticTokens/full" => self.semantic_tokens(p),
            _ => Err((-32601, `unsupported method ${method}`.to_string())),
        }
    }

    fn notification(&mut self, method: &str, p: &Json) {
        match method {
            "textDocument/didOpen" => {
                let td = match p.get("textDocument") {
                    Some(t) => t,
                    None => return,
                };
                let uri = td
                    .get("uri")
                    .and_then(|u| u.as_str())
                    .unwrap_or("")
                    .to_string();
                let text = td
                    .get("text")
                    .and_then(|t| t.as_str())
                    .unwrap_or("")
                    .to_string();
                let version = td.get("version").and_then(|v| v.as_i64()).unwrap_or(0);
                self.open(uri.as_str(), text, version);
            }
            "textDocument/didChange" => {
                let uri = p
                    .at(&["textDocument", "uri"])
                    .and_then(|u| u.as_str())
                    .unwrap_or("")
                    .to_string();
                let version = p
                    .at(&["textDocument", "version"])
                    .and_then(|v| v.as_i64())
                    .unwrap_or(0);
                let changes = match p.get("contentChanges").and_then(|c| c.as_arr()) {
                    Some(c) => c.clone(),
                    None => return,
                };
                self.change(uri.as_str(), &changes, version);
            }
            "textDocument/didSave" => {
                let uri = p
                    .at(&["textDocument", "uri"])
                    .and_then(|u| u.as_str())
                    .unwrap_or("")
                    .to_string();
                if let Some(t) = p.get("text").and_then(|t| t.as_str()) {
                    let ts = t.to_string();
                    let v = match self.docs.get(&uri) {
                        Some(d) => d.version,
                        None => 0,
                    };
                    self.open(uri.as_str(), ts, v);
                } else if let Some(d) = self.docs.get(&uri) {
                    let k = d.krate.clone();
                    self.dirty.insert(k, true);
                }
            }
            "textDocument/didClose" => {
                let uri = p
                    .at(&["textDocument", "uri"])
                    .and_then(|u| u.as_str())
                    .unwrap_or("")
                    .to_string();
                let mut k = String::new();
                if let Some(d) = self.docs.get(&uri) {
                    k = d.krate.clone();
                }
                self.docs.remove(&uri);
                // Forget a crate no open document needs.
                let mut used = false;
                for d in self.docs.values() {
                    if d.krate == k {
                        used = true;
                    }
                }
                if used {
                    self.dirty.insert(k, true);
                } else {
                    self.analyses.remove(&k);
                    self.dirty.remove(&k);
                    self.order.retain(|x| *x != k);
                }
            }
            _ => {}
        }
    }
}

fn capabilities() -> Json {
    let legend = obj()
        .set("tokenTypes", features::token_types())
        .set("tokenModifiers", arr().push(str("declaration")));
    obj()
        .set("positionEncoding", str("utf-16"))
        .set(
            "textDocumentSync",
            obj()
                .set("openClose", Json::Bool(true))
                .set("change", int(2))
                .set("save", obj().set("includeText", Json::Bool(false))),
        )
        .set("documentFormattingProvider", Json::Bool(true))
        .set("definitionProvider", Json::Bool(true))
        .set("typeDefinitionProvider", Json::Bool(true))
        .set("declarationProvider", Json::Bool(true))
        .set("referencesProvider", Json::Bool(true))
        .set("implementationProvider", Json::Bool(true))
        .set("documentHighlightProvider", Json::Bool(true))
        .set(
            "renameProvider",
            obj().set("prepareProvider", Json::Bool(true)),
        )
        .set("hoverProvider", Json::Bool(true))
        .set("documentSymbolProvider", Json::Bool(true))
        .set("workspaceSymbolProvider", Json::Bool(true))
        .set(
            "completionProvider",
            obj().set("triggerCharacters", arr().push(str(".")).push(str(":"))),
        )
        .set(
            "signatureHelpProvider",
            obj().set("triggerCharacters", arr().push(str("(")).push(str(","))),
        )
        .set("inlayHintProvider", Json::Bool(true))
        .set("foldingRangeProvider", Json::Bool(true))
        .set(
            "semanticTokensProvider",
            obj().set("legend", legend).set("full", Json::Bool(true)),
        )
}
