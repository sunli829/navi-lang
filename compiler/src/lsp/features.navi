//! The requests about code: definitions, references, rename, hover,
//! symbols, inlay hints, folding, semantic tokens and formatting.

use std::collections::HashMap;
use crate::syntax::token::*;
use crate::syntax::source::Pos;
use crate::syntax::ast::*;
use crate::resolve::*;
use crate::types::{type_string, K_ADT, K_REF, K_PTR};
use crate::lsp::Server;
use crate::lsp::json::{Json, obj, arr, str, int};
use crate::lsp::analysis::*;
use crate::lsp::index::*;

/// Where a request points: its analysis, file, offset and the file's index.
pub struct At {
    pub a: &mut Analysis,
    pub fd: &mut FileData,
    pub off: Pos,
    pub idx: &mut FileIndex,
}

pub fn uri_of(p: &Json) -> String {
    match p.at(&["textDocument", "uri"]).and_then(|u| u.as_str()) {
        Some(u) => u.to_string(),
        None => String::new(),
    }
}

impl Analysis {
    pub fn index(&mut self, fd: &FileData) -> Option<&mut FileIndex> {
        if let Some(i) = self.indexes.get(&fd.path) { return Some(*i); }
        let info = self.info?;
        let ix = index_file(info, fd.sf);
        self.indexes.insert(fd.path.clone(), ix);
        Some(ix)
    }

    /// Where a field is declared: (file, position).
    pub fn field_def(&self, owner: &Def, name: &str) -> Option<(&mut FileData, Pos, Option<&crate::types::Type>)> {
        let info = self.info?;
        let f = owner.file?;
        let fd = self.file_of(f)?;
        let adt_id = if owner.kind == DEF_VARIANT { owner.parent?.id } else { owner.id };
        let adt = *info.adts.get(&adt_id)?;
        if owner.kind == DEF_VARIANT {
            for v in adt.variants.iter() {
                if v.def.id == owner.id {
                    for fl in v.fields.iter() {
                        if fl.name == name { return Some((fd, fl.pos, Some(fl.ty))); }
                    }
                }
            }
            return None;
        }
        for fl in adt.fields.iter() {
            if fl.name == name { return Some((fd, fl.pos, Some(fl.ty))); }
        }
        None
    }

    /// The location of what a target names.
    pub fn target_location(&self, t: &Target, here: &FileData) -> Option<Json> {
        match t {
            Target::Def(d) => {
                if d.kind == DEF_MOD {
                    if let Some(m) = d.module {
                        if let Some(f) = m.file {
                            if let Some(fd) = self.file_of(f) {
                                if f.name != match d.file { Some(df) => df.name.clone(), None => String::new() } {
                                    return Some(self.location(fd, 0, 0));
                                }
                            }
                        }
                    }
                }
                self.def_location(*d)
            }
            Target::Local(l) => Some(self.location(here, l.pos, token_end(here.sf.file.src.as_str(), l.pos as usize) as Pos)),
            Target::Field(d, name) => {
                let (fd, pos, _) = self.field_def(*d, name.as_str())?;
                Some(self.location(fd, pos, token_end(fd.sf.file.src.as_str(), pos as usize) as Pos))
            }
            Target::Prim(_) => None,
        }
    }

    /// Whether a target is declared in the analyzed crate (it may be renamed).
    pub fn is_user(&self, t: &Target) -> bool {
        let f = match t {
            Target::Def(d) => d.file,
            Target::Local(_) => return true,
            Target::Field(d, _) => d.file,
            Target::Prim(_) => return false,
        };
        match f {
            Some(file) => match self.file_of(file) { Some(fd) => fd.user, None => false },
            None => false,
        }
    }

    /// Every reference to a target in the crate's files.
    pub fn all_refs(&mut self, t: &Target, here: &FileData) -> Vec<(&mut FileData, Ref)> {
        let mut out = Vec::new();
        let only_here = match t { Target::Local(_) => true, _ => false };
        let files: Vec<&mut FileData> = self.files.iter().map(|f| *f).collect();
        for fd in files.iter() {
            if !fd.user { continue; }
            if only_here && fd.path != here.path { continue; }
            let ix = match self.index(*fd) { Some(i) => i, None => continue };
            for r in ix.refs.iter() {
                if r.target.same(t) { out.push((*fd, r.clone())); }
            }
        }
        out
    }
}

// The reference a request points at: a local or definition before a field
// (a shorthand field is both).
fn pick(refs: &Vec<Ref>) -> Option<Ref> {
    for r in refs.iter() {
        match r.target {
            Target::Field(_, _) => {}
            _ => return Some(r.clone()),
        }
    }
    if refs.len() > 0 { return Some(refs[0].clone()); }
    None
}

impl Server {
    pub fn at(&mut self, p: &Json) -> Option<At> {
        let uri = uri_of(p);
        let a = self.analysis_for(uri.as_str())?;
        let fd = a.file_by_path(uri_to_path(uri.as_str()).as_str())?;
        let off = json_offset(p, fd.sf.file.src.as_str(), &fd.lines) as Pos;
        let idx = a.index(fd)?;
        Some(At { a, fd, off, idx })
    }

    pub fn definition(&mut self, p: &Json, type_def: bool) -> Result<Json, (i64, String)> {
        let at = match self.at(p) { Some(a) => a, None => return Ok(Json::Null) };
        let r = match pick(&at.idx.at(at.off)) { Some(r) => r, None => return Ok(Json::Null) };
        if type_def {
            let mut t = match r.ty {
                Some(t) => t,
                None => match &r.target {
                    Target::Field(d, n) => match at.a.field_def(*d, n.as_str()) { Some((_, _, Some(t))) => t, _ => return Ok(Json::Null) },
                    _ => return Ok(Json::Null),
                },
            };
            loop {
                if (t.kind == K_REF || t.kind == K_PTR) && t.elem.is_some() {
                    t = t.elem.unwrap();
                    continue;
                }
                break;
            }
            if t.kind == K_ADT {
                if let Some(d) = t.def {
                    return Ok(match at.a.def_location(d) { Some(l) => l, None => Json::Null });
                }
            }
            return Ok(Json::Null);
        }
        Ok(match at.a.target_location(&r.target, at.fd) { Some(l) => l, None => Json::Null })
    }

    /// The impls of a trait or type; for a trait's method, the methods
    /// implementing it.
    pub fn implementation(&mut self, p: &Json) -> Result<Json, (i64, String)> {
        let at = match self.at(p) { Some(a) => a, None => return Ok(Json::Null) };
        let r = match pick(&at.idx.at(at.off)) { Some(r) => r, None => return Ok(Json::Null) };
        let d = match &r.target { Target::Def(d) => *d, _ => return Ok(Json::Null) };
        let info = match at.a.info { Some(i) => i, None => return Ok(Json::Null) };
        // A trait item: the impls' items of the same name.
        let (trait_id, item) = match d.parent {
            Some(par) => if par.kind == DEF_TRAIT && d.kind != DEF_TRAIT { (par.id, d.name.clone()) } else { (d.id, String::new()) },
            None => (d.id, String::new()),
        };
        let mut out = arr();
        for (_, im) in info.impls.iter() {
            let of_trait = match im.trait_ref { Some(tr) => match tr.tdef { Some(td) => td.id == trait_id, None => false }, None => false };
            let of_type = item.len() == 0 && match im.self_ty.def { Some(sd) => sd.id == d.id, None => false };
            if !of_trait && !of_type { continue; }
            if item.len() > 0 {
                if let Some(it) = im.items.get(&item) {
                    if let Some(l) = at.a.def_location(*it) { out = out.push(l); }
                }
                continue;
            }
            let idef = im.def;
            if let Some(f) = idef.file {
                if let Some(fd) = at.a.file_of(f) {
                    let src = fd.sf.file.src.as_str();
                    let lo = if idef.pos >= 0 { idef.pos as usize } else { 0 };
                    out = out.push(obj().set("uri", str(fd.uri.as_str())).set("range", fd.lines.range(src, lo, token_end(src, lo))));
                }
            }
        }
        Ok(out)
    }

    pub fn references(&mut self, p: &Json) -> Result<Json, (i64, String)> {
        let at = match self.at(p) { Some(a) => a, None => return Ok(Json::Null) };
        let r = match pick(&at.idx.at(at.off)) { Some(r) => r, None => return Ok(Json::Null) };
        let with_decl = p.at(&["context", "includeDeclaration"]).and_then(|b| b.as_bool()).unwrap_or(true);
        let mut out = arr();
        for (fd, x) in at.a.all_refs(&r.target, at.fd).iter() {
            if x.decl && !with_decl { continue; }
            out = out.push(at.a.location(*fd, x.lo, x.hi));
        }
        Ok(out)
    }

    pub fn highlights(&mut self, p: &Json) -> Result<Json, (i64, String)> {
        let at = match self.at(p) { Some(a) => a, None => return Ok(Json::Null) };
        let r = match pick(&at.idx.at(at.off)) { Some(r) => r, None => return Ok(Json::Null) };
        let src = at.fd.sf.file.src.as_str();
        let mut out = arr();
        for x in at.idx.refs.iter() {
            if x.target.same(&r.target) {
                out = out.push(obj().set("range", at.fd.lines.range(src, x.lo as usize, x.hi as usize)).set("kind", int(if x.decl { 3 } else { 2 })));
            }
        }
        Ok(out)
    }

    pub fn prepare_rename(&mut self, p: &Json) -> Result<Json, (i64, String)> {
        let at = match self.at(p) { Some(a) => a, None => return Ok(Json::Null) };
        let r = match pick(&at.idx.at(at.off)) { Some(r) => r, None => return Ok(Json::Null) };
        if !at.a.is_user(&r.target) { return Err((-32803, "cannot rename what is defined outside this crate".to_string())); }
        let src = at.fd.sf.file.src.as_str();
        Ok(obj().set("range", at.fd.lines.range(src, r.lo as usize, r.hi as usize)).set("placeholder", str(&src[r.lo as usize..r.hi as usize])))
    }

    pub fn rename(&mut self, p: &Json) -> Result<Json, (i64, String)> {
        let name = p.get("newName").and_then(|n| n.as_str()).unwrap_or("").to_string();
        if !is_ident(name.as_str()) { return Err((-32602, `${name} is not an identifier`.to_string())); }
        let at = match self.at(p) { Some(a) => a, None => return Ok(Json::Null) };
        let r = match pick(&at.idx.at(at.off)) { Some(r) => r, None => return Ok(Json::Null) };
        if !at.a.is_user(&r.target) { return Err((-32803, "cannot rename what is defined outside this crate".to_string())); }
        let mut by_uri: HashMap<String, Json> = HashMap::new();
        let mut order: Vec<String> = Vec::new();
        for (fd, x) in at.a.all_refs(&r.target, at.fd).iter() {
            let src = fd.sf.file.src.as_str();
            // A shorthand field (S { x }) keeps its field name.
            let mut new_text = name.clone();
            let shorthand_other = match (&r.target, &x.target) {
                (Target::Local(_), Target::Local(_)) => field_shorthand(at.a, *fd, x.lo),
                _ => false,
            };
            if shorthand_other { new_text = `${&src[x.lo as usize..x.hi as usize]}: ${name}`.to_string(); }
            let e = obj().set("range", fd.lines.range(src, x.lo as usize, x.hi as usize)).set("newText", str(new_text.as_str()));
            let cur = match by_uri.get(&fd.uri) {
                Some(c) => c.clone(),
                None => {
                    order.push(fd.uri.clone());
                    arr()
                }
            };
            by_uri.insert(fd.uri.clone(), cur.push(e));
        }
        let mut changes = obj();
        for u in order.iter() { changes = changes.set(u.as_str(), by_uri[u].clone()); }
        Ok(obj().set("changes", changes))
    }

    pub fn hover(&mut self, p: &Json) -> Result<Json, (i64, String)> {
        let at = match self.at(p) { Some(a) => a, None => return Ok(Json::Null) };
        // A derive's name: the code it expands to.
        if let Some(info) = at.a.info {
            let src = at.fd.sf.file.src.as_str();
            for u in info.res.derive_uses.iter() {
                if u.file != at.fd.sf.file.name || u.pos < 0 || (u.pos as usize) >= src.len() { continue; }
                let hi = token_end(src, u.pos as usize) as Pos;
                if at.off < u.pos || at.off > hi { continue; }
                let code = match crate::fmt::format_source(u.what.as_str(), u.code.clone()) { Ok(t) => t, Err(_) => u.code.clone() };
                let md = `\`${u.what}\` expands to:\n\n\`\`\`navi\n${code.trim_end()}\n\`\`\``.to_string();
                return Ok(obj().set("contents", obj().set("kind", str("markdown")).set("value", str(md.as_str())))
                    .set("range", at.fd.lines.range(src, u.pos as usize, hi as usize)));
            }
        }
        let r = match pick(&at.idx.at(at.off)) { Some(r) => r, None => return Ok(Json::Null) };
        let mut code = String::new();
        let mut docs = String::new();
        match &r.target {
            Target::Prim(n) => {
                code.push_str(n.as_str());
                docs = `The primitive type \`${n}\`.`.to_string();
            }
            Target::Local(l) => {
                code.push_str("let ");
                if l.is_mut { code.push_str("mut "); }
                code.push_str(l.name.as_str());
                if let Some(t) = r.ty {
                    code.push_str(": ");
                    code.push_str(type_string(t).as_str());
                }
            }
            Target::Field(d, n) => {
                code.push_str(d.name.as_str());
                code.push_str("\n");
                code.push_str(n.as_str());
                if let Some((fd, pos, ty)) = at.a.field_def(*d, n.as_str()) {
                    if let Some(t) = ty {
                        code.push_str(": ");
                        code.push_str(type_string(t).as_str());
                    }
                    docs = doc_comment(fd.sf.file.src.as_str(), pos as usize);
                }
            }
            Target::Def(d) => {
                if let Some(f) = d.file {
                    if let Some(fd) = at.a.file_of(f) {
                        let src = fd.sf.file.src.as_str();
                        let pos = if d.pos >= 0 { d.pos as usize } else { 0 };
                        if let Some(parent) = d.parent {
                            if parent.kind != DEF_MOD && parent.kind != DEF_IMPL { code.push_str(`${parent.name}\n`.to_string().as_str()); }
                        }
                        code.push_str(header(src, pos, d.kind).as_str());
                        docs = doc_comment(src, pos);
                        if d.kind == DEF_MOD && pos == 0 { docs = module_doc(src); }
                    }
                }
                if code.len() == 0 { code.push_str(d.name.as_str()); }
                if d.kind == DEF_CONST || d.kind == DEF_STATIC || d.kind == DEF_ASSOC_CONST {
                    if let Some(t) = r.ty {
                        if !code.contains(":") { code.push_str(`: ${type_string(t)}`.to_string().as_str()); }
                    }
                }
            }
        }
        let mut md = s3("```navi\n", code.as_str(), "\n```");
        if docs.len() > 0 {
            md.push_str("\n\n---\n\n");
            md.push_str(docs.as_str());
        }
        let src = at.fd.sf.file.src.as_str();
        Ok(obj().set("contents", obj().set("kind", str("markdown")).set("value", str(md.as_str())))
            .set("range", at.fd.lines.range(src, r.lo as usize, r.hi as usize)))
    }

    pub fn document_symbols(&mut self, p: &Json) -> Result<Json, (i64, String)> {
        let uri = uri_of(p);
        let a = match self.analysis_for(uri.as_str()) { Some(a) => a, None => return Ok(Json::Null) };
        let fd = match a.file_by_path(uri_to_path(uri.as_str()).as_str()) { Some(f) => f, None => return Ok(Json::Null) };
        let toks = crate::syntax::lexer::tokenize(fd.sf.file.src.as_str(), crate::syntax::source::Errors::new(fd.sf.file));
        let fx = crate::fmt::ctx::Ctx::new(fd.sf.file, toks);
        Ok(symbols(fx, fd, &fd.sf.items))
    }

    pub fn workspace_symbols(&mut self, p: &Json) -> Result<Json, (i64, String)> {
        let q = p.get("query").and_then(|q| q.as_str()).unwrap_or("").to_lowercase();
        let mut out = arr();
        let mut n = 0;
        let keys: Vec<String> = self.analyses.keys().map(|k| k.clone()).collect();
        for k in keys.iter() {
            let a = self.analyses[k];
            let info = match a.info { Some(i) => i, None => continue };
            for d in info.res.defs.iter() {
                if d.krate.is_std { continue; }
                let kind = symbol_kind(d.kind);
                if kind == 0 || d.name.len() == 0 { continue; }
                if q.len() > 0 && !d.name.to_lowercase().contains(q.as_str()) { continue; }
                let loc = match a.def_location(*d) { Some(l) => l, None => continue };
                let mut si = obj().set("name", str(d.name.as_str())).set("kind", int(kind)).set("location", loc);
                if let Some(par) = d.parent {
                    if par.kind != DEF_MOD || par.parent.is_some() { si = si.set("containerName", str(par.name.as_str())); }
                }
                out = out.push(si);
                n += 1;
                if n >= 500 { return Ok(out); }
            }
        }
        Ok(out)
    }

    pub fn inlay_hints(&mut self, p: &Json) -> Result<Json, (i64, String)> {
        let at = match self.at(p) { Some(a) => a, None => return Ok(Json::Null) };
        let src = at.fd.sf.file.src.as_str();
        let lo = match p.get("range") {
            Some(r) => at.fd.lines.offset(src, r.at(&["start", "line"]).and_then(|v| v.as_i64()).unwrap_or(0) as usize, 0),
            None => 0,
        };
        let hi = match p.get("range") {
            Some(r) => at.fd.lines.offset(src, r.at(&["end", "line"]).and_then(|v| v.as_i64()).unwrap_or(0) as usize + 1, 0),
            None => src.len(),
        };
        // The bindings of lets and fors without a type.
        let mut names: Vec<Pos> = Vec::new();
        for it in at.fd.sf.items.iter() {
            crate::syntax::walk::inspect_item(it, |v| {
                match v {
                    crate::syntax::walk::Visit::Stmt(s) => {
                        if let Stmt::Let(l) = s {
                            if l.ty.is_none() { collect_binding_names(l.pat, &mut names); }
                        }
                    }
                    crate::syntax::walk::Visit::Expr(x) => {
                        match &x.kind {
                            ExprKind::For { pat, .. } => collect_binding_names(*pat, &mut names),
                            ExprKind::Let { pat, .. } => collect_binding_names(*pat, &mut names),
                            _ => {}
                        }
                    }
                    _ => {}
                }
                true
            });
        }
        let mut out = arr();
        for r in at.idx.refs.iter() {
            if !r.decl || (r.lo as usize) < lo || (r.lo as usize) > hi { continue; }
            let is_local = match r.target { Target::Local(_) => true, _ => false };
            if !is_local { continue; }
            let mut want = false;
            for n in names.iter() {
                if *n == r.lo { want = true; }
            }
            if !want { continue; }
            let t = match r.ty { Some(t) => t, None => continue };
            let ts = type_string(t);
            if ts.contains("?") || ts.contains("{error}") { continue; }
            out = out.push(obj().set("position", at.fd.lines.pos(src, r.hi as usize)).set("label", str(`: ${ts}`.to_string().as_str())).set("kind", int(1)));
        }
        Ok(out)
    }

    pub fn folding(&mut self, p: &Json) -> Result<Json, (i64, String)> {
        let uri = uri_of(p);
        let a = match self.analysis_for(uri.as_str()) { Some(a) => a, None => return Ok(Json::Null) };
        let fd = match a.file_by_path(uri_to_path(uri.as_str()).as_str()) { Some(f) => f, None => return Ok(Json::Null) };
        let src = fd.sf.file.src.as_str();
        let toks = crate::syntax::lexer::tokenize(src, crate::syntax::source::Errors::new(fd.sf.file));
        let fx = crate::fmt::ctx::Ctx::new(fd.sf.file, toks);
        let mut out = arr();
        let mut i = 0;
        while i < fx.toks.len() {
            let k = fx.toks[i].kind;
            if (k == L_BRACE || k == L_PAREN || k == L_BRACKET) && fx.close[i] > i {
                let a1 = fd.lines.line_of(fx.toks[i].pos as usize);
                let b1 = fd.lines.line_of(fx.toks[fx.close[i]].pos as usize);
                if b1 > a1 + 1 || (b1 > a1 && k == L_BRACE) {
                    out = out.push(obj().set("startLine", int(a1 as i64)).set("endLine", int((b1 - 1) as i64)));
                }
            }
            i += 1;
        }
        // Runs of line comments.
        let mut j = 0;
        while j < fx.comments.len() {
            let start = fd.lines.line_of(fx.comments[j].pos as usize);
            let mut end = start;
            let mut k2 = j + 1;
            while k2 < fx.comments.len() && fx.comments[k2].line && fd.lines.line_of(fx.comments[k2].pos as usize) == end + 1 {
                end += 1;
                k2 += 1;
            }
            if !fx.comments[j].line { end = fd.lines.line_of(fx.comments[j].end as usize); }
            if end > start { out = out.push(obj().set("startLine", int(start as i64)).set("endLine", int(end as i64)).set("kind", str("comment"))); }
            j = if k2 > j + 1 { k2 } else { j + 1 };
        }
        // Runs of use items.
        let items = &fd.sf.items;
        let mut m = 0;
        while m < items.len() {
            let mut n = m;
            while n + 1 < items.len() && is_use(&items[n + 1]) && is_use(&items[m]) { n += 1; }
            if n > m {
                let s1 = fd.lines.line_of(fx.item_lo(&items[m]) as usize);
                let e1 = fd.lines.line_of(fx.item_end(&items[n]) as usize);
                out = out.push(obj().set("startLine", int(s1 as i64)).set("endLine", int(e1 as i64)).set("kind", str("imports")));
            }
            m = n + 1;
        }
        Ok(out)
    }

    pub fn semantic_tokens(&mut self, p: &Json) -> Result<Json, (i64, String)> {
        let uri = uri_of(p);
        let a = match self.analysis_for(uri.as_str()) { Some(a) => a, None => return Ok(Json::Null) };
        let fd = match a.file_by_path(uri_to_path(uri.as_str()).as_str()) { Some(f) => f, None => return Ok(Json::Null) };
        let idx = a.index(fd);
        let src = fd.sf.file.src.as_str();
        let toks = crate::syntax::lexer::tokenize(src, crate::syntax::source::Errors::new(fd.sf.file));
        let fx = crate::fmt::ctx::Ctx::new(fd.sf.file, toks);
        // (start, end, type, modifiers), in order.
        let mut spans: Vec<(usize, usize, i64, i64)> = Vec::new();
        let mut ci = 0;
        let mut ri = 0;
        for t in fx.toks.iter() {
            while ci < fx.comments.len() && fx.comments[ci].pos < t.pos {
                spans.push((fx.comments[ci].pos as usize, fx.comments[ci].end as usize, T_COMMENT, 0));
                ci += 1;
            }
            let k = t.kind;
            if k == EOF { break; }
            let (lo, hi) = (t.pos as usize, t.end as usize);
            if k == STRING || k == RAW_STRING || k == BYTE_STRING || k == TEMPLATE || k == CHAR || k == BYTE {
                spans.push((lo, hi, T_STRING, 0));
            } else if k == INT || k == FLOAT {
                spans.push((lo, hi, T_NUMBER, 0));
            } else if is_keyword(k) || k == KW_TRUE || k == KW_FALSE {
                spans.push((lo, hi, T_KEYWORD, 0));
            } else if k == IDENT {
                if let Some(ix) = idx {
                    while ri < ix.refs.len() && ix.refs[ri].lo < t.pos { ri += 1; }
                    let mut tt: i64 = -1;
                    let mut md: i64 = 0;
                    let mut q = ri;
                    while q < ix.refs.len() && ix.refs[q].lo == t.pos {
                        let r = &ix.refs[q];
                        let c = target_token(&r.target);
                        if tt < 0 || c != T_PROPERTY {
                            tt = c;
                            md = if r.decl { 1 } else { 0 };
                        }
                        q += 1;
                    }
                    if tt >= 0 { spans.push((lo, hi, tt, md)); }
                }
            } else if k == LIFETIME {
                spans.push((lo, hi, T_LABEL, 0));
            }
        }
        while ci < fx.comments.len() {
            spans.push((fx.comments[ci].pos as usize, fx.comments[ci].end as usize, T_COMMENT, 0));
            ci += 1;
        }
        // Encode, a line at a time.
        let mut data = arr();
        let mut pl = 0;
        let mut pc = 0;
        for (lo, hi, tt, md) in spans.iter() {
            let mut s1 = *lo;
            while s1 < *hi {
                let line = fd.lines.line_of(s1);
                let line_end = if line + 1 < fd.lines.starts.len() { fd.lines.starts[line + 1] - 1 } else { src.len() };
                let e1 = if *hi < line_end { *hi } else { line_end };
                if e1 > s1 {
                    let col = utf16_len(&src[fd.lines.starts[line]..s1]);
                    let len = utf16_len(&src[s1..e1]);
                    let dl = line - pl;
                    let dc = if dl == 0 { col - pc } else { col };
                    data = data.push(int(dl as i64)).push(int(dc as i64)).push(int(len as i64)).push(int(*tt)).push(int(*md));
                    pl = line;
                    pc = col;
                }
                s1 = line_end + 1;
            }
        }
        Ok(obj().set("data", data))
    }

    pub fn formatting(&mut self, p: &Json) -> Result<Json, (i64, String)> {
        let uri = uri_of(p);
        let (text, lines, path) = match self.docs.get(&uri) {
            Some(d) => (d.text.clone(), d.lines.clone(), d.path.clone()),
            None => {
                let path = uri_to_path(uri.as_str());
                match std::fs::read_to_string(path.as_str()) {
                    Ok(t) => {
                        let li = LineIndex::new(t.as_str());
                        (t, li, path)
                    }
                    Err(_) => return Ok(Json::Null),
                }
            }
        };
        match crate::fmt::format_file(path.as_str(), text.clone()) {
            Ok(out) => {
                if out == text { return Ok(arr()); }
                let e = obj().set("range", lines.range(text.as_str(), 0, text.len())).set("newText", str(out.as_str()));
                Ok(arr().push(e))
            }
            Err(e) => {
                crate::lsp::log(e);
                Ok(Json::Null)
            }
        }
    }
}

// Semantic token types (the legend's order).
pub const T_NAMESPACE: i64 = 0;
pub const T_TYPE: i64 = 1;
pub const T_STRUCT: i64 = 2;
pub const T_ENUM: i64 = 3;
pub const T_INTERFACE: i64 = 4;
pub const T_TYPE_PARAM: i64 = 5;
pub const T_PARAMETER: i64 = 6;
pub const T_VARIABLE: i64 = 7;
pub const T_PROPERTY: i64 = 8;
pub const T_ENUM_MEMBER: i64 = 9;
pub const T_FUNCTION: i64 = 10;
pub const T_METHOD: i64 = 11;
pub const T_KEYWORD: i64 = 12;
pub const T_COMMENT: i64 = 13;
pub const T_STRING: i64 = 14;
pub const T_NUMBER: i64 = 15;
pub const T_LABEL: i64 = 16;

pub fn token_types() -> Json {
    let names = ["namespace", "type", "struct", "enum", "interface", "typeParameter", "parameter", "variable", "property",
        "enumMember", "function", "method", "keyword", "comment", "string", "number", "label"];
    let mut a = arr();
    for n in names.iter() { a = a.push(str(*n)); }
    a
}

fn target_token(t: &Target) -> i64 {
    match t {
        Target::Local(_) => T_VARIABLE,
        Target::Field(_, _) => T_PROPERTY,
        Target::Prim(_) => T_TYPE,
        Target::Def(d) => {
            let k = d.kind;
            if k == DEF_MOD { T_NAMESPACE }
            else if k == DEF_STRUCT { T_STRUCT }
            else if k == DEF_ENUM { T_ENUM }
            else if k == DEF_VARIANT { T_ENUM_MEMBER }
            else if k == DEF_TRAIT { T_INTERFACE }
            else if k == DEF_TYPE_ALIAS || k == DEF_ASSOC_TYPE { T_TYPE }
            else if k == DEF_TYPE_PARAM { T_TYPE_PARAM }
            else if k == DEF_ASSOC_FN { T_METHOD }
            else if k == DEF_FN || k == DEF_EXTERN_FN { T_FUNCTION }
            else { T_VARIABLE }
        }
    }
}

/// The LSP SymbolKind of a definition (0 for none).
pub fn symbol_kind(k: DefKind) -> i64 {
    if k == DEF_MOD { 2 }
    else if k == DEF_STRUCT { 23 }
    else if k == DEF_ENUM { 10 }
    else if k == DEF_VARIANT { 22 }
    else if k == DEF_TRAIT { 11 }
    else if k == DEF_TYPE_ALIAS || k == DEF_ASSOC_TYPE { 26 }
    else if k == DEF_FN || k == DEF_EXTERN_FN { 12 }
    else if k == DEF_ASSOC_FN { 6 }
    else if k == DEF_CONST || k == DEF_ASSOC_CONST { 14 }
    else if k == DEF_STATIC || k == DEF_EXTERN_STATIC { 13 }
    else { 0 }
}

fn is_use(it: &Item) -> bool { match it { Item::Use(_) => true, _ => false } }

fn collect_binding_names(p: &Pat, out: &mut Vec<Pos>) {
    match &p.kind {
        PatKind::Ident { name, sub, .. } => {
            out.push(name.pos);
            if let Some(s) = sub { collect_binding_names(*s, out); }
        }
        PatKind::Tuple { elems, .. } => { for e in elems.iter() { collect_binding_names(*e, out); } }
        PatKind::TupleStruct { elems, .. } => { for e in elems.iter() { collect_binding_names(*e, out); } }
        PatKind::Slice { elems, .. } => { for e in elems.iter() { collect_binding_names(*e, out); } }
        PatKind::Struct { fields, .. } => { for f in fields.iter() { collect_binding_names(f.pat, out); } }
        PatKind::Ref { pat, .. } => collect_binding_names(*pat, out),
        PatKind::Or(alts) => { for a in alts.iter() { collect_binding_names(*a, out); } }
        _ => {}
    }
}

pub fn is_ident(s: &str) -> bool {
    let b = s.as_bytes();
    if b.len() == 0 { return false; }
    let c = b[0];
    if !(c == b'_' || (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z')) { return false; }
    for x in b.iter() {
        let c = *x;
        if !(c == b'_' || (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || (c >= b'0' && c <= b'9')) { return false; }
    }
    crate::syntax::token::keyword(s) == IDENT && !crate::syntax::token::is_reserved(s)
}

// Whether the name at lo is a shorthand field of a struct literal or
// pattern (S { x }): renaming x must keep the field's name.
fn field_shorthand(a: &mut Analysis, fd: &FileData, lo: Pos) -> bool {
    let ix = match a.index(fd) { Some(i) => i, None => return false };
    for r in ix.refs.iter() {
        if r.lo == lo {
            if let Target::Field(_, _) = r.target { return true; }
        }
    }
    // A shorthand field pattern has no field ref: look at the source.
    let src = fd.sf.file.src.as_bytes();
    let hi = token_end(fd.sf.file.src.as_str(), lo as usize);
    let mut i = hi;
    while i < src.len() && (src[i] == b' ' || src[i] == b'\n') { i += 1; }
    let next = if i < src.len() { src[i] } else { 0 };
    let mut j = lo as usize;
    while j > 0 && (src[j - 1] == b' ' || src[j - 1] == b'\n') { j -= 1; }
    let mut prev = if j > 0 { src[j - 1] } else { 0 };
    // mut x in a pattern.
    if prev == b't' && j >= 3 && &fd.sf.file.src[j - 3..j] == "mut" {
        let mut k = j - 3;
        while k > 0 && (src[k - 1] == b' ' || src[k - 1] == b'\n') { k -= 1; }
        prev = if k > 0 { src[k - 1] } else { 0 };
    }
    (prev == b'{' || prev == b',') && (next == b',' || next == b'}') && in_braces_after_path(src, j)
}

// Whether the { before off follows a path (a struct literal or pattern, not
// a block).
fn in_braces_after_path(src: &[u8], off: usize) -> bool {
    let mut depth = 0;
    let mut i = off;
    while i > 0 {
        i -= 1;
        let c = src[i];
        if c == b'}' || c == b')' || c == b']' { depth += 1; }
        if c == b'(' || c == b'[' {
            if depth == 0 { return false; }
            depth -= 1;
        }
        if c == b'{' {
            if depth == 0 {
                let mut k = i;
                while k > 0 && src[k - 1] == b' ' { k -= 1; }
                if k == 0 { return false; }
                let p = src[k - 1];
                return p == b'_' || (p >= b'a' && p <= b'z') || (p >= b'A' && p <= b'Z') || (p >= b'0' && p <= b'9') || p == b'>';
            }
            depth -= 1;
        }
    }
    false
}

fn s3(a: &str, b: &str, c: &str) -> String {
    let mut s = a.to_string();
    s.push_str(b);
    s.push_str(c);
    s
}

/// The declaration at pos (a definition's name) as written: from the start
/// of its line to its body.
pub fn header(src: &str, pos: usize, kind: DefKind) -> String {
    let b = src.as_bytes();
    let mut lo = pos;
    while lo > 0 && b[lo - 1] != b'\n' { lo -= 1; }
    while lo < pos && (b[lo] == b' ' || b[lo] == b'\t') { lo += 1; }
    let mut i = pos;
    let mut depth = 0;
    while i < b.len() {
        let c = b[i];
        if c == b'(' || c == b'[' || c == b'<' { depth += 1; }
        if c == b')' || c == b']' || c == b'>' { if depth > 0 { depth -= 1; } }
        if depth == 0 {
            if c == b'{' || c == b';' { break; }
            if kind == DEF_VARIANT && (c == b',' || c == b'}') { break; }
            if (kind == DEF_CONST || kind == DEF_STATIC || kind == DEF_ASSOC_CONST) && c == b'=' { break; }
        }
        i += 1;
    }
    let text = src[lo..i].trim().to_string();
    let mut out = String::new();
    for l in text.split('\n') {
        if out.len() > 0 { out.push('\n'); }
        out.push_str(l.trim_end());
    }
    out
}

/// The /// comments above the line holding pos (attribute lines skipped).
pub fn doc_comment(src: &str, pos: usize) -> String {
    let b = src.as_bytes();
    let mut ls = if pos > b.len() { b.len() } else { pos };
    while ls > 0 && b[ls - 1] != b'\n' { ls -= 1; }
    let mut lines: Vec<String> = Vec::new();
    let mut end = ls;
    while end > 0 {
        let le = end - 1;
        let mut st = le;
        while st > 0 && b[st - 1] != b'\n' { st -= 1; }
        let line = src[st..le].trim();
        if line.starts_with("///") {
            let t = &line[3..];
            lines.push((if t.starts_with(" ") { &t[1..] } else { t }).to_string());
        } else if !line.starts_with("#[") {
            break;
        }
        end = st;
    }
    lines.reverse();
    lines.join("\n")
}

/// The //! comments at the top of a module's file.
pub fn module_doc(src: &str) -> String {
    let mut lines: Vec<String> = Vec::new();
    for l in src.lines() {
        let t = l.trim();
        if t.starts_with("//!") {
            let x = &t[3..];
            lines.push((if x.starts_with(" ") { &x[1..] } else { x }).to_string());
        } else if t.len() > 0 {
            break;
        }
    }
    lines.join("\n")
}

fn symbols(fx: &crate::fmt::ctx::Ctx, fd: &FileData, items: &Vec<Item>) -> Json {
    let src = fd.sf.file.src.as_str();
    let mut out = arr();
    for it in items.iter() {
        let lo = fx.item_lo(it) as usize;
        let hi = fx.item_end(it) as usize;
        let (name, npos, kind, children, detail) = match it {
            Item::Fn(f) => (f.name.value.clone(), f.name.pos, 12, arr(), header(src, f.name.pos as usize, DEF_FN)),
            Item::Struct(s) => {
                let mut ch = arr();
                for f in s.fields.iter() {
                    if let Some(n) = f.name {
                        let fe = fx.type_end(f.ty) as usize;
                        ch = ch.push(sym(fd, n.value.as_str(), 8, n.pos as usize, n.pos as usize, fe, arr(), String::new()));
                    }
                }
                (s.name.value.clone(), s.name.pos, 23, ch, String::new())
            }
            Item::Enum(e) => {
                let mut ch = arr();
                for v in e.variants.iter() {
                    ch = ch.push(sym(fd, v.name.value.as_str(), 22, v.name.pos as usize, v.name.pos as usize, token_end(src, v.name.pos as usize), arr(), String::new()));
                }
                (e.name.value.clone(), e.name.pos, 10, ch, String::new())
            }
            Item::TypeAlias(t) => (t.name.value.clone(), t.name.pos, 26, arr(), String::new()),
            Item::Const(c) => (c.name.value.clone(), c.name.pos, 14, arr(), String::new()),
            Item::Static(s) => (s.name.value.clone(), s.name.pos, 13, arr(), String::new()),
            Item::Impl(im) => {
                let n = s3("impl ", fx.snippet(im.ty.pos(), fx.type_end(im.ty)), "");
                let nm = match im.trait_path {
                    Some(tp) => s3(cat2("impl ", fx.snippet(tp.pos(), fx.path_end(tp))).as_str(), " for ", fx.snippet(im.ty.pos(), fx.type_end(im.ty))),
                    None => n,
                };
                (nm, im.ty.pos(), 19, symbols(fx, fd, &im.items), String::new())
            }
            Item::Trait(t) => (t.name.value.clone(), t.name.pos, 11, symbols(fx, fd, &t.items), String::new()),
            Item::Mod(m) => (m.name.value.clone(), m.name.pos, 2, symbols(fx, fd, &m.items), String::new()),
            Item::Use(_) => continue,
            Item::Extern(e) => {
                let ch = symbols(fx, fd, &e.items);
                if let Json::Arr(xs) = ch {
                    for x in xs.iter() { out = out.push(x.clone()); }
                }
                continue;
            }
        };
        out = out.push(sym(fd, name.as_str(), kind, npos as usize, lo, hi, children, detail));
    }
    out
}

fn cat2(a: &str, b: &str) -> String {
    let mut s = a.to_string();
    s.push_str(b);
    s
}

fn sym(fd: &FileData, name: &str, kind: i64, npos: usize, lo: usize, hi: usize, children: Json, detail: String) -> Json {
    let src = fd.sf.file.src.as_str();
    let lo2 = if lo > npos { npos } else { lo };
    let hi2 = if hi < npos { token_end(src, npos) } else { hi };
    let mut s = obj().set("name", str(name)).set("kind", int(kind))
        .set("range", fd.lines.range(src, lo2, hi2))
        .set("selectionRange", fd.lines.range(src, npos, token_end(src, npos)))
        .set("children", children);
    if detail.len() > 0 { s = s.set("detail", str(detail.as_str())); }
    s
}
