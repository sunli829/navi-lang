//! JSON values: parsing and writing (what JSON-RPC needs).

#[derive(Clone)]
pub enum Json {
    Null,
    Bool(bool),
    Int(i64),
    Num(f64),
    Str(String),
    Arr(Vec<Json>),
    Obj(Vec<(String, Json)>),
}

pub fn obj() -> Json {
    Json::Obj(Vec::new())
}
pub fn arr() -> Json {
    Json::Arr(Vec::new())
}
pub fn str(s: &str) -> Json {
    Json::Str(s.to_string())
}
pub fn int(n: i64) -> Json {
    Json::Int(n)
}

impl Json {
    /// The object with key set to v (replacing an earlier value).
    pub fn set(self, key: &str, v: Json) -> Json {
        match self {
            Json::Obj(fields) => {
                let mut out = Vec::new();
                for f in fields.iter() {
                    if f.0 != key {
                        out.push(f.clone());
                    }
                }
                out.push((key.to_string(), v));
                Json::Obj(out)
            }
            other => other,
        }
    }

    /// The array with v added.
    pub fn push(self, v: Json) -> Json {
        match self {
            Json::Arr(items) => {
                let mut out = items;
                out.push(v);
                Json::Arr(out)
            }
            other => other,
        }
    }

    pub fn get(&self, key: &str) -> Option<&Json> {
        match self {
            Json::Obj(fields) => {
                for f in fields.iter() {
                    if f.0 == key {
                        return Some(&f.1);
                    }
                }
                None
            }
            _ => None,
        }
    }

    /// The value at a path of keys.
    pub fn at(&self, keys: &[&str]) -> Option<&Json> {
        let mut cur = self;
        for k in keys.iter() {
            cur = cur.get(*k)?;
        }
        Some(cur)
    }

    pub fn as_str(&self) -> Option<&str> {
        match self {
            Json::Str(s) => Some(s.as_str()),
            _ => None,
        }
    }

    pub fn as_i64(&self) -> Option<i64> {
        match self {
            Json::Int(n) => Some(*n),
            Json::Num(f) => Some(*f as i64),
            _ => None,
        }
    }

    pub fn as_bool(&self) -> Option<bool> {
        match self {
            Json::Bool(b) => Some(*b),
            _ => None,
        }
    }

    pub fn as_arr(&self) -> Option<&Vec<Json>> {
        match self {
            Json::Arr(a) => Some(a),
            _ => None,
        }
    }

    pub fn is_null(&self) -> bool {
        match self {
            Json::Null => true,
            _ => false,
        }
    }

    pub fn to_string(&self) -> String {
        let mut out = String::new();
        write(self, &mut out);
        out
    }
}

fn write(v: &Json, out: &mut String) {
    match v {
        Json::Null => out.push_str("null"),
        Json::Bool(b) => out.push_str(if *b { "true" } else { "false" }),
        Json::Int(n) => out.push_str(`${n}`.to_string().as_str()),
        Json::Num(f) => out.push_str(`${f}`.to_string().as_str()),
        Json::Str(s) => write_str(s.as_str(), out),
        Json::Arr(items) => {
            out.push('[');
            let mut first = true;
            for it in items.iter() {
                if !first {
                    out.push(',');
                }
                write(it, out);
                first = false;
            }
            out.push(']');
        }
        Json::Obj(fields) => {
            out.push('{');
            let mut first = true;
            for f in fields.iter() {
                if !first {
                    out.push(',');
                }
                write_str(f.0.as_str(), out);
                out.push(':');
                write(&f.1, out);
                first = false;
            }
            out.push('}');
        }
    }
}

const HEX: &str = "0123456789abcdef";

fn write_str(s: &str, out: &mut String) {
    out.push('"');
    for c in s.chars() {
        match c {
            '"' => out.push_str("\\\""),
            '\\' => out.push_str("\\\\"),
            '\n' => out.push_str("\\n"),
            '\r' => out.push_str("\\r"),
            '\t' => out.push_str("\\t"),
            _ => {
                let u = c as u32;
                if u < 0x20 {
                    out.push_str("\\u00");
                    let h = HEX.as_bytes();
                    out.push(h[(u >> 4) as usize] as char);
                    out.push(h[(u & 15) as usize] as char);
                } else {
                    out.push(c);
                }
            }
        }
    }
    out.push('"');
}

/// Parses a JSON text.
pub fn parse(s: &str) -> Result<Json, String> {
    let mut p = P {
        b: s.as_bytes(),
        i: 0,
    };
    p.ws();
    let v = p.value()?;
    p.ws();
    if p.i != p.b.len() {
        return Err(p.err("trailing characters"));
    }
    Ok(v)
}

struct P {
    b: &[u8],
    i: usize,
}

impl P {
    fn err(&self, msg: &str) -> String {
        `json: ${msg} at offset ${self.i}`.to_string()
    }

    fn ws(&mut self) {
        while self.i < self.b.len() {
            let c = self.b[self.i];
            if c == b' ' || c == b'\n' || c == b'\r' || c == b'\t' {
                self.i += 1;
            } else {
                return;
            }
        }
    }

    fn lit(&mut self, word: &str, v: Json) -> Result<Json, String> {
        let w = word.as_bytes();
        if self.i + w.len() > self.b.len() {
            return Err(self.err("unexpected end"));
        }
        let mut k = 0;
        while k < w.len() {
            if self.b[self.i + k] != w[k] {
                return Err(self.err("bad literal"));
            }
            k += 1;
        }
        self.i += w.len();
        Ok(v)
    }

    fn value(&mut self) -> Result<Json, String> {
        if self.i >= self.b.len() {
            return Err(self.err("unexpected end"));
        }
        let c = self.b[self.i];
        if c == b'n' {
            return self.lit("null", Json::Null);
        }
        if c == b't' {
            return self.lit("true", Json::Bool(true));
        }
        if c == b'f' {
            return self.lit("false", Json::Bool(false));
        }
        if c == b'"' {
            return Ok(Json::Str(self.string()?));
        }
        if c == b'[' {
            self.i += 1;
            let mut items = Vec::new();
            self.ws();
            if self.i < self.b.len() && self.b[self.i] == b']' {
                self.i += 1;
                return Ok(Json::Arr(items));
            }
            loop {
                self.ws();
                items.push(self.value()?);
                self.ws();
                if self.i >= self.b.len() {
                    return Err(self.err("unexpected end"));
                }
                let d = self.b[self.i];
                self.i += 1;
                if d == b']' {
                    return Ok(Json::Arr(items));
                }
                if d != b',' {
                    return Err(self.err("expected , or ]"));
                }
            }
        }
        if c == b'{' {
            self.i += 1;
            let mut fields = Vec::new();
            self.ws();
            if self.i < self.b.len() && self.b[self.i] == b'}' {
                self.i += 1;
                return Ok(Json::Obj(fields));
            }
            loop {
                self.ws();
                if self.i >= self.b.len() || self.b[self.i] != b'"' {
                    return Err(self.err("expected a key"));
                }
                let k = self.string()?;
                self.ws();
                if self.i >= self.b.len() || self.b[self.i] != b':' {
                    return Err(self.err("expected :"));
                }
                self.i += 1;
                self.ws();
                let v = self.value()?;
                fields.push((k, v));
                self.ws();
                if self.i >= self.b.len() {
                    return Err(self.err("unexpected end"));
                }
                let d = self.b[self.i];
                self.i += 1;
                if d == b'}' {
                    return Ok(Json::Obj(fields));
                }
                if d != b',' {
                    return Err(self.err("expected , or }"));
                }
            }
        }
        self.number()
    }

    fn number(&mut self) -> Result<Json, String> {
        let start = self.i;
        let mut float = false;
        if self.i < self.b.len() && self.b[self.i] == b'-' {
            self.i += 1;
        }
        while self.i < self.b.len() {
            let c = self.b[self.i];
            if c >= b'0' && c <= b'9' {
                self.i += 1;
            } else if c == b'.' || c == b'e' || c == b'E' || c == b'+' || c == b'-' {
                float = true;
                self.i += 1;
            } else {
                break;
            }
        }
        if self.i == start {
            return Err(self.err("unexpected character"));
        }
        let t = String::from_utf8_lossy(&self.b[start..self.i]);
        if !float {
            if let Ok(n) = t.parse::<i64>() {
                return Ok(Json::Int(n));
            }
        }
        match t.parse::<f64>() {
            Ok(f) => Ok(Json::Num(f)),
            Err(_) => Err(self.err("bad number")),
        }
    }

    fn hex4(&mut self) -> Result<u32, String> {
        if self.i + 4 > self.b.len() {
            return Err(self.err("bad escape"));
        }
        let mut v: u32 = 0;
        let mut k = 0;
        while k < 4 {
            let c = self.b[self.i + k];
            let d = if c >= b'0' && c <= b'9' {
                c - b'0'
            } else if c >= b'a' && c <= b'f' {
                c - b'a' + 10
            } else if c >= b'A' && c <= b'F' {
                c - b'A' + 10
            } else {
                return Err(self.err("bad escape"));
            };
            v = v * 16 + d as u32;
            k += 1;
        }
        self.i += 4;
        Ok(v)
    }

    fn string(&mut self) -> Result<String, String> {
        self.i += 1;
        let mut out: Vec<u8> = Vec::new();
        loop {
            if self.i >= self.b.len() {
                return Err(self.err("unterminated string"));
            }
            let c = self.b[self.i];
            self.i += 1;
            if c == b'"' {
                break;
            }
            if c != b'\\' {
                out.push(c);
                continue;
            }
            if self.i >= self.b.len() {
                return Err(self.err("bad escape"));
            }
            let e = self.b[self.i];
            self.i += 1;
            match e {
                b'"' => out.push(b'"'),
                b'\\' => out.push(b'\\'),
                b'/' => out.push(b'/'),
                b'b' => out.push(8),
                b'f' => out.push(12),
                b'n' => out.push(b'\n'),
                b'r' => out.push(b'\r'),
                b't' => out.push(b'\t'),
                b'u' => {
                    let mut u = self.hex4()?;
                    if u >= 0xd800
                        && u < 0xdc00
                        && self.i + 6 <= self.b.len()
                        && self.b[self.i] == b'\\'
                        && self.b[self.i + 1] == b'u'
                    {
                        self.i += 2;
                        let lo = self.hex4()?;
                        u = 0x10000 + ((u - 0xd800) << 10) + (lo - 0xdc00);
                    }
                    push_utf8(&mut out, u);
                }
                _ => return Err(self.err("bad escape")),
            }
        }
        Ok(String::from_utf8_lossy(out.as_slice()))
    }
}

fn push_utf8(out: &mut Vec<u8>, u: u32) {
    if u < 0x80 {
        out.push(u as u8);
    } else if u < 0x800 {
        out.push((0xc0 | (u >> 6)) as u8);
        out.push((0x80 | (u & 0x3f)) as u8);
    } else if u < 0x10000 {
        out.push((0xe0 | (u >> 12)) as u8);
        out.push((0x80 | ((u >> 6) & 0x3f)) as u8);
        out.push((0x80 | (u & 0x3f)) as u8);
    } else {
        out.push((0xf0 | (u >> 18)) as u8);
        out.push((0x80 | ((u >> 12) & 0x3f)) as u8);
        out.push((0x80 | ((u >> 6) & 0x3f)) as u8);
        out.push((0x80 | (u & 0x3f)) as u8);
    }
}
