//! The compiler's debugging switches: `-d name[=value],...` on navi's
//! command line (before a "--"; as Go's -gcflags=-d=... and rustc's -Z),
//! taken out by main before the command sees its arguments. The switches
//! that change the code made are part of the caches' keys (key()), and
//! the processes navi starts to build get them again (args()).
//!
//! The programs' own runtime switches are NAVI_DEBUG's (std::rt).

/// The switches: name, whether it changes the code made, what it does.
const KNOWN: [(&str, bool, &str); 17] = [
    (
        "noescape",
        true,
        "no escape analysis: every local whose address is taken on the heap",
    ),
    (
        "noinline",
        true,
        "no inlining (nor escape analysis across calls)",
    ),
    ("noinline2", true, "no second round of inlining"),
    ("nocopyprop", true, "no MIR copy propagation"),
    (
        "nossaopt",
        true,
        "no SSA optimizations (fold, CSE, prove, LICM, fuse, dead stores)",
    ),
    ("nofold", true, "no SSA constant folding"),
    ("nofuse", true, "no SSA fusing of operations"),
    ("nopoll", true, "no preemption checks in loops"),
    (
        "llsc",
        true,
        "linux-arm64's atomics (LL/SC) on macOS too, to test them",
    ),
    (
        "checkstd",
        true,
        "check every function body of std (not only the ones used)",
    ),
    (
        "nostrip",
        false,
        "keep every function in the program (no dead code removal when merging)",
    ),
    (
        "ssacheck",
        false,
        "check each function's SSA form (=2: report what was not generated, =3: generate only)",
    ),
    (
        "ssadump",
        false,
        "=name: print the SSA form of the functions whose name contains name",
    ),
    ("ssatime", false, "print the time the SSA passes take"),
    (
        "escdebug",
        false,
        "print escape analysis' decisions (=name: of the functions whose name contains name)",
    ),
    (
        "fmtdebug",
        false,
        "navi fmt: print the document it lays out",
    ),
    (
        "linkmap",
        false,
        "=file: write each symbol's address there (PE)",
    ),
];

// The switches given, "name" or "name=value", in order.
static mut ON: Vec<String> = Vec::new();

/// Takes -d's out of args (up to a "--"), noting their switches; Err with a
/// message for an unknown one.
pub fn take(args: &Vec<String>) -> Result<Vec<String>, String> {
    let mut rest: Vec<String> = Vec::new();
    let mut i = 0;
    let mut after = false;
    while i < args.len() {
        let a = args[i].as_str();
        if after || a == "--" {
            after = true;
            rest.push(args[i].clone());
        } else if a == "-d" {
            if i + 1 >= args.len() {
                return Err("-d needs switches (navi help debug lists them)".to_string());
            }
            add(args[i + 1].as_str())?;
            i += 1;
        } else if let Some(v) = a.strip_prefix("-d=") {
            add(v)?;
        } else {
            rest.push(args[i].clone());
        }
        i += 1;
    }
    Ok(rest)
}

fn add(spec: &str) -> Result<(), String> {
    for part in spec.split(',') {
        if part.len() == 0 {
            continue;
        }
        let name = match part.find('=') {
            Some(k) => &part[..k],
            None => part,
        };
        if !KNOWN.iter().any(|k| k.0 == name) {
            return Err(`unknown -d switch ${name} (navi help debug lists them)`.to_string());
        }
        ON.push(part.to_string());
    }
    Ok(())
}

/// The value of switch name (the last given; "1" for a name alone).
pub fn value(name: &str) -> Option<String> {
    let mut found: Option<String> = None;
    for s in ON.iter() {
        match s.find('=') {
            Some(k) => {
                if &s[..k] == name {
                    found = Some(s[k + 1..].to_string());
                }
            }
            None => {
                if s.as_str() == name {
                    found = Some("1".to_string());
                }
            }
        }
    }
    found
}

/// Whether switch name is on (given, not as =0).
pub fn on(name: &str) -> bool {
    match value(name) {
        Some(v) => v != "0",
        None => false,
    }
}

/// The switches that change the code made, with their values, for the
/// caches' keys ("" if none).
pub fn key() -> String {
    let mut out = String::new();
    for k in KNOWN.iter() {
        if !k.1 {
            continue;
        }
        if let Some(v) = value(k.0) {
            out.push_str(k.0);
            out.push('=');
            out.push_str(v.as_str());
            out.push('\n');
        }
    }
    out
}

/// The -d arguments that give a process navi starts the same switches.
pub fn args() -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    if ON.len() > 0 {
        out.push("-d".to_string());
        out.push(ON.join(","));
    }
    out
}

/// navi help debug: the switches.
pub fn help() -> String {
    let mut out =
        "navi <command> -d name[=value],...: the compiler's debugging switches\n\n".to_string();
    for k in KNOWN.iter() {
        out.push_str(
            `  ${k.0}${" ".repeat(12 - k.0.len())}${k.2}\n`
                .to_string()
                .as_str(),
        );
    }
    out.push_str(
        "\nThe programs' runtime switches: NAVI_DEBUG=name[=value],... (as Go's GODEBUG):\n\n",
    );
    for k in RUNTIME.iter() {
        out.push_str(
            `  ${k.0}${" ".repeat(14 - k.0.len())}${k.1}\n`
                .to_string()
                .as_str(),
        );
    }
    out
}

/// NAVI_DEBUG's switches (read by std::rt; listed here for navi help).
const RUNTIME: [(&str, &str); 14] = [
    ("gctrace", "print a line per collection"),
    ("gcstw", "every collection stop-the-world"),
    (
        "gcverify",
        "after each concurrent mark, check that no reachable object was missed",
    ),
    (
        "gcpoison",
        "fill freed objects, and check they stay so (with gcstw)",
    ),
    ("gcconcstacks", "=0: scan the stacks with the world stopped"),
    (
        "gcminheap",
        "=bytes: the heap size below which no collection starts (testing)",
    ),
    (
        "memprof",
        "print samples of the live heap (tools/memprof.py sums them)",
    ),
    ("noslice", "no time slices"),
    ("sliceus", "=n: time slices of n microseconds"),
    (
        "stackmove",
        "move the stack at nearly every call (testing the stack maps)",
    ),
    (
        "stackcheck",
        "report the words of a moved stack still pointing into the old one",
    ),
    (
        "stackcons",
        "move stacks conservatively (any word that looks like an address in them)",
    ),
    ("stackprot", "keep freed stacks mapped and inaccessible"),
    (
        "noaes",
        "AES and SHA-2 in software even with the CPU's instructions",
    ),
];
