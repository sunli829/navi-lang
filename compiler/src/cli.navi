//! navi's command line, with std::cli's derive (as cargo's with clap's).
//! -d switches are taken out first (dflags), wherever they are.

use std::cli::{Parser, Subcommand, Args};

/// navi: build, test and document navi programs.
#[derive(Parser)]
#[command(name = "navi", arg_required_else_help, after_help = "Compiler switches: -d name[=value],... (navi help debug lists them).")]
pub struct Cli {
    #[command(subcommand)]
    pub cmd: Cmd,
}

#[derive(Subcommand)]
pub enum Cmd {
    /// Builds a program (to target/name), or checks a library
    Build(BuildArgs),
    /// Builds a program and runs it
    Run(RunArgs),
    /// Runs the tests: unit tests, tests/*.navi and a library's doctests
    Test(TestArgs),
    /// Runs the benchmarks (#[bench] functions)
    Bench(TestArgs),
    /// Writes the HTML documentation of a crate, its dependencies and std
    Doc(DocArgs),
    /// Makes a project in a new directory
    New(NewArgs),
    /// Makes a project in a directory (the current one by default)
    Init(NewArgs),
    /// Formats .navi files (as rustfmt)
    Fmt(FmtArgs),
    /// Brings navi.lock up to date with navi.toml
    Update {
        /// The project's directory
        path: Option<String>,
    },
    /// Prints what the derives of a crate expand to (formatted)
    Expand(ExpandArgs),
    /// Runs the language server (LSP) on stdin and stdout
    Lsp,
    // The compiler's own tools (navi help debug).
    #[command(hide, trailing_var_arg)]
    Parse {
        #[arg(allow_hyphen_values)]
        args: Vec<String>,
    },
    #[command(hide, trailing_var_arg)]
    ResolveDump {
        #[arg(allow_hyphen_values)]
        args: Vec<String>,
    },
    #[command(hide, trailing_var_arg)]
    TypesDump {
        #[arg(allow_hyphen_values)]
        args: Vec<String>,
    },
    #[command(hide, trailing_var_arg)]
    MirDump {
        #[arg(allow_hyphen_values)]
        args: Vec<String>,
    },
    #[command(hide, trailing_var_arg)]
    NavihCheck {
        #[arg(allow_hyphen_values)]
        args: Vec<String>,
    },
    #[command(hide, trailing_var_arg)]
    DeriveBuild {
        #[arg(allow_hyphen_values)]
        args: Vec<String>,
    },
    #[command(hide, trailing_var_arg)]
    AsmDump {
        #[arg(allow_hyphen_values)]
        args: Vec<String>,
    },
}

/// What every command that builds takes.
#[derive(Args, Clone)]
pub struct Common {
    /// The workspace member to use (its crate name)
    #[arg(short, value_name = "NAME")]
    pub p: Option<String>,
    /// The target to build for (os-arch, as linux-x64)
    #[arg(long, value_name = "OS-ARCH")]
    pub target: Option<String>,
    /// The linker: navi's own, or cc (the system's)
    #[arg(long, value_name = "navi|cc")]
    pub linker: Option<String>,
    /// A value std::build::var(name) gives (name=value; repeatable)
    #[arg(long, value_name = "NAME=VALUE")]
    pub var: Vec<String>,
    /// Prints how long each phase took
    #[arg(long)]
    pub timings: bool,
    // (Gone: one build mode, as Go.)
    #[arg(long, hide)]
    pub release: bool,
}

#[derive(Args)]
pub struct BuildArgs {
    #[command(flatten)]
    pub common: Common,
    /// The output file (one program)
    #[arg(short, value_name = "FILE")]
    pub o: Option<String>,
    /// Leaves out the debugging information (DWARF)
    #[arg(short)]
    pub s: bool,
    /// Writes an object file instead of linking
    #[arg(short)]
    pub c: bool,
    /// Builds again even if the build cache has the output
    #[arg(short)]
    pub a: bool,
    /// The crate's directory or a .navi file
    pub path: Option<String>,
}

#[derive(Args)]
pub struct RunArgs {
    #[command(flatten)]
    pub common: Common,
    /// Leaves out the debugging information (DWARF)
    #[arg(short)]
    pub s: bool,
    /// Builds again even if the build cache has the output
    #[arg(short)]
    pub a: bool,
    /// The crate's directory or a .navi file
    pub path: Option<String>,
    /// The program's arguments
    #[arg(last)]
    pub args: Vec<String>,
}

#[derive(Args)]
pub struct TestArgs {
    #[command(flatten)]
    pub common: Common,
    /// Builds the test programs and prints where they are
    #[arg(long)]
    pub no_run: bool,
    /// Runs only the doctests
    #[arg(long)]
    pub doc: bool,
    /// The paths tested at once (each in a process of its own)
    #[arg(short, long, value_name = "N")]
    pub jobs: Option<usize>,
    /// Kills a test program running longer (as 90s, 10m, 1h30m; 0: never)
    #[arg(long, value_name = "DURATION")]
    pub timeout: Option<String>,
    /// Directories or files to test, then a filter (the last, if it is no
    /// path): tests whose names contain it
    pub paths: Vec<String>,
    /// Arguments for the test programs (--test-threads=N, --nocapture)
    #[arg(last)]
    pub harness_args: Vec<String>,
}

#[derive(Args)]
pub struct DocArgs {
    /// The workspace member to document
    #[arg(short, value_name = "NAME")]
    pub p: Option<String>,
    /// Documents only the crate (not its dependencies and std)
    #[arg(long)]
    pub no_deps: bool,
    /// Opens the crate's page in the browser
    #[arg(long)]
    pub open: bool,
    /// The output directory (target/doc by default)
    #[arg(short, value_name = "DIR")]
    pub o: Option<String>,
    /// Prints how much of the crate's public API is documented and has
    /// examples, by file (writes no pages)
    #[arg(long)]
    pub show_coverage: bool,
    /// With --show-coverage: lists what has no documentation
    #[arg(long)]
    pub show_missing: bool,
    /// The crate's directory or a .navi file
    pub path: Option<String>,
}

#[derive(Args)]
pub struct NewArgs {
    /// Makes a library (src/lib.navi)
    #[arg(long)]
    pub lib: bool,
    /// Makes a program (src/main.navi; the default)
    #[arg(long)]
    pub bin: bool,
    /// The version control to set up: git or none
    #[arg(long, value_name = "git|none")]
    pub vcs: Option<String>,
    /// The crate's name (the directory's by default)
    #[arg(long, value_name = "NAME")]
    pub name: Option<String>,
    /// The directory
    pub path: Option<String>,
}

#[derive(Args)]
pub struct FmtArgs {
    /// Reports files that are not formatted instead of writing them
    #[arg(long)]
    pub check: bool,
    /// The width comments are wrapped to
    #[arg(long, value_name = "N")]
    pub comment_width: Option<usize>,
    /// Files or directories (- for stdin)
    pub paths: Vec<String>,
}

#[derive(Args)]
pub struct ExpandArgs {
    #[command(flatten)]
    pub common: Common,
    /// The crate's directory or a .navi file, then a type's name
    pub args: Vec<String>,
}
