//! The format-neutral object file model the backends fill and the Mach-O
//! (and later ELF and COFF) writers encode.

use std::collections::HashMap;

pub type Section = usize;
/// Code.
pub const TEXT: Section = 0;
/// Read-only bytes without pointers.
pub const RO_DATA: Section = 1;
/// Read-only data with relocated pointers.
pub const DATA_CONST: Section = 2;
/// Writable data.
pub const DATA: Section = 3;
pub const NUM_SECTIONS: usize = 4;

pub type RelocKind = u8;
/// arm64 bl/b.
pub const BRANCH26: RelocKind = 0;
/// arm64 adrp.
pub const PAGE21: RelocKind = 1;
/// arm64 add (low 12 bits).
pub const PAGE_OFF12: RelocKind = 2;
/// 64-bit absolute address.
pub const ABS64: RelocKind = 3;
/// amd64 call rel32.
pub const CALL32: RelocKind = 4;
/// amd64 rip-relative rel32 (lea).
pub const PC32: RelocKind = 5;

/// A relocation at off in section sec against sym.
#[derive(Clone)]
pub struct Reloc {
    pub sec: Section,
    pub off: u32,
    pub kind: RelocKind,
    pub sym: String,
}

/// A symbol defined in the object.
#[derive(Clone)]
pub struct Symbol {
    pub name: String,
    pub sec: Section,
    pub off: u64,
    pub global: bool,
}

/// A row of the line table: code at off (in TEXT) comes from file:line.
#[derive(Clone)]
pub struct Line {
    pub off: u64,
    pub file: String,
    pub line: u32,
}

/// A function's code range in TEXT, for debug information.
#[derive(Clone)]
pub struct FuncRange {
    pub name: String,
    pub off: u64,
    pub size: u64,
}

/// The contents of an object file.
pub struct Object {
    /// "arm64" or "amd64".
    pub arch: String,
    pub sects: Vec<Vec<u8>>,
    /// log2 of each section's alignment.
    pub align: Vec<u32>,
    pub syms: Vec<Symbol>,
    pub relocs: Vec<Reloc>,
    pub undef: HashMap<String, bool>,
    /// Debug information (debug builds): the line table and functions.
    pub lines: Vec<Line>,
    pub funcs: Vec<FuncRange>,
}

/// An empty object for arch.
pub fn new_object(arch: &str) -> &mut Object {
    let mut sects = Vec::new();
    let mut i = 0;
    while i < NUM_SECTIONS { sects.push(Vec::new()); i += 1; }
    let mut align = Vec::new();
    align.push(if arch == "amd64" { 4 } else { 2 });
    align.push(3);
    align.push(3);
    align.push(3);
    &mut Object { arch: arch.to_string(), sects, align, syms: Vec::new(), relocs: Vec::new(), undef: HashMap::new(), lines: Vec::new(), funcs: Vec::new() }
}

impl Object {
    /// Adds a symbol at the current end of sec (after aligning it).
    pub fn define(&mut self, name: &str, sec: Section, align: usize, global: bool) -> u64 {
        let mut s = self.sects[sec];
        while s.len() % align != 0 { s.push(0); }
        let off = s.len() as u64;
        self.syms.push(Symbol { name: name.to_string(), sec, off, global });
        off
    }

    /// Appends bytes to a section.
    pub fn append(&mut self, sec: Section, b: &[u8]) {
        let mut s = self.sects[sec];
        s.extend_from_slice(b);
    }

    /// Appends n zero bytes to a section.
    pub fn zeros(&mut self, sec: Section, n: i64) {
        let mut s = self.sects[sec];
        let mut i = 0;
        while i < n { s.push(0); i += 1; }
    }

    /// Declares an external symbol.
    pub fn undefined(&mut self, name: &str) { self.undef.insert(name.to_string(), true); }

    /// Records a relocation.
    pub fn reloc(&mut self, sec: Section, off: u32, kind: RelocKind, sym: &str) {
        self.relocs.push(Reloc { sec, off, kind, sym: sym.to_string() });
    }
}
