//! The format-neutral object file model the backends fill and the Mach-O
//! (and later ELF and COFF) writers encode.

use std::collections::HashMap;

pub type Section = usize;
/// Code.
pub const TEXT: Section = 0;
/// Read-only bytes without pointers.
pub const RO_DATA: Section = 1;
/// Read-only data with relocated pointers.
pub const DATA_CONST: Section = 2;
/// Writable data.
pub const DATA: Section = 3;
pub const NUM_SECTIONS: usize = 4;

pub type RelocKind = u8;
/// arm64 bl/b.
pub const BRANCH26: RelocKind = 0;
/// arm64 adrp.
pub const PAGE21: RelocKind = 1;
/// arm64 add (low 12 bits).
pub const PAGE_OFF12: RelocKind = 2;
/// 64-bit absolute address.
pub const ABS64: RelocKind = 3;
/// amd64 call rel32.
pub const CALL32: RelocKind = 4;
/// amd64 rip-relative rel32 (lea, mov).
pub const PC32: RelocKind = 5;
/// arm64 ldr of a 64-bit word (low 12 bits, scaled): Mach-O treats it as
/// PAGE_OFF12, ELF has a type of its own.
pub const PAGE_OFF12_LD64: RelocKind = 6;
/// No bytes: the function at off calls the dyn method sym names
/// (codegen::dyn_key) through a vtable. crate::merge keeps a vtable's slot
/// for that method only if a function reached has one (as Go's linker's
/// R_USEIFACEMETHOD); it writes none of these.
pub const DYN_USE: RelocKind = 7;
/// No bytes: the vtable slot at off (its code word, then its context
/// word) is the dyn method sym names.
pub const DYN_SLOT: RelocKind = 8;

/// A relocation at off in section sec against sym.
#[derive(Clone)]
pub struct Reloc {
    pub sec: Section,
    pub off: u32,
    pub kind: RelocKind,
    pub sym: String,
}

/// A relocation in an object: at off in section sec against the symbol
/// numbered sym (Object.names).
#[derive(Clone)]
pub struct SymReloc {
    pub sec: Section,
    pub off: u32,
    pub kind: RelocKind,
    pub sym: u32,
}

/// A symbol defined in the object.
#[derive(Clone)]
pub struct Symbol {
    pub name: String,
    pub id: u32,
    pub sec: Section,
    pub off: u64,
    pub global: bool,
}

/// A row of the line table: code at off (in TEXT) comes from file:line.
#[derive(Clone)]
pub struct Line {
    pub off: u64,
    /// Index into Object.files.
    pub file: u32,
    pub line: u32,
}

/// A function's code range in TEXT, for debug information.
#[derive(Clone)]
pub struct FuncRange {
    pub name: String,
    pub off: u64,
    pub size: u64,
}

/// The contents of an object file.
pub struct Object {
    /// "arm64" or "amd64".
    pub arch: String,
    pub sects: Vec<Vec<u8>>,
    /// log2 of each section's alignment.
    pub align: Vec<u32>,
    pub syms: Vec<Symbol>,
    pub relocs: Vec<SymReloc>,
    /// Every symbol name used, by number (relocations refer to numbers, so
    /// the linker looks nothing up by name).
    pub names: Vec<String>,
    pub ids: HashMap<String, u32>,
    pub undef: HashMap<String, bool>,
    /// The library of an undefined symbol from #[link] ("kind:name"; none:
    /// the system C library).
    pub libs: HashMap<String, String>,
    /// Debug information (debug builds): the line table and functions.
    pub lines: Vec<Line>,
    /// The files lines are in, in the order of their first line.
    pub files: Vec<String>,
    pub file_ix: HashMap<String, u32>,
    pub funcs: Vec<FuncRange>,
    /// amd64: each function with a frame (offset, size, where its prologue
    /// pushes the frame pointer), for Windows' unwind tables.
    pub frames: Vec<(u64, u64, u64)>,
}

/// An empty object for arch.
pub fn new_object(arch: &str) -> &mut Object {
    let mut sects = Vec::new();
    let mut i = 0;
    while i < NUM_SECTIONS {
        sects.push(Vec::new());
        i += 1;
    }
    let mut align = Vec::new();
    align.push(if arch == "amd64" { 4 } else { 2 });
    align.push(3);
    align.push(3);
    align.push(3);
    &mut Object {
        arch: arch.to_string(),
        sects,
        align,
        syms: Vec::new(),
        relocs: Vec::new(),
        names: Vec::new(),
        ids: HashMap::new(),
        undef: HashMap::new(),
        libs: HashMap::new(),
        lines: Vec::new(),
        files: Vec::new(),
        file_ix: HashMap::new(),
        funcs: Vec::new(),
        frames: Vec::new(),
    }
}

impl Object {
    /// Adds a symbol at the current end of sec (after aligning it).
    pub fn define(&mut self, name: &str, sec: Section, align: usize, global: bool) -> u64 {
        let mut s = self.sects[sec];
        while s.len() % align != 0 {
            s.push(0);
        }
        let off = s.len() as u64;
        let id = self.id(name);
        self.syms.push(Symbol {
            name: name.to_string(),
            id,
            sec,
            off,
            global,
        });
        off
    }

    /// Defines a symbol at off in sec (another name for code already
    /// placed or about to be).
    pub fn define_at(&mut self, name: &str, sec: Section, off: u64, global: bool) {
        let id = self.id(name);
        self.syms.push(Symbol {
            name: name.to_string(),
            id,
            sec,
            off,
            global,
        });
    }

    /// The number of a symbol name.
    pub fn id(&mut self, name: &str) -> u32 {
        self.id_s(&name.to_string())
    }

    /// id for a name already in a String (no copy unless it is new).
    pub fn id_s(&mut self, name: &String) -> u32 {
        if let Some(i) = self.ids.get(name) {
            return *i;
        }
        let i = self.names.len() as u32;
        self.names.push(name.clone());
        self.ids.insert(name.clone(), i);
        i
    }

    /// The index of a file in files (added the first time).
    pub fn file_id(&mut self, name: &String) -> u32 {
        if let Some(i) = self.file_ix.get(name) {
            return *i;
        }
        let i = self.files.len() as u32;
        self.files.push(name.clone());
        self.file_ix.insert(name.clone(), i);
        i
    }

    /// Appends bytes to a section.
    pub fn append(&mut self, sec: Section, b: &[u8]) {
        let mut s = self.sects[sec];
        s.extend_from_slice(b);
    }

    /// Appends n zero bytes to a section.
    pub fn zeros(&mut self, sec: Section, n: i64) {
        let mut s = self.sects[sec];
        let mut i = 0;
        while i < n {
            s.push(0);
            i += 1;
        }
    }

    /// Declares an external symbol.
    pub fn undefined(&mut self, name: &str) {
        self.undef.insert(name.to_string(), true);
    }

    /// Records that undefined symbol name comes from library lib.
    pub fn import_from(&mut self, name: &str, lib: &str) {
        self.libs.insert(name.to_string(), lib.to_string());
    }

    /// The libraries of the undefined symbols, sorted.
    pub fn libraries(&self) -> Vec<String> {
        let mut out: Vec<String> = Vec::new();
        for l in self.libs.values() {
            if !out.contains(l) {
                out.push(l.clone());
            }
        }
        out.sort();
        out
    }

    /// Records a relocation.
    pub fn reloc(&mut self, sec: Section, off: u32, kind: RelocKind, sym: &str) {
        let id = self.id(sym);
        self.relocs.push(SymReloc {
            sec,
            off,
            kind,
            sym: id,
        });
    }

    pub fn reloc_id(&mut self, sec: Section, off: u32, kind: RelocKind, sym: u32) {
        self.relocs.push(SymReloc {
            sec,
            off,
            kind,
            sym,
        });
    }
}

/// The file a library ("kind:name", see Object::libs) is on os: on macOS a
/// dylib's install name (/usr/lib/libNAME.dylib unless a path is given) or a
/// framework's binary, on Linux the DT_NEEDED name (libNAME.so unless a
/// file name with .so is given), on Windows the DLL (NAME.dll).
pub fn lib_file(spec: &str, os: &str) -> Result<String, String> {
    let (kind, name) = match spec.split_once(':') {
        Some(p) => p,
        None => ("dylib", spec),
    };
    if os == "macos" {
        if kind == "framework" {
            if name.contains('/') {
                return Ok(name.to_string());
            }
            return Ok(`/System/Library/Frameworks/${name}.framework/${name}`.to_string());
        }
        if name.contains('/') || name.starts_with("@") {
            return Ok(name.to_string());
        }
        return Ok(`/usr/lib/lib${name}.dylib`.to_string());
    }
    if kind == "framework" {
        return Err(`link: framework ${name} outside macOS`.to_string());
    }
    if os == "windows" {
        if name.to_lowercase().ends_with(".dll") {
            return Ok(name.to_string());
        }
        return Ok(`${name}.dll`.to_string());
    }
    if name.contains(".so") || name.contains('/') {
        return Ok(name.to_string());
    }
    Ok(`lib${name}.so`.to_string())
}
