//! The derive macros of [`std::cli`](super): `#[derive(Parser)]`,
//! `#[derive(Args)]`, `#[derive(Subcommand)]` and `#[derive(ValueEnum)]`,
//! as clap's derive API.
//!
//! The macros are re-exported from `std::cli` together with the traits of
//! the same names, so `use std::cli::Parser;` brings in both. They generate
//! code on the builder API of `std::cli` ([`Command`](super::Command),
//! [`Arg`](super::Arg)), as clap's do.
//!
//! - `Parser`, on a struct, implements
//!   [`CommandFactory`](super::CommandFactory) (the command, named by
//!   `#[command(name = "...")]` or the package's name), [`Args`](super::Args),
//!   [`FromArgMatches`](super::FromArgMatches) and [`Parser`](super::Parser)
//!   (`parse`, `try_parse`, `parse_from`, `try_parse_from`).
//! - `Args`, on a struct, implements [`Args`](super::Args) and
//!   [`FromArgMatches`](super::FromArgMatches): a group of arguments for a
//!   `#[command(flatten)]` field or a subcommand variant.
//! - `Subcommand`, on an enum, makes a subcommand of each variant, named
//!   by the variant in kebab-case or by `#[command(name = "...")]`. A unit
//!   variant takes no arguments; a variant with named fields takes them as
//!   a struct's fields; a variant with one unnamed field takes that type's
//!   arguments (an `Args` type, or with `#[command(subcommand)]` a
//!   `Subcommand` type, for nested subcommands).
//! - `ValueEnum`, on an enum of unit variants, implements
//!   [`ValueEnum`](super::ValueEnum), `FromStr` and `Display` with the
//!   variants' names in kebab-case, or `#[value(name = "...")]`.
//!
//! # Fields
//!
//! As in clap, a field's type says what kind of argument it is:
//!
//! | Type        | Argument                                                      |
//! |-------------|---------------------------------------------------------------|
//! | `bool`      | a flag ([`ArgAction::SetTrue`](super::ArgAction::SetTrue))    |
//! | `Option<T>` | optional                                                      |
//! | `Vec<T>`    | any number of values ([`ArgAction::Append`](super::ArgAction::Append)) |
//! | other `T`   | required, unless it has a `default_value`                     |
//!
//! Values are converted to `T` with `FromStr`; integer and float fields
//! are also checked while the command line is parsed (a value out of an
//! integer type's range is an error then). A field without `short` or
//! `long` is a positional. Its `///` comment is the help: the first
//! paragraph, with one trailing period dropped, is the help, and the whole
//! comment the long help. The `///` comment of the type is the command's
//! about.
//!
//! # Attributes
//!
//! `#[command(...)]` on the type or a subcommand variant:
//! - `name = "..."`, `version = "..."`, `about = "..."`,
//!   `author = "..."`; `version`, `about` and `author` alone take the
//!   package's (from `std::build`, as clap's take Cargo's);
//! - `long_about = "..."`, `after_help = "..."`;
//! - `arg_required_else_help`, `disable_help_flag`,
//!   `disable_version_flag`, `hide` (a subcommand left out of the help),
//!   `trailing_var_arg`.
//!
//! `#[command(...)]` on a field: `subcommand` (the field is a
//! `Subcommand` enum, or an `Option` of one when it may be left out) or
//! `flatten` (the field is an `Args` struct whose arguments are added).
//!
//! `#[arg(...)]` on a field:
//! - `short` (the field name's first letter) or `short = 'c'`; `long` (the
//!   field name in kebab-case) or `long = "name"`;
//! - `help`, `long_help`, `default_value`, `required`, `value_name`
//!   (default: the field name in capitals), `env`, `alias`, `short_alias`,
//!   `hide`, `conflicts_with`, `requires`, `global`, `value_delimiter`,
//!   `last`, `allow_hyphen_values`, `id`: as the [`Arg`](super::Arg)
//!   methods of the same names;
//! - `action = ArgAction::Count` (or another [`ArgAction`](super::ArgAction));
//! - `value_enum`: the field's type is a `ValueEnum`, whose names are the
//!   possible values;
//! - `skip`: not an argument; the field is `Default::default()`.
//!
//! # Examples
//!
//! ```
//! use std::cli::{Args, Parser, Subcommand, ValueEnum};
//!
//! #[derive(Parser, Debug)]
//! #[command(name = "tool", version = "1.0")]
//! /// A build tool.
//! struct Cli {
//!     /// Print more (repeat for even more)
//!     #[arg(short, action = std::cli::ArgAction::Count)]
//!     verbose: u8,
//!     #[command(subcommand)]
//!     command: Commands,
//! }
//!
//! #[derive(Subcommand, Debug, PartialEq)]
//! enum Commands {
//!     /// Builds the project
//!     Build {
//!         #[arg(long, value_enum, default_value = "debug")]
//!         profile: Profile,
//!         /// Only these packages
//!         packages: Vec<String>,
//!     },
//!     /// Runs the tests
//!     Test(TestArgs),
//! }
//!
//! #[derive(Args, Debug, PartialEq)]
//! struct TestArgs {
//!     #[arg(long, default_value = "60")]
//!     timeout: u32,
//!     filter: Option<String>,
//! }
//!
//! #[derive(ValueEnum, Clone, Debug, PartialEq)]
//! enum Profile {
//!     Debug,
//!     Release,
//! }
//!
//! let cli = Cli::parse_from(["tool", "-vv", "build", "--profile", "release", "core"]);
//! assert_eq(cli.verbose, 2);
//! assert_eq(cli.command, Commands::Build {
//!     profile: Profile::Release,
//!     packages: Vec::from(["core".to_string()]),
//! });
//!
//! let cli = Cli::parse_from(["tool", "test", "parse"]);
//! assert_eq(cli.command, Commands::Test(TestArgs { timeout: 60, filter: Some("parse".to_string()) }));
//! ```

use crate::derive::{
    AttrArgs, AttrValue, Code, Error, Field, FromAttrValue, FromAttrs, Kind, TypeInfo, TypeRef,
    Variant, quote,
};

fn c(text: &str) -> Code {
    Code::from_text(text)
}

// --- Attributes --------------------------------------------------------------------

// #[arg(short)] or #[arg(short = 'c')] (long: = "name"): the key alone,
// or a value.
enum Spec {
    Auto,
    Given(String),
}

impl FromAttrValue for Spec {
    fn from_value(v: &AttrValue) -> Option<Spec> {
        match v {
            AttrValue::Str(s, _) => Some(Spec::Given(s.clone())),
            // 'c', as written.
            AttrValue::Other(t, _) => {
                let b = t.as_bytes();
                if b.len() >= 3 && b[0] == b'\'' && b[b.len() - 1] == b'\'' {
                    Some(Spec::Given(t[1..t.len() - 1].to_string()))
                } else {
                    None
                }
            }
            _ => None,
        }
    }
    fn from_word() -> Option<Spec> {
        Some(Spec::Auto)
    }
    fn expected() -> &str {
        "a character or a string"
    }
}

// #[arg(action = ...)]: an ArgAction as the user wrote it, where they
// wrote it (read in their module).
struct ActionCode(String, i32);

impl FromAttrValue for ActionCode {
    fn from_value(v: &AttrValue) -> Option<ActionCode> {
        match v {
            AttrValue::Other(t, p) => Some(ActionCode(t.clone(), *p)),
            _ => None,
        }
    }
    fn expected() -> &str {
        "an ArgAction"
    }
}

// #[command(...)] on a type or a variant.
struct CommandAttrs {
    name: Option<String>,
    version: Option<Spec>,
    about: Option<Spec>,
    long_about: Option<String>,
    author: Option<Spec>,
    after_help: Option<String>,
    arg_required_else_help: bool,
    disable_help_flag: bool,
    disable_version_flag: bool,
    hide: bool,
    trailing_var_arg: bool,
}

impl FromAttrs for CommandAttrs {
    fn from_attrs(a: &mut AttrArgs) -> Result<CommandAttrs, Error> {
        Ok(CommandAttrs {
            name: a.get::<Option<String>>("name")?,
            version: a.get::<Option<Spec>>("version")?,
            about: a.get::<Option<Spec>>("about")?,
            long_about: a.get::<Option<String>>("long_about")?,
            author: a.get::<Option<Spec>>("author")?,
            after_help: a.get::<Option<String>>("after_help")?,
            arg_required_else_help: a.get::<bool>("arg_required_else_help")?,
            disable_help_flag: a.get::<bool>("disable_help_flag")?,
            disable_version_flag: a.get::<bool>("disable_version_flag")?,
            hide: a.get::<bool>("hide")?,
            trailing_var_arg: a.get::<bool>("trailing_var_arg")?,
        })
    }
}

// #[command(...)] on a field.
struct FieldCommand {
    subcommand: bool,
    flatten: bool,
}

impl FromAttrs for FieldCommand {
    fn from_attrs(a: &mut AttrArgs) -> Result<FieldCommand, Error> {
        Ok(FieldCommand {
            subcommand: a.get::<bool>("subcommand")?,
            flatten: a.get::<bool>("flatten")?,
        })
    }
}

// #[arg(...)] on a field.
struct ArgAttrs {
    id: Option<String>,
    short: Option<Spec>,
    long: Option<Spec>,
    help: Option<String>,
    long_help: Option<String>,
    default_value: Option<String>,
    required: bool,
    value_name: Option<String>,
    env: Option<String>,
    alias: Option<String>,
    short_alias: Option<Spec>,
    hide: bool,
    conflicts_with: Option<String>,
    requires: Option<String>,
    global: bool,
    value_delimiter: Option<Spec>,
    action: Option<ActionCode>,
    value_enum: bool,
    skip: bool,
    last: bool,
    allow_hyphen_values: bool,
}

impl FromAttrs for ArgAttrs {
    fn from_attrs(a: &mut AttrArgs) -> Result<ArgAttrs, Error> {
        Ok(ArgAttrs {
            id: a.get::<Option<String>>("id")?,
            short: a.get::<Option<Spec>>("short")?,
            long: a.get::<Option<Spec>>("long")?,
            help: a.get::<Option<String>>("help")?,
            long_help: a.get::<Option<String>>("long_help")?,
            default_value: a.get::<Option<String>>("default_value")?,
            required: a.get::<bool>("required")?,
            value_name: a.get::<Option<String>>("value_name")?,
            env: a.get::<Option<String>>("env")?,
            alias: a.get::<Option<String>>("alias")?,
            short_alias: a.get::<Option<Spec>>("short_alias")?,
            hide: a.get::<bool>("hide")?,
            conflicts_with: a.get::<Option<String>>("conflicts_with")?,
            requires: a.get::<Option<String>>("requires")?,
            global: a.get::<bool>("global")?,
            value_delimiter: a.get::<Option<Spec>>("value_delimiter")?,
            action: a.get::<Option<ActionCode>>("action")?,
            value_enum: a.get::<bool>("value_enum")?,
            skip: a.get::<bool>("skip")?,
            last: a.get::<bool>("last")?,
            allow_hyphen_values: a.get::<bool>("allow_hyphen_values")?,
        })
    }
}

// #[value(...)] on a ValueEnum's variant.
struct ValueAttrs {
    name: Option<String>,
}

impl FromAttrs for ValueAttrs {
    fn from_attrs(a: &mut AttrArgs) -> Result<ValueAttrs, Error> {
        Ok(ValueAttrs {
            name: a.get::<Option<String>>("name")?,
        })
    }
}

// --- Names and help ----------------------------------------------------------------

// A field's or variant's name in kebab-case (clap's default): snake_case
// and CamelCase alike.
fn kebab(name: &str) -> String {
    let mut out = String::new();
    for (i, ch) in name.chars().enumerate() {
        if ch == '_' {
            out.push('-');
        } else if ch.is_uppercase() {
            if i > 0 && !out.ends_with("-") {
                out.push('-');
            }
            for l in ch.to_lowercase() {
                out.push(l);
            }
        } else {
            out.push(ch);
        }
    }
    out
}

// A doc comment as clap takes it: the first paragraph (lines joined, one
// trailing period dropped) and, when there is more, all of it.
fn split_doc(doc: &Option<String>) -> (Option<String>, Option<String>) {
    let d = match doc {
        Some(d) => d.trim().to_string(),
        None => return (None, None),
    };
    if d.len() == 0 {
        return (None, None);
    }
    let mut first: Vec<String> = Vec::new();
    let mut more = false;
    for l in d.lines() {
        if l.trim().len() == 0 {
            more = true;
            break;
        }
        first.push(l.trim().to_string());
    }
    let mut head = first.join(" ");
    if head.ends_with(".") && !head.ends_with("..") {
        head.pop();
    }
    (Some(head), if more { Some(d) } else { None })
}

// --- Fields ------------------------------------------------------------------------

// What a field's type makes it.
enum Shape {
    Flag,
    Optional(TypeRef),
    Many(TypeRef),
    One(TypeRef),
}

fn shape(t: &TypeRef) -> Shape {
    if t.is("bool") {
        return Shape::Flag;
    }
    let args = t.args();
    if args.len() == 1 {
        match t.last_name() {
            Some("Option") => return Shape::Optional(args[0].clone()),
            Some("Vec") => return Shape::Many(args[0].clone()),
            _ => {}
        }
    }
    Shape::One(t.clone())
}

// The value parser for values of t (checked as the command line is read),
// if t is a number.
fn parser_for(t: &TypeRef) -> Option<Code> {
    let name = match t.last_name() {
        Some(n) => n.to_string(),
        None => return None,
    };
    if !t.is(name.as_str()) {
        return None;
    }
    match name.as_str() {
        "i8" | "i16" | "i32" | "i64" | "isize" => {
            Some(quote`::std::cli::ValueParser::i64_range(${t}::MIN as i64, ${t}::MAX as i64)`)
        }
        "u8" | "u16" | "u32" | "u64" | "usize" => {
            Some(quote`::std::cli::ValueParser::u64_range(0, ${t}::MAX as u64)`)
        }
        "f32" | "f64" => Some(quote`::std::cli::ValueParser::f64()`),
        _ => None,
    }
}

// A field's role in a struct (or a variant with named fields).
enum Role {
    Skip,
    Sub(Shape),
    Flatten(TypeRef),
    Arg(ArgAttrs, Shape),
}

fn role(f: &Field) -> Result<Role, Error> {
    let fc: FieldCommand = f.parse_attrs("command")?;
    let aa: ArgAttrs = f.parse_attrs("arg")?;
    if fc.subcommand && fc.flatten {
        return Err(Error::at(f, "subcommand and flatten together"));
    }
    if fc.subcommand {
        return match shape(f.ty()) {
            Shape::One(t) => Ok(Role::Sub(Shape::One(t))),
            Shape::Optional(t) => Ok(Role::Sub(Shape::Optional(t))),
            _ => Err(Error::at(
                f,
                "a subcommand field is an enum deriving Subcommand, or an Option of one",
            )),
        };
    }
    if fc.flatten {
        return Ok(Role::Flatten(f.ty().clone()));
    }
    if aa.skip {
        return Ok(Role::Skip);
    }
    if f.name().is_none() {
        return Err(Error::at(f, "arguments are named fields"));
    }
    let s = shape(f.ty());
    Ok(Role::Arg(aa, s))
}

fn id_of(f: &Field, aa: &ArgAttrs) -> String {
    match &aa.id {
        Some(i) => i.clone(),
        None => `${f.ident()}`.to_string(),
    }
}

// The Arg of field f: Arg::new(id) and its settings.
fn arg_code(f: &Field, aa: &ArgAttrs, s: &Shape) -> Result<Code, Error> {
    let name = `${f.ident()}`.to_string();
    let id = id_of(f, aa);
    let mut a = quote`::std::cli::Arg::new(${id})`.at(f);
    match &aa.short {
        Some(Spec::Auto) => {
            let ch = name.chars().next().unwrap();
            a = quote`${a}.short(${ch})`;
        }
        Some(Spec::Given(g)) => {
            let ch = match g.chars().next() {
                Some(x) => x,
                None => return Err(Error::at(f, "short needs a character")),
            };
            a = quote`${a}.short(${ch})`;
        }
        None => {}
    }
    match &aa.long {
        Some(Spec::Auto) => {
            let l = kebab(name.as_str());
            a = quote`${a}.long(${l})`;
        }
        Some(Spec::Given(g)) => a = quote`${a}.long(${g.clone()})`,
        None => {}
    }
    let (help, long) = split_doc(&f.doc());
    match (&aa.help, help) {
        (Some(h), _) => a = quote`${a}.help(${h.clone()})`,
        (None, Some(h)) => a = quote`${a}.help(${h})`,
        _ => {}
    }
    match (&aa.long_help, long) {
        (Some(h), _) => a = quote`${a}.long_help(${h.clone()})`,
        (None, Some(h)) => a = quote`${a}.long_help(${h})`,
        _ => {}
    }
    let inner = match s {
        Shape::Flag => {
            if aa.action.is_none() {
                a = quote`${a}.action(::std::cli::ArgAction::SetTrue)`;
            }
            None
        }
        Shape::Optional(t) => Some(t.clone()),
        Shape::Many(t) => {
            if aa.action.is_none() {
                a = quote`${a}.action(::std::cli::ArgAction::Append)`;
            }
            if aa.short.is_none() && aa.long.is_none() {
                a = quote`${a}.num_args(1..)`;
            }
            Some(t.clone())
        }
        Shape::One(t) => {
            if aa.default_value.is_none() && aa.action.is_none() {
                a = quote`${a}.required(true)`;
            }
            Some(t.clone())
        }
    };
    if let Some(t) = &inner {
        if aa.value_enum {
            a = quote`${a}.value_parser(::std::cli::ValueParser::possible(<${t} as ::std::cli::ValueEnum>::value_names().as_slice()))`;
        } else if aa.action.is_none() {
            if let Some(p) = parser_for(t) {
                a = quote`${a}.value_parser(${p})`;
            }
        }
    }
    if let Some(act) = &aa.action {
        let x = Code::spanned(act.0.as_str(), act.1);
        a = quote`${a}.action(${x})`;
    }
    if aa.required {
        a = quote`${a}.required(true)`;
    }
    if let Some(v) = &aa.default_value {
        a = quote`${a}.default_value(${v.clone()})`;
    }
    // (clap's default value name: the field's in capitals.)
    match &aa.value_name {
        Some(v) => a = quote`${a}.value_name(${v.clone()})`,
        None => {
            if inner.is_some() && aa.action.is_none() {
                let up = name.to_uppercase();
                a = quote`${a}.value_name(${up})`;
            }
        }
    }
    if let Some(v) = &aa.env {
        a = quote`${a}.env(${v.clone()})`;
    }
    if let Some(v) = &aa.alias {
        a = quote`${a}.alias(${v.clone()})`;
    }
    if let Some(Spec::Given(g)) = &aa.short_alias {
        let ch = g.chars().next().unwrap_or('?');
        a = quote`${a}.short_alias(${ch})`;
    }
    if aa.hide {
        a = quote`${a}.hide(true)`;
    }
    if let Some(v) = &aa.conflicts_with {
        a = quote`${a}.conflicts_with(${v.clone()})`;
    }
    if let Some(v) = &aa.requires {
        a = quote`${a}.requires(${v.clone()})`;
    }
    if aa.global {
        a = quote`${a}.global(true)`;
    }
    if aa.last {
        a = quote`${a}.last(true)`;
    }
    if aa.allow_hyphen_values {
        a = quote`${a}.allow_hyphen_values(true)`;
    }
    if let Some(Spec::Given(g)) = &aa.value_delimiter {
        let ch = g.chars().next().unwrap_or(',');
        a = quote`${a}.value_delimiter(${ch})`;
    }
    Ok(a)
}

// Statements adding fields' arguments (and subcommands) to cmd.
fn augment(fields: &Vec<Field>) -> Result<Code, Error> {
    let mut out: Vec<Code> = Vec::new();
    for f in fields.iter() {
        match role(f)? {
            Role::Skip => {}
            Role::Sub(s) => match s {
                Shape::One(t) => out.push(quote`let cmd = <${t} as ::std::cli::Subcommand>::augment_subcommands(cmd).subcommand_required(true).arg_required_else_help(true);`),
                Shape::Optional(t) => out.push(quote`let cmd = <${t} as ::std::cli::Subcommand>::augment_subcommands(cmd);`),
                _ => {}
            },
            Role::Flatten(t) => out.push(quote`let cmd = <${t} as ::std::cli::Args>::augment_args(cmd);`),
            Role::Arg(aa, s) => {
                let a = arg_code(f, &aa, &s)?;
                out.push(quote`let cmd = cmd.arg(${a});`);
            }
        }
    }
    Ok(quote`${out}`)
}

// The value of each field read from m: (field, expression).
fn field_values(fields: &Vec<Field>) -> Result<Vec<Code>, Error> {
    let mut out: Vec<Code> = Vec::new();
    for f in fields.iter() {
        let v = match role(f)? {
            Role::Skip => quote`::std::default::Default::default()`,
            Role::Sub(s) => match s {
                Shape::Optional(t) => {
                    quote`if m.subcommand_name().is_some() { Some(<${t} as ::std::cli::FromArgMatches>::from_arg_matches(m)?) } else { None }`
                }
                Shape::One(t) => quote`<${t} as ::std::cli::FromArgMatches>::from_arg_matches(m)?`,
                _ => quote`::std::default::Default::default()`,
            },
            Role::Flatten(t) => quote`<${t} as ::std::cli::FromArgMatches>::from_arg_matches(m)?`,
            Role::Arg(aa, s) => {
                let id = id_of(f, &aa);
                let counting = match &aa.action {
                    Some(r) => r.0.ends_with("Count"),
                    None => false,
                };
                if counting {
                    let t = f.ty();
                    quote`m.get_count(${id}) as ${t}`
                } else {
                    match s {
                        Shape::Flag => quote`m.get_flag(${id})`,
                        Shape::Optional(t) => quote`::std::cli::derive::one::<${t}>(m, ${id})?`,
                        Shape::Many(t) => quote`::std::cli::derive::many::<${t}>(m, ${id})?`,
                        Shape::One(t) => quote`::std::cli::derive::required::<${t}>(m, ${id})?`,
                    }
                }
            }
        };
        out.push(v.at(f));
    }
    Ok(out)
}

// The value of variant (or struct) v made from m's fields.
fn construct(v: &Variant) -> Result<Code, Error> {
    let path = v.path();
    let vals = field_values(v.fields())?;
    match v.kind() {
        Kind::Unit => Ok(path),
        Kind::Tuple => {
            let mut parts: Vec<Code> = Vec::new();
            for (i, x) in vals.iter().enumerate() {
                if i > 0 {
                    parts.push(c(","));
                }
                parts.push(x.clone());
            }
            Ok(quote`${path}(${parts})`)
        }
        Kind::Named => {
            let mut parts: Vec<Code> = Vec::new();
            for (i, f) in v.fields().iter().enumerate() {
                let x = vals[i].clone();
                let n = f.ident();
                parts.push(quote`${n}: ${x},`);
            }
            Ok(quote`${path} { ${parts} }`)
        }
    }
}

// The struct's Args and FromArgMatches.
fn args_impls(t: &TypeInfo) -> Result<Code, Error> {
    if t.is_enum() {
        return Err(Error::at(
            t,
            "Args and Parser derive on a struct (an enum of subcommands derives Subcommand)",
        ));
    }
    let vs = t.variants();
    let v = &vs[0];
    let aug = augment(v.fields())?;
    let build = construct(v)?;
    let args = t.impl_for(
        "::std::cli::Args",
        quote`fn augment_args(cmd: ::std::cli::Command) -> ::std::cli::Command { ${aug} cmd }`,
    );
    let from = t.impl_for("::std::cli::FromArgMatches", quote`fn from_arg_matches(m: &::std::cli::ArgMatches) -> Result<Self, ::std::cli::Error> { Ok(${build}) }`);
    Ok(quote`${args} ${from}`)
}

// The settings #[command(...)] and the doc comment give a Command.
fn command_settings(ca: &CommandAttrs, doc: &Option<String>) -> Code {
    let mut out: Vec<Code> = Vec::new();
    // (version and about alone: the package's, as clap's from Cargo.)
    match &ca.version {
        Some(Spec::Given(v)) => out.push(quote`.version(${v.clone()})`),
        Some(Spec::Auto) => out.push(quote`.version(::std::build::package_version())`),
        None => {}
    }
    match &ca.author {
        Some(Spec::Given(v)) => out.push(quote`.author(${v.clone()})`),
        Some(Spec::Auto) => out.push(quote`.author(::std::build::package_authors())`),
        None => {}
    }
    let (about, long) = split_doc(doc);
    match (&ca.about, about) {
        (Some(Spec::Given(a)), _) => out.push(quote`.about(${a.clone()})`),
        (Some(Spec::Auto), _) => out.push(quote`.about(::std::build::package_description())`),
        (None, Some(a)) => out.push(quote`.about(${a})`),
        _ => {}
    }
    match (&ca.long_about, long) {
        (Some(a), _) => out.push(quote`.long_about(${a.clone()})`),
        (None, Some(a)) => out.push(quote`.long_about(${a})`),
        _ => {}
    }
    if let Some(v) = &ca.after_help {
        out.push(quote`.after_help(${v.clone()})`);
    }
    if ca.arg_required_else_help {
        out.push(quote`.arg_required_else_help(true)`);
    }
    if ca.disable_help_flag {
        out.push(quote`.disable_help_flag(true)`);
    }
    if ca.disable_version_flag {
        out.push(quote`.disable_version_flag(true)`);
    }
    if ca.hide {
        out.push(quote`.hide(true)`);
    }
    if ca.trailing_var_arg {
        out.push(quote`.trailing_var_arg(true)`);
    }
    quote`${out}`
}

// --- The derives -------------------------------------------------------------------

/// Derives [`Parser`](super::Parser) and the traits it needs for a struct
/// whose fields are a program's arguments.
///
/// See the [module docs](self) for the attributes it takes.
///
/// # Examples
///
/// ```
/// use std::cli::Parser;
///
/// #[derive(Parser, Debug)]
/// #[command(name = "hello", version = "0.1")]
/// /// Says hello.
/// struct Cli {
///     /// Who to greet
///     #[arg(short, long, default_value = "world")]
///     name: String,
///     /// How many times
///     #[arg(short, long, default_value = "1")]
///     count: u8,
/// }
///
/// let cli = Cli::parse_from(["hello", "-n", "ann", "--count", "2"]);
/// assert_eq(cli.name, "ann");
/// assert_eq(cli.count, 2);
///
/// let err = Cli::try_parse_from(["hello", "--count", "300"]).unwrap_err();
/// assert(err.render().starts_with("error: invalid value '300' for '--count <COUNT>'"));
/// ```
#[derive_macro(Parser, attrs = [command, arg])]
pub fn parser_derive(t: &TypeInfo) -> Result<Code, Error> {
    let ca: CommandAttrs = t.parse_attrs("command")?;
    let impls = args_impls(t)?;
    let name = match &ca.name {
        Some(n) => quote`${n.clone()}`,
        None => quote`::std::build::package_name()`,
    };
    let settings = command_settings(&ca, &t.doc());
    let factory = t.impl_for("::std::cli::CommandFactory", quote`fn command() -> ::std::cli::Command { <Self as ::std::cli::Args>::augment_args(::std::cli::Command::new(${name})${settings}) }`);
    let parser = t.impl_for("::std::cli::Parser", Code::new());
    Ok(quote`${impls} ${factory} ${parser}`)
}

/// Derives [`Args`](super::Args) and [`FromArgMatches`](super::FromArgMatches)
/// for a struct whose fields are a group of arguments.
///
/// The struct is used by a `#[command(flatten)]` field, or as the one field
/// of a subcommand variant.
///
/// # Examples
///
/// ```
/// use std::cli::{Args, Parser};
///
/// #[derive(Args, Debug)]
/// struct Output {
///     /// Write JSON
///     #[arg(long)]
///     json: bool,
///     #[arg(short, long)]
///     out: Option<String>,
/// }
///
/// #[derive(Parser, Debug)]
/// #[command(name = "report")]
/// struct Cli {
///     #[command(flatten)]
///     output: Output,
/// }
///
/// let cli = Cli::parse_from(["report", "--json", "-o", "r.json"]);
/// assert(cli.output.json);
/// assert_eq(cli.output.out, Some("r.json".to_string()));
/// ```
#[derive_macro(Args, attrs = [command, arg])]
pub fn args_derive(t: &TypeInfo) -> Result<Code, Error> {
    args_impls(t)
}

/// Derives [`Subcommand`](super::Subcommand) and
/// [`FromArgMatches`](super::FromArgMatches) for an enum with a subcommand
/// per variant.
///
/// A variant's subcommand is named by the variant in kebab-case or by
/// `#[command(name = "...")]`, and its `///` comment is the subcommand's
/// about. A unit variant takes no arguments, a variant with named fields
/// takes them as arguments, and a variant with one unnamed field takes the
/// arguments of that [`Args`](super::Args) type.
///
/// # Examples
///
/// ```
/// use std::cli::{Args, Parser, Subcommand};
///
/// #[derive(Parser, Debug)]
/// #[command(name = "pkg")]
/// struct Cli {
///     #[command(subcommand)]
///     command: Option<Commands>,
/// }
///
/// #[derive(Subcommand, Debug, PartialEq)]
/// enum Commands {
///     /// Installs packages
///     Install { names: Vec<String> },
///     /// Removes a package
///     Remove(RemoveArgs),
///     #[command(name = "ls")]
///     List,
/// }
///
/// #[derive(Args, Debug, PartialEq)]
/// struct RemoveArgs {
///     name: String,
///     #[arg(long)]
///     purge: bool,
/// }
///
/// let cli = Cli::parse_from(["pkg", "remove", "vim", "--purge"]);
/// assert_eq(cli.command, Some(Commands::Remove(RemoveArgs { name: "vim".to_string(), purge: true })));
/// assert_eq(Cli::parse_from(["pkg", "ls"]).command, Some(Commands::List));
/// assert_eq(Cli::parse_from(["pkg"]).command, None);
/// ```
#[derive_macro(Subcommand, attrs = [command, arg])]
pub fn subcommand_derive(t: &TypeInfo) -> Result<Code, Error> {
    if !t.is_enum() {
        return Err(Error::at(
            t,
            "Subcommand derives on an enum, a subcommand per variant",
        ));
    }
    let mut adds: Vec<Code> = Vec::new();
    let mut arms: Vec<Code> = Vec::new();
    for v in t.variants().iter() {
        let ca: CommandAttrs = v.parse_attrs("command")?;
        let name = match &ca.name {
            Some(n) => n.clone(),
            None => kebab(`${v.name()}`.to_string().as_str()),
        };
        let settings = command_settings(&ca, &v.doc());
        let path = v.path();
        let base = quote`::std::cli::Command::new(${name.clone()})${settings}`;
        match v.kind() {
            Kind::Unit => {
                adds.push(quote`let cmd = cmd.subcommand(${base});`.at(v));
                arms.push(quote`Some((${name.clone()}, _)) => Ok(${path}),`);
            }
            Kind::Tuple => {
                if v.fields().len() != 1 {
                    return Err(Error::at(
                        v,
                        "a subcommand variant has named fields or one unnamed field (an Args type)",
                    ));
                }
                let f = &v.fields()[0];
                let fc: FieldCommand = f.parse_attrs("command")?;
                let ft = f.ty();
                if fc.subcommand {
                    adds.push(quote`let cmd = cmd.subcommand(<${ft} as ::std::cli::Subcommand>::augment_subcommands(${base}).subcommand_required(true));`.at(v));
                } else {
                    adds.push(quote`let cmd = cmd.subcommand(<${ft} as ::std::cli::Args>::augment_args(${base}));`.at(v));
                }
                arms.push(quote`Some((${name.clone()}, m)) => Ok(${path}(<${ft} as ::std::cli::FromArgMatches>::from_arg_matches(m)?)),`);
            }
            Kind::Named => {
                let aug = augment(v.fields())?;
                let build = construct(v)?;
                adds.push(
                    quote`let cmd = cmd.subcommand({ let cmd = ${base}; ${aug} cmd });`.at(v),
                );
                arms.push(quote`Some((${name.clone()}, m)) => Ok(${build}),`);
            }
        }
    }
    let sub = t.impl_for("::std::cli::Subcommand", quote`fn augment_subcommands(cmd: ::std::cli::Command) -> ::std::cli::Command { ${adds} cmd }`);
    let from = t.impl_for("::std::cli::FromArgMatches", quote`fn from_arg_matches(m: &::std::cli::ArgMatches) -> Result<Self, ::std::cli::Error> { match m.subcommand() { ${arms} Some((other, _)) => Err(::std::cli::Error::raw(::std::cli::ErrorKind::InvalidSubcommand, ::std::cli::derive::unknown_subcommand(other))), None => Err(::std::cli::Error::raw(::std::cli::ErrorKind::MissingSubcommand, "a subcommand is required")), } }`);
    Ok(quote`${sub} ${from}`)
}

/// Derives [`ValueEnum`](super::ValueEnum), `FromStr` and `Display` for an
/// enum of unit variants.
///
/// Each variant's name is its own in kebab-case, or
/// `#[value(name = "...")]`; `FromStr` accepts exactly those names, and
/// `Display` writes them.
///
/// # Examples
///
/// ```
/// use std::cli::{CommandFactory, Parser, ValueEnum};
///
/// #[derive(ValueEnum, Clone, Debug, PartialEq)]
/// enum Level {
///     Low,
///     High,
///     #[value(name = "max")]
///     Maximum,
/// }
///
/// #[derive(Parser)]
/// #[command(name = "fan")]
/// struct Cli {
///     #[arg(value_enum)]
///     level: Level,
/// }
///
/// assert_eq(Cli::parse_from(["fan", "max"]).level, Level::Maximum);
/// assert_eq(Level::value_names(), Vec::from(["low", "high", "max"]));
/// assert_eq(Level::High.to_string(), "high");
/// assert_eq("low".parse::<Level>(), Ok(Level::Low));
/// assert(Cli::command().render_help().contains("[possible values: low, high, max]"));
/// ```
#[derive_macro(ValueEnum, attrs = [value])]
pub fn value_enum_derive(t: &TypeInfo) -> Result<Code, Error> {
    if !t.is_enum() {
        return Err(Error::at(
            t,
            "ValueEnum derives on an enum of unit variants",
        ));
    }
    let mut names: Vec<Code> = Vec::new();
    let mut parse: Vec<Code> = Vec::new();
    let mut show: Vec<Code> = Vec::new();
    let mut all: Vec<String> = Vec::new();
    for v in t.variants().iter() {
        if v.kind() != Kind::Unit {
            return Err(Error::at(v, "ValueEnum's variants are unit variants"));
        }
        let va: ValueAttrs = v.parse_attrs("value")?;
        let name = match &va.name {
            Some(n) => n.clone(),
            None => kebab(`${v.name()}`.to_string().as_str()),
        };
        let path = v.path();
        if names.len() > 0 {
            names.push(c(","));
        }
        names.push(quote`${name.clone()}`);
        parse.push(quote`${name.clone()} => Ok(${path}),`);
        show.push(quote`${path} => ${name.clone()},`);
        all.push(name);
    }
    let list = all.join(", ");
    let ve = t.impl_for_with(
        "::std::cli::ValueEnum",
        Code::new(),
        quote`fn value_names() -> Vec<&str> { Vec::from([${names}]) }`,
    );
    let fs = t.impl_for_with("::std::str::FromStr", Code::new(), quote`type Err = String; fn from_str(s: &str) -> Result<Self, String> { match s { ${parse} _ => Err(::std::cli::derive::bad_value(s, ${list})), } }`);
    let disp = t.impl_for_with("::std::fmt::Display", Code::new(), quote`fn fmt(&self, f: &mut ::std::fmt::Formatter) -> ::std::fmt::Result { f.write_str(match *self { ${show} }) }`);
    Ok(quote`${ve} ${fs} ${disp}`)
}

// --- What the generated code calls -------------------------------------------------

/// Returns the first value of the argument `id` converted to `T`, or
/// `None` if it has no value.
///
/// The code generated by the derives calls this for an `Option<T>` field;
/// it is not meant to be called directly.
///
/// # Errors
///
/// Returns an error of kind
/// [`ErrorKind::ValueValidation`](super::ErrorKind::ValueValidation) if the
/// value does not parse as `T`.
///
/// # Examples
///
/// ```
/// use std::cli::{Arg, Command};
///
/// let m = Command::new("prog").arg(Arg::new("n").long("n")).get_matches_from(["prog", "--n", "5"]);
/// assert_eq(std::cli::derive::one::<i32>(&m, "n").unwrap(), Some(5));
/// assert(std::cli::derive::one::<bool>(&m, "n").is_err());
/// ```
pub fn one<T: crate::str::FromStr>(
    m: &super::ArgMatches,
    id: &str,
) -> Result<Option<T>, super::Error> {
    match m.get_raw(id) {
        None => Ok(None),
        Some(mut vs) => match vs.next() {
            None => Ok(None),
            Some(v) => match v.parse::<T>() {
                Ok(x) => Ok(Some(x)),
                Err(_) => Err(super::Error::raw(
                    super::ErrorKind::ValueValidation,
                    `invalid value '${v}' for '${id}'`,
                )),
            },
        },
    }
}

/// Returns the first value of the argument `id` converted to `T`.
///
/// The code generated by the derives calls this for a required field; it
/// is not meant to be called directly.
///
/// # Errors
///
/// Returns an error of kind
/// [`ErrorKind::MissingRequiredArgument`](super::ErrorKind::MissingRequiredArgument)
/// if the argument has no value, and of kind
/// [`ErrorKind::ValueValidation`](super::ErrorKind::ValueValidation) if the
/// value does not parse as `T`.
///
/// # Examples
///
/// ```
/// use std::cli::{Arg, Command, ErrorKind};
///
/// let m = Command::new("prog").arg(Arg::new("n").long("n")).get_matches_from(["prog"]);
/// let err = std::cli::derive::required::<i32>(&m, "n").unwrap_err();
/// assert_eq(err.kind(), ErrorKind::MissingRequiredArgument);
/// ```
pub fn required<T: crate::str::FromStr>(
    m: &super::ArgMatches,
    id: &str,
) -> Result<T, super::Error> {
    match one::<T>(m, id)? {
        Some(x) => Ok(x),
        None => Err(super::Error::raw(
            super::ErrorKind::MissingRequiredArgument,
            `the argument '${id}' is required`,
        )),
    }
}

/// Returns all the values of the argument `id` converted to `T` (an
/// empty `Vec` if it has none).
///
/// The code generated by the derives calls this for a `Vec<T>` field; it
/// is not meant to be called directly.
///
/// # Errors
///
/// Returns an error of kind
/// [`ErrorKind::ValueValidation`](super::ErrorKind::ValueValidation) if a value
/// does not parse as `T`.
///
/// # Examples
///
/// ```
/// use std::cli::{Arg, Command};
///
/// let m = Command::new("prog").arg(Arg::new("n").num_args(1..)).get_matches_from(["prog", "1", "2"]);
/// assert_eq(std::cli::derive::many::<u8>(&m, "n").unwrap(), Vec::from([1u8, 2]));
/// ```
pub fn many<T: crate::str::FromStr>(
    m: &super::ArgMatches,
    id: &str,
) -> Result<Vec<T>, super::Error> {
    let mut out: Vec<T> = Vec::new();
    if let Some(vs) = m.get_raw(id) {
        for v in vs {
            match v.parse::<T>() {
                Ok(x) => out.push(x),
                Err(_) => {
                    return Err(super::Error::raw(
                        super::ErrorKind::ValueValidation,
                        `invalid value '${v}' for '${id}'`,
                    ));
                }
            }
        }
    }
    Ok(out)
}

/// Returns the message for a subcommand the enum has no variant for.
///
/// The code generated by `#[derive(Subcommand)]` calls this; it is not
/// meant to be called directly.
///
/// # Examples
///
/// ```
/// assert_eq(std::cli::derive::unknown_subcommand("frob"), "unrecognized subcommand 'frob'");
/// ```
pub fn unknown_subcommand(name: &str) -> String {
    `unrecognized subcommand '${name}'`.to_string()
}

/// Returns the message for a value that names no variant of a
/// `ValueEnum`, listing the possible ones.
///
/// The `FromStr` generated by `#[derive(ValueEnum)]` returns this as its
/// error; it is not meant to be called directly.
///
/// # Examples
///
/// ```
/// assert_eq(
///     std::cli::derive::bad_value("hgih", "low, high"),
///     "invalid value 'hgih' [possible values: low, high]",
/// );
/// ```
pub fn bad_value(v: &str, possible: &str) -> String {
    `invalid value '${v}' [possible values: ${possible}]`.to_string()
}
