//! What the build knows, as constants where they are called (the compiler
//! puts them in: mir::buildinfo). For Cargo's env!("CARGO_PKG_VERSION")
//! and option_env!, and Go's -ldflags -X:
//!
//!     println(`${std::build::package_name()} ${std::build::package_version()}`);
//!     let commit = std::build::var("commit").unwrap_or("unknown"); // navi build --var commit=abc
//!
//! The package is the one of the crate the call is in (its navi.toml's
//! [package]: name, version, description, authors, license, repository,
//! homepage; "" for what is not given).

/// [package] name.
#[intrinsic]
pub fn package_name() -> &str;

/// [package] version.
#[intrinsic]
pub fn package_version() -> &str;

/// [package] description.
#[intrinsic]
pub fn package_description() -> &str;

/// [package] authors, joined by ", ".
#[intrinsic]
pub fn package_authors() -> &str;

/// [package] license.
#[intrinsic]
pub fn package_license() -> &str;

/// [package] repository.
#[intrinsic]
pub fn package_repository() -> &str;

/// [package] homepage.
#[intrinsic]
pub fn package_homepage() -> &str;

/// The value navi build (run, test) --var name=value gave name, if any;
/// name is a string literal.
#[intrinsic]
pub fn var(name: &str) -> Option<&str>;
