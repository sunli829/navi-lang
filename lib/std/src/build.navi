//! What the build knows: the package's metadata and values given on the command
//! line.
//!
//! These functions are navi's counterparts of Cargo's
//! `env!("CARGO_PKG_VERSION")` and `option_env!`, and of Go's `-ldflags -X`.
//! The compiler puts their values in as constants where they are called.
//!
//! The package is the one of the crate the call is in: its `navi.toml`'s
//! `[package]` table (`name`, `version`, `description`, `authors`, `license`,
//! `repository`, `homepage`); a field not given is `""`.
//!
//! # Examples
//!
//! ```
//! use std::build;
//!
//! println(`${build::package_name()} ${build::package_version()}`);
//! // `navi build --var commit=abc` sets this one.
//! let commit = build::var("commit").unwrap_or("unknown");
//! assert(!commit.is_empty());
//! ```

/// Returns the `name` of the calling crate's package (Cargo's
/// `CARGO_PKG_NAME`).
///
/// # Examples
///
/// ```
/// let name = std::build::package_name();
/// assert(!name.is_empty());
/// ```
#[intrinsic]
pub fn package_name() -> &str;

/// Returns the `version` of the calling crate's package (Cargo's
/// `CARGO_PKG_VERSION`), or `""` if it gives none.
///
/// # Examples
///
/// ```
/// println(`version ${std::build::package_version()}`);
/// ```
#[intrinsic]
pub fn package_version() -> &str;

/// Returns the `description` of the calling crate's package (Cargo's
/// `CARGO_PKG_DESCRIPTION`), or `""` if it gives none.
///
/// # Examples
///
/// ```
/// println(std::build::package_description());
/// ```
#[intrinsic]
pub fn package_description() -> &str;

/// Returns the `authors` of the calling crate's package joined by `", "`, or
/// `""` if it gives none.
///
/// Cargo's `CARGO_PKG_AUTHORS` joins them with `:`.
///
/// # Examples
///
/// ```
/// for author in std::build::package_authors().split(", ") {
///     println(author);
/// }
/// ```
#[intrinsic]
pub fn package_authors() -> &str;

/// Returns the `license` of the calling crate's package (Cargo's
/// `CARGO_PKG_LICENSE`), or `""` if it gives none.
///
/// # Examples
///
/// ```
/// println(std::build::package_license());
/// ```
#[intrinsic]
pub fn package_license() -> &str;

/// Returns the `repository` of the calling crate's package (Cargo's
/// `CARGO_PKG_REPOSITORY`), or `""` if it gives none.
///
/// # Examples
///
/// ```
/// println(std::build::package_repository());
/// ```
#[intrinsic]
pub fn package_repository() -> &str;

/// Returns the `homepage` of the calling crate's package (Cargo's
/// `CARGO_PKG_HOMEPAGE`), or `""` if it gives none.
///
/// # Examples
///
/// ```
/// println(std::build::package_homepage());
/// ```
#[intrinsic]
pub fn package_homepage() -> &str;

/// Returns the value `navi build --var name=value` (or `navi run`, `navi test`)
/// gave `name`, or [`None`] if it was not given.
///
/// This is navi's way to pass values into a build from outside, as Go's
/// `-ldflags -X` and Rust's `option_env!`, without depending silently on the
/// environment. `name` must be a string literal. Only crates whose source
/// mentions `std::build` have the `--var` values in their build cache key.
///
/// # Examples
///
/// ```
/// // Built with `navi build --var commit=1a2b3c`, this prints the commit.
/// match std::build::var("commit") {
///     Some(c) => println(`commit ${c}`),
///     None => println("commit unknown"),
/// }
/// ```
#[intrinsic]
pub fn var(name: &str) -> Option<&str>;
