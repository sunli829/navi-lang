//! Temporal quantification: monotonic instants, the system clock and
//! durations.

use crate::ops::{Add, Sub};

/// A span of time with nanosecond precision.
#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]
pub struct Duration {
    nanos: u64,
}

impl Duration {
    pub const ZERO: Duration = Duration { nanos: 0 };
    #[inline]
    pub fn from_secs(s: u64) -> Duration { Duration { nanos: s * 1000000000 } }
    #[inline]
    pub fn from_millis(ms: u64) -> Duration { Duration { nanos: ms * 1000000 } }
    #[inline]
    pub fn from_micros(us: u64) -> Duration { Duration { nanos: us * 1000 } }
    #[inline]
    pub fn from_nanos(ns: u64) -> Duration { Duration { nanos: ns } }
    #[inline]
    pub fn as_secs(&self) -> u64 { self.nanos / 1000000000 }
    #[inline]
    pub fn as_millis(&self) -> u128 { (self.nanos / 1000000) as u128 }
    #[inline]
    pub fn as_micros(&self) -> u128 { (self.nanos / 1000) as u128 }
    #[inline]
    pub fn as_nanos(&self) -> u128 { self.nanos as u128 }
    #[inline]
    pub fn subsec_nanos(&self) -> u32 { (self.nanos % 1000000000) as u32 }
    #[inline]
    pub fn subsec_millis(&self) -> u32 { ((self.nanos % 1000000000) / 1000000) as u32 }
    #[inline]
    pub fn as_secs_f64(&self) -> f64 { self.nanos as f64 / 1000000000.0 }
}

impl Add for Duration {
    type Output = Duration;
    fn add(self, rhs: Duration) -> Duration { Duration { nanos: self.nanos + rhs.nanos } }
}

impl Sub for Duration {
    type Output = Duration;
    fn sub(self, rhs: Duration) -> Duration { Duration { nanos: self.nanos - rhs.nanos } }
}

/// A measurement of a monotonically nondecreasing clock.
#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub struct Instant {
    nanos: u64,
}

impl Instant {
    #[inline]
    pub fn now() -> Instant { Instant { nanos: crate::rt::monotonic_nanos() } }
    #[inline]
    pub fn elapsed(&self) -> Duration { Instant::now().duration_since(self.clone()) }
    pub fn duration_since(&self, earlier: Instant) -> Duration {
        Duration { nanos: if self.nanos > earlier.nanos { self.nanos - earlier.nanos } else { 0 } }
    }
}

impl Sub for Instant {
    type Output = Duration;
    fn sub(self, rhs: Instant) -> Duration { self.duration_since(rhs) }
}

impl Duration {
    pub const MAX: Duration = Duration { nanos: 18446744073709551615 };
    pub const SECOND: Duration = Duration { nanos: 1000000000 };
    pub const MILLISECOND: Duration = Duration { nanos: 1000000 };
    pub const MICROSECOND: Duration = Duration { nanos: 1000 };
    pub const NANOSECOND: Duration = Duration { nanos: 1 };

    #[inline]
    pub const fn new(secs: u64, nanos: u32) -> Duration { Duration { nanos: secs * 1000000000 + nanos as u64 } }
    #[inline]
    pub fn from_secs_f64(s: f64) -> Duration { Duration { nanos: (s * 1000000000.0) as u64 } }
    #[inline]
    pub fn from_secs_f32(s: f32) -> Duration { Duration::from_secs_f64(s as f64) }
    #[inline]
    pub fn as_secs_f32(&self) -> f32 { self.as_secs_f64() as f32 }
    #[inline]
    pub fn subsec_micros(&self) -> u32 { ((self.nanos % 1000000000) / 1000) as u32 }
    #[inline]
    pub fn is_zero(&self) -> bool { self.nanos == 0 }
    pub fn checked_add(self, rhs: Duration) -> Option<Duration> {
        match self.nanos.checked_add(rhs.nanos) { Some(n) => Some(Duration { nanos: n }), None => None }
    }
    pub fn checked_sub(self, rhs: Duration) -> Option<Duration> {
        if rhs.nanos > self.nanos { None } else { Some(Duration { nanos: self.nanos - rhs.nanos }) }
    }
    #[inline]
    pub fn saturating_add(self, rhs: Duration) -> Duration { self.checked_add(rhs).unwrap_or(Duration::MAX) }
    #[inline]
    pub fn saturating_sub(self, rhs: Duration) -> Duration { self.checked_sub(rhs).unwrap_or(Duration::ZERO) }
    pub fn checked_mul(self, rhs: u32) -> Option<Duration> {
        match self.nanos.checked_mul(rhs as u64) { Some(n) => Some(Duration { nanos: n }), None => None }
    }
    #[inline]
    pub fn checked_div(self, rhs: u32) -> Option<Duration> { if rhs == 0 { None } else { Some(Duration { nanos: self.nanos / rhs as u64 }) } }
    #[inline]
    pub fn mul_f64(self, rhs: f64) -> Duration { Duration::from_secs_f64(self.as_secs_f64() * rhs) }
    #[inline]
    pub fn div_f64(self, rhs: f64) -> Duration { Duration::from_secs_f64(self.as_secs_f64() / rhs) }
    pub fn abs_diff(self, other: Duration) -> Duration {
        Duration { nanos: if self.nanos > other.nanos { self.nanos - other.nanos } else { other.nanos - self.nanos } }
    }
}

impl crate::ops::Mul<u32> for Duration {
    type Output = Duration;
    fn mul(self, rhs: u32) -> Duration { Duration { nanos: self.nanos * rhs as u64 } }
}

impl crate::ops::Div<u32> for Duration {
    type Output = Duration;
    fn div(self, rhs: u32) -> Duration { Duration { nanos: self.nanos / rhs as u64 } }
}

impl crate::ops::AddAssign for Duration {
    fn add_assign(&mut self, rhs: Duration) { self.nanos = self.nanos + rhs.nanos; }
}

impl crate::ops::SubAssign for Duration {
    fn sub_assign(&mut self, rhs: Duration) { self.nanos = self.nanos - rhs.nanos; }
}

impl Instant {
    pub fn checked_add(&self, d: Duration) -> Option<Instant> {
        match self.nanos.checked_add(d.nanos) { Some(n) => Some(Instant { nanos: n }), None => None }
    }
    pub fn checked_sub(&self, d: Duration) -> Option<Instant> {
        if d.nanos > self.nanos { None } else { Some(Instant { nanos: self.nanos - d.nanos }) }
    }
    #[inline]
    pub fn saturating_duration_since(&self, earlier: Instant) -> Duration { self.duration_since(earlier) }
    pub fn checked_duration_since(&self, earlier: Instant) -> Option<Duration> {
        if earlier.nanos > self.nanos { None } else { Some(Duration { nanos: self.nanos - earlier.nanos }) }
    }
}

impl Add<Duration> for Instant {
    type Output = Instant;
    fn add(self, d: Duration) -> Instant { Instant { nanos: self.nanos + d.nanos } }
}

impl Sub<Duration> for Instant {
    type Output = Instant;
    fn sub(self, d: Duration) -> Instant { Instant { nanos: self.nanos - d.nanos } }
}

/// A point of the system clock (nanoseconds since the Unix epoch; it may
/// jump: use Instant to measure).
#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub struct SystemTime {
    nanos: i128,
}

/// 1970-01-01 00:00:00 UTC.
pub const UNIX_EPOCH: SystemTime = SystemTime { nanos: 0 };

/// SystemTime::duration_since of a later time: how much later it is.
#[derive(Clone, Debug)]
pub struct SystemTimeError {
    d: Duration,
}

impl SystemTimeError {
    #[inline]
    pub fn duration(&self) -> Duration { self.d.clone() }
}

impl crate::fmt::Display for SystemTimeError {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result { f.write_str("second time provided was later than self") }
}

impl SystemTime {
    pub const UNIX_EPOCH: SystemTime = SystemTime { nanos: 0 };

    #[inline]
    pub fn now() -> SystemTime { SystemTime { nanos: crate::rt::native::realtime_nanos() as i128 } }

    /// The time n nanoseconds after the Unix epoch (std::fs).
    pub(crate) fn from_unix_nanos(n: i128) -> SystemTime { SystemTime { nanos: n } }
    pub(crate) fn unix_nanos(&self) -> i128 { self.nanos }

    pub fn duration_since(&self, earlier: SystemTime) -> Result<Duration, SystemTimeError> {
        if self.nanos >= earlier.nanos { Ok(Duration { nanos: (self.nanos - earlier.nanos) as u64 }) } else { Err(SystemTimeError { d: Duration { nanos: (earlier.nanos - self.nanos) as u64 } }) }
    }

    #[inline]
    pub fn elapsed(&self) -> Result<Duration, SystemTimeError> { SystemTime::now().duration_since(self.clone()) }

    #[inline]
    pub fn checked_add(&self, d: Duration) -> Option<SystemTime> { Some(SystemTime { nanos: self.nanos + d.nanos as i128 }) }
    #[inline]
    pub fn checked_sub(&self, d: Duration) -> Option<SystemTime> { Some(SystemTime { nanos: self.nanos - d.nanos as i128 }) }
}

impl Add<Duration> for SystemTime {
    type Output = SystemTime;
    fn add(self, d: Duration) -> SystemTime { SystemTime { nanos: self.nanos + d.nanos as i128 } }
}

impl Sub<Duration> for SystemTime {
    type Output = SystemTime;
    fn sub(self, d: Duration) -> SystemTime { SystemTime { nanos: self.nanos - d.nanos as i128 } }
}


// --- Timer channels (Go's time.After, time.Tick and Ticker; crossbeam's
// after and tick), for timeouts and periodic work in select ---------------

/// A channel that receives the instant once, d from now (Go's time.After):
///
///     select {
///         v = rx.recv() => handle(v),
///         t = std::time::after(Duration::from_secs(1)).recv() => println("timed out"),
///     }
pub fn after(d: Duration) -> crate::sync::mpmc::Receiver<Instant> {
    let (tx, rx) = crate::sync::mpmc::sync_channel::<Instant>(1);
    crate::thread::spawn(|| {
        crate::thread::sleep(d);
        let _ = tx.send(Instant::now());
    });
    rx
}

/// A channel that receives the instant every d (Go's time.Tick); a tick a
/// slow receiver has not taken yet makes the next one dropped. It never
/// stops: a Ticker can.
pub fn tick(d: Duration) -> crate::sync::mpmc::Receiver<Instant> { Ticker::new(d).receiver() }

/// Instants every period until stopped (Go's time.Ticker).
#[derive(Clone)]
pub struct Ticker {
    rx: crate::sync::mpmc::Receiver<Instant>,
    stopped: &crate::sync::atomic::AtomicBool,
}

impl Ticker {
    /// Ticks every period, the first one period from now (on deadlines, so
    /// they do not drift; missed ones are dropped).
    pub fn new(period: Duration) -> Ticker {
        if period.is_zero() { crate::panic::panic("Ticker::new: a zero period"); }
        let (tx, rx) = crate::sync::mpmc::sync_channel::<Instant>(1);
        let stopped = &crate::sync::atomic::AtomicBool::new(false);
        crate::thread::spawn(|| {
            let mut next = Instant::now() + period;
            loop {
                crate::thread::sleep_until(next);
                if stopped.load(crate::sync::atomic::Ordering::SeqCst) { return; }
                let now = Instant::now();
                select {
                    tx.send(now) => {},
                    default => {},
                }
                next = next + period;
                // (Behind by more than a period: from now on.)
                if next < now { next = now + period; }
            }
        });
        Ticker { rx, stopped }
    }

    /// The channel the ticks come on (for select; clones share it).
    pub fn receiver(&self) -> crate::sync::mpmc::Receiver<Instant> { self.rx.clone() }

    /// Waits for the next tick.
    pub fn recv(&self) -> Instant { self.rx.recv().unwrap() }

    /// No more ticks (the one waiting in the channel, if any, stays).
    pub fn stop(&self) { self.stopped.store(true, crate::sync::atomic::Ordering::SeqCst); }
}
