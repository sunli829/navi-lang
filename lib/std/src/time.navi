//! Temporal quantification.
//!
//! This module provides:
//!
//! - [`Duration`], a span of time, with nanosecond precision;
//! - [`Instant`], a measurement of the monotonic clock, for measuring elapsed
//!   time;
//! - [`SystemTime`], a point of the system clock (wall-clock time), which may
//!   jump;
//! - timer channels, which navi adds for use in `select` (as Go's `time`
//!   package): [`after`], [`tick`] and [`Ticker`].
//!
//! # Examples
//!
//! ```
//! use std::time::{Duration, Instant};
//!
//! let five_seconds = Duration::from_secs(5);
//! assert_eq(five_seconds, Duration::from_millis(5000));
//!
//! let start = Instant::now();
//! std::thread::sleep(Duration::from_millis(10));
//! assert(start.elapsed() >= Duration::from_millis(10));
//! ```

use crate::{
    ops::{Add, Sub},
    string::String,
};

/// A span of time, with nanosecond precision.
///
/// Each `Duration` is a whole number of nanoseconds. Durations are typically
/// used for timeouts and sleeps ([`std::thread::sleep`](crate::thread::sleep))
/// and are the result of measuring time with [`Instant`] and [`SystemTime`].
/// They implement the arithmetic operators (`+`, `-`, `*` and `/` by a `u32`,
/// `+=`, `-=`), which panic on overflow, and the comparison traits.
///
/// Unlike Rust's, navi's `Duration` holds the nanoseconds in a `u64`: the
/// longest one, [`Duration::MAX`], is about 584 years (Rust's goes to
/// `u64::MAX` seconds). Its `Debug` form shows the nanoseconds (`Duration {
/// nanos: 1500000000 }`) rather than Rust's `1.5s`.
///
/// # Examples
///
/// ```
/// use std::time::Duration;
///
/// let five_seconds = Duration::new(5, 0);
/// let five_seconds_and_five_nanos = five_seconds + Duration::new(0, 5);
///
/// assert_eq(five_seconds_and_five_nanos.as_secs(), 5);
/// assert_eq(five_seconds_and_five_nanos.subsec_nanos(), 5);
///
/// let ten_millis = Duration::from_millis(10);
/// assert_eq(ten_millis * 3, Duration::from_millis(30));
/// ```
#[derive(Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Default)]
pub struct Duration {
    nanos: u64,
}

impl Duration {
    /// A duration of zero time.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// let duration = Duration::ZERO;
    /// assert(duration.is_zero());
    /// assert_eq(duration.as_nanos(), 0);
    /// ```
    pub const ZERO: Duration = Duration { nanos: 0 };
    /// Creates a new `Duration` from the specified number of whole seconds.
    ///
    /// # Panics
    ///
    /// Panics if the duration does not fit (more than about 584 years, see
    /// [`Duration::MAX`]).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// let duration = Duration::from_secs(5);
    ///
    /// assert_eq(duration.as_secs(), 5);
    /// assert_eq(duration.subsec_nanos(), 0);
    /// ```
    #[inline]
    pub fn from_secs(s: u64) -> Duration {
        Duration {
            nanos: s * 1000000000,
        }
    }

    /// Creates a new `Duration` from the specified number of milliseconds.
    ///
    /// # Panics
    ///
    /// Panics if the duration does not fit (see [`Duration::MAX`]).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// let duration = Duration::from_millis(2_569);
    ///
    /// assert_eq(duration.as_secs(), 2);
    /// assert_eq(duration.subsec_nanos(), 569_000_000);
    /// ```
    #[inline]
    pub fn from_millis(ms: u64) -> Duration {
        Duration {
            nanos: ms * 1000000,
        }
    }

    /// Creates a new `Duration` from the specified number of microseconds.
    ///
    /// # Panics
    ///
    /// Panics if the duration does not fit (see [`Duration::MAX`]).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// let duration = Duration::from_micros(1_000_002);
    ///
    /// assert_eq(duration.as_secs(), 1);
    /// assert_eq(duration.subsec_nanos(), 2_000);
    /// ```
    #[inline]
    pub fn from_micros(us: u64) -> Duration {
        Duration { nanos: us * 1000 }
    }

    /// Creates a new `Duration` from the specified number of nanoseconds.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// let duration = Duration::from_nanos(1_000_000_123);
    ///
    /// assert_eq(duration.as_secs(), 1);
    /// assert_eq(duration.subsec_nanos(), 123);
    /// ```
    #[inline]
    pub fn from_nanos(ns: u64) -> Duration {
        Duration { nanos: ns }
    }

    /// Returns the number of _whole_ seconds contained by this `Duration`.
    ///
    /// The returned value does not include the fractional (nanosecond) part of
    /// the duration, which can be obtained using
    /// [`subsec_nanos`](Duration::subsec_nanos).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// let duration = Duration::new(5, 730_023_852);
    /// assert_eq(duration.as_secs(), 5);
    /// ```
    #[inline]
    pub fn as_secs(&self) -> u64 {
        self.nanos / 1000000000
    }

    /// Returns the total number of whole milliseconds contained by this
    /// `Duration`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// let duration = Duration::new(5, 730_023_852);
    /// assert_eq(duration.as_millis(), 5_730);
    /// ```
    #[inline]
    pub fn as_millis(&self) -> u128 {
        (self.nanos / 1000000) as u128
    }

    /// Returns the total number of whole microseconds contained by this
    /// `Duration`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// let duration = Duration::new(5, 730_023_852);
    /// assert_eq(duration.as_micros(), 5_730_023);
    /// ```
    #[inline]
    pub fn as_micros(&self) -> u128 {
        (self.nanos / 1000) as u128
    }

    /// Returns the total number of nanoseconds contained by this `Duration`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// let duration = Duration::new(5, 730_023_852);
    /// assert_eq(duration.as_nanos(), 5_730_023_852);
    /// ```
    #[inline]
    pub fn as_nanos(&self) -> u128 {
        self.nanos as u128
    }

    /// Returns the fractional part of this `Duration`, in nanoseconds.
    ///
    /// This method does _not_ return the length of the duration when
    /// represented by nanoseconds. The returned number is always less than one
    /// billion.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// let duration = Duration::from_millis(5_010);
    /// assert_eq(duration.as_secs(), 5);
    /// assert_eq(duration.subsec_nanos(), 10_000_000);
    /// ```
    #[inline]
    pub fn subsec_nanos(&self) -> u32 {
        (self.nanos % 1000000000) as u32
    }

    /// Returns the fractional part of this `Duration`, in whole milliseconds.
    ///
    /// This method does _not_ return the length of the duration when
    /// represented by milliseconds. The returned number is always less than one
    /// thousand.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// let duration = Duration::from_millis(5_432);
    /// assert_eq(duration.as_secs(), 5);
    /// assert_eq(duration.subsec_millis(), 432);
    /// ```
    #[inline]
    pub fn subsec_millis(&self) -> u32 {
        ((self.nanos % 1000000000) / 1000000) as u32
    }

    /// Returns the number of seconds contained by this `Duration` as `f64`.
    ///
    /// The returned value includes the fractional (nanosecond) part of the
    /// duration.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// let dur = Duration::new(2, 700_000_000);
    /// assert_eq(dur.as_secs_f64(), 2.7);
    /// ```
    #[inline]
    pub fn as_secs_f64(&self) -> f64 {
        self.nanos as f64 / 1000000000.0
    }
}

impl Add for Duration {
    type Output = Duration;
    fn add(self, rhs: Duration) -> Duration {
        Duration {
            nanos: self.nanos + rhs.nanos,
        }
    }
}

impl Sub for Duration {
    type Output = Duration;
    fn sub(self, rhs: Duration) -> Duration {
        Duration {
            nanos: self.nanos - rhs.nanos,
        }
    }
}

/// A measurement of a monotonically nondecreasing clock.
///
/// Instants are always guaranteed to be no less than any previously measured
/// instant when created, and are often useful for tasks such as measuring
/// benchmarks or timing how long an operation takes. An `Instant` is opaque: it
/// is only useful together with other instants (subtracting one from another
/// gives a [`Duration`]) or durations (`instant + duration` is a later
/// instant).
///
/// # Examples
///
/// ```
/// use std::{
///     thread::sleep,
///     time::{Duration, Instant},
/// };
///
/// let now = Instant::now();
/// sleep(Duration::from_millis(2));
/// let later = Instant::now();
/// assert(later.clone() - now.clone() >= Duration::from_millis(2));
/// assert(now + Duration::from_secs(1) > later);
/// ```
#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub struct Instant {
    nanos: u64,
}

impl Instant {
    /// Returns an instant corresponding to "now".
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Instant;
    ///
    /// let now = Instant::now();
    /// assert(Instant::now() >= now);
    /// ```
    #[inline]
    pub fn now() -> Instant {
        Instant {
            nanos: crate::rt::monotonic_nanos(),
        }
    }

    // The monotonic clock's nanoseconds (the runtime's deadlines).
    pub(crate) fn mono_nanos(&self) -> u64 {
        self.nanos
    }

    /// Returns the amount of time elapsed since this instant.
    ///
    /// The clock is monotonic, so the result is never negative.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::{
    ///     thread::sleep,
    ///     time::{Duration, Instant},
    /// };
    ///
    /// let instant = Instant::now();
    /// let three_millis = Duration::from_millis(3);
    /// sleep(three_millis);
    /// assert(instant.elapsed() >= three_millis);
    /// ```
    #[inline]
    pub fn elapsed(&self) -> Duration {
        Instant::now().duration_since(self.clone())
    }

    /// Returns the amount of time elapsed from another instant to this one, or
    /// zero duration if that instant is later than this one.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::{
    ///     thread::sleep,
    ///     time::{Duration, Instant},
    /// };
    ///
    /// let earlier = Instant::now();
    /// sleep(Duration::from_millis(1));
    /// let new_now = Instant::now();
    /// assert(new_now.duration_since(earlier.clone()) >= Duration::from_millis(1));
    /// assert_eq(earlier.duration_since(new_now), Duration::ZERO);
    /// ```
    pub fn duration_since(&self, earlier: Instant) -> Duration {
        Duration {
            nanos: if self.nanos > earlier.nanos {
                self.nanos - earlier.nanos
            } else {
                0
            },
        }
    }
}

impl Sub for Instant {
    type Output = Duration;
    fn sub(self, rhs: Instant) -> Duration {
        self.duration_since(rhs)
    }
}

impl Duration {
    /// The maximum duration: `u64::MAX` nanoseconds, about 584 years.
    ///
    /// Rust's `Duration::MAX` is `u64::MAX` seconds; navi's is smaller because
    /// a `Duration` is a `u64` of nanoseconds.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// assert_eq(Duration::MAX.as_nanos(), u64::MAX as u128);
    /// assert_eq(Duration::MAX.checked_add(Duration::NANOSECOND), None);
    /// ```
    pub const MAX: Duration = Duration {
        nanos: 18446744073709551615,
    };
    /// The duration of one second.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// assert_eq(Duration::SECOND, Duration::from_secs(1));
    /// ```
    pub const SECOND: Duration = Duration { nanos: 1000000000 };
    /// The duration of one millisecond.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// assert_eq(Duration::MILLISECOND, Duration::from_millis(1));
    /// ```
    pub const MILLISECOND: Duration = Duration { nanos: 1000000 };
    /// The duration of one microsecond.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// assert_eq(Duration::MICROSECOND, Duration::from_micros(1));
    /// ```
    pub const MICROSECOND: Duration = Duration { nanos: 1000 };
    /// The duration of one nanosecond.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// assert_eq(Duration::NANOSECOND, Duration::from_nanos(1));
    /// ```
    pub const NANOSECOND: Duration = Duration { nanos: 1 };

    /// Creates a new `Duration` from the specified number of whole seconds and
    /// additional nanoseconds.
    ///
    /// If the number of nanoseconds is greater than 1 billion (the number of
    /// nanoseconds in a second), then it will carry over into the seconds
    /// provided.
    ///
    /// # Panics
    ///
    /// Panics if the duration does not fit (see [`Duration::MAX`]).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// let five_seconds = Duration::new(5, 0);
    /// assert_eq(five_seconds.as_secs(), 5);
    ///
    /// let carried = Duration::new(1, 1_500_000_000);
    /// assert_eq(carried, Duration::from_millis(2_500));
    /// ```
    #[inline]
    pub const fn new(secs: u64, nanos: u32) -> Duration {
        Duration {
            nanos: secs * 1000000000 + nanos as u64,
        }
    }

    /// Creates a new `Duration` from the specified number of seconds
    /// represented as `f64`.
    ///
    /// The fractional part below a nanosecond is truncated. Unlike Rust's,
    /// which panics, a negative or NaN value gives [`Duration::ZERO`] and a
    /// value too large gives [`Duration::MAX`] (the conversion saturates, as
    /// `as` does).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// let res = Duration::from_secs_f64(2.7);
    /// assert_eq(res, Duration::new(2, 700_000_000));
    /// assert_eq(Duration::from_secs_f64(-1.0), Duration::ZERO);
    /// ```
    #[inline]
    pub fn from_secs_f64(s: f64) -> Duration {
        Duration {
            nanos: (s * 1000000000.0) as u64,
        }
    }

    /// Creates a new `Duration` from the specified number of seconds
    /// represented as `f32`.
    ///
    /// The value is converted to `f64` first, so the result has the rounding
    /// error of the `f32` (2.7 is 2.7000000477 as an `f32`). Out-of-range
    /// values saturate as in [`Duration::from_secs_f64`].
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// let res = Duration::from_secs_f32(2.5);
    /// assert_eq(res, Duration::new(2, 500_000_000));
    /// ```
    #[inline]
    pub fn from_secs_f32(s: f32) -> Duration {
        Duration::from_secs_f64(s as f64)
    }

    /// Returns the number of seconds contained by this `Duration` as `f32`.
    ///
    /// The returned value includes the fractional (nanosecond) part of the
    /// duration.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// let dur = Duration::new(2, 500_000_000);
    /// assert_eq(dur.as_secs_f32(), 2.5);
    /// ```
    #[inline]
    pub fn as_secs_f32(&self) -> f32 {
        self.as_secs_f64() as f32
    }

    /// Returns the fractional part of this `Duration`, in whole microseconds.
    ///
    /// This method does _not_ return the length of the duration when
    /// represented by microseconds. The returned number is always less than one
    /// million.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// let duration = Duration::from_micros(1_234_567);
    /// assert_eq(duration.as_secs(), 1);
    /// assert_eq(duration.subsec_micros(), 234_567);
    /// ```
    #[inline]
    pub fn subsec_micros(&self) -> u32 {
        ((self.nanos % 1000000000) / 1000) as u32
    }

    /// Returns true if this `Duration` spans no time.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// assert(Duration::ZERO.is_zero());
    /// assert(Duration::new(0, 0).is_zero());
    /// assert(Duration::from_nanos(0).is_zero());
    ///
    /// assert(!Duration::new(1, 1).is_zero());
    /// assert(!Duration::from_millis(1).is_zero());
    /// ```
    #[inline]
    pub fn is_zero(&self) -> bool {
        self.nanos == 0
    }

    /// Checked `Duration` addition. Computes `self + other`, returning [`None`]
    /// if overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// assert_eq(
    ///     Duration::new(0, 0).checked_add(Duration::new(0, 1)),
    ///     Some(Duration::new(0, 1)),
    /// );
    /// assert_eq(Duration::MAX.checked_add(Duration::new(1, 0)), None);
    /// ```
    pub fn checked_add(self, rhs: Duration) -> Option<Duration> {
        match self.nanos.checked_add(rhs.nanos) {
            Some(n) => Some(Duration { nanos: n }),
            None => None,
        }
    }

    /// Checked `Duration` subtraction. Computes `self - other`, returning
    /// [`None`] if the result would be negative.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// assert_eq(
    ///     Duration::new(0, 1).checked_sub(Duration::new(0, 0)),
    ///     Some(Duration::new(0, 1)),
    /// );
    /// assert_eq(Duration::new(0, 0).checked_sub(Duration::new(0, 1)), None);
    /// ```
    pub fn checked_sub(self, rhs: Duration) -> Option<Duration> {
        if rhs.nanos > self.nanos {
            None
        } else {
            Some(Duration {
                nanos: self.nanos - rhs.nanos,
            })
        }
    }

    /// Saturating `Duration` addition. Computes `self + other`, returning
    /// [`Duration::MAX`] if overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// assert_eq(
    ///     Duration::new(0, 0).saturating_add(Duration::new(0, 1)),
    ///     Duration::new(0, 1),
    /// );
    /// assert_eq(
    ///     Duration::new(1, 0).saturating_add(Duration::MAX),
    ///     Duration::MAX,
    /// );
    /// ```
    #[inline]
    pub fn saturating_add(self, rhs: Duration) -> Duration {
        self.checked_add(rhs).unwrap_or(Duration::MAX)
    }

    /// Saturating `Duration` subtraction. Computes `self - other`, returning
    /// [`Duration::ZERO`] if the result would be negative.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// assert_eq(
    ///     Duration::new(0, 1).saturating_sub(Duration::new(0, 0)),
    ///     Duration::new(0, 1),
    /// );
    /// assert_eq(
    ///     Duration::new(0, 0).saturating_sub(Duration::new(0, 1)),
    ///     Duration::ZERO,
    /// );
    /// ```
    #[inline]
    pub fn saturating_sub(self, rhs: Duration) -> Duration {
        self.checked_sub(rhs).unwrap_or(Duration::ZERO)
    }

    /// Checked `Duration` multiplication. Computes `self * other`, returning
    /// [`None`] if overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// assert_eq(
    ///     Duration::new(0, 500_000_001).checked_mul(2),
    ///     Some(Duration::new(1, 2)),
    /// );
    /// assert_eq(Duration::MAX.checked_mul(2), None);
    /// ```
    pub fn checked_mul(self, rhs: u32) -> Option<Duration> {
        match self.nanos.checked_mul(rhs as u64) {
            Some(n) => Some(Duration { nanos: n }),
            None => None,
        }
    }

    /// Checked `Duration` division. Computes `self / other`, returning [`None`]
    /// if `other == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// assert_eq(
    ///     Duration::new(2, 0).checked_div(2),
    ///     Some(Duration::new(1, 0)),
    /// );
    /// assert_eq(
    ///     Duration::new(1, 0).checked_div(2),
    ///     Some(Duration::new(0, 500_000_000)),
    /// );
    /// assert_eq(Duration::new(2, 0).checked_div(0), None);
    /// ```
    #[inline]
    pub fn checked_div(self, rhs: u32) -> Option<Duration> {
        if rhs == 0 {
            None
        } else {
            Some(Duration {
                nanos: self.nanos / rhs as u64,
            })
        }
    }

    /// Multiplies `Duration` by `f64`.
    ///
    /// The computation goes through [`as_secs_f64`](Duration::as_secs_f64) and
    /// [`from_secs_f64`](Duration::from_secs_f64), so it saturates instead of
    /// panicking (Rust panics if the result is negative, overflows or is not
    /// finite).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// let dur = Duration::new(2, 700_000_000);
    /// assert_eq(dur.mul_f64(3.14), Duration::new(8, 478_000_000));
    /// ```
    #[inline]
    pub fn mul_f64(self, rhs: f64) -> Duration {
        Duration::from_secs_f64(self.as_secs_f64() * rhs)
    }

    /// Divides `Duration` by `f64`.
    ///
    /// As [`mul_f64`](Duration::mul_f64), the result saturates instead of
    /// panicking.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// let dur = Duration::new(2, 700_000_000);
    /// assert_eq(dur.div_f64(4.0), Duration::new(0, 675_000_000));
    /// ```
    #[inline]
    pub fn div_f64(self, rhs: f64) -> Duration {
        Duration::from_secs_f64(self.as_secs_f64() / rhs)
    }

    /// Computes the absolute difference between `self` and `other`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::Duration;
    ///
    /// assert_eq(
    ///     Duration::new(100, 0).abs_diff(Duration::new(80, 0)),
    ///     Duration::new(20, 0),
    /// );
    /// assert_eq(
    ///     Duration::new(80, 0).abs_diff(Duration::new(100, 0)),
    ///     Duration::new(20, 0),
    /// );
    /// ```
    pub fn abs_diff(self, other: Duration) -> Duration {
        Duration {
            nanos: if self.nanos > other.nanos {
                self.nanos - other.nanos
            } else {
                other.nanos - self.nanos
            },
        }
    }
}

/// Formats as Rust's: in the largest unit of `s`, `ms`, `µs` and `ns` that
/// is at most the duration, with the fraction's digits (up to the last that
/// is not zero, or as many as the precision says, rounded); `+` writes a
/// sign, and a width pads (to the left by default).
///
/// # Examples
///
/// ```
/// use std::time::Duration;
///
/// assert_eq(`${Duration::from_millis(1500):?}`.to_string(), "1.5s");
/// assert_eq(`${Duration::from_micros(10):?}`.to_string(), "10µs");
/// assert_eq(
///     `${Duration::from_nanos(1_000_001):?}`.to_string(),
///     "1.000001ms",
/// );
/// assert_eq(`${Duration::from_millis(1234):.1?}`.to_string(), "1.2s");
/// assert_eq(`${Duration::from_secs(1):>6?}`.to_string(), "    1s");
/// ```
impl crate::fmt::Debug for Duration {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        let prefix = if f.sign_plus() { "+" } else { "" };
        let secs = self.nanos / 1_000_000_000;
        let sub = (self.nanos % 1_000_000_000) as u32;
        if secs > 0 {
            fmt_decimal(f, secs, sub, 100_000_000, prefix, "s")
        } else if sub >= 1_000_000 {
            fmt_decimal(
                f,
                (sub / 1_000_000) as u64,
                sub % 1_000_000,
                100_000,
                prefix,
                "ms",
            )
        } else if sub >= 1_000 {
            fmt_decimal(f, (sub / 1_000) as u64, sub % 1_000, 100, prefix, "µs")
        } else {
            fmt_decimal(f, sub as u64, 0, 1, prefix, "ns")
        }
    }
}

// Rust's fmt_decimal (core::time): integer.fraction (the fraction over
// divisor * 10) with the spec's precision (rounding half up) and width.
fn fmt_decimal(
    f: &mut crate::fmt::Formatter,
    integer_part: u64,
    fractional: u32,
    divisor: u32,
    prefix: &str,
    postfix: &str,
) -> crate::fmt::Result {
    let mut frac = fractional;
    let mut div = divisor;
    let mut buf = [b'0'; 9];
    let mut pos = 0;
    let digits = match f.precision() {
        Some(p) => p,
        None => 9,
    };
    while frac > 0 && pos < digits {
        buf[pos] = b'0' + (frac / div) as u8;
        frac = frac % div;
        div = div / 10;
        pos += 1;
    }
    // The rest rounds the digits up (half up), maybe into the integer.
    let mut int: Option<u64> = Some(integer_part);
    if frac > 0 && frac >= div * 5 {
        let mut rev = pos;
        let mut carry = true;
        while carry && rev > 0 {
            rev -= 1;
            if buf[rev] < b'9' {
                buf[rev] += 1;
                carry = false;
            } else {
                buf[rev] = b'0';
            }
        }
        if carry {
            int = integer_part.checked_add(1);
        }
    }
    let end = match f.precision() {
        Some(p) => {
            if p < 9 {
                p
            } else {
                9
            }
        }
        None => pos,
    };
    let frac_w = match f.precision() {
        Some(p) => p,
        None => pos,
    };
    let mut out = String::new();
    out.push_str(prefix);
    match int {
        Some(i) => out.push_str(i.to_string().as_str()),
        // (u64::MAX + 1.)
        None => out.push_str("18446744073709551616"),
    }
    if end > 0 {
        out.push('.');
        let mut k = 0;
        while k < end {
            out.push(buf[k] as char);
            k += 1;
        }
        while k < frac_w {
            out.push('0');
            k += 1;
        }
    }
    out.push_str(postfix);
    let w = out.chars().count();
    let pad = match f.width() {
        Some(req) => {
            if req > w {
                req - w
            } else {
                0
            }
        }
        None => 0,
    };
    let (pre, post) = match f.align() {
        Some(crate::fmt::Alignment::Right) => (pad, 0),
        Some(crate::fmt::Alignment::Center) => (pad / 2, (pad + 1) / 2),
        _ => (0, pad),
    };
    let fill = f.fill();
    let mut res = String::new();
    let mut k = 0;
    while k < pre {
        res.push(fill);
        k += 1;
    }
    res.push_str(out.as_str());
    k = 0;
    while k < post {
        res.push(fill);
        k += 1;
    }
    f.write_str(res.as_str())
}

impl crate::ops::Mul<u32> for Duration {
    type Output = Duration;
    fn mul(self, rhs: u32) -> Duration {
        Duration {
            nanos: self.nanos * rhs as u64,
        }
    }
}

impl crate::ops::Div<u32> for Duration {
    type Output = Duration;
    fn div(self, rhs: u32) -> Duration {
        Duration {
            nanos: self.nanos / rhs as u64,
        }
    }
}

impl crate::ops::AddAssign for Duration {
    fn add_assign(&mut self, rhs: Duration) {
        self.nanos = self.nanos + rhs.nanos;
    }
}

impl crate::ops::SubAssign for Duration {
    fn sub_assign(&mut self, rhs: Duration) {
        self.nanos = self.nanos - rhs.nanos;
    }
}

impl Instant {
    /// Returns `Some(t)` where `t` is the time `self + duration` if `t` can be
    /// represented, [`None`] otherwise.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::{Duration, Instant};
    ///
    /// let now = Instant::now();
    /// let later = now.checked_add(Duration::from_secs(1)).unwrap();
    /// assert_eq(later.duration_since(now), Duration::from_secs(1));
    /// assert_eq(Instant::now().checked_add(Duration::MAX), None);
    /// ```
    pub fn checked_add(&self, d: Duration) -> Option<Instant> {
        match self.nanos.checked_add(d.nanos) {
            Some(n) => Some(Instant { nanos: n }),
            None => None,
        }
    }

    /// Returns `Some(t)` where `t` is the time `self - duration` if `t` can be
    /// represented, [`None`] otherwise.
    ///
    /// The monotonic clock starts at an unspecified point (often the machine's
    /// boot), so going far enough back gives `None`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::{Duration, Instant};
    ///
    /// let now = Instant::now();
    /// assert_eq(now.checked_sub(Duration::MAX), None);
    /// let zero = now.checked_sub(Duration::ZERO).unwrap();
    /// assert_eq(zero, now);
    /// ```
    pub fn checked_sub(&self, d: Duration) -> Option<Instant> {
        if d.nanos > self.nanos {
            None
        } else {
            Some(Instant {
                nanos: self.nanos - d.nanos,
            })
        }
    }

    /// Returns the amount of time elapsed from another instant to this one, or
    /// zero duration if that instant is later than this one.
    ///
    /// This is the same as [`Instant::duration_since`], which in navi never
    /// panics either.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::{Duration, Instant};
    ///
    /// let now = Instant::now();
    /// let later = now.clone() + Duration::from_millis(5);
    /// assert_eq(
    ///     later.saturating_duration_since(now.clone()),
    ///     Duration::from_millis(5),
    /// );
    /// assert_eq(now.saturating_duration_since(later), Duration::ZERO);
    /// ```
    #[inline]
    pub fn saturating_duration_since(&self, earlier: Instant) -> Duration {
        self.duration_since(earlier)
    }

    /// Returns the amount of time elapsed from another instant to this one, or
    /// [`None`] if that instant is later than this one.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::{Duration, Instant};
    ///
    /// let now = Instant::now();
    /// let later = now.clone() + Duration::from_millis(5);
    /// assert_eq(
    ///     later.checked_duration_since(now.clone()),
    ///     Some(Duration::from_millis(5)),
    /// );
    /// assert_eq(now.checked_duration_since(later), None);
    /// ```
    pub fn checked_duration_since(&self, earlier: Instant) -> Option<Duration> {
        if earlier.nanos > self.nanos {
            None
        } else {
            Some(Duration {
                nanos: self.nanos - earlier.nanos,
            })
        }
    }
}

impl Add<Duration> for Instant {
    type Output = Instant;
    fn add(self, d: Duration) -> Instant {
        Instant {
            nanos: self.nanos + d.nanos,
        }
    }
}

impl Sub<Duration> for Instant {
    type Output = Instant;
    fn sub(self, d: Duration) -> Instant {
        Instant {
            nanos: self.nanos - d.nanos,
        }
    }
}

/// A measurement of the system clock, useful for talking to external entities
/// like the file system or other processes.
///
/// Distinct from the [`Instant`] type, this time measurement **is not
/// monotonic**: the system clock may be adjusted, so a later measurement can be
/// earlier than a previous one. Use `Instant` to measure how long something
/// takes, and `SystemTime` for timestamps (such as a file's modification time,
/// [`std::fs::Metadata::modified`](crate::fs::Metadata::modified)).
///
/// A `SystemTime` is the number of nanoseconds since [`UNIX_EPOCH`]; it can be
/// before the epoch. Subtracting two of them with
/// [`SystemTime::duration_since`] gives a [`Duration`] or, when the first is
/// earlier, a [`SystemTimeError`].
///
/// # Examples
///
/// ```
/// use std::time::{Duration, SystemTime, UNIX_EPOCH};
///
/// let now = SystemTime::now();
/// let since_epoch = now.duration_since(UNIX_EPOCH).unwrap();
/// // Later than 2020-01-01.
/// assert(since_epoch > Duration::from_secs(1_577_836_800));
/// ```
#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub struct SystemTime {
    nanos: i128,
}

/// An anchor in time which can be used to create new `SystemTime` instances or
/// learn about where in time a `SystemTime` lies.
///
/// This constant is defined to be "1970-01-01 00:00:00 UTC" on all systems.
///
/// # Examples
///
/// ```
/// use std::time::{SystemTime, UNIX_EPOCH};
///
/// match SystemTime::now().duration_since(UNIX_EPOCH) {
///     Ok(n) => println(`1970-01-01 00:00:00 UTC was ${n.as_secs()} seconds ago!`),
///     Err(_) => panic("SystemTime before UNIX EPOCH!"),
/// }
/// ```
pub const UNIX_EPOCH: SystemTime = SystemTime { nanos: 0 };

/// An error returned from the `duration_since` and `elapsed` methods on
/// [`SystemTime`], used to learn how far in the opposite direction a system
/// time lies.
///
/// # Examples
///
/// ```
/// use std::time::{Duration, SystemTime, UNIX_EPOCH};
///
/// let later = UNIX_EPOCH + Duration::from_secs(10);
/// let err = UNIX_EPOCH.duration_since(later).unwrap_err();
/// assert_eq(err.duration(), Duration::from_secs(10));
/// assert_eq(err.to_string(), "second time provided was later than self");
/// ```
#[derive(Clone, Debug)]
pub struct SystemTimeError {
    d: Duration,
}

impl SystemTimeError {
    /// Returns the positive duration which represents how far forward the
    /// second system time was from the first.
    ///
    /// A `SystemTimeError` is returned from the [`SystemTime::duration_since`]
    /// and [`SystemTime::elapsed`] methods whenever the second system time
    /// represents a point later in time than the `self` of the method call.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::{Duration, SystemTime};
    ///
    /// let sys_time = SystemTime::now();
    /// let later = sys_time.clone() + Duration::from_secs(1);
    /// match sys_time.duration_since(later) {
    ///     Ok(_) => panic("expected an error"),
    ///     Err(e) => assert_eq(e.duration(), Duration::from_secs(1)),
    /// }
    /// ```
    #[inline]
    pub fn duration(&self) -> Duration {
        self.d.clone()
    }
}

impl crate::fmt::Display for SystemTimeError {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        f.write_str("second time provided was later than self")
    }
}

impl SystemTime {
    /// An anchor in time which can be used to create new `SystemTime` instances
    /// or learn about where in time a `SystemTime` lies.
    ///
    /// This is the same as the module's [`UNIX_EPOCH`] constant: "1970-01-01
    /// 00:00:00 UTC".
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::{SystemTime, UNIX_EPOCH};
    ///
    /// assert_eq(SystemTime::UNIX_EPOCH, UNIX_EPOCH);
    /// ```
    pub const UNIX_EPOCH: SystemTime = SystemTime { nanos: 0 };

    /// Returns the system time corresponding to "now".
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::{SystemTime, UNIX_EPOCH};
    ///
    /// let sys_time = SystemTime::now();
    /// assert(sys_time > UNIX_EPOCH);
    /// ```
    #[inline]
    pub fn now() -> SystemTime {
        SystemTime {
            nanos: crate::rt::native::realtime_nanos() as i128,
        }
    }

    /// The time n nanoseconds after the Unix epoch (std::fs).
    pub(crate) fn from_unix_nanos(n: i128) -> SystemTime {
        SystemTime { nanos: n }
    }

    pub(crate) fn unix_nanos(&self) -> i128 {
        self.nanos
    }

    /// Returns the amount of time elapsed from an earlier point in time.
    ///
    /// This function may fail because measurements taken earlier are not
    /// guaranteed to always be before later measurements (the system clock can
    /// be adjusted).
    ///
    /// # Errors
    ///
    /// Returns a [`SystemTimeError`] if `earlier` is later than `self`; the
    /// error's [`duration`](SystemTimeError::duration) is how much later it is.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::{Duration, SystemTime, UNIX_EPOCH};
    ///
    /// let t = UNIX_EPOCH + Duration::from_secs(100);
    /// assert_eq(
    ///     t.duration_since(UNIX_EPOCH).unwrap(),
    ///     Duration::from_secs(100),
    /// );
    /// assert(UNIX_EPOCH.duration_since(t).is_err());
    /// ```
    pub fn duration_since(&self, earlier: SystemTime) -> Result<Duration, SystemTimeError> {
        if self.nanos >= earlier.nanos {
            Ok(Duration {
                nanos: (self.nanos - earlier.nanos) as u64,
            })
        } else {
            Err(SystemTimeError {
                d: Duration {
                    nanos: (earlier.nanos - self.nanos) as u64,
                },
            })
        }
    }

    /// Returns the difference from this system time to the current system time.
    ///
    /// # Errors
    ///
    /// Returns a [`SystemTimeError`] if `self` is later than the current system
    /// time (which can happen when the clock is adjusted). Use [`Instant`] to
    /// measure elapsed time reliably.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::{
    ///     thread::sleep,
    ///     time::{Duration, SystemTime},
    /// };
    ///
    /// let sys_time = SystemTime::now();
    /// let one_milli = Duration::from_millis(1);
    /// sleep(one_milli);
    /// // The clock may have gone back meanwhile, so elapsed can fail.
    /// if let Ok(d) = sys_time.elapsed() {
    ///     println(`${d.as_micros()} µs`);
    /// }
    /// ```
    #[inline]
    pub fn elapsed(&self) -> Result<Duration, SystemTimeError> {
        SystemTime::now().duration_since(self.clone())
    }

    /// Returns `Some(t)` where `t` is the time `self + duration` if `t` can be
    /// represented as `SystemTime`, [`None`] otherwise.
    ///
    /// As Rust's on Unix, a `SystemTime` is at most `i64::MAX` seconds from
    /// [`UNIX_EPOCH`] either way.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::{Duration, UNIX_EPOCH};
    ///
    /// let t = UNIX_EPOCH.checked_add(Duration::from_secs(60)).unwrap();
    /// assert_eq(
    ///     t.duration_since(UNIX_EPOCH).unwrap(),
    ///     Duration::from_secs(60),
    /// );
    /// ```
    #[inline]
    pub fn checked_add(&self, d: Duration) -> Option<SystemTime> {
        system_time(self.nanos + d.nanos as i128)
    }

    /// Returns `Some(t)` where `t` is the time `self - duration` if `t` can be
    /// represented as `SystemTime`, [`None`] otherwise.
    ///
    /// The result may be before [`UNIX_EPOCH`]: as Rust's on Unix, a
    /// `SystemTime` is at most `i64::MAX` seconds from it either way.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::{Duration, UNIX_EPOCH};
    ///
    /// let before = UNIX_EPOCH.checked_sub(Duration::from_secs(1)).unwrap();
    /// assert(before < UNIX_EPOCH);
    /// assert_eq(
    ///     UNIX_EPOCH.duration_since(before).unwrap(),
    ///     Duration::from_secs(1),
    /// );
    /// ```
    #[inline]
    pub fn checked_sub(&self, d: Duration) -> Option<SystemTime> {
        system_time(self.nanos - d.nanos as i128)
    }
}

// A SystemTime of nanos since the epoch, if Rust's Unix one (i64 seconds,
// with the nanoseconds in [0, 1e9)) holds it.
fn system_time(nanos: i128) -> Option<SystemTime> {
    let secs = nanos.div_euclid(1_000_000_000);
    if secs < i64::MIN as i128 || secs > i64::MAX as i128 {
        return None;
    }
    Some(SystemTime { nanos })
}

impl Add<Duration> for SystemTime {
    type Output = SystemTime;
    fn add(self, d: Duration) -> SystemTime {
        SystemTime {
            nanos: self.nanos + d.nanos as i128,
        }
    }
}

impl Sub<Duration> for SystemTime {
    type Output = SystemTime;
    fn sub(self, d: Duration) -> SystemTime {
        SystemTime {
            nanos: self.nanos - d.nanos as i128,
        }
    }
}

// --- Timer channels (Go's time.After, time.Tick and Ticker as of Go 1.23;
// crossbeam's after and tick), for timeouts and periodic work in select.
// They are the runtime's (rt::sched timer channels): no thread each, a
// value made when a receiver looks after its time, and one nobody refers
// to is collected, stopped or not. ----------------------------------------

/// Returns a channel that receives the current [`Instant`] once, `d` from now
/// (Go's `time.After`).
///
/// Use it in `select` for a timeout. The timer is the runtime's: it takes no
/// thread, the value is made when a receiver looks for it after the deadline,
/// and a channel nobody refers to any more is collected (it need not be
/// stopped).
///
/// # Examples
///
/// ```
/// use std::{
///     sync::mpmc::channel,
///     time::{Duration, after},
/// };
///
/// let (tx, rx) = channel::<i32>();
/// let mut timed_out = false;
/// select {
///     v = rx.recv() => println(`got ${v:?}`),
///     t = after(Duration::from_millis(10)).recv() => timed_out = true,
/// }
/// assert(timed_out);
/// tx.close();
/// ```
pub fn after(d: Duration) -> crate::sync::mpmc::Receiver<Instant> {
    crate::sync::mpmc::Receiver::<Instant>::timer(Instant::now().nanos + d.nanos, 0)
}

/// Returns a channel that receives the current [`Instant`] every `d` (Go's
/// `time.Tick`).
///
/// A tick not received before the next one is dropped. The ticks never stop;
/// use a [`Ticker`] to stop or reset them. Like [`after`], the channel takes no
/// thread and is collected when nobody refers to it.
///
/// # Panics
///
/// Panics if `d` is zero.
///
/// # Examples
///
/// ```
/// use std::time::{Duration, Instant, tick};
///
/// let start = Instant::now();
/// let ticks = tick(Duration::from_millis(5));
/// for _ in 0..3 {
///     ticks.recv().unwrap();
/// }
/// assert(start.elapsed() >= Duration::from_millis(15));
/// ```
pub fn tick(d: Duration) -> crate::sync::mpmc::Receiver<Instant> {
    Ticker::new(d).receiver()
}

/// A source of instants every period until stopped (Go's `time.Ticker`).
///
/// The ticks come on a channel ([`Ticker::receiver`], for `select`) or with
/// [`Ticker::recv`]. They are scheduled on deadlines, so they do not drift; a
/// tick not received before the next one is dropped. Clones share the ticker. A
/// ticker nobody refers to is collected, so [`stop`](Ticker::stop) is only
/// needed to end the ticks early.
///
/// # Examples
///
/// ```
/// use std::time::{Duration, Instant, Ticker};
///
/// let start = Instant::now();
/// let ticker = Ticker::new(Duration::from_millis(5));
/// ticker.recv();
/// ticker.recv();
/// assert(start.elapsed() >= Duration::from_millis(10));
/// ticker.stop();
/// ```
#[derive(Clone)]
pub struct Ticker {
    rx: crate::sync::mpmc::Receiver<Instant>,
}

impl Ticker {
    /// Creates a ticker that ticks every `period`, the first tick one period
    /// from now.
    ///
    /// # Panics
    ///
    /// Panics if `period` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::{Duration, Ticker};
    ///
    /// let ticker = Ticker::new(Duration::from_millis(1));
    /// let first = ticker.recv();
    /// let second = ticker.recv();
    /// assert(second > first);
    /// ```
    pub fn new(period: Duration) -> Ticker {
        if period.is_zero() {
            crate::panic::panic("Ticker::new: a zero period");
        }
        Ticker {
            rx: crate::sync::mpmc::Receiver::<Instant>::timer(
                Instant::now().nanos + period.nanos,
                period.nanos,
            ),
        }
    }

    /// Returns the channel the ticks come on, for use in `select`.
    ///
    /// Every call returns a handle on the same channel.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::{
    ///     sync::mpmc::channel,
    ///     time::{Duration, Ticker},
    /// };
    ///
    /// let ticker = Ticker::new(Duration::from_millis(1));
    /// let (tx, rx) = channel::<()>();
    /// let mut ticks = 0;
    /// while ticks < 3 {
    ///     select {
    ///         _ = rx.recv() => break,
    ///         _ = ticker.receiver().recv() => ticks += 1,
    ///     }
    /// }
    /// assert_eq(ticks, 3);
    /// tx.close();
    /// ```
    pub fn receiver(&self) -> crate::sync::mpmc::Receiver<Instant> {
        self.rx.clone()
    }

    /// Blocks the current thread until the next tick and returns its instant.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::{Duration, Instant, Ticker};
    ///
    /// let start = Instant::now();
    /// let ticker = Ticker::new(Duration::from_millis(2));
    /// let t = ticker.recv();
    /// assert(t >= start + Duration::from_millis(2));
    /// ```
    pub fn recv(&self) -> Instant {
        self.rx.recv().unwrap()
    }

    /// Stops the ticks: no more come on the channel.
    ///
    /// A ticker nobody refers to is collected, so stopping it is not needed to
    /// free it (as in Go 1.23).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::{Duration, Ticker};
    ///
    /// let ticker = Ticker::new(Duration::from_millis(1));
    /// ticker.recv();
    /// ticker.stop();
    /// std::thread::sleep(Duration::from_millis(5));
    /// assert(ticker.receiver().try_recv().is_err());
    /// ```
    pub fn stop(&self) {
        self.rx.timer_set(0, 0);
    }

    /// Restarts the ticks with a new period: the next tick is `period` from now
    /// (Go's `Ticker.Reset`).
    ///
    /// A stopped ticker starts ticking again.
    ///
    /// # Panics
    ///
    /// Panics if `period` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::time::{Duration, Instant, Ticker};
    ///
    /// let ticker = Ticker::new(Duration::from_secs(3600));
    /// let start = Instant::now();
    /// ticker.reset(Duration::from_millis(2));
    /// ticker.recv();
    /// assert(start.elapsed() < Duration::from_secs(3600));
    /// ```
    pub fn reset(&self, period: Duration) {
        if period.is_zero() {
            crate::panic::panic("Ticker::reset: a zero period");
        }
        self.rx
            .timer_set(Instant::now().nanos + period.nanos, period.nanos);
    }
}
