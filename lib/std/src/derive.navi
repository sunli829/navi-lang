//! The API of derive macros: what a `#[derive_macro]` function sees of the
//! type it derives for, and the code it returns.
//!
//! A derive macro is a function of a library crate, marked
//! `#[derive_macro(Name)]` (or `#[derive_macro(Name, attrs = [ns])]` to
//! take `#[ns(...)]` helper attributes). It gets the [`TypeInfo`] of the
//! struct or enum that derives it, as written (its name, generics, fields,
//! variants and attributes), and returns the [`Code`] of the items to add,
//! usually written with [`quote`] templates (``quote`...` ``, Rust's
//! `quote!`) and wrapped with [`TypeInfo::impl_for`]:
//!
//! ```navi
//! use std::derive::{Code, Error, TypeInfo, quote};
//!
//! #[derive_macro(Describe)]
//! pub fn describe(t: &TypeInfo) -> Result<Code, Error> {
//!     let name = t.name().to_string();
//!     let body = quote`fn describe(&self) -> &str { ${name} }`;
//!     Ok(t.impl_for("::mylib::Describe", body))
//! }
//! ```
//!
//! The compiler builds the macro's crate into a small program for the host
//! ([`serve`] is its main), sends it the `TypeInfo` of every type that
//! derives one of its macros, and parses the `Code` it returns as items in
//! the type's module. Positions in a `TypeInfo` are byte offsets in the
//! type's file: code made from its parts (identifiers, types, fields)
//! keeps them, so errors in it point at the user's code; the rest of the
//! code is at the `#[derive(...)]` attribute. See `docs/derive.md` for the
//! whole design.
//!
//! # Testing a macro
//!
//! [`TypeInfo::of`] gives the `TypeInfo` of a type in an ordinary test, so
//! a macro's function can be called and its code checked:
//!
//! ```
//! use std::derive::{Binding, Code, Error, TypeInfo, quote};
//!
//! struct Point {
//!     x: i32,
//!     y: i32,
//! }
//!
//! // Sums the fields.
//! fn total(t: &TypeInfo) -> Result<Code, Error> {
//!     let sum = t.each(|b: &Binding| quote`n = n + ${b} as i64;`);
//!     Ok(t.impl_for("Total", quote`fn total(&self) -> i64 { let mut n = 0i64; ${sum} n }`))
//! }
//!
//! let code = total(&TypeInfo::of::<Point>()).unwrap();
//! assert_eq(
//!     code.text(),
//!     "impl Total for Point { fn total(&self) -> i64 { let mut n = 0i64; { n = n + self.x as i64; n = n + self.y as i64; } n } }",
//! );
//! ```

use crate::collections::HashMap;

/// The position of code that has none of its own: it is reported at the
/// `#[derive(...)]` attribute.
pub const NO_POS: i32 = -1;

// --- Code ----------------------------------------------------------------

/// Generated code: its text, and the positions in the user's file that
/// parts of it come from.
///
/// Code is usually made with [`quote`] templates; values put in a
/// template's holes keep their positions (an [`Ident`], a [`TypeRef`], a
/// [`Binding`]), so a compile error in the generated code points at the
/// user's code they come from.
///
/// # Examples
///
/// ```
/// use std::derive::{Code, Ident, quote};
///
/// let name = Ident::new("Point");
/// let mut c = quote`impl Default for ${name}`;
/// c.push(&quote`{ fn default() -> ${name} { ${name} { x: 0 } } }`);
/// assert_eq(c.text(), "impl Default for Point { fn default() -> Point { Point { x: 0 } } }");
/// assert(!c.is_empty());
/// assert(Code::new().is_empty());
/// ```
#[derive(Clone)]
pub struct Code {
    text: String,
    spans: Vec<Span>,
}

/// A part of a [`Code`]'s text that comes from a position in the user's
/// file: bytes `start..end` of the text come from position `pos`.
#[derive(Clone)]
pub struct Span {
    /// The start of the part, a byte offset in the code's text.
    pub start: u32,
    /// The end of the part (exclusive).
    pub end: u32,
    /// The position in the user's file (a byte offset), or [`NO_POS`].
    pub pos: i32,
}

impl Code {
    /// Returns empty code.
    pub fn new() -> Code {
        Code {
            text: String::new(),
            spans: Vec::new(),
        }
    }

    /// Returns code with the given text, at the default position.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::derive::Code;
    ///
    /// assert_eq(Code::from_text("::std::fmt::Debug").text(), "::std::fmt::Debug");
    /// ```
    pub fn from_text(text: &str) -> Code {
        Code {
            text: text.to_string(),
            spans: Vec::new(),
        }
    }

    /// Returns code with the given text, from position `pos` of the user's
    /// file.
    pub fn spanned(text: &str, pos: i32) -> Code {
        let mut c = Code::from_text(text);
        if pos >= 0 && text.len() > 0 {
            c.spans.push(Span {
                start: 0,
                end: text.len() as u32,
                pos,
            });
        }
        c
    }

    /// Returns `true` if the code has no text but whitespace.
    pub fn is_empty(&self) -> bool {
        self.text.trim().len() == 0
    }

    /// Returns the code's text, as generated (not formatted).
    pub fn text(&self) -> &str {
        self.text.as_str()
    }

    /// Returns the parts of the text that come from positions in the user's
    /// file.
    pub fn spans(&self) -> &Vec<Span> {
        &self.spans
    }

    /// Appends `other`, with a space between unless the code reads as well
    /// without one (there is always one where two tokens would run
    /// together).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::derive::Code;
    ///
    /// let mut c = Code::from_text("fn f()");
    /// c.push(&Code::from_text("{}"));
    /// c.push_str("fn g() {}");
    /// assert_eq(c.text(), "fn f() {} fn g() {}");
    /// ```
    pub fn push(&mut self, other: &Code) {
        let a = self.text.as_bytes();
        let b = other.text.as_bytes();
        if b.len() == 0 {
            return;
        }
        // Whitespace on both sides: one is enough.
        let mut skip = 0usize;
        if a.len() > 0 && is_space(a[a.len() - 1]) {
            while skip < b.len() && is_space(b[skip]) {
                skip += 1;
            }
        }
        if skip == b.len() {
            return;
        }
        // (::a::b after a keyword: impl ::m::T, not impl::m::T.)
        let root = skip + 1 < b.len() && b[skip] == b':' && b[skip + 1] == b':';
        if a.len() > 0 && (spaced(a, b[skip]) || (root && ends_with_keyword(a))) {
            self.text.push(' ');
        }
        let base = self.text.len() as u32;
        self.text.push_str(&other.text[skip..]);
        for s in other.spans.iter() {
            if s.end as usize <= skip {
                continue;
            }
            let st = if (s.start as usize) < skip {
                0
            } else {
                s.start - skip as u32
            };
            self.spans.push(Span {
                start: st + base,
                end: s.end - skip as u32 + base,
                pos: s.pos,
            });
        }
    }

    /// Appends `text`, at the default position (see [`push`](Code::push)).
    pub fn push_str(&mut self, text: &str) {
        self.push(&Code::from_text(text));
    }

    /// Returns the same code at `x`'s position (as Rust's `quote_spanned!`):
    /// errors in it that no inner part claims point at `x`.
    pub fn at<X: Spanned>(&self, x: &X) -> Code {
        let mut c = self.clone();
        let p = x.pos();
        if p >= 0 && c.text.len() > 0 {
            let mut spans = Vec::new();
            spans.push(Span {
                start: 0,
                end: c.text.len() as u32,
                pos: p,
            });
            for s in c.spans.iter() {
                spans.push(s.clone());
            }
            c.spans = spans;
        }
        c
    }
}

impl crate::fmt::Display for Code {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        f.write_str(self.text.as_str())
    }
}

impl crate::fmt::Debug for Code {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        f.write_fmt(`Code(${self.text:?})`)
    }
}

fn is_space(c: u8) -> bool {
    c == b' ' || c == b'\n' || c == b'\t' || c == b'\r'
}

fn is_word(c: u8) -> bool {
    c == b'_'
        || (c >= b'0' && c <= b'9')
        || (c >= b'a' && c <= b'z')
        || (c >= b'A' && c <= b'Z')
        || c >= 0x80
}

fn is_op(c: u8) -> bool {
    match c {
        b'+' | b'-' | b'*' | b'/' | b'%' | b'=' | b'<' | b'>' | b'!' | b'&' | b'|' | b'^'
        | b':' | b'.' => true,
        _ => false,
    }
}

// Whether a ends with a keyword a path may follow.
fn ends_with_keyword(a: &[u8]) -> bool {
    let mut i = a.len();
    while i > 0 && is_word(a[i - 1]) {
        i -= 1;
    }
    if i == a.len() || (i > 0 && a[i - 1] == b':') {
        return false;
    }
    match &a[i..] {
        b"impl" | b"for" | b"dyn" | b"as" | b"in" | b"where" | b"return" | b"let" | b"mut"
        | b"const" | b"static" | b"type" | b"else" | b"match" | b"if" | b"while" => true,
        _ => false,
    }
}

// Whether code a and code starting with y need a space between: where they
// would make one token, else unless one side reads tight (f(x), a.b,
// Vec<T>, x: T, a::b, &x).
fn spaced(a: &[u8], y: u8) -> bool {
    let x = a[a.len() - 1];
    if is_space(x) || is_space(y) {
        return false;
    }
    if (is_word(x) && is_word(y)) || (is_op(x) && is_op(y)) {
        return true;
    }
    match y {
        b',' | b';' | b'.' | b')' | b']' | b'>' | b':' | b'(' | b'<' => return false,
        _ => {}
    }
    match x {
        b'(' | b'[' | b'.' | b'<' | b'&' | b'!' => return false,
        b':' => return !(a.len() >= 2 && a[a.len() - 2] == b':'),
        _ => {}
    }
    true
}

/// Returns the code of a template: ``quote`...` ``, as Rust's `quote!`.
///
/// It is called as a template tag: ``quote`fn f() -> ${ty} { ${body} }` ``.
/// The compiler lexes the template's text when it compiles the macro (its
/// brackets must match) and calls this function with the text between the
/// holes and each hole's value as code (by [`ToCode`]): code, identifiers,
/// types and bindings as they are, strings as string literals, numbers
/// with their type's suffix, a `Vec` or slice as its elements one after
/// the other, an `Option` as its value or nothing. `` \` `` and `\$` write
/// a backquote and a dollar sign.
///
/// # Examples
///
/// ```
/// use std::derive::{Code, Ident, quote};
///
/// let name = Ident::new("Foo");
/// let label = "a\"b";
/// let n = 3usize;
/// let c = quote`struct ${name}; const N: usize = ${n}; const S: &str = ${label};`;
/// assert_eq(c.text(), "struct Foo; const N: usize = 3usize; const S: &str = \"a\\\"b\";");
///
/// let mut stmts: Vec<Code> = Vec::new();
/// stmts.push(quote`a();`);
/// stmts.push(quote`b();`);
/// let none: Option<Code> = None;
/// assert_eq(quote`{ ${stmts} ${none} }`.text(), "{ a(); b(); }");
/// ```
pub fn quote(parts: &[&str], values: &[Code]) -> Code {
    let mut c = Code::new();
    let mut i = 0;
    while i < parts.len() {
        c.push_str(parts[i]);
        if i < values.len() {
            c.push(&values[i]);
        }
        i += 1;
    }
    c
}

/// A value that can be put in a hole of a [`quote`] template.
pub trait ToCode {
    /// Returns the value as code.
    fn to_code(&self) -> Code;
}

impl ToCode for Code {
    fn to_code(&self) -> Code {
        self.clone()
    }
}

/// A string literal (escaped).
impl ToCode for str {
    fn to_code(&self) -> Code {
        Code::from_text(string_literal(self).as_str())
    }
}

impl ToCode for String {
    fn to_code(&self) -> Code {
        Code::from_text(string_literal(self.as_str()).as_str())
    }
}

impl<T: ToCode> ToCode for &T {
    fn to_code(&self) -> Code {
        (**self).to_code()
    }
}

impl<T: ToCode> ToCode for &mut T {
    fn to_code(&self) -> Code {
        (**self).to_code()
    }
}

/// Each element in turn.
impl<T: ToCode> ToCode for [T] {
    fn to_code(&self) -> Code {
        let mut c = Code::new();
        for x in self.iter() {
            c.push(&x.to_code());
        }
        c
    }
}

impl<T: ToCode> ToCode for Vec<T> {
    fn to_code(&self) -> Code {
        self.as_slice().to_code()
    }
}

/// None is no code.
impl<T: ToCode> ToCode for Option<T> {
    fn to_code(&self) -> Code {
        match self {
            Some(x) => x.to_code(),
            None => Code::new(),
        }
    }
}

impl ToCode for bool {
    fn to_code(&self) -> Code {
        Code::from_text(if *self { "true" } else { "false" })
    }
}

impl ToCode for char {
    fn to_code(&self) -> Code {
        Code::from_text(`${self:?}`.to_string().as_str())
    }
}

impl ToCode for i32 {
    fn to_code(&self) -> Code {
        Code::from_text(`${self}i32`.to_string().as_str())
    }
}
impl ToCode for i64 {
    fn to_code(&self) -> Code {
        Code::from_text(`${self}i64`.to_string().as_str())
    }
}
impl ToCode for u32 {
    fn to_code(&self) -> Code {
        Code::from_text(`${self}u32`.to_string().as_str())
    }
}
impl ToCode for u64 {
    fn to_code(&self) -> Code {
        Code::from_text(`${self}u64`.to_string().as_str())
    }
}
impl ToCode for usize {
    fn to_code(&self) -> Code {
        Code::from_text(`${self}usize`.to_string().as_str())
    }
}
impl ToCode for isize {
    fn to_code(&self) -> Code {
        Code::from_text(`${self}isize`.to_string().as_str())
    }
}

/// Returns `s` as a navi string literal, quoted and escaped.
///
/// # Examples
///
/// ```
/// use std::derive::string_literal;
///
/// assert_eq(string_literal("say \"hi\"\n"), "\"say \\\"hi\\\"\\n\"");
/// ```
pub fn string_literal(s: &str) -> String {
    let mut out = String::new();
    out.push('"');
    for c in s.chars() {
        match c {
            '"' => out.push_str("\\\""),
            '\\' => out.push_str("\\\\"),
            '\n' => out.push_str("\\n"),
            '\r' => out.push_str("\\r"),
            '\t' => out.push_str("\\t"),
            '\0' => out.push_str("\\0"),
            _ => out.push(c),
        }
    }
    out.push('"');
    out
}

// --- What a macro sees -----------------------------------------------------

/// Something with a position in the user's code: what [`Error::at`] and
/// [`Code::at`] take.
pub trait Spanned {
    /// Returns the position, a byte offset in the type's file, or
    /// [`NO_POS`].
    fn pos(&self) -> i32;
}

/// An identifier; put in code, it keeps its position.
///
/// # Examples
///
/// ```
/// use std::derive::{Ident, quote};
///
/// let f = Ident::new("len");
/// assert_eq(f.as_str(), "len");
/// assert_eq(quote`self.${f}()`.text(), "self.len()");
/// ```
#[derive(Clone, Debug, PartialEq)]
pub struct Ident {
    name: String,
    pos: i32,
}

impl Ident {
    /// Returns an identifier at the default position.
    pub fn new(name: &str) -> Ident {
        Ident {
            name: name.to_string(),
            pos: NO_POS,
        }
    }

    /// Returns an identifier at position `pos` of the user's file.
    pub fn with_pos(name: &str, pos: i32) -> Ident {
        Ident {
            name: name.to_string(),
            pos,
        }
    }

    /// Returns the identifier's text.
    pub fn as_str(&self) -> &str {
        self.name.as_str()
    }
}

impl Spanned for Ident {
    fn pos(&self) -> i32 {
        self.pos
    }
}

impl ToCode for Ident {
    fn to_code(&self) -> Code {
        Code::spanned(self.name.as_str(), self.pos)
    }
}

impl crate::fmt::Display for Ident {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        f.write_str(self.name.as_str())
    }
}

/// A type as written in the user's code: its text, and its parts.
///
/// # Examples
///
/// ```
/// use std::derive::{TypeInfo, TypeKind};
///
/// struct S {
///     tags: Vec<Option<String>>,
///     raw: [u8; 4],
/// }
///
/// let fields = TypeInfo::of::<S>().fields();
/// let t = fields[0].ty();
/// assert_eq(t.text(), "Vec<Option<String>>");
/// assert_eq(t.last_name(), Some("Vec"));
/// assert(t.args()[0].is("Option"));
/// match fields[1].ty().kind() {
///     TypeKind::Array(elem, len) => {
///         assert_eq(elem.text(), "u8");
///         assert_eq(len.as_str(), "4");
///     }
///     _ => panic("not an array"),
/// }
/// ```
#[derive(Clone, Debug)]
pub struct TypeRef {
    text: String,
    pos: i32,
    kind: TypeKind,
}

/// The parts of a [`TypeRef`].
#[derive(Clone, Debug)]
pub enum TypeKind {
    /// a::b::C<X, Y>: each segment's name and generic arguments.
    Path(Vec<Segment>),
    /// &T or &mut T (true).
    Ref(bool, &TypeRef),
    /// [T; N]: the element and the length as written.
    Array(&TypeRef, String),
    /// [T]
    Slice(&TypeRef),
    /// (A, B)
    Tuple(Vec<TypeRef>),
    /// Anything else (fn, dyn, raw pointers, !, impl Trait).
    Other,
}

/// A segment of a path type: `C<X, Y>` in `a::b::C<X, Y>`.
#[derive(Clone, Debug)]
pub struct Segment {
    /// The segment's name.
    pub name: String,
    /// Its generic arguments (none if it has no `<...>`).
    pub args: Vec<TypeRef>,
}

impl TypeRef {
    /// Returns the parts of the type.
    pub fn kind(&self) -> &TypeKind {
        &self.kind
    }

    /// Returns the type's text as written.
    pub fn text(&self) -> &str {
        self.text.as_str()
    }

    /// Returns the name of a path type's last segment (`Option` for
    /// `std::option::Option<T>`), or `None` for another type.
    pub fn last_name(&self) -> Option<&str> {
        match &self.kind {
            TypeKind::Path(segs) => {
                if segs.len() > 0 {
                    Some(segs[segs.len() - 1].name.as_str())
                } else {
                    None
                }
            }
            _ => None,
        }
    }

    /// Returns the generic arguments of a path type's last segment (none
    /// for another type).
    pub fn args(&self) -> Vec<TypeRef> {
        match &self.kind {
            TypeKind::Path(segs) => {
                if segs.len() > 0 {
                    segs[segs.len() - 1].args.clone()
                } else {
                    Vec::new()
                }
            }
            _ => Vec::new(),
        }
    }

    /// Returns `true` if this is a one-segment path type named `name`, as
    /// `Option<T>` is `Option`.
    pub fn is(&self, name: &str) -> bool {
        match &self.kind {
            TypeKind::Path(segs) => segs.len() == 1 && segs[0].name == name,
            _ => false,
        }
    }
}

impl Spanned for TypeRef {
    fn pos(&self) -> i32 {
        self.pos
    }
}

impl ToCode for TypeRef {
    fn to_code(&self) -> Code {
        Code::spanned(self.text.as_str(), self.pos)
    }
}

/// An attribute: `#[name(key = value, flag, ...)]`.
///
/// Most macros read attributes with `parse_attrs` and a type deriving
/// [`FromAttrs`] rather than these fields.
#[derive(Clone, Debug)]
pub struct Attr {
    /// The attribute's name (`serde` in `#[serde(...)]`).
    pub name: String,
    /// Its position.
    pub pos: i32,
    /// Its arguments, in order.
    pub args: Vec<AttrArg>,
}

/// An argument of an attribute: `key = value` or a `key` alone.
#[derive(Clone, Debug)]
pub struct AttrArg {
    /// The key.
    pub key: Ident,
    /// The value, `None` for a key alone.
    pub value: Option<AttrValue>,
}

/// An attribute argument's value, with its position.
#[derive(Clone, Debug)]
pub enum AttrValue {
    /// A string literal (its value, unescaped).
    Str(String, i32),
    /// An integer literal.
    Int(i64, i32),
    /// `true` or `false`.
    Bool(bool, i32),
    /// Any other literal or path, as written.
    Other(String, i32),
}

impl Spanned for Attr {
    fn pos(&self) -> i32 {
        self.pos
    }
}
impl Spanned for AttrArg {
    fn pos(&self) -> i32 {
        self.key.pos
    }
}

/// A field of a struct or of an enum's variant.
///
/// # Examples
///
/// ```
/// use std::derive::TypeInfo;
///
/// struct Pair(pub i32, String);
///
/// let fields = TypeInfo::of::<Pair>().fields();
/// assert(fields[0].name().is_none());
/// assert_eq(fields[1].ident().as_str(), "1");
/// assert_eq(fields[1].index(), 1);
/// assert_eq(fields[0].vis(), "pub");
/// assert_eq(fields[1].ty().text(), "String");
/// ```
#[derive(Clone, Debug)]
pub struct Field {
    name: Option<Ident>,
    index: usize,
    ty: TypeRef,
    attrs: Vec<Attr>,
    vis: String,
    pos: i32,
}

impl Field {
    /// Returns the name of a named field (`None` for a tuple field).
    pub fn name(&self) -> Option<Ident> {
        self.name.clone()
    }

    /// Returns the name, or the index of a tuple field (as in `self.0`).
    pub fn ident(&self) -> Ident {
        match &self.name {
            Some(n) => n.clone(),
            None => Ident::with_pos(`${self.index}`.to_string().as_str(), self.pos),
        }
    }

    /// Returns the field's position among the fields, from 0.
    pub fn index(&self) -> usize {
        self.index
    }

    /// Returns the field's type.
    pub fn ty(&self) -> &TypeRef {
        &self.ty
    }

    /// Returns the field's visibility as written: `""` (private), `"pub"`,
    /// `"pub(crate)"` or `"pub(super)"`.
    pub fn vis(&self) -> &str {
        self.vis.as_str()
    }

    /// Returns the field's attributes.
    pub fn attrs(&self) -> &Vec<Attr> {
        &self.attrs
    }

    /// Returns `true` if the field has an attribute named `name`.
    pub fn has_attr(&self, name: &str) -> bool {
        has(&self.attrs, name)
    }

    /// The /// comment above it, lines joined by newlines (None for none
    /// or where the compiler has no source: TypeInfo::of).
    pub fn doc(&self) -> Option<String> {
        doc_of(&self.attrs)
    }

    /// Parses the field's `#[ns(...)]` attributes as `T` (see
    /// [`FromAttrs`]).
    ///
    /// # Errors
    ///
    /// Fails, at the field, if an argument is unknown or of the wrong type,
    /// or a required one is missing.
    pub fn parse_attrs<T: FromAttrs>(&self, ns: &str) -> Result<T, Error> {
        parse_attrs::<T>(&self.attrs, ns, self.pos)
    }
}

impl Spanned for Field {
    fn pos(&self) -> i32 {
        self.pos
    }
}

/// The kind of a struct or variant.
#[derive(Clone, Debug, PartialEq)]
pub enum Kind {
    /// Named fields: `S { a: A }`.
    Named,
    /// Tuple fields: `S(A, B)`.
    Tuple,
    /// No fields: `S`.
    Unit,
}

/// A variant of an enum, or a struct itself (taken as one variant, so that
/// [`TypeInfo::each_variant`] handles both).
///
/// # Examples
///
/// ```
/// use std::derive::{Code, Kind, TypeInfo, quote};
///
/// enum Shape {
///     Circle { r: f64 },
///     Square(i32),
///     Empty,
/// }
///
/// let t = TypeInfo::of::<Shape>();
/// let v = &t.variants()[1];
/// assert_eq(v.name().as_str(), "Square");
/// assert_eq(v.kind(), Kind::Tuple);
/// assert_eq(v.index(), 1);
/// assert_eq(v.path().text(), "Shape::Square");
/// assert_eq(v.pattern().text(), "Shape::Square(__binding_0)");
/// let zero: Vec<Code> = Vec::from([quote`0`]);
/// assert_eq(v.construct(zero.as_slice()).text(), "Shape::Square(0)");
/// assert_eq(t.variants()[0].pattern().text(), "Shape::Circle { r: __binding_0 }");
/// ```
#[derive(Clone, Debug)]
pub struct Variant {
    name: Ident,
    /// The path in patterns and constructors: Type or Type::Variant.
    path: String,
    kind: Kind,
    fields: Vec<Field>,
    attrs: Vec<Attr>,
    discr: String,
    index: usize,
    /// The struct itself: its fields are read as self.x (no match).
    of_struct: bool,
}

impl Variant {
    /// Returns the variant's name (the struct's, for a struct).
    pub fn name(&self) -> Ident {
        self.name.clone()
    }

    /// Returns the kind of the variant's fields.
    pub fn kind(&self) -> Kind {
        self.kind
    }

    /// Returns the variant's fields.
    pub fn fields(&self) -> &Vec<Field> {
        &self.fields
    }

    /// Returns the variant's attributes.
    pub fn attrs(&self) -> &Vec<Attr> {
        &self.attrs
    }

    /// Returns `true` if the variant has an attribute named `name`.
    pub fn has_attr(&self, name: &str) -> bool {
        has(&self.attrs, name)
    }

    /// The /// comment above it, lines joined by newlines (None for none
    /// or where the compiler has no source: TypeInfo::of).
    pub fn doc(&self) -> Option<String> {
        doc_of(&self.attrs)
    }

    /// Parses the variant's `#[ns(...)]` attributes as `T` (see
    /// [`FromAttrs`]).
    ///
    /// # Errors
    ///
    /// Fails, at the variant, if an argument is unknown or of the wrong
    /// type, or a required one is missing.
    pub fn parse_attrs<T: FromAttrs>(&self, ns: &str) -> Result<T, Error> {
        parse_attrs::<T>(&self.attrs, ns, self.name.pos)
    }

    /// The explicit discriminant as written ("" if none).
    pub fn discriminant(&self) -> &str {
        self.discr.as_str()
    }

    /// The variant's position in the declaration (0 for a struct).
    pub fn index(&self) -> usize {
        self.index
    }

    /// Type or Type::Variant, as patterns and constructors write it.
    pub fn path(&self) -> Code {
        Code::spanned(self.path.as_str(), self.name.pos)
    }

    /// A binding for each field, as each and each_variant bind them: an
    /// enum's variant's fields are bound by a pattern (__binding_0, ...),
    /// a struct's are read as self.x.
    pub fn bindings(&self) -> Vec<Binding> {
        if self.of_struct {
            return self.fields_of("self");
        }
        self.bindings_named("__binding")
    }

    // The fields read from x (an expression): x.a, x.0, ...
    fn fields_of(&self, x: &str) -> Vec<Binding> {
        let mut out = Vec::new();
        for f in self.fields.iter() {
            out.push(Binding {
                name: `${x}.${f.ident()}`.to_string(),
                field: f.clone(),
            });
        }
        out
    }

    fn bindings_named(&self, prefix: &str) -> Vec<Binding> {
        let mut out = Vec::new();
        for f in self.fields.iter() {
            out.push(Binding {
                name: `${prefix}_${f.index}`.to_string(),
                field: f.clone(),
            });
        }
        out
    }

    /// The pattern binding each field to the binding of the same index.
    pub fn pattern(&self) -> Code {
        self.pattern_named("__binding")
    }

    fn pattern_named(&self, prefix: &str) -> Code {
        let bs = self.bindings_named(prefix);
        let mut parts: Vec<Code> = Vec::new();
        for b in bs.iter() {
            match &b.field.name {
                Some(n) => {
                    let mut c = n.to_code();
                    c.push_str(":");
                    c.push_str(b.name.as_str());
                    parts.push(c);
                }
                None => parts.push(Code::from_text(b.name.as_str())),
            }
        }
        self.shape_of(&parts)
    }

    /// The constructor with one expression per field (in field order).
    pub fn construct(&self, values: &[Code]) -> Code {
        let mut parts: Vec<Code> = Vec::new();
        let mut i = 0;
        while i < self.fields.len() {
            let v = if i < values.len() {
                values[i].clone()
            } else {
                Code::new()
            };
            match &self.fields[i].name {
                Some(n) => {
                    let mut c = n.to_code();
                    c.push_str(":");
                    c.push(&v);
                    parts.push(c);
                }
                None => parts.push(v),
            }
            i += 1;
        }
        self.shape_of(&parts)
    }

    // path { a, b } / path(a, b) / path
    fn shape_of(&self, parts: &[Code]) -> Code {
        let mut c = self.path();
        match self.kind {
            Kind::Unit => {}
            Kind::Named => {
                c.push_str("{");
                c.push(&comma_list(parts));
                c.push_str("}");
            }
            Kind::Tuple => {
                c.push_str("(");
                c.push(&comma_list(parts));
                c.push_str(")");
            }
        }
        c
    }
}

impl Spanned for Variant {
    fn pos(&self) -> i32 {
        self.name.pos
    }
}

/// A field bound by a pattern; put in code, it is the bound variable (at
/// the field's position).
#[derive(Clone, Debug)]
pub struct Binding {
    name: String,
    field: Field,
}

impl Binding {
    /// Returns the field it binds.
    pub fn field(&self) -> &Field {
        &self.field
    }

    /// Returns the bound variable (`__binding_0`, or `self.x` for a
    /// struct's field) as an identifier at the field's position.
    pub fn ident(&self) -> Ident {
        Ident::with_pos(self.name.as_str(), self.field.pos)
    }
}

impl Spanned for Binding {
    fn pos(&self) -> i32 {
        self.field.pos
    }
}

impl ToCode for Binding {
    fn to_code(&self) -> Code {
        Code::spanned(self.name.as_str(), self.field.pos)
    }
}

/// A type or const parameter.
#[derive(Clone, Debug)]
pub struct GenericParam {
    /// The parameter's name.
    pub name: Ident,
    /// const N: usize
    pub is_const: bool,
    /// The bounds as written ("" if none): T: Clone + Debug.
    pub bounds: String,
    /// A const parameter's type.
    pub ty: String,
}

/// The type's generic parameters and where clause.
#[derive(Clone, Debug)]
pub struct Generics {
    /// The parameters, in order.
    pub params: Vec<GenericParam>,
    /// The where clause's predicates as written ("" if none).
    pub where_clause: String,
}

/// The struct or enum a derive macro derives for, as written.
///
/// It gives the type's name, generics, attributes and variants (a struct
/// is one variant), and helpers that make the code derives usually need:
/// [`impl_for`](TypeInfo::impl_for), [`each`](TypeInfo::each),
/// [`each_variant`](TypeInfo::each_variant),
/// [`each_construct`](TypeInfo::each_construct),
/// [`each_pair`](TypeInfo::each_pair).
///
/// # Examples
///
/// ```
/// use std::derive::TypeInfo;
///
/// struct Point<T: Clone> {
///     pub x: T,
///     y: T,
/// }
///
/// let t = TypeInfo::of::<Point<i32>>();
/// assert_eq(t.name().as_str(), "Point");
/// assert(!t.is_enum());
/// assert_eq(t.generics().params[0].name.as_str(), "T");
/// assert_eq(t.generics().params[0].bounds, "Clone");
/// assert_eq(t.fields().len(), 2);
/// assert_eq(t.self_type().text(), "Point<T>");
/// ```
#[derive(Clone, Debug)]
pub struct TypeInfo {
    name: Ident,
    module: String,
    vis: String,
    attrs: Vec<Attr>,
    generics: Generics,
    is_enum: bool,
    variants: Vec<Variant>,
}

impl TypeInfo {
    /// The TypeInfo of T (a struct or enum), made by the compiler: for
    /// testing a macro in an ordinary #[test].
    pub fn of<T>() -> TypeInfo {
        let p = crate::intrinsics::type_info::<T>() as *const usize;
        let s = unsafe { crate::rt::str_from_raw(*p as *const u8, *p.add(1)) };
        TypeInfo::decode(s)
    }

    /// The TypeInfo the compiler encoded (for its built-in derives, which
    /// run in the compiler).
    pub fn decode(s: &str) -> TypeInfo {
        let mut d = Dec {
            b: s.as_bytes(),
            i: 0,
        };
        d.type_info()
    }

    /// Returns the type's name.
    pub fn name(&self) -> Ident {
        self.name.clone()
    }

    /// The module the type is in, from its crate's root (a::b, or "").
    pub fn module(&self) -> &str {
        self.module.as_str()
    }

    /// Returns the type's visibility as written: `""`, `"pub"`,
    /// `"pub(crate)"`...
    pub fn vis(&self) -> &str {
        self.vis.as_str()
    }

    /// Returns the type's attributes (the derive itself is not among them).
    pub fn attrs(&self) -> &Vec<Attr> {
        &self.attrs
    }

    /// Returns `true` if the type has an attribute named `name`.
    pub fn has_attr(&self, name: &str) -> bool {
        has(&self.attrs, name)
    }

    /// The /// comment above it, lines joined by newlines (None for none
    /// or where the compiler has no source: TypeInfo::of).
    pub fn doc(&self) -> Option<String> {
        doc_of(&self.attrs)
    }

    /// Parses the type's `#[ns(...)]` attributes as `T` (see [`FromAttrs`]).
    ///
    /// # Errors
    ///
    /// Fails, at the type, if an argument is unknown or of the wrong type,
    /// or a required one is missing.
    pub fn parse_attrs<T: FromAttrs>(&self, ns: &str) -> Result<T, Error> {
        parse_attrs::<T>(&self.attrs, ns, self.name.pos)
    }

    /// Returns the type's generic parameters and where clause.
    pub fn generics(&self) -> &Generics {
        &self.generics
    }

    /// Returns `true` if the type is an enum.
    pub fn is_enum(&self) -> bool {
        self.is_enum
    }

    /// An enum's variants, or the struct as one variant.
    pub fn variants(&self) -> &Vec<Variant> {
        &self.variants
    }

    /// A struct's fields (an enum has none).
    pub fn fields(&self) -> Vec<Field> {
        if self.is_enum {
            return Vec::new();
        }
        self.variants[0].fields.clone()
    }

    /// The type with its parameters: Name<T, N>.
    pub fn self_type(&self) -> Code {
        let mut c = self.name.to_code();
        if self.generics.params.len() > 0 {
            let mut ps: Vec<Code> = Vec::new();
            for p in self.generics.params.iter() {
                ps.push(p.name.to_code());
            }
            c.push_str("<");
            c.push(&comma_list(&ps));
            c.push_str(">");
        }
        c
    }

    /// <T, const N: usize>: the parameters without their bounds (a helper
    /// type's declaration), empty if none.
    pub fn params(&self) -> Code {
        let mut c = Code::new();
        if self.generics.params.len() == 0 {
            return c;
        }
        let mut ps: Vec<Code> = Vec::new();
        for p in self.generics.params.iter() {
            let mut x = Code::new();
            if p.is_const {
                x.push_str("const");
                x.push(&p.name.to_code());
                x.push_str(":");
                x.push_str(p.ty.as_str());
            } else {
                x.push(&p.name.to_code());
            }
            ps.push(x);
        }
        c.push_str("<");
        c.push(&comma_list(&ps));
        c.push_str(">");
        c
    }

    /// The variant of x (an expression of type Self) as an isize: its
    /// position in the declaration (0 for a struct).
    pub fn variant_index(&self, x: Code) -> Code {
        if !self.is_enum {
            return Code::from_text("0isize");
        }
        let mut c = Code::from_text("match *(");
        c.push(&x);
        c.push_str(") {");
        for v in self.variants.iter() {
            c.push(&v.path());
            match v.kind {
                Kind::Unit => {}
                Kind::Tuple => c.push_str("(..)"),
                Kind::Named => c.push_str("{ .. }"),
            }
            c.push_str(`=> ${v.index}isize,`.to_string().as_str());
        }
        c.push_str("}");
        c
    }

    /// Returns `impl<...> trait_path for Self<...> where ... { items }`:
    /// every type parameter must implement the trait too, as Rust's
    /// derives require.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::derive::{TypeInfo, quote};
    ///
    /// struct Wrapper<T> {
    ///     inner: T,
    /// }
    ///
    /// let t = TypeInfo::of::<Wrapper<i32>>();
    /// let code = t.impl_for("Tr", quote`fn f() {}`);
    /// assert_eq(code.text(), "impl<T: Tr> Tr for Wrapper<T> { fn f() {} }");
    /// ```
    pub fn impl_for(&self, trait_path: &str, items: Code) -> Code {
        let mut bound = Code::new();
        if self.generics.params.len() > 0 {
            bound.push_str(trait_path);
        }
        self.impl_with(trait_path, bound, items)
    }

    /// impl_for with the bound for each type parameter given ("" for none).
    pub fn impl_for_with(&self, trait_path: &str, bound: Code, items: Code) -> Code {
        self.impl_with(trait_path, bound, items)
    }

    fn impl_with(&self, trait_path: &str, bound: Code, items: Code) -> Code {
        self.impl_for_type(trait_path, bound, self.self_type(), items)
    }

    /// impl_for_with for another type with the same parameters (a helper
    /// type of the derive's: self_ty is it with them).
    pub fn impl_for_type(&self, trait_path: &str, bound: Code, self_ty: Code, items: Code) -> Code {
        let mut c = Code::from_text("impl");
        if self.generics.params.len() > 0 {
            let mut ps: Vec<Code> = Vec::new();
            for p in self.generics.params.iter() {
                let mut x = Code::new();
                if p.is_const {
                    x.push_str("const");
                    x.push(&p.name.to_code());
                    x.push_str(":");
                    x.push_str(p.ty.as_str());
                } else {
                    x.push(&p.name.to_code());
                    let mut bs = Vec::new();
                    if p.bounds.len() > 0 {
                        bs.push(Code::from_text(p.bounds.as_str()));
                    }
                    if !bound.is_empty() {
                        bs.push(bound.clone());
                    }
                    if bs.len() > 0 {
                        x.push_str(":");
                        let mut i = 0;
                        while i < bs.len() {
                            if i > 0 {
                                x.push_str("+");
                            }
                            x.push(&bs[i]);
                            i += 1;
                        }
                    }
                }
                ps.push(x);
            }
            c.push_str("<");
            c.push(&comma_list(&ps));
            c.push_str(">");
        }
        c.push_str(trait_path);
        c.push_str("for");
        c.push(&self_ty);
        if self.generics.where_clause.len() > 0 {
            c.push_str("where");
            c.push_str(self.generics.where_clause.as_str());
        }
        c.push_str("{");
        c.push(&items);
        c.push_str("}");
        c
    }

    /// Returns `match *self { each variant's pattern => { f(binding) for
    /// each field } }`; for a struct, `{ f(self.x) for each field }`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::derive::{Binding, TypeInfo, quote};
    ///
    /// enum E {
    ///     A(i32),
    ///     B { x: i32, y: i32 },
    /// }
    ///
    /// let code = TypeInfo::of::<E>().each(|b: &Binding| quote`f(${b});`);
    /// assert_eq(code.text(), "match *self { E::A(__binding_0) => { f(__binding_0); } E::B { x: __binding_0, y: __binding_1 } => { f(__binding_0); f(__binding_1); } }");
    /// ```
    pub fn each(&self, f: fn(&Binding) -> Code) -> Code {
        if !self.is_enum {
            let mut body = Code::from_text("{");
            for b in self.variants[0].bindings().iter() {
                body.push(&f(b));
            }
            body.push_str("}");
            return body;
        }
        let mut arms = Code::new();
        for v in self.variants.iter() {
            let mut body = Code::new();
            for b in v.bindings().iter() {
                body.push(&f(b));
            }
            arms.push(&v.pattern());
            arms.push_str("=> {");
            arms.push(&body);
            arms.push_str("}");
        }
        self.match_self(arms)
    }

    /// match *self { each variant's pattern => { f(variant) } }: the
    /// variant's bindings() are bound.
    pub fn each_variant(&self, f: fn(&Variant) -> Result<Code, Error>) -> Result<Code, Error> {
        if !self.is_enum {
            let mut body = Code::from_text("{");
            body.push(&f(&self.variants[0])?);
            body.push_str("}");
            return Ok(body);
        }
        let mut arms = Code::new();
        for v in self.variants.iter() {
            let body = f(v)?;
            arms.push(&v.pattern());
            arms.push_str("=> {");
            arms.push(&body);
            arms.push_str("}");
        }
        Ok(self.match_self(arms))
    }

    /// match *self { each variant's pattern => the same variant built from
    /// f(binding) for each field } (as Clone).
    pub fn each_construct(&self, f: fn(&Binding) -> Code) -> Code {
        let mut arms = Code::new();
        for v in self.variants.iter() {
            let mut vals: Vec<Code> = Vec::new();
            // (A struct taken apart too: from a copy of self, not through
            // &self, where a &mut field reads as &.)
            for b in v.bindings_named("__binding").iter() {
                vals.push(f(b));
            }
            arms.push(&v.pattern());
            arms.push_str("=>");
            arms.push(&v.construct(&vals));
            arms.push_str(",");
        }
        self.match_self(arms)
    }

    /// Both self and other (an expression of type &Self) taken apart: for
    /// the same variant f(self's binding, other's binding) for each field;
    /// differ when the variants differ (as PartialEq).
    pub fn each_pair(&self, other: Code, f: fn(&Binding, &Binding) -> Code, differ: Code) -> Code {
        if !self.is_enum {
            let v = &self.variants[0];
            let a = v.fields_of("self");
            let b = v.fields_of(`(${other.text})`.to_string().as_str());
            let mut body = Code::from_text("{");
            let mut i = 0;
            while i < a.len() {
                body.push(&f(&a[i], &b[i]));
                i += 1;
            }
            body.push_str("}");
            return body;
        }
        let mut arms = Code::new();
        for v in self.variants.iter() {
            let a = v.bindings_named("__binding");
            let b = v.bindings_named("__other");
            let mut body = Code::new();
            let mut i = 0;
            while i < a.len() {
                body.push(&f(&a[i], &b[i]));
                i += 1;
            }
            arms.push(&v.pattern());
            arms.push_str("=> match *(");
            arms.push(&other);
            arms.push_str(") {");
            arms.push(&v.pattern_named("__other"));
            arms.push_str("=> {");
            arms.push(&body);
            arms.push_str("}");
            if self.variants.len() > 1 {
                arms.push_str("_ => {");
                arms.push(&differ);
                arms.push_str("}");
            }
            arms.push_str("},");
        }
        self.match_self(arms)
    }

    fn match_self(&self, arms: Code) -> Code {
        let mut c = Code::from_text("match *self {");
        c.push(&arms);
        c.push_str("}");
        c
    }
}

impl Spanned for TypeInfo {
    fn pos(&self) -> i32 {
        self.name.pos
    }
}

fn comma_list(parts: &[Code]) -> Code {
    let mut c = Code::new();
    let mut i = 0;
    while i < parts.len() {
        if i > 0 {
            c.push_str(",");
        }
        c.push(&parts[i]);
        i += 1;
    }
    c
}

fn has(attrs: &[Attr], name: &str) -> bool {
    for a in attrs.iter() {
        if a.name == name {
            return true;
        }
    }
    false
}

// The text of #[doc(text = "...")], which the compiler gives for ///
// comments.
fn doc_of(attrs: &[Attr]) -> Option<String> {
    for a in attrs.iter() {
        if a.name != "doc" {
            continue;
        }
        for g in a.args.iter() {
            if let Some(AttrValue::Str(t, _)) = &g.value {
                return Some(t.clone());
            }
        }
    }
    None
}

// --- Errors ----------------------------------------------------------------

/// An error of a derive macro, at a position in the user's code.
///
/// The compiler reports it as a compile error there.
///
/// # Examples
///
/// ```
/// use std::derive::{Error, TypeInfo};
///
/// struct Unit;
///
/// let t = TypeInfo::of::<Unit>();
/// let e = Error::at(&t, "Unit structs are not supported");
/// assert_eq(e.to_string(), "Unit structs are not supported");
/// assert_eq(Error::new("oops").pos, -1);
/// ```
#[derive(Clone, Debug)]
pub struct Error {
    /// Where the error is, a byte offset in the type's file, or [`NO_POS`]
    /// (the `#[derive(...)]` attribute).
    pub pos: i32,
    /// The message.
    pub msg: String,
}

impl Error {
    /// Returns an error at the `#[derive(...)]` attribute.
    pub fn new(msg: &str) -> Error {
        Error {
            pos: NO_POS,
            msg: msg.to_string(),
        }
    }

    /// Returns an error at `x` (a field, variant, type, attribute...).
    pub fn at<X: Spanned>(x: &X, msg: &str) -> Error {
        Error {
            pos: x.pos(),
            msg: msg.to_string(),
        }
    }
}

impl crate::fmt::Display for Error {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        f.write_str(self.msg.as_str())
    }
}

// --- Attributes --------------------------------------------------------------

/// A type made from the arguments of a macro's helper attributes, as
/// darling's `FromMeta`.
///
/// `#[derive(FromAttrs)]` on a struct implements it: each field is read
/// from the key of its name by its type's [`FromAttrValue`] (an `Option<T>`
/// is an optional key, a `bool` a flag, any other type a required key);
/// unknown keys are errors. `parse_attrs` of [`TypeInfo`], [`Variant`] and
/// [`Field`] use it.
///
/// # Examples
///
/// ```
/// use std::derive::{FromAttrs, TypeInfo};
/// use std::serde::Serialize;
///
/// #[derive(FromAttrs)]
/// struct Opts {
///     rename: Option<String>,
///     skip: bool,
/// }
///
/// #[derive(Serialize)]
/// struct S {
///     #[serde(rename = "b", skip)]
///     a: i32,
/// }
///
/// let f = &TypeInfo::of::<S>().fields()[0];
/// let o: Opts = f.parse_attrs::<Opts>("serde").unwrap();
/// assert_eq(o.rename, Some("b".to_string()));
/// assert(o.skip);
/// ```
pub trait FromAttrs {
    /// Makes the value from the arguments, taking each key it knows.
    fn from_attrs(args: &mut AttrArgs) -> Result<Self, Error>;
}

/// #[derive(FromAttrs)] (as darling's FromMeta derive): a struct with
/// named fields made from an attribute's arguments, each field from the key
/// of its name by its type's FromAttrValue.
#[derive_macro(FromAttrs)]
pub fn from_attrs_derive(t: &TypeInfo) -> Result<Code, Error> {
    if t.is_enum() || t.variants()[0].kind() != Kind::Named {
        return Err(Error::at(
            t,
            "FromAttrs can only be derived for structs with named fields",
        ));
    }
    let mut inits: Vec<Code> = Vec::new();
    for f in t.fields().iter() {
        let name = f.ident();
        let key = name.to_string();
        let ty = f.ty();
        inits.push(quote`${name}: __args.get::<${ty}>(${key})?,`);
    }
    let tn = t.name();
    Ok(t.impl_for("::std::derive::FromAttrs", quote`fn from_attrs(__args: &mut ::std::derive::AttrArgs) -> Result<Self, ::std::derive::Error> { Ok(${tn} { ${inits} }) }`))
}

/// The arguments of all of an item's #[ns(...)] attributes, taken key by
/// key.
pub struct AttrArgs {
    ns: String,
    args: Vec<AttrArg>,
    used: Vec<bool>,
    pos: i32,
}

/// The #[ns(...)] attributes in attrs parsed as T (pos: where a missing
/// key is reported).
pub fn parse_attrs<T: FromAttrs>(attrs: &[Attr], ns: &str, pos: i32) -> Result<T, Error> {
    let mut args = Vec::new();
    let mut at = pos;
    for a in attrs.iter() {
        if a.name != ns {
            continue;
        }
        at = a.pos;
        for x in a.args.iter() {
            args.push(x.clone());
        }
    }
    let mut used = Vec::new();
    for _ in args.iter() {
        used.push(false);
    }
    let mut aa = AttrArgs {
        ns: ns.to_string(),
        args,
        used,
        pos: at,
    };
    let v = T::from_attrs(&mut aa)?;
    aa.finish()?;
    Ok(v)
}

impl AttrArgs {
    // The argument key (marking it used); an error if given twice.
    fn take(&mut self, key: &str) -> Result<Option<AttrArg>, Error> {
        let mut found: Option<AttrArg> = None;
        let mut i = 0;
        while i < self.args.len() {
            if self.args[i].key.name == key {
                if found.is_some() {
                    return Err(Error::at(
                        &self.args[i],
                        `${key} is given more than once in #[${self.ns}]`
                            .to_string()
                            .as_str(),
                    ));
                }
                found = Some(self.args[i].clone());
                self.used[i] = true;
            }
            i += 1;
        }
        Ok(found)
    }

    /// The value of key as T (FromAttrValue): key = value, key alone
    /// (from_word) or no key (from_missing), else an error.
    pub fn get<T: FromAttrValue>(&mut self, key: &str) -> Result<T, Error> {
        match self.take(key)? {
            None => match T::from_missing() {
                Some(x) => Ok(x),
                None => Err(Error {
                    pos: self.pos,
                    msg: `#[${self.ns}] needs ${key} = ...`.to_string(),
                }),
            },
            Some(a) => match &a.value {
                None => match T::from_word() {
                    Some(x) => Ok(x),
                    None => Err(Error::at(
                        &a,
                        `${key} in #[${self.ns}] needs a value (${key} = ...)`
                            .to_string()
                            .as_str(),
                    )),
                },
                Some(v) => match T::from_value(v) {
                    Some(x) => Ok(x),
                    None => Err(Error::at(
                        &a,
                        `${key} in #[${self.ns}] must be ${T::expected()}`
                            .to_string()
                            .as_str(),
                    )),
                },
            },
        }
    }

    /// An error for the first argument nothing took.
    pub fn finish(&self) -> Result<(), Error> {
        let mut i = 0;
        while i < self.args.len() {
            if !self.used[i] {
                let k = self.args[i].key.name.clone();
                return Err(Error::at(
                    &self.args[i],
                    `unknown argument ${k} in #[${self.ns}]`
                        .to_string()
                        .as_str(),
                ));
            }
            i += 1;
        }
        Ok(())
    }
}

/// An attribute value a FromAttrs field can have (as darling's FromMeta):
/// from key = value, from the key alone, or when the key is not given.
pub trait FromAttrValue {
    /// `#[ns(key = value)]`: the value, or `None` if it has the wrong type.
    fn from_value(v: &AttrValue) -> Option<Self>;
    /// #[ns(key)]: none but for a flag (bool: true).
    fn from_word() -> Option<Self> {
        None
    }
    /// No key: none (it is required) but for Option (None) and bool
    /// (false).
    fn from_missing() -> Option<Self> {
        None
    }
    /// What the value must be, for errors.
    fn expected() -> &str;
}

impl<T: FromAttrValue> FromAttrValue for Option<T> {
    fn from_value(v: &AttrValue) -> Option<Option<T>> {
        match T::from_value(v) {
            Some(x) => Some(Some(x)),
            None => None,
        }
    }
    fn from_word() -> Option<Option<T>> {
        match T::from_word() {
            Some(x) => Some(Some(x)),
            None => None,
        }
    }
    fn from_missing() -> Option<Option<T>> {
        Some(None)
    }
    fn expected() -> &str {
        T::expected()
    }
}

impl FromAttrValue for String {
    fn from_value(v: &AttrValue) -> Option<String> {
        match v {
            AttrValue::Str(s, _) => Some(s.clone()),
            _ => None,
        }
    }
    fn expected() -> &str {
        "a string"
    }
}

impl FromAttrValue for bool {
    fn from_value(v: &AttrValue) -> Option<bool> {
        match v {
            AttrValue::Bool(b, _) => Some(*b),
            _ => None,
        }
    }
    fn from_word() -> Option<bool> {
        Some(true)
    }
    fn from_missing() -> Option<bool> {
        Some(false)
    }
    fn expected() -> &str {
        "true or false"
    }
}

impl FromAttrValue for i64 {
    fn from_value(v: &AttrValue) -> Option<i64> {
        match v {
            AttrValue::Int(n, _) => Some(*n),
            _ => None,
        }
    }
    fn expected() -> &str {
        "an integer"
    }
}

impl FromAttrValue for i32 {
    fn from_value(v: &AttrValue) -> Option<i32> {
        match v {
            AttrValue::Int(n, _) => {
                if *n >= -2147483648 && *n <= 2147483647 {
                    Some(*n as i32)
                } else {
                    None
                }
            }
            _ => None,
        }
    }
    fn expected() -> &str {
        "an integer (i32)"
    }
}

impl FromAttrValue for usize {
    fn from_value(v: &AttrValue) -> Option<usize> {
        match v {
            AttrValue::Int(n, _) => {
                if *n >= 0 {
                    Some(*n as usize)
                } else {
                    None
                }
            }
            _ => None,
        }
    }
    fn expected() -> &str {
        "a non-negative integer"
    }
}

/// A path or other literal, as written (#[x(with = path::to::f)]).
pub struct Raw(pub String);

impl FromAttrValue for Raw {
    fn from_value(v: &AttrValue) -> Option<Raw> {
        match v {
            AttrValue::Other(s, _) => Some(Raw(s.clone())),
            AttrValue::Str(s, _) => Some(Raw(s.clone())),
            _ => None,
        }
    }
    fn expected() -> &str {
        "a path"
    }
}

// --- The macro program ---------------------------------------------------------

/// The main of a derive macro program (the compiler makes it): reads the
/// requests (a macro's name and a TypeInfo each) from the file its argument
/// names and writes each one's code or error to standard output.
pub fn serve(f: fn(&str, &TypeInfo) -> Result<Code, Error>) {
    let args: Vec<String> = crate::env::args().collect();
    if args.len() != 2 {
        crate::io::eprintln(
            "usage: a derive macro program takes a file of requests (navi runs it)",
        );
        crate::process::exit(2);
    }
    let input = match crate::fs::read_to_string(args[1].as_str()) {
        Ok(s) => s,
        Err(e) => {
            crate::io::eprintln(`derive macro: ${e}`);
            crate::process::exit(2);
        }
    };
    let mut d = Dec {
        b: input.as_bytes(),
        i: 0,
    };
    let mut out = Enc { s: String::new() };
    d.open();
    while !d.at_close() {
        d.open();
        let name = d.str();
        let t = d.type_info();
        d.close();
        match f(name.as_str(), &t) {
            Ok(c) => {
                out.s.push('o');
                out.str(c.text.as_str());
                out.s.push('[');
                for s in c.spans.iter() {
                    out.int(s.start as i64);
                    out.int(s.end as i64);
                    out.int(s.pos as i64);
                }
                out.s.push(']');
            }
            Err(e) => {
                out.s.push('e');
                out.int(e.pos as i64);
                out.str(e.msg.as_str());
            }
        }
    }
    crate::io::print(out.s);
}

// The encoding between the compiler and a macro program (and of
// TypeInfo::of): a string is <length>:<bytes>, an integer i<decimal>; and
// a list [ ... ]. compiler/src/derive/info.navi writes TypeInfos.
struct Enc {
    s: String,
}

impl Enc {
    fn str(&mut self, x: &str) {
        self.s.push_str(`${x.len()}:`.to_string().as_str());
        self.s.push_str(x);
    }

    fn int(&mut self, n: i64) {
        self.s.push_str(`i${n};`.to_string().as_str());
    }
}

struct Dec {
    b: &[u8],
    i: usize,
}

impl Dec {
    fn fail(&self) -> ! {
        crate::panic::panic(`derive: bad input at byte ${self.i}`)
    }

    fn byte(&mut self, c: u8) {
        if self.i >= self.b.len() || self.b[self.i] != c {
            self.fail();
        }
        self.i += 1;
    }

    fn open(&mut self) {
        self.byte(b'[');
    }

    fn close(&mut self) {
        self.byte(b']');
    }

    fn at_close(&mut self) -> bool {
        if self.i >= self.b.len() {
            self.fail();
        }
        if self.b[self.i] == b']' {
            self.i += 1;
            return true;
        }
        false
    }

    fn str(&mut self) -> String {
        let mut n = 0usize;
        while self.i < self.b.len() && self.b[self.i] != b':' {
            let c = self.b[self.i];
            if c < b'0' || c > b'9' {
                self.fail();
            }
            n = n * 10 + (c - b'0') as usize;
            self.i += 1;
        }
        self.byte(b':');
        if self.i + n > self.b.len() {
            self.fail();
        }
        let s = String::from_utf8_lossy(&self.b[self.i..self.i + n]);
        self.i += n;
        s
    }

    fn int(&mut self) -> i64 {
        self.byte(b'i');
        let mut neg = false;
        if self.i < self.b.len() && self.b[self.i] == b'-' {
            neg = true;
            self.i += 1;
        }
        let mut n = 0i64;
        while self.i < self.b.len() && self.b[self.i] != b';' {
            let c = self.b[self.i];
            if c < b'0' || c > b'9' {
                self.fail();
            }
            n = n * 10 + (c - b'0') as i64;
            self.i += 1;
        }
        self.byte(b';');
        if neg { -n } else { n }
    }

    fn ident(&mut self) -> Ident {
        let name = self.str();
        let pos = self.int() as i32;
        Ident { name, pos }
    }

    // [name module vis [attrs] [params] where is_enum [variants]]
    fn type_info(&mut self) -> TypeInfo {
        self.open();
        let name = self.ident();
        let module = self.str();
        let vis = self.str();
        let attrs = self.attrs();
        let mut params = Vec::new();
        self.open();
        while !self.at_close() {
            self.open();
            let pname = self.ident();
            let is_const = self.int() != 0;
            let bounds = self.str();
            let ty = self.str();
            self.close();
            params.push(GenericParam {
                name: pname,
                is_const,
                bounds,
                ty,
            });
        }
        let where_clause = self.str();
        let is_enum = self.int() != 0;
        let mut variants = Vec::new();
        self.open();
        while !self.at_close() {
            variants.push(self.variant(variants.len()));
        }
        self.close();
        if !is_enum {
            for v in variants.iter_mut() {
                v.of_struct = true;
            }
        }
        TypeInfo {
            name,
            module,
            vis,
            attrs,
            generics: Generics {
                params,
                where_clause,
            },
            is_enum,
            variants,
        }
    }

    // [name path kind [attrs] discr [fields]]
    fn variant(&mut self, index: usize) -> Variant {
        self.open();
        let name = self.ident();
        let path = self.str();
        let kind = match self.int() {
            0 => Kind::Named,
            1 => Kind::Tuple,
            _ => Kind::Unit,
        };
        let attrs = self.attrs();
        let discr = self.str();
        let mut fields = Vec::new();
        self.open();
        while !self.at_close() {
            // [name pos vis [attrs] type]
            self.open();
            let fname = self.str();
            let pos = self.int() as i32;
            let vis = self.str();
            let fattrs = self.attrs();
            let ty = self.type_ref();
            self.close();
            let n = if fname.len() > 0 {
                Some(Ident { name: fname, pos })
            } else {
                None
            };
            fields.push(Field {
                name: n,
                index: fields.len(),
                ty,
                attrs: fattrs,
                vis,
                pos,
            });
        }
        self.close();
        Variant {
            name,
            path,
            kind,
            fields,
            attrs,
            discr,
            index,
            of_struct: false,
        }
    }

    // [[name pos [[key pos tag value vpos]...]]...]
    fn attrs(&mut self) -> Vec<Attr> {
        let mut out = Vec::new();
        self.open();
        while !self.at_close() {
            self.open();
            let name = self.str();
            let pos = self.int() as i32;
            let mut args = Vec::new();
            self.open();
            while !self.at_close() {
                self.open();
                let key = self.ident();
                let tag = self.str();
                let text = self.str();
                let vpos = self.int() as i32;
                self.close();
                let value = match tag.as_str() {
                    "" => None,
                    "s" => Some(AttrValue::Str(text, vpos)),
                    "i" => match text.parse::<i64>() {
                        Ok(n) => Some(AttrValue::Int(n, vpos)),
                        Err(_) => Some(AttrValue::Other(text, vpos)),
                    },
                    "b" => Some(AttrValue::Bool(text == "true", vpos)),
                    _ => Some(AttrValue::Other(text, vpos)),
                };
                args.push(AttrArg { key, value });
            }
            self.close();
            out.push(Attr { name, pos, args });
        }
        out
    }

    // [text pos kind ...]: kind 0 path [[name [args]]...], 1 ref mut type,
    // 2 array type len, 3 slice type, 4 tuple [types], 5 other.
    fn type_ref(&mut self) -> TypeRef {
        self.open();
        let text = self.str();
        let pos = self.int() as i32;
        let kind = match self.int() {
            0 => {
                let mut segs = Vec::new();
                self.open();
                while !self.at_close() {
                    self.open();
                    let name = self.str();
                    let mut args = Vec::new();
                    self.open();
                    while !self.at_close() {
                        args.push(self.type_ref());
                    }
                    self.close();
                    segs.push(Segment { name, args });
                }
                TypeKind::Path(segs)
            }
            1 => {
                let m = self.int() != 0;
                TypeKind::Ref(m, &self.type_ref())
            }
            2 => {
                let e = self.type_ref();
                let n = self.str();
                TypeKind::Array(&e, n)
            }
            3 => TypeKind::Slice(&self.type_ref()),
            4 => {
                let mut ts = Vec::new();
                self.open();
                while !self.at_close() {
                    ts.push(self.type_ref());
                }
                TypeKind::Tuple(ts)
            }
            _ => TypeKind::Other,
        };
        self.close();
        TypeRef { text, pos, kind }
    }
}
