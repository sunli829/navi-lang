//! Traits for conversions between types.
//!
//! The traits in this module provide a way to convert from one type to
//! another type. Each trait serves a different purpose:
//!
//! - Implement the [`AsRef`] trait for cheap reference-to-reference
//!   conversions
//! - Implement the [`AsMut`] trait for cheap mutable-to-mutable conversions
//! - Implement the [`From`] trait for consuming value-to-value conversions
//! - Implement the [`Into`] trait for consuming value-to-value conversions
//!   to types outside the current crate
//! - The [`TryFrom`] and [`TryInto`] traits behave like [`From`] and
//!   [`Into`], but should be implemented when the conversion can fail.
//!
//! The traits in this module are often used as trait bounds for generic
//! functions such that arguments of multiple types are supported.
//!
//! ## Generic implementations
//!
//! - [`From`]`<T> for U` implies [`Into`]`<U> for T`, so implement `From`
//!   and get `Into` for free.
//! - [`TryFrom`]`<T> for U` implies [`TryInto`]`<U> for T`.
//! - [`AsRef`] and [`AsMut`] auto-dereference if the inner type is a
//!   reference.
//! - `From<T> for T`: every type converts into itself.
//!
//! Unlike Rust, navi has no blanket `TryFrom` implementation for types
//! that implement `From`.
//!
//! # Examples
//!
//! ```
//! struct Wrapper(Vec<i32>);
//!
//! impl From<Vec<i32>> for Wrapper {
//!     fn from(v: Vec<i32>) -> Wrapper {
//!         Wrapper(v)
//!     }
//! }
//!
//! let w: Wrapper = Vec::from([1, 2]).into();
//! assert_eq(w.0.len(), 2);
//! ```

/// Used to do value-to-value conversions while consuming the input value.
/// It is the reciprocal of [`Into`].
///
/// One should always prefer implementing `From` over [`Into`] because
/// implementing `From` automatically provides one with an implementation
/// of [`Into`] thanks to the blanket implementation in this module.
///
/// `From` is also used by the `?` operator to convert error types: in a
/// function returning `Result<T, E>`, `?` on a `Result<U, F>` converts the
/// error with `E::from`.
///
/// **Note: This trait must not fail.** If the conversion can fail, use
/// [`TryFrom`].
///
/// (In navi "consuming" means taking a copy: a value is not moved, and a
/// collection passed by value is shared, not copied deeply.)
///
/// # Examples
///
/// [`String`] implements `From<&str>`:
///
/// ```
/// let string = "hello".to_string();
/// let other_string = String::from("hello");
///
/// assert_eq(string, other_string);
/// ```
///
/// While performing error handling it is often useful to implement `From`
/// for your own error type, so that `?` converts the errors of the
/// functions you call:
///
/// ```
/// use std::num::ParseIntError;
///
/// #[derive(Debug)]
/// enum CliError {
///     Parse(ParseIntError),
///     Negative(i32),
/// }
///
/// impl From<ParseIntError> for CliError {
///     fn from(error: ParseIntError) -> CliError {
///         CliError::Parse(error)
///     }
/// }
///
/// fn parse_positive(s: &str) -> Result<i32, CliError> {
///     let n = s.trim().parse::<i32>()?;
///     if n < 0 {
///         return Err(CliError::Negative(n));
///     }
///     Ok(n)
/// }
///
/// assert_eq(parse_positive(" 42 ").unwrap(), 42);
/// match parse_positive("x") {
///     Err(CliError::Parse(_)) => {}
///     _ => panic("expected a parse error"),
/// }
/// ```
pub trait From<T> {
    /// Converts to this type from the input type.
    ///
    /// # Examples
    ///
    /// ```
    /// let v = Vec::from([1, 2, 3]);
    /// assert_eq(v.len(), 3);
    /// let n = i64::from(7i32);
    /// assert_eq(n, 7);
    /// ```
    fn from(value: T) -> Self;
}
/// A value-to-value conversion that consumes the input value. The opposite
/// of [`From`].
///
/// One should avoid implementing `Into` and implement [`From`] instead:
/// implementing [`From`] automatically provides `Into` through the
/// blanket implementation. Prefer using `Into` over [`From`] when
/// specifying trait bounds on a generic function, to ensure that types
/// that only implement `Into` can be used as well.
///
/// **Note: This trait must not fail.** If the conversion can fail, use
/// [`TryInto`].
///
/// # Examples
///
/// In order to express that we want a generic function to take all
/// arguments that can be converted to a specified type `T`, we can use a
/// trait bound of `Into<T>`. For example, the function `is_hello` takes
/// all arguments that can be converted into a `Vec<u8>`:
///
/// ```
/// fn is_hello<T: Into<Vec<u8>>>(s: T) {
///     let bytes = b"hello".to_vec();
///     assert_eq(bytes, s.into());
/// }
///
/// let s = "hello".to_string();
/// is_hello(s);
/// ```
pub trait Into<T> {
    /// Converts this type into the (usually inferred) input type.
    ///
    /// # Examples
    ///
    /// ```
    /// let s: String = "hello".into();
    /// assert_eq(s, "hello");
    /// let x: i64 = 5i32.into();
    /// assert_eq(x, 5);
    /// ```
    fn into(self) -> T;
}
/// Simple and safe type conversions that may fail in a controlled way
/// under some circumstances. It is the reciprocal of [`TryInto`].
///
/// This is useful when you are doing a type conversion that may trivially
/// succeed but may also need special handling. For example, there is no
/// way to convert an `i64` into an `i32` using the [`From`] trait,
/// because an `i64` may contain a value that an `i32` cannot
/// represent and so the conversion would lose data. `TryFrom` returns an
/// error instead.
///
/// Implementing `TryFrom` automatically provides [`TryInto`].
///
/// # Examples
///
/// ```
/// struct GreaterThanZero(i32);
///
/// impl TryFrom<i32> for GreaterThanZero {
///     type Error = &str;
///
///     fn try_from(value: i32) -> Result<GreaterThanZero, &str> {
///         if value <= 0 {
///             Err("GreaterThanZero only accepts values greater than zero!")
///         } else {
///             Ok(GreaterThanZero(value))
///         }
///     }
/// }
///
/// assert(GreaterThanZero::try_from(5).is_ok());
/// assert(GreaterThanZero::try_from(-3).is_err());
/// ```
///
/// Integer types convert with checks:
///
/// ```
/// let big_number = 1_000_000_000_000i64;
/// // Silently truncates `big_number`, requires detecting
/// // and handling the truncation after the fact.
/// let smaller_number = big_number as i32;
/// assert_eq(smaller_number, -727379968);
///
/// // Returns an error because `big_number` is too big to
/// // fit in an `i32`.
/// let try_smaller_number = i32::try_from(big_number);
/// assert(try_smaller_number.is_err());
///
/// // Returns `Ok(3)`.
/// let try_successful_smaller_number = i32::try_from(3i64);
/// assert_eq(try_successful_smaller_number.unwrap(), 3);
/// ```
pub trait TryFrom<T> {
    /// The type returned in the event of a conversion error.
    type Error;
    /// Performs the conversion.
    ///
    /// # Errors
    ///
    /// Returns `Self::Error` when `value` cannot be converted.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u8::try_from(255i32).unwrap(), 255);
    /// assert(u8::try_from(256i32).is_err());
    /// ```
    fn try_from(value: T) -> Result<Self, Self::Error>;
}
/// An attempted conversion that consumes `self`, which may or may not be
/// expensive. The opposite of [`TryFrom`].
///
/// Library authors should not directly implement this trait, but should
/// prefer implementing the [`TryFrom`] trait, which offers greater
/// flexibility and provides an equivalent `TryInto` implementation for
/// free, thanks to a blanket implementation in this module.
///
/// # Examples
///
/// ```
/// let x: i64 = 300;
/// let r: Result<u8, std::num::TryFromIntError> = x.try_into();
/// assert(r.is_err());
/// let r: Result<u16, std::num::TryFromIntError> = x.try_into();
/// assert_eq(r.unwrap(), 300);
/// ```
pub trait TryInto<T> {
    /// The type returned in the event of a conversion error.
    type Error;
    /// Performs the conversion.
    ///
    /// # Errors
    ///
    /// Returns `Self::Error` when `self` cannot be converted.
    ///
    /// # Examples
    ///
    /// ```
    /// let n: Result<u8, std::num::TryFromIntError> = (-1i32).try_into();
    /// assert(n.is_err());
    /// ```
    fn try_into(self) -> Result<T, Self::Error>;
}
/// Used to do a cheap reference-to-reference conversion.
///
/// This trait is used in generic functions to accept any type that can
/// give a reference to a `T`: a function taking `impl AsRef<str>` accepts
/// `&str` and [`String`], and one taking `impl AsRef<[u8]>` accepts
/// strings, byte slices and `Vec<u8>`.
///
/// If you need to do a costly conversion it is better to implement
/// [`From`] with type `&T` or write a custom function.
///
/// `AsRef` auto-dereferences: if the inner type is a reference or a
/// mutable reference (`foo.as_ref()` on a `&&mut Foo`), it is the same as
/// on `Foo`.
///
/// # Examples
///
/// ```
/// fn is_hello<T: AsRef<str>>(s: T) {
///     assert_eq("hello", s.as_ref());
/// }
///
/// let s = "hello";
/// is_hello(s);
///
/// let s = "hello".to_string();
/// is_hello(s);
/// ```
pub trait AsRef<T> {
    /// Converts this type into a shared reference of the (usually inferred)
    /// input type.
    ///
    /// # Examples
    ///
    /// ```
    /// let s = String::from("abc");
    /// let bytes: &[u8] = s.as_ref();
    /// assert_eq(bytes.len(), 3);
    /// ```
    fn as_ref(&self) -> &T;
}
/// Used to do a cheap mutable-to-mutable reference conversion.
///
/// This trait is similar to [`AsRef`] but used for converting between
/// mutable references.
///
/// # Examples
///
/// ```
/// fn add_one<T: AsMut<[i32]>>(v: &mut T) {
///     for x in v.as_mut().iter_mut() {
///         *x += 1;
///     }
/// }
///
/// let mut a = [1, 2, 3];
/// add_one(&mut a);
/// assert_eq(a, [2, 3, 4]);
/// ```
pub trait AsMut<T> {
    /// Converts this type into a mutable reference of the (usually inferred)
    /// input type.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut a = [3, 1, 2];
    /// let s: &mut [i32] = a.as_mut();
    /// s.sort();
    /// assert_eq(a, [1, 2, 3]);
    /// ```
    fn as_mut(&mut self) -> &mut T;
}

impl<T, U> Into<U> for T
where
    U: From<T>,
{
    fn into(self) -> U {
        U::from(self)
    }
}

impl<T> From<T> for T {
    fn from(t: T) -> T {
        t
    }
}

impl AsRef<[u8]> for str {
    fn as_ref(&self) -> &[u8] {
        self.as_bytes()
    }
}
impl AsRef<[u8]> for crate::string::String {
    fn as_ref(&self) -> &[u8] {
        self.as_bytes()
    }
}
impl<T> AsRef<[T]> for [T] {
    fn as_ref(&self) -> &[T] {
        self
    }
}
impl<T> AsRef<[T]> for crate::vec::Vec<T> {
    fn as_ref(&self) -> &[T] {
        self.as_slice()
    }
}
impl AsRef<str> for str {
    fn as_ref(&self) -> &str {
        self
    }
}
impl AsRef<str> for crate::string::String {
    fn as_ref(&self) -> &str {
        self.as_str()
    }
}

// References (of references) are what they refer to, as in Rust.
impl<T, U> AsRef<U> for &T
where
    T: AsRef<U>,
{
    fn as_ref(&self) -> &U {
        (**self).as_ref()
    }
}
impl<T, U> AsRef<U> for &mut T
where
    T: AsRef<U>,
{
    fn as_ref(&self) -> &U {
        (**self).as_ref()
    }
}

/// The error type for errors that can never happen.
///
/// Since this enum has no variant, a value of this type can never actually
/// exist. This can be useful for generic APIs that use [`Result`] and
/// parameterize the error type, to indicate that the result is always
/// [`Ok`].
///
/// # Examples
///
/// ```
/// use std::convert::Infallible;
///
/// struct Celsius(f64);
///
/// impl TryFrom<f64> for Celsius {
///     type Error = Infallible;
///     fn try_from(x: f64) -> Result<Celsius, Infallible> {
///         Ok(Celsius(x))
///     }
/// }
///
/// let c = Celsius::try_from(21.5).unwrap();
/// assert_eq(c.0, 21.5);
/// ```
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum Infallible {}

impl crate::fmt::Display for Infallible {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        match *self {}
    }
}

impl<T, U> TryInto<U> for T
where
    U: TryFrom<T>,
{
    type Error = U::Error;
    fn try_into(self) -> Result<U, U::Error> {
        U::try_from(self)
    }
}
