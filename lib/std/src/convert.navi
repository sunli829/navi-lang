//! Conversions between types.

pub trait From<T> { fn from(value: T) -> Self; }
pub trait Into<T> { fn into(self) -> T; }
pub trait TryFrom<T> { type Error; fn try_from(value: T) -> Result<Self, Self::Error>; }
pub trait TryInto<T> { type Error; fn try_into(self) -> Result<T, Self::Error>; }
pub trait AsRef<T> { fn as_ref(&self) -> &T; }
pub trait AsMut<T> { fn as_mut(&mut self) -> &mut T; }

impl<T, U: From<T>> Into<U> for T {
    fn into(self) -> U { U::from(self) }
}

impl<T> From<T> for T {
    fn from(t: T) -> T { t }
}

impl AsRef<[u8]> for str { fn as_ref(&self) -> &[u8] { self.as_bytes() } }
impl AsRef<[u8]> for crate::string::String { fn as_ref(&self) -> &[u8] { self.as_bytes() } }
impl<T> AsRef<[T]> for [T] { fn as_ref(&self) -> &[T] { self } }
impl<T> AsRef<[T]> for crate::vec::Vec<T> { fn as_ref(&self) -> &[T] { self.as_slice() } }
impl AsRef<str> for str { fn as_ref(&self) -> &str { self } }
impl AsRef<str> for crate::string::String { fn as_ref(&self) -> &str { self.as_str() } }

// References (of references) are what they refer to, as in Rust.
impl<T: AsRef<U>, U> AsRef<U> for &T { fn as_ref(&self) -> &U { (**self).as_ref() } }
impl<T: AsRef<U>, U> AsRef<U> for &mut T { fn as_ref(&self) -> &U { (**self).as_ref() } }

/// The error type of conversions that cannot fail.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum Infallible {}

impl crate::fmt::Display for Infallible {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result { match *self {} }
}

impl<T, U: TryFrom<T>> TryInto<U> for T {
    type Error = U::Error;
    fn try_into(self) -> Result<U, U::Error> { U::try_from(self) }
}
