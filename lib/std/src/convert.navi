//! Conversions between types.

pub trait From<T> { fn from(value: T) -> Self; }
pub trait Into<T> { fn into(self) -> T; }
pub trait TryFrom<T> { type Error; fn try_from(value: T) -> Result<Self, Self::Error>; }
pub trait TryInto<T> { type Error; fn try_into(self) -> Result<T, Self::Error>; }
pub trait AsRef<T> { fn as_ref(&self) -> &T; }
pub trait AsMut<T> { fn as_mut(&mut self) -> &mut T; }

impl<T, U: From<T>> Into<U> for T {
    fn into(self) -> U { U::from(self) }
}

impl<T> From<T> for T {
    fn from(t: T) -> T { t }
}
