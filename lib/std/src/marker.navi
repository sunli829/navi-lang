//! Marker types (as Rust's std::marker; Send, Sync, Copy and Unpin are not
//! provided: see spec/std-diff.md).

/// A zero-sized marker for a type parameter a type does not otherwise use.
///
/// Adding a field of type `PhantomData<T>` lets a type take a parameter
/// `T` it does not store, for example to tag values with a unit or a kind
/// that the type checker keeps apart. It takes no space.
///
/// # Examples
///
/// ```
/// use std::marker::PhantomData;
///
/// struct Meters;
/// struct Feet;
///
/// struct Length<Unit> {
///     value: f64,
///     unit: PhantomData<Unit>,
/// }
///
/// fn meters(value: f64) -> Length<Meters> {
///     Length {
///         value,
///         unit: PhantomData,
///     }
/// }
///
/// fn add(a: Length<Meters>, b: Length<Meters>) -> Length<Meters> {
///     meters(a.value + b.value)
/// }
///
/// // add(meters(1.0), Length::<Feet> { .. }) would not compile.
/// let total = add(meters(1.5), meters(2.0));
/// assert_eq(total.value, 3.5);
/// assert_eq(std::mem::size_of::<PhantomData<Feet>>(), 0);
/// ```
#[derive(Clone, Debug, PartialEq, Eq, Default, Hash)]
pub struct PhantomData<T>;
