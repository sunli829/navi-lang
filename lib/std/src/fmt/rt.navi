//! Helpers for the compiler's builtin formatting impls (integers, floats,
//! bool, char, str, slices). Not part of the public API.

use crate::fmt::{Debug, Formatter, Result};
use crate::string::String;

fn digits(v: u64, radix: u64, upper: bool) -> String {
    let mut buf = [0u8; 64];
    let mut n = 0;
    let mut x = v;
    loop {
        let d = (x % radix) as u8;
        buf[n] = if d < 10 { b'0' + d } else if upper { b'A' + d - 10 } else { b'a' + d - 10 };
        n += 1;
        x = x / radix;
        if x == 0 { break; }
    }
    let mut s = String::with_capacity(n);
    while n > 0 {
        n -= 1;
        s.push(buf[n] as char);
    }
    s
}

pub fn fmt_u64(v: u64, f: &mut Formatter) -> Result {
    f.pad_integral(true, "", digits(v, 10, false).as_str())
}

pub fn fmt_i64(v: i64, f: &mut Formatter) -> Result {
    if v >= 0 {
        return f.pad_integral(true, "", digits(v as u64, 10, false).as_str());
    }
    // -(v + 1) + 1 avoids overflow for i64::MIN.
    let m = (-(v + 1)) as u64 + 1;
    f.pad_integral(false, "", digits(m, 10, false).as_str())
}

pub fn fmt_radix(v: u64, radix: u64, upper: bool, prefix: &str, f: &mut Formatter) -> Result {
    f.pad_integral(true, prefix, digits(v, radix, upper).as_str())
}

pub fn fmt_bool(v: bool, f: &mut Formatter) -> Result {
    f.pad(if v { "true" } else { "false" })
}

pub fn fmt_char(c: char, f: &mut Formatter) -> Result {
    let mut s = String::new();
    s.push(c);
    f.pad(s.as_str())
}

fn escape(c: char, quote: char, out: &mut String) {
    if c == '\n' { out.push_str("\\n"); }
    else if c == '\r' { out.push_str("\\r"); }
    else if c == '\t' { out.push_str("\\t"); }
    else if c == '\\' { out.push_str("\\\\"); }
    else if c == '\0' { out.push_str("\\0"); }
    else if c == quote { out.push('\\'); out.push(c); }
    else { out.push(c); }
}

pub fn debug_char(c: char, f: &mut Formatter) -> Result {
    let mut s = String::from("'");
    escape(c, '\'', &mut s);
    s.push('\'');
    f.write_str(s.as_str())
}

pub fn debug_str(v: &str, f: &mut Formatter) -> Result {
    let mut s = String::from("\"");
    for c in v.chars() { escape(c, '"', &mut s); }
    s.push('"');
    f.write_str(s.as_str())
}

// style: 0 Display, 1 Debug, 2 {:e}, 3 {:E}; +16 for f32.
pub fn fmt_float(v: f64, style: u8, f: &mut Formatter) -> Result {
    let mut buf = [0u8; 400];
    let (prec, has_prec) = match f.precision() { Some(p) => (p, true), None => (0, false) };
    let n = crate::rt::fmt_float(v, prec, has_prec, style, &mut buf as *mut [u8; 400] as *mut u8);
    let s = crate::rt::str_from_raw(&buf as *const [u8; 400] as *const u8, n);
    if s.starts_with("-") {
        f.pad_integral(false, "", &s[1..])
    } else {
        f.pad_integral(true, "", s)
    }
}

pub fn debug_unit(f: &mut Formatter) -> Result { f.pad("()") }

pub fn debug_slice<T: Debug>(s: &[T], f: &mut Formatter) -> Result {
    let mut l = f.debug_list();
    for x in s { l.entry(x); }
    l.finish()
}
