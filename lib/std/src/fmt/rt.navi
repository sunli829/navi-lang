//! Helpers for the compiler's builtin formatting impls (integers, floats,
//! bool, char, str, slices). Not part of the public API.
//!
//! The formatting traits of the primitive types
//! ([`Display`](crate::fmt::Display) for `i32`, [`Debug`] for `str`,
//! [`LowerHex`](crate::fmt::LowerHex) for `u8`...) have no `impl` written in
//! std: the compiler provides them as calls of these functions, so formatting
//! `n` in `` `${n:x}` `` calls [`fmt_radix`] with the value and the
//! [`Formatter`] configured from the spec. They are public only so that
//! compiled code in any crate can call them; use the formatting traits and
//! template strings instead.
//!
//! Each function writes one value and applies the formatter's options
//! (width, fill, alignment, sign, `#`, zero padding, precision) as the
//! corresponding Rust implementation does.
//!
//! # Examples
//!
//! What the builtin impls write:
//!
//! ```
//! assert_eq(`${-1i8:x}`.to_string(), "ff"); // fmt_radix, the bits of an i8
//! assert_eq(`${-7:>4}`.to_string(), "  -7"); // fmt_i64
//! assert_eq(`${1.5f32:?}`.to_string(), "1.5"); // fmt_float
//! assert_eq(`${'\'':?}`.to_string(), "'\\''"); // debug_char
//! assert_eq(`${"a\tb":?}`.to_string(), "\"a\\tb\""); // debug_str
//! assert_eq(`${[1, 2]:?}`.to_string(), "[1, 2]"); // debug_slice
//! assert_eq(`${():?}`.to_string(), "()"); // debug_unit
//! ```

use crate::fmt::{Debug, Formatter, Result};
use crate::string::String;

fn digits(v: u64, radix: u64, upper: bool) -> String {
    let mut buf = [0u8; 64];
    let mut n = 0;
    let mut x = v;
    loop {
        let d = (x % radix) as u8;
        buf[n] = if d < 10 {
            b'0' + d
        } else if upper {
            b'A' + d - 10
        } else {
            b'a' + d - 10
        };
        n += 1;
        x = x / radix;
        if x == 0 {
            break;
        }
    }
    let mut s = String::with_capacity(n);
    while n > 0 {
        n -= 1;
        s.push(buf[n] as char);
    }
    s
}

/// Formats an unsigned integer in decimal (`Display` for `u8` to `u64`
/// and `usize`).
pub fn fmt_u64(v: u64, f: &mut Formatter) -> Result {
    f.pad_integral(true, "", digits(v, 10, false).as_str())
}

/// Formats a signed integer in decimal (`Display` for `i8` to `i64` and
/// `isize`).
pub fn fmt_i64(v: i64, f: &mut Formatter) -> Result {
    if v >= 0 {
        return f.pad_integral(true, "", digits(v as u64, 10, false).as_str());
    }
    // -(v + 1) + 1 avoids overflow for i64::MIN.
    let m = (-(v + 1)) as u64 + 1;
    f.pad_integral(false, "", digits(m, 10, false).as_str())
}

/// Formats an integer's bits in base `radix` (2, 8 or 16), with uppercase
/// letters if `upper`, and `prefix` (as `0x`) with the `#` flag: the
/// [`LowerHex`](crate::fmt::LowerHex), [`UpperHex`](crate::fmt::UpperHex),
/// [`Octal`](crate::fmt::Octal) and [`Binary`](crate::fmt::Binary) impls
/// of integers up to 64 bits.
///
/// A negative signed integer is passed as its two's complement, truncated
/// to its width (so `-1i8` prints as `ff`).
pub fn fmt_radix(v: u64, radix: u64, upper: bool, prefix: &str, f: &mut Formatter) -> Result {
    f.pad_integral(true, prefix, digits(v, radix, upper).as_str())
}

/// Formats a `u128` in decimal (its `Display`).
pub fn fmt_u128(v: u128, f: &mut Formatter) -> Result {
    f.pad_integral(true, "", crate::rt::int128::digits(v, 10, false).as_str())
}

/// Formats an `i128` in decimal (its `Display`).
pub fn fmt_i128(v: i128, f: &mut Formatter) -> Result {
    f.pad_integral(
        !crate::rt::int128::is_neg(v),
        "",
        crate::rt::int128::digits_i(v).as_str(),
    )
}

/// [`fmt_radix`] for 128-bit integers.
pub fn fmt_radix128(v: u128, radix: u64, upper: bool, prefix: &str, f: &mut Formatter) -> Result {
    f.pad_integral(
        true,
        prefix,
        crate::rt::int128::digits(v, radix, upper).as_str(),
    )
}

/// Formats a `bool` as `true` or `false` (its `Display` and `Debug`).
pub fn fmt_bool(v: bool, f: &mut Formatter) -> Result {
    f.pad(if v { "true" } else { "false" })
}

/// Formats a `char` as itself (its `Display`).
pub fn fmt_char(c: char, f: &mut Formatter) -> Result {
    let mut s = String::new();
    s.push(c);
    f.pad(s.as_str())
}

fn escape(c: char, quote: char, out: &mut String) {
    if c == '\n' {
        out.push_str("\\n");
    } else if c == '\r' {
        out.push_str("\\r");
    } else if c == '\t' {
        out.push_str("\\t");
    } else if c == '\\' {
        out.push_str("\\\\");
    } else if c == '\0' {
        out.push_str("\\0");
    } else if c == quote {
        out.push('\\');
        out.push(c);
    } else {
        out.push(c);
    }
}

/// Formats a `char` in single quotes, escaped (its `Debug`: `'\n'`,
/// `'\''`).
///
/// Only `\n`, `\r`, `\t`, `\\`, `\0` and the quote are escaped; unlike
/// Rust, other control and non-printable characters are written as they
/// are, and the width options are ignored.
pub fn debug_char(c: char, f: &mut Formatter) -> Result {
    let mut s = String::from("'");
    escape(c, '\'', &mut s);
    s.push('\'');
    f.write_str(s.as_str())
}

/// Formats a string in double quotes, escaped (the `Debug` of `str` and
/// [`String`]).
///
/// Escapes as [`debug_char`] does, with `"` as the quote.
pub fn debug_str(v: &str, f: &mut Formatter) -> Result {
    let mut s = String::from("\"");
    for c in v.chars() {
        escape(c, '"', &mut s);
    }
    s.push('"');
    f.write_str(s.as_str())
}

// style: 0 Display, 1 Debug, 2 {:e}, 3 {:E}; +16 for f32.
/// Formats a float: `style` is 0 for `Display`, 1 for `Debug`, 2 for
/// [`LowerExp`](crate::fmt::LowerExp), 3 for
/// [`UpperExp`](crate::fmt::UpperExp), plus 16 when the value is an `f32`
/// (widened to `f64` for the call).
pub fn fmt_float(v: f64, style: u8, f: &mut Formatter) -> Result {
    let mut buf = [0u8; 1100];
    let (prec, has_prec) = match f.precision() {
        Some(p) => (p, true),
        None => (0, false),
    };
    let n = crate::rt::fmt_float(
        v,
        prec,
        has_prec,
        style,
        &mut buf as *mut [u8; 1100] as *mut u8,
    );
    let s = crate::rt::str_from_raw(&buf as *const [u8; 1100] as *const u8, n);
    if s.starts_with("-") {
        f.pad_integral(false, "", &s[1..])
    } else {
        f.pad_integral(true, "", s)
    }
}

/// Formats the unit value as `()` (its `Debug`).
pub fn debug_unit(f: &mut Formatter) -> Result {
    f.pad("()")
}

/// Formats a slice or array as a list, `[1, 2, 3]` (their `Debug`), with
/// [`Formatter::debug_list`].
pub fn debug_slice<T: Debug>(s: &[T], f: &mut Formatter) -> Result {
    let mut l = f.debug_list();
    for x in s {
        l.entry(x);
    }
    l.finish()
}
