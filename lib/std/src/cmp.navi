//! Utilities for comparing and ordering values.
//!
//! This module contains various tools for comparing and ordering values. In
//! summary:
//!
//! * [`PartialEq<Rhs>`](PartialEq) overloads the `==` and `!=` operators. `Rhs`
//!   (the right hand side's type) is often `Self`, but it does not have to be:
//!   `String` compares with `&str`, for example.
//! * [`Eq`] indicates that the overloaded `==` is an equivalence relation.
//! * [`Ord`] and [`PartialOrd`] are traits that define total and partial
//!   orderings between values, respectively. Implementing them overloads the
//!   `<`, `<=`, `>`, and `>=` operators.
//! * [`Ordering`](crate::cmp::Ordering) is an enum returned by the main
//!   functions of [`Ord`] and [`PartialOrd`], and describes an ordering of two
//!   values (less, equal, or greater).
//! * [`Reverse`] is a struct that reverses an ordering.
//! * [`max`] and [`min`] (and their `_by`, `_by_key` forms) find the greater or
//!   smaller of two values.
//!
//! All five traits can be derived with `#[derive(...)]`. `==` compares
//! values; to check whether two references point to the same object, use
//! [`crate::ptr::eq`].
//!
//! # Examples
//!
//! ```
//! use std::cmp::Ordering;
//!
//! #[derive(PartialEq, Eq, PartialOrd, Ord, Debug)]
//! struct Version {
//!     major: u32,
//!     minor: u32,
//! }
//!
//! let a = Version { major: 1, minor: 2 };
//! let b = Version {
//!     major: 1,
//!     minor: 10,
//! };
//! assert(a < b); // derived: field by field, in declaration order
//! assert_eq(a.cmp(&b), Ordering::Less);
//! assert_eq(
//!     std::cmp::max(a, b),
//!     Version {
//!         major: 1,
//!         minor: 10,
//!     },
//! );
//! ```

/// Trait for comparisons using the equality operator.
///
/// Implementing this trait for types provides the `==` and `!=` operators
/// for those types.
///
/// `x.eq(y)` can also be written `x == y`, and `x.ne(y)` can be written
/// `x != y`. Implementations must ensure that `eq` and `ne` are consistent
/// with each other, and that equality is symmetric and transitive.
///
/// `PartialEq` only requires a partial equivalence relation: for example,
/// for floating point numbers `NAN != NAN`. Types whose equality is a full
/// equivalence relation also implement [`Eq`].
///
/// ## Derivable
///
/// This trait can be used with `#[derive]`. When derived on structs, two
/// instances are equal if all fields are equal, and not equal if any fields
/// are not equal. When derived on enums, two instances are equal if they
/// are the same variant and all fields are equal.
///
/// ## How can I implement `PartialEq`?
///
/// An example implementation for a domain in which two books are
/// considered the same book if their ISBN matches, even if the formats
/// differ:
///
/// ```
/// enum BookFormat {
///     Paperback,
///     Hardback,
///     Ebook,
/// }
///
/// struct Book {
///     isbn: i32,
///     format: BookFormat,
/// }
///
/// impl PartialEq for Book {
///     fn eq(&self, other: &Book) -> bool {
///         self.isbn == other.isbn
///     }
/// }
///
/// let b1 = Book {
///     isbn: 3,
///     format: BookFormat::Paperback,
/// };
/// let b2 = Book {
///     isbn: 3,
///     format: BookFormat::Ebook,
/// };
/// let b3 = Book {
///     isbn: 10,
///     format: BookFormat::Paperback,
/// };
///
/// assert(b1 == b2);
/// assert(b1 != b3);
/// ```
///
/// ## Comparing different types
///
/// `Rhs` lets a type compare with another one:
///
/// ```
/// struct Meters(f64);
/// struct Centimeters(f64);
///
/// impl PartialEq<Centimeters> for Meters {
///     fn eq(&self, other: &Centimeters) -> bool {
///         self.0 * 100.0 == other.0
///     }
/// }
///
/// assert(Meters(1.5) == Centimeters(150.0));
/// ```
pub trait PartialEq<Rhs = Self> {
    /// Tests for `self` and `other` values to be equal, and is used by `==`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(1.eq(&1));
    /// assert("a".to_string().eq(&"a"));
    /// ```
    fn eq(&self, other: &Rhs) -> bool;
    /// Tests for `!=`. The default implementation is almost always sufficient,
    /// and should not be overridden without very good reason.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(1.ne(&2));
    /// assert(!1.ne(&1));
    /// ```
    fn ne(&self, other: &Rhs) -> bool {
        !self.eq(other)
    }
}

/// Trait for comparisons corresponding to equivalence relations.
///
/// On top of [`PartialEq`] (symmetric and transitive), `Eq` promises that
/// `a == a` for every value (reflexivity): floating point numbers are not
/// `Eq` because `NAN != NAN`. It has no methods; it is a promise that
/// generic code (such as the keys of [`HashMap`](crate::collections::HashMap)
/// or [`Ord`]) relies on.
///
/// ## Derivable
///
/// This trait can be used with `#[derive]`; it needs [`PartialEq`] too.
///
/// # Examples
///
/// ```
/// #[derive(PartialEq, Eq, Debug)]
/// struct Id(u32);
///
/// fn same<T: Eq>(a: &T, b: &T) -> bool {
///     a == b
/// }
///
/// assert(same(&Id(1), &Id(1)));
/// ```
pub trait Eq: PartialEq {}

/// An `Ordering` is the result of a comparison between two values.
///
/// Its discriminants are those of Rust's: `Less` is -1, `Equal` 0 and
/// `Greater` 1.
///
/// # Examples
///
/// ```
/// use std::cmp::Ordering;
///
/// assert_eq(1.cmp(&2), Ordering::Less);
/// assert_eq(1.cmp(&1), Ordering::Equal);
/// assert_eq(2.cmp(&1), Ordering::Greater);
/// ```
#[derive(Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
pub enum Ordering {
    /// An ordering where a compared value is less than another.
    Less = -1,
    /// An ordering where a compared value is equal to another.
    Equal = 0,
    /// An ordering where a compared value is greater than another.
    Greater = 1,
}

/// Trait for types that form a partial order.
///
/// The `lt`, `le`, `gt`, and `ge` methods of this trait can be called
/// using the `<`, `<=`, `>`, and `>=` operators, respectively.
///
/// Only [`PartialOrd::partial_cmp`] must be written; the others have
/// default implementations based on it. It returns `None` for values that
/// are not comparable, such as floating point `NAN` with anything: then
/// all four operators are `false`. Types with a total order also implement
/// [`Ord`].
///
/// ## Derivable
///
/// This trait can be used with `#[derive]`. When derived on structs, it
/// produces a lexicographic ordering based on the top-to-bottom
/// declaration order of the struct's members. When derived on enums,
/// variants are ordered primarily by their discriminants: variants
/// declared earlier are less.
///
/// # Examples
///
/// ```
/// use std::cmp::Ordering;
///
/// struct Person {
///     id: u32,
///     height: f64,
/// }
///
/// impl PartialEq for Person {
///     fn eq(&self, other: &Person) -> bool {
///         self.height == other.height
///     }
/// }
///
/// impl PartialOrd for Person {
///     fn partial_cmp(&self, other: &Person) -> Option<Ordering> {
///         self.height.partial_cmp(&other.height)
///     }
/// }
///
/// let a = Person { id: 1, height: 1.7 };
/// let b = Person { id: 2, height: 1.8 };
/// assert(a < b);
/// assert(b >= a);
/// ```
pub trait PartialOrd<Rhs = Self>: PartialEq<Rhs> {
    /// This method returns an ordering between `self` and `other` values if
    /// one exists.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::cmp::Ordering;
    ///
    /// assert_eq(1.0.partial_cmp(&2.0), Some(Ordering::Less));
    /// assert_eq(1.0.partial_cmp(&1.0), Some(Ordering::Equal));
    /// assert_eq(2.0.partial_cmp(&1.0), Some(Ordering::Greater));
    /// assert_eq(f64::NAN.partial_cmp(&1.0), None);
    /// ```
    fn partial_cmp(&self, other: &Rhs) -> Option<Ordering>;
    /// Tests less than (for `self` and `other`) and is used by the `<`
    /// operator.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(1.0 < 1.0, false);
    /// assert_eq(1.0 < 2.0, true);
    /// assert_eq(2.0.lt(&1.0), false);
    /// ```
    fn lt(&self, other: &Rhs) -> bool {
        match self.partial_cmp(other) {
            Some(Ordering::Less) => true,
            _ => false,
        }
    }

    /// Tests less than or equal to (for `self` and `other`) and is used by the
    /// `<=` operator.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(1.0 <= 1.0, true);
    /// assert_eq(1.0 <= 2.0, true);
    /// assert_eq(2.0.le(&1.0), false);
    /// ```
    fn le(&self, other: &Rhs) -> bool {
        match self.partial_cmp(other) {
            Some(Ordering::Less) | Some(Ordering::Equal) => true,
            _ => false,
        }
    }

    /// Tests greater than (for `self` and `other`) and is used by the `>`
    /// operator.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(1.0 > 1.0, false);
    /// assert_eq(1.0 > 2.0, false);
    /// assert_eq(2.0.gt(&1.0), true);
    /// ```
    fn gt(&self, other: &Rhs) -> bool {
        match self.partial_cmp(other) {
            Some(Ordering::Greater) => true,
            _ => false,
        }
    }

    /// Tests greater than or equal to (for `self` and `other`) and is used by
    /// the `>=` operator.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(1.0 >= 1.0, true);
    /// assert_eq(1.0 >= 2.0, false);
    /// assert_eq(2.0.ge(&1.0), true);
    /// ```
    fn ge(&self, other: &Rhs) -> bool {
        match self.partial_cmp(other) {
            Some(Ordering::Greater) | Some(Ordering::Equal) => true,
            _ => false,
        }
    }
}

/// Trait for types that form a total order.
///
/// An order is total if any two values compare: exactly one of `a < b`,
/// `a == b` or `a > b` is true, and `<` is transitive. Implementations
/// must be consistent with the [`PartialOrd`] implementation
/// (`partial_cmp(a, b) == Some(cmp(a, b))`) and with [`PartialEq`].
///
/// Sorting ([`slice::sort`](crate::slice)),
/// [`BTreeMap`](crate::collections::BTreeMap) keys and [`max`]/[`min`] use
/// `Ord`.
///
/// ## Derivable
///
/// This trait can be used with `#[derive]`. When derived on structs, it
/// produces a lexicographic ordering based on the top-to-bottom
/// declaration order of the struct's members. When derived on enums,
/// variants are ordered by their discriminants.
///
/// ## How can I implement `Ord`?
///
/// `Ord` requires that the type also be [`PartialOrd`], [`PartialEq`],
/// and [`Eq`]. Then implement `cmp`, and make `partial_cmp` return
/// `Some(self.cmp(other))`:
///
/// ```
/// use std::cmp::Ordering;
///
/// struct Person {
///     id: u32,
///     name: String,
///     height: u32,
/// }
///
/// impl Eq for Person {}
///
/// impl Ord for Person {
///     fn cmp(&self, other: &Person) -> Ordering {
///         self.height.cmp(&other.height)
///     }
/// }
///
/// impl PartialOrd for Person {
///     fn partial_cmp(&self, other: &Person) -> Option<Ordering> {
///         Some(self.cmp(other))
///     }
/// }
///
/// impl PartialEq for Person {
///     fn eq(&self, other: &Person) -> bool {
///         self.height == other.height
///     }
/// }
///
/// let a = Person {
///     id: 1,
///     name: "a".to_string(),
///     height: 170,
/// };
/// let b = Person {
///     id: 2,
///     name: "b".to_string(),
///     height: 180,
/// };
/// assert_eq(a.cmp(&b), Ordering::Less);
/// assert_eq(a.max(b).id, 2);
/// ```
pub trait Ord: Eq + PartialOrd {
    /// This method returns an [`Ordering`](crate::cmp::Ordering) between `self`
    /// and `other`.
    ///
    /// By convention, `self.cmp(&other)` returns the ordering matching the
    /// expression `self <operator> other` if true.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::cmp::Ordering;
    ///
    /// assert_eq(5.cmp(&10), Ordering::Less);
    /// assert_eq(10.cmp(&5), Ordering::Greater);
    /// assert_eq(5.cmp(&5), Ordering::Equal);
    /// ```
    fn cmp(&self, other: &Self) -> Ordering;
    /// Compares and returns the maximum of two values.
    ///
    /// Returns the second argument if the comparison determines them to be
    /// equal.
    ///
    /// (On an integer literal, write its type, as in `1i32.max(2)`: an untyped
    /// literal receiver also matches
    /// [`Iterator::max`](crate::iter::Iterator::max).)
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(1i32.max(2), 2);
    /// assert_eq(2i32.max(2), 2);
    /// ```
    fn max(self, other: Self) -> Self {
        match self.cmp(&other) {
            Ordering::Greater => self,
            _ => other,
        }
    }

    /// Compares and returns the minimum of two values.
    ///
    /// Returns the first argument if the comparison determines them to be
    /// equal.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(1i32.min(2), 1);
    /// assert_eq(2i32.min(2), 2);
    /// ```
    fn min(self, other: Self) -> Self {
        match self.cmp(&other) {
            Ordering::Greater => other,
            _ => self,
        }
    }

    /// Restricts a value to a certain interval.
    ///
    /// Returns `max` if `self` is greater than `max`, and `min` if `self` is
    /// less than `min`. Otherwise this returns `self`.
    ///
    /// # Panics
    ///
    /// Panics if `min > max`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-3).clamp(-2, 1), -2);
    /// assert_eq(0.clamp(-2, 1), 0);
    /// assert_eq(2.clamp(-2, 1), 1);
    /// ```
    #[track_caller]
    fn clamp(self, min: Self, max: Self) -> Self {
        if min > max {
            crate::panic::panic("assertion failed: min <= max");
        }
        if self < min {
            min
        } else if self > max {
            max
        } else {
            self
        }
    }
}

/// Compares and returns the maximum of two values.
///
/// Returns the second argument if the comparison determines them to be
/// equal.
///
/// # Examples
///
/// ```
/// use std::cmp;
///
/// assert_eq(cmp::max(1, 2), 2);
/// assert_eq(cmp::max(2, 2), 2);
/// assert_eq(cmp::max("apple", "banana"), "banana");
/// ```
pub fn max<T: Ord>(a: T, b: T) -> T {
    a.max(b)
}

/// Compares and returns the minimum of two values.
///
/// Returns the first argument if the comparison determines them to be
/// equal.
///
/// # Examples
///
/// ```
/// use std::cmp;
///
/// assert_eq(cmp::min(1, 2), 1);
/// assert_eq(cmp::min(2, 2), 2);
/// ```
pub fn min<T: Ord>(a: T, b: T) -> T {
    a.min(b)
}

impl Ordering {
    /// Returns `true` if the ordering is the `Equal` variant.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::cmp::Ordering;
    ///
    /// assert_eq(Ordering::Less.is_eq(), false);
    /// assert_eq(Ordering::Equal.is_eq(), true);
    /// assert_eq(Ordering::Greater.is_eq(), false);
    /// ```
    pub fn is_eq(self) -> bool {
        self == Ordering::Equal
    }

    /// Returns `true` if the ordering is not the `Equal` variant.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::cmp::Ordering;
    ///
    /// assert_eq(Ordering::Less.is_ne(), true);
    /// assert_eq(Ordering::Equal.is_ne(), false);
    /// assert_eq(Ordering::Greater.is_ne(), true);
    /// ```
    pub fn is_ne(self) -> bool {
        self != Ordering::Equal
    }

    /// Returns `true` if the ordering is the `Less` variant.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::cmp::Ordering;
    ///
    /// assert_eq(Ordering::Less.is_lt(), true);
    /// assert_eq(Ordering::Equal.is_lt(), false);
    /// assert_eq(Ordering::Greater.is_lt(), false);
    /// ```
    pub fn is_lt(self) -> bool {
        self == Ordering::Less
    }

    /// Returns `true` if the ordering is the `Greater` variant.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::cmp::Ordering;
    ///
    /// assert_eq(Ordering::Less.is_gt(), false);
    /// assert_eq(Ordering::Equal.is_gt(), false);
    /// assert_eq(Ordering::Greater.is_gt(), true);
    /// ```
    pub fn is_gt(self) -> bool {
        self == Ordering::Greater
    }

    /// Returns `true` if the ordering is either the `Less` or `Equal` variant.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::cmp::Ordering;
    ///
    /// assert_eq(Ordering::Less.is_le(), true);
    /// assert_eq(Ordering::Equal.is_le(), true);
    /// assert_eq(Ordering::Greater.is_le(), false);
    /// ```
    pub fn is_le(self) -> bool {
        self != Ordering::Greater
    }

    /// Returns `true` if the ordering is either the `Greater` or `Equal`
    /// variant.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::cmp::Ordering;
    ///
    /// assert_eq(Ordering::Less.is_ge(), false);
    /// assert_eq(Ordering::Equal.is_ge(), true);
    /// assert_eq(Ordering::Greater.is_ge(), true);
    /// ```
    pub fn is_ge(self) -> bool {
        self != Ordering::Less
    }

    /// Reverses the `Ordering`.
    ///
    /// * `Less` becomes `Greater`.
    /// * `Greater` becomes `Less`.
    /// * `Equal` becomes `Equal`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::cmp::Ordering;
    ///
    /// assert_eq(Ordering::Less.reverse(), Ordering::Greater);
    /// assert_eq(Ordering::Equal.reverse(), Ordering::Equal);
    /// assert_eq(Ordering::Greater.reverse(), Ordering::Less);
    ///
    /// // Sort in descending order.
    /// let mut data = Vec::from([2, 10, 5, 8]);
    /// data.sort_by(|a: &i32, b: &i32| -> Ordering { a.cmp(b).reverse() });
    /// assert_eq(data, [10, 8, 5, 2]);
    /// ```
    pub fn reverse(self) -> Ordering {
        match self {
            Ordering::Less => Ordering::Greater,
            Ordering::Equal => Ordering::Equal,
            Ordering::Greater => Ordering::Less,
        }
    }

    /// Chains two orderings.
    ///
    /// Returns `self` when it's not `Equal`. Otherwise returns `other`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::cmp::Ordering;
    ///
    /// let result = Ordering::Equal.then(Ordering::Less);
    /// assert_eq(result, Ordering::Less);
    ///
    /// let result = Ordering::Less.then(Ordering::Equal);
    /// assert_eq(result, Ordering::Less);
    ///
    /// let x = (1, 2, 7);
    /// let y = (1, 5, 3);
    /// let result = x.0.cmp(&y.0).then(x.1.cmp(&y.1)).then(x.2.cmp(&y.2));
    /// assert_eq(result, Ordering::Less);
    /// ```
    pub fn then(self, other: Ordering) -> Ordering {
        if self == Ordering::Equal { other } else { self }
    }

    /// Chains the ordering with the given function.
    ///
    /// Returns `self` when it's not `Equal`. Otherwise calls `f` and returns
    /// the result.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::cmp::Ordering;
    ///
    /// let result = Ordering::Equal.then_with(|| Ordering::Less);
    /// assert_eq(result, Ordering::Less);
    ///
    /// let x = (1, 2, 7);
    /// let y = (1, 5, 3);
    /// let result =
    ///     x.0.cmp(&y.0)
    ///         .then_with(|| x.1.cmp(&y.1))
    ///         .then_with(|| x.2.cmp(&y.2));
    /// assert_eq(result, Ordering::Less);
    /// ```
    pub fn then_with(self, f: fn() -> Ordering) -> Ordering {
        if self == Ordering::Equal { f() } else { self }
    }
}

/// A helper struct for reverse ordering.
///
/// This struct is a helper to be used with functions like
/// [`slice::sort_by_key`](crate::slice) and can be used to reverse order a
/// part of a key; a min-heap is a
/// [`BinaryHeap`](crate::collections::BinaryHeap)`<Reverse<T>>`.
///
/// # Examples
///
/// ```
/// use std::cmp::Reverse;
///
/// let mut v = Vec::from([1, 2, 3, 4, 5, 6]);
/// v.sort_by_key(|x: &i32| -> (bool, Reverse<i32>) { (*x > 3, Reverse(*x)) });
/// assert_eq(v, [3, 2, 1, 6, 5, 4]);
/// assert(Reverse(1) > Reverse(2));
/// ```
#[derive(Clone, PartialEq, Eq, Hash, Debug, Default)]
pub struct Reverse<T>(pub T);

impl<T: PartialOrd> PartialOrd for Reverse<T> {
    fn partial_cmp(&self, other: &Reverse<T>) -> Option<Ordering> {
        other.0.partial_cmp(&self.0)
    }
}

impl<T: Ord> Ord for Reverse<T> {
    fn cmp(&self, other: &Reverse<T>) -> Ordering {
        other.0.cmp(&self.0)
    }
}

/// Returns the maximum of two values with respect to the specified
/// comparison function.
///
/// Returns the second argument if the comparison determines them to be
/// equal.
///
/// # Examples
///
/// ```
/// use std::{cmp, cmp::Ordering};
///
/// let abs_cmp = |x: &i32, y: &i32| -> Ordering { x.abs().cmp(&y.abs()) };
/// assert_eq(cmp::max_by(-2, 1, abs_cmp), -2);
/// assert_eq(cmp::max_by(1, -2, abs_cmp), -2);
/// assert_eq(cmp::max_by(-2, 2, abs_cmp), 2);
/// ```
pub fn max_by<T>(v1: T, v2: T, compare: fn(&T, &T) -> Ordering) -> T {
    match compare(&v1, &v2) {
        Ordering::Greater => v1,
        _ => v2,
    }
}

/// Returns the minimum of two values with respect to the specified
/// comparison function.
///
/// Returns the first argument if the comparison determines them to be
/// equal.
///
/// # Examples
///
/// ```
/// use std::{cmp, cmp::Ordering};
///
/// let abs_cmp = |x: &i32, y: &i32| -> Ordering { x.abs().cmp(&y.abs()) };
/// assert_eq(cmp::min_by(-2, 1, abs_cmp), 1);
/// assert_eq(cmp::min_by(1, -2, abs_cmp), 1);
/// assert_eq(cmp::min_by(-2, 2, abs_cmp), -2);
/// ```
pub fn min_by<T>(v1: T, v2: T, compare: fn(&T, &T) -> Ordering) -> T {
    match compare(&v1, &v2) {
        Ordering::Greater => v2,
        _ => v1,
    }
}

/// Returns the element that gives the maximum value from the specified
/// function.
///
/// Returns the second argument if the comparison determines them to be
/// equal.
///
/// # Examples
///
/// ```
/// use std::cmp;
///
/// assert_eq(cmp::max_by_key(-2, 1, |x: &i32| -> i32 { x.abs() }), -2);
/// assert_eq(cmp::max_by_key(-2, 2, |x: &i32| -> i32 { x.abs() }), 2);
/// ```
pub fn max_by_key<T, K: Ord>(v1: T, v2: T, f: fn(&T) -> K) -> T {
    if f(&v2) >= f(&v1) { v2 } else { v1 }
}

/// Returns the element that gives the minimum value from the specified
/// function.
///
/// Returns the first argument if the comparison determines them to be
/// equal.
///
/// # Examples
///
/// ```
/// use std::cmp;
///
/// assert_eq(cmp::min_by_key(-2, 1, |x: &i32| -> i32 { x.abs() }), 1);
/// assert_eq(cmp::min_by_key(-2, 2, |x: &i32| -> i32 { x.abs() }), -2);
/// ```
pub fn min_by_key<T, K: Ord>(v1: T, v2: T, f: fn(&T) -> K) -> T {
    if f(&v2) < f(&v1) { v2 } else { v1 }
}
