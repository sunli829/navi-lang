//! TcpListener, TcpStream and UdpSocket (as Rust's).

use crate::io::{self, Read, Write};
use crate::net::{each_addr, Shutdown, SocketAddr, ToSocketAddrs};
use crate::net::sys::{self, Socket};
use crate::time::Duration;

fn nanos(d: Option<Duration>) -> io::Result<u64> {
    match d {
        None => Ok(0),
        Some(x) => {
            if x.is_zero() { return Err(io::Error::new(io::ErrorKind::InvalidInput, "cannot set a 0 duration timeout")); }
            Ok(x.as_nanos() as u64)
        }
    }
}

fn duration(n: u64) -> Option<Duration> { if n == 0 { None } else { Some(Duration::from_nanos(n)) } }

/// A TCP socket listening for connections.
#[derive(Clone)]
pub struct TcpListener {
    s: &mut Socket,
}

impl TcpListener {
    /// Listens on the first of addr's addresses that works.
    pub fn bind<A: ToSocketAddrs>(addr: A) -> io::Result<TcpListener> {
        each_addr(&addr, |a| {
            let s = sys::new_socket(a, sys::SOCK_STREAM)?;
            if let Err(e) = s.bind(a) {
                s.close();
                return Err(e);
            }
            if let Err(e) = s.listen(128) {
                s.close();
                return Err(e);
            }
            Ok(TcpListener { s })
        })
    }

    pub fn local_addr(&self) -> io::Result<SocketAddr> { self.s.local_addr() }

    /// Waits for a connection.
    pub fn accept(&self) -> io::Result<(TcpStream, SocketAddr)> {
        let (s, a) = self.s.accept()?;
        Ok((TcpStream { s }, a))
    }

    /// The connections, as they come.
    pub fn incoming(&self) -> Incoming { Incoming { l: self.clone() } }

    pub fn set_ttl(&self, ttl: u32) -> io::Result<()> { sys::set_int(self.s.fd, 0, 4, ttl as i32) }

    /// Stops listening (a G waiting in accept gets an error).
    pub fn close(&self) { self.s.close(); }
}

/// TcpListener::incoming.
pub struct Incoming {
    l: TcpListener,
}

impl Iterator for Incoming {
    type Item = io::Result<TcpStream>;
    fn next(&mut self) -> Option<io::Result<TcpStream>> {
        match self.l.accept() {
            Ok((s, _)) => Some(Ok(s)),
            Err(e) => Some(Err(e)),
        }
    }
}

/// A TCP connection.
#[derive(Clone)]
pub struct TcpStream {
    s: &mut Socket,
}

impl TcpStream {
    /// Connects to the first of addr's addresses that accepts.
    pub fn connect<A: ToSocketAddrs>(addr: A) -> io::Result<TcpStream> {
        each_addr(&addr, |a| TcpStream::connect_timeout_nanos(a, 0))
    }

    pub fn connect_timeout(addr: &SocketAddr, timeout: Duration) -> io::Result<TcpStream> {
        TcpStream::connect_timeout_nanos(addr, nanos(Some(timeout))?)
    }

    fn connect_timeout_nanos(a: &SocketAddr, t: u64) -> io::Result<TcpStream> {
        let s = sys::new_socket(a, sys::SOCK_STREAM)?;
        if let Err(e) = s.connect(a, t) {
            s.close();
            return Err(e);
        }
        Ok(TcpStream { s })
    }

    pub fn peer_addr(&self) -> io::Result<SocketAddr> { self.s.peer_addr() }
    pub fn local_addr(&self) -> io::Result<SocketAddr> { self.s.local_addr() }

    pub fn shutdown(&self, how: Shutdown) -> io::Result<()> {
        self.s.shutdown(match how { Shutdown::Read => 0, Shutdown::Write => 1, Shutdown::Both => 2 })
    }

    pub fn set_read_timeout(&self, d: Option<Duration>) -> io::Result<()> {
        self.s.rto = nanos(d)?;
        Ok(())
    }

    pub fn set_write_timeout(&self, d: Option<Duration>) -> io::Result<()> {
        self.s.wto = nanos(d)?;
        Ok(())
    }

    pub fn read_timeout(&self) -> io::Result<Option<Duration>> { Ok(duration(self.s.rto)) }
    pub fn write_timeout(&self) -> io::Result<Option<Duration>> { Ok(duration(self.s.wto)) }

    pub fn set_nodelay(&self, on: bool) -> io::Result<()> { sys::set_int(self.s.fd, sys::IPPROTO_TCP, sys::TCP_NODELAY, if on { 1 } else { 0 }) }
    pub fn nodelay(&self) -> io::Result<bool> { Ok(sys::get_int(self.s.fd, sys::IPPROTO_TCP, sys::TCP_NODELAY)? != 0) }

    /// Another handle to the same connection (it shares the socket and
    /// its timeouts).
    pub fn try_clone(&self) -> io::Result<TcpStream> { Ok(self.clone()) }

    /// Closes the connection (a G waiting on it gets an error).
    pub fn close(&self) { self.s.close(); }
}

impl Read for TcpStream {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> { self.s.read(buf) }
}

impl Write for TcpStream {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> { self.s.write(buf) }
    fn flush(&mut self) -> io::Result<()> { Ok(()) }
}

/// A UDP socket.
#[derive(Clone)]
pub struct UdpSocket {
    s: &mut Socket,
    peer: Option<SocketAddr>,
}

impl UdpSocket {
    pub fn bind<A: ToSocketAddrs>(addr: A) -> io::Result<UdpSocket> {
        each_addr(&addr, |a| {
            let s = sys::new_socket(a, sys::SOCK_DGRAM)?;
            if let Err(e) = s.bind(a) {
                s.close();
                return Err(e);
            }
            Ok(UdpSocket { s, peer: None })
        })
    }

    pub fn recv_from(&self, buf: &mut [u8]) -> io::Result<(usize, SocketAddr)> { self.s.recv_from(buf) }

    pub fn send_to<A: ToSocketAddrs>(&self, buf: &[u8], addr: A) -> io::Result<usize> {
        match addr.to_socket_addrs()?.next() {
            Some(a) => self.s.send_to(buf, &a),
            None => Err(io::Error::new(io::ErrorKind::InvalidInput, "no addresses to send data to")),
        }
    }

    /// Sends to and receives from addr only (send, recv).
    pub fn connect<A: ToSocketAddrs>(&mut self, addr: A) -> io::Result<()> {
        match addr.to_socket_addrs()?.next() {
            Some(a) => {
                self.s.connect(&a, 0)?;
                self.peer = Some(a);
                Ok(())
            }
            None => Err(io::Error::new(io::ErrorKind::InvalidInput, "no addresses to connect to")),
        }
    }

    pub fn send(&self, buf: &[u8]) -> io::Result<usize> { self.s.write(buf) }
    pub fn recv(&self, buf: &mut [u8]) -> io::Result<usize> { self.s.read(buf) }
    pub fn peer_addr(&self) -> io::Result<SocketAddr> { self.s.peer_addr() }
    pub fn local_addr(&self) -> io::Result<SocketAddr> { self.s.local_addr() }

    pub fn set_read_timeout(&self, d: Option<Duration>) -> io::Result<()> {
        self.s.rto = nanos(d)?;
        Ok(())
    }

    pub fn set_write_timeout(&self, d: Option<Duration>) -> io::Result<()> {
        self.s.wto = nanos(d)?;
        Ok(())
    }

    pub fn set_broadcast(&self, on: bool) -> io::Result<()> { sys::set_int(self.s.fd, 0xffff, sys::SO_BROADCAST, if on { 1 } else { 0 }) }

    pub fn close(&self) { self.s.close(); }
}
