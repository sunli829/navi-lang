//! IP and socket addresses (as Rust's std::net).

use crate::fmt::{self, Display, Debug, Formatter};
use crate::str::FromStr;

/// An IPv4 address.
#[derive(Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub struct Ipv4Addr {
    o: [u8; 4],
}

impl Ipv4Addr {
    pub const LOCALHOST: Ipv4Addr = Ipv4Addr { o: [127, 0, 0, 1] };
    pub const UNSPECIFIED: Ipv4Addr = Ipv4Addr { o: [0, 0, 0, 0] };
    pub const BROADCAST: Ipv4Addr = Ipv4Addr { o: [255, 255, 255, 255] };

    pub const fn new(a: u8, b: u8, c: u8, d: u8) -> Ipv4Addr { Ipv4Addr { o: [a, b, c, d] } }
    pub fn octets(&self) -> [u8; 4] { self.o }
    pub fn to_bits(&self) -> u32 { (self.o[0] as u32) << 24 | (self.o[1] as u32) << 16 | (self.o[2] as u32) << 8 | self.o[3] as u32 }
    pub fn from_bits(b: u32) -> Ipv4Addr { Ipv4Addr::new((b >> 24) as u8, (b >> 16) as u8, (b >> 8) as u8, b as u8) }
    pub fn is_unspecified(&self) -> bool { self.to_bits() == 0 }
    pub fn is_loopback(&self) -> bool { self.o[0] == 127 }
    pub fn is_private(&self) -> bool {
        self.o[0] == 10 || (self.o[0] == 172 && self.o[1] >= 16 && self.o[1] <= 31) || (self.o[0] == 192 && self.o[1] == 168)
    }
    pub fn is_link_local(&self) -> bool { self.o[0] == 169 && self.o[1] == 254 }
    pub fn is_multicast(&self) -> bool { self.o[0] >= 224 && self.o[0] <= 239 }
    pub fn is_broadcast(&self) -> bool { self.to_bits() == 0xffffffff }
    /// ::ffff:a.b.c.d
    pub fn to_ipv6_mapped(&self) -> Ipv6Addr {
        Ipv6Addr::new(0, 0, 0, 0, 0, 0xffff, (self.o[0] as u16) << 8 | self.o[1] as u16, (self.o[2] as u16) << 8 | self.o[3] as u16)
    }
}

impl Display for Ipv4Addr {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { f.pad(`${self.o[0]}.${self.o[1]}.${self.o[2]}.${self.o[3]}`.as_str()) }
}

impl Debug for Ipv4Addr {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { Display::fmt(self, f) }
}

/// Why an address did not parse.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct AddrParseError {
    what: &str,
}

impl Display for AddrParseError {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { f.write_fmt(`invalid ${self.what} syntax`) }
}

fn parse_v4(s: &[u8]) -> Option<Ipv4Addr> {
    let mut o = [0u8; 4];
    let mut part = 0;
    let mut i = 0;
    while part < 4 {
        let start = i;
        let mut v = 0u32;
        while i < s.len() && s[i] >= b'0' && s[i] <= b'9' {
            v = v * 10 + (s[i] - b'0') as u32;
            if v > 255 || i - start >= 3 { return None; }
            i += 1;
        }
        if i == start || (i - start > 1 && s[start] == b'0') { return None; }
        o[part] = v as u8;
        part += 1;
        if part < 4 {
            if i >= s.len() || s[i] != b'.' { return None; }
            i += 1;
        }
    }
    if i != s.len() { return None; }
    Some(Ipv4Addr { o })
}

impl FromStr for Ipv4Addr {
    type Err = AddrParseError;
    fn from_str(s: &str) -> Result<Ipv4Addr, AddrParseError> {
        match parse_v4(s.as_bytes()) { Some(a) => Ok(a), None => Err(AddrParseError { what: "IPv4 address" }) }
    }
}

/// An IPv6 address.
#[derive(Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub struct Ipv6Addr {
    s: [u16; 8],
}

impl Ipv6Addr {
    pub const LOCALHOST: Ipv6Addr = Ipv6Addr { s: [0, 0, 0, 0, 0, 0, 0, 1] };
    pub const UNSPECIFIED: Ipv6Addr = Ipv6Addr { s: [0, 0, 0, 0, 0, 0, 0, 0] };

    pub const fn new(a: u16, b: u16, c: u16, d: u16, e: u16, f: u16, g: u16, h: u16) -> Ipv6Addr { Ipv6Addr { s: [a, b, c, d, e, f, g, h] } }
    pub fn segments(&self) -> [u16; 8] { self.s }
    pub fn octets(&self) -> [u8; 16] {
        let mut o = [0u8; 16];
        let mut i = 0;
        while i < 8 {
            o[2 * i] = (self.s[i] >> 8) as u8;
            o[2 * i + 1] = self.s[i] as u8;
            i += 1;
        }
        o
    }
    pub fn from_octets(o: [u8; 16]) -> Ipv6Addr {
        let mut s = [0u16; 8];
        let mut i = 0;
        while i < 8 {
            s[i] = (o[2 * i] as u16) << 8 | o[2 * i + 1] as u16;
            i += 1;
        }
        Ipv6Addr { s }
    }
    pub fn is_unspecified(&self) -> bool { self.s == [0u16; 8] }
    pub fn is_loopback(&self) -> bool { self.s == [0, 0, 0, 0, 0, 0, 0, 1] }
    pub fn is_multicast(&self) -> bool { self.s[0] & 0xff00 == 0xff00 }
    /// a.b.c.d for ::ffff:a.b.c.d.
    pub fn to_ipv4_mapped(&self) -> Option<Ipv4Addr> {
        if self.s[0] == 0 && self.s[1] == 0 && self.s[2] == 0 && self.s[3] == 0 && self.s[4] == 0 && self.s[5] == 0xffff {
            return Some(Ipv4Addr::new((self.s[6] >> 8) as u8, self.s[6] as u8, (self.s[7] >> 8) as u8, self.s[7] as u8));
        }
        None
    }
}

fn hex(v: u16, out: &mut String) {
    let digits = "0123456789abcdef".as_bytes();
    let mut started = false;
    let mut sh = 12;
    loop {
        let d = (v >> sh) & 15;
        if d != 0 || started || sh == 0 {
            out.push(digits[d as usize] as char);
            started = true;
        }
        if sh == 0 { break; }
        sh -= 4;
    }
}

impl Display for Ipv6Addr {
    // RFC 5952: the longest run of two or more zero groups is "::".
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        if let Some(v4) = self.to_ipv4_mapped() { return f.pad(`::ffff:${v4}`.as_str()); }
        let mut best = 0;
        let mut best_len = 0;
        let mut i = 0;
        while i < 8 {
            if self.s[i] == 0 {
                let mut j = i;
                while j < 8 && self.s[j] == 0 { j += 1; }
                if j - i > best_len {
                    best = i;
                    best_len = j - i;
                }
                i = j;
            } else {
                i += 1;
            }
        }
        let mut out = String::new();
        i = 0;
        while i < 8 {
            if best_len >= 2 && i == best {
                out.push_str("::");
                i += best_len;
                continue;
            }
            if i > 0 && !(best_len >= 2 && i == best + best_len) { out.push(':'); }
            hex(self.s[i], &mut out);
            i += 1;
        }
        f.pad(out.as_str())
    }
}

impl Debug for Ipv6Addr {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { Display::fmt(self, f) }
}

fn hexval(c: u8) -> Option<u16> {
    if c >= b'0' && c <= b'9' { return Some((c - b'0') as u16); }
    if c >= b'a' && c <= b'f' { return Some((c - b'a' + 10) as u16); }
    if c >= b'A' && c <= b'F' { return Some((c - b'A' + 10) as u16); }
    None
}

// Groups separated by ':' (an IPv4 tail counts as two); None if invalid.
fn parse_groups(s: &[u8], out: &mut Vec<u16>) -> bool {
    if s.len() == 0 { return true; }
    let mut i = 0;
    loop {
        let start = i;
        let mut v = 0u16;
        while i < s.len() && i - start < 4 {
            match hexval(s[i]) {
                Some(d) => { v = v * 16 + d; }
                None => break,
            }
            i += 1;
        }
        if i < s.len() && s[i] == b'.' {
            // a.b.c.d
            match parse_v4(&s[start..s.len()]) {
                Some(a) => {
                    let o = a.octets();
                    out.push((o[0] as u16) << 8 | o[1] as u16);
                    out.push((o[2] as u16) << 8 | o[3] as u16);
                    return true;
                }
                None => return false,
            }
        }
        if i == start { return false; }
        out.push(v);
        if i == s.len() { return true; }
        if s[i] != b':' { return false; }
        i += 1;
    }
}

fn parse_v6(s: &[u8]) -> Option<Ipv6Addr> {
    let mut gap = s.len();
    let mut i = 0;
    while i + 1 < s.len() {
        if s[i] == b':' && s[i + 1] == b':' {
            gap = i;
            break;
        }
        i += 1;
    }
    let mut head: Vec<u16> = Vec::new();
    let mut tail: Vec<u16> = Vec::new();
    if gap == s.len() {
        if !parse_groups(s, &mut head) || head.len() != 8 { return None; }
    } else {
        if !parse_groups(&s[0..gap], &mut head) || !parse_groups(&s[gap + 2..s.len()], &mut tail) { return None; }
        if head.len() + tail.len() > 7 { return None; }
    }
    let mut segs = [0u16; 8];
    i = 0;
    while i < head.len() {
        segs[i] = head[i];
        i += 1;
    }
    i = 0;
    while i < tail.len() {
        segs[8 - tail.len() + i] = tail[i];
        i += 1;
    }
    Some(Ipv6Addr { s: segs })
}

impl FromStr for Ipv6Addr {
    type Err = AddrParseError;
    fn from_str(s: &str) -> Result<Ipv6Addr, AddrParseError> {
        match parse_v6(s.as_bytes()) { Some(a) => Ok(a), None => Err(AddrParseError { what: "IPv6 address" }) }
    }
}

/// An IPv4 or IPv6 address.
#[derive(Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub enum IpAddr {
    V4(Ipv4Addr),
    V6(Ipv6Addr),
}

impl IpAddr {
    pub fn is_ipv4(&self) -> bool { match self { IpAddr::V4(_) => true, _ => false } }
    pub fn is_ipv6(&self) -> bool { !self.is_ipv4() }
    pub fn is_loopback(&self) -> bool { match self { IpAddr::V4(a) => a.is_loopback(), IpAddr::V6(a) => a.is_loopback() } }
    pub fn is_unspecified(&self) -> bool { match self { IpAddr::V4(a) => a.is_unspecified(), IpAddr::V6(a) => a.is_unspecified() } }
    pub fn is_multicast(&self) -> bool { match self { IpAddr::V4(a) => a.is_multicast(), IpAddr::V6(a) => a.is_multicast() } }
}

impl Display for IpAddr {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { match self { IpAddr::V4(a) => Display::fmt(a, f), IpAddr::V6(a) => Display::fmt(a, f) } }
}

impl Debug for IpAddr {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { Display::fmt(self, f) }
}

impl FromStr for IpAddr {
    type Err = AddrParseError;
    fn from_str(s: &str) -> Result<IpAddr, AddrParseError> {
        if let Some(a) = parse_v4(s.as_bytes()) { return Ok(IpAddr::V4(a)); }
        match parse_v6(s.as_bytes()) { Some(a) => Ok(IpAddr::V6(a)), None => Err(AddrParseError { what: "IP address" }) }
    }
}

impl From<Ipv4Addr> for IpAddr {
    fn from(a: Ipv4Addr) -> IpAddr { IpAddr::V4(a) }
}

impl From<Ipv6Addr> for IpAddr {
    fn from(a: Ipv6Addr) -> IpAddr { IpAddr::V6(a) }
}

/// An IPv4 address and a port.
#[derive(Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub struct SocketAddrV4 {
    ip: Ipv4Addr,
    port: u16,
}

impl SocketAddrV4 {
    pub fn new(ip: Ipv4Addr, port: u16) -> SocketAddrV4 { SocketAddrV4 { ip, port } }
    pub fn ip(&self) -> &Ipv4Addr { &self.ip }
    pub fn port(&self) -> u16 { self.port }
    pub fn set_port(&mut self, p: u16) { self.port = p; }
}

impl Display for SocketAddrV4 {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { f.pad(`${self.ip}:${self.port}`.as_str()) }
}

impl Debug for SocketAddrV4 {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { Display::fmt(self, f) }
}

/// An IPv6 address, a port, a flow label and a scope.
#[derive(Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub struct SocketAddrV6 {
    ip: Ipv6Addr,
    port: u16,
    flowinfo: u32,
    scope_id: u32,
}

impl SocketAddrV6 {
    pub fn new(ip: Ipv6Addr, port: u16, flowinfo: u32, scope_id: u32) -> SocketAddrV6 { SocketAddrV6 { ip, port, flowinfo, scope_id } }
    pub fn ip(&self) -> &Ipv6Addr { &self.ip }
    pub fn port(&self) -> u16 { self.port }
    pub fn set_port(&mut self, p: u16) { self.port = p; }
    pub fn flowinfo(&self) -> u32 { self.flowinfo }
    pub fn scope_id(&self) -> u32 { self.scope_id }
}

impl Display for SocketAddrV6 {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        if self.scope_id != 0 { return f.pad(`[${self.ip}%${self.scope_id}]:${self.port}`.as_str()); }
        f.pad(`[${self.ip}]:${self.port}`.as_str())
    }
}

impl Debug for SocketAddrV6 {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { Display::fmt(self, f) }
}

/// A socket address: IPv4 or IPv6.
#[derive(Clone, PartialEq, Eq, Hash, PartialOrd, Ord)]
pub enum SocketAddr {
    V4(SocketAddrV4),
    V6(SocketAddrV6),
}

impl SocketAddr {
    pub fn new(ip: IpAddr, port: u16) -> SocketAddr {
        match ip {
            IpAddr::V4(a) => SocketAddr::V4(SocketAddrV4::new(a, port)),
            IpAddr::V6(a) => SocketAddr::V6(SocketAddrV6::new(a, port, 0, 0)),
        }
    }
    pub fn ip(&self) -> IpAddr {
        match self { SocketAddr::V4(a) => IpAddr::V4(a.ip.clone()), SocketAddr::V6(a) => IpAddr::V6(a.ip.clone()) }
    }
    pub fn port(&self) -> u16 { match self { SocketAddr::V4(a) => a.port, SocketAddr::V6(a) => a.port } }
    pub fn set_port(&mut self, p: u16) {
        match self { SocketAddr::V4(a) => a.port = p, SocketAddr::V6(a) => a.port = p }
    }
    pub fn is_ipv4(&self) -> bool { match self { SocketAddr::V4(_) => true, _ => false } }
    pub fn is_ipv6(&self) -> bool { !self.is_ipv4() }
}

impl Display for SocketAddr {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { match self { SocketAddr::V4(a) => Display::fmt(a, f), SocketAddr::V6(a) => Display::fmt(a, f) } }
}

impl Debug for SocketAddr {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { Display::fmt(self, f) }
}

fn parse_port(s: &[u8]) -> Option<u16> {
    if s.len() == 0 || s.len() > 5 { return None; }
    let mut v = 0u32;
    for c in s.iter() {
        if *c < b'0' || *c > b'9' { return None; }
        v = v * 10 + (*c - b'0') as u32;
    }
    if v > 65535 { None } else { Some(v as u16) }
}

pub(crate) fn parse_socket_addr(s: &str) -> Option<SocketAddr> {
    let b = s.as_bytes();
    if b.len() > 0 && b[0] == b'[' {
        let mut close = 0;
        while close < b.len() && b[close] != b']' { close += 1; }
        if close + 1 >= b.len() || b[close + 1] != b':' { return None; }
        let inner = &b[1..close];
        let mut pct = inner.len();
        let mut i = 0;
        while i < inner.len() {
            if inner[i] == b'%' {
                pct = i;
                break;
            }
            i += 1;
        }
        let ip = parse_v6(&inner[0..pct])?;
        let scope = if pct < inner.len() { parse_port(&inner[pct + 1..inner.len()])? as u32 } else { 0 };
        let port = parse_port(&b[close + 2..b.len()])?;
        return Some(SocketAddr::V6(SocketAddrV6::new(ip, port, 0, scope)));
    }
    let mut colon = b.len();
    let mut i = b.len();
    while i > 0 {
        i -= 1;
        if b[i] == b':' {
            colon = i;
            break;
        }
    }
    if colon == b.len() { return None; }
    let ip = parse_v4(&b[0..colon])?;
    let port = parse_port(&b[colon + 1..b.len()])?;
    Some(SocketAddr::V4(SocketAddrV4::new(ip, port)))
}

impl FromStr for SocketAddr {
    type Err = AddrParseError;
    fn from_str(s: &str) -> Result<SocketAddr, AddrParseError> {
        match parse_socket_addr(s) { Some(a) => Ok(a), None => Err(AddrParseError { what: "socket address" }) }
    }
}

impl FromStr for SocketAddrV4 {
    type Err = AddrParseError;
    fn from_str(s: &str) -> Result<SocketAddrV4, AddrParseError> {
        match parse_socket_addr(s) { Some(SocketAddr::V4(a)) => Ok(a), _ => Err(AddrParseError { what: "IPv4 socket address" }) }
    }
}

impl FromStr for SocketAddrV6 {
    type Err = AddrParseError;
    fn from_str(s: &str) -> Result<SocketAddrV6, AddrParseError> {
        match parse_socket_addr(s) { Some(SocketAddr::V6(a)) => Ok(a), _ => Err(AddrParseError { what: "IPv6 socket address" }) }
    }
}

impl From<SocketAddrV4> for SocketAddr {
    fn from(a: SocketAddrV4) -> SocketAddr { SocketAddr::V4(a) }
}

impl From<SocketAddrV6> for SocketAddr {
    fn from(a: SocketAddrV6) -> SocketAddr { SocketAddr::V6(a) }
}
