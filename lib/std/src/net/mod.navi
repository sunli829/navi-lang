//! Networking primitives for TCP/UDP communication.
//!
//! This module provides networking functionality for the Transmission Control
//! and User Datagram Protocols, as well as types for IP and socket addresses.
//!
//! # Organization
//!
//! * [`TcpListener`] and [`TcpStream`] provide functionality for communication
//!   over TCP
//! * [`UdpSocket`] provides functionality for communication over UDP
//! * [`IpAddr`] represents IP addresses of either IPv4 or IPv6; [`Ipv4Addr`]
//!   and [`Ipv6Addr`] are respectively IPv4 and IPv6 addresses
//! * [`SocketAddr`] represents socket addresses of either IPv4 or IPv6;
//!   [`SocketAddrV4`] and [`SocketAddrV6`] are respectively IPv4 and IPv6
//!   socket addresses
//! * [`ToSocketAddrs`] is a trait used for generic address resolution when
//!   interacting with networking objects like [`TcpListener`], [`TcpStream`] or
//!   [`UdpSocket`]
//! * Other types are return or parameter types for various methods in this
//!   module
//!
//! # Differences from Rust
//!
//! Sockets are non-blocking underneath: a blocking operation parks only the
//! green thread, and the runtime's network poller (kqueue on macOS, epoll on
//! Linux; on Windows the completion of an overlapped operation) wakes it, as
//! in Go. Without Drop, sockets are closed with `close()`
//! ([`TcpListener::close`], [`TcpStream::close`], [`UdpSocket::close`]);
//! copies of a socket (and [`TcpStream::try_clone`]) share it, and closing any
//! copy closes it for all. A timeout gives [`ErrorKind::TimedOut`] (Rust gives
//! `WouldBlock` on Unix). See spec/std-diff.md.
//!
//! # Examples
//!
//! ```
//! use std::{
//!     io::{Read, Write},
//!     net::{Shutdown, TcpListener, TcpStream},
//!     thread,
//! };
//!
//! fn main() -> std::io::Result<()> {
//!     // A server echoing one connection, on a port the OS picks.
//!     let listener = TcpListener::bind("127.0.0.1:0")?;
//!     let addr = listener.local_addr()?;
//!     let server = thread::spawn(|| {
//!         let (mut stream, _) = listener.accept().unwrap();
//!         let mut data = Vec::new();
//!         stream.read_to_end(&mut data).unwrap();
//!         stream.write_all(&data).unwrap();
//!         stream.close();
//!     });
//!
//!     let mut stream = TcpStream::connect(addr)?;
//!     stream.write_all(b"ping")?;
//!     stream.shutdown(Shutdown::Write)?;
//!     let mut reply = String::new();
//!     stream.read_to_string(&mut reply)?;
//!     stream.close();
//!     server.join().unwrap();
//!     listener.close();
//!     assert_eq(reply, "ping");
//!     Ok(())
//! }
//! ```
//!
//! [`ErrorKind::TimedOut`]: crate::io::ErrorKind::TimedOut

pub mod ip;
pub use ip::{AddrParseError, IpAddr, Ipv4Addr, Ipv6Addr, SocketAddr, SocketAddrV4, SocketAddrV6};

mod sys;
mod tcp;
pub use tcp::{Incoming, TcpListener, TcpStream, UdpSocket};

use crate::io;

/// Possible values which can be passed to the [`TcpStream::shutdown`] method.
///
/// # Examples
///
/// ```
/// use std::net::Shutdown;
///
/// let how = Shutdown::Write;
/// assert_eq(how, Shutdown::Write);
/// assert_ne(how, Shutdown::Both);
/// ```
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum Shutdown {
    /// The reading portion of the [`TcpStream`] should be shut down.
    ///
    /// All currently blocked and future [reads] will return `Ok(0)`.
    ///
    /// [reads]: crate::io::Read
    Read,
    /// The writing portion of the [`TcpStream`] should be shut down.
    ///
    /// All currently blocked and future [writes] will return an error; the peer
    /// reads the end of the stream.
    ///
    /// [writes]: crate::io::Write
    Write,
    /// Both the reading and the writing portions of the [`TcpStream`] should be
    /// shut down.
    ///
    /// See [`Shutdown::Read`] and [`Shutdown::Write`] for more information.
    Both,
}

/// A trait for objects which can be converted or resolved to one or more
/// [`SocketAddr`] values.
///
/// This trait is used for generic address resolution when constructing
/// network objects. By default it is implemented for the following types:
///
/// * [`SocketAddr`]: [`to_socket_addrs`] is the identity function.
///
/// * [`SocketAddrV4`], [`SocketAddrV6`], `(IpAddr, u16)`, `(Ipv4Addr, u16)`:
///   [`to_socket_addrs`] constructs a [`SocketAddr`] trivially.
///
/// * `(&str, u16)` and `(String, u16)`: the string should be either a string
///   representation of an [`IpAddr`] address as expected by [`FromStr`]
///   implementation or a host name. [`u16`] is the port number.
///
/// * `&str` and [`String`]: the string should be either a string representation
///   of a [`SocketAddr`] as expected by its [`FromStr`] implementation or a
///   string like `<host_name>:<port>` pair where `<port>` is a [`u16`] value.
///
/// A host name is resolved with the C library's `getaddrinfo`, a blocking call
/// (it blocks the OS thread running the green thread).
///
/// This trait allows constructing network objects like [`TcpStream`] or
/// [`UdpSocket`] easily with values of various types for the bind/connection
/// address. It is needed because sometimes one type is more appropriate than
/// the other: for simple uses a string like `"localhost:12345"` is much nicer
/// than manual construction of the corresponding [`SocketAddr`], but sometimes
/// [`SocketAddr`] value is *the* main source of the address, and converting
/// it to some other type (e.g., a string) just for it to be converted back to
/// [`SocketAddr`] in constructor methods is pointless.
///
/// Addresses returned by the operating system that are not IP addresses (for
/// example, Unix domain socket addresses) are silently ignored.
///
/// # Examples
///
/// Creating a [`SocketAddr`] iterator that yields one item:
///
/// ```
/// use std::net::{SocketAddr, ToSocketAddrs};
///
/// let addr: SocketAddr = "127.0.0.1:443".parse().unwrap();
/// let mut addrs_iter = addr.to_socket_addrs().unwrap();
///
/// assert_eq(addrs_iter.next(), Some(addr));
/// assert(addrs_iter.next().is_none());
/// ```
///
/// Creating a [`SocketAddr`] iterator from a hostname:
///
/// ```
/// use std::net::{SocketAddr, ToSocketAddrs};
///
/// // assuming 'localhost' resolves to 127.0.0.1 (and maybe ::1)
/// let addrs: Vec<SocketAddr> = "localhost:443".to_socket_addrs().unwrap().collect();
/// assert(
///     addrs
///         .iter()
///         .all(|a| a.ip().is_loopback() && a.port() == 443),
/// );
/// assert(!addrs.is_empty());
///
/// // A port that is not a number, or no port at all, is an error.
/// assert("localhost:http".to_socket_addrs().is_err());
/// assert("localhost".to_socket_addrs().is_err());
/// ```
///
/// Creating a [`TcpStream`] with a string, connecting to the first address
/// that accepts:
///
/// ```no_run
/// use std::net::TcpStream;
///
/// let stream = TcpStream::connect("www.example.com:80");
/// assert(stream.is_ok());
/// ```
///
/// [`FromStr`]: crate::str::FromStr
/// [`to_socket_addrs`]: ToSocketAddrs::to_socket_addrs
pub trait ToSocketAddrs {
    /// Converts this object to an iterator of resolved [`SocketAddr`]s.
    ///
    /// The returned iterator might not actually yield any values depending on
    /// the outcome of any resolution performed.
    ///
    /// Note that this function may block the current thread while resolution is
    /// performed. Unlike Rust's `Self::Iter`, the iterator is a
    /// [`vec::IntoIter`](crate::vec::IntoIter).
    ///
    /// # Errors
    ///
    /// Returns an error of kind
    /// [`InvalidInput`](crate::io::ErrorKind::InvalidInput) for a string that
    /// is neither a socket address nor `<host>:<port>`, or the resolver's error
    /// for a host name that does not resolve.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::net::{Ipv4Addr, ToSocketAddrs};
    ///
    /// let addr = (Ipv4Addr::new(10, 0, 0, 1), 8080)
    ///     .to_socket_addrs()
    ///     .unwrap()
    ///     .next()
    ///     .unwrap();
    /// assert_eq(addr.to_string(), "10.0.0.1:8080");
    /// assert("10.0.0.1".to_socket_addrs().is_err()); // no port
    /// ```
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>>;
}

impl ToSocketAddrs for SocketAddr {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        let mut v = Vec::new();
        v.push(self.clone());
        Ok(v.into_iter())
    }
}

impl ToSocketAddrs for SocketAddrV4 {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        SocketAddr::V4(self.clone()).to_socket_addrs()
    }
}

impl ToSocketAddrs for SocketAddrV6 {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        SocketAddr::V6(self.clone()).to_socket_addrs()
    }
}

impl ToSocketAddrs for (IpAddr, u16) {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        SocketAddr::new(self.0.clone(), self.1).to_socket_addrs()
    }
}

impl ToSocketAddrs for (Ipv4Addr, u16) {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        SocketAddr::new(IpAddr::V4(self.0.clone()), self.1).to_socket_addrs()
    }
}

impl ToSocketAddrs for (&str, u16) {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        host_port(self.0, self.1)
    }
}

impl ToSocketAddrs for (String, u16) {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        host_port(self.0.as_str(), self.1)
    }
}

impl ToSocketAddrs for (Ipv6Addr, u16) {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        SocketAddr::new(IpAddr::V6(self.0.clone()), self.1).to_socket_addrs()
    }
}

impl ToSocketAddrs for [SocketAddr] {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        Ok(self.to_vec().into_iter())
    }
}

impl ToSocketAddrs for str {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        str_addrs(self)
    }
}

impl<T: ToSocketAddrs> ToSocketAddrs for &T {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        (**self).to_socket_addrs()
    }
}

impl ToSocketAddrs for String {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        str_addrs(self.as_str())
    }
}

fn host_port(host: &str, port: u16) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
    if let Ok(ip) = host.parse::<IpAddr>() {
        return SocketAddr::new(ip, port).to_socket_addrs();
    }
    lookup(host, port)
}

fn lookup(host: &str, port: u16) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
    Ok(sys::resolve(host, port)?.into_iter())
}

// "a.b.c.d:p", "[v6]:p" or "host:p".
fn str_addrs(s: &str) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
    if let Some(a) = ip::parse_socket_addr(s) {
        return a.to_socket_addrs();
    }
    match s.rsplit_once(':') {
        Some((h, p)) => match p.parse::<u16>() {
            Ok(port) => host_port(h, port),
            Err(_) => Err(io::Error::new(
                io::ErrorKind::InvalidInput,
                "invalid port value",
            )),
        },
        None => Err(io::Error::new(
            io::ErrorKind::InvalidInput,
            "invalid socket address",
        )),
    }
}

// The first address that works, or the last error.
pub(crate) fn each_addr<A: ToSocketAddrs, T>(
    addrs: &A,
    f: fn(&SocketAddr) -> io::Result<T>,
) -> io::Result<T> {
    let mut last: Option<io::Error> = None;
    for a in addrs.to_socket_addrs()? {
        match f(&a) {
            Ok(t) => return Ok(t),
            Err(e) => last = Some(e),
        }
    }
    Err(match last {
        Some(e) => e,
        None => io::Error::new(
            io::ErrorKind::InvalidInput,
            "could not resolve to any addresses",
        ),
    })
}
