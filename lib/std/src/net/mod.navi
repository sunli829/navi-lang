//! Networking (as Rust's std::net): IP and socket addresses, TCP and UDP.
//! Sockets are non-blocking underneath: a blocking operation parks only
//! the green thread (the runtime's network poller wakes it; on Windows the
//! completion of an overlapped operation does). Without Drop,
//! sockets are closed with close() (see spec/std-diff.md).

pub mod ip;
pub use ip::{AddrParseError, IpAddr, Ipv4Addr, Ipv6Addr, SocketAddr, SocketAddrV4, SocketAddrV6};

mod sys;
mod tcp;
pub use tcp::{Incoming, TcpListener, TcpStream, UdpSocket};

use crate::io;

/// How a TCP connection is shut down.
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum Shutdown {
    Read,
    Write,
    Both,
}

/// What names one or more socket addresses (as Rust's; a host name is
/// resolved).
pub trait ToSocketAddrs {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>>;
}

impl ToSocketAddrs for SocketAddr {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        let mut v = Vec::new();
        v.push(self.clone());
        Ok(v.into_iter())
    }
}

impl ToSocketAddrs for SocketAddrV4 {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        SocketAddr::V4(self.clone()).to_socket_addrs()
    }
}

impl ToSocketAddrs for SocketAddrV6 {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        SocketAddr::V6(self.clone()).to_socket_addrs()
    }
}

impl ToSocketAddrs for (IpAddr, u16) {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        SocketAddr::new(self.0.clone(), self.1).to_socket_addrs()
    }
}

impl ToSocketAddrs for (Ipv4Addr, u16) {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        SocketAddr::new(IpAddr::V4(self.0.clone()), self.1).to_socket_addrs()
    }
}

impl ToSocketAddrs for (&str, u16) {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        host_port(self.0, self.1)
    }
}

impl ToSocketAddrs for (String, u16) {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        host_port(self.0.as_str(), self.1)
    }
}

impl ToSocketAddrs for &str {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        str_addrs(*self)
    }
}

impl ToSocketAddrs for String {
    fn to_socket_addrs(&self) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
        str_addrs(self.as_str())
    }
}

fn host_port(host: &str, port: u16) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
    if let Ok(ip) = host.parse::<IpAddr>() {
        return SocketAddr::new(ip, port).to_socket_addrs();
    }
    lookup(host, port)
}

fn lookup(host: &str, port: u16) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
    Ok(sys::resolve(host, port)?.into_iter())
}

// "a.b.c.d:p", "[v6]:p" or "host:p".
fn str_addrs(s: &str) -> io::Result<crate::vec::IntoIter<SocketAddr>> {
    if let Some(a) = ip::parse_socket_addr(s) {
        return a.to_socket_addrs();
    }
    match s.rsplit_once(':') {
        Some((h, p)) => match p.parse::<u16>() {
            Ok(port) => host_port(h, port),
            Err(_) => Err(io::Error::new(
                io::ErrorKind::InvalidInput,
                "invalid port value",
            )),
        },
        None => Err(io::Error::new(
            io::ErrorKind::InvalidInput,
            "invalid socket address",
        )),
    }
}

// The first address that works, or the last error.
pub(crate) fn each_addr<A: ToSocketAddrs, T>(
    addrs: &A,
    f: fn(&SocketAddr) -> io::Result<T>,
) -> io::Result<T> {
    let mut last: Option<io::Error> = None;
    for a in addrs.to_socket_addrs()? {
        match f(&a) {
            Ok(t) => return Ok(t),
            Err(e) => last = Some(e),
        }
    }
    Err(match last {
        Some(e) => e,
        None => io::Error::new(
            io::ErrorKind::InvalidInput,
            "could not resolve to any addresses",
        ),
    })
}
