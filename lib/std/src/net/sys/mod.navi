//! The sockets of std::net: each platform module provides the same Socket
//! and functions.

#[cfg(not(any(target_os = "windows", target_os = "js")))]
mod unix;
#[cfg(not(any(target_os = "windows", target_os = "js")))]
pub use self::unix::*;
#[cfg(target_os = "js")]
mod js;
#[cfg(target_os = "js")]
pub use self::js::*;
#[cfg(target_os = "windows")]
mod windows;
#[cfg(target_os = "windows")]
pub use self::windows::*;
