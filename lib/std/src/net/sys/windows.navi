//! Sockets over Winsock (ws2_32.dll): blocking sockets, as Rust's std on
//! Windows. A call that waits (accept, connect, recv, send, select,
//! getaddrinfo) counts its G as blocked: the scheduler lets another M run
//! the other Gs meanwhile (as for any blocking C call), so there is no
//! poller. Timeouts are SO_RCVTIMEO and SO_SNDTIMEO; a connect with a
//! timeout waits in select.
//!
//! WSAGetLastError is per OS thread: it is read right after the failed
//! call (the G stays on its M through a blocking call).

use crate::io;
use crate::net::ip::{Ipv4Addr, Ipv6Addr, SocketAddr, SocketAddrV4, SocketAddrV6};

#[link(name = "ws2_32")]
#[nonblocking]
extern "C" {
    fn WSAStartup(version: u16, data: *mut u8) -> i32;
    fn WSAGetLastError() -> i32;
    fn socket(af: i32, ty: i32, proto: i32) -> usize;
    fn bind(s: usize, addr: *const u8, len: i32) -> i32;
    fn listen(s: usize, backlog: i32) -> i32;
    fn getsockname(s: usize, addr: *mut u8, len: *mut i32) -> i32;
    fn getpeername(s: usize, addr: *mut u8, len: *mut i32) -> i32;
    fn shutdown(s: usize, how: i32) -> i32;
    fn closesocket(s: usize) -> i32;
    fn setsockopt(s: usize, level: i32, name: i32, val: *const u8, len: i32) -> i32;
    fn getsockopt(s: usize, level: i32, name: i32, val: *mut u8, len: *mut i32) -> i32;
    fn ioctlsocket(s: usize, cmd: i32, arg: *mut u32) -> i32;
    fn freeaddrinfo(res: usize);
}
// These wait.
#[link(name = "ws2_32")]
extern "C" {
    fn accept(s: usize, addr: *mut u8, len: *mut i32) -> usize;
    fn connect(s: usize, addr: *const u8, len: i32) -> i32;
    fn recv(s: usize, buf: *mut u8, n: i32, flags: i32) -> i32;
    fn send(s: usize, buf: *const u8, n: i32, flags: i32) -> i32;
    fn recvfrom(s: usize, buf: *mut u8, n: i32, flags: i32, addr: *mut u8, len: *mut i32) -> i32;
    fn sendto(s: usize, buf: *const u8, n: i32, flags: i32, addr: *const u8, len: i32) -> i32;
    #[link_name = "select"] fn ws_select(nfds: i32, r: *mut u8, w: *mut u8, e: *mut u8, tv: *const u8) -> i32;
    fn getaddrinfo(node: *const u8, service: *const u8, hints: *const u8, res: *mut usize) -> i32;
}

pub const SOCK_STREAM: i32 = 1;
pub const SOCK_DGRAM: i32 = 2;
const AF_INET: i32 = 2;
const AF_INET6: i32 = 23;
const SOL_SOCKET: i32 = 0xffff;
const SO_ERROR: i32 = 0x1007;
const SO_SNDTIMEO: i32 = 0x1005;
const SO_RCVTIMEO: i32 = 0x1006;
pub const SO_BROADCAST: i32 = 0x20;
pub const IPPROTO_TCP: i32 = 6;
pub const TCP_NODELAY: i32 = 1;
const FIONBIO: i32 = -2147195266; // 0x8004667e
const INVALID_SOCKET: usize = 18446744073709551615;
const WSAEWOULDBLOCK: i32 = 10035;

static mut STARTED: usize = 0;

// Winsock 2.2, once (WSAStartup counts its calls: two racing ones are fine).
fn startup() {
    if crate::rt::atomic_load(unsafe { &STARTED } as *const usize as *mut usize) != 0 { return; }
    let mut data = [0u8; 512]; // WSADATA (408 bytes on 64-bit Windows)
    let rc = unsafe { WSAStartup(0x0202, &mut data as *mut [u8; 512] as *mut u8) };
    if rc != 0 { crate::rt::native::fatal("WSAStartup failed"); }
    crate::rt::atomic_store(unsafe { &STARTED } as *const usize as *mut usize, 1);
}

/// The io::Error of a Winsock error number.
pub fn os_error(e: i32) -> io::Error { io::Error::from_raw_os_error(e) }

pub fn last_error() -> io::Error { os_error(unsafe { WSAGetLastError() }) }

fn closed() -> io::Error { io::Error::new(io::ErrorKind::NotConnected, "socket closed") }
fn timed_out() -> io::Error { io::Error::new(io::ErrorKind::TimedOut, "operation timed out") }

/// A socket and its timeouts (shared by the copies of a TcpStream etc.).
/// fd is the SOCKET (handles fit in 32 bits).
pub struct Socket {
    pub fd: i32,
    /// Read and write timeouts in nanoseconds (0: none).
    pub rto: u64,
    pub wto: u64,
    // 1 once closed (set by one close only).
    closed: usize,
}

/// A new socket for addresses like a.
pub fn new_socket(a: &SocketAddr, ty: i32) -> io::Result<&mut Socket> {
    startup();
    let fam = if a.is_ipv4() { AF_INET } else { AF_INET6 };
    let s = unsafe { socket(fam, ty, 0) };
    if s == INVALID_SOCKET { return Err(last_error()); }
    Ok(wrap(s))
}

fn wrap(s: usize) -> &mut Socket { &mut Socket { fd: s as i32, rto: 0, wto: 0, closed: 0 } }

fn h(fd: i32) -> usize { fd as u32 as usize }

pub fn set_int(fd: i32, level: i32, name: i32, v: i32) -> io::Result<()> {
    let x = v;
    if unsafe { setsockopt(h(fd), level, name, &x as *const i32 as *const u8, 4) } != 0 { return Err(last_error()); }
    Ok(())
}

pub fn get_int(fd: i32, level: i32, name: i32) -> io::Result<i32> {
    let mut x = 0i32;
    let mut n = 4i32;
    if unsafe { getsockopt(h(fd), level, name, &mut x as *mut i32 as *mut u8, &mut n as *mut i32) } != 0 { return Err(last_error()); }
    Ok(x)
}

// struct sockaddr_in / sockaddr_in6: a 16-bit family, then as everywhere.
/// The C encoding of a (and its length).
pub fn encode(a: &SocketAddr) -> ([u8; 28], i32) {
    let mut b = [0u8; 28];
    match a {
        SocketAddr::V4(v) => {
            b[0] = AF_INET as u8;
            b[2] = (v.port() >> 8) as u8;
            b[3] = v.port() as u8;
            let o = v.ip().octets();
            b[4] = o[0];
            b[5] = o[1];
            b[6] = o[2];
            b[7] = o[3];
            (b, 16)
        }
        SocketAddr::V6(v) => {
            b[0] = AF_INET6 as u8;
            b[2] = (v.port() >> 8) as u8;
            b[3] = v.port() as u8;
            let fl = v.flowinfo();
            b[4] = (fl >> 24) as u8;
            b[5] = (fl >> 16) as u8;
            b[6] = (fl >> 8) as u8;
            b[7] = fl as u8;
            let o = v.ip().octets();
            let mut i = 0;
            while i < 16 {
                b[8 + i] = o[i];
                i += 1;
            }
            let sc = v.scope_id();
            b[24] = sc as u8;
            b[25] = (sc >> 8) as u8;
            b[26] = (sc >> 16) as u8;
            b[27] = (sc >> 24) as u8;
            (b, 28)
        }
    }
}

pub fn decode(b: &[u8; 28]) -> SocketAddr {
    let port = (b[2] as u16) << 8 | b[3] as u16;
    if (b[0] as i32 | (b[1] as i32) << 8) == AF_INET {
        return SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::new(b[4], b[5], b[6], b[7]), port));
    }
    let mut o = [0u8; 16];
    let mut i = 0;
    while i < 16 {
        o[i] = b[8 + i];
        i += 1;
    }
    let fl = (b[4] as u32) << 24 | (b[5] as u32) << 16 | (b[6] as u32) << 8 | b[7] as u32;
    let sc = b[24] as u32 | (b[25] as u32) << 8 | (b[26] as u32) << 16 | (b[27] as u32) << 24;
    SocketAddr::V6(SocketAddrV6::new(Ipv6Addr::from_octets(o), port, fl, sc))
}

// A buffer length as Winsock takes it.
fn clamp(n: usize) -> i32 { if n > 0x7fffffff { 0x7fffffff } else { n as i32 } }

// SO_RCVTIMEO / SO_SNDTIMEO: milliseconds (0: none).
fn millis(ns: u64) -> i32 {
    if ns == 0 { return 0; }
    let ms = (ns + 999999) / 1000000;
    if ms > 0x7fffffff { 0x7fffffff } else { ms as i32 }
}

impl Socket {
    // The error of a failed call: a socket closed meanwhile (closesocket
    // ends a wait in it) reads as closed.
    fn fail(&self) -> io::Error {
        let e = unsafe { WSAGetLastError() };
        if self.is_closed() { return closed(); }
        os_error(e)
    }

    pub fn bind(&self, a: &SocketAddr) -> io::Result<()> {
        // No SO_REUSEADDR: on Windows it lets another socket take the port.
        let (b, n) = encode(a);
        if unsafe { bind(h(self.fd), &b as *const [u8; 28] as *const u8, n) } != 0 { return Err(last_error()); }
        Ok(())
    }

    pub fn listen(&self, backlog: i32) -> io::Result<()> {
        if unsafe { listen(h(self.fd), backlog) } != 0 { return Err(last_error()); }
        Ok(())
    }

    pub fn accept(&self) -> io::Result<(&mut Socket, SocketAddr)> {
        if self.is_closed() { return Err(closed()); }
        let mut b = [0u8; 28];
        let mut n = 28i32;
        let s = unsafe { accept(h(self.fd), &mut b as *mut [u8; 28] as *mut u8, &mut n as *mut i32) };
        if s == INVALID_SOCKET { return Err(self.fail()); }
        Ok((wrap(s), decode(&b)))
    }

    pub fn connect(&self, a: &SocketAddr, timeout: u64) -> io::Result<()> {
        let (b, n) = encode(a);
        if timeout == 0 {
            if unsafe { connect(h(self.fd), &b as *const [u8; 28] as *const u8, n) } != 0 { return Err(self.fail()); }
            return Ok(());
        }
        // Non-blocking for the connect, then select until the deadline.
        self.set_nonblocking(true)?;
        let r = self.connect_wait(&b, n, timeout);
        let back = self.set_nonblocking(false);
        r?;
        back
    }

    fn connect_wait(&self, b: &[u8; 28], n: i32, timeout: u64) -> io::Result<()> {
        if unsafe { connect(h(self.fd), b as *const [u8; 28] as *const u8, n) } == 0 { return Ok(()); }
        let e = unsafe { WSAGetLastError() };
        if e != WSAEWOULDBLOCK { return Err(os_error(e)); }
        // fd_set: a u32 count, then the SOCKETs (8-byte aligned).
        let mut w = [0u64; 2];
        w[0] = 1;
        w[1] = h(self.fd) as u64;
        let mut x = [0u64; 2];
        x[0] = 1;
        x[1] = h(self.fd) as u64;
        // struct timeval: two 32-bit longs.
        let us = timeout / 1000;
        let mut tv = [0i32; 2];
        tv[0] = if us / 1000000 > 0x7fffffff { 0x7fffffff } else { (us / 1000000) as i32 };
        tv[1] = (us % 1000000) as i32;
        let rc = unsafe { ws_select(0, 0 as *mut u8, &mut w as *mut [u64; 2] as *mut u8, &mut x as *mut [u64; 2] as *mut u8, &tv as *const [i32; 2] as *const u8) };
        if rc < 0 { return Err(last_error()); }
        if rc == 0 { return Err(timed_out()); }
        let err = get_int(self.fd, SOL_SOCKET, SO_ERROR)?;
        if err != 0 { return Err(os_error(err)); }
        Ok(())
    }

    fn set_nonblocking(&self, on: bool) -> io::Result<()> {
        let mut v: u32 = if on { 1 } else { 0 };
        if unsafe { ioctlsocket(h(self.fd), FIONBIO, &mut v as *mut u32) } != 0 { return Err(last_error()); }
        Ok(())
    }

    pub fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
        if self.is_closed() { return Err(closed()); }
        let n = unsafe { recv(h(self.fd), crate::rt::slice_ptr(buf) as *mut u8, clamp(buf.len()), 0) };
        if n < 0 { return Err(self.fail()); }
        Ok(n as usize)
    }

    pub fn write(&self, buf: &[u8]) -> io::Result<usize> {
        if self.is_closed() { return Err(closed()); }
        let n = unsafe { send(h(self.fd), crate::rt::slice_ptr(buf), clamp(buf.len()), 0) };
        if n < 0 { return Err(self.fail()); }
        Ok(n as usize)
    }

    pub fn recv_from(&self, buf: &mut [u8]) -> io::Result<(usize, SocketAddr)> {
        if self.is_closed() { return Err(closed()); }
        let mut b = [0u8; 28];
        let mut an = 28i32;
        let n = unsafe { recvfrom(h(self.fd), crate::rt::slice_ptr(buf) as *mut u8, clamp(buf.len()), 0, &mut b as *mut [u8; 28] as *mut u8, &mut an as *mut i32) };
        if n < 0 { return Err(self.fail()); }
        Ok((n as usize, decode(&b)))
    }

    pub fn send_to(&self, buf: &[u8], a: &SocketAddr) -> io::Result<usize> {
        if self.is_closed() { return Err(closed()); }
        let (b, an) = encode(a);
        let n = unsafe { sendto(h(self.fd), crate::rt::slice_ptr(buf), clamp(buf.len()), 0, &b as *const [u8; 28] as *const u8, an) };
        if n < 0 { return Err(self.fail()); }
        Ok(n as usize)
    }

    pub fn local_addr(&self) -> io::Result<SocketAddr> {
        let mut b = [0u8; 28];
        let mut n = 28i32;
        if unsafe { getsockname(h(self.fd), &mut b as *mut [u8; 28] as *mut u8, &mut n as *mut i32) } != 0 { return Err(last_error()); }
        Ok(decode(&b))
    }

    pub fn peer_addr(&self) -> io::Result<SocketAddr> {
        let mut b = [0u8; 28];
        let mut n = 28i32;
        if unsafe { getpeername(h(self.fd), &mut b as *mut [u8; 28] as *mut u8, &mut n as *mut i32) } != 0 { return Err(last_error()); }
        Ok(decode(&b))
    }

    pub fn shutdown(&self, how: i32) -> io::Result<()> {
        if unsafe { shutdown(h(self.fd), how) } != 0 { return Err(last_error()); }
        Ok(())
    }

    fn is_closed(&self) -> bool { crate::rt::atomic_load(&self.closed as *const usize as *mut usize) != 0 }

    /// Sets the read and write timeouts (nanoseconds; 0: none). Sockets are
    /// shared by the copies of a TcpStream: they change through &self.
    pub fn set_rto(&self, ns: u64) {
        unsafe { *(&self.rto as *const u64 as *mut u64) = ns; }
        let _ = set_int(self.fd, SOL_SOCKET, SO_RCVTIMEO, millis(ns));
    }
    pub fn set_wto(&self, ns: u64) {
        unsafe { *(&self.wto as *const u64 as *mut u64) = ns; }
        let _ = set_int(self.fd, SOL_SOCKET, SO_SNDTIMEO, millis(ns));
    }

    /// Closes the socket (a G waiting in it gets an error); again is a
    /// no-op.
    pub fn close(&self) {
        let p = &self.closed as *const usize as *mut usize;
        if !crate::rt::atomic_cas(p, 0, 1) { return; }
        unsafe { closesocket(h(self.fd)); }
    }
}

fn cstr_owned(s: &str) -> Vec<u8> {
    let mut v = s.as_bytes().to_vec();
    v.push(0);
    v
}

/// The addresses of host:port (getaddrinfo, a blocking call).
pub fn resolve(host: &str, port: u16) -> io::Result<Vec<SocketAddr>> {
    startup();
    let mut out: Vec<SocketAddr> = Vec::new();
    let hs = cstr_owned(host);
    let mut hints = [0u8; 48];
    hints[8] = SOCK_STREAM as u8; // ai_socktype
    let mut res = 0usize;
    let rc = unsafe { getaddrinfo(crate::rt::slice_ptr(hs.as_slice()), 0 as *const u8, &hints as *const [u8; 48] as *const u8, &mut res as *mut usize) };
    if rc != 0 { return Err(io::Error::other(`failed to lookup address information: ${os_error(rc)}`.as_str())); }
    // struct addrinfo: flags, family, socktype, protocol (i32 each),
    // addrlen (8), canonname, addr, next.
    let mut p = res;
    while p != 0 {
        unsafe {
            let fam = *((p + 4) as *const i32);
            let addr = *((p + 32) as *const usize);
            if (fam == AF_INET || fam == AF_INET6) && addr != 0 {
                let mut b = [0u8; 28];
                let len = if fam == AF_INET { 16 } else { 28 };
                let mut i = 0;
                while i < len {
                    b[i] = *((addr + i) as *const u8);
                    i += 1;
                }
                let mut a = decode(&b);
                a.set_port(port);
                if !out.contains(&a) { out.push(a); }
            }
            p = *((p + 40) as *const usize);
        }
    }
    unsafe { freeaddrinfo(res); }
    Ok(out)
}
