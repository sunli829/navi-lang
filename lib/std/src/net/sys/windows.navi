//! Sockets over Winsock (ws2_32.dll) and the runtime's I/O completion port
//! (as Go's on Windows): sockets are opened overlapped and attached to the
//! port; an operation (WSARecv, WSASend, AcceptEx, ConnectEx, ...) is
//! issued with an Op of rt::netpoll and its G parks until the completion
//! comes. A deadline cancels the operation (CancelIoEx), which then
//! completes as aborted. The data goes through the Op (the kernel never
//! writes into a G's stack, which may move): a read or write moves at most
//! CHUNK bytes. Name resolution (getaddrinfo) is a blocking call.
//!
//! WSAGetLastError is per OS thread: it is read right after the failed
//! call, with no park in between.

use crate::{
    io,
    net::ip::{Ipv4Addr, Ipv6Addr, SocketAddr, SocketAddrV4, SocketAddrV6},
    rt::netpoll::{self, OP_ADDR, OP_ADDRLEN, OP_BUF, OP_BYTES, OP_DATA, OP_FLAGS},
};

#[link(name = "ws2_32")]
#[nonblocking]
extern "C" {
    fn WSAStartup(version: u16, data: *mut u8) -> i32;
    fn WSAGetLastError() -> i32;
    fn WSASocketW(af: i32, ty: i32, proto: i32, info: *const u8, group: u32, flags: u32) -> usize;
    fn WSARecv(
        s: usize,
        bufs: *mut u8,
        n: u32,
        got: *mut u32,
        flags: *mut u32,
        ov: *mut u8,
        done: *const u8,
    ) -> i32;
    fn WSASend(
        s: usize,
        bufs: *mut u8,
        n: u32,
        sent: *mut u32,
        flags: u32,
        ov: *mut u8,
        done: *const u8,
    ) -> i32;
    fn WSARecvFrom(
        s: usize,
        bufs: *mut u8,
        n: u32,
        got: *mut u32,
        flags: *mut u32,
        from: *mut u8,
        fromlen: *mut i32,
        ov: *mut u8,
        done: *const u8,
    ) -> i32;
    fn WSASendTo(
        s: usize,
        bufs: *mut u8,
        n: u32,
        sent: *mut u32,
        flags: u32,
        to: *const u8,
        tolen: i32,
        ov: *mut u8,
        done: *const u8,
    ) -> i32;
    fn WSAGetOverlappedResult(
        s: usize,
        ov: *mut u8,
        bytes: *mut u32,
        wait: i32,
        flags: *mut u32,
    ) -> i32;
    fn WSAIoctl(
        s: usize,
        code: u32,
        inb: *const u8,
        inlen: u32,
        outb: *mut u8,
        outlen: u32,
        got: *mut u32,
        ov: *mut u8,
        done: *const u8,
    ) -> i32;
    fn bind(s: usize, addr: *const u8, len: i32) -> i32;
    fn listen(s: usize, backlog: i32) -> i32;
    fn connect(s: usize, addr: *const u8, len: i32) -> i32;
    fn getsockname(s: usize, addr: *mut u8, len: *mut i32) -> i32;
    fn getpeername(s: usize, addr: *mut u8, len: *mut i32) -> i32;
    fn shutdown(s: usize, how: i32) -> i32;
    fn closesocket(s: usize) -> i32;
    fn setsockopt(s: usize, level: i32, name: i32, val: *const u8, len: i32) -> i32;
    fn getsockopt(s: usize, level: i32, name: i32, val: *mut u8, len: *mut i32) -> i32;
    fn freeaddrinfo(res: usize);
}
// May block: the call counts its G as blocked.
#[link(name = "ws2_32")]
extern "C" {
    fn getaddrinfo(node: *const u8, service: *const u8, hints: *const u8, res: *mut usize) -> i32;
}

#[link(name = "mswsock")]
#[nonblocking]
extern "C" {
    fn AcceptEx(
        listen: usize,
        accept: usize,
        buf: *mut u8,
        recvlen: u32,
        local: u32,
        remote: u32,
        got: *mut u32,
        ov: *mut u8,
    ) -> i32;
}

pub const SOCK_STREAM: i32 = 1;
pub const SOCK_DGRAM: i32 = 2;
const AF_INET: i32 = 2;
const AF_INET6: i32 = 23;
pub const SOL_SOCKET: i32 = 0xffff;
pub const SO_BROADCAST: i32 = 0x20;
const SO_UPDATE_ACCEPT_CONTEXT: i32 = 0x700b;
const SO_UPDATE_CONNECT_CONTEXT: i32 = 0x7010;
pub const IPPROTO_TCP: i32 = 6;
pub const TCP_NODELAY: i32 = 1;
pub const IPPROTO_IP: i32 = 0;
pub const IP_TTL: i32 = 4;
const WSA_FLAG_OVERLAPPED: u32 = 1;
const WSA_FLAG_NO_HANDLE_INHERIT: u32 = 0x80;
const SIO_GET_EXTENSION_FUNCTION_POINTER: u32 = 0xc8000006;
const SIO_UDP_CONNRESET: u32 = 0x9800000c;
const INVALID_SOCKET: usize = 18446744073709551615;
const WSA_IO_PENDING: i32 = 997;
const WSAEMSGSIZE: i32 = 10040;
const ERROR_OPERATION_ABORTED: i32 = 995;
// The most bytes one read or write moves (through its Op).
const CHUNK: usize = 65536;

static mut STARTED: usize = 0;
static mut CONNECT_EX: usize = 0;

// Winsock 2.2, once (WSAStartup counts its calls: two racing ones are fine).
fn startup() {
    if crate::rt::atomic_load(unsafe { &STARTED } as *const usize as *mut usize) != 0 {
        return;
    }
    let mut data = [0u8; 512]; // WSADATA (408 bytes on 64-bit Windows)
    let rc = unsafe { WSAStartup(0x0202, &mut data as *mut [u8; 512] as *mut u8) };
    if rc != 0 {
        crate::rt::native::fatal("WSAStartup failed");
    }
    crate::rt::atomic_store(unsafe { &STARTED } as *const usize as *mut usize, 1);
}

/// The io::Error of a Winsock error number.
pub fn os_error(e: i32) -> io::Error {
    io::Error::from_raw_os_error(e)
}

/// The error of the Winsock call just failed. Callers here read
/// WSAGetLastError in the failing expression instead: this call's own
/// prologue may grow the stack, a Win32 call that can change it.
pub fn last_error() -> io::Error {
    os_error(unsafe { WSAGetLastError() })
}

fn closed() -> io::Error {
    io::Error::new(io::ErrorKind::NotConnected, "socket closed")
}

fn timed_out() -> io::Error {
    io::Error::new(io::ErrorKind::TimedOut, "operation timed out")
}

/// A socket and its timeouts (shared by the copies of a TcpStream etc.).
/// fd is the SOCKET (handles fit in 32 bits).
pub struct Socket {
    pub fd: i32,
    fam: i32,
    ty: i32,
    /// Read and write timeouts in nanoseconds (0: none).
    pub rto: u64,
    pub wto: u64,
    // 1 once closed (set by one close only).
    closed: usize,
    // An Op (with CHUNK bytes of data) kept for the next read and the next
    // write, under oplk (copies of a TcpStream may read at once).
    oplk: usize,
    rop: *mut u8,
    wop: *mut u8,
}

fn h(fd: i32) -> usize {
    fd as u32 as usize
}

// A new overlapped socket attached to the completion port.
fn open(fam: i32, ty: i32) -> io::Result<&mut Socket> {
    startup();
    let s = unsafe {
        WSASocketW(
            fam,
            ty,
            0,
            0 as *const u8,
            0,
            WSA_FLAG_OVERLAPPED | WSA_FLAG_NO_HANDLE_INHERIT,
        )
    };
    if s == INVALID_SOCKET {
        return Err(os_error(unsafe { WSAGetLastError() }));
    }
    if !netpoll::attach(s) {
        let e = io::Error::last_os_error();
        unsafe {
            closesocket(s);
        }
        return Err(e);
    }
    if ty == SOCK_DGRAM {
        // A datagram refused by an earlier peer (ICMP port unreachable) is
        // no error of the next receive.
        let off = 0u32;
        let mut got = 0u32;
        unsafe {
            WSAIoctl(
                s,
                SIO_UDP_CONNRESET,
                &off as *const u32 as *const u8,
                4,
                0 as *mut u8,
                0,
                &mut got as *mut u32,
                0 as *mut u8,
                0 as *const u8,
            );
        }
    }
    Ok(&mut Socket {
        fd: s as i32,
        fam,
        ty,
        rto: 0,
        wto: 0,
        closed: 0,
        oplk: 0,
        rop: 0 as *mut u8,
        wop: 0 as *mut u8,
    })
}

/// A new socket for addresses like a.
pub fn new_socket(a: &SocketAddr, ty: i32) -> io::Result<&mut Socket> {
    open(if a.is_ipv4() { AF_INET } else { AF_INET6 }, ty)
}

pub fn set_int(fd: i32, level: i32, name: i32, v: i32) -> io::Result<()> {
    let x = v;
    if unsafe { setsockopt(h(fd), level, name, &x as *const i32 as *const u8, 4) } != 0 {
        return Err(os_error(unsafe { WSAGetLastError() }));
    }
    Ok(())
}

pub fn get_int(fd: i32, level: i32, name: i32) -> io::Result<i32> {
    let mut x = 0i32;
    let mut n = 4i32;
    if unsafe {
        getsockopt(
            h(fd),
            level,
            name,
            &mut x as *mut i32 as *mut u8,
            &mut n as *mut i32,
        )
    } != 0
    {
        return Err(os_error(unsafe { WSAGetLastError() }));
    }
    Ok(x)
}

// struct sockaddr_in / sockaddr_in6: a 16-bit family, then as everywhere.
/// The C encoding of a (and its length).
pub fn encode(a: &SocketAddr) -> ([u8; 28], i32) {
    let mut b = [0u8; 28];
    match a {
        SocketAddr::V4(v) => {
            b[0] = AF_INET as u8;
            b[2] = (v.port() >> 8) as u8;
            b[3] = v.port() as u8;
            let o = v.ip().octets();
            b[4] = o[0];
            b[5] = o[1];
            b[6] = o[2];
            b[7] = o[3];
            (b, 16)
        }
        SocketAddr::V6(v) => {
            b[0] = AF_INET6 as u8;
            b[2] = (v.port() >> 8) as u8;
            b[3] = v.port() as u8;
            let fl = v.flowinfo();
            b[4] = (fl >> 24) as u8;
            b[5] = (fl >> 16) as u8;
            b[6] = (fl >> 8) as u8;
            b[7] = fl as u8;
            let o = v.ip().octets();
            let mut i = 0;
            while i < 16 {
                b[8 + i] = o[i];
                i += 1;
            }
            let sc = v.scope_id();
            b[24] = sc as u8;
            b[25] = (sc >> 8) as u8;
            b[26] = (sc >> 16) as u8;
            b[27] = (sc >> 24) as u8;
            (b, 28)
        }
    }
}

pub fn decode(b: &[u8; 28]) -> SocketAddr {
    let port = (b[2] as u16) << 8 | b[3] as u16;
    if (b[0] as i32 | (b[1] as i32) << 8) == AF_INET {
        return SocketAddr::V4(SocketAddrV4::new(
            Ipv4Addr::new(b[4], b[5], b[6], b[7]),
            port,
        ));
    }
    let mut o = [0u8; 16];
    let mut i = 0;
    while i < 16 {
        o[i] = b[8 + i];
        i += 1;
    }
    let fl = (b[4] as u32) << 24 | (b[5] as u32) << 16 | (b[6] as u32) << 8 | b[7] as u32;
    let sc = b[24] as u32 | (b[25] as u32) << 8 | (b[26] as u32) << 16 | (b[27] as u32) << 24;
    SocketAddr::V6(SocketAddrV6::new(Ipv6Addr::from_octets(o), port, fl, sc))
}

fn deadline(timeout: u64) -> u64 {
    if timeout == 0 {
        0
    } else {
        crate::rt::native::monotonic_nanos() + timeout
    }
}

// --- Ops ---------------------------------------------------------------------

fn ov(op: usize) -> *mut u8 {
    op as *mut u8
}

fn u32_at(op: usize, off: usize) -> *mut u32 {
    (op + off) as *mut u32
}

// Points op's WSABUF at the first n bytes of its data.
fn set_buf(op: usize, n: usize) {
    unsafe {
        *((op + OP_BUF) as *mut u32) = n as u32;
        *((op + OP_BUF + 8) as *mut usize) = op + OP_DATA;
    }
}

// The address in op (as a 28-byte sockaddr).
fn op_addr(op: usize) -> SocketAddr {
    let mut b = [0u8; 28];
    let mut i = 0;
    while i < 28 {
        b[i] = unsafe { *((op + OP_ADDR + i) as *const u8) };
        i += 1;
    }
    decode(&b)
}

fn op_set_addr(op: usize, a: &SocketAddr) -> i32 {
    let (b, n) = encode(a);
    let mut i = 0;
    while i < 28 {
        unsafe {
            *((op + OP_ADDR + i) as *mut u8) = b[i];
        }
        i += 1;
    }
    n
}

impl Socket {
    // Ends op issued on this socket: err is 0 if the issuing call succeeded
    // (a completion comes either way, as the socket does not skip it), else
    // its WSAGetLastError, read in the issuing expression itself (a call in
    // between, even a prologue growing the stack, may change it): pending
    // (a completion comes) or failed (none). The bytes moved.
    fn finish(&self, op: usize, err: i32, dl: u64) -> io::Result<usize> {
        if err != 0 {
            let e = err;
            if e != WSA_IO_PENDING {
                netpoll::op_failed(op);
                if self.is_closed() {
                    return Err(closed());
                }
                return Err(os_error(e));
            }
        }
        let timed = netpoll::op_wait(op, h(self.fd), dl);
        // The kernel left the outcome in the OVERLAPPED (Internal: the
        // NTSTATUS, InternalHigh: the bytes) before queueing the completion:
        // a success stands even if the socket was closed since.
        let status = unsafe { *(op as *const u64) } as u32;
        if status == 0 {
            return Ok(unsafe { *((op + 8) as *const u64) } as usize);
        }
        if self.is_closed() {
            return Err(closed());
        }
        // A failure (or a warning, as a datagram truncated): Winsock turns
        // the NTSTATUS into its error.
        let mut n = 0u32;
        let mut fl = 0u32;
        if unsafe {
            WSAGetOverlappedResult(
                h(self.fd),
                ov(op),
                &mut n as *mut u32,
                0,
                &mut fl as *mut u32,
            )
        } == 0
        {
            let e = unsafe { WSAGetLastError() };
            if self.is_closed() {
                return Err(closed());
            }
            if timed && e == ERROR_OPERATION_ABORTED {
                return Err(timed_out());
            }
            return Err(os_error(e));
        }
        Ok(n as usize)
    }

    pub fn bind(&self, a: &SocketAddr) -> io::Result<()> {
        // No SO_REUSEADDR: on Windows it lets another socket take the port.
        let (b, n) = encode(a);
        if unsafe { bind(h(self.fd), &b as *const [u8; 28] as *const u8, n) } != 0 {
            return Err(os_error(unsafe { WSAGetLastError() }));
        }
        Ok(())
    }

    pub fn listen(&self, backlog: i32) -> io::Result<()> {
        if unsafe { listen(h(self.fd), backlog) } != 0 {
            return Err(os_error(unsafe { WSAGetLastError() }));
        }
        Ok(())
    }

    pub fn accept(&self) -> io::Result<(&mut Socket, SocketAddr)> {
        if self.is_closed() {
            return Err(closed());
        }
        let s = open(self.fam, self.ty)?;
        // The addresses AcceptEx writes: each its sockaddr and 16 bytes.
        let op = netpoll::op_new(2 * 44);
        set_buf(op, 2 * 44);
        let err = unsafe {
            if AcceptEx(
                h(self.fd),
                h(s.fd),
                (op + OP_DATA) as *mut u8,
                0,
                44,
                44,
                u32_at(op, OP_BYTES),
                ov(op),
            ) != 0
            {
                0
            } else {
                WSAGetLastError()
            }
        };
        if let Err(e) = self.finish(op, err, deadline(self.rto)) {
            s.close();
            return Err(e);
        }
        // The accepted socket takes the listener's properties.
        let l = h(self.fd);
        unsafe {
            setsockopt(
                h(s.fd),
                SOL_SOCKET,
                SO_UPDATE_ACCEPT_CONTEXT,
                &l as *const usize as *const u8,
                8,
            );
        }
        match s.peer_addr() {
            Ok(a) => Ok((s, a)),
            Err(e) => {
                s.close();
                Err(e)
            }
        }
    }

    pub fn connect(&self, a: &SocketAddr, timeout: u64) -> io::Result<()> {
        let (b, n) = encode(a);
        if self.ty != SOCK_STREAM {
            // A datagram socket only records its peer.
            if unsafe { connect(h(self.fd), &b as *const [u8; 28] as *const u8, n) } != 0 {
                return Err(os_error(unsafe { WSAGetLastError() }));
            }
            return Ok(());
        }
        // ConnectEx wants a socket bound first (as Go's): to a port chosen
        // without knowing the peer, so a port in TIME_WAIT cannot be reused
        // as connect's own bind would (more than about 16000 connections
        // closed within the TIME_WAIT delay run out of ports).
        let any = if a.is_ipv4() {
            SocketAddr::V4(SocketAddrV4::new(Ipv4Addr::new(0, 0, 0, 0), 0))
        } else {
            SocketAddr::V6(SocketAddrV6::new(Ipv6Addr::from_octets([0u8; 16]), 0, 0, 0))
        };
        self.bind(&any)?;
        let cx = self.connect_ex()?;
        let op = netpoll::op_new(0);
        let len = op_set_addr(op, a);
        let err = if cx(
            h(self.fd),
            (op + OP_ADDR) as *const u8,
            len,
            0 as *const u8,
            0,
            u32_at(op, OP_BYTES),
            ov(op),
        ) != 0
        {
            0
        } else {
            unsafe { WSAGetLastError() }
        };
        self.finish(op, err, deadline(timeout))?;
        unsafe {
            setsockopt(
                h(self.fd),
                SOL_SOCKET,
                SO_UPDATE_CONNECT_CONTEXT,
                0 as *const u8,
                0,
            );
        }
        Ok(())
    }

    // ConnectEx, from the provider (once).
    fn connect_ex(
        &self,
    ) -> io::Result<extern "C" fn(usize, *const u8, i32, *const u8, u32, *mut u32, *mut u8) -> i32>
    {
        let mut p = crate::rt::atomic_load(unsafe { &CONNECT_EX } as *const usize as *mut usize);
        if p == 0 {
            // WSAID_CONNECTEX {25a207b9-ddf3-4660-8ee9-76e58c74063e}.
            let guid: [u8; 16] = [
                0xb9, 0x07, 0xa2, 0x25, 0xf3, 0xdd, 0x60, 0x46, 0x8e, 0xe9, 0x76, 0xe5, 0x8c, 0x74,
                0x06, 0x3e,
            ];
            let mut got = 0u32;
            if unsafe {
                WSAIoctl(
                    h(self.fd),
                    SIO_GET_EXTENSION_FUNCTION_POINTER,
                    &guid as *const [u8; 16] as *const u8,
                    16,
                    &mut p as *mut usize as *mut u8,
                    8,
                    &mut got as *mut u32,
                    0 as *mut u8,
                    0 as *const u8,
                )
            } != 0
            {
                return Err(os_error(unsafe { WSAGetLastError() }));
            }
            crate::rt::atomic_store(unsafe { &CONNECT_EX } as *const usize as *mut usize, p);
        }
        Ok(unsafe {
            *(&p as *const usize
                as *const extern "C" fn(
                    usize,
                    *const u8,
                    i32,
                    *const u8,
                    u32,
                    *mut u32,
                    *mut u8,
                ) -> i32)
        })
    }

    pub fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
        if self.is_closed() {
            return Err(closed());
        }
        // A zero-byte read would wait for data and report none.
        if buf.len() == 0 {
            return Ok(0);
        }
        let want = if buf.len() < CHUNK { buf.len() } else { CHUNK };
        let op = self.take_op(true);
        set_buf(op, want);
        let err = unsafe {
            if WSARecv(
                h(self.fd),
                (op + OP_BUF) as *mut u8,
                1,
                u32_at(op, OP_BYTES),
                u32_at(op, OP_FLAGS),
                ov(op),
                0 as *const u8,
            ) == 0
            {
                0
            } else {
                WSAGetLastError()
            }
        };
        let n = self.truncated(self.finish(op, err, deadline(self.rto)), want)?;
        copy_out(op, buf, n);
        self.put_op(true, op);
        Ok(n)
    }

    // A datagram longer than the buffer fills it and the rest is dropped
    // (WSAEMSGSIZE): as on Unix, that is no error.
    fn truncated(&self, r: io::Result<usize>, want: usize) -> io::Result<usize> {
        match r {
            Err(e) if self.ty == SOCK_DGRAM && e.raw_os_error() == Some(WSAEMSGSIZE) => Ok(want),
            r => r,
        }
    }

    pub fn write(&self, buf: &[u8]) -> io::Result<usize> {
        if self.is_closed() {
            return Err(closed());
        }
        let op = self.take_op(false);
        fill(op, buf);
        let err = unsafe {
            if WSASend(
                h(self.fd),
                (op + OP_BUF) as *mut u8,
                1,
                u32_at(op, OP_BYTES),
                0,
                ov(op),
                0 as *const u8,
            ) == 0
            {
                0
            } else {
                WSAGetLastError()
            }
        };
        let n = self.finish(op, err, deadline(self.wto))?;
        self.put_op(false, op);
        Ok(n)
    }

    pub fn recv_from(&self, buf: &mut [u8]) -> io::Result<(usize, SocketAddr)> {
        if self.is_closed() {
            return Err(closed());
        }
        let want = if buf.len() < CHUNK { buf.len() } else { CHUNK };
        let op = self.take_op(true);
        set_buf(op, want);
        unsafe {
            *((op + OP_ADDRLEN) as *mut i32) = 28;
        }
        let err = unsafe {
            if WSARecvFrom(
                h(self.fd),
                (op + OP_BUF) as *mut u8,
                1,
                u32_at(op, OP_BYTES),
                u32_at(op, OP_FLAGS),
                (op + OP_ADDR) as *mut u8,
                (op + OP_ADDRLEN) as *mut i32,
                ov(op),
                0 as *const u8,
            ) == 0
            {
                0
            } else {
                WSAGetLastError()
            }
        };
        let n = self.truncated(self.finish(op, err, deadline(self.rto)), want)?;
        copy_out(op, buf, n);
        let a = op_addr(op);
        self.put_op(true, op);
        Ok((n, a))
    }

    pub fn send_to(&self, buf: &[u8], a: &SocketAddr) -> io::Result<usize> {
        if self.is_closed() {
            return Err(closed());
        }
        let op = self.take_op(false);
        fill(op, buf);
        let len = op_set_addr(op, a);
        let err = unsafe {
            if WSASendTo(
                h(self.fd),
                (op + OP_BUF) as *mut u8,
                1,
                u32_at(op, OP_BYTES),
                0,
                (op + OP_ADDR) as *const u8,
                len,
                ov(op),
                0 as *const u8,
            ) == 0
            {
                0
            } else {
                WSAGetLastError()
            }
        };
        let n = self.finish(op, err, deadline(self.wto))?;
        self.put_op(false, op);
        Ok(n)
    }

    pub fn local_addr(&self) -> io::Result<SocketAddr> {
        let mut b = [0u8; 28];
        let mut n = 28i32;
        if unsafe {
            getsockname(
                h(self.fd),
                &mut b as *mut [u8; 28] as *mut u8,
                &mut n as *mut i32,
            )
        } != 0
        {
            return Err(os_error(unsafe { WSAGetLastError() }));
        }
        Ok(decode(&b))
    }

    pub fn peer_addr(&self) -> io::Result<SocketAddr> {
        let mut b = [0u8; 28];
        let mut n = 28i32;
        if unsafe {
            getpeername(
                h(self.fd),
                &mut b as *mut [u8; 28] as *mut u8,
                &mut n as *mut i32,
            )
        } != 0
        {
            return Err(os_error(unsafe { WSAGetLastError() }));
        }
        Ok(decode(&b))
    }

    pub fn shutdown(&self, how: i32) -> io::Result<()> {
        if unsafe { shutdown(h(self.fd), how) } != 0 {
            return Err(os_error(unsafe { WSAGetLastError() }));
        }
        Ok(())
    }

    fn is_closed(&self) -> bool {
        crate::rt::atomic_load(&self.closed as *const usize as *mut usize) != 0
    }

    /// Sets the read and write timeouts (nanoseconds; 0: none). Sockets are
    /// shared by the copies of a TcpStream: they change through &self.
    pub fn set_rto(&self, ns: u64) {
        unsafe {
            *(&self.rto as *const u64 as *mut u64) = ns;
        }
    }

    pub fn set_wto(&self, ns: u64) {
        unsafe {
            *(&self.wto as *const u64 as *mut u64) = ns;
        }
    }

    // The kept Op for reads (or writes), or a new one. One whose operation
    // failed is not put back (the next takes a new one).
    fn take_op(&self, read: bool) -> usize {
        let lk = &self.oplk as *const usize as *mut usize;
        let slot = (if read { &self.rop } else { &self.wop }) as *const *mut u8 as *mut *mut u8;
        crate::rt::sched::obj_lock(lk);
        let op = unsafe { *slot } as usize;
        unsafe {
            *slot = 0 as *mut u8;
        }
        crate::rt::sched::obj_unlock(lk);
        if op == 0 {
            netpoll::op_new(CHUNK)
        } else {
            netpoll::op_reuse(op)
        }
    }

    // Keeps op (finished) for the next read (or write), if none is kept.
    // The store is through a pointer to a pointer: with the write barrier.
    fn put_op(&self, read: bool, op: usize) {
        let lk = &self.oplk as *const usize as *mut usize;
        let slot = (if read { &self.rop } else { &self.wop }) as *const *mut u8 as *mut *mut u8;
        crate::rt::sched::obj_lock(lk);
        unsafe {
            if (*slot) as usize == 0 {
                *slot = op as *mut u8;
            }
        }
        crate::rt::sched::obj_unlock(lk);
    }

    /// Closes the socket (its pending operations complete as aborted: a G
    /// waiting in one gets an error); again is a no-op.
    pub fn close(&self) {
        let p = &self.closed as *const usize as *mut usize;
        if !crate::rt::atomic_cas(p, 0, 1) {
            return;
        }
        unsafe {
            closesocket(h(self.fd));
        }
    }
}

// Copies the first n bytes of op's data into buf.
fn copy_out(op: usize, buf: &mut [u8], n: usize) {
    crate::rt::copy::<u8>(
        (op + OP_DATA) as *const u8,
        crate::rt::slice_ptr(buf) as *mut u8,
        n,
    );
}

// Puts the first CHUNK bytes (at most) of buf into op, to send.
fn fill(op: usize, buf: &[u8]) {
    let n = if buf.len() < CHUNK { buf.len() } else { CHUNK };
    crate::rt::copy::<u8>(crate::rt::slice_ptr(buf), (op + OP_DATA) as *mut u8, n);
    set_buf(op, n);
}

fn cstr_owned(s: &str) -> Vec<u8> {
    let mut v = s.as_bytes().to_vec();
    v.push(0);
    v
}

/// The addresses of host:port (getaddrinfo, a blocking call).
pub fn resolve(host: &str, port: u16) -> io::Result<Vec<SocketAddr>> {
    startup();
    let mut out: Vec<SocketAddr> = Vec::new();
    let hs = cstr_owned(host);
    let mut hints = [0u8; 48];
    hints[8] = SOCK_STREAM as u8; // ai_socktype
    let mut res = 0usize;
    let rc = unsafe {
        getaddrinfo(
            crate::rt::slice_ptr(hs.as_slice()),
            0 as *const u8,
            &hints as *const [u8; 48] as *const u8,
            &mut res as *mut usize,
        )
    };
    if rc != 0 {
        return Err(io::Error::other(
            `failed to lookup address information: ${os_error(rc)}`
                .to_string()
                .as_str(),
        ));
    }
    // struct addrinfo: flags, family, socktype, protocol (i32 each),
    // addrlen (8), canonname, addr, next.
    let mut p = res;
    while p != 0 {
        unsafe {
            let fam = *((p + 4) as *const i32);
            let addr = *((p + 32) as *const usize);
            if (fam == AF_INET || fam == AF_INET6) && addr != 0 {
                let mut b = [0u8; 28];
                let len = if fam == AF_INET { 16 } else { 28 };
                let mut i = 0;
                while i < len {
                    b[i] = *((addr + i) as *const u8);
                    i += 1;
                }
                let mut a = decode(&b);
                a.set_port(port);
                if !out.contains(&a) {
                    out.push(a);
                }
            }
            p = *((p + 40) as *const usize);
        }
    }
    unsafe {
        freeaddrinfo(res);
    }
    Ok(out)
}
