//! A lightweight logging facade, with the API of Rust's [log] crate, and a
//! built-in logger configured as [env_logger].
//!
//! Libraries log with the functions [`error`], [`warn`], [`info`],
//! [`debug`] and [`trace`] (the log crate's macros), and programs choose
//! where the records go by installing a logger. Like Go, whose standard
//! library has a `log` package, navi's std includes a logger:
//! [`init`] installs it, reading its filters from the `NAVI_LOG`
//! environment variable (env_logger's `RUST_LOG`), and [`Builder`]
//! configures it in code.
//!
//! [log]: https://docs.rs/log
//! [env_logger]: https://docs.rs/env_logger
//!
//! # Usage
//!
//! ```no_run
//! use std::log;
//!
//! fn main() {
//!     log::init(); // NAVI_LOG=info, NAVI_LOG=net=debug,warn, ...
//!
//!     let workers = 4;
//!     log::info(`starting with ${workers} workers`);
//!     if log::log_enabled(log::Level::Debug) {
//!         log::debug(`state: ${expensive_dump()}`);
//!     }
//!     log::log(log::Level::Warn, "low disk space");
//!     log::log_target("net", log::Level::Error, "connection reset");
//! }
//! # fn expensive_dump() -> String { String::new() }
//! ```
//!
//! With `NAVI_LOG=info`, the built-in logger writes to the standard error,
//! as env_logger does:
//!
//! ```text
//! [2024-01-02T03:04:05Z INFO  myapp] starting with 4 workers
//! [2024-01-02T03:04:05Z WARN  myapp] low disk space
//! [2024-01-02T03:04:05Z ERROR net] connection reset
//! ```
//!
//! # Levels and laziness
//!
//! The logging functions take any `impl Display`. A template string passed
//! to them is a `fmt::Arguments`, formatted only if the record is logged;
//! but the expressions in its `${...}` are evaluated in any case, unlike
//! the arguments of the log crate's macros, which a disabled call skips.
//! Guard expensive arguments with [`log_enabled`].
//!
//! # Installing a logger
//!
//! As with the log crate, nothing is logged until a logger is installed:
//! the maximum level starts at [`LevelFilter::Off`] and the logger is a
//! no-op. [`init`] (or [`Builder::init`]) installs the built-in logger;
//! [`set_logger`] installs any implementation of [`Log`], and
//! [`set_max_level`] sets the level the logging functions check before
//! making a record. A logger can be installed once per process.
//!
//! ```
//! use std::log::{Level, Log, Metadata, Record};
//! use std::sync::Mutex;
//!
//! // A logger that keeps the messages of Info and above.
//! struct Memory {
//!     lines: &Mutex<Vec<String>>,
//! }
//!
//! impl Log for Memory {
//!     fn enabled(&self, metadata: &Metadata) -> bool {
//!         metadata.level() <= Level::Info
//!     }
//!     fn log(&self, record: &Record) {
//!         if self.enabled(record.metadata()) {
//!             self.lines.lock().push(`${record.level()}: ${record.args()}`.to_string());
//!             self.lines.unlock();
//!         }
//!     }
//!     fn flush(&self) {}
//! }
//!
//! let logger = Memory { lines: &Mutex::new(Vec::new()) };
//! // A program installs it with
//! //     log::set_logger(&logger).unwrap();
//! //     log::set_max_level(log::LevelFilter::Info);
//! // here it is called directly.
//! logger.log(&Record::builder().level(Level::Warn).args("disk almost full").build());
//! logger.log(&Record::builder().level(Level::Debug).args("not kept").build());
//! let lines = logger.lines.lock().clone();
//! logger.lines.unlock();
//! assert_eq(lines, Vec::from(["WARN: disk almost full".to_string()]));
//! ```
//!
//! # Targets
//!
//! A record's target defaults to its module path, which navi derives from
//! the caller's file (the logging functions are `#[track_caller]`):
//! `src/net/http.navi` in a crate is `<crate>::net::http`, where `<crate>`
//! is the directory holding `src` (or, for a relative path, the program's
//! name); a file outside `src` is its file stem (`x.navi` is `x`).
//! [`log_target`] gives a target explicitly (the log crate's
//! `log!(target: "net", ...)`).
//!
//! # Threads
//!
//! A logger is shared by every thread; the built-in one writes each record
//! with one write under a lock.

use crate::cmp::Ordering;
use crate::fmt::{self, Debug, Display};
use crate::panic::Location;
use crate::str::FromStr;

mod env;
pub use env::{
    Builder, Formatter, Logger, Target, Timestamp, TimestampPrecision, WriteStyle, init, try_init,
};

// --- Levels ------------------------------------------------------------------

/// The level of a log record: how important it is.
///
/// `Error` is the most severe; as in the log crate, it compares as the
/// smallest (`Error < Warn < Info < Debug < Trace`), so "this level or more
/// severe" is `level <= filter`. A `Level` compares with a [`LevelFilter`]
/// too. It parses from its name, ignoring case, and displays as its name
/// in capitals.
///
/// # Examples
///
/// ```
/// use std::log::{Level, LevelFilter};
///
/// assert(Level::Error < Level::Warn);
/// assert(!(Level::Debug <= LevelFilter::Info));
/// assert(Level::Warn <= LevelFilter::Info);
///
/// let l: Level = "info".parse().unwrap();
/// assert_eq(l, Level::Info);
/// assert_eq(l.to_string(), "INFO");
/// assert("off".parse::<Level>().is_err());
/// ```
#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub enum Level {
    /// Serious errors.
    Error = 1,
    /// Hazardous situations.
    Warn = 2,
    /// Useful information.
    Info = 3,
    /// Lower priority information, for debugging.
    Debug = 4,
    /// Very low priority, often extremely verbose, information.
    Trace = 5,
}

/// A maximum level of the records to log: [`Off`](LevelFilter::Off) or a
/// [`Level`].
///
/// [`set_max_level`] takes one, and the built-in logger's filters are
/// made of them. Ordered as `Level` is, with `Off` the smallest; a
/// `LevelFilter` compares with a `Level`.
///
/// # Examples
///
/// ```
/// use std::log::{Level, LevelFilter};
///
/// assert(LevelFilter::Off < LevelFilter::Error);
/// assert(Level::Error <= LevelFilter::Warn);
/// assert_eq("OFF".parse::<LevelFilter>(), Ok(LevelFilter::Off));
/// assert_eq(LevelFilter::from(Level::Debug), LevelFilter::Debug);
/// ```
#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub enum LevelFilter {
    /// Logs nothing.
    Off = 0,
    /// Logs `Error` records.
    Error = 1,
    /// Logs `Warn` records and more severe ones.
    Warn = 2,
    /// Logs `Info` records and more severe ones.
    Info = 3,
    /// Logs `Debug` records and more severe ones.
    Debug = 4,
    /// Logs every record.
    Trace = 5,
}

const LEVEL_NAMES: [&str; 6] = ["OFF", "ERROR", "WARN", "INFO", "DEBUG", "TRACE"];

fn level_from(i: usize) -> Option<Level> {
    match i {
        1 => Some(Level::Error),
        2 => Some(Level::Warn),
        3 => Some(Level::Info),
        4 => Some(Level::Debug),
        5 => Some(Level::Trace),
        _ => None,
    }
}

fn filter_from(i: usize) -> LevelFilter {
    match i {
        0 => LevelFilter::Off,
        1 => LevelFilter::Error,
        2 => LevelFilter::Warn,
        3 => LevelFilter::Info,
        4 => LevelFilter::Debug,
        _ => LevelFilter::Trace,
    }
}

impl Level {
    fn idx(&self) -> usize {
        self.clone() as usize
    }

    /// Returns the most verbose level, [`Level::Trace`].
    ///
    /// # Examples
    ///
    /// ```
    /// use std::log::Level;
    ///
    /// assert_eq(Level::max(), Level::Trace);
    /// ```
    pub fn max() -> Level {
        Level::Trace
    }

    /// Returns the [`LevelFilter`] of the same name.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::log::{Level, LevelFilter};
    ///
    /// assert_eq(Level::Warn.to_level_filter(), LevelFilter::Warn);
    /// ```
    pub fn to_level_filter(&self) -> LevelFilter {
        filter_from(self.idx())
    }

    /// Returns the name of the level: `"ERROR"`, `"WARN"`, `"INFO"`,
    /// `"DEBUG"` or `"TRACE"`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::log::Level;
    ///
    /// assert_eq(Level::Debug.as_str(), "DEBUG");
    /// ```
    pub fn as_str(&self) -> &str {
        LEVEL_NAMES[self.idx()]
    }

    /// Returns an iterator over the levels, from `Error` to `Trace`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::log::Level;
    ///
    /// let names: Vec<String> = Level::iter().map(|l| l.to_string()).collect();
    /// assert_eq(names.join(" "), "ERROR WARN INFO DEBUG TRACE");
    /// ```
    pub fn iter() -> crate::vec::IntoIter<Level> {
        Vec::from([
            Level::Error,
            Level::Warn,
            Level::Info,
            Level::Debug,
            Level::Trace,
        ])
        .into_iter()
    }
}

impl LevelFilter {
    fn idx(&self) -> usize {
        self.clone() as usize
    }

    /// Returns the most verbose filter, [`LevelFilter::Trace`].
    ///
    /// # Examples
    ///
    /// ```
    /// use std::log::LevelFilter;
    ///
    /// assert_eq(LevelFilter::max(), LevelFilter::Trace);
    /// ```
    pub fn max() -> LevelFilter {
        LevelFilter::Trace
    }

    /// Returns the [`Level`] of the same name, or `None` for `Off`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::log::{Level, LevelFilter};
    ///
    /// assert_eq(LevelFilter::Info.to_level(), Some(Level::Info));
    /// assert_eq(LevelFilter::Off.to_level(), None);
    /// ```
    pub fn to_level(&self) -> Option<Level> {
        level_from(self.idx())
    }

    /// Returns the name of the filter: `"OFF"`, `"ERROR"`, `"WARN"`,
    /// `"INFO"`, `"DEBUG"` or `"TRACE"`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::log::LevelFilter;
    ///
    /// assert_eq(LevelFilter::Off.as_str(), "OFF");
    /// ```
    pub fn as_str(&self) -> &str {
        LEVEL_NAMES[self.idx()]
    }

    /// Returns an iterator over the filters, from `Off` to `Trace`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::log::LevelFilter;
    ///
    /// assert_eq(LevelFilter::iter().count(), 6);
    /// ```
    pub fn iter() -> crate::vec::IntoIter<LevelFilter> {
        Vec::from([
            LevelFilter::Off,
            LevelFilter::Error,
            LevelFilter::Warn,
            LevelFilter::Info,
            LevelFilter::Debug,
            LevelFilter::Trace,
        ])
        .into_iter()
    }
}

impl PartialEq<LevelFilter> for Level {
    fn eq(&self, other: &LevelFilter) -> bool {
        self.idx() == other.idx()
    }
}

impl PartialOrd<LevelFilter> for Level {
    fn partial_cmp(&self, other: &LevelFilter) -> Option<Ordering> {
        self.idx().partial_cmp(&other.idx())
    }
}

impl PartialEq<Level> for LevelFilter {
    fn eq(&self, other: &Level) -> bool {
        self.idx() == other.idx()
    }
}

impl PartialOrd<Level> for LevelFilter {
    fn partial_cmp(&self, other: &Level) -> Option<Ordering> {
        self.idx().partial_cmp(&other.idx())
    }
}

impl Display for Level {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        f.pad(self.as_str())
    }
}

impl Display for LevelFilter {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        f.pad(self.as_str())
    }
}

impl From<Level> for LevelFilter {
    fn from(l: Level) -> LevelFilter {
        l.to_level_filter()
    }
}

/// The error of parsing a string that names no level as a [`Level`] or
/// [`LevelFilter`].
///
/// # Examples
///
/// ```
/// use std::log::{Level, ParseLevelError};
///
/// assert_eq("verbose".parse::<Level>(), Err(ParseLevelError));
/// ```
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct ParseLevelError;

impl Display for ParseLevelError {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        f.write_str("attempted to convert a string that doesn't match an existing log level")
    }
}

fn parse_level_name(s: &str) -> Option<usize> {
    let mut i = 0;
    while i < LEVEL_NAMES.len() {
        if s.eq_ignore_ascii_case(LEVEL_NAMES[i]) {
            return Some(i);
        }
        i += 1;
    }
    None
}

/// Parses a level's name, ignoring case (`"info"`, `"WARN"`...); `"off"`
/// is not a `Level`.
impl FromStr for Level {
    type Err = ParseLevelError;
    fn from_str(s: &str) -> Result<Level, ParseLevelError> {
        match parse_level_name(s) {
            Some(i) => match level_from(i) {
                Some(l) => Ok(l),
                None => Err(ParseLevelError),
            },
            None => Err(ParseLevelError),
        }
    }
}

impl FromStr for LevelFilter {
    type Err = ParseLevelError;
    fn from_str(s: &str) -> Result<LevelFilter, ParseLevelError> {
        match parse_level_name(s) {
            Some(i) => Ok(filter_from(i)),
            None => Err(ParseLevelError),
        }
    }
}

/// The most verbose level compiled in.
///
/// The log crate's features can lower it; navi always keeps every level,
/// so it is `LevelFilter::Trace`.
pub const STATIC_MAX_LEVEL: LevelFilter = LevelFilter::Trace;

// --- Records -----------------------------------------------------------------

/// The metadata of a log record: its level and target, which loggers
/// filter on.
///
/// [`Log::enabled`] receives one; [`Record::metadata`] returns a record's.
///
/// # Examples
///
/// ```
/// use std::log::{Level, Metadata};
///
/// let m = Metadata::builder().level(Level::Debug).target("net").build();
/// assert_eq(m.level(), Level::Debug);
/// assert_eq(m.target(), "net");
/// ```
#[derive(Clone, Debug)]
pub struct Metadata {
    level: Level,
    target: &str,
}

impl Metadata {
    /// Returns a builder of metadata (level `Info`, target `""`).
    pub fn builder() -> MetadataBuilder {
        MetadataBuilder {
            m: Metadata {
                level: Level::Info,
                target: "",
            },
        }
    }

    /// Returns the level.
    pub fn level(&self) -> Level {
        self.level.clone()
    }

    /// Returns the target: by default the module path of the code that
    /// logged (see [the module docs](crate::log)).
    pub fn target(&self) -> &str {
        self.target
    }
}

/// A builder of [`Metadata`], for loggers' tests and adapters.
///
/// # Examples
///
/// ```
/// use std::log::{Level, MetadataBuilder};
///
/// let m = MetadataBuilder::new().level(Level::Error).target("db").build();
/// assert_eq(m.level(), Level::Error);
/// assert_eq(m.target(), "db");
/// ```
pub struct MetadataBuilder {
    m: Metadata,
}

impl MetadataBuilder {
    /// Returns a builder with level `Info` and target `""`.
    pub fn new() -> MetadataBuilder {
        Metadata::builder()
    }

    /// Sets the level.
    pub fn level(&mut self, l: Level) -> &mut MetadataBuilder {
        self.m.level = l;
        self
    }

    /// Sets the target.
    pub fn target(&mut self, t: &str) -> &mut MetadataBuilder {
        self.m.target = t;
        self
    }

    /// Returns the metadata.
    pub fn build(&self) -> Metadata {
        self.m.clone()
    }
}

/// A log record: its metadata, its message and where it was logged.
///
/// The logging functions make one and pass it to the installed logger's
/// [`Log::log`]. The message is kept unformatted ([`args`](Record::args)):
/// writing it formats it.
///
/// # Examples
///
/// ```
/// use std::log::{Level, Record};
///
/// let r = Record::builder()
///     .level(Level::Warn)
///     .target("app::db")
///     .args(`pool at ${90}%`)
///     .line(Some(42))
///     .build();
/// assert_eq(r.level(), Level::Warn);
/// assert_eq(r.target(), "app::db");
/// assert_eq(r.args().to_string(), "pool at 90%");
/// assert_eq(r.line(), Some(42));
/// assert_eq(r.file(), None);
/// ```
#[derive(Clone)]
pub struct Record {
    metadata: Metadata,
    args: fmt::Arguments,
    module_path: Option<&str>,
    file: Option<&str>,
    line: Option<u32>,
}

impl Record {
    /// Returns a builder of a record (see [`RecordBuilder`]).
    pub fn builder() -> RecordBuilder {
        RecordBuilder::new()
    }

    /// Returns the message; it is formatted when written (as
    /// `${record.args()}`).
    pub fn args(&self) -> &fmt::Arguments {
        &self.args
    }

    /// Returns the metadata: the level and the target.
    pub fn metadata(&self) -> &Metadata {
        &self.metadata
    }

    /// Returns the level.
    pub fn level(&self) -> Level {
        self.metadata.level.clone()
    }

    /// Returns the target.
    pub fn target(&self) -> &str {
        self.metadata.target
    }

    /// Returns the module path of the code that logged, if known.
    pub fn module_path(&self) -> Option<&str> {
        self.module_path
    }

    /// Returns the source file of the code that logged, if known.
    pub fn file(&self) -> Option<&str> {
        self.file
    }

    /// Returns the line of the code that logged, if known.
    pub fn line(&self) -> Option<u32> {
        self.line
    }
}

impl Debug for Record {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        f.debug_struct("Record")
            .field("metadata", &self.metadata)
            .field("args", &self.args)
            .field("module_path", &self.module_path)
            .field("file", &self.file)
            .field("line", &self.line)
            .finish()
    }
}

/// A builder of a [`Record`], for loggers' tests and adapters.
///
/// A new builder has level `Info`, target `""`, an empty message and no
/// location.
///
/// # Examples
///
/// ```
/// use std::log::{Level, Metadata, RecordBuilder};
///
/// let m = Metadata::builder().level(Level::Error).target("net").build();
/// let r = RecordBuilder::new().metadata(m).args("reset").file(Some("src/net.navi")).build();
/// assert_eq(r.level(), Level::Error);
/// assert_eq(r.target(), "net");
/// assert_eq(r.file(), Some("src/net.navi"));
/// ```
pub struct RecordBuilder {
    r: Record,
}

impl RecordBuilder {
    /// Returns a builder with level `Info`, target `""`, an empty message
    /// and no location.
    pub fn new() -> RecordBuilder {
        RecordBuilder {
            r: Record {
                metadata: Metadata {
                    level: Level::Info,
                    target: "",
                },
                args: ``,
                module_path: None,
                file: None,
                line: None,
            },
        }
    }

    /// Sets the message.
    pub fn args(&mut self, args: impl Display) -> &mut RecordBuilder {
        self.r.args = `${args}`;
        self
    }

    /// Sets the metadata (the level and the target).
    pub fn metadata(&mut self, m: Metadata) -> &mut RecordBuilder {
        self.r.metadata = m;
        self
    }

    /// Sets the level.
    pub fn level(&mut self, l: Level) -> &mut RecordBuilder {
        self.r.metadata.level = l;
        self
    }

    /// Sets the target.
    pub fn target(&mut self, t: &str) -> &mut RecordBuilder {
        self.r.metadata.target = t;
        self
    }

    /// Sets the module path.
    pub fn module_path(&mut self, p: Option<&str>) -> &mut RecordBuilder {
        self.r.module_path = p;
        self
    }

    /// Sets the source file.
    pub fn file(&mut self, f: Option<&str>) -> &mut RecordBuilder {
        self.r.file = f;
        self
    }

    /// Sets the line.
    pub fn line(&mut self, l: Option<u32>) -> &mut RecordBuilder {
        self.r.line = l;
        self
    }

    /// Returns the record.
    pub fn build(&self) -> Record {
        self.r.clone()
    }
}

// --- Loggers -----------------------------------------------------------------

/// A logger: what [`set_logger`] installs.
///
/// The logging functions call the installed logger from every thread, so
/// an implementation that keeps state must lock it (with a
/// [`Mutex`](crate::sync::Mutex), for instance). See
/// [the module docs](crate::log) for an example.
pub trait Log {
    /// Returns `true` if a record with this metadata would be logged
    /// ([`log_enabled`](crate::log::log_enabled) asks this).
    fn enabled(&self, metadata: &Metadata) -> bool;

    /// Logs a record.
    ///
    /// A logger filters here too: the logging functions only check the
    /// maximum level ([`set_max_level`]) before calling it.
    fn log(&self, record: &Record);

    /// Flushes the records the logger buffers.
    fn flush(&self);
}

struct NopLogger;

impl Log for NopLogger {
    fn enabled(&self, metadata: &Metadata) -> bool {
        false
    }

    fn log(&self, record: &Record) {}
    fn flush(&self) {}
}

/// The error of [`set_logger`] when a logger is already installed.
#[derive(Debug, Clone)]
pub struct SetLoggerError;

impl Display for SetLoggerError {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        f.write_str("attempted to set a logger after the logging system was already initialized")
    }
}

const UNINITIALIZED: usize = 0;
const INITIALIZING: usize = 1;
const INITIALIZED: usize = 2;

static mut STATE: usize = 0;
static mut MAX_LEVEL: usize = 0;
static mut LOGGER: Option<&dyn Log> = None;

/// Installs the global logger.
///
/// A logger can be installed once per process. The log crate's
/// `set_logger` takes a `&'static dyn Log`; in navi any reference does.
/// The maximum level stays [`LevelFilter::Off`] (nothing is logged) until
/// [`set_max_level`] raises it.
///
/// # Errors
///
/// Fails if a logger is already installed (by this function, [`init`] or
/// [`Builder::init`]).
///
/// # Examples
///
/// ```no_run
/// use std::log::{self, LevelFilter, Log, Metadata, Record};
///
/// struct Stderr;
///
/// impl Log for Stderr {
///     fn enabled(&self, m: &Metadata) -> bool {
///         true
///     }
///     fn log(&self, r: &Record) {
///         eprintln(`${r.level()} ${r.target()}: ${r.args()}`);
///     }
///     fn flush(&self) {}
/// }
///
/// fn main() {
///     log::set_logger(&Stderr).unwrap();
///     log::set_max_level(LevelFilter::Info);
///     log::info("hello"); // INFO <module>: hello
/// }
/// ```
pub fn set_logger(logger: &dyn Log) -> Result<(), SetLoggerError> {
    if !crate::rt::atomic_cas(&mut STATE as *mut usize, UNINITIALIZED, INITIALIZING) {
        return Err(SetLoggerError);
    }
    LOGGER = Some(logger);
    crate::rt::atomic_store(&mut STATE as *mut usize, INITIALIZED);
    Ok(())
}

/// Returns the installed logger, or a logger that does nothing if none is
/// installed.
pub fn logger() -> &dyn Log {
    if crate::rt::atomic_load(&mut STATE as *mut usize) == INITIALIZED {
        if let Some(l) = LOGGER {
            return l;
        }
    }
    // (Bound first: navi crashes coercing a function's tail &T to &dyn.)
    let nop: &dyn Log = &NopLogger;
    nop
}

/// Sets the global maximum level: the most verbose level the logging
/// functions pass on to the logger.
///
/// Records above it are dropped before the logger sees them. It starts at
/// [`LevelFilter::Off`]; [`init`] sets it from the logger's filters.
///
/// # Examples
///
/// ```no_run
/// use std::log::{self, LevelFilter};
///
/// log::set_max_level(LevelFilter::Warn);
/// assert_eq(log::max_level(), LevelFilter::Warn);
/// ```
pub fn set_max_level(level: LevelFilter) {
    crate::rt::atomic_store(&mut MAX_LEVEL as *mut usize, level.idx());
}

/// Returns the global maximum level (see [`set_max_level`]).
///
/// # Examples
///
/// ```
/// use std::log::{self, Level};
///
/// // Nothing above the maximum level reaches the logger.
/// if Level::Debug <= log::max_level() {
///     log::debug("details");
/// }
/// ```
pub fn max_level() -> LevelFilter {
    filter_from(crate::rt::atomic_load(&mut MAX_LEVEL as *mut usize))
}

// --- Logging functions -------------------------------------------------------

/// The module path the caller's file stands for (see the module docs).
fn module_of(file: &str) -> String {
    let mut parts: Vec<&str> = Vec::new();
    for p in file.split('/') {
        for q in p.split('\\') {
            parts.push(q);
        }
    }
    let mut src = parts.len();
    let mut i = 0;
    while i < parts.len() {
        if parts[i] == "src" {
            src = i;
        }
        i += 1;
    }
    let last = parts.len() - 1;
    let stem = match parts[last].rfind('.') {
        Some(d) => &parts[last][0..d],
        None => parts[last],
    };
    if src == parts.len() {
        return stem.to_string();
    }
    let mut out = String::new();
    if src > 0 && parts[src - 1] != "." && parts[src - 1] != ".." && parts[src - 1] != "" {
        out.push_str(parts[src - 1]);
    } else {
        out.push_str(program_name().as_str());
    }
    let mut j = src + 1;
    while j < last {
        out.push_str("::");
        out.push_str(parts[j]);
        j += 1;
    }
    if last > src && !(last == src + 1 && (stem == "main" || stem == "lib")) && stem != "mod" {
        out.push_str("::");
        out.push_str(stem);
    }
    out
}

fn program_name() -> String {
    match crate::env::args().next() {
        Some(a) => {
            let s = a.as_str();
            let base = match s.rfind('/') {
                Some(i) => &s[i + 1..],
                None => s,
            };
            let base = match base.rfind('\\') {
                Some(i) => &base[i + 1..],
                None => base,
            };
            let base = match base.strip_suffix(".exe") {
                Some(b) => b,
                None => base,
            };
            base.to_string()
        }
        None => String::from("main"),
    }
}

fn emit(level: Level, target: Option<&str>, msg: impl Display, loc: Location) {
    if level.idx() > crate::rt::atomic_load(&mut MAX_LEVEL as *mut usize) {
        return;
    }
    let module = module_of(loc.file());
    let t = match target {
        Some(t) => t,
        None => module.as_str(),
    };
    let r = Record {
        metadata: Metadata { level, target: t },
        args: `${msg}`,
        module_path: Some(module.as_str()),
        file: Some(loc.file()),
        line: Some(loc.line()),
    };
    logger().log(&r);
}

/// Logs a message at the [`Level::Error`] level (the log crate's
/// `error!`).
///
/// The record's target is the caller's module path. A template string
/// argument is formatted only if the record is logged.
///
/// # Examples
///
/// ```
/// use std::log;
///
/// let path = "/etc/app.toml";
/// log::error(`cannot read ${path}`);
/// ```
#[track_caller]
pub fn error(msg: impl Display) {
    emit(Level::Error, None, msg, Location::caller());
}

/// Logs a message at the [`Level::Warn`] level (the log crate's
/// `warn!`).
///
/// The record's target is the caller's module path. A template string
/// argument is formatted only if the record is logged.
///
/// # Examples
///
/// ```
/// use std::log;
///
/// let used = 93;
/// log::warn(`disk ${used}% full`);
/// ```
#[track_caller]
pub fn warn(msg: impl Display) {
    emit(Level::Warn, None, msg, Location::caller());
}

/// Logs a message at the [`Level::Info`] level (the log crate's
/// `info!`).
///
/// The record's target is the caller's module path. A template string
/// argument is formatted only if the record is logged.
///
/// # Examples
///
/// ```
/// use std::log;
///
/// let port = 8080;
/// log::info(`listening on port ${port}`);
/// ```
#[track_caller]
pub fn info(msg: impl Display) {
    emit(Level::Info, None, msg, Location::caller());
}

/// Logs a message at the [`Level::Debug`] level (the log crate's
/// `debug!`).
///
/// The record's target is the caller's module path. A template string
/// argument is formatted only if the record is logged.
///
/// # Examples
///
/// ```
/// use std::log;
///
/// let req = Vec::from(["GET", "/"]);
/// log::debug(`request: ${req:?}`);
/// ```
#[track_caller]
pub fn debug(msg: impl Display) {
    emit(Level::Debug, None, msg, Location::caller());
}

/// Logs a message at the [`Level::Trace`] level (the log crate's
/// `trace!`).
///
/// The record's target is the caller's module path. A template string
/// argument is formatted only if the record is logged.
///
/// # Examples
///
/// ```
/// use std::log;
///
/// log::trace("entering parse");
/// ```
#[track_caller]
pub fn trace(msg: impl Display) {
    emit(Level::Trace, None, msg, Location::caller());
}

/// Logs a message at a level (the log crate's `log!`).
///
/// # Examples
///
/// ```
/// use std::log::{self, Level};
///
/// let level = if 3 > 2 { Level::Warn } else { Level::Info };
/// log::log(level, "retrying");
/// ```
#[track_caller]
pub fn log(level: Level, msg: impl Display) {
    emit(level, None, msg, Location::caller());
}

/// Logs a message at a level with an explicit target (the log crate's
/// `log!(target: "net", level, ...)`).
///
/// # Examples
///
/// ```
/// use std::log::{self, Level};
///
/// log::log_target("net", Level::Error, "connection reset");
/// ```
#[track_caller]
pub fn log_target(target: &str, level: Level, msg: impl Display) {
    emit(level, Some(target), msg, Location::caller());
}

/// Returns `true` if a message at the level would be logged from here
/// (the log crate's `log_enabled!`).
///
/// It is if the level is within the maximum level and the logger enables
/// it for the caller's module. Use it to skip computing an expensive
/// message.
///
/// # Examples
///
/// ```
/// use std::log::{self, Level};
///
/// fn expensive_dump() -> String {
///     "...".to_string()
/// }
///
/// if log::log_enabled(Level::Debug) {
///     log::debug(`state: ${expensive_dump()}`);
/// }
/// ```
#[track_caller]
pub fn log_enabled(level: Level) -> bool {
    if level.idx() > crate::rt::atomic_load(&mut MAX_LEVEL as *mut usize) {
        return false;
    }
    let module = module_of(Location::caller().file());
    logger().enabled(&Metadata {
        level,
        target: module.as_str(),
    })
}

/// Returns `true` if a message at the level with the target would be
/// logged (the log crate's `log_enabled!(target: "net", level)`).
///
/// # Examples
///
/// ```
/// use std::log::{self, Level};
///
/// if log::log_enabled_target("net", Level::Trace) {
///     log::log_target("net", Level::Trace, "packet dump");
/// }
/// ```
pub fn log_enabled_target(target: &str, level: Level) -> bool {
    if level.idx() > crate::rt::atomic_load(&mut MAX_LEVEL as *mut usize) {
        return false;
    }
    logger().enabled(&Metadata { level, target })
}
