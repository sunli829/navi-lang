//! The built-in logger, configured as env_logger: filters from `NAVI_LOG`
//! (env_logger reads `RUST_LOG`), one line a record on the standard error.

use super::{Level, LevelFilter, Log, Metadata, Record, SetLoggerError};
use crate::fmt::{self, Display};
use crate::io::{self, Write};
use crate::sync::Mutex;

/// The environment variable [`init`] and [`Builder::from_default_env`] read
/// the filters from: `NAVI_LOG` (env_logger's `RUST_LOG`).
pub const DEFAULT_FILTER_ENV: &str = "NAVI_LOG";

/// Where the built-in logger writes, set with [`Builder::target`].
///
/// # Examples
///
/// ```
/// use std::log::{Builder, Level, Log, Record, Target};
///
/// let mut out: Vec<u8> = Vec::new();
/// let logger = Builder::new().format_timestamp(None).target(Target::Pipe(&mut out)).build();
/// logger.log(&Record::builder().level(Level::Error).target("app").args("failed").build());
/// assert_eq(String::from_utf8(out).unwrap(), "[ERROR app] failed\n");
/// ```
pub enum Target {
    /// The standard output.
    Stdout,
    /// The standard error (the default).
    Stderr,
    /// Any writer (env_logger's `Pipe(Box<dyn Write + Send>)`); each
    /// record is written with one `write_all`, under a lock.
    Pipe(&mut dyn Write),
}

/// Whether to write colors, as env_logger's `WriteStyle`.
///
/// It is kept for env_logger's API: the built-in logger writes no colors,
/// whatever [`Builder::write_style`] is given.
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum WriteStyle {
    /// Colors if the output is a terminal.
    Auto,
    /// Always colors.
    Always,
    /// Never colors.
    Never,
}

/// How many decimals of seconds a [`Timestamp`] has.
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum TimestampPrecision {
    /// Whole seconds: `2024-01-02T03:04:05Z`.
    Seconds,
    /// Milliseconds: `2024-01-02T03:04:05.123Z`.
    Millis,
    /// Microseconds: `2024-01-02T03:04:05.123456Z`.
    Micros,
    /// Nanoseconds: `2024-01-02T03:04:05.123456789Z`.
    Nanos,
}

// --- Time ---------------------------------------------------------------------------

#[cfg(not(target_os = "windows"))]
#[nonblocking]
extern "C" {
    fn clock_gettime(clock: i32, ts: *mut i64) -> i32;
}

#[cfg(not(target_os = "windows"))]
fn now() -> (i64, u32) {
    let mut ts = [0i64; 2];
    unsafe {
        clock_gettime(0, &mut ts as *mut [i64; 2] as *mut i64);
    } // CLOCK_REALTIME
    (ts[0], ts[1] as u32)
}

#[cfg(target_os = "windows")]
#[nonblocking]
extern "C" {
    fn GetSystemTimePreciseAsFileTime(ft: *mut u64);
}

#[cfg(target_os = "windows")]
fn now() -> (i64, u32) {
    let mut ft = 0u64;
    unsafe {
        GetSystemTimePreciseAsFileTime(&mut ft as *mut u64);
    }
    // 100 ns intervals since 1601.
    let t = ft - 116444736000000000;
    ((t / 10000000) as i64, ((t % 10000000) * 100) as u32)
}

/// A UTC time, as the built-in logger writes it.
///
/// It is displayed as RFC 3339 (`2024-01-02T03:04:05Z`), with decimals of
/// seconds for the finer precisions.
///
/// # Examples
///
/// ```
/// use std::log::{Timestamp, TimestampPrecision};
///
/// let t = Timestamp::from_unix(1704164645, 123456789, TimestampPrecision::Seconds);
/// assert_eq(t.to_string(), "2024-01-02T03:04:05Z");
/// let t = Timestamp::from_unix(1704164645, 123456789, TimestampPrecision::Millis);
/// assert_eq(t.to_string(), "2024-01-02T03:04:05.123Z");
/// ```
#[derive(Clone, Debug)]
pub struct Timestamp {
    secs: i64,
    nanos: u32,
    precision: TimestampPrecision,
}

impl Timestamp {
    /// Returns the current time, displayed at a precision.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::log::{Timestamp, TimestampPrecision};
    ///
    /// let s = Timestamp::now(TimestampPrecision::Seconds).to_string();
    /// assert_eq(s.len(), "2024-01-02T03:04:05Z".len());
    /// assert(s.ends_with("Z"));
    /// ```
    pub fn now(precision: TimestampPrecision) -> Timestamp {
        let (secs, nanos) = now();
        Timestamp {
            secs,
            nanos,
            precision,
        }
    }

    /// Returns the time `secs` seconds and `nanos` nanoseconds after the
    /// Unix epoch, displayed at a precision.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::log::{Timestamp, TimestampPrecision};
    ///
    /// assert_eq(Timestamp::from_unix(0, 0, TimestampPrecision::Micros).to_string(), "1970-01-01T00:00:00.000000Z");
    /// ```
    pub fn from_unix(secs: i64, nanos: u32, precision: TimestampPrecision) -> Timestamp {
        Timestamp {
            secs,
            nanos,
            precision,
        }
    }
}

fn pad(out: &mut String, n: i64, width: usize) {
    let s = `${n}`.to_string();
    let mut i = s.len();
    while i < width {
        out.push('0');
        i += 1;
    }
    out.push_str(s.as_str());
}

impl Display for Timestamp {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        let days = if self.secs >= 0 {
            self.secs / 86400
        } else {
            (self.secs - 86399) / 86400
        };
        let rem = self.secs - days * 86400;
        // Civil date from days since 1970-01-01 (Howard Hinnant's algorithm).
        let z = days + 719468;
        let era = (if z >= 0 { z } else { z - 146096 }) / 146097;
        let doe = z - era * 146097;
        let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
        let mp = (5 * doy + 2) / 153;
        let d = doy - (153 * mp + 2) / 5 + 1;
        let m = if mp < 10 { mp + 3 } else { mp - 9 };
        let y = yoe + era * 400 + if m <= 2 { 1 } else { 0 };
        let mut s = String::new();
        pad(&mut s, y, 4);
        s.push('-');
        pad(&mut s, m, 2);
        s.push('-');
        pad(&mut s, d, 2);
        s.push('T');
        pad(&mut s, rem / 3600, 2);
        s.push(':');
        pad(&mut s, rem / 60 % 60, 2);
        s.push(':');
        pad(&mut s, rem % 60, 2);
        match self.precision {
            TimestampPrecision::Seconds => {}
            TimestampPrecision::Millis => {
                s.push('.');
                pad(&mut s, (self.nanos / 1000000) as i64, 3);
            }
            TimestampPrecision::Micros => {
                s.push('.');
                pad(&mut s, (self.nanos / 1000) as i64, 6);
            }
            TimestampPrecision::Nanos => {
                s.push('.');
                pad(&mut s, self.nanos as i64, 9);
            }
        }
        s.push('Z');
        f.write_str(s.as_str())
    }
}

// --- Formatting ---------------------------------------------------------------------

/// The buffer a record is formatted into, as env_logger's
/// `fmt::Formatter`.
///
/// A custom format ([`Builder::format`]) writes the whole line into it,
/// newline included; the logger then writes the buffer to its target in
/// one piece. It implements [`io::Write`](crate::io::Write).
///
/// # Examples
///
/// ```
/// use std::log::{Builder, Formatter, Level, Log, Record, Target};
/// use std::io;
///
/// fn short(buf: &mut Formatter, r: &Record) -> io::Result<()> {
///     buf.write_fmt(`${r.level()}: ${r.args()}\n`)
/// }
///
/// let mut out: Vec<u8> = Vec::new();
/// let logger = Builder::new().format(short).target(Target::Pipe(&mut out)).build();
/// logger.log(&Record::builder().level(Level::Error).args("disk full").build());
/// assert_eq(String::from_utf8(out).unwrap(), "ERROR: disk full\n");
/// ```
pub struct Formatter {
    buf: Vec<u8>,
}

impl Formatter {
    /// Writes a template string (`io::Write`'s `write_fmt`).
    pub fn write_fmt(&mut self, args: fmt::Arguments) -> io::Result<()> {
        let s = fmt::format(args);
        self.buf.extend_from_slice(s.as_bytes());
        Ok(())
    }

    /// Returns the current time, displayed to the second.
    pub fn timestamp(&self) -> Timestamp {
        Timestamp::now(TimestampPrecision::Seconds)
    }

    /// Returns the current time, displayed to the second.
    pub fn timestamp_seconds(&self) -> Timestamp {
        Timestamp::now(TimestampPrecision::Seconds)
    }

    /// Returns the current time, displayed to the millisecond.
    pub fn timestamp_millis(&self) -> Timestamp {
        Timestamp::now(TimestampPrecision::Millis)
    }

    /// Returns the current time, displayed to the microsecond.
    pub fn timestamp_micros(&self) -> Timestamp {
        Timestamp::now(TimestampPrecision::Micros)
    }

    /// Returns the current time, displayed to the nanosecond.
    pub fn timestamp_nanos(&self) -> Timestamp {
        Timestamp::now(TimestampPrecision::Nanos)
    }
}

impl Write for Formatter {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        self.buf.extend_from_slice(buf);
        Ok(buf.len())
    }
    fn flush(&mut self) -> io::Result<()> {
        Ok(())
    }
}

#[derive(Clone)]
struct Format {
    timestamp: Option<TimestampPrecision>,
    level: bool,
    target: bool,
    module_path: bool,
    indent: Option<usize>,
    suffix: &str,
    custom: Option<fn(&mut Formatter, &Record) -> io::Result<()>>,
}

impl Format {
    // env_logger's default format: [timestamp level module target] message.
    fn write(&self, buf: &mut Formatter, r: &Record) {
        let mut head = String::new();
        let mut open = |head: &mut String| {
            head.push_str(if head.len() == 0 { "[" } else { " " });
        };
        if let Some(p) = self.timestamp.clone() {
            open(&mut head);
            head.push_str(Timestamp::now(p).to_string().as_str());
        }
        if self.level {
            open(&mut head);
            head.push_str(`${r.level():<5}`.to_string().as_str());
        }
        if self.module_path {
            if let Some(m) = r.module_path() {
                open(&mut head);
                head.push_str(m);
            }
        }
        if self.target && r.target().len() > 0 {
            open(&mut head);
            head.push_str(r.target());
        }
        if head.len() > 0 {
            head.push_str("] ");
        }
        buf.buf.extend_from_slice(head.as_bytes());
        let msg = r.args().to_string();
        match self.indent {
            Some(n) => {
                let mut first = true;
                for line in msg.split('\n') {
                    if !first {
                        buf.buf.push(b'\n');
                        let mut i = 0;
                        while i < n {
                            buf.buf.push(b' ');
                            i += 1;
                        }
                    }
                    buf.buf.extend_from_slice(line.as_bytes());
                    first = false;
                }
            }
            None => buf.buf.extend_from_slice(msg.as_bytes()),
        }
        buf.buf.extend_from_slice(self.suffix.as_bytes());
    }
}

// --- Filters ------------------------------------------------------------------------

#[derive(Clone, Debug)]
struct Directive {
    name: Option<String>,
    level: LevelFilter,
}

/// Parses env_logger's filter syntax: comma-separated directives, each a
/// level, a module path (every level) or module=level, then optionally
/// /text, which messages must contain (env_logger's regex; a substring
/// here).
fn parse_spec(spec: &str, dirs: &mut Vec<Directive>) -> Option<String> {
    let parts: Vec<&str> = spec.split('/').collect();
    if parts.len() > 2 {
        crate::io::eprintln(`warning: invalid logging spec '${spec}', ignoring it (too many '/'s)`);
        return None;
    }
    for d in parts[0].split(',') {
        let d = d.trim();
        if d.len() == 0 {
            continue;
        }
        let kv: Vec<&str> = d.split('=').collect();
        if kv.len() == 1 {
            match kv[0].parse::<LevelFilter>() {
                Ok(l) => insert(dirs, None, l),
                Err(_) => insert(dirs, Some(kv[0]), LevelFilter::Trace),
            }
        } else if kv.len() == 2 && kv[1].len() == 0 {
            insert(dirs, Some(kv[0]), LevelFilter::Trace);
        } else if kv.len() == 2 {
            match kv[1].parse::<LevelFilter>() {
                Ok(l) => insert(dirs, Some(kv[0]), l),
                Err(_) => {
                    crate::io::eprintln(`warning: invalid logging spec '${kv[1]}', ignoring it`)
                }
            }
        } else {
            crate::io::eprintln(`warning: invalid logging spec '${d}', ignoring it`);
        }
    }
    if parts.len() == 2 {
        Some(parts[1].to_string())
    } else {
        None
    }
}

fn insert(dirs: &mut Vec<Directive>, name: Option<&str>, level: LevelFilter) {
    let name = match name {
        Some(n) => Some(n.to_string()),
        None => None,
    };
    for d in dirs.iter_mut() {
        if d.name == name {
            d.level = level;
            return;
        }
    }
    dirs.push(Directive { name, level });
}

// --- Builder ------------------------------------------------------------------------

/// A builder of the built-in logger, as env_logger's `Builder`.
///
/// It sets the logger's filters, format and target; [`init`](Builder::init)
/// then installs the logger, or [`build`](Builder::build) returns it.
///
/// A filter is a level for a module (records whose target starts with the
/// module's path) or for every module; the filter of the longest matching
/// module applies. Without filters, only errors are logged. The default
/// format is env_logger's: `[2024-01-02T03:04:05Z INFO  target] message`.
///
/// # Examples
///
/// A program installs the logger:
///
/// ```no_run
/// use std::log::{self, Builder, LevelFilter, Target};
///
/// Builder::new()
///     .filter_level(LevelFilter::Info)
///     .filter_module("myapp::net", LevelFilter::Trace)
///     .format_timestamp(None)
///     .target(Target::Stdout)
///     .init();
/// log::info("ready");
/// ```
///
/// A logger built without installing it can be called directly:
///
/// ```
/// use std::log::{Builder, Level, LevelFilter, Log, Record, Target};
///
/// let mut out: Vec<u8> = Vec::new();
/// let logger = Builder::new()
///     .filter_level(LevelFilter::Warn)
///     .filter_module("app::db", LevelFilter::Debug)
///     .format_timestamp(None)
///     .target(Target::Pipe(&mut out))
///     .build();
/// let rec = |level: Level, target: &str, msg: &str| -> Record {
///     Record::builder().level(level).target(target).args(msg).build()
/// };
/// logger.log(&rec(Level::Info, "app", "dropped"));
/// logger.log(&rec(Level::Warn, "app", "slow request"));
/// logger.log(&rec(Level::Debug, "app::db", "query took 3ms"));
/// assert_eq(String::from_utf8(out).unwrap(), "[WARN  app] slow request\n[DEBUG app::db] query took 3ms\n");
/// ```
pub struct Builder {
    dirs: Vec<Directive>,
    text: Option<String>,
    format: Format,
    target: Option<Target>,
    built: bool,
}

impl Builder {
    /// Returns a builder without filters (only errors are logged unless
    /// some are added), with the default format, writing to the standard
    /// error.
    pub fn new() -> Builder {
        Builder {
            dirs: Vec::new(),
            text: None,
            format: Format {
                timestamp: Some(TimestampPrecision::Seconds),
                level: true,
                target: true,
                module_path: false,
                indent: Some(4),
                suffix: "\n",
                custom: None,
            },
            target: None,
            built: false,
        }
    }

    /// Returns a builder with the filters in the environment variable
    /// `var` (none if it is not set).
    pub fn from_env(var: &str) -> Builder {
        let mut b = Builder::new();
        b.parse_env(var);
        b
    }

    /// Returns a builder with the filters in `NAVI_LOG`.
    pub fn from_default_env() -> Builder {
        Builder::from_env(DEFAULT_FILTER_ENV)
    }

    /// Adds the filters in the environment variable `var`, if it is set.
    pub fn parse_env(&mut self, var: &str) -> &mut Builder {
        if let Ok(spec) = crate::env::var(var) {
            self.parse_filters(spec.as_str());
        }
        self
    }

    /// Adds the filters in `NAVI_LOG`, if it is set.
    pub fn parse_default_env(&mut self) -> &mut Builder {
        self.parse_env(DEFAULT_FILTER_ENV)
    }

    /// Adds filters written in `NAVI_LOG`'s syntax (env_logger's).
    ///
    /// The syntax is comma-separated directives, each a level (`info`: for
    /// every module), a module path (`net::http`: every level of it) or
    /// `module=level`; then, optionally, `/text`: only messages containing
    /// the text are logged (env_logger takes a regex there; navi a
    /// substring). Invalid directives are reported on the standard error
    /// and ignored.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::log::{Builder, Level, Log, Record, Target};
    ///
    /// let mut out: Vec<u8> = Vec::new();
    /// let logger = Builder::new()
    ///     .parse_filters("warn,app::net=trace/timeout")
    ///     .format_timestamp(None)
    ///     .target(Target::Pipe(&mut out))
    ///     .build();
    /// logger.log(&Record::builder().level(Level::Trace).target("app::net").args("read timeout").build());
    /// logger.log(&Record::builder().level(Level::Trace).target("app::net").args("read 10 bytes").build());
    /// assert_eq(String::from_utf8(out).unwrap(), "[TRACE app::net] read timeout\n");
    /// ```
    pub fn parse_filters(&mut self, filters: &str) -> &mut Builder {
        let text = parse_spec(filters, &mut self.dirs);
        if text.is_some() {
            self.text = text;
        }
        self
    }

    /// Sets the level for the modules without a filter of their own.
    pub fn filter_level(&mut self, level: LevelFilter) -> &mut Builder {
        insert(&mut self.dirs, None, level);
        self
    }

    /// Sets the level for a module and its submodules (the targets that
    /// start with `module`).
    pub fn filter_module(&mut self, module: &str, level: LevelFilter) -> &mut Builder {
        insert(&mut self.dirs, Some(module), level);
        self
    }

    /// Sets the level for a module, as
    /// [`filter_module`](Builder::filter_module), or for every module if
    /// `module` is `None`, as [`filter_level`](Builder::filter_level).
    pub fn filter(&mut self, module: Option<&str>, level: LevelFilter) -> &mut Builder {
        insert(&mut self.dirs, module, level);
        self
    }

    /// Sets where the logger writes (the standard error by default).
    pub fn target(&mut self, target: Target) -> &mut Builder {
        self.target = Some(target);
        self
    }

    /// Sets whether to write colors; accepted for env_logger's API, but no
    /// colors are written.
    pub fn write_style(&mut self, style: WriteStyle) -> &mut Builder {
        self
    }

    /// Sets the precision of the timestamp at the start of each line, or
    /// `None` for no timestamp (whole seconds by default).
    pub fn format_timestamp(&mut self, precision: Option<TimestampPrecision>) -> &mut Builder {
        self.format.timestamp = precision;
        self
    }

    /// Writes timestamps to the second.
    pub fn format_timestamp_secs(&mut self) -> &mut Builder {
        self.format_timestamp(Some(TimestampPrecision::Seconds))
    }

    /// Writes timestamps to the millisecond.
    pub fn format_timestamp_millis(&mut self) -> &mut Builder {
        self.format_timestamp(Some(TimestampPrecision::Millis))
    }

    /// Writes timestamps to the microsecond.
    pub fn format_timestamp_micros(&mut self) -> &mut Builder {
        self.format_timestamp(Some(TimestampPrecision::Micros))
    }

    /// Writes timestamps to the nanosecond.
    pub fn format_timestamp_nanos(&mut self) -> &mut Builder {
        self.format_timestamp(Some(TimestampPrecision::Nanos))
    }

    /// Sets whether the default format writes the level (it does by
    /// default).
    pub fn format_level(&mut self, on: bool) -> &mut Builder {
        self.format.level = on;
        self
    }

    /// Sets whether the default format writes the target (it does by
    /// default).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::log::{Builder, Level, Log, Record, Target};
    ///
    /// let mut out: Vec<u8> = Vec::new();
    /// let logger = Builder::new()
    ///     .format_timestamp(None)
    ///     .format_target(false)
    ///     .format_level(false)
    ///     .target(Target::Pipe(&mut out))
    ///     .build();
    /// logger.log(&Record::builder().level(Level::Error).target("app").args("plain").build());
    /// assert_eq(String::from_utf8(out).unwrap(), "plain\n");
    /// ```
    pub fn format_target(&mut self, on: bool) -> &mut Builder {
        self.format.target = on;
        self
    }

    /// Sets whether the default format writes the module path, before the
    /// target (it does not by default).
    pub fn format_module_path(&mut self, on: bool) -> &mut Builder {
        self.format.module_path = on;
        self
    }

    /// Sets how many spaces indent the lines of a message after its first
    /// (4 by default), or `None` for no indentation.
    pub fn format_indent(&mut self, indent: Option<usize>) -> &mut Builder {
        self.format.indent = indent;
        self
    }

    /// Sets what the default format writes after each record (`"\n"` by
    /// default).
    pub fn format_suffix(&mut self, suffix: &str) -> &mut Builder {
        self.format.suffix = suffix;
        self
    }

    /// Sets a custom format: `f` writes the whole line of a record into the
    /// buffer, newline included (see [`Formatter`]).
    pub fn format(&mut self, f: fn(&mut Formatter, &Record) -> io::Result<()>) -> &mut Builder {
        self.format.custom = Some(f);
        self
    }

    /// Goes back to the default format.
    pub fn default_format(&mut self) -> &mut Builder {
        self.format.custom = None;
        self
    }

    /// Builds the logger, without installing it.
    ///
    /// # Panics
    ///
    /// Panics if the builder was already used (by `build`, `init` or
    /// `try_init`), as env_logger's.
    pub fn build(&mut self) -> Logger {
        if self.built {
            panic("attempted to re-use consumed builder");
        }
        self.built = true;
        let mut dirs = self.dirs.clone();
        if dirs.len() == 0 {
            dirs.push(Directive {
                name: None,
                level: LevelFilter::Error,
            });
        }
        // Shortest names first: matching walks them from the end.
        dirs.sort_by(|a, b| {
            let la = match &a.name {
                Some(n) => n.len(),
                None => 0,
            };
            let lb = match &b.name {
                Some(n) => n.len(),
                None => 0,
            };
            la.cmp(&lb)
        });
        let target = match self.target.clone() {
            Some(t) => t,
            None => Target::Stderr,
        };
        Logger {
            dirs,
            text: self.text.clone(),
            format: self.format.clone(),
            out: &Mutex::new(target),
        }
    }

    /// Builds the logger, installs it and sets the maximum level to the
    /// most verbose level of its filters.
    ///
    /// # Errors
    ///
    /// Fails if a logger is already installed.
    pub fn try_init(&mut self) -> Result<(), SetLoggerError> {
        let logger = self.build();
        let max = logger.filter();
        let r = super::set_logger(&logger);
        if r.is_ok() {
            super::set_max_level(max);
        }
        r
    }

    /// Builds the logger, installs it and sets the maximum level, as
    /// [`try_init`](Builder::try_init).
    ///
    /// # Panics
    ///
    /// Panics if a logger is already installed.
    pub fn init(&mut self) {
        if let Err(e) = self.try_init() {
            panic(`Builder::init should not be called after logger initialized: ${e}`);
        }
    }
}

impl Clone for Target {
    fn clone(&self) -> Target {
        match self {
            Target::Stdout => Target::Stdout,
            Target::Stderr => Target::Stderr,
            Target::Pipe(w) => Target::Pipe(*w),
        }
    }
}

/// Installs the built-in logger with the filters in `NAVI_LOG`, as
/// env_logger's `init`.
///
/// If `NAVI_LOG` is not set, only errors are logged. Call it once, early
/// in `main`.
///
/// # Panics
///
/// Panics if a logger is already installed.
///
/// # Examples
///
/// ```no_run
/// use std::log;
///
/// fn main() {
///     log::init(); // run with NAVI_LOG=info to see the message
///     log::info("starting up");
/// }
/// ```
pub fn init() {
    Builder::from_default_env().init();
}

/// Installs the built-in logger with the filters in `NAVI_LOG`, as
/// [`init`], returning an error instead of panicking.
///
/// # Errors
///
/// Fails if a logger is already installed.
pub fn try_init() -> Result<(), SetLoggerError> {
    Builder::from_default_env().try_init()
}

// --- Logger -------------------------------------------------------------------------

/// The built-in logger, as env_logger's `Logger`, made by
/// [`Builder::build`].
///
/// It implements [`Log`]: it filters records by their target and level
/// (and text), formats them and writes each one to its target in one
/// piece.
pub struct Logger {
    dirs: Vec<Directive>,
    text: Option<String>,
    format: Format,
    out: &Mutex<Target>,
}

impl Logger {
    /// Returns a logger with the filters in `NAVI_LOG`.
    pub fn from_default_env() -> Logger {
        Builder::from_default_env().build()
    }

    /// Returns the most verbose level any of its filters lets through (what
    /// [`Builder::init`] sets the maximum level to).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::log::{Builder, LevelFilter};
    ///
    /// let logger = Builder::new().parse_filters("warn,db=debug").build();
    /// assert_eq(logger.filter(), LevelFilter::Debug);
    /// assert_eq(Builder::new().build().filter(), LevelFilter::Error);
    /// ```
    pub fn filter(&self) -> LevelFilter {
        let mut max = LevelFilter::Off;
        for d in self.dirs.iter() {
            if d.level > max {
                max = d.level.clone();
            }
        }
        max
    }

    /// Returns `true` if the record passes the filters (its level and
    /// target, and the text filter if there is one).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::log::{Builder, Level, Record};
    ///
    /// let logger = Builder::new().parse_filters("info").build();
    /// assert(logger.matches(&Record::builder().level(Level::Warn).build()));
    /// assert(!logger.matches(&Record::builder().level(Level::Debug).build()));
    /// ```
    pub fn matches(&self, r: &Record) -> bool {
        if !self.enabled(r.metadata()) {
            return false;
        }
        match &self.text {
            Some(t) => r.args().to_string().contains(t.as_str()),
            None => true,
        }
    }
}

impl Log for Logger {
    fn enabled(&self, m: &Metadata) -> bool {
        let level = m.level();
        let target = m.target();
        let mut i = self.dirs.len();
        while i > 0 {
            i -= 1;
            let d = &self.dirs[i];
            match &d.name {
                Some(n) => {
                    if target.starts_with(n.as_str()) {
                        return level <= d.level;
                    }
                }
                None => return level <= d.level,
            }
        }
        false
    }

    fn log(&self, r: &Record) {
        if !self.matches(r) {
            return;
        }
        let mut buf = Formatter { buf: Vec::new() };
        match self.format.custom {
            Some(f) => {
                if f(&mut buf, r).is_err() {
                    return;
                }
            }
            None => self.format.write(&mut buf, r),
        }
        let bytes = buf.buf;
        self.out.with_lock(|t: &mut Target| {
            let _ = match t {
                Target::Stdout => io::stdout().write_all(bytes.as_slice()),
                Target::Stderr => io::stderr().write_all(bytes.as_slice()),
                Target::Pipe(w) => w.write_all(bytes.as_slice()),
            };
        });
    }

    fn flush(&self) {
        self.out.with_lock(|t: &mut Target| {
            let _ = match t {
                Target::Stdout => io::stdout().flush(),
                Target::Stderr => io::stderr().flush(),
                Target::Pipe(w) => w.flush(),
            };
        });
    }
}
