//! The built-in logger, configured as env_logger: filters from NAVI_LOG
//! (env_logger reads RUST_LOG), one line a record on the standard error.

use crate::fmt::{self, Display};
use crate::io::{self, Write};
use crate::sync::Mutex;
use super::{Level, LevelFilter, Log, Metadata, Record, SetLoggerError};

/// The environment variable log::init reads.
pub const DEFAULT_FILTER_ENV: &str = "NAVI_LOG";

/// Where the logger writes.
pub enum Target {
    Stdout,
    Stderr,
    /// Any writer (env_logger's Pipe(Box<dyn Write + Send>)).
    Pipe(&mut dyn Write),
}

/// Kept for env_logger's API; the built-in logger writes no colors.
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum WriteStyle { Auto, Always, Never }

/// How many decimals of seconds timestamps have.
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum TimestampPrecision { Seconds, Millis, Micros, Nanos }

// --- Time ---------------------------------------------------------------------------

#[cfg(not(target_os = "windows"))]
extern "C" {
    fn clock_gettime(clock: i32, ts: *mut i64) -> i32;
}

#[cfg(not(target_os = "windows"))]
fn now() -> (i64, u32) {
    let mut ts = [0i64; 2];
    unsafe { clock_gettime(0, &mut ts as *mut [i64; 2] as *mut i64); } // CLOCK_REALTIME
    (ts[0], ts[1] as u32)
}

#[cfg(target_os = "windows")]
extern "C" {
    fn GetSystemTimePreciseAsFileTime(ft: *mut u64);
}

#[cfg(target_os = "windows")]
fn now() -> (i64, u32) {
    let mut ft = 0u64;
    unsafe { GetSystemTimePreciseAsFileTime(&mut ft as *mut u64); }
    // 100 ns intervals since 1601.
    let t = ft - 116444736000000000;
    ((t / 10000000) as i64, ((t % 10000000) * 100) as u32)
}

/// A UTC time, displayed as RFC 3339 (2024-01-02T03:04:05Z, with
/// decimals for the finer precisions).
#[derive(Clone, Debug)]
pub struct Timestamp {
    secs: i64,
    nanos: u32,
    precision: TimestampPrecision,
}

impl Timestamp {
    pub fn now(precision: TimestampPrecision) -> Timestamp {
        let (secs, nanos) = now();
        Timestamp { secs, nanos, precision }
    }

    /// The time at secs and nanos since the Unix epoch.
    pub fn from_unix(secs: i64, nanos: u32, precision: TimestampPrecision) -> Timestamp { Timestamp { secs, nanos, precision } }
}

fn pad(out: &mut String, n: i64, width: usize) {
    let s = `${n}`;
    let mut i = s.len();
    while i < width {
        out.push('0');
        i += 1;
    }
    out.push_str(s.as_str());
}

impl Display for Timestamp {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        let days = if self.secs >= 0 { self.secs / 86400 } else { (self.secs - 86399) / 86400 };
        let rem = self.secs - days * 86400;
        // Civil date from days since 1970-01-01 (Howard Hinnant's algorithm).
        let z = days + 719468;
        let era = (if z >= 0 { z } else { z - 146096 }) / 146097;
        let doe = z - era * 146097;
        let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
        let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
        let mp = (5 * doy + 2) / 153;
        let d = doy - (153 * mp + 2) / 5 + 1;
        let m = if mp < 10 { mp + 3 } else { mp - 9 };
        let y = yoe + era * 400 + if m <= 2 { 1 } else { 0 };
        let mut s = String::new();
        pad(&mut s, y, 4);
        s.push('-');
        pad(&mut s, m, 2);
        s.push('-');
        pad(&mut s, d, 2);
        s.push('T');
        pad(&mut s, rem / 3600, 2);
        s.push(':');
        pad(&mut s, rem / 60 % 60, 2);
        s.push(':');
        pad(&mut s, rem % 60, 2);
        match self.precision {
            TimestampPrecision::Seconds => {}
            TimestampPrecision::Millis => {
                s.push('.');
                pad(&mut s, (self.nanos / 1000000) as i64, 3);
            }
            TimestampPrecision::Micros => {
                s.push('.');
                pad(&mut s, (self.nanos / 1000) as i64, 6);
            }
            TimestampPrecision::Nanos => {
                s.push('.');
                pad(&mut s, self.nanos as i64, 9);
            }
        }
        s.push('Z');
        f.write_str(s.as_str())
    }
}

// --- Formatting ---------------------------------------------------------------------

/// The buffer a record is formatted into (env_logger::fmt::Formatter):
/// custom formats write the whole line, newline included.
///
///     log::Builder::new().format(|buf, r| buf.write_fmt(`${r.level()}: ${r.args()}\n`))
pub struct Formatter {
    buf: Vec<u8>,
}

impl Formatter {
    /// Writes a template string (io::Write's write_fmt).
    pub fn write_fmt(&mut self, args: fmt::Arguments) -> io::Result<()> {
        let s = fmt::format(args);
        self.buf.extend_from_slice(s.as_bytes());
        Ok(())
    }

    /// The current time, to seconds.
    pub fn timestamp(&self) -> Timestamp { Timestamp::now(TimestampPrecision::Seconds) }
    pub fn timestamp_seconds(&self) -> Timestamp { Timestamp::now(TimestampPrecision::Seconds) }
    pub fn timestamp_millis(&self) -> Timestamp { Timestamp::now(TimestampPrecision::Millis) }
    pub fn timestamp_micros(&self) -> Timestamp { Timestamp::now(TimestampPrecision::Micros) }
    pub fn timestamp_nanos(&self) -> Timestamp { Timestamp::now(TimestampPrecision::Nanos) }
}

impl Write for Formatter {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        self.buf.extend_from_slice(buf);
        Ok(buf.len())
    }
    fn flush(&mut self) -> io::Result<()> { Ok(()) }
}

#[derive(Clone)]
struct Format {
    timestamp: Option<TimestampPrecision>,
    level: bool,
    target: bool,
    module_path: bool,
    indent: Option<usize>,
    suffix: &str,
    custom: Option<fn(&mut Formatter, &Record) -> io::Result<()>>,
}

impl Format {
    // env_logger's default format: [timestamp level module target] message.
    fn write(&self, buf: &mut Formatter, r: &Record) {
        let mut head = String::new();
        let mut open = |head: &mut String| { head.push_str(if head.len() == 0 { "[" } else { " " }); };
        if let Some(p) = self.timestamp.clone() {
            open(&mut head);
            head.push_str(Timestamp::now(p).to_string().as_str());
        }
        if self.level {
            open(&mut head);
            head.push_str(`${r.level():<5}`.as_str());
        }
        if self.module_path {
            if let Some(m) = r.module_path() {
                open(&mut head);
                head.push_str(m);
            }
        }
        if self.target && r.target().len() > 0 {
            open(&mut head);
            head.push_str(r.target());
        }
        if head.len() > 0 { head.push_str("] "); }
        buf.buf.extend_from_slice(head.as_bytes());
        let msg = r.args().to_string();
        match self.indent {
            Some(n) => {
                let mut first = true;
                for line in msg.split('\n') {
                    if !first {
                        buf.buf.push(b'\n');
                        let mut i = 0;
                        while i < n {
                            buf.buf.push(b' ');
                            i += 1;
                        }
                    }
                    buf.buf.extend_from_slice(line.as_bytes());
                    first = false;
                }
            }
            None => buf.buf.extend_from_slice(msg.as_bytes()),
        }
        buf.buf.extend_from_slice(self.suffix.as_bytes());
    }
}

// --- Filters ------------------------------------------------------------------------

#[derive(Clone, Debug)]
struct Directive {
    name: Option<String>,
    level: LevelFilter,
}

/// Parses env_logger's filter syntax: comma-separated directives, each a
/// level, a module path (every level) or module=level, then optionally
/// /text, which messages must contain (env_logger's regex; a substring
/// here).
fn parse_spec(spec: &str, dirs: &mut Vec<Directive>) -> Option<String> {
    let parts: Vec<&str> = spec.split('/').collect();
    if parts.len() > 2 {
        crate::io::eprintln(`warning: invalid logging spec '${spec}', ignoring it (too many '/'s)`);
        return None;
    }
    for d in parts[0].split(',') {
        let d = d.trim();
        if d.len() == 0 { continue; }
        let kv: Vec<&str> = d.split('=').collect();
        if kv.len() == 1 {
            match kv[0].parse::<LevelFilter>() {
                Ok(l) => insert(dirs, None, l),
                Err(_) => insert(dirs, Some(kv[0]), LevelFilter::Trace),
            }
        } else if kv.len() == 2 && kv[1].len() == 0 {
            insert(dirs, Some(kv[0]), LevelFilter::Trace);
        } else if kv.len() == 2 {
            match kv[1].parse::<LevelFilter>() {
                Ok(l) => insert(dirs, Some(kv[0]), l),
                Err(_) => crate::io::eprintln(`warning: invalid logging spec '${kv[1]}', ignoring it`),
            }
        } else {
            crate::io::eprintln(`warning: invalid logging spec '${d}', ignoring it`);
        }
    }
    if parts.len() == 2 { Some(parts[1].to_string()) } else { None }
}

fn insert(dirs: &mut Vec<Directive>, name: Option<&str>, level: LevelFilter) {
    let name = match name { Some(n) => Some(n.to_string()), None => None };
    for d in dirs.iter_mut() {
        if d.name == name {
            d.level = level;
            return;
        }
    }
    dirs.push(Directive { name, level });
}

// --- Builder ------------------------------------------------------------------------

/// Configures the built-in logger (env_logger::Builder).
///
///     log::Builder::new()
///         .filter_level(log::LevelFilter::Info)
///         .filter_module("net", log::LevelFilter::Trace)
///         .format_timestamp(None)
///         .target(log::Target::Stdout)
///         .init();
pub struct Builder {
    dirs: Vec<Directive>,
    text: Option<String>,
    format: Format,
    target: Option<Target>,
    built: bool,
}

impl Builder {
    /// No filters (only errors are logged unless some are added) and the
    /// default format, writing to the standard error.
    pub fn new() -> Builder {
        Builder {
            dirs: Vec::new(),
            text: None,
            format: Format { timestamp: Some(TimestampPrecision::Seconds), level: true, target: true, module_path: false, indent: Some(4), suffix: "\n", custom: None },
            target: None,
            built: false,
        }
    }

    /// A builder with the filters in the environment variable var.
    pub fn from_env(var: &str) -> Builder {
        let mut b = Builder::new();
        b.parse_env(var);
        b
    }

    /// A builder with the filters in NAVI_LOG.
    pub fn from_default_env() -> Builder { Builder::from_env(DEFAULT_FILTER_ENV) }

    /// Adds the filters in the environment variable var (if it is set).
    pub fn parse_env(&mut self, var: &str) -> &mut Builder {
        if let Ok(spec) = crate::env::var(var) { self.parse_filters(spec.as_str()); }
        self
    }

    pub fn parse_default_env(&mut self) -> &mut Builder { self.parse_env(DEFAULT_FILTER_ENV) }

    /// Adds filters in NAVI_LOG's syntax: "info", "net=debug,warn",
    /// "net::http", "warn/timeout".
    pub fn parse_filters(&mut self, filters: &str) -> &mut Builder {
        let text = parse_spec(filters, &mut self.dirs);
        if text.is_some() { self.text = text; }
        self
    }

    /// The level for every module without its own filter.
    pub fn filter_level(&mut self, level: LevelFilter) -> &mut Builder {
        insert(&mut self.dirs, None, level);
        self
    }

    /// The level for a module and its submodules (targets starting with
    /// module).
    pub fn filter_module(&mut self, module: &str, level: LevelFilter) -> &mut Builder {
        insert(&mut self.dirs, Some(module), level);
        self
    }

    /// filter_module, or filter_level for None.
    pub fn filter(&mut self, module: Option<&str>, level: LevelFilter) -> &mut Builder {
        insert(&mut self.dirs, module, level);
        self
    }

    pub fn target(&mut self, target: Target) -> &mut Builder {
        self.target = Some(target);
        self
    }

    /// Accepted for env_logger's API (no colors are written).
    pub fn write_style(&mut self, style: WriteStyle) -> &mut Builder { self }

    /// Timestamps at a precision, or none.
    pub fn format_timestamp(&mut self, precision: Option<TimestampPrecision>) -> &mut Builder {
        self.format.timestamp = precision;
        self
    }

    pub fn format_timestamp_secs(&mut self) -> &mut Builder { self.format_timestamp(Some(TimestampPrecision::Seconds)) }
    pub fn format_timestamp_millis(&mut self) -> &mut Builder { self.format_timestamp(Some(TimestampPrecision::Millis)) }
    pub fn format_timestamp_micros(&mut self) -> &mut Builder { self.format_timestamp(Some(TimestampPrecision::Micros)) }
    pub fn format_timestamp_nanos(&mut self) -> &mut Builder { self.format_timestamp(Some(TimestampPrecision::Nanos)) }

    pub fn format_level(&mut self, on: bool) -> &mut Builder {
        self.format.level = on;
        self
    }

    pub fn format_target(&mut self, on: bool) -> &mut Builder {
        self.format.target = on;
        self
    }

    pub fn format_module_path(&mut self, on: bool) -> &mut Builder {
        self.format.module_path = on;
        self
    }

    /// Indents the lines after the first of a message by n spaces (4 by
    /// default), or not at all.
    pub fn format_indent(&mut self, indent: Option<usize>) -> &mut Builder {
        self.format.indent = indent;
        self
    }

    /// What ends a record ("\n").
    pub fn format_suffix(&mut self, suffix: &str) -> &mut Builder {
        self.format.suffix = suffix;
        self
    }

    /// A custom format: f writes the whole line into the buffer.
    pub fn format(&mut self, f: fn(&mut Formatter, &Record) -> io::Result<()>) -> &mut Builder {
        self.format.custom = Some(f);
        self
    }

    /// Back to the default format.
    pub fn default_format(&mut self) -> &mut Builder {
        self.format.custom = None;
        self
    }

    /// The logger (once per builder, as env_logger).
    pub fn build(&mut self) -> Logger {
        if self.built { panic("attempted to re-use consumed builder"); }
        self.built = true;
        let mut dirs = self.dirs.clone();
        if dirs.len() == 0 { dirs.push(Directive { name: None, level: LevelFilter::Error }); }
        // Shortest names first: matching walks them from the end.
        dirs.sort_by(|a, b| {
            let la = match &a.name { Some(n) => n.len(), None => 0 };
            let lb = match &b.name { Some(n) => n.len(), None => 0 };
            la.cmp(&lb)
        });
        let target = match self.target.clone() { Some(t) => t, None => Target::Stderr };
        Logger { dirs, text: self.text.clone(), format: self.format.clone(), out: &Mutex::new(target) }
    }

    /// Installs the logger and sets the maximum level to its filter's;
    /// fails if a logger is installed.
    pub fn try_init(&mut self) -> Result<(), SetLoggerError> {
        let logger = self.build();
        let max = logger.filter();
        let r = super::set_logger(&logger);
        if r.is_ok() { super::set_max_level(max); }
        r
    }

    /// try_init, panicking if a logger is installed.
    pub fn init(&mut self) {
        if let Err(e) = self.try_init() { panic(`Builder::init should not be called after logger initialized: ${e}`); }
    }
}

impl Clone for Target {
    fn clone(&self) -> Target {
        match self {
            Target::Stdout => Target::Stdout,
            Target::Stderr => Target::Stderr,
            Target::Pipe(w) => Target::Pipe(*w),
        }
    }
}

/// Installs the built-in logger with the filters in NAVI_LOG (only errors
/// if it is unset), as env_logger::init. Panics if a logger is installed.
pub fn init() { Builder::from_default_env().init(); }

/// init, failing instead of panicking if a logger is installed.
pub fn try_init() -> Result<(), SetLoggerError> { Builder::from_default_env().try_init() }

// --- Logger -------------------------------------------------------------------------

/// The built-in logger (env_logger::Logger).
pub struct Logger {
    dirs: Vec<Directive>,
    text: Option<String>,
    format: Format,
    out: &Mutex<Target>,
}

impl Logger {
    /// A logger with the filters in NAVI_LOG.
    pub fn from_default_env() -> Logger { Builder::from_default_env().build() }

    /// The most verbose level any filter lets through.
    pub fn filter(&self) -> LevelFilter {
        let mut max = LevelFilter::Off;
        for d in self.dirs.iter() {
            if d.level > max { max = d.level.clone(); }
        }
        max
    }

    /// Whether the record passes the filters.
    pub fn matches(&self, r: &Record) -> bool {
        if !self.enabled(r.metadata()) { return false; }
        match &self.text {
            Some(t) => r.args().to_string().contains(t.as_str()),
            None => true,
        }
    }
}

impl Log for Logger {
    fn enabled(&self, m: &Metadata) -> bool {
        let level = m.level();
        let target = m.target();
        let mut i = self.dirs.len();
        while i > 0 {
            i -= 1;
            let d = &self.dirs[i];
            match &d.name {
                Some(n) => { if target.starts_with(n.as_str()) { return level <= d.level; } }
                None => return level <= d.level,
            }
        }
        false
    }

    fn log(&self, r: &Record) {
        if !self.matches(r) { return; }
        let mut buf = Formatter { buf: Vec::new() };
        match self.format.custom {
            Some(f) => { if f(&mut buf, r).is_err() { return; } }
            None => self.format.write(&mut buf, r),
        }
        let bytes = buf.buf;
        self.out.with_lock(|t: &mut Target| {
            let _ = match t {
                Target::Stdout => io::stdout().write_all(bytes.as_slice()),
                Target::Stderr => io::stderr().write_all(bytes.as_slice()),
                Target::Pipe(w) => w.write_all(bytes.as_slice()),
            };
        });
    }

    fn flush(&self) {
        self.out.with_lock(|t: &mut Target| {
            let _ = match t {
                Target::Stdout => io::stdout().flush(),
                Target::Stderr => io::stderr().flush(),
                Target::Pipe(w) => w.flush(),
            };
        });
    }
}
