//! Encoding and decoding base64 (RFC 4648), with the API of Rust's
//! `base64` crate (0.22).
//!
//! An [`Engine`](crate::base64::engine::Engine) encodes and decodes; the
//! usual engines are constants in [`crate::base64::engine::general_purpose`],
//! and [`crate::base64::prelude`] brings the trait and the four common
//! engines into scope:
//!
//! | Engine | Alphabet | Padding |
//! |---|---|---|
//! | `BASE64_STANDARD` | `A-Z a-z 0-9 + /` | `=` written, required |
//! | `BASE64_STANDARD_NO_PAD` | `A-Z a-z 0-9 + /` | none written, none allowed |
//! | `BASE64_URL_SAFE` | `A-Z a-z 0-9 - _` | `=` written, required |
//! | `BASE64_URL_SAFE_NO_PAD` | `A-Z a-z 0-9 - _` | none written, none allowed |
//!
//! Inputs are anything that is `AsRef<[u8]>` (`&str`, `String`, `&[u8]`,
//! `Vec<u8>`). Decoding is strict as in the crate: no whitespace, the
//! padding as the engine's
//! [`DecodePaddingMode`](crate::base64::engine::DecodePaddingMode) says, and no
//! stray bits in the last symbol.
//!
//! # Examples
//!
//! ```
//! use std::base64::prelude::*;
//!
//! assert_eq(BASE64_STANDARD.encode(b"hello"), "aGVsbG8=");
//! assert_eq(BASE64_STANDARD.decode("aGVsbG8=").unwrap(), b"hello");
//! assert_eq(BASE64_STANDARD.encode(b"\xfb\xff"), "+/8=");
//! assert_eq(BASE64_URL_SAFE_NO_PAD.encode(b"\xfb\xff"), "-_8");
//! ```
//!
//! Custom engines combine an [`alphabet`](crate::base64::alphabet) and a
//! config:
//!
//! ```
//! use std::base64::{alphabet, engine::{self, general_purpose, Engine}};
//!
//! let e = engine::GeneralPurpose::new(&alphabet::CRYPT, general_purpose::NO_PAD);
//! assert_eq(e.encode(b"hello"), "O4JgP4w");
//! assert_eq(e.decode("O4JgP4w").unwrap(), b"hello");
//! ```

use crate::fmt::{self, Debug, Display, Formatter};
use crate::string::String;

pub use self::engine::Engine;

/// The error returned when base64 input cannot be decoded.
///
/// Offsets are byte offsets in the input.
///
/// # Examples
///
/// ```
/// use std::base64::{prelude::*, DecodeError};
///
/// assert_eq(BASE64_STANDARD.decode("aGVsbG8*"), Err(DecodeError::InvalidByte(7, b'*')));
/// assert_eq(BASE64_STANDARD.decode("aGVsbG8"), Err(DecodeError::InvalidPadding));
/// assert_eq(BASE64_STANDARD_NO_PAD.decode("aGVsbG8="), Err(DecodeError::InvalidPadding));
/// assert_eq(BASE64_STANDARD.decode("aGVsbG9="), Err(DecodeError::InvalidLastSymbol(6, b'9')));
/// assert_eq(BASE64_STANDARD.decode("aGVsbG8*").unwrap_err().to_string(), "Invalid symbol 42, offset 7.");
/// ```
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum DecodeError {
    /// A byte that is not a symbol of the alphabet, at an offset (padding
    /// in the wrong place is reported this way too).
    InvalidByte(usize, u8),
    /// The number of symbols (the field) leaves a single symbol in the
    /// last group of four, which cannot encode a byte.
    InvalidLength(usize),
    /// The last symbol (offset, byte) has bits set that do not belong to
    /// any decoded byte, so the input is not the canonical encoding of
    /// anything.
    InvalidLastSymbol(usize, u8),
    /// The padding is missing, present when it must not be, or too short.
    InvalidPadding,
}

impl Display for DecodeError {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        match self {
            DecodeError::InvalidByte(i, b) => f.write_fmt(`Invalid symbol ${*b}, offset ${*i}.`),
            DecodeError::InvalidLength(n) => f.write_fmt(`Invalid input length: ${*n}`),
            DecodeError::InvalidLastSymbol(i, b) => {
                f.write_fmt(`Invalid last symbol ${*b}, offset ${*i}.`)
            }
            DecodeError::InvalidPadding => f.write_str("Invalid padding"),
        }
    }
}

/// The error returned by
/// [`Engine::decode_slice`](engine::Engine::decode_slice).
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum DecodeSliceError {
    /// The input is not valid base64.
    DecodeError(DecodeError),
    /// The decoded bytes do not fit in the output slice.
    OutputSliceTooSmall,
}

impl Display for DecodeSliceError {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        match self {
            DecodeSliceError::DecodeError(e) => Display::fmt(e, f),
            DecodeSliceError::OutputSliceTooSmall => f.write_str("Output slice too small"),
        }
    }
}

impl From<DecodeError> for DecodeSliceError {
    fn from(e: DecodeError) -> DecodeSliceError {
        DecodeSliceError::DecodeError(e)
    }
}

/// The error returned by
/// [`Engine::encode_slice`](engine::Engine::encode_slice).
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum EncodeSliceError {
    /// The encoding does not fit in the output slice.
    OutputSliceTooSmall,
}

impl Display for EncodeSliceError {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("Output slice too small")
    }
}

/// Returns the length of the base64 encoding of `bytes_len` bytes, with or
/// without padding, or `None` if it overflows a `usize`.
///
/// # Examples
///
/// ```
/// use std::base64::encoded_len;
///
/// assert_eq(encoded_len(5, true), Some(8));
/// assert_eq(encoded_len(5, false), Some(7));
/// assert_eq(encoded_len(usize::MAX, true), None);
/// ```
pub fn encoded_len(bytes_len: usize, padding: bool) -> Option<usize> {
    let quads = bytes_len / 3;
    let rem = bytes_len % 3;
    let full = quads.checked_mul(4)?;
    if rem == 0 {
        return Some(full);
    }
    if padding {
        full.checked_add(4)
    } else {
        full.checked_add(rem + 1)
    }
}

/// Returns an upper bound of the number of bytes that `encoded_len`
/// base64 symbols decode to (good for sizing a buffer).
///
/// # Examples
///
/// ```
/// use std::base64::decoded_len_estimate;
///
/// assert_eq(decoded_len_estimate(8), 6); // "aGVsbG8=" is 5 bytes
/// assert_eq(decoded_len_estimate(7), 6);
/// ```
pub fn decoded_len_estimate(encoded_len: usize) -> usize {
    (encoded_len + 3) / 4 * 3
}

/// Alphabets: the 64 symbols an engine encodes with.
pub mod alphabet {
    use crate::fmt::{self, Display, Formatter};

    /// An alphabet: 64 distinct printable ASCII bytes other than `=`, the
    /// symbols for the values 0 to 63.
    ///
    /// Use one of the constants of this module, or make one with
    /// [`Alphabet::new`].
    #[derive(Clone, Debug, PartialEq, Eq)]
    pub struct Alphabet {
        pub(crate) symbols: [u8; 64],
    }

    /// The error returned by [`Alphabet::new`] when a string is not an
    /// alphabet.
    #[derive(Clone, Debug, PartialEq, Eq)]
    pub enum ParseAlphabetError {
        /// The string is not 64 bytes long.
        InvalidLength,
        /// The byte occurs twice.
        DuplicatedByte(u8),
        /// The byte is outside of the printable ASCII range.
        UnprintableByte(u8),
        /// The byte is the padding byte `=`.
        ReservedByte(u8),
    }

    impl Display for ParseAlphabetError {
        fn fmt(&self, f: &mut Formatter) -> fmt::Result {
            match self {
                ParseAlphabetError::InvalidLength => {
                    f.write_str("Invalid length - must be 64 bytes")
                }
                ParseAlphabetError::DuplicatedByte(b) => f.write_fmt(`Duplicated byte: ${*b:#x}`),
                ParseAlphabetError::UnprintableByte(b) => f.write_fmt(`Unprintable byte: ${*b:#x}`),
                ParseAlphabetError::ReservedByte(b) => f.write_fmt(`Reserved byte: ${*b:#x}`),
            }
        }
    }

    const fn from_bytes(s: &[u8]) -> Alphabet {
        let mut symbols = [0u8; 64];
        let mut i = 0;
        while i < 64 {
            symbols[i] = s[i];
            i += 1;
        }
        Alphabet { symbols }
    }

    impl Alphabet {
        /// Creates an alphabet from 64 distinct printable ASCII bytes other
        /// than `=`, the symbols for 0 to 63 in order.
        ///
        /// # Errors
        ///
        /// A [`ParseAlphabetError`] if `alphabet` is not 64 bytes long or
        /// has a byte twice, a byte that is not printable ASCII, or `=`.
        ///
        /// # Examples
        ///
        /// ```
        /// use std::base64::alphabet::{self, Alphabet, ParseAlphabetError};
        ///
        /// let a = Alphabet::new("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_").unwrap();
        /// assert_eq(a, alphabet::URL_SAFE);
        /// assert_eq(Alphabet::new("abc"), Err(ParseAlphabetError::InvalidLength));
        /// ```
        pub fn new(alphabet: &str) -> Result<Alphabet, ParseAlphabetError> {
            let b = alphabet.as_bytes();
            if b.len() != 64 {
                return Err(ParseAlphabetError::InvalidLength);
            }
            let mut i = 0;
            while i < 64 {
                let c = b[i];
                if c < 32 || c > 126 {
                    return Err(ParseAlphabetError::UnprintableByte(c));
                }
                if c == b'=' {
                    return Err(ParseAlphabetError::ReservedByte(c));
                }
                let mut j = 0;
                while j < i {
                    if b[j] == c {
                        return Err(ParseAlphabetError::DuplicatedByte(c));
                    }
                    j += 1;
                }
                i += 1;
            }
            Ok(from_bytes(b))
        }

        /// Returns the 64 symbols, in order.
        ///
        /// # Examples
        ///
        /// ```
        /// use std::base64::alphabet;
        ///
        /// assert(alphabet::STANDARD.as_str().starts_with("ABC"));
        /// assert(alphabet::STANDARD.as_str().ends_with("+/"));
        /// ```
        pub fn as_str(&self) -> &str {
            unsafe { crate::str::from_utf8_unchecked(&self.symbols) }
        }
    }

    /// RFC 4648's standard alphabet: A-Z a-z 0-9 + /.
    pub const STANDARD: Alphabet =
        from_bytes(b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/");
    /// RFC 4648's URL- and filename-safe alphabet: A-Z a-z 0-9 - _.
    pub const URL_SAFE: Alphabet =
        from_bytes(b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_");
    /// The crypt(3) alphabet: . / 0-9 A-Z a-z.
    pub const CRYPT: Alphabet =
        from_bytes(b"./0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz");
    /// The bcrypt alphabet: . / A-Z a-z 0-9.
    pub const BCRYPT: Alphabet =
        from_bytes(b"./ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789");
    /// IMAP's modified UTF-7 alphabet (RFC 3501): A-Z a-z 0-9 + ,.
    pub const IMAP_MUTF7: Alphabet =
        from_bytes(b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+,");
    /// The BinHex 4.0 alphabet.
    pub const BIN_HEX: Alphabet =
        from_bytes(b"!\"#$%&'()*+,-012345689@ABCDEFGHIJKLMNPQRSTUVXYZ[`abcdefhijklmpqr");
}

/// Engines: the [`Engine`] trait and the [`GeneralPurpose`] engine.
pub mod engine {
    use super::alphabet::Alphabet;
    use super::{DecodeError, DecodeSliceError, EncodeSliceError};
    use crate::string::String;

    /// How decoding treats `=` padding.
    #[derive(Clone, Debug, PartialEq, Eq)]
    pub enum DecodePaddingMode {
        /// Padded and unpadded input are both accepted (padding, if
        /// present, must be complete).
        Indifferent,
        /// The input must be padded to a multiple of 4.
        RequireCanonical,
        /// The input must not be padded.
        RequireNone,
    }

    /// The settings of a [`GeneralPurpose`] engine: whether encoding pads,
    /// how decoding treats padding, and whether decoding accepts stray bits
    /// in the last symbol.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::base64::alphabet;
    /// use std::base64::engine::{DecodePaddingMode, Engine, GeneralPurpose, GeneralPurposeConfig};
    ///
    /// let config = GeneralPurposeConfig::new()
    ///     .with_encode_padding(false)
    ///     .with_decode_padding_mode(DecodePaddingMode::Indifferent);
    /// let e = GeneralPurpose::new(&alphabet::STANDARD, config);
    /// assert_eq(e.encode(b"hello"), "aGVsbG8");
    /// assert_eq(e.decode("aGVsbG8=").unwrap(), b"hello");
    /// assert_eq(e.decode("aGVsbG8").unwrap(), b"hello");
    /// ```
    #[derive(Clone, Debug, PartialEq, Eq)]
    pub struct GeneralPurposeConfig {
        encode_padding: bool,
        decode_allow_trailing_bits: bool,
        decode_padding_mode: DecodePaddingMode,
    }

    impl GeneralPurposeConfig {
        /// Creates the default config: padding on encode, canonical padding
        /// and no trailing bits on decode (the same as
        /// [`general_purpose::PAD`]).
        pub const fn new() -> GeneralPurposeConfig {
            GeneralPurposeConfig {
                encode_padding: true,
                decode_allow_trailing_bits: false,
                decode_padding_mode: DecodePaddingMode::RequireCanonical,
            }
        }
        /// Returns the config with encoding padding (`=`) on or off.
        pub const fn with_encode_padding(self, padding: bool) -> GeneralPurposeConfig {
            GeneralPurposeConfig {
                encode_padding: padding,
                ..self
            }
        }
        /// Returns the config with decoding accepting (or rejecting) a last
        /// symbol with bits that belong to no decoded byte.
        ///
        /// Accepting them means several inputs decode to the same bytes.
        pub const fn with_decode_allow_trailing_bits(self, allow: bool) -> GeneralPurposeConfig {
            GeneralPurposeConfig {
                decode_allow_trailing_bits: allow,
                ..self
            }
        }
        /// Returns the config with decoding treating padding as `mode`
        /// says.
        pub const fn with_decode_padding_mode(
            self,
            mode: DecodePaddingMode,
        ) -> GeneralPurposeConfig {
            GeneralPurposeConfig {
                decode_padding_mode: mode,
                ..self
            }
        }
        /// Returns whether encoding writes padding.
        pub fn encode_padding(&self) -> bool {
            self.encode_padding
        }
    }

    impl Default for GeneralPurposeConfig {
        fn default() -> GeneralPurposeConfig {
            GeneralPurposeConfig::new()
        }
    }

    /// Encodes and decodes base64.
    ///
    /// The provided methods are the API; an engine implements
    /// `internal_encode` and `internal_decode`. Bring the trait into scope
    /// to call them (`use std::base64::prelude::*;` does).
    pub trait Engine {
        /// Appends the encoding of `input` to `output` (the engine's part;
        /// call the provided methods instead).
        fn internal_encode(&self, input: &[u8], output: &mut Vec<u8>);
        /// Appends the decoding of `input` to `output` (the engine's part;
        /// call the provided methods instead).
        fn internal_decode(&self, input: &[u8], output: &mut Vec<u8>) -> Result<(), DecodeError>;

        /// Encodes `input` as a base64 string.
        ///
        /// # Examples
        ///
        /// ```
        /// use std::base64::prelude::*;
        ///
        /// assert_eq(BASE64_STANDARD.encode(b"hello world"), "aGVsbG8gd29ybGQ=");
        /// assert_eq(BASE64_STANDARD_NO_PAD.encode("hello world"), "aGVsbG8gd29ybGQ");
        /// ```
        fn encode<T: AsRef<[u8]>>(&self, input: T) -> String {
            let mut v = Vec::new();
            self.internal_encode(input.as_ref(), &mut v);
            unsafe { String::from_utf8_unchecked(v) }
        }

        /// Encodes `input` and appends it to `output_buf`.
        ///
        /// # Examples
        ///
        /// ```
        /// use std::base64::prelude::*;
        ///
        /// let mut s = String::from("data:");
        /// BASE64_STANDARD.encode_string(b"hi", &mut s);
        /// assert_eq(s, "data:aGk=");
        /// ```
        fn encode_string<T: AsRef<[u8]>>(&self, input: T, output_buf: &mut String) {
            let mut v = Vec::new();
            self.internal_encode(input.as_ref(), &mut v);
            output_buf.push_str(unsafe { crate::str::from_utf8_unchecked(v.as_slice()) });
        }

        /// Encodes `input` into the front of `output_buf` and returns the
        /// number of bytes written.
        ///
        /// # Errors
        ///
        /// [`EncodeSliceError::OutputSliceTooSmall`] if the encoding does
        /// not fit; `output_buf` is left unchanged then.
        ///
        /// # Examples
        ///
        /// ```
        /// use std::base64::prelude::*;
        ///
        /// let mut buf = [0u8; 16];
        /// let n = BASE64_STANDARD.encode_slice(b"hello", &mut buf).unwrap();
        /// assert_eq(&buf[..n], b"aGVsbG8=");
        /// assert(BASE64_STANDARD.encode_slice(b"hello", &mut buf[..4]).is_err());
        /// ```
        fn encode_slice<T: AsRef<[u8]>>(
            &self,
            input: T,
            output_buf: &mut [u8],
        ) -> Result<usize, EncodeSliceError> {
            let mut v = Vec::new();
            self.internal_encode(input.as_ref(), &mut v);
            if v.len() > output_buf.len() {
                return Err(EncodeSliceError::OutputSliceTooSmall);
            }
            crate::rt::copy(
                v.as_ptr(),
                crate::rt::slice_ptr(output_buf) as *mut u8,
                v.len(),
            );
            Ok(v.len())
        }

        /// Decodes `input`, returning the bytes it encodes.
        ///
        /// # Errors
        ///
        /// A [`DecodeError`] if `input` is not valid base64 for this engine
        /// (a byte outside the alphabet, padding the engine's config does
        /// not allow, a length that cannot be base64, stray bits in the
        /// last symbol).
        ///
        /// # Examples
        ///
        /// ```
        /// use std::base64::prelude::*;
        ///
        /// assert_eq(BASE64_STANDARD.decode("SGVsbG8sIHdvcmxkIQ==").unwrap(), b"Hello, world!");
        /// assert_eq(BASE64_URL_SAFE.decode("-_8=").unwrap(), b"\xfb\xff");
        /// assert(BASE64_STANDARD.decode("-_8=").is_err());
        /// ```
        fn decode<T: AsRef<[u8]>>(&self, input: T) -> Result<Vec<u8>, DecodeError> {
            let mut v = Vec::new();
            self.internal_decode(input.as_ref(), &mut v)?;
            Ok(v)
        }

        /// Decodes `input` and appends the bytes to `buffer`.
        ///
        /// # Errors
        ///
        /// A [`DecodeError`] if `input` is not valid base64 for this engine.
        ///
        /// # Examples
        ///
        /// ```
        /// use std::base64::prelude::*;
        ///
        /// let mut buf = Vec::from(b"Hello, ");
        /// BASE64_STANDARD.decode_vec("d29ybGQ=", &mut buf).unwrap();
        /// assert_eq(buf, b"Hello, world");
        /// ```
        fn decode_vec<T: AsRef<[u8]>>(
            &self,
            input: T,
            buffer: &mut Vec<u8>,
        ) -> Result<(), DecodeError> {
            self.internal_decode(input.as_ref(), buffer)
        }

        /// Decodes `input` into the front of `output` and returns the number
        /// of bytes written.
        ///
        /// # Errors
        ///
        /// [`DecodeSliceError::DecodeError`] if `input` is not valid base64
        /// for this engine, and [`DecodeSliceError::OutputSliceTooSmall`] if
        /// the bytes do not fit (`output` is left unchanged then).
        ///
        /// # Examples
        ///
        /// ```
        /// use std::base64::{prelude::*, DecodeSliceError};
        ///
        /// let mut buf = [0u8; 8];
        /// let n = BASE64_STANDARD.decode_slice("aGVsbG8=", &mut buf).unwrap();
        /// assert_eq(&buf[..n], b"hello");
        /// let e = BASE64_STANDARD.decode_slice("aGVsbG8=", &mut buf[..2]);
        /// assert_eq(e, Err(DecodeSliceError::OutputSliceTooSmall));
        /// ```
        fn decode_slice<T: AsRef<[u8]>>(
            &self,
            input: T,
            output: &mut [u8],
        ) -> Result<usize, DecodeSliceError> {
            let mut v = Vec::new();
            self.internal_decode(input.as_ref(), &mut v)?;
            if v.len() > output.len() {
                return Err(DecodeSliceError::OutputSliceTooSmall);
            }
            crate::rt::copy(v.as_ptr(), crate::rt::slice_ptr(output) as *mut u8, v.len());
            Ok(v.len())
        }
    }

    const INVALID: u8 = 0xff;

    /// An engine for any alphabet and config, in portable code.
    ///
    /// The common ones are constants in [`general_purpose`].
    ///
    /// # Examples
    ///
    /// ```
    /// use std::base64::alphabet;
    /// use std::base64::engine::{general_purpose, Engine, GeneralPurpose};
    ///
    /// let e = GeneralPurpose::new(&alphabet::URL_SAFE, general_purpose::NO_PAD);
    /// assert_eq(e.encode(b"\xfb\xff"), "-_8");
    /// ```
    #[derive(Clone, Debug)]
    pub struct GeneralPurpose {
        encode_table: [u8; 64],
        decode_table: [u8; 256],
        config: GeneralPurposeConfig,
    }

    impl GeneralPurpose {
        /// Creates an engine that encodes with `alphabet` as `config` says.
        pub const fn new(alphabet: &Alphabet, config: GeneralPurposeConfig) -> GeneralPurpose {
            let mut decode_table = [INVALID; 256];
            let mut i = 0;
            while i < 64 {
                decode_table[alphabet.symbols[i] as usize] = i as u8;
                i += 1;
            }
            GeneralPurpose {
                encode_table: alphabet.symbols,
                decode_table,
                config,
            }
        }

        /// Returns the engine's config.
        pub fn config(&self) -> &GeneralPurposeConfig {
            &self.config
        }
    }

    impl Engine for GeneralPurpose {
        fn internal_encode(&self, input: &[u8], output: &mut Vec<u8>) {
            let n = input.len();
            let start = output.len();
            let len = match super::encoded_len(n, self.config.encode_padding) {
                Some(l) => l,
                None => panic("base64: input too long"),
            };
            output.resize(start + len, 0u8);
            let out = &mut output.as_mut_slice()[start..];
            let t = &self.encode_table;
            let mut i = 0;
            let mut o = 0;
            while i + 3 <= n {
                let w = (input[i] as u32) << 16 | (input[i + 1] as u32) << 8 | input[i + 2] as u32;
                out[o] = t[(w >> 18) as usize];
                out[o + 1] = t[((w >> 12) & 63) as usize];
                out[o + 2] = t[((w >> 6) & 63) as usize];
                out[o + 3] = t[(w & 63) as usize];
                i += 3;
                o += 4;
            }
            let rem = n - i;
            if rem == 0 {
                return;
            }
            let w = if rem == 1 {
                (input[i] as u32) << 16
            } else {
                (input[i] as u32) << 16 | (input[i + 1] as u32) << 8
            };
            out[o] = t[(w >> 18) as usize];
            out[o + 1] = t[((w >> 12) & 63) as usize];
            if rem == 2 {
                out[o + 2] = t[((w >> 6) & 63) as usize];
            } else if self.config.encode_padding {
                out[o + 2] = b'=';
            }
            if self.config.encode_padding {
                out[o + 3] = b'=';
            }
        }

        fn internal_decode(&self, input: &[u8], output: &mut Vec<u8>) -> Result<(), DecodeError> {
            let n = input.len();
            if n == 0 {
                return Ok(());
            }
            let t = &self.decode_table;
            // Whole quads, then the last one to four bytes (which may hold
            // padding), as the crate splits them.
            let start = (n - 1) / 4 * 4;
            let base = output.len();
            output.resize(base + start / 4 * 3 + 3, 0u8);
            let out = &mut output.as_mut_slice()[base..];
            let mut i = 0;
            let mut o = 0;
            while i < start {
                let a = t[input[i] as usize] as u32;
                let b = t[input[i + 1] as usize] as u32;
                let c = t[input[i + 2] as usize] as u32;
                let d = t[input[i + 3] as usize] as u32;
                if (a | b | c | d) & 0x80 != 0 {
                    let mut j = i;
                    while t[input[j] as usize] != INVALID {
                        j += 1;
                    }
                    output.truncate(base);
                    return Err(DecodeError::InvalidByte(j, input[j]));
                }
                let w = a << 18 | b << 12 | c << 6 | d;
                out[o] = (w >> 16) as u8;
                out[o + 1] = (w >> 8) as u8;
                out[o + 2] = w as u8;
                i += 4;
                o += 3;
            }
            // The last quad.
            let mut acc = 0u32;
            let mut morsels = 0;
            let mut pads = 0;
            let mut first_pad = 0;
            let mut j = start;
            while j < n {
                let ch = input[j];
                if ch == b'=' {
                    if j - start < 2 {
                        output.truncate(base);
                        let at = if pads > 0 { first_pad } else { j };
                        return Err(DecodeError::InvalidByte(at, ch));
                    }
                    if pads == 0 {
                        first_pad = j;
                    }
                    pads += 1;
                } else {
                    if pads > 0 {
                        output.truncate(base);
                        return Err(DecodeError::InvalidByte(first_pad, b'='));
                    }
                    let v = t[ch as usize];
                    if v == INVALID {
                        output.truncate(base);
                        return Err(DecodeError::InvalidByte(j, ch));
                    }
                    acc = acc << 6 | v as u32;
                    morsels += 1;
                }
                j += 1;
            }
            if morsels == 1 {
                output.truncate(base);
                return Err(DecodeError::InvalidLength(start + 1));
            }
            let bad_padding = match self.config.decode_padding_mode {
                DecodePaddingMode::Indifferent => pads > 0 && (pads + morsels) % 4 != 0,
                DecodePaddingMode::RequireCanonical => (pads + morsels) % 4 != 0,
                DecodePaddingMode::RequireNone => pads > 0,
            };
            if bad_padding {
                output.truncate(base);
                return Err(DecodeError::InvalidPadding);
            }
            // 2 symbols carry 1 byte and 4 spare bits, 3 symbols 2 bytes
            // and 2 spare bits.
            let nbytes = morsels * 6 / 8;
            let spare = morsels * 6 - nbytes * 8;
            if !self.config.decode_allow_trailing_bits
                && spare > 0
                && (acc & ((1u32 << spare as u32) - 1)) != 0
            {
                output.truncate(base);
                let last = start + morsels - 1;
                return Err(DecodeError::InvalidLastSymbol(last, input[last]));
            }
            let w = acc >> spare as u32;
            let mut k = 0;
            while k < nbytes {
                out[o + k] = (w >> (8 * (nbytes - 1 - k) as u32)) as u8;
                k += 1;
            }
            output.truncate(base + o + nbytes);
            Ok(())
        }
    }

    /// Ready-made [`GeneralPurpose`](super::GeneralPurpose) engines and
    /// configs.
    pub mod general_purpose {
        use super::super::alphabet;
        use super::{DecodePaddingMode, GeneralPurpose, GeneralPurposeConfig};

        /// Padding on encode, required on decode.
        pub const PAD: GeneralPurposeConfig = GeneralPurposeConfig::new();
        /// No padding on encode, none allowed on decode.
        pub const NO_PAD: GeneralPurposeConfig = GeneralPurposeConfig::new()
            .with_encode_padding(false)
            .with_decode_padding_mode(DecodePaddingMode::RequireNone);
        /// No padding on encode, either on decode.
        pub const NO_PAD_INDIFFERENT: GeneralPurposeConfig = GeneralPurposeConfig::new()
            .with_encode_padding(false)
            .with_decode_padding_mode(DecodePaddingMode::Indifferent);
        /// Padding on encode, either on decode.
        pub const PAD_INDIFFERENT: GeneralPurposeConfig =
            GeneralPurposeConfig::new().with_decode_padding_mode(DecodePaddingMode::Indifferent);

        /// The standard alphabet with padding.
        pub const STANDARD: GeneralPurpose = GeneralPurpose::new(&alphabet::STANDARD, PAD);
        /// The standard alphabet without padding.
        pub const STANDARD_NO_PAD: GeneralPurpose =
            GeneralPurpose::new(&alphabet::STANDARD, NO_PAD);
        /// The URL-safe alphabet with padding.
        pub const URL_SAFE: GeneralPurpose = GeneralPurpose::new(&alphabet::URL_SAFE, PAD);
        /// The URL-safe alphabet without padding.
        pub const URL_SAFE_NO_PAD: GeneralPurpose =
            GeneralPurpose::new(&alphabet::URL_SAFE, NO_PAD);
    }
}

/// The [`Engine`] trait and the four usual engines, for
/// `use std::base64::prelude::*;`.
///
/// The engines are named `BASE64_STANDARD`, `BASE64_STANDARD_NO_PAD`,
/// `BASE64_URL_SAFE` and `BASE64_URL_SAFE_NO_PAD`.
pub mod prelude {
    pub use super::engine::Engine;
    pub use super::engine::general_purpose::STANDARD as BASE64_STANDARD;
    pub use super::engine::general_purpose::STANDARD_NO_PAD as BASE64_STANDARD_NO_PAD;
    pub use super::engine::general_purpose::URL_SAFE as BASE64_URL_SAFE;
    pub use super::engine::general_purpose::URL_SAFE_NO_PAD as BASE64_URL_SAFE_NO_PAD;
}
