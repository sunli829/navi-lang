//! Inspection and manipulation of the process's environment.
//!
//! This module contains functions to inspect various aspects such as
//! environment variables, the command line arguments, the current directory,
//! and various other important directories.
//!
//! Unlike Rust's, navi has no `OsStr`/`OsString`: names, values and arguments
//! are UTF-8 [`String`]s (anything else read from the OS is converted lossily),
//! and the `_os` variants ([`var_os`], [`vars_os`]) return the same strings as
//! the others (see spec/std-diff.md).

use crate::fmt::{self, Display, Formatter};
use crate::path::PathBuf;
use crate::string::String;

pub mod consts;

/// An iterator over the arguments of a process, yielding a [`String`] value for
/// each argument.
///
/// This struct is created by [`env::args()`](args). See its documentation for
/// more.
///
/// The arguments are read when `args()` is called; the first one is usually the
/// path of the program.
///
/// # Examples
///
/// ```
/// use std::env;
///
/// let mut args = env::args();
/// let program = args.next();
/// assert(program.is_some());
/// for arg in args {
///     println(`argument: ${arg}`);
/// }
/// ```
pub struct Args {
    args: Vec<String>,
    i: usize,
}

/// Returns the arguments that this program was started with (normally passed
/// via the command line).
///
/// The first element is traditionally the path of the executable, but it can be
/// set to arbitrary text, and might not even exist. This means this property
/// should not be relied upon for security purposes.
///
/// Unlike Rust's, this never panics: an argument that is not valid Unicode is
/// converted lossily (on Windows the command line comes from `GetCommandLineW`,
/// split by the rules of the C runtime, as Rust's).
///
/// # Examples
///
/// ```
/// use std::env;
///
/// // Prints each argument on a separate line
/// for argument in env::args() {
///     println(argument);
/// }
/// ```
pub fn args() -> Args {
    Args {
        args: crate::sys::args(),
        i: 0,
    }
}

impl Iterator for Args {
    type Item = String;
    /// Returns the next argument, or `None` after the last one.
    fn next(&mut self) -> Option<String> {
        if self.i >= self.args.len() {
            return None;
        }
        self.i += 1;
        Some(self.args[self.i - 1].clone())
    }
}

/// The error type for operations interacting with environment variables.
///
/// Possibly returned from [`env::var()`](var). Unlike Rust's, there is no
/// `NotUnicode` variant: a value that is not valid Unicode is read lossily.
///
/// # Examples
///
/// ```
/// use std::env::{self, VarError};
///
/// assert_eq(env::var("NAVI_DOC_VAR_ERROR_UNSET"), Err(VarError::NotPresent));
/// assert_eq(VarError::NotPresent.to_string(), "environment variable not found");
/// ```
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum VarError {
    /// The specified environment variable was not present in the current
    /// process's environment.
    NotPresent,
}

impl Display for VarError {
    /// Writes "environment variable not found".
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.pad("environment variable not found")
    }
}

/// Returns the path of a temporary directory.
///
/// The temporary directory may be shared among users, or between processes with
/// different privileges; thus, the creation of any files or directories in the
/// temporary directory must use a secure method to create a uniquely named
/// file.
///
/// On Unix, returns the value of the `TMPDIR` environment variable if it is set
/// and not empty, otherwise `/tmp`. On Windows, returns what `GetTempPathW`
/// gives, as Rust's. The directory is not checked to exist.
///
/// # Examples
///
/// ```
/// use std::env;
/// use std::fs;
///
/// fn main() -> std::io::Result<()> {
///     let path = env::temp_dir().join("navi_doc_env_temp_dir.txt");
///     fs::write(&path, "scratch")?;
///     assert_eq(fs::read_to_string(&path)?, "scratch");
///     fs::remove_file(&path)?;
///     Ok(())
/// }
/// ```
pub fn temp_dir() -> PathBuf {
    PathBuf::from(crate::sys::temp_dir())
}

// --- navi: on the OS layer ---------------------------------------------------

// The separator of PATH-like variables.
#[cfg(not(target_os = "windows"))]
const PATH_SEPARATOR: char = ':';
#[cfg(target_os = "windows")]
const PATH_SEPARATOR: char = ';';

/// Fetches the environment variable `key` from the current process.
///
/// # Errors
///
/// Returns [`VarError::NotPresent`] if the variable is not set (also when `key`
/// is empty or contains `=` or NUL). Unlike Rust's, a value that is not valid
/// Unicode is read lossily rather than giving an error.
///
/// # Examples
///
/// ```
/// use std::env;
///
/// let key = "PATH";
/// match env::var(key) {
///     Ok(val) => println(`${key}: ${val}`),
///     Err(e) => println(`couldn't interpret ${key}: ${e}`),
/// }
/// assert_eq(env::var("NAVI_DOC_ENV_VAR_UNSET"), Err(env::VarError::NotPresent));
/// ```
pub fn var<K: AsRef<str>>(key: K) -> Result<String, VarError> {
    match crate::sys::getenv(key.as_ref()) {
        Some(v) => Ok(v),
        None => Err(VarError::NotPresent),
    }
}

/// Fetches the environment variable `key` from the current process, returning
/// [`None`] if the variable isn't set.
///
/// Rust's returns an `Option<OsString>`; navi has no `OsString`, so this
/// returns the same string as [`var`], as an `Option`.
///
/// # Examples
///
/// ```
/// use std::env;
///
/// assert_eq(env::var_os("PATH"), env::var("PATH").ok());
/// assert_eq(env::var_os("NAVI_DOC_ENV_VAR_OS_UNSET"), None);
/// ```
pub fn var_os<K: AsRef<str>>(key: K) -> Option<String> {
    crate::sys::getenv(key.as_ref())
}

/// Sets the environment variable `key` to the value `value` for the currently
/// running process.
///
/// # Safety
///
/// As in Rust 2024, this function is unsafe: other threads may be reading or
/// writing the environment at the same time (the OS functions are not
/// thread-safe), including C code calling `getenv`. navi's own [`var`],
/// [`vars`] and process spawning take no lock either, so calling `set_var`
/// while another thread does any of them can crash the program. It is safe to
/// call while the program has a single thread, or when no other thread touches
/// the environment. (For that reason the example below is not run as a doctest:
/// doctests run on many threads at once.)
///
/// # Panics
///
/// Panics if `key` is empty, contains the ASCII equals sign `'='` or the NUL
/// character `'\0'`, or when `value` contains the NUL character.
///
/// # Examples
///
/// ```no_run
/// use std::env;
///
/// let key = "NAVI_DOC_SET_VAR";
/// unsafe { env::set_var(key, "VALUE") };
/// assert_eq(env::var(key), Ok("VALUE".to_string()));
/// ```
pub unsafe fn set_var<K: AsRef<str>, V: AsRef<str>>(key: K, value: V) {
    let k = key.as_ref();
    let v = value.as_ref();
    if let Err(e) = crate::sys::setenv(k, v) {
        crate::panic::panic(`failed to set environment variable \`${k:?}\` to \`${v:?}\`: ${e}`);
    }
}

/// Removes the environment variable `key` from the environment of the currently
/// running process.
///
/// # Safety
///
/// The same as for [`set_var`]: other threads must not read or write the
/// environment meanwhile. (The example below is not run as a doctest for that
/// reason.)
///
/// # Panics
///
/// Panics if `key` is empty, contains the ASCII equals sign `'='` or the NUL
/// character `'\0'`.
///
/// # Examples
///
/// ```no_run
/// use std::env;
///
/// let key = "NAVI_DOC_REMOVE_VAR";
/// unsafe { env::set_var(key, "VALUE") };
/// assert(env::var(key).is_ok());
/// unsafe { env::remove_var(key) };
/// assert(env::var(key).is_err());
/// ```
pub unsafe fn remove_var<K: AsRef<str>>(key: K) {
    let k = key.as_ref();
    if let Err(e) = crate::sys::unsetenv(k) {
        crate::panic::panic(`failed to remove environment variable \`${k:?}\`: ${e}`);
    }
}

/// An iterator over a snapshot of the environment variables of this process, as
/// `(name, value)` pairs.
///
/// This structure is created by [`env::vars()`](vars). See its documentation
/// for more.
///
/// # Examples
///
/// ```
/// use std::env;
///
/// let names: Vec<String> = env::vars().map(|(name, _)| name).collect();
/// assert(names.iter().any(|n| n == "PATH"));
/// ```
pub struct Vars {
    all: Vec<(String, String)>,
    i: usize,
}

impl Iterator for Vars {
    type Item = (String, String);
    /// Returns the next `(name, value)` pair, or `None` after the last one.
    fn next(&mut self) -> Option<(String, String)> {
        if self.i >= self.all.len() {
            return None;
        }
        self.i += 1;
        Some(self.all[self.i - 1].clone())
    }
}

/// Returns an iterator of `(variable, value)` pairs of strings, for all the
/// environment variables of the current process.
///
/// The returned iterator contains a snapshot of the process's environment
/// variables at the time of this invocation. Modifications to environment
/// variables afterwards will not be reflected in the returned iterator.
///
/// On Linux the list is built from the names in the initial environment plus
/// the names set later with [`set_var`], each read with `getenv` (navi cannot
/// read libc's `environ`): a variable that C code adds to `environ` directly is
/// not seen. Values that are not valid Unicode are read lossily, so unlike
/// Rust's this never panics.
///
/// # Examples
///
/// ```
/// use std::env;
///
/// // Print all environment variables.
/// for (key, value) in env::vars() {
///     println(`${key}: ${value}`);
/// }
///
/// assert(env::vars().any(|(k, v)| k == "PATH" && Ok(v) == env::var("PATH")));
/// ```
pub fn vars() -> Vars {
    Vars {
        all: crate::sys::environ(),
        i: 0,
    }
}

/// Returns an iterator of `(variable, value)` pairs, for all the environment
/// variables of the current process.
///
/// The same as [`vars`]: Rust's yields `OsString`s, navi has none.
///
/// # Examples
///
/// ```
/// use std::env;
///
/// for (key, value) in env::vars_os() {
///     println(`${key}: ${value}`);
/// }
/// ```
pub fn vars_os() -> Vars {
    vars()
}

/// Returns the current working directory as a [`PathBuf`].
///
/// # Errors
///
/// Returns an [`Err`] if the current working directory value is invalid.
/// Possible cases:
///
/// * Current directory does not exist.
/// * There are insufficient permissions to access the current directory.
///
/// # Examples
///
/// ```
/// use std::env;
///
/// fn main() -> std::io::Result<()> {
///     let path = env::current_dir()?;
///     assert(path.is_absolute());
///     println(`The current directory is ${path.display()}`);
///     Ok(())
/// }
/// ```
pub fn current_dir() -> crate::io::Result<PathBuf> {
    Ok(PathBuf::from(crate::sys::getcwd()?))
}

/// Changes the current working directory to the specified path.
///
/// The working directory belongs to the process: the change is seen by all its
/// threads.
///
/// # Errors
///
/// Returns an [`Err`] if the operation fails, for example when the directory
/// does not exist or is not a directory.
///
/// # Examples
///
/// ```no_run
/// use std::env;
/// use std::path::Path;
///
/// fn main() -> std::io::Result<()> {
///     let root = Path::new("/");
///     env::set_current_dir(&root)?;
///     println(`Successfully changed working directory to ${root.display()}!`);
///     Ok(())
/// }
/// ```
pub fn set_current_dir<P: AsRef<crate::path::Path>>(path: P) -> crate::io::Result<()> {
    crate::sys::chdir(path.as_ref().as_str())
}

/// Returns the path of the current user's home directory if known.
///
/// On Unix, returns the value of the `HOME` environment variable if it is set
/// and not empty; on Windows, the value of `USERPROFILE`. Unlike Rust's, it
/// does not fall back to `getpwuid_r` (or `GetUserProfileDirectoryW`): without
/// the variable it returns [`None`].
///
/// # Examples
///
/// ```
/// use std::env;
///
/// match env::home_dir() {
///     Some(path) => println(`Your home directory, probably: ${path.display()}`),
///     None => println("Impossible to get your home dir!"),
/// }
/// ```
pub fn home_dir() -> Option<PathBuf> {
    match crate::sys::home_dir() {
        Some(h) => Some(PathBuf::from(h)),
        None => None,
    }
}

/// Returns the full filesystem path of the current running executable.
///
/// # Errors
///
/// Acquiring the path of the current executable is a platform-specific
/// operation that can fail for a good number of reasons; such a failure is
/// returned as an [`Err`].
///
/// # Examples
///
/// ```
/// use std::env;
///
/// fn main() -> std::io::Result<()> {
///     let path = env::current_exe()?;
///     println(`The current executable is ${path.display()}`);
///     Ok(())
/// }
/// ```
pub fn current_exe() -> crate::io::Result<PathBuf> {
    Ok(PathBuf::from(crate::sys::current_exe()?))
}

/// Parses input according to platform conventions for the `PATH` environment
/// variable.
///
/// Splits at `':'` on Unix and `';'` on Windows, yielding each piece (empty
/// ones too) as a [`PathBuf`]. Unlike Rust's, it returns a
/// [`vec::IntoIter`](crate::vec::IntoIter) rather than a `SplitPaths` iterator,
/// and Windows paths in double quotes are not unquoted.
///
/// # Examples
///
/// ```
/// use std::env;
/// use std::path::PathBuf;
///
/// let joined = env::join_paths(["/bin", "/usr/bin"]).unwrap();
/// let paths: Vec<PathBuf> = env::split_paths(&joined).collect();
/// assert_eq(paths, Vec::from([PathBuf::from("/bin"), PathBuf::from("/usr/bin")]));
///
/// // Print the directories of PATH.
/// if let Ok(path) = env::var("PATH") {
///     for dir in env::split_paths(&path) {
///         println(`'${dir.display()}'`);
///     }
/// }
/// ```
pub fn split_paths<T: AsRef<str>>(unparsed: T) -> crate::vec::IntoIter<PathBuf> {
    let mut out: Vec<PathBuf> = Vec::new();
    for p in unparsed.as_ref().split(PATH_SEPARATOR) {
        out.push(PathBuf::from(p));
    }
    out.into_iter()
}

/// The error type for operations on the `PATH` variable, returned from
/// [`env::join_paths()`](join_paths) when one of the paths contains the
/// separator (`':'` on Unix, `';'` on Windows).
///
/// # Examples
///
/// ```
/// use std::env;
///
/// let sep = if env::consts::FAMILY == "windows" { ";" } else { ":" };
/// let bad = `/bin${sep}/usr/bin`.to_string();
/// let err = env::join_paths([bad.as_str()]).unwrap_err();
/// assert_eq(err.to_string(), `path segment contains separator \`${sep}\``.to_string());
/// ```
#[derive(Debug, Clone)]
pub struct JoinPathsError;

impl Display for JoinPathsError {
    /// Writes "path segment contains separator `:`" (`;` on Windows).
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_fmt(`path segment contains separator \`${PATH_SEPARATOR}\``)
    }
}

/// Joins a collection of [`Path`](crate::path::Path)s appropriately for the
/// `PATH` environment variable.
///
/// The paths are joined with `':'` on Unix and `';'` on Windows. Unlike Rust's,
/// the result is a [`String`] (navi has no `OsString`).
///
/// # Errors
///
/// Returns an [`Err`] (containing a [`JoinPathsError`]) if one of the input
/// paths contains the separator. On Windows, Rust's also accepts such a path if
/// it can be quoted; navi's does not.
///
/// # Examples
///
/// ```
/// use std::env;
/// use std::path::PathBuf;
///
/// let paths = [PathBuf::from("/bin"), PathBuf::from("/usr/bin")];
/// let joined = env::join_paths(paths.iter()).unwrap();
/// let sep = if env::consts::FAMILY == "windows" { ";" } else { ":" };
/// assert_eq(joined, `/bin${sep}/usr/bin`.to_string());
///
/// // Add a directory to the front of PATH.
/// let mut dirs: Vec<PathBuf> = Vec::from([PathBuf::from("/opt/tools/bin")]);
/// if let Ok(path) = env::var("PATH") {
///     dirs.extend(env::split_paths(&path));
/// }
/// let new_path = env::join_paths(dirs.iter()).unwrap();
/// assert(new_path.starts_with("/opt/tools/bin"));
/// ```
pub fn join_paths<I, T>(paths: I) -> Result<String, JoinPathsError>
where
    I: IntoIterator<Item = T>,
    T: AsRef<crate::path::Path>,
{
    let mut out = String::new();
    let mut first = true;
    for p in paths {
        let s = p.as_ref().as_str();
        if s.contains(PATH_SEPARATOR) {
            return Err(JoinPathsError);
        }
        if !first {
            out.push(PATH_SEPARATOR);
        }
        out.push_str(s);
        first = false;
    }
    Ok(out)
}
