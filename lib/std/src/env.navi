//! The process environment.

use crate::string::String;
use crate::path::PathBuf;
use crate::fmt::{self, Display, Formatter};

/// The command line arguments, starting with the program name.
pub struct Args { i: usize, n: usize }

pub fn args() -> Args { Args { i: 0, n: crate::rt::os_arg_count() } }

impl Iterator for Args {
    type Item = String;
    fn next(&mut self) -> Option<String> {
        if self.i >= self.n { return None; }
        let s = crate::rt::os_arg(self.i).to_string();
        self.i += 1;
        Some(s)
    }
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub enum VarError { NotPresent }

impl Display for VarError {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { f.pad("environment variable not found") }
}

pub fn var(key: &str) -> Result<String, VarError> {
    match crate::rt::os_getenv(key) {
        Some(v) => Ok(v.to_string()),
        None => Err(VarError::NotPresent),
    }
}

/// The directory for temporary files.
pub fn temp_dir() -> PathBuf {
    for name in ["TMPDIR", "TEMP", "TMP"].iter() {
        if let Ok(v) = var(*name) {
            if v.len() > 0 { return PathBuf::from(v); }
        }
    }
    PathBuf::from("/tmp")
}
