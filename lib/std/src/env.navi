//! The process environment.

use crate::string::String;
use crate::path::PathBuf;
use crate::fmt::{self, Display, Formatter};

#[cfg(feature = "navic")]
pub mod consts;

/// The command line arguments, starting with the program name.
pub struct Args { i: usize, n: usize }

pub fn args() -> Args { Args { i: 0, n: crate::rt::os_arg_count() } }

impl Iterator for Args {
    type Item = String;
    fn next(&mut self) -> Option<String> {
        if self.i >= self.n { return None; }
        let s = crate::rt::os_arg(self.i).to_string();
        self.i += 1;
        Some(s)
    }
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub enum VarError { NotPresent }

impl Display for VarError {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { f.pad("environment variable not found") }
}

#[cfg(not(feature = "navic"))]
pub fn var(key: &str) -> Result<String, VarError> {
    match crate::rt::os_getenv(key) {
        Some(v) => Ok(v.to_string()),
        None => Err(VarError::NotPresent),
    }
}

/// The directory for temporary files.
pub fn temp_dir() -> PathBuf {
    for name in ["TMPDIR", "TEMP", "TMP"].iter() {
        if let Ok(v) = var(*name) {
            if v.len() > 0 { return PathBuf::from(v); }
        }
    }
    PathBuf::from("/tmp")
}

// --- navic: on the OS layer ------------------------------------------------------------

// The separator of PATH-like variables.
#[cfg(all(feature = "navic", not(target_os = "windows")))]
const PATH_SEPARATOR: char = ':';
#[cfg(all(feature = "navic", target_os = "windows"))]
const PATH_SEPARATOR: char = ';';

/// A variable's value (NotPresent if it is not set).
#[cfg(feature = "navic")]
pub fn var<K: AsRef<str>>(key: K) -> Result<String, VarError> {
    match crate::sys::getenv(key.as_ref()) {
        Some(v) => Ok(v),
        None => Err(VarError::NotPresent),
    }
}

/// A variable's value, if set (Rust returns an OsString).
#[cfg(feature = "navic")]
pub fn var_os<K: AsRef<str>>(key: K) -> Option<String> { crate::sys::getenv(key.as_ref()) }

/// Sets a variable. Unsafe as in Rust 2024: other threads may read the
/// environment meanwhile. Panics on an empty name, or one with '=' or NUL.
#[cfg(feature = "navic")]
pub unsafe fn set_var<K: AsRef<str>, V: AsRef<str>>(key: K, value: V) {
    let k = key.as_ref();
    let v = value.as_ref();
    if let Err(e) = crate::sys::setenv(k, v) {
        crate::panic::panic(`failed to set environment variable \`${k:?}\` to \`${v:?}\`: ${e}`);
    }
}

/// Removes a variable (unsafe as set_var).
#[cfg(feature = "navic")]
pub unsafe fn remove_var<K: AsRef<str>>(key: K) {
    let k = key.as_ref();
    if let Err(e) = crate::sys::unsetenv(k) {
        crate::panic::panic(`failed to remove environment variable \`${k:?}\`: ${e}`);
    }
}

/// The variables of the environment (a snapshot taken by vars()).
#[cfg(feature = "navic")]
pub struct Vars {
    all: Vec<(String, String)>,
    i: usize,
}

#[cfg(feature = "navic")]
impl Iterator for Vars {
    type Item = (String, String);
    fn next(&mut self) -> Option<(String, String)> {
        if self.i >= self.all.len() { return None; }
        self.i += 1;
        Some(self.all[self.i - 1].clone())
    }
}

#[cfg(feature = "navic")]
pub fn vars() -> Vars { Vars { all: crate::sys::environ(), i: 0 } }

/// vars() (Rust's yields OsStrings).
#[cfg(feature = "navic")]
pub fn vars_os() -> Vars { vars() }

/// The working directory.
#[cfg(feature = "navic")]
pub fn current_dir() -> crate::io::Result<PathBuf> { Ok(PathBuf::from(crate::sys::getcwd()?)) }

#[cfg(feature = "navic")]
pub fn set_current_dir<P: AsRef<crate::path::Path>>(path: P) -> crate::io::Result<()> { crate::sys::chdir(path.as_ref().as_str()) }

/// The user's home directory: $HOME (%USERPROFILE% on Windows).
#[cfg(feature = "navic")]
pub fn home_dir() -> Option<PathBuf> {
    match crate::sys::home_dir() { Some(h) => Some(PathBuf::from(h)), None => None }
}

/// The path of the running executable.
#[cfg(feature = "navic")]
pub fn current_exe() -> crate::io::Result<PathBuf> { Ok(PathBuf::from(crate::sys::current_exe()?)) }

/// The paths in a PATH-like variable.
#[cfg(feature = "navic")]
pub fn split_paths<T: AsRef<str>>(unparsed: T) -> crate::vec::IntoIter<PathBuf> {
    let mut out: Vec<PathBuf> = Vec::new();
    for p in unparsed.as_ref().split(PATH_SEPARATOR) { out.push(PathBuf::from(p)); }
    out.into_iter()
}

/// An error of join_paths: a path contains the separator.
#[cfg(feature = "navic")]
#[derive(Debug, Clone)]
pub struct JoinPathsError;

#[cfg(feature = "navic")]
impl Display for JoinPathsError {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { f.write_fmt(`path segment contains separator \`${PATH_SEPARATOR}\``) }
}

/// Joins paths for a PATH-like variable.
#[cfg(feature = "navic")]
pub fn join_paths<I: IntoIterator<Item = T>, T: AsRef<crate::path::Path>>(paths: I) -> Result<String, JoinPathsError> {
    let mut out = String::new();
    let mut first = true;
    for p in paths {
        let s = p.as_ref().as_str();
        if s.contains(PATH_SEPARATOR) { return Err(JoinPathsError); }
        if !first { out.push(PATH_SEPARATOR); }
        out.push_str(s);
        first = false;
    }
    Ok(out)
}
