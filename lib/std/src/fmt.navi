//! Formatting: the traits behind template strings and #[derive(Debug)].

pub type Result = crate::result::Result<(), Error>;

#[derive(Clone, PartialEq, Eq, Debug, Default)]
pub struct Error;

#[derive(Clone, PartialEq, Eq, Debug)]
pub enum Alignment { Left, Right, Center }

pub trait Write {
    fn write_str(&mut self, s: &str) -> Result;
    fn write_char(&mut self, c: char) -> Result { todo() }
    fn write_fmt(&mut self, args: Arguments) -> Result { todo() }
}

/// A template string evaluated lazily: the interpolated values are captured
/// when it is created and formatted when it is written.
pub struct Arguments {
    pieces: &[&str],
}

pub struct Formatter {
    out: &mut dyn Write,
    width: Option<usize>,
    precision: Option<usize>,
    fill: char,
    align: Option<Alignment>,
    alternate: bool,
    sign_plus: bool,
}

impl Formatter {
    pub fn write_fmt(&mut self, args: Arguments) -> Result { todo() }
    pub fn write_str(&mut self, s: &str) -> Result { self.out.write_str(s) }
    pub fn width(&self) -> Option<usize> { self.width }
    pub fn precision(&self) -> Option<usize> { self.precision }
    pub fn fill(&self) -> char { self.fill }
    pub fn align(&self) -> Option<Alignment> { self.align.clone() }
    pub fn alternate(&self) -> bool { self.alternate }
    pub fn sign_plus(&self) -> bool { self.sign_plus }
    pub fn pad(&mut self, s: &str) -> Result { todo() }
    pub fn pad_integral(&mut self, is_nonnegative: bool, prefix: &str, digits: &str) -> Result { todo() }
    pub fn debug_struct(&mut self, name: &str) -> DebugStruct { todo() }
    pub fn debug_tuple(&mut self, name: &str) -> DebugTuple { todo() }
    pub fn debug_list(&mut self) -> DebugList { todo() }
    pub fn debug_set(&mut self) -> DebugSet { todo() }
    pub fn debug_map(&mut self) -> DebugMap { todo() }
}

pub struct DebugStruct { fmt: &mut Formatter, result: Result, has_fields: bool }
impl DebugStruct {
    pub fn field(&mut self, name: &str, value: &dyn Debug) -> &mut DebugStruct { todo() }
    pub fn finish(&mut self) -> Result { todo() }
}

pub struct DebugTuple { fmt: &mut Formatter, result: Result, fields: usize }
impl DebugTuple {
    pub fn field(&mut self, value: &dyn Debug) -> &mut DebugTuple { todo() }
    pub fn finish(&mut self) -> Result { todo() }
}

pub struct DebugList { fmt: &mut Formatter, result: Result, has_fields: bool }
impl DebugList {
    pub fn entry(&mut self, value: &dyn Debug) -> &mut DebugList { todo() }
    pub fn finish(&mut self) -> Result { todo() }
}

pub struct DebugSet { fmt: &mut Formatter, result: Result, has_fields: bool }
impl DebugSet {
    pub fn entry(&mut self, value: &dyn Debug) -> &mut DebugSet { todo() }
    pub fn finish(&mut self) -> Result { todo() }
}

pub struct DebugMap { fmt: &mut Formatter, result: Result, has_fields: bool }
impl DebugMap {
    pub fn entry(&mut self, key: &dyn Debug, value: &dyn Debug) -> &mut DebugMap { todo() }
    pub fn finish(&mut self) -> Result { todo() }
}

pub trait Display { fn fmt(&self, f: &mut Formatter) -> Result; }
pub trait Debug { fn fmt(&self, f: &mut Formatter) -> Result; }
pub trait LowerHex { fn fmt(&self, f: &mut Formatter) -> Result; }
pub trait UpperHex { fn fmt(&self, f: &mut Formatter) -> Result; }
pub trait Octal { fn fmt(&self, f: &mut Formatter) -> Result; }
pub trait Binary { fn fmt(&self, f: &mut Formatter) -> Result; }
pub trait LowerExp { fn fmt(&self, f: &mut Formatter) -> Result; }
pub trait UpperExp { fn fmt(&self, f: &mut Formatter) -> Result; }

impl Display for Arguments {
    fn fmt(&self, f: &mut Formatter) -> Result { f.write_fmt(self.clone_args()) }
}

impl Arguments {
    fn clone_args(&self) -> Arguments { Arguments { pieces: self.pieces } }
}
