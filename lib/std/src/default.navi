//! The [`Default`] trait for types with a default value.

/// A trait for giving a type a useful default value.
///
/// Numbers default to zero, `bool` to `false`, [`Option`] to `None`, and
/// collections such as [`Vec`] and [`String`] to empty ones.
///
/// `Default` can be derived with `#[derive(Default)]` for a struct whose
/// fields all implement `Default`: each field gets its own default value.
///
/// # Examples
///
/// ```
/// #[derive(Default, Debug, PartialEq)]
/// struct Options {
///     verbose: bool,
///     level: i32,
///     name: String,
/// }
///
/// let o = Options::default();
/// assert_eq(
///     o,
///     Options {
///         verbose: false,
///         level: 0,
///         name: String::new(),
///     },
/// );
///
/// // Override some fields and keep the defaults of the others.
/// let o = Options {
///     level: 3,
///     ..Options::default()
/// };
/// assert_eq(o.level, 3);
/// assert(!o.verbose);
/// ```
pub trait Default {
    /// Returns the "default value" for a type.
    ///
    /// # Examples
    ///
    /// ```
    /// let i: i32 = Default::default();
    /// assert_eq(i, 0);
    /// let v: Vec<u8> = Default::default();
    /// assert(v.is_empty());
    /// let (a, b): (Option<String>, bool) = Default::default();
    /// assert(a.is_none() && !b);
    /// ```
    fn default() -> Self;
}
