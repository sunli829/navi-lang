//! js-wasm32 (docs/wasm.md): a browser has no files, processes or
//! descriptors. Standard output and error go to the console through the
//! glue JS (its write import); the environment is the program's own
//! (empty at the start); everything else is ErrorKind::Unsupported, as
//! Rust's wasm32-unknown-unknown and Go's js/wasm.

use crate::{
    io::{self, Error, ErrorKind},
    string::String,
    sys::{DirEnt, FileAttr, split_env},
};

#[link(wasm_import_module = "navi")]
#[nonblocking]
extern "C" {
    /// Writes len bytes at p to the console (fd 1: log, 2: error).
    #[link_name = "write"]
    fn js_write(fd: i32, p: u32, len: u32) -> i32;
}

pub const EBADF: i32 = 9;
pub const EINVAL_CODE: i32 = 22;

fn unsupported() -> Error {
    Error::new(
        ErrorKind::Unsupported,
        "operation not supported on js-wasm32",
    )
}

pub fn errno() -> i32 {
    0
}

pub fn error_string(code: i32) -> String {
    `os error ${code}`.to_string()
}

pub fn decode_error_kind(code: i32) -> ErrorKind {
    let _ = code;
    ErrorKind::Other
}

pub fn open(path: &str, access: u8, append: bool, creation: u8, mode: u32) -> io::Result<i64> {
    let _ = (path, access, append, creation, mode);
    Err(unsupported())
}

pub fn read(fd: i64, buf: &mut [u8]) -> io::Result<usize> {
    // (Standard input is empty.)
    let _ = buf;
    if fd == 0 {
        return Ok(0);
    }
    Err(unsupported())
}

pub fn write(fd: i64, buf: &[u8]) -> io::Result<usize> {
    if fd != 1 && fd != 2 {
        return Err(unsupported());
    }
    if buf.len() > 0 {
        unsafe { js_write(fd as i32, buf.as_ptr() as usize as u32, buf.len() as u32) };
    }
    Ok(buf.len())
}

