// --- Environment -------------------------------------------------------------

// The program's environment: NAME=value strings.
static mut ENV: Vec<String> = Vec::new();

pub fn getenv(name: &str) -> Option<String> {
    for s in ENV.iter() {
        if let Some((k, v)) = split_env(s.as_str()) {
            if k == name {
                return Some(v);
            }
        }
    }
    None
}

fn check_env_name(name: &str) -> io::Result<()> {
    if name.len() == 0 || name.contains('=') {
        return Err(Error::new(
            ErrorKind::InvalidInput,
            `invalid environment variable name: ${name:?}`.to_string(),
        ));
    }
    Ok(())
}

pub fn setenv(name: &str, value: &str) -> io::Result<()> {
    check_env_name(name)?;
    unsetenv(name)?;
    ENV.push(`${name}=${value}`.to_string());
    Ok(())
}

pub fn unsetenv(name: &str) -> io::Result<()> {
    check_env_name(name)?;
    let mut kept: Vec<String> = Vec::new();
    for s in ENV.iter() {
        let same = match split_env(s.as_str()) {
            Some((k, _)) => k == name,
            None => false,
        };
        if !same {
            kept.push(s.clone());
        }
    }
    ENV = kept;
    Ok(())
}

pub fn environ() -> Vec<(String, String)> {
    let mut out: Vec<(String, String)> = Vec::new();
    for s in ENV.iter() {
        if let Some(kv) = split_env(s.as_str()) {
            out.push(kv);
        }
    }
    out
}

pub fn home_dir() -> Option<String> {
    None
}

/// The arguments the page gave (none by default).
pub fn args() -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let mut i = 0;
    while i < crate::rt::os_arg_count() {
        out.push(crate::rt::os_arg(i).to_string());
        i += 1;
    }
    out
}

pub fn temp_dir() -> String {
    "/tmp".to_string()
}

