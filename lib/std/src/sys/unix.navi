//! POSIX (macOS and Linux with glibc or bionic): file descriptors, stat,
//! directories, the environment, posix_spawn and waitpid.
//!
//! errno is per OS thread and a green thread may move to another one when
//! it parks: it is read right after the failed C call (exit_blocked, run
//! after a blocking one, neither parks nor makes failing C calls). The C
//! functions that may block for long are declared without #[nonblocking]:
//! their calls count the G as blocked (a collector proceeds meanwhile).

use crate::io::{self, Error, ErrorKind};
use crate::string::String;
use crate::sys::{FileAttr, DirEnt, cstring, from_cstr, zeroed, rd_u16, rd_u32, rd_u64, split_env};

#[nonblocking]
extern "C" {
    fn strerror(e: i32) -> *const u8;
    fn fcntl(fd: i32, cmd: i32, ...) -> i32;
    fn lseek(fd: i32, off: i64, whence: i32) -> i64;
    #[link_name = "close"]
    fn c_close(fd: i32) -> i32;
    fn ftruncate(fd: i32, len: i64) -> i32;
    #[link_name = "unlink"]
    fn c_unlink(path: *const u8) -> i32;
    #[link_name = "rmdir"]
    fn c_rmdir(path: *const u8) -> i32;
    #[link_name = "mkdir"]
    fn c_mkdir(path: *const u8, mode: u32) -> i32;
    #[link_name = "rename"]
    fn c_rename(from: *const u8, to: *const u8) -> i32;
    #[link_name = "link"]
    fn c_link(from: *const u8, to: *const u8) -> i32;
    #[link_name = "symlink"]
    fn c_symlink(target: *const u8, link: *const u8) -> i32;
    #[link_name = "readlink"]
    fn c_readlink(path: *const u8, buf: *mut u8, n: usize) -> isize;
    #[link_name = "chmod"]
    fn c_chmod(path: *const u8, mode: u32) -> i32;
    #[link_name = "fchmod"]
    fn c_fchmod(fd: i32, mode: u32) -> i32;
    #[link_name = "getcwd"]
    fn c_getcwd(buf: *mut u8, n: usize) -> *mut u8;
    #[link_name = "chdir"]
    fn c_chdir(path: *const u8) -> i32;
    #[link_name = "isatty"]
    fn c_isatty(fd: i32) -> i32;
    #[link_name = "getenv"]
    fn c_getenv(name: *const u8) -> *const u8;
    #[link_name = "setenv"]
    fn c_setenv(name: *const u8, value: *const u8, overwrite: i32) -> i32;
    #[link_name = "unsetenv"]
    fn c_unsetenv(name: *const u8) -> i32;
    #[link_name = "getpid"]
    fn c_getpid() -> i32;
    fn closedir(d: *mut u8) -> i32;
    fn futimens(fd: i32, times: *const u8) -> i32;
    #[link_name = "kill"]
    fn c_kill(pid: i32, sig: i32) -> i32;
    fn signal(sig: i32, handler: usize) -> usize;
    fn sigemptyset(set: *mut u8) -> i32;
    fn sigaddset(set: *mut u8, sig: i32) -> i32;
    fn posix_spawn_file_actions_init(fa: *mut u8) -> i32;
    fn posix_spawn_file_actions_destroy(fa: *mut u8) -> i32;
    fn posix_spawn_file_actions_adddup2(fa: *mut u8, fd: i32, newfd: i32) -> i32;
    fn posix_spawn_file_actions_addopen(fa: *mut u8, fd: i32, path: *const u8, flags: i32, mode: u32) -> i32;
    fn posix_spawn_file_actions_addchdir_np(fa: *mut u8, path: *const u8) -> i32;
    fn posix_spawnattr_init(a: *mut u8) -> i32;
    fn posix_spawnattr_destroy(a: *mut u8) -> i32;
    fn posix_spawnattr_setflags(a: *mut u8, flags: i16) -> i32;
    fn posix_spawnattr_setsigdefault(a: *mut u8, set: *const u8) -> i32;
    #[link_name = "access"]
    fn c_access(path: *const u8, mode: i32) -> i32;
}
// May block: calls count the G as blocked (see sched::enter_blocked).
extern "C" {
    #[link_name = "read"]
    fn c_read(fd: i32, buf: *mut u8, n: usize) -> isize;
    #[link_name = "write"]
    fn c_write(fd: i32, buf: *const u8, n: usize) -> isize;
    #[link_name = "open"]
    fn c_open(path: *const u8, flags: i32, ...) -> i32;
    fn fsync(fd: i32) -> i32;
    fn waitpid(pid: i32, status: *mut u8, options: i32) -> i32;
    fn poll(fds: *mut u8, n: u64, timeout: i32) -> i32;
    fn posix_spawnp(pid: *mut u8, file: *const u8, fa: *const u8, attr: *const u8, argv: *const *const u8, envp: *const *const u8) -> i32;
}

