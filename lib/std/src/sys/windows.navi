//! Windows (Win32, kernel32): handles, file information, directories, the
//! environment, CreateProcess and pipes. OS errors are GetLastError codes.
//! Strings go to and come from the W (UTF-16) functions, as Rust's std:
//! paths, variables and arguments may be any Unicode (unpaired surrogates
//! read back as U+FFFD).
//!
//! GetLastError is per OS thread: it is read right after the failed call.

use crate::io::{self, Error, ErrorKind};
use crate::string::String;
use crate::sys::{FileAttr, DirEnt, zeroed, rd_u16, rd_u32, rd_u64, wr_u32, wr_u64, split_env};

#[nonblocking]
extern "C" {
    fn GetLastError() -> u32;
    fn SetLastError(code: u32);
    fn FormatMessageW(flags: u32, src: *const u8, id: u32, lang: u32, buf: *mut u16, size: u32, args: *const u8) -> u32;
    fn SetFilePointerEx(h: usize, dist: i64, newpos: *mut u8, method: u32) -> i32;
    fn CloseHandle(h: usize) -> i32;
    fn GetFileInformationByHandle(h: usize, info: *mut u8) -> i32;
    fn SetFileInformationByHandle(h: usize, class: u32, info: *const u8, size: u32) -> i32;
    fn GetFileAttributesExW(name: *const u16, level: u32, info: *mut u8) -> i32;
    fn GetFileAttributesW(name: *const u16) -> u32;
    fn SetFileAttributesW(name: *const u16, attrs: u32) -> i32;
    fn DeleteFileW(name: *const u16) -> i32;
    fn RemoveDirectoryW(name: *const u16) -> i32;
    fn CreateDirectoryW(name: *const u16, sa: *const u8) -> i32;
    fn MoveFileExW(from: *const u16, to: *const u16, flags: u32) -> i32;
    fn CreateHardLinkW(link: *const u16, existing: *const u16, sa: *const u8) -> i32;
    fn CreateSymbolicLinkW(link: *const u16, target: *const u16, flags: u32) -> u8;
    fn GetFinalPathNameByHandleW(h: usize, buf: *mut u16, size: u32, flags: u32) -> u32;
    fn DeviceIoControl(h: usize, code: u32, inbuf: *const u8, insize: u32, outbuf: *mut u8, outsize: u32, ret: *mut u8, ov: usize) -> i32;
    fn FindFirstFileW(pattern: *const u16, data: *mut u8) -> usize;
    fn FindNextFileW(h: usize, data: *mut u8) -> i32;
    fn FindClose(h: usize) -> i32;
    fn GetCurrentDirectoryW(size: u32, buf: *mut u16) -> u32;
    fn SetCurrentDirectoryW(path: *const u16) -> i32;
    fn GetEnvironmentVariableW(name: *const u16, buf: *mut u16, size: u32) -> u32;
    fn SetEnvironmentVariableW(name: *const u16, value: *const u16) -> i32;
    fn GetEnvironmentStringsW() -> *const u16;
    fn FreeEnvironmentStringsW(p: *const u16) -> i32;
    fn GetModuleFileNameW(module: usize, buf: *mut u16, size: u32) -> u32;
    fn GetTempPathW(size: u32, buf: *mut u16) -> u32;
    fn GetCommandLineW() -> *const u16;
    fn GetCurrentProcessId() -> u32;
    fn GetStdHandle(n: u32) -> usize;
    fn GetConsoleMode(h: usize, mode: *mut u8) -> i32;
    fn CreatePipe(r: *mut u8, w: *mut u8, sa: *const u8, size: u32) -> i32;
    fn SetHandleInformation(h: usize, mask: u32, flags: u32) -> i32;
    fn CreateProcessW(app: usize, cmdline: *mut u16, psa: usize, tsa: usize, inherit: i32, flags: u32, env: *const u16, cwd: *const u16, si: *const u8, pi: *mut u8) -> i32;
    fn GetExitCodeProcess(h: usize, code: *mut u8) -> i32;
    fn TerminateProcess(h: usize, code: u32) -> i32;
}
// May block: calls count the G as blocked (see sched::enter_blocked).
extern "C" {
    fn CreateFileW(name: *const u16, access: u32, share: u32, sa: *const u8, disp: u32, flags: u32, tmpl: usize) -> usize;
    fn ReadFile(h: usize, buf: *mut u8, n: u32, done: *mut u8, ov: usize) -> i32;
    fn WriteFile(h: usize, buf: *const u8, n: u32, done: *mut u8, ov: usize) -> i32;
    fn FlushFileBuffers(h: usize) -> i32;
    fn WaitForSingleObject(h: usize, ms: u32) -> u32;
}

/// s as a NUL-terminated UTF-16 string (what the W functions take).
pub fn wide(s: &str) -> io::Result<Vec<u16>> {
    let mut v: Vec<u16> = Vec::with_capacity(s.len() + 1);
    for u in s.encode_utf16() {
        if u == 0 { return Err(io::Error::new(io::ErrorKind::InvalidInput, "file name contained an unexpected NUL byte")); }
        v.push(u);
    }
    v.push(0);
    Ok(v)
}

/// UTF-16 units as a string (unpaired surrogates as U+FFFD).
pub fn from_wide(units: &[u16]) -> String { String::from_utf16_lossy(units) }

// A zeroed buffer of n UTF-16 units.
fn wzeroed(n: usize) -> Vec<u16> {
    let mut v: Vec<u16> = Vec::with_capacity(n);
    unsafe { v.set_len(n); }
    v
}

// The NUL-terminated UTF-16 string at p.
fn from_wide_ptr(p: *const u16) -> String {
    let mut n = 0;
    unsafe { while *crate::rt::ptr_offset(p, n) != 0 { n += 1; } }
    from_wide(crate::rt::slice_from_raw(p, n))
}

// A string a W function writes into a buffer: f(buf, size) returns the
// length written (less than size), the size needed (not less), or 0 on
// failure.
fn fill_wide(f: fn(*mut u16, u32) -> u32) -> io::Result<String> {
    let mut size = 512u32;
    loop {
        let buf = wzeroed(size as usize);
        unsafe { SetLastError(0); }
        let n = f(buf.as_ptr() as *mut u16, size);
        if n == 0 {
            let e = unsafe { GetLastError() };
            if e != 0 { return Err(os_err(e)); }
            return Ok(String::new());
        }
        if n < size { return Ok(from_wide(&buf[0..n as usize])); }
        // GetModuleFileNameW returns size when it truncates.
        size = if n == size { size * 2 } else { n + 1 };
    }
}

const INVALID: usize = 18446744073709551615;
const GENERIC_READ: u32 = 0x80000000;
const GENERIC_WRITE: u32 = 0x40000000;
const APPEND_ACCESS: u32 = 0x120114; // FILE_GENERIC_WRITE without FILE_WRITE_DATA
const SHARE_ALL: u32 = 7;
const FLAG_BACKUP_SEMANTICS: u32 = 0x02000000;
const ATTR_READONLY: u32 = 1;
const ATTR_DIRECTORY: u32 = 0x10;
const ATTR_NORMAL: u32 = 0x80;
const ATTR_REPARSE_POINT: u32 = 0x400;
const ERROR_BROKEN_PIPE: u32 = 109;
const ERROR_ENVVAR_NOT_FOUND: u32 = 203;
const ERROR_NO_MORE_FILES: u32 = 18;
const ERROR_INSUFFICIENT_BUFFER: u32 = 122;
pub const EBADF: i32 = 6; // ERROR_INVALID_HANDLE
pub const EINVAL_CODE: i32 = 87; // ERROR_INVALID_PARAMETER

// --- Errors ------------------------------------------------------------------------

pub fn errno() -> i32 { unsafe { GetLastError() as i32 } }

pub fn error_string(code: i32) -> String {
    let buf = wzeroed(512);
    let n = unsafe { FormatMessageW(0x1200, 0 as *const u8, code as u32, 0, buf.as_ptr() as *mut u16, 512, 0 as *const u8) };
    if n == 0 { return `OS Error ${code}`.to_string(); }
    from_wide(&buf[0..n as usize]).trim_end().to_string()
}

pub fn decode_error_kind(code: i32) -> ErrorKind {
    match code {
        2 | 3 => ErrorKind::NotFound,
        5 => ErrorKind::PermissionDenied,
        8 | 14 => ErrorKind::OutOfMemory,
        17 => ErrorKind::CrossesDevices,
        19 => ErrorKind::ReadOnlyFilesystem,
        32 | 33 => ErrorKind::ResourceBusy,
        39 | 112 => ErrorKind::StorageFull,
        50 | 120 => ErrorKind::Unsupported,
        80 | 183 => ErrorKind::AlreadyExists,
        87 | 131 => ErrorKind::InvalidInput,
        109 | 232 => ErrorKind::BrokenPipe,
        121 | 258 => ErrorKind::TimedOut,
        123 | 206 => ErrorKind::InvalidFilename,
        145 => ErrorKind::DirectoryNotEmpty,
        267 => ErrorKind::NotADirectory,
        1921 => ErrorKind::FilesystemLoop,
        // Winsock (WSAGetLastError).
        10004 => ErrorKind::Interrupted,
        10013 => ErrorKind::PermissionDenied,
        10022 => ErrorKind::InvalidInput,
        10035 => ErrorKind::WouldBlock,
        10048 => ErrorKind::AddrInUse,
        10049 => ErrorKind::AddrNotAvailable,
        10050 => ErrorKind::NetworkDown,
        10051 => ErrorKind::NetworkUnreachable,
        10053 => ErrorKind::ConnectionAborted,
        10054 => ErrorKind::ConnectionReset,
        10057 => ErrorKind::NotConnected,
        10060 => ErrorKind::TimedOut,
        10061 => ErrorKind::ConnectionRefused,
        10065 => ErrorKind::HostUnreachable,
        _ => ErrorKind::Uncategorized,
    }
}

fn last() -> Error { Error::from_raw_os_error(unsafe { GetLastError() as i32 }) }
fn os_err(code: u32) -> Error { Error::from_raw_os_error(code as i32) }

// --- Files -------------------------------------------------------------------------

pub fn open(path: &str, access: u8, append: bool, creation: u8, mode: u32) -> io::Result<i64> {
    let c = wide(path)?;
    let acc = match access {
        0 => GENERIC_READ,
        1 => if append { APPEND_ACCESS } else { GENERIC_WRITE },
        _ => if append { GENERIC_READ | APPEND_ACCESS } else { GENERIC_READ | GENERIC_WRITE },
    };
    let disp = match creation {
        1 => 4, // OPEN_ALWAYS
        2 => 5, // TRUNCATE_EXISTING
        3 => 2, // CREATE_ALWAYS
        4 => 1, // CREATE_NEW
        _ => 3, // OPEN_EXISTING
    };
    let attrs = if mode & 0o222 == 0 { ATTR_READONLY } else { ATTR_NORMAL };
    let h = unsafe { CreateFileW(c.as_ptr(), acc, SHARE_ALL, 0 as *const u8, disp, attrs | FLAG_BACKUP_SEMANTICS, 0) };
    let e = unsafe { GetLastError() };
    if h == INVALID { return Err(os_err(e)); }
    Ok(h as i64)
}

pub fn read(fd: i64, buf: &mut [u8]) -> io::Result<usize> {
    let p = crate::rt::slice_ptr(buf) as *mut u8;
    let n = if buf.len() > 0x7fffffff { 0x7fffffff } else { buf.len() };
    let done = zeroed(8);
    let ok = unsafe { ReadFile(fd as usize, p, n as u32, done.as_ptr() as *mut u8, 0) };
    let e = unsafe { GetLastError() };
    if ok == 0 {
        if e == ERROR_BROKEN_PIPE { return Ok(0); } // the writer closed its end
        return Err(os_err(e));
    }
    Ok(rd_u32(&done, 0) as usize)
}

pub fn write(fd: i64, buf: &[u8]) -> io::Result<usize> {
    let n = if buf.len() > 0x7fffffff { 0x7fffffff } else { buf.len() };
    let done = zeroed(8);
    let ok = unsafe { WriteFile(fd as usize, crate::rt::slice_ptr(buf), n as u32, done.as_ptr() as *mut u8, 0) };
    let e = unsafe { GetLastError() };
    if ok == 0 { return Err(os_err(e)); }
    Ok(rd_u32(&done, 0) as usize)
}

pub fn seek(fd: i64, off: i64, whence: i32) -> io::Result<u64> {
    let pos = zeroed(8);
    let ok = unsafe { SetFilePointerEx(fd as usize, off, pos.as_ptr() as *mut u8, whence as u32) };
    if ok == 0 { return Err(last()); }
    Ok(rd_u64(&pos, 0))
}

pub fn close(fd: i64) -> io::Result<()> {
    if unsafe { CloseHandle(fd as usize) } == 0 { return Err(last()); }
    Ok(())
}

pub fn sync(fd: i64) -> io::Result<()> {
    let ok = unsafe { FlushFileBuffers(fd as usize) };
    let e = unsafe { GetLastError() };
    if ok == 0 { Err(os_err(e)) } else { Ok(()) }
}

pub fn truncate(fd: i64, len: u64) -> io::Result<()> {
    let mut b = zeroed(8);
    wr_u64(&mut b, 0, len);
    if unsafe { SetFileInformationByHandle(fd as usize, 6, b.as_ptr(), 8) } == 0 { return Err(last()); } // FileEndOfFileInfo
    Ok(())
}

fn unix_to_filetime(n: i128) -> u64 { (n / 100 + 116444736000000000) as u64 }
fn filetime_to_unix(ft: u64) -> i128 { (ft as i128 - 116444736000000000) * 100 }

// Sets FILE_BASIC_INFO (zero: unchanged).
fn set_basic(fd: i64, atime: u64, mtime: u64, attrs: u32) -> io::Result<()> {
    let mut b = zeroed(40);
    wr_u64(&mut b, 8, atime);
    wr_u64(&mut b, 16, mtime);
    wr_u32(&mut b, 32, attrs as u64);
    if unsafe { SetFileInformationByHandle(fd as usize, 0, b.as_ptr(), 40) } == 0 { return Err(last()); } // FileBasicInfo
    Ok(())
}

pub fn set_times(fd: i64, atime: Option<i128>, mtime: Option<i128>) -> io::Result<()> {
    let a = match atime { Some(n) => unix_to_filetime(n), None => 0 };
    let m = match mtime { Some(n) => unix_to_filetime(n), None => 0 };
    set_basic(fd, a, m, 0)
}

pub fn fchmod(fd: i64, mode: u32) -> io::Result<()> {
    let a = fstat(fd)?;
    let mut attrs = a.attrib;
    if mode & 0o222 == 0 { attrs = attrs | ATTR_READONLY; } else { attrs = attrs & !ATTR_READONLY; }
    if attrs == 0 { attrs = ATTR_NORMAL; }
    set_basic(fd, 0, 0, attrs)
}

pub fn isatty(fd: i64) -> bool {
    let m = zeroed(8);
    unsafe { GetConsoleMode(fd as usize, m.as_ptr() as *mut u8) != 0 }
}

/// The standard streams' handles (0 stdin, 1 stdout, 2 stderr).
pub fn stdio_fd(n: i32) -> i64 { unsafe { GetStdHandle((-10 - n) as u32) as i64 } }

// --- Metadata ----------------------------------------------------------------------

fn make_attr(attrs: u32, size: u64, ct: u64, at: u64, wt: u64, follow: bool) -> FileAttr {
    let typ = if !follow && attrs & ATTR_REPARSE_POINT != 0 {
        crate::sys::S_IFLNK
    } else if attrs & ATTR_DIRECTORY != 0 {
        crate::sys::S_IFDIR
    } else {
        crate::sys::S_IFREG
    };
    let perm = if attrs & ATTR_READONLY != 0 { 0o444 } else { 0o666 };
    FileAttr {
        mode: typ | perm, size, atime: filetime_to_unix(at), mtime: filetime_to_unix(wt), ctime: filetime_to_unix(wt),
        btime: filetime_to_unix(ct), has_btime: true, dev: 0, ino: 0, nlink: 1, uid: 0, gid: 0, rdev: 0, blksize: 4096,
        blocks: 0, attrib: attrs,
    }
}

pub fn fstat(fd: i64) -> io::Result<FileAttr> {
    let b = zeroed(56);
    if unsafe { GetFileInformationByHandle(fd as usize, b.as_ptr() as *mut u8) } == 0 { return Err(last()); }
    let mut a = make_attr(rd_u32(&b, 0) as u32, rd_u32(&b, 32) << 32 | rd_u32(&b, 36), rd_u64(&b, 4), rd_u64(&b, 12), rd_u64(&b, 20), true);
    a.dev = rd_u32(&b, 28);
    a.nlink = rd_u32(&b, 40);
    a.ino = rd_u32(&b, 44) << 32 | rd_u32(&b, 48);
    Ok(a)
}

fn open_any(path: &str) -> io::Result<usize> { open_flags(path, FLAG_BACKUP_SEMANTICS) }

fn open_flags(path: &str, flags: u32) -> io::Result<usize> {
    let c = wide(path)?;
    let h = unsafe { CreateFileW(c.as_ptr(), 0, SHARE_ALL, 0 as *const u8, 3, flags, 0) };
    if h == INVALID { return Err(last()); }
    Ok(h)
}

pub fn stat(path: &str, follow: bool) -> io::Result<FileAttr> {
    if follow {
        let h = open_any(path)?;
        let r = fstat(h as i64);
        unsafe { CloseHandle(h); }
        return r;
    }
    let c = wide(path)?;
    let b = zeroed(40);
    if unsafe { GetFileAttributesExW(c.as_ptr(), 0, b.as_ptr() as *mut u8) } == 0 { return Err(last()); }
    Ok(make_attr(rd_u32(&b, 0) as u32, rd_u32(&b, 28) << 32 | rd_u32(&b, 32), rd_u64(&b, 4), rd_u64(&b, 12), rd_u64(&b, 20), false))
}

// --- Paths and directories ------------------------------------------------------------

fn path_call(path: &str, f: fn(*const u16) -> i32) -> io::Result<()> {
    let c = wide(path)?;
    if f(c.as_ptr()) == 0 { return Err(last()); }
    Ok(())
}

pub fn unlink(path: &str) -> io::Result<()> { path_call(path, |p| unsafe { DeleteFileW(p) }) }

/// Removes a symbolic link: a directory link is removed as a directory.
pub fn unlink_link(path: &str, attr: &FileAttr) -> io::Result<()> {
    if attr.attrib & ATTR_DIRECTORY != 0 { rmdir(path) } else { unlink(path) }
}

pub fn rmdir(path: &str) -> io::Result<()> { path_call(path, |p| unsafe { RemoveDirectoryW(p) }) }

pub fn mkdir(path: &str, mode: u32) -> io::Result<()> { path_call(path, |p| unsafe { CreateDirectoryW(p, 0 as *const u8) }) }

pub fn rename(from: &str, to: &str) -> io::Result<()> {
    let a = wide(from)?;
    let b = wide(to)?;
    if unsafe { MoveFileExW(a.as_ptr(), b.as_ptr(), 1) } == 0 { return Err(last()); } // MOVEFILE_REPLACE_EXISTING
    Ok(())
}

pub fn link(from: &str, to: &str) -> io::Result<()> {
    let a = wide(from)?;
    let b = wide(to)?;
    if unsafe { CreateHardLinkW(b.as_ptr(), a.as_ptr(), 0 as *const u8) } == 0 { return Err(last()); }
    Ok(())
}

pub fn symlink(target: &str, link: &str, dir: bool) -> io::Result<()> {
    // Windows takes \ in link targets (a relative target with / does not
    // resolve).
    let a = wide(target.replace("/", "\\").as_str())?;
    let b = wide(link)?;
    // SYMBOLIC_LINK_FLAG_DIRECTORY, ALLOW_UNPRIVILEGED_CREATE
    let flags = if dir { 3 } else { 2 };
    if unsafe { CreateSymbolicLinkW(b.as_ptr(), a.as_ptr(), flags) } == 0 { return Err(last()); }
    Ok(())
}

// The final path of an open handle (with the \\?\ prefix, as Rust's
// canonicalize returns it).
fn final_path(h: usize) -> io::Result<String> {
    fill_wide(|buf, size| unsafe { GetFinalPathNameByHandleW(h, buf, size, 0) })
}

/// What a symbolic link (or a junction) contains: its reparse point's
/// print name (what it was made with), else its substitute name without
/// the \??\ prefix.
pub fn readlink(path: &str) -> io::Result<String> {
    // FILE_FLAG_OPEN_REPARSE_POINT: the link, not its target.
    let h = open_flags(path, FLAG_BACKUP_SEMANTICS | 0x00200000)?;
    let buf = zeroed(16384);
    let ret = zeroed(8);
    // FSCTL_GET_REPARSE_POINT
    let ok = unsafe { DeviceIoControl(h, 0x000900A8, 0 as *const u8, 0, buf.as_ptr() as *mut u8, 16384, ret.as_ptr() as *mut u8, 0) };
    let e = unsafe { GetLastError() };
    unsafe { CloseHandle(h); }
    if ok == 0 { return Err(os_err(e)); }
    let tag = rd_u32(&buf, 0) as u32;
    // A symbolic link's names follow its flags; a junction's do not.
    let names = if tag == 0xA000000C { 20 } else if tag == 0xA0000003 { 16 } else {
        return Err(Error::new(ErrorKind::InvalidInput, "not a symbolic link"));
    };
    let name = |off: usize, len: usize| -> String {
        let mut units: Vec<u16> = Vec::new();
        let mut i = 0;
        while i < len / 2 {
            units.push(rd_u16(&buf, names + off + 2 * i) as u16);
            i += 1;
        }
        from_wide(units.as_slice())
    };
    let print = name(rd_u16(&buf, 12) as usize, rd_u16(&buf, 14) as usize);
    if print.len() > 0 { return Ok(print); }
    let sub = name(rd_u16(&buf, 8) as usize, rd_u16(&buf, 10) as usize);
    match sub.strip_prefix("\\??\\") { Some(r) => Ok(r.to_string()), None => Ok(sub) }
}

pub fn realpath(path: &str) -> io::Result<String> {
    let h = open_any(path)?;
    let r = final_path(h);
    unsafe { CloseHandle(h); }
    r
}

/// Sets or clears the read-only attribute (the rest of mode is ignored).
pub fn chmod(path: &str, mode: u32, readonly: bool) -> io::Result<()> {
    let c = wide(path)?;
    let a = unsafe { GetFileAttributesW(c.as_ptr()) };
    if a == 4294967295 { return Err(last()); }
    let mut na = if readonly { a | ATTR_READONLY } else { a & !ATTR_READONLY };
    if na == 0 { na = ATTR_NORMAL; }
    if unsafe { SetFileAttributesW(c.as_ptr(), na) } == 0 { return Err(last()); }
    Ok(())
}

pub fn read_dir(path: &str) -> io::Result<Vec<DirEnt>> {
    let mut pat = path.to_string();
    if !pat.ends_with("\\") && !pat.ends_with("/") { pat.push('\\'); }
    pat.push('*');
    let c = wide(pat.as_str())?;
    let data = zeroed(600); // WIN32_FIND_DATAW
    let dp = data.as_ptr() as *mut u8;
    let h = unsafe { FindFirstFileW(c.as_ptr(), dp) };
    if h == INVALID { return Err(last()); }
    let mut out: Vec<DirEnt> = Vec::new();
    loop {
        // cFileName: 260 UTF-16 units at 44.
        let name = from_wide_ptr(crate::rt::ptr_offset(data.as_ptr(), 44) as *const u16);
        if name != "." && name != ".." {
            let attrs = rd_u32(&data, 0) as u32;
            let typ = if attrs & ATTR_REPARSE_POINT != 0 {
                crate::sys::S_IFLNK
            } else if attrs & ATTR_DIRECTORY != 0 {
                crate::sys::S_IFDIR
            } else {
                crate::sys::S_IFREG
            };
            out.push(DirEnt { name, typ });
        }
        if unsafe { FindNextFileW(h, dp) } == 0 {
            let e = unsafe { GetLastError() };
            unsafe { FindClose(h); }
            if e == ERROR_NO_MORE_FILES { return Ok(out); }
            return Err(os_err(e));
        }
    }
}

pub fn getcwd() -> io::Result<String> {
    fill_wide(|buf, size| unsafe { GetCurrentDirectoryW(size, buf) })
}

pub fn chdir(path: &str) -> io::Result<()> { path_call(path, |p| unsafe { SetCurrentDirectoryW(p) }) }

// --- Environment -------------------------------------------------------------------

pub fn getenv(name: &str) -> Option<String> {
    let c = match wide(name) { Ok(c) => c, Err(_) => return None };
    match fill_wide(|buf, size| unsafe { GetEnvironmentVariableW(c.as_ptr(), buf, size) }) {
        Ok(v) => Some(v),
        Err(e) => if e.raw_os_error() == Some(ERROR_ENVVAR_NOT_FOUND as i32) { None } else { Some(String::new()) },
    }
}

fn check_env_name(name: &str) -> io::Result<()> {
    if name.len() == 0 || name[1..].contains('=') {
        return Err(Error::new(ErrorKind::InvalidInput, `invalid environment variable name: ${name:?}`.to_string()));
    }
    Ok(())
}

pub fn setenv(name: &str, value: &str) -> io::Result<()> {
    check_env_name(name)?;
    let n = wide(name)?;
    let v = wide(value)?;
    if unsafe { SetEnvironmentVariableW(n.as_ptr(), v.as_ptr()) } == 0 { return Err(last()); }
    Ok(())
}

pub fn unsetenv(name: &str) -> io::Result<()> {
    check_env_name(name)?;
    let n = wide(name)?;
    if unsafe { SetEnvironmentVariableW(n.as_ptr(), 0 as *const u16) } == 0 {
        let e = unsafe { GetLastError() };
        if e != ERROR_ENVVAR_NOT_FOUND { return Err(os_err(e)); }
    }
    Ok(())
}

pub fn environ() -> Vec<(String, String)> {
    let mut out: Vec<(String, String)> = Vec::new();
    let block = unsafe { GetEnvironmentStringsW() };
    if block as usize == 0 { return out; }
    let mut p = block;
    loop {
        let mut n = 0;
        unsafe { while *crate::rt::ptr_offset(p, n) != 0 { n += 1; } }
        if n == 0 { break; }
        let s = from_wide(crate::rt::slice_from_raw(p, n));
        p = crate::rt::ptr_offset(p, n + 1);
        if let Some(kv) = split_env(s.as_str()) { out.push(kv); }
    }
    unsafe { FreeEnvironmentStringsW(block); }
    out
}

/// Whether two variable names are the same (case does not matter).
pub fn env_name_eq(a: &str, b: &str) -> bool { a.eq_ignore_ascii_case(b) }

pub fn home_dir() -> Option<String> {
    match getenv("USERPROFILE") { Some(h) => if h.len() > 0 { Some(h) } else { None }, None => None }
}

pub fn current_exe() -> io::Result<String> {
    fill_wide(|buf, size| unsafe { GetModuleFileNameW(0, buf, size) })
}

/// GetTempPathW's directory (TMP, TEMP, USERPROFILE or the Windows
/// directory), without its trailing \.
pub fn temp_dir() -> String {
    match fill_wide(|buf, size| unsafe { GetTempPathW(size, buf) }) {
        Ok(t) => if t.len() > 3 && t.ends_with("\\") { t[0..t.len() - 1].to_string() } else { t },
        Err(_) => "C:\\Windows\\Temp".to_string(),
    }
}

static mut ARGS: Option<Vec<String>> = None;

/// The command line's arguments (from GetCommandLineW, split as the C
/// runtime splits them, as Rust's std).
pub fn args() -> Vec<String> {
    if let Some(a) = ARGS { return a; }
    let a = split_command_line(from_wide_ptr(unsafe { GetCommandLineW() }).as_str());
    ARGS = Some(a);
    a
}

// The C runtime's rules: the program name ends at the next space (or at
// its closing quote); then arguments are separated by spaces and tabs,
// quotes group, and backslashes escape a quote (2n backslashes and a quote
// are n backslashes and a group's edge, 2n+1 are n and a literal quote).
fn split_command_line(line: &str) -> Vec<String> {
    let mut out: Vec<String> = Vec::new();
    let cs: Vec<char> = line.chars().collect();
    let mut i = 0;
    let mut prog = String::new();
    if i < cs.len() && cs[i] == '"' {
        i += 1;
        while i < cs.len() && cs[i] != '"' { prog.push(cs[i]); i += 1; }
        if i < cs.len() { i += 1; }
    } else {
        while i < cs.len() && cs[i] != ' ' && cs[i] != '\t' { prog.push(cs[i]); i += 1; }
    }
    out.push(prog);
    loop {
        while i < cs.len() && (cs[i] == ' ' || cs[i] == '\t') { i += 1; }
        if i >= cs.len() { break; }
        let mut arg = String::new();
        let mut quoted = false;
        while i < cs.len() {
            let c = cs[i];
            if !quoted && (c == ' ' || c == '\t') { break; }
            if c == '\\' {
                let mut n = 0;
                while i < cs.len() && cs[i] == '\\' { n += 1; i += 1; }
                if i < cs.len() && cs[i] == '"' {
                    let mut k = 0;
                    while k < n / 2 { arg.push('\\'); k += 1; }
                    if n % 2 == 1 {
                        arg.push('"');
                        i += 1;
                    }
                } else {
                    let mut k = 0;
                    while k < n { arg.push('\\'); k += 1; }
                }
                continue;
            }
            if c == '"' {
                // "" inside a group is a literal quote.
                if quoted && i + 1 < cs.len() && cs[i + 1] == '"' {
                    arg.push('"');
                    i += 2;
                    continue;
                }
                quoted = !quoted;
                i += 1;
                continue;
            }
            arg.push(c);
            i += 1;
        }
        out.push(arg);
    }
    out
}

pub fn getpid() -> u32 { unsafe { GetCurrentProcessId() } }

// --- Processes ----------------------------------------------------------------------

/// A pipe (read end, write end); neither end is inheritable (spawn makes
/// the child's end so for the child).
pub fn pipe_pair() -> io::Result<(i64, i64)> {
    let r = zeroed(8);
    let w = zeroed(8);
    let mut sa = zeroed(24);
    wr_u32(&mut sa, 0, 24);
    if unsafe { CreatePipe(r.as_ptr() as *mut u8, w.as_ptr() as *mut u8, sa.as_ptr(), 0) } == 0 { return Err(last()); }
    Ok((rd_u64(&r, 0) as i64, rd_u64(&w, 0) as i64))
}

// Appends an argument quoted as the C runtime parses command lines.
fn append_arg(cmd: &mut String, arg: &str, force: bool) {
    let quote = force || arg.len() == 0 || arg.contains(' ') || arg.contains('\t');
    if quote { cmd.push('"'); }
    let mut backslashes = 0;
    for c in arg.chars() {
        if c == '\\' {
            backslashes += 1;
        } else {
            if c == '"' {
                let mut k = 0;
                while k < backslashes + 1 {
                    cmd.push('\\');
                    k += 1;
                }
            }
            backslashes = 0;
        }
        cmd.push(c);
    }
    if quote {
        let mut k = 0;
        while k < backslashes {
            cmd.push('\\');
            k += 1;
        }
        cmd.push('"');
    }
}

/// Starts program with argv, env (NAME=value) and cwd; the standard
/// streams inherited, NUL or the given handles. Returns (pid, process
/// handle).
pub fn spawn(program: &str, argv: &[String], env: &[String], cwd: Option<&str>, kinds: &[u8], fds: &[i64]) -> io::Result<(i64, i64)> {
    let mut cmd = String::new();
    let mut i = 0;
    while i < argv.len() {
        if i > 0 { cmd.push(' '); }
        append_arg(&mut cmd, argv[i].as_str(), i == 0);
        i += 1;
    }
    let cmdline = wide(cmd.as_str())?;
    // The environment block: sorted NAME=value strings, then an empty one
    // (UTF-16: CREATE_UNICODE_ENVIRONMENT).
    let mut sorted = env.to_vec();
    sorted.sort_by(|a: &String, b: &String| a.to_uppercase().cmp(&b.to_uppercase()));
    let mut block: Vec<u16> = Vec::new();
    for s in sorted.iter() {
        for u in s.encode_utf16() { block.push(u); }
        block.push(0);
    }
    if sorted.len() == 0 { block.push(0); }
    block.push(0);
    let dir = match cwd { Some(d) => Some(wide(d)?), None => None };
    let mut sa = zeroed(24);
    wr_u32(&mut sa, 0, 24);
    wr_u32(&mut sa, 16, 1); // inheritable
    let mut si = zeroed(104);
    wr_u32(&mut si, 0, 104);
    wr_u32(&mut si, 60, 0x100); // STARTF_USESTDHANDLES
    let mut opened: Vec<usize> = Vec::new();
    let nul = wide("NUL")?;
    let mut k = 0;
    while k < 3 {
        let h = if kinds[k] == crate::sys::STDIO_NULL {
            let acc = if k == 0 { GENERIC_READ } else { GENERIC_WRITE };
            let h = unsafe { CreateFileW(nul.as_ptr(), acc, SHARE_ALL, sa.as_ptr(), 3, 0, 0) };
            if h != INVALID { opened.push(h); }
            h
        } else if kinds[k] == crate::sys::STDIO_FD {
            fds[k] as usize
        } else {
            unsafe { GetStdHandle((-10 - k as i32) as u32) }
        };
        if h != INVALID && h != 0 { unsafe { SetHandleInformation(h, 1, 1); } } // HANDLE_FLAG_INHERIT
        wr_u64(&mut si, 80 + 8 * k, h as u64);
        k += 1;
    }
    let pi = zeroed(24);
    let cwdp = match &dir { Some(d) => d.as_ptr(), None => 0 as *const u16 };
    // CREATE_UNICODE_ENVIRONMENT
    let ok = unsafe { CreateProcessW(0, cmdline.as_ptr() as *mut u16, 0, 0, 1, 0x400, block.as_ptr(), cwdp, si.as_ptr(), pi.as_ptr() as *mut u8) };
    let e = unsafe { GetLastError() };
    // The handles given to the child are not inherited by later children.
    k = 0;
    while k < 3 {
        if kinds[k] == crate::sys::STDIO_FD { unsafe { SetHandleInformation(fds[k] as usize, 1, 0); } }
        k += 1;
    }
    for h in opened.iter() { unsafe { CloseHandle(*h); } }
    if ok == 0 { return Err(os_err(e)); }
    unsafe { CloseHandle(rd_u64(&pi, 8) as usize); }
    Ok((rd_u32(&pi, 16) as i64, rd_u64(&pi, 0) as i64))
}

/// Waits for a child (block: until it ends); the status is its exit code.
pub fn wait(pid: i64, handle: i64, block: bool) -> io::Result<Option<i32>> {
    let r = unsafe { WaitForSingleObject(handle as usize, if block { 0xffffffff } else { 0 }) };
    let e = unsafe { GetLastError() };
    if r == 258 { return Ok(None); } // WAIT_TIMEOUT
    if r != 0 { return Err(os_err(e)); }
    let code = zeroed(8);
    if unsafe { GetExitCodeProcess(handle as usize, code.as_ptr() as *mut u8) } == 0 { return Err(last()); }
    Ok(Some(rd_u32(&code, 0) as i32))
}

pub fn kill(pid: i64, handle: i64) -> io::Result<()> {
    if unsafe { TerminateProcess(handle as usize, 1) } == 0 { return Err(last()); }
    Ok(())
}

pub fn close_process(handle: i64) { unsafe { CloseHandle(handle as usize); } }

fn read_all(fd: i64) -> io::Result<Vec<u8>> {
    let mut out: Vec<u8> = Vec::new();
    let mut chunk = zeroed(16384);
    loop {
        let n = read(fd, chunk.as_mut_slice())?;
        if n == 0 { return Ok(out); }
        out.extend_from_slice(&chunk[0..n]);
    }
}

/// Reads two handles to their ends (-1: none): the second on another
/// green thread (anonymous pipes cannot be polled).
pub fn read2(fd1: i64, fd2: i64) -> io::Result<(Vec<u8>, Vec<u8>)> {
    if fd1 < 0 || fd2 < 0 {
        let a = if fd1 >= 0 { read_all(fd1)? } else { Vec::new() };
        let b = if fd2 >= 0 { read_all(fd2)? } else { Vec::new() };
        return Ok((a, b));
    }
    let h = crate::thread::spawn(|| read_all(fd2));
    let a = read_all(fd1);
    let b = match h.join() {
        Ok(r) => r,
        Err(_) => Err(Error::new(ErrorKind::Other, "reading the child's stderr panicked")),
    };
    Ok((a?, b?))
}
