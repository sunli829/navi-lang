//! The operating system layer of std::fs, std::io, std::env and
//! std::process (navi only; private): file descriptors (handles on
//! Windows), metadata, directories, the environment and child processes,
//! with OS errors turned into io::Error.
//!
//! Each platform module provides the same functions; descriptors and
//! handles are i64 (-1: none).

#[cfg(not(target_os = "windows"))]
mod unix;
#[cfg(not(target_os = "windows"))]
pub use self::unix::*;
#[cfg(target_os = "windows")]
mod windows;
#[cfg(target_os = "windows")]
pub use self::windows::*;

use crate::io;
use crate::string::String;

/// What stat says about a file. Times are nanoseconds since the Unix
/// epoch. On Windows mode is made up (the S_IF* type bits, 0o444 or 0o666)
/// and attrib holds the file attributes.
#[derive(Clone, Debug)]
pub struct FileAttr {
    pub mode: u32,
    pub size: u64,
    pub atime: i128,
    pub mtime: i128,
    pub ctime: i128,
    pub btime: i128,
    pub has_btime: bool,
    pub dev: u64,
    pub ino: u64,
    pub nlink: u64,
    pub uid: u32,
    pub gid: u32,
    pub rdev: u64,
    pub blksize: u64,
    pub blocks: u64,
    pub attrib: u32,
}

pub const S_IFMT: u32 = 0o170000;
pub const S_IFIFO: u32 = 0o010000;
pub const S_IFCHR: u32 = 0o020000;
pub const S_IFDIR: u32 = 0o040000;
pub const S_IFBLK: u32 = 0o060000;
pub const S_IFREG: u32 = 0o100000;
pub const S_IFLNK: u32 = 0o120000;
pub const S_IFSOCK: u32 = 0o140000;

/// How open treats an existing or missing file.
pub const OPEN_EXISTING: u8 = 0;
pub const OPEN_CREATE: u8 = 1;
pub const OPEN_TRUNCATE: u8 = 2;
pub const OPEN_CREATE_TRUNCATE: u8 = 3;
pub const OPEN_CREATE_NEW: u8 = 4;

/// What a child's standard stream is connected to.
pub const STDIO_INHERIT: u8 = 0;
pub const STDIO_NULL: u8 = 1;
pub const STDIO_FD: u8 = 2;

/// A directory entry as read_dir lists it: the name and the type when
/// the directory says (0: unknown, else the S_IF* bits).
pub struct DirEnt {
    pub name: String,
    pub typ: u32,
}

/// A NUL-terminated copy of s (InvalidInput if s has a NUL byte).
pub fn cstring(s: &str) -> io::Result<Vec<u8>> {
    let b = s.as_bytes();
    let mut v: Vec<u8> = Vec::with_capacity(b.len() + 1);
    let mut i = 0;
    while i < b.len() {
        if b[i] == 0 { return Err(io::Error::new(io::ErrorKind::InvalidInput, "file name contained an unexpected NUL byte")); }
        i += 1;
    }
    v.extend_from_slice(b);
    v.push(0);
    Ok(v)
}

/// The string at a C pointer (copied; invalid UTF-8 replaced).
pub fn from_cstr(p: *const u8) -> String {
    let mut n = 0;
    unsafe { while *crate::rt::ptr_offset(p, n) != 0 { n += 1; } }
    String::from_utf8_lossy(crate::rt::slice_from_raw(p, n))
}

/// A zeroed buffer of n bytes.
pub fn zeroed(n: usize) -> Vec<u8> {
    // A new allocation is zeroed.
    let mut v: Vec<u8> = Vec::with_capacity(n);
    unsafe { v.set_len(n); }
    v
}

pub fn rd_u16(b: &Vec<u8>, at: usize) -> u64 { b[at] as u64 | (b[at + 1] as u64) << 8 }
pub fn rd_u32(b: &Vec<u8>, at: usize) -> u64 { rd_u16(b, at) | rd_u16(b, at + 2) << 16 }
pub fn rd_u64(b: &Vec<u8>, at: usize) -> u64 { rd_u32(b, at) | rd_u32(b, at + 4) << 32 }
pub fn wr_u32(b: &mut Vec<u8>, at: usize, v: u64) {
    let mut i = 0;
    while i < 4 {
        b[at + i] = (v >> (8 * i) as u32) as u8;
        i += 1;
    }
}
pub fn wr_u64(b: &mut Vec<u8>, at: usize, v: u64) {
    wr_u32(b, at, v & 0xffffffff);
    wr_u32(b, at + 4, v >> 32);
}

/// Splits "NAME=value" (a name may start with '=', as Windows' "=C:").
pub fn split_env(s: &str) -> Option<(String, String)> {
    let b = s.as_bytes();
    let mut i = 1;
    while i < b.len() {
        if b[i] == b'=' { return Some((s[0..i].to_string(), s[i + 1..].to_string())); }
        i += 1;
    }
    None
}
