//! Adapters (Take, Chain, Bytes), empty/sink/repeat, copy, and Read and
//! Write for byte slices, vectors and references.

use crate::io::{self, BufRead, Error, ErrorKind, Read, Seek, SeekFrom, Write};
use crate::string::String;

/// Copies the entire contents of a reader into a writer, and returns the number
/// of bytes copied.
///
/// This function will continuously read data from `reader` and then write it
/// into `writer` in a streaming fashion until `reader` returns EOF. Errors of
/// kind [`ErrorKind::Interrupted`] are retried.
///
/// # Errors
///
/// This function will return an error immediately if any call to
/// [`read`](Read::read) or [`write_all`](Write::write_all) returns an error;
/// what was copied until then stays written.
///
/// # Examples
///
/// ```
/// use std::io;
///
/// fn main() -> io::Result<()> {
///     let mut reader: &[u8] = b"hello";
///     let mut writer: Vec<u8> = Vec::new();
///
///     io::copy(&mut reader, &mut writer)?;
///
///     assert_eq(&b"hello"[..], &writer[..]);
///     Ok(())
/// }
/// ```
pub fn copy<R: Read, W: Write>(reader: &mut R, writer: &mut W) -> io::Result<u64> {
    let mut buf = crate::sys::zeroed(8192);
    let mut total = 0u64;
    loop {
        let n = match reader.read(buf.as_mut_slice()) {
            Ok(n) => n,
            Err(e) => {
                if e.kind() == ErrorKind::Interrupted {
                    continue;
                }
                return Err(e);
            }
        };
        if n == 0 {
            return Ok(total);
        }
        writer.write_all(&buf[0..n])?;
        total += n as u64;
    }
}

/// Reads all bytes from a reader into a new [`String`].
///
/// This is a convenience function for [`Read::read_to_string`]: no need to
/// create the `String` first.
///
/// # Errors
///
/// Returns an error if reading fails, or if the data is not valid UTF-8 (an
/// error of kind [`ErrorKind::InvalidData`]).
///
/// # Examples
///
/// ```
/// use std::io;
///
/// fn main() -> io::Result<()> {
///     let reader: &[u8] = b"one\ntwo\n";
///     let text = io::read_to_string(reader)?;
///     assert_eq(text, "one\ntwo\n");
///     Ok(())
/// }
/// ```
pub fn read_to_string<R: Read>(reader: R) -> io::Result<String> {
    let mut r = reader;
    let mut s = String::new();
    r.read_to_string(&mut s)?;
    Ok(s)
}

/// `Empty` ignores any data written via [`Write`], and will always be empty
/// (returning zero bytes) when read via [`Read`].
///
/// This struct is generally created by calling [`empty()`]. Please see the
/// documentation of [`empty()`] for more details.
///
/// # Examples
///
/// ```
/// use std::io::{self, Read, Write};
///
/// let mut e = io::empty();
/// let mut buf = String::new();
/// assert_eq(e.read_to_string(&mut buf).unwrap(), 0);
/// assert_eq(e.write(b"ignored").unwrap(), 7);
/// ```
#[derive(Debug, Clone, Default)]
pub struct Empty;

/// Creates a value that is always at EOF for reads, and ignores all data
/// written.
///
/// All calls to [`write`](Write::write) on the returned instance will return
/// `Ok(buf.len())` and the contents of the buffer will not be inspected.
///
/// All calls to [`read`](Read::read) from the returned reader will return
/// `Ok(0)`.
///
/// # Examples
///
/// ```
/// use std::io::{self, Read, Write};
///
/// let buffer = Vec::from([1u8, 2, 3, 5, 8]);
/// let num_bytes = io::empty().write(&buffer).unwrap();
/// assert_eq(num_bytes, 5);
///
/// let mut buffer = String::new();
/// io::empty().read_to_string(&mut buffer).unwrap();
/// assert(buffer.is_empty());
/// ```
pub fn empty() -> Empty {
    Empty
}

impl Read for Empty {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        Ok(0)
    }
}

impl BufRead for Empty {
    fn fill_buf(&mut self) -> io::Result<&[u8]> {
        Ok(&[])
    }
    fn consume(&mut self, amt: usize) {}
}

impl Write for Empty {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        Ok(buf.len())
    }
    fn flush(&mut self) -> io::Result<()> {
        Ok(())
    }
}

impl Seek for Empty {
    fn seek(&mut self, pos: SeekFrom) -> io::Result<u64> {
        Ok(0)
    }
}

/// A writer which will move data into the void.
///
/// This struct is generally created by calling [`sink()`]. Please see the
/// documentation of [`sink()`] for more details.
///
/// # Examples
///
/// ```
/// use std::io::{self, Write};
///
/// let mut s = io::sink();
/// s.write_all(b"gone").unwrap();
/// s.flush().unwrap();
/// ```
#[derive(Debug, Clone, Default)]
pub struct Sink;

/// Creates an instance of a writer which will successfully consume all data.
///
/// All calls to [`write`](Write::write) on the returned instance will return
/// `Ok(buf.len())` and the contents of the buffer will not be inspected.
///
/// # Examples
///
/// ```
/// use std::io::{self, Write};
///
/// let buffer = Vec::from([1u8, 2, 3, 5, 8]);
/// let num_bytes = io::sink().write(&buffer).unwrap();
/// assert_eq(num_bytes, 5);
/// ```
pub fn sink() -> Sink {
    Sink
}

impl Write for Sink {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        Ok(buf.len())
    }
    fn flush(&mut self) -> io::Result<()> {
        Ok(())
    }
}

/// A reader which yields one byte over and over again.
///
/// This struct is generally created by calling [`repeat()`]. Please see the
/// documentation of [`repeat()`] for more details.
///
/// # Examples
///
/// ```
/// use std::io::{self, Read};
///
/// let mut r = io::repeat(b'x');
/// let mut buf = [0u8; 3];
/// r.read_exact(&mut buf).unwrap();
/// assert_eq(&buf[..], b"xxx");
/// ```
#[derive(Debug, Clone)]
pub struct Repeat {
    byte: u8,
}

/// Creates an instance of a reader that infinitely repeats one byte.
///
/// All reads from this reader will succeed by filling the specified buffer with
/// the given byte. Combine it with [`Read::take`] to get a finite reader.
///
/// # Examples
///
/// ```
/// use std::io::{self, Read};
///
/// let mut buffer = [0u8; 3];
/// io::repeat(0b101).read_exact(&mut buffer).unwrap();
/// assert_eq(buffer, [0b101, 0b101, 0b101]);
///
/// let mut s = String::new();
/// io::repeat(b'a').take(4).read_to_string(&mut s).unwrap();
/// assert_eq(s, "aaaa");
/// ```
pub fn repeat(byte: u8) -> Repeat {
    Repeat { byte }
}

impl Read for Repeat {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        let mut i = 0;
        while i < buf.len() {
            buf[i] = self.byte;
            i += 1;
        }
        Ok(buf.len())
    }
}

/// Reader adapter which limits the bytes read from an underlying reader.
///
/// This struct is generally created by calling [`take`](Read::take) on a
/// reader. Please see the documentation of [`take`](Read::take) for more
/// details.
///
/// # Examples
///
/// ```
/// use std::io::Read;
///
/// let data: &[u8] = b"hello world";
/// let mut handle = data.take(5);
/// let mut s = String::new();
/// handle.read_to_string(&mut s).unwrap();
/// assert_eq(s, "hello");
/// ```
#[derive(Debug, Clone)]
pub struct Take<R> {
    pub(crate) inner: R,
    pub(crate) limit: u64,
}

impl<R> Take<R> {
    /// Returns the number of bytes that can be read before this instance will
    /// return EOF.
    ///
    /// # Note
    ///
    /// This instance may reach `EOF` after reading fewer bytes than indicated
    /// by this method if the underlying [`Read`] instance reaches EOF.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::Read;
    ///
    /// let data: &[u8] = b"hello world";
    /// let mut handle = data.take(5);
    /// assert_eq(handle.limit(), 5);
    /// let mut buf = [0u8; 2];
    /// handle.read(&mut buf).unwrap();
    /// assert_eq(handle.limit(), 3);
    /// ```
    pub fn limit(&self) -> u64 {
        self.limit
    }
    /// Sets the number of bytes that can be read before this instance will
    /// return EOF. This is the same as constructing a new `Take` instance, so
    /// the amount of bytes read and the previous limit value don't matter when
    /// calling this method.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::Read;
    ///
    /// let data: &[u8] = b"hello world";
    /// let mut handle = data.take(5);
    /// handle.set_limit(8);
    /// let mut s = String::new();
    /// handle.read_to_string(&mut s).unwrap();
    /// assert_eq(s, "hello wo");
    /// ```
    pub fn set_limit(&mut self, limit: u64) {
        self.limit = limit;
    }
    /// Consumes the `Take`, returning the wrapped reader.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::Read;
    ///
    /// let data: &[u8] = b"hello world";
    /// let mut handle = data.take(6);
    /// let mut first = String::new();
    /// handle.read_to_string(&mut first).unwrap();
    /// let mut rest = handle.into_inner();
    /// let mut second = String::new();
    /// rest.read_to_string(&mut second).unwrap();
    /// assert_eq(first, "hello ");
    /// assert_eq(second, "world");
    /// ```
    pub fn into_inner(self) -> R {
        self.inner
    }
    /// Gets a reference to the underlying reader.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::Read;
    ///
    /// let data: &[u8] = b"hello world";
    /// let mut handle = data.take(5);
    /// let mut buf = [0u8; 5];
    /// handle.read_exact(&mut buf).unwrap();
    /// // The slice reader has moved past what was read.
    /// assert_eq(*handle.get_ref(), b" world");
    /// ```
    pub fn get_ref(&self) -> &R {
        &self.inner
    }
    /// Gets a mutable reference to the underlying reader.
    ///
    /// Care should be taken to avoid modifying the internal I/O state of the
    /// underlying reader as doing so may corrupt the internal limit of this
    /// `Take`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{Cursor, Read};
    ///
    /// let mut handle = Cursor::new(b"hello world".to_vec()).take(5);
    /// handle.get_mut().set_position(6);
    /// let mut s = String::new();
    /// handle.read_to_string(&mut s).unwrap();
    /// assert_eq(s, "world");
    /// ```
    pub fn get_mut(&mut self) -> &mut R {
        &mut self.inner
    }
}

impl<R: Read> Read for Take<R> {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        if self.limit == 0 {
            return Ok(0);
        }
        let max = if (buf.len() as u64) < self.limit {
            buf.len()
        } else {
            self.limit as usize
        };
        let n = self.inner.read(&mut buf[0..max])?;
        self.limit -= n as u64;
        Ok(n)
    }
}

impl<R: BufRead> BufRead for Take<R> {
    fn fill_buf(&mut self) -> io::Result<&[u8]> {
        if self.limit == 0 {
            return Ok(&[]);
        }
        let limit = self.limit;
        let b = self.inner.fill_buf()?;
        let n = if (b.len() as u64) < limit {
            b.len()
        } else {
            limit as usize
        };
        Ok(&b[0..n])
    }
    fn consume(&mut self, amt: usize) {
        let a = if amt as u64 > self.limit {
            self.limit as usize
        } else {
            amt
        };
        self.limit -= a as u64;
        self.inner.consume(a);
    }
}

/// Adapter to chain together two readers.
///
/// This struct is generally created by calling [`chain`](Read::chain) on a
/// reader. Please see the documentation of [`chain`](Read::chain) for more
/// details.
///
/// # Examples
///
/// ```
/// use std::io::Read;
///
/// let first: &[u8] = b"hello ";
/// let second: &[u8] = b"world";
/// let mut s = String::new();
/// first.chain(second).read_to_string(&mut s).unwrap();
/// assert_eq(s, "hello world");
/// ```
#[derive(Debug, Clone)]
pub struct Chain<A, B> {
    pub(crate) first: A,
    pub(crate) second: B,
    pub(crate) done_first: bool,
}

impl<A, B> Chain<A, B> {
    /// Consumes the `Chain`, returning the wrapped readers.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::Read;
    ///
    /// let first: &[u8] = b"ab";
    /// let second: &[u8] = b"cd";
    /// let mut chain = first.chain(second);
    /// let mut buf = [0u8; 3];
    /// chain.read_exact(&mut buf).unwrap();
    /// let (a, b) = chain.into_inner();
    /// assert(a.is_empty());
    /// assert_eq(b, b"d");
    /// ```
    pub fn into_inner(self) -> (A, B) {
        (self.first, self.second)
    }
    /// Gets references to the underlying readers in this `Chain`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::Read;
    ///
    /// let first: &[u8] = b"ab";
    /// let second: &[u8] = b"cd";
    /// let chain = first.chain(second);
    /// let (a, b) = chain.get_ref();
    /// assert_eq(*a, b"ab");
    /// assert_eq(*b, b"cd");
    /// ```
    pub fn get_ref(&self) -> (&A, &B) {
        (&self.first, &self.second)
    }
}

impl<A: Read, B: Read> Read for Chain<A, B> {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        if !self.done_first {
            let n = self.first.read(buf)?;
            if n > 0 || buf.len() == 0 {
                return Ok(n);
            }
            self.done_first = true;
        }
        self.second.read(buf)
    }
}

/// An iterator over the bytes of a reader.
///
/// This struct is generally created by calling [`bytes`](Read::bytes) on a
/// reader. Please see the documentation of [`bytes`](Read::bytes) for more
/// details. Each item is an [`io::Result`]: a read error is returned as an
/// item, and iterating further reads again. The reader is read one byte at a
/// time, so wrap an unbuffered one (a file, a socket) in a
/// [`BufReader`](crate::io::BufReader).
///
/// # Examples
///
/// ```
/// use std::io::Read;
///
/// let data: &[u8] = b"hi!";
/// let bytes: Vec<u8> = data.bytes().map(|b| b.unwrap()).collect();
/// assert_eq(bytes, b"hi!");
/// ```
#[derive(Debug, Clone)]
pub struct Bytes<R> {
    pub(crate) inner: R,
}

impl<R: Read> Iterator for Bytes<R> {
    type Item = io::Result<u8>;
    fn next(&mut self) -> Option<io::Result<u8>> {
        let mut one = [0u8; 1];
        loop {
            match self.inner.read(&mut one) {
                Ok(0) => return None,
                Ok(_) => return Some(Ok(one[0])),
                Err(e) => {
                    if e.kind() != ErrorKind::Interrupted {
                        return Some(Err(e));
                    }
                }
            }
        }
    }
}

/// Reading a byte slice takes bytes off its front.
impl Read for &[u8] {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        let n = if buf.len() < self.len() {
            buf.len()
        } else {
            self.len()
        };
        buf[0..n].copy_from_slice(&self[0..n]);
        *self = &self[n..];
        Ok(n)
    }
}

impl BufRead for &[u8] {
    fn fill_buf(&mut self) -> io::Result<&[u8]> {
        Ok(*self)
    }
    fn consume(&mut self, amt: usize) {
        *self = &self[amt..];
    }
}

/// Writing to a Vec appends.
impl Write for Vec<u8> {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        self.extend_from_slice(buf);
        Ok(buf.len())
    }
    fn write_all(&mut self, buf: &[u8]) -> io::Result<()> {
        self.extend_from_slice(buf);
        Ok(())
    }
    fn flush(&mut self) -> io::Result<()> {
        Ok(())
    }
}

impl<R: Read> Read for &mut R {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        (**self).read(buf)
    }
}

impl<W: Write> Write for &mut W {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        (**self).write(buf)
    }
    fn flush(&mut self) -> io::Result<()> {
        (**self).flush()
    }
}

impl<B: BufRead> BufRead for &mut B {
    fn fill_buf(&mut self) -> io::Result<&[u8]> {
        (**self).fill_buf()
    }
    fn consume(&mut self, amt: usize) {
        (**self).consume(amt)
    }
}

impl<S: Seek> Seek for &mut S {
    fn seek(&mut self, pos: SeekFrom) -> io::Result<u64> {
        (**self).seek(pos)
    }
}
