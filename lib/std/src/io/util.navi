//! Adapters (Take, Chain, Bytes), empty/sink/repeat, copy, and Read and
//! Write for byte slices, vectors and references.

use crate::io::{self, Read, Write, Seek, SeekFrom, BufRead, Error, ErrorKind};
use crate::string::String;

/// Copies everything from reader to writer; returns how many bytes.
pub fn copy<R: Read, W: Write>(reader: &mut R, writer: &mut W) -> io::Result<u64> {
    let mut buf = crate::sys::zeroed(8192);
    let mut total = 0u64;
    loop {
        let n = match reader.read(buf.as_mut_slice()) {
            Ok(n) => n,
            Err(e) => {
                if e.kind() == ErrorKind::Interrupted { continue; }
                return Err(e);
            }
        };
        if n == 0 { return Ok(total); }
        writer.write_all(&buf[0..n])?;
        total += n as u64;
    }
}

/// Reads everything from a reader into a new String.
pub fn read_to_string<R: Read>(reader: R) -> io::Result<String> {
    let mut r = reader;
    let mut s = String::new();
    r.read_to_string(&mut s)?;
    Ok(s)
}

/// A reader at its end, and a writer that takes everything.
#[derive(Debug, Clone, Default)]
pub struct Empty;

pub fn empty() -> Empty { Empty }

impl Read for Empty {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> { Ok(0) }
}

impl BufRead for Empty {
    fn fill_buf(&mut self) -> io::Result<&[u8]> { Ok(&[]) }
    fn consume(&mut self, amt: usize) {}
}

impl Write for Empty {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> { Ok(buf.len()) }
    fn flush(&mut self) -> io::Result<()> { Ok(()) }
}

impl Seek for Empty {
    fn seek(&mut self, pos: SeekFrom) -> io::Result<u64> { Ok(0) }
}

/// A writer that discards everything.
#[derive(Debug, Clone, Default)]
pub struct Sink;

pub fn sink() -> Sink { Sink }

impl Write for Sink {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> { Ok(buf.len()) }
    fn flush(&mut self) -> io::Result<()> { Ok(()) }
}

/// A reader that yields one byte forever.
#[derive(Debug, Clone)]
pub struct Repeat {
    byte: u8,
}

pub fn repeat(byte: u8) -> Repeat { Repeat { byte } }

impl Read for Repeat {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        let mut i = 0;
        while i < buf.len() {
            buf[i] = self.byte;
            i += 1;
        }
        Ok(buf.len())
    }
}

/// The reader of Read::take: at most limit bytes of the inner one.
#[derive(Debug, Clone)]
pub struct Take<R> {
    pub(crate) inner: R,
    pub(crate) limit: u64,
}

impl<R> Take<R> {
    /// How many bytes may still be read.
    pub fn limit(&self) -> u64 { self.limit }
    pub fn set_limit(&mut self, limit: u64) { self.limit = limit; }
    pub fn into_inner(self) -> R { self.inner }
    pub fn get_ref(&self) -> &R { &self.inner }
    pub fn get_mut(&mut self) -> &mut R { &mut self.inner }
}

impl<R: Read> Read for Take<R> {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        if self.limit == 0 { return Ok(0); }
        let max = if (buf.len() as u64) < self.limit { buf.len() } else { self.limit as usize };
        let n = self.inner.read(&mut buf[0..max])?;
        self.limit -= n as u64;
        Ok(n)
    }
}

impl<R: BufRead> BufRead for Take<R> {
    fn fill_buf(&mut self) -> io::Result<&[u8]> {
        if self.limit == 0 { return Ok(&[]); }
        let limit = self.limit;
        let b = self.inner.fill_buf()?;
        let n = if (b.len() as u64) < limit { b.len() } else { limit as usize };
        Ok(&b[0..n])
    }
    fn consume(&mut self, amt: usize) {
        let a = if amt as u64 > self.limit { self.limit as usize } else { amt };
        self.limit -= a as u64;
        self.inner.consume(a);
    }
}

/// The reader of Read::chain: one reader, then the other.
#[derive(Debug, Clone)]
pub struct Chain<A, B> {
    pub(crate) first: A,
    pub(crate) second: B,
    pub(crate) done_first: bool,
}

impl<A, B> Chain<A, B> {
    pub fn into_inner(self) -> (A, B) { (self.first, self.second) }
    pub fn get_ref(&self) -> (&A, &B) { (&self.first, &self.second) }
}

impl<A: Read, B: Read> Read for Chain<A, B> {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        if !self.done_first {
            let n = self.first.read(buf)?;
            if n > 0 || buf.len() == 0 { return Ok(n); }
            self.done_first = true;
        }
        self.second.read(buf)
    }
}

/// The iterator of Read::bytes (unbuffered: wrap the reader in a
/// BufReader for many bytes).
#[derive(Debug, Clone)]
pub struct Bytes<R> {
    pub(crate) inner: R,
}

impl<R: Read> Iterator for Bytes<R> {
    type Item = io::Result<u8>;
    fn next(&mut self) -> Option<io::Result<u8>> {
        let mut one = [0u8; 1];
        loop {
            match self.inner.read(&mut one) {
                Ok(0) => return None,
                Ok(_) => return Some(Ok(one[0])),
                Err(e) => {
                    if e.kind() != ErrorKind::Interrupted { return Some(Err(e)); }
                }
            }
        }
    }
}

/// Reading a byte slice takes bytes off its front.
impl Read for &[u8] {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        let n = if buf.len() < self.len() { buf.len() } else { self.len() };
        buf[0..n].copy_from_slice(&self[0..n]);
        *self = &self[n..];
        Ok(n)
    }
}

impl BufRead for &[u8] {
    fn fill_buf(&mut self) -> io::Result<&[u8]> { Ok(*self) }
    fn consume(&mut self, amt: usize) { *self = &self[amt..]; }
}

/// Writing to a Vec appends.
impl Write for Vec<u8> {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        self.extend_from_slice(buf);
        Ok(buf.len())
    }
    fn write_all(&mut self, buf: &[u8]) -> io::Result<()> {
        self.extend_from_slice(buf);
        Ok(())
    }
    fn flush(&mut self) -> io::Result<()> { Ok(()) }
}

impl<R: Read> Read for &mut R {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> { (**self).read(buf) }
}

impl<W: Write> Write for &mut W {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> { (**self).write(buf) }
    fn flush(&mut self) -> io::Result<()> { (**self).flush() }
}

impl<B: BufRead> BufRead for &mut B {
    fn fill_buf(&mut self) -> io::Result<&[u8]> { (**self).fill_buf() }
    fn consume(&mut self, amt: usize) { (**self).consume(amt) }
}

impl<S: Seek> Seek for &mut S {
    fn seek(&mut self, pos: SeekFrom) -> io::Result<u64> { (**self).seek(pos) }
}
