//! The I/O prelude: the traits [`Read`], [`Write`], [`BufRead`] and [`Seek`],
//! for `use std::io::prelude::*`.
//!
//! The methods of a trait can only be called when the trait is in scope; this
//! module brings the four I/O traits in with one glob import.
//!
//! # Examples
//!
//! ```
//! use std::io::{Cursor, prelude::*};
//!
//! fn main() -> std::io::Result<()> {
//!     let mut cursor = Cursor::new(Vec::new());
//!     cursor.write_all(b"one\ntwo\n")?;
//!     cursor.rewind()?;
//!     let mut line = String::new();
//!     cursor.read_line(&mut line)?;
//!     assert_eq(line, "one\n");
//!     Ok(())
//! }
//! ```

pub use crate::io::{BufRead, Read, Seek, Write};
