//! Cursor: Read, Write, Seek and BufRead over bytes in memory.

use crate::io::{self, Read, Write, Seek, SeekFrom, BufRead, Error, ErrorKind};

/// Bytes in memory (a Vec<u8>, a &[u8], ...) with a position. A Vec is a
/// reference type in navi: a Cursor<Vec<u8>> writes into the Vec it was
/// made from.
#[derive(Debug, Clone, Default)]
pub struct Cursor<T> {
    inner: T,
    pos: u64,
}

impl<T> Cursor<T> {
    pub fn new(inner: T) -> Cursor<T> { Cursor { inner, pos: 0 } }
    pub fn into_inner(self) -> T { self.inner }
    pub fn get_ref(&self) -> &T { &self.inner }
    pub fn get_mut(&mut self) -> &mut T { &mut self.inner }
    pub fn position(&self) -> u64 { self.pos }
    pub fn set_position(&mut self, pos: u64) { self.pos = pos; }
}

impl<T: AsRef<[u8]>> Cursor<T> {
    /// The bytes from the position on.
    pub fn remaining_slice(&self) -> &[u8] {
        let data = self.inner.as_ref();
        let start = if self.pos > data.len() as u64 { data.len() } else { self.pos as usize };
        &data[start..]
    }

    pub fn is_empty(&self) -> bool { self.pos >= self.inner.as_ref().len() as u64 }
}

impl<T: AsRef<[u8]>> Read for Cursor<T> {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        let rest = self.remaining_slice();
        let n = if rest.len() < buf.len() { rest.len() } else { buf.len() };
        buf[0..n].copy_from_slice(&rest[0..n]);
        self.pos += n as u64;
        Ok(n)
    }
}

impl<T: AsRef<[u8]>> BufRead for Cursor<T> {
    fn fill_buf(&mut self) -> io::Result<&[u8]> { Ok(self.remaining_slice()) }
    fn consume(&mut self, amt: usize) { self.pos += amt as u64; }
}

impl<T: AsRef<[u8]>> Seek for Cursor<T> {
    fn seek(&mut self, style: SeekFrom) -> io::Result<u64> {
        let (base, off) = match style {
            SeekFrom::Start(n) => {
                self.pos = n;
                return Ok(n);
            }
            SeekFrom::End(n) => (self.inner.as_ref().len() as u64, n),
            SeekFrom::Current(n) => (self.pos, n),
        };
        let p = base as i64 + off;
        if p < 0 {
            return Err(Error::new(ErrorKind::InvalidInput, "invalid seek to a negative or overflowing position"));
        }
        self.pos = p as u64;
        Ok(self.pos)
    }
}

// Writes buf at *pos of v (growing it, zero-filled past its end).
fn vec_write(v: &mut Vec<u8>, pos: &mut u64, buf: &[u8]) -> usize {
    let at = *pos as usize;
    while v.len() < at { v.push(0); }
    let mut i = 0;
    while i < buf.len() {
        if at + i < v.len() { v[at + i] = buf[i]; } else { v.push(buf[i]); }
        i += 1;
    }
    *pos += buf.len() as u64;
    buf.len()
}

impl Write for Cursor<Vec<u8>> {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> { Ok(vec_write(&mut self.inner, &mut self.pos, buf)) }
    fn flush(&mut self) -> io::Result<()> { Ok(()) }
}

impl Write for Cursor<&mut Vec<u8>> {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> { Ok(vec_write(self.inner, &mut self.pos, buf)) }
    fn flush(&mut self) -> io::Result<()> { Ok(()) }
}

impl Write for Cursor<&mut [u8]> {
    /// Writes what fits before the end of the slice.
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        let len = self.inner.len();
        let at = if self.pos > len as u64 { len } else { self.pos as usize };
        let n = if len - at < buf.len() { len - at } else { buf.len() };
        self.inner[at..at + n].copy_from_slice(&buf[0..n]);
        self.pos += n as u64;
        Ok(n)
    }
    fn flush(&mut self) -> io::Result<()> { Ok(()) }
}
