//! Standard input (buffered, shared by every Stdin), locks of the
//! standard streams and IsTerminal.

use crate::io::{self, BufRead, Lines, Read, Stderr, Stdout, Write};
use crate::string::String;

// The buffer of standard input: every Stdin and StdinLock reads through
// it, so that what one read ahead the next one sees.
static mut BUF: Vec<u8> = Vec::new();
static mut POS: usize = 0;
static mut FILLED: usize = 0;

fn fill() -> io::Result<&[u8]> {
    if POS >= FILLED {
        if BUF.len() == 0 {
            BUF = crate::sys::zeroed(8192);
        }
        let n = match crate::sys::read(crate::sys::stdio_fd(0), BUF.as_mut_slice()) {
            Ok(n) => n,
            // A closed standard input reads as empty (as in Rust).
            Err(e) => {
                if e.raw_os_error() == Some(crate::sys::EBADF) {
                    0
                } else {
                    return Err(e);
                }
            }
        };
        POS = 0;
        FILLED = n;
    }
    Ok(&BUF[POS..FILLED])
}

fn consume(amt: usize) {
    POS = if POS + amt > FILLED {
        FILLED
    } else {
        POS + amt
    };
}

fn read_buffered(out: &mut [u8]) -> io::Result<usize> {
    let avail = fill()?;
    let n = if avail.len() < out.len() {
        avail.len()
    } else {
        out.len()
    };
    out[0..n].copy_from_slice(&avail[0..n]);
    consume(n);
    Ok(n)
}

/// A handle to the standard input stream of a process.
///
/// Each handle is a shared reference to a global buffer of input data to this
/// process (8 KiB): what one `Stdin` or [`StdinLock`] read ahead, the next read
/// through any of them sees. Created by the [`stdin`] function. `Stdin`
/// implements [`Read`]; for [`BufRead`]'s methods call [`Stdin::lock`], or use
/// [`Stdin::read_line`] and [`Stdin::lines`].
///
/// Unlike Rust's, there is no lock: several green threads reading standard
/// input at once see their reads interleaved (see spec/std-diff.md). A closed
/// standard input reads as empty.
///
/// # Examples
///
/// ```no_run
/// use std::io::Read;
///
/// fn main() -> std::io::Result<()> {
///     let mut buffer = String::new();
///     std::io::stdin().read_to_string(&mut buffer)?;
///     println(`read ${buffer.len()} bytes`);
///     Ok(())
/// }
/// ```
#[derive(Clone)]
pub struct Stdin {}

/// Constructs a new handle to the standard input of the current process.
///
/// Every handle reads through the same global buffer (see [`Stdin`]).
///
/// # Examples
///
/// ```no_run
/// fn main() -> std::io::Result<()> {
///     let mut name = String::new();
///     println("What is your name?");
///     std::io::stdin().read_line(&mut name)?;
///     println(`Hello, ${name.trim()}!`);
///     Ok(())
/// }
/// ```
pub fn stdin() -> Stdin {
    Stdin {}
}

impl Stdin {
    /// Locks this handle and reads a line of input, appending it to the
    /// specified buffer.
    ///
    /// This is [`BufRead::read_line`] on the standard input: the line is
    /// appended with its newline (if any), and the number of bytes read is
    /// returned; `Ok(0)` means the input has ended.
    ///
    /// # Errors
    ///
    /// The errors of [`BufRead::read_line`]: an error reading the standard
    /// input, or [`ErrorKind::InvalidData`](crate::io::ErrorKind::InvalidData)
    /// if the line is not valid UTF-8.
    ///
    /// # Examples
    ///
    /// ```no_run
    /// fn main() -> std::io::Result<()> {
    ///     let mut input = String::new();
    ///     while std::io::stdin().read_line(&mut input)? > 0 {
    ///         print(`echo: ${input}`);
    ///         input.clear();
    ///     }
    ///     Ok(())
    /// }
    /// ```
    pub fn read_line(&self, buf: &mut String) -> io::Result<usize> {
        self.lock().read_line(buf)
    }

    /// Locks this handle to the standard input stream, returning a readable
    /// guard that implements [`BufRead`].
    ///
    /// There is no lock in navi: a [`StdinLock`] reads through the shared
    /// buffer and does not keep other threads from reading (see
    /// spec/std-diff.md).
    ///
    /// # Examples
    ///
    /// ```no_run
    /// use std::io::BufRead;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let mut handle = std::io::stdin().lock();
    ///     let mut first = String::new();
    ///     handle.read_line(&mut first)?;
    ///     println(`first line: ${first.trim_end()}`);
    ///     Ok(())
    /// }
    /// ```
    pub fn lock(&self) -> StdinLock {
        StdinLock {}
    }

    /// Consumes this handle and returns an iterator over input lines.
    ///
    /// This is [`BufRead::lines`] on the standard input: each line comes
    /// without its newline, as an `io::Result<String>`.
    ///
    /// # Examples
    ///
    /// ```no_run
    /// fn main() {
    ///     let mut count = 0;
    ///     for line in std::io::stdin().lines() {
    ///         let line = line.unwrap();
    ///         if !line.is_empty() {
    ///             count += 1;
    ///         }
    ///     }
    ///     println(`${count} non-empty lines`);
    /// }
    /// ```
    pub fn lines(self) -> Lines<StdinLock> {
        self.lock().lines()
    }
}

impl Read for Stdin {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        read_buffered(buf)
    }
}

/// A "locked" reference to the [`Stdin`] handle, which implements [`Read`] and
/// [`BufRead`].
///
/// This handle is returned by [`Stdin::lock`]. It reads through the global
/// buffer every [`Stdin`] shares; unlike Rust's, it locks nothing (see
/// spec/std-diff.md).
///
/// # Examples
///
/// ```no_run
/// use std::io::BufRead;
///
/// fn main() -> std::io::Result<()> {
///     let mut words = 0;
///     for line in std::io::stdin().lock().lines() {
///         words += line?.split_whitespace().count();
///     }
///     println(`${words} words`);
///     Ok(())
/// }
/// ```
#[derive(Clone)]
pub struct StdinLock {}

impl Read for StdinLock {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        read_buffered(buf)
    }
}

impl BufRead for StdinLock {
    fn fill_buf(&mut self) -> io::Result<&[u8]> {
        fill()
    }
    fn consume(&mut self, amt: usize) {
        consume(amt);
    }
}

/// A "locked" handle to the standard output, returned by [`Stdout::lock`].
///
/// There is no lock in navi: a `StdoutLock` forwards each write to [`Stdout`]
/// (which is not buffered), so writes of different threads are not interleaved
/// within one `write` call, but may be between calls.
///
/// # Examples
///
/// ```
/// use std::io::Write;
///
/// fn main() -> std::io::Result<()> {
///     let mut out = std::io::stdout().lock();
///     out.write_all(b"one\n")?;
///     out.write_all(b"two\n")?;
///     Ok(())
/// }
/// ```
pub struct StdoutLock {
    out: Stdout,
}

/// A "locked" handle to the standard error, returned by [`Stderr::lock`].
///
/// There is no lock in navi: a `StderrLock` forwards each write to [`Stderr`].
///
/// # Examples
///
/// ```
/// use std::io::Write;
///
/// fn main() -> std::io::Result<()> {
///     let mut err = std::io::stderr().lock();
///     err.write_all(b"a diagnostic\n")?;
///     Ok(())
/// }
/// ```
pub struct StderrLock {
    out: Stderr,
}

impl Stdout {
    /// Locks this handle to the standard output stream, returning a writable
    /// guard.
    ///
    /// There is no lock in navi: the returned [`StdoutLock`] forwards its
    /// writes to the standard output (see spec/std-diff.md).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::Write;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let stdout = std::io::stdout();
    ///     let mut handle = stdout.lock();
    ///     handle.write_all(b"hello world\n")?;
    ///     Ok(())
    /// }
    /// ```
    pub fn lock(&self) -> StdoutLock {
        StdoutLock {
            out: crate::io::stdout(),
        }
    }
}

impl Stderr {
    /// Locks this handle to the standard error stream, returning a writable
    /// guard.
    ///
    /// There is no lock in navi: the returned [`StderrLock`] forwards its
    /// writes to the standard error.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::Write;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let stderr = std::io::stderr();
    ///     let mut handle = stderr.lock();
    ///     handle.write_all(b"hello world\n")?;
    ///     Ok(())
    /// }
    /// ```
    pub fn lock(&self) -> StderrLock {
        StderrLock {
            out: crate::io::stderr(),
        }
    }
}

impl Write for StdoutLock {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        self.out.write(buf)
    }
    fn flush(&mut self) -> io::Result<()> {
        Ok(())
    }
}

impl Write for StderrLock {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        self.out.write(buf)
    }
    fn flush(&mut self) -> io::Result<()> {
        Ok(())
    }
}

/// Trait to determine if a descriptor/handle refers to a terminal/tty.
///
/// [`Stdin`], [`Stdout`], [`Stderr`] and [`File`](crate::fs::File) implement
/// it. A program can use it to decide whether to color its output or to show
/// prompts.
///
/// # Examples
///
/// ```
/// use std::io::IsTerminal;
///
/// let colored = std::io::stdout().is_terminal();
/// if colored {
///     println("\x1b[1mbold\x1b[0m");
/// } else {
///     println("plain");
/// }
/// ```
pub trait IsTerminal {
    /// Returns `true` if the descriptor/handle refers to a terminal/tty.
    ///
    /// On Windows, it is `true` for a console; an MSYS or Cygwin terminal (a
    /// pipe) gives `false`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::IsTerminal;
    ///
    /// if std::io::stdin().is_terminal() {
    ///     println("interactive");
    /// }
    /// ```
    fn is_terminal(&self) -> bool;
}

impl IsTerminal for Stdin {
    fn is_terminal(&self) -> bool {
        crate::sys::isatty(crate::sys::stdio_fd(0))
    }
}

impl IsTerminal for Stdout {
    fn is_terminal(&self) -> bool {
        crate::sys::isatty(crate::sys::stdio_fd(1))
    }
}

impl IsTerminal for Stderr {
    fn is_terminal(&self) -> bool {
        crate::sys::isatty(crate::sys::stdio_fd(2))
    }
}
