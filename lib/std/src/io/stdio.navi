//! Standard input (buffered, shared by every Stdin), locks of the
//! standard streams and IsTerminal.

use crate::io::{self, Read, Write, BufRead, Lines, Stdout, Stderr};
use crate::string::String;

// The buffer of standard input: every Stdin and StdinLock reads through
// it, so that what one read ahead the next one sees.
static mut BUF: Vec<u8> = Vec::new();
static mut POS: usize = 0;
static mut FILLED: usize = 0;

fn fill() -> io::Result<&[u8]> {
    if POS >= FILLED {
        if BUF.len() == 0 { BUF = crate::sys::zeroed(8192); }
        let n = match crate::sys::read(crate::sys::stdio_fd(0), BUF.as_mut_slice()) {
            Ok(n) => n,
            // A closed standard input reads as empty (as in Rust).
            Err(e) => if e.raw_os_error() == Some(crate::sys::EBADF) { 0 } else { return Err(e); },
        };
        POS = 0;
        FILLED = n;
    }
    Ok(&BUF[POS..FILLED])
}

fn consume(amt: usize) { POS = if POS + amt > FILLED { FILLED } else { POS + amt }; }

fn read_buffered(out: &mut [u8]) -> io::Result<usize> {
    let avail = fill()?;
    let n = if avail.len() < out.len() { avail.len() } else { out.len() };
    out[0..n].copy_from_slice(&avail[0..n]);
    consume(n);
    Ok(n)
}

/// The standard input stream (buffered).
#[derive(Clone)]
pub struct Stdin {}

pub fn stdin() -> Stdin { Stdin {} }

impl Stdin {
    /// Appends a line (with its newline) to buf; 0 at the end of input.
    pub fn read_line(&self, buf: &mut String) -> io::Result<usize> { self.lock().read_line(buf) }

    /// Locks standard input (there is no lock in navi: a StdinLock reads
    /// through the shared buffer; see spec/std-diff.md).
    pub fn lock(&self) -> StdinLock { StdinLock {} }

    /// The lines of standard input.
    pub fn lines(self) -> Lines<StdinLock> { self.lock().lines() }
}

impl Read for Stdin {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> { read_buffered(buf) }
}

/// Standard input with BufRead (Stdin::lock).
#[derive(Clone)]
pub struct StdinLock {}

impl Read for StdinLock {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> { read_buffered(buf) }
}

impl BufRead for StdinLock {
    fn fill_buf(&mut self) -> io::Result<&[u8]> { fill() }
    fn consume(&mut self, amt: usize) { consume(amt); }
}

/// Standard output (Stdout::lock; there is no lock: writes are not
/// interleaved within one write call).
pub struct StdoutLock {
    out: Stdout,
}

/// Standard error (Stderr::lock).
pub struct StderrLock {
    out: Stderr,
}

impl Stdout {
    pub fn lock(&self) -> StdoutLock { StdoutLock { out: crate::io::stdout() } }
}

impl Stderr {
    pub fn lock(&self) -> StderrLock { StderrLock { out: crate::io::stderr() } }
}

impl Write for StdoutLock {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> { self.out.write(buf) }
    fn flush(&mut self) -> io::Result<()> { Ok(()) }
}

impl Write for StderrLock {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> { self.out.write(buf) }
    fn flush(&mut self) -> io::Result<()> { Ok(()) }
}

/// Whether a stream is a terminal.
pub trait IsTerminal {
    fn is_terminal(&self) -> bool;
}

impl IsTerminal for Stdin {
    fn is_terminal(&self) -> bool { crate::sys::isatty(crate::sys::stdio_fd(0)) }
}

impl IsTerminal for Stdout {
    fn is_terminal(&self) -> bool { crate::sys::isatty(crate::sys::stdio_fd(1)) }
}

impl IsTerminal for Stderr {
    fn is_terminal(&self) -> bool { crate::sys::isatty(crate::sys::stdio_fd(2)) }
}
