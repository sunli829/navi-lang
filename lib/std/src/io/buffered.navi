//! Buffered reading (BufRead, BufReader, lines and split) and LineWriter.

use crate::io::{self, BufWriter, Error, ErrorKind, Read, Seek, SeekFrom, Write};
use crate::string::String;

/// A `BufRead` is a type of [`Read`]er which has an internal buffer, allowing
/// it to perform extra ways of reading.
///
/// For example, reading line-by-line is inefficient without using a buffer, so
/// if you want to read by line, you'll need `BufRead`, which includes a
/// [`BufRead::read_line`] method as well as a [`BufRead::lines`] iterator.
///
/// [`BufReader`], [`Cursor`](crate::io::Cursor), byte slices (`&[u8]`),
/// [`StdinLock`](crate::io::StdinLock), [`Empty`](crate::io::Empty) and
/// [`Take`](crate::io::Take) of a `BufRead` implement it. Implementors define
/// [`BufRead::fill_buf`] and [`BufRead::consume`]; the other methods are built
/// on them.
///
/// # Examples
///
/// ```
/// use std::io::{BufRead, Cursor};
///
/// fn main() -> std::io::Result<()> {
///     let input = Cursor::new(b"3\n4\n5\n");
///     let mut sum = 0;
///     for line in input.lines() {
///         sum += line?.parse::<i32>().unwrap();
///     }
///     assert_eq(sum, 12);
///     Ok(())
/// }
/// ```
pub trait BufRead: Read {
    /// Returns the contents of the internal buffer, filling it with more data
    /// from the inner reader if it is empty.
    ///
    /// This function is a lower-level call. It needs to be paired with the
    /// [`BufRead::consume`] method to function properly: calling it does not
    /// consume the bytes it returns, so a second call returns the same bytes.
    /// An empty slice means the input has ended.
    ///
    /// # Errors
    ///
    /// The errors of reading the inner reader.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{BufRead, BufReader};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let mut reader = BufReader::with_capacity(4, "abcdef".as_bytes());
    ///     let buf = reader.fill_buf()?;
    ///     assert_eq(buf, "abcd".as_bytes());
    ///     let n = buf.len();
    ///     reader.consume(n);
    ///     assert_eq(reader.fill_buf()?, "ef".as_bytes());
    ///     reader.consume(2);
    ///     assert(reader.fill_buf()?.is_empty());
    ///     Ok(())
    /// }
    /// ```
    fn fill_buf(&mut self) -> io::Result<&[u8]>;

    /// Marks the given `amt` bytes of the buffer as read, so that they are no
    /// longer returned by [`BufRead::fill_buf`] or by reads.
    ///
    /// `amt` should be at most the length of the buffer `fill_buf` returned.
    /// ([`BufReader`] takes a larger `amt` as the whole buffer; a byte slice
    /// panics.)
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{BufRead, Read};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let mut reader: &[u8] = b"skip:keep";
    ///     reader.consume(5);
    ///     let mut rest = String::new();
    ///     reader.read_to_string(&mut rest)?;
    ///     assert_eq(rest, "keep");
    ///     Ok(())
    /// }
    /// ```
    fn consume(&mut self, amt: usize);

    /// Checks if there is any data left to be read.
    ///
    /// This calls [`BufRead::fill_buf`], which may read from the inner reader,
    /// and returns whether it returned any bytes. (Rust's is unstable.)
    ///
    /// # Errors
    ///
    /// The errors of [`BufRead::fill_buf`].
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{BufRead, Cursor};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let mut cursor = Cursor::new(b"x\n");
    ///     let mut line = String::new();
    ///     assert(cursor.has_data_left()?);
    ///     cursor.read_line(&mut line)?;
    ///     assert(!cursor.has_data_left()?);
    ///     Ok(())
    /// }
    /// ```
    fn has_data_left(&mut self) -> io::Result<bool> {
        let b = self.fill_buf()?;
        Ok(b.len() > 0)
    }

    /// Reads all bytes into `buf` until the delimiter `byte` or the end of the
    /// input is reached.
    ///
    /// The bytes, up to and including the delimiter (if found), are appended to
    /// `buf`; returns how many bytes were read (0 at the end of the input).
    /// Reads that fail with [`ErrorKind::Interrupted`] are retried.
    ///
    /// # Errors
    ///
    /// Any other error of [`BufRead::fill_buf`]; the bytes read before it stay
    /// in `buf`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{BufRead, Cursor};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let mut cursor = Cursor::new(b"lorem-ipsum");
    ///     let mut buf = Vec::new();
    ///
    ///     // cursor is at 'l'
    ///     let num_bytes = cursor.read_until(b'-', &mut buf)?;
    ///     assert_eq(num_bytes, 6);
    ///     assert_eq(buf, b"lorem-".to_vec());
    ///     buf.clear();
    ///
    ///     // cursor is at 'i'
    ///     let num_bytes = cursor.read_until(b'-', &mut buf)?;
    ///     assert_eq(num_bytes, 5);
    ///     assert_eq(buf, b"ipsum".to_vec());
    ///     buf.clear();
    ///
    ///     // cursor is at EOF
    ///     let num_bytes = cursor.read_until(b'-', &mut buf)?;
    ///     assert_eq(num_bytes, 0);
    ///     assert(buf.is_empty());
    ///     Ok(())
    /// }
    /// ```
    fn read_until(&mut self, byte: u8, buf: &mut Vec<u8>) -> io::Result<usize> {
        let mut total = 0;
        loop {
            let available = match self.fill_buf() {
                Ok(b) => b,
                Err(e) => {
                    if e.kind() == ErrorKind::Interrupted {
                        continue;
                    }
                    return Err(e);
                }
            };
            let mut i = 0;
            let n = available.len();
            while i < n && available[i] != byte {
                i += 1;
            }
            let found = i < n;
            let used = if found { i + 1 } else { n };
            buf.extend_from_slice(&available[0..used]);
            self.consume(used);
            total += used;
            if found || used == 0 {
                return Ok(total);
            }
        }
    }

    /// Skips all bytes until the delimiter `byte` or the end of the input is
    /// reached.
    ///
    /// The bytes up to and including the delimiter (if found) are discarded;
    /// returns how many bytes were skipped (0 at the end of the input).
    ///
    /// # Errors
    ///
    /// The errors of [`BufRead::fill_buf`] (unlike [`BufRead::read_until`], an
    /// [`ErrorKind::Interrupted`] one is returned too).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{BufRead, Cursor};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let mut cursor = Cursor::new(b"Ferris\0Likes long walks on the beach\0Crustacean\0");
    ///
    ///     // read name
    ///     let mut name = Vec::new();
    ///     let num_bytes = cursor.read_until(b'\0', &mut name)?;
    ///     assert_eq(num_bytes, 7);
    ///     assert_eq(name, b"Ferris\0".to_vec());
    ///
    ///     // skip life motto
    ///     let num_bytes = cursor.skip_until(b'\0')?;
    ///     assert_eq(num_bytes, 30);
    ///
    ///     // read animal type
    ///     let mut animal = Vec::new();
    ///     let num_bytes = cursor.read_until(b'\0', &mut animal)?;
    ///     assert_eq(num_bytes, 11);
    ///     assert_eq(animal, b"Crustacean\0".to_vec());
    ///
    ///     // reach EOF
    ///     assert_eq(cursor.skip_until(b'\0')?, 0);
    ///     Ok(())
    /// }
    /// ```
    fn skip_until(&mut self, byte: u8) -> io::Result<usize> {
        let mut total = 0;
        loop {
            let available = self.fill_buf()?;
            let mut i = 0;
            let n = available.len();
            while i < n && available[i] != byte {
                i += 1;
            }
            let found = i < n;
            let used = if found { i + 1 } else { n };
            self.consume(used);
            total += used;
            if found || used == 0 {
                return Ok(total);
            }
        }
    }

    /// Reads all bytes until a newline (the `0xA` byte) is reached, and appends
    /// them to the provided `String` buffer.
    ///
    /// The line is appended with its newline, if it has one (the last line of
    /// the input may not); returns its length in bytes. `Ok(0)` means the input
    /// has ended. Lines ending with `"\r\n"` keep both characters;
    /// [`BufRead::lines`] strips them.
    ///
    /// # Errors
    ///
    /// The errors of [`BufRead::read_until`]. If the line is not valid UTF-8,
    /// an error of kind [`ErrorKind::InvalidData`] is returned and `buf` is
    /// left unchanged (the line's bytes are consumed all the same).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{BufRead, Cursor};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let mut cursor = Cursor::new(b"foo\nbar");
    ///     let mut buf = String::new();
    ///
    ///     // cursor is at 'f'
    ///     let num_bytes = cursor.read_line(&mut buf)?;
    ///     assert_eq(num_bytes, 4);
    ///     assert_eq(buf, "foo\n");
    ///     buf.clear();
    ///
    ///     // cursor is at 'b'
    ///     let num_bytes = cursor.read_line(&mut buf)?;
    ///     assert_eq(num_bytes, 3);
    ///     assert_eq(buf, "bar");
    ///     buf.clear();
    ///
    ///     // cursor is at EOF
    ///     let num_bytes = cursor.read_line(&mut buf)?;
    ///     assert_eq(num_bytes, 0);
    ///     assert_eq(buf, "");
    ///     Ok(())
    /// }
    /// ```
    fn read_line(&mut self, buf: &mut String) -> io::Result<usize> {
        let mut bytes: Vec<u8> = Vec::new();
        let n = self.read_until(b'\n', &mut bytes)?;
        match String::from_utf8(bytes) {
            Ok(s) => {
                buf.push_str(s.as_str());
                Ok(n)
            }
            Err(_) => Err(Error::new(
                ErrorKind::InvalidData,
                "stream did not contain valid UTF-8",
            )),
        }
    }

    /// Returns an iterator over the contents of this reader split on the byte
    /// `byte`.
    ///
    /// The iterator yields `io::Result<Vec<u8>>`: each piece without the
    /// delimiter, or an error of [`BufRead::read_until`]. An input ending with
    /// the delimiter has no empty piece after it.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{BufRead, Cursor};
    ///
    /// let cursor = Cursor::new(b"lorem-ipsum-dolor");
    /// let mut split_iter = cursor.split(b'-').map(|l| l.unwrap());
    /// assert_eq(split_iter.next(), Some(b"lorem".to_vec()));
    /// assert_eq(split_iter.next(), Some(b"ipsum".to_vec()));
    /// assert_eq(split_iter.next(), Some(b"dolor".to_vec()));
    /// assert_eq(split_iter.next(), None);
    /// ```
    fn split(self, byte: u8) -> Split<Self> {
        Split {
            buf: self,
            delim: byte,
        }
    }

    /// Returns an iterator over the lines of this reader.
    ///
    /// The iterator yields `io::Result<String>`: each line without its newline
    /// (`"\n"` or `"\r\n"`), or an error of [`BufRead::read_line`]. An input
    /// ending with a newline has no empty line after it.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{BufRead, Cursor};
    ///
    /// let cursor = Cursor::new(b"lorem\nipsum\r\ndolor");
    /// let mut lines_iter = cursor.lines().map(|l| l.unwrap());
    /// assert_eq(lines_iter.next(), Some("lorem".to_string()));
    /// assert_eq(lines_iter.next(), Some("ipsum".to_string()));
    /// assert_eq(lines_iter.next(), Some("dolor".to_string()));
    /// assert_eq(lines_iter.next(), None);
    /// ```
    fn lines(self) -> Lines<Self> {
        Lines { buf: self }
    }
}

/// An iterator over the lines of an instance of [`BufRead`].
///
/// This struct is created by calling [`BufRead::lines`]; see its documentation
/// for more. Each item is an [`io::Result`](crate::io::Result) of a line
/// without its `\n` (or `\r\n`).
///
/// # Examples
///
/// ```
/// use std::io::{BufRead, Cursor};
///
/// let cursor = Cursor::new(b"one\r\ntwo\n".to_vec());
/// let lines: Vec<String> = cursor.lines().map(|l| l.unwrap()).collect();
/// assert_eq(lines.join(","), "one,two");
/// ```
pub struct Lines<B> {
    buf: B,
}

impl<B: BufRead> Iterator for Lines<B> {
    type Item = io::Result<String>;
    fn next(&mut self) -> Option<io::Result<String>> {
        let mut s = String::new();
        match self.buf.read_line(&mut s) {
            Ok(0) => None,
            Ok(_) => {
                if s.ends_with("\n") {
                    s.pop();
                    if s.ends_with("\r") {
                        s.pop();
                    }
                }
                Some(Ok(s))
            }
            Err(e) => Some(Err(e)),
        }
    }
}

/// An iterator over the contents of an instance of [`BufRead`] split on a
/// particular byte.
///
/// This struct is created by calling [`BufRead::split`]; see its documentation
/// for more. Each item is an [`io::Result`](crate::io::Result) of the bytes
/// up to the delimiter, without it.
///
/// # Examples
///
/// ```
/// use std::io::{BufRead, Cursor};
///
/// let cursor = Cursor::new(b"a-bc-d".to_vec());
/// let parts: Vec<Vec<u8>> = cursor.split(b'-').map(|p| p.unwrap()).collect();
/// assert_eq(parts.len(), 3);
/// assert_eq(parts[1], b"bc");
/// ```
pub struct Split<B> {
    buf: B,
    delim: u8,
}

impl<B: BufRead> Iterator for Split<B> {
    type Item = io::Result<Vec<u8>>;
    fn next(&mut self) -> Option<io::Result<Vec<u8>>> {
        let mut v: Vec<u8> = Vec::new();
        match self.buf.read_until(self.delim, &mut v) {
            Ok(0) => None,
            Ok(_) => {
                if v.len() > 0 && v[v.len() - 1] == self.delim {
                    v.pop();
                }
                Some(Ok(v))
            }
            Err(e) => Some(Err(e)),
        }
    }
}

/// Adds buffering to any reader.
///
/// It can be excessively inefficient to work directly with a [`Read`] instance:
/// every call to `read` on a file or a socket is a system call. A
/// `BufReader<R>` performs large, infrequent reads on the underlying reader (8
/// KiB by default) and maintains an in-memory buffer of the results; it also
/// implements [`BufRead`], for reading lines.
///
/// A read at least as large as the buffer, when nothing is buffered, goes
/// straight to the inner reader. [`BufReader::into_inner`] loses the bytes read
/// ahead and not consumed.
///
/// # Examples
///
/// ```
/// use std::io::{BufRead, BufReader};
///
/// fn main() -> std::io::Result<()> {
///     let data = "name=navi\nkind=language\n".as_bytes();
///     let mut reader = BufReader::new(data);
///     let mut line = String::new();
///     reader.read_line(&mut line)?;
///     assert_eq(line, "name=navi\n");
///     let rest: Vec<String> = reader.lines().map(|l| l.unwrap()).collect();
///     assert_eq(rest, Vec::from(["kind=language".to_string()]));
///     Ok(())
/// }
/// ```
pub struct BufReader<R> {
    inner: R,
    buf: Vec<u8>,
    pos: usize,
    filled: usize,
}

impl<R: Read> BufReader<R> {
    /// Creates a new `BufReader<R>` with a default buffer capacity (8 KiB).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{BufReader, Read};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let mut reader = BufReader::new("some text".as_bytes());
    ///     assert_eq(reader.capacity(), 8192);
    ///     let mut text = String::new();
    ///     reader.read_to_string(&mut text)?;
    ///     assert_eq(text, "some text");
    ///     Ok(())
    /// }
    /// ```
    pub fn new(inner: R) -> BufReader<R> {
        BufReader::with_capacity(8192, inner)
    }

    /// Creates a new `BufReader<R>` with the specified buffer capacity.
    ///
    /// A capacity of 0 is taken as 1.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{BufRead, BufReader};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let mut reader = BufReader::with_capacity(3, "abcdef".as_bytes());
    ///     assert_eq(reader.capacity(), 3);
    ///     assert_eq(reader.fill_buf()?, "abc".as_bytes());
    ///     Ok(())
    /// }
    /// ```
    pub fn with_capacity(capacity: usize, inner: R) -> BufReader<R> {
        let cap = if capacity == 0 { 1 } else { capacity };
        BufReader {
            inner,
            buf: crate::sys::zeroed(cap),
            pos: 0,
            filled: 0,
        }
    }
}

impl<R> BufReader<R> {
    /// Gets a reference to the underlying reader.
    ///
    /// It is inadvisable to directly read from the underlying reader: bytes may
    /// already have been read into the buffer.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{BufReader, Cursor};
    ///
    /// let reader = BufReader::new(Cursor::new(b"abc"));
    /// assert_eq(reader.get_ref().position(), 0);
    /// ```
    pub fn get_ref(&self) -> &R {
        &self.inner
    }

    /// Gets a mutable reference to the underlying reader.
    ///
    /// It is inadvisable to directly read from the underlying reader: bytes may
    /// already have been read into the buffer.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{BufReader, Cursor};
    ///
    /// let mut reader = BufReader::new(Cursor::new(b"abc"));
    /// reader.get_mut().set_position(1);
    /// assert_eq(reader.get_ref().position(), 1);
    /// ```
    pub fn get_mut(&mut self) -> &mut R {
        &mut self.inner
    }

    /// Unwraps this `BufReader<R>`, returning the underlying reader.
    ///
    /// Note that any leftover data in the internal buffer is lost. Therefore, a
    /// following read from the underlying reader may lead to data loss.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{BufReader, Read};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let mut reader = BufReader::with_capacity(4, "abcdefgh".as_bytes());
    ///     let mut one = [0u8; 1];
    ///     reader.read(&mut one)?;
    ///     // "bcd" was buffered and is lost.
    ///     let mut rest = String::new();
    ///     reader.into_inner().read_to_string(&mut rest)?;
    ///     assert_eq(rest, "efgh");
    ///     Ok(())
    /// }
    /// ```
    pub fn into_inner(self) -> R {
        self.inner
    }

    /// Returns a reference to the internally buffered data: the bytes read
    /// ahead from the inner reader and not consumed yet.
    ///
    /// Unlike [`BufRead::fill_buf`], this will not attempt to fill the buffer
    /// if it is empty.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{BufReader, Read};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let mut reader = BufReader::with_capacity(4, "abcdefg".as_bytes());
    ///     assert(reader.buffer().is_empty());
    ///     let mut one = [0u8; 1];
    ///     reader.read(&mut one)?;
    ///     assert_eq(reader.buffer(), "bcd".as_bytes());
    ///     Ok(())
    /// }
    /// ```
    pub fn buffer(&self) -> &[u8] {
        &self.buf[self.pos..self.filled]
    }

    /// Returns the number of bytes the internal buffer can hold at once.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::BufReader;
    ///
    /// let reader = BufReader::with_capacity(16, "abc".as_bytes());
    /// assert_eq(reader.capacity(), 16);
    /// ```
    pub fn capacity(&self) -> usize {
        self.buf.len()
    }

    fn discard_buffer(&mut self) {
        self.pos = 0;
        self.filled = 0;
    }
}

impl<R: Read> Read for BufReader<R> {
    fn read(&mut self, out: &mut [u8]) -> io::Result<usize> {
        // Nothing buffered and a large read: straight from the inner reader.
        if self.pos == self.filled && out.len() >= self.buf.len() {
            self.discard_buffer();
            return self.inner.read(out);
        }
        let n = {
            let avail = self.fill_buf()?;
            let n = if avail.len() < out.len() {
                avail.len()
            } else {
                out.len()
            };
            out[0..n].copy_from_slice(&avail[0..n]);
            n
        };
        self.consume(n);
        Ok(n)
    }
}

impl<R: Read> BufRead for BufReader<R> {
    fn fill_buf(&mut self) -> io::Result<&[u8]> {
        if self.pos >= self.filled {
            let n = self.inner.read(self.buf.as_mut_slice())?;
            self.pos = 0;
            self.filled = n;
        }
        Ok(&self.buf[self.pos..self.filled])
    }

    fn consume(&mut self, amt: usize) {
        self.pos = if self.pos + amt > self.filled {
            self.filled
        } else {
            self.pos + amt
        };
    }
}

impl<R> Seek for BufReader<R>
where
    R: Read + Seek,
{
    /// Seeks the inner reader and discards the buffer.
    ///
    /// A [`SeekFrom::Current`] offset counts from the position of the
    /// `BufReader` (that is, before the bytes still buffered), not from the
    /// inner reader's. Seeking always discards the buffer, even when the new
    /// position is within it; [`BufReader::seek_relative`] keeps it when it
    /// can.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{BufReader, Cursor, Read, Seek, SeekFrom};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let mut reader = BufReader::with_capacity(4, Cursor::new(b"0123456789"));
    ///     let mut one = [0u8; 1];
    ///     reader.read(&mut one)?;
    ///     // The inner cursor is at 4, the reader at 1.
    ///     assert_eq(reader.stream_position()?, 1);
    ///     reader.seek(SeekFrom::End(-2))?;
    ///     reader.read(&mut one)?;
    ///     assert_eq(one[0], b'8');
    ///     Ok(())
    /// }
    /// ```
    fn seek(&mut self, pos: SeekFrom) -> io::Result<u64> {
        let r = match pos {
            SeekFrom::Current(n) => {
                let remainder = (self.filled - self.pos) as i64;
                self.inner.seek(SeekFrom::Current(n - remainder))?
            }
            _ => self.inner.seek(pos)?,
        };
        self.discard_buffer();
        Ok(r)
    }
}

impl<R> BufReader<R>
where
    R: Read + Seek,
{
    /// Seeks relative to the current position, keeping the buffer when it can.
    ///
    /// If the new position lies within the buffer, the buffer will not be
    /// flushed, allowing for more efficient seeks; otherwise this seeks the
    /// inner reader as [`Seek::seek`] with [`SeekFrom::Current`] does.
    ///
    /// # Errors
    ///
    /// The errors of seeking the inner reader.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{BufReader, Cursor, Read};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let mut reader = BufReader::with_capacity(4, Cursor::new(b"0123456789"));
    ///     let mut one = [0u8; 1];
    ///     reader.read(&mut one)?;
    ///     // Within the buffer ("0123"): no seek of the cursor.
    ///     reader.seek_relative(2)?;
    ///     assert_eq(reader.buffer(), "3".as_bytes());
    ///     reader.read(&mut one)?;
    ///     assert_eq(one[0], b'3');
    ///     // Past the buffer: the cursor seeks.
    ///     reader.seek_relative(3)?;
    ///     reader.read(&mut one)?;
    ///     assert_eq(one[0], b'7');
    ///     Ok(())
    /// }
    /// ```
    pub fn seek_relative(&mut self, offset: i64) -> io::Result<()> {
        let p = self.pos as i64 + offset;
        if p >= 0 && p <= self.filled as i64 {
            self.pos = p as usize;
            return Ok(());
        }
        self.seek(SeekFrom::Current(offset))?;
        Ok(())
    }
}

/// Wraps a writer and buffers output to it, flushing whenever a newline is
/// written.
///
/// A `LineWriter` is like a [`BufWriter`] (its buffer holds 1 KiB by default),
/// except that a write containing a newline (`0x0a`) writes everything up to
/// and including the last newline through to the inner writer and flushes it;
/// what follows the newline stays buffered.
///
/// navi has no Drop: call [`Write::flush`] (or [`LineWriter::into_inner`])
/// before the writer goes away, or the last, unfinished line is lost.
///
/// # Examples
///
/// ```
/// use std::io::{LineWriter, Write};
///
/// fn main() -> std::io::Result<()> {
///     let mut writer = LineWriter::new(Vec::new());
///
///     // No newline yet: nothing is written.
///     writer.write_all(b"I shall be telling this")?;
///     assert(writer.get_ref().is_empty());
///
///     // The line is written through, the rest kept.
///     writer.write_all(b" with a sigh\nSomewhere ages")?;
///     assert_eq(writer.get_ref().clone(), b"I shall be telling this with a sigh\n".to_vec());
///
///     // Flushing writes the rest.
///     writer.flush()?;
///     let text = String::from_utf8(writer.get_ref().clone()).unwrap();
///     assert_eq(text, "I shall be telling this with a sigh\nSomewhere ages");
///     Ok(())
/// }
/// ```
pub struct LineWriter<W: Write> {
    inner: BufWriter<W>,
}

impl<W: Write> LineWriter<W> {
    /// Creates a new `LineWriter` with a default buffer capacity (1 KiB).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{LineWriter, Write};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let mut writer = LineWriter::new(Vec::new());
    ///     writer.write_all(b"one line\n")?;
    ///     assert_eq(writer.get_ref().clone(), b"one line\n".to_vec());
    ///     Ok(())
    /// }
    /// ```
    pub fn new(inner: W) -> LineWriter<W> {
        LineWriter {
            inner: BufWriter::with_capacity(1024, inner),
        }
    }

    /// Creates a new `LineWriter` with at least the specified capacity for the
    /// internal buffer.
    ///
    /// A capacity of 0 is taken as 1. A line longer than the buffer is written
    /// out in pieces.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{LineWriter, Write};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let mut writer = LineWriter::with_capacity(100, Vec::new());
    ///     writer.write_all(b"short")?;
    ///     assert(writer.get_ref().is_empty());
    ///     Ok(())
    /// }
    /// ```
    pub fn with_capacity(capacity: usize, inner: W) -> LineWriter<W> {
        LineWriter {
            inner: BufWriter::with_capacity(capacity, inner),
        }
    }

    /// Gets a reference to the underlying writer.
    ///
    /// The bytes after the last newline written are still buffered, not in it.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{LineWriter, Write};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let mut writer = LineWriter::new(Vec::new());
    ///     writer.write_all(b"a\nb")?;
    ///     assert_eq(writer.get_ref().clone(), b"a\n".to_vec());
    ///     Ok(())
    /// }
    /// ```
    pub fn get_ref(&self) -> &W {
        self.inner.get_ref()
    }

    /// Gets a mutable reference to the underlying writer.
    ///
    /// Caution must be taken when calling methods on the mutable reference
    /// returned, as writing directly to the underlying writer bypasses the
    /// buffer: what is written comes before the bytes still buffered.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{LineWriter, Write};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let mut writer = LineWriter::new(Vec::new());
    ///     writer.write_all(b"buffered")?;
    ///     writer.get_mut().write_all(b"direct ")?;
    ///     writer.flush()?;
    ///     assert_eq(writer.get_ref().clone(), b"direct buffered".to_vec());
    ///     Ok(())
    /// }
    /// ```
    pub fn get_mut(&mut self) -> &mut W {
        self.inner.get_mut()
    }

    /// Unwraps this `LineWriter`, returning the underlying writer.
    ///
    /// The internal buffer is written out before returning the writer.
    ///
    /// # Errors
    ///
    /// An error of writing the buffer or of flushing the inner writer.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::io::{LineWriter, Write};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let mut writer = LineWriter::new(Vec::new());
    ///     writer.write_all(b"no newline")?;
    ///     let inner = writer.into_inner()?;
    ///     assert_eq(inner, b"no newline".to_vec());
    ///     Ok(())
    /// }
    /// ```
    pub fn into_inner(self) -> io::Result<W> {
        self.inner.into_inner()
    }
}

impl<W: Write> Write for LineWriter<W> {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        let mut i = buf.len();
        while i > 0 && buf[i - 1] != b'\n' {
            i -= 1;
        }
        if i == 0 {
            return self.inner.write(buf);
        }
        self.inner.write_all(&buf[0..i])?;
        self.inner.flush()?;
        if i < buf.len() {
            self.inner.write_all(&buf[i..])?;
        }
        Ok(buf.len())
    }

    fn flush(&mut self) -> io::Result<()> {
        self.inner.flush()
    }
}
