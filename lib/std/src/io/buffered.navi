//! Buffered reading (BufRead, BufReader, lines and split) and LineWriter.

use crate::io::{self, Read, Write, Seek, SeekFrom, Error, ErrorKind, BufWriter};
use crate::string::String;

/// A reader with a buffer it can show: reading lines and up to a byte.
pub trait BufRead: Read {
    /// The buffered bytes, reading more if none are (empty at the end).
    fn fill_buf(&mut self) -> io::Result<&[u8]>;

    /// Marks amt bytes of the buffer as read.
    fn consume(&mut self, amt: usize);

    fn has_data_left(&mut self) -> io::Result<bool> {
        let b = self.fill_buf()?;
        Ok(b.len() > 0)
    }

    /// Appends bytes to buf up to and including byte (or the end); returns
    /// how many.
    fn read_until(&mut self, byte: u8, buf: &mut Vec<u8>) -> io::Result<usize> {
        let mut total = 0;
        loop {
            let available = match self.fill_buf() {
                Ok(b) => b,
                Err(e) => {
                    if e.kind() == ErrorKind::Interrupted { continue; }
                    return Err(e);
                }
            };
            let mut i = 0;
            let n = available.len();
            while i < n && available[i] != byte { i += 1; }
            let found = i < n;
            let used = if found { i + 1 } else { n };
            buf.extend_from_slice(&available[0..used]);
            self.consume(used);
            total += used;
            if found || used == 0 { return Ok(total); }
        }
    }

    /// Skips bytes up to and including byte (or the end); returns how many.
    fn skip_until(&mut self, byte: u8) -> io::Result<usize> {
        let mut total = 0;
        loop {
            let available = self.fill_buf()?;
            let mut i = 0;
            let n = available.len();
            while i < n && available[i] != byte { i += 1; }
            let found = i < n;
            let used = if found { i + 1 } else { n };
            self.consume(used);
            total += used;
            if found || used == 0 { return Ok(total); }
        }
    }

    /// Appends a line (with its newline, if any) to buf; returns its length
    /// in bytes (0 at the end).
    fn read_line(&mut self, buf: &mut String) -> io::Result<usize> {
        let mut bytes: Vec<u8> = Vec::new();
        let n = self.read_until(b'\n', &mut bytes)?;
        match String::from_utf8(bytes) {
            Ok(s) => {
                buf.push_str(s.as_str());
                Ok(n)
            }
            Err(_) => Err(Error::new(ErrorKind::InvalidData, "stream did not contain valid UTF-8")),
        }
    }

    /// The pieces between the byte (without it).
    fn split(self, byte: u8) -> Split<Self> { Split { buf: self, delim: byte } }

    /// The lines, without "\n" or "\r\n".
    fn lines(self) -> Lines<Self> { Lines { buf: self } }
}

/// The iterator of BufRead::lines.
pub struct Lines<B> {
    buf: B,
}

impl<B: BufRead> Iterator for Lines<B> {
    type Item = io::Result<String>;
    fn next(&mut self) -> Option<io::Result<String>> {
        let mut s = String::new();
        match self.buf.read_line(&mut s) {
            Ok(0) => None,
            Ok(_) => {
                if s.ends_with("\n") {
                    s.pop();
                    if s.ends_with("\r") { s.pop(); }
                }
                Some(Ok(s))
            }
            Err(e) => Some(Err(e)),
        }
    }
}

/// The iterator of BufRead::split.
pub struct Split<B> {
    buf: B,
    delim: u8,
}

impl<B: BufRead> Iterator for Split<B> {
    type Item = io::Result<Vec<u8>>;
    fn next(&mut self) -> Option<io::Result<Vec<u8>>> {
        let mut v: Vec<u8> = Vec::new();
        match self.buf.read_until(self.delim, &mut v) {
            Ok(0) => None,
            Ok(_) => {
                if v.len() > 0 && v[v.len() - 1] == self.delim { v.pop(); }
                Some(Ok(v))
            }
            Err(e) => Some(Err(e)),
        }
    }
}

/// Buffers reads from an inner reader (8 KiB by default).
pub struct BufReader<R> {
    inner: R,
    buf: Vec<u8>,
    pos: usize,
    filled: usize,
}

impl<R: Read> BufReader<R> {
    pub fn new(inner: R) -> BufReader<R> { BufReader::with_capacity(8192, inner) }

    pub fn with_capacity(capacity: usize, inner: R) -> BufReader<R> {
        let cap = if capacity == 0 { 1 } else { capacity };
        BufReader { inner, buf: crate::sys::zeroed(cap), pos: 0, filled: 0 }
    }
}

impl<R> BufReader<R> {
    pub fn get_ref(&self) -> &R { &self.inner }
    pub fn get_mut(&mut self) -> &mut R { &mut self.inner }
    /// The inner reader (the buffered bytes are lost).
    pub fn into_inner(self) -> R { self.inner }
    /// The bytes read ahead and not consumed.
    pub fn buffer(&self) -> &[u8] { &self.buf[self.pos..self.filled] }
    pub fn capacity(&self) -> usize { self.buf.len() }
    fn discard_buffer(&mut self) {
        self.pos = 0;
        self.filled = 0;
    }
}

impl<R: Read> Read for BufReader<R> {
    fn read(&mut self, out: &mut [u8]) -> io::Result<usize> {
        // Nothing buffered and a large read: straight from the inner reader.
        if self.pos == self.filled && out.len() >= self.buf.len() {
            self.discard_buffer();
            return self.inner.read(out);
        }
        let n = {
            let avail = self.fill_buf()?;
            let n = if avail.len() < out.len() { avail.len() } else { out.len() };
            out[0..n].copy_from_slice(&avail[0..n]);
            n
        };
        self.consume(n);
        Ok(n)
    }
}

impl<R: Read> BufRead for BufReader<R> {
    fn fill_buf(&mut self) -> io::Result<&[u8]> {
        if self.pos >= self.filled {
            let n = self.inner.read(self.buf.as_mut_slice())?;
            self.pos = 0;
            self.filled = n;
        }
        Ok(&self.buf[self.pos..self.filled])
    }

    fn consume(&mut self, amt: usize) {
        self.pos = if self.pos + amt > self.filled { self.filled } else { self.pos + amt };
    }
}

impl<R> Seek for BufReader<R> where R: Read + Seek {
    /// Seeks the inner reader (a Current offset counts from the position of
    /// the reader, before the buffered bytes) and drops the buffer.
    fn seek(&mut self, pos: SeekFrom) -> io::Result<u64> {
        let r = match pos {
            SeekFrom::Current(n) => {
                let remainder = (self.filled - self.pos) as i64;
                self.inner.seek(SeekFrom::Current(n - remainder))?
            }
            _ => self.inner.seek(pos)?,
        };
        self.discard_buffer();
        Ok(r)
    }
}

impl<R> BufReader<R> where R: Read + Seek {
    /// Moves the position by offset, keeping the buffer when it can.
    pub fn seek_relative(&mut self, offset: i64) -> io::Result<()> {
        let p = self.pos as i64 + offset;
        if p >= 0 && p <= self.filled as i64 {
            self.pos = p as usize;
            return Ok(());
        }
        self.seek(SeekFrom::Current(offset))?;
        Ok(())
    }
}

/// Buffers writes until a newline (then writes through the newline).
/// navi has no Drop: call flush() before the writer goes away.
pub struct LineWriter<W: Write> {
    inner: BufWriter<W>,
}

impl<W: Write> LineWriter<W> {
    pub fn new(inner: W) -> LineWriter<W> { LineWriter { inner: BufWriter::with_capacity(1024, inner) } }
    pub fn with_capacity(capacity: usize, inner: W) -> LineWriter<W> { LineWriter { inner: BufWriter::with_capacity(capacity, inner) } }
    pub fn get_ref(&self) -> &W { self.inner.get_ref() }
    pub fn get_mut(&mut self) -> &mut W { self.inner.get_mut() }
    pub fn into_inner(self) -> io::Result<W> { self.inner.into_inner() }
}

impl<W: Write> Write for LineWriter<W> {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        let mut i = buf.len();
        while i > 0 && buf[i - 1] != b'\n' { i -= 1; }
        if i == 0 { return self.inner.write(buf); }
        self.inner.write_all(&buf[0..i])?;
        self.inner.flush()?;
        if i < buf.len() { self.inner.write_all(&buf[i..])?; }
        Ok(buf.len())
    }
    fn flush(&mut self) -> io::Result<()> { self.inner.flush() }
}
