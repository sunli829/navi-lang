//! A growable array. Vec has reference semantics: copying a Vec shares the
//! buffer; use clone() for an independent copy.

use crate::ops::{Deref, DerefMut, Index, IndexMut};
use crate::slice;

pub struct Vec<T> {
    buf: &mut RawVec<T>,
}

struct RawVec<T> {
    ptr: *mut T,
    len: usize,
    cap: usize,
}

impl<T> Vec<T> {
    pub fn new() -> Vec<T> {
        Vec { buf: &mut RawVec { ptr: crate::ptr::null_mut(), len: 0, cap: 0 } }
    }

    pub fn with_capacity(capacity: usize) -> Vec<T> {
        let mut v = Vec::new();
        v.reserve(capacity);
        v
    }

    /// Sets the length; the elements up to it must be initialized (GC
    /// memory is zeroed: an all-zero value counts).
    pub unsafe fn set_len(&mut self, new_len: usize) { self.buf.len = new_len; }

    pub fn reserve(&mut self, additional: usize) {
        let need = self.buf.len + additional;
        if need <= self.buf.cap { return; }
        let mut cap = if self.buf.cap == 0 { 4 } else { self.buf.cap * 2 };
        while cap < need { cap = cap * 2; }
        let ptr = crate::rt::alloc_array::<T>(cap);
        if self.buf.len > 0 {
            crate::rt::copy(self.buf.ptr as *const T, ptr, self.buf.len);
        }
        self.buf.ptr = ptr;
        self.buf.cap = cap;
    }

    pub fn push(&mut self, value: T) {
        self.reserve(1);
        unsafe { self.buf.ptr.add(self.buf.len).write(value); }
        self.buf.len += 1;
    }

    pub fn pop(&mut self) -> Option<T> {
        if self.buf.len == 0 { return None; }
        self.buf.len -= 1;
        unsafe { Some(self.buf.ptr.add(self.buf.len).read()) }
    }

    pub fn len(&self) -> usize { self.buf.len }
    pub fn is_empty(&self) -> bool { self.buf.len == 0 }
    pub fn capacity(&self) -> usize { self.buf.cap }

    /// Gives back the capacity past the length (a new buffer of exactly
    /// the length).
    pub fn shrink_to_fit(&mut self) {
        let n = self.buf.len;
        if n == self.buf.cap { return; }
        if n == 0 {
            self.buf.ptr = crate::ptr::null_mut();
            self.buf.cap = 0;
            return;
        }
        let ptr = crate::rt::alloc_array::<T>(n);
        crate::rt::copy(self.buf.ptr as *const T, ptr, n);
        self.buf.ptr = ptr;
        self.buf.cap = n;
    }
    pub fn clear(&mut self) { self.buf.len = 0; }

    pub fn insert(&mut self, index: usize, value: T) {
        let len = self.buf.len;
        if index > len { panic(`insertion index (is ${index}) should be <= len (is ${len})`); }
        self.reserve(1);
        let mut i = len;
        while i > index {
            unsafe { self.buf.ptr.add(i).write(self.buf.ptr.add(i - 1).read()); }
            i -= 1;
        }
        unsafe { self.buf.ptr.add(index).write(value); }
        self.buf.len += 1;
    }

    pub fn remove(&mut self, index: usize) -> T {
        let len = self.buf.len;
        if index >= len { panic(`removal index (is ${index}) should be < len (is ${len})`); }
        let v = unsafe { self.buf.ptr.add(index).read() };
        let mut i = index;
        while i + 1 < len {
            unsafe { self.buf.ptr.add(i).write(self.buf.ptr.add(i + 1).read()); }
            i += 1;
        }
        self.buf.len -= 1;
        v
    }

    pub fn truncate(&mut self, len: usize) {
        if len < self.buf.len { self.buf.len = len; }
    }

    pub fn as_slice(&self) -> &[T] { crate::rt::slice_from_raw(self.buf.ptr as *const T, self.buf.len) }
    pub fn as_mut_slice(&mut self) -> &mut [T] { crate::rt::slice_from_raw_mut(self.buf.ptr, self.buf.len) }
    pub fn as_ptr(&self) -> *const T { self.buf.ptr as *const T }
    pub fn first(&self) -> Option<&T> { self.as_slice().first() }
    pub fn last(&self) -> Option<&T> { self.as_slice().last() }
    pub fn get(&self, index: usize) -> Option<&T> { self.as_slice().get(index) }
    pub fn iter(&self) -> slice::Iter<T> { self.as_slice().iter() }
    pub fn iter_mut(&mut self) -> slice::IterMut<T> { self.as_mut_slice().iter_mut() }
    pub fn first_mut(&mut self) -> Option<&mut T> { self.as_mut_slice().first_mut() }
    pub fn last_mut(&mut self) -> Option<&mut T> { self.as_mut_slice().last_mut() }
    pub fn get_mut(&mut self, index: usize) -> Option<&mut T> { self.as_mut_slice().get_mut(index) }

    pub fn swap_remove(&mut self, index: usize) -> T {
        let n = self.buf.len;
        if index >= n { panic(`swap_remove index (is ${index}) should be < len (is ${n})`); }
        let v = unsafe { self.buf.ptr.add(index).read() };
        unsafe { self.buf.ptr.add(index).write(self.buf.ptr.add(n - 1).read()); }
        self.buf.len -= 1;
        v
    }

    pub fn retain(&mut self, f: fn(&T) -> bool) {
        let n = self.buf.len;
        let mut w = 0;
        let mut r = 0;
        while r < n {
            let v = unsafe { self.buf.ptr.add(r).read() };
            if f(&v) {
                unsafe { self.buf.ptr.add(w).write(v); }
                w += 1;
            }
            r += 1;
        }
        self.buf.len = w;
    }

    pub fn dedup_by_key<K: PartialEq>(&mut self, key: fn(&T) -> K) {
        let n = self.buf.len;
        if n < 2 { return; }
        let mut w = 1;
        let mut r = 1;
        while r < n {
            let v = unsafe { self.buf.ptr.add(r).read() };
            let prev = unsafe { self.buf.ptr.add(w - 1).read() };
            if key(&v) != key(&prev) {
                unsafe { self.buf.ptr.add(w).write(v); }
                w += 1;
            }
            r += 1;
        }
        self.buf.len = w;
    }

    pub fn split_off(&mut self, at: usize) -> Vec<T> {
        let mut out = Vec::new();
        let n = self.buf.len;
        let mut i = at;
        while i < n { out.push(unsafe { self.buf.ptr.add(i).read() }); i += 1; }
        self.truncate(at);
        out
    }

    pub fn append(&mut self, other: &mut Vec<T>) {
        let n = other.len();
        let mut i = 0;
        while i < n { self.push(unsafe { other.buf.ptr.add(i).read() }); i += 1; }
        other.clear();
    }

    /// Removes the elements in a range and returns them (Rust returns a
    /// draining iterator; this returns its items as an iterator over a
    /// new Vec).
    pub fn drain<R: crate::ops::RangeBounds<usize>>(&mut self, range: R) -> IntoIter<T> {
        let n = self.buf.len;
        let start = match range.start_bound() {
            crate::ops::Bound::Included(s) => *s,
            crate::ops::Bound::Excluded(s) => *s + 1,
            crate::ops::Bound::Unbounded => 0,
        };
        let end = match range.end_bound() {
            crate::ops::Bound::Included(e) => *e + 1,
            crate::ops::Bound::Excluded(e) => *e,
            crate::ops::Bound::Unbounded => n,
        };
        if start > end || end > n { panic("drain range out of bounds"); }
        let mut out = Vec::new();
        let mut i = start;
        while i < end { out.push(unsafe { self.buf.ptr.add(i).read() }); i += 1; }
        let mut j = end;
        let mut w = start;
        while j < n {
            unsafe { self.buf.ptr.add(w).write(self.buf.ptr.add(j).read()); }
            w += 1;
            j += 1;
        }
        self.buf.len = w;
        out.into_iter()
    }
}

impl<T: PartialEq> Vec<T> {
    pub fn dedup(&mut self) {
        let n = self.buf.len;
        if n < 2 { return; }
        let mut w = 1;
        let mut r = 1;
        while r < n {
            let v = unsafe { self.buf.ptr.add(r).read() };
            let prev = unsafe { self.buf.ptr.add(w - 1).read() };
            if v != prev {
                unsafe { self.buf.ptr.add(w).write(v); }
                w += 1;
            }
            r += 1;
        }
        self.buf.len = w;
    }
}

impl<T: Clone> Vec<T> {
    pub fn resize(&mut self, n: usize, v: T) {
        if n < self.len() { self.truncate(n); return; }
        while self.len() < n { self.push(v.clone()); }
    }
}

/// The by-value iterator of a Vec.
pub struct IntoIter<T> { v: Vec<T>, i: usize, end: usize }
impl<T> Iterator for IntoIter<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        if self.i < self.end {
            let x = self.v[self.i];
            self.i += 1;
            Some(x)
        } else {
            None
        }
    }
}
impl<T> DoubleEndedIterator for IntoIter<T> {
    fn next_back(&mut self) -> Option<T> {
        if self.i < self.end {
            self.end -= 1;
            Some(self.v[self.end])
        } else {
            None
        }
    }
}

impl<T> IntoIterator for Vec<T> {
    type Item = T;
    type IntoIter = IntoIter<T>;
    fn into_iter(self) -> IntoIter<T> { let n = self.len(); IntoIter { v: self, i: 0, end: n } }
}

impl<T: Clone> Vec<T> {
    pub fn extend_from_slice(&mut self, other: &[T]) {
        if crate::rt::is_copy_clone::<T>() {
            self.extend_from_raw(crate::rt::slice_ptr(other), other.len());
            return;
        }
        for x in other { self.push(x.clone()); }
    }

    /// Appends n values copied bitwise from p.
    pub(crate) fn extend_from_raw(&mut self, p: *const T, n: usize) {
        if n == 0 { return; }
        self.reserve(n);
        crate::rt::copy(p, unsafe { self.buf.ptr.add(self.buf.len) }, n);
        self.buf.len += n;
    }
}

impl<T> Deref for Vec<T> {
    type Target = [T];
    fn deref(&self) -> &[T] { self.as_slice() }
}

impl<T> DerefMut for Vec<T> {
    fn deref_mut(&mut self) -> &mut [T] { self.as_mut_slice() }
}

impl<T> Index<usize> for Vec<T> {
    type Output = T;
    #[track_caller]
    fn index(&self, index: usize) -> &T { &self.as_slice()[index] }
}

impl<T> IndexMut<usize> for Vec<T> {
    #[track_caller]
    fn index_mut(&mut self, index: usize) -> &mut T { &mut self.as_mut_slice()[index] }
}

impl<T: Clone> Clone for Vec<T> {
    fn clone(&self) -> Vec<T> {
        let mut v = Vec::with_capacity(self.len());
        v.extend_from_slice(self.as_slice());
        v
    }
}

impl<T: PartialEq> PartialEq for Vec<T> {
    fn eq(&self, other: &Vec<T>) -> bool { self.as_slice() == other.as_slice() }
}

impl<T: crate::cmp::Eq> crate::cmp::Eq for Vec<T> {}

impl<T: crate::hash::Hash> crate::hash::Hash for Vec<T> {
    fn hash<H: crate::hash::Hasher>(&self, state: &mut H) { crate::slice::hash_slice(self.as_slice(), state) }
}

impl<T> Default for Vec<T> {
    fn default() -> Vec<T> { Vec::new() }
}

impl<T: Clone> From<&[T]> for Vec<T> {
    fn from(s: &[T]) -> Vec<T> { let mut v = Vec::new(); v.extend_from_slice(s); v }
}

impl<T: crate::fmt::Debug> crate::fmt::Debug for Vec<T> {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        crate::fmt::Debug::fmt(self.as_slice(), f)
    }
}

impl<T> IntoIterator for &Vec<T> {
    type Item = &T;
    type IntoIter = slice::Iter<T>;
    fn into_iter(self) -> slice::Iter<T> { self.iter() }
}

impl<T> IntoIterator for &mut Vec<T> {
    type Item = &mut T;
    type IntoIter = slice::IterMut<T>;
    fn into_iter(self) -> slice::IterMut<T> { self.iter_mut() }
}

impl<T> FromIterator<T> for Vec<T> {
    fn from_iter<I: IntoIterator<Item = T>>(iter: I) -> Vec<T> {
        let mut v = Vec::new();
        for x in iter { v.push(x); }
        v
    }
}

impl<T> Extend<T> for Vec<T> {
    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {
        for x in iter { self.push(x); }
    }
}

// std::reflect works on a Vec of any element type through a Vec<u8> view
// (a RawVec's layout does not depend on T).
#[cfg(feature = "navic")]
impl Vec<u8> {
    /// The elements' address.
    pub(crate) fn reflect_data(&self) -> *mut u8 { self.buf.ptr }

    /// Appends a zeroed element of size bytes (has_ptrs: it may hold
    /// references) and returns its address.
    pub(crate) fn reflect_push(&mut self, size: usize, has_ptrs: bool) -> *mut u8 {
        if self.buf.len == self.buf.cap {
            let cap = if self.buf.cap == 0 { 4 } else { self.buf.cap * 2 };
            let bytes = if cap * size == 0 { 8 } else { cap * size };
            let p = crate::rt::native::gc_alloc(bytes, !has_ptrs);
            let n = self.buf.len * size;
            if n > 0 {
                // Words that may be references are copied as such (the
                // collector's write barrier).
                if has_ptrs { crate::rt::copy(self.buf.ptr as *const &u8, p as *mut &u8, n / 8); } else { crate::rt::copy(self.buf.ptr as *const u8, p, n); }
            }
            self.buf.ptr = p;
            self.buf.cap = cap;
        }
        let at = self.buf.ptr as usize + self.buf.len * size;
        self.buf.len += 1;
        at as *mut u8
    }
}

