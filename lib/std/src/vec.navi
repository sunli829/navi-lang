//! A contiguous growable array type, [`Vec<T>`](Vec).
//!
//! Vectors have O(1) indexing, amortized O(1) push (to the end) and O(1) pop
//! (from the end).
//!
//! A `Vec` is a handle to a shared buffer: copying a vector (assigning it,
//! passing it to a function) shares its elements and its length, so changes
//! through one copy are seen through the others. Use `.clone()` for an
//! independent copy.
//!
//! # Examples
//!
//! Vectors are made with [`Vec::new`], from an array with `Vec::from` (there
//! is no `vec!` macro), or by collecting an iterator:
//!
//! ```
//! let v: Vec<i32> = Vec::new();
//! assert(v.is_empty());
//!
//! let v = Vec::from([1, 2, 3, 4, 5]);
//! assert_eq(v.len(), 5);
//!
//! let v: Vec<i32> = (0..5).collect();
//! assert_eq(v, [0, 1, 2, 3, 4]);
//! ```
//!
//! [`push`](Vec::push) adds an element to the end, [`pop`](Vec::pop) removes
//! the last one:
//!
//! ```
//! let mut v = Vec::from([1, 2]);
//! v.push(3);
//! assert_eq(v.pop(), Some(3));
//! assert_eq(v, [1, 2]);
//! ```
//!
//! Indexing reads and writes elements (out-of-bounds indexes panic):
//!
//! ```
//! let mut v = Vec::from([1, 2, 3]);
//! let three = v[2];
//! v[1] = v[1] + 5;
//! assert_eq(three, 3);
//! assert_eq(v, [1, 7, 3]);
//! ```
//!
//! A copy shares the vector, a clone does not:
//!
//! ```
//! let mut a = Vec::from([1, 2, 3]);
//! let b = a;
//! a.push(4);
//! assert_eq(b, [1, 2, 3, 4]);
//!
//! let mut c = a.clone();
//! c.push(5);
//! assert_eq(a.len(), 4);
//! assert_eq(c.len(), 5);
//! ```

use crate::{
    ops::{Deref, DerefMut, Index, IndexMut},
    slice,
};

/// A contiguous growable array type, written `Vec<T>`.
///
/// A vector is a handle to a buffer (a pointer, a capacity and a length)
/// shared by all its copies: assigning a vector or passing it to a function
/// does not copy the elements, and a `push` through one copy is seen through
/// the others. [`Clone::clone`](crate::clone::Clone::clone) makes an
/// independent vector with clones of the elements.
///
/// A `Vec<T>` dereferences to a slice `[T]`, so all the slice methods
/// (`sort`, `binary_search`, `iter`, `contains`, `windows`...) are available
/// on it, as is indexing with an index or a range.
///
/// # Capacity and reallocation
///
/// The capacity of a vector is the number of elements it can hold without
/// allocating a new buffer; its length is the number it does hold. When the
/// length would exceed the capacity, the vector moves to a new buffer about
/// twice as large (the old buffer is left to the garbage collector). A slice
/// taken before then (by [`as_slice`](Vec::as_slice), or `&v[..]`) keeps
/// viewing the old buffer.
///
/// [`Vec::with_capacity`] and [`Vec::reserve`] allocate room in advance,
/// when the final size is known.
///
/// # Examples
///
/// ```
/// let mut vec = Vec::new();
/// vec.push(1);
/// vec.push(2);
///
/// assert_eq(vec.len(), 2);
/// assert_eq(vec[0], 1);
///
/// assert_eq(vec.pop(), Some(2));
/// assert_eq(vec.len(), 1);
///
/// vec[0] = 7;
/// assert_eq(vec[0], 7);
///
/// vec.extend_from_slice(&[1, 2, 3]);
///
/// let mut sum = 0;
/// for x in vec.iter() {
///     sum += *x;
/// }
/// assert_eq(sum, 13);
/// assert_eq(vec, [7, 1, 2, 3]);
/// ```
///
/// Using a vector as a stack:
///
/// ```
/// let mut stack = Vec::new();
///
/// stack.push(1);
/// stack.push(2);
/// stack.push(3);
///
/// let mut popped = Vec::new();
/// while let Some(top) = stack.pop() {
///     popped.push(top);
/// }
/// assert_eq(popped, [3, 2, 1]);
/// ```
pub struct Vec<T> {
    buf: &mut RawVec<T>,
}

struct RawVec<T> {
    ptr: *mut T,
    len: usize,
    cap: usize,
}

impl<T> Vec<T> {
    /// Constructs a new, empty `Vec<T>`.
    ///
    /// The vector does not allocate until elements are pushed onto it.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec: Vec<i32> = Vec::new();
    /// assert_eq(vec.len(), 0);
    /// assert_eq(vec.capacity(), 0);
    /// ```
    pub fn new() -> Vec<T> {
        Vec {
            buf: &mut RawVec {
                ptr: crate::ptr::null_mut(),
                len: 0,
                cap: 0,
            },
        }
    }

    /// Constructs a new, empty `Vec<T>` with room for at least `capacity`
    /// elements.
    ///
    /// The vector can then hold `capacity` elements without a new allocation
    /// (the capacity may be larger than asked). With a capacity of 0, it does
    /// not allocate.
    ///
    /// # Panics
    ///
    /// Panics if the size of the buffer overflows.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::with_capacity(10);
    ///
    /// // The vector contains no items, even though it has room for more.
    /// assert_eq(vec.len(), 0);
    /// assert(vec.capacity() >= 10);
    ///
    /// // These are all done without reallocating...
    /// let cap = vec.capacity();
    /// for i in 0..10 {
    ///     vec.push(i);
    /// }
    /// assert_eq(vec.len(), 10);
    /// assert_eq(vec.capacity(), cap);
    ///
    /// // ...but this may make the vector reallocate.
    /// vec.push(11);
    /// assert_eq(vec.len(), 11);
    /// assert(vec.capacity() >= 11);
    /// ```
    pub fn with_capacity(capacity: usize) -> Vec<T> {
        let mut v = Vec::new();
        v.reserve(capacity);
        v
    }

    /// Forces the length of the vector to `new_len`.
    ///
    /// This does not change the buffer; it is used after writing elements
    /// through [`as_mut_ptr`](Vec::as_mut_ptr), for example.
    ///
    /// # Safety
    ///
    /// `new_len` must be less than or equal to [`capacity`](Vec::capacity), and
    /// the elements up to `new_len` must be initialized. (GC memory is zeroed:
    /// an all-zero value counts as initialized, as do elements left past the
    /// length by `truncate`, `pop` or `clear`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let mut v: Vec<u8> = Vec::with_capacity(4);
    /// let p = v.as_mut_ptr();
    /// unsafe {
    ///     p.write(1);
    ///     p.add(1).write(2);
    ///     v.set_len(2);
    /// }
    /// assert_eq(v, [1, 2]);
    /// ```
    pub unsafe fn set_len(&mut self, new_len: usize) {
        self.buf.len = new_len;
    }

    /// Reserves capacity for at least `additional` more elements.
    ///
    /// If the capacity is too small, the vector moves to a new buffer: at least
    /// twice the old capacity (4 for the first), doubled until the elements
    /// fit, so that a series of pushes takes amortized constant time. Does
    /// nothing if the capacity is already sufficient. Use
    /// [`reserve_exact`](Vec::reserve_exact) to allocate no more than needed.
    ///
    /// # Panics
    ///
    /// Panics if the new capacity overflows.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::from([1]);
    /// vec.reserve(10);
    /// assert(vec.capacity() >= 11);
    /// ```
    pub fn reserve(&mut self, additional: usize) {
        let need = self.buf.len + additional;
        if need <= self.buf.cap {
            return;
        }
        let mut cap = if self.buf.cap == 0 {
            4
        } else {
            self.buf.cap * 2
        };
        while cap < need {
            cap = cap * 2;
        }
        let ptr = crate::rt::alloc_array::<T>(cap);
        if self.buf.len > 0 {
            crate::rt::copy(self.buf.ptr as *const T, ptr, self.buf.len);
        }
        self.buf.ptr = ptr;
        self.buf.cap = cap;
    }

    /// Appends an element to the back of the vector.
    ///
    /// Takes amortized O(1) time: when the capacity is reached, the vector
    /// moves to a buffer twice as large.
    ///
    /// # Panics
    ///
    /// Panics if the new capacity overflows.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::from([1, 2]);
    /// vec.push(3);
    /// assert_eq(vec, [1, 2, 3]);
    /// ```
    #[inline]
    pub fn push(&mut self, value: T) {
        if self.buf.len == self.buf.cap {
            self.reserve(1);
        }
        unsafe {
            self.buf.ptr.add(self.buf.len).write(value);
        }
        self.buf.len += 1;
    }

    /// Removes the last element from the vector and returns it, or `None` if it
    /// is empty.
    ///
    /// Takes O(1) time.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::from([1, 2, 3]);
    /// assert_eq(vec.pop(), Some(3));
    /// assert_eq(vec, [1, 2]);
    ///
    /// let mut empty: Vec<i32> = Vec::new();
    /// assert_eq(empty.pop(), None);
    /// ```
    #[inline]
    pub fn pop(&mut self) -> Option<T> {
        if self.buf.len == 0 {
            return None;
        }
        self.buf.len -= 1;
        unsafe { Some(self.buf.ptr.add(self.buf.len).read()) }
    }

    /// Returns the number of elements in the vector, also called its length.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = Vec::from([1, 2, 3]);
    /// assert_eq(a.len(), 3);
    /// ```
    pub fn len(&self) -> usize {
        self.buf.len
    }

    /// Returns `true` if the vector contains no elements.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut v = Vec::new();
    /// assert(v.is_empty());
    ///
    /// v.push(1);
    /// assert(!v.is_empty());
    /// ```
    pub fn is_empty(&self) -> bool {
        self.buf.len == 0
    }

    /// Returns the total number of elements the vector can hold without
    /// reallocating.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec: Vec<i32> = Vec::with_capacity(10);
    /// vec.push(42);
    /// assert(vec.capacity() >= 10);
    /// ```
    pub fn capacity(&self) -> usize {
        self.buf.cap
    }

    /// Shrinks the capacity of the vector to its length.
    ///
    /// If the capacity is larger than the length, the elements move to a new
    /// buffer of exactly the length; an empty vector gives its buffer up.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::with_capacity(10);
    /// vec.extend_from_slice(&[1, 2, 3]);
    /// assert(vec.capacity() >= 10);
    /// vec.shrink_to_fit();
    /// assert_eq(vec.capacity(), 3);
    /// ```
    pub fn shrink_to_fit(&mut self) {
        let n = self.buf.len;
        if n == self.buf.cap {
            return;
        }
        if n == 0 {
            self.buf.ptr = crate::ptr::null_mut();
            self.buf.cap = 0;
            return;
        }
        let ptr = crate::rt::alloc_array::<T>(n);
        crate::rt::copy(self.buf.ptr as *const T, ptr, n);
        self.buf.ptr = ptr;
        self.buf.cap = n;
    }

    /// Clears the vector, removing all values.
    ///
    /// The capacity is unchanged.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut v = Vec::from([1, 2, 3]);
    /// v.clear();
    /// assert(v.is_empty());
    /// assert(v.capacity() >= 3);
    /// ```
    pub fn clear(&mut self) {
        self.buf.len = 0;
    }

    /// Inserts an element at position `index`, shifting all the elements after
    /// it to the right.
    ///
    /// Takes O(*n*) time (the elements after `index` move).
    ///
    /// # Panics
    ///
    /// Panics if `index > len`.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::from(['a', 'b', 'c']);
    /// vec.insert(1, 'd');
    /// assert_eq(vec, ['a', 'd', 'b', 'c']);
    /// vec.insert(4, 'e');
    /// assert_eq(vec, ['a', 'd', 'b', 'c', 'e']);
    /// ```
    pub fn insert(&mut self, index: usize, value: T) {
        let len = self.buf.len;
        if index > len {
            panic(`insertion index (is ${index}) should be <= len (is ${len})`);
        }
        self.reserve(1);
        let mut i = len;
        while i > index {
            unsafe {
                self.buf.ptr.add(i).write(self.buf.ptr.add(i - 1).read());
            }
            i -= 1;
        }
        unsafe {
            self.buf.ptr.add(index).write(value);
        }
        self.buf.len += 1;
    }

    /// Removes and returns the element at position `index`, shifting all the
    /// elements after it to the left.
    ///
    /// Takes O(*n*) time (the elements after `index` move). If the order does
    /// not matter, [`swap_remove`](Vec::swap_remove) is O(1).
    ///
    /// # Panics
    ///
    /// Panics if `index` is out of bounds.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut v = Vec::from(['a', 'b', 'c']);
    /// assert_eq(v.remove(1), 'b');
    /// assert_eq(v, ['a', 'c']);
    /// ```
    pub fn remove(&mut self, index: usize) -> T {
        let len = self.buf.len;
        if index >= len {
            panic(`removal index (is ${index}) should be < len (is ${len})`);
        }
        let v = unsafe { self.buf.ptr.add(index).read() };
        let mut i = index;
        while i + 1 < len {
            unsafe {
                self.buf.ptr.add(i).write(self.buf.ptr.add(i + 1).read());
            }
            i += 1;
        }
        self.buf.len -= 1;
        v
    }

    /// Shortens the vector, keeping the first `len` elements.
    ///
    /// If `len` is greater than or equal to the vector's current length, this
    /// does nothing. The capacity is unchanged.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::from([1, 2, 3, 4, 5]);
    /// vec.truncate(2);
    /// assert_eq(vec, [1, 2]);
    ///
    /// // No truncation when len is greater than the vector's length.
    /// vec.truncate(8);
    /// assert_eq(vec, [1, 2]);
    /// ```
    pub fn truncate(&mut self, len: usize) {
        if len < self.buf.len {
            self.buf.len = len;
        }
    }

    /// Returns a slice of the whole vector.
    ///
    /// The slice views the current buffer: after a push that reallocates, it no
    /// longer sees the vector's changes.
    ///
    /// # Examples
    ///
    /// ```
    /// let v = Vec::from([1, 2, 3]);
    /// let s: &[i32] = v.as_slice();
    /// assert_eq(s.len(), 3);
    /// assert_eq(s[1], 2);
    /// ```
    pub fn as_slice(&self) -> &[T] {
        crate::rt::slice_from_raw(self.as_ptr(), self.buf.len)
    }

    /// Returns a mutable slice of the whole vector.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut v = Vec::from([3, 1, 2]);
    /// let s = v.as_mut_slice();
    /// s[0] = 0;
    /// assert_eq(v, [0, 1, 2]);
    /// ```
    pub fn as_mut_slice(&mut self) -> &mut [T] {
        crate::rt::slice_from_raw_mut(self.as_mut_ptr(), self.buf.len)
    }

    /// Returns a raw pointer to the vector's buffer.
    ///
    /// While no buffer is allocated it is, as Rust's, a dangling non-null
    /// pointer: `Option<&[T]>` and `Option<&str>` keep `None` as a null
    /// pointer, so an empty slice's must not be one (`Some("")` would read as
    /// `None`). The pointer must not be read past the length, and becomes stale
    /// when the vector reallocates.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = Vec::from([1, 2, 4]);
    /// let p = x.as_ptr();
    /// unsafe {
    ///     assert_eq(p.add(2).read(), 4);
    /// }
    /// ```
    pub fn as_ptr(&self) -> *const T {
        if self.buf.ptr as usize == 0 {
            DANGLING as *const T
        } else {
            self.buf.ptr as *const T
        }
    }

    /// Returns the first element of the vector, or `None` if it is empty.
    ///
    /// # Examples
    ///
    /// ```
    /// let v = Vec::from([10, 40, 30]);
    /// assert_eq(v.first(), Some(&10));
    ///
    /// let w: Vec<i32> = Vec::new();
    /// assert_eq(w.first(), None);
    /// ```
    pub fn first(&self) -> Option<&T> {
        self.as_slice().first()
    }

    /// Returns the last element of the vector, or `None` if it is empty.
    ///
    /// # Examples
    ///
    /// ```
    /// let v = Vec::from([10, 40, 30]);
    /// assert_eq(v.last(), Some(&30));
    /// ```
    pub fn last(&self) -> Option<&T> {
        self.as_slice().last()
    }

    /// Returns a reference to the element at `index`, or `None` if it is out of
    /// bounds.
    ///
    /// # Examples
    ///
    /// ```
    /// let v = Vec::from([10, 40, 30]);
    /// assert_eq(v.get(1), Some(&40));
    /// assert_eq(v.get(3), None);
    /// ```
    #[inline]
    pub fn get(&self, index: usize) -> Option<&T> {
        self.as_slice().get(index)
    }

    /// Returns an iterator over the elements of the vector, yielding `&T`.
    ///
    /// # Examples
    ///
    /// ```
    /// let v = Vec::from([1, 2, 4]);
    /// let mut it = v.iter();
    /// assert_eq(it.next(), Some(&1));
    /// assert_eq(it.next(), Some(&2));
    /// assert_eq(it.next(), Some(&4));
    /// assert_eq(it.next(), None);
    /// ```
    pub fn iter(&self) -> slice::Iter<T> {
        self.as_slice().iter()
    }

    /// Returns an iterator over the elements of the vector, yielding `&mut T`.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut v = Vec::from([1, 2, 4]);
    /// for x in v.iter_mut() {
    ///     *x *= 10;
    /// }
    /// assert_eq(v, [10, 20, 40]);
    /// ```
    pub fn iter_mut(&mut self) -> slice::IterMut<T> {
        self.as_mut_slice().iter_mut()
    }

    /// Returns a mutable reference to the first element, or `None` if the
    /// vector is empty.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut v = Vec::from([0, 1, 2]);
    /// if let Some(first) = v.first_mut() {
    ///     *first = 5;
    /// }
    /// assert_eq(v, [5, 1, 2]);
    /// ```
    pub fn first_mut(&mut self) -> Option<&mut T> {
        self.as_mut_slice().first_mut()
    }

    /// Returns a mutable reference to the last element, or `None` if the vector
    /// is empty.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut v = Vec::from([0, 1, 2]);
    /// if let Some(last) = v.last_mut() {
    ///     *last = 10;
    /// }
    /// assert_eq(v, [0, 1, 10]);
    /// ```
    pub fn last_mut(&mut self) -> Option<&mut T> {
        self.as_mut_slice().last_mut()
    }

    /// Returns a mutable reference to the element at `index`, or `None` if it
    /// is out of bounds.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut v = Vec::from([0, 1, 2]);
    /// if let Some(x) = v.get_mut(1) {
    ///     *x = 42;
    /// }
    /// assert_eq(v, [0, 42, 2]);
    /// ```
    #[inline]
    pub fn get_mut(&mut self, index: usize) -> Option<&mut T> {
        self.as_mut_slice().get_mut(index)
    }

    /// Removes an element from the vector and returns it, replacing it with the
    /// last element.
    ///
    /// This does not preserve the order of the remaining elements, but is O(1).
    /// If the order matters, use [`remove`](Vec::remove).
    ///
    /// # Panics
    ///
    /// Panics if `index` is out of bounds.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut v = Vec::from(["foo", "bar", "baz", "qux"]);
    ///
    /// assert_eq(v.swap_remove(1), "bar");
    /// assert_eq(v, ["foo", "qux", "baz"]);
    ///
    /// assert_eq(v.swap_remove(0), "foo");
    /// assert_eq(v, ["baz", "qux"]);
    /// ```
    pub fn swap_remove(&mut self, index: usize) -> T {
        let n = self.buf.len;
        if index >= n {
            panic(`swap_remove index (is ${index}) should be < len (is ${n})`);
        }
        let v = unsafe { self.buf.ptr.add(index).read() };
        unsafe {
            self.buf
                .ptr
                .add(index)
                .write(self.buf.ptr.add(n - 1).read());
        }
        self.buf.len -= 1;
        v
    }

    /// Retains only the elements for which `f` returns `true`.
    ///
    /// The other elements are removed. `f` is called once for each element, in
    /// order, and the kept elements keep their order.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::from([1, 2, 3, 4]);
    /// vec.retain(|x| *x % 2 == 0);
    /// assert_eq(vec, [2, 4]);
    /// ```
    pub fn retain(&mut self, f: fn(&T) -> bool) {
        let n = self.buf.len;
        let mut w = 0;
        let mut r = 0;
        while r < n {
            let v = unsafe { self.buf.ptr.add(r).read() };
            if f(&v) {
                unsafe {
                    self.buf.ptr.add(w).write(v);
                }
                w += 1;
            }
            r += 1;
        }
        self.buf.len = w;
    }

    /// Removes consecutive elements that map to the same key, keeping the first
    /// of each run.
    ///
    /// If the vector is sorted by the key, this removes all duplicates.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::from([10, 20, 21, 30, 20]);
    /// vec.dedup_by_key(|i| *i / 10);
    /// assert_eq(vec, [10, 20, 30, 20]);
    /// ```
    pub fn dedup_by_key<K: PartialEq>(&mut self, key: fn(&T) -> K) {
        let n = self.buf.len;
        if n < 2 {
            return;
        }
        let mut w = 1;
        let mut r = 1;
        while r < n {
            let v = unsafe { self.buf.ptr.add(r).read() };
            let prev = unsafe { self.buf.ptr.add(w - 1).read() };
            if key(&v) != key(&prev) {
                unsafe {
                    self.buf.ptr.add(w).write(v);
                }
                w += 1;
            }
            r += 1;
        }
        self.buf.len = w;
    }

    /// Splits the vector into two at the given index.
    ///
    /// Returns a new vector holding the elements from `at` on; the vector keeps
    /// the elements before `at`. Its capacity is unchanged.
    ///
    /// # Panics
    ///
    /// Panics if `at > len`.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::from(['a', 'b', 'c']);
    /// let vec2 = vec.split_off(1);
    /// assert_eq(vec, ['a']);
    /// assert_eq(vec2, ['b', 'c']);
    /// ```
    pub fn split_off(&mut self, at: usize) -> Vec<T> {
        let n = self.buf.len;
        if at > n {
            crate::panic::panic(`\`at\` split index (is ${at}) should be <= len (is ${n})`);
        }
        let mut out = Vec::new();
        let mut i = at;
        while i < n {
            out.push(unsafe { self.buf.ptr.add(i).read() });
            i += 1;
        }
        self.truncate(at);
        out
    }

    /// Moves all the elements of `other` to the end of the vector, leaving
    /// `other` empty.
    ///
    /// # Panics
    ///
    /// Panics if `other` is this vector (a copy of it shares its elements; Rust
    /// does not let one borrow a vector twice).
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::from([1, 2, 3]);
    /// let mut vec2 = Vec::from([4, 5, 6]);
    /// vec.append(&mut vec2);
    /// assert_eq(vec, [1, 2, 3, 4, 5, 6]);
    /// assert(vec2.is_empty());
    /// ```
    pub fn append(&mut self, other: &mut Vec<T>) {
        if crate::ptr::eq(self.buf, other.buf) {
            crate::panic::panic("append: `other` is the vector itself");
        }
        let n = other.len();
        let mut i = 0;
        while i < n {
            self.push(unsafe { other.buf.ptr.add(i).read() });
            i += 1;
        }
        other.clear();
    }

    /// Removes the elements in `range` from the vector and returns them, as an
    /// iterator.
    ///
    /// Unlike Rust's, which returns a lazy draining iterator, the elements are
    /// removed at once: the vector is already shortened when `drain` returns,
    /// whether or not the iterator is used. The result is an iterator over a
    /// new vector holding them.
    ///
    /// # Panics
    ///
    /// Panics if the start of the range is greater than its end, or if its end
    /// is greater than the length of the vector.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut v = Vec::from([1, 2, 3]);
    /// let u: Vec<i32> = v.drain(1..).collect();
    /// assert_eq(v, [1]);
    /// assert_eq(u, [2, 3]);
    ///
    /// // A full range clears the vector, as `clear` does.
    /// v.drain(..);
    /// assert(v.is_empty());
    /// ```
    pub fn drain<R: crate::ops::RangeBounds<usize>>(&mut self, range: R) -> IntoIter<T> {
        let n = self.buf.len;
        let start = match range.start_bound() {
            crate::ops::Bound::Included(s) => *s,
            crate::ops::Bound::Excluded(s) => *s + 1,
            crate::ops::Bound::Unbounded => 0,
        };
        let end = match range.end_bound() {
            crate::ops::Bound::Included(e) => *e + 1,
            crate::ops::Bound::Excluded(e) => *e,
            crate::ops::Bound::Unbounded => n,
        };
        if start > end || end > n {
            panic("drain range out of bounds");
        }
        let mut out = Vec::new();
        let mut i = start;
        while i < end {
            out.push(unsafe { self.buf.ptr.add(i).read() });
            i += 1;
        }
        let mut j = end;
        let mut w = start;
        while j < n {
            unsafe {
                self.buf.ptr.add(w).write(self.buf.ptr.add(j).read());
            }
            w += 1;
            j += 1;
        }
        self.buf.len = w;
        out.into_iter()
    }
}

impl<T: PartialEq> Vec<T> {
    /// Removes consecutive repeated elements, keeping the first of each run.
    ///
    /// If the vector is sorted, this removes all duplicates.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::from([1, 2, 2, 3, 2]);
    /// vec.dedup();
    /// assert_eq(vec, [1, 2, 3, 2]);
    /// ```
    pub fn dedup(&mut self) {
        let n = self.buf.len;
        if n < 2 {
            return;
        }
        let mut w = 1;
        let mut r = 1;
        while r < n {
            let v = unsafe { self.buf.ptr.add(r).read() };
            let prev = unsafe { self.buf.ptr.add(w - 1).read() };
            if v != prev {
                unsafe {
                    self.buf.ptr.add(w).write(v);
                }
                w += 1;
            }
            r += 1;
        }
        self.buf.len = w;
    }
}

impl<T: Clone> Vec<T> {
    /// Resizes the vector in place so that its length is `n`.
    ///
    /// If `n` is greater than the length, the vector is extended with copies of
    /// `v` (each a clone, or a plain copy for types whose clone is one);
    /// otherwise it is truncated.
    ///
    /// # Panics
    ///
    /// Panics if the new capacity overflows.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::from(["hello"]);
    /// vec.resize(3, "world");
    /// assert_eq(vec, ["hello", "world", "world"]);
    ///
    /// let mut vec = Vec::from([1, 2, 3, 4]);
    /// vec.resize(2, 0);
    /// assert_eq(vec, [1, 2]);
    /// ```
    pub fn resize(&mut self, n: usize, v: T) {
        if n < self.len() {
            self.truncate(n);
            return;
        }
        self.reserve(n - self.len());
        if crate::rt::is_copy_clone::<T>() {
            // Copies of v without calling clone (the pointer and index in
            // registers, the length stored once).
            let p = self.buf.ptr;
            let mut i = self.buf.len;
            while i < n {
                unsafe {
                    p.add(i).write(v);
                }
                i += 1;
            }
            self.buf.len = n;
            return;
        }
        while self.len() < n {
            self.push(v.clone());
        }
    }
}

/// An iterator yielding the elements of a vector by value.
///
/// Made by the `into_iter` method of [`Vec`] (from the
/// [`IntoIterator`](crate::iter::IntoIterator) trait), as in a `for` loop
/// over a vector, and returned by [`Vec::drain`]. navi has no move: the
/// iterator shares the vector's buffer, and the vector stays usable.
///
/// # Examples
///
/// ```
/// let v = Vec::from([1, 2, 3]);
/// let mut it = v.into_iter();
/// assert_eq(it.next(), Some(1));
/// assert_eq(it.as_slice(), &[2, 3][..]);
/// assert_eq(it.next_back(), Some(3));
/// assert_eq(it.len(), 1);
/// ```
pub struct IntoIter<T> {
    v: Vec<T>,
    i: usize,
    end: usize,
}

impl<T> Iterator for IntoIter<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        if self.i < self.end {
            let x = self.v[self.i];
            self.i += 1;
            Some(x)
        } else {
            None
        }
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        (self.end - self.i, Some(self.end - self.i))
    }
}

impl<T> DoubleEndedIterator for IntoIter<T> {
    fn next_back(&mut self) -> Option<T> {
        if self.i < self.end {
            self.end -= 1;
            Some(self.v[self.end])
        } else {
            None
        }
    }
}

impl<T> IntoIterator for Vec<T> {
    type Item = T;
    type IntoIter = IntoIter<T>;
    fn into_iter(self) -> IntoIter<T> {
        let n = self.len();
        IntoIter {
            v: self,
            i: 0,
            end: n,
        }
    }
}

impl<T: Clone> Vec<T> {
    /// Clones and appends all the elements of a slice to the vector.
    ///
    /// The elements are cloned in order (for types whose clone is a plain copy,
    /// copied all at once).
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::from([1]);
    /// vec.extend_from_slice(&[2, 3, 4]);
    /// assert_eq(vec, [1, 2, 3, 4]);
    /// ```
    pub fn extend_from_slice(&mut self, other: &[T]) {
        if crate::rt::is_copy_clone::<T>() {
            self.extend_from_raw(crate::rt::slice_ptr(other), other.len());
            return;
        }
        for x in other {
            self.push(x.clone());
        }
    }

    /// Appends n values copied bitwise from p.
    pub(crate) fn extend_from_raw(&mut self, p: *const T, n: usize) {
        if n == 0 {
            return;
        }
        self.reserve(n);
        crate::rt::copy(p, unsafe { self.buf.ptr.add(self.buf.len) }, n);
        self.buf.len += n;
    }
}

impl<T> Deref for Vec<T> {
    type Target = [T];
    fn deref(&self) -> &[T] {
        self.as_slice()
    }
}

impl<T> DerefMut for Vec<T> {
    fn deref_mut(&mut self) -> &mut [T] {
        self.as_mut_slice()
    }
}

impl<T> Index<usize> for Vec<T> {
    type Output = T;
    #[track_caller]
    #[inline]
    fn index(&self, index: usize) -> &T {
        // (Within the length the buffer is allocated: no dangling pointer
        // for an empty vector needed, as as_slice's.)
        &crate::rt::slice_from_raw(self.buf.ptr as *const T, self.buf.len)[index]
    }
}

impl<T> IndexMut<usize> for Vec<T> {
    #[track_caller]
    #[inline]
    fn index_mut(&mut self, index: usize) -> &mut T {
        &mut crate::rt::slice_from_raw_mut(self.buf.ptr, self.buf.len)[index]
    }
}

impl<T: Clone> Clone for Vec<T> {
    fn clone(&self) -> Vec<T> {
        let mut v = Vec::with_capacity(self.len());
        v.extend_from_slice(self.as_slice());
        v
    }
}

// Comparisons with vectors, slices and arrays of other element types (as
// Rust's alloc::vec::partial_eq: Vec<String> == ["a", "b"]).
impl<T, U> PartialEq<Vec<U>> for Vec<T>
where
    T: PartialEq<U>,
{
    fn eq(&self, other: &Vec<U>) -> bool {
        crate::slice::eq_slices(self.as_slice(), other.as_slice())
    }
}

impl<T, U> PartialEq<[U]> for Vec<T>
where
    T: PartialEq<U>,
{
    fn eq(&self, other: &[U]) -> bool {
        crate::slice::eq_slices(self.as_slice(), other)
    }
}

impl<T, U> PartialEq<&mut [U]> for Vec<T>
where
    T: PartialEq<U>,
{
    fn eq(&self, other: &&mut [U]) -> bool {
        crate::slice::eq_slices(self.as_slice(), &**other)
    }
}

impl<T, U> PartialEq<Vec<U>> for [T]
where
    T: PartialEq<U>,
{
    fn eq(&self, other: &Vec<U>) -> bool {
        crate::slice::eq_slices(self, other.as_slice())
    }
}

impl<T, U> PartialEq<Vec<U>> for &[T]
where
    T: PartialEq<U>,
{
    fn eq(&self, other: &Vec<U>) -> bool {
        crate::slice::eq_slices(*self, other.as_slice())
    }
}

impl<T, U> PartialEq<Vec<U>> for &mut [T]
where
    T: PartialEq<U>,
{
    fn eq(&self, other: &Vec<U>) -> bool {
        crate::slice::eq_slices(&**self, other.as_slice())
    }
}

impl<T: crate::cmp::Eq> crate::cmp::Eq for Vec<T> {}

impl<T: crate::hash::Hash> crate::hash::Hash for Vec<T> {
    fn hash<H: crate::hash::Hasher>(&self, state: &mut H) {
        crate::slice::hash_slice(self.as_slice(), state)
    }
}

impl<T> Default for Vec<T> {
    fn default() -> Vec<T> {
        Vec::new()
    }
}

impl<T: Clone> From<&[T]> for Vec<T> {
    fn from(s: &[T]) -> Vec<T> {
        let mut v = Vec::new();
        v.extend_from_slice(s);
        v
    }
}

impl<T: crate::fmt::Debug> crate::fmt::Debug for Vec<T> {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        crate::fmt::Debug::fmt(self.as_slice(), f)
    }
}

impl<T> IntoIterator for &Vec<T> {
    type Item = &T;
    type IntoIter = slice::Iter<T>;
    fn into_iter(self) -> slice::Iter<T> {
        self.iter()
    }
}

impl<T> IntoIterator for &mut Vec<T> {
    type Item = &mut T;
    type IntoIter = slice::IterMut<T>;
    fn into_iter(self) -> slice::IterMut<T> {
        self.iter_mut()
    }
}

impl<T> FromIterator<T> for Vec<T> {
    fn from_iter<I: IntoIterator<Item = T>>(iter: I) -> Vec<T> {
        let mut v = Vec::new();
        for x in iter {
            v.push(x);
        }
        v
    }
}

impl<T> Extend<T> for Vec<T> {
    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {
        for x in iter {
            self.push(x);
        }
    }
}

// ---------------------------------------------------------------------------

/// The (start, end) of range within 0..len; panics if out of bounds.
#[track_caller]
pub(crate) fn range_of<R: crate::ops::RangeBounds<usize>>(range: &R, len: usize) -> (usize, usize) {
    let start = match range.start_bound() {
        crate::ops::Bound::Included(s) => *s,
        crate::ops::Bound::Excluded(s) => *s + 1,
        crate::ops::Bound::Unbounded => 0,
    };
    let end = match range.end_bound() {
        crate::ops::Bound::Included(e) => *e + 1,
        crate::ops::Bound::Excluded(e) => *e,
        crate::ops::Bound::Unbounded => len,
    };
    if start > end {
        panic(`slice index starts at ${start} but ends at ${end}`);
    }
    if end > len {
        panic(`range end index ${end} out of range for slice of length ${len}`);
    }
    (start, end)
}

impl<T> Vec<T> {
    /// Returns a raw mutable pointer to the vector's buffer.
    ///
    /// While no buffer is allocated it is a dangling non-null pointer (see
    /// [`as_ptr`](Vec::as_ptr)). Writes past the length are not part of the
    /// vector until [`set_len`](Vec::set_len) includes them; the pointer
    /// becomes stale when the vector reallocates.
    ///
    /// # Examples
    ///
    /// ```
    /// let size = 4;
    /// let mut x: Vec<i32> = Vec::with_capacity(size);
    /// let p = x.as_mut_ptr();
    /// unsafe {
    ///     let mut i = 0;
    ///     while i < size {
    ///         p.add(i).write(i as i32);
    ///         i += 1;
    ///     }
    ///     x.set_len(size);
    /// }
    /// assert_eq(x, [0, 1, 2, 3]);
    /// ```
    pub fn as_mut_ptr(&mut self) -> *mut T {
        if self.buf.ptr as usize == 0 {
            DANGLING as *mut T
        } else {
            self.buf.ptr
        }
    }

    /// Reserves capacity for exactly `additional` more elements.
    ///
    /// Unlike [`reserve`](Vec::reserve), the new buffer is no larger than
    /// needed; prefer `reserve` when more pushes may follow. Does nothing if
    /// the capacity is already sufficient.
    ///
    /// # Panics
    ///
    /// Panics if the new capacity overflows.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::from([1]);
    /// vec.reserve_exact(10);
    /// assert_eq(vec.capacity(), 11);
    /// ```
    pub fn reserve_exact(&mut self, additional: usize) {
        let need = self.buf.len + additional;
        if need <= self.buf.cap {
            return;
        }
        let ptr = crate::rt::alloc_array::<T>(need);
        if self.buf.len > 0 {
            crate::rt::copy(self.buf.ptr as *const T, ptr, self.buf.len);
        }
        self.buf.ptr = ptr;
        self.buf.cap = need;
    }

    /// Shrinks the capacity of the vector to the larger of its length and
    /// `min_capacity`.
    ///
    /// If the capacity is already at most that, this does nothing.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::with_capacity(10);
    /// vec.extend_from_slice(&[1, 2, 3]);
    /// assert(vec.capacity() >= 10);
    /// vec.shrink_to(4);
    /// assert_eq(vec.capacity(), 4);
    /// vec.shrink_to(0);
    /// assert_eq(vec.capacity(), 3);
    /// ```
    pub fn shrink_to(&mut self, min_capacity: usize) {
        let n = if self.buf.len > min_capacity {
            self.buf.len
        } else {
            min_capacity
        };
        if n >= self.buf.cap {
            return;
        }
        if n == 0 {
            self.buf.ptr = crate::ptr::null_mut();
            self.buf.cap = 0;
            return;
        }
        let ptr = crate::rt::alloc_array::<T>(n);
        if self.buf.len > 0 {
            crate::rt::copy(self.buf.ptr as *const T, ptr, self.buf.len);
        }
        self.buf.ptr = ptr;
        self.buf.cap = n;
    }

    /// Retains only the elements for which `f` returns `true`, passing it a
    /// mutable reference to each.
    ///
    /// `f` is called once for each element, in order, and may change it; the
    /// kept elements keep their order.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::from([1, 2, 3, 4]);
    /// vec.retain_mut(|x| {
    ///     if *x <= 3 {
    ///         *x += 1;
    ///         true
    ///     } else {
    ///         false
    ///     }
    /// });
    /// assert_eq(vec, [2, 3, 4]);
    /// ```
    pub fn retain_mut(&mut self, f: fn(&mut T) -> bool) {
        let n = self.buf.len;
        let mut w = 0;
        let mut r = 0;
        while r < n {
            let keep = f(&mut self.as_mut_slice()[r]);
            if keep {
                if w != r {
                    unsafe {
                        self.buf.ptr.add(w).write(self.buf.ptr.add(r).read());
                    }
                }
                w += 1;
            }
            r += 1;
        }
        self.buf.len = w;
    }

    /// Removes consecutive elements for which `same_bucket` returns `true`,
    /// keeping the first of each run.
    ///
    /// `same_bucket(a, b)` is passed an element `a` and the last kept element
    /// `b` before it; if it returns `true`, `a` is removed. If the vector is
    /// sorted, this removes all duplicates.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::from(["foo", "bar", "Bar", "baz", "bar"]);
    /// vec.dedup_by(|a, b| a.eq_ignore_ascii_case(b));
    /// assert_eq(vec, ["foo", "bar", "baz", "bar"]);
    /// ```
    pub fn dedup_by(&mut self, same_bucket: fn(&mut T, &mut T) -> bool) {
        let n = self.buf.len;
        if n < 2 {
            return;
        }
        let mut w = 1;
        let mut r = 1;
        while r < n {
            let s = self.as_mut_slice();
            if !same_bucket(&mut s[r], &mut s[w - 1]) {
                if w != r {
                    unsafe {
                        self.buf.ptr.add(w).write(self.buf.ptr.add(r).read());
                    }
                }
                w += 1;
            }
            r += 1;
        }
        self.buf.len = w;
    }

    /// Resizes the vector in place so that its length is `new_len`, calling `f`
    /// for each new element.
    ///
    /// If `new_len` is greater than the length, the vector is extended with the
    /// values `f` returns, one call per element; otherwise it is truncated. To
    /// fill with copies of one value, use [`resize`](Vec::resize).
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::from([1, 2, 3]);
    /// vec.resize_with(5, Default::default);
    /// assert_eq(vec, [1, 2, 3, 0, 0]);
    ///
    /// let mut rows: Vec<Vec<i32>> = Vec::new();
    /// rows.resize_with(2, || Vec::new());
    /// rows[0].push(1);
    /// assert_eq(rows[1].len(), 0);
    /// ```
    pub fn resize_with(&mut self, new_len: usize, f: fn() -> T) {
        if new_len <= self.len() {
            self.truncate(new_len);
            return;
        }
        self.reserve(new_len - self.len());
        while self.len() < new_len {
            self.push(f());
        }
    }

    /// Removes and returns the last element if `predicate` returns `true` for
    /// it; returns `None` otherwise or if the vector is empty.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::from([1, 2, 3, 4]);
    /// let pred = |x: &mut i32| -> bool { *x % 2 == 0 };
    ///
    /// assert_eq(vec.pop_if(pred), Some(4));
    /// assert_eq(vec, [1, 2, 3]);
    /// assert_eq(vec.pop_if(pred), None);
    /// ```
    pub fn pop_if(&mut self, predicate: fn(&mut T) -> bool) -> Option<T> {
        let n = self.buf.len;
        if n == 0 {
            return None;
        }
        if predicate(&mut self.as_mut_slice()[n - 1]) {
            self.pop()
        } else {
            None
        }
    }
}

impl<T: Clone> Vec<T> {
    /// Appends clones of the elements in the range `src` of the vector to its
    /// end.
    ///
    /// # Panics
    ///
    /// Panics if the start of the range is greater than its end, or if its end
    /// is greater than the length of the vector.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut vec = Vec::from([0, 1, 2, 3, 4]);
    ///
    /// vec.extend_from_within(2..);
    /// assert_eq(vec, [0, 1, 2, 3, 4, 2, 3, 4]);
    ///
    /// vec.extend_from_within(..2);
    /// assert_eq(vec, [0, 1, 2, 3, 4, 2, 3, 4, 0, 1]);
    ///
    /// vec.extend_from_within(4..8);
    /// assert_eq(vec, [0, 1, 2, 3, 4, 2, 3, 4, 0, 1, 4, 2, 3, 4]);
    /// ```
    pub fn extend_from_within<R: crate::ops::RangeBounds<usize>>(&mut self, src: R) {
        let (start, end) = range_of(&src, self.len());
        self.reserve(end - start);
        let mut i = start;
        while i < end {
            let x = self.as_slice()[i].clone();
            self.push(x);
            i += 1;
        }
    }
}

impl<T: PartialOrd> PartialOrd for Vec<T> {
    fn partial_cmp(&self, other: &Vec<T>) -> Option<crate::cmp::Ordering> {
        crate::slice::partial_cmp_slices(self.as_slice(), other.as_slice())
    }
}

impl<T: Ord> Ord for Vec<T> {
    fn cmp(&self, other: &Vec<T>) -> crate::cmp::Ordering {
        crate::slice::cmp_slices(self.as_slice(), other.as_slice())
    }
}

impl<T, U> PartialEq<&[U]> for Vec<T>
where
    T: PartialEq<U>,
{
    fn eq(&self, other: &&[U]) -> bool {
        crate::slice::eq_slices(self.as_slice(), *other)
    }
}

impl<T: Clone> Extend<&T> for Vec<T> {
    fn extend<I: IntoIterator<Item = &T>>(&mut self, iter: I) {
        for x in iter {
            self.push(x.clone());
        }
    }
}

impl From<crate::string::String> for Vec<u8> {
    fn from(s: crate::string::String) -> Vec<u8> {
        s.into_bytes()
    }
}

impl From<&str> for Vec<u8> {
    fn from(s: &str) -> Vec<u8> {
        let mut v = Vec::new();
        v.extend_from_slice(s.as_bytes());
        v
    }
}

impl<T> AsMut<[T]> for Vec<T> {
    fn as_mut(&mut self) -> &mut [T] {
        self.as_mut_slice()
    }
}

impl<T> IntoIter<T> {
    /// Returns the elements not yet yielded, as a slice.
    ///
    /// # Examples
    ///
    /// ```
    /// let v = Vec::from(['a', 'b', 'c']);
    /// let mut it = v.into_iter();
    /// assert_eq(it.as_slice(), &['a', 'b', 'c'][..]);
    /// let _ = it.next().unwrap();
    /// assert_eq(it.as_slice(), &['b', 'c'][..]);
    /// ```
    pub fn as_slice(&self) -> &[T] {
        &self.v.as_slice()[self.i..self.end]
    }
}

impl<T> ExactSizeIterator for IntoIter<T> {}
impl<T> Clone for IntoIter<T> {
    fn clone(&self) -> IntoIter<T> {
        IntoIter {
            v: self.v,
            i: self.i,
            end: self.end,
        }
    }
}

// The address of an empty buffer (never read: its length is 0; below the
// heap, so the collector takes it for no pointer).
const DANGLING: usize = 8;
