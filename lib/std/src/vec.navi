//! A growable array. Vec has reference semantics: copying a Vec shares the
//! buffer; use clone() for an independent copy.

use crate::ops::{Deref, DerefMut, Index, IndexMut};
use crate::slice;

pub struct Vec<T> {
    buf: &mut RawVec<T>,
}

struct RawVec<T> {
    ptr: *mut T,
    len: usize,
    cap: usize,
}

impl<T> Vec<T> {
    pub fn new() -> Vec<T> { todo() }
    pub fn with_capacity(capacity: usize) -> Vec<T> { todo() }
    pub fn push(&mut self, value: T) { todo() }
    pub fn pop(&mut self) -> Option<T> { todo() }
    pub fn len(&self) -> usize { self.buf.len }
    pub fn is_empty(&self) -> bool { self.len() == 0 }
    pub fn capacity(&self) -> usize { self.buf.cap }
    pub fn clear(&mut self) { self.buf.len = 0; }
    pub fn insert(&mut self, index: usize, value: T) { todo() }
    pub fn remove(&mut self, index: usize) -> T { todo() }
    pub fn truncate(&mut self, len: usize) { todo() }
    pub fn as_slice(&self) -> &[T] { todo() }
    pub fn as_mut_slice(&mut self) -> &mut [T] { todo() }
    pub fn first(&self) -> Option<&T> { todo() }
    pub fn last(&self) -> Option<&T> { todo() }
    pub fn get(&self, index: usize) -> Option<&T> { todo() }
    pub fn iter(&self) -> slice::Iter<T> { todo() }
    pub fn iter_mut(&mut self) -> slice::IterMut<T> { todo() }
}

impl<T: Clone> Vec<T> {
    pub fn extend_from_slice(&mut self, other: &[T]) { todo() }
}

impl<T> Deref for Vec<T> {
    type Target = [T];
    fn deref(&self) -> &[T] { self.as_slice() }
}

impl<T> DerefMut for Vec<T> {
    fn deref_mut(&mut self) -> &mut [T] { self.as_mut_slice() }
}

impl<T> Index<usize> for Vec<T> {
    type Output = T;
    fn index(&self, index: usize) -> &T { todo() }
}

impl<T> IndexMut<usize> for Vec<T> {
    fn index_mut(&mut self, index: usize) -> &mut T { todo() }
}

impl<T: Clone> Clone for Vec<T> {
    fn clone(&self) -> Vec<T> { todo() }
}

impl<T> Default for Vec<T> {
    fn default() -> Vec<T> { Vec::new() }
}

impl<T: Clone> From<&[T]> for Vec<T> {
    fn from(s: &[T]) -> Vec<T> { let mut v = Vec::new(); v.extend_from_slice(s); v }
}

impl<T: crate::fmt::Debug> crate::fmt::Debug for Vec<T> {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result { todo() }
}

impl<T> IntoIterator for &Vec<T> {
    type Item = &T;
    type IntoIter = slice::Iter<T>;
    fn into_iter(self) -> slice::Iter<T> { self.iter() }
}

impl<T> IntoIterator for &mut Vec<T> {
    type Item = &mut T;
    type IntoIter = slice::IterMut<T>;
    fn into_iter(self) -> slice::IterMut<T> { self.iter_mut() }
}

impl<T> FromIterator<T> for Vec<T> {
    fn from_iter<I: IntoIterator<Item = T>>(iter: I) -> Vec<T> { todo() }
}

impl<T> Extend<T> for Vec<T> {
    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) { todo() }
}
