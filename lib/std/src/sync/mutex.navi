//! Mutual exclusion. Without Drop there is no guard: lock() and unlock()
//! are paired by hand (with defer), or with_lock runs a function holding
//! the lock (see spec/std-diff.md).

pub struct Mutex<T> {
    word: usize,
    // Guards waiters (the Gs sleeping until the lock is free).
    lk: usize,
    waiters: crate::rt::sched::WaitList,
    data: T,
}

impl<T> Mutex<T> {
    pub fn new(t: T) -> Mutex<T> { Mutex { word: 0, lk: 0, waiters: crate::rt::sched::new_wait_list(), data: t } }

    fn word(&self) -> *mut usize { &self.word as *const usize as *mut usize }
    fn lk(&self) -> *mut usize { &self.lk as *const usize as *mut usize }
    fn q(&self) -> *mut crate::rt::sched::WaitList {
        &self.waiters as *const crate::rt::sched::WaitList as *mut crate::rt::sched::WaitList
    }

    /// Waits until the lock is free and takes it; returns the data (until
    /// unlock).
    pub fn lock(&self) -> &mut T {
        crate::rt::sched::mutex_lock(self.word(), self.lk(), self.q());
        self.data_mut()
    }

    pub(crate) fn data_mut(&self) -> &mut T { unsafe { &mut *(&self.data as *const T as *mut T) } }

    /// Takes the lock if it is free.
    pub fn try_lock(&self) -> bool { crate::rt::sched::mutex_try_lock(self.word()) }

    pub fn unlock(&self) { crate::rt::sched::mutex_unlock(self.word(), self.lk(), self.q()); }

    /// Runs f on the data holding the lock.
    pub fn with_lock<R>(&self, f: fn(&mut T) -> R) -> R {
        self.lock();
        let p = &self.data as *const T as *mut T;
        let r = f(unsafe { &mut *p });
        self.unlock();
        r
    }

    pub fn get_mut(&mut self) -> &mut T { &mut self.data }

    pub fn into_inner(self) -> T { self.data }
}
