//! Synchronization primitives.
//!
//! This module has the types of Rust's `std::sync` for threads
//! ([`crate::thread`]) to share data and wait for one another:
//!
//! - [`mpmc`]: multi-producer, multi-consumer channels ([`mpmc::channel`],
//!   [`mpmc::sync_channel`]), which the `select` statement waits on.
//! - [`Mutex`]: mutual exclusion, one thread at a time.
//! - [`RwLock`]: many readers or one writer at a time.
//! - [`Condvar`]: waiting for a condition on the data a [`Mutex`] protects.
//! - [`Barrier`]: waiting until a number of threads have all reached a point.
//! - [`Once`], [`OnceLock`] and [`LazyLock`]: initialization run once.
//! - [`atomic`]: atomic integers, booleans and pointers.
//!
//! navi's threads are green threads, so waiting on any of these parks the
//! thread, not its OS thread. There are some differences from Rust's, since
//! navi has a garbage collector and no Drop:
//!
//! - Data is shared between threads through plain references `&T` (Rust's
//!   `Arc<T>`), which [`thread::spawn`](crate::thread::spawn) captures.
//! - Locks have no guards: [`Mutex::lock`] and [`Mutex::unlock`] are paired by
//!   hand (often with `defer`), or [`Mutex::with_lock`] runs a function holding
//!   the lock; the same for [`RwLock`]. There is no lock poisoning.
//! - Channels are closed explicitly, with [`mpmc::Sender::close`] (or
//!   [`mpmc::Receiver::close`]).
//!
//! # Examples
//!
//! ```
//! use std::{
//!     sync::{Mutex, mpmc::channel},
//!     thread,
//! };
//!
//! let results = &Mutex::new(Vec::new());
//! let (tx, rx) = channel();
//! let mut workers = Vec::new();
//! for _ in 0..4 {
//!     workers.push(thread::spawn(|| {
//!         for n in rx.iter() {
//!             let square = n * n;
//!             results.with_lock(|r| r.push(square));
//!         }
//!     }));
//! }
//! for n in 1..=5 {
//!     tx.send(n).unwrap();
//! }
//! tx.close();
//! for w in workers {
//!     w.join().unwrap();
//! }
//! let mut squares = results.with_lock(|r| r.clone());
//! squares.sort();
//! assert_eq(squares, Vec::from([1, 4, 9, 16, 25]));
//! ```

pub mod atomic;
pub mod mpmc;
mod mutex;
pub use mutex::Mutex;
mod prims;
pub use prims::{
    Barrier, BarrierWaitResult, Condvar, LazyLock, Once, OnceLock, RwLock, WaitTimeoutResult,
};
