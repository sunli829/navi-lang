//! Atomic integers. This version has AtomicUsize; the orderings are
//! accepted and every operation is sequentially consistent.

#[derive(Clone, Debug, PartialEq, Eq)]
pub enum Ordering {
    Relaxed,
    Release,
    Acquire,
    AcqRel,
    SeqCst,
}

pub struct AtomicUsize {
    v: usize,
}

impl AtomicUsize {
    pub fn new(v: usize) -> AtomicUsize { AtomicUsize { v } }

    fn word(&self) -> *mut usize { &self.v as *const usize as *mut usize }

    pub fn load(&self, order: Ordering) -> usize { crate::rt::sched::word_load(self.word()) }

    pub fn store(&self, v: usize, order: Ordering) { crate::rt::sched::word_store(self.word(), v); }

    /// Adds v; returns the previous value.
    pub fn fetch_add(&self, v: usize, order: Ordering) -> usize { crate::rt::sched::word_add(self.word(), v) }

    /// Stores new if the value is current: Ok(current), else Err(the value).
    pub fn compare_exchange(&self, current: usize, new: usize, success: Ordering, failure: Ordering) -> Result<usize, usize> {
        if crate::rt::sched::word_cas(self.word(), current, new) { Ok(current) } else { Err(self.load(failure)) }
    }

    pub fn get_mut(&mut self) -> &mut usize { &mut self.v }

    pub fn into_inner(self) -> usize { self.v }
}
