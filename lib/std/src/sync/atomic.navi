//! Atomic types, as Rust's `std::sync::atomic`.
//!
//! Atomic types provide primitive shared-memory communication between
//! threads, and are the building blocks of other concurrent types. This
//! module has atomic versions of `bool`, `i32`, `u32`, `i64`, `u64`, `isize`,
//! `usize` and raw pointers: [`AtomicBool`], [`AtomicI32`], [`AtomicU32`],
//! [`AtomicI64`], [`AtomicU64`], [`AtomicIsize`], [`AtomicUsize`] and
//! [`AtomicPtr`].
//!
//! Each method takes an [`Ordering`] which in Rust represents the strength of
//! the memory barrier for that operation. navi accepts the orderings for
//! compatibility, but every operation is sequentially consistent (as
//! `Ordering::SeqCst`), so any ordering is correct; [`fence`] does nothing.
//! There is no `Arc`: share an atomic between threads through a reference
//! (`&AtomicUsize`), or put it in a `static`. Unlike Rust's, the narrower
//! atomics take a whole word each.
//!
//! # Examples
//!
//! A simple spinlock:
//!
//! ```
//! use std::{
//!     sync::atomic::{AtomicUsize, Ordering},
//!     thread,
//! };
//!
//! let spinlock = &AtomicUsize::new(1);
//! let h = thread::spawn(|| {
//!     spinlock.store(0, Ordering::Release);
//! });
//! // Wait for the other thread to release the lock.
//! while spinlock.load(Ordering::Acquire) != 0 {
//!     thread::yield_now();
//! }
//! h.join().unwrap();
//! ```
//!
//! Keep a global count of live threads:
//!
//! ```
//! use std::sync::atomic::{AtomicUsize, Ordering};
//!
//! static GLOBAL_THREAD_COUNT: AtomicUsize = AtomicUsize::new(0);
//!
//! let old_thread_count = GLOBAL_THREAD_COUNT.fetch_add(1, Ordering::SeqCst);
//! println(`live threads: ${old_thread_count + 1}`);
//! ```

/// Atomic memory orderings.
///
/// In Rust, memory orderings specify the way atomic operations synchronize
/// memory. navi accepts them so that code reads as Rust's, but every atomic
/// operation is sequentially consistent whatever the ordering: a stronger
/// guarantee than any of them asks for.
///
/// # Examples
///
/// ```
/// use std::sync::atomic::{AtomicBool, Ordering};
///
/// let flag = AtomicBool::new(false);
/// flag.store(true, Ordering::Release);
/// assert(flag.load(Ordering::Acquire));
/// assert_ne(Ordering::Relaxed, Ordering::SeqCst);
/// ```
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum Ordering {
    /// No ordering constraints, only atomic operations (in navi, as
    /// [`SeqCst`](Ordering::SeqCst)).
    Relaxed,
    /// For stores: all previous operations become ordered before any load of
    /// this value with [`Acquire`](Ordering::Acquire) (or stronger) ordering
    /// (in navi, as [`SeqCst`](Ordering::SeqCst)).
    Release,
    /// For loads: if the loaded value was written by a store with
    /// [`Release`](Ordering::Release) (or stronger) ordering, all subsequent
    /// operations become ordered after that store (in navi, as
    /// [`SeqCst`](Ordering::SeqCst)).
    Acquire,
    /// Has the effects of both [`Acquire`](Ordering::Acquire) and
    /// [`Release`](Ordering::Release) together: acquire for loads, release for
    /// stores (in navi, as [`SeqCst`](Ordering::SeqCst)).
    AcqRel,
    /// Like [`Acquire`](Ordering::Acquire)/[`Release`](Ordering::Release)/
    /// [`AcqRel`](Ordering::AcqRel), with the additional guarantee that all
    /// threads see all sequentially consistent operations in the same order.
    /// Every navi atomic operation behaves this way.
    SeqCst,
}

/// An integer type which can be safely shared between threads.
///
/// This type has the same in-memory representation as the underlying integer
/// type, [`usize`], widened to a word. Share it between threads through a
/// reference (`&AtomicUsize`) or a `static`; every operation is sequentially
/// consistent (see the [module documentation](self)).
///
/// # Examples
///
/// ```
/// use std::{
///     sync::atomic::{AtomicUsize, Ordering},
///     thread,
/// };
///
/// let counter = &AtomicUsize::new(0);
/// let mut handles = Vec::new();
/// for _ in 0..4 {
///     handles.push(thread::spawn(|| {
///         for _ in 0..100 {
///             counter.fetch_add(1, Ordering::Relaxed);
///         }
///     }));
/// }
/// for h in handles {
///     h.join().unwrap();
/// }
/// assert_eq(counter.load(Ordering::SeqCst), 400);
/// ```
pub struct AtomicUsize {
    v: usize,
}

impl AtomicUsize {
    /// Creates a new atomic integer.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicUsize, Ordering};
    ///
    /// let atomic_forty_two = AtomicUsize::new(42);
    /// assert_eq(atomic_forty_two.load(Ordering::Relaxed), 42);
    /// ```
    #[inline]
    pub fn new(v: usize) -> AtomicUsize {
        AtomicUsize { v }
    }

    fn word(&self) -> *mut usize {
        &self.v as *const usize as *mut usize
    }

    /// Loads a value from the atomic integer.
    ///
    /// `order` is accepted for compatibility with Rust; the load is
    /// sequentially consistent.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicUsize, Ordering};
    ///
    /// let some_var = AtomicUsize::new(5);
    /// assert_eq(some_var.load(Ordering::Relaxed), 5);
    /// ```
    #[inline]
    pub fn load(&self, order: Ordering) -> usize {
        crate::rt::sched::word_load(self.word())
    }

    /// Stores a value into the atomic integer.
    ///
    /// `order` is accepted for compatibility with Rust; the store is
    /// sequentially consistent.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicUsize, Ordering};
    ///
    /// let some_var = AtomicUsize::new(5);
    /// some_var.store(10, Ordering::Relaxed);
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    /// ```
    #[inline]
    pub fn store(&self, v: usize, order: Ordering) {
        crate::rt::sched::word_store(self.word(), v);
    }

    /// Adds to the current value, returning the previous value.
    ///
    /// This operation wraps around on overflow (it does not panic).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicUsize, Ordering};
    ///
    /// let foo = AtomicUsize::new(0);
    /// assert_eq(foo.fetch_add(10, Ordering::SeqCst), 0);
    /// assert_eq(foo.load(Ordering::SeqCst), 10);
    ///
    /// let max = AtomicUsize::new(usize::MAX);
    /// max.fetch_add(1, Ordering::SeqCst);
    /// assert_eq(max.load(Ordering::SeqCst), usize::MIN);
    /// ```
    #[inline]
    pub fn fetch_add(&self, v: usize, order: Ordering) -> usize {
        crate::rt::sched::word_add(self.word(), v)
    }

    /// Stores a value into the atomic integer if the current value is the same
    /// as the `current` value.
    ///
    /// The return value is a result indicating whether the new value was
    /// written and containing the previous value. On success this value is
    /// guaranteed to be equal to `current`. The orderings are accepted for
    /// compatibility with Rust.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicUsize, Ordering};
    ///
    /// let some_var = AtomicUsize::new(5);
    ///
    /// assert_eq(
    ///     some_var.compare_exchange(5, 10, Ordering::Acquire, Ordering::Relaxed),
    ///     Ok(5),
    /// );
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    ///
    /// assert_eq(
    ///     some_var.compare_exchange(6, 12, Ordering::SeqCst, Ordering::Acquire),
    ///     Err(10),
    /// );
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    /// ```
    pub fn compare_exchange(
        &self,
        current: usize,
        new: usize,
        success: Ordering,
        failure: Ordering,
    ) -> Result<usize, usize> {
        if crate::rt::sched::word_cas(self.word(), current, new) {
            Ok(current)
        } else {
            Err(self.load(failure))
        }
    }

    /// Returns a mutable reference to the underlying integer.
    ///
    /// This is safe because the mutable reference guarantees that no other
    /// threads are concurrently accessing the atomic data (through this path).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicUsize, Ordering};
    ///
    /// let mut some_var = AtomicUsize::new(10);
    /// assert_eq(*some_var.get_mut(), 10);
    /// *some_var.get_mut() = 5;
    /// assert_eq(some_var.load(Ordering::SeqCst), 5);
    /// ```
    #[inline]
    pub fn get_mut(&mut self) -> &mut usize {
        &mut self.v
    }

    /// Consumes the atomic and returns the contained value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::AtomicUsize;
    ///
    /// let some_var = AtomicUsize::new(5);
    /// assert_eq(some_var.into_inner(), 5);
    /// ```
    #[inline]
    pub fn into_inner(self) -> usize {
        self.v
    }
}

// --- More atomics (navi) -----------------------------------------------------
//
// Every atomic is one word (narrower values in its low bits, the rest 0),
// so that the runtime's word operations serve them all.

/// A boolean type which can be safely shared between threads.
///
/// Share it between threads through a reference (`&AtomicBool`) or a
/// `static`; every operation is sequentially consistent (see the [module
/// documentation](self)). It takes a word.
///
/// # Examples
///
/// ```
/// use std::{
///     sync::atomic::{AtomicBool, Ordering},
///     thread,
/// };
///
/// let ready = &AtomicBool::new(false);
/// let h = thread::spawn(|| ready.store(true, Ordering::Release));
/// h.join().unwrap();
/// assert(ready.load(Ordering::Acquire));
/// ```
pub struct AtomicBool {
    v: usize,
}

impl AtomicBool {
    /// Creates a new `AtomicBool`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicBool, Ordering};
    ///
    /// let atomic_true = AtomicBool::new(true);
    /// let atomic_false = AtomicBool::new(false);
    /// assert(atomic_true.load(Ordering::Relaxed));
    /// assert(!atomic_false.load(Ordering::Relaxed));
    /// ```
    #[inline]
    pub fn new(v: bool) -> AtomicBool {
        AtomicBool {
            v: (if (v) { 1 } else { 0 }),
        }
    }

    fn word(&self) -> *mut usize {
        &self.v as *const usize as *mut usize
    }

    /// Loads a value from the bool.
    ///
    /// `order` is accepted for compatibility with Rust; the load is
    /// sequentially consistent.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicBool, Ordering};
    ///
    /// let some_bool = AtomicBool::new(true);
    /// assert_eq(some_bool.load(Ordering::Relaxed), true);
    /// ```
    #[inline]
    pub fn load(&self, order: Ordering) -> bool {
        ((crate::rt::sched::word_load(self.word())) != 0)
    }

    /// Stores a value into the bool.
    ///
    /// `order` is accepted for compatibility with Rust; the store is
    /// sequentially consistent.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicBool, Ordering};
    ///
    /// let some_bool = AtomicBool::new(true);
    /// some_bool.store(false, Ordering::Relaxed);
    /// assert_eq(some_bool.load(Ordering::Relaxed), false);
    /// ```
    #[inline]
    pub fn store(&self, v: bool, order: Ordering) {
        crate::rt::sched::word_store(self.word(), (if (v) { 1 } else { 0 }));
    }

    /// Stores a value into the bool, returning the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicBool, Ordering};
    ///
    /// let some_bool = AtomicBool::new(true);
    /// assert_eq(some_bool.swap(false, Ordering::Relaxed), true);
    /// assert_eq(some_bool.load(Ordering::Relaxed), false);
    /// ```
    pub fn swap(&self, v: bool, order: Ordering) -> bool {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            if crate::rt::sched::word_cas(self.word(), w, (if (v) { 1 } else { 0 })) {
                return ((w) != 0);
            }
        }
    }

    /// Stores a value into the `bool` if the current value is the same as the
    /// `current` value.
    ///
    /// The return value is a result indicating whether the new value was
    /// written and containing the previous value. On success this value is
    /// guaranteed to be equal to `current`. The orderings are accepted for
    /// compatibility with Rust.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicBool, Ordering};
    ///
    /// let some_bool = AtomicBool::new(true);
    ///
    /// assert_eq(
    ///     some_bool.compare_exchange(true, false, Ordering::Acquire, Ordering::Relaxed),
    ///     Ok(true),
    /// );
    /// assert_eq(some_bool.load(Ordering::Relaxed), false);
    ///
    /// assert_eq(
    ///     some_bool.compare_exchange(true, true, Ordering::SeqCst, Ordering::Acquire),
    ///     Err(false),
    /// );
    /// assert_eq(some_bool.load(Ordering::Relaxed), false);
    /// ```
    pub fn compare_exchange(
        &self,
        current: bool,
        new: bool,
        success: Ordering,
        failure: Ordering,
    ) -> Result<bool, bool> {
        loop {
            if crate::rt::sched::word_cas(
                self.word(),
                (if (current) { 1 } else { 0 }),
                (if (new) { 1 } else { 0 }),
            ) {
                return Ok(current);
            }
            let w = crate::rt::sched::word_load(self.word());
            if w != (if (current) { 1 } else { 0 }) {
                return Err(((w) != 0));
            }
        }
    }

    /// Stores a value into the `bool` if the current value is the same as the
    /// `current` value.
    ///
    /// In Rust this function is allowed to spuriously fail even when the
    /// comparison succeeds; navi's never does: it is the same as
    /// [`compare_exchange`](AtomicBool::compare_exchange).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicBool, Ordering};
    ///
    /// let val = AtomicBool::new(false);
    /// let new = true;
    /// let mut old = val.load(Ordering::Relaxed);
    /// loop {
    ///     match val.compare_exchange_weak(old, new, Ordering::SeqCst, Ordering::Relaxed) {
    ///         Ok(_) => break,
    ///         Err(x) => old = x,
    ///     }
    /// }
    /// assert(val.load(Ordering::Relaxed));
    /// ```
    pub fn compare_exchange_weak(
        &self,
        current: bool,
        new: bool,
        success: Ordering,
        failure: Ordering,
    ) -> Result<bool, bool> {
        self.compare_exchange(current, new, success, failure)
    }

    /// Fetches the value, and applies a function to it that returns an optional
    /// new value. Returns a `Result` of `Ok(previous_value)` if the function
    /// returned `Some(_)`, else `Err(previous_value)`.
    ///
    /// The function may be called multiple times if the value has been changed
    /// from other threads in the meantime, as long as the function returns
    /// `Some(_)`, but the function will have been applied only once to the
    /// stored value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicBool, Ordering};
    ///
    /// let x = AtomicBool::new(false);
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |_| None),
    ///     Err(false),
    /// );
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |x| Some(!x)),
    ///     Ok(false),
    /// );
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |x| Some(!x)),
    ///     Ok(true),
    /// );
    /// assert_eq(x.load(Ordering::SeqCst), false);
    /// ```
    pub fn fetch_update(
        &self,
        set_order: Ordering,
        fetch_order: Ordering,
        f: fn(bool) -> Option<bool>,
    ) -> Result<bool, bool> {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) != 0);
            match f(old) {
                Some(n) => {
                    if crate::rt::sched::word_cas(self.word(), w, (if (n) { 1 } else { 0 })) {
                        return Ok(old);
                    }
                }
                None => return Err(old),
            }
        }
    }

    /// Logical "and" with a boolean value.
    ///
    /// Performs a logical "and" operation on the current value and the argument
    /// `v`, and sets the new value to the result. Returns the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicBool, Ordering};
    ///
    /// let foo = AtomicBool::new(true);
    /// assert_eq(foo.fetch_and(false, Ordering::SeqCst), true);
    /// assert_eq(foo.load(Ordering::SeqCst), false);
    ///
    /// let foo = AtomicBool::new(true);
    /// assert_eq(foo.fetch_and(true, Ordering::SeqCst), true);
    /// assert_eq(foo.load(Ordering::SeqCst), true);
    ///
    /// let foo = AtomicBool::new(false);
    /// assert_eq(foo.fetch_and(false, Ordering::SeqCst), false);
    /// assert_eq(foo.load(Ordering::SeqCst), false);
    /// ```
    pub fn fetch_and(&self, v: bool, order: Ordering) -> bool {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) != 0);
            let n: bool = old && v;
            if crate::rt::sched::word_cas(self.word(), w, (if (n) { 1 } else { 0 })) {
                return old;
            }
        }
    }

    /// Logical "or" with a boolean value.
    ///
    /// Performs a logical "or" operation on the current value and the argument
    /// `v`, and sets the new value to the result. Returns the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicBool, Ordering};
    ///
    /// let foo = AtomicBool::new(true);
    /// assert_eq(foo.fetch_or(false, Ordering::SeqCst), true);
    /// assert_eq(foo.load(Ordering::SeqCst), true);
    ///
    /// let foo = AtomicBool::new(false);
    /// assert_eq(foo.fetch_or(false, Ordering::SeqCst), false);
    /// assert_eq(foo.load(Ordering::SeqCst), false);
    ///
    /// let foo = AtomicBool::new(false);
    /// assert_eq(foo.fetch_or(true, Ordering::SeqCst), false);
    /// assert_eq(foo.load(Ordering::SeqCst), true);
    /// ```
    pub fn fetch_or(&self, v: bool, order: Ordering) -> bool {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) != 0);
            let n: bool = old || v;
            if crate::rt::sched::word_cas(self.word(), w, (if (n) { 1 } else { 0 })) {
                return old;
            }
        }
    }

    /// Logical "xor" with a boolean value.
    ///
    /// Performs a logical "xor" operation on the current value and the argument
    /// `v`, and sets the new value to the result. Returns the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicBool, Ordering};
    ///
    /// let foo = AtomicBool::new(true);
    /// assert_eq(foo.fetch_xor(false, Ordering::SeqCst), true);
    /// assert_eq(foo.load(Ordering::SeqCst), true);
    ///
    /// let foo = AtomicBool::new(true);
    /// assert_eq(foo.fetch_xor(true, Ordering::SeqCst), true);
    /// assert_eq(foo.load(Ordering::SeqCst), false);
    ///
    /// let foo = AtomicBool::new(false);
    /// assert_eq(foo.fetch_xor(false, Ordering::SeqCst), false);
    /// assert_eq(foo.load(Ordering::SeqCst), false);
    /// ```
    pub fn fetch_xor(&self, v: bool, order: Ordering) -> bool {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) != 0);
            let n: bool = old != v;
            if crate::rt::sched::word_cas(self.word(), w, (if (n) { 1 } else { 0 })) {
                return old;
            }
        }
    }

    /// Logical "nand" with a boolean value.
    ///
    /// Performs a logical "nand" operation on the current value and the
    /// argument `v`, and sets the new value to the result. Returns the previous
    /// value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicBool, Ordering};
    ///
    /// let foo = AtomicBool::new(true);
    /// assert_eq(foo.fetch_nand(false, Ordering::SeqCst), true);
    /// assert_eq(foo.load(Ordering::SeqCst), true);
    ///
    /// let foo = AtomicBool::new(true);
    /// assert_eq(foo.fetch_nand(true, Ordering::SeqCst), true);
    /// assert_eq(foo.load(Ordering::SeqCst), false);
    ///
    /// let foo = AtomicBool::new(false);
    /// assert_eq(foo.fetch_nand(false, Ordering::SeqCst), false);
    /// assert_eq(foo.load(Ordering::SeqCst), true);
    /// ```
    pub fn fetch_nand(&self, v: bool, order: Ordering) -> bool {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) != 0);
            let n: bool = !(old && v);
            if crate::rt::sched::word_cas(self.word(), w, (if (n) { 1 } else { 0 })) {
                return old;
            }
        }
    }

    /// Returns a mutable reference to the underlying [`bool`].
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicBool, Ordering};
    ///
    /// let mut some_bool = AtomicBool::new(true);
    /// assert_eq(*some_bool.get_mut(), true);
    /// *some_bool.get_mut() = false;
    /// assert_eq(some_bool.load(Ordering::SeqCst), false);
    /// ```
    #[inline]
    pub fn get_mut(&mut self) -> &mut bool {
        unsafe { &mut *(&mut self.v as *mut usize as *mut bool) }
    }

    /// Consumes the atomic and returns the contained value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::AtomicBool;
    ///
    /// let some_bool = AtomicBool::new(true);
    /// assert_eq(some_bool.into_inner(), true);
    /// ```
    #[inline]
    pub fn into_inner(self) -> bool {
        ((self.v) != 0)
    }
}

impl crate::fmt::Debug for AtomicBool {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        crate::fmt::Debug::fmt(&self.load(Ordering::SeqCst), f)
    }
}

impl Default for AtomicBool {
    fn default() -> AtomicBool {
        AtomicBool::new(false)
    }
}

/// An integer type which can be safely shared between threads.
///
/// This type has the same in-memory representation as the underlying integer
/// type, [`i32`], widened to a word. Share it between threads through a
/// reference (`&AtomicI32`) or a `static`; every operation is sequentially
/// consistent (see the [module documentation](self)).
///
/// # Examples
///
/// ```
/// use std::{
///     sync::atomic::{AtomicI32, Ordering},
///     thread,
/// };
///
/// let counter = &AtomicI32::new(0);
/// let mut handles = Vec::new();
/// for _ in 0..4 {
///     handles.push(thread::spawn(|| {
///         for _ in 0..100 {
///             counter.fetch_add(1, Ordering::Relaxed);
///         }
///     }));
/// }
/// for h in handles {
///     h.join().unwrap();
/// }
/// assert_eq(counter.load(Ordering::SeqCst), 400);
/// ```
pub struct AtomicI32 {
    v: usize,
}

impl AtomicI32 {
    /// Creates a new atomic integer.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI32, Ordering};
    ///
    /// let atomic_forty_two = AtomicI32::new(42);
    /// assert_eq(atomic_forty_two.load(Ordering::Relaxed), 42);
    /// ```
    #[inline]
    pub fn new(v: i32) -> AtomicI32 {
        AtomicI32 {
            v: ((v) as u32 as usize),
        }
    }

    fn word(&self) -> *mut usize {
        &self.v as *const usize as *mut usize
    }

    /// Loads a value from the atomic integer.
    ///
    /// `order` is accepted for compatibility with Rust; the load is
    /// sequentially consistent.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI32, Ordering};
    ///
    /// let some_var = AtomicI32::new(5);
    /// assert_eq(some_var.load(Ordering::Relaxed), 5);
    /// ```
    #[inline]
    pub fn load(&self, order: Ordering) -> i32 {
        ((crate::rt::sched::word_load(self.word())) as u32 as i32)
    }

    /// Stores a value into the atomic integer.
    ///
    /// `order` is accepted for compatibility with Rust; the store is
    /// sequentially consistent.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI32, Ordering};
    ///
    /// let some_var = AtomicI32::new(5);
    /// some_var.store(10, Ordering::Relaxed);
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    /// ```
    #[inline]
    pub fn store(&self, v: i32, order: Ordering) {
        crate::rt::sched::word_store(self.word(), ((v) as u32 as usize));
    }

    /// Stores a value into the atomic integer, returning the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI32, Ordering};
    ///
    /// let some_var = AtomicI32::new(5);
    /// assert_eq(some_var.swap(10, Ordering::Relaxed), 5);
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    /// ```
    pub fn swap(&self, v: i32, order: Ordering) -> i32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            if crate::rt::sched::word_cas(self.word(), w, ((v) as u32 as usize)) {
                return ((w) as u32 as i32);
            }
        }
    }

    /// Stores a value into the atomic integer if the current value is the same
    /// as the `current` value.
    ///
    /// The return value is a result indicating whether the new value was
    /// written and containing the previous value. On success this value is
    /// guaranteed to be equal to `current`. The orderings are accepted for
    /// compatibility with Rust.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI32, Ordering};
    ///
    /// let some_var = AtomicI32::new(5);
    ///
    /// assert_eq(
    ///     some_var.compare_exchange(5, 10, Ordering::Acquire, Ordering::Relaxed),
    ///     Ok(5),
    /// );
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    ///
    /// assert_eq(
    ///     some_var.compare_exchange(6, 12, Ordering::SeqCst, Ordering::Acquire),
    ///     Err(10),
    /// );
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    /// ```
    pub fn compare_exchange(
        &self,
        current: i32,
        new: i32,
        success: Ordering,
        failure: Ordering,
    ) -> Result<i32, i32> {
        loop {
            if crate::rt::sched::word_cas(
                self.word(),
                ((current) as u32 as usize),
                ((new) as u32 as usize),
            ) {
                return Ok(current);
            }
            let w = crate::rt::sched::word_load(self.word());
            if w != ((current) as u32 as usize) {
                return Err(((w) as u32 as i32));
            }
        }
    }

    /// Stores a value into the atomic integer if the current value is the same
    /// as the `current` value.
    ///
    /// In Rust this function is allowed to spuriously fail even when the
    /// comparison succeeds; navi's never does: it is the same as
    /// [`compare_exchange`](AtomicI32::compare_exchange).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI32, Ordering};
    ///
    /// let val = AtomicI32::new(4);
    ///
    /// let mut old = val.load(Ordering::Relaxed);
    /// loop {
    ///     let new = old * 2;
    ///     match val.compare_exchange_weak(old, new, Ordering::SeqCst, Ordering::Relaxed) {
    ///         Ok(_) => break,
    ///         Err(x) => old = x,
    ///     }
    /// }
    /// assert_eq(val.load(Ordering::Relaxed), 8);
    /// ```
    pub fn compare_exchange_weak(
        &self,
        current: i32,
        new: i32,
        success: Ordering,
        failure: Ordering,
    ) -> Result<i32, i32> {
        self.compare_exchange(current, new, success, failure)
    }

    /// Fetches the value, and applies a function to it that returns an optional
    /// new value. Returns a `Result` of `Ok(previous_value)` if the function
    /// returned `Some(_)`, else `Err(previous_value)`.
    ///
    /// The function may be called multiple times if the value has been changed
    /// from other threads in the meantime, as long as the function returns
    /// `Some(_)`, but the function will have been applied only once to the
    /// stored value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI32, Ordering};
    ///
    /// let x = AtomicI32::new(7);
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |_| None),
    ///     Err(7),
    /// );
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |x| Some(x + 1)),
    ///     Ok(7),
    /// );
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |x| Some(x + 1)),
    ///     Ok(8),
    /// );
    /// assert_eq(x.load(Ordering::SeqCst), 9);
    /// ```
    pub fn fetch_update(
        &self,
        set_order: Ordering,
        fetch_order: Ordering,
        f: fn(i32) -> Option<i32>,
    ) -> Result<i32, i32> {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32 as i32);
            match f(old) {
                Some(n) => {
                    if crate::rt::sched::word_cas(self.word(), w, ((n) as u32 as usize)) {
                        return Ok(old);
                    }
                }
                None => return Err(old),
            }
        }
    }

    /// Adds to the current value, returning the previous value.
    ///
    /// This operation wraps around on overflow (it does not panic).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI32, Ordering};
    ///
    /// let foo = AtomicI32::new(0);
    /// assert_eq(foo.fetch_add(10, Ordering::SeqCst), 0);
    /// assert_eq(foo.load(Ordering::SeqCst), 10);
    ///
    /// let max = AtomicI32::new(i32::MAX);
    /// max.fetch_add(1, Ordering::SeqCst);
    /// assert_eq(max.load(Ordering::SeqCst), i32::MIN);
    /// ```
    pub fn fetch_add(&self, v: i32, order: Ordering) -> i32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32 as i32);
            let n: i32 = old.wrapping_add(v);
            if crate::rt::sched::word_cas(self.word(), w, ((n) as u32 as usize)) {
                return old;
            }
        }
    }

    /// Subtracts from the current value, returning the previous value.
    ///
    /// This operation wraps around on overflow (it does not panic).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI32, Ordering};
    ///
    /// let foo = AtomicI32::new(20);
    /// assert_eq(foo.fetch_sub(10, Ordering::SeqCst), 20);
    /// assert_eq(foo.load(Ordering::SeqCst), 10);
    ///
    /// let min = AtomicI32::new(i32::MIN);
    /// min.fetch_sub(1, Ordering::SeqCst);
    /// assert_eq(min.load(Ordering::SeqCst), i32::MAX);
    /// ```
    pub fn fetch_sub(&self, v: i32, order: Ordering) -> i32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32 as i32);
            let n: i32 = old.wrapping_sub(v);
            if crate::rt::sched::word_cas(self.word(), w, ((n) as u32 as usize)) {
                return old;
            }
        }
    }

    /// Bitwise "and" with the current value, returning the previous value.
    ///
    /// Performs a bitwise "and" operation on the current value and the argument
    /// `v`, and sets the new value to the result.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI32, Ordering};
    ///
    /// let foo = AtomicI32::new(0b101101);
    /// assert_eq(foo.fetch_and(0b110011, Ordering::SeqCst), 0b101101);
    /// assert_eq(foo.load(Ordering::SeqCst), 0b100001);
    /// ```
    pub fn fetch_and(&self, v: i32, order: Ordering) -> i32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32 as i32);
            let n: i32 = old & v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as u32 as usize)) {
                return old;
            }
        }
    }

    /// Bitwise "or" with the current value, returning the previous value.
    ///
    /// Performs a bitwise "or" operation on the current value and the argument
    /// `v`, and sets the new value to the result.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI32, Ordering};
    ///
    /// let foo = AtomicI32::new(0b101101);
    /// assert_eq(foo.fetch_or(0b110011, Ordering::SeqCst), 0b101101);
    /// assert_eq(foo.load(Ordering::SeqCst), 0b111111);
    /// ```
    pub fn fetch_or(&self, v: i32, order: Ordering) -> i32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32 as i32);
            let n: i32 = old | v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as u32 as usize)) {
                return old;
            }
        }
    }

    /// Bitwise "xor" with the current value, returning the previous value.
    ///
    /// Performs a bitwise "xor" operation on the current value and the argument
    /// `v`, and sets the new value to the result.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI32, Ordering};
    ///
    /// let foo = AtomicI32::new(0b101101);
    /// assert_eq(foo.fetch_xor(0b110011, Ordering::SeqCst), 0b101101);
    /// assert_eq(foo.load(Ordering::SeqCst), 0b011110);
    /// ```
    pub fn fetch_xor(&self, v: i32, order: Ordering) -> i32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32 as i32);
            let n: i32 = old ^ v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as u32 as usize)) {
                return old;
            }
        }
    }

    /// Maximum with the current value.
    ///
    /// Finds the maximum of the current value and the argument `v`, and sets
    /// the new value to the result. Returns the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI32, Ordering};
    ///
    /// let foo = AtomicI32::new(23);
    /// assert_eq(foo.fetch_max(42, Ordering::SeqCst), 23);
    /// assert_eq(foo.load(Ordering::SeqCst), 42);
    /// assert_eq(foo.fetch_max(7, Ordering::SeqCst), 42);
    /// assert_eq(foo.load(Ordering::SeqCst), 42);
    /// ```
    pub fn fetch_max(&self, v: i32, order: Ordering) -> i32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32 as i32);
            let n: i32 = if v > old { v } else { old };
            if crate::rt::sched::word_cas(self.word(), w, ((n) as u32 as usize)) {
                return old;
            }
        }
    }

    /// Minimum with the current value.
    ///
    /// Finds the minimum of the current value and the argument `v`, and sets
    /// the new value to the result. Returns the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI32, Ordering};
    ///
    /// let foo = AtomicI32::new(23);
    /// assert_eq(foo.fetch_min(42, Ordering::Relaxed), 23);
    /// assert_eq(foo.load(Ordering::Relaxed), 23);
    /// assert_eq(foo.fetch_min(22, Ordering::Relaxed), 23);
    /// assert_eq(foo.load(Ordering::Relaxed), 22);
    /// ```
    pub fn fetch_min(&self, v: i32, order: Ordering) -> i32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32 as i32);
            let n: i32 = if v < old { v } else { old };
            if crate::rt::sched::word_cas(self.word(), w, ((n) as u32 as usize)) {
                return old;
            }
        }
    }

    /// Returns a mutable reference to the underlying integer.
    ///
    /// This is safe because the mutable reference guarantees that no other
    /// threads are concurrently accessing the atomic data (through this path).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI32, Ordering};
    ///
    /// let mut some_var = AtomicI32::new(10);
    /// assert_eq(*some_var.get_mut(), 10);
    /// *some_var.get_mut() = 5;
    /// assert_eq(some_var.load(Ordering::SeqCst), 5);
    /// ```
    #[inline]
    pub fn get_mut(&mut self) -> &mut i32 {
        unsafe { &mut *(&mut self.v as *mut usize as *mut i32) }
    }

    /// Consumes the atomic and returns the contained value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::AtomicI32;
    ///
    /// let some_var = AtomicI32::new(5);
    /// assert_eq(some_var.into_inner(), 5);
    /// ```
    #[inline]
    pub fn into_inner(self) -> i32 {
        ((self.v) as u32 as i32)
    }
}

impl crate::fmt::Debug for AtomicI32 {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        crate::fmt::Debug::fmt(&self.load(Ordering::SeqCst), f)
    }
}

impl Default for AtomicI32 {
    fn default() -> AtomicI32 {
        AtomicI32::new(0)
    }
}

/// An integer type which can be safely shared between threads.
///
/// This type has the same in-memory representation as the underlying integer
/// type, [`u32`], widened to a word. Share it between threads through a
/// reference (`&AtomicU32`) or a `static`; every operation is sequentially
/// consistent (see the [module documentation](self)).
///
/// # Examples
///
/// ```
/// use std::{
///     sync::atomic::{AtomicU32, Ordering},
///     thread,
/// };
///
/// let counter = &AtomicU32::new(0);
/// let mut handles = Vec::new();
/// for _ in 0..4 {
///     handles.push(thread::spawn(|| {
///         for _ in 0..100 {
///             counter.fetch_add(1, Ordering::Relaxed);
///         }
///     }));
/// }
/// for h in handles {
///     h.join().unwrap();
/// }
/// assert_eq(counter.load(Ordering::SeqCst), 400);
/// ```
pub struct AtomicU32 {
    v: usize,
}

impl AtomicU32 {
    /// Creates a new atomic integer.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU32, Ordering};
    ///
    /// let atomic_forty_two = AtomicU32::new(42);
    /// assert_eq(atomic_forty_two.load(Ordering::Relaxed), 42);
    /// ```
    #[inline]
    pub fn new(v: u32) -> AtomicU32 {
        AtomicU32 { v: ((v) as usize) }
    }

    fn word(&self) -> *mut usize {
        &self.v as *const usize as *mut usize
    }

    /// Loads a value from the atomic integer.
    ///
    /// `order` is accepted for compatibility with Rust; the load is
    /// sequentially consistent.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU32, Ordering};
    ///
    /// let some_var = AtomicU32::new(5);
    /// assert_eq(some_var.load(Ordering::Relaxed), 5);
    /// ```
    #[inline]
    pub fn load(&self, order: Ordering) -> u32 {
        ((crate::rt::sched::word_load(self.word())) as u32)
    }

    /// Stores a value into the atomic integer.
    ///
    /// `order` is accepted for compatibility with Rust; the store is
    /// sequentially consistent.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU32, Ordering};
    ///
    /// let some_var = AtomicU32::new(5);
    /// some_var.store(10, Ordering::Relaxed);
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    /// ```
    #[inline]
    pub fn store(&self, v: u32, order: Ordering) {
        crate::rt::sched::word_store(self.word(), ((v) as usize));
    }

    /// Stores a value into the atomic integer, returning the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU32, Ordering};
    ///
    /// let some_var = AtomicU32::new(5);
    /// assert_eq(some_var.swap(10, Ordering::Relaxed), 5);
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    /// ```
    pub fn swap(&self, v: u32, order: Ordering) -> u32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            if crate::rt::sched::word_cas(self.word(), w, ((v) as usize)) {
                return ((w) as u32);
            }
        }
    }

    /// Stores a value into the atomic integer if the current value is the same
    /// as the `current` value.
    ///
    /// The return value is a result indicating whether the new value was
    /// written and containing the previous value. On success this value is
    /// guaranteed to be equal to `current`. The orderings are accepted for
    /// compatibility with Rust.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU32, Ordering};
    ///
    /// let some_var = AtomicU32::new(5);
    ///
    /// assert_eq(
    ///     some_var.compare_exchange(5, 10, Ordering::Acquire, Ordering::Relaxed),
    ///     Ok(5),
    /// );
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    ///
    /// assert_eq(
    ///     some_var.compare_exchange(6, 12, Ordering::SeqCst, Ordering::Acquire),
    ///     Err(10),
    /// );
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    /// ```
    pub fn compare_exchange(
        &self,
        current: u32,
        new: u32,
        success: Ordering,
        failure: Ordering,
    ) -> Result<u32, u32> {
        loop {
            if crate::rt::sched::word_cas(self.word(), ((current) as usize), ((new) as usize)) {
                return Ok(current);
            }
            let w = crate::rt::sched::word_load(self.word());
            if w != ((current) as usize) {
                return Err(((w) as u32));
            }
        }
    }

    /// Stores a value into the atomic integer if the current value is the same
    /// as the `current` value.
    ///
    /// In Rust this function is allowed to spuriously fail even when the
    /// comparison succeeds; navi's never does: it is the same as
    /// [`compare_exchange`](AtomicU32::compare_exchange).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU32, Ordering};
    ///
    /// let val = AtomicU32::new(4);
    ///
    /// let mut old = val.load(Ordering::Relaxed);
    /// loop {
    ///     let new = old * 2;
    ///     match val.compare_exchange_weak(old, new, Ordering::SeqCst, Ordering::Relaxed) {
    ///         Ok(_) => break,
    ///         Err(x) => old = x,
    ///     }
    /// }
    /// assert_eq(val.load(Ordering::Relaxed), 8);
    /// ```
    pub fn compare_exchange_weak(
        &self,
        current: u32,
        new: u32,
        success: Ordering,
        failure: Ordering,
    ) -> Result<u32, u32> {
        self.compare_exchange(current, new, success, failure)
    }

    /// Fetches the value, and applies a function to it that returns an optional
    /// new value. Returns a `Result` of `Ok(previous_value)` if the function
    /// returned `Some(_)`, else `Err(previous_value)`.
    ///
    /// The function may be called multiple times if the value has been changed
    /// from other threads in the meantime, as long as the function returns
    /// `Some(_)`, but the function will have been applied only once to the
    /// stored value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU32, Ordering};
    ///
    /// let x = AtomicU32::new(7);
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |_| None),
    ///     Err(7),
    /// );
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |x| Some(x + 1)),
    ///     Ok(7),
    /// );
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |x| Some(x + 1)),
    ///     Ok(8),
    /// );
    /// assert_eq(x.load(Ordering::SeqCst), 9);
    /// ```
    pub fn fetch_update(
        &self,
        set_order: Ordering,
        fetch_order: Ordering,
        f: fn(u32) -> Option<u32>,
    ) -> Result<u32, u32> {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32);
            match f(old) {
                Some(n) => {
                    if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                        return Ok(old);
                    }
                }
                None => return Err(old),
            }
        }
    }

    /// Adds to the current value, returning the previous value.
    ///
    /// This operation wraps around on overflow (it does not panic).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU32, Ordering};
    ///
    /// let foo = AtomicU32::new(0);
    /// assert_eq(foo.fetch_add(10, Ordering::SeqCst), 0);
    /// assert_eq(foo.load(Ordering::SeqCst), 10);
    ///
    /// let max = AtomicU32::new(u32::MAX);
    /// max.fetch_add(1, Ordering::SeqCst);
    /// assert_eq(max.load(Ordering::SeqCst), u32::MIN);
    /// ```
    pub fn fetch_add(&self, v: u32, order: Ordering) -> u32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32);
            let n: u32 = old.wrapping_add(v);
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Subtracts from the current value, returning the previous value.
    ///
    /// This operation wraps around on overflow (it does not panic).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU32, Ordering};
    ///
    /// let foo = AtomicU32::new(20);
    /// assert_eq(foo.fetch_sub(10, Ordering::SeqCst), 20);
    /// assert_eq(foo.load(Ordering::SeqCst), 10);
    ///
    /// let min = AtomicU32::new(u32::MIN);
    /// min.fetch_sub(1, Ordering::SeqCst);
    /// assert_eq(min.load(Ordering::SeqCst), u32::MAX);
    /// ```
    pub fn fetch_sub(&self, v: u32, order: Ordering) -> u32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32);
            let n: u32 = old.wrapping_sub(v);
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Bitwise "and" with the current value, returning the previous value.
    ///
    /// Performs a bitwise "and" operation on the current value and the argument
    /// `v`, and sets the new value to the result.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU32, Ordering};
    ///
    /// let foo = AtomicU32::new(0b101101);
    /// assert_eq(foo.fetch_and(0b110011, Ordering::SeqCst), 0b101101);
    /// assert_eq(foo.load(Ordering::SeqCst), 0b100001);
    /// ```
    pub fn fetch_and(&self, v: u32, order: Ordering) -> u32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32);
            let n: u32 = old & v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Bitwise "or" with the current value, returning the previous value.
    ///
    /// Performs a bitwise "or" operation on the current value and the argument
    /// `v`, and sets the new value to the result.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU32, Ordering};
    ///
    /// let foo = AtomicU32::new(0b101101);
    /// assert_eq(foo.fetch_or(0b110011, Ordering::SeqCst), 0b101101);
    /// assert_eq(foo.load(Ordering::SeqCst), 0b111111);
    /// ```
    pub fn fetch_or(&self, v: u32, order: Ordering) -> u32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32);
            let n: u32 = old | v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Bitwise "xor" with the current value, returning the previous value.
    ///
    /// Performs a bitwise "xor" operation on the current value and the argument
    /// `v`, and sets the new value to the result.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU32, Ordering};
    ///
    /// let foo = AtomicU32::new(0b101101);
    /// assert_eq(foo.fetch_xor(0b110011, Ordering::SeqCst), 0b101101);
    /// assert_eq(foo.load(Ordering::SeqCst), 0b011110);
    /// ```
    pub fn fetch_xor(&self, v: u32, order: Ordering) -> u32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32);
            let n: u32 = old ^ v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Maximum with the current value.
    ///
    /// Finds the maximum of the current value and the argument `v`, and sets
    /// the new value to the result. Returns the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU32, Ordering};
    ///
    /// let foo = AtomicU32::new(23);
    /// assert_eq(foo.fetch_max(42, Ordering::SeqCst), 23);
    /// assert_eq(foo.load(Ordering::SeqCst), 42);
    /// assert_eq(foo.fetch_max(7, Ordering::SeqCst), 42);
    /// assert_eq(foo.load(Ordering::SeqCst), 42);
    /// ```
    pub fn fetch_max(&self, v: u32, order: Ordering) -> u32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32);
            let n: u32 = if v > old { v } else { old };
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Minimum with the current value.
    ///
    /// Finds the minimum of the current value and the argument `v`, and sets
    /// the new value to the result. Returns the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU32, Ordering};
    ///
    /// let foo = AtomicU32::new(23);
    /// assert_eq(foo.fetch_min(42, Ordering::Relaxed), 23);
    /// assert_eq(foo.load(Ordering::Relaxed), 23);
    /// assert_eq(foo.fetch_min(22, Ordering::Relaxed), 23);
    /// assert_eq(foo.load(Ordering::Relaxed), 22);
    /// ```
    pub fn fetch_min(&self, v: u32, order: Ordering) -> u32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32);
            let n: u32 = if v < old { v } else { old };
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Returns a mutable reference to the underlying integer.
    ///
    /// This is safe because the mutable reference guarantees that no other
    /// threads are concurrently accessing the atomic data (through this path).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU32, Ordering};
    ///
    /// let mut some_var = AtomicU32::new(10);
    /// assert_eq(*some_var.get_mut(), 10);
    /// *some_var.get_mut() = 5;
    /// assert_eq(some_var.load(Ordering::SeqCst), 5);
    /// ```
    #[inline]
    pub fn get_mut(&mut self) -> &mut u32 {
        unsafe { &mut *(&mut self.v as *mut usize as *mut u32) }
    }

    /// Consumes the atomic and returns the contained value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::AtomicU32;
    ///
    /// let some_var = AtomicU32::new(5);
    /// assert_eq(some_var.into_inner(), 5);
    /// ```
    #[inline]
    pub fn into_inner(self) -> u32 {
        ((self.v) as u32)
    }
}

impl crate::fmt::Debug for AtomicU32 {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        crate::fmt::Debug::fmt(&self.load(Ordering::SeqCst), f)
    }
}

impl Default for AtomicU32 {
    fn default() -> AtomicU32 {
        AtomicU32::new(0)
    }
}

/// An integer type which can be safely shared between threads.
///
/// This type has the same in-memory representation as the underlying integer
/// type, [`i64`], widened to a word. Share it between threads through a
/// reference (`&AtomicI64`) or a `static`; every operation is sequentially
/// consistent (see the [module documentation](self)).
///
/// # Examples
///
/// ```
/// use std::{
///     sync::atomic::{AtomicI64, Ordering},
///     thread,
/// };
///
/// let counter = &AtomicI64::new(0);
/// let mut handles = Vec::new();
/// for _ in 0..4 {
///     handles.push(thread::spawn(|| {
///         for _ in 0..100 {
///             counter.fetch_add(1, Ordering::Relaxed);
///         }
///     }));
/// }
/// for h in handles {
///     h.join().unwrap();
/// }
/// assert_eq(counter.load(Ordering::SeqCst), 400);
/// ```
pub struct AtomicI64 {
    v: usize,
}

impl AtomicI64 {
    /// Creates a new atomic integer.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI64, Ordering};
    ///
    /// let atomic_forty_two = AtomicI64::new(42);
    /// assert_eq(atomic_forty_two.load(Ordering::Relaxed), 42);
    /// ```
    #[inline]
    pub fn new(v: i64) -> AtomicI64 {
        AtomicI64 { v: ((v) as usize) }
    }

    fn word(&self) -> *mut usize {
        &self.v as *const usize as *mut usize
    }

    /// Loads a value from the atomic integer.
    ///
    /// `order` is accepted for compatibility with Rust; the load is
    /// sequentially consistent.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI64, Ordering};
    ///
    /// let some_var = AtomicI64::new(5);
    /// assert_eq(some_var.load(Ordering::Relaxed), 5);
    /// ```
    #[inline]
    pub fn load(&self, order: Ordering) -> i64 {
        ((crate::rt::sched::word_load(self.word())) as i64)
    }

    /// Stores a value into the atomic integer.
    ///
    /// `order` is accepted for compatibility with Rust; the store is
    /// sequentially consistent.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI64, Ordering};
    ///
    /// let some_var = AtomicI64::new(5);
    /// some_var.store(10, Ordering::Relaxed);
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    /// ```
    #[inline]
    pub fn store(&self, v: i64, order: Ordering) {
        crate::rt::sched::word_store(self.word(), ((v) as usize));
    }

    /// Stores a value into the atomic integer, returning the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI64, Ordering};
    ///
    /// let some_var = AtomicI64::new(5);
    /// assert_eq(some_var.swap(10, Ordering::Relaxed), 5);
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    /// ```
    pub fn swap(&self, v: i64, order: Ordering) -> i64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            if crate::rt::sched::word_cas(self.word(), w, ((v) as usize)) {
                return ((w) as i64);
            }
        }
    }

    /// Stores a value into the atomic integer if the current value is the same
    /// as the `current` value.
    ///
    /// The return value is a result indicating whether the new value was
    /// written and containing the previous value. On success this value is
    /// guaranteed to be equal to `current`. The orderings are accepted for
    /// compatibility with Rust.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI64, Ordering};
    ///
    /// let some_var = AtomicI64::new(5);
    ///
    /// assert_eq(
    ///     some_var.compare_exchange(5, 10, Ordering::Acquire, Ordering::Relaxed),
    ///     Ok(5),
    /// );
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    ///
    /// assert_eq(
    ///     some_var.compare_exchange(6, 12, Ordering::SeqCst, Ordering::Acquire),
    ///     Err(10),
    /// );
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    /// ```
    pub fn compare_exchange(
        &self,
        current: i64,
        new: i64,
        success: Ordering,
        failure: Ordering,
    ) -> Result<i64, i64> {
        loop {
            if crate::rt::sched::word_cas(self.word(), ((current) as usize), ((new) as usize)) {
                return Ok(current);
            }
            let w = crate::rt::sched::word_load(self.word());
            if w != ((current) as usize) {
                return Err(((w) as i64));
            }
        }
    }

    /// Stores a value into the atomic integer if the current value is the same
    /// as the `current` value.
    ///
    /// In Rust this function is allowed to spuriously fail even when the
    /// comparison succeeds; navi's never does: it is the same as
    /// [`compare_exchange`](AtomicI64::compare_exchange).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI64, Ordering};
    ///
    /// let val = AtomicI64::new(4);
    ///
    /// let mut old = val.load(Ordering::Relaxed);
    /// loop {
    ///     let new = old * 2;
    ///     match val.compare_exchange_weak(old, new, Ordering::SeqCst, Ordering::Relaxed) {
    ///         Ok(_) => break,
    ///         Err(x) => old = x,
    ///     }
    /// }
    /// assert_eq(val.load(Ordering::Relaxed), 8);
    /// ```
    pub fn compare_exchange_weak(
        &self,
        current: i64,
        new: i64,
        success: Ordering,
        failure: Ordering,
    ) -> Result<i64, i64> {
        self.compare_exchange(current, new, success, failure)
    }

    /// Fetches the value, and applies a function to it that returns an optional
    /// new value. Returns a `Result` of `Ok(previous_value)` if the function
    /// returned `Some(_)`, else `Err(previous_value)`.
    ///
    /// The function may be called multiple times if the value has been changed
    /// from other threads in the meantime, as long as the function returns
    /// `Some(_)`, but the function will have been applied only once to the
    /// stored value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI64, Ordering};
    ///
    /// let x = AtomicI64::new(7);
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |_| None),
    ///     Err(7),
    /// );
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |x| Some(x + 1)),
    ///     Ok(7),
    /// );
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |x| Some(x + 1)),
    ///     Ok(8),
    /// );
    /// assert_eq(x.load(Ordering::SeqCst), 9);
    /// ```
    pub fn fetch_update(
        &self,
        set_order: Ordering,
        fetch_order: Ordering,
        f: fn(i64) -> Option<i64>,
    ) -> Result<i64, i64> {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as i64);
            match f(old) {
                Some(n) => {
                    if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                        return Ok(old);
                    }
                }
                None => return Err(old),
            }
        }
    }

    /// Adds to the current value, returning the previous value.
    ///
    /// This operation wraps around on overflow (it does not panic).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI64, Ordering};
    ///
    /// let foo = AtomicI64::new(0);
    /// assert_eq(foo.fetch_add(10, Ordering::SeqCst), 0);
    /// assert_eq(foo.load(Ordering::SeqCst), 10);
    ///
    /// let max = AtomicI64::new(i64::MAX);
    /// max.fetch_add(1, Ordering::SeqCst);
    /// assert_eq(max.load(Ordering::SeqCst), i64::MIN);
    /// ```
    pub fn fetch_add(&self, v: i64, order: Ordering) -> i64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as i64);
            let n: i64 = old.wrapping_add(v);
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Subtracts from the current value, returning the previous value.
    ///
    /// This operation wraps around on overflow (it does not panic).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI64, Ordering};
    ///
    /// let foo = AtomicI64::new(20);
    /// assert_eq(foo.fetch_sub(10, Ordering::SeqCst), 20);
    /// assert_eq(foo.load(Ordering::SeqCst), 10);
    ///
    /// let min = AtomicI64::new(i64::MIN);
    /// min.fetch_sub(1, Ordering::SeqCst);
    /// assert_eq(min.load(Ordering::SeqCst), i64::MAX);
    /// ```
    pub fn fetch_sub(&self, v: i64, order: Ordering) -> i64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as i64);
            let n: i64 = old.wrapping_sub(v);
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Bitwise "and" with the current value, returning the previous value.
    ///
    /// Performs a bitwise "and" operation on the current value and the argument
    /// `v`, and sets the new value to the result.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI64, Ordering};
    ///
    /// let foo = AtomicI64::new(0b101101);
    /// assert_eq(foo.fetch_and(0b110011, Ordering::SeqCst), 0b101101);
    /// assert_eq(foo.load(Ordering::SeqCst), 0b100001);
    /// ```
    pub fn fetch_and(&self, v: i64, order: Ordering) -> i64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as i64);
            let n: i64 = old & v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Bitwise "or" with the current value, returning the previous value.
    ///
    /// Performs a bitwise "or" operation on the current value and the argument
    /// `v`, and sets the new value to the result.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI64, Ordering};
    ///
    /// let foo = AtomicI64::new(0b101101);
    /// assert_eq(foo.fetch_or(0b110011, Ordering::SeqCst), 0b101101);
    /// assert_eq(foo.load(Ordering::SeqCst), 0b111111);
    /// ```
    pub fn fetch_or(&self, v: i64, order: Ordering) -> i64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as i64);
            let n: i64 = old | v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Bitwise "xor" with the current value, returning the previous value.
    ///
    /// Performs a bitwise "xor" operation on the current value and the argument
    /// `v`, and sets the new value to the result.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI64, Ordering};
    ///
    /// let foo = AtomicI64::new(0b101101);
    /// assert_eq(foo.fetch_xor(0b110011, Ordering::SeqCst), 0b101101);
    /// assert_eq(foo.load(Ordering::SeqCst), 0b011110);
    /// ```
    pub fn fetch_xor(&self, v: i64, order: Ordering) -> i64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as i64);
            let n: i64 = old ^ v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Maximum with the current value.
    ///
    /// Finds the maximum of the current value and the argument `v`, and sets
    /// the new value to the result. Returns the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI64, Ordering};
    ///
    /// let foo = AtomicI64::new(23);
    /// assert_eq(foo.fetch_max(42, Ordering::SeqCst), 23);
    /// assert_eq(foo.load(Ordering::SeqCst), 42);
    /// assert_eq(foo.fetch_max(7, Ordering::SeqCst), 42);
    /// assert_eq(foo.load(Ordering::SeqCst), 42);
    /// ```
    pub fn fetch_max(&self, v: i64, order: Ordering) -> i64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as i64);
            let n: i64 = if v > old { v } else { old };
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Minimum with the current value.
    ///
    /// Finds the minimum of the current value and the argument `v`, and sets
    /// the new value to the result. Returns the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI64, Ordering};
    ///
    /// let foo = AtomicI64::new(23);
    /// assert_eq(foo.fetch_min(42, Ordering::Relaxed), 23);
    /// assert_eq(foo.load(Ordering::Relaxed), 23);
    /// assert_eq(foo.fetch_min(22, Ordering::Relaxed), 23);
    /// assert_eq(foo.load(Ordering::Relaxed), 22);
    /// ```
    pub fn fetch_min(&self, v: i64, order: Ordering) -> i64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as i64);
            let n: i64 = if v < old { v } else { old };
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Returns a mutable reference to the underlying integer.
    ///
    /// This is safe because the mutable reference guarantees that no other
    /// threads are concurrently accessing the atomic data (through this path).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicI64, Ordering};
    ///
    /// let mut some_var = AtomicI64::new(10);
    /// assert_eq(*some_var.get_mut(), 10);
    /// *some_var.get_mut() = 5;
    /// assert_eq(some_var.load(Ordering::SeqCst), 5);
