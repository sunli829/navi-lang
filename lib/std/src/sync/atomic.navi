    /// Subtracts v (wrapping); returns the previous value.
    pub fn fetch_sub(&self, v: u64, order: Ordering) -> u64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u64);
            let n: u64 = old.wrapping_sub(v);
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) { return old; }
        }
    }

    /// Ands v; returns the previous value.
    pub fn fetch_and(&self, v: u64, order: Ordering) -> u64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u64);
            let n: u64 = old & v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) { return old; }
        }
    }

    /// Ors v; returns the previous value.
    pub fn fetch_or(&self, v: u64, order: Ordering) -> u64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u64);
            let n: u64 = old | v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) { return old; }
        }
    }

    /// Xors v; returns the previous value.
    pub fn fetch_xor(&self, v: u64, order: Ordering) -> u64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u64);
            let n: u64 = old ^ v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) { return old; }
        }
    }

    /// Stores the maximum; returns the previous value.
    pub fn fetch_max(&self, v: u64, order: Ordering) -> u64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u64);
            let n: u64 = if v > old { v } else { old };
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) { return old; }
        }
    }

    /// Stores the minimum; returns the previous value.
    pub fn fetch_min(&self, v: u64, order: Ordering) -> u64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u64);
            let n: u64 = if v < old { v } else { old };
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) { return old; }
        }
    }

    pub fn get_mut(&mut self) -> &mut u64 { unsafe { &mut *(&mut self.v as *mut usize as *mut u64) } }

    pub fn into_inner(self) -> u64 { ((self.v) as u64) }
}

impl crate::fmt::Debug for AtomicU64 {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result { crate::fmt::Debug::fmt(&self.load(Ordering::SeqCst), f) }
}

impl Default for AtomicU64 {
    fn default() -> AtomicU64 { AtomicU64::new(0) }
}

pub struct AtomicIsize {
    v: usize,
}

impl AtomicIsize {
    pub fn new(v: isize) -> AtomicIsize { AtomicIsize { v: ((v) as usize) } }

    fn word(&self) -> *mut usize { &self.v as *const usize as *mut usize }

    pub fn load(&self, order: Ordering) -> isize { ((crate::rt::sched::word_load(self.word())) as isize) }

    pub fn store(&self, v: isize, order: Ordering) { crate::rt::sched::word_store(self.word(), ((v) as usize)); }

    /// Stores v; returns the previous value.
    pub fn swap(&self, v: isize, order: Ordering) -> isize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            if crate::rt::sched::word_cas(self.word(), w, ((v) as usize)) { return ((w) as isize); }
        }
    }

    /// Stores new if the value is current: Ok(current), else Err(the value).
    pub fn compare_exchange(&self, current: isize, new: isize, success: Ordering, failure: Ordering) -> Result<isize, isize> {
        loop {
            if crate::rt::sched::word_cas(self.word(), ((current) as usize), ((new) as usize)) { return Ok(current); }
            let w = crate::rt::sched::word_load(self.word());
            if w != ((current) as usize) { return Err(((w) as isize)); }
        }
    }

    pub fn compare_exchange_weak(&self, current: isize, new: isize, success: Ordering, failure: Ordering) -> Result<isize, isize> {
        self.compare_exchange(current, new, success, failure)
    }

    /// Applies f until it stores: Ok(the previous value), or Err(the value)
    /// once f returns None.
    pub fn fetch_update(&self, set_order: Ordering, fetch_order: Ordering, f: fn(isize) -> Option<isize>) -> Result<isize, isize> {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as isize);
            match f(old) {
                Some(n) => { if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) { return Ok(old); } }
                None => return Err(old),
            }
        }
    }

    /// Adds v (wrapping); returns the previous value.
    pub fn fetch_add(&self, v: isize, order: Ordering) -> isize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as isize);
            let n: isize = old.wrapping_add(v);
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) { return old; }
        }
    }

    /// Subtracts v (wrapping); returns the previous value.
    pub fn fetch_sub(&self, v: isize, order: Ordering) -> isize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as isize);
            let n: isize = old.wrapping_sub(v);
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) { return old; }
        }
    }

    /// Ands v; returns the previous value.
    pub fn fetch_and(&self, v: isize, order: Ordering) -> isize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as isize);
            let n: isize = old & v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) { return old; }
        }
    }

    /// Ors v; returns the previous value.
    pub fn fetch_or(&self, v: isize, order: Ordering) -> isize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as isize);
            let n: isize = old | v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) { return old; }
        }
    }

    /// Xors v; returns the previous value.
    pub fn fetch_xor(&self, v: isize, order: Ordering) -> isize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as isize);
            let n: isize = old ^ v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) { return old; }
        }
    }

    /// Stores the maximum; returns the previous value.
    pub fn fetch_max(&self, v: isize, order: Ordering) -> isize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as isize);
            let n: isize = if v > old { v } else { old };
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) { return old; }
        }
    }

    /// Stores the minimum; returns the previous value.
    pub fn fetch_min(&self, v: isize, order: Ordering) -> isize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as isize);
            let n: isize = if v < old { v } else { old };
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) { return old; }
        }
    }

    pub fn get_mut(&mut self) -> &mut isize { unsafe { &mut *(&mut self.v as *mut usize as *mut isize) } }

    pub fn into_inner(self) -> isize { ((self.v) as isize) }
}

impl crate::fmt::Debug for AtomicIsize {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result { crate::fmt::Debug::fmt(&self.load(Ordering::SeqCst), f) }
}

impl Default for AtomicIsize {
    fn default() -> AtomicIsize { AtomicIsize::new(0) }
}

impl AtomicUsize {
    pub fn swap(&self, v: usize, order: Ordering) -> usize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            if crate::rt::sched::word_cas(self.word(), w, v) { return w; }
        }
    }

    pub fn fetch_sub(&self, v: usize, order: Ordering) -> usize { crate::rt::sched::word_add(self.word(), 0usize.wrapping_sub(v)) }

    pub fn compare_exchange_weak(&self, current: usize, new: usize, success: Ordering, failure: Ordering) -> Result<usize, usize> {
        self.compare_exchange(current, new, success, failure)
    }

    pub fn fetch_update(&self, set_order: Ordering, fetch_order: Ordering, f: fn(usize) -> Option<usize>) -> Result<usize, usize> {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            match f(w) {
                Some(n) => { if crate::rt::sched::word_cas(self.word(), w, n) { return Ok(w); } }
                None => return Err(w),
            }
        }
    }

    fn rmw(&self, f: fn(usize, usize) -> usize, v: usize) -> usize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            if crate::rt::sched::word_cas(self.word(), w, f(w, v)) { return w; }
        }
    }

    pub fn fetch_and(&self, v: usize, order: Ordering) -> usize { self.rmw(|a, b| a & b, v) }
    pub fn fetch_or(&self, v: usize, order: Ordering) -> usize { self.rmw(|a, b| a | b, v) }
    pub fn fetch_xor(&self, v: usize, order: Ordering) -> usize { self.rmw(|a, b| a ^ b, v) }
    pub fn fetch_max(&self, v: usize, order: Ordering) -> usize { self.rmw(|a, b| if a > b { a } else { b }, v) }
    pub fn fetch_min(&self, v: usize, order: Ordering) -> usize { self.rmw(|a, b| if a < b { a } else { b }, v) }
}

impl crate::fmt::Debug for AtomicUsize {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result { crate::fmt::Debug::fmt(&self.load(Ordering::SeqCst), f) }
}

impl Default for AtomicUsize {
    fn default() -> AtomicUsize { AtomicUsize::new(0) }
}

/// An atomic raw pointer.
pub struct AtomicPtr<T> {
    v: usize,
    t: crate::marker::PhantomData<T>,
}

impl<T> AtomicPtr<T> {
    pub fn new(p: *mut T) -> AtomicPtr<T> { AtomicPtr { v: p as usize, t: crate::marker::PhantomData } }
    fn word(&self) -> *mut usize { &self.v as *const usize as *mut usize }
    pub fn load(&self, order: Ordering) -> *mut T { crate::rt::sched::word_load(self.word()) as *mut T }
    pub fn store(&self, p: *mut T, order: Ordering) { crate::rt::sched::word_store(self.word(), p as usize); }
    pub fn swap(&self, p: *mut T, order: Ordering) -> *mut T {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            if crate::rt::sched::word_cas(self.word(), w, p as usize) { return w as *mut T; }
        }
    }
    pub fn compare_exchange(&self, current: *mut T, new: *mut T, success: Ordering, failure: Ordering) -> Result<*mut T, *mut T> {
        if crate::rt::sched::word_cas(self.word(), current as usize, new as usize) { Ok(current) } else { Err(self.load(failure)) }
    }
    pub fn into_inner(self) -> *mut T { self.v as *mut T }
}

/// A memory fence (every operation here is sequentially consistent
/// already).
pub fn fence(order: Ordering) {}
