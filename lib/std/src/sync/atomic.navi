    }

    /// Stores a value into the atomic integer, returning the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU64, Ordering};
    ///
    /// let some_var = AtomicU64::new(5);
    /// assert_eq(some_var.swap(10, Ordering::Relaxed), 5);
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    /// ```
    pub fn swap(&self, v: u64, order: Ordering) -> u64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            if crate::rt::sched::word_cas(self.word(), w, ((v) as usize)) {
                return ((w) as u64);
            }
        }
    }

    /// Stores a value into the atomic integer if the current value is the same
    /// as the `current` value.
    ///
    /// The return value is a result indicating whether the new value was
    /// written and containing the previous value. On success this value is
    /// guaranteed to be equal to `current`. The orderings are accepted for
    /// compatibility with Rust.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU64, Ordering};
    ///
    /// let some_var = AtomicU64::new(5);
    ///
    /// assert_eq(
    ///     some_var.compare_exchange(5, 10, Ordering::Acquire, Ordering::Relaxed),
    ///     Ok(5),
    /// );
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    ///
    /// assert_eq(
    ///     some_var.compare_exchange(6, 12, Ordering::SeqCst, Ordering::Acquire),
    ///     Err(10),
    /// );
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    /// ```
    pub fn compare_exchange(
        &self,
        current: u64,
        new: u64,
        success: Ordering,
        failure: Ordering,
    ) -> Result<u64, u64> {
        loop {
            if crate::rt::sched::word_cas(self.word(), ((current) as usize), ((new) as usize)) {
                return Ok(current);
            }
            let w = crate::rt::sched::word_load(self.word());
            if w != ((current) as usize) {
                return Err(((w) as u64));
            }
        }
    }

    /// Stores a value into the atomic integer if the current value is the same
    /// as the `current` value.
    ///
    /// In Rust this function is allowed to spuriously fail even when the
    /// comparison succeeds; navi's never does: it is the same as
    /// [`compare_exchange`](AtomicU64::compare_exchange).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU64, Ordering};
    ///
    /// let val = AtomicU64::new(4);
    ///
    /// let mut old = val.load(Ordering::Relaxed);
    /// loop {
    ///     let new = old * 2;
    ///     match val.compare_exchange_weak(old, new, Ordering::SeqCst, Ordering::Relaxed) {
    ///         Ok(_) => break,
    ///         Err(x) => old = x,
    ///     }
    /// }
    /// assert_eq(val.load(Ordering::Relaxed), 8);
    /// ```
    pub fn compare_exchange_weak(
        &self,
        current: u64,
        new: u64,
        success: Ordering,
        failure: Ordering,
    ) -> Result<u64, u64> {
        self.compare_exchange(current, new, success, failure)
    }

    /// Fetches the value, and applies a function to it that returns an optional
    /// new value. Returns a `Result` of `Ok(previous_value)` if the function
    /// returned `Some(_)`, else `Err(previous_value)`.
    ///
    /// The function may be called multiple times if the value has been changed
    /// from other threads in the meantime, as long as the function returns
    /// `Some(_)`, but the function will have been applied only once to the
    /// stored value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU64, Ordering};
    ///
    /// let x = AtomicU64::new(7);
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |_| None),
    ///     Err(7),
    /// );
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |x| Some(x + 1)),
    ///     Ok(7),
    /// );
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |x| Some(x + 1)),
    ///     Ok(8),
    /// );
    /// assert_eq(x.load(Ordering::SeqCst), 9);
    /// ```
    pub fn fetch_update(
        &self,
        set_order: Ordering,
        fetch_order: Ordering,
        f: fn(u64) -> Option<u64>,
    ) -> Result<u64, u64> {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u64);
            match f(old) {
                Some(n) => {
                    if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                        return Ok(old);
                    }
                }
                None => return Err(old),
            }
        }
    }

    /// Adds to the current value, returning the previous value.
    ///
    /// This operation wraps around on overflow (it does not panic).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU64, Ordering};
    ///
    /// let foo = AtomicU64::new(0);
    /// assert_eq(foo.fetch_add(10, Ordering::SeqCst), 0);
    /// assert_eq(foo.load(Ordering::SeqCst), 10);
    ///
    /// let max = AtomicU64::new(u64::MAX);
    /// max.fetch_add(1, Ordering::SeqCst);
    /// assert_eq(max.load(Ordering::SeqCst), u64::MIN);
    /// ```
    pub fn fetch_add(&self, v: u64, order: Ordering) -> u64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u64);
            let n: u64 = old.wrapping_add(v);
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Subtracts from the current value, returning the previous value.
    ///
    /// This operation wraps around on overflow (it does not panic).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU64, Ordering};
    ///
    /// let foo = AtomicU64::new(20);
    /// assert_eq(foo.fetch_sub(10, Ordering::SeqCst), 20);
    /// assert_eq(foo.load(Ordering::SeqCst), 10);
    ///
    /// let min = AtomicU64::new(u64::MIN);
    /// min.fetch_sub(1, Ordering::SeqCst);
    /// assert_eq(min.load(Ordering::SeqCst), u64::MAX);
    /// ```
    pub fn fetch_sub(&self, v: u64, order: Ordering) -> u64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u64);
            let n: u64 = old.wrapping_sub(v);
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Bitwise "and" with the current value, returning the previous value.
    ///
    /// Performs a bitwise "and" operation on the current value and the argument
    /// `v`, and sets the new value to the result.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU64, Ordering};
    ///
    /// let foo = AtomicU64::new(0b101101);
    /// assert_eq(foo.fetch_and(0b110011, Ordering::SeqCst), 0b101101);
    /// assert_eq(foo.load(Ordering::SeqCst), 0b100001);
    /// ```
    pub fn fetch_and(&self, v: u64, order: Ordering) -> u64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u64);
            let n: u64 = old & v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Bitwise "or" with the current value, returning the previous value.
    ///
    /// Performs a bitwise "or" operation on the current value and the argument
    /// `v`, and sets the new value to the result.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU64, Ordering};
    ///
    /// let foo = AtomicU64::new(0b101101);
    /// assert_eq(foo.fetch_or(0b110011, Ordering::SeqCst), 0b101101);
    /// assert_eq(foo.load(Ordering::SeqCst), 0b111111);
    /// ```
    pub fn fetch_or(&self, v: u64, order: Ordering) -> u64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u64);
            let n: u64 = old | v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Bitwise "xor" with the current value, returning the previous value.
    ///
    /// Performs a bitwise "xor" operation on the current value and the argument
    /// `v`, and sets the new value to the result.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU64, Ordering};
    ///
    /// let foo = AtomicU64::new(0b101101);
    /// assert_eq(foo.fetch_xor(0b110011, Ordering::SeqCst), 0b101101);
    /// assert_eq(foo.load(Ordering::SeqCst), 0b011110);
    /// ```
    pub fn fetch_xor(&self, v: u64, order: Ordering) -> u64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u64);
            let n: u64 = old ^ v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Maximum with the current value.
    ///
    /// Finds the maximum of the current value and the argument `v`, and sets
    /// the new value to the result. Returns the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU64, Ordering};
    ///
    /// let foo = AtomicU64::new(23);
    /// assert_eq(foo.fetch_max(42, Ordering::SeqCst), 23);
    /// assert_eq(foo.load(Ordering::SeqCst), 42);
    /// assert_eq(foo.fetch_max(7, Ordering::SeqCst), 42);
    /// assert_eq(foo.load(Ordering::SeqCst), 42);
    /// ```
    pub fn fetch_max(&self, v: u64, order: Ordering) -> u64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u64);
            let n: u64 = if v > old { v } else { old };
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Minimum with the current value.
    ///
    /// Finds the minimum of the current value and the argument `v`, and sets
    /// the new value to the result. Returns the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU64, Ordering};
    ///
    /// let foo = AtomicU64::new(23);
    /// assert_eq(foo.fetch_min(42, Ordering::Relaxed), 23);
    /// assert_eq(foo.load(Ordering::Relaxed), 23);
    /// assert_eq(foo.fetch_min(22, Ordering::Relaxed), 23);
    /// assert_eq(foo.load(Ordering::Relaxed), 22);
    /// ```
    pub fn fetch_min(&self, v: u64, order: Ordering) -> u64 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u64);
            let n: u64 = if v < old { v } else { old };
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Returns a mutable reference to the underlying integer.
    ///
    /// This is safe because the mutable reference guarantees that no other
    /// threads are concurrently accessing the atomic data (through this path).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU64, Ordering};
    ///
    /// let mut some_var = AtomicU64::new(10);
    /// assert_eq(*some_var.get_mut(), 10);
    /// *some_var.get_mut() = 5;
    /// assert_eq(some_var.load(Ordering::SeqCst), 5);
    /// ```
    #[inline]
    pub fn get_mut(&mut self) -> &mut u64 {
        unsafe { &mut *(&mut self.v as *mut usize as *mut u64) }
    }

    /// Consumes the atomic and returns the contained value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::AtomicU64;
    ///
    /// let some_var = AtomicU64::new(5);
    /// assert_eq(some_var.into_inner(), 5);
    /// ```
    #[inline]
    pub fn into_inner(self) -> u64 {
        ((self.v) as u64)
    }
}

impl crate::fmt::Debug for AtomicU64 {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        crate::fmt::Debug::fmt(&self.load(Ordering::SeqCst), f)
    }
}

impl Default for AtomicU64 {
    fn default() -> AtomicU64 {
        AtomicU64::new(0)
    }
}

/// An integer type which can be safely shared between threads.
///
/// This type has the same in-memory representation as the underlying integer
/// type, [`isize`], widened to a word. Share it between threads through a
/// reference (`&AtomicIsize`) or a `static`; every operation is sequentially
/// consistent (see the [module documentation](self)).
///
/// # Examples
///
/// ```
/// use std::{
///     sync::atomic::{AtomicIsize, Ordering},
///     thread,
/// };
///
/// let counter = &AtomicIsize::new(0);
/// let mut handles = Vec::new();
/// for _ in 0..4 {
///     handles.push(thread::spawn(|| {
///         for _ in 0..100 {
///             counter.fetch_add(1, Ordering::Relaxed);
///         }
///     }));
/// }
/// for h in handles {
///     h.join().unwrap();
/// }
/// assert_eq(counter.load(Ordering::SeqCst), 400);
/// ```
pub struct AtomicIsize {
    v: usize,
}

impl AtomicIsize {
    /// Creates a new atomic integer.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicIsize, Ordering};
    ///
    /// let atomic_forty_two = AtomicIsize::new(42);
    /// assert_eq(atomic_forty_two.load(Ordering::Relaxed), 42);
    /// ```
    #[inline]
    pub fn new(v: isize) -> AtomicIsize {
        AtomicIsize { v: ((v) as usize) }
    }

    fn word(&self) -> *mut usize {
        &self.v as *const usize as *mut usize
    }

    /// Loads a value from the atomic integer.
    ///
    /// `order` is accepted for compatibility with Rust; the load is
    /// sequentially consistent.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicIsize, Ordering};
    ///
    /// let some_var = AtomicIsize::new(5);
    /// assert_eq(some_var.load(Ordering::Relaxed), 5);
    /// ```
    #[inline]
    pub fn load(&self, order: Ordering) -> isize {
        ((crate::rt::sched::word_load(self.word())) as isize)
    }

    /// Stores a value into the atomic integer.
    ///
    /// `order` is accepted for compatibility with Rust; the store is
    /// sequentially consistent.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicIsize, Ordering};
    ///
    /// let some_var = AtomicIsize::new(5);
    /// some_var.store(10, Ordering::Relaxed);
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    /// ```
    #[inline]
    pub fn store(&self, v: isize, order: Ordering) {
        crate::rt::sched::word_store(self.word(), ((v) as usize));
    }

    /// Stores a value into the atomic integer, returning the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicIsize, Ordering};
    ///
    /// let some_var = AtomicIsize::new(5);
    /// assert_eq(some_var.swap(10, Ordering::Relaxed), 5);
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    /// ```
    pub fn swap(&self, v: isize, order: Ordering) -> isize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            if crate::rt::sched::word_cas(self.word(), w, ((v) as usize)) {
                return ((w) as isize);
            }
        }
    }

    /// Stores a value into the atomic integer if the current value is the same
    /// as the `current` value.
    ///
    /// The return value is a result indicating whether the new value was
    /// written and containing the previous value. On success this value is
    /// guaranteed to be equal to `current`. The orderings are accepted for
    /// compatibility with Rust.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicIsize, Ordering};
    ///
    /// let some_var = AtomicIsize::new(5);
    ///
    /// assert_eq(
    ///     some_var.compare_exchange(5, 10, Ordering::Acquire, Ordering::Relaxed),
    ///     Ok(5),
    /// );
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    ///
    /// assert_eq(
    ///     some_var.compare_exchange(6, 12, Ordering::SeqCst, Ordering::Acquire),
    ///     Err(10),
    /// );
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    /// ```
    pub fn compare_exchange(
        &self,
        current: isize,
        new: isize,
        success: Ordering,
        failure: Ordering,
    ) -> Result<isize, isize> {
        loop {
            if crate::rt::sched::word_cas(self.word(), ((current) as usize), ((new) as usize)) {
                return Ok(current);
            }
            let w = crate::rt::sched::word_load(self.word());
            if w != ((current) as usize) {
                return Err(((w) as isize));
            }
        }
    }

    /// Stores a value into the atomic integer if the current value is the same
    /// as the `current` value.
    ///
    /// In Rust this function is allowed to spuriously fail even when the
    /// comparison succeeds; navi's never does: it is the same as
    /// [`compare_exchange`](AtomicIsize::compare_exchange).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicIsize, Ordering};
    ///
    /// let val = AtomicIsize::new(4);
    ///
    /// let mut old = val.load(Ordering::Relaxed);
    /// loop {
    ///     let new = old * 2;
    ///     match val.compare_exchange_weak(old, new, Ordering::SeqCst, Ordering::Relaxed) {
    ///         Ok(_) => break,
    ///         Err(x) => old = x,
    ///     }
    /// }
    /// assert_eq(val.load(Ordering::Relaxed), 8);
    /// ```
    pub fn compare_exchange_weak(
        &self,
        current: isize,
        new: isize,
        success: Ordering,
        failure: Ordering,
    ) -> Result<isize, isize> {
        self.compare_exchange(current, new, success, failure)
    }

    /// Fetches the value, and applies a function to it that returns an optional
    /// new value. Returns a `Result` of `Ok(previous_value)` if the function
    /// returned `Some(_)`, else `Err(previous_value)`.
    ///
    /// The function may be called multiple times if the value has been changed
    /// from other threads in the meantime, as long as the function returns
    /// `Some(_)`, but the function will have been applied only once to the
    /// stored value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicIsize, Ordering};
    ///
    /// let x = AtomicIsize::new(7);
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |_| None),
    ///     Err(7),
    /// );
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |x| Some(x + 1)),
    ///     Ok(7),
    /// );
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |x| Some(x + 1)),
    ///     Ok(8),
    /// );
    /// assert_eq(x.load(Ordering::SeqCst), 9);
    /// ```
    pub fn fetch_update(
        &self,
        set_order: Ordering,
        fetch_order: Ordering,
        f: fn(isize) -> Option<isize>,
    ) -> Result<isize, isize> {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as isize);
            match f(old) {
                Some(n) => {
                    if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                        return Ok(old);
                    }
                }
                None => return Err(old),
            }
        }
    }

    /// Adds to the current value, returning the previous value.
    ///
    /// This operation wraps around on overflow (it does not panic).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicIsize, Ordering};
    ///
    /// let foo = AtomicIsize::new(0);
    /// assert_eq(foo.fetch_add(10, Ordering::SeqCst), 0);
    /// assert_eq(foo.load(Ordering::SeqCst), 10);
    ///
    /// let max = AtomicIsize::new(isize::MAX);
    /// max.fetch_add(1, Ordering::SeqCst);
    /// assert_eq(max.load(Ordering::SeqCst), isize::MIN);
    /// ```
    pub fn fetch_add(&self, v: isize, order: Ordering) -> isize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as isize);
            let n: isize = old.wrapping_add(v);
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Subtracts from the current value, returning the previous value.
    ///
    /// This operation wraps around on overflow (it does not panic).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicIsize, Ordering};
    ///
    /// let foo = AtomicIsize::new(20);
    /// assert_eq(foo.fetch_sub(10, Ordering::SeqCst), 20);
    /// assert_eq(foo.load(Ordering::SeqCst), 10);
    ///
    /// let min = AtomicIsize::new(isize::MIN);
    /// min.fetch_sub(1, Ordering::SeqCst);
    /// assert_eq(min.load(Ordering::SeqCst), isize::MAX);
    /// ```
    pub fn fetch_sub(&self, v: isize, order: Ordering) -> isize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as isize);
            let n: isize = old.wrapping_sub(v);
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Bitwise "and" with the current value, returning the previous value.
    ///
    /// Performs a bitwise "and" operation on the current value and the argument
    /// `v`, and sets the new value to the result.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicIsize, Ordering};
    ///
    /// let foo = AtomicIsize::new(0b101101);
    /// assert_eq(foo.fetch_and(0b110011, Ordering::SeqCst), 0b101101);
    /// assert_eq(foo.load(Ordering::SeqCst), 0b100001);
    /// ```
    pub fn fetch_and(&self, v: isize, order: Ordering) -> isize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as isize);
            let n: isize = old & v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Bitwise "or" with the current value, returning the previous value.
    ///
    /// Performs a bitwise "or" operation on the current value and the argument
    /// `v`, and sets the new value to the result.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicIsize, Ordering};
    ///
    /// let foo = AtomicIsize::new(0b101101);
    /// assert_eq(foo.fetch_or(0b110011, Ordering::SeqCst), 0b101101);
    /// assert_eq(foo.load(Ordering::SeqCst), 0b111111);
    /// ```
    pub fn fetch_or(&self, v: isize, order: Ordering) -> isize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as isize);
            let n: isize = old | v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Bitwise "xor" with the current value, returning the previous value.
    ///
    /// Performs a bitwise "xor" operation on the current value and the argument
    /// `v`, and sets the new value to the result.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicIsize, Ordering};
    ///
    /// let foo = AtomicIsize::new(0b101101);
    /// assert_eq(foo.fetch_xor(0b110011, Ordering::SeqCst), 0b101101);
    /// assert_eq(foo.load(Ordering::SeqCst), 0b011110);
    /// ```
    pub fn fetch_xor(&self, v: isize, order: Ordering) -> isize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as isize);
            let n: isize = old ^ v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Maximum with the current value.
    ///
    /// Finds the maximum of the current value and the argument `v`, and sets
    /// the new value to the result. Returns the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicIsize, Ordering};
    ///
    /// let foo = AtomicIsize::new(23);
    /// assert_eq(foo.fetch_max(42, Ordering::SeqCst), 23);
    /// assert_eq(foo.load(Ordering::SeqCst), 42);
    /// assert_eq(foo.fetch_max(7, Ordering::SeqCst), 42);
    /// assert_eq(foo.load(Ordering::SeqCst), 42);
    /// ```
    pub fn fetch_max(&self, v: isize, order: Ordering) -> isize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as isize);
            let n: isize = if v > old { v } else { old };
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Minimum with the current value.
    ///
    /// Finds the minimum of the current value and the argument `v`, and sets
    /// the new value to the result. Returns the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicIsize, Ordering};
    ///
    /// let foo = AtomicIsize::new(23);
    /// assert_eq(foo.fetch_min(42, Ordering::Relaxed), 23);
    /// assert_eq(foo.load(Ordering::Relaxed), 23);
    /// assert_eq(foo.fetch_min(22, Ordering::Relaxed), 23);
    /// assert_eq(foo.load(Ordering::Relaxed), 22);
    /// ```
    pub fn fetch_min(&self, v: isize, order: Ordering) -> isize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as isize);
            let n: isize = if v < old { v } else { old };
            if crate::rt::sched::word_cas(self.word(), w, ((n) as usize)) {
                return old;
            }
        }
    }

    /// Returns a mutable reference to the underlying integer.
    ///
    /// This is safe because the mutable reference guarantees that no other
    /// threads are concurrently accessing the atomic data (through this path).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicIsize, Ordering};
    ///
    /// let mut some_var = AtomicIsize::new(10);
    /// assert_eq(*some_var.get_mut(), 10);
    /// *some_var.get_mut() = 5;
    /// assert_eq(some_var.load(Ordering::SeqCst), 5);
    /// ```
    #[inline]
    pub fn get_mut(&mut self) -> &mut isize {
        unsafe { &mut *(&mut self.v as *mut usize as *mut isize) }
    }

    /// Consumes the atomic and returns the contained value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::AtomicIsize;
    ///
    /// let some_var = AtomicIsize::new(5);
    /// assert_eq(some_var.into_inner(), 5);
    /// ```
    #[inline]
    pub fn into_inner(self) -> isize {
        ((self.v) as isize)
    }
}

impl crate::fmt::Debug for AtomicIsize {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        crate::fmt::Debug::fmt(&self.load(Ordering::SeqCst), f)
    }
}

impl Default for AtomicIsize {
    fn default() -> AtomicIsize {
        AtomicIsize::new(0)
    }
}

impl AtomicUsize {
    /// Stores a value into the atomic integer, returning the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicUsize, Ordering};
    ///
    /// let some_var = AtomicUsize::new(5);
    /// assert_eq(some_var.swap(10, Ordering::Relaxed), 5);
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    /// ```
    pub fn swap(&self, v: usize, order: Ordering) -> usize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            if crate::rt::sched::word_cas(self.word(), w, v) {
                return w;
            }
        }
    }

    /// Subtracts from the current value, returning the previous value.
    ///
    /// This operation wraps around on overflow (it does not panic).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicUsize, Ordering};
    ///
    /// let foo = AtomicUsize::new(20);
    /// assert_eq(foo.fetch_sub(10, Ordering::SeqCst), 20);
    /// assert_eq(foo.load(Ordering::SeqCst), 10);
    ///
    /// let min = AtomicUsize::new(usize::MIN);
    /// min.fetch_sub(1, Ordering::SeqCst);
    /// assert_eq(min.load(Ordering::SeqCst), usize::MAX);
    /// ```
    #[inline]
    pub fn fetch_sub(&self, v: usize, order: Ordering) -> usize {
        crate::rt::sched::word_add(self.word(), 0usize.wrapping_sub(v))
    }

    /// Stores a value into the atomic integer if the current value is the same
    /// as the `current` value.
    ///
    /// In Rust this function is allowed to spuriously fail even when the
    /// comparison succeeds; navi's never does: it is the same as
    /// [`compare_exchange`](AtomicUsize::compare_exchange).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicUsize, Ordering};
    ///
    /// let val = AtomicUsize::new(4);
    ///
    /// let mut old = val.load(Ordering::Relaxed);
    /// loop {
    ///     let new = old * 2;
    ///     match val.compare_exchange_weak(old, new, Ordering::SeqCst, Ordering::Relaxed) {
    ///         Ok(_) => break,
    ///         Err(x) => old = x,
    ///     }
    /// }
    /// assert_eq(val.load(Ordering::Relaxed), 8);
    /// ```
    pub fn compare_exchange_weak(
        &self,
        current: usize,
        new: usize,
        success: Ordering,
        failure: Ordering,
    ) -> Result<usize, usize> {
        self.compare_exchange(current, new, success, failure)
    }

    /// Fetches the value, and applies a function to it that returns an optional
    /// new value. Returns a `Result` of `Ok(previous_value)` if the function
    /// returned `Some(_)`, else `Err(previous_value)`.
    ///
    /// The function may be called multiple times if the value has been changed
    /// from other threads in the meantime, as long as the function returns
    /// `Some(_)`, but the function will have been applied only once to the
    /// stored value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicUsize, Ordering};
    ///
    /// let x = AtomicUsize::new(7);
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |_| None),
    ///     Err(7),
    /// );
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |x| Some(x + 1)),
    ///     Ok(7),
    /// );
    /// assert_eq(
    ///     x.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |x| Some(x + 1)),
    ///     Ok(8),
    /// );
    /// assert_eq(x.load(Ordering::SeqCst), 9);
    /// ```
    pub fn fetch_update(
        &self,
        set_order: Ordering,
        fetch_order: Ordering,
        f: fn(usize) -> Option<usize>,
    ) -> Result<usize, usize> {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            match f(w) {
                Some(n) => {
                    if crate::rt::sched::word_cas(self.word(), w, n) {
                        return Ok(w);
                    }
                }
                None => return Err(w),
            }
        }
    }

    fn rmw(&self, f: fn(usize, usize) -> usize, v: usize) -> usize {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            if crate::rt::sched::word_cas(self.word(), w, f(w, v)) {
                return w;
            }
        }
    }

    /// Bitwise "and" with the current value, returning the previous value.
    ///
    /// Performs a bitwise "and" operation on the current value and the argument
    /// `v`, and sets the new value to the result.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicUsize, Ordering};
    ///
    /// let foo = AtomicUsize::new(0b101101);
    /// assert_eq(foo.fetch_and(0b110011, Ordering::SeqCst), 0b101101);
    /// assert_eq(foo.load(Ordering::SeqCst), 0b100001);
    /// ```
    #[inline]
    pub fn fetch_and(&self, v: usize, order: Ordering) -> usize {
        self.rmw(|a, b| a & b, v)
    }

    /// Bitwise "or" with the current value, returning the previous value.
    ///
    /// Performs a bitwise "or" operation on the current value and the argument
    /// `v`, and sets the new value to the result.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicUsize, Ordering};
    ///
    /// let foo = AtomicUsize::new(0b101101);
    /// assert_eq(foo.fetch_or(0b110011, Ordering::SeqCst), 0b101101);
    /// assert_eq(foo.load(Ordering::SeqCst), 0b111111);
    /// ```
    #[inline]
    pub fn fetch_or(&self, v: usize, order: Ordering) -> usize {
        self.rmw(|a, b| a | b, v)
    }

    /// Bitwise "xor" with the current value, returning the previous value.
    ///
    /// Performs a bitwise "xor" operation on the current value and the argument
    /// `v`, and sets the new value to the result.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicUsize, Ordering};
    ///
    /// let foo = AtomicUsize::new(0b101101);
    /// assert_eq(foo.fetch_xor(0b110011, Ordering::SeqCst), 0b101101);
    /// assert_eq(foo.load(Ordering::SeqCst), 0b011110);
    /// ```
    #[inline]
    pub fn fetch_xor(&self, v: usize, order: Ordering) -> usize {
        self.rmw(|a, b| a ^ b, v)
    }

    /// Maximum with the current value.
    ///
    /// Finds the maximum of the current value and the argument `v`, and sets
    /// the new value to the result. Returns the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicUsize, Ordering};
    ///
    /// let foo = AtomicUsize::new(23);
    /// assert_eq(foo.fetch_max(42, Ordering::SeqCst), 23);
    /// assert_eq(foo.load(Ordering::SeqCst), 42);
    /// assert_eq(foo.fetch_max(7, Ordering::SeqCst), 42);
    /// assert_eq(foo.load(Ordering::SeqCst), 42);
    /// ```
    #[inline]
    pub fn fetch_max(&self, v: usize, order: Ordering) -> usize {
        self.rmw(|a, b| if a > b { a } else { b }, v)
    }

    /// Minimum with the current value.
    ///
    /// Finds the minimum of the current value and the argument `v`, and sets
    /// the new value to the result. Returns the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicUsize, Ordering};
    ///
    /// let foo = AtomicUsize::new(23);
    /// assert_eq(foo.fetch_min(42, Ordering::Relaxed), 23);
    /// assert_eq(foo.load(Ordering::Relaxed), 23);
    /// assert_eq(foo.fetch_min(22, Ordering::Relaxed), 23);
    /// assert_eq(foo.load(Ordering::Relaxed), 22);
    /// ```
    #[inline]
    pub fn fetch_min(&self, v: usize, order: Ordering) -> usize {
        self.rmw(|a, b| if a < b { a } else { b }, v)
    }
}

impl crate::fmt::Debug for AtomicUsize {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        crate::fmt::Debug::fmt(&self.load(Ordering::SeqCst), f)
    }
}

impl Default for AtomicUsize {
    fn default() -> AtomicUsize {
        AtomicUsize::new(0)
    }
}

/// A raw pointer type which can be safely shared between threads.
///
/// This type has the same in-memory representation as a `*mut T`. Every
/// operation is sequentially consistent (see the [module
/// documentation](self)). In navi, a GC reference is usually what you want
/// to share; `AtomicPtr` is for raw pointers (for example to memory from C).
///
/// # Examples
///
/// ```
/// use std::sync::atomic::{AtomicPtr, Ordering};
///
/// let ptr = &mut 5;
/// let some_ptr = AtomicPtr::new(ptr as *mut i32);
/// let p = some_ptr.load(Ordering::Relaxed);
/// assert_eq(unsafe { *p }, 5);
/// ```
pub struct AtomicPtr<T> {
    v: usize,
    t: crate::marker::PhantomData<T>,
}

impl<T> AtomicPtr<T> {
    /// Creates a new `AtomicPtr`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicPtr, Ordering};
    ///
    /// let ptr = &mut 5;
    /// let atomic_ptr = AtomicPtr::new(ptr as *mut i32);
    /// assert(!atomic_ptr.load(Ordering::SeqCst).is_null());
    /// ```
    #[inline]
    pub fn new(p: *mut T) -> AtomicPtr<T> {
        AtomicPtr {
            v: p as usize,
            t: crate::marker::PhantomData,
        }
    }

    fn word(&self) -> *mut usize {
        &self.v as *const usize as *mut usize
    }

    /// Loads a value from the pointer.
    ///
    /// `order` is accepted for compatibility with Rust; the load is
    /// sequentially consistent.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicPtr, Ordering};
    ///
    /// let ptr = &mut 5;
    /// let some_ptr = AtomicPtr::new(ptr as *mut i32);
    /// let value = some_ptr.load(Ordering::Relaxed);
    /// assert_eq(value, ptr as *mut i32);
    /// ```
    #[inline]
    pub fn load(&self, order: Ordering) -> *mut T {
        crate::rt::sched::word_load(self.word()) as *mut T
    }

    /// Stores a value into the pointer.
    ///
    /// `order` is accepted for compatibility with Rust; the store is
    /// sequentially consistent.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicPtr, Ordering};
    ///
    /// let ptr = &mut 5;
    /// let some_ptr = AtomicPtr::new(ptr as *mut i32);
    /// let other_ptr = &mut 10;
    /// some_ptr.store(other_ptr as *mut i32, Ordering::Relaxed);
    /// assert_eq(unsafe { *some_ptr.load(Ordering::Relaxed) }, 10);
    /// ```
    #[inline]
    pub fn store(&self, p: *mut T, order: Ordering) {
        crate::rt::sched::word_store(self.word(), p as usize);
    }

    /// Stores a value into the pointer, returning the previous value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicPtr, Ordering};
    ///
    /// let ptr = &mut 5;
    /// let some_ptr = AtomicPtr::new(ptr as *mut i32);
    /// let other_ptr = &mut 10;
    /// let value = some_ptr.swap(other_ptr as *mut i32, Ordering::Relaxed);
    /// assert_eq(unsafe { *value }, 5);
    /// ```
    pub fn swap(&self, p: *mut T, order: Ordering) -> *mut T {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            if crate::rt::sched::word_cas(self.word(), w, p as usize) {
                return w as *mut T;
            }
        }
    }

    /// Stores a value into the pointer if the current value is the same as the
    /// `current` value.
    ///
    /// The return value is a result indicating whether the new value was
    /// written and containing the previous value. On success this value is
    /// guaranteed to be equal to `current`. The orderings are accepted for
    /// compatibility with Rust.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicPtr, Ordering};
    ///
    /// let ptr = &mut 5 as *mut i32;
    /// let some_ptr = AtomicPtr::new(ptr);
    /// let other_ptr = &mut 10 as *mut i32;
    ///
    /// let value = some_ptr.compare_exchange(ptr, other_ptr, Ordering::SeqCst, Ordering::Relaxed);
    /// assert_eq(value, Ok(ptr));
    /// assert_eq(
    ///     some_ptr.compare_exchange(ptr, ptr, Ordering::SeqCst, Ordering::Relaxed),
    ///     Err(other_ptr),
    /// );
    /// ```
    pub fn compare_exchange(
        &self,
        current: *mut T,
        new: *mut T,
        success: Ordering,
        failure: Ordering,
    ) -> Result<*mut T, *mut T> {
        if crate::rt::sched::word_cas(self.word(), current as usize, new as usize) {
            Ok(current)
        } else {
            Err(self.load(failure))
        }
    }

    /// Consumes the atomic and returns the contained value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::AtomicPtr;
    ///
    /// let ptr = &mut 5 as *mut i32;
    /// let atomic_ptr = AtomicPtr::new(ptr);
    /// assert_eq(atomic_ptr.into_inner(), ptr);
    /// ```
    #[inline]
    pub fn into_inner(self) -> *mut T {
        self.v as *mut T
    }
}

/// An atomic fence.
///
/// In Rust, a fence prevents the compiler and CPU from reordering certain
/// types of memory operations around it. In navi every atomic operation is
/// sequentially consistent already, so `fence` does nothing; it exists so
/// that code written for Rust compiles.
///
/// # Examples
///
/// ```
/// use std::sync::atomic::{AtomicBool, Ordering, fence};
///
/// let flag = AtomicBool::new(false);
/// flag.store(true, Ordering::Relaxed);
/// fence(Ordering::SeqCst);
/// assert(flag.load(Ordering::Relaxed));
/// ```
#[inline]
pub fn fence(order: Ordering) {}
