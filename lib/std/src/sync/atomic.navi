/// This type has the same in-memory representation as the underlying integer
/// type, [`u64`], widened to a word. Share it between threads through a
/// reference (`&AtomicU64`) or a `static`; every operation is sequentially
/// consistent (see the [module documentation](self)).
///
/// # Examples
///
/// ```
/// use std::{
///     sync::atomic::{AtomicU64, Ordering},
///     thread,
/// };
///
/// let counter = &AtomicU64::new(0);
/// let mut handles = Vec::new();
/// for _ in 0..4 {
///     handles.push(thread::spawn(|| {
///         for _ in 0..100 {
///             counter.fetch_add(1, Ordering::Relaxed);
///         }
///     }));
/// }
/// for h in handles {
///     h.join().unwrap();
/// }
/// assert_eq(counter.load(Ordering::SeqCst), 400);
/// ```
pub struct AtomicU64 {
    v: usize,
