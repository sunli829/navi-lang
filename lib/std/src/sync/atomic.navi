impl AtomicU64 {
    /// Creates a new atomic integer.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU64, Ordering};
    ///
    /// let atomic_forty_two = AtomicU64::new(42);
    /// assert_eq(atomic_forty_two.load(Ordering::Relaxed), 42);
    /// ```
    #[inline]
    pub fn new(v: u64) -> AtomicU64 {
        AtomicU64 { v: ((v) as usize) }
    }

    fn word(&self) -> *mut usize {
        &self.v as *const usize as *mut usize
    }

    /// Loads a value from the atomic integer.
    ///
    /// `order` is accepted for compatibility with Rust; the load is
    /// sequentially consistent.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU64, Ordering};
    ///
    /// let some_var = AtomicU64::new(5);
    /// assert_eq(some_var.load(Ordering::Relaxed), 5);
    /// ```
    #[inline]
    pub fn load(&self, order: Ordering) -> u64 {
        ((crate::rt::sched::word_load(self.word())) as u64)
    }

    /// Stores a value into the atomic integer.
    ///
    /// `order` is accepted for compatibility with Rust; the store is
    /// sequentially consistent.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::sync::atomic::{AtomicU64, Ordering};
    ///
    /// let some_var = AtomicU64::new(5);
    /// some_var.store(10, Ordering::Relaxed);
    /// assert_eq(some_var.load(Ordering::Relaxed), 10);
    /// ```
    #[inline]
    pub fn store(&self, v: u64, order: Ordering) {
