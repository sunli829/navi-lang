//! Atomic types (as Rust's std::sync::atomic). The orderings are accepted
//! and every operation is sequentially consistent.

#[derive(Clone, Debug, PartialEq, Eq)]
pub enum Ordering {
    Relaxed,
    Release,
    Acquire,
    AcqRel,
    SeqCst,
}

pub struct AtomicUsize {
    v: usize,
}

impl AtomicUsize {
    pub fn new(v: usize) -> AtomicUsize { AtomicUsize { v } }

    fn word(&self) -> *mut usize { &self.v as *const usize as *mut usize }

    pub fn load(&self, order: Ordering) -> usize { crate::rt::sched::word_load(self.word()) }

    pub fn store(&self, v: usize, order: Ordering) { crate::rt::sched::word_store(self.word(), v); }

    /// Adds v; returns the previous value.
    pub fn fetch_add(&self, v: usize, order: Ordering) -> usize { crate::rt::sched::word_add(self.word(), v) }

    /// Stores new if the value is current: Ok(current), else Err(the value).
    pub fn compare_exchange(&self, current: usize, new: usize, success: Ordering, failure: Ordering) -> Result<usize, usize> {
        if crate::rt::sched::word_cas(self.word(), current, new) { Ok(current) } else { Err(self.load(failure)) }
    }

    pub fn get_mut(&mut self) -> &mut usize { &mut self.v }

    pub fn into_inner(self) -> usize { self.v }
}

// --- More atomics (navi) ---------------------------------------------------------
//
// Every atomic is one word (narrower values in its low bits, the rest 0),
// so that the runtime's word operations serve them all.

pub struct AtomicBool {
    v: usize,
}

impl AtomicBool {
    pub fn new(v: bool) -> AtomicBool { AtomicBool { v: (if (v) { 1 } else { 0 }) } }

    fn word(&self) -> *mut usize { &self.v as *const usize as *mut usize }

    pub fn load(&self, order: Ordering) -> bool { ((crate::rt::sched::word_load(self.word())) != 0) }

    pub fn store(&self, v: bool, order: Ordering) { crate::rt::sched::word_store(self.word(), (if (v) { 1 } else { 0 })); }

    /// Stores v; returns the previous value.
    pub fn swap(&self, v: bool, order: Ordering) -> bool {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            if crate::rt::sched::word_cas(self.word(), w, (if (v) { 1 } else { 0 })) { return ((w) != 0); }
        }
    }

    /// Stores new if the value is current: Ok(current), else Err(the value).
    pub fn compare_exchange(&self, current: bool, new: bool, success: Ordering, failure: Ordering) -> Result<bool, bool> {
        loop {
            if crate::rt::sched::word_cas(self.word(), (if (current) { 1 } else { 0 }), (if (new) { 1 } else { 0 })) { return Ok(current); }
            let w = crate::rt::sched::word_load(self.word());
            if w != (if (current) { 1 } else { 0 }) { return Err(((w) != 0)); }
        }
    }

    pub fn compare_exchange_weak(&self, current: bool, new: bool, success: Ordering, failure: Ordering) -> Result<bool, bool> {
        self.compare_exchange(current, new, success, failure)
    }

    /// Applies f until it stores: Ok(the previous value), or Err(the value)
    /// once f returns None.
    pub fn fetch_update(&self, set_order: Ordering, fetch_order: Ordering, f: fn(bool) -> Option<bool>) -> Result<bool, bool> {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) != 0);
            match f(old) {
                Some(n) => { if crate::rt::sched::word_cas(self.word(), w, (if (n) { 1 } else { 0 })) { return Ok(old); } }
                None => return Err(old),
            }
        }
    }

    /// Ands v; returns the previous value.
    pub fn fetch_and(&self, v: bool, order: Ordering) -> bool {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) != 0);
            let n: bool = old && v;
            if crate::rt::sched::word_cas(self.word(), w, (if (n) { 1 } else { 0 })) { return old; }
        }
    }

    /// Ors v; returns the previous value.
    pub fn fetch_or(&self, v: bool, order: Ordering) -> bool {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) != 0);
            let n: bool = old || v;
            if crate::rt::sched::word_cas(self.word(), w, (if (n) { 1 } else { 0 })) { return old; }
        }
    }

    /// Xors v; returns the previous value.
    pub fn fetch_xor(&self, v: bool, order: Ordering) -> bool {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) != 0);
            let n: bool = old != v;
            if crate::rt::sched::word_cas(self.word(), w, (if (n) { 1 } else { 0 })) { return old; }
        }
    }

    /// Nands v; returns the previous value.
    pub fn fetch_nand(&self, v: bool, order: Ordering) -> bool {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) != 0);
            let n: bool = !(old && v);
            if crate::rt::sched::word_cas(self.word(), w, (if (n) { 1 } else { 0 })) { return old; }
        }
    }

    pub fn get_mut(&mut self) -> &mut bool { unsafe { &mut *(&mut self.v as *mut usize as *mut bool) } }

    pub fn into_inner(self) -> bool { ((self.v) != 0) }
}

impl crate::fmt::Debug for AtomicBool {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result { crate::fmt::Debug::fmt(&self.load(Ordering::SeqCst), f) }
}

impl Default for AtomicBool {
    fn default() -> AtomicBool { AtomicBool::new(false) }
}

pub struct AtomicI32 {
    v: usize,
}

impl AtomicI32 {
    pub fn new(v: i32) -> AtomicI32 { AtomicI32 { v: ((v) as u32 as usize) } }

    fn word(&self) -> *mut usize { &self.v as *const usize as *mut usize }

    pub fn load(&self, order: Ordering) -> i32 { ((crate::rt::sched::word_load(self.word())) as u32 as i32) }

    pub fn store(&self, v: i32, order: Ordering) { crate::rt::sched::word_store(self.word(), ((v) as u32 as usize)); }

    /// Stores v; returns the previous value.
    pub fn swap(&self, v: i32, order: Ordering) -> i32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            if crate::rt::sched::word_cas(self.word(), w, ((v) as u32 as usize)) { return ((w) as u32 as i32); }
        }
    }

    /// Stores new if the value is current: Ok(current), else Err(the value).
    pub fn compare_exchange(&self, current: i32, new: i32, success: Ordering, failure: Ordering) -> Result<i32, i32> {
        loop {
            if crate::rt::sched::word_cas(self.word(), ((current) as u32 as usize), ((new) as u32 as usize)) { return Ok(current); }
            let w = crate::rt::sched::word_load(self.word());
            if w != ((current) as u32 as usize) { return Err(((w) as u32 as i32)); }
        }
    }

    pub fn compare_exchange_weak(&self, current: i32, new: i32, success: Ordering, failure: Ordering) -> Result<i32, i32> {
        self.compare_exchange(current, new, success, failure)
    }

    /// Applies f until it stores: Ok(the previous value), or Err(the value)
    /// once f returns None.
    pub fn fetch_update(&self, set_order: Ordering, fetch_order: Ordering, f: fn(i32) -> Option<i32>) -> Result<i32, i32> {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32 as i32);
            match f(old) {
                Some(n) => { if crate::rt::sched::word_cas(self.word(), w, ((n) as u32 as usize)) { return Ok(old); } }
                None => return Err(old),
            }
        }
    }

    /// Adds v (wrapping); returns the previous value.
    pub fn fetch_add(&self, v: i32, order: Ordering) -> i32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32 as i32);
            let n: i32 = old.wrapping_add(v);
            if crate::rt::sched::word_cas(self.word(), w, ((n) as u32 as usize)) { return old; }
        }
    }

    /// Subtracts v (wrapping); returns the previous value.
    pub fn fetch_sub(&self, v: i32, order: Ordering) -> i32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32 as i32);
            let n: i32 = old.wrapping_sub(v);
            if crate::rt::sched::word_cas(self.word(), w, ((n) as u32 as usize)) { return old; }
        }
    }

    /// Ands v; returns the previous value.
    pub fn fetch_and(&self, v: i32, order: Ordering) -> i32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32 as i32);
            let n: i32 = old & v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as u32 as usize)) { return old; }
        }
    }

    /// Ors v; returns the previous value.
    pub fn fetch_or(&self, v: i32, order: Ordering) -> i32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32 as i32);
            let n: i32 = old | v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as u32 as usize)) { return old; }
        }
    }

    /// Xors v; returns the previous value.
    pub fn fetch_xor(&self, v: i32, order: Ordering) -> i32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32 as i32);
            let n: i32 = old ^ v;
            if crate::rt::sched::word_cas(self.word(), w, ((n) as u32 as usize)) { return old; }
        }
    }

    /// Stores the maximum; returns the previous value.
    pub fn fetch_max(&self, v: i32, order: Ordering) -> i32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32 as i32);
            let n: i32 = if v > old { v } else { old };
            if crate::rt::sched::word_cas(self.word(), w, ((n) as u32 as usize)) { return old; }
        }
    }

    /// Stores the minimum; returns the previous value.
    pub fn fetch_min(&self, v: i32, order: Ordering) -> i32 {
        loop {
            let w = crate::rt::sched::word_load(self.word());
            let old = ((w) as u32 as i32);
            let n: i32 = if v < old { v } else { old };
            if crate::rt::sched::word_cas(self.word(), w, ((n) as u32 as usize)) { return old; }
        }
    }

    pub fn get_mut(&mut self) -> &mut i32 { unsafe { &mut *(&mut self.v as *mut usize as *mut i32) } }

    pub fn into_inner(self) -> i32 { ((self.v) as u32 as i32) }
}

impl crate::fmt::Debug for AtomicI32 {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result { crate::fmt::Debug::fmt(&self.load(Ordering::SeqCst), f) }
}

impl Default for AtomicI32 {
    fn default() -> AtomicI32 { AtomicI32::new(0) }
}

