//! Multi-producer, multi-consumer channels with Rust's std::sync::mpmc API,
//! plus Sender::close() because navi has no Drop.

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct SendError<T>(pub T);

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct RecvError;

#[derive(Debug, Clone, PartialEq, Eq)]
pub enum TryRecvError { Empty, Disconnected }

// Channels are shared and mutated through &self, so the handles hold raw
// pointers (the GC traces raw pointers like references).
pub struct Sender<T> { chan: *mut Channel<T> }
pub struct Receiver<T> { chan: *mut Channel<T> }

struct Channel<T> {
    cap: usize,
    closed: bool,
    buf: crate::vec::Vec<T>,
}

/// An unbounded channel.
pub fn channel<T>() -> (Sender<T>, Receiver<T>) { todo() }

/// A bounded channel; capacity 0 makes every send wait for a receiver.
pub fn sync_channel<T>(bound: usize) -> (Sender<T>, Receiver<T>) { todo() }

impl<T> Sender<T> {
    pub fn send(&self, value: T) -> Result<(), SendError<T>> { todo() }
    pub fn close(&self) { todo() }
}

impl<T> Clone for Sender<T> {
    fn clone(&self) -> Sender<T> { Sender { chan: self.chan } }
}

impl<T> Receiver<T> {
    pub fn recv(&self) -> Result<T, RecvError> { todo() }
    pub fn try_recv(&self) -> Result<T, TryRecvError> { todo() }
    pub fn iter(&self) -> Iter<T> { Iter { rx: Receiver { chan: self.chan } } }
}

impl<T> Clone for Receiver<T> {
    fn clone(&self) -> Receiver<T> { Receiver { chan: self.chan } }
}

pub struct Iter<T> { rx: Receiver<T> }
impl<T> Iterator for Iter<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> { self.rx.recv().ok() }
}
