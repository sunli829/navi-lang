//! The runtime: memory, output, panics, threads and channels. Private to
//! std. The interpreter implements these intrinsics in Go; the native
//! runtime (M3/M6) implements them in navi and assembly.

pub mod panic;
pub mod native;
pub mod float;
pub mod gc;
pub mod sched;

#[intrinsic] pub fn alloc(size: usize, align: usize) -> *mut u8;
#[intrinsic] pub fn alloc_array<T>(n: usize) -> *mut T;
#[intrinsic] pub fn copy<T>(src: *const T, dst: *mut T, n: usize);
#[intrinsic] pub fn ptr_offset<T>(p: *const T, n: usize) -> *const T;
#[intrinsic] pub fn slice_from_raw<T>(p: *const T, n: usize) -> &[T];
#[intrinsic] pub fn slice_from_raw_mut<T>(p: *mut T, n: usize) -> &mut [T];
#[intrinsic] pub fn slice_len<T>(s: &[T]) -> usize;
#[intrinsic] pub fn slice_ptr<T>(s: &[T]) -> *const T;
#[intrinsic] pub fn str_from_raw(p: *const u8, n: usize) -> &str;
#[intrinsic] pub fn str_as_bytes(s: &str) -> &[u8];
#[intrinsic] pub fn write(fd: i32, p: *const u8, n: usize);
#[intrinsic] pub fn exit(code: i32) -> !;
#[intrinsic] pub fn panic_raw(msg: &str, file: &str, line: u32, col: u32) -> !;
#[intrinsic] pub fn spawn<T>(f: fn() -> T) -> *mut u8;
#[intrinsic] pub fn join<T>(h: *mut u8) -> T;
#[intrinsic] pub fn yield_now();
#[intrinsic] pub fn chan_new<T>(cap: usize) -> *mut u8;
#[intrinsic] pub fn chan_send<T>(c: *mut u8, v: T) -> bool;
#[intrinsic] pub fn chan_recv<T>(c: *mut u8) -> Option<T>;
#[intrinsic] pub fn chan_try_recv<T>(c: *mut u8) -> Option<T>;
#[intrinsic] pub fn chan_close(c: *mut u8);
#[intrinsic] pub fn chan_closed(c: *mut u8) -> bool;
#[intrinsic] pub fn select_cases(cases: &[crate::sync::mpmc::SelectCase], has_default: bool) -> usize;
// Operating system access (std::fs, std::env, std::process).
#[intrinsic] pub fn os_arg_count() -> usize;
#[intrinsic] pub fn monotonic_nanos() -> u64;
/// Stores the registers that may hold pointers across calls (callee-saved
/// registers of generated code) into buf (10 words), for the collector.
#[intrinsic] pub fn spill_registers(buf: *mut usize);
/// The stack pointer of the calling function (the lowest address of its frame).
#[intrinsic] pub fn stack_pointer() -> *mut u8;
#[intrinsic] pub fn os_arg(i: usize) -> &str;
#[intrinsic] pub fn os_getenv(name: &str) -> Option<&str>;
#[intrinsic] pub fn os_system(cmd: &str) -> i32;
#[intrinsic] pub fn fs_open(path: &str, mode: u8) -> usize;
#[intrinsic] pub fn fs_read(h: usize, buf: *mut u8, n: usize) -> usize;
#[intrinsic] pub fn fs_write(h: usize, buf: *const u8, n: usize) -> usize;
#[intrinsic] pub fn fs_close(h: usize);
#[intrinsic] pub fn fs_kind(path: &str) -> u8;
#[intrinsic] pub fn fs_mkdir(path: &str) -> bool;
#[intrinsic] pub fn fs_remove(path: &str) -> bool;

// Native code only (the collector and panic unwinding).
#[intrinsic] pub fn has_pointers<T>() -> bool;
#[intrinsic] pub fn frame_address() -> *const u8;
#[intrinsic] pub fn stack_top() -> *const u8;
#[intrinsic] pub fn data_start() -> *const u8;
#[intrinsic] pub fn data_end() -> *const u8;
#[intrinsic] pub fn run_defers(head: *mut u8);
#[intrinsic] pub fn swap_context(save: *mut u8, load: *mut u8);
#[intrinsic] pub fn gstart_address() -> *const u8;
#[intrinsic] pub fn set_stack_limit(lo: usize);
#[intrinsic] pub fn float_op(op: u8, x: f64) -> f64;
#[intrinsic] pub fn fmt_float(x: f64, prec: usize, has_prec: bool, style: u8, buf: *mut u8) -> usize;
