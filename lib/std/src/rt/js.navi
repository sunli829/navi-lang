//! The runtime's C library on js-wasm32 (docs/wasm.md): what the other
//! targets get from libc, under the same names (the runtime calls them
//! unchanged), over the glue JS's imports and the module's memory.
//!
//! - mmap grows the memory (it cannot shrink: munmap keeps the range for a
//!   later mmap); calloc, realloc and free (the runtime's own metadata, never
//!   GC memory) are a size-class allocator over it.
//! - One thread: the locks do nothing; waiting on a condition goes back to JS
//!   (_navi_idle) until a timer or an event calls resume().

#[link(wasm_import_module = "navi")]
#[nonblocking]
extern "C" {
    #[link_name = "write"]
    fn js_write(fd: i32, p: u32, len: u32) -> i32;
    #[link_name = "exit"]
    fn js_exit(code: i32);
    /// Monotonic nanoseconds (performance.now).
    #[link_name = "nanotime"]
    fn js_nanotime() -> f64;
    /// Milliseconds since the Unix epoch (Date.now).
    #[link_name = "walltime"]
    fn js_walltime() -> f64;
    /// memory.grow by pages (64 KiB): the old size in pages, or -1.
    #[link_name = "grow"]
    fn js_grow(pages: u32) -> i32;
    #[link_name = "floor"]
    fn js_floor(x: f64) -> f64;
    #[link_name = "ceil"]
    fn js_ceil(x: f64) -> f64;
    #[link_name = "trunc"]
    fn js_trunc(x: f64) -> f64;
    #[link_name = "sqrt"]
    fn js_sqrt(x: f64) -> f64;
    /// Fills len bytes at p with random bytes (crypto.getRandomValues).
    #[link_name = "random"]
    fn js_random(p: u32, len: u32);
    /// The Func of the event JS made that navi has not run (-1: none;
    /// std::js).
    #[link_name = "js_event_func"]
    fn js_event_func() -> i32;
}

#[nonblocking]
extern "C" {
    /// The backend's routine (crate::backend::wasm): back to JS, which
    /// calls resume() after ms milliseconds (-1: on an event).
    fn _navi_idle(ms: i64);
}

// --- Memory
// --------------------------------------------------------------------

const WASM_PAGE: usize = 65536;
/// mmap's failure (MAP_FAILED).
const FAILED: usize = 18446744073709551615;

// Ranges munmap gave back (address, length), for mmap to reuse.
static mut FREE_RANGES: usize = 0;
static mut NFREE_RANGES: usize = 0;
const MAX_RANGES: usize = 4096;

fn grow_by(len: usize) -> usize {
    let pages = (len + WASM_PAGE - 1) / WASM_PAGE;
    let old = unsafe { js_grow(pages as u32) };
    if old < 0 {
        return FAILED;
    }
    old as usize * WASM_PAGE
}

pub unsafe fn mmap(addr: *mut u8, len: usize, prot: i32, flags: i32, fd: i32, off: i64) -> *mut u8 {
    let _ = (addr, prot, flags, fd, off);
    let n = (len + WASM_PAGE - 1) / WASM_PAGE * WASM_PAGE;
    // A range given back, as large (first fit; the rest stays free).
    if FREE_RANGES != 0 {
        let t = FREE_RANGES as *mut usize;
        let mut i = 0;
        while i < NFREE_RANGES {
            let a = *t.add(2 * i);
            let l = *t.add(2 * i + 1);
            if l >= n {
                if l == n {
                    NFREE_RANGES -= 1;
                    *t.add(2 * i) = *t.add(2 * NFREE_RANGES);
                    *t.add(2 * i + 1) = *t.add(2 * NFREE_RANGES + 1);
                } else {
                    *t.add(2 * i) = a + n;
                    *t.add(2 * i + 1) = l - n;
                }
                crate::rt::mem_fill(a as *mut u8, 0, n);
                return a as *mut u8;
            }
            i += 1;
        }
    }
    grow_by(n) as *mut u8
}

pub unsafe fn munmap(addr: *mut u8, len: usize) -> i32 {
    let n = (len + WASM_PAGE - 1) / WASM_PAGE * WASM_PAGE;
    if FREE_RANGES == 0 {
        FREE_RANGES = grow_by(16 * MAX_RANGES);
    }
    if NFREE_RANGES < MAX_RANGES {
        let t = FREE_RANGES as *mut usize;
        *t.add(2 * NFREE_RANGES) = addr as usize;
        *t.add(2 * NFREE_RANGES + 1) = n;
        NFREE_RANGES += 1;
    }
    0
}

pub unsafe fn mprotect(addr: *mut u8, len: usize, prot: i32) -> i32 {
    let _ = (addr, len, prot);
    0
}

pub unsafe fn madvise(addr: *mut u8, len: usize, advice: i32) -> i32 {
    let _ = (addr, len, advice);
    0
}

pub unsafe fn sysconf(name: i32) -> i64 {
    let _ = name;
    1
}

pub unsafe fn memset(p: *mut u8, c: i32, n: usize) -> *mut u8 {
    crate::rt::mem_fill(p, c as u8, n);
    p
}

pub unsafe fn memmove(dst: *mut u8, src: *const u8, n: usize) -> *mut u8 {
    crate::rt::mem_copy(dst, src, n);
    dst
}

// The allocator: blocks of 16 << k bytes (k < NCLASS) with a 16-byte
// header holding k, free ones on per-class lists; larger ones are mmap'd
// (the header holds their length).
const NCLASS: usize = 13;
static mut FREE_LISTS: [usize; 13] = [0usize; 13];
// The part of a chunk not handed out yet.
static mut CHUNK_NEXT: usize = 0;
static mut CHUNK_END: usize = 0;

pub unsafe fn calloc(n: usize, size: usize) -> *mut u8 {
    let mut total = n * size;
    if total == 0 {
        total = 1;
    }
    let need = total + 16;
    let mut k = 0;
    while k < NCLASS && (16usize << k as u32) < need {
        k += 1;
    }
    if k == NCLASS {
        let p = mmap(0 as *mut u8, need, 3, 0, -1, 0) as usize;
        if p == FAILED {
            return 0 as *mut u8;
        }
        *(p as *mut usize) = 100 + need;
        return (p + 16) as *mut u8;
    }
    let bytes = 16usize << k as u32;
    let mut p = FREE_LISTS[k];
    if p != 0 {
        FREE_LISTS[k] = *(p as *const usize);
        crate::rt::mem_fill(p as *mut u8, 0, bytes);
    } else {
        if CHUNK_NEXT + bytes > CHUNK_END {
            let c = grow_by(1 << 20);
            if c == FAILED {
                return 0 as *mut u8;
            }
            CHUNK_NEXT = c;
            CHUNK_END = c + (1 << 20);
        }
        p = CHUNK_NEXT;
        CHUNK_NEXT += bytes;
    }
    *(p as *mut usize) = k;
    (p + 16) as *mut u8
}

// The usable size of an allocated block.
unsafe fn usable(q: *mut u8) -> usize {
    let h = *((q as usize - 16) as *const usize);
    if h >= 100 {
        h - 100 - 16
    } else {
        (16usize << h as u32) - 16
    }
}

pub unsafe fn free(q: *mut u8) {
    if q as usize == 0 {
        return;
    }
    let p = q as usize - 16;
    let h = *(p as *const usize);
    if h >= 100 {
        munmap(p as *mut u8, h - 100);
        return;
    }
    *(p as *mut usize) = FREE_LISTS[h];
    FREE_LISTS[h] = p;
}

pub unsafe fn realloc(q: *mut u8, size: usize) -> *mut u8 {
    if q as usize == 0 {
        return calloc(1, size);
    }
    let have = usable(q);
    if size <= have {
        return q;
    }
    let r = calloc(1, size);
    if r as usize == 0 {
        return r;
    }
    crate::rt::mem_copy(r, q, have);
    free(q);
    r
}

// --- Threads (one)
// ---------------------------------------------------------------

pub unsafe fn pthread_mutex_init(m: *mut u8, attr: *const u8) -> i32 {
    let _ = (m, attr);
    0
}

pub unsafe fn pthread_mutex_lock(m: *mut u8) -> i32 {
    let _ = m;
    0
}

pub unsafe fn pthread_mutex_trylock(m: *mut u8) -> i32 {
    let _ = m;
    0
}

pub unsafe fn pthread_mutex_unlock(m: *mut u8) -> i32 {
    let _ = m;
    0
}

pub unsafe fn pthread_cond_init(c: *mut u8, attr: *const u8) -> i32 {
    let _ = (c, attr);
    0
}

/// Nothing else runs: back to JS until an event.
pub unsafe fn pthread_cond_wait(c: *mut u8, m: *mut u8) -> i32 {
    let _ = (c, m);
    _navi_idle(-1);
    after_idle();
    0
}

/// The same for at most ns nanoseconds.
pub unsafe fn cond_wait_ns(ns: u64) {
    let ms = (ns + 999999) / 1000000;
    _navi_idle(if ms > 2147483647 {
        2147483647
    } else {
        ms as i64
    });
    after_idle();
}

// Back from JS: an event JS made (a Func called while the program waited)
// readies the G that runs Funcs (std::js).
fn after_idle() {
    if EVENTS && unsafe { js_event_func() } >= 0 {
        crate::rt::sched::wake_events();
        crate::rt::sched::wake_self();
    }
}

// Whether the G running Funcs was started, and how many Funcs JS may call.
static mut EVENTS: bool = false;
static mut WAITERS: usize = 0;

/// Starts the G running the Funcs JS calls while the program waits (once).
pub fn start_events() {
    if EVENTS {
        return;
    }
    EVENTS = true;
    crate::thread::spawn(|| crate::rt::sched::event_loop(crate::js::handle_events));
}

pub fn set_waiters(n: usize) {
    WAITERS = n;
}

/// Whether a Func may still be called (the program waits for events).
pub fn waiting() -> bool {
    WAITERS > 0
}

pub unsafe fn pthread_cond_signal(c: *mut u8) -> i32 {
    let _ = c;
    0
}

pub unsafe fn pthread_create(t: *mut usize, attr: *const u8, start: usize, arg: usize) -> i32 {
    let _ = (t, attr, start, arg);
    1
}

pub unsafe fn pthread_detach(t: usize) -> i32 {
    let _ = t;
    0
}

pub unsafe fn sched_yield() -> i32 {
    0
}

pub unsafe fn usleep(us: u32) -> i32 {
    let _ = us;
    0
}

pub unsafe fn pthread_key_create(key: *mut usize, dtor: usize) -> i32 {
    let _ = dtor;
    *key = 1;
    0
}

pub unsafe fn pthread_setspecific(key: usize, v: usize) -> i32 {
    let _ = (key, v);
    0
}

// --- The rest
// --------------------------------------------------------------------

pub fn write(fd: i32, p: *const u8, n: usize) {
    if n > 0 {
        unsafe { js_write(fd, p as usize as u32, n as u32) };
    }
}

pub fn exit(code: i32) -> ! {
    unsafe { js_exit(code) };
    loop {}
}

pub fn monotonic_nanos() -> i64 {
    unsafe { js_nanotime() as i64 }
}

pub fn realtime_nanos() -> i128 {
    unsafe { js_walltime() as i128 * 1000000 }
}

pub fn floor(x: f64) -> f64 {
    unsafe { js_floor(x) }
}

pub fn ceil(x: f64) -> f64 {
    unsafe { js_ceil(x) }
}

pub fn trunc(x: f64) -> f64 {
    unsafe { js_trunc(x) }
}

pub fn sqrt(x: f64) -> f64 {
    unsafe { js_sqrt(x) }
}

/// C's round: halfway cases away from zero.
pub fn round(x: f64) -> f64 {
    let t = trunc(x);
    let d = x - t;
    if d >= 0.5 {
        t + 1.0
    } else if d <= -0.5 {
        t - 1.0
    } else {
        t
    }
}

pub fn random(p: *mut u8, n: usize) {
    if n > 0 {
        unsafe { js_random(p as usize as u32, n as u32) };
    }
}

// --- The C library's names native.navi calls
// ----------------------------------

pub unsafe fn c_write(fd: i32, buf: *const u8, n: usize) -> isize {
    write(fd, buf, n);
    n as isize
}

pub unsafe fn c_exit(code: i32) -> ! {
    exit(code)
}

// No files or processes: getenv sees none of the environment (std::env has
// the program's own), the rest fails.
pub unsafe fn getenv(name: *const u8) -> *const u8 {
    let _ = name;
    0 as *const u8
}

pub unsafe fn fopen(path: *const u8, mode: *const u8) -> *mut u8 {
    let _ = (path, mode);
    0 as *mut u8
}

pub unsafe fn fclose(f: *mut u8) -> i32 {
    let _ = f;
    0
}

pub unsafe fn remove(path: *const u8) -> i32 {
    let _ = path;
    -1
}

pub unsafe fn system(cmd: *const u8) -> i32 {
    let _ = cmd;
    -1
}

pub unsafe fn fread(buf: *mut u8, size: usize, n: usize, f: *mut u8) -> usize {
    let _ = (buf, size, n, f);
    0
}

pub unsafe fn fwrite(buf: *const u8, size: usize, n: usize, f: *mut u8) -> usize {
    let _ = (buf, size, n, f);
    0
}

pub unsafe fn opendir(path: *const u8) -> *mut u8 {
    let _ = path;
    0 as *mut u8
}

pub unsafe fn closedir(d: *mut u8) -> i32 {
    let _ = d;
    0
}

pub unsafe fn mkdir(path: *const u8, mode: u32) -> i32 {
    let _ = (path, mode);
    -1
}
