//! The garbage collector of native programs: a non-moving mark-sweep
//! collector over size-classed spans carved from one reserved arena.
//!
//! - Objects up to 8 KiB come from 64 KiB spans of one size class; larger
//!   objects get a span of their own (reused after they die).
//! - Spans holding types without pointers are marked noscan and never
//!   scanned.
//! - Roots are the stack (from the collector's frame up to main's frame)
//!   and the writable data section (statics). Roots and heap objects are
//!   scanned word by word: any word that points into an allocated object,
//!   including its interior, keeps it alive.
//! - A concurrent cycle (navi) marks with Go's hybrid write barrier: a store
//!   into the heap or a static shades the value it overwrites and the one
//!   it stores, so each stack is scanned once, when the cycle starts, and
//!   the cycle ends without rescanning any.
//! - Pacing (as Go's pacer): the heap may grow by what survived the last
//!   collection (at least 32 MiB; std::gc::set_percent changes the ratio,
//!   NAVI_GC=percent|off as GOGC) before the next one is done, at most to
//!   a memory limit if one is set (std::gc::set_memory_limit,
//!   NAVI_MEMLIMIT as GOMEMLIMIT). A cycle starts early enough to end
//!   there: the markers take a quarter of the threads, and a G allocating
//!   while they mark scans in proportion (a mark assist).
//!
//! Span metadata, mark bits and the mark stack live outside the arena
//! (libc calloc), so the collector itself never allocates GC memory.

#[cfg(not(target_os = "windows"))]
#[nonblocking]
extern "C" {
    fn mmap(addr: *mut u8, len: usize, prot: i32, flags: i32, fd: i32, off: i64) -> *mut u8;
}

#[cfg(target_os = "linux")]
#[nonblocking]
extern "C" {
    fn madvise(addr: *mut u8, len: usize, advice: i32) -> i32;
}

#[cfg(not(target_os = "windows"))]
#[nonblocking]
extern "C" {
    fn sysconf(name: i32) -> i64;
}

#[cfg(target_os = "windows")]
#[nonblocking]
extern "C" {
    fn VirtualAlloc(addr: *mut u8, size: usize, kind: u32, protect: u32) -> *mut u8;
    fn VirtualFree(addr: *mut u8, size: usize, kind: u32) -> i32;
}

#[nonblocking]
extern "C" {
    fn memset(p: *mut u8, c: i32, n: usize) -> *mut u8;
    fn calloc(n: usize, size: usize) -> *mut u8;
    fn realloc(p: *mut u8, size: usize) -> *mut u8;
    fn free(p: *mut u8);
}

#[cfg(target_os = "macos")]
const MAP_FLAGS: i32 = 0x1002; // MAP_ANON | MAP_PRIVATE
#[cfg(target_os = "linux")]
const MAP_FLAGS: i32 = 0x4022; // MAP_NORESERVE | MAP_ANONYMOUS | MAP_PRIVATE
#[cfg(target_os = "windows")]
const MAP_FLAGS: i32 = 0;

const PROT_RW: i32 = 3;
const PAGE_SHIFT: usize = 13;
const PAGE: usize = 8192;
const SPAN_BYTES: usize = 65536;
const ARENA_SIZE: usize = 34359738368; // 32 GiB of address space
const MIN_GC: usize = 33554432; // 32 MiB
const NCLASS: usize = 32;
const MAX_SMALL: usize = 8192;

static CLASSES: [usize; 32] = [16, 32, 48, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320, 384,
    448, 512, 640, 768, 896, 1024, 1280, 1536, 1792, 2048, 2560, 3072, 3584, 4096, 5120, 6144,
    7168, 8192];

struct Span {
    start: usize,
    bytes: usize,
    elem: usize,
    // (off * div_mul) >> 32 == off / elem for offsets within the span.
    div_mul: usize,
    nelems: usize,
    noscan: bool,
    // Free objects are linked through their first word; after them come
    // the objects never used (zero), from bump to the end (bump 0 once a
    // sweep has linked them all).
    freelist: usize,
    bump: usize,
    nfree: usize,
    // nelems allocation bytes followed by nelems mark bytes.
    bits: *mut u8,
    next_all: *mut Span,
    next_free: *mut Span,
    in_free: bool,
    list: usize, // index into FREE (small spans), or NCLASS * 2 for large spans
    // Dead (no object allocated) with its pages returned to the system
    // (see scavenge): zero when used again.
    released: bool,
    // Which words of each object hold pointers (C memory, made with the
    // first typed object; 0: scan every word): an entry per object, a byte
    // (objects up to 64 bytes) or a word (up to 512) of mask bits, word k
    // a pointer if bit k is set; past 512 bytes two words: the mask and
    // the words of the element type it repeats (0: scan every word).
    pm: usize,
}

static mut ARENA: usize = 0;
static mut ARENA_NEXT: usize = 0;
static mut ARENA_END: usize = 0;
static mut PAGES: usize = 0; // *mut *mut Span, one entry per page of the arena
static mut ALL: usize = 0; // *mut Span: every span
// Spans with free objects per class and noscan; [64]: dead spans (no
// object allocated: large spans, and small ones of any class), which any
// size class or large object may reuse (as Go's page heap); REL: dead
// spans whose pages were returned to the system.
static mut FREE: [usize; 65] = [0; 65];
static mut REL: usize = 0;
// The bytes of the arena returned to the system (in dead spans).
static mut RELEASED: usize = 0;
static mut ALLOCATED: usize = 0;
// What ALLOCATED starts a cycle at (between cycles), or makes the
// allocating G finish it (during one).
static mut NEXT_GC: usize = 0;
// What ALLOCATED should be when a cycle's mark ends (the heap goal less
// what survived the last cycle; see set_goal).
static mut GOAL: usize = 0;
// Where in [0, GOAL) a cycle starts, in thousandths (adjusted to what was
// allocated during the last mark).
static mut TRIGGER: usize = 875;
// Bytes of objects scanned this cycle (markers and assists add theirs in
// batches) and in the last one: what is left to scan, for the assists.
static mut SCAN_DONE: usize = 0;
static mut SCAN_LAST: usize = 0;
// How many assists hold grey objects (the markers do not end the mark
// meanwhile).
static mut ASSISTING: usize = 0;
// What the markers scanned that no assist has counted yet (as Go's
// bgScanCredit): an assist pays from it first.
static mut BG_CREDIT: usize = 0;
// The memory limit (bytes; NO_LIMIT: none) and the percent that turns the
// ratio off (only the limit starts a cycle).
static mut MEMLIMIT: usize = 18446744073709551615;
const NO_LIMIT: usize = 18446744073709551615;
const OFF: usize = 18446744073709551615;
static mut LIVE: usize = 0;
static mut COLLECTIONS: usize = 0;
// NAVI_GCPOISON=1 (debugging, with NAVI_GCSTW): freed objects are filled
// with 0xab, a free object found written or a GC allocation on a scheduler
// record (which a collector neither stops nor scans) is fatal.
pub static mut POISON_FREE: bool = false;

fn ld(p: usize) -> usize { unsafe { *(p as *const usize) } }
fn st(p: usize, v: usize) { unsafe { *(p as *mut usize) = v; } }
fn wget(p: usize) -> usize { unsafe { *(p as *const usize) } }
fn wset(p: usize, v: usize) { unsafe { *(p as *mut usize) = v; } }
fn ldb(p: usize) -> u8 { unsafe { *(p as *const u8) } }
fn stb(p: usize, v: u8) { unsafe { *(p as *mut u8) = v; } }

fn out_of_memory() -> ! {
    crate::rt::native::fatal("out of memory")
}

// reserve returns size bytes of address space; commit makes a part of it
// usable (a no-op where the kernel commits on first touch).
#[cfg(not(target_os = "windows"))]
fn reserve(size: usize) -> usize {
    let p = unsafe { mmap(0 as *mut u8, size, PROT_RW, MAP_FLAGS, -1, 0) } as usize;
    if p == 18446744073709551615 { 0 } else { p }
}

#[cfg(not(target_os = "windows"))]
fn commit(p: usize, size: usize) {}

#[cfg(target_os = "windows")]
fn reserve(size: usize) -> usize {
    unsafe { VirtualAlloc(0 as *mut u8, size, 0x2000, 4) as usize } // MEM_RESERVE, PAGE_READWRITE
}

#[cfg(target_os = "windows")]
fn commit(p: usize, size: usize) {
    let q = unsafe { VirtualAlloc(p as *mut u8, size, 0x1000, 4) } as usize; // MEM_COMMIT
    if q == 0 { out_of_memory(); }
}

// The system's page size (spans are aligned to PAGE, which may be less:
// macOS on arm64 has 16 KiB pages).
static mut OS_PAGE: usize = 0;

#[cfg(target_os = "macos")]
fn os_page() -> usize { unsafe { sysconf(29) as usize } } // _SC_PAGESIZE
#[cfg(target_os = "linux")]
fn os_page() -> usize { unsafe { sysconf(30) as usize } }
#[cfg(target_os = "windows")]
fn os_page() -> usize { 4096 }

// The whole system pages inside [p, p + size): [lo, hi) (empty at the
// end if there is none).
fn inner_pages(p: usize, size: usize) -> (usize, usize) {
    if OS_PAGE == 0 { OS_PAGE = os_page(); }
    let lo = (p + OS_PAGE - 1) / OS_PAGE * OS_PAGE;
    let hi = (p + size) / OS_PAGE * OS_PAGE;
    if lo < hi { (lo, hi) } else { (p + size, p + size) }
}

// Returns the whole system pages of [p, p + size) to the system (as Go's
// sysUnused): they read as zero when used again, after reuse_pages (which
// zeroes the rest).
#[cfg(target_os = "linux")]
fn release_os_pages(p: usize, size: usize) { unsafe { madvise(p as *mut u8, size, 4); } } // MADV_DONTNEED

// A fresh anonymous mapping over the range (MADV_FREE would leave the
// pages counted until the system needs them, and not zero).
#[cfg(target_os = "macos")]
fn release_os_pages(p: usize, size: usize) {
    let q = unsafe { mmap(p as *mut u8, size, PROT_RW, MAP_FLAGS | 0x10, -1, 0) } as usize; // MAP_FIXED
    if q != p { out_of_memory(); }
}

#[cfg(target_os = "windows")]
fn release_os_pages(p: usize, size: usize) { unsafe { VirtualFree(p as *mut u8, size, 0x4000); } } // MEM_DECOMMIT

fn release_pages(p: usize, size: usize) {
    let (lo, hi) = inner_pages(p, size);
    if lo < hi { release_os_pages(lo, hi - lo); }
}

#[cfg(target_os = "windows")]
fn reuse_os_pages(p: usize, size: usize) { commit(p, size); }
#[cfg(not(target_os = "windows"))]
fn reuse_os_pages(p: usize, size: usize) {}

fn reuse_pages(p: usize, size: usize) {
    let (lo, hi) = inner_pages(p, size);
    if lo < hi { reuse_os_pages(lo, hi - lo); }
    // The parts of system pages shared with other spans were kept.
    if lo > p { unsafe { memset(p as *mut u8, 0, lo - p); } }
    if p + size > hi { unsafe { memset(hi as *mut u8, 0, p + size - hi); } }
}

fn init() {
    let base = reserve(ARENA_SIZE);
    if base == 0 { out_of_memory(); }
    // Align the arena to a page.
    let aligned = (base + PAGE - 1) / PAGE * PAGE;
    ARENA = aligned;
    ARENA_NEXT = aligned;
    ARENA_END = base + ARENA_SIZE;
    let table_size = (ARENA_SIZE >> PAGE_SHIFT) * 8;
    let table = reserve(table_size);
    if table == 0 { out_of_memory(); }
    commit(table, table_size);
    PAGES = table;
    MAIN = new_stack();
    POOL = new_stack();
    SHARED = new_stack();
    LOCAL = unsafe { calloc(MAX_MARKERS * 4, 8) } as usize;
    let mut k = 0;
    while k <= MAX_SMALL / 16 {
        CLASS_OF[k] = class_of(if k == 0 { 1 } else { k * 16 }) as u8;
        k += 1;
    }
    read_env();
    set_goal(0);
    span_offsets();
}

// NAVI_GC=percent|off and NAVI_MEMLIMIT=bytes (a suffix B, KiB, MiB, GiB or
// TiB), as Go's GOGC and GOMEMLIMIT.
fn read_env() {
    if let Some(v) = crate::rt::native::getenv_c(b"NAVI_GC\0") {
        if v == "off" { PERCENT = OFF; } else if let Some(n) = parse_size(v) { PERCENT = n; }
    }
    if let Some(v) = crate::rt::native::getenv_c(b"NAVI_MEMLIMIT\0") {
        if let Some(n) = parse_size(v) { MEMLIMIT = n; }
    }
}

fn parse_size(v: &str) -> Option<usize> {
    let b = v.as_bytes();
    let mut n = 0usize;
    let mut i = 0;
    while i < b.len() && b[i] >= b'0' && b[i] <= b'9' {
        n = n * 10 + (b[i] - b'0') as usize;
        i += 1;
    }
    if i == 0 { return None; }
    let unit = &v[i..];
    let shift = if unit == "" || unit == "B" { 0 } else if unit == "KiB" { 10 } else if unit == "MiB" { 20 } else if unit == "GiB" { 30 } else if unit == "TiB" { 40 } else { return None; };
    Some(n << shift)
}

/// The size class of each size up to MAX_SMALL in 16-byte steps.
static mut CLASS_OF: [u8; 513] = [0; 513];

/// Allocates size zeroed bytes. noscan objects hold no pointers. The fast
/// path (a free object in the first span of the size class) is written out
/// in this one function.
pub fn alloc(size: usize, noscan: bool) -> *mut u8 {
    // (Every word may be a pointer: the runtime's own allocations.)
    alloc0(size, noscan, ALL_WORDS, 0)
}

const ALL_WORDS: usize = 18446744073709551615;

/// Allocates size zeroed bytes for values of a type whose pointer words
/// are mask's bits, tw words long (repeated: an array); mask 0: no
/// pointers; tw 0: every word may be one (as Go's heap bitmap, written at
/// allocation).
pub fn alloc_typed(size: usize, mask: usize, tw: usize) -> *mut u8 {
    let noscan = mask == 0 && tw != 0;
    // (The common way straight to the threads' allocator.)
    if MULTI && !POISON_FREE { return alloc_mt(size, noscan, mask, tw); }
    alloc0(size, noscan, mask, tw)
}

/// The same for an array of such values (the mask repeated every tw words).
pub fn alloc_array_typed(size: usize, mask: usize, tw: usize) -> *mut u8 {
    if mask == 0 && tw != 0 { return alloc0(size, true, 0, 0); }
    let p = alloc0(size, false, mask, tw);
    set_info(p as usize, mask, tw, true);
    p
}

// The bytes of an object's entry in its span's mask table.
fn pm_width(elem: usize) -> usize { if elem <= 64 { 1 } else if elem <= 512 { 8 } else { 16 } }

// Records the pointer words of the object at p (allocated, its span's):
// mask (repeated every tw words for an array).
fn set_info(p: usize, mask: usize, tw: usize, array: bool) {
    let s = ld(PAGES + ((p - ARENA) >> PAGE_SHIFT) * 8) as *mut Span;
    unsafe {
        let elem = (*s).elem;
        let w = pm_width(elem);
        if (*s).pm == 0 {
            let t = calloc((*s).nelems, w) as usize;
            if t == 0 { out_of_memory(); }
            (*s).pm = t;
        }
        let n = (*s).nelems;
        let i = if n == 1 { 0 } else { ((p - (*s).start) * (*s).div_mul) >> 32 };
        let e = (*s).pm + i * w;
        if w == 16 {
            wset(e, mask);
            wset(e + 8, tw);
            return;
        }
        // The object's words (up to 64), the type's mask repeated.
        let words = elem >> 3;
        let mut m = mask;
        if tw == 0 || tw > 64 {
            m = ALL_WORDS;
        } else if array && tw < words {
            let mut k = tw;
            while k < words {
                m = m | (mask << k as u32);
                k += tw;
            }
        }
        // (No bit past the object: its neighbour's words.)
        if words < 64 { m = m & ((1usize << words as u32) - 1); }
        if w == 1 { stb(e, (m & 255) as u8); } else { wset(e, m); }
    }
}

fn alloc0(size: usize, noscan: bool, mask: usize, tw: usize) -> *mut u8 {
    if MULTI {
        if POISON_FREE && crate::rt::sched::on_g0() { crate::rt::native::fatal("GC allocation on a scheduler record"); }
        return alloc_mt(size, noscan, mask, tw);
    }
    let p = alloc1(size, noscan);
    if !noscan { set_info(p as usize, mask, tw, false); }
    p
}

// The single-threaded allocator (before a second OS thread exists).
fn alloc1(size: usize, noscan: bool) -> *mut u8 {
    if ALLOCATED >= NEXT_GC {
        if ARENA == 0 { init(); } else { collect_locked(); }
    }
    if size > MAX_SMALL { return alloc_large(size, noscan) as *mut u8; }
    let c = CLASS_OF[(size + 15) >> 4] as usize;
    let list = c * 2 + if noscan { 1 } else { 0 };
    let s = FREE[list] as *mut Span;
    unsafe {
        if s as usize != 0 && (*s).nfree > 0 {
            let elem = (*s).elem;
            let mut p = (*s).freelist;
            if p != 0 {
                (*s).freelist = *(p as *const usize);
                // Zero the object (the free list link is in its first word).
                if elem <= 64 {
                    let mut q = p;
                    while q < p + elem {
                        *(q as *mut usize) = 0;
                        q += 8;
                    }
                } else {
                    memset(p as *mut u8, 0, elem);
                }
            } else {
                p = (*s).bump;
                (*s).bump = p + elem;
            }
            (*s).nfree -= 1;
            let i = ((p - (*s).start) * (*s).div_mul) >> 32;
            *(((*s).bits as usize + i) as *mut u8) = 1;
            if MARKING { *(((*s).bits as usize + (*s).nelems + i) as *mut u8) = 1; } // allocated black
            ALLOCATED += elem;
            return p as *mut u8;
        }
    }
    alloc_small(c, noscan) as *mut u8
}

/// Set (by the scheduler) once a second OS thread exists.
pub static mut MULTI: bool = false;

// With several OS threads (navi): small objects come from spans the M
// keeps for itself (sched::m_cache), without the runtime lock; a span is
// taken from the shared lists, and counted as allocated, under the lock
// when the M's one is used up. Large objects are allocated under the lock.
fn alloc_mt(size: usize, noscan: bool, mask: usize, tw: usize) -> *mut u8 {
    if size <= MAX_SMALL {
        let c = CLASS_OF[(size + 15) >> 4] as usize;
        let list = c * 2 + if noscan { 1 } else { 0 };
        let slot = crate::rt::sched::m_cache() + list * 8;
        // No call (safepoint) from reading the cache to taking the object: a
        // collector may empty the caches whenever this G stops.
        unsafe {
            let s = *(slot as *const usize) as *mut Span;
            if s as usize != 0 && (*s).nfree > 0 {
                let elem = (*s).elem;
                let mut p = (*s).freelist;
                if p != 0 {
                    if POISON_FREE {
                        // A free object's link points into its span (else a
                        // live object was freed and written).
                        let nx = *(p as *const usize);
                        if nx != 0 && (nx < (*s).start || nx >= (*s).start + (*s).bytes) { crate::rt::native::fatal("a free object was written (NAVI_GCPOISON)"); }
                    }
                    (*s).freelist = *(p as *const usize);
                    let mut q = p;
                    while q < p + elem {
                        *(q as *mut usize) = 0;
                        q += 8;
                    }
                } else {
                    // A never used object: zero, not read.
                    p = (*s).bump;
                    (*s).bump = p + elem;
                }
                (*s).nfree -= 1;
                let i = ((p - (*s).start) * (*s).div_mul) >> 32;
                *(((*s).bits as usize + i) as *mut u8) = 1;
                if MARKING { *(((*s).bits as usize + (*s).nelems + i) as *mut u8) = 1; }
                if !noscan {
                    // Its pointer words, in the entry of the span's table
                    // (made, and wider entries, the slow way).
                    let pm = (*s).pm;
                    if pm != 0 && elem <= 512 {
                        let m = if tw != 0 { mask } else if elem < 512 { (1usize << (elem >> 3) as u32) - 1 } else { ALL_WORDS };
                        if elem <= 64 { *((pm + i) as *mut u8) = m as u8; } else { *((pm + 8 * i) as *mut usize) = m; }
                    } else {
                        set_info(p, mask, tw, false);
                    }
                }
                return p as *mut u8;
            }
        }
        // An assist first (as Go's mallocgc): it may stop the G, and a
        // cycle end and another start meanwhile; the object it returns must
        // be the new cycle's (its initializing stores have no barrier).
        if MARKING { assist(SPAN_BYTES); }
        // The shared lists have locks of their own (as Go's mcentral); the
        // runtime lock only for a collection.
        if ALLOCATED >= NEXT_GC {
            // Again under the lock: another G may have collected meanwhile
            // (else each waiter would start another cycle).
            crate::rt::sched::lock();
            if ALLOCATED >= NEXT_GC { collect_locked(); }
            crate::rt::sched::unlock();
        }
        crate::rt::sched::preempt_off();
        let ns = refill(c, list);
        st(crate::rt::sched::m_cache() + list * 8, ns as usize);
        let p = take_owned(ns);
        crate::rt::sched::preempt_on();
        if !noscan { set_info(p, mask, tw, false); }
        return p as *mut u8;
    }
    if MARKING { assist(size); }
    if ALLOCATED >= NEXT_GC {
        crate::rt::sched::lock();
        if ALLOCATED >= NEXT_GC { collect_locked(); }
        crate::rt::sched::unlock();
    }
    crate::rt::sched::preempt_off();
    let p = alloc_large(size, noscan);
    crate::rt::sched::preempt_on();
    if !noscan { set_info(p, mask, tw, false); }
    p as *mut u8
}

// --- Mark assists (as Go's gcAssistAlloc) ---------------------------------------
//
// While a mark runs, a G that took bytes from the heap scans grey objects
// in proportion: what is left to scan (about what the last cycle scanned)
// over what is left to allocate before the goal, so that the mark ends by
// then (past the goal: until no grey object is left to take).
// Bytes the assists scanned this cycle (NAVI_GCTRACE).
static mut ASSISTED: usize = 0;

fn assist(bytes: usize) {
    if !crate::rt::sched::may_assist() { return; }
    let alloc = ALLOCATED;
    let left_heap = if GOAL > alloc { GOAL - alloc } else { 0 };
    let done = crate::rt::atomic_load(&mut SCAN_DONE as *mut usize);
    let expect = if SCAN_LAST != 0 { SCAN_LAST } else { LIVE };
    // (Past what was expected: more is left than thought.)
    let left_scan = if expect > done + expect / 16 { expect - done } else { expect / 16 };
    if left_scan == 0 { return; }
    let mut debt = if left_heap <= bytes { left_scan } else { ((bytes as u128) * (left_scan as u128) / (left_heap as u128)) as usize };
    // What the markers did counts first.
    loop {
        let c = crate::rt::atomic_load(&mut BG_CREDIT as *mut usize);
        if c == 0 { break; }
        let take = if c < debt { c } else { debt };
        if crate::rt::atomic_cas(&mut BG_CREDIT as *mut usize, c, c - take) {
            debt -= take;
            break;
        }
    }
    if debt > 0 { assist_scan(debt); }
}

// Scans about debt bytes of grey objects (taken from the shared ones onto
// the M's write barrier buffer, a stack the collector sees), in batches
// during which the G does not stop; what it greys is shared. Finding no
// grey object anywhere, it ends the mark itself (as Go's assists call
// gcMarkDone: the markers may not get a thread soon).
fn assist_scan(debt: usize) {
    let mut done = 0usize;
    let cyc = CYCLE_NO;
    while done < debt {
        crate::rt::sched::preempt_off();
        if !MARKING || MARK_DONE {
            crate::rt::sched::preempt_on();
            return;
        }
        let me = crate::rt::sched::m_wbuf();
        let mut batch = 0usize;
        let mut empty = false;
        crate::rt::atomic_add(&mut ASSISTING as *mut usize, 1);
        while batch < 65536 && me != 0 {
            let mut obj = stack_pop(me);
            if obj == 0 && !STACKS_DONE {
                scan_stacks(2, me);
                obj = stack_pop(me);
            }
            if obj == 0 {
                mark_lock();
                if take_few(me) { obj = stack_pop(me); }
                mark_unlock();
                if obj == 0 {
                    empty = true;
                    break;
                }
            }
            batch += scan_object(obj, me);
        }
        if me != 0 && stack_len(me) > 0 {
            mark_lock();
            move_all(me, SHARED);
            mark_unlock();
        }
        crate::rt::atomic_add(&mut ASSISTING as *mut usize, 18446744073709551615);
        crate::rt::atomic_add(&mut SCAN_DONE as *mut usize, batch);
        crate::rt::atomic_add(&mut ASSISTED as *mut usize, batch);
        let mut finish = false;
        if empty {
            mark_lock();
            // (This assist no longer counts.)
            if !MARK_DONE && crate::rt::atomic_load(&mut ASSISTING as *mut usize) == 0 && STACKS_DONE && no_grey() {
                MARK_DONE = true;
                finish = true;
            }
            mark_unlock();
        }
        crate::rt::sched::preempt_on();
        if finish {
            crate::rt::sched::lock();
            if CYCLE_NO == cyc { finish_cycle(); }
            crate::rt::sched::unlock();
            return;
        }
        done += batch;
        if empty || me == 0 { return; }
    }
}

// Whether the pool, the shared objects and every marker's stack are empty
// (mark_lock held; a marker in a batch may hold some still, and write
// barriers' buffers: the final stop drains them).
fn no_grey() -> bool {
    if stack_len(POOL) != 0 || stack_len(SHARED) != 0 { return false; }
    let mut k = 0;
    while k < MAX_MARKERS {
        if LOCAL != 0 && stack_len(LOCAL + k * 32) != 0 { return false; }
        k += 1;
    }
    true
}

// A span of class c with free objects for an M's cache (the runtime lock
// is held): taken off the shared list, its free objects counted as
// allocated.
fn refill(c: usize, list: usize) -> *mut Span {
    let mut budget = 16;
    loop {
        let l = list_lk(list);
        spin_lock(l);
        let mut found = 0usize;
        loop {
            let s = FREE[list] as *mut Span;
            if s as usize == 0 { break; }
            unsafe {
                FREE[list] = (*s).next_free as usize;
                (*s).in_free = false;
                if (*s).nfree > 0 {
                    found = s as usize;
                    break;
                }
            }
        }
        spin_unlock(l);
        if found != 0 {
            let s = found as *mut Span;
            add_allocated(unsafe { (*s).nfree * (*s).elem });
            return s;
        }
        // Sweep a little (others' spans go to their lists), at most 256.
        if UNSWEPT != 0 && budget > 0 {
            sweep_some(16);
            budget -= 1;
            continue;
        }
        break;
    }
    let s = small_span(c, list);
    add_allocated(unsafe { (*s).nfree * (*s).elem });
    s
}

// A span for size class c (free list list): a dead one, else a new one.
fn small_span(c: usize, list: usize) -> *mut Span {
    let s = take_dead(SPAN_BYTES, SPAN_BYTES, list);
    if s as usize == 0 { return new_span(CLASSES[c], SPAN_BYTES, list & 1 == 1, list); }
    unsafe {
        if (*s).released {
            unrelease(s);
        } else if (*s).list != list {
            memset((*s).start as *mut u8, 0, (*s).bytes);
        }
        // (Of this class and not released: its free list links every object.)
        if (*s).list != list || (*s).bump != 0 { relayout(s, CLASSES[c], list); }
    }
    s
}

// Takes a dead span of lo to hi bytes off its list: one whose pages are
// still in use first. While a mark runs, only one of layout list (a
// marker may be reading a span's layout).
fn take_dead(lo: usize, hi: usize, list: usize) -> *mut Span {
    let l = list_lk(64);
    spin_lock(l);
    let mut s = unlink_dead((&mut FREE as *mut [usize; 65] as usize + 64 * 8) as *mut usize, lo, hi, list);
    if s == 0 { s = unlink_dead(&mut REL as *mut usize, lo, hi, list); }
    spin_unlock(l);
    s as *mut Span
}

fn unlink_dead(head: *mut usize, lo: usize, hi: usize, list: usize) -> usize {
    let mut prev = 0usize;
    let mut s = unsafe { *head };
    while s != 0 {
        let sp = s as *mut Span;
        unsafe {
            if (*sp).bytes >= lo && (*sp).bytes <= hi && ((*sp).list == list || !CYCLE) {
                if prev == 0 { *head = (*sp).next_free as usize; } else { (*(prev as *mut Span)).next_free = (*sp).next_free; }
                (*sp).in_free = false;
                return s;
            }
            prev = s;
            s = (*sp).next_free as usize;
        }
    }
    0
}

// A released span's pages in use again (zero).
fn unrelease(s: *mut Span) {
    unsafe {
        reuse_pages((*s).start, (*s).bytes);
        (*s).released = false;
        crate::rt::atomic_add(&mut RELEASED as *mut usize, 0usize.wrapping_sub((*s).bytes));
    }
}

// Makes dead span s (its memory zero) one of objects of elem bytes on
// free list list, all taken from the bump pointer.
fn relayout(s: *mut Span, elem: usize, list: usize) {
    unsafe {
        let n = (*s).bytes / elem;
        if n != (*s).nelems {
            // (A dead span's allocation and mark bytes are all zero.)
            free((*s).bits);
            (*s).bits = calloc(2 * n, 1);
        }
        // (Its mask table is made again with the first typed object.)
        if (*s).pm != 0 {
            free((*s).pm as *mut u8);
            (*s).pm = 0;
        }
        (*s).elem = elem;
        (*s).div_mul = if elem >= 4294967296 { 0 } else { 4294967295 / elem + 1 };
        (*s).nelems = n;
        (*s).noscan = list & 1 == 1;
        (*s).list = list;
        (*s).freelist = 0;
        (*s).bump = (*s).start;
        (*s).nfree = n;
    }
}

// The locks of the shared span lists and of the heap (new spans, the
// unswept cursor): spin locks taken only while the G may not stop, so that
// no stopped G holds one when a collector runs.
static mut LIST_LK: [usize; 65] = [0; 65];
static mut HEAP_LK: usize = 0;

fn list_lk(list: usize) -> *mut usize { (&mut LIST_LK as *mut [usize; 65] as usize + list * 8) as *mut usize }

fn spin_lock(p: *mut usize) {
    while !crate::rt::atomic_cas(p, 0, 1) { crate::rt::sched::cpu_relax(); }
}
fn spin_unlock(p: *mut usize) { crate::rt::atomic_store(p, 0); }
fn add_allocated(n: usize) { crate::rt::atomic_add(&mut ALLOCATED as *mut usize, n); }

// Pops a free object of a span the M owns and zeroes it.
fn take_owned(s: *mut Span) -> usize {
    unsafe {
        let elem = (*s).elem;
        let mut p = (*s).freelist;
        if p != 0 {
            (*s).freelist = *(p as *const usize);
            if elem <= 64 {
                let mut q = p;
                while q < p + elem {
                    *(q as *mut usize) = 0;
                    q += 8;
                }
            } else {
                memset(p as *mut u8, 0, elem);
            }
        } else {
            p = (*s).bump;
            (*s).bump = p + elem;
        }
        (*s).nfree -= 1;
        let i = ((p - (*s).start) * (*s).div_mul) >> 32;
        *(((*s).bits as usize + i) as *mut u8) = 1;
        if MARKING { *(((*s).bits as usize + (*s).nelems + i) as *mut u8) = 1; }
        p
    }
}

fn class_of(size: usize) -> usize {
    let mut c = 0;
    while CLASSES[c] < size { c += 1; }
    c
}

fn alloc_small(c: usize, noscan: bool) -> usize {
    let list = c * 2 + if noscan { 1 } else { 0 };
    loop {
        let s = FREE[list] as *mut Span;
        if s as usize == 0 { break; }
        unsafe {
            if (*s).nfree > 0 { return take(s); }
            FREE[list] = (*s).next_free as usize;
            (*s).in_free = false;
        }
    }
    if UNSWEPT != 0 && sweep_for(list) { return alloc_small(c, noscan); }
    let s = small_span(c, list);
    unsafe {
        (*s).next_free = FREE[list] as *mut Span;
        (*s).in_free = true;
    }
    FREE[list] = s as usize;
    take(s)
}

// take pops a free object of s, zeroes it and marks it allocated.
fn take(s: *mut Span) -> usize {
    unsafe {
        let mut p = (*s).freelist;
        if p != 0 {
            (*s).freelist = *(p as *const usize);
            memset(p as *mut u8, 0, (*s).elem);
        } else {
            p = (*s).bump;
            (*s).bump = p + (*s).elem;
        }
        (*s).nfree -= 1;
        let i = ((p - (*s).start) * (*s).div_mul) >> 32;
        *(((*s).bits as usize + i) as *mut u8) = 1;
        if MARKING { *(((*s).bits as usize + (*s).nelems + i) as *mut u8) = 1; }
        ALLOCATED += (*s).elem;
        p
    }
}

fn alloc_large(size: usize, noscan: bool) -> usize { alloc_large_in(size, noscan, 4) }

// tries: how many more batches of spans may be swept for a fitting one.
fn alloc_large_in(size: usize, noscan: bool, tries: usize) -> usize {
    let bytes = (size + PAGE - 1) / PAGE * PAGE;
    // Reuse a dead span that fits (first fit, at most twice the size).
    let s = take_dead(bytes, 2 * bytes, NCLASS * 2);
    if s as usize != 0 {
        unsafe {
            if (*s).released { unrelease(s); } else { memset((*s).start as *mut u8, 0, (*s).bytes); }
            if (*s).list != NCLASS * 2 {
                relayout(s, (*s).bytes, NCLASS * 2);
                (*s).bump = 0;
                (*s).nfree = 0;
            }
            (*s).noscan = noscan;
            stb((*s).bits as usize, 1);
            if MARKING { stb((*s).bits as usize + 1, 1); }
            add_allocated((*s).bytes);
            return (*s).start;
        }
    }
    if UNSWEPT != 0 && tries > 0 {
        // Sweep a little more and look again.
        sweep_some(64);
        return alloc_large_in(size, noscan, tries - 1);
    }
    let s = new_span(bytes, bytes, noscan, NCLASS * 2);
    unsafe {
        (*s).freelist = 0;
        (*s).bump = 0;
        (*s).nfree = 0;
        stb((*s).bits as usize, 1);
        if MARKING { stb((*s).bits as usize + 1, 1); }
        add_allocated(bytes);
        (*s).start
    }
}

// A new span: the heap lock only to cut its pages off the arena and to put
// it on the span list (it is set up in between: no other thread sees it
// before; a concurrent mark ignores pages past its LIMIT).
fn new_span(elem: usize, bytes: usize, noscan: bool, list: usize) -> *mut Span {
    spin_lock(&mut HEAP_LK as *mut usize);
    let start = ARENA_NEXT;
    if start + bytes > ARENA_END { out_of_memory(); }
    ARENA_NEXT = start + bytes;
    spin_unlock(&mut HEAP_LK as *mut usize);
    commit(start, bytes);
    let s = unsafe { calloc(1, crate::intrinsics::size_of::<Span>()) } as *mut Span;
    let nelems = bytes / elem;
    unsafe {
        (*s).start = start;
        (*s).bytes = bytes;
        (*s).elem = elem;
        (*s).div_mul = if elem >= 4294967296 { 0 } else { 4294967295 / elem + 1 };
        (*s).nelems = nelems;
        (*s).noscan = noscan;
        (*s).bits = calloc(2 * nelems, 1);
        (*s).list = list;
        // Its objects are taken from the bump pointer (not linked: their
        // memory is not touched until used).
        (*s).freelist = 0;
        (*s).bump = start;
        (*s).nfree = nelems;
    }
    let mut pg = start;
    while pg < start + bytes {
        st(PAGES + ((pg - ARENA) >> PAGE_SHIFT) * 8, s as usize);
        pg += PAGE;
    }
    if VERIFY { crate::rt::sched::check_alloc_stopped(); }
    spin_lock(&mut HEAP_LK as *mut usize);
    unsafe { (*s).next_all = ALL as *mut Span; }
    ALL = s as usize;
    spin_unlock(&mut HEAP_LK as *mut usize);
    s
}

// --- Marking -----------------------------------------------------------------

// A mark stack is four words [buf, len, cap, bytes marked] (C memory). MAIN is the
// collector's (used while the world is stopped); each concurrent marker G
// has its own (LOCAL). A marker pops and scans an object, and moves objects
// between stacks and the pool, only while it may not stop, so a stopped
// marker leaves every grey object on a stack the collector can see.
fn stack_push(sk: usize, obj: usize) {
    let n = wget(sk + 8);
    if n == wget(sk + 16) {
        let cap = if n == 0 { 1024 } else { n * 2 };
        let b = unsafe { realloc(wget(sk) as *mut u8, cap * 8) } as usize;
        if b == 0 { out_of_memory(); }
        wset(sk, b);
        wset(sk + 16, cap);
    }
    wset(wget(sk) + n * 8, obj);
    wset(sk + 8, n + 1);
}

fn stack_pop(sk: usize) -> usize {
    let n = wget(sk + 8);
    if n == 0 { return 0; }
    wset(sk + 8, n - 1);
    wget(wget(sk) + (n - 1) * 8)
}

fn stack_len(sk: usize) -> usize { wget(sk + 8) }

fn push(obj: usize) { stack_push(MAIN, obj); }
fn pop() -> usize { stack_pop(MAIN) }

// The objects the write barriers of other threads mark wait here for a
// marker (under mark_lock; no navi call while it is held).
static mut SHARED: usize = 0; // a stack

fn push_shared(obj: usize) {
    mark_lock();
    stack_push(SHARED, obj);
    mark_unlock();
}

// Moves every object of stack from onto stack to (mark_lock held or the
// world stopped).
fn move_all(from: usize, to: usize) -> bool {
    let n = stack_len(from);
    let mut i = 0;
    while i < n {
        stack_push(to, wget(wget(from) + i * 8));
        i += 1;
    }
    wset(from + 8, 0);
    n > 0
}

// Moves what other marking left (the shared objects, the pool, the
// markers' stacks) onto MAIN; false if there was nothing (the world is
// stopped or no marker runs).
fn take_shared() -> bool {
    mark_lock();
    let mut any = move_all(SHARED, MAIN);
    if move_all(POOL, MAIN) { any = true; }
    let mut w = 0;
    loop {
        let b = crate::rt::sched::wbuf_at(w);
        if b == crate::rt::sched::WBUF_END { break; }
        if b != 0 && move_all(b, MAIN) { any = true; }
        w += 1;
    }
    let mut k = 0;
    while k < MAX_MARKERS {
        if LOCAL != 0 && stack_len(LOCAL + k * 32) > 0 {
            move_all(LOCAL + k * 32, MAIN);
            any = true;
        }
        k += 1;
    }
    mark_unlock();
    any
}

/// Marks every object a word in [lo, hi) points into (by the collector).
pub(crate) fn scan_range(lo: usize, hi: usize) { scan(lo, hi, MAIN); }

/// The same, queuing what it marks on mark stack dst (0: the M's write
/// barrier buffer).
pub(crate) fn scan_into(lo: usize, hi: usize, dst: usize) { scan(lo, hi, dst); }

/// The collector's mark stack (for sched's scans with the world stopped).
pub(crate) fn main_dst() -> usize { MAIN }

/// The current cycle's number.
pub fn cycle_no() -> usize { CYCLE_NO }

/// Scans the running G's own stack and registers (the world stopped).
pub(crate) fn scan_own_stack() {
    crate::rt::spill_registers(&mut SAVED_REGS as *mut [usize; 10] as *mut usize);
    let lo = crate::rt::stack_pointer() as usize;
    crate::rt::sched::scan_stack(lo, crate::rt::frame_address() as usize, crate::rt::sched::current_stack_hi());
    scan_range(&SAVED_REGS as *const [usize; 10] as usize, &SAVED_REGS as *const [usize; 10] as usize + 80);
}

// --- Stacks, scanned while the program runs (as Go's markroot jobs) ------------
//
// The Gs of the ALL list as the cycle started (later ones have empty
// stacks), from STK_CUR on, then those that were running when tried
// (STK_PEND, C memory: asked to scan themselves, tried again).
static mut STK_LK: usize = 0;
static mut STK_CUR: usize = 0;
static mut STK_PEND: usize = 0;
static mut STK_N: usize = 0;
static mut STK_CAP: usize = 0;
static mut STK_BUSY: usize = 0;
static mut STACKS_DONE: bool = true;
/// Whether the stacks are scanned while the program runs.
pub fn conc_stacks() -> bool {
    if CONC_STACKS == 0 { CONC_STACKS = if crate::rt::native::env_set(b"NAVI_GCCONCSTACKS\0") { 1 } else { 2 }; }
    CONC_STACKS == 1
}

// NAVI_GCCONCSTACKS=1 (being finished): the stacks are scanned while the
// program runs (as Go's); else when a cycle starts, the world stopped (1:
// on, 2: off).
static mut CONC_STACKS: usize = 0;

// Scans up to budget stacks onto mark stack dst (the G may not stop);
// whether every stack is scanned.
fn scan_stacks(budget: usize, dst: usize) -> bool {
    if STACKS_DONE { return true; }
    let mut k = 0;
    while k < budget {
        spin_lock(&mut STK_LK as *mut usize);
        let mut g = STK_CUR;
        if g != 0 {
            STK_CUR = crate::rt::sched::all_next(g);
        } else if STK_N > 0 {
            STK_N -= 1;
            g = wget(STK_PEND + 8 * STK_N);
        } else {
            if STK_BUSY == 0 { STACKS_DONE = true; }
            spin_unlock(&mut STK_LK as *mut usize);
            return STACKS_DONE;
        }
        STK_BUSY += 1;
        spin_unlock(&mut STK_LK as *mut usize);
        let ok = crate::rt::sched::scan_g(g, CYCLE_NO, dst);
        spin_lock(&mut STK_LK as *mut usize);
        STK_BUSY -= 1;
        if !ok {
            if STK_N == STK_CAP {
                STK_CAP = if STK_CAP == 0 { 256 } else { STK_CAP * 2 };
                STK_PEND = unsafe { realloc(STK_PEND as *mut u8, STK_CAP * 8) } as usize;
                if STK_PEND == 0 { out_of_memory(); }
            }
            wset(STK_PEND + 8 * STK_N, g);
            STK_N += 1;
        }
        spin_unlock(&mut STK_LK as *mut usize);
        k += 1;
    }
    false
}


// navi: the loop is the backend's leaf routine (generated navi code keeps
// every value in memory; this loop runs over the whole live heap). It
// stops at the words to mark.
fn scan(lo: usize, hi: usize, dst: usize) {
    let arena = ARENA;
    // During a concurrent mark, spans made since it started hold only
    // objects allocated black (or free ones): not read.
    let next = if CYCLE { LIMIT } else { ARENA_NEXT };
    let pages = PAGES;
    let mut p = (lo + 7) / 8 * 8;
    loop {
        p = crate::rt::scan_words(p, hi, arena, next, pages, SPAN_OFFS);
        if p == 0 { return; }
        // Read again: a running mutator may have changed the word since
        // (its write barrier shaded the new value; either may be marked).
        let w = ld(p - 8);
        if w < arena || w >= next { continue; }
        let s = ld(pages + ((w - arena) >> PAGE_SHIFT) * 8) as *mut Span;
        if s as usize == 0 { continue; }
        let n = unsafe { (*s).nelems };
        let i = if n == 1 { 0 } else { unsafe { ((w - (*s).start) * (*s).div_mul) >> 32 } };
        if i >= n { continue; }
        let bits = unsafe { (*s).bits } as usize;
        if ldb(bits + i) == 0 || ldb(bits + n + i) != 0 { continue; }
        mark_found(s, i, dst);
    }
}

/// The offsets of Span's start, nelems, div_mul and bits, a byte each (for
/// scan_words).
static mut SPAN_OFFS: usize = 0;

fn span_offsets() {
    let s = unsafe { calloc(1, crate::mem::size_of::<Span>()) } as *mut Span;
    unsafe {
        let start = &mut (*s).start as *mut usize as usize - s as usize;
        let nelems = &mut (*s).nelems as *mut usize as usize - s as usize;
        let div_mul = &mut (*s).div_mul as *mut usize as usize - s as usize;
        let bits = &mut (*s).bits as *mut *mut u8 as usize - s as usize;
        SPAN_OFFS = start | nelems << 8 | div_mul << 16 | bits << 24;
    }
}

// Marks object i of s (allocated, seen unmarked) and queues it.
fn mark_found(s: *mut Span, i: usize, dst: usize) {
    unsafe {
        let n = (*s).nelems;
        let start = (*s).start;
        let m = ((*s).bits as usize + n + i) as *mut u8;
        // Two markers may both get here: the object is scanned twice.
        *m = 1;
        // The bytes marked (the live heap of a lazily swept cycle). A
        // write barrier's go to its M's buffer, shared when full.
        let mut to = dst;
        if dst == 0 { to = crate::rt::sched::m_wbuf(); }
        if to == 0 { count_shared((*s).elem); } else { wset(to + 24, wget(to + 24) + (*s).elem); }
        if (*s).noscan { return; }
        if to == 0 {
            push_shared(start + i * (*s).elem);
        } else {
            stack_push(to, start + i * (*s).elem);
            if dst == 0 && stack_len(to) >= 256 {
                mark_lock();
                move_all(to, SHARED);
                mark_unlock();
            }
        }
    }
}

// Scans obj (precisely: the words its entry in its span's mask table
// says hold pointers); its size.
fn scan_object(obj: usize, dst: usize) -> usize {
    let s = unsafe { *((PAGES + ((obj - ARENA) >> PAGE_SHIFT) * 8) as *const usize) } as *mut Span;
    let (elem, pm, n) = unsafe { ((*s).elem, (*s).pm, (*s).nelems) };
    if pm == 0 {
        scan(obj, obj + elem, dst);
        return elem;
    }
    let i = if n == 1 { 0 } else { unsafe { ((obj - (*s).start) * (*s).div_mul) >> 32 } };
    if elem <= 512 {
        let m = if elem <= 64 { ldb(pm + i) as usize } else { wget(pm + 8 * i) };
        // Every word a pointer: one range.
        let words = elem >> 3;
        if m == ALL_WORDS || words < 64 && m == (1usize << words as u32) - 1 {
            scan(obj, obj + elem, dst);
        } else {
            scan_mask(obj, m, dst);
        }
    } else {
        let e = pm + 16 * i;
        let mask = unsafe { *(e as *const usize) };
        let tw = unsafe { *((e + 8) as *const usize) };
        // Every word (unknown, or an array of pointers): one range.
        if tw == 0 || tw > 64 || (tw < 64 && mask == (1usize << tw as u32) - 1) || (tw == 64 && mask == ALL_WORDS) {
            scan(obj, obj + elem, dst);
        } else {
            let step = tw * 8;
            let mut b = obj;
            while b + step <= obj + elem {
                scan_mask(b, mask, dst);
                b += step;
            }
        }
    }
    elem
}

// Marks what the words at base whose bits in m are set point to (each
// checked here, as scan_words does a range).
fn scan_mask(base: usize, m0: usize, dst: usize) {
    if m0 == ALL_WORDS {
        scan(base, base + 512, dst);
        return;
    }
    let arena = ARENA;
    let next = if CYCLE { LIMIT } else { ARENA_NEXT };
    let pages = PAGES;
    let mut m = m0;
    let mut p = base;
    loop {
        let q = crate::rt::scan_bits(p, m, arena, next, pages, SPAN_OFFS);
        if q == 0 { return; }
        // (Read again, as scan does: a mutator may have written it since.)
        let w = ld(q - 8);
        if w >= arena && w < next {
            let s = ld(pages + ((w - arena) >> PAGE_SHIFT) * 8) as *mut Span;
            if s as usize != 0 {
                let n = unsafe { (*s).nelems };
                let i = if n == 1 { 0 } else { unsafe { ((w - (*s).start) * (*s).div_mul) >> 32 } };
                if i < n {
                    let bits = unsafe { (*s).bits } as usize;
                    if ldb(bits + i) != 0 && ldb(bits + n + i) == 0 { mark_found(s, i, dst); }
                }
            }
        }
        // The bits left past that word.
        let k = (q - p) >> 3;
        m = if k >= 64 { 0 } else { m >> k as u32 };
        p = q;
    }
}

// Marks everything reachable from the mark stacks (the world is stopped).
fn drain() {
    let mut n = 0usize;
    loop {
        let obj = pop();
        if obj == 0 {
            if take_shared() { continue; }
            break;
        }
        n += scan_object(obj, MAIN);
    }
    SCAN_DONE += n;
}

/// The write barrier's work (and that of runtime copies): while a
/// concurrent mark runs, marks what the words in [p, p + n) point to.
pub fn shade_range(p: usize, n: usize) {
    if MARKING { scan(p, p + n, 0); }
}

// --- Parallel concurrent marking (navi) ---------------------------------------
//
// MARKERS marker Gs drain their own stacks; one with more than it needs
// puts a part in the pool (a stack, under mark_lock), one without work
// takes from the pool or SHARED, else it is idle. When all are idle and
// both are empty, the first to see it finishes the cycle.

const MAX_MARKERS: usize = 16;
static mut MAIN: usize = 0; // a stack
static mut POOL: usize = 0; // a stack
static mut LOCAL: usize = 0; // MAX_MARKERS stacks
static mut MARKERS: usize = 0;
static mut IDLE_MARKERS: usize = 0;
static mut MARK_DONE: bool = false;
static mut CYCLE_NO: usize = 0;

pub(crate) fn new_mark_stack() -> usize { new_stack() }

fn new_stack() -> usize {
    let p = unsafe { calloc(4, 8) };
    p as usize
}

// Takes up to half of the pool, else the shared objects, onto st; false if
// both are empty (mark_lock held).
fn take_work(sk: usize) -> bool {
    let n = stack_len(POOL);
    if n > 0 {
        let mut k = (n + 1) / 2;
        while k > 0 {
            stack_push(sk, stack_pop(POOL));
            k -= 1;
        }
        return true;
    }
    move_all(SHARED, sk)
}

// Takes up to 64 grey objects from the pool, else the shared ones, onto
// sk (an assist's batch; mark_lock held); false if both are empty.
fn take_few(sk: usize) -> bool {
    let from = if stack_len(POOL) > 0 { POOL } else { SHARED };
    let mut k = 0;
    while k < 64 {
        let obj = stack_pop(from);
        if obj == 0 { break; }
        stack_push(sk, obj);
        k += 1;
    }
    k > 0
}

fn mark_worker(k: usize, cyc: usize) {
    let me = LOCAL + k * 32;
    loop {
        crate::rt::sched::preempt_off();
        if !CYCLE || CYCLE_NO != cyc || MARK_DONE {
            crate::rt::sched::preempt_on();
            return;
        }
        // The stacks first (as Go's root jobs).
        if !STACKS_DONE { scan_stacks(4, me); }
        let mut n = 0;
        let mut bytes = 0usize;
        while n < 256 {
            let obj = stack_pop(me);
            if obj == 0 { break; }
            bytes += scan_object(obj, me);
            n += 1;
        }
        crate::rt::atomic_add(&mut SCAN_DONE as *mut usize, bytes);
        crate::rt::atomic_add(&mut BG_CREDIT as *mut usize, bytes);
        let mut idle = false;
        let mut finish = false;
        let len = stack_len(me);
        if len > 2048 || len == 0 {
            mark_lock();
            if len > 2048 && stack_len(POOL) < 4096 {
                // Share half.
                let mut k2 = len / 2;
                while k2 > 0 {
                    stack_push(POOL, stack_pop(me));
                    k2 -= 1;
                }
            } else if len == 0 && !take_work(me) {
                IDLE_MARKERS += 1;
                idle = true;
            }
            mark_unlock();
        }
        crate::rt::sched::preempt_on();
        // Idle: waits a little for work, then leaves (the last marker to
        // be idle finishes the cycle).
        let mut spins = 0;
        while idle {
            crate::rt::sched::cpu_relax();
            spins += 1;
            crate::rt::sched::preempt_off();
            if !CYCLE || CYCLE_NO != cyc || MARK_DONE {
                crate::rt::sched::preempt_on();
                return;
            }
            if !STACKS_DONE {
                scan_stacks(4, me);
                if stack_len(me) > 0 {
                    mark_lock();
                    IDLE_MARKERS -= 1;
                    mark_unlock();
                    crate::rt::sched::preempt_on();
                    break;
                }
            }
            // A look without the lock first (a hint): nothing to take and
            // not everyone idle (or an assist runs, or a stack is left), so
            // keep waiting (the last marker waits for the assists).
            if stack_len(POOL) == 0 && stack_len(SHARED) == 0 && (IDLE_MARKERS != MARKERS || ASSISTING != 0 || !STACKS_DONE) && (spins < 100 || MARKERS == 1) {
                crate::rt::sched::preempt_on();
                continue;
            }
            let mut leave = false;
            mark_lock();
            if take_work(me) {
                IDLE_MARKERS -= 1;
                idle = false;
            } else if IDLE_MARKERS == MARKERS && crate::rt::atomic_load(&mut ASSISTING as *mut usize) == 0 && STACKS_DONE {
                MARK_DONE = true;
                finish = true;
                idle = false;
            } else if spins >= 100 && MARKERS > 1 {
                MARKERS -= 1;
                IDLE_MARKERS -= 1;
                leave = true;
            }
            mark_unlock();
            crate::rt::sched::preempt_on();
            if leave { return; }
        }
        if finish {
            crate::rt::sched::lock();
            if CYCLE_NO == cyc { finish_cycle(); }
            crate::rt::sched::unlock();
            return;
        }
    }
}

/// Whether a concurrent mark runs.
pub fn marking() -> bool { MARKING }

// Whether a concurrent mark runs (mirrors the word the generated write
// barriers test), when it started, and the end of the arena then.
static mut MARKING: bool = false;
static mut CYCLE: bool = false;
static mut LIMIT: usize = 0;
static mut MARK_LK: usize = 0;

static mut COLLECTING: bool = false;

/// The registers of the collecting thread, spilled where the root scan of
/// the data section sees them.
static mut SAVED_REGS: [usize; 10] = [0; 10];

/// Runs a full collection.
pub fn collect() {
    crate::rt::sched::lock();
    if !full_concurrent() { collect_locked(); }
    crate::rt::sched::unlock();
}

// Collects with the runtime lock held: in navi builds a concurrent cycle
// starts (or, if one runs, is finished: the heap grew too much meanwhile);
// otherwise every G stops for the whole collection. It must not allocate.
fn collect_locked() {
    finish_sweep();
    if step_concurrent() { return; }
    if COLLECTING { return; }
    COLLECTING = true;
    COLLECTIONS += 1;
    crate::rt::sched::stop_the_world();
    // The spans the Ms kept go back to the shared lists (sweep rebuilds them).
    crate::rt::sched::flush_caches();
    crate::rt::spill_registers(&mut SAVED_REGS as *mut [usize; 10] as *mut usize);
    // From the stack pointer: this frame holds the callers' registers saved
    // by its prologue.
    let lo = crate::rt::stack_pointer() as usize;
    crate::rt::sched::scan_stack(lo, crate::rt::frame_address() as usize, crate::rt::sched::current_stack_hi());
    crate::rt::sched::scan_other_stacks();
    scan_range(crate::rt::data_start() as usize, crate::rt::data_end() as usize);
    scan_cleanups();
    drain();
    sweep_specials();
    sweep();
    crate::rt::sched::mark_shrinks();
    crate::rt::sched::start_the_world();
    COLLECTING = false;
    wake_cleanups();
    LAST_GC = crate::rt::native::monotonic_nanos();
    scavenge(SCAV_GOAL);
    crate::rt::sched::free_stacks();
}

/// When the last collection ended (monotonic nanoseconds; sysmon forces
/// one when none ran for two minutes).
pub static mut LAST_GC: u64 = 0;

fn sweep() {
    clear_lists();
    let mut live = 0usize;
    let mut s = ALL as *mut Span;
    while s as usize != 0 {
        live += sweep_span(s);
        s = unsafe { (*s).next_all };
    }
    LIVE = live;
    ALLOCATED = 0;
    set_goal(live);
}

// Frees the unmarked objects of s, clears its marks and puts it on its
// free list if it has room (the dead list if it has no object); returns
// its live bytes.
fn sweep_span(s: *mut Span) -> usize {
    let (live, room) = sweep_bits(s);
    if room == DEAD { put_dead(s); } else if room == ROOM { put_free(s); }
    live
}

// Puts s on its free list (if not there).
fn put_free(s: *mut Span) {
    unsafe {
        if !(*s).in_free {
            (*s).next_free = FREE[(*s).list] as *mut Span;
            FREE[(*s).list] = s as usize;
            (*s).in_free = true;
        }
    }
}

// Puts dead span s on the dead list (released ones on theirs; its list's
// lock held, or the world stopped).
fn put_dead(s: *mut Span) {
    unsafe {
        if (*s).in_free { return; }
        if (*s).released {
            (*s).next_free = REL as *mut Span;
            REL = s as usize;
        } else {
            (*s).next_free = FREE[NCLASS * 2] as *mut Span;
            FREE[NCLASS * 2] = s as usize;
        }
        (*s).in_free = true;
    }
}

// Empties every free list (the world is stopped): each span is put back
// as it is swept.
fn clear_lists() {
    let mut i = 0;
    while i <= NCLASS * 2 {
        FREE[i] = 0;
        i += 1;
    }
    REL = 0;
    let mut s = ALL as *mut Span;
    while s as usize != 0 {
        unsafe {
            (*s).in_free = false;
            s = (*s).next_all;
        }
    }
}

// What a sweep leaves of a span: no free object, some, none allocated.
const FULL: usize = 0;
const ROOM: usize = 1;
const DEAD: usize = 2;

// Frees the unmarked objects of s and clears its marks (s is the caller's
// alone); its live bytes, and whether it has room now (FULL, ROOM, DEAD).
fn sweep_bits(s: *mut Span) -> (usize, usize) {
    let mut live = 0usize;
    let mut room = FULL;
    unsafe {
        let n = (*s).nelems;
        let bits = (*s).bits as usize;
        // (Its pages are not touched: they stay released.)
        if (*s).released { return (0, DEAD); }
        if (*s).list == NCLASS * 2 {
            if ldb(bits) != 0 && ldb(bits + 1) == 0 {
                stb(bits, 0);
                room = DEAD;
            } else if ldb(bits) != 0 {
                live += (*s).bytes;
            } else {
                room = DEAD;
            }
            stb(bits + 1, 0);
        } else {
            let mut free = 0usize;
            let mut nfree = 0usize;
            let start = (*s).start;
            let elem = (*s).elem;
            let mut i = n;
            while i > 0 {
                i -= 1;
                let a = (bits + i) as *mut u8;
                let m = (bits + n + i) as *mut u8;
                if *a != 0 && *m == 0 {
                    *a = 0;
                    if POISON_FREE { memset((start + i * elem) as *mut u8, 0xab, elem); }
                }
                *m = 0;
                if *a == 0 {
                    let p = start + i * elem;
                    *(p as *mut usize) = free;
                    free = p;
                    nfree += 1;
                }
            }
            (*s).freelist = free;
            (*s).bump = 0;
            (*s).nfree = nfree;
            live += (n - nfree) * (*s).elem;
            room = if nfree == n { DEAD } else if nfree > 0 { ROOM } else { FULL };
        }
    }
    (live, room)
}

// --- Lazy sweeping (concurrent collections) ----------------------------------
//
// A concurrent cycle ends without sweeping (as Go does): the free lists are
// emptied and UNSWEPT walks the span list; the allocator sweeps spans
// before it makes a new one, and a sweeper G sweeps the rest. The next
// cycle starts after the last span is swept. Spans made since the cycle
// ended are ahead of UNSWEPT and need none.
static mut UNSWEPT: usize = 0;
static mut ALLOC_AT_START: usize = 0;

// Lets every span be swept again (the world is stopped).
fn begin_lazy_sweep() {
    clear_lists();
    UNSWEPT = ALL;
}

// Sweeps up to n spans (several threads may: each span is claimed under
// the heap lock, swept under its list's); whether any is left.
fn sweep_some(n: usize) -> bool {
    let mut k = 0;
    while k < n {
        crate::rt::sched::preempt_off();
        spin_lock(&mut HEAP_LK as *mut usize);
        let s = UNSWEPT as *mut Span;
        if s as usize != 0 { UNSWEPT = unsafe { (*s).next_all } as usize; }
        spin_unlock(&mut HEAP_LK as *mut usize);
        if s as usize == 0 {
            crate::rt::sched::preempt_on();
            return false;
        }
        // Swept unlocked (claimed: no one else has it); the list lock only
        // to put it on its free list.
        let (_, room) = sweep_bits(s);
        if room == ROOM {
            let l = list_lk(unsafe { (*s).list });
            spin_lock(l);
            put_free(s);
            spin_unlock(l);
        } else if room == DEAD {
            let l = list_lk(NCLASS * 2);
            spin_lock(l);
            put_dead(s);
            spin_unlock(l);
        }
        crate::rt::sched::preempt_on();
        k += 1;
    }
    UNSWEPT != 0
}

fn finish_sweep() { while sweep_some(4096) {} }

// Sweeps until free list list has a span with room, at most 256 spans
// (the runtime lock is held: the sweeper G does the rest); whether one was
// found.
fn sweep_for(list: usize) -> bool {
    let mut budget = 16;
    while UNSWEPT != 0 && budget > 0 {
        sweep_some(16);
        budget -= 1;
        let f = FREE[list] as *mut Span;
        if f as usize != 0 && (list == NCLASS * 2 || unsafe { (*f).nfree } > 0) { return true; }
    }
    false
}

// The sweeper G: then returns what the heap does not need to the system.
fn sweeper() {
    loop {
        if !sweep_some(64) { break; }
        crate::rt::yield_now();
    }
    scavenge(SCAV_GOAL);
    crate::rt::sched::free_stacks();
}

// --- Returning memory to the system ------------------------------------------
//
// As Go's scavenger: once a cycle's sweep is done, the pages of dead spans
// go back to the system until the heap's pages in use are at most the
// heap goal (what survived plus what may be allocated before the next
// cycle) and 10%. A program that stops allocating gets a collection every
// two minutes (sched's sysmon), so its memory goes back too.

// The pages to keep (set when a cycle ends).
static mut SCAV_GOAL: usize = 0;

// What survived the last cycle and may be allocated before the next, and
// 10% (under a memory limit, at most 95% of it, as Go's scavenger).
fn heap_goal() -> usize {
    let g = if GOAL > NO_LIMIT / 11 * 10 - LIVE { NO_LIMIT } else { (LIVE + GOAL) / 10 * 11 };
    if MEMLIMIT != NO_LIMIT && g > MEMLIMIT / 20 * 19 { MEMLIMIT / 20 * 19 } else { g }
}

// The arena's bytes in use (made and not returned).
fn heap_in_use() -> usize {
    if ARENA == 0 { return 0; }
    ARENA_NEXT - ARENA - crate::rt::atomic_load(&mut RELEASED as *mut usize)
}

// Releases dead spans until the heap's pages in use are at most goal.
fn scavenge(goal: usize) {
    loop {
        if heap_in_use() <= goal { return; }
        crate::rt::sched::preempt_off();
        let l = list_lk(NCLASS * 2);
        spin_lock(l);
        let s = FREE[NCLASS * 2] as *mut Span;
        if s as usize != 0 {
            unsafe {
                FREE[NCLASS * 2] = (*s).next_free as usize;
                (*s).in_free = false;
            }
        }
        spin_unlock(l);
        if s as usize == 0 {
            crate::rt::sched::preempt_on();
            return;
        }
        unsafe {
            release_pages((*s).start, (*s).bytes);
            (*s).released = true;
            // Zero when used again: its objects come from the bump pointer.
            (*s).freelist = 0;
            if (*s).list != NCLASS * 2 {
                (*s).bump = (*s).start;
                (*s).nfree = (*s).nelems;
            }
            crate::rt::atomic_add(&mut RELEASED as *mut usize, (*s).bytes);
        }
        spin_lock(l);
        put_dead(s);
        spin_unlock(l);
        crate::rt::sched::preempt_on();
    }
}

/// Runs a collection and returns every unused page to the system (as Go's
/// debug.FreeOSMemory).
pub fn free_os_memory() {
    collect();
    finish_sweep();
    scavenge(0);
}

/// The heap's bytes in use (taken from the system and not returned) and
/// returned (as Go's HeapSys - HeapReleased and HeapReleased).
pub fn heap_bytes() -> (usize, usize) { (heap_in_use(), crate::rt::atomic_load(&mut RELEASED as *mut usize)) }

// Bytes marked by write barriers (the markers count on their stacks).
static mut MARKED_SHARED: usize = 0;

fn count_shared(n: usize) { crate::rt::atomic_add(&mut MARKED_SHARED as *mut usize, n); }

// The bytes marked this cycle, and the counts reset.
fn take_marked() -> usize {
    let mut t = MARKED_SHARED;
    MARKED_SHARED = 0;
    t += wget(MAIN + 24);
    wset(MAIN + 24, 0);
    let mut w = 0;
    loop {
        let b = crate::rt::sched::wbuf_at(w);
        if b == crate::rt::sched::WBUF_END { break; }
        if b != 0 {
            t += wget(b + 24);
            wset(b + 24, 0);
        }
        w += 1;
    }
    let mut k = 0;
    while k < MAX_MARKERS {
        t += wget(LOCAL + k * 32 + 24);
        wset(LOCAL + k * 32 + 24, 0);
        k += 1;
    }
    t
}

/// Sets the heap size below which no collection starts.
pub fn set_min_heap(bytes: usize) {
    crate::rt::sched::lock();
    MIN_HEAP = bytes;
    repace();
    crate::rt::sched::unlock();
}

static mut MIN_HEAP: usize = MIN_GC;
static mut PERCENT: usize = 100;

/// Sets the percent the heap may grow by (OFF: only the memory limit
/// starts a collection); the previous one.
pub fn set_percent(percent: usize) -> usize {
    crate::rt::sched::lock();
    if ARENA == 0 { init(); }
    let old = PERCENT;
    PERCENT = percent;
    repace();
    crate::rt::sched::unlock();
    old
}

/// Sets the memory limit (NO_LIMIT: none); the previous one.
pub fn set_memory_limit(bytes: usize) -> usize {
    crate::rt::sched::lock();
    if ARENA == 0 { init(); }
    let old = MEMLIMIT;
    MEMLIMIT = bytes;
    repace();
    crate::rt::sched::unlock();
    old
}

// The goal again after a setting changed (not during a cycle: its start
// set the point that finishes it).
fn repace() {
    if !CYCLE && ARENA != 0 { set_goal(LIVE); }
}

// The least the heap may grow by under a memory limit (as Go's minimum
// heap: a limit below what survives does not collect continuously).
const LIMIT_FLOOR: usize = 4194304;

// The bytes the heap may grow by past what survived (live).
fn goal(live: usize) -> usize {
    let mut g = if PERCENT == OFF || PERCENT != 0 && live / 100 > NO_LIMIT / PERCENT { NO_LIMIT } else { live / 100 * PERCENT };
    if g < MIN_HEAP { g = MIN_HEAP; }
    if MEMLIMIT != NO_LIMIT {
        // The limit counts the stacks too (not the collector's own
        // metadata, outside the arena).
        let other = crate::rt::sched::stack_bytes();
        let room = if MEMLIMIT > live + other + LIMIT_FLOOR { MEMLIMIT - live - other } else { LIMIT_FLOOR };
        if g > room { g = room; }
    }
    g
}

// Sets the next cycle's goal after one that left live bytes, and where it
// starts.
fn set_goal(live: usize) {
    GOAL = goal(live);
    NEXT_GC = if MODE == 2 { GOAL } else { ((GOAL as u128) * (TRIGGER as u128) / 1000) as usize };
    SCAV_GOAL = heap_goal();
}

// After a concurrent cycle: the trigger moves so that the next mark,
// allocating as much as this one did, ends at its goal (between 60% and
// 95% of the way; halfway to the new estimate each time, as Go smooths).
fn adjust_trigger(during_mark: usize) {
    if GOAL == 0 || GOAL == NO_LIMIT { return; }
    let used = ((during_mark as u128) * 1000 / (GOAL as u128)) as usize;
    let mut want = if used >= 400 { 600 } else { 1000 - used };
    if want > 950 { want = 950; }
    TRIGGER = (TRIGGER + want) / 2;
}

/// Statistics for tests: (collections, live bytes after the last one,
/// bytes allocated since).
pub fn stats() -> (usize, usize, usize) { (COLLECTIONS, LIVE, ALLOCATED) }

// --- Concurrent collection (navi) -------------------------------------------------
//
// A cycle: (1) the world stops briefly while the roots (stacks, saved
// registers, statics) are marked and the write barrier is switched on; (2)
// the marker Gs and the assists drain the grey objects while the program
// runs: the barrier shades every pointer a store overwrites or stores (as
// Go's hybrid barrier: a stack, scanned once, then needs none), and objects
// allocated meanwhile are born marked; (3) the world stops again: what the
// barriers left in the Ms' buffers is drained (the statics rescanned too:
// the runtime writes some as integers) and sweeping begins.

fn mark_lock() {
    while !crate::rt::atomic_cas(&mut MARK_LK as *mut usize, 0, 1) { mark_spin(); }
}
fn mark_unlock() { crate::rt::atomic_store(&mut MARK_LK as *mut usize, 0); }
fn mark_spin() { crate::rt::sched::cpu_relax(); }


// NAVI_GCSTW=1 keeps every collection stop-the-world; NAVI_GCVERIFY=1
// checks after each concurrent mark that no reachable object was missed.
static mut MODE: usize = 0; // 0 unknown, 1 concurrent, 2 stop-the-world
static mut VERIFY: bool = false;

fn concurrent_on() -> bool {
    if MODE == 0 {
        MODE = if crate::rt::native::env_set(b"NAVI_GCSTW\0") { 2 } else { 1 };
        VERIFY = crate::rt::native::env_set(b"NAVI_GCVERIFY\0");
        // NAVI_GCMINHEAP=bytes: collect more often (testing).
        if let Some(v) = crate::rt::native::getenv_c(b"NAVI_GCMINHEAP\0") {
            let mut n = 0usize;
            for b in v.bytes() { if b >= b'0' && b <= b'9' { n = n * 10 + (b - b'0') as usize; } }
            if n > 0 { MIN_HEAP = n; }
        }
        // (Stop-the-world cycles start at the goal.)
        set_goal(LIVE);
    }
    MODE == 1
}

fn step_concurrent() -> bool {
    if !concurrent_on() { return false; }
    if CYCLE { finish_cycle(); } else { start_cycle(); }
    true
}

// A full cycle (as Go's runtime.GC: one running is finished first, its
// roots marked before what died since).
fn full_concurrent() -> bool {
    if !concurrent_on() { return false; }
    if CYCLE { finish_cycle(); }
    start_cycle();
    finish_cycle();
    true
}

fn set_marking(on: bool) {
    MARKING = on;
    crate::rt::atomic_store(crate::rt::gc_marking_flag() as *mut usize, if on { 1 } else { 0 });
}


// How many mark workers a cycle has: a quarter of the threads (as Go's
// dedicated workers), at least one.
fn workers() -> usize {
    let mut n = (crate::rt::sched::procs() + 2) / 4;
    if n < 1 { n = 1; }
    if n > MAX_MARKERS { n = MAX_MARKERS; }
    n
}

// How long the world stopped to start the last cycle (NAVI_GCTRACE).
static mut START_STW: u64 = 0;

// (1), with the runtime lock held.
fn start_cycle() {
    if COLLECTING { return; }
    finish_sweep();
    COLLECTING = true;
    let t0 = crate::rt::native::monotonic_nanos();
    crate::rt::sched::stop_the_world();
    take_marked();
    SCAN_DONE = 0;
    BG_CREDIT = 0;
    ASSISTED = 0;
    ALLOC_AT_START = ALLOCATED;
    CYCLE = true;
    LIMIT = ARENA_NEXT;
    set_marking(true);
    // The statics now; the stacks while the program runs (the barrier
    // keeps what a G moves between its stack and the heap meanwhile).
    scan_range(crate::rt::data_start() as usize, crate::rt::data_end() as usize);
    scan_cleanups();
    if CONC_STACKS == 0 { CONC_STACKS = if crate::rt::native::env_set(b"NAVI_GCCONCSTACKS\0") { 1 } else { 2 }; }
    STK_CUR = crate::rt::sched::all_head();
    STK_N = 0;
    STK_BUSY = 0;
    STACKS_DONE = false;
    // The cycle's state, all before the world starts again (assists start
    // taking grey objects at once; a marker of an earlier cycle not yet run
    // must see it is stale).
    // Past half again the goal the allocating G finishes the cycle itself
    // (the assists should have ended it before).
    let hard = if GOAL > NO_LIMIT / 2 { NO_LIMIT } else { GOAL + GOAL / 2 };
    NEXT_GC = if hard > ALLOCATED + MIN_HEAP / 4 { hard } else { ALLOCATED + MIN_HEAP / 4 };
    CYCLE_NO += 1;
    let cyc = CYCLE_NO;
    if CONC_STACKS != 1 {
        // Every stack now, the world stopped (each once: the barrier keeps
        // them).
        crate::rt::sched::scan_unscanned(cyc);
        STACKS_DONE = true;
    }
    move_all(MAIN, POOL);
    // (2): the marker Gs (a quarter of the threads, as Go's dedicated
    // workers), starting from the roots.
    MARKERS = workers();
    IDLE_MARKERS = 0;
    MARK_DONE = false;
    crate::rt::sched::ask_yields(MARKERS);
    crate::rt::sched::start_the_world();
    START_STW = crate::rt::native::monotonic_nanos() - t0;
    COLLECTING = false;
    let mut k = 0;
    while k < MARKERS {
        let id = k;
        crate::rt::sched::go_marker(|| { mark_worker(id, cyc); });
        k += 1;
    }
}

// (3), with the runtime lock held.
fn finish_cycle() {
    if !CYCLE || COLLECTING { return; }
    COLLECTING = true;
    COLLECTIONS += 1;
    let t0 = crate::rt::native::monotonic_nanos();
    crate::rt::sched::stop_the_world();
    // No stack again (the barrier kept them), only those no marker
    // scanned.
    crate::rt::sched::scan_unscanned(CYCLE_NO);
    STACKS_DONE = true;
    scan_range(crate::rt::data_start() as usize, crate::rt::data_end() as usize);
    scan_cleanups();
    drain();
    if crate::rt::native::env_set(b"NAVI_GCTRACE\0") {
        crate::rt::native::put(2, "gc finish done=");
        crate::rt::native::put(2, if MARK_DONE { "1" } else { "0" });
        crate::rt::native::put(2, " start_stw_us=");
        crate::rt::native::put_u64(2, START_STW / 1000);
        crate::rt::native::put(2, " stw_us=");
        crate::rt::native::put_u64(2, (crate::rt::native::monotonic_nanos() - t0) / 1000);
        crate::rt::native::put(2, " scan_mb=");
        crate::rt::native::put_u64(2, (SCAN_DONE >> 20) as u64);
        crate::rt::native::put(2, " assist_mb=");
        crate::rt::native::put_u64(2, (ASSISTED >> 20) as u64);
        crate::rt::native::put(2, " goal_mb=");
        crate::rt::native::put_u64(2, (GOAL >> 20) as u64);
        crate::rt::native::put(2, " trigger=");
        crate::rt::native::put_u64(2, TRIGGER as u64);
        crate::rt::native::put(2, " start_mb=");
        crate::rt::native::put_u64(2, (ALLOC_AT_START >> 20) as u64);
        crate::rt::native::put(2, " alloc_mb=");
        crate::rt::native::put_u64(2, (ALLOCATED >> 20) as u64);
        crate::rt::native::put(2, "\n");
    }
    if VERIFY { verify_marks(); }
    sweep_specials();
    crate::rt::sched::mark_shrinks();
    set_marking(false);
    CYCLE = false;
    crate::rt::sched::flush_caches();
    // The live heap: what was marked, and what was allocated meanwhile
    // (allocated black).
    let during = ALLOCATED - ALLOC_AT_START;
    let live = take_marked() + during;
    LIVE = live;
    adjust_trigger(during);
    SCAN_LAST = SCAN_DONE;
    ALLOCATED = 0;
    set_goal(live);
    LAST_GC = crate::rt::native::monotonic_nanos();
    begin_lazy_sweep();
    crate::rt::sched::start_the_world();
    COLLECTING = false;
    wake_cleanups();
    crate::rt::sched::go(|| { sweeper(); });
}

// Rescans every marked object: if that marks anything more, the
// concurrent mark missed a reachable object (a missing write barrier).
fn verify_marks() {
    // The mark bytes before the rescan (to report what it marks).
    let mut nspans = 0usize;
    let mut s = ALL as *mut Span;
    while s as usize != 0 { nspans += 1; s = unsafe { (*s).next_all }; }
    let copies = unsafe { calloc(nspans + 1, 8) } as usize;
    let mut k = 0usize;
    s = ALL as *mut Span;
    while s as usize != 0 {
        unsafe {
            let n = (*s).nelems;
            let c = calloc(n + 1, 1) as usize;
            let mut i = 0;
            while i < n { stb(c + i, ldb((*s).bits as usize + n + i)); i += 1; }
            *((copies + 8 * k) as *mut usize) = c;
            s = (*s).next_all;
        }
        k += 1;
    }
    let mut before = 0usize;
    s = ALL as *mut Span;
    while s as usize != 0 {
        unsafe {
            let n = (*s).nelems;
            let bits = (*s).bits as usize;
            let mut i = 0;
            while i < n {
                if ldb(bits + n + i) != 0 {
                    before += 1;
                    if !(*s).noscan { scan_object((*s).start + i * (*s).elem, MAIN); }
                }
                i += 1;
            }
            s = (*s).next_all;
        }
    }
    drain();
    let mut after = 0usize;
    s = ALL as *mut Span;
    while s as usize != 0 {
        unsafe {
            let n = (*s).nelems;
            let bits = (*s).bits as usize;
            let mut i = 0;
            while i < n {
                if ldb(bits + n + i) != 0 { after += 1; }
                i += 1;
            }
            s = (*s).next_all;
        }
    }
    if after != before {
        // Spans made meanwhile mean something allocated while the world
        // was stopped.
        let mut now = 0usize;
        s = ALL as *mut Span;
        while s as usize != 0 { now += 1; s = unsafe { (*s).next_all }; }
        crate::rt::native::put(2, "spans before ");
        crate::rt::native::put_u64(2, nspans as u64);
        crate::rt::native::put(2, " now ");
        crate::rt::native::put_u64(2, now as u64);
        crate::rt::native::put(2, "\n");
        crate::rt::sched::dump_ms();
        if now != nspans { crate::rt::native::fatal("concurrent mark missed reachable objects (the heap changed during the check)"); }
        report_missed(copies);
        crate::rt::native::fatal("concurrent mark missed reachable objects");
    }
}

// What verify_marks marked that the concurrent mark had not (the first
// 8), and the marked objects that point at any of them (the first 12, with
// their first words): where a write barrier was missing.
fn report_missed(copies: usize) {
    use crate::rt::native::{put, put_hex, put_u64};
    // The newly marked objects, sorted by address (insertion: few).
    let cap = 4096usize;
    let los = unsafe { calloc(cap, 8) } as usize;
    let his = unsafe { calloc(cap, 8) } as usize;
    let mut nm = 0usize;
    let mut k = 0usize;
    let mut s = ALL as *mut Span;
    while s as usize != 0 {
        unsafe {
            let n = (*s).nelems;
            let c = *((copies + 8 * k) as *const usize);
            let mut i = 0;
            while i < n {
                if ldb((*s).bits as usize + n + i) != 0 && ldb(c + i) == 0 {
                    let lo = (*s).start + i * (*s).elem;
                    if nm < 8 {
                        put(2, "missed object ");
                        put_hex(2, lo as u64);
                        put(2, " size ");
                        put_u64(2, (*s).elem as u64);
                        put(2, if (*s).noscan { " noscan" } else { "" });
                        put(2, " words");
                        let mut w = 0;
                        while w < 4 && w * 8 < (*s).elem { put(2, " "); put_hex(2, *((lo + 8 * w) as *const usize) as u64); w += 1; }
                        put(2, "\n");
                    }
                    if nm < cap {
                        let mut at = nm;
                        while at > 0 && *((los + 8 * (at - 1)) as *const usize) > lo {
                            *((los + 8 * at) as *mut usize) = *((los + 8 * (at - 1)) as *const usize);
                            *((his + 8 * at) as *mut usize) = *((his + 8 * (at - 1)) as *const usize);
                            at -= 1;
                        }
                        *((los + 8 * at) as *mut usize) = lo;
                        *((his + 8 * at) as *mut usize) = lo + (*s).elem;
                        nm += 1;
                    }
                }
                i += 1;
            }
            s = (*s).next_all;
        }
        k += 1;
    }
    put(2, "newly marked: ");
    put_u64(2, nm as u64);
    put(2, "\n");
    let mut shown = 0;
    k = 0;
    s = ALL as *mut Span;
    while s as usize != 0 && shown < 12 {
        unsafe {
            let n = (*s).nelems;
            let c = *((copies + 8 * k) as *const usize);
            let mut i = 0;
            while i < n && !(*s).noscan && shown < 12 {
                if ldb(c + i) != 0 {
                    let o = (*s).start + i * (*s).elem;
                    let mut w = 0;
                    while w * 8 < (*s).elem && shown < 12 {
                        let v = *((o + 8 * w) as *const usize);
                        // The last newly marked object starting at or below v.
                        let mut a = 0usize;
                        let mut b = nm;
                        while a < b {
                            let mid = (a + b) / 2;
                            if *((los + 8 * mid) as *const usize) <= v { a = mid + 1; } else { b = mid; }
                        }
                        if a > 0 && v < *((his + 8 * (a - 1)) as *const usize) {
                            put(2, "  marked ");
                            put_hex(2, o as u64);
                            put(2, " (size ");
                            put_u64(2, (*s).elem as u64);
                            put(2, ") word ");
                            put_u64(2, w as u64);
                            put(2, " -> ");
                            put_hex(2, v as u64);
                            put(2, "; its words");
                            let mut x = 0;
                            while x < 6 && x * 8 < (*s).elem { put(2, " "); put_hex(2, *((o + 8 * x) as *const usize) as u64); x += 1; }
                            put(2, "\n");
                            shown += 1;
                        }
                        w += 1;
                    }
                }
                i += 1;
            }
            s = (*s).next_all;
        }
        k += 1;
    }
}

// --- Weak handles and cleanups (as Go's weak.Pointer and runtime.AddCleanup) --
//
// A weak handle is a heap object without pointers (never scanned) holding
// an address, shared by every std::gc::Weak made from it; a table in C
// memory (not scanned either) maps the address to its handle. A cleanup
// is a record in C memory: the address and the function to call (scanned
// as a root: it must not keep the object alive itself). When a mark ends
// (the world stopped), a handle whose object is not marked is cleared and
// a cleanup whose object is not marked is queued for the cleanup G; the
// object is then freed as any other.

static mut SPECIAL_LK: usize = 0;
// The table: WK_CAP slots of [address, handle] (address 0: empty, 1: a
// deleted entry), WK_USED of them not empty.
static mut WK: usize = 0;
static mut WK_CAP: usize = 0;
static mut WK_USED: usize = 0;

fn special_lock() {
    crate::rt::sched::preempt_off();
    spin_lock(&mut SPECIAL_LK as *mut usize);
}
fn special_unlock() {
    spin_unlock(&mut SPECIAL_LK as *mut usize);
    crate::rt::sched::preempt_on();
}

// The slot of addr in the table, or the empty one where it would go.
fn wk_find(addr: usize) -> usize {
    let mask = WK_CAP - 1;
    let mut i = (addr >> 4).wrapping_mul(11400714819323198485) >> 40 & mask;
    let mut free = 0usize;
    loop {
        let e = WK + 16 * i;
        let k = wget(e);
        if k == addr { return e; }
        if k == 0 { return if free != 0 { free } else { e }; }
        if k == 1 && free == 0 { free = e; }
        i = (i + 1) & mask;
    }
}

// Rebuilds the table with room for twice the entries (deleted ones go).
fn wk_grow() {
    let old = WK;
    let n = WK_CAP;
    let mut live = 0usize;
    let mut i = 0;
    while i < n {
        if wget(old + 16 * i) > 1 { live += 1; }
        i += 1;
    }
    let mut cap = 64usize;
    while cap < live * 4 { cap *= 2; }
    WK = unsafe { calloc(cap, 16) } as usize;
    if WK == 0 { out_of_memory(); }
    WK_CAP = cap;
    WK_USED = 0;
    i = 0;
    while i < n {
        let k = wget(old + 16 * i);
        if k > 1 {
            let e = wk_find(k);
            wset(e, k);
            wset(e + 8, wget(old + 16 * i + 8));
            WK_USED += 1;
        }
        i += 1;
    }
    if old != 0 { unsafe { free(old as *mut u8); } }
}

/// The weak handle of addr (std::gc::Weak::new): made on first use.
pub fn weak_handle(addr: usize) -> usize {
    // Made first (allocating may collect, which takes the table's lock).
    let h = alloc(8, true) as usize;
    wset(h, addr);
    special_lock();
    if WK_USED * 2 >= WK_CAP { wk_grow(); }
    let e = wk_find(addr);
    let k = wget(e);
    let found = if k == addr { wget(e + 8) } else { 0 };
    if found == 0 {
        wset(e, addr);
        wset(e + 8, h);
        if k == 0 { WK_USED += 1; }
    }
    special_unlock();
    if found != 0 { found } else { h }
}

/// The address a weak handle holds (0: its object died). During a mark
/// the object is shaded first (a strong reference is made from it), with
/// no stop in between (the mark could end and the handle be cleared).
pub fn weak_get(h: usize) -> usize {
    crate::rt::sched::preempt_off();
    let a = crate::rt::atomic_load(h as *mut usize);
    if a != 0 && MARKING {
        let w = [a];
        scan(&w as *const [usize; 1] as usize, &w as *const [usize; 1] as usize + 8, 0);
    }
    crate::rt::sched::preempt_on();
    a
}

// Whether the object containing addr is marked (an address outside the
// heap's objects is: a static's).
fn is_marked(addr: usize) -> bool {
    if addr < ARENA || addr >= ARENA_NEXT { return true; }
    let s = ld(PAGES + ((addr - ARENA) >> PAGE_SHIFT) * 8) as *mut Span;
    if s as usize == 0 { return true; }
    unsafe {
        let n = (*s).nelems;
        let i = if n == 1 { 0 } else { ((addr - (*s).start) * (*s).div_mul) >> 32 };
        if i >= n { return true; }
        let bits = (*s).bits as usize;
        ldb(bits + i) == 0 || ldb(bits + n + i) != 0
    }
}

// Cleanups: CL_N records of CL_REC bytes: [address, id, the function (a
// closure value)]; address 0 once queued (to run) or stopped.
static mut CL: usize = 0;
static mut CL_N: usize = 0;
static mut CL_CAP: usize = 0;
static mut CL_NEXT_ID: usize = 0;
static mut CL_QUEUED: usize = 0;
const CL_FN: usize = 16;

fn cl_rec() -> usize { CL_FN + crate::intrinsics::size_of::<fn()>() }

/// Registers f to run (on the cleanup G) once the object containing addr
/// is unreachable; its id (std::gc::add_cleanup).
pub fn add_cleanup(addr: usize, f: fn()) -> usize {
    crate::rt::sched::start_helpers();
    special_lock();
    if CL_N == CL_CAP {
        let cap = if CL_CAP == 0 { 64 } else { CL_CAP * 2 };
        let p = unsafe { realloc(CL as *mut u8, cap * cl_rec()) } as usize;
        if p == 0 { out_of_memory(); }
        CL = p;
        CL_CAP = cap;
    }
    CL_NEXT_ID += 1;
    let id = CL_NEXT_ID;
    let r = CL + CL_N * cl_rec();
    wset(r, addr);
    wset(r + 8, id);
    unsafe { *((r + CL_FN) as *mut fn()) = f; }
    CL_N += 1;
    // (A root: shaded if a mark runs, which scanned the roots already.)
    if MARKING { scan(r + CL_FN, r + cl_rec(), 0); }
    special_unlock();
    id
}

/// Cancels cleanup id unless it was queued (Cleanup::stop).
pub fn stop_cleanup(id: usize) {
    special_lock();
    let mut i = 0;
    while i < CL_N {
        let r = CL + i * cl_rec();
        if wget(r + 8) == id && wget(r) != 0 {
            cl_remove(i);
            break;
        }
        i += 1;
    }
    special_unlock();
}

// Removes record i (the last moves into its place).
fn cl_remove(i: usize) {
    CL_N -= 1;
    if i != CL_N {
        let mut k = 0;
        while k < cl_rec() {
            wset(CL + i * cl_rec() + k, wget(CL + CL_N * cl_rec() + k));
            k += 8;
        }
    }
}

// The cleanups' functions are roots.
fn scan_cleanups() {
    let mut i = 0;
    while i < CL_N {
        let r = CL + i * cl_rec();
        scan_range(r + CL_FN, r + cl_rec());
        i += 1;
    }
}

// At the end of a mark (the world stopped): clears the handles of dead
// objects (and drops the handles no Weak holds), queues the cleanups of
// dead objects.
fn sweep_specials() {
    let mut i = 0;
    while i < WK_CAP {
        let e = WK + 16 * i;
        let k = wget(e);
        if k > 1 {
            let h = wget(e + 8);
            if !is_marked(h) {
                wset(e, 1);
            } else if !is_marked(k) {
                wset(h, 0);
                wset(e, 1);
            }
        }
        i += 1;
    }
    i = 0;
    while i < CL_N {
        let r = CL + i * cl_rec();
        let a = wget(r);
        if a != 0 && !is_marked(a) {
            wset(r, 0);
            CL_QUEUED += 1;
        }
        i += 1;
    }
}

// After a mark queued cleanups: the cleanup G runs them.
fn wake_cleanups() {
    if CL_QUEUED != 0 { crate::rt::sched::wake_cleanups(); }
}

/// The next queued cleanup (the cleanup G; None: none left), taken off.
pub fn next_cleanup() -> Option<fn()> {
    special_lock();
    let mut i = 0;
    while i < CL_N {
        let r = CL + i * cl_rec();
        if wget(r) == 0 {
            let f = unsafe { *((r + CL_FN) as *const fn()) };
            cl_remove(i);
            CL_QUEUED -= 1;
            special_unlock();
            return Some(f);
        }
        i += 1;
    }
    special_unlock();
    None
}
