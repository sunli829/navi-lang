//! The harnesses of navi test and navi bench: the compiler generates an
//! entry function that passes the #[test] or #[bench] functions here. The
//! first command line argument, if any, selects the names containing it.

use crate::bench::Bencher;

fn selected(name: &str) -> bool {
    match crate::env::args().nth(1) {
        Some(f) => name.contains(f.as_str()),
        None => true,
    }
}

/// Runs each test, catching panics; exits with 1 if any failed. panics[i]
/// is what test i must do (as Rust's #[should_panic]): "" return, "panic:"
/// panic, "panic:text" panic with a message containing text.
pub fn run_tests(names: &[&str], tests: &[fn()], panics: &[&str]) {
    let mut passed = 0;
    let mut failed = 0;
    let mut i = 0;
    while i < tests.len() {
        if selected(names[i]) {
            let why = match (crate::panic::catch_unwind(tests[i]), panics[i].strip_prefix("panic:")) {
                (Ok(_), None) => None,
                (Err(_), None) => Some(String::new()),
                (Ok(_), Some(_)) => Some("test did not panic as expected".to_string()),
                (Err(p), Some(want)) => {
                    if p.message().contains(want) { None } else {
                        Some(`panic did not contain expected string\n      panic message: ${p.message():?}\n expected substring: ${want:?}`.to_string())
                    }
                }
            };
            match why {
                None => {
                    println(`ok   ${names[i]}`);
                    passed += 1;
                }
                Some(w) => {
                    if w.len() > 0 { println(`note: ${w}`); }
                    println(`--- FAIL: ${names[i]}`);
                    failed += 1;
                }
            }
        }
        i += 1;
    }
    println(`${passed} passed, ${failed} failed`);
    if failed > 0 { crate::process::exit(1); }
}

/// Runs each benchmark and prints the time per iteration.
pub fn run_benches(names: &[&str], plain: &[fn()], bnames: &[&str], with_b: &[fn(&mut Bencher)]) {
    let mut i = 0;
    while i < plain.len() {
        if selected(names[i]) {
            let f = plain[i];
            let mut b = Bencher::new();
            b.iter(|| f());
            report(names[i], &b);
        }
        i += 1;
    }
    i = 0;
    while i < with_b.len() {
        if selected(bnames[i]) {
            let mut b = Bencher::new();
            with_b[i](&mut b);
            report(bnames[i], &b);
        }
        i += 1;
    }
}

fn report(name: &str, b: &Bencher) {
    if b.iterations() == 0 {
        println(`bench ${name} ... no iterations (call Bencher::iter)`);
        return;
    }
    println(`bench ${name:<30} ${b.ns_per_iter():>12} ns/iter (${b.iterations()} iterations)`);
}
