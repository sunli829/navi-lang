//! The harnesses of navi test and navi bench: the compiler generates an
//! entry function that passes the #[test] or #[bench] functions here. The
//! first command line argument that is not an option, if any, selects the
//! names containing it.
//!
//! Tests run in parallel as Rust's harness runs them: on
//! --test-threads=N threads (NAVI_TEST_THREADS, else as many as the
//! scheduler's), each test's print output and panic messages captured
//! (and threads it starts) and shown only if it fails; --nocapture
//! (NAVI_TEST_NOCAPTURE) prints them as they come. The results are printed
//! in the tests' order. With NAVI_TEST_TIMEOUT=ns (navi test's -timeout)
//! a program still running then prints the tests that run, their output so
//! far and the goroutines, and exits (as go test's -timeout panics).

use crate::bench::Bencher;

// The harness's options: the name filter, the threads, whether output is
// captured.
struct Options {
    filter: Option<String>,
    threads: usize,
    capture: bool,
}

fn options() -> Options {
    let mut o = Options { filter: None, threads: 0, capture: crate::env::var("NAVI_TEST_NOCAPTURE").is_err() };
    if let Ok(v) = crate::env::var("NAVI_TEST_THREADS") {
        if let Ok(n) = v.parse::<usize>() { o.threads = n; }
    }
    for a in crate::env::args().skip(1) {
        if let Some(v) = a.strip_prefix("--test-threads=") {
            match v.parse::<usize>() {
                Ok(n) if n > 0 => o.threads = n,
                _ => {
                    eprintln(`--test-threads: not a positive number: ${v}`);
                    crate::process::exit(2);
                }
            }
        } else if a == "--nocapture" || a == "--no-capture" {
            o.capture = false;
        } else if o.filter.is_none() {
            o.filter = Some(a.clone());
        }
    }
    if o.threads == 0 {
        o.threads = match crate::thread::available_parallelism() { Ok(n) => n, Err(_) => 1 };
    }
    o
}

fn selected(o: &Options, name: &str) -> bool {
    match &o.filter {
        Some(f) => name.contains(f.as_str()),
        None => true,
    }
}

// Runs test i; None if it passed, else why not ("" if it panicked).
fn run_one(test: fn(), panics: &str) -> Option<String> {
    match (crate::panic::catch_unwind(test), panics.strip_prefix("panic:")) {
        (Ok(_), None) => None,
        (Err(_), None) => Some(String::new()),
        (Ok(_), Some(_)) => Some("test did not panic as expected".to_string()),
        (Err(p), Some(want)) => {
            if p.message().contains(want) { None } else {
                Some(`panic did not contain expected string\n      panic message: ${p.message():?}\n expected substring: ${want:?}`.to_string())
            }
        }
    }
}

/// Runs the tests (see the module's comment), catching panics; exits with
/// 1 if any failed. panics[i] is what test i must do (as Rust's
/// #[should_panic]): "" return, "panic:" panic, "panic:text" panic with a
/// message containing text.
pub fn run_tests(names: &[&str], tests: &[fn()], panics: &[&str]) {
    let o = options();
    let mut sel: Vec<usize> = Vec::new();
    for i in 0..tests.len() {
        if selected(&o, names[i]) { sel.push(i); }
    }
    let (work_tx, work_rx) = crate::sync::mpmc::channel::<usize>();
    for k in 0..sel.len() { let _ = work_tx.send(k); }
    work_tx.close();
    let (done_tx, done_rx) = crate::sync::mpmc::channel::<(usize, Option<String>, String)>();
    let n = if o.threads < sel.len() { o.threads } else { sel.len() };
    let capture = o.capture;
    // Each test's capture while it runs (1 if not captured; for the timeout).
    let mut running: Vec<usize> = Vec::new();
    for _ in 0..sel.len() { running.push(0); }
    if let Ok(v) = crate::env::var("NAVI_TEST_TIMEOUT") {
        if let Ok(ns) = v.parse::<u64>() {
            if ns > 0 { watchdog(ns, names, &sel, &running); }
        }
    }
    let mut workers = Vec::new();
    for _ in 0..n {
        workers.push(crate::thread::spawn(|| {
            for k in work_rx.iter() {
                let i = sel[k];
                let c = if capture { crate::rt::native::capture_new() } else { 0 };
                running[k] = if c != 0 { c } else { 1 };
                crate::rt::sched::set_output_capture(c);
                let why = run_one(tests[i], panics[i]);
                crate::rt::sched::set_output_capture(0);
                running[k] = 0;
                let out = if c != 0 { crate::rt::native::capture_take(c) } else { String::new() };
                let _ = done_tx.send((k, why, out));
            }
        }));
    }
    // The results in the tests' order, each once it and those before it
    // have ended.
    let mut results: Vec<Option<(Option<String>, String)>> = Vec::new();
    for _ in 0..sel.len() { results.push(None); }
    let mut shown = 0;
    let mut passed = 0;
    let mut failed = 0;
    for _ in 0..sel.len() {
        let (k, why, out) = match done_rx.recv() { Ok(r) => r, Err(_) => break };
        results[k] = Some((why, out));
        while shown < sel.len() {
            let (why, out) = match &results[shown] { Some(r) => r.clone(), None => break };
            let name = names[sel[shown]];
            match why {
                None => {
                    println(`ok   ${name}`);
                    passed += 1;
                }
                Some(w) => {
                    // (Its output indented, as go test prints a failed test's log.)
                    println(`--- FAIL: ${name}`);
                    for line in out.lines() { println(`    ${line}`); }
                    if w.len() > 0 { println(`    note: ${w}`); }
                    failed += 1;
                }
            }
            shown += 1;
        }
    }
    for w in workers.iter() { let _ = w.join(); }
    println(`${passed} passed, ${failed} failed`);
    if failed > 0 { crate::process::exit(1); }
}

// After ns: the tests running (their output so far), the goroutines, exit.
fn watchdog(ns: u64, names: &[&str], sel: &Vec<usize>, running: &Vec<usize>) {
    let _ = crate::thread::spawn(|| {
        crate::thread::sleep(crate::time::Duration::from_nanos(ns));
        timed_out(ns, names, sel, running);
    });
}

fn timed_out(ns: u64, names: &[&str], sel: &Vec<usize>, running: &Vec<usize>) {
    let mut text = `panic: test timed out after ${ns / 1000000000}s\nrunning tests:\n`.to_string();
    for k in 0..sel.len() {
        if running[k] != 0 { text.push_str(`\t${names[sel[k]]}\n`.to_string().as_str()); }
    }
    for k in 0..sel.len() {
        let c = running[k];
        if c > 1 {
            text.push_str(`--- output of ${names[sel[k]]}:\n`.to_string().as_str());
            for line in crate::rt::native::capture_peek(c).lines() { text.push_str(`    ${line}\n`.to_string().as_str()); }
        }
    }
    eprint(text);
    crate::rt::sched::dump_goroutines();
    crate::process::exit(2);
}

/// Runs each benchmark and prints the time per iteration.
pub fn run_benches(names: &[&str], plain: &[fn()], bnames: &[&str], with_b: &[fn(&mut Bencher)]) {
    let o = options();
    let mut i = 0;
    while i < plain.len() {
        if selected(&o, names[i]) {
            let f = plain[i];
            let mut b = Bencher::new();
            b.iter(|| f());
            report(names[i], &b);
        }
        i += 1;
    }
    i = 0;
    while i < with_b.len() {
        if selected(&o, bnames[i]) {
            let mut b = Bencher::new();
            with_b[i](&mut b);
            report(bnames[i], &b);
        }
        i += 1;
    }
}

fn report(name: &str, b: &Bencher) {
    if b.iterations() == 0 {
        println(`bench ${name} ... no iterations (call Bencher::iter)`);
        return;
    }
    println(`bench ${name:<30} ${b.ns_per_iter():>12} ns/iter (${b.iterations()} iterations)`);
}
