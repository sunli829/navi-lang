//! Exact float to decimal conversion for the native runtime (the
//! interpreter uses Go's strconv). Shortest round-trip digits use the
//! Burger-Dybvig free-format algorithm on big integers; fixed precision is
//! rounded exactly (half to even).

// 110 * 32 bits holds 2^1024 * 10^700, the largest product formatted
// (precision is capped at 700 digits).
struct Big { d: [u32; 110], n: usize }

impl Big {
    fn from_u64(v: u64) -> Big {
        let mut b = Big { d: [0u32; 110], n: 0 };
        let mut x = v;
        while x > 0 {
            b.d[b.n] = (x & 0xffffffff) as u32;
            b.n += 1;
            x = x >> 32;
        }
        b
    }

    fn is_zero(&self) -> bool { self.n == 0 }

    fn mul_small(&mut self, m: u32) {
        let mut carry: u64 = 0;
        let mut i = 0;
        while i < self.n {
            let v = (self.d[i] as u64) * (m as u64) + carry;
            self.d[i] = (v & 0xffffffff) as u32;
            carry = v >> 32;
            i += 1;
        }
        if carry > 0 {
            self.d[self.n] = carry as u32;
            self.n += 1;
        }
    }

    fn mul_pow10(&mut self, k: i32) {
        let mut i = 0;
        while i < k { self.mul_small(10); i += 1; }
    }

    fn shl(&mut self, bits: i32) {
        let words = (bits / 32) as usize;
        let rest = (bits % 32) as u32;
        if rest > 0 {
            let mut carry: u32 = 0;
            let mut i = 0;
            while i < self.n {
                let v = self.d[i];
                self.d[i] = (v << rest) | carry;
                carry = v >> (32 - rest);
                i += 1;
            }
            if carry > 0 {
                self.d[self.n] = carry;
                self.n += 1;
            }
        }
        if words > 0 && self.n > 0 {
            let mut i = self.n;
            while i > 0 {
                i -= 1;
                self.d[i + words] = self.d[i];
            }
            let mut j = 0;
            while j < words { self.d[j] = 0; j += 1; }
            self.n += words;
        }
    }

    fn add(&mut self, o: &Big) {
        let mut carry: u64 = 0;
        let m = if self.n > o.n { self.n } else { o.n };
        let mut i = 0;
        while i < m {
            let a = if i < self.n { self.d[i] as u64 } else { 0 };
            let b = if i < o.n { o.d[i] as u64 } else { 0 };
            let v = a + b + carry;
            self.d[i] = (v & 0xffffffff) as u32;
            carry = v >> 32;
            i += 1;
        }
        self.n = m;
        if carry > 0 {
            self.d[self.n] = carry as u32;
            self.n += 1;
        }
    }

    // self -= o (requires self >= o)
    fn sub(&mut self, o: &Big) {
        let mut borrow: i64 = 0;
        let mut i = 0;
        while i < self.n {
            let b = if i < o.n { o.d[i] as i64 } else { 0 };
            let mut v = (self.d[i] as i64) - b - borrow;
            if v < 0 {
                v += 4294967296;
                borrow = 1;
            } else {
                borrow = 0;
            }
            self.d[i] = v as u32;
            i += 1;
        }
        while self.n > 0 && self.d[self.n - 1] == 0 { self.n -= 1; }
    }

    fn cmp(&self, o: &Big) -> i32 {
        if self.n != o.n { return if self.n > o.n { 1 } else { -1 }; }
        let mut i = self.n;
        while i > 0 {
            i -= 1;
            if self.d[i] != o.d[i] { return if self.d[i] > o.d[i] { 1 } else { -1 }; }
        }
        0
    }

    fn copy(&self) -> Big {
        let mut b = Big { d: [0u32; 110], n: self.n };
        let mut i = 0;
        while i < self.n { b.d[i] = self.d[i]; i += 1; }
        b
    }

    // Divides by s, returning a quotient digit (0..9) and leaving the
    // remainder.
    fn div_digit(&mut self, s: &Big) -> u8 {
        let mut q = 0u8;
        while self.cmp(s) >= 0 {
            self.sub(s);
            q += 1;
        }
        q
    }

    // Divides by a small number, returning the remainder.
    fn divrem_small(&mut self, m: u32) -> u32 {
        let mut rem: u64 = 0;
        let mut i = self.n;
        while i > 0 {
            i -= 1;
            let v = (rem << 32) | (self.d[i] as u64);
            self.d[i] = (v / (m as u64)) as u32;
            rem = v % (m as u64);
        }
        while self.n > 0 && self.d[self.n - 1] == 0 { self.n -= 1; }
        rem as u32
    }
}

struct Out { buf: *mut u8, n: usize }

impl Out {
    fn byte(&mut self, b: u8) {
        unsafe { *self.buf.add(self.n) = b; }
        self.n += 1;
    }
    fn str(&mut self, s: &str) {
        for b in s.as_bytes() { self.byte(*b); }
    }
    fn zeros(&mut self, k: i32) {
        let mut i = 0;
        while i < k { self.byte(b'0'); i += 1; }
    }
}

// Decomposed float: value = mant * 2^exp.
struct Decoded { mant: u64, exp: i32, neg: bool, lower_boundary_closer: bool, even: bool }

fn decode(x: f64, single: bool) -> Decoded {
    if single {
        let y = x as f32;
        let bits = unsafe { *(&y as *const f32 as *const u32) } as u64;
        let neg = bits >> 31 != 0;
        let be = ((bits >> 23) & 0xff) as i32;
        let frac = bits & 0x7fffff;
        let (mant, exp) = if be == 0 { (frac, -149) } else { (frac | 0x800000, be - 150) };
        return Decoded { mant, exp, neg, lower_boundary_closer: be > 1 && frac == 0, even: mant % 2 == 0 };
    }
    let bits = unsafe { *(&x as *const f64 as *const u64) };
    let neg = bits >> 63 != 0;
    let be = ((bits >> 52) & 0x7ff) as i32;
    let frac = bits & 0xfffffffffffff;
    let (mant, exp) = if be == 0 { (frac, -1074) } else { (frac | 0x10000000000000, be - 1075) };
    Decoded { mant, exp, neg, lower_boundary_closer: be > 1 && frac == 0, even: mant % 2 == 0 }
}

// Shortest digits (Burger & Dybvig). Returns the number of digits written
// to digits and the decimal exponent k (value = 0.d1d2... * 10^k).
fn shortest(dv: &Decoded, digits: &mut [u8; 40]) -> (usize, i32) {
    let mut r: Big;
    let mut s: Big;
    let mut mp: Big;
    let mut mm: Big;
    if dv.exp >= 0 {
        let mut be = Big::from_u64(1);
        be.shl(dv.exp);
        if !dv.lower_boundary_closer {
            r = Big::from_u64(dv.mant);
            r.shl(dv.exp + 1);
            s = Big::from_u64(2);
            mp = be.copy();
            mm = be;
        } else {
            r = Big::from_u64(dv.mant);
            r.shl(dv.exp + 2);
            s = Big::from_u64(4);
            mp = be.copy();
            mp.shl(1);
            mm = be;
        }
    } else if !dv.lower_boundary_closer {
        r = Big::from_u64(dv.mant);
        r.shl(1);
        s = Big::from_u64(1);
        s.shl(1 - dv.exp);
        mp = Big::from_u64(1);
        mm = Big::from_u64(1);
    } else {
        r = Big::from_u64(dv.mant);
        r.shl(2);
        s = Big::from_u64(1);
        s.shl(2 - dv.exp);
        mp = Big::from_u64(2);
        mm = Big::from_u64(1);
    }
    // Scale so that r/s is in [0.1, 1): find k with high = r + mp.
    let mut k: i32 = 0;
    loop {
        let mut high = r.copy();
        high.add(&mp);
        let c = high.cmp(&s);
        if c > 0 || c == 0 && dv.even {
            s.mul_small(10);
            k += 1;
        } else {
            break;
        }
    }
    loop {
        let mut high = r.copy();
        high.add(&mp);
        high.mul_small(10);
        let c = high.cmp(&s);
        if c < 0 || c == 0 && !dv.even {
            r.mul_small(10);
            mp.mul_small(10);
            mm.mul_small(10);
            k -= 1;
        } else {
            break;
        }
    }
    let mut n = 0;
    loop {
        r.mul_small(10);
        mp.mul_small(10);
        mm.mul_small(10);
        let d = r.div_digit(&s);
        let c1 = r.cmp(&mm);
        let low = c1 < 0 || c1 == 0 && dv.even;
        let mut high = r.copy();
        high.add(&mp);
        let c2 = high.cmp(&s);
        let hi = c2 > 0 || c2 == 0 && dv.even;
        if !low && !hi {
            digits[n] = d;
            n += 1;
            continue;
        }
        if low && !hi {
            digits[n] = d;
        } else if hi && !low {
            digits[n] = d + 1;
        } else {
            let mut twice = r.copy();
            twice.shl(1);
            digits[n] = if twice.cmp(&s) < 0 { d } else { d + 1 };
        }
        n += 1;
        break;
    }
    (n, k)
}

impl Big {
    fn bits(&self) -> usize {
        if self.n == 0 { return 0; }
        let mut top = self.d[self.n - 1];
        let mut b = 0;
        while top > 0 { b += 1; top = top >> 1; }
        (self.n - 1) * 32 + b
    }

    fn bit(&self, i: usize) -> u32 { (self.d[i / 32] >> ((i % 32) as u32)) & 1 }

    fn set_bit(&mut self, i: usize) {
        while self.n <= i / 32 { self.d[self.n] = 0; self.n += 1; }
        self.d[i / 32] = self.d[i / 32] | (1u32 << ((i % 32) as u32));
    }
}

// Returns round_half_even(value * 10^p) for value = mant * 2^exp.
fn round_scaled(dv: &Decoded, p: i32) -> Big {
    let mut num = Big::from_u64(dv.mant);
    let mut den = Big::from_u64(1);
    if dv.exp >= 0 { num.shl(dv.exp); } else { den.shl(-dv.exp); }
    if p >= 0 { num.mul_pow10(p); } else { den.mul_pow10(-p); }
    // Binary long division.
    let mut q = Big::from_u64(0);
    let mut r = Big::from_u64(0);
    let mut i = num.bits();
    while i > 0 {
        i -= 1;
        r.shl(1);
        if num.bit(i) == 1 {
            if r.n == 0 { r.n = 1; r.d[0] = 1; } else { r.d[0] = r.d[0] | 1; }
        }
        if r.cmp(&den) >= 0 {
            r.sub(&den);
            q.set_bit(i);
        }
    }
    r.shl(1);
    let c = r.cmp(&den);
    if c > 0 || c == 0 && q.n > 0 && q.d[0] % 2 == 1 {
        q.add(&Big::from_u64(1));
    }
    q
}

// Decimal digits of q, most significant first; returns the count.
fn digits_of(q: &Big, ds: &mut [u8; 1100]) -> usize {
    let mut t = q.copy();
    let mut rev = [0u8; 1100];
    let mut n = 0;
    while !t.is_zero() {
        rev[n] = t.divrem_small(10) as u8;
        n += 1;
    }
    let mut i = 0;
    while i < n { ds[i] = rev[n - 1 - i]; i += 1; }
    n
}

// Writes v rounded to prec digits after the decimal point.
fn fixed(dv: &Decoded, prec: usize, out: &mut Out) {
    let q = round_scaled(dv, prec as i32);
    let mut ds = [0u8; 1100];
    let n = digits_of(&q, &mut ds);
    // Pad with leading zeros so there is at least one integer digit.
    let mut lead = 0;
    if n <= prec { lead = prec + 1 - n; }
    let total = n + lead;
    let mut i = 0;
    while i < total {
        if i == total - prec { out.byte(b'.'); }
        out.byte(if i < lead { b'0' } else { b'0' + ds[i - lead] });
        i += 1;
    }
}

// Writes v in exponent form with prec digits after the decimal point.
fn exp_prec(dv: &Decoded, prec: usize, k0: i32, upper: bool, out: &mut Out) {
    let mut ds = [0u8; 1100];
    let mut n = 0;
    let mut k = k0;
    if dv.mant == 0 {
        n = prec + 1;
        k = 1;
    } else {
        loop {
            let q = round_scaled(dv, prec as i32 + 1 - k);
            n = digits_of(&q, &mut ds);
            if n < prec + 1 { k -= 1; } else if n > prec + 1 { k += 1; } else { break; }
        }
    }
    out.byte(b'0' + ds[0]);
    if prec > 0 {
        out.byte(b'.');
        let mut i = 1;
        while i < n { out.byte(b'0' + ds[i]); i += 1; }
    }
    out.byte(if upper { b'E' } else { b'e' });
    put_i32(out, if dv.mant == 0 { 0 } else { k - 1 });
}

fn put_i32(out: &mut Out, v: i32) {
    if v < 0 { out.byte(b'-'); }
    let mut x = if v < 0 { -v } else { v };
    let mut buf = [0u8; 12];
    let mut n = 0;
    loop {
        buf[n] = b'0' + (x % 10) as u8;
        n += 1;
        x = x / 10;
        if x == 0 { break; }
    }
    while n > 0 { n -= 1; out.byte(buf[n]); }
}

/// Formats x into buf; style: 0 Display, 1 Debug, 2 {:e}, 3 {:E}, +16 for
/// f32. Returns the number of bytes written.
pub fn format(x: f64, prec: usize, has_prec: bool, style: u8, buf: *mut u8) -> usize {
    let mut out = Out { buf, n: 0 };
    let single = style >= 16;
    let style = if single { style - 16 } else { style };
    if x != x {
        out.str("NaN");
        return out.n;
    }
    let dv = decode(x, single);
    if dv.neg { out.byte(b'-'); }
    if x == 1.0 / 0.0 || x == -1.0 / 0.0 {
        out.str("inf");
        return out.n;
    }
    let prec = if prec > 700 { 700 } else { prec };
    if style < 2 && has_prec {
        fixed(&dv, prec, &mut out);
        return out.n;
    }
    let mut digits = [0u8; 40];
    let (n, k) = if dv.mant == 0 { digits[0] = 0; (1, 1) } else { shortest(&dv, &mut digits) };
    if style >= 2 && has_prec {
        exp_prec(&dv, prec, k, style == 3, &mut out);
        return out.n;
    }
    if style >= 2 {
        out.byte(b'0' + digits[0]);
        if n > 1 {
            out.byte(b'.');
            let mut i = 1;
            while i < n { out.byte(b'0' + digits[i]); i += 1; }
        }
        out.byte(if style == 3 { b'E' } else { b'e' });
        put_i32(&mut out, if dv.mant == 0 { 0 } else { k - 1 });
        return out.n;
    }
    let n = n as i32;
    if k <= 0 {
        out.str("0.");
        out.zeros(-k);
        let mut i = 0;
        while i < n { out.byte(b'0' + digits[i as usize]); i += 1; }
    } else if k >= n {
        let mut i = 0;
        while i < n { out.byte(b'0' + digits[i as usize]); i += 1; }
        out.zeros(k - n);
        if style == 1 { out.str(".0"); }
    } else {
        let mut i = 0;
        while i < n {
            if i == k { out.byte(b'.'); }
            out.byte(b'0' + digits[i as usize]);
            i += 1;
        }
    }
    out.n
}
