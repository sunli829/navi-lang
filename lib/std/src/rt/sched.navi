//! Green threads for native programs: goroutine-style Gs. A G runs until it
//! blocks (join, a channel operation, select) or yields; the scheduler then
//! runs another runnable G. Every G has its own stack (reserved address
//! space, committed by the OS on first touch); function prologues check the
//! running G's stack limit.
//!
//! Built by navic, Gs run on up to one OS thread (M) per CPU (M:N; at most
//! NAVI_MAXPROCS). Each M runs its scheduler loop on its own record (g0):
//! a G that blocks switches to its M's g0, which picks the next runnable G
//! from the global run queue, or sleeps until there is one. One runtime
//! lock guards the scheduler, the channels and the heap; it is only taken
//! once a second M exists. The collector stops the world: see
//! stop_the_world. Built by stage0 (to bootstrap navic), there is one M.
//!
//! Waiting follows the interpreter's semantics (a condition variable per
//! waitable object): a blocked G registers on the wait lists it cares
//! about and re-checks its condition when woken.

#[cfg(not(target_os = "windows"))]
extern "C" {
    fn mmap(addr: *mut u8, len: usize, prot: i32, flags: i32, fd: i32, off: i64) -> *mut u8;
    fn munmap(addr: *mut u8, len: usize) -> i32;
}

#[cfg(target_os = "windows")]
extern "C" {
    fn VirtualAlloc(addr: *mut u8, size: usize, kind: u32, protect: u32) -> *mut u8;
    fn VirtualFree(addr: *mut u8, size: usize, kind: u32) -> i32;
}

#[cfg(target_os = "macos")]
const MAP_FLAGS: i32 = 0x1002;
#[cfg(target_os = "linux")]
const MAP_FLAGS: i32 = 0x4022;
#[cfg(target_os = "windows")]
const MAP_FLAGS: i32 = 0;

const MAIN_STACK: usize = 67108864; // 64 MiB
// The first stack of a spawned G (navic: grown by copying, up to
// MAX_STACK; stage0 builds keep it).
#[cfg(not(feature = "navic"))]
const STACK: usize = 1048576;
#[cfg(feature = "navic")]
const STACK: usize = 65536;
const MAX_STACK: usize = 1073741824; // 1 GiB
// The bottom of every stack is left for C calls made near the limit.
const RED_ZONE: usize = 32768;

const RUNNING: u8 = 0;
const RUNNABLE: u8 = 1;
const WAITING: u8 = 2;
const DEAD: u8 = 3;

/// A green thread.
pub struct G {
    // First: the stack limit function prologues check (navic; see
    // backend::lower). The collector sets it to the maximum to stop the G.
    guard: usize,
    // Second (navic): while non-zero the G does not stop for the collector
    // at a prologue (a write barrier runs; generated code increments it).
    nopreempt: usize,
    // Third and fourth (navic; see backend::lower): the bytes the function
    // entering morestack needs below its SP, and the SP of morestack's stub
    // (below it, the registers it saved).
    need: usize,
    entry_sp: usize,
    // A stack left by growing (freed by the next morestack, which runs on
    // the new one).
    old_stack: usize,
    old_size: usize,
    // std::thread::ThreadId.
    tid: u64,
    // Saved context (sp, fp, pc) while not running.
    sp: usize,
    fp: usize,
    pc: usize,
    stack_lo: usize,
    stack_hi: usize,
    status: u8,
    main: bool,
    entry: fn(),
    next: *mut G, // run queue
    all_next: *mut G,
    wait_gen: usize,
    // The innermost catch_unwind record (see native::try_call), or 0.
    catch: usize,
    // M:N (navic): the M running it, how many times it holds the runtime
    // lock, its state for the collector (SYS_*), whether the collector
    // poisoned its stack limit, whether it is an M's scheduler record, and
    // its callee-saved registers while blocked outside navi code.
    m: usize,
    lock_depth: usize,
    sys: usize,
    poisoned: bool,
    is_g0: bool,
    regs: [usize; 10],
    // The object locks (addresses of lock words) its M's scheduler record
    // releases once the G has switched away (see park_on).
    release: usize,
    release_n: usize,
}

// G.sys: running navi code; blocked in C (a system call or waiting for the
// runtime lock), with its stack pointer and registers saved; the same,
// claimed by a collector (it waits before running navi code again);
// stopped at a safepoint for a collector.
const SYS_RUNNING: usize = 0;
const SYS_BLOCKED: usize = 1;
const SYS_CLAIMED: usize = 2;
const SYS_STOPPED: usize = 3;

struct WaitNode { g: *mut G, gen: usize, key: usize, next: *mut WaitNode }

/// A list of Gs waiting for a change of some object, in arrival order.
pub struct WaitList { head: *mut WaitNode, tail: *mut WaitNode }

static mut CUR: usize = 0;
static mut RUN_HEAD: usize = 0;
static mut RUN_TAIL: usize = 0;
static mut ALL: usize = 0;
static mut FREE_GS: usize = 0; // dead Gs whose records and stacks are reused (linked by next)

fn reserve(size: usize) -> usize { reserve_os(size) }

#[cfg(not(target_os = "windows"))]
fn reserve_os(size: usize) -> usize {
    let p = unsafe { mmap(0 as *mut u8, size, 3, MAP_FLAGS, -1, 0) } as usize;
    if p == 0 || p == 18446744073709551615 { crate::rt::native::fatal("cannot allocate a stack"); }
    p
}

#[cfg(not(target_os = "windows"))]
fn release_os(p: usize, size: usize) { unsafe { munmap(p as *mut u8, size); } }

#[cfg(target_os = "windows")]
fn release_os(p: usize, size: usize) { unsafe { VirtualFree(p as *mut u8, 0, 0x8000); } }

#[cfg(target_os = "windows")]
fn reserve_os(size: usize) -> usize {
    let p = unsafe { VirtualAlloc(0 as *mut u8, size, 0x3000, 4) } as usize;
    if p == 0 { crate::rt::native::fatal("cannot allocate a stack"); }
    p
}

fn new_g() -> *mut G {
    // G records are GC objects kept alive by the ALL list (a static), so
    // their entry closures are traced.
    let g = crate::rt::gc::alloc(crate::intrinsics::size_of::<G>(), false) as *mut G;
    unsafe {
        (*g).all_next = ALL as *mut G;
    }
    ALL = g as usize;
    g
}

/// Called by the entry point before anything else: creates the main G
/// and returns the top of its stack (the entry point switches to it).
pub fn init() -> usize {
    let g = new_g();
    let base = reserve(MAIN_STACK);
    unsafe {
        (*g).stack_lo = base;
        (*g).stack_hi = base + MAIN_STACK;
        (*g).status = RUNNING;
        (*g).main = true;
        (*g).tid = 1;
        (*g).entry = || {};
        (*g).guard = base + RED_ZONE;
    }
    init_ms(g);
    set_current(g);
    base + MAIN_STACK
}

#[cfg(not(feature = "navic"))]
fn init_ms(main: *mut G) {}

// The running G: navic keeps it in a register (each OS thread has its own),
// stage0 in CUR.
#[cfg(feature = "navic")]
pub fn current() -> *mut G { crate::rt::current_g() as *mut G }
#[cfg(not(feature = "navic"))]
pub fn current() -> *mut G { CUR as *mut G }

#[cfg(feature = "navic")]
fn set_current(g: *mut G) { crate::rt::set_current_g(g as usize); }
#[cfg(not(feature = "navic"))]
fn set_current(g: *mut G) {
    CUR = g as usize;
    unsafe { crate::rt::set_stack_limit((*g).guard); }
}

// Switches from prev to next. navic's context switch also switches the G
// register; stage0 code reads CUR and the global stack limit.
#[cfg(feature = "navic")]
fn switch(prev: *mut G, next: *mut G) {
    unsafe { crate::rt::swap_context(&mut (*prev).sp as *mut usize as *mut u8, &mut (*next).sp as *mut usize as *mut u8); }
}
#[cfg(not(feature = "navic"))]
fn switch(prev: *mut G, next: *mut G) {
    set_current(next);
    unsafe { crate::rt::swap_context(&mut (*prev).sp as *mut usize as *mut u8, &mut (*next).sp as *mut usize as *mut u8); }
}

// Whether the scheduler has not started (the running G is a blank record).
fn booting() -> bool {
    let g = current();
    g as usize == 0 || unsafe { (*g).stack_hi } == 0
}

/// The current G's innermost catch_unwind record (0: none).
pub fn catch_top() -> usize { unsafe { (*current()).catch } }
pub fn set_catch_top(r: usize) { unsafe { (*current()).catch = r; } }

/// Whether the running G is the main thread (for panic messages).
pub fn is_main() -> bool {
    if booting() { return true; }
    unsafe { (*current()).main }
}

/// The stack range of the running G that the collector must scan, and
/// calls f for the saved stack of every other live G.
pub fn current_stack_hi() -> usize {
    if booting() { return crate::rt::stack_top() as usize + 16; }
    unsafe { (*current()).stack_hi }
}

/// Scans a stack [sp, hi) for the collector, its innermost frame at fp:
/// the frames of user code by their stack maps (as Go's scanframe), the
/// rest (the runtime, std, code without maps) conservatively, as are the
/// registers the G saved when it stopped (below fp).
#[cfg(feature = "navic")]
pub fn scan_stack(sp: usize, fp0: usize, hi: usize) {
    stack_mode();
    if STACKMAP != 1 || fp0 < sp || fp0 >= hi {
        crate::rt::gc::scan_range(sp, hi);
        return;
    }
    let mut pend = [0usize; 9];
    let mut top = sp;
    let mut fp = fp0;
    let mut pc = 0usize;
    while fp >= top && fp < hi {
        let prev = unsafe { *(fp as *const usize) };
        let ret = unsafe { *((fp + 8) as *const usize) };
        let (m, start) = if pc == 0 { (0, 0) } else { find_map(pc) };
        let flags = if m == 0 { 3 } else { unsafe { *((m + 8) as *const usize) } };
        if flags != 0 {
            crate::rt::gc::scan_range(top, fp);
            let mut k = 0;
            while k < 9 {
                if pend[k] != 0 { crate::rt::gc::scan_range(pend[k], pend[k] + 8); }
                pend[k] = 0;
                k += 1;
            }
        } else {
            let frame = unsafe { *(m as *const usize) };
            let any = unsafe { *((m + 16) as *const usize) };
            let nb = unsafe { *((m + 24) as *const usize) };
            let fsp = fp - frame;
            if top < fsp { crate::rt::gc::scan_range(top, fsp); }
            crate::rt::gc::scan_range(fsp, fsp + 8 * any);
            let mut w = any;
            while w < frame / 8 {
                let i = w - any;
                let bits = unsafe { *((m + 32 + 8 * (i / 64)) as *const usize) };
                if (bits >> (i % 64) as u32) & 1 != 0 { crate::rt::gc::scan_range(fsp + 8 * w, fsp + 8 * w + 8); }
                w += 1;
            }
            let sv = m + 32 + 8 * nb;
            let ns = unsafe { *(sv as *const usize) };
            let mask = call_mask(sv + 8 + 8 * ns, pc - start);
            let mut j = 0;
            while j < ns {
                let e = unsafe { *((sv + 8 + 8 * j) as *const usize) };
                let r = e >> 32;
                let off = (e & 0xffffffff) as u32 as i32 as i64 as usize;
                if pend[r] != 0 && (mask >> r as u32) & 1 != 0 { crate::rt::gc::scan_range(pend[r], pend[r] + 8); }
                pend[r] = fp.wrapping_add(off);
                j += 1;
            }
        }
        top = fp + 16;
        fp = prev;
        pc = ret;
    }
    crate::rt::gc::scan_range(top, hi);
    let mut k = 0;
    while k < 9 {
        if pend[k] != 0 { crate::rt::gc::scan_range(pend[k], pend[k] + 8); }
        k += 1;
    }
}
#[cfg(not(feature = "navic"))]
pub fn scan_stack(sp: usize, fp0: usize, hi: usize) { crate::rt::gc::scan_range(sp, hi); }

/// Scans the saved stack of every other live G.
pub fn scan_other_stacks() {
    let mut g = ALL as *mut G;
    while g as usize != 0 {
        unsafe {
            if (*g).status != DEAD && !(*g).is_g0 && g as usize != current() as usize {
                scan_stack((*g).sp, (*g).fp, (*g).stack_hi);
                let r = &(*g).regs as *const [usize; 10] as usize;
                crate::rt::gc::scan_range(r, r + 80);
            }
            g = (*g).all_next;
        }
    }
}

/// Starts a new G running f.
pub fn go(f: fn()) {
    lock();
    let mut g = FREE_GS as *mut G;
    if g as usize != 0 {
        FREE_GS = unsafe { (*g).next } as usize;
        unsafe {
            if (*g).old_size != 0 {
                release_os((*g).old_stack, (*g).old_size);
                (*g).old_size = 0;
            }
        }
    } else {
        g = new_g();
        let stack = reserve(STACK);
        unsafe {
            (*g).stack_lo = stack;
            (*g).stack_hi = stack + STACK;
        }
    }
    unsafe {
        // 80 bytes below the top hold the callee-saved registers the context
        // switch restores.
        (*g).sp = (*g).stack_hi - 80;
        (*g).fp = 0;
        (*g).pc = crate::rt::gstart_address() as usize;
        (*g).entry = f;
        (*g).catch = 0;
        (*g).guard = (*g).stack_lo + RED_ZONE;
        // The G register (x28, the last of the saved registers) of the
        // first context.
        *(((*g).stack_hi - 8) as *mut usize) = g as usize;
        (*g).lock_depth = 0;
        (*g).sys = SYS_RUNNING;
        (*g).poisoned = false;
        (*g).release_n = 0;
        NEXT_TID += 1;
        (*g).tid = NEXT_TID;
    }
    ready(g);
    unlock();
}

/// The first function of every spawned G (called by the start routine).
pub fn gmain() -> ! {
    let g = current();
    let f = unsafe { (*g).entry };
    f();
    exit_current()
}

#[cfg(not(feature = "navic"))]
fn exit_current() -> ! {
    lock();
    let g = current();
    // The record and its stack are reused by a later G once this one has
    // switched away for good. Dead Gs stay on the ALL list (so they stay
    // allocated) but their stacks are not scanned.
    unsafe {
        (*g).status = DEAD;
        (*g).entry = || {};
        (*g).next = FREE_GS as *mut G;
    }
    FREE_GS = g as usize;
    block_current();
    crate::rt::native::fatal("dead goroutine resumed")
}

// Queues g (the runtime lock is held).
fn enqueue(g: *mut G) {
    unsafe {
        (*g).status = RUNNABLE;
        (*g).next = 0 as *mut G;
        if RUN_TAIL == 0 {
            RUN_HEAD = g as usize;
        } else {
            (*(RUN_TAIL as *mut G)).next = g;
        }
    }
    RUN_TAIL = g as usize;
}

fn dequeue() -> *mut G {
    let g = RUN_HEAD as *mut G;
    if g as usize != 0 {
        unsafe {
            RUN_HEAD = (*g).next as usize;
            if RUN_HEAD == 0 { RUN_TAIL = 0; }
        }
    }
    g
}

// schedule switches to the next runnable G. The current G must already be
// queued, waiting or dead.
#[cfg(not(feature = "navic"))]
fn schedule() {
    if RUN_HEAD == 0 {
        crate::rt::native::fatal("all goroutines are asleep - deadlock!");
    }
    let next = RUN_HEAD as *mut G;
    unsafe {
        RUN_HEAD = (*next).next as usize;
        if RUN_HEAD == 0 { RUN_TAIL = 0; }
        (*next).status = RUNNING;
    }
    let prev = current();
    if next as usize == prev as usize { return; }
    switch(prev, next);
}

/// Lets other Gs run.
#[cfg(not(feature = "navic"))]
pub fn yield_now() {
    lock();
    ready(current());
    block_current();
    unlock();
}

// --- One OS thread (stage0) -----------------------------------------------------

#[cfg(not(feature = "navic"))]
fn ready(g: *mut G) { enqueue(g); }

// The running G stops (it is queued, waiting or dead) until it is resumed.
#[cfg(not(feature = "navic"))]
fn block_current() { schedule(); }

// Blocks the running G (its wait nodes are enlisted) until woken.
#[cfg(not(feature = "navic"))]
fn park_on(locks: *const usize, n: usize) {
    let g = current();
    unsafe { (*g).status = WAITING; }
    schedule();
}
#[cfg(not(feature = "navic"))]
fn obj_lock(lk: *mut usize) {}
#[cfg(not(feature = "navic"))]
fn obj_unlock(lk: *mut usize) {}

#[cfg(not(feature = "navic"))]
pub fn lock() {}
#[cfg(not(feature = "navic"))]
pub fn unlock() {}
#[cfg(not(feature = "navic"))]
pub fn enter_blocked() {}
#[cfg(not(feature = "navic"))]
pub fn exit_blocked() {}
#[cfg(not(feature = "navic"))]
pub fn stop_the_world() {}
#[cfg(not(feature = "navic"))]
pub fn preempt_off() {}
#[cfg(not(feature = "navic"))]
pub fn preempt_on() {}
#[cfg(not(feature = "navic"))]
pub fn flush_caches() {}
#[cfg(not(feature = "navic"))]
pub fn start_the_world() {}

// --- Waiting -------------------------------------------------------------------

pub fn new_wait_list() -> WaitList { WaitList { head: 0 as *mut WaitNode, tail: 0 as *mut WaitNode } }

/// Registers the running G at the end of w (it may register on several
/// lists; once woken from one, its nodes on the others are stale).
pub fn enlist(w: *mut WaitList) { enlist_key(w, 0); }

fn enlist_key(w: *mut WaitList, key: usize) {
    let g = current();
    let n = crate::rt::gc::alloc(crate::intrinsics::size_of::<WaitNode>(), false) as *mut WaitNode;
    unsafe {
        (*n).g = g;
        (*n).gen = (*g).wait_gen;
        (*n).key = key;
        (*n).next = 0 as *mut WaitNode;
        if (*w).head as usize == 0 { (*w).head = n; } else { (*(*w).tail).next = n; }
        (*w).tail = n;
    }
}

/// Waits on w, whose object lock lk is held (and held again on return).
pub fn wait(w: *mut WaitList, lk: *mut usize) { wait_key(w, lk, 0); }

fn wait_key(w: *mut WaitList, lk: *mut usize, key: usize) {
    enlist_key(w, key);
    let one = [lk as usize];
    park_on(&one as *const [usize; 1] as *const usize, 1);
}

// Whether n's G still waits for it (not woken through another list).
fn live(n: *mut WaitNode) -> bool {
    unsafe { (*n).gen == (*(*n).g).wait_gen && (*(*n).g).status == WAITING }
}

fn unlink_head(w: *mut WaitList) -> *mut WaitNode {
    unsafe {
        let n = (*w).head;
        (*w).head = (*n).next;
        if (*w).head as usize == 0 { (*w).tail = 0 as *mut WaitNode; }
        n
    }
}

// Wakes the G of n (the runtime lock is held).
// (Several threads may wake a G waiting on several lists at once: the one
// that moves its wait_gen on readies it.)
fn wake(n: *mut WaitNode) {
    unsafe {
        let g = (*n).g;
        if word_cas(&mut (*g).wait_gen as *mut usize, (*n).gen, (*n).gen + 1) { ready(g); }
    }
}

/// Wakes the first G still waiting on w, if any (its object lock is held).
pub fn signal(w: *mut WaitList) {
    while unsafe { (*w).head } as usize != 0 {
        let n = unlink_head(w);
        if live(n) {
            wake(n);
            break;
        }
    }
}

// Wakes the Gs at the front of w whose key is at most k (w is in key
// order).
fn signal_upto(w: *mut WaitList, k: usize) {
    while unsafe { (*w).head } as usize != 0 {
        let h = unsafe { (*w).head };
        if live(h) && unsafe { (*h).key } > k { break; }
        let n = unlink_head(w);
        if live(n) { wake(n); }
    }
}

/// Wakes every G waiting on w (its object lock is held).
pub fn broadcast(w: *mut WaitList) {
    let mut n = unsafe { (*w).head };
    if n as usize == 0 { return; }
    unsafe {
        (*w).head = 0 as *mut WaitNode;
        (*w).tail = 0 as *mut WaitNode;
    }
    while n as usize != 0 {
        unsafe {
            if live(n) { wake(n); }
            n = (*n).next;
        }
    }
}

// --- Threads -------------------------------------------------------------------

/// A spawned thread: its result cell and the Gs joining it.
pub struct Handle { lk: usize, done: bool, result: *mut u8, waiters: WaitList }

pub fn new_handle(result: *mut u8) -> *mut Handle {
    &mut Handle { lk: 0, done: false, result, waiters: new_wait_list() } as *mut Handle
}

pub fn finish(h: *mut Handle) {
    unsafe {
        let lk = &mut (*h).lk as *mut usize;
        obj_lock(lk);
        (*h).done = true;
        broadcast(&mut (*h).waiters as *mut WaitList);
        obj_unlock(lk);
    }
}

pub fn join(h: *mut Handle) -> *mut u8 {
    unsafe {
        let lk = &mut (*h).lk as *mut usize;
        obj_lock(lk);
        while !(*h).done { wait(&mut (*h).waiters as *mut WaitList, lk); }
        obj_unlock(lk);
        (*h).result
    }
}

// --- Channels ------------------------------------------------------------------

const UNBOUNDED: usize = 18446744073709551615;

/// A channel of elements of elem bytes, stored in a ring buffer.
pub struct Chan {
    // The channel's lock (see obj_lock).
    lk: usize,
    elem: usize,
    cap: usize,
    buf: *mut u8,
    head: usize,
    len: usize,
    slots: usize,
    closed: bool,
    send_seq: usize,
    recv_seq: usize,
    recv_waiter: usize,
    // Receivers waiting for an element; senders waiting for room (and, on
    // an unbuffered channel, selects waiting for a receiver); unbuffered
    // senders waiting for their element to be taken (keyed by its send_seq).
    // Each element wakes one receiver, each taken element one sender.
    recvq: WaitList,
    sendq: WaitList,
    ackq: WaitList,
    // Writes Result<T, RecvError> for select: (slot, value or null).
    write_result: fn(*mut u8, *const u8),
}

pub fn new_chan(elem: usize, cap: usize, write_result: fn(*mut u8, *const u8)) -> *mut Chan {
    &mut Chan { lk: 0, elem, cap, buf: 0 as *mut u8, head: 0, len: 0, slots: 0, closed: false, send_seq: 0,
        recv_seq: 0, recv_waiter: 0, recvq: new_wait_list(), sendq: new_wait_list(),
        ackq: new_wait_list(), write_result } as *mut Chan
}

fn recvq(c: *mut Chan) -> *mut WaitList { unsafe { &mut (*c).recvq as *mut WaitList } }
fn sendq(c: *mut Chan) -> *mut WaitList { unsafe { &mut (*c).sendq as *mut WaitList } }
fn ackq(c: *mut Chan) -> *mut WaitList { unsafe { &mut (*c).ackq as *mut WaitList } }

// After an element was taken: its unbuffered sender, or a sender waiting
// for room.
fn taken(c: *mut Chan) {
    unsafe {
        if (*c).cap == 0 { signal_upto(ackq(c), (*c).recv_seq); } else { signal(sendq(c)); }
    }
}

// Passes on the wakes a select did not use: whoever may proceed on c.
fn kick(c: *mut Chan) {
    unsafe {
        if (*c).closed {
            broadcast(recvq(c));
            broadcast(sendq(c));
            return;
        }
        if (*c).len > 0 { signal(recvq(c)); }
        if (*c).cap == UNBOUNDED || (*c).len < (*c).cap || (*c).cap == 0 && (*c).recv_waiter > (*c).len { signal(sendq(c)); }
    }
}
fn lk(c: *mut Chan) -> *mut usize { unsafe { &mut (*c).lk as *mut usize } }

fn copy_bytes(src: *const u8, dst: *mut u8, n: usize) { crate::rt::copy::<u8>(src, dst, n); }

fn push(c: *mut Chan, src: *const u8) {
    unsafe {
        if (*c).len == (*c).slots {
            // Grow the ring (scan: elements may hold pointers).
            let slots = if (*c).slots == 0 { 4 } else { (*c).slots * 2 };
            let elem = if (*c).elem == 0 { 1 } else { (*c).elem };
            let nb = crate::rt::gc::alloc(slots * elem, false);
            let mut i = 0;
            preempt_off();
            while i < (*c).len {
                let from = ((*c).head + i) % (*c).slots;
                copy_bytes(crate::rt::ptr_offset((*c).buf as *const u8, from * elem), crate::rt::ptr_offset(nb as *const u8, i * elem) as *mut u8, elem);
                i += 1;
            }
            crate::rt::gc::shade_range(nb as usize, (*c).len * elem);
            preempt_on();
            (*c).buf = nb;
            (*c).head = 0;
            (*c).slots = slots;
        }
        let at = ((*c).head + (*c).len) % (*c).slots;
        let dst = crate::rt::ptr_offset((*c).buf as *const u8, at * (*c).elem) as *mut u8;
        // The element may hold pointers (the copy is of bytes).
        preempt_off();
        copy_bytes(src, dst, (*c).elem);
        crate::rt::gc::shade_range(dst as usize, (*c).elem);
        preempt_on();
        (*c).len += 1;
    }
}

fn pop(c: *mut Chan, dst: *mut u8) {
    unsafe {
        preempt_off();
        copy_bytes(crate::rt::ptr_offset((*c).buf as *const u8, (*c).head * (*c).elem), dst, (*c).elem);
        crate::rt::gc::shade_range(dst as usize, (*c).elem);
        preempt_on();
        (*c).head = ((*c).head + 1) % (*c).slots;
        (*c).len -= 1;
    }
}

/// Sends the elem bytes at src; false if the channel is closed.
pub fn send(c: *mut Chan, src: *const u8) -> bool {
    obj_lock(lk(c));
    let ok = send_locked(c, src);
    obj_unlock(lk(c));
    ok
}

fn send_locked(c: *mut Chan, src: *const u8) -> bool {
    unsafe {
        loop {
            if (*c).closed { return false; }
            if (*c).cap == UNBOUNDED || (*c).len < (*c).cap || (*c).cap == 0 { break; }
            wait(sendq(c), lk(c));
        }
        push(c, src);
        (*c).send_seq += 1;
        let seq = (*c).send_seq;
        signal(recvq(c));
        if (*c).cap == 0 {
            while (*c).recv_seq < seq && !(*c).closed { wait_key(ackq(c), lk(c), seq); }
        }
    }
    true
}

/// Receives into dst; false if the channel is closed and empty (or, when
/// not blocking, empty).
pub fn recv(c: *mut Chan, dst: *mut u8, block: bool) -> bool {
    obj_lock(lk(c));
    let ok = recv_locked(c, dst, block);
    obj_unlock(lk(c));
    ok
}

fn recv_locked(c: *mut Chan, dst: *mut u8, block: bool) -> bool {
    unsafe {
        (*c).recv_waiter += 1;
        // A select may send to an unbuffered channel once a receiver waits.
        if (*c).cap == 0 { signal(sendq(c)); }
        while (*c).len == 0 && !(*c).closed && block { wait(recvq(c), lk(c)); }
        (*c).recv_waiter -= 1;
        if (*c).len > 0 {
            pop(c, dst);
            (*c).recv_seq += 1;
            taken(c);
            return true;
        }
    }
    false
}

pub fn close(c: *mut Chan) {
    obj_lock(lk(c));
    unsafe { (*c).closed = true; }
    broadcast(recvq(c));
    broadcast(sendq(c));
    broadcast(ackq(c));
    obj_unlock(lk(c));
}

pub fn closed(c: *mut Chan) -> bool {
    obj_lock(lk(c));
    let r = unsafe { (*c).closed && (*c).len == 0 };
    obj_unlock(lk(c));
    r
}

/// Runs a select over cases; returns the index of the case that ran or
/// cases.len() for the default case.
pub fn run_select(cases: &[crate::sync::mpmc::SelectCase], has_default: bool) -> usize {
    // The locks of the distinct channels, in address order (no deadlock
    // with another select).
    let mut locks: Vec<usize> = Vec::new();
    for c in cases.iter() {
        let l = lk(case_chan(c)) as usize;
        if !locks.contains(&l) { locks.push(l); }
    }
    locks.sort();
    for l in locks.iter() { obj_lock(*l as *mut usize); }
    let i = select_locked(cases, has_default, &locks);
    for l in locks.iter() { obj_unlock(*l as *mut usize); }
    i
}

fn select_locked(cases: &[crate::sync::mpmc::SelectCase], has_default: bool, locks: &Vec<usize>) -> usize {
    let n = cases.len();
    let mut waited = false;
    loop {
        let mut i = 0;
        while i < n {
            let c = case_chan(&cases[i]);
            let slot = case_slot(&cases[i]);
            unsafe {
                if case_send(&cases[i]) {
                    let ready = (*c).cap == UNBOUNDED || (*c).len < (*c).cap
                        || (*c).cap == 0 && (*c).recv_waiter > (*c).len;
                    if !(*c).closed && ready {
                        push(c, slot as *const u8);
                        (*c).send_seq += 1;
                        signal(recvq(c));
                        if waited { kick_others(cases, i); }
                        return i;
                    }
                } else if (*c).len > 0 || (*c).closed {
                    if (*c).len > 0 {
                        let elem = if (*c).elem == 0 { 1 } else { (*c).elem };
                        let tmp = crate::rt::gc::alloc(elem, false);
                        pop(c, tmp);
                        (*c).recv_seq += 1;
                        taken(c);
                        ((*c).write_result)(slot, tmp as *const u8);
                    } else {
                        ((*c).write_result)(slot, 0 as *const u8);
                    }
                    if waited { kick_others(cases, i); }
                    return i;
                }
            }
            i += 1;
        }
        if has_default { return n; }
        let mut j = 0;
        while j < n {
            let cj = case_chan(&cases[j]);
            if case_send(&cases[j]) { enlist(sendq(cj)); } else { enlist(recvq(cj)); }
            j += 1;
        }
        park_on(locks.as_ptr(), locks.len());
        waited = true;
    }
}

// A woken select may have been the one woken for another case's channel:
// those channels are kicked (all their locks are held).
fn kick_others(cases: &[crate::sync::mpmc::SelectCase], chosen: usize) {
    let mine = case_chan(&cases[chosen]);
    let mut j = 0;
    while j < cases.len() {
        let c = case_chan(&cases[j]);
        if c as usize != mine as usize { kick(c); }
        j += 1;
    }
}

fn case_chan(c: &crate::sync::mpmc::SelectCase) -> *mut Chan {
    // The case points at the Sender or Receiver, whose first field is the
    // channel.
    unsafe { *(crate::sync::mpmc::select_case_chan(c) as *const *mut Chan) }
}

fn case_slot(c: &crate::sync::mpmc::SelectCase) -> *mut u8 { crate::sync::mpmc::select_case_slot(c) }
fn case_send(c: &crate::sync::mpmc::SelectCase) -> bool { crate::sync::mpmc::select_case_send(c) }

// --- M:N (navic) ------------------------------------------------------------------

#[cfg(feature = "navic")]
extern "C" {
    fn pthread_mutex_init(m: *mut u8, attr: *const u8) -> i32;
    fn pthread_mutex_lock(m: *mut u8) -> i32;
    fn pthread_mutex_trylock(m: *mut u8) -> i32;
    fn pthread_mutex_unlock(m: *mut u8) -> i32;
    fn pthread_cond_init(c: *mut u8, attr: *const u8) -> i32;
    fn pthread_cond_wait(c: *mut u8, m: *mut u8) -> i32;
    fn pthread_cond_signal(c: *mut u8) -> i32;
    fn pthread_create(t: *mut usize, attr: *const u8, start: usize, arg: usize) -> i32;
    fn pthread_detach(t: usize) -> i32;
    fn sched_yield() -> i32;
    fn calloc(n: usize, size: usize) -> *mut u8;
    fn sysconf(name: i32) -> i64;
}

#[cfg(all(feature = "navic", target_os = "macos"))]
const SC_NPROCESSORS_ONLN: i32 = 58;
#[cfg(all(feature = "navic", not(target_os = "macos")))]
const SC_NPROCESSORS_ONLN: i32 = 84;

// The stack of M0's scheduler record (other Ms use their thread's stack).
#[cfg(feature = "navic")]
const G0_STACK: usize = 262144;

/// An OS thread running Gs.
#[cfg(feature = "navic")]
struct M {
    g0: *mut G,
    cur: *mut G,
    next: *mut M,
    // A span per size class and noscan for allocation without the runtime
    // lock (see gc::alloc_mt).
    cache: [usize; 64],
    // The objects its write barriers marked, not yet shared (a gc mark
    // stack, made on first use; see gc::scan).
    wbuf: usize,
    // Its run queue (linked by G.next, under qlk) and the G to run next
    // (as Go's P: a readied G runs soon on the M that readied it).
    qlk: usize,
    qhead: usize,
    qtail: usize,
    qn: usize,
    runnext: usize,
    // Sleeping while idle: its own mutex, condition and flag (a note).
    note_mu: usize,
    note_cv: usize,
    note: usize,
    idle: bool,
    idle_next: usize,
    // What its scheduler record does after a G switched to it (AFTER_*).
    after: usize,
    after_g: usize,
}

// The runtime lock (pthread mutex) and the condition idle Ms wait on.
#[cfg(feature = "navic")]
static mut MU: usize = 0;
#[cfg(feature = "navic")]
static mut IDLE_CV: usize = 0;
// Whether a second M exists: before, the lock is not needed.
#[cfg(feature = "navic")]
static mut MULTI: bool = false;
#[cfg(feature = "navic")]
static mut NUM_M: usize = 1;
#[cfg(feature = "navic")]
static mut MAX_M: usize = 1;
#[cfg(feature = "navic")]
static mut IDLE: usize = 0;
#[cfg(feature = "navic")]
static mut MS: usize = 0;
// Set while a collector stops the world.
#[cfg(feature = "navic")]
static mut STW: usize = 0;

#[cfg(feature = "navic")]
pub fn multi() -> bool { MULTI }

/// The running M's span cache (an array of 64 words).
/// The running M's write barrier buffer (0: none, the G has no M).
#[cfg(feature = "navic")]
pub fn m_wbuf() -> usize {
    let g = current();
    unsafe {
        let m = (*g).m as *mut M;
        if m as usize == 0 { return 0; }
        if (*m).wbuf == 0 { (*m).wbuf = crate::rt::gc::new_mark_stack(); }
        (*m).wbuf
    }
}
#[cfg(not(feature = "navic"))]
pub fn m_wbuf() -> usize { 0 }

/// The write barrier buffer of the i-th M (0: none; WBUF_END past the
/// last; the world is stopped).
#[cfg(feature = "navic")]
pub fn wbuf_at(i: usize) -> usize {
    let mut m = MS as *mut M;
    let mut k = 0;
    while m as usize != 0 {
        if k == i { return unsafe { (*m).wbuf }; }
        m = unsafe { (*m).next };
        k += 1;
    }
    WBUF_END
}
#[cfg(not(feature = "navic"))]
pub fn wbuf_at(i: usize) -> usize { WBUF_END }

/// What wbuf_at gives past the last M.
pub const WBUF_END: usize = 18446744073709551615;

#[cfg(feature = "navic")]
pub fn m_cache() -> usize {
    let g = current();
    unsafe { &mut (*((*g).m as *mut M)).cache as *mut [usize; 64] as usize }
}

/// Empties every M's span cache (the world is stopped).
#[cfg(feature = "navic")]
pub fn flush_caches() {
    let mut m = MS as *mut M;
    while m as usize != 0 {
        unsafe {
            let mut i = 0;
            while i < 64 {
                (*m).cache[i] = 0;
                i += 1;
            }
            m = (*m).next;
        }
    }
}

// M0 (the main OS thread) and its scheduler record, whose loop runs on a
// stack of its own the first time the main G blocks.
#[cfg(feature = "navic")]
fn init_ms(main: *mut G) {
    let m = unsafe { calloc(1, crate::intrinsics::size_of::<M>()) } as *mut M;
    let g0 = new_g();
    let s0 = reserve(G0_STACK);
    unsafe {
        (*g0).stack_lo = s0;
        (*g0).stack_hi = s0 + G0_STACK;
        (*g0).guard = s0 + RED_ZONE;
        (*g0).status = RUNNING;
        (*g0).is_g0 = true;
        (*g0).m = m as usize;
        (*g0).entry = || { lock_held_mloop(); };
        (*g0).sp = (*g0).stack_hi - 80;
        (*g0).fp = 0;
        (*g0).pc = crate::rt::gstart_address() as usize;
        *(((*g0).stack_hi - 8) as *mut usize) = g0 as usize;
        (*m).g0 = g0;
        (*m).cur = main;
        (*main).m = m as usize;
    }
    new_note(m);
    MS = m as usize;
    MU = unsafe { calloc(1, 128) } as usize;
    IDLE_CV = unsafe { calloc(1, 128) } as usize;
    unsafe {
        pthread_mutex_init(MU as *mut u8, 0 as *const u8);
        pthread_cond_init(IDLE_CV as *mut u8, 0 as *const u8);
    }
    MAX_M = max_procs();
}

/// The most OS threads running Gs at once.
#[cfg(feature = "navic")]
pub fn procs() -> usize {
    if MAX_M == 0 { max_procs() } else { MAX_M }
}
#[cfg(not(feature = "navic"))]
pub fn procs() -> usize { 1 }

// NAVI_MAXPROCS, else the number of CPUs.
#[cfg(feature = "navic")]
fn max_procs() -> usize {
    if let Some(v) = crate::rt::native::os_getenv("NAVI_MAXPROCS") {
        let b = v.as_bytes();
        let mut n = 0usize;
        let mut i = 0;
        while i < b.len() && b[i] >= b'0' && b[i] <= b'9' {
            n = n * 10 + (b[i] - b'0') as usize;
            i += 1;
        }
        if n > 0 { return n; }
    }
    let n = unsafe { sysconf(SC_NPROCESSORS_ONLN) };
    if n < 1 { 1 } else { n as usize }
}

/// Takes the runtime lock (recursively). Waiting for it counts as being
/// blocked outside navi code, so that a collector holding it can proceed.
#[cfg(feature = "navic")]
pub fn lock() {
    let g = current();
    unsafe {
        (*g).lock_depth += 1;
        if (*g).lock_depth > 1 || !MULTI { return; }
        if pthread_mutex_trylock(MU as *mut u8) == 0 { return; }
        enter_blocked();
        pthread_mutex_lock(MU as *mut u8);
        exit_blocked();
    }
}

#[cfg(feature = "navic")]
pub fn unlock() {
    let g = current();
    unsafe {
        (*g).lock_depth -= 1;
        if (*g).lock_depth == 0 && MULTI { pthread_mutex_unlock(MU as *mut u8); }
    }
}

/// Before a call that may block outside navi code (waiting for the lock, a
/// system call): saves the stack pointer and registers for a collector.
#[cfg(feature = "navic")]
pub fn enter_blocked() {
    if !MULTI { return; }
    let g = current();
    unsafe {
        (*g).sp = crate::rt::stack_pointer() as usize;
        // The caller's frame (this one is gone while the G blocks).
        (*g).fp = *(crate::rt::frame_address() as *const usize);
        crate::rt::spill_registers(&mut (*g).regs as *mut [usize; 10] as *mut usize);
        crate::rt::atomic_store(&mut (*g).sys as *mut usize, SYS_BLOCKED);
    }
}

/// After such a call: waits while a collector that claimed the G runs.
#[cfg(feature = "navic")]
pub fn exit_blocked() {
    if !MULTI { return; }
    let g = current();
    unsafe {
        while !crate::rt::atomic_cas(&mut (*g).sys as *mut usize, SYS_BLOCKED, SYS_RUNNING) { sched_yield(); }
    }
}

// --- Run queues (as Go's GMP) -------------------------------------------------
//
// Each M has a run queue and a runnext slot; a G readied by a G goes to its
// M's runnext (the previous one to the queue's tail). An M looks at its own
// queue, then the global one (Gs that yielded, or readied with no M), then
// steals from other Ms; with nothing, it waits on its own note in the idle
// list. A readied G wakes an idle M unless one is already looking for work.
// The runtime lock is not used on these paths.

#[cfg(feature = "navic")]
static mut GQ_LK: usize = 0;
#[cfg(feature = "navic")]
static mut GQ_HEAD: usize = 0;
#[cfg(feature = "navic")]
static mut GQ_TAIL: usize = 0;
#[cfg(feature = "navic")]
static mut IDLE_LK: usize = 0;
#[cfg(feature = "navic")]
static mut IDLE_MS: usize = 0;
#[cfg(feature = "navic")]
static mut NIDLE: usize = 0;
// Ms looking for work (stealing).
#[cfg(feature = "navic")]
static mut NSPIN: usize = 0;

#[cfg(feature = "navic")]
const AFTER_NONE: usize = 0;
#[cfg(feature = "navic")]
const AFTER_PARK: usize = 1;
#[cfg(feature = "navic")]
const AFTER_YIELD: usize = 2;
#[cfg(feature = "navic")]
const AFTER_EXIT: usize = 3;

#[cfg(feature = "navic")]
fn gq_push(g: *mut G) {
    obj_lock(&mut GQ_LK as *mut usize);
    unsafe {
        (*g).next = 0 as *mut G;
        if GQ_TAIL == 0 { GQ_HEAD = g as usize; } else { (*(GQ_TAIL as *mut G)).next = g; }
    }
    GQ_TAIL = g as usize;
    obj_unlock(&mut GQ_LK as *mut usize);
}

#[cfg(feature = "navic")]
fn gq_pop() -> *mut G {
    if crate::rt::atomic_load(&mut GQ_HEAD as *mut usize) == 0 { return 0 as *mut G; }
    obj_lock(&mut GQ_LK as *mut usize);
    let g = GQ_HEAD as *mut G;
    if g as usize != 0 {
        GQ_HEAD = unsafe { (*g).next } as usize;
        if GQ_HEAD == 0 { GQ_TAIL = 0; }
    }
    obj_unlock(&mut GQ_LK as *mut usize);
    g
}

// m's queue (qlk held).
#[cfg(feature = "navic")]
fn q_push(m: *mut M, g: *mut G) {
    unsafe {
        (*g).next = 0 as *mut G;
        if (*m).qtail == 0 { (*m).qhead = g as usize; } else { (*((*m).qtail as *mut G)).next = g; }
        (*m).qtail = g as usize;
        (*m).qn += 1;
    }
}

#[cfg(feature = "navic")]
fn q_pop(m: *mut M) -> *mut G {
    unsafe {
        let g = (*m).qhead as *mut G;
        if g as usize != 0 {
            (*m).qhead = (*g).next as usize;
            if (*m).qhead == 0 { (*m).qtail = 0; }
            (*m).qn -= 1;
        }
        g
    }
}

#[cfg(feature = "navic")]
fn qlk(m: *mut M) -> *mut usize { unsafe { &mut (*m).qlk as *mut usize } }

// Queues g (runnable now) and wakes an M for it if needed.
#[cfg(feature = "navic")]
fn ready(g: *mut G) {
    unsafe { (*g).status = RUNNABLE; }
    let cur = current();
    let mut mm = 0usize;
    if cur as usize != 0 { mm = unsafe { (*cur).m }; }
    let m = mm as *mut M;
    if m as usize == 0 {
        gq_push(g);
    } else {
        preempt_off();
        obj_lock(qlk(m));
        unsafe {
            let old = (*m).runnext as *mut G;
            (*m).runnext = g as usize;
            if old as usize != 0 { q_push(m, old); }
        }
        obj_unlock(qlk(m));
        preempt_on();
    }
    wakep();
}

// Wakes an idle M (or starts one) unless an M is already looking for work.
#[cfg(feature = "navic")]
fn wakep() {
    if MAX_M <= 1 { return; }
    if crate::rt::atomic_load(&mut NSPIN as *mut usize) != 0 { return; }
    obj_lock(&mut IDLE_LK as *mut usize);
    let m = IDLE_MS as *mut M;
    if m as usize != 0 {
        unsafe {
            IDLE_MS = (*m).idle_next;
            (*m).idle = false;
        }
        NIDLE -= 1;
    }
    obj_unlock(&mut IDLE_LK as *mut usize);
    if m as usize != 0 {
        note_wake(m);
        return;
    }
    if NUM_M < MAX_M {
        lock();
        if NUM_M < MAX_M { start_m(); }
        unlock();
    }
}

#[cfg(feature = "navic")]
fn note_wake(m: *mut M) {
    unsafe {
        pthread_mutex_lock((*m).note_mu as *mut u8);
        (*m).note = 1;
        pthread_cond_signal((*m).note_cv as *mut u8);
        pthread_mutex_unlock((*m).note_mu as *mut u8);
    }
}

#[cfg(feature = "navic")]
fn note_sleep(m: *mut M) {
    unsafe {
        pthread_mutex_lock((*m).note_mu as *mut u8);
        while (*m).note == 0 { pthread_cond_wait((*m).note_cv as *mut u8, (*m).note_mu as *mut u8); }
        (*m).note = 0;
        pthread_mutex_unlock((*m).note_mu as *mut u8);
    }
}

#[cfg(feature = "navic")]
fn new_note(m: *mut M) {
    unsafe {
        (*m).note_mu = calloc(1, 128) as usize;
        (*m).note_cv = calloc(1, 128) as usize;
        pthread_mutex_init((*m).note_mu as *mut u8, 0 as *const u8);
        pthread_cond_init((*m).note_cv as *mut u8, 0 as *const u8);
    }
}

// A runnable G of m's own (runnext first).
#[cfg(feature = "navic")]
fn local_pop(m: *mut M) -> *mut G {
    unsafe { if (*m).runnext == 0 && (*m).qhead == 0 { return 0 as *mut G; } }
    obj_lock(qlk(m));
    let mut g = unsafe { (*m).runnext } as *mut G;
    if g as usize != 0 { unsafe { (*m).runnext = 0; } } else { g = q_pop(m); }
    obj_unlock(qlk(m));
    g
}

// A G taken from another M: the head of its queue, else its runnext.
#[cfg(feature = "navic")]
fn steal(me: *mut M) -> *mut G {
    let mut v = unsafe { (*me).next };
    let mut k = 0;
    while k < NUM_M * 2 {
        if v as usize == 0 { v = MS as *mut M; }
        if v as usize != me as usize {
            let busy = unsafe { (*v).qhead != 0 || (*v).runnext != 0 };
            if busy {
                obj_lock(qlk(v));
                let mut g = q_pop(v);
                if g as usize == 0 {
                    g = unsafe { (*v).runnext } as *mut G;
                    unsafe { (*v).runnext = 0; }
                }
                obj_unlock(qlk(v));
                if g as usize != 0 { return g; }
            }
        }
        v = unsafe { (*v).next };
        k += 1;
    }
    0 as *mut G
}

// Whether any G is runnable (a look without locks).
#[cfg(feature = "navic")]
fn work_exists() -> bool {
    if crate::rt::atomic_load(&mut GQ_HEAD as *mut usize) != 0 { return true; }
    let mut v = MS as *mut M;
    while v as usize != 0 {
        unsafe {
            if crate::rt::atomic_load(&mut (*v).qhead as *mut usize) != 0 { return true; }
            if crate::rt::atomic_load(&mut (*v).runnext as *mut usize) != 0 { return true; }
            v = (*v).next;
        }
    }
    false
}

// Takes m off the idle list; false if a waker took it (it will be woken).
#[cfg(feature = "navic")]
fn unidle(m: *mut M) -> bool {
    obj_lock(&mut IDLE_LK as *mut usize);
    let mut found = false;
    unsafe {
        if (*m).idle {
            let mut prev = 0usize;
            let mut x = IDLE_MS;
            while x != 0 {
                if x == m as usize {
                    if prev == 0 { IDLE_MS = (*m).idle_next; } else { (*(prev as *mut M)).idle_next = (*m).idle_next; }
                    break;
                }
                prev = x;
                x = (*(x as *mut M)).idle_next;
            }
            (*m).idle = false;
            NIDLE -= 1;
            found = true;
        }
    }
    obj_unlock(&mut IDLE_LK as *mut usize);
    found
}

// The next G for m to run (waits for one; not while the world is stopped).
#[cfg(feature = "navic")]
fn find_runnable(m: *mut M) -> *mut G {
    loop {
        while crate::rt::atomic_load(&mut STW as *mut usize) != 0 { unsafe { sched_yield(); } }
        let mut g = local_pop(m);
        if g as usize != 0 { return g; }
        g = gq_pop();
        if g as usize != 0 { return g; }
        crate::rt::atomic_add(&mut NSPIN as *mut usize, 1);
        g = steal(m);
        crate::rt::atomic_add(&mut NSPIN as *mut usize, 18446744073709551615);
        if g as usize != 0 { return g; }
        // Idle: on the list first, then a last look (a G readied meanwhile
        // either finds this M on the list or is seen here).
        obj_lock(&mut IDLE_LK as *mut usize);
        unsafe {
            (*m).idle_next = IDLE_MS;
            (*m).idle = true;
        }
        IDLE_MS = m as usize;
        NIDLE += 1;
        let all = NIDLE == NUM_M;
        obj_unlock(&mut IDLE_LK as *mut usize);
        if work_exists() {
            if !unidle(m) { note_sleep(m); }
            continue;
        }
        if all {
            // No M runs a G that could ready one: every G waits.
            crate::rt::native::fatal("all goroutines are asleep - deadlock!");
        }
        note_sleep(m);
    }
}

// What m's scheduler record does once the G that switched to it stopped.
#[cfg(feature = "navic")]
fn do_after(m: *mut M) {
    unsafe {
        let g = (*m).after_g as *mut G;
        match (*m).after {
            AFTER_PARK => release_locks(g),
            AFTER_YIELD => gq_push(g),
            AFTER_EXIT => {
                lock();
                (*g).next = FREE_GS as *mut G;
                FREE_GS = g as usize;
                unlock();
            }
            _ => {}
        }
        (*m).after = AFTER_NONE;
        (*m).after_g = 0;
    }
}

// The running G stops (its M's scheduler record does what) until it is
// readied and resumed.
#[cfg(feature = "navic")]
fn stop_current(what: usize) {
    let g = current();
    unsafe {
        let m = (*g).m as *mut M;
        (*m).after = what;
        (*m).after_g = g as usize;
        switch(g, (*m).g0);
    }
}

/// Lets other Gs run (the G goes to the global queue, as in Go).
#[cfg(feature = "navic")]
pub fn yield_now() {
    let g = current();
    unsafe { (*g).status = RUNNABLE; }
    stop_current(AFTER_YIELD);
}

#[cfg(feature = "navic")]
fn exit_current() -> ! {
    let g = current();
    // The record and its stack are reused by a later G once this one has
    // switched away for good. Dead Gs stay on the ALL list (so they stay
    // allocated) but their stacks are not scanned.
    unsafe {
        (*g).status = DEAD;
        (*g).entry = || {};
    }
    stop_current(AFTER_EXIT);
    crate::rt::native::fatal("dead goroutine resumed")
}

// A new OS thread with its scheduler record (the runtime lock is held).
#[cfg(feature = "navic")]
fn start_m() {
    if !MULTI {
        // From now on the lock is real: the running G holds it.
        unsafe { pthread_mutex_lock(MU as *mut u8); }
        MULTI = true;
        crate::rt::gc::MULTI = true;
    }
    let m = unsafe { calloc(1, crate::intrinsics::size_of::<M>()) } as *mut M;
    let g0 = unsafe { calloc(1, crate::intrinsics::size_of::<G>()) } as *mut G;
    new_note(m);
    unsafe {
        (*g0).is_g0 = true;
        (*g0).status = RUNNING;
        (*g0).m = m as usize;
        (*m).g0 = g0;
        (*m).next = MS as *mut M;
    }
    MS = m as usize;
    NUM_M += 1;
    let mut tid = 0usize;
    if unsafe { pthread_create(&mut tid as *mut usize, 0 as *const u8, crate::rt::mstart_address(), g0 as usize) } != 0 {
        crate::rt::native::fatal("cannot create an OS thread");
    }
    unsafe { pthread_detach(tid); }
}

/// The first navi code of a new M (its G register is its scheduler record).
#[cfg(feature = "navic")]
pub fn mstart() -> ! { mloop() }

#[cfg(feature = "navic")]
fn lock_held_mloop() { mloop(); }

// The scheduler loop of an M, on its scheduler record: runs runnable Gs
// until each stops, sleeps while there are none.
#[cfg(feature = "navic")]
fn mloop() -> ! {
    let g0 = current();
    let m = unsafe { (*g0).m } as *mut M;
    loop {
        // The G that switched here (M0's main G the first time) stopped.
        do_after(m);
        crate::rt::atomic_store(unsafe { &mut (*m).cur as *mut *mut G as *mut usize }, 0);
        let g = find_runnable(m);
        // Running from now on, then visible to a collector, then a look at
        // whether one stops the world (it sets STW before looking at the
        // Ms): one of the two sees the other.
        unsafe {
            (*g).status = RUNNING;
            (*g).m = m as usize;
        }
        crate::rt::atomic_store(unsafe { &mut (*m).cur as *mut *mut G as *mut usize }, g as usize);
        if crate::rt::atomic_load(&mut STW as *mut usize) != 0 {
            crate::rt::atomic_store(unsafe { &mut (*m).cur as *mut *mut G as *mut usize }, 0);
            unsafe { (*g).status = RUNNABLE; }
            gq_push(g);
            continue;
        }
        switch(g0, g);
    }
}

// An object lock (a word in a channel or thread handle; 0: free). A G
// spinning on one calls a function each time round, a safepoint for a
// collector.
#[cfg(feature = "navic")]
fn obj_lock(lk: *mut usize) {
    while !crate::rt::atomic_cas(lk, 0, 1) { spin_wait(); }
}

#[cfg(feature = "navic")]
fn obj_unlock(lk: *mut usize) { crate::rt::atomic_store(lk, 0); }

#[cfg(feature = "navic")]
fn spin_wait() { unsafe { sched_yield(); } }

/// Keeps the running G from stopping for the collector until preempt_on:
/// a store and the write barrier's marking happen in one step.
#[cfg(feature = "navic")]
pub fn preempt_off() { unsafe { (*current()).nopreempt += 1; } }
#[cfg(feature = "navic")]
pub fn preempt_on() { unsafe { (*current()).nopreempt -= 1; } }

static mut NEXT_TID: u64 = 1;

/// The running G's std::thread::ThreadId.
pub fn current_id() -> u64 {
    let g = current();
    if g as usize == 0 { return 1; } // before the scheduler starts
    unsafe { (*g).tid }
}

/// The atomic word operations of std::sync::atomic.
#[cfg(feature = "navic")]
pub fn word_load(w: *mut usize) -> usize { crate::rt::atomic_load(w) }
#[cfg(feature = "navic")]
pub fn word_store(w: *mut usize, v: usize) { crate::rt::atomic_store(w, v); }
#[cfg(feature = "navic")]
pub fn word_add(w: *mut usize, v: usize) -> usize { crate::rt::atomic_add(w, v) }
#[cfg(feature = "navic")]
pub fn word_cas(w: *mut usize, old: usize, new: usize) -> bool { crate::rt::atomic_cas(w, old, new) }
// One OS thread: plain memory operations.
#[cfg(not(feature = "navic"))]
pub fn word_load(w: *mut usize) -> usize { unsafe { *w } }
#[cfg(not(feature = "navic"))]
pub fn word_store(w: *mut usize, v: usize) { unsafe { *w = v; } }
#[cfg(not(feature = "navic"))]
pub fn word_add(w: *mut usize, v: usize) -> usize {
    let old = unsafe { *w };
    unsafe { *w = old + v; }
    old
}
#[cfg(not(feature = "navic"))]
pub fn word_cas(w: *mut usize, old: usize, new: usize) -> bool {
    if unsafe { *w } != old { return false; }
    unsafe { *w = new; }
    true
}

/// A std::sync::Mutex (as Go's sync.Mutex): its word is 0 (free), 1
/// (held) or 2 (held, Gs may wait); lk guards the wait list q. A locker
/// spins a little, then sleeps on q; an unlock with waiters wakes one.
pub fn mutex_lock(w: *mut usize, lk: *mut usize, q: *mut WaitList) {
    let mut i = 0;
    while i < 30 {
        if word_cas(w, 0, 1) { return; }
        i += 1;
    }
    loop {
        obj_lock(lk);
        // Taken now, or marked contended (so that unlock wakes a waiter).
        loop {
            let v = word_load(w);
            if v == 0 {
                if word_cas(w, 0, 2) {
                    obj_unlock(lk);
                    return;
                }
                continue;
            }
            if v == 2 || word_cas(w, 1, 2) { break; }
        }
        wait(q, lk);
        obj_unlock(lk);
    }
}

pub fn mutex_try_lock(w: *mut usize) -> bool { word_cas(w, 0, 1) }

pub fn mutex_unlock(w: *mut usize, lk: *mut usize, q: *mut WaitList) {
    if word_cas(w, 1, 0) { return; }
    obj_lock(lk);
    word_store(w, 0);
    signal(q);
    obj_unlock(lk);
}

/// Gives the CPU to another thread while spinning.
#[cfg(feature = "navic")]
pub fn cpu_relax() { unsafe { sched_yield(); } }

// Blocks the running G (its wait nodes are enlisted) until woken: it holds
// the n object locks at locks, which its M's scheduler record releases
// after the switch (so a waker cannot see it before it stopped); they are
// held again on return.
#[cfg(feature = "navic")]
fn park_on(locks: *const usize, n: usize) {
    let g = current();
    unsafe {
        (*g).status = WAITING;
        (*g).release = locks as usize;
        (*g).release_n = n;
    }
    stop_current(AFTER_PARK);
    let mut i = 0;
    while i < n {
        obj_lock(unsafe { *((locks as usize + 8 * i) as *const usize) } as *mut usize);
        i += 1;
    }
}

// Releases the object locks a G that just switched away held (park_on).
#[cfg(feature = "navic")]
// The addresses are copied first: once one lock is free the G may be woken,
// run (its stack, which holds the list, changes) and park again.
fn release_locks(g: *mut G) {
    unsafe {
        let n = (*g).release_n;
        let base = (*g).release;
        (*g).release_n = 0;
        let mut few = [0usize; 64];
        let mut many: Vec<usize> = Vec::new();
        let mut i = 0;
        while i < n {
            let a = *((base + 8 * i) as *const usize);
            if n <= 64 { few[i] = a; } else { many.push(a); }
            i += 1;
        }
        i = 0;
        while i < n {
            let a = if n <= 64 { few[i] } else { many[i] };
            obj_unlock(a as *mut usize);
            i += 1;
        }
    }
}


/// The slow path of the stack check: a collector asked this G to stop (it
/// scans the stack while the G waits), or the stack is exhausted: a
/// spawned G's moves to one twice as large (or more). Called with the G's
/// limit cleared; returns how far the stack moved (its stub moves SP and
/// FP as much).
#[cfg(feature = "navic")]
pub fn morestack() -> usize {
    let g = current();
    unsafe {
        if (*g).stack_hi == 0 { return 0; } // a thread's scheduler record: no limit
        let stw = crate::rt::atomic_load(&mut STW as *mut usize) != 0;
        if stw && !(*g).is_g0 && (*g).nopreempt != 0 {
            // Stops at a prologue after preempt_on (the stub zeroed the
            // limit: poisoned again).
            (*g).guard = POISON;
            return 0;
        }
        if stw && !(*g).is_g0 {
            // The registers are saved below (by the stub), above SP.
            (*g).sp = crate::rt::stack_pointer() as usize;
            (*g).fp = crate::rt::frame_address() as usize;
            crate::rt::atomic_store(&mut (*g).sys as *mut usize, SYS_STOPPED);
            while crate::rt::atomic_load(&mut STW as *mut usize) != 0 { sched_yield(); }
            crate::rt::atomic_store(&mut (*g).sys as *mut usize, SYS_RUNNING);
        }
        if (*g).old_size != 0 {
            release_os((*g).old_stack, (*g).old_size);
            (*g).old_size = 0;
        }
        let mut delta = 0usize;
        if (*g).entry_sp < (*g).stack_lo + RED_ZONE + (*g).need {
            if (*g).main || (*g).is_g0 { crate::rt::native::fatal("stack overflow"); }
            delta = grow(g);
        }
        // A collector may have poisoned the limit meanwhile (it sets STW
        // first): the G must still stop at its next prologue.
        crate::rt::atomic_store(&mut (*g).guard as *mut usize, (*g).stack_lo + RED_ZONE);
        if crate::rt::atomic_load(&mut STW as *mut usize) != 0 && !(*g).is_g0 {
            crate::rt::atomic_store(&mut (*g).guard as *mut usize, POISON);
        }
        delta
    }
}

const POISON: usize = 18446744073709551615;

/// Moves the running G's stack (from its stub's SP up) to a new one with
/// room for what the function entering morestack needs; returns how far it
/// moved. Every word of the copy that points into the old stack (saved
/// FPs, addresses of locals, the registers the stub saved) is moved as
/// much, as are the catch_unwind records (on the heap). Nothing else
/// points into a stack: escape analysis keeps such locals on the heap.
#[cfg(feature = "navic")]
fn grow(g: *mut G) -> usize {
    unsafe {
        let lo = (*g).stack_lo;
        let hi = (*g).stack_hi;
        let sp = (*g).entry_sp;
        let used = hi - sp;
        let mut size = hi - lo;
        loop {
            size = size * 2;
            if size > MAX_STACK { crate::rt::native::fatal("stack overflow"); }
            if size >= used + (*g).need + RED_ZONE + 4096 { break; }
        }
        let nlo = reserve(size);
        let nhi = nlo + size;
        let delta = nhi.wrapping_sub(hi);
        let nsp = sp.wrapping_add(delta);
        crate::rt::copy::<u8>(sp as *const u8, nsp as *mut u8, used);
        stack_mode();
        if STACKMAP == 1 {
            move_frames(sp, lo, hi, delta);
            if STACKCHECK { check_moved(nsp, nhi, lo, hi, delta); }
        } else {
            let mut p = nsp;
            while p < nhi {
                let w = *(p as *const usize);
                if w >= lo && w < hi { *(p as *mut usize) = w.wrapping_add(delta); }
                p += 8;
            }
        }
        crate::rt::native::move_catches((*g).catch, lo, hi, delta);
        (*g).old_stack = lo;
        (*g).old_size = hi - lo;
        (*g).stack_lo = nlo;
        (*g).stack_hi = nhi;
        delta
    }
}

// Stacks move by their maps (as Go's adjustframe), not every word that
// looks like an address in the old stack (NAVI_STACKCONS=1 does that).
#[cfg(feature = "navic")]
static mut STACKMAP: usize = 0;
#[cfg(feature = "navic")]
static mut STACKCHECK: bool = false;

#[cfg(feature = "navic")]
fn stack_mode() {
    if STACKMAP == 0 {
        STACKMAP = if crate::rt::native::env_set(b"NAVI_STACKCONS\0") { 2 } else { 1 };
        if crate::rt::native::env_set(b"NAVI_STACKCHECK\0") { STACKCHECK = true; }
    }
}

// The word at old address a, in the copy.
#[cfg(feature = "navic")]
fn mv_rd(a: usize, delta: usize) -> usize { unsafe { *(a.wrapping_add(delta) as *const usize) } }

// Moves the word at old address a (in the copy) if it points into the old stack.
#[cfg(feature = "navic")]
fn mv_adj(a: usize, lo: usize, hi: usize, delta: usize) {
    let p = a.wrapping_add(delta) as *mut usize;
    unsafe {
        let w = *p;
        if w >= lo && w < hi { *p = w.wrapping_add(delta); }
    }
}

// The stack map of the function containing return address pc and the
// function's start (0, 0 for code without one).
#[cfg(feature = "navic")]
fn find_map(pc: usize) -> (usize, usize) {
    let tab = crate::rt::func_table();
    let (n, text, maps) = unsafe { (*(tab as *const usize), *((tab + 8) as *const usize), tab + *((tab + 16) as *const usize)) };
    if pc <= text { return (0, 0); }
    let at = pc - 1 - text;
    let mut lo = 0;
    let mut hi = n;
    while lo < hi {
        let mid = (lo + hi) / 2;
        let start = unsafe { *((tab + 24 + 12 * mid) as *const u32) } as usize;
        if start <= at { lo = mid + 1; } else { hi = mid; }
    }
    if lo == 0 { return (0, 0); }
    let e = tab + 24 + 12 * (lo - 1);
    let (start, size, mo) = unsafe { (*(e as *const u32) as usize, *((e + 4) as *const u32) as usize, *((e + 8) as *const u32) as usize) };
    if at >= start + size { return (0, 0); }
    (maps + mo, text + start)
}

// The saved-register pointer mask of the call returning to offset ret in
// a function's map (all registers if the call is not listed).
#[cfg(feature = "navic")]
fn call_mask(calls: usize, ret: usize) -> usize {
    // Entries of 4 bytes: (return offset / 4) << 9 | mask.
    let n = unsafe { *(calls as *const usize) };
    let want = ret / 4;
    let mut lo = 0;
    let mut hi = n;
    while lo < hi {
        let mid = (lo + hi) / 2;
        let c = unsafe { *((calls + 8 + 4 * mid) as *const u32) } as usize;
        let r = c >> 9;
        if r == want { return c & 0x1ff; }
        if r < want { lo = mid + 1; } else { hi = mid; }
    }
    0x1ff
}

// Moves the pointers into the old stack [lo, hi) of the copy of [sp, hi)
// (delta away), frame by frame from the morestack stub's (sp) outward: the
// words each function's map marks, its saved registers as the caller's
// mask at the call says (the value of x19 + k a frame saved belongs to the
// next frame out that uses the register), the saved frame pointers. Code
// without a map (the runtime's routines): every word of its frame.
#[cfg(feature = "navic")]
fn move_frames(sp: usize, lo: usize, hi: usize, delta: usize) {
    // The stub saved x0-x15 at sp, x19-x28 at sp + 128, x16-x17 at sp + 208;
    // at a function's entry only CTX (x0), RET (x8), LOC (x9) and the
    // saved registers hold values.
    mv_adj(sp, lo, hi, delta);
    mv_adj(sp + 64, lo, hi, delta);
    mv_adj(sp + 72, lo, hi, delta);
    let mut pend = [0usize; 9];
    let mut k = 0;
    while k < 9 {
        pend[k] = sp + 128 + 8 * k;
        k += 1;
    }
    // The stub's frame record, then the one the function entering it
    // pushed: its caller's frame pointer and return address.
    let s = sp + 256;
    mv_adj(s, lo, hi, delta);
    let t = s + 16;
    let mut fp = mv_rd(t, delta);
    let mut pc = mv_rd(t + 8, delta);
    mv_adj(t, lo, hi, delta);
    let mut top = t + 16;
    while fp >= sp && fp < hi {
        let prev = mv_rd(fp, delta);
        let ret = mv_rd(fp + 8, delta);
        let (m, start) = find_map(pc);
        if m == 0 {
            let mut a = top;
            while a < fp {
                mv_adj(a, lo, hi, delta);
                a += 8;
            }
            k = 0;
            while k < 9 {
                if pend[k] != 0 { mv_adj(pend[k], lo, hi, delta); }
                pend[k] = 0;
                k += 1;
            }
        } else {
            let frame = unsafe { *(m as *const usize) };
            let flags = unsafe { *((m + 8) as *const usize) };
            let any = unsafe { *((m + 16) as *const usize) };
            let nb = unsafe { *((m + 24) as *const usize) };
            let fsp = fp - frame;
            let mut w = 0;
            while w < any {
                mv_adj(fsp + 8 * w, lo, hi, delta);
                w += 1;
            }
            while w < frame / 8 {
                let i = w - any;
                let bits = unsafe { *((m + 32 + 8 * (i / 64)) as *const usize) };
                if (bits >> (i % 64) as u32) & 1 != 0 { mv_adj(fsp + 8 * w, lo, hi, delta); }
                w += 1;
            }
            let sv = m + 32 + 8 * nb;
            let ns = unsafe { *(sv as *const usize) };
            let mask = if flags & 1 != 0 { 0x1ff } else { call_mask(sv + 8 + 8 * ns, pc - start) };
            let mut j = 0;
            while j < ns {
                let e = unsafe { *((sv + 8 + 8 * j) as *const usize) };
                let r = e >> 32;
                let off = (e & 0xffffffff) as u32 as i32 as i64 as usize;
                if pend[r] != 0 && (mask >> r as u32) & 1 != 0 { mv_adj(pend[r], lo, hi, delta); }
                pend[r] = fp.wrapping_add(off);
                j += 1;
            }
        }
        mv_adj(fp, lo, hi, delta);
        top = fp + 16;
        fp = prev;
        pc = ret;
    }
    // Registers saved for frames outside the walk.
    k = 0;
    while k < 9 {
        if pend[k] != 0 { mv_adj(pend[k], lo, hi, delta); }
        k += 1;
    }
}

// NAVI_STACKCHECK=1: reports the words of the moved stack still pointing
// into the old one (a pointer a map missed, or an integer that looks like one).
#[cfg(feature = "navic")]
fn check_moved(nsp: usize, nhi: usize, lo: usize, hi: usize, delta: usize) {
    // The frames of the new stack: (frame pointer, return address into the
    // frame's function), from the stub's record out.
    let mut fps = [0usize; 64];
    let mut pcs = [0usize; 64];
    let mut nf = 0;
    let mut r = nsp + 256 + 16;
    let mut fp = unsafe { *(r as *const usize) };
    let mut pc = unsafe { *((r + 8) as *const usize) };
    while fp >= nsp && fp < nhi && nf < 64 {
        fps[nf] = fp;
        pcs[nf] = pc;
        nf += 1;
        pc = unsafe { *((fp + 8) as *const usize) };
        fp = unsafe { *(fp as *const usize) };
    }
    let mut p = nsp;
    while p < nhi {
        let w = unsafe { *(p as *const usize) };
        if w >= lo && w < hi {
            let mut f = 0;
            while f < nf && fps[f] < p { f += 1; }
            crate::rt::native::put(2, "stack map missed: frame ");
            crate::rt::native::put_u64(2, f as u64);
            crate::rt::native::put(2, " pc ");
            crate::rt::native::put_u64(2, if f < nf { pcs[f] } else { 0 } as u64);
            crate::rt::native::put(2, " fp-");
            crate::rt::native::put_u64(2, if f < nf { fps[f] - p } else { 0 } as u64);
            crate::rt::native::put(2, " value at old fp-");
            let wf = if f + 1 < nf { fps[f + 1].wrapping_sub(delta).wrapping_sub(w) } else { 0 };
            crate::rt::native::put_u64(2, wf as u64);
            crate::rt::native::put(2, "\n");
        }
        p += 8;
    }
}

/// Stops every G running on another M (the collector holds the runtime
/// lock): each is asked to stop at its next function prologue (its stack
/// limit is made unreachable) or, if blocked outside navi code, claimed so
/// that it waits before running navi code again.
#[cfg(feature = "navic")]
pub fn stop_the_world() {
    if !MULTI { return; }
    let me = current();
    crate::rt::atomic_store(&mut STW as *mut usize, 1);
    let mut m = MS as *mut M;
    while m as usize != 0 {
        unsafe {
            let g = (*m).cur;
            if g as usize != 0 && g as usize != me as usize && (*g).status == RUNNING {
                (*g).poisoned = true;
                crate::rt::atomic_store(&mut (*g).guard as *mut usize, 18446744073709551615);
            }
            m = (*m).next;
        }
    }
    loop {
        let mut waiting = 0;
        m = MS as *mut M;
        while m as usize != 0 {
            unsafe {
                let g = (*m).cur;
                if g as usize != 0 && g as usize != me as usize && (*g).status == RUNNING {
                    let st = crate::rt::atomic_load(&mut (*g).sys as *mut usize);
                    if st == SYS_RUNNING {
                        waiting += 1;
                    } else if st == SYS_BLOCKED {
                        if !crate::rt::atomic_cas(&mut (*g).sys as *mut usize, SYS_BLOCKED, SYS_CLAIMED) { waiting += 1; }
                    }
                }
                m = (*m).next;
            }
        }
        if waiting == 0 { return; }
        unsafe { sched_yield(); }
    }
}

/// Lets the stopped Gs run again.
#[cfg(feature = "navic")]
pub fn start_the_world() {
    if !MULTI { return; }
    let me = current();
    let mut m = MS as *mut M;
    while m as usize != 0 {
        unsafe {
            let g = (*m).cur;
            if g as usize != 0 && g as usize != me as usize {
                if (*g).poisoned {
                    (*g).poisoned = false;
                    crate::rt::atomic_store(&mut (*g).guard as *mut usize, (*g).stack_lo + RED_ZONE);
                }
                crate::rt::atomic_cas(&mut (*g).sys as *mut usize, SYS_CLAIMED, SYS_BLOCKED);
            }
            m = (*m).next;
        }
    }
    crate::rt::atomic_store(&mut STW as *mut usize, 0);
}
