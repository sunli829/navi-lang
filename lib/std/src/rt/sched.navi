//! Green threads for native programs: goroutine-style Gs. A G runs until it
//! blocks (join, a channel operation, select) or yields; the scheduler then
//! runs another runnable G. Every G has its own stack (reserved address
//! space, committed by the OS on first touch); function prologues check the
//! running G's stack limit.
//!
//! Gs run on up to one OS thread (M) per CPU (M:N; at most NAVI_MAXPROCS).
//! Each M runs its scheduler loop on its own record (g0):
//! a G that blocks switches to its M's g0, which picks the next runnable G
//! from the global run queue, or sleeps until there is one. One runtime
//! lock guards the scheduler, the channels and the heap; it is only taken
//! once a second M exists. The collector stops the world: see
//! stop_the_world.
//!
//! Waiting follows the interpreter's semantics (a condition variable per
//! waitable object): a blocked G registers on the wait lists it cares
//! about and re-checks its condition when woken.

#[cfg(not(target_os = "windows"))]
#[nonblocking]
extern "C" {
    fn mmap(addr: *mut u8, len: usize, prot: i32, flags: i32, fd: i32, off: i64) -> *mut u8;
    fn munmap(addr: *mut u8, len: usize) -> i32;
    fn mprotect(addr: *mut u8, len: usize, prot: i32) -> i32;
}

#[cfg(target_os = "windows")]
#[nonblocking]
extern "C" {
    fn VirtualAlloc(addr: *mut u8, size: usize, kind: u32, protect: u32) -> *mut u8;
    fn VirtualFree(addr: *mut u8, size: usize, kind: u32) -> i32;
}

#[cfg(target_os = "macos")]
const MAP_FLAGS: i32 = 0x1002;
#[cfg(target_os = "linux")]
const MAP_FLAGS: i32 = 0x4022;
#[cfg(target_os = "windows")]
const MAP_FLAGS: i32 = 0;

const MAIN_STACK: usize = 67108864; // 64 MiB
// The first stack of a spawned G (grown by copying, up to MAX_STACK).
const STACK: usize = 65536;
const MAX_STACK: usize = 1073741824; // 1 GiB
// The bottom of every stack is left for C calls made near the limit.
const RED_ZONE: usize = 32768;

const RUNNING: u8 = 0;
const RUNNABLE: u8 = 1;
const WAITING: u8 = 2;
const DEAD: u8 = 3;

/// A green thread.
pub struct G {
    // First: the stack limit function prologues check (navi; see
    // backend::lower). The collector sets it to the maximum to stop the G.
    guard: usize,
    // Second (navi): while non-zero the G does not stop for the collector
    // at a prologue (a write barrier runs; generated code increments it).
    nopreempt: usize,
    // Third and fourth (navi; see backend::lower): the bytes the function
    // entering morestack needs below its SP, and the SP of morestack's stub
    // (below it, the registers it saved).
    need: usize,
    entry_sp: usize,
    // Fifth (navi): how many morestacks the G is in (the stub counts):
    // more than one only if the collector poisoned the limit while one
    // ran; the inner ones do nothing.
    ms_depth: usize,
    // Sixth and seventh (navi; see backend call_c): the top of the stack
    // its C calls that may block run on (its M's scheduler stack, below
    // where that switched to it; 0: its own stack), and its stack pointer
    // during such a call (0 outside one; a callback from C continues
    // below it).
    c_stack: usize,
    c_sp: usize,
    // Eighth (navi; see backend c_callback): for a callback G, the top of
    // its stack, where a callback from C starts.
    cb_stack: usize,
    // A callback G (running a navi function C called): the G whose C call
    // it serves (0: not one), and the spare callback G for a C call it
    // makes in turn.
    cb_prev: *mut G,
    cb_next: *mut G,
    // Counts its blocking calls (sysmon sees one that lasts).
    blk_seq: usize,
    // A stack left by growing (freed by the next morestack, which runs on
    // the new one).
    old_stack: usize,
    old_size: usize,
    // std::thread::ThreadId.
    tid: u64,
    // Saved context (sp, fp, pc) while not running.
    sp: usize,
    fp: usize,
    pc: usize,
    stack_lo: usize,
    stack_hi: usize,
    status: u8,
    main: bool,
    entry: fn(),
    next: *mut G, // run queue
    all_next: *mut G,
    wait_gen: usize,
    // The innermost catch_unwind record (see native::try_call), or 0.
    catch: usize,
    // M:N (navi): the M running it, how many times it holds the runtime
    // lock, its state for the collector (SYS_*), whether the collector
    // poisoned its stack limit, whether it is an M's scheduler record, and
    // its callee-saved registers while blocked outside navi code.
    m: usize,
    lock_depth: usize,
    sys: usize,
    poisoned: bool,
    is_g0: bool,
    regs: [usize; 10],
    // The object locks (addresses of lock words) its M's scheduler record
    // releases once the G has switched away (see park_on).
    release: usize,
    release_n: usize,
    // The M running it (0: none), taken atomically before an M switches
    // to it (debugging double scheduling).
    running_on: usize,
    // Set by sysmon when the G has run for a time slice: it yields at its
    // next check (a prologue's or a loop's; see morestack).
    preempt: usize,
    // While it yields inside morestack: the frame record above morestack's
    // stub, where a collector's scan turns precise (as for a G stopped
    // there; 0: not yielding there).
    ms_fp: usize,
    // Windows' main G: where its stack's reservation starts (stack_lo is
    // where the committed part does; see commit_more). 0 otherwise.
    reserve_lo: usize,
    // How many object locks it holds (as Go's m.locks): it does not yield
    // for a time slice while it holds one.
    locks: usize,
    // Set by a collection that found it using under a quarter of its
    // stack: its next prologue's check moves it to one half as large (as
    // Go's shrinkstack; see morestack).
    shrink: usize,
    // The cycle (gc's CYCLE_NO) whose mark has scanned its stack, and one
    // whose marker asked it to scan its stack itself at its next check
    // (it was running; see morestack).
    scan_cyc: usize,
    scan_req: usize,
    // Where its print output and panic messages go: a test's captured
    // output (see native::capture_new; 0: the standard streams). A G it
    // starts inherits it.
    capture: usize,
    // Set while it scans its own stack (an assist): the scan holds
    // addresses in it as integers, which a move would leave in the old one.
    nomove: usize,
}

// G.sys: running navi code; blocked in C (a system call or waiting for the
// runtime lock), with its stack pointer and registers saved; the same,
// claimed by a collector (it waits before running navi code again);
// stopped at a safepoint for a collector.
const SYS_RUNNING: usize = 0;
const SYS_BLOCKED: usize = 1;
const SYS_CLAIMED: usize = 2;
const SYS_STOPPED: usize = 3;
// Blocked, its stack being scanned by a marker (it waits as when claimed).
const SYS_SCANNING: usize = 4;
// G.running_on while a marker scans a G no M runs (an M waits to run it).
const SCANNING: usize = 1;

struct WaitNode {
    g: *mut G,
    gen: usize,
    key: usize,
    next: *mut WaitNode,
}

/// A list of Gs waiting for a change of some object, in arrival order.
pub struct WaitList {
    head: *mut WaitNode,
    tail: *mut WaitNode,
}

static mut ALL: usize = 0;
static mut FREE_GS: usize = 0; // dead Gs whose records and stacks are reused (linked by next)

// Stacks no G uses any more, kept for reuse (as Go's stack pool): a list
// per size (STACK << k), linked through each stack's lowest word, under
// SPOOL_LK; they go back to the system after each collection (free_stacks).
// With NAVI_DEBUG=stackmove a stack is freed at nearly every call: an munmap
// each, which a virtual machine makes slow (CI's macOS ones ran the mode
// 50 times slower), since it must stop every CPU running the process.
const SPOOL_CLASSES: usize = 12;
static mut SPOOL: [usize; 12] = [0; 12];
static mut SPOOL_LK: usize = 0;

// Takes SPOOL_LK. Held, a G makes no call until it lets go with an inline
// store: a call's prologue could stop it for a collector, which may need a
// stack itself (stack_headroom).
fn spool_lock() {
    while !crate::rt::atomic_cas(&mut SPOOL_LK as *mut usize, 0, 1) {
        unsafe {
            os_yield();
        }
    }
}

// The pool's list for stacks of size bytes (SPOOL_CLASSES: none).
fn spool_class(size: usize) -> usize {
    let mut k = 0;
    let mut s = STACK;
    while k < SPOOL_CLASSES {
        if s == size {
            return k;
        }
        s = s * 2;
        k += 1;
    }
    SPOOL_CLASSES
}

// A stack of size bytes: one from the pool, else from the system.
fn reserve(size: usize) -> usize {
    let k = spool_class(size);
    if k < SPOOL_CLASSES {
        spool_lock();
        let p = SPOOL[k];
        if p != 0 {
            SPOOL[k] = unsafe { *(p as *const usize) };
        }
        crate::rt::atomic_store(&mut SPOOL_LK as *mut usize, 0);
        if p != 0 {
            return p;
        }
    }
    reserve_os(size)
}

// A stack no G uses any more: into the pool (unless NAVI_DEBUG=stackprot keeps
// it to fault on).
fn release(p: usize, size: usize) {
    if size == 0 {
        return;
    }
    let k = spool_class(size);
    if k >= SPOOL_CLASSES || stack_prot() {
        release_os(p, size);
        return;
    }
    spool_lock();
    unsafe {
        *(p as *mut usize) = SPOOL[k];
    }
    SPOOL[k] = p;
    crate::rt::atomic_store(&mut SPOOL_LK as *mut usize, 0);
}

// The pool's stacks back to the system.
fn drain_spool() {
    let mut k = 0;
    while k < SPOOL_CLASSES {
        spool_lock();
        let mut p = SPOOL[k];
        SPOOL[k] = 0;
        crate::rt::atomic_store(&mut SPOOL_LK as *mut usize, 0);
        while p != 0 {
            let next = unsafe { *(p as *const usize) };
            release_os(p, STACK << k as u32);
            p = next;
        }
        k += 1;
    }
}

#[cfg(not(target_os = "windows"))]
fn reserve_os(size: usize) -> usize {
    let p = unsafe { mmap(0 as *mut u8, size, 3, MAP_FLAGS, -1, 0) } as usize;
    if p == 0 || p == 18446744073709551615 {
        crate::rt::native::fatal("cannot allocate a stack");
    }
    p
}

#[cfg(not(target_os = "windows"))]
fn release_os(p: usize, size: usize) {
    // NAVI_DEBUG=stackprot (debugging): the stack stays mapped, inaccessible,
    // so that a pointer left into it faults where it is used.
    if stack_prot() {
        unsafe {
            mprotect(p as *mut u8, size, 0);
        }
        return;
    }
    unsafe {
        munmap(p as *mut u8, size);
    }
}

#[cfg(not(target_os = "windows"))]
static mut STACKPROT: usize = 0;
#[cfg(not(target_os = "windows"))]
fn stack_prot() -> bool {
    if STACKPROT == 0 {
        STACKPROT = if crate::rt::native::debug_on("stackprot") {
            1
        } else {
            2
        };
    }
    STACKPROT == 1
}

#[cfg(target_os = "windows")]
fn stack_prot() -> bool {
    false
}

#[cfg(target_os = "windows")]
fn release_os(p: usize, size: usize) {
    unsafe {
        VirtualFree(p as *mut u8, 0, 0x8000);
    }
}

// The main G's stack. Unix commits pages as they are first touched; on
// Windows everything VirtualAlloc commits counts against the system's
// commit limit, so the main stack is only reserved, its top committed,
// and committed further as it grows (commit_more).
#[cfg(not(target_os = "windows"))]
fn reserve_main() -> usize {
    reserve(MAIN_STACK)
}

#[cfg(not(target_os = "windows"))]
fn main_lo(base: usize) -> usize {
    base
}

#[cfg(target_os = "windows")]
const MAIN_COMMIT: usize = 1048576;

#[cfg(target_os = "windows")]
fn reserve_main() -> usize {
    // MEM_RESERVE, then MEM_COMMIT of the top.
    let p = unsafe { VirtualAlloc(0 as *mut u8, MAIN_STACK, 0x2000, 4) } as usize;
    if p == 0 {
        crate::rt::native::fatal("cannot allocate a stack");
    }
    if unsafe {
        VirtualAlloc(
            (p + MAIN_STACK - MAIN_COMMIT) as *mut u8,
            MAIN_COMMIT,
            0x1000,
            4,
        )
    } as usize
        == 0
    {
        crate::rt::native::fatal("cannot allocate a stack");
    }
    p
}

#[cfg(target_os = "windows")]
fn main_lo(base: usize) -> usize {
    base + MAIN_STACK - MAIN_COMMIT
}

// Commits more of Windows' main stack below what is committed (twice as
// much, and enough for what the entering function needs): whether the
// reservation had room. The stack does not move.
#[cfg(target_os = "windows")]
fn commit_more(g: *mut G) -> bool {
    unsafe {
        let lo = (*g).stack_lo;
        let rlo = (*g).reserve_lo;
        if rlo == 0 || rlo >= lo {
            return false;
        }
        let mut nlo = lo - ((*g).stack_hi - lo);
        let want = (*g).entry_sp - (*g).need - RED_ZONE - 65536;
        if want < nlo {
            nlo = want & !65535;
        }
        if nlo < rlo {
            nlo = rlo;
        }
        if VirtualAlloc(nlo as *mut u8, lo - nlo, 0x1000, 4) as usize == 0 {
            crate::rt::native::fatal("cannot commit the main stack");
        }
        (*g).stack_lo = nlo;
        true
    }
}

#[cfg(not(target_os = "windows"))]
fn commit_more(g: *mut G) -> bool {
    false
}

#[cfg(target_os = "windows")]
fn reserve_os(size: usize) -> usize {
    let p = unsafe { VirtualAlloc(0 as *mut u8, size, 0x3000, 4) } as usize;
    if p == 0 {
        crate::rt::native::fatal("cannot allocate a stack");
    }
    p
}

fn new_g() -> *mut G {
    // G records are GC objects kept alive by the ALL list (a static), so
    // their entry closures are traced.
    let g = crate::rt::gc::alloc(crate::intrinsics::size_of::<G>(), false) as *mut G;
    unsafe {
        (*g).all_next = ALL as *mut G;
    }
    ALL = g as usize;
    g
}

/// Called by the entry point before anything else: creates the main G
/// and returns the top of its stack (the entry point switches to it).
pub fn init() -> usize {
    let g = new_g();
    let base = reserve_main();
    unsafe {
        (*g).stack_lo = main_lo(base);
        (*g).reserve_lo = if (*g).stack_lo != base { base } else { 0 };
        (*g).stack_hi = base + MAIN_STACK;
        (*g).status = RUNNING;
        (*g).main = true;
        (*g).tid = 1;
        (*g).entry = || {};
        (*g).guard = (*g).stack_lo + RED_ZONE;
    }
    init_ms(g);
    set_current(g);
    base + MAIN_STACK
}

// The running G, kept in a register (each OS thread has its own).
pub fn current() -> *mut G {
    crate::rt::current_g() as *mut G
}

fn set_current(g: *mut G) {
    crate::rt::set_current_g(g as usize);
}

// Switches from prev to next (the context switch also switches the G
// register).
fn switch(prev: *mut G, next: *mut G) {
    // From an M's scheduler record: next's C calls run below this frame
    // (swap_context's save area included).
    unsafe {
        if (*prev).is_g0 && !(*next).is_g0 {
            (*next).c_stack = (crate::rt::stack_pointer() as usize - 256) & !15;
        }
    }
    unsafe {
        crate::rt::swap_context(
            &mut (*prev).sp as *mut usize as *mut u8,
            &mut (*next).sp as *mut usize as *mut u8,
        );
    }
}

// Whether the scheduler has not started (the running G is a blank record).
fn booting() -> bool {
    let g = current();
    g as usize == 0 || unsafe { (*g).stack_hi } == 0
}

/// The current G's innermost catch_unwind record (0: none).
pub fn catch_top() -> usize {
    unsafe { (*current()).catch }
}

pub fn set_catch_top(r: usize) {
    unsafe {
        (*current()).catch = r;
    }
}

/// Whether the running G is the main thread (for panic messages).
pub fn is_main() -> bool {
    if booting() {
        return true;
    }
    unsafe { (*current()).main }
}

/// The stack range of the running G that the collector must scan, and
/// calls f for the saved stack of every other live G.
pub fn current_stack_hi() -> usize {
    if booting() {
        return crate::rt::stack_top() as usize + 16;
    }
    unsafe { (*current()).stack_hi }
}

/// How many bytes the running G's stack has (0 while booting: the stack
/// the system gave, which does not move).
pub fn current_stack_size() -> usize {
    if booting() {
        return 0;
    }
    unsafe { (*current()).stack_hi - (*current()).stack_lo }
}

/// Scans a stack [sp, hi) for the collector, its innermost frame at fp:
/// the frames of user code by their stack maps (as Go's scanframe), the
/// rest (the runtime, std, code without maps) conservatively, as are the
/// registers the G saved when it stopped (below fp).
pub fn scan_stack(sp: usize, fp0: usize, hi: usize) {
    scan_stack_into(sp, fp0, hi, crate::rt::gc::main_dst());
}

// scan_stack, the objects found queued on mark stack dst (0: the M's
// write barrier buffer).
fn scan_stack_into(sp: usize, fp0: usize, hi: usize, dst: usize) {
    stack_mode();
    if STACKMAP != 1 || fp0 < sp || fp0 >= hi {
        crate::rt::gc::scan_into(sp, hi, dst);
        return;
    }
    let mut pend = [0usize; 9];
    let mut top = sp;
    let mut fp = fp0;
    let mut pc = 0usize;
    while fp >= top && fp < hi {
        let prev = unsafe { *(fp as *const usize) };
        let ret = unsafe { *((fp + 8) as *const usize) };
        let (m, start) = if pc == 0 { (0, 0) } else { find_map(pc) };
        let flags = if m == 0 {
            3
        } else {
            unsafe { *((m + 8) as *const usize) }
        };
        if flags & 3 != 0 {
            crate::rt::gc::scan_into(top, fp, dst);
            let mut k = 0;
            while k < 9 {
                if pend[k] != 0 {
                    crate::rt::gc::scan_into(pend[k], pend[k] + 8, dst);
                }
                pend[k] = 0;
                k += 1;
            }
        } else {
            let frame = unsafe { *(m as *const usize) };
            let any = unsafe { *((m + 16) as *const usize) };
            let nb = unsafe { *((m + 24) as *const usize) };
            let fsp = fp - frame;
            if top < fsp {
                crate::rt::gc::scan_into(top, fsp, dst);
            }
            crate::rt::gc::scan_into(fsp, fsp + 8 * any, dst);
            let mut w = any;
            while w < frame / 8 {
                let i = w - any;
                let bits = unsafe { *((m + 32 + 8 * (i / 64)) as *const usize) };
                if (bits >> (i % 64) as u32) & 1 != 0 {
                    crate::rt::gc::scan_into(fsp + 8 * w, fsp + 8 * w + 8, dst);
                }
                w += 1;
            }
            let sv = m + 32 + 8 * nb;
            let ns = unsafe { *(sv as *const usize) };
            let mask = call_mask(sv + 8 + 8 * ns, pc - start);
            let mut j = 0;
            while j < ns {
                let e = unsafe { *((sv + 8 + 8 * j) as *const usize) };
                let r = e >> 32;
                let off = (e & 0xffffffff) as u32 as i32 as i64 as usize;
                if pend[r] != 0 && (mask >> r as u32) & 1 != 0 {
                    crate::rt::gc::scan_into(pend[r], pend[r] + 8, dst);
                }
                pend[r] = fp.wrapping_add(off);
                j += 1;
            }
        }
        top = fp + 16;
        fp = prev;
        pc = ret;
    }
    crate::rt::gc::scan_into(top, hi, dst);
    let mut k = 0;
    while k < 9 {
        if pend[k] != 0 {
            crate::rt::gc::scan_into(pend[k], pend[k] + 8, dst);
        }
        k += 1;
    }
}

// The stack and saved registers of g, not running (as the collector scans
// one stopped).
fn scan_saved(g: *mut G, dst: usize) {
    unsafe {
        scan_stack_into(
            (*g).sp,
            if (*g).ms_fp != 0 { (*g).ms_fp } else { (*g).fp },
            (*g).stack_hi,
            dst,
        );
        let r = &(*g).regs as *const [usize; 10] as usize;
        crate::rt::gc::scan_into(r, r + 80, dst);
    }
}

/// The first G of the ALL list (the stacks a mark scans: Gs made after
/// start scanned), and the next.
pub fn all_head() -> usize {
    ALL
}

pub fn all_next(g: usize) -> usize {
    unsafe { (*(g as *mut G)).all_next as usize }
}

/// A marker's scan of g's stack for cycle cyc while the program runs (as
/// Go's scanstack with suspendG): a G no M runs is held (an M waits to run
/// it), one blocked outside navi code too (it waits to go on); a running
/// one is asked to scan its own at its next check (its limit poisoned).
/// Whether it is scanned (or needs none).
pub fn scan_g(gp: usize, cyc: usize, dst: usize) -> bool {
    let g = gp as *mut G;
    unsafe {
        if (*g).status == DEAD || (*g).is_g0 || (*g).scan_cyc == cyc {
            return true;
        }
        if g as usize == current() as usize {
            // Its own (an assist): now, from here up, its registers too. The
            // stack must not move meanwhile (Go scans on the system stack):
            // it grows first if the scan could need it to.
            scan_room();
            (*g).nomove = 1;
            let r = calloc(10, 8) as usize;
            crate::rt::spill_registers(r as *mut usize);
            scan_stack_into(
                crate::rt::stack_pointer() as usize,
                crate::rt::frame_address() as usize,
                (*g).stack_hi,
                dst,
            );
            crate::rt::gc::scan_into(r, r + 80, dst);
            free(r as *mut u8);
            if dst == 0 {
                crate::rt::gc::flush_wbuf();
            }
            (*g).nomove = 0;
            (*g).scan_cyc = cyc;
            return true;
        }
        if crate::rt::atomic_cas(&mut (*g).running_on as *mut usize, 0, SCANNING) {
            if (*g).status != DEAD && (*g).scan_cyc != cyc {
                scan_saved(g, dst);
                (*g).scan_cyc = cyc;
            }
            crate::rt::atomic_store(&mut (*g).running_on as *mut usize, 0);
            return true;
        }
        if g as usize != current() as usize
            && crate::rt::atomic_cas(&mut (*g).sys as *mut usize, SYS_BLOCKED, SYS_SCANNING)
        {
            if (*g).scan_cyc != cyc {
                scan_saved(g, dst);
                (*g).scan_cyc = cyc;
            }
            if !crate::rt::atomic_cas(&mut (*g).sys as *mut usize, SYS_SCANNING, SYS_BLOCKED) {
                crate::rt::native::fatal("scan_g: a scanned G's state changed");
            }
            return true;
        }
        (*g).scan_req = cyc;
        crate::rt::atomic_store(&mut (*g).guard as *mut usize, POISON);
        false
    }
}

/// With the world stopped at the end of a mark: scans the stacks no
/// marker did (the collector's own too), and drops the requests.
pub fn scan_unscanned(cyc: usize) {
    let me = current();
    let mut g = ALL as *mut G;
    while g as usize != 0 {
        unsafe {
            if (*g).status != DEAD && !(*g).is_g0 && (*g).scan_cyc != cyc {
                if g as usize == me as usize {
                    crate::rt::gc::scan_own_stack();
                } else {
                    scan_saved(g, crate::rt::gc::main_dst());
                }
                (*g).scan_cyc = cyc;
            }
            (*g).scan_req = 0;
            g = (*g).all_next;
        }
    }
}

/// Scans the saved stack of every other live G.
pub fn scan_other_stacks() {
    let mut g = ALL as *mut G;
    while g as usize != 0 {
        unsafe {
            if (*g).status != DEAD && !(*g).is_g0 && g as usize != current() as usize {
                scan_stack(
                    (*g).sp,
                    if (*g).ms_fp != 0 { (*g).ms_fp } else { (*g).fp },
                    (*g).stack_hi,
                );
                let r = &(*g).regs as *const [usize; 10] as usize;
                crate::rt::gc::scan_range(r, r + 80);
            }
            g = (*g).all_next;
        }
    }
}

/// Starts a new G running f.
pub fn go(f: fn()) {
    go_on(f, false);
}

/// Starts a mark worker G running f: Ms run it before any other G at their
/// next scheduling point (as Go's dedicated mark workers; see
/// find_runnable).
pub fn go_marker(f: fn()) {
    go_on(f, true);
}

fn go_on(f: fn(), marker: bool) {
    let capture = if marker { 0 } else { output_capture() };
    lock();
    let mut g = FREE_GS as *mut G;
    if g as usize != 0 {
        FREE_GS = unsafe { (*g).next } as usize;
        NFREE_GS -= 1;
        unsafe {
            if (*g).stack_hi == 0 {
                // (Its stack was returned: see exit_g and free_stacks.)
                let stack = reserve(STACK);
                (*g).stack_lo = stack;
                (*g).stack_hi = stack + STACK;
            }
        }
    } else {
        g = new_g();
        let stack = reserve(STACK);
        unsafe {
            (*g).stack_lo = stack;
            (*g).stack_hi = stack + STACK;
        }
    }
    unsafe {
        // 80 bytes below the top hold the callee-saved registers the context
        // switch restores.
        (*g).sp = (*g).stack_hi - 80;
        (*g).fp = 0;
        (*g).pc = crate::rt::gstart_address() as usize;
        (*g).entry = f;
        (*g).catch = 0;
        (*g).guard = (*g).stack_lo + RED_ZONE;
        // The G register (x28, the last of the saved registers) of the
        // first context.
        *(((*g).stack_hi - 8) as *mut usize) = g as usize;
        (*g).lock_depth = 0;
        (*g).sys = SYS_RUNNING;
        (*g).poisoned = false;
        (*g).release_n = 0;
        (*g).shrink = 0;
        // (Its stack is empty: scanned for a mark that runs.)
        (*g).scan_cyc = crate::rt::gc::cycle_no();
        (*g).scan_req = 0;
        (*g).capture = capture;
        NEXT_TID += 1;
        (*g).tid = NEXT_TID;
    }
    start_sysmon();
    if marker {
        unsafe {
            (*g).status = RUNNABLE;
        }
        obj_lock(&mut MQ_LK as *mut usize);
        unsafe {
            (*g).next = MQ as *mut G;
        }
        MQ = g as usize;
        obj_unlock(&mut MQ_LK as *mut usize);
        wakep();
    } else {
        ready(g);
    }
    unlock();
    if !FGC_ON {
        FGC_ON = true;
        go(|| {
            forcegc_loop();
        });
    }
}

// --- Forced collections (as Go's forcegc) ------------------------------------
//
// A G that waits until sysmon sees no collection for FORCE_GC (a program
// that stopped allocating), then collects: what died is freed and its
// memory returned to the system.
const FORCE_GC: u64 = 120000000000;
static mut FGC_ON: bool = false;
static mut FGC_G: usize = 0;
static mut FGC_LK: usize = 0;
// Set (under FGC_LK) while it waits.
static mut FGC_PARKED: bool = false;

// The G that runs the cleanups (std::gc::add_cleanup), one after
// another (as Go's cleanup goroutine), started with the first.
static mut CL_ON: bool = false;
static mut CL_G: usize = 0;
static mut CL_LK: usize = 0;
static mut CL_PARKED: bool = false;
static mut CL_WAKE: bool = false;

/// Starts the cleanup G (once).
pub fn start_helpers() {
    if CL_ON {
        return;
    }
    lock();
    if !CL_ON {
        CL_ON = true;
        go(|| {
            cleanup_loop();
        });
    }
    unlock();
}

fn cleanup_loop() {
    loop {
        while let Some(f) = crate::rt::gc::next_cleanup() {
            f();
        }
        loop {
            let c = crate::rt::gc::next_chan_close();
            if c == 0 {
                break;
            }
            close_recv(c as *mut Chan);
        }
        obj_lock(&mut CL_LK as *mut usize);
        CL_G = current() as usize;
        if !CL_WAKE {
            CL_PARKED = true;
            park_until(&mut CL_LK as *mut usize, 0);
        }
        CL_WAKE = false;
        obj_unlock(&mut CL_LK as *mut usize);
    }
}

/// After a mark queued cleanups (on a G): readies the cleanup G.
pub fn wake_cleanups() {
    obj_lock(&mut CL_LK as *mut usize);
    CL_WAKE = true;
    if CL_PARKED {
        CL_PARKED = false;
        ready(CL_G as *mut G);
    }
    obj_unlock(&mut CL_LK as *mut usize);
}

fn forcegc_loop() {
    loop {
        obj_lock(&mut FGC_LK as *mut usize);
        FGC_G = current() as usize;
        FGC_PARKED = true;
        park_until(&mut FGC_LK as *mut usize, 0);
        obj_unlock(&mut FGC_LK as *mut usize);
        crate::rt::gc::collect();
    }
}

// sysmon: readies the forced collection's G if no collection ran for
// FORCE_GC (it runs no Gs itself: the global queue).
fn force_gc(now: u64) {
    let last = crate::rt::gc::LAST_GC;
    if last == 0 || now < last + FORCE_GC || !FGC_PARKED {
        return;
    }
    obj_lock(&mut FGC_LK as *mut usize);
    if FGC_PARKED {
        FGC_PARKED = false;
        // Not again before it ran.
        crate::rt::gc::LAST_GC = now;
        let g = FGC_G as *mut G;
        unsafe {
            (*g).status = RUNNABLE;
        }
        gq_push(g);
        wake_idle();
    }
    obj_unlock(&mut FGC_LK as *mut usize);
}

/// The first function of every spawned G (called by the start routine).
pub fn gmain() -> ! {
    let g = current();
    let f = unsafe { (*g).entry };
    f();
    exit_current()
}

// --- Waiting -----------------------------------------------------------------

pub fn new_wait_list() -> WaitList {
    WaitList {
        head: 0 as *mut WaitNode,
        tail: 0 as *mut WaitNode,
    }
}

/// Registers the running G at the end of w (it may register on several
/// lists; once woken from one, its nodes on the others are stale).
pub fn enlist(w: *mut WaitList) {
    enlist_key(w, 0);
}

fn enlist_key(w: *mut WaitList, key: usize) {
    let g = current();
    let n = crate::rt::gc::alloc(crate::intrinsics::size_of::<WaitNode>(), false) as *mut WaitNode;
    unsafe {
        (*n).g = g;
        (*n).gen = (*g).wait_gen;
        (*n).key = key;
        (*n).next = 0 as *mut WaitNode;
        if (*w).head as usize == 0 {
            (*w).head = n;
        } else {
            (*(*w).tail).next = n;
        }
        (*w).tail = n;
    }
}

/// Waits on w, whose object lock lk is held (and held again on return).
pub fn wait(w: *mut WaitList, lk: *mut usize) {
    wait_key(w, lk, 0);
}

fn wait_key(w: *mut WaitList, lk: *mut usize, key: usize) {
    enlist_key(w, key);
    let one = [lk as usize];
    park_on(&one as *const [usize; 1] as *const usize, 1);
}

// Whether n's G still waits for it (not woken through another list).
fn live(n: *mut WaitNode) -> bool {
    unsafe { (*n).gen == (*(*n).g).wait_gen && (*(*n).g).status == WAITING }
}

fn unlink_head(w: *mut WaitList) -> *mut WaitNode {
    unsafe {
        let n = (*w).head;
        (*w).head = (*n).next;
        if (*w).head as usize == 0 {
            (*w).tail = 0 as *mut WaitNode;
        }
        n
    }
}

// Wakes the G of n (the runtime lock is held).
// (Several threads may wake a G waiting on several lists at once: the one
// that moves its wait_gen on readies it.)
fn wake(n: *mut WaitNode) {
    unsafe {
        let g = (*n).g;
        if word_cas(&mut (*g).wait_gen as *mut usize, (*n).gen, (*n).gen + 1) {
            ready(g);
        }
    }
}

/// Wakes the first G still waiting on w, if any (its object lock is held).
pub fn signal(w: *mut WaitList) {
    while unsafe { (*w).head } as usize != 0 {
        let n = unlink_head(w);
        if live(n) {
            wake(n);
            break;
        }
    }
}

// Wakes the Gs at the front of w whose key is at most k (w is in key
// order).
fn signal_upto(w: *mut WaitList, k: usize) {
    while unsafe { (*w).head } as usize != 0 {
        let h = unsafe { (*w).head };
        if live(h) && unsafe { (*h).key } > k {
            break;
        }
        let n = unlink_head(w);
        if live(n) {
            wake(n);
        }
    }
}

/// Wakes every G waiting on w (its object lock is held).
pub fn broadcast(w: *mut WaitList) {
    let mut n = unsafe { (*w).head };
    if n as usize == 0 {
        return;
    }
    unsafe {
        (*w).head = 0 as *mut WaitNode;
        (*w).tail = 0 as *mut WaitNode;
    }
    while n as usize != 0 {
        unsafe {
            if live(n) {
                wake(n);
            }
            n = (*n).next;
        }
    }
}

// --- Threads -----------------------------------------------------------------

/// A spawned thread: its result cell and the Gs joining it.
pub struct Handle {
    lk: usize,
    done: bool,
    result: *mut u8,
    waiters: WaitList,
}

pub fn new_handle(result: *mut u8) -> *mut Handle {
    &mut Handle {
        lk: 0,
        done: false,
        result,
        waiters: new_wait_list(),
    } as *mut Handle
}

pub fn finish(h: *mut Handle) {
    unsafe {
        let lk = &mut (*h).lk as *mut usize;
        obj_lock(lk);
        (*h).done = true;
        broadcast(&mut (*h).waiters as *mut WaitList);
        obj_unlock(lk);
    }
}

pub fn join(h: *mut Handle) -> *mut u8 {
    unsafe {
        let lk = &mut (*h).lk as *mut usize;
        obj_lock(lk);
        while !(*h).done {
            wait(&mut (*h).waiters as *mut WaitList, lk);
        }
        obj_unlock(lk);
        (*h).result
    }
}

// --- Channels ----------------------------------------------------------------

const UNBOUNDED: usize = 18446744073709551615;

/// A channel of elements of elem bytes, stored in a ring buffer.
pub struct Chan {
    // The channel's lock (see obj_lock).
    lk: usize,
    elem: usize,
    cap: usize,
    buf: *mut u8,
    head: usize,
    len: usize,
    slots: usize,
    closed: bool,
    send_seq: usize,
    recv_seq: usize,
    recv_waiter: usize,
    // Receivers waiting for an element; senders waiting for room (and, on
    // an unbuffered channel, selects waiting for a receiver); unbuffered
    // senders waiting for their element to be taken (keyed by its send_seq).
    // Each element wakes one receiver, each taken element one sender.
    recvq: WaitList,
    sendq: WaitList,
    ackq: WaitList,
    // Writes Result<T, RecvError> for select: (slot, value or null).
    write_result: fn(*mut u8, *const u8),
    // A timer channel (std::time::after, tick, Ticker; as Go 1.23's): the
    // monotonic time of its next value (0: none) and the period between
    // values (0: one). The value is put in when a receiver looks after
    // that time (timer_fill); a receiver waiting for it waits on the timer
    // heap too. Nothing else holds the channel: one nobody refers to is
    // collected, stopped or not.
    when: usize,
    period: usize,
}

pub fn new_chan(elem: usize, cap: usize, write_result: fn(*mut u8, *const u8)) -> *mut Chan {
    &mut Chan {
        lk: 0,
        elem,
        cap,
        buf: 0 as *mut u8,
        head: 0,
        len: 0,
        slots: 0,
        closed: false,
        send_seq: 0,
        recv_seq: 0,
        recv_waiter: 0,
        recvq: new_wait_list(),
        sendq: new_wait_list(),
        ackq: new_wait_list(),
        write_result,
        when: 0,
        period: 0,
    } as *mut Chan
}

// A timer channel's value, if its time has come and none waits in it: the
// time now (an Instant's nanoseconds); then the next time, the period's
// next multiple from the first (missed ones dropped), or none (its lock
// held).
fn timer_fill(c: *mut Chan) {
    unsafe {
        if (*c).when == 0 || (*c).len > 0 || (*c).elem != 8 {
            return;
        }
        let now = crate::rt::native::monotonic_nanos() as usize;
        if now < (*c).when {
            return;
        }
        let v = now as u64;
        push(c, &v as *const u64 as *const u8);
        if (*c).period == 0 {
            (*c).when = 0;
        } else {
            let k = (now - (*c).when) / (*c).period + 1;
            (*c).when = (*c).when + k * (*c).period;
        }
    }
}

/// Makes c a timer channel with its next value at when (monotonic
/// nanoseconds; 0: stopped) and then every period (0: once); receivers
/// waiting wake to wait for the new time.
pub fn timer_set(c: *mut Chan, when: u64, period: u64) {
    obj_lock(lk(c));
    unsafe {
        (*c).when = when as usize;
        (*c).period = period as usize;
    }
    broadcast(recvq(c));
    obj_unlock(lk(c));
}

/// c's values waiting, and its capacity (usize::MAX: unbounded).
pub fn chan_len(c: *mut Chan) -> usize {
    obj_lock(lk(c));
    timer_fill(c);
    let n = unsafe { (*c).len };
    obj_unlock(lk(c));
    n
}

pub fn chan_cap(c: *mut Chan) -> usize {
    unsafe { (*c).cap }
}

// Waits on w (lk held, and held again on return) until woken, or until
// deadline (monotonic nanoseconds; 0: none): whether the deadline woke it.
fn wait_until(w: *mut WaitList, lk: *mut usize, deadline: usize) -> bool {
    if deadline == 0 {
        wait(w, lk);
        return false;
    }
    enlist(w);
    obj_lock(&mut TIMER_LK as *mut usize);
    let t = add_timer(deadline);
    let two = [lk as usize, &mut TIMER_LK as *mut usize as usize];
    park_on(&two as *const [usize; 2] as *const usize, 2);
    obj_unlock(&mut TIMER_LK as *mut usize);
    unsafe { (*t).fired }
}

// The earlier of two deadlines (0: none).
fn earlier(a: usize, b: usize) -> usize {
    if a == 0 {
        b
    } else if b == 0 {
        a
    } else if a < b {
        a
    } else {
        b
    }
}

fn past(deadline: usize) -> bool {
    deadline != 0 && crate::rt::native::monotonic_nanos() as usize >= deadline
}

fn recvq(c: *mut Chan) -> *mut WaitList {
    unsafe { &mut (*c).recvq as *mut WaitList }
}

fn sendq(c: *mut Chan) -> *mut WaitList {
    unsafe { &mut (*c).sendq as *mut WaitList }
}

fn ackq(c: *mut Chan) -> *mut WaitList {
    unsafe { &mut (*c).ackq as *mut WaitList }
}

// After an element was taken: its unbuffered sender, or a sender waiting
// for room.
fn taken(c: *mut Chan) {
    unsafe {
        if (*c).cap == 0 {
            signal_upto(ackq(c), (*c).recv_seq);
        } else {
            signal(sendq(c));
        }
    }
}

// Passes on the wakes a select did not use: whoever may proceed on c.
fn kick(c: *mut Chan) {
    unsafe {
        if (*c).closed {
            broadcast(recvq(c));
            broadcast(sendq(c));
            return;
        }
        if (*c).len > 0 {
            signal(recvq(c));
        }
        if (*c).cap == UNBOUNDED
            || (*c).len < (*c).cap
            || (*c).cap == 0 && (*c).recv_waiter > (*c).len
        {
            signal(sendq(c));
        }
    }
}

fn lk(c: *mut Chan) -> *mut usize {
    unsafe { &mut (*c).lk as *mut usize }
}

fn copy_bytes(src: *const u8, dst: *mut u8, n: usize) {
    crate::rt::copy::<u8>(src, dst, n);
}

fn push(c: *mut Chan, src: *const u8) {
    unsafe {
        if (*c).len == (*c).slots {
            // Grow the ring (scan: elements may hold pointers).
            let slots = if (*c).slots == 0 { 4 } else { (*c).slots * 2 };
            let elem = if (*c).elem == 0 { 1 } else { (*c).elem };
            let nb = crate::rt::gc::alloc(slots * elem, false);
            let mut i = 0;
            preempt_off();
            while i < (*c).len {
                let from = ((*c).head + i) % (*c).slots;
                copy_bytes(
                    crate::rt::ptr_offset((*c).buf as *const u8, from * elem),
                    crate::rt::ptr_offset(nb as *const u8, i * elem) as *mut u8,
                    elem,
                );
                i += 1;
            }
            crate::rt::gc::shade_range(nb as usize, (*c).len * elem);
            preempt_on();
            (*c).buf = nb;
            (*c).head = 0;
            (*c).slots = slots;
        }
        let at = ((*c).head + (*c).len) % (*c).slots;
        let dst = crate::rt::ptr_offset((*c).buf as *const u8, at * (*c).elem) as *mut u8;
        // The element may hold pointers (the copy is of bytes): shaded
        // before (what it overwrites) and after, as a barrier does.
        preempt_off();
        crate::rt::gc::shade_range(dst as usize, (*c).elem);
        copy_bytes(src, dst, (*c).elem);
        crate::rt::gc::shade_range(dst as usize, (*c).elem);
        preempt_on();
        (*c).len += 1;
    }
}

fn pop(c: *mut Chan, dst: *mut u8) {
    unsafe {
        preempt_off();
        crate::rt::gc::shade_range(dst as usize, (*c).elem);
        copy_bytes(
            crate::rt::ptr_offset((*c).buf as *const u8, (*c).head * (*c).elem),
            dst,
            (*c).elem,
        );
        crate::rt::gc::shade_range(dst as usize, (*c).elem);
        preempt_on();
        (*c).head = ((*c).head + 1) % (*c).slots;
        (*c).len -= 1;
    }
}

/// Sends the elem bytes at src; false if the channel is closed.
pub fn send(c: *mut Chan, src: *const u8) -> bool {
    obj_lock(lk(c));
    let r = send_locked(c, src, 0);
    obj_unlock(lk(c));
    r == SENT
}

pub const SENT: usize = 0;
pub const CLOSED: usize = 1;
pub const TIMED_OUT: usize = 2;

/// send, waiting until deadline (monotonic nanoseconds) at most for room
/// (in an unbuffered channel, for a receiver): SENT, CLOSED or TIMED_OUT.
pub fn send_until(c: *mut Chan, src: *const u8, deadline: u64) -> usize {
    obj_lock(lk(c));
    let r = send_locked(c, src, deadline as usize);
    obj_unlock(lk(c));
    r
}

fn send_locked(c: *mut Chan, src: *const u8, deadline: usize) -> usize {
    unsafe {
        loop {
            if (*c).closed {
                return CLOSED;
            }
            if (*c).cap == UNBOUNDED || (*c).len < (*c).cap {
                break;
            }
            // Unbuffered: without a deadline the element goes in and the
            // sender waits for it to be taken; with one, it goes in once a
            // receiver waits.
            if (*c).cap == 0 && (deadline == 0 || (*c).recv_waiter > (*c).len) {
                break;
            }
            if past(deadline) {
                return TIMED_OUT;
            }
            wait_until(sendq(c), lk(c), deadline);
        }
        push(c, src);
        (*c).send_seq += 1;
        let seq = (*c).send_seq;
        signal(recvq(c));
        if (*c).cap == 0 {
            while (*c).recv_seq < seq && !(*c).closed {
                wait_key(ackq(c), lk(c), seq);
            }
        }
    }
    SENT
}

/// Receives into dst; false if the channel is closed and empty (or, when
/// not blocking, empty).
pub fn recv(c: *mut Chan, dst: *mut u8, block: bool) -> bool {
    obj_lock(lk(c));
    let r = recv_locked(c, dst, block, 0);
    obj_unlock(lk(c));
    r == SENT
}

/// recv, waiting until deadline (monotonic nanoseconds) at most: SENT (a
/// value), CLOSED (closed and empty) or TIMED_OUT.
pub fn recv_until(c: *mut Chan, dst: *mut u8, deadline: u64) -> usize {
    obj_lock(lk(c));
    let r = recv_locked(c, dst, true, deadline as usize);
    obj_unlock(lk(c));
    r
}

fn recv_locked(c: *mut Chan, dst: *mut u8, block: bool, deadline: usize) -> usize {
    unsafe {
        (*c).recv_waiter += 1;
        // A select may send to an unbuffered channel once a receiver waits.
        if (*c).cap == 0 {
            signal(sendq(c));
        }
        let mut timed_out = false;
        loop {
            timer_fill(c);
            if (*c).len > 0 || (*c).closed || !block {
                break;
            }
            if past(deadline) {
                timed_out = true;
                break;
            }
            // (A timer channel's next value wakes it too.)
            wait_until(recvq(c), lk(c), earlier(deadline, (*c).when));
        }
        (*c).recv_waiter -= 1;
        if (*c).len > 0 {
            pop(c, dst);
            (*c).recv_seq += 1;
            taken(c);
            return SENT;
        }
        if timed_out {
            return TIMED_OUT;
        }
    }
    CLOSED
}

pub fn close(c: *mut Chan) {
    obj_lock(lk(c));
    unsafe {
        (*c).closed = true;
    }
    broadcast(recvq(c));
    broadcast(sendq(c));
    broadcast(ackq(c));
    obj_unlock(lk(c));
}

/// Closes c from the receiving side (Receiver::close, or the collector
/// finding no Receiver left): closed, the values in it dropped (no one
/// will take them), every waiter woken (senders then fail).
pub fn close_recv(c: *mut Chan) {
    obj_lock(lk(c));
    unsafe {
        (*c).closed = true;
        (*c).len = 0;
        (*c).head = 0;
        (*c).buf = 0 as *mut u8;
        (*c).slots = 0;
    }
    broadcast(recvq(c));
    broadcast(sendq(c));
    broadcast(ackq(c));
    obj_unlock(lk(c));
}

pub fn closed(c: *mut Chan) -> bool {
    obj_lock(lk(c));
    let r = unsafe { (*c).closed && (*c).len == 0 };
    obj_unlock(lk(c));
    r
}

/// Whether c is closed, values left in it or not (a sender's view).
pub fn close_called(c: *mut Chan) -> bool {
    obj_lock(lk(c));
    let r = unsafe { (*c).closed };
    obj_unlock(lk(c));
    r
}

/// Runs a select over cases; returns the index of the case that ran or
/// cases.len() for the default case.
pub fn run_select(cases: &[crate::sync::mpmc::SelectCase], has_default: bool) -> usize {
    // The locks of the distinct channels, in address order (no deadlock
    // with another select).
    let mut locks: Vec<usize> = Vec::new();
    for c in cases.iter() {
        if case_off(c) {
            continue;
        }
        let l = lk(case_chan(c)) as usize;
        if !locks.contains(&l) {
            locks.push(l);
        }
    }
    locks.sort();
    for l in locks.iter() {
        obj_lock(*l as *mut usize);
    }
    let i = select_locked(cases, has_default, &locks);
    for l in locks.iter() {
        obj_unlock(*l as *mut usize);
    }
    i
}

fn select_locked(
    cases: &[crate::sync::mpmc::SelectCase],
    has_default: bool,
    locks: &[usize],
) -> usize {
    let n = cases.len();
    let mut waited = false;
    loop {
        let mut i = 0;
        while i < n {
            if case_off(&cases[i]) {
                i += 1;
                continue;
            }
            let c = case_chan(&cases[i]);
            let slot = case_slot(&cases[i]);
            // (A timer channel's value, if its time has come.)
            if !case_send(&cases[i]) {
                timer_fill(c);
            }
            unsafe {
                if case_send(&cases[i]) {
                    let ready = (*c).cap == UNBOUNDED
                        || (*c).len < (*c).cap
                        || (*c).cap == 0 && (*c).recv_waiter > (*c).len;
                    if !(*c).closed && ready {
                        push(c, slot as *const u8);
                        (*c).send_seq += 1;
                        signal(recvq(c));
                        if waited {
                            kick_others(cases, i);
                        }
                        return i;
                    }
                } else if (*c).len > 0 || (*c).closed {
                    if (*c).len > 0 {
                        let elem = if (*c).elem == 0 { 1 } else { (*c).elem };
                        let tmp = crate::rt::gc::alloc(elem, false);
                        pop(c, tmp);
                        (*c).recv_seq += 1;
                        taken(c);
                        ((*c).write_result)(slot, tmp as *const u8);
                    } else {
                        ((*c).write_result)(slot, 0 as *const u8);
                    }
                    if waited {
                        kick_others(cases, i);
                    }
                    return i;
                }
            }
            i += 1;
        }
        if has_default {
            return n;
        }
        let mut j = 0;
        // (The earliest next value of the timer channels received from.)
        let mut next = 0usize;
        while j < n {
            if case_off(&cases[j]) {
                j += 1;
                continue;
            }
            let cj = case_chan(&cases[j]);
            if case_send(&cases[j]) {
                enlist(sendq(cj));
            } else {
                enlist(recvq(cj));
            }
            if !case_send(&cases[j]) {
                next = earlier(next, unsafe { (*cj).when });
            }
            j += 1;
        }
        if next == 0 {
            park_on(locks.as_ptr(), locks.len());
        } else {
            obj_lock(&mut TIMER_LK as *mut usize);
            add_timer(next);
            let mut all: Vec<usize> = Vec::new();
            for l in locks.iter() {
                all.push(*l);
            }
            all.push(&mut TIMER_LK as *mut usize as usize);
            park_on(all.as_ptr(), all.len());
            obj_unlock(&mut TIMER_LK as *mut usize);
        }
        waited = true;
    }
}

// A woken select may have been the one woken for another case's channel:
// those channels are kicked (all their locks are held).
fn kick_others(cases: &[crate::sync::mpmc::SelectCase], chosen: usize) {
    let mine = case_chan(&cases[chosen]);
    let mut j = 0;
    while j < cases.len() {
        if case_off(&cases[j]) {
            j += 1;
            continue;
        }
        let c = case_chan(&cases[j]);
        if c as usize != mine as usize {
            kick(c);
        }
        j += 1;
    }
}

// A case its guard left out (a null channel; as Go's nil channel, never
// ready).
fn case_off(c: &crate::sync::mpmc::SelectCase) -> bool {
    crate::sync::mpmc::select_case_chan(c) as usize == 0
}

fn case_chan(c: &crate::sync::mpmc::SelectCase) -> *mut Chan {
    // The case points at the Sender or Receiver, whose first field is the
    // channel.
    unsafe { *(crate::sync::mpmc::select_case_chan(c) as *const *mut Chan) }
}

fn case_slot(c: &crate::sync::mpmc::SelectCase) -> *mut u8 {
    crate::sync::mpmc::select_case_slot(c)
}

fn case_send(c: &crate::sync::mpmc::SelectCase) -> bool {
    crate::sync::mpmc::select_case_send(c)
}

// --- M:N (navi) --------------------------------------------------------------

// The OS's threads and locks: pthreads, or Windows' slim reader/writer
// locks, condition variables and CreateThread.
#[cfg(not(target_os = "windows"))]
#[nonblocking]
extern "C" {
    fn pthread_mutex_init(m: *mut u8, attr: *const u8) -> i32;
    fn pthread_mutex_lock(m: *mut u8) -> i32;
    fn pthread_mutex_trylock(m: *mut u8) -> i32;
    fn pthread_mutex_unlock(m: *mut u8) -> i32;
    fn pthread_cond_init(c: *mut u8, attr: *const u8) -> i32;
    fn pthread_cond_wait(c: *mut u8, m: *mut u8) -> i32;
    fn pthread_cond_signal(c: *mut u8) -> i32;
    fn pthread_create(t: *mut usize, attr: *const u8, start: usize, arg: usize) -> i32;
    fn pthread_detach(t: usize) -> i32;
    fn sched_yield() -> i32;
    fn sysconf(name: i32) -> i64;
}

#[cfg(target_os = "macos")]
#[nonblocking]
extern "C" {
    fn pthread_cond_timedwait_relative_np(c: *mut u8, m: *mut u8, ts: *const i64) -> i32;
}

#[cfg(target_os = "linux")]
#[nonblocking]
extern "C" {
    fn pthread_cond_timedwait(c: *mut u8, m: *mut u8, ts: *const i64) -> i32;
    fn clock_gettime(clock: i32, ts: *mut i64) -> i32;
}

#[cfg(target_os = "windows")]
#[nonblocking]
extern "C" {
    fn InitializeSRWLock(l: *mut u8);
    fn AcquireSRWLockExclusive(l: *mut u8);
    fn TryAcquireSRWLockExclusive(l: *mut u8) -> u8;
    fn ReleaseSRWLockExclusive(l: *mut u8);
    fn InitializeConditionVariable(c: *mut u8);
    fn SleepConditionVariableSRW(c: *mut u8, l: *mut u8, ms: u32, flags: u32) -> i32;
    fn WakeConditionVariable(c: *mut u8);
    fn CreateThread(
        attr: *const u8,
        stack: usize,
        start: usize,
        arg: usize,
        flags: u32,
        id: *mut u32,
    ) -> usize;
    fn CloseHandle(h: usize) -> i32;
    fn SwitchToThread() -> i32;
    fn GetSystemInfo(info: *mut u8);
}

#[nonblocking]
extern "C" {
    fn calloc(n: usize, size: usize) -> *mut u8;
    fn realloc(p: *mut u8, size: usize) -> *mut u8;
    fn free(p: *mut u8);
}

#[cfg(target_os = "macos")]
const SC_NPROCESSORS_ONLN: i32 = 58;
#[cfg(target_os = "linux")]
const SC_NPROCESSORS_ONLN: i32 = 84;

#[cfg(not(target_os = "windows"))]
unsafe fn os_mutex_init(m: *mut u8) {
    pthread_mutex_init(m, 0 as *const u8);
}

#[cfg(not(target_os = "windows"))]
unsafe fn os_mutex_lock(m: *mut u8) {
    pthread_mutex_lock(m);
}

#[cfg(not(target_os = "windows"))]
unsafe fn os_mutex_trylock(m: *mut u8) -> bool {
    pthread_mutex_trylock(m) == 0
}

#[cfg(not(target_os = "windows"))]
unsafe fn os_mutex_unlock(m: *mut u8) {
    pthread_mutex_unlock(m);
}

#[cfg(not(target_os = "windows"))]
unsafe fn os_cond_init(c: *mut u8) {
    pthread_cond_init(c, 0 as *const u8);
}

#[cfg(not(target_os = "windows"))]
unsafe fn os_cond_wait(c: *mut u8, m: *mut u8) {
    pthread_cond_wait(c, m);
}

#[cfg(not(target_os = "windows"))]
unsafe fn os_cond_signal(c: *mut u8) {
    pthread_cond_signal(c);
}

#[cfg(not(target_os = "windows"))]
unsafe fn os_yield() {
    sched_yield();
}
// Waits on c (m held) for at most ns nanoseconds.
// (The timespec in C memory: a local whose address C gets would be a heap
// cell, and this runs on scheduler records, which must not allocate.)
#[cfg(target_os = "macos")]
unsafe fn os_cond_wait_ns(c: *mut u8, m: *mut u8, ns: u64) {
    let ts = calloc(2, 8) as *mut i64;
    *ts = (ns / 1000000000) as i64;
    *ts.add(1) = (ns % 1000000000) as i64;
    pthread_cond_timedwait_relative_np(c, m, ts as *const i64);
    free(ts as *mut u8);
}

#[cfg(target_os = "linux")]
unsafe fn os_cond_wait_ns(c: *mut u8, m: *mut u8, ns: u64) {
    // An absolute CLOCK_REALTIME deadline.
    let ts = calloc(2, 8) as *mut i64;
    clock_gettime(0, ts);
    let t = (*ts.add(1) as u64) + ns % 1000000000;
    *ts = *ts + (ns / 1000000000) as i64 + (t / 1000000000) as i64;
    *ts.add(1) = (t % 1000000000) as i64;
    pthread_cond_timedwait(c, m, ts as *const i64);
    free(ts as *mut u8);
}

#[cfg(not(target_os = "windows"))]
fn os_ncpu() -> i64 {
    unsafe { sysconf(SC_NPROCESSORS_ONLN) }
}
// Starts an OS thread at the C function start with arg; false if it
// cannot.
#[cfg(not(target_os = "windows"))]
unsafe fn os_thread(start: usize, arg: usize) -> bool {
    // The thread id in C memory: the monitor starts Ms too, and has no GC.
    let tp = calloc(1, 8) as *mut usize;
    if pthread_create(tp, 0 as *const u8, start, arg) != 0 {
        free(tp as *mut u8);
        return false;
    }
    pthread_detach(*tp);
    free(tp as *mut u8);
    true
}

#[cfg(target_os = "windows")]
unsafe fn os_mutex_init(m: *mut u8) {
    InitializeSRWLock(m);
}

#[cfg(target_os = "windows")]
unsafe fn os_mutex_lock(m: *mut u8) {
    AcquireSRWLockExclusive(m);
}

#[cfg(target_os = "windows")]
unsafe fn os_mutex_trylock(m: *mut u8) -> bool {
    TryAcquireSRWLockExclusive(m) != 0
}

#[cfg(target_os = "windows")]
unsafe fn os_mutex_unlock(m: *mut u8) {
    ReleaseSRWLockExclusive(m);
}

#[cfg(target_os = "windows")]
unsafe fn os_cond_init(c: *mut u8) {
    InitializeConditionVariable(c);
}

#[cfg(target_os = "windows")]
unsafe fn os_cond_wait(c: *mut u8, m: *mut u8) {
    SleepConditionVariableSRW(c, m, 0xffffffff, 0);
}

#[cfg(target_os = "windows")]
unsafe fn os_cond_signal(c: *mut u8) {
    WakeConditionVariable(c);
}

#[cfg(target_os = "windows")]
unsafe fn os_yield() {
    SwitchToThread();
}

#[cfg(target_os = "windows")]
unsafe fn os_cond_wait_ns(c: *mut u8, m: *mut u8, ns: u64) {
    let ms = (ns + 999999) / 1000000;
    SleepConditionVariableSRW(
        c,
        m,
        if ms >= 0xfffffffe {
            0xfffffffe
        } else {
            ms as u32
        },
        0,
    );
}
// SYSTEM_INFO.dwNumberOfProcessors is at 32.
#[cfg(target_os = "windows")]
fn os_ncpu() -> i64 {
    let mut info = [0u64; 8];
    unsafe {
        GetSystemInfo(&mut info as *mut [u64; 8] as *mut u8);
        *((&mut info as *mut [u64; 8] as usize + 32) as *const u32) as i64
    }
}

#[cfg(target_os = "windows")]
unsafe fn os_thread(start: usize, arg: usize) -> bool {
    let h = CreateThread(0 as *const u8, 0, start, arg, 0, 0 as *mut u32);
    if h == 0 {
        return false;
    }
    CloseHandle(h);
    true
}

// The stack of M0's scheduler record (other Ms use their thread's stack).
const G0_STACK: usize = 262144;

/// An OS thread running Gs.
struct M {
    // First to third: fixed (backend c_callback reads cur and cb).
    g0: *mut G,
    cur: *mut G,
    // The G that runs the next callback from C on this OS thread.
    cb: *mut G,
    next: *mut M,
    // A span per size class and noscan for allocation without the runtime
    // lock (see gc::alloc_mt).
    cache: [usize; 64],
    // The objects its write barriers marked, not yet shared (a gc mark
    // stack, made on first use; see gc::scan).
    wbuf: usize,
    // Its run queue (linked by G.next, under qlk) and the G to run next
    // (as Go's P: a readied G runs soon on the M that readied it).
    qlk: usize,
    qhead: usize,
    qtail: usize,
    qn: usize,
    runnext: usize,
    // Sleeping while idle: its own mutex, condition and flag (a note).
    note_mu: usize,
    note_cv: usize,
    note: usize,
    idle: bool,
    idle_next: usize,
    // What its scheduler record does after a G switched to it (AFTER_*).
    after: usize,
    after_g: usize,
    // The network poller's thread (runs no Gs; see netpoll).
    poller: bool,
    // The monitor's thread (runs no Gs; see sysmon).
    sysmon: bool,
    // Set by sysmon while its G is blocked long (another M took over), and
    // what sysmon saw blocked last: the G and its blk_seq.
    retaken: usize,
    mon_g: usize,
    mon_seq: usize,
    // Counts the Gs it starts running; what sysmon saw running last (the
    // count and when).
    run_seq: usize,
    mon_run_seq: usize,
    mon_run_t: usize,
}

// A G running this long is asked to yield (as Go's forcePreemptNS;
// NAVI_DEBUG=sliceus sets it in microseconds, for testing).
static mut TIME_SLICE: usize = 10000000;
// NAVI_DEBUG=noslice: no time slices (debugging).
static mut NOSLICE: bool = false;

// The runtime lock (pthread mutex) and the condition idle Ms wait on.
static mut MU: usize = 0;
static mut IDLE_CV: usize = 0;
// Whether a second M exists: before, the lock is not needed.
static mut MULTI: bool = false;
static mut NUM_M: usize = 1;
static mut MAX_M: usize = 1;
static mut IDLE: usize = 0;
static mut MS: usize = 0;
// Set while a collector stops the world.
static mut STW: usize = 0;
// The G that stopped the world (morestack does not stop it).
static mut STW_OWNER: usize = 0;

pub fn multi() -> bool {
    MULTI
}

/// The running M's span cache (an array of 64 words).
/// The running M's write barrier buffer (0: none, the G has no M, or the
/// thread is the poller's or the monitor's: what they shade, readying Gs,
/// goes to the shared stack).
pub fn m_wbuf() -> usize {
    let g = current();
    unsafe {
        let m = (*g).m as *mut M;
        if m as usize == 0 {
            return 0;
        }
        // (Their Ms are not on the MS list, whose buffers the mark takes:
        // one of theirs would never be scanned. A G record the poller
        // shaded there stayed marked unscanned, and what only it held, its
        // entry closure and the Gs after it on the ALL list, was missed.)
        if (*m).poller || (*m).sysmon {
            return 0;
        }
        if (*m).wbuf == 0 {
            (*m).wbuf = crate::rt::gc::new_mark_stack();
        }
        (*m).wbuf
    }
}

/// The write barrier buffer of the i-th M (0: none; WBUF_END past the
/// last; the world is stopped).
pub fn wbuf_at(i: usize) -> usize {
    let mut m = MS as *mut M;
    let mut k = 0;
    while m as usize != 0 {
        if k == i {
            return unsafe { (*m).wbuf };
        }
        m = unsafe { (*m).next };
        k += 1;
    }
    WBUF_END
}

/// What wbuf_at gives past the last M.
pub const WBUF_END: usize = 18446744073709551615;

pub fn m_cache() -> usize {
    let g = current();
    unsafe { &mut (*((*g).m as *mut M)).cache as *mut [usize; 64] as usize }
}

/// Empties every M's span cache (the world is stopped).
pub fn flush_caches() {
    let mut m = MS as *mut M;
    while m as usize != 0 {
        unsafe {
            let mut i = 0;
            while i < 64 {
                (*m).cache[i] = 0;
                i += 1;
            }
            m = (*m).next;
        }
    }
}

// M0 (the main OS thread) and its scheduler record, whose loop runs on a
// stack of its own the first time the main G blocks.
fn init_ms(main: *mut G) {
    let m = unsafe { calloc(1, crate::intrinsics::size_of::<M>()) } as *mut M;
    let g0 = new_g();
    let s0 = reserve(G0_STACK);
    unsafe {
        (*g0).stack_lo = s0;
        (*g0).stack_hi = s0 + G0_STACK;
        (*g0).guard = s0 + RED_ZONE;
        (*g0).status = RUNNING;
        (*g0).is_g0 = true;
        (*g0).m = m as usize;
        (*g0).entry = || {
            lock_held_mloop();
        };
        (*g0).sp = (*g0).stack_hi - 80;
        (*g0).fp = 0;
        (*g0).pc = crate::rt::gstart_address() as usize;
        *(((*g0).stack_hi - 8) as *mut usize) = g0 as usize;
        (*m).g0 = g0;
        (*m).cur = main;
        (*main).m = m as usize;
        (*main).running_on = m as usize;
        // The main G starts without a switch from g0: its C calls run
        // below g0's first frame.
        (*main).c_stack = ((*g0).sp - 256) & !15;
    }
    new_note(m);
    tls_init();
    tls_set(m);
    MS = m as usize;
    MU = unsafe { calloc(1, 128) } as usize;
    IDLE_CV = unsafe { calloc(1, 128) } as usize;
    unsafe {
        os_mutex_init(MU as *mut u8);
        os_cond_init(IDLE_CV as *mut u8);
    }
    MAX_M = max_procs();
}

/// The most OS threads running Gs at once.
pub fn procs() -> usize {
    if MAX_M == 0 { max_procs() } else { MAX_M }
}

/// The number of CPUs (whatever NAVI_MAXPROCS says).
pub fn cpus() -> usize {
    let n = os_ncpu();
    if n < 1 { 1 } else { n as usize }
}

// NAVI_MAXPROCS, else the number of CPUs.
fn max_procs() -> usize {
    if let Some(v) = crate::rt::native::os_getenv("NAVI_MAXPROCS") {
        let b = v.as_bytes();
        let mut n = 0usize;
        let mut i = 0;
        while i < b.len() && b[i] >= b'0' && b[i] <= b'9' {
            n = n * 10 + (b[i] - b'0') as usize;
            i += 1;
        }
        if n > 0 {
            return n;
        }
    }
    let n = os_ncpu();
    if n < 1 { 1 } else { n as usize }
}

/// Takes the runtime lock (recursively). Waiting for it counts as being
/// blocked outside navi code, so that a collector holding it can proceed.
pub fn lock() {
    let g = current();
    unsafe {
        (*g).lock_depth += 1;
        if (*g).lock_depth > 1 || !MULTI {
            return;
        }
        if os_mutex_trylock(MU as *mut u8) {
            return;
        }
        enter_blocked();
        os_mutex_lock(MU as *mut u8);
        exit_blocked();
    }
}

pub fn unlock() {
    let g = current();
    unsafe {
        (*g).lock_depth -= 1;
        if (*g).lock_depth == 0 && MULTI {
            os_mutex_unlock(MU as *mut u8);
        }
    }
}

/// Whether the running code is an M's scheduler record (navi).
pub fn on_g0() -> bool {
    unsafe { (*current()).is_g0 }
}

/// Before a call that may block outside navi code (waiting for the lock, a
/// system call): saves the stack pointer and registers for a collector.
// (Also with one OS thread: a callback from C may collect, scanning the
// blocked G's stack from what this saves, and start threads.)
#[inline(never)]
pub fn enter_blocked() {
    let g = current();
    unsafe {
        (*g).blk_seq += 1;
        (*g).sp = crate::rt::stack_pointer() as usize;
        // The caller's frame (this one is gone while the G blocks).
        (*g).fp = *(crate::rt::frame_address() as *const usize);
        crate::rt::spill_registers(&mut (*g).regs as *mut [usize; 10] as *mut usize);
        if MULTI {
            crate::rt::atomic_store(&mut (*g).sys as *mut usize, SYS_BLOCKED);
        } else {
            (*g).sys = SYS_BLOCKED;
        }
    }
}

/// After such a call: waits while a collector that claimed the G runs.
pub fn exit_blocked() {
    let g = current();
    unsafe {
        // One OS thread (no collector elsewhere to claim the G).
        if !MULTI && (*g).sys == SYS_BLOCKED {
            (*g).sys = SYS_RUNNING;
            return;
        }
        while !crate::rt::atomic_cas(&mut (*g).sys as *mut usize, SYS_BLOCKED, SYS_RUNNING) {
            // Only a collector's claim or a marker's scan keeps it waiting:
            // anything else is a lost state (it would wait forever, holding
            // what it holds).
            let st = crate::rt::atomic_load(&mut (*g).sys as *mut usize);
            // (Blocked again: a marker's scan ended meanwhile; try again.)
            if st != SYS_CLAIMED && st != SYS_SCANNING && st != SYS_BLOCKED {
                crate::rt::native::put(2, "exit_blocked: sys ");
                crate::rt::native::put_u64(2, st as u64);
                crate::rt::native::put(2, " g ");
                crate::rt::native::put_hex(2, g as u64);
                crate::rt::native::put(2, " running_on ");
                crate::rt::native::put_hex(2, (*g).running_on as u64);
                crate::rt::native::put(2, " m ");
                crate::rt::native::put_hex(2, (*g).m as u64);
                crate::rt::native::put(2, " cb_prev ");
                crate::rt::native::put_hex(2, (*g).cb_prev as u64);
                crate::rt::native::put(2, " status ");
                crate::rt::native::put_u64(2, (*g).status as u64);
                crate::rt::native::put(2, " stw ");
                crate::rt::native::put_u64(2, STW as u64);
                crate::rt::native::put(2, " owner ");
                crate::rt::native::put_hex(2, STW_OWNER as u64);
                crate::rt::native::put(2, "\n");
                crate::rt::native::fatal("exit_blocked: the G is not blocked");
            }
            os_yield();
        }
        // Another M took over meanwhile: this one counts again (find_runnable
        // idles one if too many run).
        let m = (*g).m as *mut M;
        if m as usize != 0
            && crate::rt::atomic_load(&mut (*m).retaken as *mut usize) != 0
            && crate::rt::atomic_cas(&mut (*m).retaken as *mut usize, 1, 0)
        {
            crate::rt::atomic_add(&mut NRETAKEN as *mut usize, 18446744073709551615);
        }
    }
}

/// Before a C call that may block or call back (the MIR wraps such calls):
/// the M's callback G is made on first use, then the G counts as blocked.
#[inline(never)]
pub fn enter_c() {
    let g = current();
    unsafe {
        if !(*g).is_g0 && (*g).m != 0 {
            let m = (*g).m as *mut M;
            if (*m).cb as usize == 0 {
                lock();
                if (*m).cb as usize == 0 {
                    (*m).cb = new_cb_g();
                }
                unlock();
            }
        }
    }
    enter_blocked();
}

fn netpoll_active() -> bool {
    crate::rt::netpoll::active()
}

// --- Timers ------------------------------------------------------------------
//
// A min-heap of deadlines (monotonic nanoseconds), each readying a G unless
// it was woken otherwise meanwhile (its wait_gen moved on). Schedulers run
// the expired ones whenever they look for work; an idle M sleeps until the
// next one.

struct Timer {
    when: usize,
    g: *mut G,
    gen: usize,
    fired: bool,
}

const NO_TIMER: usize = 18446744073709551615;
// The heap (an array of *mut Timer, GC memory), its size and capacity.
static mut TIMERS: usize = 0;
static mut TIMER_N: usize = 0;
static mut TIMER_CAP: usize = 0;
static mut TIMER_LK: usize = 0;
// The earliest deadline (NO_TIMER: none), read without the lock.
static mut TIMER_NEXT: usize = 18446744073709551615;

fn theap(i: usize) -> *mut Timer {
    unsafe { *((TIMERS + 8 * i) as *const *mut Timer) }
}

fn theap_set(i: usize, t: *mut Timer) {
    unsafe {
        *((TIMERS + 8 * i) as *mut *mut Timer) = t;
    }
}

// Adds a timer for the running G at when (TIMER_LK held).
fn add_timer(when: usize) -> *mut Timer {
    let g = current();
    let t = crate::rt::gc::alloc(crate::intrinsics::size_of::<Timer>(), false) as *mut Timer;
    unsafe {
        (*t).when = when;
        (*t).g = g;
        (*t).gen = (*g).wait_gen;
        (*t).fired = false;
    }
    if TIMER_N == TIMER_CAP {
        let cap = if TIMER_CAP == 0 { 16 } else { 2 * TIMER_CAP };
        let a = crate::rt::gc::alloc(8 * cap, false) as usize;
        let mut i = 0;
        while i < TIMER_N {
            unsafe {
                *((a + 8 * i) as *mut *mut Timer) = theap(i);
            }
            i += 1;
        }
        TIMERS = a;
        TIMER_CAP = cap;
    }
    let mut i = TIMER_N;
    TIMER_N += 1;
    while i > 0 {
        let p = (i - 1) / 2;
        if unsafe { (*theap(p)).when } <= when {
            break;
        }
        theap_set(i, theap(p));
        i = p;
    }
    theap_set(i, t);
    crate::rt::atomic_store(&mut TIMER_NEXT as *mut usize, unsafe { (*theap(0)).when });
    t
}

// Removes the earliest timer (TIMER_LK held).
fn pop_timer() -> *mut Timer {
    let top = theap(0);
    TIMER_N -= 1;
    if TIMER_N > 0 {
        let last = theap(TIMER_N);
        let w = unsafe { (*last).when };
        let mut i = 0;
        loop {
            let mut c = 2 * i + 1;
            if c >= TIMER_N {
                break;
            }
            if c + 1 < TIMER_N && unsafe { (*theap(c + 1)).when < (*theap(c)).when } {
                c += 1;
            }
            if w <= unsafe { (*theap(c)).when } {
                break;
            }
            theap_set(i, theap(c));
            i = c;
        }
        theap_set(i, last);
    }
    theap_set(TIMER_N, 0 as *mut Timer);
    crate::rt::atomic_store(
        &mut TIMER_NEXT as *mut usize,
        if TIMER_N > 0 {
            unsafe { (*theap(0)).when }
        } else {
            NO_TIMER
        },
    );
    top
}

// Readies the Gs whose timers expired (no allocation: Ms run it).
fn run_timers() {
    let next = crate::rt::atomic_load(&mut TIMER_NEXT as *mut usize);
    if next == NO_TIMER {
        return;
    }
    let now = crate::rt::native::monotonic_nanos() as usize;
    if next > now {
        return;
    }
    obj_lock(&mut TIMER_LK as *mut usize);
    while TIMER_N > 0 && unsafe { (*theap(0)).when } <= now {
        let t = pop_timer();
        unsafe {
            let g = (*t).g;
            if word_cas(&mut (*g).wait_gen as *mut usize, (*t).gen, (*t).gen + 1) {
                (*t).fired = true;
                // In deadline order, even when several expired at once.
                ready_at(g, true);
            }
        }
    }
    obj_unlock(&mut TIMER_LK as *mut usize);
}

/// Parks the running G for ns nanoseconds (its OS thread runs others).
pub fn sleep_ns(ns: u64) {
    if ns == 0 {
        yield_now();
        return;
    }
    let when = crate::rt::native::monotonic_nanos() as usize + ns as usize;
    obj_lock(&mut TIMER_LK as *mut usize);
    add_timer(when);
    let one = [&mut TIMER_LK as *mut usize as usize];
    park_on(&one as *const [usize; 1] as *const usize, 1);
    obj_unlock(&mut TIMER_LK as *mut usize);
}

/// wait, for at most ns nanoseconds: whether the time ran out.
pub fn wait_ns(w: *mut WaitList, lk: *mut usize, ns: u64) -> bool {
    enlist_key(w, 0);
    let when = crate::rt::native::monotonic_nanos() as usize + ns as usize;
    obj_lock(&mut TIMER_LK as *mut usize);
    let t = add_timer(when);
    let two = [lk as usize, &mut TIMER_LK as *mut usize as usize];
    park_on(&two as *const [usize; 2] as *const usize, 2);
    obj_unlock(&mut TIMER_LK as *mut usize);
    unsafe { (*t).fired }
}

// --- Run queues (as Go's GMP) ------------------------------------------------
//
// Each M has a run queue and a runnext slot; a G readied by a G goes to its
// M's runnext (the previous one to the queue's tail). An M looks at its own
// queue, then the global one (Gs that yielded, or readied with no M), then
// steals from other Ms; with nothing, it waits on its own note in the idle
// list. A readied G wakes an idle M unless one is already looking for work.
// The runtime lock is not used on these paths.

// The mark workers waiting to run (linked by next, under MQ_LK).
static mut MQ: usize = 0;
static mut MQ_LK: usize = 0;

fn mq_pop() -> *mut G {
    if crate::rt::atomic_load(&mut MQ as *mut usize) == 0 {
        return 0 as *mut G;
    }
    obj_lock(&mut MQ_LK as *mut usize);
    let g = MQ as *mut G;
    if g as usize != 0 {
        MQ = unsafe { (*g).next } as usize;
    }
    obj_unlock(&mut MQ_LK as *mut usize);
    g
}

/// With the world stopped to start a cycle: asks the Gs running on up to
/// n other Ms to yield when the world starts again (if they stopped in
/// the program's own code; see morestack), so that their Ms run the mark
/// workers (as Go's Ps schedule its dedicated workers then).
pub fn ask_yields(n: usize) {
    let me = current();
    let mut k = 0;
    let mut m = MS as *mut M;
    while m as usize != 0 && k < n {
        unsafe {
            let g = (*m).cur;
            if g as usize != 0
                && g as usize != me as usize
                && !(*g).is_g0
                && (*g).cb_prev as usize == 0
                && crate::rt::atomic_load(&mut (*g).sys as *mut usize) == SYS_STOPPED
            {
                (*g).preempt = 1;
                k += 1;
            }
            m = (*m).next;
        }
    }
}

static mut GQ_LK: usize = 0;
static mut GQ_HEAD: usize = 0;
static mut GQ_TAIL: usize = 0;
static mut IDLE_LK: usize = 0;
static mut IDLE_MS: usize = 0;
static mut NIDLE: usize = 0;
// Ms looking for work (stealing).
static mut NSPIN: usize = 0;

const AFTER_NONE: usize = 0;
const AFTER_PARK: usize = 1;
const AFTER_YIELD: usize = 2;
const AFTER_EXIT: usize = 3;

fn gq_push(g: *mut G) {
    obj_lock(&mut GQ_LK as *mut usize);
    unsafe {
        (*g).next = 0 as *mut G;
        if GQ_TAIL == 0 {
            GQ_HEAD = g as usize;
        } else {
            (*(GQ_TAIL as *mut G)).next = g;
        }
    }
    GQ_TAIL = g as usize;
    obj_unlock(&mut GQ_LK as *mut usize);
}

fn gq_pop() -> *mut G {
    if crate::rt::atomic_load(&mut GQ_HEAD as *mut usize) == 0 {
        return 0 as *mut G;
    }
    obj_lock(&mut GQ_LK as *mut usize);
    let g = GQ_HEAD as *mut G;
    if g as usize != 0 {
        GQ_HEAD = unsafe { (*g).next } as usize;
        if GQ_HEAD == 0 {
            GQ_TAIL = 0;
        }
    }
    obj_unlock(&mut GQ_LK as *mut usize);
    g
}

// m's queue (qlk held).
fn q_push(m: *mut M, g: *mut G) {
    unsafe {
        (*g).next = 0 as *mut G;
        if (*m).qtail == 0 {
            (*m).qhead = g as usize;
        } else {
            (*((*m).qtail as *mut G)).next = g;
        }
        (*m).qtail = g as usize;
        (*m).qn += 1;
    }
}

fn q_pop(m: *mut M) -> *mut G {
    unsafe {
        let g = (*m).qhead as *mut G;
        if g as usize != 0 {
            (*m).qhead = (*g).next as usize;
            if (*m).qhead == 0 {
                (*m).qtail = 0;
            }
            (*m).qn -= 1;
        }
        g
    }
}

fn qlk(m: *mut M) -> *mut usize {
    unsafe { &mut (*m).qlk as *mut usize }
}

// Queues g (runnable now) and wakes an M for it if needed.
fn ready(g: *mut G) {
    ready_at(g, false);
}

// ready, g to the M's runnext (it runs soon, as Go's), or with fifo to its
// queue's tail (Gs readied together run in that order: timers).
fn ready_at(g: *mut G, fifo: bool) {
    unsafe {
        (*g).status = RUNNABLE;
    }
    if unsafe { (*g).cb_prev } as usize != 0 {
        // A callback G waits on its own OS thread.
        note_wake(unsafe { (*g).m } as *mut M);
        return;
    }
    let cur = current();
    let mut mm = 0usize;
    if cur as usize != 0 {
        mm = unsafe { (*cur).m };
    }
    let m = mm as *mut M;
    if m as usize != 0 && unsafe { (*m).poller } {
        // From the poller's thread: the global queue, and an idle M (even
        // the only one) must look.
        gq_push(g);
        wake_idle();
        return;
    }
    if m as usize == 0 {
        gq_push(g);
    } else {
        preempt_off();
        obj_lock(qlk(m));
        unsafe {
            if fifo {
                q_push(m, g);
            } else {
                let old = (*m).runnext as *mut G;
                (*m).runnext = g as usize;
                if old as usize != 0 {
                    q_push(m, old);
                }
            }
        }
        obj_unlock(qlk(m));
        preempt_on();
    }
    wakep();
}

// Wakes an idle M (or starts one) unless an M is already looking for work.
fn wakep() {
    if MAX_M <= 1 && crate::rt::atomic_load(&mut NRETAKEN as *mut usize) == 0 {
        return;
    }
    if crate::rt::atomic_load(&mut NSPIN as *mut usize) != 0 {
        return;
    }
    obj_lock(&mut IDLE_LK as *mut usize);
    let m = IDLE_MS as *mut M;
    if m as usize != 0 {
        unsafe {
            IDLE_MS = (*m).idle_next;
            (*m).idle = false;
        }
        NIDLE -= 1;
    }
    obj_unlock(&mut IDLE_LK as *mut usize);
    if m as usize != 0 {
        note_wake(m);
        return;
    }
    if NUM_M < MAX_M + crate::rt::atomic_load(&mut NRETAKEN as *mut usize) {
        lock();
        if NUM_M < MAX_M + crate::rt::atomic_load(&mut NRETAKEN as *mut usize) {
            start_m();
        }
        unlock();
    }
}

// Wakes an idle M, if any (else starts one if allowed).
fn wake_idle() {
    obj_lock(&mut IDLE_LK as *mut usize);
    let m = IDLE_MS as *mut M;
    if m as usize != 0 {
        unsafe {
            IDLE_MS = (*m).idle_next;
            (*m).idle = false;
        }
        NIDLE -= 1;
    }
    obj_unlock(&mut IDLE_LK as *mut usize);
    if m as usize != 0 {
        note_wake(m);
        return;
    }
    wakep();
}

fn note_wake(m: *mut M) {
    unsafe {
        os_mutex_lock((*m).note_mu as *mut u8);
        (*m).note = 1;
        os_cond_signal((*m).note_cv as *mut u8);
        os_mutex_unlock((*m).note_mu as *mut u8);
    }
}

fn note_sleep(m: *mut M) {
    unsafe {
        os_mutex_lock((*m).note_mu as *mut u8);
        while (*m).note == 0 {
            os_cond_wait((*m).note_cv as *mut u8, (*m).note_mu as *mut u8);
        }
        (*m).note = 0;
        os_mutex_unlock((*m).note_mu as *mut u8);
    }
}

// note_sleep for at most ns nanoseconds: whether the note was set.
fn note_sleep_ns(m: *mut M, ns: u64) -> bool {
    unsafe {
        os_mutex_lock((*m).note_mu as *mut u8);
        if (*m).note == 0 {
            os_cond_wait_ns((*m).note_cv as *mut u8, (*m).note_mu as *mut u8, ns);
        }
        let woken = (*m).note != 0;
        (*m).note = 0;
        os_mutex_unlock((*m).note_mu as *mut u8);
        woken
    }
}

fn new_note(m: *mut M) {
    unsafe {
        (*m).note_mu = calloc(1, 128) as usize;
        (*m).note_cv = calloc(1, 128) as usize;
        os_mutex_init((*m).note_mu as *mut u8);
        os_cond_init((*m).note_cv as *mut u8);
    }
}

// A runnable G of m's own (runnext first).
fn local_pop(m: *mut M) -> *mut G {
    unsafe {
        if (*m).runnext == 0 && (*m).qhead == 0 {
            return 0 as *mut G;
        }
    }
    obj_lock(qlk(m));
    let mut g = unsafe { (*m).runnext } as *mut G;
    if g as usize != 0 {
        unsafe {
            (*m).runnext = 0;
        }
    } else {
        g = q_pop(m);
    }
    obj_unlock(qlk(m));
    g
}

// A G taken from another M: the head of its queue, else its runnext.
fn steal(me: *mut M) -> *mut G {
    let mut v = unsafe { (*me).next };
    let mut k = 0;
    while k < NUM_M * 2 {
        if v as usize == 0 {
            v = MS as *mut M;
        }
        if v as usize != me as usize {
            let busy = unsafe { (*v).qhead != 0 || (*v).runnext != 0 };
            if busy {
                obj_lock(qlk(v));
                let mut g = q_pop(v);
                if g as usize == 0 {
                    g = unsafe { (*v).runnext } as *mut G;
                    unsafe {
                        (*v).runnext = 0;
                    }
                }
                obj_unlock(qlk(v));
                if g as usize != 0 {
                    return g;
                }
            }
        }
        v = unsafe { (*v).next };
        k += 1;
    }
    0 as *mut G
}

// Whether any G is runnable (a look without locks).
fn work_exists() -> bool {
    if crate::rt::atomic_load(&mut GQ_HEAD as *mut usize) != 0 {
        return true;
    }
    if crate::rt::atomic_load(&mut MQ as *mut usize) != 0 {
        return true;
    }
    let mut v = MS as *mut M;
    while v as usize != 0 {
        unsafe {
            if crate::rt::atomic_load(&mut (*v).qhead as *mut usize) != 0 {
                return true;
            }
            if crate::rt::atomic_load(&mut (*v).runnext as *mut usize) != 0 {
                return true;
            }
            v = (*v).next;
        }
    }
    false
}

// Takes m off the idle list; false if a waker took it (it will be woken).
fn unidle(m: *mut M) -> bool {
    obj_lock(&mut IDLE_LK as *mut usize);
    let mut found = false;
    unsafe {
        if (*m).idle {
            let mut prev = 0usize;
            let mut x = IDLE_MS;
            while x != 0 {
                if x == m as usize {
                    if prev == 0 {
                        IDLE_MS = (*m).idle_next;
                    } else {
                        (*(prev as *mut M)).idle_next = (*m).idle_next;
                    }
                    break;
                }
                prev = x;
                x = (*(x as *mut M)).idle_next;
            }
            (*m).idle = false;
            NIDLE -= 1;
            found = true;
        }
    }
    obj_unlock(&mut IDLE_LK as *mut usize);
    found
}

// The next G for m to run (waits for one; not while the world is stopped).
fn find_runnable(m: *mut M) -> *mut G {
    loop {
        while crate::rt::atomic_load(&mut STW as *mut usize) != 0 {
            unsafe {
                os_yield();
            }
        }
        if too_many(m) {
            // An M sysmon replaced is back: one of them idles. Decided under
            // the idle list's lock (Ms looking at once would all idle).
            obj_lock(&mut IDLE_LK as *mut usize);
            if too_many(m) {
                unsafe {
                    (*m).idle_next = IDLE_MS;
                    (*m).idle = true;
                }
                IDLE_MS = m as usize;
                NIDLE += 1;
                obj_unlock(&mut IDLE_LK as *mut usize);
                note_sleep(m);
                continue;
            }
            obj_unlock(&mut IDLE_LK as *mut usize);
        }
        run_timers();
        let mut g = mq_pop();
        if g as usize != 0 {
            return g;
        }
        g = local_pop(m);
        if g as usize != 0 {
            return g;
        }
        g = gq_pop();
        if g as usize != 0 {
            return g;
        }
        crate::rt::atomic_add(&mut NSPIN as *mut usize, 1);
        g = steal(m);
        crate::rt::atomic_add(&mut NSPIN as *mut usize, 18446744073709551615);
        if g as usize != 0 {
            return g;
        }
        // Idle: on the list first, then a last look (a G readied meanwhile
        // either finds this M on the list or is seen here).
        obj_lock(&mut IDLE_LK as *mut usize);
        unsafe {
            (*m).idle_next = IDLE_MS;
            (*m).idle = true;
        }
        IDLE_MS = m as usize;
        NIDLE += 1;
        let all = NIDLE == NUM_M;
        obj_unlock(&mut IDLE_LK as *mut usize);
        if work_exists() {
            if !unidle(m) {
                note_sleep(m);
            }
            continue;
        }
        let next = crate::rt::atomic_load(&mut TIMER_NEXT as *mut usize);
        if next != NO_TIMER {
            // Asleep until the next timer (or woken).
            let now = crate::rt::native::monotonic_nanos() as usize;
            let woken = next > now && note_sleep_ns(m, (next - now) as u64);
            if !woken && !unidle(m) {
                note_sleep(m);
            }
            run_timers();
            continue;
        }
        if all && !netpoll_active() {
            // No M runs a G that could ready one: every G waits.
            deadlock();
        }
        note_sleep(m);
    }
}

// The waiting Gs and the return addresses of their frames (as Go lists the
// goroutines at a deadlock), and mstart's address for symbolizing them
// against the binary (tools/symbolize.py).
fn deadlock() -> ! {
    crate::rt::native::put(2, "fatal error: all goroutines are asleep - deadlock!\n\n");
    dump_goroutines();
    crate::rt::native::exit(2)
}

/// The Gs (those running only named: their saved frames are old) and the
/// return addresses of the frames of the others, after mstart's address
/// for symbolizing them (tools/symbolize.py).
pub fn dump_goroutines() {
    crate::rt::native::put(2, "mstart at ");
    crate::rt::native::put_hex(2, crate::rt::mstart_address() as u64);
    crate::rt::native::put(2, "\n");
    let mut g = ALL as *mut G;
    while g as usize != 0 {
        unsafe {
            if (*g).status != DEAD && !(*g).is_g0 && g as usize != FGC_G && g as usize != CL_G {
                crate::rt::native::put(2, "\ngoroutine ");
                crate::rt::native::put_u64(2, (*g).tid);
                if (*g).status == RUNNING {
                    crate::rt::native::put(2, " [running]\n");
                    g = (*g).all_next;
                    continue;
                }
                crate::rt::native::put(
                    2,
                    if (*g).status == WAITING {
                        " [waiting]:\n"
                    } else {
                        " [runnable]:\n"
                    },
                );
                crate::rt::native::put(2, "\t");
                crate::rt::native::put_hex(2, (*g).pc as u64);
                crate::rt::native::put(2, "\n");
                // The frame records: the caller's frame pointer, then the
                // return address.
                let mut fp = (*g).fp;
                let mut k = 0;
                while fp >= (*g).sp && fp < (*g).stack_hi && k < 64 {
                    crate::rt::native::put(2, "\t");
                    crate::rt::native::put_hex(2, *((fp + 8) as *const usize) as u64);
                    crate::rt::native::put(2, "\n");
                    fp = *(fp as *const usize);
                    k += 1;
                }
            }
            g = (*g).all_next;
        }
    }
}

// A G that ended (on its M's scheduler record): its stack goes back to the
// system unless it has the first size (as Go's gfput), then the G is kept
// for go to reuse.
fn exit_g(g: *mut G) {
    unsafe {
        // What it held goes (as Go's goexit clears the g): its record is a
        // heap object scanned as any other, and the registers it saved last
        // would keep objects alive (exit_current dropped its entry, on the
        // G: this runs on the scheduler record, which must not allocate).
        let mut i = 0;
        while i < 10 {
            (*g).regs[i] = 0;
            i += 1;
        }
        (*g).catch = 0;
        (*g).release = 0;
        (*g).sp = 0;
        (*g).fp = 0;
        if (*g).old_size != 0 {
            release((*g).old_stack, (*g).old_size);
            (*g).old_size = 0;
        }
        if (*g).stack_hi - (*g).stack_lo != STACK {
            release((*g).stack_lo, (*g).stack_hi - (*g).stack_lo);
            (*g).stack_lo = 0;
            (*g).stack_hi = 0;
        }
    }
    lock();
    unsafe {
        (*g).next = FREE_GS as *mut G;
    }
    FREE_GS = g as usize;
    NFREE_GS += 1;
    unlock();
}

// How many Gs are on FREE_GS; how many of them keep their stacks after a
// collection (see free_stacks).
static mut NFREE_GS: usize = 0;
const KEEP_STACKS: usize = 64;

/// After a collection (on a G): the stacks of the ended Gs past the first
/// KEEP_STACKS, and the pool's, go back to the system (as Go frees the
/// stacks of its global list of dead goroutines and its stack spans at each
/// cycle); go makes new ones as needed.
pub fn free_stacks() {
    drain_spool();
    let mut n = 0usize;
    let mut a = 0usize;
    lock();
    let mut g = FREE_GS as *mut G;
    let mut k = 0usize;
    while g as usize != 0 {
        unsafe {
            if k >= KEEP_STACKS && (*g).stack_hi != 0 {
                if n % 512 == 0 {
                    a = realloc(a as *mut u8, (n + 512) * 16) as usize;
                }
                *((a + 16 * n) as *mut usize) = (*g).stack_lo;
                *((a + 16 * n + 8) as *mut usize) = (*g).stack_hi - (*g).stack_lo;
                (*g).stack_lo = 0;
                (*g).stack_hi = 0;
                n += 1;
            }
            g = (*g).next;
        }
        k += 1;
    }
    unlock();
    let mut i = 0;
    while i < n {
        unsafe {
            release_os(
                *((a + 16 * i) as *const usize),
                *((a + 16 * i + 8) as *const usize),
            );
        }
        i += 1;
    }
    if a != 0 {
        unsafe {
            free(a as *mut u8);
        }
    }
}

/// Whether the running G may do a mark assist: not on a scheduler record,
/// nor holding the runtime lock or in preempt_off (it would keep a
/// collector waiting), nor an object lock (as Go's, not with m.locks: an
/// assist takes the runtime lock, whose holder may be waiting for that
/// one, as a collection waking the cleanup G did).
pub fn may_assist() -> bool {
    let g = current();
    g as usize != 0
        && unsafe {
            !(*g).is_g0
                && (*g).lock_depth == 0
                && (*g).nopreempt == 0
                && (*g).locks == 0
                && (*g).m != 0
        }
}

/// The bytes of the spawned Gs' stacks (those kept by ended Gs included;
/// not the main G's, which is fixed).
pub fn stack_bytes() -> usize {
    let mut n = 0usize;
    let mut g = ALL as *mut G;
    while g as usize != 0 {
        unsafe {
            // (Read without the lock: a G may be moving its stack.)
            let (lo, hi) = ((*g).stack_lo, (*g).stack_hi);
            if !(*g).main && hi > lo {
                n += hi - lo + (*g).old_size;
            }
            g = (*g).all_next;
        }
    }
    n
}

/// With the world stopped at the end of a cycle: asks each spawned G
/// using under a quarter of its grown stack to move to one half as large
/// at its next prologue's check (its limit is poisoned; start_the_world
/// keeps it so for the Gs on an M).
pub fn mark_shrinks() {
    let me = current();
    let mut g = ALL as *mut G;
    while g as usize != 0 {
        unsafe {
            if (*g).status != DEAD
                && !(*g).main
                && !(*g).is_g0
                && (*g).cb_stack == 0
                && g as usize != me as usize
                && (*g).stack_hi != 0
                && (*g).reserve_lo == 0
            {
                let size = (*g).stack_hi - (*g).stack_lo;
                let sp = (*g).sp;
                if size > STACK
                    && sp >= (*g).stack_lo
                    && sp < (*g).stack_hi
                    && (*g).stack_hi - sp < size / 4
                {
                    (*g).shrink = 1;
                    crate::rt::atomic_store(&mut (*g).guard as *mut usize, POISON);
                }
            }
            g = (*g).all_next;
        }
    }
}

// What m's scheduler record does once the G that switched to it stopped.
fn do_after(m: *mut M) {
    unsafe {
        let g = (*m).after_g as *mut G;
        match (*m).after {
            AFTER_PARK => release_locks(g),
            AFTER_YIELD => gq_push(g),
            AFTER_EXIT => exit_g(g),
            _ => {}
        }
        (*m).after = AFTER_NONE;
        (*m).after_g = 0;
    }
}

// The running G stops (its M's scheduler record does what) until it is
// readied and resumed.
fn stop_current(what: usize) {
    let g = current();
    if unsafe { (*g).cb_prev } as usize != 0 {
        stop_callback(g, what);
        return;
    }
    unsafe {
        let m = (*g).m as *mut M;
        (*m).after = what;
        (*m).after_g = g as usize;
        switch(g, (*m).g0);
    }
}

// --- Callbacks from C --------------------------------------------------------
//
// A C function navi called (on the M's scheduler stack, see backend call_c)
// may call a navi extern "C" fn: its C entry (backend c_callback) finds the
// M through thread-local storage and runs it on the M's callback G, whose
// own stack can grow, while the calling G stays blocked in its C call (its
// stack untouched). As Go's cgocallback, the callback G is bound to its OS
// thread: the C frames below the scheduler's are the thread's, so where it
// would wait for another G the thread sleeps instead (stop_callback).

#[cfg(not(target_os = "windows"))]
#[nonblocking]
extern "C" {
    fn pthread_key_create(key: *mut usize, dtor: usize) -> i32;
    fn pthread_setspecific(key: usize, v: usize) -> i32;
}

#[cfg(target_os = "windows")]
#[nonblocking]
extern "C" {
    fn TlsAlloc() -> u32;
    fn TlsSetValue(idx: u32, v: usize) -> i32;
}

#[cfg(not(target_os = "windows"))]
fn tls_init() {
    unsafe {
        pthread_key_create(crate::rt::tls_key_slot(), 0);
    }
}

#[cfg(target_os = "windows")]
fn tls_init() {
    unsafe {
        *crate::rt::tls_key_slot() = TlsAlloc() as usize;
    }
}

// Makes m the running OS thread's M for callbacks.
#[cfg(not(target_os = "windows"))]
fn tls_set(m: *mut M) {
    unsafe {
        pthread_setspecific(*crate::rt::tls_key_slot(), m as usize);
    }
}

#[cfg(target_os = "windows")]
fn tls_set(m: *mut M) {
    unsafe {
        TlsSetValue(*crate::rt::tls_key_slot() as u32, m as usize);
    }
}

// A callback G, idle (dead to the collector) until a callback runs on it.
fn new_cb_g() -> *mut G {
    let g = new_g();
    let stack = reserve(STACK);
    unsafe {
        (*g).stack_lo = stack;
        (*g).stack_hi = stack + STACK;
        (*g).guard = stack + RED_ZONE;
        (*g).status = DEAD;
        (*g).cb_stack = ((*g).stack_hi - 64) & !15;
    }
    g
}

/// The start of a callback from C, on m's callback G (the running G): it
/// becomes m's G. The runtime lock keeps a collection from stopping the
/// world meanwhile.
pub fn cb_enter(mp: usize) {
    let g = current();
    let m = mp as *mut M;
    lock();
    unsafe {
        let prev = (*m).cur;
        (*g).cb_prev = prev;
        (*g).m = mp;
        // On the M from now (a marker may hold it a moment: idle, it was
        // dead; only markers scanning stacks concurrently claim Gs).
        if crate::rt::gc::conc_stacks() {
            while !crate::rt::atomic_cas(&mut (*g).running_on as *mut usize, 0, mp) {
                os_yield();
            }
        }
        (*g).tid = (*prev).tid;
        (*g).capture = (*prev).capture;
        (*g).catch = 0;
        (*g).sys = SYS_RUNNING;
        (*g).status = RUNNING;
        crate::rt::atomic_store(&mut (*m).cur as *mut *mut G as *mut usize, g as usize);
        // The callback G of a C call this callback makes.
        if (*g).cb_next as usize == 0 {
            (*g).cb_next = new_cb_g();
        }
        (*m).cb = (*g).cb_next;
    }
    unlock();
}

/// The end of a callback: the G whose C call it served is m's G again.
pub fn cb_exit() {
    let g = current();
    lock();
    unsafe {
        let m = (*g).m as *mut M;
        (*m).cb = g;
        crate::rt::atomic_store(
            &mut (*m).cur as *mut *mut G as *mut usize,
            (*g).cb_prev as usize,
        );
        (*g).cb_prev = 0 as *mut G;
        (*g).status = DEAD;
        if crate::rt::gc::conc_stacks() {
            crate::rt::atomic_store(&mut (*g).running_on as *mut usize, 0);
        }
    }
    unlock();
    // Its stack may have moved: where the next callback starts. Last, with
    // no call after (a call's prologue may move it again: the next callback
    // ran on the old stack, which a later morestack unmapped under it).
    unsafe {
        (*g).cb_stack = ((*g).stack_hi - 64) & !15;
    }
}

// A callback G stops: it cannot switch to the scheduler (whose stack holds
// the C frames below it), so a yield is the OS thread's and a wait sleeps
// the thread until ready wakes it (blocked meanwhile, for the collector).
fn stop_callback(g: *mut G, what: usize) {
    if what == AFTER_YIELD {
        unsafe {
            (*g).status = RUNNING;
            os_yield();
        }
        return;
    }
    if what != AFTER_PARK {
        crate::rt::native::fatal("a callback from C cannot exit its thread");
    }
    let m = unsafe { (*g).m } as *mut M;
    enter_blocked();
    release_locks(g);
    note_sleep(m);
    exit_blocked();
    unsafe {
        (*g).status = RUNNING;
    }
}

/// Lets other Gs run (the G goes to the global queue, as in Go).
pub fn yield_now() {
    let g = current();
    unsafe {
        (*g).status = RUNNABLE;
    }
    stop_current(AFTER_YIELD);
}

fn exit_current() -> ! {
    let g = current();
    // The record and its stack are reused by a later G once this one has
    // switched away for good. Dead Gs stay on the ALL list (so they stay
    // allocated) but their stacks are not scanned.
    unsafe {
        // The empty closure first: a stop of the world does not wait for a
        // dead G, and one allocating meanwhile took an object from its M's
        // cache as the collector emptied it (the object was handed out
        // twice).
        (*g).entry = || {};
        (*g).capture = 0;
        (*g).status = DEAD;
    }
    stop_current(AFTER_EXIT);
    crate::rt::native::fatal("dead goroutine resumed")
}

// A new OS thread with its scheduler record (the runtime lock is held).
fn start_m() {
    if !MULTI {
        // From now on the lock is real: the running G holds it.
        unsafe {
            os_mutex_lock(MU as *mut u8);
        }
        MULTI = true;
        crate::rt::gc::MULTI = true;
    }
    let m = unsafe { calloc(1, crate::intrinsics::size_of::<M>()) } as *mut M;
    let g0 = unsafe { calloc(1, crate::intrinsics::size_of::<G>()) } as *mut G;
    new_note(m);
    unsafe {
        (*g0).is_g0 = true;
        (*g0).status = RUNNING;
        (*g0).m = m as usize;
        (*m).g0 = g0;
        (*m).next = MS as *mut M;
    }
    MS = m as usize;
    NUM_M += 1;
    if !unsafe { os_thread(crate::rt::mstart_address(), g0 as usize) } {
        crate::rt::native::fatal("cannot create an OS thread");
    }
}

/// The first navi code of a new M (its G register is its scheduler record).
pub fn mstart() -> ! {
    let m = unsafe { (*current()).m } as *mut M;
    if unsafe { (*m).poller } {
        crate::rt::netpoll::poll_loop();
    }
    if unsafe { (*m).sysmon } {
        sysmon_loop(m);
    }
    tls_set(m);
    mloop()
}

/// Starts the network poller's thread: an M outside the list of Ms (it
/// runs no Gs, and the collector need not stop it).
pub fn start_poller() {
    lock();
    if !MULTI {
        unsafe {
            os_mutex_lock(MU as *mut u8);
        }
        MULTI = true;
        crate::rt::gc::MULTI = true;
    }
    unlock();
    let m = unsafe { calloc(1, crate::intrinsics::size_of::<M>()) } as *mut M;
    let g0 = unsafe { calloc(1, crate::intrinsics::size_of::<G>()) } as *mut G;
    new_note(m);
    unsafe {
        (*g0).is_g0 = true;
        (*g0).status = RUNNING;
        (*g0).m = m as usize;
        (*m).g0 = g0;
        (*m).poller = true;
    }
    if !unsafe { os_thread(crate::rt::mstart_address(), g0 as usize) } {
        crate::rt::native::fatal("cannot create an OS thread");
    }
}

// --- The monitor (as Go's sysmon) --------------------------------------------
//
// An M whose G stays blocked outside navi code (a C call, a callback's
// wait) still counts toward MAX_M: with work waiting, the monitor lets
// another M take over (retake, as Go hands off the P of a G in a system
// call for 20 microseconds), and find_runnable idles one when it is back.

#[cfg(not(target_os = "windows"))]
#[nonblocking]
extern "C" {
    fn usleep(us: u32) -> i32;
}

#[cfg(target_os = "windows")]
#[nonblocking]
extern "C" {
    fn Sleep(ms: u32);
}
// Sleeps the OS thread (without GC memory: the monitor runs no G).
#[cfg(not(target_os = "windows"))]
fn os_sleep_us(us: u64) {
    unsafe {
        usleep(us as u32);
    }
}

#[cfg(target_os = "windows")]
fn os_sleep_us(us: u64) {
    unsafe {
        Sleep(((us + 999) / 1000) as u32);
    }
}

static mut NRETAKEN: usize = 0;
static mut SYSMON_ON: bool = false;

// Whether more Ms run Gs (m included) than MAX_M and those sysmon
// replaced.
fn too_many(m: *mut M) -> bool {
    let busy = NUM_M - NIDLE;
    busy > MAX_M + crate::rt::atomic_load(&mut NRETAKEN as *mut usize) && unsafe { !(*m).idle }
}

/// Starts the monitor's thread (once, with the first spawned G; the
/// runtime lock is held).
fn start_sysmon() {
    if SYSMON_ON {
        return;
    }
    SYSMON_ON = true;
    if !MULTI {
        unsafe {
            os_mutex_lock(MU as *mut u8);
        }
        MULTI = true;
        crate::rt::gc::MULTI = true;
    }
    let m = unsafe { calloc(1, crate::intrinsics::size_of::<M>()) } as *mut M;
    let g0 = unsafe { calloc(1, crate::intrinsics::size_of::<G>()) } as *mut G;
    new_note(m);
    unsafe {
        (*g0).is_g0 = true;
        (*g0).status = RUNNING;
        (*g0).m = m as usize;
        (*m).g0 = g0;
        (*m).sysmon = true;
    }
    if !unsafe { os_thread(crate::rt::mstart_address(), g0 as usize) } {
        crate::rt::native::fatal("cannot create an OS thread");
    }
}

// The monitor's loop: every 20 us (up to 10 ms while nothing is blocked;
// me is its M, unused),
// an M whose G has been blocked in the same call since the last look is
// replaced if work waits.
fn sysmon_loop(me: *mut M) -> ! {
    NOSLICE = crate::rt::native::debug_on("noslice");
    let mut max_delay: u64 = 10000;
    {
        let n = crate::rt::native::debug_usize("sliceus");
        if n > 0 {
            TIME_SLICE = n * 1000;
            if (n as u64) < max_delay {
                max_delay = n as u64;
            }
        }
    }
    let mut delay: u64 = 20;
    loop {
        os_sleep_us(delay);
        let mut blocked = false;
        let mut m = MS as *mut M;
        while m as usize != 0 {
            unsafe {
                let g =
                    crate::rt::atomic_load(&mut (*m).cur as *mut *mut G as *mut usize) as *mut G;
                let st = if g as usize == 0 {
                    SYS_RUNNING
                } else {
                    crate::rt::atomic_load(&mut (*g).sys as *mut usize)
                };
                if st == SYS_BLOCKED || st == SYS_CLAIMED {
                    blocked = true;
                    let seq = (*g).blk_seq;
                    if (*m).mon_g == g as usize && (*m).mon_seq == seq {
                        // Counted first: once the flag is set, the G returning
                        // from C takes the count back (it must never go below
                        // zero, even for a moment: too_many adds it).
                        if (*m).retaken == 0 && work_exists() {
                            crate::rt::atomic_add(&mut NRETAKEN as *mut usize, 1);
                            if crate::rt::atomic_cas(&mut (*m).retaken as *mut usize, 0, 1) {
                                wakep();
                            } else {
                                crate::rt::atomic_add(
                                    &mut NRETAKEN as *mut usize,
                                    18446744073709551615,
                                );
                            }
                        }
                    } else {
                        (*m).mon_g = g as usize;
                        (*m).mon_seq = seq;
                    }
                } else {
                    (*m).mon_g = 0;
                    // A G running for a time slice is asked to yield at its
                    // next check: poisoning its limit takes it to morestack.
                    let seq = crate::rt::atomic_load(&mut (*m).run_seq as *mut usize);
                    let now = crate::rt::native::monotonic_nanos() as usize;
                    if g as usize != 0 && (*m).mon_run_seq == seq && !NOSLICE {
                        // (Again each look: start_the_world or morestack may
                        // have restored the limit since.)
                        if now - (*m).mon_run_t >= TIME_SLICE
                            && !(*g).is_g0
                            && (*g).cb_prev as usize == 0
                        {
                            (*g).preempt = 1;
                            crate::rt::atomic_store(&mut (*g).guard as *mut usize, POISON);
                        }
                    } else {
                        (*m).mon_run_seq = seq;
                        (*m).mon_run_t = now;
                    }
                }
                m = (*m).next;
            }
        }
        force_gc(crate::rt::native::monotonic_nanos());
        // (At most a time slice, 10 ms.)
        delay = if blocked {
            20
        } else if delay < max_delay {
            delay * 2
        } else {
            max_delay
        };
    }
}

/// The running G's wait generation (a waker that saw it readies the G
/// only if it has not been woken otherwise since: wake_gen).
pub fn wait_gen(g: *mut G) -> usize {
    unsafe { crate::rt::atomic_load(&mut (*g).wait_gen as *mut usize) }
}

/// Readies g unless it was woken since its wait generation was gen.
pub fn wake_gen(g: *mut G, gen: usize) {
    if unsafe { word_cas(&mut (*g).wait_gen as *mut usize, gen, gen + 1) } {
        ready(g);
    }
}

/// Parks the running G, releasing lk (held again on return), until a
/// wake_gen or deadline (monotonic nanoseconds; 0: none): whether the
/// deadline woke it.
pub fn park_until(lk: *mut usize, deadline: u64) -> bool {
    if deadline == 0 {
        let one = [lk as usize];
        park_on(&one as *const [usize; 1] as *const usize, 1);
        return false;
    }
    obj_lock(&mut TIMER_LK as *mut usize);
    let t = add_timer(deadline as usize);
    let two = [lk as usize, &mut TIMER_LK as *mut usize as usize];
    park_on(&two as *const [usize; 2] as *const usize, 2);
    obj_unlock(&mut TIMER_LK as *mut usize);
    unsafe { (*t).fired }
}

fn lock_held_mloop() {
    mloop();
}

// The scheduler loop of an M, on its scheduler record: runs runnable Gs
// until each stops, sleeps while there are none.
fn mloop() -> ! {
    let g0 = current();
    let m = unsafe { (*g0).m } as *mut M;
    loop {
        // The G that switched here (M0's main G the first time) stopped: its
        // context is saved, a collector need not wait for it (do_after may
        // wait for the runtime lock a collector holds).
        let prev = crate::rt::atomic_load(unsafe { &mut (*m).cur as *mut *mut G as *mut usize });
        if prev != 0 {
            crate::rt::atomic_store(
                unsafe { &mut (*(prev as *mut G)).running_on as *mut usize },
                0,
            );
        }
        crate::rt::atomic_store(unsafe { &mut (*m).cur as *mut *mut G as *mut usize }, 0);
        do_after(m);
        let g = find_runnable(m);
        // Running from now on, then visible to a collector, then a look at
        // whether one stops the world (it sets STW before looking at the
        // Ms): one of the two sees the other.
        unsafe {
            (*g).status = RUNNING;
            (*g).m = m as usize;
        }
        crate::rt::atomic_store(
            unsafe { &mut (*m).cur as *mut *mut G as *mut usize },
            g as usize,
        );
        if crate::rt::atomic_load(&mut STW as *mut usize) != 0 {
            crate::rt::atomic_store(unsafe { &mut (*m).cur as *mut *mut G as *mut usize }, 0);
            unsafe {
                (*g).status = RUNNABLE;
            }
            gq_push(g);
            continue;
        }
        // A marker scanning its stack holds it a moment (and may take it
        // until this M does): it waits in the queue meanwhile, as for a stop
        // of the world, rather than this M for the marker, which may be
        // waiting itself (stopped for the world, or behind this M).
        if !crate::rt::atomic_cas(unsafe { &mut (*g).running_on as *mut usize }, 0, m as usize) {
            let on = crate::rt::atomic_load(unsafe { &mut (*g).running_on as *mut usize });
            if on == SCANNING || on == 0 {
                crate::rt::atomic_store(unsafe { &mut (*m).cur as *mut *mut G as *mut usize }, 0);
                unsafe {
                    (*g).status = RUNNABLE;
                }
                gq_push(g);
                unsafe {
                    os_yield();
                }
                continue;
            }
            crate::rt::native::put(2, "G ");
            crate::rt::native::put_u64(2, g as u64);
            crate::rt::native::put(2, " already runs on M ");
            crate::rt::native::put_u64(2, on as u64);
            crate::rt::native::put(2, ", now taken by M ");
            crate::rt::native::put_u64(2, m as u64);
            crate::rt::native::put(2, "\n");
            crate::rt::native::fatal("a G scheduled twice");
        }
        crate::rt::atomic_add(unsafe { &mut (*m).run_seq as *mut usize }, 1);
        switch(g0, g);
    }
}

// An object lock (a word in a channel or thread handle; 0: free). A G
// spinning on one calls a function each time round, a safepoint for a
// collector.
pub fn obj_lock(lk: *mut usize) {
    while !crate::rt::atomic_cas(lk, 0, 1) {
        spin_wait();
    }
    let g = current();
    if g as usize != 0 {
        unsafe {
            (*g).locks += 1;
        }
    }
}

pub fn obj_unlock(lk: *mut usize) {
    crate::rt::atomic_store(lk, 0);
    let g = current();
    if g as usize != 0 {
        unsafe {
            if (*g).locks > 0 {
                (*g).locks -= 1;
            }
        }
    }
}

fn spin_wait() {
    unsafe {
        os_yield();
    }
}

/// Keeps the running G from stopping for the collector until preempt_on:
/// a store and the write barrier's marking happen in one step.
pub fn preempt_off() {
    unsafe {
        (*current()).nopreempt += 1;
    }
}

pub fn preempt_on() {
    unsafe {
        (*current()).nopreempt -= 1;
    }
}

static mut NEXT_TID: u64 = 1;

/// The running G's std::thread::ThreadId.
/// The running G's output capture (0: none; see G.capture).
pub fn output_capture() -> usize {
    let g = current();
    if g as usize == 0 {
        return 0;
    }
    unsafe { if (*g).is_g0 { 0 } else { (*g).capture } }
}

/// Sets the running G's output capture (0: none).
pub fn set_output_capture(c: usize) {
    unsafe {
        (*current()).capture = c;
    }
}

pub fn current_id() -> u64 {
    let g = current();
    if g as usize == 0 {
        return 1;
    } // before the scheduler starts
    unsafe { (*g).tid }
}

/// The atomic word operations of std::sync::atomic.
pub fn word_load(w: *mut usize) -> usize {
    crate::rt::atomic_load(w)
}

pub fn word_store(w: *mut usize, v: usize) {
    crate::rt::atomic_store(w, v);
}

pub fn word_add(w: *mut usize, v: usize) -> usize {
    crate::rt::atomic_add(w, v)
}

pub fn word_cas(w: *mut usize, old: usize, new: usize) -> bool {
    crate::rt::atomic_cas(w, old, new)
}

/// A std::sync::Mutex (as Go's sync.Mutex): its word is 0 (free), 1
/// (held) or 2 (held, Gs may wait); lk guards the wait list q. A locker
/// spins a little, then sleeps on q; an unlock with waiters wakes one.
pub fn mutex_lock(w: *mut usize, lk: *mut usize, q: *mut WaitList) {
    let mut i = 0;
    while i < 30 {
        if word_cas(w, 0, 1) {
            return;
        }
        i += 1;
    }
    loop {
        obj_lock(lk);
        // Taken now, or marked contended (so that unlock wakes a waiter).
        loop {
            let v = word_load(w);
            if v == 0 {
                if word_cas(w, 0, 2) {
                    obj_unlock(lk);
                    return;
                }
                continue;
            }
            if v == 2 || word_cas(w, 1, 2) {
                break;
            }
        }
        wait(q, lk);
        obj_unlock(lk);
    }
}

pub fn mutex_try_lock(w: *mut usize) -> bool {
    word_cas(w, 0, 1)
}

pub fn mutex_unlock(w: *mut usize, lk: *mut usize, q: *mut WaitList) {
    if word_cas(w, 1, 0) {
        return;
    }
    obj_lock(lk);
    word_store(w, 0);
    signal(q);
    obj_unlock(lk);
}

/// Gives the CPU to another thread while spinning.
pub fn cpu_relax() {
    unsafe {
        os_yield();
    }
}

// Blocks the running G (its wait nodes are enlisted) until woken: it holds
// the n object locks at locks, which its M's scheduler record releases
// after the switch (so a waker cannot see it before it stopped); they are
// held again on return.
fn park_on(locks: *const usize, n: usize) {
    let g = current();
    unsafe {
        (*g).status = WAITING;
        (*g).release = locks as usize;
        (*g).release_n = n;
    }
    stop_current(AFTER_PARK);
    let mut i = 0;
    while i < n {
        obj_lock(unsafe { *((locks as usize + 8 * i) as *const usize) } as *mut usize);
        i += 1;
    }
}

// Releases the object locks a G that just switched away held (park_on).
// The addresses are copied first: once one lock is free the G may be woken,
// run (its stack, which holds the list, changes) and park again.
fn release_locks(g: *mut G) {
    unsafe {
        let n = (*g).release_n;
        let base = (*g).release;
        (*g).release_n = 0;
        // Released for g (it takes them again when it runs).
        (*g).locks = if (*g).locks > n { (*g).locks - n } else { 0 };
        // No GC memory here: this runs on the M's scheduler record, which a
        // collector neither stops nor scans.
        let mut few = [0usize; 64];
        let many = if n > 64 { calloc(n, 8) as usize } else { 0 };
        let mut i = 0;
        while i < n {
            let a = *((base + 8 * i) as *const usize);
            if n <= 64 {
                few[i] = a;
            } else {
                *((many + 8 * i) as *mut usize) = a;
            }
            i += 1;
        }
        i = 0;
        while i < n {
            let a = if n <= 64 {
                few[i]
            } else {
                *((many + 8 * i) as *const usize)
            };
            obj_unlock(a as *mut usize);
            i += 1;
        }
        if many != 0 {
            free(many as *mut u8);
        }
    }
}

/// The slow path of the stack check: a collector asked this G to stop (it
/// scans the stack while the G waits), or the stack is exhausted: a
/// spawned G's moves to one twice as large (or more). Called with the G's
/// limit cleared; returns how far the stack moved (its stub moves SP and
/// FP as much).
pub fn morestack() -> usize {
    let g = current();
    unsafe {
        if (*g).stack_hi == 0 {
            return 0;
        } // a thread's scheduler record: no limit
        // Entered from inside morestack (the collector poisoned the limit):
        // the outer one stops the G at the next prologue if need be. The
        // stub cleared the limit, which the outer one may have set already:
        // poisoned, the next prologue comes here again and sets it (else the
        // G ran on without a limit, and a large frame went past its stack).
        if (*g).ms_depth > 1 {
            crate::rt::atomic_store(&mut (*g).guard as *mut usize, POISON);
            return 0;
        }
        // Between enter_blocked and the call that blocks (a function's
        // prologue): the G runs navi code again until morestack is done (a
        // collector waits for it rather than scanning a stack that may move)
        // and blocked after, with the SP and FP it saved moved too.
        let mut was_blocked = false;
        let bsp = (*g).sp;
        let bfp = (*g).fp;
        let olo = (*g).stack_lo;
        let ohi = (*g).stack_hi;
        if !(*g).is_g0 {
            loop {
                let st = crate::rt::atomic_load(&mut (*g).sys as *mut usize);
                if st == SYS_RUNNING {
                    break;
                }
                if st == SYS_BLOCKED
                    && crate::rt::atomic_cas(&mut (*g).sys as *mut usize, SYS_BLOCKED, SYS_RUNNING)
                {
                    was_blocked = true;
                    break;
                }
                // Claimed: a collector scans the stack; wait for it.
                os_yield();
            }
        }
        // (The G that stopped the world does not stop for itself.)
        let stw = crate::rt::atomic_load(&mut STW as *mut usize) != 0 && STW_OWNER != g as usize;
        if stw && !(*g).is_g0 && (*g).nopreempt != 0 {
            // Stops at a prologue after preempt_on (the stub zeroed the
            // limit: poisoned again).
            (*g).guard = POISON;
            if was_blocked {
                crate::rt::atomic_store(&mut (*g).sys as *mut usize, SYS_BLOCKED);
            }
            return 0;
        }
        if stw && !(*g).is_g0 {
            // A collector scans from SP to the frame record call_morestack
            // (or _navi_poll) pushed (above the stub's: morestack's frames
            // and the registers the stub saved, conservatively), then the
            // frames of the entering function's callers (a loop's: its own
            // frame too) by their maps. (The stub's own record returns into
            // the entering function, whose frame does not exist yet: its map
            // must not describe its caller's.)
            (*g).sp = crate::rt::stack_pointer() as usize;
            (*g).fp = (*g).entry_sp + 256 + 16;
            crate::rt::atomic_store(&mut (*g).sys as *mut usize, SYS_STOPPED);
            while crate::rt::atomic_load(&mut STW as *mut usize) != 0 {
                os_yield();
            }
            crate::rt::atomic_store(&mut (*g).sys as *mut usize, SYS_RUNNING);
        }
        // A marker asked: the G scans its own stack (stopped here, as a
        // collector would scan it: morestack's frames and the registers the
        // stub saved conservatively, the rest by the maps). Not in
        // preempt_off: the code it stopped may hold the mark lock (or another
        // the scan takes); the marker asks again.
        if (*g).scan_req != 0 && !(*g).is_g0 && (*g).nopreempt == 0 {
            let cyc = (*g).scan_req;
            (*g).scan_req = 0;
            if crate::rt::gc::marking() && cyc == crate::rt::gc::cycle_no() && (*g).scan_cyc != cyc
            {
                scan_stack_into(
                    crate::rt::stack_pointer() as usize,
                    (*g).entry_sp + 256 + 16,
                    (*g).stack_hi,
                    0,
                );
                crate::rt::gc::flush_wbuf();
                (*g).scan_cyc = cyc;
            }
        }
        if (*g).old_size != 0 {
            release((*g).old_stack, (*g).old_size);
            (*g).old_size = 0;
        }
        let mut delta = 0usize;
        stack_mode();
        // (Only while little of the stack is used: deep recursion would
        // copy quadratically.)
        // The collector's stack must not move while the world is stopped:
        // it holds its own SP and frames (stop_the_world makes room first).
        let owner = crate::rt::atomic_load(&mut STW as *mut usize) != 0 && STW_OWNER == g as usize;
        // need 0: a loop's check (_navi_poll), which only stops: its frame
        // exists and registers may hold addresses in it, so the stack
        // never moves there.
        let poll = (*g).need == 0;
        let stress = STACKMOVE
            && !poll
            && (*g).nomove == 0
            && !owner
            && !(*g).main
            && !(*g).is_g0
            && (*g).stack_hi - (*g).entry_sp < 262144;
        if !poll
            && (*g).entry_sp < (*g).stack_lo + RED_ZONE + (*g).need
            && (*g).main
            && commit_more(g)
        {
            // (Windows: the main stack committed further; it stays put.)
        } else if !poll && (*g).entry_sp < (*g).stack_lo + RED_ZONE + (*g).need || stress {
            if (*g).main || (*g).is_g0 {
                crate::rt::native::fatal("stack overflow");
            }
            if owner {
                crate::rt::native::fatal(
                    "the collector ran out of stack while the world was stopped",
                );
            }
            if (*g).nomove != 0 {
                crate::rt::native::fatal("the stack ran out while the G scanned it");
            }
            delta = grow(g, !was_blocked && (*g).cb_stack == 0);
        } else if (*g).shrink != 0
            && !poll
            && (*g).nomove == 0
            && !was_blocked
            && !owner
            && !(*g).main
            && !(*g).is_g0
            && (*g).cb_stack == 0
        {
            // A collection found most of the stack unused (a loop's check
            // leaves it for a prologue's; the next collection asks again).
            delta = shrink(g);
        }
        if !poll {
            (*g).shrink = 0;
        }
        let mut limit = (*g).stack_lo + RED_ZONE;
        if stress {
            let near = (*g).entry_sp.wrapping_add(delta) - (*g).need - 256;
            if near > limit {
                limit = near;
            }
        }
        // A collector may have poisoned the limit meanwhile (it sets STW
        // first): the G must still stop at its next prologue.
        crate::rt::atomic_store(&mut (*g).guard as *mut usize, limit);
        if crate::rt::atomic_load(&mut STW as *mut usize) != 0
            && STW_OWNER != g as usize
            && !(*g).is_g0
        {
            crate::rt::atomic_store(&mut (*g).guard as *mut usize, POISON);
        }
        if was_blocked {
            (*g).sp = if bsp >= olo && bsp < ohi {
                bsp.wrapping_add(delta)
            } else {
                bsp
            };
            (*g).fp = if bfp >= olo && bfp < ohi {
                bfp.wrapping_add(delta)
            } else {
                bfp
            };
            crate::rt::atomic_store(&mut (*g).sys as *mut usize, SYS_BLOCKED);
        } else if (*g).preempt != 0
            && !(*g).is_g0
            && (*g).nopreempt == 0
            && (*g).lock_depth == 0
            && (*g).locks == 0
            && (*g).cb_prev as usize == 0
            && !owner
            && (*g).status == RUNNING
            && delta == 0
            && preemptible(poll, (*g).entry_sp)
        {
            // A time slice is over: other Gs run (as Go's preemption at a
            // prologue). Parked here, the G is scanned as one stopped here:
            // conservatively up to the record above the stub, then by the
            // maps. (Not after moving the stack: morestack's frames are on
            // the old one until the stub returns; a later check yields.)
            (*g).preempt = 0;
            (*g).ms_fp = (*g).entry_sp + 256 + 16;
            yield_now();
            (*g).ms_fp = 0;
            // The limit again: a prologue on the way (a poisoned limit)
            // entered a nested morestack, whose stub cleared it and which
            // returned at once, the outer one having set it already.
            crate::rt::atomic_store(&mut (*g).guard as *mut usize, limit);
            if crate::rt::atomic_load(&mut STW as *mut usize) != 0 && STW_OWNER != g as usize {
                crate::rt::atomic_store(&mut (*g).guard as *mut usize, POISON);
            }
        } else {
            (*g).preempt = 0;
        }
        delta
    }
}

const POISON: usize = 18446744073709551615;

// Whether the check that entered morestack is in code that may yield for
// a time slice: the program's own (not std's, nor the runtime's: as Go
// does not preempt runtime code, which may hold its M's state, be between
// registering a G as waiting and parking it, or rely on not stopping
// between two steps; std code may be called by the runtime). A loop's
// check is in the function of the record _navi_poll pushed (above the
// stub's 256 bytes and record), a prologue's in the function the stub
// returns into; code without a map is the runtime's own.
fn preemptible(poll: bool, entry_sp: usize) -> bool {
    let ret = if poll {
        unsafe { *((entry_sp + 256 + 16 + 8) as *const usize) }
    } else {
        unsafe { *((entry_sp + 256 + 8) as *const usize) }
    };
    let (m, _) = find_map(ret);
    m != 0 && unsafe { *((m + 8) as *const usize) } & 3 == 0
}

/// Moves the running G's stack (from its stub's SP up) to a new one with
/// room for what the function entering morestack needs; returns how far it
/// moved. Every word of the copy that points into the old stack (saved
/// FPs, addresses of locals, the registers the stub saved) is moved as
/// much, as are the catch_unwind records (on the heap). Nothing else
/// points into a stack: escape analysis keeps such locals on the heap.
fn grow(g: *mut G, may_shrink: bool) -> usize {
    unsafe {
        let lo = (*g).stack_lo;
        let hi = (*g).stack_hi;
        let sp = (*g).entry_sp;
        if sp > hi || sp < lo {
            let n = crate::rt::native::put;
            n(2, "morestack: SP outside the G's stack: sp=");
            crate::rt::native::put_u64(2, sp as u64);
            n(2, " lo=");
            crate::rt::native::put_u64(2, lo as u64);
            n(2, " hi=");
            crate::rt::native::put_u64(2, hi as u64);
            n(2, " g=");
            crate::rt::native::put_u64(2, g as u64);
            n(2, " m=");
            crate::rt::native::put_u64(2, (*g).m as u64);
            n(2, " m.cur=");
            crate::rt::native::put_u64(
                2,
                if (*g).m != 0 {
                    (*((*g).m as *mut M)).cur as u64
                } else {
                    0
                },
            );
            n(2, " status=");
            crate::rt::native::put_u64(2, (*g).status as u64);
            n(2, " sys=");
            crate::rt::native::put_u64(2, (*g).sys as u64);
            n(2, " old=");
            crate::rt::native::put_u64(2, (*g).old_stack as u64);
            n(2, "/");
            crate::rt::native::put_u64(2, (*g).old_size as u64);
            n(2, " stub fp=");
            crate::rt::native::put_u64(2, crate::rt::frame_address() as u64);
            n(2, "\n");
            crate::rt::native::fatal("morestack: the stub's SP is outside the G's stack");
        }
        let used = hi - sp;
        let mut size = hi - lo;
        // (NAVI_DEBUG=stackmove: a move the collector asked for shrinks too,
        // where shrink would: not in a blocked window nor on a callback's
        // stack.)
        if STACKMOVE
            && may_shrink
            && (*g).shrink != 0
            && size / 2 >= STACK
            && used + (*g).need + RED_ZONE + 4096 <= size / 4
        {
            return move_stack(g, size / 2);
        }
        if !(STACKMOVE && size >= used + (*g).need + RED_ZONE + 4096) {
            loop {
                size = size * 2;
                if size > MAX_STACK {
                    crate::rt::native::fatal("stack overflow");
                }
                if size >= used + (*g).need + RED_ZONE + 4096 {
                    break;
                }
            }
        }
        move_stack(g, size)
    }
}

// Moves the running G's stack to one half as large if what it uses (and
// what the entering function needs) takes at most half of that; how far.
fn shrink(g: *mut G) -> usize {
    unsafe {
        let size = ((*g).stack_hi - (*g).stack_lo) / 2;
        let used = (*g).stack_hi - (*g).entry_sp;
        if size < STACK
            || (*g).entry_sp > (*g).stack_hi
            || used + (*g).need + RED_ZONE + 4096 > size / 2
        {
            return 0;
        }
        move_stack(g, size)
    }
}

// Moves the running G's stack (from its stub's SP up) to a new one of size
// bytes; how far it moved.
fn move_stack(g: *mut G, size: usize) -> usize {
    unsafe {
        let lo = (*g).stack_lo;
        let hi = (*g).stack_hi;
        let sp = (*g).entry_sp;
        let used = hi - sp;
        let nlo = reserve(size);
        let nhi = nlo + size;
        let delta = nhi.wrapping_sub(hi);
        let nsp = sp.wrapping_add(delta);
        crate::rt::copy::<u8>(sp as *const u8, nsp as *mut u8, used);
        stack_mode();
        if STACKMAP == 1 {
            move_frames(sp, lo, hi, delta);
            if STACKCHECK {
                check_moved(nsp, nhi, lo, hi, delta);
            }
        } else {
            let mut p = nsp;
            while p < nhi {
                let w = *(p as *const usize);
                if w >= lo && w < hi {
                    *(p as *mut usize) = w.wrapping_add(delta);
                }
                p += 8;
            }
        }
        crate::rt::native::move_catches((*g).catch, lo, hi, delta);
        (*g).old_stack = lo;
        (*g).old_size = hi - lo;
        (*g).stack_lo = nlo;
        (*g).stack_hi = nhi;
        delta
    }
}

// Stacks move by their maps (as Go's adjustframe), not every word that
// looks like an address in the old stack (NAVI_DEBUG=stackcons does that).
static mut STACKMAP: usize = 0;
static mut STACKCHECK: bool = false;
// NAVI_DEBUG=stackmove (debugging the stack maps): every morestack of a
// spawned G using under 256 KiB of stack moves it, and the new limit is
// just below where it is, so nearly every deeper call moves it again.
static mut STACKMOVE: bool = false;

fn stack_mode() {
    if STACKMAP == 0 {
        STACKMAP = if crate::rt::native::debug_on("stackcons") {
            2
        } else {
            1
        };
        if crate::rt::native::debug_on("stackcheck") {
            STACKCHECK = true;
        }
        if crate::rt::native::debug_on("stackmove") {
            STACKMOVE = true;
        }
    }
}

// The word at old address a, in the copy.
fn mv_rd(a: usize, delta: usize) -> usize {
    unsafe { *(a.wrapping_add(delta) as *const usize) }
}

// How many words of its caller's outgoing area the function containing
// return address pc takes its parameters in, and which of them hold
// pointers (all of them past 64 words; ARGS_UNKNOWN: code without such a
// map, and the caller's area is taken conservatively).
fn arg_map(pc: usize) -> (usize, usize) {
    let a = ext_map(find_map(pc).0);
    if a == 0 {
        return (ARGS_UNKNOWN, 0);
    }
    unsafe { (*(a as *const usize), *((a + 8) as *const usize)) }
}

const ARGS_UNKNOWN: usize = 18446744073709551615;

// Where map m's words past its calls are (flag 4): the parameters' words and
// mask, then the result's (0: an older compiler's map, or none).
fn ext_map(m: usize) -> usize {
    if m == 0 {
        return 0;
    }
    unsafe {
        if *((m + 8) as *const usize) & 4 == 0 {
            return 0;
        }
        let nb = *((m + 24) as *const usize);
        let sv = m + 32 + 8 * nb;
        let ns = *(sv as *const usize);
        let calls = sv + 8 + 8 * ns;
        let n = *(calls as *const usize);
        calls + 8 + 8 * ((n + 1) / 2)
    }
}

// Moves the pointer words of a result being made at old address ret (in the
// old stack) by map m's result mask.
fn mv_result(m: usize, ret: usize, sp: usize, lo: usize, hi: usize, delta: usize) {
    let a = ext_map(m);
    if a == 0 || ret < sp || ret >= hi {
        return;
    }
    let (rw, rm) = unsafe { (*((a + 16) as *const usize), *((a + 24) as *const usize)) };
    let mut k = 0;
    while k < rw && ret + 8 * k < hi {
        if rw > 64 || (rm >> k as u32) & 1 != 0 {
            mv_adj(ret + 8 * k, lo, hi, delta);
        }
        k += 1;
    }
}

// Moves the word at old address a (in the copy) if it points into the old
// stack.
fn mv_adj(a: usize, lo: usize, hi: usize, delta: usize) {
    let p = a.wrapping_add(delta) as *mut usize;
    unsafe {
        let w = *p;
        if w >= lo && w < hi {
            *p = w.wrapping_add(delta);
        }
    }
}

// The stack map of the function containing return address pc and the
// function's start (0, 0 for code without one).
fn find_map(pc: usize) -> (usize, usize) {
    let tab = crate::rt::func_table();
    let (n, text, maps) = unsafe {
        (
            *(tab as *const usize),
            *((tab + 8) as *const usize),
            tab + *((tab + 16) as *const usize),
        )
    };
    if pc <= text {
        return (0, 0);
    }
    let at = pc - 1 - text;
    let mut lo = 0;
    let mut hi = n;
    while lo < hi {
        let mid = (lo + hi) / 2;
        let start = unsafe { *((tab + 24 + 12 * mid) as *const u32) } as usize;
        if start <= at {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    if lo == 0 {
        return (0, 0);
    }
    let e = tab + 24 + 12 * (lo - 1);
    let (start, size, mo) = unsafe {
        (
            *(e as *const u32) as usize,
            *((e + 4) as *const u32) as usize,
            *((e + 8) as *const u32) as usize,
        )
    };
    if at >= start + size {
        return (0, 0);
    }
    (maps + mo, text + start)
}

// Stack maps give return offsets in instruction units.
#[cfg(target_arch = "aarch64")]
const CODE_UNIT: usize = 4;
#[cfg(target_arch = "x86_64")]
const CODE_UNIT: usize = 1;

// The saved-register pointer mask of the call returning to offset ret in
// a function's map (all registers if the call is not listed).

fn call_mask(calls: usize, ret: usize) -> usize {
    // Entries of 4 bytes: (return offset / code unit) << 9 | mask.
    let n = unsafe { *(calls as *const usize) };
    let want = ret / CODE_UNIT;
    let mut lo = 0;
    let mut hi = n;
    while lo < hi {
        let mid = (lo + hi) / 2;
        let c = unsafe { *((calls + 8 + 4 * mid) as *const u32) } as usize;
        let r = c >> 9;
        if r == want {
            return c & 0x1ff;
        }
        if r < want {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    0x1ff
}

// Moves the pointers into the old stack [lo, hi) of the copy of [sp, hi)
// (delta away), frame by frame from the morestack stub's (sp) outward: the
// words each function's map marks, its saved registers as the caller's
// mask at the call says (the value of x19 + k a frame saved belongs to the
// next frame out that uses the register), the saved frame pointers, the
// arguments of the call in progress and the result it is making by the
// called function's map (as Go's adjustframe goes by the locals' and the
// arguments' maps). No word moves only because it looks like an address in
// the stack: one that is not a pointer would change. Code without a map
// (the runtime's hand-written routines): every word of its frame.
fn move_frames(sp: usize, lo: usize, hi: usize, delta: usize) {
    // The function that entered morestack: its result buffer (RET, saved by
    // the stub at sp + 64, before it is moved itself).
    mv_result(
        find_map(mv_rd(sp + 256 + 8, delta)).0,
        mv_rd(sp + 64, delta),
        sp,
        lo,
        hi,
        delta,
    );
    // The stub saved x0-x15 at sp, x19-x28 at sp + 128, x16-x17 at sp + 208;
    // at a function's entry only CTX (x0), RET (x8), LOC (x9) and the
    // saved registers hold values.
    mv_adj(sp, lo, hi, delta);
    mv_adj(sp + 64, lo, hi, delta);
    mv_adj(sp + 72, lo, hi, delta);
    let mut pend = [0usize; 9];
    let mut k = 0;
    while k < 9 {
        pend[k] = sp + 128 + 8 * k;
        k += 1;
    }
    // The stub's frame record, then the one the function entering it
    // pushed: its caller's frame pointer and return address.
    let s = sp + 256;
    mv_adj(s, lo, hi, delta);
    // The function that entered morestack (the stub returns into it): its
    // map says which words of its caller's outgoing area hold pointers.
    let (mut argw, mut argmask) = arg_map(mv_rd(s + 8, delta));
    let t = s + 16;
    let mut fp = mv_rd(t, delta);
    let mut pc = mv_rd(t + 8, delta);
    mv_adj(t, lo, hi, delta);
    let mut top = t + 16;
    while fp >= sp && fp < hi {
        let prev = mv_rd(fp, delta);
        let ret = mv_rd(fp + 8, delta);
        let (m, start) = find_map(pc);
        if m == 0 {
            let mut a = top;
            while a < fp {
                mv_adj(a, lo, hi, delta);
                a += 8;
            }
            argw = ARGS_UNKNOWN;
            argmask = 0;
            k = 0;
            while k < 9 {
                if pend[k] != 0 {
                    mv_adj(pend[k], lo, hi, delta);
                }
                pend[k] = 0;
                k += 1;
            }
        } else {
            let frame = unsafe { *(m as *const usize) };
            let flags = unsafe { *((m + 8) as *const usize) };
            // Its result buffer, by the RET its prologue saved (read before
            // the slot itself moves).
            mv_result(m, mv_rd(fp - 16, delta), sp, lo, hi, delta);
            let any = unsafe { *((m + 16) as *const usize) };
            let nb = unsafe { *((m + 24) as *const usize) };
            let fsp = fp - frame;
            // The bottom of the frame (the outgoing area and the buffers):
            // the arguments of the call in progress by the called function's
            // map. The rest holds nothing live across the call that the maps
            // do not describe: the result being made in the buffer is moved
            // by the called function's map (mv_result). A map an older
            // compiler made (no flag 4; the runtime's frames all bottom), or
            // a call into code without such a map: every word there that
            // looks like an address, as before.
            let exact = flags & 4 != 0;
            let mut w = 0;
            if exact && argw != ARGS_UNKNOWN {
                while w < argw && w < any {
                    if argw > 64 || (argmask >> w as u32) & 1 != 0 {
                        mv_adj(fsp + 8 * w, lo, hi, delta);
                    }
                    w += 1;
                }
            } else {
                while w < any {
                    mv_adj(fsp + 8 * w, lo, hi, delta);
                    w += 1;
                }
            }
            w = any;
            while w < frame / 8 {
                let i = w - any;
                let bits = unsafe { *((m + 32 + 8 * (i / 64)) as *const usize) };
                if (bits >> (i % 64) as u32) & 1 != 0 {
                    mv_adj(fsp + 8 * w, lo, hi, delta);
                }
                w += 1;
            }
            // This frame is the next one out's callee.
            let (naw, nam) = arg_map(pc);
            argw = naw;
            argmask = nam;
            let sv = m + 32 + 8 * nb;
            let ns = unsafe { *(sv as *const usize) };
            let mask = if !exact && flags & 1 != 0 {
                0x1ff
            } else {
                call_mask(sv + 8 + 8 * ns, pc - start)
            };
            let mut j = 0;
            while j < ns {
                let e = unsafe { *((sv + 8 + 8 * j) as *const usize) };
                let r = e >> 32;
                let off = (e & 0xffffffff) as u32 as i32 as i64 as usize;
                if pend[r] != 0 && (mask >> r as u32) & 1 != 0 {
                    mv_adj(pend[r], lo, hi, delta);
                }
                pend[r] = fp.wrapping_add(off);
                j += 1;
            }
        }
        mv_adj(fp, lo, hi, delta);
        top = fp + 16;
        fp = prev;
        pc = ret;
    }
    // Registers saved for frames outside the walk.
    k = 0;
    while k < 9 {
        if pend[k] != 0 {
            mv_adj(pend[k], lo, hi, delta);
        }
        k += 1;
    }
}

// NAVI_DEBUG=stackcheck: reports the words of the moved stack still pointing
// into the old one (a pointer a map missed, or an integer that looks like one).
fn check_moved(nsp: usize, nhi: usize, lo: usize, hi: usize, delta: usize) {
    // The frames of the new stack: (frame pointer, return address into the
    // frame's function), from the stub's record out.
    let mut fps = [0usize; 64];
    let mut pcs = [0usize; 64];
    let mut nf = 0;
    let mut r = nsp + 256 + 16;
    let mut fp = unsafe { *(r as *const usize) };
    let mut pc = unsafe { *((r + 8) as *const usize) };
    while fp >= nsp && fp < nhi && nf < 64 {
        fps[nf] = fp;
        pcs[nf] = pc;
        nf += 1;
        pc = unsafe { *((fp + 8) as *const usize) };
        fp = unsafe { *(fp as *const usize) };
    }
    let mut p = nsp;
    while p < nhi {
        let w = unsafe { *(p as *const usize) };
        if w >= lo && w < hi {
            let mut f = 0;
            while f < nf && fps[f] < p {
                f += 1;
            }
            crate::rt::native::put(2, "stack map missed: frame ");
            crate::rt::native::put_u64(2, f as u64);
            crate::rt::native::put(2, " pc ");
            crate::rt::native::put_u64(2, if f < nf { pcs[f] } else { 0 } as u64);
            crate::rt::native::put(2, " fp-");
            crate::rt::native::put_u64(2, if f < nf { fps[f] - p } else { 0 } as u64);
            crate::rt::native::put(2, " value at old fp-");
            let wf = if f + 1 < nf {
                fps[f + 1].wrapping_sub(delta).wrapping_sub(w)
            } else {
                0
            };
            crate::rt::native::put_u64(2, wf as u64);
            crate::rt::native::put(2, "\n");
        }
        p += 8;
    }
}

// Grows the stack now (if need be) so that a collection, which runs with
// the world stopped, has 256 KiB below the caller's frame (Go runs its
// collector on the system stack instead).
fn stack_headroom() {
    let mut pad = [0u64; 32768];
    let i = (crate::rt::stack_pointer() as usize >> 4) & 32767;
    pad[i] = 1;
    if pad[(i + 1) & 32767] != 0 {
        crate::rt::native::fatal("stack_headroom");
    }
}

// Grows the stack now if need be, so that a G's scan of its own stack has
// room (16 KiB below the caller's frame) without moving it.
fn scan_room() {
    let mut pad = [0u64; 2048];
    let i = (crate::rt::stack_pointer() as usize >> 4) & 2047;
    pad[i] = 1;
    if pad[(i + 1) & 2047] != 0 {
        crate::rt::native::fatal("scan_room");
    }
}

/// Stops every G running on another M (the collector holds the runtime
/// lock): each is asked to stop at its next function prologue (its stack
/// limit is made unreachable) or, if blocked outside navi code, claimed so
/// that it waits before running navi code again.
pub fn stop_the_world() {
    if !MULTI {
        return;
    }
    if crate::rt::native::debug_on("gcpoison") {
        crate::rt::gc::POISON_FREE = true;
    }
    let me = current();
    stack_headroom();
    STW_OWNER = me as usize;
    crate::rt::atomic_store(&mut STW as *mut usize, 1);
    // Every G on an M, whatever its status: a G changes its status before
    // it switches away (yield, park), and runs until its context is saved.
    let mut m = MS as *mut M;
    while m as usize != 0 {
        unsafe {
            let g = (*m).cur;
            if g as usize != 0 && g as usize != me as usize {
                (*g).poisoned = true;
                crate::rt::atomic_store(&mut (*g).guard as *mut usize, 18446744073709551615);
            }
            m = (*m).next;
        }
    }
    loop {
        let mut waiting = 0;
        m = MS as *mut M;
        while m as usize != 0 {
            unsafe {
                let g = (*m).cur;
                if g as usize != 0 && g as usize != me as usize {
                    let st = crate::rt::atomic_load(&mut (*g).sys as *mut usize);
                    // (One a marker is scanning goes back to blocked, then is
                    // claimed: else it could go on running once the marker
                    // lets it go.)
                    if st == SYS_RUNNING || st == SYS_SCANNING {
                        waiting += 1;
                    } else if st == SYS_BLOCKED {
                        if !crate::rt::atomic_cas(
                            &mut (*g).sys as *mut usize,
                            SYS_BLOCKED,
                            SYS_CLAIMED,
                        ) {
                            waiting += 1;
                        }
                    }
                }
                m = (*m).next;
            }
        }
        if waiting == 0 {
            crate::rt::atomic_store(&mut STOPPED_ALL as *mut usize, 1);
            return;
        }
        unsafe {
            os_yield();
        }
    }
}

// Whether every G has stopped (stop_the_world returned); a stray allocation
// was reported (see check_alloc_stopped).
static mut STOPPED_ALL: usize = 0;
static mut REPORTED: usize = 0;

/// NAVI_DEBUG=gcverify: a new span while the world is stopped for another G
/// (something runs that should not) prints that G and its return
/// addresses (tools/symbolize.py names them).
pub fn check_alloc_stopped() {
    // (Once the world has stopped: until then the others run on.)
    if crate::rt::atomic_load(&mut STOPPED_ALL as *mut usize) == 0 {
        return;
    }
    let g = current();
    if g as usize == STW_OWNER {
        return;
    }
    if !crate::rt::atomic_cas(&mut REPORTED as *mut usize, 0, 1) {
        return;
    }
    crate::rt::native::put(2, "a span made while the world is stopped, by G ");
    crate::rt::native::put_hex(2, g as u64);
    if g as usize != 0 && unsafe { (*g).is_g0 } {
        crate::rt::native::put(2, " (an M's scheduler record)");
    }
    crate::rt::native::put(2, "; the collector is ");
    crate::rt::native::put_hex(2, STW_OWNER as u64);
    crate::rt::native::put(2, "\nreturn addresses:");
    let mut fp = crate::rt::frame_address() as usize;
    let mut k = 0;
    while k < 12 && fp != 0 {
        let ret = unsafe { *((fp + 8) as *const usize) };
        crate::rt::native::put(2, " ");
        crate::rt::native::put_hex(2, ret as u64);
        let up = unsafe { *(fp as *const usize) };
        if up <= fp {
            break;
        }
        fp = up;
        k += 1;
    }
    crate::rt::native::put(2, "\nmstart at ");
    crate::rt::native::put_hex(2, crate::rt::mstart_address() as u64);
    crate::rt::native::put(2, "\n");
}

/// Each M's current G, its status and state for the collector, and the
/// running G (debugging a stopped world).
pub fn dump_ms() {
    let me = current();
    let mut m = MS as *mut M;
    while m as usize != 0 {
        unsafe {
            let g = (*m).cur;
            crate::rt::native::put(2, "M ");
            crate::rt::native::put_hex(2, m as u64);
            crate::rt::native::put(2, " cur ");
            crate::rt::native::put_hex(2, g as u64);
            if g as usize != 0 {
                crate::rt::native::put(2, " status ");
                crate::rt::native::put_u64(2, (*g).status as u64);
                crate::rt::native::put(2, " sys ");
                crate::rt::native::put_u64(2, (*g).sys as u64);
                crate::rt::native::put(2, " cb_prev ");
                crate::rt::native::put_hex(2, (*g).cb_prev as u64);
            }
            if g as usize == me as usize {
                crate::rt::native::put(2, " (the collector)");
            }
            crate::rt::native::put(2, "\n");
            m = (*m).next;
        }
    }
}

/// Lets the stopped Gs run again.
pub fn start_the_world() {
    if !MULTI {
        return;
    }
    crate::rt::atomic_store(&mut STOPPED_ALL as *mut usize, 0);
    let me = current();
    let mut m = MS as *mut M;
    while m as usize != 0 {
        unsafe {
            let g = (*m).cur;
            if g as usize != 0 && g as usize != me as usize {
                if (*g).poisoned {
                    (*g).poisoned = false;
                    crate::rt::atomic_store(
                        &mut (*g).guard as *mut usize,
                        if (*g).shrink != 0 {
                            POISON
                        } else {
                            (*g).stack_lo + RED_ZONE
                        },
                    );
                }
                crate::rt::atomic_cas(&mut (*g).sys as *mut usize, SYS_CLAIMED, SYS_BLOCKED);
            }
            m = (*m).next;
        }
    }
    crate::rt::atomic_store(&mut STW as *mut usize, 0);
}
