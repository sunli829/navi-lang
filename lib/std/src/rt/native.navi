//! Native implementations of the runtime intrinsics, used by the native
//! backends (the interpreter implements the intrinsics in Go). The code
//! generator calls the function with the intrinsic's name; the simple ones
//! (size_of, slice and pointer primitives) are generated inline instead.
//!
//! Single-threaded for now (green threads arrive in M6).

#[cfg(not(target_os = "windows"))]
extern "C" {
    #[link_name = "write"]
    fn c_write(fd: i32, buf: *const u8, n: usize) -> isize;
}

#[cfg(target_os = "windows")]
extern "C" {
    #[link_name = "_write"]
    fn c_write(fd: i32, buf: *const u8, n: u32) -> i32;
}

extern "C" {
    #[link_name = "exit"]
    fn c_exit(code: i32) -> !;
    fn memmove(dst: *mut u8, src: *const u8, n: usize) -> *mut u8;
}

pub fn alloc(size: usize, align: usize) -> *mut u8 {
    crate::rt::gc::alloc(size, false)
}

pub fn alloc_array<T>(n: usize) -> *mut T {
    crate::rt::gc::alloc(n * crate::intrinsics::size_of::<T>(), !crate::rt::has_pointers::<T>()) as *mut T
}

/// Allocation entry point of generated code (cells, closure environments,
/// defer records).
pub fn gc_alloc(size: usize, noscan: bool) -> *mut u8 {
    crate::rt::gc::alloc(size, noscan)
}

pub fn copy<T>(src: *const T, dst: *mut T, n: usize) {
    unsafe { memmove(dst as *mut u8, src as *const u8, n * crate::intrinsics::size_of::<T>()); }
}

#[cfg(not(target_os = "windows"))]
pub fn write(fd: i32, p: *const u8, n: usize) {
    unsafe { c_write(fd, p, n); }
}

#[cfg(target_os = "windows")]
pub fn write(fd: i32, p: *const u8, n: usize) {
    unsafe { c_write(fd, p, n as u32); }
}

pub fn exit(code: i32) -> ! {
    unsafe { c_exit(code) }
}

fn put(fd: i32, s: &str) { write(fd, s.as_ptr(), s.len()); }

fn put_u64(fd: i32, v: u64) {
    let mut buf = [0u8; 20];
    let mut n = 20;
    let mut x = v;
    loop {
        n -= 1;
        buf[n] = b'0' + (x % 10) as u8;
        x = x / 10;
        if x == 0 { break; }
    }
    write(fd, crate::rt::ptr_offset(&buf as *const [u8; 20] as *const u8, n), 20 - n);
}

fn put_u32(fd: i32, v: u32) { put_u64(fd, v as u64); }

fn panic_header(file: &str, line: u32, col: u32) {
    if crate::rt::sched::is_main() {
        put(2, "thread 'main' panicked at ");
    } else {
        put(2, "thread '<unnamed>' panicked at ");
    }
    put(2, file);
    put(2, ":");
    put_u32(2, line);
    put(2, ":");
    put_u32(2, col);
    put(2, ":\n");
}

/// Runs the deferred calls of every frame on the stack, innermost first
/// (a panic unwinding to the top: there is no catch_unwind yet).
fn unwind() {
    let top = crate::rt::stack_top() as usize;
    let mut fp = crate::rt::frame_address() as usize;
    while fp != 0 && fp != top {
        let slot = (fp - 32) as *mut usize;
        unsafe {
            let head = *slot;
            if head != 0 {
                *slot = 0;
                crate::rt::run_defers(head as *mut u8);
            }
            fp = *(fp as *const usize);
        }
    }
}

static mut PANICKING: bool = false;

pub fn panic_raw(msg: &str, file: &str, line: u32, col: u32) -> ! {
    if !PANICKING {
        PANICKING = true;
        unwind();
    }
    panic_header(file, line, col);
    put(2, msg);
    put(2, "\n");
    exit(101)
}

/// Called by generated code when a bounds check fails.
pub fn panic_bounds(len: usize, index: usize, file: &str, line: u32, col: u32) -> ! {
    if !PANICKING {
        PANICKING = true;
        unwind();
    }
    panic_header(file, line, col);
    put(2, "index out of bounds: the len is ");
    put_u64(2, len as u64);
    put(2, " but the index is ");
    put_u64(2, index as u64);
    put(2, "\n");
    exit(101)
}

/// Reports a fatal runtime error and exits.
pub fn fatal(msg: &str) -> ! {
    put(2, "fatal error: ");
    put(2, msg);
    put(2, "\n");
    exit(2)
}

pub fn spawn<T>(f: fn() -> T) -> *mut u8 {
    let mut slot: Option<T> = None;
    let cell = &mut slot;
    let h = crate::rt::sched::new_handle(cell as *mut Option<T> as *mut u8);
    crate::rt::sched::go(|| {
        *cell = Some(f());
        crate::rt::sched::finish(h);
    });
    h as *mut u8
}

pub fn join<T>(h: *mut u8) -> T {
    let cell = crate::rt::sched::join(h as *mut crate::rt::sched::Handle) as *mut Option<T>;
    match unsafe { *cell } {
        Some(v) => v,
        None => fatal("joined thread has no result"),
    }
}

pub fn yield_now() { crate::rt::sched::yield_now(); }

pub fn chan_new<T>(cap: usize) -> *mut u8 {
    let write_result = |slot: *mut u8, src: *const u8| {
        let r: Result<T, crate::sync::mpmc::RecvError> =
            if src as usize == 0 { Err(crate::sync::mpmc::RecvError) } else { Ok(unsafe { *(src as *const T) }) };
        unsafe { *(slot as *mut Result<T, crate::sync::mpmc::RecvError>) = r; }
    };
    crate::rt::sched::new_chan(crate::intrinsics::size_of::<T>(), cap, write_result) as *mut u8
}

pub fn chan_send<T>(c: *mut u8, v: T) -> bool {
    let mut tmp = v;
    let cell = &mut tmp;
    crate::rt::sched::send(c as *mut crate::rt::sched::Chan, cell as *mut T as *const u8)
}

fn recv_typed<T>(c: *mut u8, block: bool) -> Option<T> {
    let n = crate::intrinsics::size_of::<T>();
    let buf = crate::rt::gc::alloc(if n == 0 { 1 } else { n }, false);
    if crate::rt::sched::recv(c as *mut crate::rt::sched::Chan, buf, block) {
        Some(unsafe { *(buf as *const T) })
    } else {
        None
    }
}

pub fn chan_recv<T>(c: *mut u8) -> Option<T> { recv_typed::<T>(c, true) }
pub fn chan_try_recv<T>(c: *mut u8) -> Option<T> { recv_typed::<T>(c, false) }
pub fn chan_close(c: *mut u8) { crate::rt::sched::close(c as *mut crate::rt::sched::Chan); }
pub fn chan_closed(c: *mut u8) -> bool { crate::rt::sched::closed(c as *mut crate::rt::sched::Chan) }
pub fn select_cases(cases: &[crate::sync::mpmc::SelectCase], has_default: bool) -> usize {
    crate::rt::sched::run_select(cases, has_default)
}

/// The scheduler's entry points used by generated code.
pub fn sched_init() -> usize { crate::rt::sched::init() }
pub fn gmain() -> ! { crate::rt::sched::gmain() }

pub fn fmt_float(x: f64, prec: usize, has_prec: bool, style: u8, buf: *mut u8) -> usize {
    crate::rt::float::format(x, prec, has_prec, style, buf)
}
