//! Native implementations of the runtime intrinsics, used by the native
//! backends (the interpreter implements the intrinsics in Go). The code
//! generator calls the function with the intrinsic's name; the simple ones
//! (size_of, slice and pointer primitives) are generated inline instead.
//!
//! M3: single-threaded, memory is never freed (the GC arrives in M4),
//! panics exit the process without running defers of other frames.

extern "C" {
    fn calloc(n: usize, size: usize) -> *mut u8;
    #[link_name = "write"]
    fn c_write(fd: i32, buf: *const u8, n: usize) -> isize;
    #[link_name = "exit"]
    fn c_exit(code: i32) -> !;
    fn memmove(dst: *mut u8, src: *const u8, n: usize) -> *mut u8;
}

pub fn alloc(size: usize, align: usize) -> *mut u8 {
    unsafe { calloc(1, if size == 0 { 1 } else { size }) }
}

pub fn alloc_array<T>(n: usize) -> *mut T {
    alloc(n * crate::intrinsics::size_of::<T>(), 8) as *mut T
}

pub fn copy<T>(src: *const T, dst: *mut T, n: usize) {
    unsafe { memmove(dst as *mut u8, src as *const u8, n * crate::intrinsics::size_of::<T>()); }
}

pub fn write(fd: i32, p: *const u8, n: usize) {
    unsafe { c_write(fd, p, n); }
}

pub fn exit(code: i32) -> ! {
    unsafe { c_exit(code) }
}

fn put(fd: i32, s: &str) { write(fd, s.as_ptr(), s.len()); }

fn put_u64(fd: i32, v: u64) {
    let mut buf = [0u8; 20];
    let mut n = 20;
    let mut x = v;
    loop {
        n -= 1;
        buf[n] = b'0' + (x % 10) as u8;
        x = x / 10;
        if x == 0 { break; }
    }
    write(fd, crate::rt::ptr_offset(&buf as *const [u8; 20] as *const u8, n), 20 - n);
}

fn put_u32(fd: i32, v: u32) { put_u64(fd, v as u64); }

fn panic_header(file: &str, line: u32, col: u32) {
    put(2, "thread 'main' panicked at ");
    put(2, file);
    put(2, ":");
    put_u32(2, line);
    put(2, ":");
    put_u32(2, col);
    put(2, ":\n");
}

pub fn panic_raw(msg: &str, file: &str, line: u32, col: u32) -> ! {
    panic_header(file, line, col);
    put(2, msg);
    put(2, "\n");
    exit(101)
}

/// Called by generated code when a bounds check fails.
pub fn panic_bounds(len: usize, index: usize, file: &str, line: u32, col: u32) -> ! {
    panic_header(file, line, col);
    put(2, "index out of bounds: the len is ");
    put_u64(2, len as u64);
    put(2, " but the index is ");
    put_u64(2, index as u64);
    put(2, "\n");
    exit(101)
}

fn unsupported(what: &str) -> ! {
    panic_raw(what, "<runtime>", 0, 0)
}

pub fn spawn<T>(f: fn() -> T) -> *mut u8 { unsupported("threads are not supported in native code yet (M6)") }
pub fn join<T>(h: *mut u8) -> T { unsupported("threads are not supported in native code yet (M6)") }
pub fn yield_now() {}
pub fn chan_new<T>(cap: usize) -> *mut u8 { unsupported("channels are not supported in native code yet (M6)") }
pub fn chan_send<T>(c: *mut u8, v: T) -> bool { unsupported("channels are not supported in native code yet (M6)") }
pub fn chan_recv<T>(c: *mut u8) -> Option<T> { unsupported("channels are not supported in native code yet (M6)") }
pub fn chan_try_recv<T>(c: *mut u8) -> Option<T> { unsupported("channels are not supported in native code yet (M6)") }
pub fn chan_close(c: *mut u8) { unsupported("channels are not supported in native code yet (M6)") }
pub fn chan_closed(c: *mut u8) -> bool { unsupported("channels are not supported in native code yet (M6)") }
pub fn select_cases(cases: &[crate::sync::mpmc::SelectCase], has_default: bool) -> usize { unsupported("select is not supported in native code yet (M6)") }

pub fn fmt_float(x: f64, prec: usize, has_prec: bool, style: u8, buf: *mut u8) -> usize {
    crate::rt::float::format(x, prec, has_prec, style, buf)
}
