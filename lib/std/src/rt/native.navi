//! Native implementations of the runtime intrinsics, used by the native
//! backends (the interpreter implements the intrinsics in Go). The code
//! generator calls the function with the intrinsic's name; the simple ones
//! (size_of, slice and pointer primitives) are generated inline instead.
//!
//! Single-threaded for now (green threads arrive in M6).

#[cfg(not(target_os = "windows"))]
extern "C" {
    #[link_name = "write"]
    fn c_write(fd: i32, buf: *const u8, n: usize) -> isize;
}

#[cfg(target_os = "windows")]
extern "C" {
    #[link_name = "_write"]
    fn c_write(fd: i32, buf: *const u8, n: u32) -> i32;
}

#[nonblocking]
extern "C" {
    #[link_name = "exit"]
    fn c_exit(code: i32) -> !;
    fn memmove(dst: *mut u8, src: *const u8, n: usize) -> *mut u8;
    fn calloc(n: usize, size: usize) -> *mut u8;
    fn free(p: *mut u8);
}

pub fn alloc(size: usize, align: usize) -> *mut u8 {
    crate::rt::gc::alloc(size, false)
}

pub fn alloc_array<T>(n: usize) -> *mut T {
    crate::rt::gc::alloc(n * crate::intrinsics::size_of::<T>(), !crate::rt::has_pointers::<T>()) as *mut T
}

/// Allocation entry point of generated code (cells, closure environments,
/// defer records).
pub fn gc_alloc(size: usize, noscan: bool) -> *mut u8 {
    crate::rt::gc::alloc(size, noscan)
}

/// scan_bits for a compiler that does not generate it (a bootstrap).
pub fn scan_bits(p: usize, m0: usize, arena: usize, next: usize, pages: usize, offs: usize) -> usize {
    let mut m = m0;
    let mut a = p;
    while m != 0 {
        if m & 1 != 0 {
            let r = crate::rt::scan_words(a, a + 8, arena, next, pages, offs);
            if r != 0 { return r; }
        }
        m = m >> 1;
        a += 8;
    }
    0
}

/// Allocation entry point of generated code for values whose pointer words
/// it knows: mask's bits, a type tw words long (repeated: an array).
pub fn gc_alloc_typed(size: usize, mask: usize, tw: usize) -> *mut u8 {
    crate::rt::gc::alloc_typed(size, mask, tw)
}

/// The same for n elements of such a value (alloc_array).
pub fn gc_alloc_array(size: usize, mask: usize, tw: usize) -> *mut u8 {
    crate::rt::gc::alloc_array_typed(size, mask, tw)
}

pub fn copy<T>(src: *const T, dst: *mut T, n: usize) {
    let bytes = n * crate::intrinsics::size_of::<T>();
    // A mark can only start at a prologue: none between the test and the
    // copy.
    if !crate::rt::has_pointers::<T>() || !crate::rt::gc::marking() {
        unsafe { memmove(dst as *mut u8, src as *const u8, bytes); }
        return;
    }
    // The barrier of a concurrent mark (as the generated code's): the
    // pointers overwritten and those copied are shaded; the G does not stop
    // in between.
    crate::rt::sched::preempt_off();
    crate::rt::gc::shade_range(dst as usize, bytes);
    unsafe { memmove(dst as *mut u8, src as *const u8, bytes); }
    crate::rt::gc::shade_range(dst as usize, bytes);
    crate::rt::sched::preempt_on();
}

// Writes may block (pipes, terminals): c_write is not #[nonblocking], so a
// collector on another OS thread proceeds meanwhile.
#[cfg(not(target_os = "windows"))]
pub fn write(fd: i32, p: *const u8, n: usize) {
    unsafe { c_write(fd, p, n); }
}

// Windows: to a console as UTF-16 (WriteConsoleW, as Rust's std): a
// console shows bytes as characters of its code page.
#[cfg(target_os = "windows")]
pub fn write(fd: i32, p: *const u8, n: usize) {
    if fd == 1 || fd == 2 {
        let h = unsafe { GetStdHandle((-10 - fd) as u32) };
        let mut mode = 0u32;
        if unsafe { GetConsoleMode(h, &mut mode as *mut u32) } != 0 {
            write_console(h, p, n);
            return;
        }
    }
    unsafe { c_write(fd, p, n as u32); }
}

#[cfg(target_os = "windows")]
extern "C" {
    fn WriteConsoleW(h: usize, buf: *const u16, n: u32, written: *mut u32, reserved: usize) -> i32;
}

#[cfg(target_os = "windows")]
#[nonblocking]
extern "C" {
    fn GetStdHandle(n: u32) -> usize;
    fn GetConsoleMode(h: usize, mode: *mut u32) -> i32;
}

// The UTF-8 bytes p[0..n] to console h, in pieces of up to 512 units
// (invalid or cut sequences as U+FFFD). The units are in C memory (a local
// array passed by address would be a heap cell: this prints fatal errors,
// on scheduler records too).
#[cfg(target_os = "windows")]
fn write_console(h: usize, p: *const u8, n: usize) {
    let buf = unsafe { calloc(514, 2) } as *mut u16;
    let mut k = 0;
    let mut i = 0;
    while i < n {
        let b0 = unsafe { *crate::rt::ptr_offset(p, i) } as u32;
        let len = if b0 < 0x80 { 1 } else if b0 >> 5 == 6 { 2 } else if b0 >> 4 == 14 { 3 } else if b0 >> 3 == 30 { 4 } else { 0 };
        let mut c = 0xFFFDu32;
        let mut used = 1;
        if len == 1 {
            c = b0;
        } else if len > 1 && i + len <= n {
            let mut v = b0 & (0x7F >> len);
            let mut ok = true;
            let mut j = 1;
            while j < len {
                let b = unsafe { *crate::rt::ptr_offset(p, i + j) } as u32;
                if b >> 6 != 2 { ok = false; }
                v = v << 6 | (b & 0x3F);
                j += 1;
            }
            if ok && v <= 0x10FFFF && !(v >= 0xD800 && v < 0xE000) {
                c = v;
                used = len;
            }
        }
        i += used;
        if c >= 0x10000 {
            unsafe {
                *buf.add(k) = (0xD800 + ((c - 0x10000) >> 10)) as u16;
                *buf.add(k + 1) = (0xDC00 + ((c - 0x10000) & 0x3FF)) as u16;
            }
            k += 2;
        } else {
            unsafe { *buf.add(k) = c as u16; }
            k += 1;
        }
        if k >= 510 {
            console_out(h, buf, k);
            k = 0;
        }
    }
    if k > 0 { console_out(h, buf, k); }
    unsafe { free(buf as *mut u8); }
}

#[cfg(target_os = "windows")]
fn console_out(h: usize, buf: *mut u16, n: usize) {
    let mut done = 0;
    // (The count written: C memory, the 2 units after the buffer's 512.)
    let w = unsafe { buf.add(512) } as *mut u32;
    while done < n {
        unsafe { *w = 0; }
        let ok = unsafe { WriteConsoleW(h, crate::rt::ptr_offset(buf as *const u16, done), (n - done) as u32, w, 0) };
        if ok == 0 || unsafe { *w } == 0 { return; }
        done += unsafe { *w } as usize;
    }
}

pub fn exit(code: i32) -> ! {
    unsafe { c_exit(code) }
}

pub fn put(fd: i32, s: &str) { write(fd, s.as_ptr(), s.len()); }

// The digits go to C memory: a local array whose address write gets would
// be a heap cell, and these print on scheduler records and while the world
// is stopped, where nothing may allocate.
pub fn put_u64(fd: i32, v: u64) {
    let buf = unsafe { calloc(1, 32) } as usize;
    let mut n = 20;
    let mut x = v;
    loop {
        n -= 1;
        unsafe { *((buf + n) as *mut u8) = b'0' + (x % 10) as u8; }
        x = x / 10;
        if x == 0 { break; }
    }
    write(fd, (buf + n) as *const u8, 20 - n);
    unsafe { free(buf as *mut u8); }
}

pub fn put_hex(fd: i32, v: u64) {
    let buf = unsafe { calloc(1, 32) } as usize;
    let mut n = 18;
    let mut x = v;
    loop {
        n -= 1;
        let d = (x & 15) as u8;
        unsafe { *((buf + n) as *mut u8) = if d < 10 { b'0' + d } else { b'a' + d - 10 }; }
        x = x >> 4;
        if x == 0 { break; }
    }
    n -= 2;
    unsafe {
        *((buf + n) as *mut u8) = b'0';
        *((buf + n + 1) as *mut u8) = b'x';
    }
    write(fd, (buf + n) as *const u8, 18 - n);
    unsafe { free(buf as *mut u8); }
}

fn put_u32(fd: i32, v: u32) { put_u64(fd, v as u64); }

fn panic_header(file: &str, line: u32, col: u32) {
    if crate::rt::sched::is_main() {
        put(2, "thread 'main' panicked at ");
    } else {
        put(2, "thread '<unnamed>' panicked at ");
    }
    put(2, file);
    put(2, ":");
    put_u32(2, line);
    put(2, ":");
    put_u32(2, col);
    put(2, ":\n");
}

/// Runs the deferred calls of every frame on the stack, innermost first,
/// up to the frame stop (exclusive; 0: the whole stack).
fn unwind(stop: usize) {
    let top = crate::rt::stack_top() as usize;
    let mut fp = crate::rt::frame_address() as usize;
    while fp != 0 && fp != top && fp != stop {
        let slot = (fp - 32) as *mut usize;
        unsafe {
            let head = *slot;
            if head != 0 {
                *slot = 0;
                crate::rt::run_defers(head as *mut u8);
            }
            fp = *(fp as *const usize);
        }
    }
}

/// A catch_unwind in progress (allocated by try_call, linked from the G).
struct CatchRec {
    buf: [usize; 13],
    prev: usize,
    fp: usize,
    payload: usize,
}

/// Moves what the catch_unwind records from first on hold of a stack
/// [lo, hi) that moved by delta (see sched::grow).
pub fn move_catches(first: usize, lo: usize, hi: usize, delta: usize) {
    let mut r = first as *mut CatchRec;
    while r as usize != 0 {
        unsafe {
            if (*r).fp >= lo && (*r).fp < hi { (*r).fp = (*r).fp.wrapping_add(delta); }
            let mut i = 0;
            while i < 13 {
                let w = (*r).buf[i];
                if w >= lo && w < hi { (*r).buf[i] = w.wrapping_add(delta); }
                i += 1;
            }
            r = (*r).prev as *mut CatchRec;
        }
    }
}

/// Calls f; a panic in f unwinds (running defers) back here and its
/// payload is returned.
pub fn try_call(f: fn()) -> *mut u8 {
    let rec = crate::rt::gc::alloc(crate::intrinsics::size_of::<CatchRec>(), false) as *mut CatchRec;
    unsafe {
        (*rec).prev = crate::rt::sched::catch_top();
        (*rec).fp = crate::rt::frame_address() as usize;
        crate::rt::sched::set_catch_top(rec as usize);
        if crate::rt::save_context(&mut (*rec).buf as *mut [usize; 13] as *mut usize) == 0 {
            f();
            crate::rt::sched::set_catch_top((*rec).prev);
            return 0 as *mut u8;
        }
        // Resumed by throw: rec is unchanged since save_context.
        crate::rt::sched::set_catch_top((*rec).prev);
        (*rec).payload as *mut u8
    }
}

/// Unwinds to the innermost catch_unwind with payload p.
fn throw(p: *mut u8) -> ! {
    let rec = crate::rt::sched::catch_top() as *mut CatchRec;
    unsafe {
        (*rec).payload = p as usize;
        unwind((*rec).fp);
        crate::rt::resume_context(&mut (*rec).buf as *mut [usize; 13] as *mut usize, 1)
    }
}

static mut PANICKING: bool = false;

pub fn panic_raw(msg: &str, file: &str, line: u32, col: u32) -> ! {
    panic_header(file, line, col);
    put(2, msg);
    put(2, "\n");
    if crate::rt::sched::catch_top() != 0 { throw(crate::panic::new_payload(msg, file, line, col)); }
    if !PANICKING {
        PANICKING = true;
        unwind(0);
    }
    exit(101)
}

/// Called by generated code when a bounds check fails.
pub fn panic_bounds(len: usize, index: usize, file: &str, line: u32, col: u32) -> ! {
    panic_header(file, line, col);
    put(2, "index out of bounds: the len is ");
    put_u64(2, len as u64);
    put(2, " but the index is ");
    put_u64(2, index as u64);
    put(2, "\n");
    if crate::rt::sched::catch_top() != 0 { throw(crate::panic::bounds_payload(len, index, file, line, col)); }
    if !PANICKING {
        PANICKING = true;
        unwind(0);
    }
    exit(101)
}

/// Reports a fatal runtime error and exits.
pub fn fatal(msg: &str) -> ! {
    put(2, "fatal error: ");
    put(2, msg);
    put(2, "\n");
    exit(2)
}

pub fn spawn<T>(f: fn() -> T) -> *mut u8 {
    let mut slot: Option<T> = None;
    let cell = &mut slot;
    let h = crate::rt::sched::new_handle(cell as *mut Option<T> as *mut u8);
    crate::rt::sched::go(|| {
        *cell = Some(f());
        crate::rt::sched::finish(h);
    });
    h as *mut u8
}

pub fn join<T>(h: *mut u8) -> T {
    let cell = crate::rt::sched::join(h as *mut crate::rt::sched::Handle) as *mut Option<T>;
    match unsafe { *cell } {
        Some(v) => v,
        None => fatal("joined thread has no result"),
    }
}

pub fn yield_now() { crate::rt::sched::yield_now(); }

pub fn chan_new<T>(cap: usize) -> *mut u8 {
    let write_result = |slot: *mut u8, src: *const u8| {
        let r: Result<T, crate::sync::mpmc::RecvError> =
            if src as usize == 0 { Err(crate::sync::mpmc::RecvError) } else { Ok(unsafe { *(src as *const T) }) };
        unsafe { *(slot as *mut Result<T, crate::sync::mpmc::RecvError>) = r; }
    };
    crate::rt::sched::new_chan(crate::intrinsics::size_of::<T>(), cap, write_result) as *mut u8
}

pub fn chan_send<T>(c: *mut u8, v: T) -> bool {
    let mut tmp = v;
    let cell = &mut tmp;
    crate::rt::sched::send(c as *mut crate::rt::sched::Chan, cell as *mut T as *const u8)
}

fn recv_typed<T>(c: *mut u8, block: bool) -> Option<T> {
    let n = crate::intrinsics::size_of::<T>();
    let buf = crate::rt::gc::alloc(if n == 0 { 1 } else { n }, false);
    if crate::rt::sched::recv(c as *mut crate::rt::sched::Chan, buf, block) {
        Some(unsafe { *(buf as *const T) })
    } else {
        None
    }
}

pub fn chan_recv<T>(c: *mut u8) -> Option<T> { recv_typed::<T>(c, true) }
pub fn chan_try_recv<T>(c: *mut u8) -> Option<T> { recv_typed::<T>(c, false) }
pub fn chan_close(c: *mut u8) { crate::rt::sched::close(c as *mut crate::rt::sched::Chan); }
pub fn chan_closed(c: *mut u8) -> bool { crate::rt::sched::closed(c as *mut crate::rt::sched::Chan) }
pub fn select_cases(cases: &[crate::sync::mpmc::SelectCase], has_default: bool) -> usize {
    crate::rt::sched::run_select(cases, has_default)
}

/// The scheduler's entry points used by generated code.
pub fn sched_init() -> usize { crate::rt::sched::init() }
pub fn gmain() -> ! { crate::rt::sched::gmain() }
/// A callback from C enters and leaves its callback G (navi; see
/// sched::cb_enter).
pub fn cb_enter(m: usize) { crate::rt::sched::cb_enter(m) }
pub fn cb_exit() { crate::rt::sched::cb_exit() }

/// The slow path of the stack check in every function prologue (navi):
/// the stack is really exhausted, or the collector asked the G to stop.
/// Called with the G's limit cleared.
pub fn morestack() -> usize { crate::rt::sched::morestack() }

/// The write barrier of generated code (navi), called while a concurrent
/// collection marks: marks what was just stored at [p, p + n). The G may
/// not stop between the store and the marking (a collection finishing then
/// would miss the stored pointer): the barrier made it non-preemptible.
pub fn gc_wb(p: usize, n: usize) {
    // The barrier incremented nopreempt before the call.
    crate::rt::gc::shade_range(p, n);
    crate::rt::sched::preempt_on();
}

/// The first navi code of a new OS thread (navi).
pub fn mstart() -> ! { crate::rt::sched::mstart() }

#[nonblocking]
extern "C" {
    fn floor(x: f64) -> f64;
    fn ceil(x: f64) -> f64;
    fn trunc(x: f64) -> f64;
    fn round(x: f64) -> f64;
    fn sqrt(x: f64) -> f64;
}

pub fn float_op(op: u8, x: f64) -> f64 {
    unsafe {
        if op == 0 { floor(x) } else if op == 1 { ceil(x) } else if op == 2 { trunc(x) } else if op == 3 { round(x) } else { sqrt(x) }
    }
}

pub fn fmt_float(x: f64, prec: usize, has_prec: bool, style: u8, buf: *mut u8) -> usize {
    crate::rt::float::format(x, prec, has_prec, style, buf)
}

// --- Operating system ------------------------------------------------------------

#[nonblocking]
extern "C" {
    fn getenv(name: *const u8) -> *const u8;
    fn fopen(path: *const u8, mode: *const u8) -> *mut u8;
    fn fclose(f: *mut u8) -> i32;
    fn remove(path: *const u8) -> i32;
}
// May block: calls count the G as blocked (see sched::enter_blocked).
extern "C" {
    fn system(cmd: *const u8) -> i32;
    fn fread(buf: *mut u8, size: usize, n: usize, f: *mut u8) -> usize;
    fn fwrite(buf: *const u8, size: usize, n: usize, f: *mut u8) -> usize;
}

#[cfg(not(target_os = "windows"))]
#[nonblocking]
extern "C" {
    fn opendir(path: *const u8) -> *mut u8;
    fn closedir(d: *mut u8) -> i32;
    fn mkdir(path: *const u8, mode: u32) -> i32;
}

#[cfg(target_os = "windows")]
#[nonblocking]
extern "C" {
    fn GetFileAttributesA(path: *const u8) -> u32;
    #[link_name = "_mkdir"]
    fn mkdir_win(path: *const u8) -> i32;
}

static mut ARGC: usize = 0;
static mut ARGV: usize = 0;

/// Called by the entry point with C's argc and argv.
pub fn set_args(argc: usize, argv: usize) {
    ARGC = argc;
    ARGV = argv;
    binary_stdio();
}

// Windows: the standard streams in binary mode, so that what is written
// is what arrives ("\n" stays "\n", as Go and Rust write).
#[cfg(target_os = "windows")]
#[nonblocking]
extern "C" {
    fn _setmode(fd: i32, mode: i32) -> i32;
}
#[cfg(target_os = "windows")]
fn binary_stdio() {
    let mut fd = 0;
    while fd < 3 {
        unsafe { _setmode(fd, 0x8000); }
        fd += 1;
    }
}
#[cfg(not(target_os = "windows"))]
fn binary_stdio() {}

// A NUL-terminated copy of s.
fn cstr(s: &str) -> *const u8 {
    let n = s.len();
    let p = crate::rt::gc::alloc(n + 1, true);
    crate::rt::copy::<u8>(s.as_ptr(), p, n);
    p as *const u8
}

// The string at a C pointer (not copied).
fn from_cstr(p: *const u8) -> &str {
    let mut n = 0;
    unsafe { while *crate::rt::ptr_offset(p, n) != 0 { n += 1; } }
    crate::rt::str_from_raw(p, n)
}

pub fn os_arg_count() -> usize { ARGC }

/// The initial environment (C's envp: it follows argv's terminating null
/// on Linux and macOS).
pub fn os_envp() -> usize { ARGV + 8 * (ARGC + 1) }

#[cfg(target_os = "macos")]
#[nonblocking]
extern "C" {
    fn clock_gettime_nsec_np(clock: u32) -> u64;
}

#[cfg(target_os = "macos")]
pub fn monotonic_nanos() -> u64 { unsafe { clock_gettime_nsec_np(4) } } // CLOCK_MONOTONIC_RAW

/// Nanoseconds since 1970-01-01 UTC (the system clock).
#[cfg(target_os = "macos")]
pub fn realtime_nanos() -> u64 { unsafe { clock_gettime_nsec_np(0) } } // CLOCK_REALTIME

#[cfg(target_os = "linux")]
pub fn realtime_nanos() -> u64 {
    let mut ts = [0i64; 2];
    unsafe { clock_gettime(0, &mut ts as *mut [i64; 2] as *mut i64); } // CLOCK_REALTIME
    (ts[0] as u64) * 1000000000 + ts[1] as u64
}

#[cfg(target_os = "windows")]
#[nonblocking]
extern "C" {
    fn GetSystemTimePreciseAsFileTime(ft: *mut u64);
}

// 100-ns intervals since 1601.
#[cfg(target_os = "windows")]
pub fn realtime_nanos() -> u64 {
    let mut ft = 0u64;
    unsafe { GetSystemTimePreciseAsFileTime(&mut ft as *mut u64); }
    (ft - 116444736000000000) * 100
}

#[cfg(target_os = "linux")]
#[nonblocking]
extern "C" {
    fn clock_gettime(clock: i32, ts: *mut i64) -> i32;
}

#[cfg(target_os = "linux")]
pub fn monotonic_nanos() -> u64 {
    let mut ts = [0i64; 2];
    unsafe { clock_gettime(1, &mut ts as *mut [i64; 2] as *mut i64); } // CLOCK_MONOTONIC
    (ts[0] as u64) * 1000000000 + ts[1] as u64
}

#[cfg(target_os = "windows")]
#[nonblocking]
extern "C" {
    fn QueryPerformanceCounter(c: *mut i64) -> i32;
    fn QueryPerformanceFrequency(f: *mut i64) -> i32;
}

#[cfg(target_os = "windows")]
pub fn monotonic_nanos() -> u64 {
    let mut c = 0i64;
    let mut f = 0i64;
    unsafe {
        QueryPerformanceCounter(&mut c as *mut i64);
        QueryPerformanceFrequency(&mut f as *mut i64);
    }
    let secs = (c / f) as u64;
    let rest = (c % f) as u64;
    secs * 1000000000 + rest * 1000000000 / f as u64
}

pub fn os_arg(i: usize) -> &str {
    let p = unsafe { *((ARGV + 8 * i) as *const *const u8) };
    from_cstr(p)
}

pub fn os_getenv(name: &str) -> Option<&str> {
    let p = unsafe { getenv(cstr(name)) };
    if p as usize == 0 { None } else { Some(from_cstr(p)) }
}

/// Whether the variable named by name (NUL-terminated) is set; does not
/// allocate (the collector asks).
pub fn env_set(name: &[u8]) -> bool { unsafe { getenv(name.as_ptr()) as usize != 0 } }

/// The variable named by name (NUL-terminated); does not allocate (the
/// runtime's threads and the allocator ask; os_getenv copies the name to
/// GC memory).
pub fn getenv_c(name: &[u8]) -> Option<&str> {
    let p = unsafe { getenv(name.as_ptr()) };
    if p as usize == 0 { None } else { Some(from_cstr(p)) }
}

pub fn os_system(cmd: &str) -> i32 {
    let c = cstr(cmd);
    let status = unsafe { system(c) };
    exit_code(status)
}

#[cfg(not(target_os = "windows"))]
fn exit_code(status: i32) -> i32 {
    // The wait status: exit code in bits 8-15, or the signal.
    if status & 127 == 0 { (status >> 8) & 255 } else { 128 + (status & 127) }
}

#[cfg(target_os = "windows")]
fn exit_code(status: i32) -> i32 { status }

pub fn fs_open(path: &str, mode: u8) -> usize {
    let m = if mode == 0 { "rb\0" } else if mode == 1 { "wb\0" } else { "ab\0" };
    unsafe { fopen(cstr(path), m.as_ptr()) as usize }
}

pub fn fs_read(h: usize, buf: *mut u8, n: usize) -> usize {
    let r = unsafe { fread(buf, 1, n, h as *mut u8) };
    r
}

pub fn fs_write(h: usize, buf: *const u8, n: usize) -> usize {
    let r = unsafe { fwrite(buf, 1, n, h as *mut u8) };
    r
}
pub fn fs_close(h: usize) { unsafe { fclose(h as *mut u8); } }
pub fn fs_remove(path: &str) -> bool { unsafe { remove(cstr(path)) == 0 } }

#[cfg(not(target_os = "windows"))]
pub fn fs_kind(path: &str) -> u8 {
    let c = cstr(path);
    let d = unsafe { opendir(c) };
    if d as usize != 0 {
        unsafe { closedir(d); }
        return 2;
    }
    let f = unsafe { fopen(c, "rb\0".as_ptr()) };
    if f as usize != 0 {
        unsafe { fclose(f); }
        return 1;
    }
    0
}

#[cfg(target_os = "windows")]
pub fn fs_kind(path: &str) -> u8 {
    let a = unsafe { GetFileAttributesA(cstr(path)) };
    if a == 4294967295 { 0 } else if a & 16 != 0 { 2 } else { 1 }
}

#[cfg(not(target_os = "windows"))]
pub fn fs_mkdir(path: &str) -> bool { unsafe { mkdir(cstr(path), 511) == 0 } }

#[cfg(target_os = "windows")]
pub fn fs_mkdir(path: &str) -> bool { unsafe { mkdir_win(cstr(path)) == 0 } }
