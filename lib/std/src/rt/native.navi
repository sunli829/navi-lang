//! Native implementations of the runtime intrinsics, used by the native
//! backends (the interpreter implements the intrinsics in Go). The code
//! generator calls the function with the intrinsic's name; the simple ones
//! (size_of, slice and pointer primitives) are generated inline instead.
//!
//! Single-threaded for now (green threads arrive in M6).

#[cfg(not(target_os = "windows"))]
extern "C" {
    #[link_name = "write"]
    fn c_write(fd: i32, buf: *const u8, n: usize) -> isize;
}

#[cfg(target_os = "windows")]
extern "C" {
    #[link_name = "_write"]
    fn c_write(fd: i32, buf: *const u8, n: u32) -> i32;
}

#[nonblocking]
extern "C" {
    #[link_name = "exit"]
    fn c_exit(code: i32) -> !;
    fn memmove(dst: *mut u8, src: *const u8, n: usize) -> *mut u8;
    fn calloc(n: usize, size: usize) -> *mut u8;
    fn realloc(p: *mut u8, size: usize) -> *mut u8;
    fn free(p: *mut u8);
}

pub fn alloc(size: usize, align: usize) -> *mut u8 {
    crate::rt::gc::alloc(size, false)
}

pub fn alloc_array<T>(n: usize) -> *mut T {
    crate::rt::gc::alloc(
        n * crate::intrinsics::size_of::<T>(),
        !crate::rt::has_pointers::<T>(),
    ) as *mut T
}

/// Allocation entry point of generated code (cells, closure environments,
/// defer records).
pub fn gc_alloc(size: usize, noscan: bool) -> *mut u8 {
    crate::rt::gc::alloc(size, noscan)
}

/// scan_heap for a compiler that does not generate it (a bootstrap).
pub fn scan_heap(
    p: usize,
    hi: usize,
    index: usize,
    nidx: usize,
    limit: usize,
    offs: usize,
) -> usize {
    let _ = (index, nidx, offs);
    let mut a = p;
    while a + 8 <= hi {
        let w = unsafe { *(a as *const usize) };
        a += 8;
        if crate::rt::gc::unmarked_at(w, limit) {
            return a;
        }
    }
    0
}

/// scan_heap_bits for a compiler that does not generate it (a bootstrap).
pub fn scan_heap_bits(
    p: usize,
    m0: usize,
    index: usize,
    nidx: usize,
    limit: usize,
    offs: usize,
) -> usize {
    let _ = (index, nidx, offs);
    let mut m = m0;
    let mut a = p;
    while m != 0 {
        if m & 1 != 0 && crate::rt::gc::unmarked_at(unsafe { *(a as *const usize) }, limit) {
            return a + 8;
        }
        m = m >> 1;
        a += 8;
    }
    0
}

/// Allocation entry point of generated code for values whose pointer words
/// it knows: mask's bits, a type tw words long (repeated: an array).
pub fn gc_alloc_typed(size: usize, mask: usize, tw: usize) -> *mut u8 {
    crate::rt::gc::alloc_typed(size, mask, tw)
}

/// The same for n elements of such a value (alloc_array).
pub fn gc_alloc_array(size: usize, mask: usize, tw: usize) -> *mut u8 {
    crate::rt::gc::alloc_array_typed(size, mask, tw)
}

pub fn copy<T>(src: *const T, dst: *mut T, n: usize) {
    let bytes = n * crate::intrinsics::size_of::<T>();
    // A mark can only start at a prologue: none between the test and the
    // copy.
    if !crate::rt::has_pointers::<T>() || !crate::rt::gc::marking() {
        unsafe {
            memmove(dst as *mut u8, src as *const u8, bytes);
        }
        return;
    }
    // The barrier of a concurrent mark (as the generated code's): the
    // pointers overwritten and those copied are shaded; the G does not stop
    // in between.
    crate::rt::sched::preempt_off();
    crate::rt::gc::shade_range(dst as usize, bytes);
    unsafe {
        memmove(dst as *mut u8, src as *const u8, bytes);
    }
    crate::rt::gc::shade_range(dst as usize, bytes);
    crate::rt::sched::preempt_on();
}

// Writes may block (pipes, terminals): c_write is not #[nonblocking], so a
// collector on another OS thread proceeds meanwhile.
#[cfg(not(target_os = "windows"))]
pub fn write(fd: i32, p: *const u8, n: usize) {
    unsafe {
        c_write(fd, p, n);
    }
}

// Windows: to a console as UTF-16 (WriteConsoleW, as Rust's std): a
// console shows bytes as characters of its code page.
#[cfg(target_os = "windows")]
pub fn write(fd: i32, p: *const u8, n: usize) {
    if fd == 1 || fd == 2 {
        let h = unsafe { GetStdHandle((-10 - fd) as u32) };
        let mut mode = 0u32;
        if unsafe { GetConsoleMode(h, &mut mode as *mut u32) } != 0 {
            write_console(h, p, n);
            return;
        }
    }
    unsafe {
        c_write(fd, p, n as u32);
    }
}

#[cfg(target_os = "windows")]
extern "C" {
    fn WriteConsoleW(h: usize, buf: *const u16, n: u32, written: *mut u32, reserved: usize) -> i32;
}

#[cfg(target_os = "windows")]
#[nonblocking]
extern "C" {
    fn GetStdHandle(n: u32) -> usize;
    fn GetConsoleMode(h: usize, mode: *mut u32) -> i32;
}

// The UTF-8 bytes p[0..n] to console h, in pieces of up to 512 units
// (invalid or cut sequences as U+FFFD). The units are in C memory (a local
// array passed by address would be a heap cell: this prints fatal errors,
// on scheduler records too).
#[cfg(target_os = "windows")]
fn write_console(h: usize, p: *const u8, n: usize) {
    let buf = unsafe { calloc(514, 2) } as *mut u16;
    let mut k = 0;
    let mut i = 0;
    while i < n {
        let b0 = unsafe { *crate::rt::ptr_offset(p, i) } as u32;
        let len = if b0 < 0x80 {
            1
        } else if b0 >> 5 == 6 {
            2
        } else if b0 >> 4 == 14 {
            3
        } else if b0 >> 3 == 30 {
            4
        } else {
            0
        };
        let mut c = 0xFFFDu32;
        let mut used = 1;
        if len == 1 {
            c = b0;
        } else if len > 1 && i + len <= n {
            let mut v = b0 & (0x7F >> len);
            let mut ok = true;
            let mut j = 1;
            while j < len {
                let b = unsafe { *crate::rt::ptr_offset(p, i + j) } as u32;
                if b >> 6 != 2 {
                    ok = false;
                }
                v = v << 6 | (b & 0x3F);
                j += 1;
            }
            if ok && v <= 0x10FFFF && !(v >= 0xD800 && v < 0xE000) {
                c = v;
                used = len;
            }
        }
        i += used;
        if c >= 0x10000 {
            unsafe {
                *buf.add(k) = (0xD800 + ((c - 0x10000) >> 10)) as u16;
                *buf.add(k + 1) = (0xDC00 + ((c - 0x10000) & 0x3FF)) as u16;
            }
            k += 2;
        } else {
            unsafe {
                *buf.add(k) = c as u16;
            }
            k += 1;
        }
        if k >= 510 {
            console_out(h, buf, k);
            k = 0;
        }
    }
    if k > 0 {
        console_out(h, buf, k);
    }
    unsafe {
        free(buf as *mut u8);
    }
}

#[cfg(target_os = "windows")]
fn console_out(h: usize, buf: *mut u16, n: usize) {
    let mut done = 0;
    // (The count written: C memory, the 2 units after the buffer's 512.)
    let w = unsafe { buf.add(512) } as *mut u32;
    while done < n {
        unsafe {
            *w = 0;
        }
        let ok = unsafe {
            WriteConsoleW(
                h,
                crate::rt::ptr_offset(buf as *const u16, done),
                (n - done) as u32,
                w,
                0,
            )
        };
        if ok == 0 || unsafe { *w } == 0 {
            return;
        }
        done += unsafe { *w } as usize;
    }
}

pub fn exit(code: i32) -> ! {
    unsafe { c_exit(code) }
}

pub fn put(fd: i32, s: &str) {
    write(fd, s.as_ptr(), s.len());
}

// --- Captured output (a test's, as Rust's harness captures) ---------------------
//
// C memory (written without allocating, so that panics anywhere can go
// there): a lock word, closed (1 once the test has ended: later output of
// threads it left goes to the standard streams), the bytes' address,
// length and capacity.

/// A new output capture (see sched::set_output_capture).
pub fn capture_new() -> usize {
    let c = unsafe { calloc(1, 40) } as usize;
    if c == 0 {
        fatal("out of memory");
    }
    c
}

// Appends n bytes at p to capture c; false if it is closed.
fn capture_write(c: usize, p: *const u8, n: usize) -> bool {
    let w = c as *mut usize;
    crate::rt::sched::obj_lock(w);
    let ok = unsafe { *w.add(1) == 0 };
    if ok {
        unsafe {
            let len = *w.add(3);
            let mut cap = *w.add(4);
            if len + n > cap {
                if cap < 256 {
                    cap = 256;
                }
                while len + n > cap {
                    cap = cap * 2;
                }
                let d = realloc(*w.add(2) as *mut u8, cap) as usize;
                if d == 0 {
                    fatal("out of memory");
                }
                *w.add(2) = d;
                *w.add(4) = cap;
            }
            memmove((*w.add(2) + len) as *mut u8, p, n);
            *w.add(3) = len + n;
        }
    }
    crate::rt::sched::obj_unlock(w);
    ok
}

/// Closes capture c and returns what it holds.
pub fn capture_take(c: usize) -> crate::string::String {
    let w = c as *mut usize;
    crate::rt::sched::obj_lock(w);
    let (d, n) = unsafe {
        *w.add(1) = 1;
        let r = (*w.add(2), *w.add(3));
        *w.add(2) = 0;
        *w.add(3) = 0;
        *w.add(4) = 0;
        r
    };
    crate::rt::sched::obj_unlock(w);
    // (The record stays: threads the test started may hold it.)
    if d == 0 {
        return crate::string::String::new();
    }
    let b = crate::rt::slice_from_raw(d as *const u8, n);
    let s = crate::string::String::from_utf8_lossy(b);
    unsafe {
        free(d as *mut u8);
    }
    s
}

/// What capture c holds so far (it stays open).
pub fn capture_peek(c: usize) -> crate::string::String {
    let w = c as *mut usize;
    crate::rt::sched::obj_lock(w);
    let s = unsafe {
        let (d, n) = (*w.add(2), *w.add(3));
        if d == 0 {
            crate::string::String::new()
        } else {
            crate::string::String::from_utf8_lossy(crate::rt::slice_from_raw(d as *const u8, n))
        }
    };
    crate::rt::sched::obj_unlock(w);
    s
}

/// Writes n bytes at p to fd, or to the running G's output capture if it
/// has one (fd 1 or 2).
pub fn write_out(fd: i32, p: *const u8, n: usize) {
    let c = crate::rt::sched::output_capture();
    if c != 0 && (fd == 1 || fd == 2) && capture_write(c, p, n) {
        return;
    }
    write(fd, p, n);
}

// A panic message's pieces (to the G's output capture if it has one).
fn pput(s: &str) {
    write_out(2, s.as_ptr(), s.len());
}

fn pput_u64(v: u64) {
    let buf = unsafe { calloc(1, 32) } as usize;
    let mut n = 20;
    let mut x = v;
    loop {
        n -= 1;
        unsafe {
            *((buf + n) as *mut u8) = b'0' + (x % 10) as u8;
        }
        x = x / 10;
        if x == 0 {
            break;
        }
    }
    write_out(2, (buf + n) as *const u8, 20 - n);
    unsafe {
        free(buf as *mut u8);
    }
}

// The digits go to C memory: a local array whose address write gets would
// be a heap cell, and these print on scheduler records and while the world
// is stopped, where nothing may allocate.
pub fn put_u64(fd: i32, v: u64) {
    let buf = unsafe { calloc(1, 32) } as usize;
    let mut n = 20;
    let mut x = v;
    loop {
        n -= 1;
        unsafe {
            *((buf + n) as *mut u8) = b'0' + (x % 10) as u8;
        }
        x = x / 10;
        if x == 0 {
            break;
        }
    }
    write(fd, (buf + n) as *const u8, 20 - n);
    unsafe {
        free(buf as *mut u8);
    }
}

pub fn put_hex(fd: i32, v: u64) {
    let buf = unsafe { calloc(1, 32) } as usize;
    let mut n = 18;
    let mut x = v;
    loop {
        n -= 1;
        let d = (x & 15) as u8;
        unsafe {
            *((buf + n) as *mut u8) = if d < 10 { b'0' + d } else { b'a' + d - 10 };
        }
        x = x >> 4;
        if x == 0 {
            break;
        }
    }
    n -= 2;
    unsafe {
        *((buf + n) as *mut u8) = b'0';
        *((buf + n + 1) as *mut u8) = b'x';
    }
    write(fd, (buf + n) as *const u8, 18 - n);
    unsafe {
        free(buf as *mut u8);
    }
}

fn panic_header(file: &str, line: u32, col: u32) {
    if crate::rt::sched::is_main() {
        pput("thread 'main' panicked at ");
    } else {
        pput("thread '<unnamed>' panicked at ");
    }
    pput(file);
    pput(":");
    pput_u64(line as u64);
    pput(":");
    pput_u64(col as u64);
    pput(":\n");
}

/// Runs the deferred calls of every frame on the stack, innermost first,
/// up to the frame stop (exclusive; 0: the whole stack).
fn unwind(stop0: usize) {
    let top = crate::rt::stack_top() as usize;
    let mut fp = crate::rt::frame_address() as usize;
    let mut stop = stop0;
    while fp != 0 && fp != top && fp != stop {
        let slot = (fp - 32) as *mut usize;
        unsafe {
            let head = *slot;
            if head != 0 {
                *slot = 0;
                // A deferred call may move the stack, and fp and stop are
                // integers, which a move leaves alone (as Go's uintptr):
                // kept as distances from the stack's top, which a move keeps.
                let hi = crate::rt::sched::current_stack_hi();
                let size = crate::rt::sched::current_stack_size();
                let fd = hi.wrapping_sub(fp);
                let sd = hi.wrapping_sub(stop);
                crate::rt::run_defers(head as *mut u8);
                let nhi = crate::rt::sched::current_stack_hi();
                if fd < size {
                    fp = nhi - fd;
                }
                if stop != 0 && sd < size {
                    stop = nhi - sd;
                }
            }
            fp = *(fp as *const usize);
        }
    }
}

/// A catch_unwind in progress (allocated by try_call, linked from the G).
struct CatchRec {
    buf: [usize; 13],
    prev: usize,
    fp: usize,
    payload: usize,
}

/// Moves what the catch_unwind records from first on hold of a stack
/// [lo, hi) that moved by delta (see sched::grow).
pub fn move_catches(first: usize, lo: usize, hi: usize, delta: usize) {
    let mut r = first as *mut CatchRec;
    while r as usize != 0 {
        unsafe {
            if (*r).fp >= lo && (*r).fp < hi {
                (*r).fp = (*r).fp.wrapping_add(delta);
            }
            let mut i = 0;
            while i < 13 {
                let w = (*r).buf[i];
                if w >= lo && w < hi {
                    (*r).buf[i] = w.wrapping_add(delta);
                }
                i += 1;
            }
            r = (*r).prev as *mut CatchRec;
        }
    }
}

/// Calls f; a panic in f unwinds (running defers) back here and its
/// payload is returned.
pub fn try_call(f: fn()) -> *mut u8 {
    let rec =
        crate::rt::gc::alloc(crate::intrinsics::size_of::<CatchRec>(), false) as *mut CatchRec;
    unsafe {
        (*rec).prev = crate::rt::sched::catch_top();
        (*rec).fp = crate::rt::frame_address() as usize;
        crate::rt::sched::set_catch_top(rec as usize);
        // The registers saved may be all that holds a pointer (f's
        // environment in a callee-saved register): rec, allocated black
        // while a concurrent mark runs, is not scanned, so what they point
        // to is shaded as a write barrier would, with no stop between the
        // save and that.
        crate::rt::sched::preempt_off();
        if crate::rt::save_context(&mut (*rec).buf as *mut [usize; 13] as *mut usize) == 0 {
            crate::rt::gc::shade_range(&mut (*rec).buf as *mut [usize; 13] as usize, 13 * 8);
            crate::rt::sched::preempt_on();
            f();
            crate::rt::sched::set_catch_top((*rec).prev);
            return 0 as *mut u8;
        }
        // Resumed by throw: rec is unchanged since save_context.
        crate::rt::sched::set_catch_top((*rec).prev);
        (*rec).payload as *mut u8
    }
}

/// Unwinds to the innermost catch_unwind with payload p.
fn throw(p: *mut u8) -> ! {
    let rec = crate::rt::sched::catch_top() as *mut CatchRec;
    unsafe {
        // (A word rec, allocated black, holds: shaded, as save_context's.)
        crate::rt::sched::preempt_off();
        (*rec).payload = p as usize;
        crate::rt::gc::shade_range(&mut (*rec).payload as *mut usize as usize, 8);
        crate::rt::sched::preempt_on();
        unwind((*rec).fp);
        crate::rt::resume_context(&mut (*rec).buf as *mut [usize; 13] as *mut usize, 1)
    }
}

static mut PANICKING: bool = false;

pub fn panic_raw(msg: &str, file: &str, line: u32, col: u32) -> ! {
    panic_header(file, line, col);
    pput(msg);
    pput("\n");
    if crate::rt::sched::catch_top() != 0 {
        throw(crate::panic::new_payload(msg, file, line, col));
    }
    if !PANICKING {
        PANICKING = true;
        unwind(0);
    }
    exit(101)
}

/// Called by generated code when a bounds check fails.
pub fn panic_bounds(len: usize, index: usize, file: &str, line: u32, col: u32) -> ! {
    panic_header(file, line, col);
    pput("index out of bounds: the len is ");
    pput_u64(len as u64);
    pput(" but the index is ");
    pput_u64(index as u64);
    pput("\n");
    if crate::rt::sched::catch_top() != 0 {
        throw(crate::panic::bounds_payload(len, index, file, line, col));
    }
    if !PANICKING {
        PANICKING = true;
        unwind(0);
    }
    exit(101)
}

/// Reports a fatal runtime error and exits.
pub fn fatal(msg: &str) -> ! {
    put(2, "fatal error: ");
    put(2, msg);
    put(2, "\n");
    exit(2)
}

pub fn spawn<T>(f: fn() -> T) -> *mut u8 {
    let mut slot: Option<T> = None;
    let cell = &mut slot;
    let h = crate::rt::sched::new_handle(cell as *mut Option<T> as *mut u8);
    crate::rt::sched::go(|| {
        *cell = Some(f());
        crate::rt::sched::finish(h);
    });
    h as *mut u8
}

pub fn join<T>(h: *mut u8) -> T {
    let cell = crate::rt::sched::join(h as *mut crate::rt::sched::Handle) as *mut Option<T>;
    match unsafe { *cell } {
        Some(v) => v,
        None => fatal("joined thread has no result"),
    }
}

pub fn yield_now() {
    crate::rt::sched::yield_now();
}

pub fn chan_new<T>(cap: usize) -> *mut u8 {
    let write_result = |slot: *mut u8, src: *const u8| {
        let r: Result<T, crate::sync::mpmc::RecvError> = if src as usize == 0 {
            Err(crate::sync::mpmc::RecvError)
        } else {
            Ok(unsafe { *(src as *const T) })
        };
        unsafe {
            *(slot as *mut Result<T, crate::sync::mpmc::RecvError>) = r;
        }
    };
    crate::rt::sched::new_chan(crate::intrinsics::size_of::<T>(), cap, write_result) as *mut u8
}

pub fn chan_send<T>(c: *mut u8, v: T) -> bool {
    let mut tmp = v;
    let cell = &mut tmp;
    crate::rt::sched::send(
        c as *mut crate::rt::sched::Chan,
        cell as *mut T as *const u8,
    )
}

fn recv_typed<T>(c: *mut u8, block: bool) -> Option<T> {
    let n = crate::intrinsics::size_of::<T>();
    let buf = crate::rt::gc::alloc(if n == 0 { 1 } else { n }, false);
    if crate::rt::sched::recv(c as *mut crate::rt::sched::Chan, buf, block) {
        Some(unsafe { *(buf as *const T) })
    } else {
        None
    }
}

pub fn chan_recv<T>(c: *mut u8) -> Option<T> {
    recv_typed::<T>(c, true)
}

/// chan_send waiting until deadline (monotonic nanoseconds) at most:
/// sched::SENT, CLOSED or TIMED_OUT.
pub fn chan_send_until<T>(c: *mut u8, v: T, deadline: u64) -> usize {
    let mut tmp = v;
    let cell = &mut tmp;
    crate::rt::sched::send_until(
        c as *mut crate::rt::sched::Chan,
        cell as *mut T as *const u8,
        deadline,
    )
}

/// chan_recv waiting until deadline at most: the value, or sched::CLOSED
/// or TIMED_OUT.
pub fn chan_recv_until<T>(c: *mut u8, deadline: u64) -> Result<T, usize> {
    let n = crate::intrinsics::size_of::<T>();
    let buf = crate::rt::gc::alloc(if n == 0 { 1 } else { n }, false);
    let r = crate::rt::sched::recv_until(c as *mut crate::rt::sched::Chan, buf, deadline);
    if r == crate::rt::sched::SENT {
        Ok(unsafe { *(buf as *const T) })
    } else {
        Err(r)
    }
}
pub fn chan_try_recv<T>(c: *mut u8) -> Option<T> {
    recv_typed::<T>(c, false)
}
pub fn chan_close(c: *mut u8) {
    crate::rt::sched::close(c as *mut crate::rt::sched::Chan);
}
pub fn chan_closed(c: *mut u8) -> bool {
    crate::rt::sched::closed(c as *mut crate::rt::sched::Chan)
}
pub fn select_cases(cases: &[crate::sync::mpmc::SelectCase], has_default: bool) -> usize {
    crate::rt::sched::run_select(cases, has_default)
}

/// The scheduler's entry points used by generated code.
pub fn sched_init() -> usize {
    crate::rt::sched::init()
}
pub fn gmain() -> ! {
    crate::rt::sched::gmain()
}
/// A callback from C enters and leaves its callback G (navi; see
/// sched::cb_enter).
pub fn cb_enter(m: usize) {
    crate::rt::sched::cb_enter(m)
}
pub fn cb_exit() {
    crate::rt::sched::cb_exit()
}

/// The slow path of the stack check in every function prologue (navi):
/// the stack is really exhausted, or the collector asked the G to stop.
/// Called with the G's limit cleared.
pub fn morestack() -> usize {
    crate::rt::sched::morestack()
}

/// The write barrier of generated code (navi), called while a concurrent
/// collection marks: marks what was just stored at [p, p + n). The G may
/// not stop between the store and the marking (a collection finishing then
/// would miss the stored pointer): the barrier made it non-preemptible.
pub fn gc_wb(p: usize, n: usize) {
    // The barrier incremented nopreempt before the call.
    crate::rt::gc::shade_range(p, n);
    crate::rt::sched::preempt_on();
}

/// The first navi code of a new OS thread (navi).
pub fn mstart() -> ! {
    crate::rt::sched::mstart()
}

#[nonblocking]
extern "C" {
    fn floor(x: f64) -> f64;
    fn ceil(x: f64) -> f64;
    fn trunc(x: f64) -> f64;
    fn round(x: f64) -> f64;
    fn sqrt(x: f64) -> f64;
}

pub fn float_op(op: u8, x: f64) -> f64 {
    unsafe {
        if op == 0 {
            floor(x)
        } else if op == 1 {
            ceil(x)
        } else if op == 2 {
            trunc(x)
        } else if op == 3 {
            round(x)
        } else {
            sqrt(x)
        }
    }
}

pub fn fmt_float(x: f64, prec: usize, has_prec: bool, style: u8, buf: *mut u8) -> usize {
    crate::rt::float::format(x, prec, has_prec, style, buf)
}

// --- Operating system ------------------------------------------------------------

#[nonblocking]
extern "C" {
    fn getenv(name: *const u8) -> *const u8;
    fn fopen(path: *const u8, mode: *const u8) -> *mut u8;
    fn fclose(f: *mut u8) -> i32;
    fn remove(path: *const u8) -> i32;
}
// May block: calls count the G as blocked (see sched::enter_blocked).
extern "C" {
    fn system(cmd: *const u8) -> i32;
    fn fread(buf: *mut u8, size: usize, n: usize, f: *mut u8) -> usize;
    fn fwrite(buf: *const u8, size: usize, n: usize, f: *mut u8) -> usize;
}

#[cfg(not(target_os = "windows"))]
#[nonblocking]
extern "C" {
    fn opendir(path: *const u8) -> *mut u8;
    fn closedir(d: *mut u8) -> i32;
    fn mkdir(path: *const u8, mode: u32) -> i32;
}

#[cfg(target_os = "windows")]
#[nonblocking]
extern "C" {
    fn GetFileAttributesA(path: *const u8) -> u32;
    #[link_name = "_mkdir"]
    fn mkdir_win(path: *const u8) -> i32;
}

static mut ARGC: usize = 0;
static mut ARGV: usize = 0;

/// Called by the entry point with C's argc and argv.
pub fn set_args(argc: usize, argv: usize) {
    ARGC = argc;
    ARGV = argv;
    binary_stdio();
}

// Windows: the standard streams in binary mode, so that what is written
// is what arrives ("\n" stays "\n", as Go and Rust write).
#[cfg(target_os = "windows")]
#[nonblocking]
extern "C" {
    fn _setmode(fd: i32, mode: i32) -> i32;
}
#[cfg(target_os = "windows")]
fn binary_stdio() {
    let mut fd = 0;
    while fd < 3 {
        unsafe {
            _setmode(fd, 0x8000);
        }
        fd += 1;
    }
}
#[cfg(not(target_os = "windows"))]
fn binary_stdio() {}

// A NUL-terminated copy of s.
fn cstr(s: &str) -> *const u8 {
    let n = s.len();
    let p = crate::rt::gc::alloc(n + 1, true);
    crate::rt::copy::<u8>(s.as_ptr(), p, n);
    p as *const u8
}

// The string at a C pointer (not copied).
fn from_cstr(p: *const u8) -> &str {
    let mut n = 0;
    unsafe {
        while *crate::rt::ptr_offset(p, n) != 0 {
            n += 1;
        }
    }
    crate::rt::str_from_raw(p, n)
}

pub fn os_arg_count() -> usize {
    ARGC
}

/// The initial environment (C's envp: it follows argv's terminating null
/// on Linux and macOS).
pub fn os_envp() -> usize {
    ARGV + 8 * (ARGC + 1)
}

#[cfg(target_os = "macos")]
#[nonblocking]
extern "C" {
    fn clock_gettime_nsec_np(clock: u32) -> u64;
}

#[cfg(target_os = "macos")]
pub fn monotonic_nanos() -> u64 {
    unsafe { clock_gettime_nsec_np(4) }
} // CLOCK_MONOTONIC_RAW

/// Nanoseconds since 1970-01-01 UTC (the system clock).
#[cfg(target_os = "macos")]
pub fn realtime_nanos() -> u64 {
    unsafe { clock_gettime_nsec_np(0) }
} // CLOCK_REALTIME

#[cfg(target_os = "linux")]
pub fn realtime_nanos() -> u64 {
    let mut ts = [0i64; 2];
    unsafe {
        clock_gettime(0, &mut ts as *mut [i64; 2] as *mut i64);
    } // CLOCK_REALTIME
    (ts[0] as u64) * 1000000000 + ts[1] as u64
}

#[cfg(target_os = "windows")]
#[nonblocking]
extern "C" {
    fn GetSystemTimePreciseAsFileTime(ft: *mut u64);
}

// 100-ns intervals since 1601.
#[cfg(target_os = "windows")]
pub fn realtime_nanos() -> u64 {
    let mut ft = 0u64;
    unsafe {
        GetSystemTimePreciseAsFileTime(&mut ft as *mut u64);
    }
    (ft - 116444736000000000) * 100
}

#[cfg(target_os = "linux")]
#[nonblocking]
extern "C" {
    fn clock_gettime(clock: i32, ts: *mut i64) -> i32;
}

#[cfg(target_os = "linux")]
pub fn monotonic_nanos() -> u64 {
    let mut ts = [0i64; 2];
    unsafe {
        clock_gettime(1, &mut ts as *mut [i64; 2] as *mut i64);
    } // CLOCK_MONOTONIC
    (ts[0] as u64) * 1000000000 + ts[1] as u64
}

#[cfg(target_os = "windows")]
#[nonblocking]
extern "C" {
    fn QueryPerformanceCounter(c: *mut i64) -> i32;
    fn QueryPerformanceFrequency(f: *mut i64) -> i32;
}

#[cfg(target_os = "windows")]
pub fn monotonic_nanos() -> u64 {
    let mut c = 0i64;
    let mut f = 0i64;
    unsafe {
        QueryPerformanceCounter(&mut c as *mut i64);
        QueryPerformanceFrequency(&mut f as *mut i64);
    }
    let secs = (c / f) as u64;
    let rest = (c % f) as u64;
    secs * 1000000000 + rest * 1000000000 / f as u64
}

pub fn os_arg(i: usize) -> &str {
    let p = unsafe { *((ARGV + 8 * i) as *const *const u8) };
    from_cstr(p)
}

pub fn os_getenv(name: &str) -> Option<&str> {
    let p = unsafe { getenv(cstr(name)) };
    if p as usize == 0 {
        None
    } else {
        Some(from_cstr(p))
    }
}

/// Whether the variable named by name (NUL-terminated) is set; does not
/// allocate (the collector asks).
pub fn env_set(name: &[u8]) -> bool {
    unsafe { getenv(name.as_ptr()) as usize != 0 }
}

/// The runtime's debugging switch name in NAVI_DEBUG (as Go's GODEBUG:
/// name=value pairs separated by commas, a name alone meaning 1), the last
/// one given; does not allocate.
pub fn debug_var(name: &str) -> Option<&str> {
    let all = getenv_c(b"NAVI_DEBUG\0")?;
    let b = all.as_bytes();
    let mut found: Option<&str> = None;
    let mut i = 0;
    while i < b.len() {
        let mut j = i;
        while j < b.len() && b[j] != b',' {
            j += 1;
        }
        let mut k = i;
        while k < j && b[k] != b'=' {
            k += 1;
        }
        if &all[i..k] == name {
            found = Some(if k < j { &all[k + 1..j] } else { "1" });
        }
        i = j + 1;
    }
    found
}

/// Whether the switch name is on in NAVI_DEBUG (given, not as 0).
pub fn debug_on(name: &str) -> bool {
    match debug_var(name) {
        Some(v) => v != "0",
        None => false,
    }
}

/// The switch's value as a number (digits only; 0 if none).
pub fn debug_usize(name: &str) -> usize {
    let mut n = 0usize;
    if let Some(v) = debug_var(name) {
        for c in v.bytes() {
            if c >= b'0' && c <= b'9' {
                n = n * 10 + (c - b'0') as usize;
            }
        }
    }
    n
}

/// The variable named by name (NUL-terminated); does not allocate (the
/// runtime's threads and the allocator ask; os_getenv copies the name to
/// GC memory).
pub fn getenv_c(name: &[u8]) -> Option<&str> {
    let p = unsafe { getenv(name.as_ptr()) };
    if p as usize == 0 {
        None
    } else {
        Some(from_cstr(p))
    }
}

pub fn os_system(cmd: &str) -> i32 {
    let c = cstr(cmd);
    let status = unsafe { system(c) };
    exit_code(status)
}

#[cfg(not(target_os = "windows"))]
fn exit_code(status: i32) -> i32 {
    // The wait status: exit code in bits 8-15, or the signal.
    if status & 127 == 0 {
        (status >> 8) & 255
    } else {
        128 + (status & 127)
    }
}

#[cfg(target_os = "windows")]
fn exit_code(status: i32) -> i32 {
    status
}

pub fn fs_open(path: &str, mode: u8) -> usize {
    let m = if mode == 0 {
        "rb\0"
    } else if mode == 1 {
        "wb\0"
    } else {
        "ab\0"
    };
    unsafe { fopen(cstr(path), m.as_ptr()) as usize }
}

pub fn fs_read(h: usize, buf: *mut u8, n: usize) -> usize {
    let r = unsafe { fread(buf, 1, n, h as *mut u8) };
    r
}

pub fn fs_write(h: usize, buf: *const u8, n: usize) -> usize {
    let r = unsafe { fwrite(buf, 1, n, h as *mut u8) };
    r
}
pub fn fs_close(h: usize) {
    unsafe {
        fclose(h as *mut u8);
    }
}
pub fn fs_remove(path: &str) -> bool {
    unsafe { remove(cstr(path)) == 0 }
}

#[cfg(not(target_os = "windows"))]
pub fn fs_kind(path: &str) -> u8 {
    let c = cstr(path);
    let d = unsafe { opendir(c) };
    if d as usize != 0 {
        unsafe {
            closedir(d);
        }
        return 2;
    }
    let f = unsafe { fopen(c, "rb\0".as_ptr()) };
    if f as usize != 0 {
        unsafe {
            fclose(f);
        }
        return 1;
    }
    0
}

#[cfg(target_os = "windows")]
pub fn fs_kind(path: &str) -> u8 {
    let a = unsafe { GetFileAttributesA(cstr(path)) };
    if a == 4294967295 {
        0
    } else if a & 16 != 0 {
        2
    } else {
        1
    }
}

#[cfg(not(target_os = "windows"))]
pub fn fs_mkdir(path: &str) -> bool {
    unsafe { mkdir(cstr(path), 511) == 0 }
}

#[cfg(target_os = "windows")]
pub fn fs_mkdir(path: &str) -> bool {
    unsafe { mkdir_win(cstr(path)) == 0 }
}

/// a + b + carry and the carry out: the add_carry intrinsic of compilers
/// that do not expand it (the previous release, for bootstrapping).
pub fn add_carry(a: u64, b: u64, carry: bool) -> (u64, bool) {
    let s = a.wrapping_add(b);
    let s2 = s.wrapping_add(carry as u64);
    (s2, s < a || s2 < s)
}

/// a - b - borrow and the borrow out (sub_borrow, as add_carry).
pub fn sub_borrow(a: u64, b: u64, borrow: bool) -> (u64, bool) {
    let d = a.wrapping_sub(b);
    let d2 = d.wrapping_sub(borrow as u64);
    (d2, a < b || d < borrow as u64)
}

/// The high word of a * b: the mul_hi intrinsic of compilers that do not
/// expand it (the previous release, for bootstrapping).
pub fn mul_hi(a: u64, b: u64) -> u64 {
    let a0 = a & 0xffffffff;
    let a1 = a >> 32;
    let b0 = b & 0xffffffff;
    let b1 = b >> 32;
    let p00 = a0 * b0;
    let p01 = a0 * b1;
    let p10 = a1 * b0;
    let p11 = a1 * b1;
    let mid = (p00 >> 32) + (p01 & 0xffffffff) + (p10 & 0xffffffff);
    p11 + (p01 >> 32) + (p10 >> 32) + (mid >> 32)
}
