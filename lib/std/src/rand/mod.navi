//! Random numbers, as Rust's `rand` crate (0.9 names, with the common 0.8
//! names kept as aliases).
//!
//! - Generators: [`rng()`](crate::rand::rng) (the process's generator, seeded
//!   from the operating system), [`StdRng`](crate::rand::rngs::StdRng) and
//!   [`SmallRng`](crate::rand::rngs::SmallRng) (seedable, reproducible),
//!   [`OsRng`](crate::rand::rngs::OsRng) (the operating system's source).
//! - The [`Rng`](crate::rand::Rng) methods draw values: `random`,
//!   `random_range`, `random_bool`, `fill`, `sample`...
//! - [`distr`](crate::rand::distr) has distributions, and
//!   [`seq`](crate::rand::seq) picks from and shuffles sequences.
//!
//! The same seed gives the same values as rand 0.9. Random values of a type
//! come from the [`StandardUniform`](crate::rand::distr::StandardUniform)
//! distribution: every integer type over all its values, `f32` and `f64`
//! in `[0, 1)`, `bool`, `char`, tuples of up to 6 and arrays of such types.
//! Differences from rand are listed in `spec/std-diff.md`.
//!
//! # Examples
//!
//! ```
//! use std::rand::{self, Rng};
//!
//! let x: f64 = rand::random();
//! assert(x >= 0.0 && x < 1.0);
//!
//! let mut rng = rand::rng();
//! let die = rng.random_range(1..=6);
//! assert(die >= 1 && die <= 6);
//! let coin: bool = rng.random_bool(0.5);
//! let mut bytes = [0u8; 16];
//! rng.fill(&mut bytes);
//! ```
//!
//! A seeded generator is reproducible:
//!
//! ```
//! use std::rand::{
//!     Rng, SeedableRng,
//!     rngs::StdRng,
//!     seq::{IndexedRandom, SliceRandom},
//! };
//!
//! let mut a = StdRng::seed_from_u64(42);
//! let mut b = StdRng::seed_from_u64(42);
//! assert_eq(a.random::<u64>(), b.random::<u64>());
//!
//! let mut v = Vec::from([1, 2, 3, 4, 5]);
//! let mut w = v.clone();
//! v.shuffle(&mut a);
//! w.shuffle(&mut b);
//! assert_eq(v, w);
//! let pick = v.choose(&mut a).unwrap();
//! assert(*pick >= 1 && *pick <= 5);
//! ```

mod core;
pub mod distr;
mod os;
pub mod rngs;
pub mod seq;

pub use self::{
    core::{CryptoRng, OsError, RngCore, SeedableRng, TryRngCore},
    rngs::ThreadRng,
};
use crate::{
    marker::PhantomData,
    rand::distr::{
        Bernoulli, DistIter, Distribution, StandardUniform,
        uniform::{Error as UniformError, SampleRange, SampleUniform},
    },
};

/// rand 0.8's name of the [`distr`](crate::rand::distr) module.
pub mod distributions {
    pub use crate::rand::distr::{uniform, *};
}

/// The ChaCha generators, as the `rand_chacha` crate.
pub mod chacha {
    pub use crate::rand::rngs::{ChaCha8Rng, ChaCha12Rng, ChaCha20Rng};
}

/// The traits, generators and functions usually needed, for
/// `use std::rand::prelude::*;`.
///
/// # Examples
///
/// ```
/// use std::rand::prelude::*;
///
/// let mut rng = StdRng::seed_from_u64(7);
/// let n: u32 = rng.random_range(0..10);
/// assert(n < 10);
/// assert(Vec::from([1, 2, 3]).choose(&mut rng).is_some());
/// ```
pub mod prelude {
    pub use crate::rand::{
        CryptoRng, Rng, RngCore, SeedableRng,
        distr::Distribution,
        random, rng,
        rngs::{SmallRng, StdRng, ThreadRng},
        seq::{IndexedMutRandom, IndexedRandom, IteratorRandom, SliceRandom},
        thread_rng,
    };
}

/// Returns the process's generator, [`ThreadRng`]: fast, seeded from the
/// operating system and reseeded regularly, cryptographically strong.
///
/// Unlike rand, navi has one such generator for the whole process (shared
/// by all threads, used under a lock), not one per thread.
///
/// # Examples
///
/// ```
/// use std::rand::{self, Rng};
///
/// let mut rng = rand::rng();
/// let n: u8 = rng.random();
/// let f = rng.random_range(-1.0..1.0);
/// assert(f >= -1.0 && f < 1.0);
/// ```
pub fn rng() -> ThreadRng {
    ThreadRng
}

/// rand 0.8's name of [`rng()`](rng).
pub fn thread_rng() -> ThreadRng {
    ThreadRng
}

/// Returns a random value of type `T` from [`rng()`](rng), drawn from the
/// [`StandardUniform`] distribution.
///
/// A shorthand for `rand::rng().random()`; for many values, keep the
/// generator instead.
///
/// # Examples
///
/// ```
/// use std::rand;
///
/// let x: u8 = rand::random();
/// let (a, b) = rand::random::<(f64, bool)>();
/// assert(a >= 0.0 && a < 1.0);
/// ```
pub fn random<T>() -> T
where
    StandardUniform: Distribution<T>,
{
    let mut r = ThreadRng;
    StandardUniform.sample(&mut r)
}

/// Returns an endless iterator of random values of type `T` from
/// [`rng()`](rng), drawn from the [`StandardUniform`] distribution.
///
/// # Examples
///
/// ```
/// use std::rand;
///
/// let v: Vec<u8> = rand::random_iter::<u8>().take(5).collect();
/// assert_eq(v.len(), 5);
/// ```
pub fn random_iter<T>() -> RandomIter<ThreadRng, T>
where
    StandardUniform: Distribution<T>,
{
    RandomIter {
        rng: &mut ThreadRng,
        t: PhantomData,
    }
}

/// Returns a value drawn uniformly from `range` (`low..high` or
/// `low..=high`) with [`rng()`](rng).
///
/// # Panics
///
/// If the range is empty.
///
/// # Examples
///
/// ```
/// use std::rand;
///
/// let n = rand::random_range(10..20);
/// assert(n >= 10 && n < 20);
/// ```
pub fn random_range<T, Rg>(range: Rg) -> T
where
    T: SampleUniform,
    Rg: SampleRange<T>,
{
    let mut r = ThreadRng;
    r.random_range(range)
}

/// Returns `true` with probability `p`, using [`rng()`](rng).
///
/// # Panics
///
/// Unless `0.0 <= p <= 1.0`.
///
/// # Examples
///
/// ```
/// use std::rand;
///
/// assert(rand::random_bool(1.0));
/// assert(!rand::random_bool(0.0));
/// ```
pub fn random_bool(p: f64) -> bool {
    let mut r = ThreadRng;
    r.random_bool(p)
}

/// Returns `true` with probability `numerator / denominator`, using
/// [`rng()`](rng).
///
/// # Panics
///
/// If `denominator` is 0 or less than `numerator`.
///
/// # Examples
///
/// ```
/// use std::rand;
///
/// assert(rand::random_ratio(3, 3));
/// assert(!rand::random_ratio(0, 3));
/// ```
pub fn random_ratio(numerator: u32, denominator: u32) -> bool {
    let mut r = ThreadRng;
    r.random_ratio(numerator, denominator)
}

/// Fills `dest` (a slice, array or `Vec` of integers) with random data
/// from [`rng()`](rng).
///
/// # Examples
///
/// ```
/// let mut key = [0u8; 32];
/// std::rand::fill(&mut key);
/// ```
pub fn fill<T: Fill>(dest: &mut T) {
    let mut r = ThreadRng;
    Fill::fill(dest, &mut r);
}

/// The methods to draw random values, implemented for every
/// [`RngCore`].
///
/// # Examples
///
/// ```
/// use std::rand::{Rng, SeedableRng, rngs::SmallRng};
///
/// let mut rng = SmallRng::seed_from_u64(1);
/// let x: u32 = rng.random();
/// let y = rng.random_range(0..100);
/// let z = rng.random_bool(0.25);
/// assert(y < 100);
/// ```
pub trait Rng: RngCore {
    /// Returns a random value of type `T`, drawn from the
    /// [`StandardUniform`] distribution: integers over all their values,
    /// floats in `[0, 1)`, `bool`s with equal chances, tuples and arrays of
    /// such types.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::rand::{self, Rng};
    ///
    /// let mut rng = rand::rng();
    /// let x: u32 = rng.random();
    /// let y = rng.random::<f64>();
    /// assert(y >= 0.0 && y < 1.0);
    /// let arr: [u8; 4] = rng.random();
    /// let (a, b): (i8, bool) = rng.random();
    /// ```
    fn random<T>(&mut self) -> T
    where
        StandardUniform: Distribution<T>,
    {
        StandardUniform.sample(self)
    }

    /// Returns an endless iterator of random values of type `T` (drawn as
    /// [`Rng::random`] does); the iterator borrows the generator.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::rand::{self, Rng};
    ///
    /// let mut rng = rand::rng();
    /// let v: Vec<bool> = rng.random_iter().take(8).collect();
    /// assert_eq(v.len(), 8);
    /// ```
    fn random_iter<T>(&mut self) -> RandomIter<Self, T>
    where
        StandardUniform: Distribution<T>,
    {
        RandomIter {
            rng: self,
            t: PhantomData,
        }
    }

    /// Returns a value drawn uniformly from `range`, `low..high` or
    /// `low..=high`.
    ///
    /// Integers are unbiased. To draw many values from the same range, a
    /// [`Uniform`](crate::rand::distr::Uniform) distribution is faster.
    ///
    /// # Panics
    ///
    /// If the range is empty.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::rand::{self, Rng};
    ///
    /// let mut rng = rand::rng();
    /// let v = Vec::from([10, 20, 30]);
    /// let i = rng.random_range(0..v.len());
    /// assert(i < 3);
    /// let x = rng.random_range(-1.0..=1.0);
    /// assert(x >= -1.0 && x <= 1.0);
    /// ```
    fn random_range<T, Rg>(&mut self, range: Rg) -> T
    where
        T: SampleUniform,
        Rg: SampleRange<T>,
    {
        if range.is_empty() {
            panic("cannot sample empty range");
        }
        match range.sample_single(self) {
            Ok(v) => v,
            Err(e) => panic(`random_range: ${e}`),
        }
    }

    /// Returns `true` with probability `p`.
    ///
    /// # Panics
    ///
    /// Unless `0.0 <= p <= 1.0`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::rand::{self, Rng};
    ///
    /// let mut rng = rand::rng();
    /// let heads = rng.random_bool(0.5);
    /// assert(rng.random_bool(1.0));
    /// ```
    fn random_bool(&mut self, p: f64) -> bool {
        match Bernoulli::new(p) {
            Ok(d) => d.sample(self),
            Err(_) => panic(`p=${p} is outside range [0.0, 1.0]`),
        }
    }

    /// Returns `true` with probability `numerator / denominator`.
    ///
    /// # Panics
    ///
    /// If `denominator` is 0 or less than `numerator`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::rand::{self, Rng};
    ///
    /// let mut rng = rand::rng();
    /// let one_in_six = rng.random_ratio(1, 6);
    /// assert(rng.random_ratio(2, 2));
    /// ```
    fn random_ratio(&mut self, numerator: u32, denominator: u32) -> bool {
        match Bernoulli::from_ratio(numerator, denominator) {
            Ok(d) => d.sample(self),
            Err(_) => panic(`p=${numerator}/${denominator} is outside range [0, 1]`),
        }
    }

    /// Returns a value drawn from the distribution `distr`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::rand::{self, Rng, distr::Uniform};
    ///
    /// let mut rng = rand::rng();
    /// let n: i32 = rng.sample(Uniform::new(10, 15).unwrap());
    /// assert(n >= 10 && n < 15);
    /// ```
    fn sample<T, D>(&mut self, distr: D) -> T
    where
        D: Distribution<T>,
    {
        distr.sample(self)
    }

    /// Returns an endless iterator of values drawn from `distr`; the
    /// iterator borrows the generator.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::rand::{self, Rng, distr::Alphanumeric};
    ///
    /// let mut rng = rand::rng();
    /// let s: String = rng
    ///     .sample_iter(Alphanumeric)
    ///     .take(7)
    ///     .map(|b: u8| b as char)
    ///     .collect();
    /// assert_eq(s.len(), 7);
    /// ```
    fn sample_iter<T, D>(&mut self, distr: D) -> DistIter<D, Self, T>
    where
        D: Distribution<T>,
    {
        distr.sample_iter(self)
    }

    /// Fills `dest` (a slice, array or `Vec` of integers) with random
    /// data.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::rand::{self, Rng};
    ///
    /// let mut nonce = [0u8; 12];
    /// rand::rng().fill(&mut nonce);
    /// let mut words = [0u32; 4];
    /// rand::rng().fill(&mut words);
    /// ```
    fn fill<T: Fill>(&mut self, dest: &mut T) {
        Fill::fill(dest, self);
    }

    /// rand 0.8's name of [`Rng::random`].
    fn gen<T>(&mut self) -> T
    where
        StandardUniform: Distribution<T>,
    {
        StandardUniform.sample(self)
    }

    /// rand 0.8's name of [`Rng::random_range`].
    fn gen_range<T, Rg>(&mut self, range: Rg) -> T
    where
        T: SampleUniform,
        Rg: SampleRange<T>,
    {
        self.random_range(range)
    }

    /// rand 0.8's name of [`Rng::random_bool`].
    fn gen_bool(&mut self, p: f64) -> bool {
        self.random_bool(p)
    }

    /// rand 0.8's name of [`Rng::random_ratio`].
    fn gen_ratio(&mut self, numerator: u32, denominator: u32) -> bool {
        self.random_ratio(numerator, denominator)
    }
}

impl<R: RngCore> Rng for R {}

/// The endless iterator returned by [`Rng::random_iter`] and
/// [`random_iter`].
pub struct RandomIter<R, T> {
    rng: &mut R,
    t: PhantomData<T>,
}

impl<R: RngCore, T> Iterator for RandomIter<R, T>
where
    StandardUniform: Distribution<T>,
{
    type Item = T;
    fn next(&mut self) -> Option<T> {
        Some(StandardUniform.sample(self.rng))
    }
}

/// Types that [`Rng::fill`] can fill with random data: slices, arrays and
/// `Vec`s of integers.
///
/// The elements get the bytes of [`RngCore::fill_bytes`], little-endian
/// (the same values as rand's `fill`).
pub trait Fill {
    /// Fills `self` with random data from `rng`.
    fn fill<R: Rng>(&mut self, rng: &mut R);
}

impl Fill for [u8] {
    fn fill<R: Rng>(&mut self, rng: &mut R) {
        rng.fill_bytes(self);
    }
}

// The elements' bytes (little-endian targets: the values are those of
// rand's fill).
fn fill_raw<T, R: Rng>(s: &mut [T], rng: &mut R) {
    let n = s.len() * crate::mem::size_of::<T>();
    rng.fill_bytes(crate::rt::slice_from_raw_mut(s.as_mut_ptr() as *mut u8, n));
}

impl Fill for [i8] {
    fn fill<R: Rng>(&mut self, rng: &mut R) {
        fill_raw(self, rng);
    }
}

impl Fill for [u16] {
    fn fill<R: Rng>(&mut self, rng: &mut R) {
        fill_raw(self, rng);
    }
}

impl Fill for [i16] {
    fn fill<R: Rng>(&mut self, rng: &mut R) {
        fill_raw(self, rng);
    }
}

impl Fill for [u32] {
    fn fill<R: Rng>(&mut self, rng: &mut R) {
        fill_raw(self, rng);
    }
}

impl Fill for [i32] {
    fn fill<R: Rng>(&mut self, rng: &mut R) {
        fill_raw(self, rng);
    }
}

impl Fill for [u64] {
    fn fill<R: Rng>(&mut self, rng: &mut R) {
        fill_raw(self, rng);
    }
}

impl Fill for [i64] {
    fn fill<R: Rng>(&mut self, rng: &mut R) {
        fill_raw(self, rng);
    }
}

impl Fill for [u128] {
    fn fill<R: Rng>(&mut self, rng: &mut R) {
        fill_raw(self, rng);
    }
}

impl Fill for [i128] {
    fn fill<R: Rng>(&mut self, rng: &mut R) {
        fill_raw(self, rng);
    }
}

impl Fill for [usize] {
    fn fill<R: Rng>(&mut self, rng: &mut R) {
        fill_raw(self, rng);
    }
}

impl Fill for [isize] {
    fn fill<R: Rng>(&mut self, rng: &mut R) {
        fill_raw(self, rng);
    }
}

impl<T, const N: usize> Fill for [T; N]
where
    [T]: Fill,
{
    fn fill<R: Rng>(&mut self, rng: &mut R) {
        Fill::fill(self.as_mut_slice(), rng);
    }
}

impl<T> Fill for Vec<T>
where
    [T]: Fill,
{
    fn fill<R: Rng>(&mut self, rng: &mut R) {
        Fill::fill(self.as_mut_slice(), rng);
    }
}
