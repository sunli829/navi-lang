//! The random number generators, as `rand::rngs`.
//!
//! | Generator | Algorithm | Cryptographic | Seedable |
//! |---|---|---|---|
//! | [`ThreadRng`](crate::rand::rngs::ThreadRng) (`rand::rng()`) | ChaCha12, seeded and reseeded from the OS | yes | no |
//! | [`StdRng`](crate::rand::rngs::StdRng) | ChaCha12 | yes | yes |
//! | [`SmallRng`](crate::rand::rngs::SmallRng) | Xoshiro256++ | no | yes |
//! | [`OsRng`](crate::rand::rngs::OsRng) | the operating system's source | yes | no |
//! | [`ChaCha8Rng`](crate::rand::rngs::ChaCha8Rng), [`ChaCha12Rng`](crate::rand::rngs::ChaCha12Rng), [`ChaCha20Rng`](crate::rand::rngs::ChaCha20Rng) | ChaCha (`rand_chacha`) | yes | yes |
//! | [`mock::StepRng`](crate::rand::rngs::mock::StepRng) | a counter, for tests | no | no |

use crate::{
    fmt::{self, Debug, Formatter},
    rand::core::{ChaChaCore, CryptoRng, OsError, RngCore, SeedableRng, TryRngCore, Xoshiro256},
    sync::{LazyLock, Mutex},
};

// --- ThreadRng ---------------------------------------------------------------

/// The generator of [`rand::rng()`](crate::rand::rng) and
/// [`rand::random()`](crate::rand::random): ChaCha12 seeded from the
/// operating system and reseeded from it every 64 KiB of output.
///
/// Unlike rand's, there is one for the whole process, shared by every
/// thread under a lock (navi's threads are green): a `ThreadRng` is only a
/// handle to it, cheap to create and to copy.
///
/// # Examples
///
/// ```
/// use std::rand::{self, Rng};
///
/// let mut rng = rand::rng();
/// let x: u64 = rng.random();
/// let y = rng.random_range(0..10);
/// assert(y < 10);
/// ```
#[derive(Clone, Default)]
pub struct ThreadRng;

struct ThreadState {
    core: ChaChaCore,
    // Bytes to give before reseeding.
    left: i64,
}

const RESEED_AFTER: i64 = 65536;

fn new_thread_state() -> Mutex<ThreadState> {
    let mut seed = [0u8; 32];
    match crate::rand::os::fill(&mut seed[..]) {
        Ok(()) => {}
        Err(e) => panic(`could not initialize ThreadRng: ${e}`),
    }
    Mutex::new(ThreadState {
        core: ChaChaCore::new(&seed, 12),
        left: RESEED_AFTER,
    })
}

static THREAD_RNG: LazyLock<Mutex<ThreadState>> = LazyLock::new(new_thread_state);

// The shared state, locked; n bytes are about to be taken.
fn lock_thread_rng(n: i64) -> &mut ThreadState {
    let m: &Mutex<ThreadState> = &*THREAD_RNG;
    let s = m.lock();
    s.left -= n;
    if s.left < 0 {
        // A failed reseed keeps the old key (as rand's ReseedingRng).
        let mut seed = [0u8; 32];
        if crate::rand::os::fill(&mut seed[..]).is_ok() {
            s.core = ChaChaCore::new(&seed, 12);
        }
        s.left = RESEED_AFTER - n;
    }
    s
}

fn unlock_thread_rng() {
    let m: &Mutex<ThreadState> = &*THREAD_RNG;
    m.unlock();
}

impl RngCore for ThreadRng {
    fn next_u32(&mut self) -> u32 {
        let s = lock_thread_rng(4);
        let v = s.core.next_u32();
        unlock_thread_rng();
        v
    }

    fn next_u64(&mut self) -> u64 {
        let s = lock_thread_rng(8);
        let v = s.core.next_u64();
        unlock_thread_rng();
        v
    }

    fn fill_bytes(&mut self, dest: &mut [u8]) {
        let s = lock_thread_rng(dest.len() as i64);
        s.core.fill_bytes(dest);
        unlock_thread_rng();
    }
}

impl CryptoRng for ThreadRng {}

impl Debug for ThreadRng {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("ThreadRng { .. }")
    }
}

// --- StdRng ------------------------------------------------------------------

/// The standard generator: ChaCha12 (as rand's `StdRng`),
/// cryptographically strong and deterministic for a seed.
///
/// The values are those of rand 0.9's `StdRng` for the same seed (the
/// algorithm may change in later versions of rand, as rand warns).
///
/// # Examples
///
/// ```
/// use std::rand::{Rng, SeedableRng, rngs::StdRng};
///
/// let mut a = StdRng::seed_from_u64(42);
/// let mut b = StdRng::seed_from_u64(42);
/// assert_eq(a.random::<u32>(), b.random::<u32>());
///
/// // Seeded from the operating system: not reproducible.
/// let mut r = StdRng::from_os_rng();
/// ```
#[derive(Clone)]
pub struct StdRng {
    core: ChaChaCore,
}

impl RngCore for StdRng {
    fn next_u32(&mut self) -> u32 {
        self.core.next_u32()
    }

    fn next_u64(&mut self) -> u64 {
        self.core.next_u64()
    }

    fn fill_bytes(&mut self, dest: &mut [u8]) {
        self.core.fill_bytes(dest);
    }
}

impl SeedableRng for StdRng {
    type Seed = [u8; 32];
    fn from_seed(seed: [u8; 32]) -> StdRng {
        StdRng {
            core: ChaChaCore::new(&seed, 12),
        }
    }
}

impl CryptoRng for StdRng {}

impl Debug for StdRng {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("StdRng { .. }")
    }
}

// --- SmallRng ----------------------------------------------------------------

/// A small, fast generator, not for cryptography: Xoshiro256++ (as rand's
/// `SmallRng` on 64-bit targets; the same values for the same seed).
///
/// # Examples
///
/// ```
/// use std::rand::{Rng, SeedableRng, rngs::SmallRng};
///
/// let mut rng = SmallRng::seed_from_u64(9);
/// let rolls: Vec<u8> = (0..10).map(|_| rng.random_range(1..=6)).collect();
/// assert(rolls.iter().all(|r: &u8| -> bool { *r >= 1 && *r <= 6 }));
/// ```
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct SmallRng {
    x: Xoshiro256,
}

impl SmallRng {
    /// Creates a `SmallRng` seeded from [`rand::rng()`](crate::rand::rng).
    pub fn from_thread_rng() -> SmallRng {
        let mut t = ThreadRng;
        SmallRng::from_rng(&mut t)
    }
}

impl RngCore for SmallRng {
    fn next_u32(&mut self) -> u32 {
        self.x.next_u32()
    }

    fn next_u64(&mut self) -> u64 {
        self.x.next_u64()
    }

    fn fill_bytes(&mut self, dest: &mut [u8]) {
        self.x.fill_bytes(dest);
    }
}

impl SeedableRng for SmallRng {
    type Seed = [u8; 32];
    fn from_seed(seed: [u8; 32]) -> SmallRng {
        SmallRng {
            x: Xoshiro256::from_seed(&seed),
        }
    }
    // SplitMix64, as rand_xoshiro.
    fn seed_from_u64(state: u64) -> SmallRng {
        SmallRng {
            x: Xoshiro256::seed_from_u64(state),
        }
    }
}

// --- OsRng -------------------------------------------------------------------

/// The operating system's random source: `getentropy` on macOS, the
/// `getrandom` system call on Linux and Android (`/dev/urandom` on kernels
/// without it), `rand_s` on Windows.
///
/// Every call asks the operating system, which is slow: use it for keys
/// and to seed other generators. As [`RngCore`] it panics if the
/// operating system fails; as [`TryRngCore`] it returns the error.
///
/// # Examples
///
/// ```
/// use std::rand::{RngCore, TryRngCore, rngs::OsRng};
///
/// let mut key = [0u8; 16];
/// OsRng.try_fill_bytes(&mut key).unwrap();
/// let n = OsRng.next_u32();
/// ```
#[derive(Clone, Debug, Default)]
pub struct OsRng;

impl TryRngCore for OsRng {
    fn try_next_u32(&mut self) -> Result<u32, OsError> {
        let mut b = [0u8; 4];
        crate::rand::os::fill(&mut b[..])?;
        Ok(u32::from_le_bytes(b))
    }

    fn try_next_u64(&mut self) -> Result<u64, OsError> {
        let mut b = [0u8; 8];
        crate::rand::os::fill(&mut b[..])?;
        Ok(u64::from_le_bytes(b))
    }

    fn try_fill_bytes(&mut self, dest: &mut [u8]) -> Result<(), OsError> {
        crate::rand::os::fill(dest)
    }
}

impl RngCore for OsRng {
    fn next_u32(&mut self) -> u32 {
        match self.try_next_u32() {
            Ok(v) => v,
            Err(e) => panic(`OsRng failed: ${e}`),
        }
    }

    fn next_u64(&mut self) -> u64 {
        match self.try_next_u64() {
            Ok(v) => v,
            Err(e) => panic(`OsRng failed: ${e}`),
        }
    }

    fn fill_bytes(&mut self, dest: &mut [u8]) {
        match self.try_fill_bytes(dest) {
            Ok(()) => {}
            Err(e) => panic(`OsRng failed: ${e}`),
        }
    }
}

impl CryptoRng for OsRng {}

// --- ChaCha (rand_chacha) ----------------------------------------------------

/// The ChaCha stream cipher with 8 rounds as a generator (`rand_chacha`'s
/// `ChaCha8Rng`, the same values for the same seed).
///
/// The seed is the key; the stream (the nonce, 0 by default) selects one of
/// 2<sup>64</sup> independent sequences, and the word position can be set
/// to jump ahead.
#[derive(Clone)]
pub struct ChaCha8Rng {
    core: ChaChaCore,
}

/// The ChaCha stream cipher with 12 rounds as a generator (`rand_chacha`'s
/// `ChaCha12Rng`, the algorithm of [`StdRng`]).
///
/// See [`ChaCha8Rng`] for the seed, the streams and the word position.
#[derive(Clone)]
pub struct ChaCha12Rng {
    core: ChaChaCore,
}

/// The ChaCha stream cipher with 20 rounds as a generator (`rand_chacha`'s
/// `ChaCha20Rng`).
///
/// Its output is the ChaCha20 keystream of RFC 8439 with the seed as the
/// key and a zero nonce, read as little-endian `u32`s.
///
/// # Examples
///
/// ```
/// use std::rand::{RngCore, SeedableRng, rngs::ChaCha20Rng};
///
/// let mut rng = ChaCha20Rng::from_seed([0u8; 32]);
/// assert_eq(rng.next_u32(), 0xade0b876);
/// assert_eq(rng.next_u32(), 0x903df1a0);
/// assert_eq(rng.get_word_pos(), 2);
///
/// rng.set_word_pos(0);
/// assert_eq(rng.next_u32(), 0xade0b876);
/// ```
#[derive(Clone)]
pub struct ChaCha20Rng {
    core: ChaChaCore,
}

impl ChaCha8Rng {
    /// Returns the seed the generator was created with.
    pub fn get_seed(&self) -> [u8; 32] {
        self.core.seed()
    }

    /// Selects one of 2<sup>64</sup> independent streams (the ChaCha
    /// nonce; 0 by default), keeping the word position.
    pub fn set_stream(&mut self, stream: u64) {
        self.core.set_stream(stream);
    }

    /// Returns the position in the stream, in `u32` words.
    pub fn get_word_pos(&self) -> u128 {
        self.core.word_pos()
    }

    /// Sets the position in the stream, in `u32` words: the next value
    /// is the keystream from there.
    pub fn set_word_pos(&mut self, pos: u128) {
        self.core.set_word_pos(pos);
    }
}

impl ChaCha12Rng {
    /// Returns the seed the generator was created with.
    pub fn get_seed(&self) -> [u8; 32] {
        self.core.seed()
    }

    /// Selects one of 2<sup>64</sup> independent streams (the ChaCha
    /// nonce; 0 by default), keeping the word position.
    pub fn set_stream(&mut self, stream: u64) {
        self.core.set_stream(stream);
    }

    /// Returns the position in the stream, in `u32` words.
    pub fn get_word_pos(&self) -> u128 {
        self.core.word_pos()
    }

    /// Sets the position in the stream, in `u32` words: the next value
    /// is the keystream from there.
    pub fn set_word_pos(&mut self, pos: u128) {
        self.core.set_word_pos(pos);
    }
}

impl ChaCha20Rng {
    /// Returns the seed the generator was created with.
    pub fn get_seed(&self) -> [u8; 32] {
        self.core.seed()
    }

    /// Selects one of 2<sup>64</sup> independent streams (the ChaCha
    /// nonce; 0 by default), keeping the word position.
    pub fn set_stream(&mut self, stream: u64) {
        self.core.set_stream(stream);
    }

    /// Returns the position in the stream, in `u32` words.
    pub fn get_word_pos(&self) -> u128 {
        self.core.word_pos()
    }

    /// Sets the position in the stream, in `u32` words: the next value
    /// is the keystream from there.
    pub fn set_word_pos(&mut self, pos: u128) {
        self.core.set_word_pos(pos);
    }
}

impl RngCore for ChaCha8Rng {
    fn next_u32(&mut self) -> u32 {
        self.core.next_u32()
    }

    fn next_u64(&mut self) -> u64 {
        self.core.next_u64()
    }

    fn fill_bytes(&mut self, dest: &mut [u8]) {
        self.core.fill_bytes(dest);
    }
}

impl RngCore for ChaCha12Rng {
    fn next_u32(&mut self) -> u32 {
        self.core.next_u32()
    }

    fn next_u64(&mut self) -> u64 {
        self.core.next_u64()
    }

    fn fill_bytes(&mut self, dest: &mut [u8]) {
        self.core.fill_bytes(dest);
    }
}

impl RngCore for ChaCha20Rng {
    fn next_u32(&mut self) -> u32 {
        self.core.next_u32()
    }

    fn next_u64(&mut self) -> u64 {
        self.core.next_u64()
    }

    fn fill_bytes(&mut self, dest: &mut [u8]) {
        self.core.fill_bytes(dest);
    }
}

impl SeedableRng for ChaCha8Rng {
    type Seed = [u8; 32];
    fn from_seed(seed: [u8; 32]) -> ChaCha8Rng {
        ChaCha8Rng {
            core: ChaChaCore::new(&seed, 8),
        }
    }
}

impl SeedableRng for ChaCha12Rng {
    type Seed = [u8; 32];
    fn from_seed(seed: [u8; 32]) -> ChaCha12Rng {
        ChaCha12Rng {
            core: ChaChaCore::new(&seed, 12),
        }
    }
}

impl SeedableRng for ChaCha20Rng {
    type Seed = [u8; 32];
    fn from_seed(seed: [u8; 32]) -> ChaCha20Rng {
        ChaCha20Rng {
            core: ChaChaCore::new(&seed, 20),
        }
    }
}

impl CryptoRng for ChaCha8Rng {}
impl CryptoRng for ChaCha12Rng {}
impl CryptoRng for ChaCha20Rng {}

impl Debug for ChaCha8Rng {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("ChaCha8Rng { .. }")
    }
}

impl Debug for ChaCha12Rng {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("ChaCha12Rng { .. }")
    }
}

impl Debug for ChaCha20Rng {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("ChaCha20Rng { .. }")
    }
}

/// Generators for tests.
pub mod mock {
    use crate::rand::core::{RngCore, fill_bytes_via_next};

    /// A generator that is not random: `initial`, `initial + increment`,
    /// ... (rand 0.8's `StepRng`), for tests that need known values.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::rand::{RngCore, rngs::mock::StepRng};
    ///
    /// let mut rng = StepRng::new(10, 5);
    /// assert_eq(rng.next_u64(), 10);
    /// assert_eq(rng.next_u64(), 15);
    /// assert_eq(rng.next_u32(), 20);
    /// ```
    #[derive(Clone, Debug, PartialEq, Eq)]
    pub struct StepRng {
        v: u64,
        a: u64,
    }

    impl StepRng {
        /// Creates a generator whose `next_u64` returns `initial`, then
        /// adds `increment` (wrapping) for each next value.
        pub fn new(initial: u64, increment: u64) -> StepRng {
            StepRng {
                v: initial,
                a: increment,
            }
        }
    }

    impl RngCore for StepRng {
        fn next_u32(&mut self) -> u32 {
            self.next_u64() as u32
        }

        fn next_u64(&mut self) -> u64 {
            let r = self.v;
            self.v = self.v.wrapping_add(self.a);
            r
        }

        fn fill_bytes(&mut self, dest: &mut [u8]) {
            fill_bytes_via_next(self, dest);
        }
    }
}
