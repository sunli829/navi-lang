//! Probability distributions (rand::distr): Distribution, StandardUniform
//! (the "random value of type T" behind rng.random::<T>()), Uniform,
//! Bernoulli, Open01, OpenClosed01 and Alphanumeric.
//!
//!     use std::rand::distr::{Distribution, Bernoulli, Uniform};
//!     let coin = Bernoulli::new(0.5).unwrap();
//!     let heads = coin.sample(&mut rng);
//!     let digits: Vec<u8> = Uniform::new(0u8, 10).unwrap().sample_iter(&mut rng).take(4).collect();

pub mod uniform;
pub mod weighted;

pub use self::uniform::Uniform;
pub use self::weighted::WeightedIndex;

use crate::fmt::{self, Display, Debug, Formatter};
use crate::marker::PhantomData;
use crate::rand::{Rng, RngCore};

/// Something values of type T can be drawn from.
pub trait Distribution<T> {
    fn sample<R: Rng>(&self, rng: &mut R) -> T;

    /// The endless iterator of samples (it borrows rng).
    fn sample_iter<R: Rng>(self, rng: &mut R) -> DistIter<Self, R, T> { DistIter { distr: self, rng, t: PhantomData } }

    /// The distribution of f applied to the samples.
    fn map<U>(self, f: fn(T) -> U) -> DistMap<Self, T, U> { DistMap { distr: self, f } }
}

/// The iterator of Distribution::sample_iter and Rng::sample_iter.
pub struct DistIter<D, R, T> {
    distr: D,
    rng: &mut R,
    t: PhantomData<T>,
}

impl<D, R, T> Iterator for DistIter<D, R, T> where D: Distribution<T>, R: Rng {
    type Item = T;
    fn next(&mut self) -> Option<T> { Some(self.distr.sample(self.rng)) }
}

/// The distribution of Distribution::map.
pub struct DistMap<D, T, U> {
    distr: D,
    f: fn(T) -> U,
}

impl<D, T, U> Distribution<U> for DistMap<D, T, U> where D: Distribution<T> {
    fn sample<R: Rng>(&self, rng: &mut R) -> U { (self.f)(self.distr.sample(rng)) }
}

/// The default distribution of each type (what rng.random() draws):
/// integers uniform over all their values, floats uniform in [0, 1), bool
/// fair, char uniform over the Unicode scalar values; tuples, arrays and
/// Option of such types element by element.
#[derive(Clone, Debug, Default)]
pub struct StandardUniform;

/// rand 0.8's name of StandardUniform.
pub type Standard = StandardUniform;

/// Floats uniform in the open interval (0, 1).
#[derive(Clone, Debug, Default)]
pub struct Open01;

/// Floats uniform in (0, 1].
#[derive(Clone, Debug, Default)]
pub struct OpenClosed01;

/// ASCII letters and digits (a u8 uniform over A-Z, a-z, 0-9).
#[derive(Clone, Debug, Default)]
pub struct Alphanumeric;

impl Distribution<bool> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> bool { (rng.next_u32() as i32) < 0 }
}

impl Distribution<f64> for StandardUniform {
    // 53 random bits.
    fn sample<R: Rng>(&self, rng: &mut R) -> f64 { (rng.next_u64() >> 11) as f64 * (1.0 / 9007199254740992.0) }
}

impl Distribution<f32> for StandardUniform {
    // 24 random bits.
    fn sample<R: Rng>(&self, rng: &mut R) -> f32 { (rng.next_u32() >> 8) as f32 * (1.0f32 / 16777216.0) }
}

impl Distribution<char> for StandardUniform {
    // Uniform over [0, 0x110000) without the surrogates.
    fn sample<R: Rng>(&self, rng: &mut R) -> char {
        let gap: u32 = 0xdfff - 0xd800 + 1;
        let mut n: u32 = rng.random_range(gap..0x110000);
        if n <= 0xdfff { n -= gap; }
        char::from_u32(n).unwrap()
    }
}

impl Distribution<()> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> () { () }
}

impl<A> Distribution<(A,)> for StandardUniform where StandardUniform: Distribution<A> {
    fn sample<R: Rng>(&self, rng: &mut R) -> (A,) { (self.sample(rng),) }
}

impl<A, B> Distribution<(A, B)> for StandardUniform where StandardUniform: Distribution<A>, StandardUniform: Distribution<B> {
    fn sample<R: Rng>(&self, rng: &mut R) -> (A, B) {
        let a: A = self.sample(rng);
        let b: B = self.sample(rng);
        (a, b)
    }
}

impl<A, B, C> Distribution<(A, B, C)> for StandardUniform
where StandardUniform: Distribution<A>, StandardUniform: Distribution<B>, StandardUniform: Distribution<C> {
    fn sample<R: Rng>(&self, rng: &mut R) -> (A, B, C) {
        let a: A = self.sample(rng);
        let b: B = self.sample(rng);
        let c: C = self.sample(rng);
        (a, b, c)
    }
}

impl<A, B, C, D> Distribution<(A, B, C, D)> for StandardUniform
where StandardUniform: Distribution<A>, StandardUniform: Distribution<B>, StandardUniform: Distribution<C>, StandardUniform: Distribution<D> {
    fn sample<R: Rng>(&self, rng: &mut R) -> (A, B, C, D) {
        let a: A = self.sample(rng);
        let b: B = self.sample(rng);
        let c: C = self.sample(rng);
        let d: D = self.sample(rng);
        (a, b, c, d)
    }
}

impl<A, B, C, D, E> Distribution<(A, B, C, D, E)> for StandardUniform
where StandardUniform: Distribution<A>, StandardUniform: Distribution<B>, StandardUniform: Distribution<C>, StandardUniform: Distribution<D>, StandardUniform: Distribution<E> {
    fn sample<R: Rng>(&self, rng: &mut R) -> (A, B, C, D, E) {
        let a: A = self.sample(rng);
        let b: B = self.sample(rng);
        let c: C = self.sample(rng);
        let d: D = self.sample(rng);
        let e: E = self.sample(rng);
        (a, b, c, d, e)
    }
}

impl<A, B, C, D, E, F> Distribution<(A, B, C, D, E, F)> for StandardUniform
where StandardUniform: Distribution<A>, StandardUniform: Distribution<B>, StandardUniform: Distribution<C>, StandardUniform: Distribution<D>, StandardUniform: Distribution<E>, StandardUniform: Distribution<F> {
    fn sample<R: Rng>(&self, rng: &mut R) -> (A, B, C, D, E, F) {
        let a: A = self.sample(rng);
        let b: B = self.sample(rng);
        let c: C = self.sample(rng);
        let d: D = self.sample(rng);
        let e: E = self.sample(rng);
        let f: F = self.sample(rng);
        (a, b, c, d, e, f)
    }
}

impl<T, const N: usize> Distribution<[T; N]> for StandardUniform where StandardUniform: Distribution<T> {
    fn sample<R: Rng>(&self, rng: &mut R) -> [T; N] {
        let p = crate::rt::alloc_array::<T>(if N == 0 { 1 } else { N });
        let mut i = 0;
        while i < N {
            let x: T = self.sample(rng);
            unsafe { p.add(i).write(x); }
            i += 1;
        }
        unsafe { *(p as *const [T; N]) }
    }
}

impl Distribution<f64> for Open01 {
    fn sample<R: Rng>(&self, rng: &mut R) -> f64 {
        f64::from_bits((rng.next_u64() >> 12) | 0x3ff0000000000000) - (1.0 - f64::EPSILON / 2.0)
    }
}

impl Distribution<f32> for Open01 {
    fn sample<R: Rng>(&self, rng: &mut R) -> f32 {
        f32::from_bits((rng.next_u32() >> 9) | 0x3f800000) - (1.0f32 - f32::EPSILON / 2.0)
    }
}

impl Distribution<f64> for OpenClosed01 {
    fn sample<R: Rng>(&self, rng: &mut R) -> f64 { ((rng.next_u64() >> 11) + 1) as f64 * (1.0 / 9007199254740992.0) }
}

impl Distribution<f32> for OpenClosed01 {
    fn sample<R: Rng>(&self, rng: &mut R) -> f32 { ((rng.next_u32() >> 8) + 1) as f32 * (1.0f32 / 16777216.0) }
}

const ALPHANUMERIC: &str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";

impl Distribution<u8> for Alphanumeric {
    // 6 bits, rejecting 62 and 63.
    fn sample<R: Rng>(&self, rng: &mut R) -> u8 {
        loop {
            let v = rng.next_u32() >> 26;
            if v < 62 { return ALPHANUMERIC.as_bytes()[v as usize]; }
        }
    }
}

/// Random strings of a distribution's chars.
///
///     let id = Alphanumeric.sample_string(&mut rng, 16);
pub trait SampleString {
    /// Appends len chars to s.
    fn append_string<R: Rng>(&self, rng: &mut R, s: &mut String, len: usize);

    /// A string of len chars.
    fn sample_string<R: Rng>(&self, rng: &mut R, len: usize) -> String {
        let mut s = String::new();
        self.append_string(rng, &mut s, len);
        s
    }
}

impl SampleString for Alphanumeric {
    fn append_string<R: Rng>(&self, rng: &mut R, s: &mut String, len: usize) {
        let mut i = 0;
        while i < len {
            let b: u8 = self.sample(rng);
            s.push(b as char);
            i += 1;
        }
    }
}

impl SampleString for StandardUniform {
    fn append_string<R: Rng>(&self, rng: &mut R, s: &mut String, len: usize) {
        let mut i = 0;
        while i < len {
            let c: char = self.sample(rng);
            s.push(c);
            i += 1;
        }
    }
}

/// true with probability p.
#[derive(Clone, Debug, PartialEq)]
pub struct Bernoulli {
    // true when a u64 is below p_int (u64::MAX: always).
    p_int: u64,
}

/// Bernoulli::new of a p outside [0, 1].
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum BernoulliError {
    InvalidProbability,
}

impl Display for BernoulliError {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { f.write_str("p is outside [0, 1] in Bernoulli distribution") }
}

const ALWAYS_TRUE: u64 = 18446744073709551615;
// 2^64
const SCALE: f64 = 18446744073709551616.0;

impl Bernoulli {
    pub fn new(p: f64) -> Result<Bernoulli, BernoulliError> {
        if !(p >= 0.0 && p < 1.0) {
            if p == 1.0 { return Ok(Bernoulli { p_int: ALWAYS_TRUE }); }
            return Err(BernoulliError::InvalidProbability);
        }
        Ok(Bernoulli { p_int: (p * SCALE) as u64 })
    }

    /// Probability numerator / denominator.
    pub fn from_ratio(numerator: u32, denominator: u32) -> Result<Bernoulli, BernoulliError> {
        if numerator > denominator || denominator == 0 { return Err(BernoulliError::InvalidProbability); }
        if numerator == denominator { return Ok(Bernoulli { p_int: ALWAYS_TRUE }); }
        Ok(Bernoulli { p_int: ((numerator as f64 / denominator as f64) * SCALE) as u64 })
    }

    /// The probability of true.
    pub fn p(&self) -> f64 { if self.p_int == ALWAYS_TRUE { 1.0 } else { self.p_int as f64 / SCALE } }
}

impl Distribution<bool> for Bernoulli {
    fn sample<R: Rng>(&self, rng: &mut R) -> bool {
        if self.p_int == ALWAYS_TRUE { return true; }
        rng.next_u64() < self.p_int
    }
}

// --- The integer types -------------------------------------------------------------
// u8, u16, i8, i16: the low bits of a u32; u128: two u64s, the first low.

impl Distribution<u8> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> u8 { rng.next_u32() as u8 }
}

impl Distribution<u16> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> u16 { rng.next_u32() as u16 }
}

impl Distribution<u32> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> u32 { rng.next_u32() }
}

impl Distribution<u64> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> u64 { rng.next_u64() }
}

impl Distribution<usize> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> usize { rng.next_u64() as usize }
}

impl Distribution<u128> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> u128 { self::uniform::random_u128(rng) }
}

impl Distribution<i8> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> i8 { rng.next_u32() as i8 }
}

impl Distribution<i16> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> i16 { rng.next_u32() as i16 }
}

impl Distribution<i32> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> i32 { rng.next_u32() as i32 }
}

impl Distribution<i64> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> i64 { rng.next_u64() as i64 }
}

impl Distribution<isize> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> isize { rng.next_u64() as isize }
}

impl Distribution<i128> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> i128 { self::uniform::random_u128(rng) as i128 }
}
