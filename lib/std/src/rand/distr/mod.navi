//! Probability distributions, as `rand::distr`.
//!
//! A [`Distribution`](crate::rand::distr::Distribution) draws values with a
//! generator. This module has
//! [`StandardUniform`](crate::rand::distr::StandardUniform) (the "random
//! value of type `T`" behind `rng.random::<T>()`),
//! [`Uniform`](crate::rand::distr::Uniform) (values in a range),
//! [`Bernoulli`](crate::rand::distr::Bernoulli) (`true` with some
//! probability), [`WeightedIndex`](crate::rand::distr::WeightedIndex),
//! [`Open01`](crate::rand::distr::Open01),
//! [`OpenClosed01`](crate::rand::distr::OpenClosed01) and
//! [`Alphanumeric`](crate::rand::distr::Alphanumeric).
//!
//! # Examples
//!
//! ```
//! use std::rand;
//! use std::rand::distr::{Bernoulli, Distribution, Uniform};
//!
//! let mut rng = rand::rng();
//! let coin = Bernoulli::new(0.5).unwrap();
//! let heads: bool = coin.sample(&mut rng);
//! let digits: Vec<u8> = Uniform::new(0u8, 10).unwrap().sample_iter(&mut rng).take(4).collect();
//! assert(digits.iter().all(|d: &u8| -> bool { *d < 10 }));
//! ```

pub mod uniform;
pub mod weighted;

pub use self::uniform::Uniform;
pub use self::weighted::WeightedIndex;

use crate::fmt::{self, Debug, Display, Formatter};
use crate::marker::PhantomData;
use crate::rand::{Rng, RngCore};

/// A probability distribution: something values of type `T` can be drawn
/// from with a generator.
///
/// # Examples
///
/// ```
/// use std::rand;
/// use std::rand::distr::{Distribution, Uniform};
///
/// let die = Uniform::new_inclusive(1, 6).unwrap();
/// let roll: i32 = die.sample(&mut rand::rng());
/// assert(roll >= 1 && roll <= 6);
/// ```
pub trait Distribution<T> {
    /// Draws a value with `rng`.
    fn sample<R: Rng>(&self, rng: &mut R) -> T;

    /// Returns an endless iterator of values drawn with `rng` (which the
    /// iterator borrows).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::rand;
    /// use std::rand::distr::{Distribution, Uniform};
    ///
    /// let mut rng = rand::rng();
    /// let v: Vec<u32> = Uniform::new(0u32, 100).unwrap().sample_iter(&mut rng).take(10).collect();
    /// assert_eq(v.len(), 10);
    /// ```
    fn sample_iter<R: Rng>(self, rng: &mut R) -> DistIter<Self, R, T> {
        DistIter {
            distr: self,
            rng,
            t: PhantomData,
        }
    }

    /// Returns the distribution of `f` applied to this one's values.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::rand;
    /// use std::rand::distr::{Distribution, Uniform};
    ///
    /// let even = Uniform::new(0u32, 50).unwrap().map(|x: u32| -> u32 { x * 2 });
    /// let n = even.sample(&mut rand::rng());
    /// assert(n % 2 == 0 && n < 100);
    /// ```
    fn map<U>(self, f: fn(T) -> U) -> DistMap<Self, T, U> {
        DistMap { distr: self, f }
    }
}

/// The endless iterator returned by [`Distribution::sample_iter`] and
/// [`Rng::sample_iter`].
pub struct DistIter<D, R, T> {
    distr: D,
    rng: &mut R,
    t: PhantomData<T>,
}

impl<D, R, T> Iterator for DistIter<D, R, T>
where
    D: Distribution<T>,
    R: Rng,
{
    type Item = T;
    fn next(&mut self) -> Option<T> {
        Some(self.distr.sample(self.rng))
    }
}

/// The distribution returned by [`Distribution::map`].
pub struct DistMap<D, T, U> {
    distr: D,
    f: fn(T) -> U,
}

impl<D, T, U> Distribution<U> for DistMap<D, T, U>
where
    D: Distribution<T>,
{
    fn sample<R: Rng>(&self, rng: &mut R) -> U {
        (self.f)(self.distr.sample(rng))
    }
}

/// The default distribution of each type, what [`Rng::random`] draws:
/// integers uniform over all their values, floats uniform in `[0, 1)`,
/// `bool` fair, `char` uniform over the Unicode scalar values; tuples,
/// arrays and `Option` of such types element by element.
///
/// # Examples
///
/// ```
/// use std::rand;
/// use std::rand::distr::{Distribution, StandardUniform};
///
/// let mut rng = rand::rng();
/// let x: f32 = StandardUniform.sample(&mut rng);
/// assert(x >= 0.0 && x < 1.0);
/// let pair: (u8, bool) = StandardUniform.sample(&mut rng);
/// ```
#[derive(Clone, Debug, Default)]
pub struct StandardUniform;

/// rand 0.8's name of [`StandardUniform`].
pub type Standard = StandardUniform;

/// Floats (`f32`, `f64`) uniform in the open interval `(0, 1)`: never 0,
/// never 1.
///
/// # Examples
///
/// ```
/// use std::rand;
/// use std::rand::distr::{Distribution, Open01};
///
/// let x: f64 = Open01.sample(&mut rand::rng());
/// assert(x > 0.0 && x < 1.0);
/// ```
#[derive(Clone, Debug, Default)]
pub struct Open01;

/// Floats (`f32`, `f64`) uniform in the half-open interval `(0, 1]`:
/// never 0, so its logarithm is finite.
///
/// # Examples
///
/// ```
/// use std::rand;
/// use std::rand::distr::{Distribution, OpenClosed01};
///
/// let x: f64 = OpenClosed01.sample(&mut rand::rng());
/// assert(x > 0.0 && x <= 1.0);
/// ```
#[derive(Clone, Debug, Default)]
pub struct OpenClosed01;

/// ASCII letters and digits: a `u8` uniform over `A-Z`, `a-z` and `0-9`.
///
/// # Examples
///
/// ```
/// use std::rand;
/// use std::rand::distr::{Alphanumeric, SampleString};
///
/// let id = Alphanumeric.sample_string(&mut rand::rng(), 16);
/// assert_eq(id.len(), 16);
/// assert(id.chars().all(|c: char| -> bool { c.is_ascii_alphanumeric() }));
/// ```
#[derive(Clone, Debug, Default)]
pub struct Alphanumeric;

impl Distribution<bool> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> bool {
        (rng.next_u32() as i32) < 0
    }
}

impl Distribution<f64> for StandardUniform {
    // 53 random bits.
    fn sample<R: Rng>(&self, rng: &mut R) -> f64 {
        (rng.next_u64() >> 11) as f64 * (1.0 / 9007199254740992.0)
    }
}

impl Distribution<f32> for StandardUniform {
    // 24 random bits.
    fn sample<R: Rng>(&self, rng: &mut R) -> f32 {
        (rng.next_u32() >> 8) as f32 * (1.0f32 / 16777216.0)
    }
}

impl Distribution<char> for StandardUniform {
    // Uniform over [0, 0x110000) without the surrogates.
    fn sample<R: Rng>(&self, rng: &mut R) -> char {
        let gap: u32 = 0xdfff - 0xd800 + 1;
        let mut n: u32 = rng.random_range(gap..0x110000);
        if n <= 0xdfff {
            n -= gap;
        }
        char::from_u32(n).unwrap()
    }
}

impl Distribution<()> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> () {
        ()
    }
}

impl<A> Distribution<(A,)> for StandardUniform
where
    StandardUniform: Distribution<A>,
{
    fn sample<R: Rng>(&self, rng: &mut R) -> (A,) {
        (self.sample(rng),)
    }
}

impl<A, B> Distribution<(A, B)> for StandardUniform
where
    StandardUniform: Distribution<A>,
    StandardUniform: Distribution<B>,
{
    fn sample<R: Rng>(&self, rng: &mut R) -> (A, B) {
        let a: A = self.sample(rng);
        let b: B = self.sample(rng);
        (a, b)
    }
}

impl<A, B, C> Distribution<(A, B, C)> for StandardUniform
where
    StandardUniform: Distribution<A>,
    StandardUniform: Distribution<B>,
    StandardUniform: Distribution<C>,
{
    fn sample<R: Rng>(&self, rng: &mut R) -> (A, B, C) {
        let a: A = self.sample(rng);
        let b: B = self.sample(rng);
        let c: C = self.sample(rng);
        (a, b, c)
    }
}

impl<A, B, C, D> Distribution<(A, B, C, D)> for StandardUniform
where
    StandardUniform: Distribution<A>,
    StandardUniform: Distribution<B>,
    StandardUniform: Distribution<C>,
    StandardUniform: Distribution<D>,
{
    fn sample<R: Rng>(&self, rng: &mut R) -> (A, B, C, D) {
        let a: A = self.sample(rng);
        let b: B = self.sample(rng);
        let c: C = self.sample(rng);
        let d: D = self.sample(rng);
        (a, b, c, d)
    }
}

impl<A, B, C, D, E> Distribution<(A, B, C, D, E)> for StandardUniform
where
    StandardUniform: Distribution<A>,
    StandardUniform: Distribution<B>,
    StandardUniform: Distribution<C>,
    StandardUniform: Distribution<D>,
    StandardUniform: Distribution<E>,
{
    fn sample<R: Rng>(&self, rng: &mut R) -> (A, B, C, D, E) {
        let a: A = self.sample(rng);
        let b: B = self.sample(rng);
        let c: C = self.sample(rng);
        let d: D = self.sample(rng);
        let e: E = self.sample(rng);
        (a, b, c, d, e)
    }
}

impl<A, B, C, D, E, F> Distribution<(A, B, C, D, E, F)> for StandardUniform
where
    StandardUniform: Distribution<A>,
    StandardUniform: Distribution<B>,
    StandardUniform: Distribution<C>,
    StandardUniform: Distribution<D>,
    StandardUniform: Distribution<E>,
    StandardUniform: Distribution<F>,
{
    fn sample<R: Rng>(&self, rng: &mut R) -> (A, B, C, D, E, F) {
        let a: A = self.sample(rng);
        let b: B = self.sample(rng);
        let c: C = self.sample(rng);
        let d: D = self.sample(rng);
        let e: E = self.sample(rng);
        let f: F = self.sample(rng);
        (a, b, c, d, e, f)
    }
}

impl<T, const N: usize> Distribution<[T; N]> for StandardUniform
where
    StandardUniform: Distribution<T>,
{
    fn sample<R: Rng>(&self, rng: &mut R) -> [T; N] {
        let p = crate::rt::alloc_array::<T>(if N == 0 { 1 } else { N });
        let mut i = 0;
        while i < N {
            let x: T = self.sample(rng);
            unsafe {
                p.add(i).write(x);
            }
            i += 1;
        }
        unsafe { *(p as *const [T; N]) }
    }
}

impl Distribution<f64> for Open01 {
    fn sample<R: Rng>(&self, rng: &mut R) -> f64 {
        f64::from_bits((rng.next_u64() >> 12) | 0x3ff0000000000000) - (1.0 - f64::EPSILON / 2.0)
    }
}

impl Distribution<f32> for Open01 {
    fn sample<R: Rng>(&self, rng: &mut R) -> f32 {
        f32::from_bits((rng.next_u32() >> 9) | 0x3f800000) - (1.0f32 - f32::EPSILON / 2.0)
    }
}

impl Distribution<f64> for OpenClosed01 {
    fn sample<R: Rng>(&self, rng: &mut R) -> f64 {
        ((rng.next_u64() >> 11) + 1) as f64 * (1.0 / 9007199254740992.0)
    }
}

impl Distribution<f32> for OpenClosed01 {
    fn sample<R: Rng>(&self, rng: &mut R) -> f32 {
        ((rng.next_u32() >> 8) + 1) as f32 * (1.0f32 / 16777216.0)
    }
}

const ALPHANUMERIC: &str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";

impl Distribution<u8> for Alphanumeric {
    // 6 bits, rejecting 62 and 63.
    fn sample<R: Rng>(&self, rng: &mut R) -> u8 {
        loop {
            let v = rng.next_u32() >> 26;
            if v < 62 {
                return ALPHANUMERIC.as_bytes()[v as usize];
            }
        }
    }
}

/// Random strings of a distribution's characters, for
/// [`Alphanumeric`] and [`StandardUniform`].
///
/// # Examples
///
/// ```
/// use std::rand;
/// use std::rand::distr::{Alphanumeric, SampleString};
///
/// let mut s = String::from("id-");
/// Alphanumeric.append_string(&mut rand::rng(), &mut s, 8);
/// assert_eq(s.len(), 11);
/// ```
pub trait SampleString {
    /// Appends `len` random characters to `s`.
    fn append_string<R: Rng>(&self, rng: &mut R, s: &mut String, len: usize);

    /// Returns a string of `len` random characters.
    fn sample_string<R: Rng>(&self, rng: &mut R, len: usize) -> String {
        let mut s = String::new();
        self.append_string(rng, &mut s, len);
        s
    }
}

impl SampleString for Alphanumeric {
    fn append_string<R: Rng>(&self, rng: &mut R, s: &mut String, len: usize) {
        let mut i = 0;
        while i < len {
            let b: u8 = self.sample(rng);
            s.push(b as char);
            i += 1;
        }
    }
}

impl SampleString for StandardUniform {
    fn append_string<R: Rng>(&self, rng: &mut R, s: &mut String, len: usize) {
        let mut i = 0;
        while i < len {
            let c: char = self.sample(rng);
            s.push(c);
            i += 1;
        }
    }
}

/// The Bernoulli distribution: `true` with probability `p`.
///
/// # Examples
///
/// ```
/// use std::rand;
/// use std::rand::distr::{Bernoulli, Distribution};
///
/// let d = Bernoulli::new(0.3).unwrap();
/// let v: bool = d.sample(&mut rand::rng());
/// assert(Bernoulli::new(1.0).unwrap().sample(&mut rand::rng()));
/// ```
#[derive(Clone, Debug, PartialEq)]
pub struct Bernoulli {
    // true when a u64 is below p_int (u64::MAX: always).
    p_int: u64,
}

/// The error returned by [`Bernoulli::new`] and [`Bernoulli::from_ratio`]
/// for a probability outside `[0, 1]`.
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum BernoulliError {
    /// The probability is not in `[0, 1]`.
    InvalidProbability,
}

impl Display for BernoulliError {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("p is outside [0, 1] in Bernoulli distribution")
    }
}

const ALWAYS_TRUE: u64 = 18446744073709551615;
// 2^64
const SCALE: f64 = 18446744073709551616.0;

impl Bernoulli {
    /// Creates the distribution that gives `true` with probability `p`.
    ///
    /// The probability is kept with 64 bits of precision, as in rand.
    ///
    /// # Errors
    ///
    /// [`BernoulliError::InvalidProbability`] unless `0.0 <= p <= 1.0`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::rand::distr::{Bernoulli, BernoulliError};
    ///
    /// assert(Bernoulli::new(0.25).is_ok());
    /// assert_eq(Bernoulli::new(1.5), Err(BernoulliError::InvalidProbability));
    /// ```
    pub fn new(p: f64) -> Result<Bernoulli, BernoulliError> {
        if !(p >= 0.0 && p < 1.0) {
            if p == 1.0 {
                return Ok(Bernoulli { p_int: ALWAYS_TRUE });
            }
            return Err(BernoulliError::InvalidProbability);
        }
        Ok(Bernoulli {
            p_int: (p * SCALE) as u64,
        })
    }

    /// Creates the distribution that gives `true` with probability
    /// `numerator / denominator`.
    ///
    /// # Errors
    ///
    /// [`BernoulliError::InvalidProbability`] if `denominator` is 0 or less
    /// than `numerator`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::rand::distr::Bernoulli;
    ///
    /// assert_eq(Bernoulli::from_ratio(1, 4).unwrap().p(), 0.25);
    /// assert(Bernoulli::from_ratio(5, 4).is_err());
    /// ```
    pub fn from_ratio(numerator: u32, denominator: u32) -> Result<Bernoulli, BernoulliError> {
        if numerator > denominator || denominator == 0 {
            return Err(BernoulliError::InvalidProbability);
        }
        if numerator == denominator {
            return Ok(Bernoulli { p_int: ALWAYS_TRUE });
        }
        Ok(Bernoulli {
            p_int: ((numerator as f64 / denominator as f64) * SCALE) as u64,
        })
    }

    /// Returns the probability of `true`.
    pub fn p(&self) -> f64 {
        if self.p_int == ALWAYS_TRUE {
            1.0
        } else {
            self.p_int as f64 / SCALE
        }
    }
}

impl Distribution<bool> for Bernoulli {
    fn sample<R: Rng>(&self, rng: &mut R) -> bool {
        if self.p_int == ALWAYS_TRUE {
            return true;
        }
        rng.next_u64() < self.p_int
    }
}

// --- The integer types -------------------------------------------------------
// u8, u16, i8, i16: the low bits of a u32; u128: two u64s, the first low.

impl Distribution<u8> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> u8 {
        rng.next_u32() as u8
    }
}

impl Distribution<u16> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> u16 {
        rng.next_u32() as u16
    }
}

impl Distribution<u32> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> u32 {
        rng.next_u32()
    }
}

impl Distribution<u64> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> u64 {
        rng.next_u64()
    }
}

impl Distribution<usize> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> usize {
        rng.next_u64() as usize
    }
}

impl Distribution<u128> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> u128 {
        self::uniform::random_u128(rng)
    }
}

impl Distribution<i8> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> i8 {
        rng.next_u32() as i8
    }
}

impl Distribution<i16> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> i16 {
        rng.next_u32() as i16
    }
}

impl Distribution<i32> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> i32 {
        rng.next_u32() as i32
    }
}

impl Distribution<i64> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> i64 {
        rng.next_u64() as i64
    }
}

impl Distribution<isize> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> isize {
        rng.next_u64() as isize
    }
}

impl Distribution<i128> for StandardUniform {
    fn sample<R: Rng>(&self, rng: &mut R) -> i128 {
        self::uniform::random_u128(rng) as i128
    }
}
