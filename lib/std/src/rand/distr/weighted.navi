//! Choosing indices by weight, as `rand::distr::weighted`.
//!
//! # Examples
//!
//! ```
//! use std::{
//!     rand,
//!     rand::distr::{Distribution, WeightedIndex},
//! };
//!
//! let w = WeightedIndex::new([2, 1, 1]).unwrap();
//! let i = w.sample(&mut rand::rng()); // 0 half of the time
//! assert(i < 3);
//! ```

use crate::{
    fmt::{self, Display, Formatter},
    ops::Add,
    rand::{
        Rng,
        distr::{
            Distribution,
            uniform::{SampleUniform, Uniform},
        },
    },
};

/// The error returned by [`WeightedIndex::new`] when weights cannot be
/// used.
///
/// # Examples
///
/// ```
/// use std::rand::distr::{WeightedIndex, weighted::Error};
///
/// assert(WeightedIndex::new([0, 0]).is_err());
/// assert_eq(
///     WeightedIndex::new([0, 0]).unwrap_err(),
///     Error::InsufficientNonZero,
/// );
/// assert_eq(
///     WeightedIndex::new([1.0, -1.0]).unwrap_err(),
///     Error::InvalidWeight,
/// );
/// ```
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum Error {
    /// There are no weights.
    InvalidInput,
    /// A weight is negative (or NaN).
    InvalidWeight,
    /// All the weights are zero.
    InsufficientNonZero,
    /// The sum of the weights overflows.
    Overflow,
}

impl Display for Error {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str(match self {
            Error::InvalidInput => "Weights sequence is empty/too long/unordered",
            Error::InvalidWeight => "A weight is negative, too large or not a valid number",
            Error::InsufficientNonZero => "Not enough weights > zero",
            Error::Overflow => "Overflow when summing weights",
        })
    }
}

/// The distribution of indices `0..n` where index `i` has probability
/// `weights[i] / sum`.
///
/// As rand's: a uniform value below the sum is looked up among the
/// cumulative weights. The weights can be integers or floats.
///
/// # Examples
///
/// ```
/// use std::{
///     rand,
///     rand::distr::{Distribution, WeightedIndex},
/// };
///
/// let choices = ['a', 'b', 'c'];
/// let weights = [2, 0, 1];
/// let dist = WeightedIndex::new(weights).unwrap();
/// let mut rng = rand::rng();
/// let i: usize = dist.sample(&mut rng);
/// let c = choices[i];
/// assert(c == 'a' || c == 'c'); // 'b' has weight 0
/// assert_eq(dist.total_weight(), 3);
/// ```
#[derive(Clone, Debug)]
pub struct WeightedIndex<X> {
    cumulative: Vec<X>,
    total: X,
    distr: Uniform<X>,
}

impl<X> WeightedIndex<X>
where
    X: SampleUniform + PartialOrd + Clone + Default + Add<Output = X>,
{
    /// Creates the distribution of the given weights.
    ///
    /// # Errors
    ///
    /// [`Error::InvalidInput`] if there are no weights,
    /// [`Error::InvalidWeight`] if one is negative or NaN, and
    /// [`Error::InsufficientNonZero`] if all are zero.
    pub fn new<I: IntoIterator<Item = X>>(weights: I) -> Result<WeightedIndex<X>, Error> {
        let mut it = weights.into_iter();
        let mut total = match it.next() {
            Some(w) => w,
            None => return Err(Error::InvalidInput),
        };
        let zero = X::default();
        if !(total >= zero) {
            return Err(Error::InvalidWeight);
        }
        let mut cumulative: Vec<X> = Vec::new();
        for w in it {
            if !(w >= zero) {
                return Err(Error::InvalidWeight);
            }
            cumulative.push(total.clone());
            total = total + w;
        }
        if total == zero {
            return Err(Error::InsufficientNonZero);
        }
        let distr = match Uniform::new(zero, total.clone()) {
            Ok(d) => d,
            Err(_) => return Err(Error::InvalidWeight),
        };
        Ok(WeightedIndex {
            cumulative,
            total,
            distr,
        })
    }

    /// Returns the sum of the weights.
    pub fn total_weight(&self) -> X {
        self.total.clone()
    }
}

impl<X> Distribution<usize> for WeightedIndex<X>
where
    X: SampleUniform + PartialOrd + Clone,
{
    fn sample<R: Rng>(&self, rng: &mut R) -> usize {
        let chosen = self.distr.sample(rng);
        // The first cumulative weight above chosen.
        let mut lo = 0;
        let mut hi = self.cumulative.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if self.cumulative[mid] <= chosen {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        lo
    }
}
