//! Choosing indices by weight (rand::distr::weighted).
//!
//!     let w = WeightedIndex::new([2, 1, 1]).unwrap();
//!     let i = w.sample(&mut rng);    // 0 half of the time

use crate::fmt::{self, Display, Formatter};
use crate::ops::Add;
use crate::rand::Rng;
use crate::rand::distr::Distribution;
use crate::rand::distr::uniform::{SampleUniform, Uniform};

/// Why weights cannot be used.
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum Error {
    /// No weights.
    InvalidInput,
    /// A weight is negative (or NaN).
    InvalidWeight,
    /// All the weights are zero.
    InsufficientNonZero,
    /// The sum of the weights overflows.
    Overflow,
}

impl Display for Error {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str(match self {
            Error::InvalidInput => "Weights sequence is empty/too long/unordered",
            Error::InvalidWeight => "A weight is negative, too large or not a valid number",
            Error::InsufficientNonZero => "Not enough weights > zero",
            Error::Overflow => "Overflow when summing weights",
        })
    }
}

/// Indices 0..n chosen with probability weight[i] / sum (as rand's: a
/// uniform value below the sum, found among the cumulative weights).
#[derive(Clone, Debug)]
pub struct WeightedIndex<X> {
    cumulative: Vec<X>,
    total: X,
    distr: Uniform<X>,
}

impl<X> WeightedIndex<X>
where
    X: SampleUniform + PartialOrd + Clone + Default + Add<Output = X>,
{
    pub fn new<I: IntoIterator<Item = X>>(weights: I) -> Result<WeightedIndex<X>, Error> {
        let mut it = weights.into_iter();
        let mut total = match it.next() {
            Some(w) => w,
            None => return Err(Error::InvalidInput),
        };
        let zero = X::default();
        if !(total >= zero) {
            return Err(Error::InvalidWeight);
        }
        let mut cumulative: Vec<X> = Vec::new();
        for w in it {
            if !(w >= zero) {
                return Err(Error::InvalidWeight);
            }
            cumulative.push(total.clone());
            total = total + w;
        }
        if total == zero {
            return Err(Error::InsufficientNonZero);
        }
        let distr = match Uniform::new(zero, total.clone()) {
            Ok(d) => d,
            Err(_) => return Err(Error::InvalidWeight),
        };
        Ok(WeightedIndex {
            cumulative,
            total,
            distr,
        })
    }

    /// The sum of the weights.
    pub fn total_weight(&self) -> X {
        self.total.clone()
    }
}

impl<X> Distribution<usize> for WeightedIndex<X>
where
    X: SampleUniform + PartialOrd + Clone,
{
    fn sample<R: Rng>(&self, rng: &mut R) -> usize {
        let chosen = self.distr.sample(rng);
        // The first cumulative weight above chosen.
        let mut lo = 0;
        let mut hi = self.cumulative.len();
        while lo < hi {
            let mid = (lo + hi) / 2;
            if self.cumulative[mid] <= chosen {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        lo
    }
}
