impl SampleUniform for isize {
    fn sample_checked<R: Rng>(low: &isize, high: &isize, inclusive: bool, rng: &mut R) -> isize {
        let hi = if inclusive { *high } else { *high - 1 };
        let range = hi.wrapping_sub(*low).wrapping_add(1) as u64 as u64;
        if range == 0 {
            return rng.next_u64() as isize;
        }
        low.wrapping_add(canon_u64(rng, range) as isize)
    }

    fn sample_uniform<R: Rng>(low: &isize, high: &isize, inclusive: bool, rng: &mut R) -> isize {
        let hi = if inclusive { *high } else { *high - 1 };
        let range = hi.wrapping_sub(*low).wrapping_add(1) as u64 as u64;
        if range == 0 {
            return rng.next_u64() as isize;
        }
        low.wrapping_add(lemire_u64(rng, range) as isize)
    }
}

impl SampleUniform for i128 {
    fn sample_checked<R: Rng>(low: &i128, high: &i128, inclusive: bool, rng: &mut R) -> i128 {
        let hi = if inclusive { *high } else { *high - 1 };
        let range = hi.wrapping_sub(*low).wrapping_add(1) as u128 as u128;
        if range == 0 {
            return random_u128(rng) as i128;
        }
        low.wrapping_add(canon_u128(rng, range) as i128)
    }

    fn sample_uniform<R: Rng>(low: &i128, high: &i128, inclusive: bool, rng: &mut R) -> i128 {
        let hi = if inclusive { *high } else { *high - 1 };
        let range = hi.wrapping_sub(*low).wrapping_add(1) as u128 as u128;
        if range == 0 {
            return random_u128(rng) as i128;
        }
        low.wrapping_add(lemire_u128(rng, range) as i128)
    }
}

// usize draws a u32 when the range's bounds fit one (as rand's
// UniformUsize, so results do not depend on the pointer width).
impl SampleUniform for usize {
    fn sample_checked<R: Rng>(low: &usize, high: &usize, inclusive: bool, rng: &mut R) -> usize {
        if *high > 0xffffffff {
            return u64::sample_checked(&(*low as u64), &(*high as u64), inclusive, rng) as usize;
        }
        u32::sample_checked(&(*low as u32), &(*high as u32), inclusive, rng) as usize
    }

    fn sample_uniform<R: Rng>(low: &usize, high: &usize, inclusive: bool, rng: &mut R) -> usize {
        let hi = if inclusive { *high } else { *high - 1 };
        if hi > 0xffffffff {
            return u64::sample_uniform(&(*low as u64), &(hi as u64), true, rng) as usize;
        }
        u32::sample_uniform(&(*low as u32), &(hi as u32), true, rng) as usize
    }
}
