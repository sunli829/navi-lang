//! Filesystem manipulation operations.
//!
//! This module contains basic methods to manipulate the contents of the local
//! filesystem: the [`File`] type for reading and writing files, [`OpenOptions`]
//! to choose how a file is opened, [`Metadata`], [`Permissions`] and
//! [`FileType`] to inspect files, [`read_dir`] and [`DirBuilder`] for
//! directories, and whole-file helpers such as [`read`], [`read_to_string`] and
//! [`write`].
//!
//! It is implemented on the OS layer (the private `std::sys`: file descriptors
//! and `stat` on POSIX, Win32 handles and the UTF-16 `*W` functions on
//! Windows). All paths are UTF-8 strings (navi has no `OsStr`).
//!
//! navi has no Drop, so unlike Rust's a [`File`] is not closed when it goes out
//! of scope: call [`File::close`] (usually with `defer`). The whole-file
//! functions ([`read`], [`write`], [`copy`], ...) close the files they open
//! themselves.
//!
//! # Examples
//!
//! ```
//! use std::fs;
//!
//! fn main() -> std::io::Result<()> {
//!     let dir = std::env::temp_dir().join("navi-doc-fs-module");
//!     fs::create_dir_all(&dir)?;
//!     fs::write(dir.join("hello.txt"), "Hello, world!")?;
//!     assert_eq(fs::read_to_string(dir.join("hello.txt"))?, "Hello, world!");
//!     fs::remove_dir_all(&dir)?;
//!     Ok(())
//! }
//! ```

mod imp;
pub use self::imp::*;
