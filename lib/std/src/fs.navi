//! Files and directories. navic builds them on the OS layer (std::sys,
//! see fs/imp.navi); the stdio-based version below is stage0's (frozen).

#[cfg(feature = "navic")]
mod imp;
#[cfg(feature = "navic")]
pub use self::imp::*;

#[cfg(not(feature = "navic"))]
use crate::io::{self, Error, ErrorKind, Read, Write};
#[cfg(not(feature = "navic"))]
use crate::path::{Path, PathBuf};
#[cfg(not(feature = "navic"))]
use crate::string::String;
#[cfg(not(feature = "navic"))]
use crate::convert::AsRef;

/// An open file. navi has no Drop: close it with close() (or use the
/// whole-file helpers below).
#[cfg(not(feature = "navic"))]
pub struct File { h: usize }

#[cfg(not(feature = "navic"))]
fn not_found(path: &Path) -> Error {
    Error::new(ErrorKind::NotFound, `${path.display()}: no such file or directory`.as_str())
}

#[cfg(not(feature = "navic"))]
impl File {
    pub fn open<P: AsRef<Path>>(path: P) -> io::Result<File> {
        let p = path.as_ref();
        let h = crate::rt::fs_open(p.to_str().unwrap(), 0);
        if h == 0 { Err(not_found(p)) } else { Ok(File { h }) }
    }

    pub fn create<P: AsRef<Path>>(path: P) -> io::Result<File> {
        let p = path.as_ref();
        let h = crate::rt::fs_open(p.to_str().unwrap(), 1);
        if h == 0 {
            Err(Error::new(ErrorKind::PermissionDenied, `${p.display()}: cannot create file`.as_str()))
        } else {
            Ok(File { h })
        }
    }

    pub fn close(&mut self) {
        if self.h != 0 {
            crate::rt::fs_close(self.h);
            self.h = 0;
        }
    }
}

#[cfg(not(feature = "navic"))]
impl Read for File {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        Ok(crate::rt::fs_read(self.h, crate::rt::slice_ptr(buf) as *mut u8, buf.len()))
    }
}

#[cfg(not(feature = "navic"))]
impl Write for File {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        Ok(crate::rt::fs_write(self.h, crate::rt::slice_ptr(buf), buf.len()))
    }
    fn flush(&mut self) -> io::Result<()> { Ok(()) }
}

/// Reads a whole file.
#[cfg(not(feature = "navic"))]
pub fn read<P: AsRef<Path>>(path: P) -> io::Result<Vec<u8>> {
    let mut f = File::open(path)?;
    let mut buf = Vec::new();
    let r = f.read_to_end(&mut buf);
    f.close();
    r?;
    Ok(buf)
}

/// Reads a whole file as UTF-8.
#[cfg(not(feature = "navic"))]
pub fn read_to_string<P: AsRef<Path>>(path: P) -> io::Result<String> {
    let bytes = read(path)?;
    match String::from_utf8(bytes) {
        Ok(s) => Ok(s),
        Err(_) => Err(Error::new(ErrorKind::InvalidData, "stream did not contain valid UTF-8")),
    }
}

/// Writes a whole file, replacing it.
#[cfg(not(feature = "navic"))]
pub fn write<P: AsRef<Path>, C: AsRef<[u8]>>(path: P, contents: C) -> io::Result<()> {
    let mut f = File::create(path)?;
    let r = f.write_all(contents.as_ref());
    f.close();
    r
}

#[cfg(not(feature = "navic"))]
pub fn create_dir<P: AsRef<Path>>(path: P) -> io::Result<()> {
    let p = path.as_ref();
    if crate::rt::fs_mkdir(p.to_str().unwrap()) {
        Ok(())
    } else {
        Err(Error::new(ErrorKind::Other, `${p.display()}: cannot create directory`.as_str()))
    }
}

/// Creates a directory and its missing parents.
#[cfg(not(feature = "navic"))]
pub fn create_dir_all<P: AsRef<Path>>(path: P) -> io::Result<()> {
    let p = path.as_ref();
    if p.is_dir() { return Ok(()); }
    match p.parent() {
        Some(parent) => { if parent.to_str().unwrap().len() > 0 { create_dir_all(parent)?; } }
        None => {}
    }
    if p.is_dir() { return Ok(()); }
    create_dir(p)
}

#[cfg(not(feature = "navic"))]
pub fn remove_file<P: AsRef<Path>>(path: P) -> io::Result<()> {
    let p = path.as_ref();
    if crate::rt::fs_remove(p.to_str().unwrap()) { Ok(()) } else { Err(not_found(p)) }
}

/// Whether a path exists (std::fs::exists, stable since Rust 1.81).
#[cfg(not(feature = "navic"))]
pub fn exists<P: AsRef<Path>>(path: P) -> io::Result<bool> { Ok(path.as_ref().exists()) }
