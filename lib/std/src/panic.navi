//! Panics and assertions. These functions replace Rust's panic!/assert!
//! macros; #[track_caller] gives them the caller's location.

use crate::fmt::{Debug, Display};

#[derive(Clone, Debug)]
pub struct Location {
    file: &str,
    line: u32,
    col: u32,
}

impl Location {
    #[track_caller]
    pub fn caller() -> Location { crate::intrinsics::caller_location() }
    pub fn file(&self) -> &str { self.file }
    pub fn line(&self) -> u32 { self.line }
    pub fn column(&self) -> u32 { self.col }
}

/// The value a caught panic produces (Rust: Box<dyn Any + Send>, usually
/// holding the message): the message and where the panic happened.
#[derive(Clone, Debug)]
pub struct PanicPayload {
    message: String,
    location: Location,
}

impl PanicPayload {
    pub fn message(&self) -> &str { self.message.as_str() }
    pub fn location(&self) -> &Location { &self.location }
}

impl Display for PanicPayload {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result { f.pad(self.message.as_str()) }
}

/// Calls f, catching a panic in it (after its defers have run). The panic
/// message is still printed when the panic happens, as with Rust's default
/// hook.
pub fn catch_unwind<R>(f: fn() -> R) -> crate::thread::Result<R> {
    let mut out: Option<R> = None;
    let p = crate::rt::try_call(|| { out = Some(f()); });
    if p as usize == 0 { return Ok(out.unwrap()); }
    Err(unsafe { (*(p as *mut PanicPayload)).clone() })
}

/// Panics again with a payload from catch_unwind (the message is printed
/// again).
pub fn resume_unwind(payload: PanicPayload) -> ! {
    let l = payload.location;
    crate::rt::panic_raw(payload.message.as_str(), l.file, l.line, l.col)
}

pub(crate) fn new_payload(msg: &str, file: &str, line: u32, col: u32) -> *mut u8 {
    &mut PanicPayload { message: msg.to_string(), location: Location { file, line, col } } as *mut PanicPayload as *mut u8
}

pub(crate) fn bounds_payload(len: usize, index: usize, file: &str, line: u32, col: u32) -> *mut u8 {
    let msg = `index out of bounds: the len is ${len} but the index is ${index}`.to_string();
    new_payload(msg.as_str(), file, line, col)
}

#[track_caller]
pub fn panic(msg: impl Display) -> ! {
    let s = msg.to_string();
    crate::rt::panic::begin(s.as_str(), Location::caller())
}

#[track_caller]
pub fn todo() -> ! { panic("not yet implemented") }

#[track_caller]
pub fn unimplemented() -> ! { panic("not implemented") }

#[track_caller]
pub fn unreachable() -> ! { panic("internal error: entered unreachable code") }

#[track_caller]
pub fn assert(cond: bool) {
    if !cond { panic("assertion failed"); }
}

#[track_caller]
pub fn assert_msg(cond: bool, msg: impl Display) {
    if !cond { panic(msg); }
}

#[track_caller]
pub fn assert_eq<A, B>(left: A, right: B) where A: PartialEq<B> + Debug, B: Debug {
    if left != right {
        panic(`assertion \`left == right\` failed\n  left: ${left:?}\n right: ${right:?}`);
    }
}

#[track_caller]
pub fn assert_ne<A, B>(left: A, right: B) where A: PartialEq<B> + Debug, B: Debug {
    if left == right {
        panic(`assertion \`left != right\` failed\n  left: ${left:?}\n right: ${right:?}`);
    }
}

/// As assert: navi has one build mode, so debug assertions are always
/// checked (Rust leaves them out of release builds).
#[track_caller]
pub fn debug_assert(cond: bool) { assert(cond); }
