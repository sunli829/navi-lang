//! Panics and assertions. These functions replace Rust's panic!/assert!
//! macros; #[track_caller] gives them the caller's location.
//!
//! A panic ends the current thread (after running its deferred code),
//! printing the message and the location; a panic in the main thread ends
//! the program. [`catch_unwind`] catches one. Integer overflow, an index
//! out of bounds and `unwrap` on `None` are panics too.
//!
//! The functions in this module are in the prelude, except
//! [`catch_unwind`], [`resume_unwind`], [`Location`] and [`PanicPayload`].
//! There is no `debug_assert`: navi has a single build mode and assertions
//! are always checked.
//!
//! # Examples
//!
//! ```
//! fn divide(a: i32, b: i32) -> i32 {
//!     assert_msg(b != 0, "division by zero");
//!     a / b
//! }
//!
//! assert_eq(divide(10, 2), 5);
//! let r = std::panic::catch_unwind(|| divide(1, 0));
//! assert_eq(r.unwrap_err().message(), "division by zero");
//! ```

use crate::fmt::{Debug, Display};

/// The location in the source of a panic or of a call.
///
/// A panic's location is in its [`PanicPayload`]; [`Location::caller`]
/// gives the location of the call to the current `#[track_caller]`
/// function.
///
/// # Examples
///
/// ```
/// use std::panic::Location;
///
/// #[track_caller]
/// fn where_called() -> Location {
///     Location::caller()
/// }
///
/// let l = where_called();
/// assert(l.line() > 0);
/// assert(l.file().ends_with(".navi"));
/// ```
#[derive(Clone, Debug)]
pub struct Location {
    file: &str,
    line: u32,
    col: u32,
}

impl Location {
    /// Returns the source location of the caller of this function.
    ///
    /// In a function marked `#[track_caller]` it is the location of the
    /// call to that function (and so on up the chain of `#[track_caller]`
    /// functions); otherwise the location of the call to `caller` itself.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::panic::Location;
    ///
    /// /// Checks a value, reporting where it was called from.
    /// #[track_caller]
    /// fn check_positive(x: i32) -> Result<i32, String> {
    ///     if x > 0 {
    ///         return Ok(x);
    ///     }
    ///     let l = Location::caller();
    ///     Err(`${l.file()}:${l.line()}: ${x} is not positive`.to_string())
    /// }
    ///
    /// assert_eq(check_positive(3), Ok(3));
    /// let e = check_positive(-1).unwrap_err();
    /// assert(e.ends_with("-1 is not positive"));
    /// ```
    #[track_caller]
    pub fn caller() -> Location {
        crate::intrinsics::caller_location()
    }

    /// Returns the name of the source file.
    ///
    /// # Examples
    ///
    /// ```
    /// let l = std::panic::Location::caller();
    /// assert(l.file().ends_with(".navi"));
    /// ```
    pub fn file(&self) -> &str {
        self.file
    }

    /// Returns the line number (counting from 1).
    ///
    /// # Examples
    ///
    /// ```
    /// let l = std::panic::Location::caller();
    /// assert(l.line() >= 1);
    /// ```
    pub fn line(&self) -> u32 {
        self.line
    }

    /// Returns the column (counting from 1).
    ///
    /// # Examples
    ///
    /// ```
    /// let l = std::panic::Location::caller();
    /// assert(l.column() >= 1);
    /// ```
    pub fn column(&self) -> u32 {
        self.col
    }
}

/// The value a caught panic produces (Rust: Box<dyn Any + Send>, usually
/// holding the message): the message and where the panic happened.
///
/// [`catch_unwind`] and a panicked thread's `join` give it (as the error of
/// `std::thread::Result`); it displays as its message.
///
/// # Examples
///
/// ```
/// use std::panic;
///
/// let r = panic::catch_unwind(|| -> i32 { panic("oops") });
/// let p = r.unwrap_err();
/// assert_eq(p.message(), "oops");
/// assert_eq(p.to_string(), "oops");
/// assert(p.location().line() > 0);
/// ```
#[derive(Clone, Debug)]
pub struct PanicPayload {
    message: String,
    location: Location,
}

impl PanicPayload {
    /// Returns the panic message.
    ///
    /// # Examples
    ///
    /// ```
    /// let r = std::panic::catch_unwind(|| -> u8 { panic(`bad value ${7}`) });
    /// assert_eq(r.unwrap_err().message(), "bad value 7");
    /// ```
    pub fn message(&self) -> &str {
        self.message.as_str()
    }

    /// Returns where the panic happened.
    ///
    /// # Examples
    ///
    /// ```
    /// let r = std::panic::catch_unwind(|| -> u8 { panic("here") });
    /// let p = r.unwrap_err();
    /// assert(p.location().file().ends_with(".navi"));
    /// ```
    pub fn location(&self) -> &Location {
        &self.location
    }
}

impl Display for PanicPayload {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        f.pad(self.message.as_str())
    }
}

/// Calls `f`, catching a panic in it (after its defers have run).
///
/// Returns `Ok` with `f`'s result if it returns normally, and `Err` with
/// the [`PanicPayload`] if it panics. The panic message is still printed
/// when the panic happens, as with Rust's default hook.
///
/// # Examples
///
/// ```
/// use std::panic;
///
/// let r = panic::catch_unwind(|| 1 + 2);
/// assert_eq(r.unwrap(), 3);
///
/// let v: Vec<i32> = Vec::new();
/// let r = panic::catch_unwind(|| v[0]);
/// assert_eq(r.unwrap_err().message(), "index out of bounds: the len is 0 but the index is 0");
/// ```
pub fn catch_unwind<R>(f: fn() -> R) -> crate::thread::Result<R> {
    let mut out: Option<R> = None;
    let p = crate::rt::try_call(|| {
        out = Some(f());
    });
    if p as usize == 0 {
        return Ok(out.unwrap());
    }
    Err(unsafe { (*(p as *mut PanicPayload)).clone() })
}

/// Panics again with a payload from [`catch_unwind`] (the message is
/// printed again), at the payload's location.
///
/// # Examples
///
/// ```should_panic
/// use std::panic;
///
/// let r = panic::catch_unwind(|| -> i32 { panic("first") });
/// if let Err(p) = r {
///     panic::resume_unwind(p);
/// }
/// ```
pub fn resume_unwind(payload: PanicPayload) -> ! {
    let l = payload.location;
    crate::rt::panic_raw(payload.message.as_str(), l.file, l.line, l.col)
}

pub(crate) fn new_payload(msg: &str, file: &str, line: u32, col: u32) -> *mut u8 {
    &mut PanicPayload {
        message: msg.to_string(),
        location: Location { file, line, col },
    } as *mut PanicPayload as *mut u8
}

pub(crate) fn bounds_payload(len: usize, index: usize, file: &str, line: u32, col: u32) -> *mut u8 {
    let msg = `index out of bounds: the len is ${len} but the index is ${index}`.to_string();
    new_payload(msg.as_str(), file, line, col)
}

/// Panics with a message: ends the current thread, printing the message
/// and the caller's location (Rust's `panic!`).
///
/// The message is any [`Display`] value, usually a string or a template
/// string. Deferred code runs as the panic unwinds; [`catch_unwind`] can
/// catch it, and a thread's `join` reports it.
///
/// # Examples
///
/// ```should_panic
/// let x = 4;
/// if x % 2 == 0 {
///     panic(`${x} is even`);
/// }
/// ```
#[track_caller]
pub fn panic(msg: impl Display) -> ! {
    let s = msg.to_string();
    crate::rt::panic::begin(s.as_str(), Location::caller())
}

/// Marks unfinished code: panics with "not yet implemented" (Rust's
/// `todo!`).
///
/// # Examples
///
/// ```should_panic
/// fn later() -> i32 {
///     todo()
/// }
///
/// later();
/// ```
#[track_caller]
pub fn todo() -> ! {
    panic("not yet implemented")
}

/// Marks code that is not implemented: panics with "not implemented"
/// (Rust's `unimplemented!`).
///
/// # Examples
///
/// ```should_panic
/// trait Shape {
///     fn area(&self) -> f64;
///     fn volume(&self) -> f64;
/// }
///
/// struct Square(f64);
///
/// impl Shape for Square {
///     fn area(&self) -> f64 { self.0 * self.0 }
///     fn volume(&self) -> f64 { unimplemented() }
/// }
///
/// assert_eq(Square(2.0).area(), 4.0);
/// Square(2.0).volume();
/// ```
#[track_caller]
pub fn unimplemented() -> ! {
    panic("not implemented")
}

/// Marks code that should never run: panics with "internal error:
/// entered unreachable code" (Rust's `unreachable!`).
///
/// # Examples
///
/// ```
/// fn sign(x: i32) -> &str {
///     if x > 0 {
///         "+"
///     } else if x < 0 {
///         "-"
///     } else if x == 0 {
///         "0"
///     } else {
///         unreachable()
///     }
/// }
///
/// assert_eq(sign(-3), "-");
/// ```
#[track_caller]
pub fn unreachable() -> ! {
    panic("internal error: entered unreachable code")
}

/// Asserts that a boolean expression is `true`: panics with "assertion
/// failed" otherwise (Rust's `assert!`).
///
/// Assertions are always checked (navi has one build mode). To give a
/// message, use [`assert_msg`].
///
/// # Examples
///
/// ```
/// let v = Vec::from([1, 2, 3]);
/// assert(v.contains(&2));
/// assert(!v.is_empty());
/// ```
#[track_caller]
pub fn assert(cond: bool) {
    if !cond {
        panic("assertion failed");
    }
}

/// Asserts that a boolean expression is `true`, panicking with `msg`
/// otherwise (Rust's `assert!(cond, "msg")`).
///
/// # Examples
///
/// ```
/// let x = 3;
/// assert_msg(x < 10, `x is too big: ${x}`);
/// ```
///
/// ```should_panic
/// let x = 30;
/// assert_msg(x < 10, `x is too big: ${x}`);
/// ```
#[track_caller]
pub fn assert_msg(cond: bool, msg: impl Display) {
    if !cond {
        panic(msg);
    }
}

/// Asserts that two values are equal (using [`PartialEq`]), panicking
/// with both values' [`Debug`] forms otherwise (Rust's `assert_eq!`).
///
/// The two sides may have different types when `A: PartialEq<B>`, e.g. a
/// [`String`] and a `&str`, or a [`Vec`] and an array.
///
/// # Examples
///
/// ```
/// let a = 3;
/// let b = 1 + 2;
/// assert_eq(a, b);
/// assert_eq("ab".to_string(), "ab");
/// assert_eq(Vec::from([1, 2]), [1, 2]);
/// ```
///
/// On failure the message shows both sides:
///
/// ```text
/// assertion `left == right` failed
///   left: 3
///  right: 4
/// ```
#[track_caller]
pub fn assert_eq<A, B>(left: A, right: B)
where
    A: PartialEq<B> + Debug,
    B: Debug,
{
    if left != right {
        panic(`assertion \`left == right\` failed\n  left: ${left:?}\n right: ${right:?}`);
    }
}

/// Asserts that two values are not equal (using [`PartialEq`]),
/// panicking with both values' [`Debug`] forms otherwise (Rust's
/// `assert_ne!`).
///
/// # Examples
///
/// ```
/// let a = 3;
/// let b = 2;
/// assert_ne(a, b);
/// assert_ne("a".to_string(), "b");
/// ```
#[track_caller]
pub fn assert_ne<A, B>(left: A, right: B)
where
    A: PartialEq<B> + Debug,
    B: Debug,
{
    if left == right {
        panic(`assertion \`left != right\` failed\n  left: ${left:?}\n right: ${right:?}`);
    }
}
