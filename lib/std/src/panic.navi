//! Panics and assertions. These functions replace Rust's panic!/assert!
//! macros; #[track_caller] gives them the caller's location.

use crate::fmt::{Debug, Display};

#[derive(Clone, Debug)]
pub struct Location {
    file: &str,
    line: u32,
    col: u32,
}

impl Location {
    #[track_caller]
    pub fn caller() -> Location { crate::intrinsics::caller_location() }
    pub fn file(&self) -> &str { self.file }
    pub fn line(&self) -> u32 { self.line }
    pub fn column(&self) -> u32 { self.col }
}

#[track_caller]
pub fn panic(msg: impl Display) -> ! { crate::rt::panic::begin(`${msg}`, Location::caller()) }

#[track_caller]
pub fn todo() -> ! { panic("not yet implemented") }

#[track_caller]
pub fn unimplemented() -> ! { panic("not implemented") }

#[track_caller]
pub fn unreachable() -> ! { panic("internal error: entered unreachable code") }

#[track_caller]
pub fn assert(cond: bool) {
    if !cond { panic("assertion failed"); }
}

#[track_caller]
pub fn assert_eq<T: PartialEq + Debug>(left: T, right: T) {
    if left != right {
        panic(`assertion failed: left == right\n  left: ${left:?}\n right: ${right:?}`);
    }
}

#[track_caller]
pub fn assert_ne<T: PartialEq + Debug>(left: T, right: T) {
    if left == right {
        panic(`assertion failed: left != right\n  left: ${left:?}\n right: ${right:?}`);
    }
}

#[cfg(debug_assertions)]
#[track_caller]
pub fn debug_assert(cond: bool) { assert(cond); }

#[cfg(not(debug_assertions))]
pub fn debug_assert(cond: bool) {}
