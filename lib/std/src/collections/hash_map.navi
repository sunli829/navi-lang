//! A hash map implemented with open addressing (linear probing and tombstones).
//!
//! See [`HashMap`] for the map itself, [`Entry`] for the entry API, and
//! [`Iter`], [`IterMut`], [`Keys`], [`Values`] and [`ValuesMut`] for its
//! iterators.
//!
//! # Examples
//!
//! Grouping words by their first letter with the entry API:
//!
//! ```
//! use std::collections::HashMap;
//!
//! let mut by_letter: HashMap<char, Vec<&str>> = HashMap::new();
//! for word in "apple banana avocado cherry blueberry".split_whitespace() {
//!     let first = word.chars().next().unwrap();
//!     by_letter.entry(first).or_default().push(word);
//! }
//!
//! assert_eq(by_letter.len(), 3);
//! assert_eq(by_letter[&'a'], Vec::from(["apple", "avocado"]));
//! assert_eq(by_letter[&'b'], Vec::from(["banana", "blueberry"]));
//! assert_eq(by_letter[&'c'], Vec::from(["cherry"]));
//! ```

use crate::{
    fmt::{self, Debug, Formatter},
    hash::{DefaultHasher, Hash, Hasher},
    ops::Index,
};

/// A hash map implemented with open addressing (linear probing).
///
/// It is required that the keys implement the [`Eq`] and
/// [`Hash`](crate::hash::Hash) traits, and that `k1 == k2` implies that the two
/// keys hash equally. Keys are hashed with
/// [`DefaultHasher`](crate::hash::DefaultHasher), which in navi is FxHash:
/// fast, but not resistant to HashDoS attacks as Rust's SipHash is, so a map
/// keyed by untrusted input can be made slow by an attacker who picks colliding
/// keys.
///
/// Navi's `HashMap` differs from Rust's in a few ways:
///
/// - The iteration order is deterministic: there is no random seed, so it
///   depends only on the keys and on the history of insertions and removals,
///   and a program visits the entries in the same order on every run. The order
///   is still unspecified: do not rely on it.
/// - A `HashMap` is a shared handle, as [`Vec`] is: assigning or passing a map
///   shares its table, so a change through one copy is seen through the others.
///   Use [`clone`](Clone::clone) for an independent copy.
/// - Lookups take a `&K` (there is no `Borrow`): `map.get(&"key")` for a map
///   with `&str` keys, `map.get(&key_string)` for one with `String` keys.
/// - Methods taking a closure take a `fn` type, as all closures in navi.
///
/// Indexing with `map[&key]` returns the value of a key and panics if the key
/// is not in the map.
///
/// # Examples
///
/// ```
/// use std::collections::HashMap;
///
/// let mut book_reviews: HashMap<&str, &str> = HashMap::new();
///
/// // Review some books.
/// book_reviews.insert("Adventures of Huckleberry Finn", "My favorite book.");
/// book_reviews.insert("Grimms' Fairy Tales", "Masterpiece.");
/// book_reviews.insert("Pride and Prejudice", "Very enjoyable.");
/// book_reviews.insert("The Adventures of Sherlock Holmes", "Eye lyked it alot.");
///
/// // Check for a specific one.
/// assert(!book_reviews.contains_key(&"Les Misérables"));
///
/// // Oops, this review has a lot of spelling mistakes, let's delete it.
/// book_reviews.remove(&"The Adventures of Sherlock Holmes");
/// assert_eq(book_reviews.len(), 3);
///
/// // Look up the values associated with some keys.
/// assert_eq(
///     book_reviews.get(&"Pride and Prejudice"),
///     Some(&"Very enjoyable."),
/// );
/// assert_eq(book_reviews.get(&"Alice's Adventure in Wonderland"), None);
///
/// // Look up the value for a key (panics if the key is not found).
/// assert_eq(book_reviews[&"Grimms' Fairy Tales"], "Masterpiece.");
///
/// // Iterate over everything.
/// for (book, review) in book_reviews.iter() {
///     println(`${book}: "${review}"`);
/// }
/// ```
///
/// A map can be built from an iterator of key-value pairs:
///
/// ```
/// use std::collections::HashMap;
///
/// let solar_distance: HashMap<&str, f32> = [
///     ("Mercury", 0.4),
///     ("Venus", 0.7),
///     ("Earth", 1.0),
///     ("Mars", 1.5),
/// ]
/// .into_iter()
/// .collect();
/// assert_eq(solar_distance[&"Earth"], 1.0);
/// ```
///
/// Copies of a map share it; [`clone`](Clone::clone) makes an independent one:
///
/// ```
/// use std::collections::HashMap;
///
/// let mut a: HashMap<i32, &str> = HashMap::new();
/// a.insert(1, "one");
/// let mut b = a;
/// b.insert(2, "two");
/// assert_eq(a.len(), 2);
///
/// let mut c = a.clone();
/// c.insert(3, "three");
/// assert_eq(a.len(), 2);
/// assert_eq(c.len(), 3);
/// ```
pub struct HashMap<K, V> {
    t: &mut Table<K, V>,
}

enum Slot<K, V> {
    Empty,
    Deleted,
    Full(K, V),
}

struct Table<K, V> {
    slots: Vec<Slot<K, V>>,
    len: usize,
    used: usize, // full + deleted
}

fn hash_of<K: Hash>(k: &K) -> u64 {
    let mut h = DefaultHasher::new();
    k.hash(&mut h);
    h.finish()
}

impl<K, V> HashMap<K, V>
where
    K: Hash + Eq,
{
    /// Creates an empty `HashMap`.
    ///
    /// The hash map is initially created with a capacity of 0, so it will not
    /// allocate until it is first inserted into.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map: HashMap<&str, i32> = HashMap::new();
    /// assert(map.is_empty());
    /// map.insert("a", 1);
    /// assert_eq(map.len(), 1);
    /// ```
    pub fn new() -> HashMap<K, V> {
        HashMap {
            t: &mut Table {
                slots: Vec::new(),
                len: 0,
                used: 0,
            },
        }
    }

    /// Creates an empty `HashMap` with room for at least `capacity` entries.
    ///
    /// The hash map will be able to hold at least `capacity` elements without
    /// reallocating. If `capacity` is 0, the hash map will not allocate.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map: HashMap<&str, i32> = HashMap::with_capacity(10);
    /// assert(map.is_empty());
    /// map.insert("a", 1);
    /// assert_eq(map[&"a"], 1);
    /// ```
    pub fn with_capacity(capacity: usize) -> HashMap<K, V> {
        let m = HashMap::new();
        if capacity > 0 {
            m.t.resize(capacity * 2);
        }
        m
    }

    /// Reserves capacity for at least `additional` more entries.
    ///
    /// The map may reserve more space to avoid frequent reallocations. Does
    /// nothing if the capacity is already sufficient.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map: HashMap<&str, i32> = HashMap::new();
    /// map.reserve(10);
    /// map.insert("a", 1);
    /// assert_eq(map.len(), 1);
    /// ```
    pub fn reserve(&mut self, additional: usize) {
        let want = (self.t.len + additional) * 2;
        if want > self.t.slots.len() {
            self.t.resize(want);
        }
    }

    /// Returns the number of entries in the map.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut a = HashMap::new();
    /// assert_eq(a.len(), 0);
    /// a.insert(1, "a");
    /// assert_eq(a.len(), 1);
    /// ```
    pub fn len(&self) -> usize {
        self.t.len
    }

    /// Returns `true` if the map contains no entries.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut a = HashMap::new();
    /// assert(a.is_empty());
    /// a.insert(1, "a");
    /// assert(!a.is_empty());
    /// ```
    pub fn is_empty(&self) -> bool {
        self.t.len == 0
    }

    /// Clears the map, removing all key-value pairs.
    ///
    /// Unlike Rust's, this also lets go of the table (its memory is reclaimed
    /// by the GC), so the map starts again from no capacity. Every copy of the
    /// map sees it empty, since they share it.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut a = HashMap::new();
    /// a.insert(1, "a");
    /// a.clear();
    /// assert(a.is_empty());
    /// ```
    pub fn clear(&mut self) {
        self.t.slots = Vec::new();
        self.t.len = 0;
        self.t.used = 0;
    }

    /// Inserts a key-value pair into the map.
    ///
    /// If the map did not have this key present, [`None`] is returned.
    ///
    /// If the map did have this key present, the value is updated, and the old
    /// value is returned. The key is not updated, though (it matters for types
    /// that can be `==` without being identical).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map = HashMap::new();
    /// assert_eq(map.insert(37, "a"), None);
    /// assert(!map.is_empty());
    ///
    /// map.insert(37, "b");
    /// assert_eq(map.insert(37, "c"), Some("b"));
    /// assert_eq(map[&37], "c");
    /// ```
    pub fn insert(&mut self, k: K, v: V) -> Option<V> {
        let i = self.t.find_or_slot(&k);
        match &mut self.t.slots[i] {
            Slot::Full(_, old) => {
                let prev = crate::mem::replace(old, v);
                return Some(prev);
            }
            Slot::Deleted => {}
            Slot::Empty => {
                self.t.used += 1;
            }
        }
        self.t.slots[i] = Slot::Full(k, v);
        self.t.len += 1;
        if self.t.used * 4 >= self.t.slots.len() * 3 {
            self.t.grow();
        }
        None
    }

    /// Returns a reference to the value corresponding to the key, or [`None`]
    /// if the key is not in the map.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map = HashMap::new();
    /// map.insert(1, "a");
    /// assert_eq(map.get(&1), Some(&"a"));
    /// assert_eq(map.get(&2), None);
    /// ```
    pub fn get(&self, k: &K) -> Option<&V> {
        match self.t.find(k) {
            Some(i) => match &self.t.slots[i] {
                Slot::Full(_, v) => Some(v),
                _ => None,
            },
            None => None,
        }
    }

    /// Returns a mutable reference to the value corresponding to the key, or
    /// [`None`] if the key is not in the map.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map = HashMap::new();
    /// map.insert(1, "a");
    /// if let Some(x) = map.get_mut(&1) {
    ///     *x = "b";
    /// }
    /// assert_eq(map[&1], "b");
    /// ```
    pub fn get_mut(&mut self, k: &K) -> Option<&mut V> {
        match self.t.find(k) {
            Some(i) => match &mut self.t.slots[i] {
                Slot::Full(_, v) => Some(v),
                _ => None,
            },
            None => None,
        }
    }

    /// Returns the key-value pair corresponding to the supplied key, or
    /// [`None`] if the key is not in the map.
    ///
    /// The key returned is the one stored in the map, which may differ from the
    /// one given if the key type's `==` is not identity.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map = HashMap::new();
    /// map.insert(1, "a");
    /// assert_eq(map.get_key_value(&1), Some((&1, &"a")));
    /// assert_eq(map.get_key_value(&2), None);
    /// ```
    pub fn get_key_value(&self, k: &K) -> Option<(&K, &V)> {
        match self.t.find(k) {
            Some(i) => match &self.t.slots[i] {
                Slot::Full(key, v) => Some((key, v)),
                _ => None,
            },
            None => None,
        }
    }

    /// Returns `true` if the map contains a value for the specified key.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map = HashMap::new();
    /// map.insert(1, "a");
    /// assert(map.contains_key(&1));
    /// assert(!map.contains_key(&2));
    /// ```
    pub fn contains_key(&self, k: &K) -> bool {
        self.t.find(k).is_some()
    }

    /// Removes a key from the map, returning the value at the key if the key
    /// was previously in the map.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map = HashMap::new();
    /// map.insert(1, "a");
    /// assert_eq(map.remove(&1), Some("a"));
    /// assert_eq(map.remove(&1), None);
    /// ```
    pub fn remove(&mut self, k: &K) -> Option<V> {
        match self.t.find(k) {
            Some(i) => {
                let old = crate::mem::replace(&mut self.t.slots[i], Slot::Deleted);
                self.t.len -= 1;
                match old {
                    Slot::Full(_, v) => Some(v),
                    _ => None,
                }
            }
            None => None,
        }
    }

    /// Gets the given key's corresponding entry in the map for in-place
    /// manipulation.
    ///
    /// Unlike Rust's, navi's [`Entry`] is a struct, not an enum with `Occupied`
    /// and `Vacant` variants: use its methods ([`Entry::or_insert`],
    /// [`Entry::and_modify`], ...).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut letters: HashMap<char, i32> = HashMap::new();
    ///
    /// for ch in "a short treatise on fungi".chars() {
    ///     *letters.entry(ch).or_insert(0) += 1;
    /// }
    ///
    /// assert_eq(letters[&'s'], 2);
    /// assert_eq(letters[&'t'], 3);
    /// assert_eq(letters[&'u'], 1);
    /// assert_eq(letters.get(&'y'), None);
    /// ```
    pub fn entry(&mut self, k: K) -> Entry<K, V> {
        let i = self.t.find_or_slot(&k);
        let occupied = match &self.t.slots[i] {
            Slot::Full(_, _) => true,
            _ => false,
        };
        Entry {
            map: HashMap { t: self.t },
            key: k,
            index: i,
            occupied,
        }
    }

    /// An iterator visiting all key-value pairs in arbitrary order. The
    /// iterator element type is `(&K, &V)`.
    ///
    /// The order is unspecified, but deterministic: the same insertions and
    /// removals give the same order on every run.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map = HashMap::new();
    /// map.insert("a", 1);
    /// map.insert("b", 2);
    /// map.insert("c", 3);
    ///
    /// let mut pairs: Vec<(&str, i32)> = map.iter().map(|(k, v)| (*k, *v)).collect();
    /// pairs.sort();
    /// assert_eq(pairs, Vec::from([("a", 1), ("b", 2), ("c", 3)]));
    /// ```
    pub fn iter(&self) -> Iter<K, V> {
        Iter { t: self.t, i: 0 }
    }

    /// An iterator visiting all key-value pairs in arbitrary order, with
    /// mutable references to the values. The iterator element type is `(&K,
    /// &mut V)`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map = HashMap::new();
    /// map.insert("a", 1);
    /// map.insert("b", 2);
    /// map.insert("c", 3);
    ///
    /// // Update all values.
    /// for (_, val) in map.iter_mut() {
    ///     *val *= 2;
    /// }
    /// assert_eq(map[&"a"], 2);
    /// assert_eq(map[&"c"], 6);
    /// ```
    pub fn iter_mut(&mut self) -> IterMut<K, V> {
        IterMut { t: self.t, i: 0 }
    }

    /// An iterator visiting all keys in arbitrary order. The iterator element
    /// type is `&K`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map = HashMap::new();
    /// map.insert("a", 1);
    /// map.insert("b", 2);
    /// map.insert("c", 3);
    ///
    /// let mut keys: Vec<&str> = map.keys().copied().collect();
    /// keys.sort();
    /// assert_eq(keys, Vec::from(["a", "b", "c"]));
    /// ```
    pub fn keys(&self) -> Keys<K, V> {
        Keys { it: self.iter() }
    }

    /// An iterator visiting all values in arbitrary order. The iterator element
    /// type is `&V`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map = HashMap::new();
    /// map.insert("a", 1);
    /// map.insert("b", 2);
    /// map.insert("c", 3);
    ///
    /// let total: i32 = map.values().copied().sum();
    /// assert_eq(total, 6);
    /// ```
    pub fn values(&self) -> Values<K, V> {
        Values { it: self.iter() }
    }

    /// An iterator visiting all values mutably in arbitrary order. The iterator
    /// element type is `&mut V`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map = HashMap::new();
    /// map.insert("a", 1);
    /// map.insert("b", 2);
    ///
    /// for val in map.values_mut() {
    ///     *val = *val + 10;
    /// }
    /// assert_eq(map[&"a"], 11);
    /// assert_eq(map[&"b"], 12);
    /// ```
    pub fn values_mut(&mut self) -> ValuesMut<K, V> {
        ValuesMut {
            it: self.iter_mut(),
        }
    }

    /// Returns the number of entries the map can hold without reallocating.
    ///
    /// This number is a lower bound; the map might be able to hold more, but
    /// is guaranteed to be able to hold at least this many.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let map: HashMap<i32, i32> = HashMap::with_capacity(100);
    /// assert(map.capacity() >= 100);
    /// ```
    pub fn capacity(&self) -> usize {
        let n = self.t.slots.len();
        // (It grows when 3/4 of the slots are used.)
        if n == 0 { 0 } else { n * 3 / 4 - 1 }
    }

    /// Removes a key from the map, returning the stored key and value if the
    /// key was previously in the map.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map = HashMap::new();
    /// map.insert(1, "a");
    /// assert_eq(map.remove_entry(&1), Some((1, "a")));
    /// assert_eq(map.remove(&1), None);
    /// ```
    pub fn remove_entry(&mut self, k: &K) -> Option<(K, V)> {
        match self.t.find(k) {
            Some(i) => {
                let old = crate::mem::replace(&mut self.t.slots[i], Slot::Deleted);
                self.t.len -= 1;
                match old {
                    Slot::Full(key, v) => Some((key, v)),
                    _ => None,
                }
            }
            None => None,
        }
    }

    /// Clears the map, returning all key-value pairs as an iterator.
    ///
    /// Unlike Rust's, which removes them as the iterator is used, the map is
    /// empty when `drain` returns, whether or not the iterator is used.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut a = HashMap::new();
    /// a.insert(1, "a");
    /// a.insert(2, "b");
    ///
    /// let mut drained: Vec<(i32, &str)> = a.drain().collect();
    /// drained.sort();
    /// assert_eq(drained, [(1, "a"), (2, "b")]);
    /// assert(a.is_empty());
    /// ```
    pub fn drain(&mut self) -> Drain<K, V> {
        let all = self.entries();
        self.clear();
        Drain {
            it: all.into_iter(),
        }
    }

    /// Creates a consuming iterator visiting all the keys in arbitrary order.
    ///
    /// navi's maps are shared by their copies, so the map is left as it is:
    /// the iterator holds the keys it had when it was made.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let map = HashMap::from([("a", 1), ("b", 2), ("c", 3)]);
    ///
    /// let mut vec: Vec<&str> = map.into_keys().collect();
    /// vec.sort_unstable();
    /// assert_eq(vec, ["a", "b", "c"]);
    /// ```
    pub fn into_keys(self) -> IntoKeys<K, V> {
        IntoKeys {
            it: self.entries().into_iter(),
        }
    }

    /// Creates a consuming iterator visiting all the values in arbitrary
    /// order.
    ///
    /// The map is left as it is, as with [`into_keys`](HashMap::into_keys).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let map = HashMap::from([("a", 1), ("b", 2), ("c", 3)]);
    ///
    /// let mut vec: Vec<i32> = map.into_values().collect();
    /// vec.sort_unstable();
    /// assert_eq(vec, [1, 2, 3]);
    /// ```
    pub fn into_values(self) -> IntoValues<K, V> {
        IntoValues {
            it: self.entries().into_iter(),
        }
    }

    fn entries(&self) -> crate::vec::Vec<(K, V)> {
        self.t.entries()
    }

    /// Retains only the entries specified by the predicate.
    ///
    /// In other words, removes all pairs `(k, v)` for which `f(&k, &mut v)`
    /// returns `false`. The entries are visited in arbitrary order; `f` may
    /// change the values it keeps.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map: HashMap<i32, i32> = (0..8).map(|x| (x, x * 10)).collect();
    /// map.retain(|k, _| k % 2 == 0);
    /// assert_eq(map.len(), 4);
    /// assert(map.contains_key(&6));
    /// assert(!map.contains_key(&3));
    /// ```
    pub fn retain(&mut self, f: fn(&K, &mut V) -> bool) {
        let mut i = 0;
        while i < self.t.slots.len() {
            let keep = match &mut self.t.slots[i] {
                Slot::Full(k, v) => f(k, v),
                _ => true,
            };
            if !keep {
                self.t.slots[i] = Slot::Deleted;
                self.t.len -= 1;
            }
            i += 1;
        }
    }
}

impl<K, V> Table<K, V>
where
    K: Hash + Eq,
{
    // Index of the slot holding k.
    fn find(&self, k: &K) -> Option<usize> {
        let n = self.slots.len();
        if n == 0 {
            return None;
        }
        let mut i = (hash_of(k) as usize) & (n - 1);
        loop {
            match &self.slots[i] {
                Slot::Empty => return None,
                Slot::Full(key, _) => {
                    if key == k {
                        return Some(i);
                    }
                }
                Slot::Deleted => {}
            }
            i = (i + 1) & (n - 1);
        }
    }

    // Index of the slot holding k, or of the slot where it would go.
    fn find_or_slot(&mut self, k: &K) -> usize {
        if self.slots.len() == 0 {
            self.resize(8);
        }
        let n = self.slots.len();
        let mut i = (hash_of(k) as usize) & (n - 1);
        let mut first_deleted = n;
        loop {
            match &self.slots[i] {
                Slot::Empty => return if first_deleted < n { first_deleted } else { i },
                Slot::Full(key, _) => {
                    if key == k {
                        return i;
                    }
                }
                Slot::Deleted => {
                    if first_deleted == n {
                        first_deleted = i;
                    }
                }
            }
            i = (i + 1) & (n - 1);
        }
    }

    fn grow(&mut self) {
        let n = if self.len * 2 >= self.slots.len() {
            self.slots.len() * 2
        } else {
            self.slots.len()
        };
        self.resize(n);
    }

    fn resize(&mut self, want: usize) {
        let mut n = 8;
        while n < want {
            n = n * 2;
        }
        // New memory is zeroed: every slot is Empty (the first variant).
        let mut fresh: Vec<Slot<K, V>> = Vec::with_capacity(n);
        unsafe {
            fresh.set_len(n);
        }
        let old = crate::mem::replace(&mut self.slots, fresh);
        self.len = 0;
        self.used = 0;
        for s in old.iter() {
            if let Slot::Full(k, v) = s {
                let mut j = (hash_of(k) as usize) & (n - 1);
                loop {
                    let empty = match &self.slots[j] {
                        Slot::Empty => true,
                        _ => false,
                    };
                    if empty {
                        break;
                    }
                    j = (j + 1) & (n - 1);
                }
                self.slots[j] = Slot::Full(k.clone_shallow(), v.clone_shallow());
                self.len += 1;
                self.used += 1;
            }
        }
    }
}

impl<K, V> HashMap<K, V> {
    // keys, for the impls without K's bounds (HashSet's IntoIterator).
    pub(crate) fn keys_unbounded(&self) -> Keys<K, V> {
        Keys {
            it: Iter { t: self.t, i: 0 },
        }
    }
}

impl<K, V> Table<K, V> {
    // The entries, copied out (keys and values are copied by assignment).
    fn entries(&self) -> crate::vec::Vec<(K, V)> {
        let mut out = crate::vec::Vec::with_capacity(self.len);
        for s in self.slots.iter() {
            if let Slot::Full(k, v) = s {
                out.push((k.clone_shallow(), v.clone_shallow()));
            }
        }
        out
    }
}

// Moving entries between tables copies them (values are copied by
// assignment in navi; no Clone bound is needed).
trait CloneShallow {
    fn clone_shallow(&self) -> Self;
}

impl<T> CloneShallow for T {
    fn clone_shallow(&self) -> T {
        unsafe { *(self as *const T) }
    }
}

/// A view into a single entry of a map, which may be either vacant or occupied.
///
/// This struct is constructed by [`HashMap::entry`]. Unlike Rust's `Entry`, it
/// is a struct, not an enum with `Occupied` and `Vacant` variants: its methods
/// fill in a vacant entry ([`Entry::or_insert`], [`Entry::or_insert_with`],
/// [`Entry::or_default`]) or change an occupied one ([`Entry::and_modify`]).
///
/// # Examples
///
/// ```
/// use std::collections::HashMap;
///
/// let mut map: HashMap<&str, i32> = HashMap::new();
/// map.entry("poneyland").and_modify(|e| *e += 1).or_insert(42);
/// assert_eq(map[&"poneyland"], 42);
/// map.entry("poneyland").and_modify(|e| *e += 1).or_insert(42);
/// assert_eq(map[&"poneyland"], 43);
/// ```
pub struct Entry<K, V> {
    map: HashMap<K, V>,
    key: K,
    index: usize,
    occupied: bool,
}

impl<K, V> Entry<K, V>
where
    K: Hash + Eq,
{
    /// Ensures a value is in the entry by inserting the default if empty, and
    /// returns a mutable reference to the value in the entry.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map: HashMap<&str, i32> = HashMap::new();
    ///
    /// map.entry("poneyland").or_insert(3);
    /// assert_eq(map[&"poneyland"], 3);
    ///
    /// *map.entry("poneyland").or_insert(10) *= 2;
    /// assert_eq(map[&"poneyland"], 6);
    /// ```
    pub fn or_insert(mut self, default: V) -> &mut V {
        if !self.occupied {
            self.map.insert(self.key.clone_shallow(), default);
        }
        self.map.get_mut(&self.key).unwrap()
    }

    /// Ensures a value is in the entry by inserting the result of the default
    /// function if empty, and returns a mutable reference to the value in the
    /// entry.
    ///
    /// `f` is called only if the entry is vacant.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map: HashMap<&str, String> = HashMap::new();
    /// let value = "hoho";
    ///
    /// map.entry("poneyland").or_insert_with(|| value.to_string());
    /// assert_eq(map[&"poneyland"], "hoho".to_string());
    /// ```
    pub fn or_insert_with(mut self, f: fn() -> V) -> &mut V {
        if !self.occupied {
            self.map.insert(self.key.clone_shallow(), f());
        }
        self.map.get_mut(&self.key).unwrap()
    }

    /// Provides in-place mutable access to an occupied entry before any
    /// potential inserts into the map.
    ///
    /// If the entry is vacant, `f` is not called.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map: HashMap<&str, i32> = HashMap::new();
    ///
    /// map.entry("poneyland").and_modify(|e| *e += 1).or_insert(42);
    /// assert_eq(map[&"poneyland"], 42);
    ///
    /// map.entry("poneyland").and_modify(|e| *e += 1).or_insert(42);
    /// assert_eq(map[&"poneyland"], 43);
    /// ```
    pub fn and_modify(mut self, f: fn(&mut V)) -> Entry<K, V> {
        if self.occupied {
            match self.map.get_mut(&self.key) {
                Some(v) => f(v),
                None => {}
            }
        }
        self
    }

    /// Returns a reference to this entry's key.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map: HashMap<&str, i32> = HashMap::new();
    /// assert_eq(*map.entry("poneyland").key(), "poneyland");
    /// ```
    pub fn key(&self) -> &K {
        &self.key
    }
}

impl<K, V> Entry<K, V>
where
    K: Hash + Eq,
    V: Default,
{
    /// Ensures a value is in the entry by inserting the default value if empty,
    /// and returns a mutable reference to the value in the entry.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let mut map: HashMap<&str, Vec<i32>> = HashMap::new();
    /// map.entry("odd").or_default().push(1);
    /// map.entry("odd").or_default().push(3);
    /// map.entry("even").or_default();
    ///
    /// assert_eq(map[&"odd"], Vec::from([1, 3]));
    /// assert(map[&"even"].is_empty());
    /// ```
    pub fn or_default(mut self) -> &mut V {
        if !self.occupied {
            self.map.insert(self.key.clone_shallow(), V::default());
        }
        self.map.get_mut(&self.key).unwrap()
    }
}

/// An iterator over the entries of a `HashMap`, in arbitrary order.
///
/// This struct is created by [`HashMap::iter`]. Its items are `(&K, &V)`.
///
/// # Examples
///
/// ```
/// use std::collections::HashMap;
///
/// let mut map = HashMap::new();
/// map.insert("a", 1);
/// let mut iter = map.iter();
/// assert_eq(iter.next(), Some((&"a", &1)));
/// assert_eq(iter.next(), None);
/// ```
pub struct Iter<K, V> {
    t: &Table<K, V>,
    i: usize,
}

impl<K, V> Iterator for Iter<K, V> {
    type Item = (&K, &V);
    fn next(&mut self) -> Option<(&K, &V)> {
        while self.i < self.t.slots.len() {
            let i = self.i;
            self.i += 1;
            if let Slot::Full(k, v) = &self.t.slots[i] {
                return Some((k, v));
            }
        }
        None
    }
}

/// A mutable iterator over the entries of a `HashMap`, in arbitrary order.
///
/// This struct is created by [`HashMap::iter_mut`]. Its items are `(&K, &mut
/// V)`.
///
/// # Examples
///
/// ```
/// use std::collections::HashMap;
///
/// let mut map = HashMap::new();
/// map.insert("a", 1);
/// for (_, v) in map.iter_mut() {
///     *v += 1;
/// }
/// assert_eq(map[&"a"], 2);
/// ```
pub struct IterMut<K, V> {
    t: &mut Table<K, V>,
    i: usize,
}

impl<K, V> Iterator for IterMut<K, V> {
    type Item = (&K, &mut V);
    fn next(&mut self) -> Option<(&K, &mut V)> {
        while self.i < self.t.slots.len() {
            let i = self.i;
            self.i += 1;
            if let Slot::Full(k, v) = &mut self.t.slots[i] {
                return Some((k, v));
            }
        }
        None
    }
}

/// An iterator over the keys of a `HashMap`, in arbitrary order.
///
/// This struct is created by [`HashMap::keys`]. Its items are `&K`.
///
/// # Examples
///
/// ```
/// use std::collections::HashMap;
///
/// let mut map = HashMap::new();
/// map.insert("a", 1);
/// let mut keys = map.keys();
/// assert_eq(keys.next(), Some(&"a"));
/// assert_eq(keys.next(), None);
/// ```
pub struct Keys<K, V> {
    it: Iter<K, V>,
}

impl<K, V> Iterator for Keys<K, V> {
    type Item = &K;
    fn next(&mut self) -> Option<&K> {
        match self.it.next() {
            Some((k, _)) => Some(k),
            None => None,
        }
    }
}

/// An iterator over the values of a `HashMap`, in arbitrary order.
///
/// This struct is created by [`HashMap::values`]. Its items are `&V`.
///
/// # Examples
///
/// ```
/// use std::collections::HashMap;
///
/// let mut map = HashMap::new();
/// map.insert("a", 1);
/// let mut values = map.values();
/// assert_eq(values.next(), Some(&1));
/// assert_eq(values.next(), None);
/// ```
pub struct Values<K, V> {
    it: Iter<K, V>,
}

impl<K, V> Iterator for Values<K, V> {
    type Item = &V;
    fn next(&mut self) -> Option<&V> {
        match self.it.next() {
            Some((_, v)) => Some(v),
            None => None,
        }
    }
}

/// A mutable iterator over the values of a `HashMap`, in arbitrary order.
///
/// This struct is created by [`HashMap::values_mut`]. Its items are `&mut V`.
///
/// # Examples
///
/// ```
/// use std::collections::HashMap;
///
/// let mut map = HashMap::new();
/// map.insert("a", 1);
/// for v in map.values_mut() {
///     *v = 5;
/// }
/// assert_eq(map[&"a"], 5);
/// ```
pub struct ValuesMut<K, V> {
    it: IterMut<K, V>,
}

impl<K, V> Iterator for ValuesMut<K, V> {
    type Item = &mut V;
    fn next(&mut self) -> Option<&mut V> {
        match self.it.next() {
            Some((_, v)) => Some(v),
            None => None,
        }
    }
}

impl<K, V> Index<&K> for HashMap<K, V>
where
    K: Hash + Eq,
{
    type Output = V;
    /// Returns a reference to the value corresponding to the supplied key.
    ///
    /// # Panics
    ///
    /// Panics if the key is not present in the `HashMap`.
    #[track_caller]
    fn index(&self, k: &K) -> &V {
        match self.get(k) {
            Some(v) => v,
            None => panic("key not found in HashMap"),
        }
    }
}

impl<K, V> Clone for HashMap<K, V>
where
    K: Hash + Eq + Clone,
    V: Clone,
{
    // Slot by slot. (Inserting the keys in slot order into a table that
    // starts small piles them into long probe runs while it grows.)
    /// Returns an independent copy of the map, cloning every key and value.
    ///
    /// The copy has the same table layout, so it iterates in the same order as
    /// the original.
    fn clone(&self) -> HashMap<K, V> {
        let mut slots: Vec<Slot<K, V>> = Vec::with_capacity(self.t.slots.len());
        for s in self.t.slots.iter() {
            slots.push(match s {
                Slot::Full(k, v) => Slot::Full(k.clone(), v.clone()),
                Slot::Deleted => Slot::Deleted,
                Slot::Empty => Slot::Empty,
            });
        }
        HashMap {
            t: &mut Table {
                slots,
                len: self.t.len,
                used: self.t.used,
            },
        }
    }
}

impl<K, V> Default for HashMap<K, V>
where
    K: Hash + Eq,
{
    fn default() -> HashMap<K, V> {
        HashMap::new()
    }
}

impl<K, V> Debug for HashMap<K, V>
where
    K: Hash + Eq + Debug,
    V: Debug,
{
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        let mut m = f.debug_map();
        for (k, v) in self.iter() {
            m.entry(k, v);
        }
        m.finish()
    }
}

impl<K, V> PartialEq for HashMap<K, V>
where
    K: Hash + Eq,
    V: PartialEq,
{
    /// Two maps are equal if they have the same keys, each with an equal value
    /// (whatever their iteration orders).
    fn eq(&self, other: &HashMap<K, V>) -> bool {
        if self.len() != other.len() {
            return false;
        }
        for (k, v) in self.iter() {
            match other.get(k) {
                Some(w) => {
                    if v != w {
                        return false;
                    }
                }
                None => return false,
            }
        }
        true
    }
}

impl<K, V> FromIterator<(K, V)> for HashMap<K, V>
where
    K: Hash + Eq,
{
    fn from_iter<I: IntoIterator<Item = (K, V)>>(iter: I) -> HashMap<K, V> {
        let mut m = HashMap::new();
        for (k, v) in iter {
            m.insert(k, v);
        }
        m
    }
}

impl<K, V> Extend<(K, V)> for HashMap<K, V>
where
    K: Hash + Eq,
{
    fn extend<I: IntoIterator<Item = (K, V)>>(&mut self, iter: I) {
        for (k, v) in iter {
            self.insert(k, v);
        }
    }
}

impl<K, V, const N: usize> From<[(K, V); N]> for HashMap<K, V>
where
    K: Hash + Eq,
{
    /// Converts a `[(K, V); N]` into a `HashMap<K, V>`.
    ///
    /// If any entries in the array have equal keys, all but one of the
    /// corresponding values will be dropped.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let map1 = HashMap::from([(1, 2), (3, 4)]);
    /// let map2: HashMap<i32, i32> = [(1, 2), (3, 4)].into();
    /// assert_eq(map1, map2);
    /// ```
    fn from(a: [(K, V); N]) -> HashMap<K, V> {
        let mut m = HashMap::with_capacity(N);
        for (k, v) in a.iter() {
            m.insert(k.clone_shallow(), v.clone_shallow());
        }
        m
    }
}

impl<K, V> IntoIterator for HashMap<K, V> {
    type Item = (K, V);
    type IntoIter = IntoIter<K, V>;
    /// Creates a consuming iterator visiting all the key-value pairs in
    /// arbitrary order (a snapshot: the map, shared by its copies, is left as
    /// it is).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashMap;
    ///
    /// let map = HashMap::from([("a", 1), ("b", 2)]);
    /// let mut v: Vec<(&str, i32)> = map.into_iter().collect();
    /// v.sort();
    /// assert_eq(v, [("a", 1), ("b", 2)]);
    /// ```
    fn into_iter(self) -> IntoIter<K, V> {
        IntoIter {
            it: self.t.entries().into_iter(),
        }
    }
}

impl<K, V> IntoIterator for &HashMap<K, V> {
    type Item = (&K, &V);
    type IntoIter = Iter<K, V>;
    fn into_iter(self) -> Iter<K, V> {
        Iter { t: self.t, i: 0 }
    }
}

impl<K, V> IntoIterator for &mut HashMap<K, V> {
    type Item = (&K, &mut V);
    type IntoIter = IterMut<K, V>;
    fn into_iter(self) -> IterMut<K, V> {
        IterMut { t: self.t, i: 0 }
    }
}

/// An owning iterator over the entries of a `HashMap`, in arbitrary order.
///
/// This struct is created by the [`into_iter`](IntoIterator::into_iter)
/// method on [`HashMap`].
///
/// # Examples
///
/// ```
/// use std::collections::HashMap;
///
/// let map = HashMap::from([("a", 1)]);
/// let mut iter = map.into_iter();
/// assert_eq(iter.next(), Some(("a", 1)));
/// assert_eq(iter.next(), None);
/// ```
pub struct IntoIter<K, V> {
    it: crate::vec::IntoIter<(K, V)>,
}

impl<K, V> Iterator for IntoIter<K, V> {
    type Item = (K, V);
    fn next(&mut self) -> Option<(K, V)> {
        self.it.next()
    }
}

/// A draining iterator over the entries of a `HashMap`.
///
/// This struct is created by [`HashMap::drain`].
///
/// # Examples
///
/// ```
/// use std::collections::HashMap;
///
/// let mut map = HashMap::from([("a", 1)]);
/// let mut iter = map.drain();
/// assert_eq(iter.next(), Some(("a", 1)));
/// assert(map.is_empty());
/// ```
pub struct Drain<K, V> {
    it: crate::vec::IntoIter<(K, V)>,
}

impl<K, V> Iterator for Drain<K, V> {
    type Item = (K, V);
    fn next(&mut self) -> Option<(K, V)> {
        self.it.next()
    }
}

/// An owning iterator over the keys of a `HashMap`.
///
/// This struct is created by [`HashMap::into_keys`].
///
/// # Examples
///
/// ```
/// use std::collections::HashMap;
///
/// let map = HashMap::from([("a", 1)]);
/// let mut keys = map.into_keys();
/// assert_eq(keys.next(), Some("a"));
/// assert_eq(keys.next(), None);
/// ```
pub struct IntoKeys<K, V> {
    it: crate::vec::IntoIter<(K, V)>,
}

impl<K, V> Iterator for IntoKeys<K, V> {
    type Item = K;
    fn next(&mut self) -> Option<K> {
        match self.it.next() {
            Some((k, _)) => Some(k),
            None => None,
        }
    }
}

/// An owning iterator over the values of a `HashMap`.
///
/// This struct is created by [`HashMap::into_values`].
///
/// # Examples
///
/// ```
/// use std::collections::HashMap;
///
/// let map = HashMap::from([("a", 1)]);
/// let mut values = map.into_values();
/// assert_eq(values.next(), Some(1));
/// assert_eq(values.next(), None);
/// ```
pub struct IntoValues<K, V> {
    it: crate::vec::IntoIter<(K, V)>,
}

impl<K, V> Iterator for IntoValues<K, V> {
    type Item = V;
    fn next(&mut self) -> Option<V> {
        match self.it.next() {
            Some((_, v)) => Some(v),
            None => None,
        }
    }
}
