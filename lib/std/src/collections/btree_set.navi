//! An ordered set based on a B-Tree.
//!
//! See [`BTreeSet`] for details. A `BTreeSet` is a [`BTreeMap`] with `()`
//! values. Like [`Vec`], it is a shared handle: copies of it share the same
//! tree, and [`clone`](BTreeSet::clone) makes an independent copy.

use crate::cmp::Ordering;
use crate::collections::btree_map::{self, BTreeMap};
use crate::fmt::{self, Debug, Formatter};
use crate::ops::RangeBounds;

/// An ordered set based on a B-Tree.
///
/// See [`BTreeMap`]'s documentation for a detailed discussion of this
/// collection's performance benefits and drawbacks.
///
/// It is a logic error for an item to be modified in such a way that the item's
/// ordering relative to any other item, as determined by the [`Ord`] trait,
/// changes while it is in the set. The behavior resulting from such a logic
/// error is not specified, but it is not undefined behavior.
///
/// Iterators returned by [`BTreeSet::iter`] and [`BTreeSet::into_iter`] produce
/// their items in order, and take worst-case logarithmic and amortized constant
/// time per item returned.
///
/// Where navi differs from Rust (see spec/std-diff.md):
///
/// - A `BTreeSet` is a shared handle, like [`Vec`]: assigning it or passing it
///   by value copies the handle, and all the copies see the same values. Use
///   [`clone`](BTreeSet::clone) for an independent copy.
///   [`into_iter`](BTreeSet::into_iter) does not empty the set.
/// - `union` is a reserved word in navi: call the method as `a.r#union(&b)`.
/// - There is no `Borrow`: the lookup methods take `&T`, and
///   [`range`](BTreeSet::range) takes bounds of `T`.
/// - Closures passed to [`retain`](BTreeSet::retain) are `fn` types.
///
/// # Examples
///
/// ```
/// use std::collections::BTreeSet;
///
/// // Type inference lets us omit an explicit type signature (which
/// // would be `BTreeSet<&str>` in this example).
/// let mut books = BTreeSet::new();
///
/// // Add some books.
/// books.insert("A Dance With Dragons");
/// books.insert("To Kill a Mockingbird");
/// books.insert("The Odyssey");
/// books.insert("The Great Gatsby");
///
/// // Check for a specific one.
/// if !books.contains(&"The Winds of Winter") {
///     println(`We have ${books.len()} books, but The Winds of Winter ain't one.`);
/// }
///
/// // Remove a book.
/// books.remove(&"The Odyssey");
///
/// // Iterate over everything, in order.
/// for book in &books {
///     println(`${book}`);
/// }
/// assert_eq(books.first(), Some(&"A Dance With Dragons"));
/// ```
///
/// A `BTreeSet` with a known list of items can be initialized from an array:
///
/// ```
/// use std::collections::BTreeSet;
///
/// let set = BTreeSet::from([1, 2, 3]);
/// assert_eq(set.len(), 3);
/// ```
///
/// Copies of a `BTreeSet` share its values; [`clone`](BTreeSet::clone) does
/// not:
///
/// ```
/// use std::collections::BTreeSet;
///
/// let a = BTreeSet::from([1]);
/// let mut b = a;
/// b.insert(2);
/// assert(a.contains(&2));
///
/// let mut c = a.clone();
/// c.insert(3);
/// assert(!a.contains(&3));
/// ```
pub struct BTreeSet<T> {
    m: BTreeMap<T, ()>,
}

impl<T> BTreeSet<T> {
    /// Makes a new, empty `BTreeSet`.
    ///
    /// Does not allocate anything on its own.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut set: BTreeSet<i32> = BTreeSet::new();
    /// set.insert(1);
    /// assert_eq(set.len(), 1);
    /// ```
    pub fn new() -> BTreeSet<T> {
        BTreeSet { m: BTreeMap::new() }
    }
    /// Returns the number of elements in the set.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut v = BTreeSet::new();
    /// assert_eq(v.len(), 0);
    /// v.insert(1);
    /// assert_eq(v.len(), 1);
    /// ```
    pub fn len(&self) -> usize {
        self.m.len()
    }
    /// Returns `true` if the set contains no elements.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut v = BTreeSet::new();
    /// assert(v.is_empty());
    /// v.insert(1);
    /// assert(!v.is_empty());
    /// ```
    pub fn is_empty(&self) -> bool {
        self.m.is_empty()
    }
    /// Clears the set, removing all elements.
    ///
    /// Every copy of the set's handle sees it empty.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut v = BTreeSet::new();
    /// v.insert(1);
    /// v.clear();
    /// assert(v.is_empty());
    /// ```
    pub fn clear(&mut self) {
        self.m.clear();
    }
    /// Gets an iterator that visits the elements in the `BTreeSet` in ascending
    /// order.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let set = BTreeSet::from([3, 1, 2]);
    /// let mut set_iter = set.iter();
    /// assert_eq(set_iter.next(), Some(&1));
    /// assert_eq(set_iter.next(), Some(&2));
    /// assert_eq(set_iter.next(), Some(&3));
    /// assert_eq(set_iter.next(), None);
    /// ```
    pub fn iter(&self) -> Iter<T> {
        Iter {
            keys: self.m.keys(),
        }
    }
    /// Returns a reference to the first element in the set, if any. This
    /// element is always the minimum of all elements in the set.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut set = BTreeSet::new();
    /// assert_eq(set.first(), None);
    /// set.insert(1);
    /// assert_eq(set.first(), Some(&1));
    /// set.insert(2);
    /// assert_eq(set.first(), Some(&1));
    /// ```
    pub fn first(&self) -> Option<&T> {
        match self.m.first_key_value() {
            Some((k, _)) => Some(k),
            None => None,
        }
    }
    /// Returns a reference to the last element in the set, if any. This element
    /// is always the maximum of all elements in the set.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut set = BTreeSet::new();
    /// assert_eq(set.last(), None);
    /// set.insert(1);
    /// assert_eq(set.last(), Some(&1));
    /// set.insert(2);
    /// assert_eq(set.last(), Some(&2));
    /// ```
    pub fn last(&self) -> Option<&T> {
        match self.m.last_key_value() {
            Some((k, _)) => Some(k),
            None => None,
        }
    }
}

impl<T: Ord> BTreeSet<T> {
    /// Adds a value to the set.
    ///
    /// Returns whether the value was newly inserted. That is:
    ///
    /// - If the set did not previously contain an equal value, `true` is
    ///   returned.
    /// - If the set already contained an equal value, `false` is returned, and
    ///   the entry is not updated.
    ///
    /// See [`replace`](BTreeSet::replace) to replace the stored value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut set = BTreeSet::new();
    ///
    /// assert_eq(set.insert(2), true);
    /// assert_eq(set.insert(2), false);
    /// assert_eq(set.len(), 1);
    /// ```
    pub fn insert(&mut self, value: T) -> bool {
        self.m.insert(value, ()).is_none()
    }
    /// Returns `true` if the set contains an element equal to the value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let set = BTreeSet::from([1, 2, 3]);
    /// assert_eq(set.contains(&1), true);
    /// assert_eq(set.contains(&4), false);
    /// ```
    pub fn contains(&self, value: &T) -> bool {
        self.m.contains_key(value)
    }
    /// If the set contains an element equal to the value, removes it from the
    /// set. Returns whether such an element was present.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut set = BTreeSet::new();
    ///
    /// set.insert(2);
    /// assert_eq(set.remove(&2), true);
    /// assert_eq(set.remove(&2), false);
    /// ```
    pub fn remove(&mut self, value: &T) -> bool {
        self.m.remove(value).is_some()
    }
    /// Returns a reference to the element in the set, if any, that is equal to
    /// the value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let set = BTreeSet::from([1, 2, 3]);
    /// assert_eq(set.get(&2), Some(&2));
    /// assert_eq(set.get(&4), None);
    /// ```
    pub fn get(&self, value: &T) -> Option<&T> {
        match self.m.get_key_value(value) {
            Some((k, _)) => Some(k),
            None => None,
        }
    }
    /// Removes and returns the element in the set, if any, that is equal to the
    /// value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut set = BTreeSet::from([1, 2, 3]);
    /// assert_eq(set.take(&2), Some(2));
    /// assert_eq(set.take(&2), None);
    /// ```
    pub fn take(&mut self, value: &T) -> Option<T> {
        match self.m.remove_entry(value) {
            Some((k, _)) => Some(k),
            None => None,
        }
    }

    /// Adds a value to the set, replacing the existing element, if any, that is
    /// equal to the value. Returns the replaced element.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut set = BTreeSet::new();
    /// set.insert(Vec::<i32>::new());
    ///
    /// assert_eq(set.get(&Vec::new()).unwrap().capacity(), 0);
    /// // The returned element is the one that was in the set.
    /// assert_eq(set.replace(Vec::with_capacity(10)).unwrap().capacity(), 0);
    /// assert(set.get(&Vec::new()).unwrap().capacity() >= 10);
    /// ```
    pub fn replace(&mut self, value: T) -> Option<T> {
        let old = self.take(&value);
        self.m.insert(value, ());
        old
    }

    /// Removes the first element from the set and returns it, if any. The first
    /// element is always the minimum element in the set.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut set = BTreeSet::new();
    ///
    /// set.insert(1);
    /// while let Some(n) = set.pop_first() {
    ///     assert_eq(n, 1);
    /// }
    /// assert(set.is_empty());
    /// ```
    pub fn pop_first(&mut self) -> Option<T> {
        match self.m.pop_first() {
            Some((k, _)) => Some(k),
            None => None,
        }
    }
    /// Removes the last element from the set and returns it, if any. The last
    /// element is always the maximum element in the set.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut set = BTreeSet::new();
    ///
    /// set.insert(1);
    /// while let Some(n) = set.pop_last() {
    ///     assert_eq(n, 1);
    /// }
    /// assert(set.is_empty());
    /// ```
    pub fn pop_last(&mut self) -> Option<T> {
        match self.m.pop_last() {
            Some((k, _)) => Some(k),
            None => None,
        }
    }

    /// Constructs a double-ended iterator over a sub-range of elements in the
    /// set, in ascending order.
    ///
    /// The simplest way is to use the range syntax `min..max`, thus
    /// `range(min..max)` will yield elements from min (inclusive) to max
    /// (exclusive). The range may also be entered as `(Bound<T>, Bound<T>)`, so
    /// for example `range((Excluded(4), Included(10)))` will yield a
    /// left-exclusive, right-inclusive range from 4 to 10. Unlike Rust's, the
    /// bounds are of the element type `T` itself (navi has no `Borrow`).
    ///
    /// # Panics
    ///
    /// Panics if range `start > end`. Panics if range `start == end` and both
    /// bounds are `Excluded`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    /// use std::ops::Bound::Included;
    ///
    /// let mut set = BTreeSet::new();
    /// set.insert(3);
    /// set.insert(5);
    /// set.insert(8);
    /// for elem in set.range((Included(4), Included(8))) {
    ///     println(`${elem}`);
    /// }
    /// assert_eq(set.range(4..).next(), Some(&5));
    /// ```
    #[track_caller]
    pub fn range<R: RangeBounds<T>>(&self, range: R) -> Range<T> {
        Range {
            r: self.m.range(range),
        }
    }

    /// Retains only the elements specified by the predicate.
    ///
    /// In other words, removes all elements `e` for which `f(&e)` returns
    /// `false`. The elements are visited in ascending order.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut set = BTreeSet::from([1, 2, 3, 4, 5, 6]);
    /// // Keep only the even numbers.
    /// set.retain(|&k| k % 2 == 0);
    /// let v: Vec<i32> = set.iter().cloned().collect();
    /// assert_eq(v, Vec::from([2, 4, 6]));
    /// ```
    pub fn retain(&mut self, f: fn(&T) -> bool) {
        let mut gone: Vec<T> = Vec::new();
        for v in self.iter() {
            if !f(v) {
                gone.push(*v);
            }
        }
        for v in gone.iter() {
            self.remove(v);
        }
    }

    /// Moves all elements from `other` into `self`, leaving `other` empty.
    ///
    /// Appending a set to itself (or to a copy of its handle) does nothing.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut a = BTreeSet::new();
    /// a.insert(1);
    /// a.insert(2);
    /// a.insert(3);
    ///
    /// let mut b = BTreeSet::new();
    /// b.insert(3);
    /// b.insert(4);
    /// b.insert(5);
    ///
    /// a.append(&mut b);
    ///
    /// assert_eq(a.len(), 5);
    /// assert_eq(b.len(), 0);
    ///
    /// assert(a.contains(&1));
    /// assert(a.contains(&2));
    /// assert(a.contains(&3));
    /// assert(a.contains(&4));
    /// assert(a.contains(&5));
    /// ```
    pub fn append(&mut self, other: &mut BTreeSet<T>) {
        self.m.append(&mut other.m);
    }

    /// Splits the collection into two at the value. Returns a new collection
    /// with all elements greater than or equal to the value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut a = BTreeSet::new();
    /// a.insert(1);
    /// a.insert(2);
    /// a.insert(3);
    /// a.insert(17);
    /// a.insert(41);
    ///
    /// let b = a.split_off(&3);
    ///
    /// assert_eq(a.len(), 2);
    /// assert_eq(b.len(), 3);
    ///
    /// assert(a.contains(&1));
    /// assert(a.contains(&2));
    ///
    /// assert(b.contains(&3));
    /// assert(b.contains(&17));
    /// assert(b.contains(&41));
    /// ```
    pub fn split_off(&mut self, value: &T) -> BTreeSet<T> {
        BTreeSet {
            m: self.m.split_off(value),
        }
    }

    /// Visits the elements representing the union, i.e., all the elements in
    /// `self` or `other`, without duplicates, in ascending order.
    ///
    /// `union` is a reserved word in navi: call it as `a.r#union(&b)`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut a = BTreeSet::new();
    /// a.insert(1);
    ///
    /// let mut b = BTreeSet::new();
    /// b.insert(2);
    ///
    /// let u: Vec<i32> = a.r#union(&b).cloned().collect();
    /// assert_eq(u, Vec::from([1, 2]));
    /// ```
    pub fn r#union(&self, other: &BTreeSet<T>) -> Union<T> {
        Union {
            m: Merge::new(self, other),
        }
    }
    /// Visits the elements representing the intersection, i.e., the elements
    /// that are both in `self` and `other`, in ascending order.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut a = BTreeSet::new();
    /// a.insert(1);
    /// a.insert(2);
    ///
    /// let mut b = BTreeSet::new();
    /// b.insert(2);
    /// b.insert(3);
    ///
    /// let intersection: Vec<i32> = a.intersection(&b).cloned().collect();
    /// assert_eq(intersection, Vec::from([2]));
    /// ```
    pub fn intersection(&self, other: &BTreeSet<T>) -> Intersection<T> {
        Intersection {
            m: Merge::new(self, other),
        }
    }
    /// Visits the elements representing the difference, i.e., the elements that
    /// are in `self` but not in `other`, in ascending order.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut a = BTreeSet::new();
    /// a.insert(1);
    /// a.insert(2);
    ///
    /// let mut b = BTreeSet::new();
    /// b.insert(2);
    /// b.insert(3);
    ///
    /// let diff: Vec<i32> = a.difference(&b).cloned().collect();
    /// assert_eq(diff, Vec::from([1]));
    /// ```
    pub fn difference(&self, other: &BTreeSet<T>) -> Difference<T> {
        Difference {
            m: Merge::new(self, other),
        }
    }
    /// Visits the elements representing the symmetric difference, i.e., the
    /// elements that are in `self` or in `other` but not in both, in ascending
    /// order.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut a = BTreeSet::new();
    /// a.insert(1);
    /// a.insert(2);
    ///
    /// let mut b = BTreeSet::new();
    /// b.insert(2);
    /// b.insert(3);
    ///
    /// let sym_diff: Vec<i32> = a.symmetric_difference(&b).cloned().collect();
    /// assert_eq(sym_diff, Vec::from([1, 3]));
    /// ```
    pub fn symmetric_difference(&self, other: &BTreeSet<T>) -> SymmetricDifference<T> {
        SymmetricDifference {
            m: Merge::new(self, other),
        }
    }

    /// Returns `true` if `self` has no elements in common with `other`. This is
    /// equivalent to checking for an empty intersection.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let a = BTreeSet::from([1, 2, 3]);
    /// let mut b = BTreeSet::new();
    ///
    /// assert_eq(a.is_disjoint(&b), true);
    /// b.insert(4);
    /// assert_eq(a.is_disjoint(&b), true);
    /// b.insert(1);
    /// assert_eq(a.is_disjoint(&b), false);
    /// ```
    pub fn is_disjoint(&self, other: &BTreeSet<T>) -> bool {
        self.intersection(other).next().is_none()
    }
    /// Returns `true` if the set is a subset of another, i.e., `other` contains
    /// at least all the elements in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let sup = BTreeSet::from([1, 2, 3]);
    /// let mut set = BTreeSet::new();
    ///
    /// assert_eq(set.is_subset(&sup), true);
    /// set.insert(2);
    /// assert_eq(set.is_subset(&sup), true);
    /// set.insert(4);
    /// assert_eq(set.is_subset(&sup), false);
    /// ```
    pub fn is_subset(&self, other: &BTreeSet<T>) -> bool {
        if self.len() > other.len() {
            return false;
        }
        self.difference(other).next().is_none()
    }
    /// Returns `true` if the set is a superset of another, i.e., `self`
    /// contains at least all the elements in `other`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let sub = BTreeSet::from([1, 2]);
    /// let mut set = BTreeSet::new();
    ///
    /// assert_eq(set.is_superset(&sub), false);
    ///
    /// set.insert(0);
    /// set.insert(1);
    /// assert_eq(set.is_superset(&sub), false);
    ///
    /// set.insert(2);
    /// assert_eq(set.is_superset(&sub), true);
    /// ```
    pub fn is_superset(&self, other: &BTreeSet<T>) -> bool {
        other.is_subset(self)
    }
}

/// An iterator over the items of a `BTreeSet`, in ascending order.
///
/// This `struct` is created by the [`iter`](BTreeSet::iter) method on
/// [`BTreeSet`]. It can be iterated from both ends and knows its exact length.
///
/// # Examples
///
/// ```
/// use std::collections::BTreeSet;
///
/// let set = BTreeSet::from([2, 1, 3]);
/// let mut iter = set.iter();
/// assert_eq(iter.len(), 3);
/// assert_eq(iter.next(), Some(&1));
/// assert_eq(iter.next_back(), Some(&3));
/// assert_eq(iter.len(), 1);
/// ```
pub struct Iter<T> {
    keys: btree_map::Keys<T, ()>,
}
impl<T> Iterator for Iter<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        self.keys.next()
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        self.keys.size_hint()
    }
}
impl<T> DoubleEndedIterator for Iter<T> {
    fn next_back(&mut self) -> Option<&T> {
        self.keys.next_back()
    }
}
impl<T> ExactSizeIterator for Iter<T> {}

/// An owning iterator over the items of a `BTreeSet`, in ascending order.
///
/// This `struct` is created by the [`into_iter`](BTreeSet::into_iter) method on
/// [`BTreeSet`] (provided by the [`IntoIterator`] trait). The set's other
/// handles still see its values.
///
/// # Examples
///
/// ```
/// use std::collections::BTreeSet;
///
/// let set = BTreeSet::from([2, 1, 3]);
/// let v: Vec<i32> = set.into_iter().rev().collect();
/// assert_eq(v, Vec::from([3, 2, 1]));
/// ```
pub struct IntoIter<T> {
    keys: btree_map::IntoKeys<T, ()>,
}
impl<T> Iterator for IntoIter<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        self.keys.next()
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        self.keys.size_hint()
    }
}
impl<T> DoubleEndedIterator for IntoIter<T> {
    fn next_back(&mut self) -> Option<T> {
        self.keys.next_back()
    }
}

/// An iterator over a sub-range of items in a `BTreeSet`, in ascending order.
///
/// This `struct` is created by the [`range`](BTreeSet::range) method on
/// [`BTreeSet`]. It can be iterated from both ends.
///
/// # Examples
///
/// ```
/// use std::collections::BTreeSet;
///
/// let set = BTreeSet::from([1, 2, 3, 4, 5]);
/// let v: Vec<i32> = set.range(2..4).rev().cloned().collect();
/// assert_eq(v, Vec::from([3, 2]));
/// ```
pub struct Range<T> {
    r: btree_map::Range<T, ()>,
}
impl<T> Iterator for Range<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        match self.r.next() {
            Some((k, _)) => Some(k),
            None => None,
        }
    }
}
impl<T> DoubleEndedIterator for Range<T> {
    fn next_back(&mut self) -> Option<&T> {
        match self.r.next_back() {
            Some((k, _)) => Some(k),
            None => None,
        }
    }
}

// Two sets walked side by side: the next value of each (a, b) and which
// of them is smaller.
struct Merge<T> {
    a: Iter<T>,
    b: Iter<T>,
    x: Option<&T>,
    y: Option<&T>,
}

impl<T: Ord> Merge<T> {
    fn new(a: &BTreeSet<T>, b: &BTreeSet<T>) -> Merge<T> {
        let mut m = Merge {
            a: a.iter(),
            b: b.iter(),
            x: None,
            y: None,
        };
        m.x = m.a.next();
        m.y = m.b.next();
        m
    }

    // The next value of either set with its source: Less if only in a,
    // Greater if only in b, Equal if in both (given once).
    fn next(&mut self) -> Option<(&T, Ordering)> {
        match (self.x, self.y) {
            (None, None) => None,
            (Some(x), None) => {
                self.x = self.a.next();
                Some((x, Ordering::Less))
            }
            (None, Some(y)) => {
                self.y = self.b.next();
                Some((y, Ordering::Greater))
            }
            (Some(x), Some(y)) => match x.cmp(y) {
                Ordering::Less => {
                    self.x = self.a.next();
                    Some((x, Ordering::Less))
                }
                Ordering::Greater => {
                    self.y = self.b.next();
                    Some((y, Ordering::Greater))
                }
                Ordering::Equal => {
                    self.x = self.a.next();
                    self.y = self.b.next();
                    Some((x, Ordering::Equal))
                }
            },
        }
    }
}

/// A lazy iterator producing elements in the union of `BTreeSet`s, in ascending
/// order.
///
/// This `struct` is created by the [`r#union`](BTreeSet::r#union) method on
/// [`BTreeSet`].
///
/// # Examples
///
/// ```
/// use std::collections::BTreeSet;
///
/// let a = BTreeSet::from([1, 3]);
/// let b = BTreeSet::from([2, 3]);
/// let mut u = a.r#union(&b);
/// assert_eq(u.next(), Some(&1));
/// assert_eq(u.next(), Some(&2));
/// assert_eq(u.next(), Some(&3));
/// assert_eq(u.next(), None);
/// ```
pub struct Union<T> {
    m: Merge<T>,
}
impl<T: Ord> Iterator for Union<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        match self.m.next() {
            Some((v, _)) => Some(v),
            None => None,
        }
    }
}

/// A lazy iterator producing elements in the intersection of `BTreeSet`s, in
/// ascending order.
///
/// This `struct` is created by the [`intersection`](BTreeSet::intersection)
/// method on [`BTreeSet`].
///
/// # Examples
///
/// ```
/// use std::collections::BTreeSet;
///
/// let a = BTreeSet::from([1, 2, 3]);
/// let b = BTreeSet::from([2, 3, 4]);
/// assert_eq(a.intersection(&b).count(), 2);
/// ```
pub struct Intersection<T> {
    m: Merge<T>,
}
impl<T: Ord> Iterator for Intersection<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        loop {
            if self.m.x.is_none() || self.m.y.is_none() {
                return None;
            }
            let (v, o) = self.m.next()?;
            if o == Ordering::Equal {
                return Some(v);
            }
        }
    }
}

/// A lazy iterator producing elements in the difference of `BTreeSet`s, in
/// ascending order.
///
/// This `struct` is created by the [`difference`](BTreeSet::difference) method
/// on [`BTreeSet`].
///
/// # Examples
///
/// ```
/// use std::collections::BTreeSet;
///
/// let a = BTreeSet::from([1, 2, 3]);
/// let b = BTreeSet::from([2, 3, 4]);
/// assert_eq(a.difference(&b).next(), Some(&1));
/// ```
pub struct Difference<T> {
    m: Merge<T>,
}
impl<T: Ord> Iterator for Difference<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        loop {
            if self.m.x.is_none() {
                return None;
            }
            let (v, o) = self.m.next()?;
            if o == Ordering::Less {
                return Some(v);
            }
        }
    }
}

/// A lazy iterator producing elements in the symmetric difference of
/// `BTreeSet`s, in ascending order.
///
/// This `struct` is created by the
/// [`symmetric_difference`](BTreeSet::symmetric_difference) method on
/// [`BTreeSet`].
///
/// # Examples
///
/// ```
/// use std::collections::BTreeSet;
///
/// let a = BTreeSet::from([1, 2, 3]);
/// let b = BTreeSet::from([2, 3, 4]);
/// let v: Vec<i32> = a.symmetric_difference(&b).cloned().collect();
/// assert_eq(v, Vec::from([1, 4]));
/// ```
pub struct SymmetricDifference<T> {
    m: Merge<T>,
}
impl<T: Ord> Iterator for SymmetricDifference<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        loop {
            let (v, o) = self.m.next()?;
            if o != Ordering::Equal {
                return Some(v);
            }
        }
    }
}

impl<T> IntoIterator for BTreeSet<T> {
    type Item = T;
    type IntoIter = IntoIter<T>;
    /// Gets an iterator for moving out the `BTreeSet`'s contents in ascending
    /// order.
    ///
    /// Unlike Rust's, this does not empty the set: its other handles still see
    /// the values.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let set = BTreeSet::from([1, 2, 3, 4]);
    ///
    /// let v: Vec<i32> = set.into_iter().collect();
    /// assert_eq(v, Vec::from([1, 2, 3, 4]));
    /// ```
    fn into_iter(self) -> IntoIter<T> {
        IntoIter {
            keys: self.m.into_keys(),
        }
    }
}

impl<T> IntoIterator for &BTreeSet<T> {
    type Item = &T;
    type IntoIter = Iter<T>;
    fn into_iter(self) -> Iter<T> {
        self.iter()
    }
}

impl<T: Clone> Clone for BTreeSet<T> {
    /// Makes an independent copy of the set, cloning every value.
    ///
    /// Assigning a `BTreeSet` only copies its handle; `clone` copies the tree.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let a = BTreeSet::from([1]);
    /// let mut b = a.clone();
    /// b.insert(2);
    /// assert_eq(a.len(), 1);
    /// assert_eq(b.len(), 2);
    /// ```
    fn clone(&self) -> BTreeSet<T> {
        BTreeSet { m: self.m.clone() }
    }
}

impl<T> Default for BTreeSet<T> {
    /// Creates an empty `BTreeSet`.
    fn default() -> BTreeSet<T> {
        BTreeSet::new()
    }
}

impl<T: Debug> Debug for BTreeSet<T> {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        let mut s = f.debug_set();
        for v in self.iter() {
            s.entry(v);
        }
        s.finish()
    }
}

impl<T: PartialEq> PartialEq for BTreeSet<T> {
    /// Returns `true` if both sets have the same values.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// assert(BTreeSet::from([1, 2]) == BTreeSet::from([2, 1]));
    /// assert(BTreeSet::from([1, 2]) != BTreeSet::from([1]));
    /// ```
    fn eq(&self, other: &BTreeSet<T>) -> bool {
        self.m == other.m
    }
}

impl<T: Eq> Eq for BTreeSet<T> {}

impl<T: crate::hash::Hash> crate::hash::Hash for BTreeSet<T> {
    fn hash<H: crate::hash::Hasher>(&self, state: &mut H) {
        state.write_usize(self.len());
        for v in self.iter() {
            v.hash(state);
        }
    }
}

impl<T: Ord> FromIterator<T> for BTreeSet<T> {
    /// Constructs a `BTreeSet` from an iterator, dropping duplicate values.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let set: BTreeSet<i32> = Vec::from([3, 1, 3, 2]).into_iter().collect();
    /// let v: Vec<i32> = set.iter().cloned().collect();
    /// assert_eq(v, Vec::from([1, 2, 3]));
    /// ```
    fn from_iter<I: IntoIterator<Item = T>>(iter: I) -> BTreeSet<T> {
        let mut s = BTreeSet::new();
        for v in iter {
            s.insert(v);
        }
        s
    }
}

impl<T: Ord> Extend<T> for BTreeSet<T> {
    /// Inserts every value of the iterator into the set.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let mut set = BTreeSet::from([1]);
    /// set.extend([1, 2, 3]);
    /// assert_eq(set.len(), 3);
    /// ```
    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {
        for v in iter {
            self.insert(v);
        }
    }
}

impl<T: Ord, const N: usize> From<[T; N]> for BTreeSet<T> {
    /// Converts a `[T; N]` into a `BTreeSet<T>`, dropping duplicate values.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeSet;
    ///
    /// let set1 = BTreeSet::from([1, 2, 3, 4]);
    /// let set2: BTreeSet<i32> = [1, 2, 3, 4].into_iter().collect();
    /// assert_eq(set1, set2);
    /// ```
    fn from(a: [T; N]) -> BTreeSet<T> {
        let mut s = BTreeSet::new();
        for v in a.iter() {
            s.insert(*v);
        }
        s
    }
}
