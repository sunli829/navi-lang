//! Collection types. HashMap, HashSet, VecDeque, BTreeMap, BTreeSet and
//! BinaryHeap have reference semantics like Vec: copies share the
//! contents; use clone() for an independent copy.

pub mod hash_map;
pub mod hash_set;
#[cfg(feature = "navic")]
pub mod vec_deque;
#[cfg(feature = "navic")]
pub mod btree_map;
#[cfg(feature = "navic")]
pub mod btree_set;
#[cfg(feature = "navic")]
pub mod binary_heap;

pub use self::hash_map::HashMap;
pub use self::hash_set::HashSet;
#[cfg(feature = "navic")]
pub use self::vec_deque::VecDeque;
#[cfg(feature = "navic")]
pub use self::btree_map::BTreeMap;
#[cfg(feature = "navic")]
pub use self::btree_set::BTreeSet;
#[cfg(feature = "navic")]
pub use self::binary_heap::BinaryHeap;
