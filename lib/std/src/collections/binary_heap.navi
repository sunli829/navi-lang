//! A priority queue: a max-heap in a Vec. BinaryHeap has reference
//! semantics like Vec: copies share the heap; use clone() for an
//! independent copy.

use crate::fmt::{self, Debug, Formatter};
use crate::slice;

pub struct BinaryHeap<T> {
    data: Vec<T>,
}

impl<T: Ord> BinaryHeap<T> {
    pub fn new() -> BinaryHeap<T> { BinaryHeap { data: Vec::new() } }
    pub fn with_capacity(capacity: usize) -> BinaryHeap<T> { BinaryHeap { data: Vec::with_capacity(capacity) } }

    pub fn push(&mut self, item: T) {
        self.data.push(item);
        let n = self.data.len();
        sift_up(&mut self.data, n - 1);
    }

    /// Removes and returns the greatest item.
    pub fn pop(&mut self) -> Option<T> {
        let mut last = self.data.pop()?;
        if self.data.len() > 0 {
            last = crate::mem::replace(&mut self.data[0], last);
            sift_down_to_bottom(&mut self.data, 0);
        }
        Some(last)
    }

    /// The greatest item.
    pub fn peek(&self) -> Option<&T> { self.data.first() }

    /// Moves all the items of other into this heap, leaving other empty.
    pub fn append(&mut self, other: &mut BinaryHeap<T>) {
        let n = other.data.len();
        let mut i = 0;
        while i < n { self.push(other.data[i]); i += 1; }
        other.data.clear();
    }

    pub fn retain(&mut self, f: fn(&T) -> bool) {
        self.data.retain(f);
        heapify(&mut self.data);
    }

    /// The items in ascending order (a sorted copy: the heap is left as
    /// it is).
    pub fn into_sorted_vec(self) -> Vec<T> {
        let mut v: Vec<T> = Vec::with_capacity(self.data.len());
        for x in self.data.iter() { v.push(*x); }
        let mut end = v.len();
        while end > 1 {
            end -= 1;
            v.swap(0, end);
            sift_down(&mut v, 0, end);
        }
        v
    }
}

impl<T> BinaryHeap<T> {
    pub fn len(&self) -> usize { self.data.len() }
    pub fn is_empty(&self) -> bool { self.data.is_empty() }
    pub fn capacity(&self) -> usize { self.data.capacity() }
    pub fn reserve(&mut self, additional: usize) { self.data.reserve(additional); }
    pub fn clear(&mut self) { self.data.clear(); }

    /// The items in heap order (no particular order).
    pub fn iter(&self) -> Iter<T> { Iter { it: self.data.iter() } }
    pub fn as_slice(&self) -> &[T] { self.data.as_slice() }

    /// The underlying Vec, in heap order (shared with the heap).
    pub fn into_vec(self) -> Vec<T> { self.data }

    /// Removes all the items, returning them in heap order.
    pub fn drain(&mut self) -> crate::vec::IntoIter<T> {
        let mut v: Vec<T> = Vec::with_capacity(self.data.len());
        for x in self.data.iter() { v.push(*x); }
        self.data.clear();
        v.into_iter()
    }
}

// Moves data[i] up while it is greater than its parent. (Raw pointers:
// the indexes are in bounds.)
fn sift_up<T: Ord>(data: &mut Vec<T>, i: usize) {
    let b = data.as_ptr() as *mut T;
    let mut i = i;
    let x = unsafe { b.add(i).read() };
    while i > 0 {
        let p = (i - 1) / 2;
        let pv = unsafe { b.add(p).read() };
        if x <= pv { break; }
        unsafe { b.add(i).write(pv); }
        i = p;
    }
    unsafe { b.add(i).write(x); }
}

// Moves data[i] down while a child within data[..end] is greater.
fn sift_down<T: Ord>(data: &mut Vec<T>, i: usize, end: usize) {
    let b = data.as_ptr() as *mut T;
    let mut i = i;
    let x = unsafe { b.add(i).read() };
    loop {
        let mut c = 2 * i + 1;
        if c >= end { break; }
        let mut cv = unsafe { b.add(c).read() };
        if c + 1 < end {
            let rv = unsafe { b.add(c + 1).read() };
            if cv < rv { c += 1; cv = rv; }
        }
        if x >= cv { break; }
        unsafe { b.add(i).write(cv); }
        i = c;
    }
    unsafe { b.add(i).write(x); }
}

// Moves data[i] down to a leaf along the greater children, then back up
// to its place (fewer comparisons for an item from the bottom, as in pop).
fn sift_down_to_bottom<T: Ord>(data: &mut Vec<T>, i: usize) {
    let b = data.as_ptr() as *mut T;
    let end = data.len();
    let start = i;
    let mut i = i;
    let x = unsafe { b.add(i).read() };
    loop {
        let mut c = 2 * i + 1;
        if c >= end { break; }
        let mut cv = unsafe { b.add(c).read() };
        if c + 1 < end {
            let rv = unsafe { b.add(c + 1).read() };
            if cv < rv { c += 1; cv = rv; }
        }
        unsafe { b.add(i).write(cv); }
        i = c;
    }
    while i > start {
        let p = (i - 1) / 2;
        let pv = unsafe { b.add(p).read() };
        if x <= pv { break; }
        unsafe { b.add(i).write(pv); }
        i = p;
    }
    unsafe { b.add(i).write(x); }
}

fn heapify<T: Ord>(data: &mut Vec<T>) {
    let n = data.len();
    let mut i = n / 2;
    while i > 0 {
        i -= 1;
        sift_down(data, i, n);
    }
}

impl<T: Ord> From<Vec<T>> for BinaryHeap<T> {
    /// Heapifies the Vec in place (the heap shares it), in O(n).
    fn from(v: Vec<T>) -> BinaryHeap<T> {
        let mut data = v;
        heapify(&mut data);
        BinaryHeap { data }
    }
}

impl<T> From<BinaryHeap<T>> for Vec<T> {
    fn from(h: BinaryHeap<T>) -> Vec<T> { h.data }
}

impl<T: Ord> FromIterator<T> for BinaryHeap<T> {
    fn from_iter<I: IntoIterator<Item = T>>(iter: I) -> BinaryHeap<T> {
        let mut data: Vec<T> = Vec::new();
        for x in iter { data.push(x); }
        heapify(&mut data);
        BinaryHeap { data }
    }
}

impl<T: Ord> Extend<T> for BinaryHeap<T> {
    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {
        for x in iter { self.push(x); }
    }
}

/// An iterator over the items of a heap, in heap order.
pub struct Iter<T> { it: slice::Iter<T> }
impl<T> Iterator for Iter<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> { self.it.next() }
    fn size_hint(&self) -> (usize, Option<usize>) { self.it.size_hint() }
}
impl<T> DoubleEndedIterator for Iter<T> {
    fn next_back(&mut self) -> Option<&T> { self.it.next_back() }
}
impl<T> ExactSizeIterator for Iter<T> {}

/// The by-value iterator of a heap, in heap order.
pub struct IntoIter<T> { it: crate::vec::IntoIter<T> }
impl<T> Iterator for IntoIter<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> { self.it.next() }
}
impl<T> DoubleEndedIterator for IntoIter<T> {
    fn next_back(&mut self) -> Option<T> { self.it.next_back() }
}

impl<T> IntoIterator for BinaryHeap<T> {
    type Item = T;
    type IntoIter = IntoIter<T>;
    /// The items in heap order (no particular order).
    fn into_iter(self) -> IntoIter<T> { IntoIter { it: self.data.into_iter() } }
}

impl<T> IntoIterator for &BinaryHeap<T> {
    type Item = &T;
    type IntoIter = Iter<T>;
    fn into_iter(self) -> Iter<T> { self.iter() }
}

impl<T: Clone> Clone for BinaryHeap<T> {
    fn clone(&self) -> BinaryHeap<T> { BinaryHeap { data: self.data.clone() } }
}

impl<T: Ord> Default for BinaryHeap<T> {
    fn default() -> BinaryHeap<T> { BinaryHeap::new() }
}

impl<T: Debug> Debug for BinaryHeap<T> {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        let mut l = f.debug_list();
        for x in self.data.iter() { l.entry(x); }
        l.finish()
    }
}
