//! A priority queue implemented with a binary heap.
//!
//! Insertion and popping the largest element have *O*(log(*n*)) time
//! complexity. Checking the largest element is *O*(1). Converting a vector to
//! a binary heap can be done in-place, and has *O*(*n*) complexity.
//!
//! A [`BinaryHeap`] is a max-heap kept in a [`Vec`]. Like a `Vec` it is a
//! shared handle: copies share the heap; use `clone()` for an independent
//! copy.
//!
//! # Examples
//!
//! This is a larger example that implements [Dijkstra's algorithm][dijkstra]
//! to solve the [shortest path problem][sssp] on a [directed graph][dir_graph].
//! It shows how to use [`BinaryHeap`] with custom types.
//!
//! [dijkstra]: https://en.wikipedia.org/wiki/Dijkstra%27s_algorithm
//! [sssp]: https://en.wikipedia.org/wiki/Shortest_path_problem
//! [dir_graph]: https://en.wikipedia.org/wiki/Directed_graph
//!
//! ```
//! use std::cmp::Ordering;
//! use std::collections::BinaryHeap;
//!
//! #[derive(Clone, PartialEq, Eq)]
//! struct State {
//!     cost: usize,
//!     position: usize,
//! }
//!
//! // The priority queue depends on `Ord`. Explicitly implement the trait so
//! // the queue becomes a min-heap instead of a max-heap.
//! impl Ord for State {
//!     fn cmp(&self, other: &State) -> Ordering {
//!         // Notice that we flip the ordering on costs. In case of a tie we
//!         // compare positions: this keeps `PartialEq` and `Ord` consistent.
//!         other.cost.cmp(&self.cost).then(self.position.cmp(&other.position))
//!     }
//! }
//!
//! // `PartialOrd` needs to be implemented as well.
//! impl PartialOrd for State {
//!     fn partial_cmp(&self, other: &State) -> Option<Ordering> {
//!         Some(self.cmp(other))
//!     }
//! }
//!
//! // Each node is represented as a `usize`, for a shorter implementation.
//! #[derive(Clone)]
//! struct Edge {
//!     node: usize,
//!     cost: usize,
//! }
//!
//! // Dijkstra's shortest path algorithm.
//!
//! // Start at `start` and use `dist` to track the current shortest distance
//! // to each node. This implementation isn't memory-efficient as it may leave
//! // duplicate nodes in the queue.
//! fn shortest_path(adj_list: &Vec<Vec<Edge>>, start: usize, goal: usize) -> Option<usize> {
//!     // dist[node] = current shortest distance from `start` to `node`
//!     let mut dist: Vec<usize> = (0..adj_list.len()).map(|_| usize::MAX).collect();
//!     let mut heap = BinaryHeap::new();
//!
//!     // We're at `start`, with a zero cost.
//!     dist[start] = 0;
//!     heap.push(State { cost: 0, position: start });
//!
//!     // Examine the frontier with lower cost nodes first (min-heap).
//!     while let Some(State { cost, position }) = heap.pop() {
//!         // Alternatively we could have continued to find all shortest paths.
//!         if position == goal {
//!             return Some(cost);
//!         }
//!         // Important as we may have already found a better way.
//!         if cost > dist[position] {
//!             continue;
//!         }
//!         // For each node we can reach, see if we can find a way with a
//!         // lower cost going through this node.
//!         for edge in adj_list[position].iter() {
//!             let next = State { cost: cost + edge.cost, position: edge.node };
//!             // If so, add it to the frontier and continue.
//!             if next.cost < dist[next.position] {
//!                 dist[next.position] = next.cost;
//!                 heap.push(next);
//!             }
//!         }
//!     }
//!     // Goal not reachable.
//!     None
//! }
//!
//! // This is the directed graph we're going to use. The node numbers
//! // correspond to the different states, and the edge weights symbolize the
//! // cost of moving from one node to another. Note that the edges are
//! // one-way.
//! //
//! //                  7
//! //          +-----------------+
//! //          |                 |
//! //          v   1        2    |  2
//! //          0 -----> 1 -----> 3 ---> 4
//! //          |        ^        ^      ^
//! //          |        | 1      |      |
//! //          |        |        | 3    | 1
//! //          +------> 2 -------+      |
//! //           10      |               |
//! //                   +---------------+
//! //
//! // The graph is represented as an adjacency list where each index,
//! // corresponding to a node value, has a list of outgoing edges.
//! let graph = Vec::from([
//!     // Node 0
//!     Vec::from([Edge { node: 2, cost: 10 }, Edge { node: 1, cost: 1 }]),
//!     // Node 1
//!     Vec::from([Edge { node: 3, cost: 2 }]),
//!     // Node 2
//!     Vec::from([
//!         Edge { node: 1, cost: 1 },
//!         Edge { node: 3, cost: 3 },
//!         Edge { node: 4, cost: 1 },
//!     ]),
//!     // Node 3
//!     Vec::from([Edge { node: 0, cost: 7 }, Edge { node: 4, cost: 2 }]),
//!     // Node 4
//!     Vec::new(),
//! ]);
//!
//! assert_eq(shortest_path(&graph, 0, 1), Some(1));
//! assert_eq(shortest_path(&graph, 0, 3), Some(3));
//! assert_eq(shortest_path(&graph, 3, 0), Some(7));
//! assert_eq(shortest_path(&graph, 0, 4), Some(5));
//! assert_eq(shortest_path(&graph, 4, 0), None);
//! ```

use crate::fmt::{self, Debug, Formatter};
use crate::slice;

/// A priority queue implemented with a binary heap.
///
/// This will be a max-heap: [`pop`](BinaryHeap::pop) and
/// [`peek`](BinaryHeap::peek) give the greatest item. A min-heap is a
/// `BinaryHeap` of [`Reverse`](crate::cmp::Reverse) items.
///
/// It is a logic error for an item to be modified in such a way that the
/// item's ordering relative to any other item, as determined by the [`Ord`]
/// trait, changes while it is in the heap. The behavior resulting from such a
/// logic error is not specified (the heap may give items in the wrong order),
/// but it is not undefined behavior.
///
/// Navi's `BinaryHeap` differs from Rust's:
///
/// - It is a shared handle, as [`Vec`] is: assigning or passing a heap shares
///   it, and [`clone`](Clone::clone) makes an independent copy.
/// - There is no `peek_mut` (there is no Drop to restore the heap when the
///   item is changed): [`pop`](BinaryHeap::pop) the item and
///   [`push`](BinaryHeap::push) it back instead.
/// - [`into_sorted_vec`](BinaryHeap::into_sorted_vec) returns a sorted copy
///   and leaves the heap as it is.
/// - [`drain`](BinaryHeap::drain) takes the items out at once and returns
///   an iterator over them.
///
/// # Examples
///
/// ```
/// use std::collections::BinaryHeap;
///
/// let mut heap = BinaryHeap::new();
///
/// // We can use peek to look at the next item in the heap. In this case,
/// // there's no items in there yet so we get None.
/// assert_eq(heap.peek(), None);
///
/// // Let's add some scores...
/// heap.push(1);
/// heap.push(5);
/// heap.push(2);
///
/// // Now peek shows the most important item in the heap.
/// assert_eq(heap.peek(), Some(&5));
///
/// // We can check the length of a heap.
/// assert_eq(heap.len(), 3);
///
/// // We can iterate over the items in the heap, although they are returned in
/// // an unspecified order.
/// for x in heap.iter() {
///     println(`${x}`);
/// }
///
/// // If we instead pop these scores, they should come back in order.
/// assert_eq(heap.pop(), Some(5));
/// assert_eq(heap.pop(), Some(2));
/// assert_eq(heap.pop(), Some(1));
/// assert_eq(heap.pop(), None);
///
/// // We can clear the heap of any remaining items.
/// heap.clear();
///
/// // The heap should now be empty.
/// assert(heap.is_empty());
/// ```
///
/// A `BinaryHeap` with a known list of items can be initialized from a
/// vector:
///
/// ```
/// use std::collections::BinaryHeap;
///
/// let heap = BinaryHeap::from(Vec::from([1, 5, 2]));
/// assert_eq(heap.peek(), Some(&5));
/// ```
///
/// # Min-heap
///
/// Either [`Reverse`](crate::cmp::Reverse) or a custom [`Ord`] implementation
/// can be used to make `BinaryHeap` a min-heap. This makes `heap.pop()` return
/// the smallest value instead of the greatest one.
///
/// ```
/// use std::collections::BinaryHeap;
/// use std::cmp::Reverse;
///
/// let mut heap = BinaryHeap::new();
///
/// // Wrap values in `Reverse`.
/// heap.push(Reverse(1));
/// heap.push(Reverse(5));
/// heap.push(Reverse(2));
///
/// // If we pop these scores now, they should come back in the reverse order.
/// assert_eq(heap.pop().map(|r| r.0), Some(1));
/// assert_eq(heap.pop().map(|r| r.0), Some(2));
/// assert_eq(heap.pop().map(|r| r.0), Some(5));
/// assert(heap.pop().is_none());
/// ```
///
/// # Time complexity
///
/// | [push] | [pop]         | [peek] |
/// |--------|---------------|--------|
/// | *O*(log(*n*)) | *O*(log(*n*)) | *O*(1) |
///
/// [push]: BinaryHeap::push
/// [pop]: BinaryHeap::pop
/// [peek]: BinaryHeap::peek
pub struct BinaryHeap<T> {
    data: Vec<T>,
}

impl<T: Ord> BinaryHeap<T> {
    /// Creates an empty `BinaryHeap` as a max-heap.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BinaryHeap;
    ///
    /// let mut heap = BinaryHeap::new();
    /// heap.push(4);
    /// assert_eq(heap.len(), 1);
    /// ```
    pub fn new() -> BinaryHeap<T> {
        BinaryHeap { data: Vec::new() }
    }

    /// Creates an empty `BinaryHeap` with at least the specified capacity.
    ///
    /// The binary heap will be able to hold at least `capacity` elements
    /// without reallocating. If `capacity` is 0, the binary heap will not
    /// allocate.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BinaryHeap;
    ///
    /// let mut heap = BinaryHeap::with_capacity(10);
    /// assert(heap.capacity() >= 10);
    /// heap.push(4);
    /// assert_eq(heap.len(), 1);
    /// ```
    pub fn with_capacity(capacity: usize) -> BinaryHeap<T> {
        BinaryHeap {
            data: Vec::with_capacity(capacity),
        }
    }

    /// Pushes an item onto the binary heap.
    ///
    /// # Time complexity
    ///
    /// The expected cost of `push`, averaged over every possible ordering of
    /// the elements being pushed, and over a sufficiently large number of
    /// pushes, is *O*(1). The worst case cost is *O*(log(*n*)).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BinaryHeap;
    ///
    /// let mut heap = BinaryHeap::new();
    /// heap.push(3);
    /// heap.push(5);
    /// heap.push(1);
    ///
    /// assert_eq(heap.len(), 3);
    /// assert_eq(heap.peek(), Some(&5));
    /// ```
    pub fn push(&mut self, item: T) {
        self.data.push(item);
        let n = self.data.len();
        sift_up(&mut self.data, n - 1);
    }

    /// Removes the greatest item from the binary heap and returns it, or
    /// [`None`] if it is empty.
    ///
    /// # Time complexity
    ///
    /// The worst case cost of `pop` on a heap containing *n* elements is
    /// *O*(log(*n*)).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BinaryHeap;
    ///
    /// let mut heap = BinaryHeap::from(Vec::from([1, 3]));
    ///
    /// assert_eq(heap.pop(), Some(3));
    /// assert_eq(heap.pop(), Some(1));
    /// assert_eq(heap.pop(), None);
    /// ```
    pub fn pop(&mut self) -> Option<T> {
        let mut last = self.data.pop()?;
        if self.data.len() > 0 {
            last = crate::mem::replace(&mut self.data[0], last);
            sift_down_to_bottom(&mut self.data, 0);
        }
        Some(last)
    }

    /// Returns the greatest item in the binary heap, or [`None`] if it is
    /// empty.
    ///
    /// There is no `peek_mut` in navi: to change the greatest item, `pop` it
    /// and `push` it back.
    ///
    /// # Time complexity
    ///
    /// Cost is *O*(1) in the worst case.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BinaryHeap;
    ///
    /// let mut heap = BinaryHeap::new();
    /// assert_eq(heap.peek(), None);
    ///
    /// heap.push(1);
    /// heap.push(5);
    /// heap.push(2);
    /// assert_eq(heap.peek(), Some(&5));
    /// ```
    pub fn peek(&self) -> Option<&T> {
        self.data.first()
    }

    /// Moves all the items of `other` into `self`, leaving `other` empty.
    ///
    /// `other` must be a different heap: if it shares its buffer with `self`
    /// (a copy of the same heap), the items are lost.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BinaryHeap;
    ///
    /// let mut a = BinaryHeap::from(Vec::from([-10, 1, 2, 3, 3]));
    /// let mut b = BinaryHeap::from(Vec::from([-20, 5, 43]));
    ///
    /// a.append(&mut b);
    ///
    /// assert_eq(a.into_sorted_vec(), Vec::from([-20, -10, 1, 2, 3, 3, 5, 43]));
    /// assert(b.is_empty());
    /// ```
    pub fn append(&mut self, other: &mut BinaryHeap<T>) {
        let n = other.data.len();
        let mut i = 0;
        while i < n {
            self.push(other.data[i]);
            i += 1;
        }
        other.data.clear();
    }

    /// Retains only the items specified by the predicate.
    ///
    /// In other words, removes all items `e` for which `f(&e)` returns `false`.
    /// The items are visited in unsorted (and unspecified) order.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BinaryHeap;
    ///
    /// let mut heap = BinaryHeap::from(Vec::from([-10, -5, 1, 2, 4, 13]));
    ///
    /// heap.retain(|x| *x % 2 == 0); // only keep even numbers
    ///
    /// assert_eq(heap.into_sorted_vec(), Vec::from([-10, 2, 4]));
    /// ```
    pub fn retain(&mut self, f: fn(&T) -> bool) {
        self.data.retain(f);
        heapify(&mut self.data);
    }

    /// Returns the items in a new vector, in sorted (ascending) order.
    ///
    /// Unlike Rust's, which sorts the heap's buffer in place, this sorts a copy
    /// and leaves the heap as it is: without moves, sorting in place would
    /// break a heap that other copies still share.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BinaryHeap;
    ///
    /// let mut heap = BinaryHeap::from(Vec::from([1, 2, 4, 5, 7]));
    /// heap.push(6);
    /// heap.push(3);
    ///
    /// let vec = heap.into_sorted_vec();
    /// assert_eq(vec, Vec::from([1, 2, 3, 4, 5, 6, 7]));
    /// assert_eq(heap.len(), 7);
    /// ```
    pub fn into_sorted_vec(self) -> Vec<T> {
        let mut v: Vec<T> = Vec::with_capacity(self.data.len());
        for x in self.data.iter() {
            v.push(*x);
        }
        let mut end = v.len();
        while end > 1 {
            end -= 1;
            v.swap(0, end);
            sift_down(&mut v, 0, end);
        }
        v
    }
}

impl<T> BinaryHeap<T> {
    /// Returns the length of the binary heap.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BinaryHeap;
    ///
    /// let heap = BinaryHeap::from(Vec::from([1, 3]));
    ///
    /// assert_eq(heap.len(), 2);
    /// ```
    pub fn len(&self) -> usize {
        self.data.len()
    }

    /// Checks if the binary heap is empty.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BinaryHeap;
    ///
    /// let mut heap = BinaryHeap::new();
    ///
    /// assert(heap.is_empty());
    ///
    /// heap.push(3);
    /// heap.push(5);
    /// heap.push(1);
    ///
    /// assert(!heap.is_empty());
    /// ```
    pub fn is_empty(&self) -> bool {
        self.data.is_empty()
    }

    /// Returns the number of elements the binary heap can hold without
    /// reallocating.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BinaryHeap;
    ///
    /// let mut heap = BinaryHeap::with_capacity(100);
    /// assert(heap.capacity() >= 100);
    /// heap.push(4);
    /// ```
    pub fn capacity(&self) -> usize {
        self.data.capacity()
    }

    /// Reserves capacity for at least `additional` elements more than the
    /// current length.
    ///
    /// The allocator may reserve more space to speculatively avoid frequent
    /// allocations. After calling `reserve`, capacity will be greater than or
    /// equal to `self.len() + additional`. Does nothing if capacity is already
    /// sufficient.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BinaryHeap;
    ///
    /// let mut heap = BinaryHeap::new();
    /// heap.reserve(100);
    /// assert(heap.capacity() >= 100);
    /// heap.push(4);
    /// ```
    pub fn reserve(&mut self, additional: usize) {
        self.data.reserve(additional);
    }

    /// Drops all items from the binary heap.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BinaryHeap;
    ///
    /// let mut heap = BinaryHeap::from(Vec::from([1, 3]));
    ///
    /// assert(!heap.is_empty());
    ///
    /// heap.clear();
    ///
    /// assert(heap.is_empty());
    /// ```
    pub fn clear(&mut self) {
        self.data.clear();
    }

    /// Returns an iterator visiting all values in the underlying vector, in
    /// arbitrary order (the heap's order, not a sorted one).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BinaryHeap;
    ///
    /// let heap = BinaryHeap::from(Vec::from([1, 2, 3, 4]));
    ///
    /// let sum: i32 = heap.iter().copied().sum();
    /// assert_eq(sum, 10);
    /// ```
    pub fn iter(&self) -> Iter<T> {
        Iter {
            it: self.data.iter(),
        }
    }

    /// Returns a slice of all values in the underlying vector, in arbitrary
    /// order (the heap's order).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BinaryHeap;
    ///
    /// let heap = BinaryHeap::from(Vec::from([1, 2, 3, 4, 5, 6, 7]));
    /// assert_eq(heap.as_slice().len(), 7);
    /// assert_eq(heap.as_slice()[0], 7);
    /// ```
    pub fn as_slice(&self) -> &[T] {
        self.data.as_slice()
    }

    /// Returns the underlying vector, in arbitrary order (the heap's order).
    ///
    /// Unlike Rust's, the vector is not a copy: it is the heap's own buffer, so
    /// the heap and the vector share their items. Change the vector only if the
    /// heap is not used anymore.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BinaryHeap;
    ///
    /// let heap = BinaryHeap::from(Vec::from([1, 2, 3, 4, 5, 6, 7]));
    /// let mut vec = heap.into_vec();
    /// vec.sort();
    /// assert_eq(vec, Vec::from([1, 2, 3, 4, 5, 6, 7]));
    /// ```
    pub fn into_vec(self) -> Vec<T> {
        self.data
    }

    /// Clears the binary heap, returning an iterator over the removed items, in
    /// arbitrary order (the heap's order).
    ///
    /// Unlike Rust's lazy `Drain`, the items are taken out at once: the heap is
    /// empty as soon as `drain` returns, and the iterator holds the items.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BinaryHeap;
    ///
    /// let mut heap = BinaryHeap::from(Vec::from([1, 3]));
    ///
    /// assert(!heap.is_empty());
    /// let mut items: Vec<i32> = heap.drain().collect();
    /// assert(heap.is_empty());
    ///
    /// items.sort();
    /// assert_eq(items, Vec::from([1, 3]));
    /// ```
    pub fn drain(&mut self) -> crate::vec::IntoIter<T> {
        let mut v: Vec<T> = Vec::with_capacity(self.data.len());
        for x in self.data.iter() {
            v.push(*x);
        }
        self.data.clear();
        v.into_iter()
    }
}

// Moves data[i] up while it is greater than its parent. (Raw pointers:
// the indexes are in bounds.)
fn sift_up<T: Ord>(data: &mut [T], i: usize) {
    let b = data.as_ptr() as *mut T;
    let mut i = i;
    let x = unsafe { b.add(i).read() };
    while i > 0 {
        let p = (i - 1) / 2;
        let pv = unsafe { b.add(p).read() };
        if x <= pv {
            break;
        }
        unsafe {
            b.add(i).write(pv);
        }
        i = p;
    }
    unsafe {
        b.add(i).write(x);
    }
}

// Moves data[i] down while a child within data[..end] is greater.
fn sift_down<T: Ord>(data: &mut [T], i: usize, end: usize) {
    let b = data.as_ptr() as *mut T;
    let mut i = i;
    let x = unsafe { b.add(i).read() };
    loop {
        let mut c = 2 * i + 1;
        if c >= end {
            break;
        }
        let mut cv = unsafe { b.add(c).read() };
        if c + 1 < end {
            let rv = unsafe { b.add(c + 1).read() };
            if cv < rv {
                c += 1;
                cv = rv;
            }
        }
        if x >= cv {
            break;
        }
        unsafe {
            b.add(i).write(cv);
        }
        i = c;
    }
    unsafe {
        b.add(i).write(x);
    }
}

// Moves data[i] down to a leaf along the greater children, then back up
// to its place (fewer comparisons for an item from the bottom, as in pop).
fn sift_down_to_bottom<T: Ord>(data: &mut [T], i: usize) {
    let b = data.as_ptr() as *mut T;
    let end = data.len();
    let start = i;
    let mut i = i;
    let x = unsafe { b.add(i).read() };
    loop {
        let mut c = 2 * i + 1;
        if c >= end {
            break;
        }
        let mut cv = unsafe { b.add(c).read() };
        if c + 1 < end {
            let rv = unsafe { b.add(c + 1).read() };
            if cv < rv {
                c += 1;
                cv = rv;
            }
        }
        unsafe {
            b.add(i).write(cv);
        }
        i = c;
    }
    while i > start {
        let p = (i - 1) / 2;
        let pv = unsafe { b.add(p).read() };
        if x <= pv {
            break;
        }
        unsafe {
            b.add(i).write(pv);
        }
        i = p;
    }
    unsafe {
        b.add(i).write(x);
    }
}

fn heapify<T: Ord>(data: &mut [T]) {
    let n = data.len();
    let mut i = n / 2;
    while i > 0 {
        i -= 1;
        sift_down(data, i, n);
    }
}

impl<T: Ord> From<Vec<T>> for BinaryHeap<T> {
    /// Converts a `Vec<T>` into a `BinaryHeap<T>`.
    ///
    /// This conversion happens in-place, and has *O*(*n*) time complexity. As
    /// collections are shared handles, the heap keeps the vector itself as its
    /// buffer: the vector's items are reordered, and the two share them.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BinaryHeap;
    ///
    /// let mut heap = BinaryHeap::from(Vec::from([1, 5, 2]));
    /// assert_eq(heap.pop(), Some(5));
    /// ```
    fn from(v: Vec<T>) -> BinaryHeap<T> {
        let mut data = v;
        heapify(&mut data);
        BinaryHeap { data }
    }
}

impl<T> From<BinaryHeap<T>> for Vec<T> {
    /// Converts a `BinaryHeap<T>` into a `Vec<T>`: its buffer, in heap order,
    /// as [`BinaryHeap::into_vec`].
    fn from(h: BinaryHeap<T>) -> Vec<T> {
        h.data
    }
}

impl<T: Ord> FromIterator<T> for BinaryHeap<T> {
    fn from_iter<I: IntoIterator<Item = T>>(iter: I) -> BinaryHeap<T> {
        let mut data: Vec<T> = Vec::new();
        for x in iter {
            data.push(x);
        }
        heapify(&mut data);
        BinaryHeap { data }
    }
}

impl<T: Ord> Extend<T> for BinaryHeap<T> {
    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {
        for x in iter {
            self.push(x);
        }
    }
}

/// An iterator over the items of a `BinaryHeap`, in heap order (not sorted).
///
/// This struct is created by [`BinaryHeap::iter`]. Its items are `&T`.
///
/// # Examples
///
/// ```
/// use std::collections::BinaryHeap;
///
/// let heap = BinaryHeap::from(Vec::from([3]));
/// let mut iter = heap.iter();
/// assert_eq(iter.next(), Some(&3));
/// assert_eq(iter.next(), None);
/// ```
pub struct Iter<T> {
    it: slice::Iter<T>,
}

impl<T> Iterator for Iter<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        self.it.next()
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        self.it.size_hint()
    }
}

impl<T> DoubleEndedIterator for Iter<T> {
    fn next_back(&mut self) -> Option<&T> {
        self.it.next_back()
    }
}

impl<T> ExactSizeIterator for Iter<T> {}

/// An owning iterator over the items of a `BinaryHeap`, in heap order (not
/// sorted).
///
/// This struct is created by the `into_iter` method on [`BinaryHeap`]
/// (provided by the [`IntoIterator`] trait). It reads the heap's buffer, which
/// it shares: the heap itself is not emptied.
///
/// # Examples
///
/// ```
/// use std::collections::BinaryHeap;
///
/// let heap = BinaryHeap::from(Vec::from([1, 2, 3, 4]));
/// let mut v: Vec<i32> = heap.into_iter().collect();
/// v.sort();
/// assert_eq(v, Vec::from([1, 2, 3, 4]));
/// ```
pub struct IntoIter<T> {
    it: crate::vec::IntoIter<T>,
}

impl<T> Iterator for IntoIter<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        self.it.next()
    }
}

impl<T> DoubleEndedIterator for IntoIter<T> {
    fn next_back(&mut self) -> Option<T> {
        self.it.next_back()
    }
}

impl<T> IntoIterator for BinaryHeap<T> {
    type Item = T;
    type IntoIter = IntoIter<T>;
    /// Creates a consuming iterator, that is, one that yields each value of the
    /// binary heap in arbitrary order (the heap's order, not a sorted one).
    fn into_iter(self) -> IntoIter<T> {
        IntoIter {
            it: self.data.into_iter(),
        }
    }
}

impl<T> IntoIterator for &BinaryHeap<T> {
    type Item = &T;
    type IntoIter = Iter<T>;
    fn into_iter(self) -> Iter<T> {
        self.iter()
    }
}

impl<T: Clone> Clone for BinaryHeap<T> {
    fn clone(&self) -> BinaryHeap<T> {
        BinaryHeap {
            data: self.data.clone(),
        }
    }
}

impl<T: Ord> Default for BinaryHeap<T> {
    fn default() -> BinaryHeap<T> {
        BinaryHeap::new()
    }
}

impl<T: Debug> Debug for BinaryHeap<T> {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        let mut l = f.debug_list();
        for x in self.data.iter() {
            l.entry(x);
        }
        l.finish()
    }
}
