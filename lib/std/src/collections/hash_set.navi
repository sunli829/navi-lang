//! A hash set (a HashMap with unit values).

use crate::hash::Hash;
use crate::fmt::{self, Debug, Formatter};
use crate::collections::hash_map::{self, HashMap};

pub struct HashSet<T> { m: HashMap<T, ()> }

impl<T: Hash + Eq> HashSet<T> {
    pub fn new() -> HashSet<T> { HashSet { m: HashMap::new() } }
    pub fn with_capacity(capacity: usize) -> HashSet<T> { HashSet { m: HashMap::with_capacity(capacity) } }
    pub fn len(&self) -> usize { self.m.len() }
    pub fn is_empty(&self) -> bool { self.m.is_empty() }
    pub fn clear(&mut self) { self.m.clear(); }
    /// Adds a value; returns whether it was not present.
    pub fn insert(&mut self, v: T) -> bool { self.m.insert(v, ()).is_none() }
    pub fn contains(&self, v: &T) -> bool { self.m.contains_key(v) }
    pub fn remove(&mut self, v: &T) -> bool { self.m.remove(v).is_some() }
    pub fn get(&self, v: &T) -> Option<&T> { match self.m.get_key_value(v) { Some((k, _)) => Some(k), None => None } }
    pub fn iter(&self) -> Iter<T> { Iter { keys: self.m.keys() } }
}

pub struct Iter<T> { keys: hash_map::Keys<T, ()> }
impl<T> Iterator for Iter<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> { self.keys.next() }
}

impl<T: Hash + Eq + Clone> Clone for HashSet<T> {
    fn clone(&self) -> HashSet<T> { HashSet { m: self.m.clone() } }
}

impl<T: Hash + Eq> Default for HashSet<T> {
    fn default() -> HashSet<T> { HashSet::new() }
}

impl<T: Hash + Eq + Debug> Debug for HashSet<T> {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        let mut s = f.debug_set();
        for v in self.iter() { s.entry(v); }
        s.finish()
    }
}

impl<T: Hash + Eq> PartialEq for HashSet<T> {
    fn eq(&self, other: &HashSet<T>) -> bool {
        if self.len() != other.len() { return false; }
        for v in self.iter() { if !other.contains(v) { return false; } }
        true
    }
}

impl<T: Hash + Eq> FromIterator<T> for HashSet<T> {
    fn from_iter<I: IntoIterator<Item = T>>(iter: I) -> HashSet<T> {
        let mut s = HashSet::new();
        for v in iter { s.insert(v); }
        s
    }
}

impl<T: Hash + Eq> Extend<T> for HashSet<T> {
    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {
        for v in iter { self.insert(v); }
    }
}
