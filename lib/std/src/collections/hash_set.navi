//! A hash set implemented as a [`HashMap`] whose values are `()`.
//!
//! See [`HashSet`] for the set itself and [`Iter`] for its iterator.
//!
//! # Examples
//!
//! Removing duplicates from a list while keeping its order:
//!
//! ```
//! use std::collections::HashSet;
//!
//! let words = Vec::from(["to", "be", "or", "not", "to", "be"]);
//! let mut seen: HashSet<&str> = HashSet::new();
//! let mut unique: Vec<&str> = Vec::new();
//! for w in words.iter() {
//!     if seen.insert(*w) {
//!         unique.push(*w);
//!     }
//! }
//! assert_eq(unique, Vec::from(["to", "be", "or", "not"]));
//! ```

use crate::{
    collections::hash_map::{self, HashMap},
    fmt::{self, Debug, Formatter},
    hash::Hash,
};

/// A hash set implemented as a [`HashMap`] where the value is `()`.
///
/// As with the [`HashMap`] type, a `HashSet` requires that the elements
/// implement the [`Eq`] and [`Hash`](crate::hash::Hash) traits, and that
/// `a == b` implies that the two elements hash equally.
///
/// What [`HashMap`] says about navi applies here too: elements are hashed with
/// FxHash (fast, not HashDoS resistant); the iteration order is unspecified
/// but deterministic (the same insertions and removals give the same order on
/// every run); and a `HashSet` is a shared handle, so assigning or passing a
/// set shares it, and [`clone`](Clone::clone) makes an independent copy.
///
/// # Examples
///
/// ```
/// use std::collections::HashSet;
///
/// let mut books: HashSet<&str> = HashSet::new();
///
/// // Add some books.
/// books.insert("A Dance With Dragons");
/// books.insert("To Kill a Mockingbird");
/// books.insert("The Odyssey");
/// books.insert("The Great Gatsby");
///
/// // Check for a specific one.
/// assert(!books.contains(&"The Winds of Winter"));
///
/// // Remove a book.
/// books.remove(&"The Odyssey");
/// assert_eq(books.len(), 3);
///
/// // Iterate over everything.
/// for book in books.iter() {
///     println(`${book}`);
/// }
/// ```
///
/// A set can be built from an iterator; duplicates are kept once:
///
/// ```
/// use std::collections::HashSet;
///
/// let viking_names: HashSet<&str> = ["Einar", "Olaf", "Harald", "Olaf"].into_iter().collect();
/// assert_eq(viking_names.len(), 3);
/// assert(viking_names.contains(&"Harald"));
/// ```
pub struct HashSet<T> {
    m: HashMap<T, ()>,
}

impl<T> HashSet<T>
where
    T: Hash + Eq,
{
    /// Creates an empty `HashSet`.
    ///
    /// The hash set is initially created with a capacity of 0, so it will not
    /// allocate until it is first inserted into.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashSet;
    ///
    /// let set: HashSet<i32> = HashSet::new();
    /// assert(set.is_empty());
    /// ```
    pub fn new() -> HashSet<T> {
        HashSet { m: HashMap::new() }
    }

    /// Creates an empty `HashSet` with room for at least `capacity` elements.
    ///
    /// The hash set will be able to hold at least `capacity` elements without
    /// reallocating. If `capacity` is 0, the hash set will not allocate.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashSet;
    ///
    /// let mut set: HashSet<i32> = HashSet::with_capacity(10);
    /// set.insert(1);
    /// assert_eq(set.len(), 1);
    /// ```
    pub fn with_capacity(capacity: usize) -> HashSet<T> {
        HashSet {
            m: HashMap::with_capacity(capacity),
        }
    }

    /// Returns the number of elements in the set.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashSet;
    ///
    /// let mut v = HashSet::new();
    /// assert_eq(v.len(), 0);
    /// v.insert(1);
    /// assert_eq(v.len(), 1);
    /// ```
    pub fn len(&self) -> usize {
        self.m.len()
    }

    /// Returns `true` if the set contains no elements.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashSet;
    ///
    /// let mut v = HashSet::new();
    /// assert(v.is_empty());
    /// v.insert(1);
    /// assert(!v.is_empty());
    /// ```
    pub fn is_empty(&self) -> bool {
        self.m.is_empty()
    }

    /// Clears the set, removing all values.
    ///
    /// Every copy of the set sees it empty, since they share it.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashSet;
    ///
    /// let mut v = HashSet::new();
    /// v.insert(1);
    /// v.clear();
    /// assert(v.is_empty());
    /// ```
    pub fn clear(&mut self) {
        self.m.clear();
    }

    /// Adds a value to the set.
    ///
    /// Returns whether the value was newly inserted. That is:
    ///
    /// - If the set did not previously contain this value, `true` is returned.
    /// - If the set already contained this value, `false` is returned, and the
    ///   set is not modified: the original value is kept.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashSet;
    ///
    /// let mut set = HashSet::new();
    ///
    /// assert_eq(set.insert(2), true);
    /// assert_eq(set.insert(2), false);
    /// assert_eq(set.len(), 1);
    /// ```
    pub fn insert(&mut self, v: T) -> bool {
        self.m.insert(v, ()).is_none()
    }

    /// Returns `true` if the set contains a value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashSet;
    ///
    /// let set: HashSet<i32> = [1, 2, 3].into_iter().collect();
    /// assert_eq(set.contains(&1), true);
    /// assert_eq(set.contains(&4), false);
    /// ```
    pub fn contains(&self, v: &T) -> bool {
        self.m.contains_key(v)
    }

    /// Removes a value from the set. Returns whether the value was present in
    /// the set.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashSet;
    ///
    /// let mut set = HashSet::new();
    ///
    /// set.insert(2);
    /// assert_eq(set.remove(&2), true);
    /// assert_eq(set.remove(&2), false);
    /// ```
    pub fn remove(&mut self, v: &T) -> bool {
        self.m.remove(v).is_some()
    }

    /// Returns a reference to the value in the set, if any, that is equal to
    /// the given value.
    ///
    /// The value returned is the one stored in the set, which may differ from
    /// the one given if the type's `==` is not identity.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashSet;
    ///
    /// let set: HashSet<i32> = [1, 2, 3].into_iter().collect();
    /// assert_eq(set.get(&2), Some(&2));
    /// assert_eq(set.get(&4), None);
    /// ```
    pub fn get(&self, v: &T) -> Option<&T> {
        match self.m.get_key_value(v) {
            Some((k, _)) => Some(k),
            None => None,
        }
    }

    /// An iterator visiting all elements in arbitrary order. The iterator
    /// element type is `&T`.
    ///
    /// The order is unspecified, but deterministic: the same insertions and
    /// removals give the same order on every run.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashSet;
    ///
    /// let mut set = HashSet::new();
    /// set.insert("a");
    /// set.insert("b");
    ///
    /// let mut items: Vec<&str> = set.iter().copied().collect();
    /// items.sort();
    /// assert_eq(items, Vec::from(["a", "b"]));
    /// ```
    pub fn iter(&self) -> Iter<T> {
        Iter {
            keys: self.m.keys(),
        }
    }
    /// Visits the values representing the difference, i.e., the values that are
    /// in `self` but not in `other`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashSet;
    ///
    /// let a = HashSet::from([1, 2, 3]);
    /// let b = HashSet::from([4, 2, 3, 4]);
    ///
    /// let diff: HashSet<&i32> = a.difference(&b).collect();
    /// assert_eq(diff, [&1].into_iter().collect());
    /// ```
    pub fn difference(&self, other: &HashSet<T>) -> Difference<T> {
        let mut v = crate::vec::Vec::new();
        for x in self.iter() {
            if !other.contains(x) {
                v.push(x);
            }
        }
        Difference { it: v.into_iter() }
    }

    /// Visits the values representing the symmetric difference, i.e., the
    /// values that are in `self` or in `other` but not in both.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashSet;
    ///
    /// let a = HashSet::from([1, 2, 3]);
    /// let b = HashSet::from([4, 2, 3, 4]);
    ///
    /// let diff: HashSet<&i32> = a.symmetric_difference(&b).collect();
    /// assert_eq(diff, [&1, &4].into_iter().collect());
    /// ```
    pub fn symmetric_difference(&self, other: &HashSet<T>) -> SymmetricDifference<T> {
        let mut v = crate::vec::Vec::new();
        for x in self.iter() {
            if !other.contains(x) {
                v.push(x);
            }
        }
        for x in other.iter() {
            if !self.contains(x) {
                v.push(x);
            }
        }
        SymmetricDifference { it: v.into_iter() }
    }

    /// Visits the values representing the intersection, i.e., the values that
    /// are both in `self` and `other`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashSet;
    ///
    /// let a = HashSet::from([1, 2, 3]);
    /// let b = HashSet::from([4, 2, 3, 4]);
    ///
    /// let inter: HashSet<&i32> = a.intersection(&b).collect();
    /// assert_eq(inter, [&2, &3].into_iter().collect());
    /// ```
    pub fn intersection(&self, other: &HashSet<T>) -> Intersection<T> {
        let mut v = crate::vec::Vec::new();
        for x in self.iter() {
            if other.contains(x) {
                v.push(x);
            }
        }
        Intersection { it: v.into_iter() }
    }

    /// Visits the values representing the union, i.e., all the values in `self`
    /// or `other`, without duplicates.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashSet;
    ///
    /// let a = HashSet::from([1, 2, 3]);
    /// let b = HashSet::from([4, 2, 3, 4]);
    ///
    /// let union: HashSet<&i32> = a.union(&b).collect();
    /// assert_eq(union, [&1, &2, &3, &4].into_iter().collect());
    /// ```
    // (r#: the bootstrap compiler still reserves the word.)
    pub fn r#union(&self, other: &HashSet<T>) -> Union<T> {
        let mut v = crate::vec::Vec::new();
        for x in self.iter() {
            v.push(x);
        }
        for x in other.iter() {
            if !self.contains(x) {
                v.push(x);
            }
        }
        Union { it: v.into_iter() }
    }

    /// Returns `true` if `self` has no elements in common with `other`. This is
    /// equivalent to checking for an empty intersection.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashSet;
    ///
    /// let a = HashSet::from([1, 2, 3]);
    /// let mut b = HashSet::new();
    ///
    /// assert(a.is_disjoint(&b));
    /// b.insert(4);
    /// assert(a.is_disjoint(&b));
    /// b.insert(1);
    /// assert(!a.is_disjoint(&b));
    /// ```
    pub fn is_disjoint(&self, other: &HashSet<T>) -> bool {
        for x in self.iter() {
            if other.contains(x) {
                return false;
            }
        }
        true
    }

    /// Returns `true` if the set is a subset of another, i.e., `other`
    /// contains at least all the values in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashSet;
    ///
    /// let sup = HashSet::from([1, 2, 3]);
    /// let mut set = HashSet::new();
    ///
    /// assert(set.is_subset(&sup));
    /// set.insert(2);
    /// assert(set.is_subset(&sup));
    /// set.insert(4);
    /// assert(!set.is_subset(&sup));
    /// ```
    pub fn is_subset(&self, other: &HashSet<T>) -> bool {
        if self.len() > other.len() {
            return false;
        }
        for x in self.iter() {
            if !other.contains(x) {
                return false;
            }
        }
        true
    }

    /// Returns `true` if the set is a superset of another, i.e., `self`
    /// contains at least all the values in `other`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashSet;
    ///
    /// let sub = HashSet::from([1, 2]);
    /// let mut set = HashSet::new();
    ///
    /// assert(!set.is_superset(&sub));
    /// set.insert(0);
    /// set.insert(1);
    /// assert(!set.is_superset(&sub));
    /// set.insert(2);
    /// assert(set.is_superset(&sub));
    /// ```
    pub fn is_superset(&self, other: &HashSet<T>) -> bool {
        other.is_subset(self)
    }
}

/// An iterator over the items of a `HashSet`, in arbitrary order.
///
/// This struct is created by [`HashSet::iter`]. Its items are `&T`.
///
/// # Examples
///
/// ```
/// use std::collections::HashSet;
///
/// let a: HashSet<i32> = [1].into_iter().collect();
/// let mut iter = a.iter();
/// assert_eq(iter.next(), Some(&1));
/// assert_eq(iter.next(), None);
/// ```
pub struct Iter<T> {
    keys: hash_map::Keys<T, ()>,
}

impl<T> Iterator for Iter<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        self.keys.next()
    }
}

impl<T> Clone for HashSet<T>
where
    T: Hash + Eq + Clone,
{
    /// Returns an independent copy of the set, cloning every element.
    fn clone(&self) -> HashSet<T> {
        HashSet { m: self.m.clone() }
    }
}

impl<T> Default for HashSet<T>
where
    T: Hash + Eq,
{
    fn default() -> HashSet<T> {
        HashSet::new()
    }
}

impl<T> Debug for HashSet<T>
where
    T: Hash + Eq + Debug,
{
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        let mut s = f.debug_set();
        for v in self.iter() {
            s.entry(v);
        }
        s.finish()
    }
}

impl<T> PartialEq for HashSet<T>
where
    T: Hash + Eq,
{
    /// Two sets are equal if they have the same elements (whatever their
    /// iteration orders).
    fn eq(&self, other: &HashSet<T>) -> bool {
        if self.len() != other.len() {
            return false;
        }
        for v in self.iter() {
            if !other.contains(v) {
                return false;
            }
        }
        true
    }
}

impl<T> FromIterator<T> for HashSet<T>
where
    T: Hash + Eq,
{
    fn from_iter<I: IntoIterator<Item = T>>(iter: I) -> HashSet<T> {
        let mut s = HashSet::new();
        for v in iter {
            s.insert(v);
        }
        s
    }
}

impl<T> Extend<T> for HashSet<T>
where
    T: Hash + Eq,
{
    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {
        for v in iter {
            self.insert(v);
        }
    }
}

/// An iterator over the elements in the difference of `HashSet`s.
///
/// This struct is created by [`HashSet::difference`]. Its items are `&T`
/// (collected when it is made, where Rust's is lazy).
pub struct Difference<T> {
    it: crate::vec::IntoIter<&T>,
}

impl<T> Iterator for Difference<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        self.it.next()
    }
}

/// An iterator over the elements in the symmetric difference of `HashSet`s.
///
/// This struct is created by [`HashSet::symmetric_difference`]. Its items are
/// `&T` (collected when it is made, where Rust's is lazy).
pub struct SymmetricDifference<T> {
    it: crate::vec::IntoIter<&T>,
}

impl<T> Iterator for SymmetricDifference<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        self.it.next()
    }
}

/// An iterator over the elements in the intersection of `HashSet`s.
///
/// This struct is created by [`HashSet::intersection`]. Its items are `&T`
/// (collected when it is made, where Rust's is lazy).
pub struct Intersection<T> {
    it: crate::vec::IntoIter<&T>,
}

impl<T> Iterator for Intersection<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        self.it.next()
    }
}

/// An iterator over the elements in the union of `HashSet`s.
///
/// This struct is created by [`HashSet::union`]. Its items are `&T`
/// (collected when it is made, where Rust's is lazy).
pub struct Union<T> {
    it: crate::vec::IntoIter<&T>,
}

impl<T> Iterator for Union<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        self.it.next()
    }
}

impl<T, const N: usize> From<[T; N]> for HashSet<T>
where
    T: Hash + Eq,
{
    /// Converts a `[T; N]` into a `HashSet<T>`.
    ///
    /// If the array contains any equal values, all but one will be dropped.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashSet;
    ///
    /// let set1 = HashSet::from([1, 2, 3, 4]);
    /// let set2: HashSet<i32> = [1, 2, 3, 4].into();
    /// assert_eq(set1, set2);
    /// ```
    fn from(a: [T; N]) -> HashSet<T> {
        let mut s = HashSet::with_capacity(N);
        for x in a.iter() {
            s.insert(*x);
        }
        s
    }
}

impl<T> IntoIterator for HashSet<T> {
    type Item = T;
    type IntoIter = IntoIter<T>;
    /// Creates a consuming iterator, that is, one that moves each value out of
    /// the set in arbitrary order (a snapshot: the set, shared by its copies,
    /// is left as it is).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::HashSet;
    ///
    /// let set = HashSet::from(["a", "b"]);
    /// let mut v: Vec<&str> = set.into_iter().collect();
    /// v.sort();
    /// assert_eq(v, ["a", "b"]);
    /// ```
    fn into_iter(self) -> IntoIter<T> {
        IntoIter {
            it: self.m.into_iter(),
        }
    }
}

impl<T> IntoIterator for &HashSet<T> {
    type Item = &T;
    type IntoIter = Iter<T>;
    fn into_iter(self) -> Iter<T> {
        Iter {
            keys: self.m.keys_unbounded(),
        }
    }
}

/// An owning iterator over the items of a `HashSet`.
///
/// This struct is created by the [`into_iter`](IntoIterator::into_iter)
/// method on [`HashSet`].
///
/// # Examples
///
/// ```
/// use std::collections::HashSet;
///
/// let set = HashSet::from([7]);
/// let mut iter = set.into_iter();
/// assert_eq(iter.next(), Some(7));
/// assert_eq(iter.next(), None);
/// ```
pub struct IntoIter<T> {
    it: hash_map::IntoIter<T, ()>,
}

impl<T> Iterator for IntoIter<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        match self.it.next() {
            Some((k, _)) => Some(k),
            None => None,
        }
    }
}
