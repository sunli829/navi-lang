//! An ordered map based on a B-Tree.
//!
//! See [`BTreeMap`] for details. Like [`Vec`], a `BTreeMap` is a shared handle:
//! copies of it share the same tree, and [`clone`](BTreeMap::clone) makes an
//! independent copy.

use crate::cmp::Ordering;
use crate::fmt::{self, Debug, Formatter};
use crate::ops::{Bound, Index, RangeBounds};

// Minimum degree: a node other than the root holds B - 1 to 2B - 1
// entries; an internal node has one more child than entries.
const B: usize = 6;
const CAP: usize = 11;
const MIN: usize = 5;

struct Node<K, V> {
    len: usize,
    keys: [K; CAP],
    vals: [V; CAP],
    // CAP + 1 children; null in a leaf.
    edges: *mut &mut Node<K, V>,
}

fn new_leaf<K, V>() -> &mut Node<K, V> {
    // Zeroed: len 0, no edges (the arrays' slots past len are unused).
    unsafe { &mut *crate::rt::alloc_array::<Node<K, V>>(1) }
}

// An internal node: a node and its children in one object (the node's
// edges point at the children here).
struct Internal<K, V> {
    node: Node<K, V>,
    edges: [&mut Node<K, V>; CAP + 1],
}

fn new_internal<K, V>() -> &mut Node<K, V> {
    let x = unsafe { &mut *crate::rt::alloc_array::<Internal<K, V>>(1) };
    x.node.edges = &mut x.edges[0] as *mut &mut Node<K, V>;
    &mut x.node
}

fn same<K, V>(a: &Node<K, V>, b: &Node<K, V>) -> bool {
    (a as *const Node<K, V>) == (b as *const Node<K, V>)
}

impl<K, V> Node<K, V> {
    fn is_leaf(&self) -> bool {
        self.edges.is_null()
    }
    fn edge(&self, i: usize) -> &mut Node<K, V> {
        unsafe { self.edges.add(i).read() }
    }
    fn set_edge(&mut self, i: usize, e: &mut Node<K, V>) {
        unsafe {
            self.edges.add(i).write(e);
        }
    }

    // Inserts an entry at i (the node is not full).
    fn insert_kv(&mut self, i: usize, k: K, v: V) {
        let mut j = self.len;
        while j > i {
            self.keys[j] = self.keys[j - 1];
            self.vals[j] = self.vals[j - 1];
            j -= 1;
        }
        self.keys[i] = k;
        self.vals[i] = v;
        self.len += 1;
    }

    // Inserts a child at i, after insert_kv made room for it.
    fn insert_edge(&mut self, i: usize, e: &mut Node<K, V>) {
        let mut j = self.len;
        while j > i {
            self.set_edge(j, self.edge(j - 1));
            j -= 1;
        }
        self.set_edge(i, e);
    }

    fn remove_kv(&mut self, i: usize) -> (K, V) {
        let k = self.keys[i];
        let v = self.vals[i];
        let mut j = i;
        while j + 1 < self.len {
            self.keys[j] = self.keys[j + 1];
            self.vals[j] = self.vals[j + 1];
            j += 1;
        }
        self.len -= 1;
        (k, v)
    }

    // Removes the child at i, after remove_kv.
    fn remove_edge(&mut self, i: usize) {
        let mut j = i;
        while j <= self.len {
            self.set_edge(j, self.edge(j + 1));
            j += 1;
        }
    }
}

// The index of k in n, or of the child to look in.
fn search<K: Ord, V>(n: &Node<K, V>, k: &K) -> (usize, bool) {
    let mut i = 0;
    while i < n.len {
        match k.cmp(&n.keys[i]) {
            Ordering::Greater => {
                i += 1;
            }
            Ordering::Equal => return (i, true),
            Ordering::Less => return (i, false),
        }
    }
    (i, false)
}

// Splits the full child i of p, moving its middle entry up into p.
fn split_child<K, V>(p: &mut Node<K, V>, i: usize) {
    let y = p.edge(i);
    let z: &mut Node<K, V> = if y.is_leaf() {
        new_leaf()
    } else {
        new_internal()
    };
    let mut j = 0;
    while j < MIN {
        z.keys[j] = y.keys[B + j];
        z.vals[j] = y.vals[B + j];
        j += 1;
    }
    if !y.is_leaf() {
        let mut j = 0;
        while j <= MIN {
            z.set_edge(j, y.edge(B + j));
            j += 1;
        }
    }
    z.len = MIN;
    y.len = MIN;
    p.insert_kv(i, y.keys[MIN], y.vals[MIN]);
    p.insert_edge(i + 1, z);
}

// Merges child i + 1 of p and the entry between them into child i.
fn merge<K, V>(p: &mut Node<K, V>, i: usize) {
    let y = p.edge(i);
    let z = p.edge(i + 1);
    let (k, v) = p.remove_kv(i);
    p.remove_edge(i + 1);
    let base = y.len;
    y.keys[base] = k;
    y.vals[base] = v;
    let mut j = 0;
    while j < z.len {
        y.keys[base + 1 + j] = z.keys[j];
        y.vals[base + 1 + j] = z.vals[j];
        j += 1;
    }
    if !y.is_leaf() {
        let mut j = 0;
        while j <= z.len {
            y.set_edge(base + 1 + j, z.edge(j));
            j += 1;
        }
    }
    y.len = base + 1 + z.len;
}

// Makes child i of p hold more than MIN entries (borrowing from a sibling
// or merging with one) before a removal descends into it. Returns the
// index of the child that now covers the keys child i covered.
fn fill_child<K, V>(p: &mut Node<K, V>, i: usize) -> usize {
    let c = p.edge(i);
    if c.len > MIN {
        return i;
    }
    if i > 0 && p.edge(i - 1).len > MIN {
        // Rotate right through p.
        let l = p.edge(i - 1);
        c.insert_kv(0, p.keys[i - 1], p.vals[i - 1]);
        if !c.is_leaf() {
            c.insert_edge(0, l.edge(l.len));
        }
        p.keys[i - 1] = l.keys[l.len - 1];
        p.vals[i - 1] = l.vals[l.len - 1];
        l.len -= 1;
        return i;
    }
    if i < p.len && p.edge(i + 1).len > MIN {
        // Rotate left through p.
        let r = p.edge(i + 1);
        c.keys[c.len] = p.keys[i];
        c.vals[c.len] = p.vals[i];
        c.len += 1;
        if !c.is_leaf() {
            c.set_edge(c.len, r.edge(0));
        }
        p.keys[i] = r.keys[0];
        p.vals[i] = r.vals[0];
        r.remove_kv(0);
        if !r.is_leaf() {
            r.remove_edge(0);
        }
        return i;
    }
    if i < p.len {
        merge(p, i);
        i
    } else {
        merge(p, i - 1);
        i - 1
    }
}

// What a removal looks for.
const BY_KEY: u8 = 0;
const FIRST: u8 = 1;
const LAST: u8 = 2;

// Removes the entry from the subtree at n (which holds more than MIN
// entries, or is the root), top-down: each child is filled before the
// removal descends into it.
fn remove_from<K: Ord, V>(n: &mut Node<K, V>, key: Option<&K>, what: u8) -> Option<(K, V)> {
    let mut n = n;
    loop {
        let (i, found) = if what == FIRST {
            (0, n.is_leaf())
        } else if what == LAST {
            if n.is_leaf() {
                (n.len - 1, true)
            } else {
                (n.len, false)
            }
        } else {
            search(n, key.unwrap())
        };
        if found {
            if n.is_leaf() {
                return Some(n.remove_kv(i));
            }
            // An internal entry: replace it with its predecessor or
            // successor, or merge its two children and go on in them.
            if n.edge(i).len > MIN {
                let (k, v) = remove_from(n.edge(i), None, LAST).unwrap();
                let old = (n.keys[i], n.vals[i]);
                n.keys[i] = k;
                n.vals[i] = v;
                return Some(old);
            }
            if n.edge(i + 1).len > MIN {
                let (k, v) = remove_from(n.edge(i + 1), None, FIRST).unwrap();
                let old = (n.keys[i], n.vals[i]);
                n.keys[i] = k;
                n.vals[i] = v;
                return Some(old);
            }
            merge(n, i);
            n = n.edge(i);
        } else {
            if n.is_leaf() {
                return None;
            }
            let j = fill_child(n, i);
            n = n.edge(j);
        }
    }
}

fn clone_node<K: Clone, V: Clone>(n: &Node<K, V>) -> &mut Node<K, V> {
    let c: &mut Node<K, V> = if n.is_leaf() {
        new_leaf()
    } else {
        new_internal()
    };
    let mut i = 0;
    while i < n.len {
        c.keys[i] = n.keys[i].clone();
        c.vals[i] = n.vals[i].clone();
        i += 1;
    }
    if !n.is_leaf() {
        let mut i = 0;
        while i <= n.len {
            c.set_edge(i, clone_node(n.edge(i)));
            i += 1;
        }
    }
    c.len = n.len;
    c
}

/// An ordered map based on a [B-Tree].
///
/// The entries are kept sorted by key (with [`Ord`]), so iteration,
/// [`BTreeMap::first_key_value`], [`BTreeMap::last_key_value`] and
/// [`BTreeMap::range`] give them in ascending key order. Each node of the tree
/// holds up to 11 entries in arrays, which makes the map use memory well and
/// search it with few cache misses; lookups, insertions and removals take
/// `O(log n)` time.
///
/// It is a logic error for a key to be modified in such a way that its ordering
/// relative to any other key changes while it is in the map. The behavior
/// resulting from such a logic error is not specified, but it is not undefined
/// behavior.
///
/// Where navi differs from Rust (see spec/std-diff.md):
///
/// - A `BTreeMap` is a shared handle, like [`Vec`]: assigning it or passing it
///   by value copies the handle, and all the copies see the same entries. Use
///   [`clone`](BTreeMap::clone) for an independent copy. Consuming methods such
///   as [`into_iter`](BTreeMap::into_iter) and
///   [`into_keys`](BTreeMap::into_keys) do not empty the map.
/// - There is no `Borrow`: the lookup methods take `&K` (a `BTreeMap<String,
///   V>` is looked up with a `&String`, not a `&str`), and
///   [`range`](BTreeMap::range) takes bounds of `K`.
/// - Closures passed to methods such as [`retain`](BTreeMap::retain) are `fn`
///   types.
///
/// [B-Tree]: https://en.wikipedia.org/wiki/B-tree
///
/// # Examples
///
/// ```
/// use std::collections::BTreeMap;
///
/// // type inference lets us omit an explicit type signature (which
/// // would be `BTreeMap<&str, &str>` in this example).
/// let mut movie_reviews = BTreeMap::new();
///
/// // review some movies.
/// movie_reviews.insert("Office Space", "Deals with real issues in the workplace.");
/// movie_reviews.insert("Pulp Fiction", "Masterpiece.");
/// movie_reviews.insert("The Godfather", "Very enjoyable.");
/// movie_reviews.insert("The Blues Brothers", "Eye lyked it a lot.");
///
/// // check for a specific one.
/// if !movie_reviews.contains_key(&"Les Misérables") {
///     println(`We've got ${movie_reviews.len()} reviews, but Les Misérables ain't one.`);
/// }
///
/// // oops, this review has a lot of spelling mistakes, let's delete it.
/// movie_reviews.remove(&"The Blues Brothers");
///
/// // look up the values associated with some keys.
/// let to_find = ["Up!", "Office Space"];
/// for movie in to_find.iter() {
///     match movie_reviews.get(movie) {
///         Some(review) => println(`${movie}: ${review}`),
///         None => println(`${movie} is unreviewed.`),
///     }
/// }
///
/// // Look up the value for a key (will panic if the key is not found).
/// println(`Movie review: ${movie_reviews[&"Office Space"]}`);
///
/// // iterate over everything, in key order.
/// for (movie, review) in &movie_reviews {
///     println(`${movie}: "${review}"`);
/// }
/// assert_eq(movie_reviews.keys().next(), Some(&"Office Space"));
/// ```
///
/// A `BTreeMap` with a known list of items can be initialized from an array:
///
/// ```
/// use std::collections::BTreeMap;
///
/// let solar_distance = BTreeMap::from([
///     ("Mercury", 0.4),
///     ("Venus", 0.7),
///     ("Earth", 1.0),
///     ("Mars", 1.5),
/// ]);
/// assert_eq(solar_distance.len(), 4);
/// assert_eq(solar_distance.first_key_value(), Some((&"Earth", &1.0)));
/// ```
///
/// Copies of a `BTreeMap` share its entries; [`clone`](BTreeMap::clone) does
/// not:
///
/// ```
/// use std::collections::BTreeMap;
///
/// let a = BTreeMap::from([(1, "a")]);
/// let mut b = a;
/// b.insert(2, "b");
/// assert_eq(a.len(), 2);
///
/// let mut c = a.clone();
/// c.insert(3, "c");
/// assert_eq(a.len(), 2);
/// assert_eq(c.len(), 3);
/// ```
///
/// `BTreeMap` implements an [`Entry API`](BTreeMap::entry), which allows for
/// complex methods of getting, setting, updating and removing keys and their
/// values:
///
/// ```
/// use std::collections::BTreeMap;
///
/// // type inference lets us omit an explicit type signature (which
/// // would be `BTreeMap<&str, u8>` in this example).
/// let mut player_stats = BTreeMap::new();
///
/// fn random_stat_buff() -> u8 {
///     // could actually return some random value here - let's just return
///     // some fixed value for now
///     42
/// }
///
/// // insert a key only if it doesn't already exist
/// player_stats.entry("health").or_insert(100);
///
/// // insert a key using a function that provides a new value only if it
/// // doesn't already exist
/// player_stats.entry("defence").or_insert_with(random_stat_buff);
///
/// // update a key, guarding against the key possibly not being set
/// let stat = player_stats.entry("attack").or_insert(100);
/// *stat += random_stat_buff();
///
/// // modify an entry before an insert with in-place mutation
/// player_stats.entry("mana").and_modify(|mana| *mana += 200).or_insert(100);
///
/// assert_eq(player_stats[&"attack"], 142);
/// assert_eq(player_stats[&"mana"], 100);
/// ```
pub struct BTreeMap<K, V> {
    t: &mut Tree<K, V>,
}

struct Tree<K, V> {
    root: Option<&mut Node<K, V>>,
    len: usize,
}

impl<K, V> BTreeMap<K, V> {
    /// Makes a new, empty `BTreeMap`.
    ///
    /// Does not allocate anything on its own.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map = BTreeMap::new();
    ///
    /// // entries can now be inserted into the empty map
    /// map.insert(1, "a");
    /// assert_eq(map.len(), 1);
    /// ```
    pub fn new() -> BTreeMap<K, V> {
        BTreeMap {
            t: &mut Tree { root: None, len: 0 },
        }
    }
    /// Returns the number of elements in the map.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut a = BTreeMap::new();
    /// assert_eq(a.len(), 0);
    /// a.insert(1, "a");
    /// assert_eq(a.len(), 1);
    /// ```
    pub fn len(&self) -> usize {
        self.t.len
    }
    /// Returns `true` if the map contains no elements.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut a = BTreeMap::new();
    /// assert(a.is_empty());
    /// a.insert(1, "a");
    /// assert(!a.is_empty());
    /// ```
    pub fn is_empty(&self) -> bool {
        self.t.len == 0
    }

    /// Clears the map, removing all elements.
    ///
    /// Every copy of the map's handle sees it empty.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut a = BTreeMap::new();
    /// a.insert(1, "a");
    /// a.clear();
    /// assert(a.is_empty());
    /// ```
    pub fn clear(&mut self) {
        self.t.root = None;
        self.t.len = 0;
    }

    /// Gets an iterator over the entries of the map, sorted by key.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map = BTreeMap::new();
    /// map.insert(3, "c");
    /// map.insert(2, "b");
    /// map.insert(1, "a");
    ///
    /// for (key, value) in map.iter() {
    ///     println(`${key}: ${value}`);
    /// }
    ///
    /// let (first_key, first_value) = map.iter().next().unwrap();
    /// assert_eq((*first_key, *first_value), (1, "a"));
    /// ```
    pub fn iter(&self) -> Iter<K, V> {
        Iter {
            w: Walk::all(self.t),
            left: self.t.len,
        }
    }
    /// Gets a mutable iterator over the entries of the map, sorted by key.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map = BTreeMap::from([("a", 1), ("b", 2), ("c", 3)]);
    ///
    /// // add 10 to the value if the key isn't "a"
    /// for (key, value) in map.iter_mut() {
    ///     if *key != "a" {
    ///         *value += 10;
    ///     }
    /// }
    /// assert_eq(map[&"a"], 1);
    /// assert_eq(map[&"c"], 13);
    /// ```
    pub fn iter_mut(&mut self) -> IterMut<K, V> {
        IterMut {
            w: Walk::all(self.t),
            left: self.t.len,
        }
    }
    /// Gets an iterator over the keys of the map, in sorted order.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut a = BTreeMap::new();
    /// a.insert(2, "b");
    /// a.insert(1, "a");
    ///
    /// let keys: Vec<i32> = a.keys().cloned().collect();
    /// assert_eq(keys, Vec::from([1, 2]));
    /// ```
    pub fn keys(&self) -> Keys<K, V> {
        Keys { it: self.iter() }
    }
    /// Gets an iterator over the values of the map, in order by key.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut a = BTreeMap::new();
    /// a.insert(1, "hello");
    /// a.insert(2, "goodbye");
    ///
    /// let values: Vec<&str> = a.values().cloned().collect();
    /// assert_eq(values, Vec::from(["hello", "goodbye"]));
    /// ```
    pub fn values(&self) -> Values<K, V> {
        Values { it: self.iter() }
    }
    /// Gets a mutable iterator over the values of the map, in order by key.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut a = BTreeMap::new();
    /// a.insert(1, String::from("hello"));
    /// a.insert(2, String::from("goodbye"));
    ///
    /// for value in a.values_mut() {
    ///     value.push_str("!");
    /// }
    ///
    /// let values: Vec<String> = a.values().cloned().collect();
    /// assert_eq(values, Vec::from([String::from("hello!"), String::from("goodbye!")]));
    /// ```
    pub fn values_mut(&mut self) -> ValuesMut<K, V> {
        ValuesMut {
            it: self.iter_mut(),
        }
    }
    /// Creates a consuming iterator visiting all the keys, in sorted order.
    ///
    /// The map's other handles still see its entries (navi does not move the
    /// map out). The key type is `K`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut a = BTreeMap::new();
    /// a.insert(2, "b");
    /// a.insert(1, "a");
    ///
    /// let keys: Vec<i32> = a.into_keys().collect();
    /// assert_eq(keys, Vec::from([1, 2]));
    /// ```
    pub fn into_keys(self) -> IntoKeys<K, V> {
        IntoKeys {
            it: self.into_iter(),
        }
    }
    /// Creates a consuming iterator visiting all the values, in order by key.
    ///
    /// The map's other handles still see its entries (navi does not move the
    /// map out). The value type is `V`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut a = BTreeMap::new();
    /// a.insert(1, "hello");
    /// a.insert(2, "goodbye");
    ///
    /// let values: Vec<&str> = a.into_values().collect();
    /// assert_eq(values, Vec::from(["hello", "goodbye"]));
    /// ```
    pub fn into_values(self) -> IntoValues<K, V> {
        IntoValues {
            it: self.into_iter(),
        }
    }

    /// Returns the first key-value pair in the map: the key in this pair is the
    /// minimum key in the map.
    ///
    /// Returns `None` if the map is empty.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map = BTreeMap::new();
    /// assert_eq(map.first_key_value(), None);
    /// map.insert(1, "b");
    /// map.insert(2, "a");
    /// assert_eq(map.first_key_value(), Some((&1, &"b")));
    /// ```
    pub fn first_key_value(&self) -> Option<(&K, &V)> {
        let mut n = self.t.root?;
        while !n.is_leaf() {
            n = n.edge(0);
        }
        Some((&n.keys[0], &n.vals[0]))
    }

    /// Returns the last key-value pair in the map: the key in this pair is the
    /// maximum key in the map.
    ///
    /// Returns `None` if the map is empty.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map = BTreeMap::new();
    /// map.insert(1, "b");
    /// map.insert(2, "a");
    /// assert_eq(map.last_key_value(), Some((&2, &"a")));
    /// ```
    pub fn last_key_value(&self) -> Option<(&K, &V)> {
        let mut n = self.t.root?;
        while !n.is_leaf() {
            n = n.edge(n.len);
        }
        Some((&n.keys[n.len - 1], &n.vals[n.len - 1]))
    }
}

impl<K: Ord, V> BTreeMap<K, V> {
    // The node and index of k.
    fn find(&self, k: &K) -> Option<(&mut Node<K, V>, usize)> {
        let mut n = self.t.root?;
        loop {
            let (i, found) = search(n, k);
            if found {
                return Some((n, i));
            }
            if n.is_leaf() {
                return None;
            }
            n = n.edge(i);
        }
    }

    /// Returns a reference to the value corresponding to the key.
    ///
    /// Unlike Rust's, the key is given as a `&K` (navi has no `Borrow`).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map = BTreeMap::new();
    /// map.insert(1, "a");
    /// assert_eq(map.get(&1), Some(&"a"));
    /// assert_eq(map.get(&2), None);
    /// ```
    pub fn get(&self, k: &K) -> Option<&V> {
        match self.find(k) {
            Some((n, i)) => Some(&n.vals[i]),
            None => None,
        }
    }

    /// Returns a mutable reference to the value corresponding to the key.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map = BTreeMap::new();
    /// map.insert(1, "a");
    /// if let Some(x) = map.get_mut(&1) {
    ///     *x = "b";
    /// }
    /// assert_eq(map[&1], "b");
    /// ```
    pub fn get_mut(&mut self, k: &K) -> Option<&mut V> {
        match self.find(k) {
            Some((n, i)) => Some(&mut n.vals[i]),
            None => None,
        }
    }

    /// Returns the key-value pair corresponding to the supplied key.
    ///
    /// The key in the pair is the one stored in the map, which may differ from
    /// the given one in ways [`Ord`] does not see.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map = BTreeMap::new();
    /// map.insert(1, "a");
    /// assert_eq(map.get_key_value(&1), Some((&1, &"a")));
    /// assert_eq(map.get_key_value(&2), None);
    /// ```
    pub fn get_key_value(&self, k: &K) -> Option<(&K, &V)> {
        match self.find(k) {
            Some((n, i)) => Some((&n.keys[i], &n.vals[i])),
            None => None,
        }
    }

    /// Returns `true` if the map contains a value for the specified key.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map = BTreeMap::new();
    /// map.insert(1, "a");
    /// assert(map.contains_key(&1));
    /// assert(!map.contains_key(&2));
    /// ```
    pub fn contains_key(&self, k: &K) -> bool {
        self.find(k).is_some()
    }

    /// Inserts a key-value pair into the map.
    ///
    /// If the map did not have this key present, `None` is returned.
    ///
    /// If the map did have this key present, the value is updated, and the old
    /// value is returned. The key is not updated, though; this matters for
    /// types that can be `==` without being identical.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map = BTreeMap::new();
    /// assert_eq(map.insert(37, "a"), None);
    /// assert_eq(map.is_empty(), false);
    ///
    /// map.insert(37, "b");
    /// assert_eq(map.insert(37, "c"), Some("b"));
    /// assert_eq(map[&37], "c");
    /// ```
    pub fn insert(&mut self, k: K, v: V) -> Option<V> {
        let (_, _, old) = self.insert_at(k, v);
        old
    }

    // Inserts or replaces, splitting full nodes on the way down. Returns
    // where the value is and the old value.
    fn insert_at(&mut self, k: K, v: V) -> (&mut Node<K, V>, usize, Option<V>) {
        let mut n = match self.t.root {
            Some(r) => r,
            None => {
                let r: &mut Node<K, V> = new_leaf();
                self.t.root = Some(r);
                r
            }
        };
        if n.len == CAP {
            let r: &mut Node<K, V> = new_internal();
            r.set_edge(0, n);
            split_child(r, 0);
            self.t.root = Some(r);
            n = r;
        }
        loop {
            let (i, found) = search(n, &k);
            if found {
                let old = crate::mem::replace(&mut n.vals[i], v);
                return (n, i, Some(old));
            }
            if n.is_leaf() {
                n.insert_kv(i, k, v);
                self.t.len += 1;
                return (n, i, None);
            }
            let mut i = i;
            if n.edge(i).len == CAP {
                split_child(n, i);
                match k.cmp(&n.keys[i]) {
                    Ordering::Equal => {
                        let old = crate::mem::replace(&mut n.vals[i], v);
                        return (n, i, Some(old));
                    }
                    Ordering::Greater => {
                        i += 1;
                    }
                    Ordering::Less => {}
                }
            }
            n = n.edge(i);
        }
    }

    /// Removes a key from the map, returning the value at the key if the key
    /// was previously in the map.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map = BTreeMap::new();
    /// map.insert(1, "a");
    /// assert_eq(map.remove(&1), Some("a"));
    /// assert_eq(map.remove(&1), None);
    /// ```
    pub fn remove(&mut self, k: &K) -> Option<V> {
        match self.remove_entry(k) {
            Some((_, v)) => Some(v),
            None => None,
        }
    }

    /// Removes a key from the map, returning the stored key and value if the
    /// key was previously in the map.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map = BTreeMap::new();
    /// map.insert(1, "a");
    /// assert_eq(map.remove_entry(&1), Some((1, "a")));
    /// assert_eq(map.remove_entry(&1), None);
    /// ```
    pub fn remove_entry(&mut self, k: &K) -> Option<(K, V)> {
        self.remove_what(Some(k), BY_KEY)
    }
    /// Removes and returns the first element in the map. The key of this
    /// element is the minimum key that was in the map.
    ///
    /// Returns `None` if the map is empty.
    ///
    /// # Examples
    ///
    /// Draining elements in ascending order, while keeping a usable map each
    /// iteration.
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map = BTreeMap::new();
    /// map.insert(1, "a");
    /// map.insert(2, "b");
    /// while let Some((key, _val)) = map.pop_first() {
    ///     assert(map.iter().all(|(k, _v)| *k > key));
    /// }
    /// assert(map.is_empty());
    /// ```
    pub fn pop_first(&mut self) -> Option<(K, V)> {
        self.remove_what(None, FIRST)
    }
    /// Removes and returns the last element in the map. The key of this element
    /// is the maximum key that was in the map.
    ///
    /// Returns `None` if the map is empty.
    ///
    /// # Examples
    ///
    /// Draining elements in descending order, while keeping a usable map each
    /// iteration.
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map = BTreeMap::new();
    /// map.insert(1, "a");
    /// map.insert(2, "b");
    /// while let Some((key, _val)) = map.pop_last() {
    ///     assert(map.iter().all(|(k, _v)| *k < key));
    /// }
    /// assert(map.is_empty());
    /// ```
    pub fn pop_last(&mut self) -> Option<(K, V)> {
        self.remove_what(None, LAST)
    }

    fn remove_what(&mut self, key: Option<&K>, what: u8) -> Option<(K, V)> {
        let root = self.t.root?;
        let r = remove_from(root, key, what);
        if r.is_some() {
            self.t.len -= 1;
            if root.len == 0 {
                self.t.root = if root.is_leaf() {
                    None
                } else {
                    Some(root.edge(0))
                };
            }
        }
        r
    }

    /// Gets the given key's corresponding entry in the map for in-place
    /// manipulation.
    ///
    /// The entry holds a handle to the map: change the map only through the
    /// entry until it is used.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut count: BTreeMap<&str, usize> = BTreeMap::new();
    ///
    /// // count the number of occurrences of letters in the vec
    /// for x in ["a", "b", "a", "c", "a", "b"] {
    ///     count.entry(x).and_modify(|curr| *curr += 1).or_insert(1);
    /// }
    ///
    /// assert_eq(count[&"a"], 3);
    /// assert_eq(count[&"b"], 2);
    /// assert_eq(count[&"c"], 1);
    /// ```
    pub fn entry(&mut self, key: K) -> Entry<K, V> {
        match self.find(&key) {
            Some((n, i)) => Entry::Occupied(OccupiedEntry {
                map: BTreeMap { t: self.t },
                node: n,
                idx: i,
            }),
            None => Entry::Vacant(VacantEntry {
                map: BTreeMap { t: self.t },
                key,
            }),
        }
    }

    /// Returns the first entry in the map for in-place manipulation. The key of
    /// this entry is the minimum key in the map.
    ///
    /// Returns `None` if the map is empty.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map = BTreeMap::new();
    /// map.insert(1, "a");
    /// map.insert(2, "b");
    /// if let Some(mut entry) = map.first_entry() {
    ///     if *entry.key() > 0 {
    ///         entry.insert("first");
    ///     }
    /// }
    /// assert_eq(*map.get(&1).unwrap(), "first");
    /// assert_eq(*map.get(&2).unwrap(), "b");
    /// ```
    pub fn first_entry(&mut self) -> Option<OccupiedEntry<K, V>> {
        let mut n = self.t.root?;
        while !n.is_leaf() {
            n = n.edge(0);
        }
        Some(OccupiedEntry {
            map: BTreeMap { t: self.t },
            node: n,
            idx: 0,
        })
    }

    /// Returns the last entry in the map for in-place manipulation. The key of
    /// this entry is the maximum key in the map.
    ///
    /// Returns `None` if the map is empty.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map = BTreeMap::new();
    /// map.insert(1, "a");
    /// map.insert(2, "b");
    /// if let Some(mut entry) = map.last_entry() {
    ///     if *entry.key() > 0 {
    ///         entry.insert("last");
    ///     }
    /// }
    /// assert_eq(*map.get(&1).unwrap(), "a");
    /// assert_eq(*map.get(&2).unwrap(), "last");
    /// ```
    pub fn last_entry(&mut self) -> Option<OccupiedEntry<K, V>> {
        let mut n = self.t.root?;
        while !n.is_leaf() {
            n = n.edge(n.len);
        }
        Some(OccupiedEntry {
            map: BTreeMap { t: self.t },
            node: n,
            idx: n.len - 1,
        })
    }

    /// Constructs a double-ended iterator over a sub-range of entries in the
    /// map, in key order.
    ///
    /// The simplest way is to use the range syntax `min..max`, thus
    /// `range(min..max)` will yield entries from min (inclusive) to max
    /// (exclusive). The range may also be entered as `(Bound<K>, Bound<K>)`, so
    /// for example `range((Excluded(4), Included(10)))` will yield a
    /// left-exclusive, right-inclusive range from 4 to 10. Unlike Rust's, the
    /// bounds are of the key type `K` itself (navi has no `Borrow`).
    ///
    /// # Panics
    ///
    /// Panics if range `start > end`. Panics if range `start == end` and both
    /// bounds are `Excluded`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    /// use std::ops::Bound::Included;
    ///
    /// let mut map = BTreeMap::new();
    /// map.insert(3, "a");
    /// map.insert(5, "b");
    /// map.insert(8, "c");
    /// for (key, value) in map.range((Included(4), Included(8))) {
    ///     println(`${key}: ${value}`);
    /// }
    /// assert_eq(map.range(4..).next(), Some((&5, &"b")));
    /// let keys: Vec<i32> = map.range(..8).rev().map(|(k, _)| *k).collect();
    /// assert_eq(keys, Vec::from([5, 3]));
    /// ```
    #[track_caller]
    pub fn range<R: RangeBounds<K>>(&self, range: R) -> Range<K, V> {
        Range {
            w: Walk::range(self.t, range.start_bound(), range.end_bound()),
        }
    }

    /// Constructs a mutable double-ended iterator over a sub-range of entries
    /// in the map, in key order.
    ///
    /// The range is given as for [`range`](BTreeMap::range).
    ///
    /// # Panics
    ///
    /// Panics if range `start > end`. Panics if range `start == end` and both
    /// bounds are `Excluded`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map: BTreeMap<&str, i32> =
    ///     [("Alice", 0), ("Bob", 0), ("Carol", 0), ("Cheryl", 0)].into_iter().collect();
    /// for (_, balance) in map.range_mut("B".."Cheryl") {
    ///     *balance += 100;
    /// }
    /// for (name, balance) in &map {
    ///     println(`${name} => ${balance}`);
    /// }
    /// assert_eq(map[&"Alice"], 0);
    /// assert_eq(map[&"Bob"], 100);
    /// assert_eq(map[&"Carol"], 100);
    /// assert_eq(map[&"Cheryl"], 0);
    /// ```
    #[track_caller]
    pub fn range_mut<R: RangeBounds<K>>(&mut self, range: R) -> RangeMut<K, V> {
        RangeMut {
            w: Walk::range(self.t, range.start_bound(), range.end_bound()),
        }
    }

    /// Retains only the elements specified by the predicate.
    ///
    /// In other words, removes all pairs `(k, v)` for which `f(&k, &mut v)`
    /// returns `false`. The elements are visited in ascending key order. The
    /// keys to remove are collected first and removed after the walk.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map: BTreeMap<i32, i32> = (0..8).map(|x| (x, x * 10)).collect();
    /// // Keep only the elements with even-numbered keys.
    /// map.retain(|&k, _| k % 2 == 0);
    /// let kept: Vec<(i32, i32)> = map.into_iter().collect();
    /// assert_eq(kept, Vec::from([(0, 0), (2, 20), (4, 40), (6, 60)]));
    /// ```
    pub fn retain(&mut self, f: fn(&K, &mut V) -> bool) {
        let mut gone: Vec<K> = Vec::new();
        for (k, v) in self.iter_mut() {
            if !f(k, v) {
                gone.push(*k);
            }
        }
        for k in gone.iter() {
            self.remove(k);
        }
    }

    /// Moves all elements from `other` into `self`, leaving `other` empty.
    ///
    /// If a key from `other` is already present in `self`, the respective value
    /// from `self` will be overwritten with the respective value from `other`.
    /// Appending a map to itself (or to a copy of its handle) does nothing.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut a = BTreeMap::new();
    /// a.insert(1, "a");
    /// a.insert(2, "b");
    /// a.insert(3, "c"); // Note: Key (3) also present in b.
    ///
    /// let mut b = BTreeMap::new();
    /// b.insert(3, "d"); // Note: Key (3) also present in a.
    /// b.insert(4, "e");
    /// b.insert(5, "f");
    ///
    /// a.append(&mut b);
    ///
    /// assert_eq(a.len(), 5);
    /// assert_eq(b.len(), 0);
    ///
    /// assert_eq(a[&1], "a");
    /// assert_eq(a[&2], "b");
    /// assert_eq(a[&3], "d"); // Note: "c" has been overwritten.
    /// assert_eq(a[&4], "e");
    /// assert_eq(a[&5], "f");
    /// ```
    pub fn append(&mut self, other: &mut BTreeMap<K, V>) {
        if same_tree(self.t, other.t) {
            return;
        }
        for (k, v) in other.iter() {
            self.insert(*k, *v);
        }
        other.clear();
    }

    /// Splits the collection into two at the given key. Returns everything
    /// after the given key, including the key.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut a = BTreeMap::new();
    /// a.insert(1, "a");
    /// a.insert(2, "b");
    /// a.insert(3, "c");
    /// a.insert(17, "d");
    /// a.insert(41, "e");
    ///
    /// let b = a.split_off(&3);
    ///
    /// assert_eq(a.len(), 2);
    /// assert_eq(b.len(), 3);
    ///
    /// assert_eq(a[&1], "a");
    /// assert_eq(a[&2], "b");
    ///
    /// assert_eq(b[&3], "c");
    /// assert_eq(b[&17], "d");
    /// assert_eq(b[&41], "e");
    /// ```
    pub fn split_off(&mut self, key: &K) -> BTreeMap<K, V> {
        let mut out = BTreeMap::new();
        let mut moved: Vec<K> = Vec::new();
        for (k, v) in self.range(*key..) {
            out.insert(*k, *v);
            moved.push(*k);
        }
        for k in moved.iter() {
            self.remove(k);
        }
        out
    }
}

fn same_tree<K, V>(a: &Tree<K, V>, b: &Tree<K, V>) -> bool {
    (a as *const Tree<K, V>) == (b as *const Tree<K, V>)
}

/// A view into a single entry in a map, which may either be vacant or occupied.
///
/// This `enum` is constructed from the [`entry`](BTreeMap::entry) method on
/// [`BTreeMap`].
///
/// # Examples
///
/// ```
/// use std::collections::BTreeMap;
/// use std::collections::btree_map::Entry;
///
/// let mut map = BTreeMap::from([("a", 1)]);
/// match map.entry("a") {
///     Entry::Occupied(e) => assert_eq(*e.get(), 1),
///     Entry::Vacant(_) => panic("expected an occupied entry"),
/// }
/// match map.entry("b") {
///     Entry::Occupied(_) => panic("expected a vacant entry"),
///     Entry::Vacant(e) => {
///         e.insert(2);
///     }
/// }
/// assert_eq(map[&"b"], 2);
/// ```
pub enum Entry<K, V> {
    /// A vacant entry.
    Vacant(VacantEntry<K, V>),
    /// An occupied entry.
    Occupied(OccupiedEntry<K, V>),
}

/// A view into a vacant entry in a `BTreeMap`. It is part of the [`Entry`]
/// enum.
///
/// # Examples
///
/// ```
/// use std::collections::BTreeMap;
/// use std::collections::btree_map::Entry;
///
/// let mut map: BTreeMap<&str, i32> = BTreeMap::new();
/// if let Entry::Vacant(v) = map.entry("poneyland") {
///     assert_eq(*v.key(), "poneyland");
///     v.insert(37);
/// }
/// assert_eq(map[&"poneyland"], 37);
/// ```
pub struct VacantEntry<K, V> {
    map: BTreeMap<K, V>,
    key: K,
}

/// A view into an occupied entry in a `BTreeMap`. It is part of the [`Entry`]
/// enum.
///
/// It is also returned by [`BTreeMap::first_entry`] and
/// [`BTreeMap::last_entry`].
///
/// # Examples
///
/// ```
/// use std::collections::BTreeMap;
/// use std::collections::btree_map::Entry;
///
/// let mut map = BTreeMap::from([("poneyland", 12)]);
/// if let Entry::Occupied(mut o) = map.entry("poneyland") {
///     *o.get_mut() += 10;
///     assert_eq(*o.get(), 22);
/// }
/// assert_eq(map[&"poneyland"], 22);
/// ```
pub struct OccupiedEntry<K, V> {
    map: BTreeMap<K, V>,
    node: &mut Node<K, V>,
    idx: usize,
}

impl<K: Ord, V> Entry<K, V> {
    /// Ensures a value is in the entry by inserting the default if empty, and
    /// returns a mutable reference to the value in the entry.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map: BTreeMap<&str, usize> = BTreeMap::new();
    /// map.entry("poneyland").or_insert(12);
    ///
    /// assert_eq(map[&"poneyland"], 12);
    /// *map.entry("poneyland").or_insert(12) += 10;
    /// assert_eq(map[&"poneyland"], 22);
    /// ```
    pub fn or_insert(self, default: V) -> &mut V {
        match self {
            Entry::Occupied(e) => e.into_mut(),
            Entry::Vacant(e) => e.insert(default),
        }
    }
    /// Ensures a value is in the entry by inserting the result of the default
    /// function if empty, and returns a mutable reference to the value in the
    /// entry.
    ///
    /// `f` is only called when the entry is vacant.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map: BTreeMap<&str, String> = BTreeMap::new();
    /// let s = "hoho".to_string();
    ///
    /// map.entry("poneyland").or_insert_with(|| s.clone());
    ///
    /// assert_eq(map[&"poneyland"], "hoho".to_string());
    /// ```
    pub fn or_insert_with(self, f: fn() -> V) -> &mut V {
        match self {
            Entry::Occupied(e) => e.into_mut(),
            Entry::Vacant(e) => e.insert(f()),
        }
    }
    /// Ensures a value is in the entry by inserting, if empty, the result of
    /// the default function.
    ///
    /// This method allows for generating key-derived values for insertion by
    /// providing the default function a reference to the key that was moved
    /// during the `.entry(key)` method call.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map: BTreeMap<&str, usize> = BTreeMap::new();
    ///
    /// map.entry("poneyland").or_insert_with_key(|key| key.chars().count());
    ///
    /// assert_eq(map[&"poneyland"], 9);
    /// ```
    pub fn or_insert_with_key(self, f: fn(&K) -> V) -> &mut V {
        match self {
            Entry::Occupied(e) => e.into_mut(),
            Entry::Vacant(e) => {
                let v = f(&e.key);
                e.insert(v)
            }
        }
    }
    /// Provides in-place mutable access to an occupied entry before any
    /// potential inserts into the map.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map: BTreeMap<&str, usize> = BTreeMap::new();
    ///
    /// map.entry("poneyland").and_modify(|e| *e += 1).or_insert(42);
    /// assert_eq(map[&"poneyland"], 42);
    ///
    /// map.entry("poneyland").and_modify(|e| *e += 1).or_insert(42);
    /// assert_eq(map[&"poneyland"], 43);
    /// ```
    pub fn and_modify(self, f: fn(&mut V)) -> Entry<K, V> {
        match self {
            Entry::Occupied(mut e) => {
                f(e.get_mut());
                Entry::Occupied(e)
            }
            Entry::Vacant(e) => Entry::Vacant(e),
        }
    }
    /// Returns a reference to this entry's key.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map: BTreeMap<&str, usize> = BTreeMap::new();
    /// assert_eq(*map.entry("poneyland").key(), "poneyland");
    /// ```
    pub fn key(&self) -> &K {
        match self {
            Entry::Occupied(e) => e.key(),
            Entry::Vacant(e) => e.key(),
        }
    }
}

impl<K: Ord, V: Default> Entry<K, V> {
    /// Ensures a value is in the entry by inserting the default value if empty,
    /// and returns a mutable reference to the value in the entry.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map: BTreeMap<&str, Option<usize>> = BTreeMap::new();
    /// map.entry("poneyland").or_default();
    ///
    /// assert_eq(map[&"poneyland"], None);
    /// ```
    pub fn or_default(self) -> &mut V {
        match self {
            Entry::Occupied(e) => e.into_mut(),
            Entry::Vacant(e) => e.insert(V::default()),
        }
    }
}

impl<K: Ord, V> VacantEntry<K, V> {
    /// Gets a reference to the key that would be used when inserting a value
    /// through the `VacantEntry`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map: BTreeMap<&str, usize> = BTreeMap::new();
    /// assert_eq(*map.entry("poneyland").key(), "poneyland");
    /// ```
    pub fn key(&self) -> &K {
        &self.key
    }
    /// Takes ownership of the key.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    /// use std::collections::btree_map::Entry;
    ///
    /// let mut map: BTreeMap<&str, usize> = BTreeMap::new();
    ///
    /// if let Entry::Vacant(v) = map.entry("poneyland") {
    ///     assert_eq(v.into_key(), "poneyland");
    /// }
    /// assert(map.is_empty());
    /// ```
    pub fn into_key(self) -> K {
        self.key
    }
    /// Sets the value of the entry with the `VacantEntry`'s key, and returns a
    /// mutable reference to it.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    /// use std::collections::btree_map::Entry;
    ///
    /// let mut map: BTreeMap<&str, u32> = BTreeMap::new();
    ///
    /// if let Entry::Vacant(o) = map.entry("poneyland") {
    ///     *o.insert(37) += 1;
    /// }
    /// assert_eq(map[&"poneyland"], 38);
    /// ```
    pub fn insert(self, value: V) -> &mut V {
        let mut m = self.map;
        let (n, i, _) = m.insert_at(self.key, value);
        &mut n.vals[i]
    }
}

impl<K: Ord, V> OccupiedEntry<K, V> {
    /// Gets a reference to the key in the entry.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map: BTreeMap<&str, usize> = BTreeMap::new();
    /// map.entry("poneyland").or_insert(12);
    /// assert_eq(*map.entry("poneyland").key(), "poneyland");
    /// ```
    pub fn key(&self) -> &K {
        &self.node.keys[self.idx]
    }
    /// Gets a reference to the value in the entry.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    /// use std::collections::btree_map::Entry;
    ///
    /// let mut map: BTreeMap<&str, usize> = BTreeMap::new();
    /// map.entry("poneyland").or_insert(12);
    ///
    /// if let Entry::Occupied(o) = map.entry("poneyland") {
    ///     assert_eq(*o.get(), 12);
    /// }
    /// ```
    pub fn get(&self) -> &V {
        &self.node.vals[self.idx]
    }
    /// Gets a mutable reference to the value in the entry.
    ///
    /// To get a reference that outlives the `OccupiedEntry`, see
    /// [`into_mut`](OccupiedEntry::into_mut).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    /// use std::collections::btree_map::Entry;
    ///
    /// let mut map: BTreeMap<&str, usize> = BTreeMap::new();
    /// map.entry("poneyland").or_insert(12);
    ///
    /// assert_eq(map[&"poneyland"], 12);
    /// if let Entry::Occupied(mut o) = map.entry("poneyland") {
    ///     *o.get_mut() += 10;
    ///     assert_eq(*o.get(), 22);
    ///
    ///     // We can use the same Entry multiple times.
    ///     *o.get_mut() += 2;
    /// }
    /// assert_eq(map[&"poneyland"], 24);
    /// ```
    pub fn get_mut(&mut self) -> &mut V {
        &mut self.node.vals[self.idx]
    }
    /// Converts the entry into a mutable reference to its value.
    ///
    /// To use the entry and keep changing the value, see
    /// [`get_mut`](OccupiedEntry::get_mut).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    /// use std::collections::btree_map::Entry;
    ///
    /// let mut map: BTreeMap<&str, usize> = BTreeMap::new();
    /// map.entry("poneyland").or_insert(12);
    ///
    /// assert_eq(map[&"poneyland"], 12);
    /// if let Entry::Occupied(o) = map.entry("poneyland") {
    ///     *o.into_mut() += 10;
    /// }
    /// assert_eq(map[&"poneyland"], 22);
    /// ```
    pub fn into_mut(self) -> &mut V {
        &mut self.node.vals[self.idx]
    }
    /// Sets the value of the entry with the `OccupiedEntry`'s key, and returns
    /// the entry's old value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    /// use std::collections::btree_map::Entry;
    ///
    /// let mut map: BTreeMap<&str, usize> = BTreeMap::new();
    /// map.entry("poneyland").or_insert(12);
    ///
    /// if let Entry::Occupied(mut o) = map.entry("poneyland") {
    ///     assert_eq(o.insert(15), 12);
    /// }
    /// assert_eq(map[&"poneyland"], 15);
    /// ```
    pub fn insert(&mut self, value: V) -> V {
        crate::mem::replace(&mut self.node.vals[self.idx], value)
    }
    /// Takes the value of the entry out of the map, and returns it.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    /// use std::collections::btree_map::Entry;
    ///
    /// let mut map: BTreeMap<&str, usize> = BTreeMap::new();
    /// map.entry("poneyland").or_insert(12);
    ///
    /// if let Entry::Occupied(o) = map.entry("poneyland") {
    ///     assert_eq(o.remove(), 12);
    /// }
    /// // If we try to get "poneyland"'s value, it'll panic:
    /// // println(`${map[&"poneyland"]}`);
    /// assert(!map.contains_key(&"poneyland"));
    /// ```
    pub fn remove(self) -> V {
        self.remove_entry().1
    }
    /// Takes ownership of the key and value from the map.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    /// use std::collections::btree_map::Entry;
    ///
    /// let mut map: BTreeMap<&str, usize> = BTreeMap::new();
    /// map.entry("poneyland").or_insert(12);
    ///
    /// if let Entry::Occupied(o) = map.entry("poneyland") {
    ///     // We delete the entry from the map.
    ///     assert_eq(o.remove_entry(), ("poneyland", 12));
    /// }
    /// assert(map.is_empty());
    /// ```
    pub fn remove_entry(self) -> (K, V) {
        let k = self.node.keys[self.idx];
        let mut m = self.map;
        m.remove_entry(&k).unwrap()
    }
}

// A stack of nodes and indexes leading to an entry.
struct Frame<K, V> {
    n: &mut Node<K, V>,
    i: usize,
}

// A double-ended walk over entries: front's top frame is at the next entry
// from the front (n.keys[i]); back's at the next from the back
// (n.keys[i - 1]). The walk ends when they have met.
struct Walk<K, V> {
    front: Vec<Frame<K, V>>,
    back: Vec<Frame<K, V>>,
    done: bool,
}

impl<K, V> Walk<K, V> {
    fn all(t: &Tree<K, V>) -> Walk<K, V> {
        let mut w = Walk {
            front: Vec::new(),
            back: Vec::new(),
            done: true,
        };
        if let Some(root) = t.root {
            if root.len > 0 {
                down_front(&mut w.front, root, 0);
                down_back(&mut w.back, root, root.len);
                w.done = false;
            }
        }
        w
    }

    // The node and index of the next entry from the front.
    fn next(&mut self) -> Option<(&mut Node<K, V>, usize)> {
        if self.done {
            return None;
        }
        let top = self.front[self.front.len() - 1];
        let n = top.n;
        let i = top.i;
        let b = self.back[self.back.len() - 1];
        if same(n, b.n) && i + 1 == b.i {
            self.done = true;
            return Some((n, i));
        }
        let last = self.front.len() - 1;
        self.front[last].i = i + 1;
        if !n.is_leaf() {
            down_front(&mut self.front, n.edge(i + 1), 0);
        }
        while self.front[self.front.len() - 1].i == self.front[self.front.len() - 1].n.len {
            self.front.pop();
        }
        Some((n, i))
    }

    fn next_back(&mut self) -> Option<(&mut Node<K, V>, usize)> {
        if self.done {
            return None;
        }
        let top = self.back[self.back.len() - 1];
        let n = top.n;
        let i = top.i - 1;
        let f = self.front[self.front.len() - 1];
        if same(n, f.n) && i == f.i {
            self.done = true;
            return Some((n, i));
        }
        let last = self.back.len() - 1;
        self.back[last].i = i;
        if !n.is_leaf() {
            let c = n.edge(i);
            down_back(&mut self.back, c, c.len);
        }
        while self.back[self.back.len() - 1].i == 0 {
            self.back.pop();
        }
        Some((n, i))
    }
}

// Pushes n at i, then the leftmost path below edge i.
fn down_front<K, V>(st: &mut Vec<Frame<K, V>>, n: &mut Node<K, V>, i: usize) {
    st.push(Frame { n, i });
    let mut n = n;
    while !n.is_leaf() {
        n = n.edge(0);
        st.push(Frame { n, i: 0 });
    }
}

// Pushes n at i, then the rightmost path below n.
fn down_back<K, V>(st: &mut Vec<Frame<K, V>>, n: &mut Node<K, V>, i: usize) {
    st.push(Frame { n, i });
    let mut n = n;
    while !n.is_leaf() {
        n = n.edge(n.len);
        st.push(Frame { n, i: n.len });
    }
}

impl<K: Ord, V> Walk<K, V> {
    #[track_caller]
    fn range(t: &Tree<K, V>, lo: Bound<&K>, hi: Bound<&K>) -> Walk<K, V> {
        match (lo, hi) {
            (Bound::Included(a), Bound::Included(b)) => {
                if a > b {
                    panic("range start is greater than range end in BTreeMap");
                }
            }
            (Bound::Included(a), Bound::Excluded(b)) => {
                if a > b {
                    panic("range start is greater than range end in BTreeMap");
                }
            }
            (Bound::Excluded(a), Bound::Included(b)) => {
                if a > b {
                    panic("range start is greater than range end in BTreeMap");
                }
            }
            (Bound::Excluded(a), Bound::Excluded(b)) => {
                if a > b {
                    panic("range start is greater than range end in BTreeMap");
                }
                if a == b {
                    panic("range start and end are equal and excluded in BTreeMap");
                }
            }
            _ => {}
        }
        let mut w = Walk {
            front: Vec::new(),
            back: Vec::new(),
            done: true,
        };
        let root = match t.root {
            Some(r) => r,
            None => return w,
        };
        // The front: the first entry at or after lo.
        let mut n = root;
        loop {
            let mut i = 0;
            let mut exact = false;
            match lo {
                Bound::Included(k) => {
                    while i < n.len {
                        match k.cmp(&n.keys[i]) {
                            Ordering::Greater => {
                                i += 1;
                            }
                            Ordering::Equal => {
                                exact = true;
                                break;
                            }
                            Ordering::Less => break,
                        }
                    }
                }
                Bound::Excluded(k) => {
                    while i < n.len && n.keys[i] <= *k {
                        i += 1;
                    }
                }
                Bound::Unbounded => {}
            }
            w.front.push(Frame { n, i });
            if exact || n.is_leaf() {
                break;
            }
            n = n.edge(i);
        }
        while w.front.len() > 0 && w.front[w.front.len() - 1].i == w.front[w.front.len() - 1].n.len
        {
            w.front.pop();
        }
        // The back: the last entry at or before hi.
        let mut n = root;
        loop {
            let mut i = 0;
            let mut exact = false;
            match hi {
                Bound::Included(k) => {
                    while i < n.len {
                        match k.cmp(&n.keys[i]) {
                            Ordering::Greater => {
                                i += 1;
                            }
                            Ordering::Equal => {
                                i += 1;
                                exact = true;
                                break;
                            }
                            Ordering::Less => break,
                        }
                    }
                }
                Bound::Excluded(k) => {
                    while i < n.len && n.keys[i] < *k {
                        i += 1;
                    }
                }
                Bound::Unbounded => {
                    i = n.len;
                }
            }
            w.back.push(Frame { n, i });
            if exact || n.is_leaf() {
                break;
            }
            n = n.edge(i);
        }
        while w.back.len() > 0 && w.back[w.back.len() - 1].i == 0 {
            w.back.pop();
        }
        if w.front.len() > 0 && w.back.len() > 0 {
            let f = w.front[w.front.len() - 1];
            let b = w.back[w.back.len() - 1];
            w.done = f.n.keys[f.i] > b.n.keys[b.i - 1];
        }
        w
    }
}

/// An iterator over the entries of a `BTreeMap`, in key order.
///
/// This `struct` is created by the [`iter`](BTreeMap::iter) method on
/// [`BTreeMap`]. It yields `(&K, &V)` pairs, can be iterated from both ends,
/// and knows its exact length.
///
/// # Examples
///
/// ```
/// use std::collections::BTreeMap;
///
/// let map = BTreeMap::from([(2, "b"), (1, "a")]);
/// let mut iter = map.iter();
/// assert_eq(iter.len(), 2);
/// assert_eq(iter.next(), Some((&1, &"a")));
/// assert_eq(iter.next_back(), Some((&2, &"b")));
/// assert_eq(iter.next(), None);
/// ```
pub struct Iter<K, V> {
    w: Walk<K, V>,
    left: usize,
}
impl<K, V> Iterator for Iter<K, V> {
    type Item = (&K, &V);
    fn next(&mut self) -> Option<(&K, &V)> {
        let (n, i) = self.w.next()?;
        self.left -= 1;
        Some((&n.keys[i], &n.vals[i]))
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        (self.left, Some(self.left))
    }
}
impl<K, V> DoubleEndedIterator for Iter<K, V> {
    fn next_back(&mut self) -> Option<(&K, &V)> {
        let (n, i) = self.w.next_back()?;
        self.left -= 1;
        Some((&n.keys[i], &n.vals[i]))
    }
}
impl<K, V> ExactSizeIterator for Iter<K, V> {}

/// A mutable iterator over the entries of a `BTreeMap`, in key order.
///
/// This `struct` is created by the [`iter_mut`](BTreeMap::iter_mut) method on
/// [`BTreeMap`]. It yields `(&K, &mut V)` pairs.
///
/// # Examples
///
/// ```
/// use std::collections::BTreeMap;
///
/// let mut map = BTreeMap::from([(1, 10), (2, 20)]);
/// for (k, v) in map.iter_mut() {
///     *v += *k;
/// }
/// assert_eq(map[&2], 22);
/// ```
pub struct IterMut<K, V> {
    w: Walk<K, V>,
    left: usize,
}
impl<K, V> Iterator for IterMut<K, V> {
    type Item = (&K, &mut V);
    fn next(&mut self) -> Option<(&K, &mut V)> {
        let (n, i) = self.w.next()?;
        self.left -= 1;
        Some((&n.keys[i], &mut n.vals[i]))
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        (self.left, Some(self.left))
    }
}
impl<K, V> DoubleEndedIterator for IterMut<K, V> {
    fn next_back(&mut self) -> Option<(&K, &mut V)> {
        let (n, i) = self.w.next_back()?;
        self.left -= 1;
        Some((&n.keys[i], &mut n.vals[i]))
    }
}
impl<K, V> ExactSizeIterator for IterMut<K, V> {}

/// An owning iterator over the entries of a `BTreeMap`, sorted by key.
///
/// This `struct` is created by the [`into_iter`](IntoIterator::into_iter)
/// method on [`BTreeMap`] (provided by the [`IntoIterator`] trait). It yields
/// `(K, V)` pairs. The map's other handles still see its entries.
///
/// # Examples
///
/// ```
/// use std::collections::BTreeMap;
///
/// let map = BTreeMap::from([(2, "b"), (1, "a")]);
/// let v: Vec<(i32, &str)> = map.into_iter().collect();
/// assert_eq(v, Vec::from([(1, "a"), (2, "b")]));
/// ```
pub struct IntoIter<K, V> {
    w: Walk<K, V>,
    left: usize,
}
impl<K, V> Iterator for IntoIter<K, V> {
    type Item = (K, V);
    fn next(&mut self) -> Option<(K, V)> {
        let (n, i) = self.w.next()?;
        self.left -= 1;
        Some((n.keys[i], n.vals[i]))
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        (self.left, Some(self.left))
    }
}
impl<K, V> DoubleEndedIterator for IntoIter<K, V> {
    fn next_back(&mut self) -> Option<(K, V)> {
        let (n, i) = self.w.next_back()?;
        self.left -= 1;
        Some((n.keys[i], n.vals[i]))
    }
}
impl<K, V> ExactSizeIterator for IntoIter<K, V> {}

/// An iterator over the keys of a `BTreeMap`, in sorted order.
///
/// This `struct` is created by the [`keys`](BTreeMap::keys) method on
/// [`BTreeMap`].
///
/// # Examples
///
/// ```
/// use std::collections::BTreeMap;
///
/// let map = BTreeMap::from([(2, "b"), (1, "a")]);
/// let mut keys = map.keys();
/// assert_eq(keys.next(), Some(&1));
/// assert_eq(keys.next_back(), Some(&2));
/// assert_eq(keys.next(), None);
/// ```
pub struct Keys<K, V> {
    it: Iter<K, V>,
}
impl<K, V> Iterator for Keys<K, V> {
    type Item = &K;
    fn next(&mut self) -> Option<&K> {
        match self.it.next() {
            Some((k, _)) => Some(k),
            None => None,
        }
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        self.it.size_hint()
    }
}
impl<K, V> DoubleEndedIterator for Keys<K, V> {
    fn next_back(&mut self) -> Option<&K> {
        match self.it.next_back() {
            Some((k, _)) => Some(k),
            None => None,
        }
    }
}
impl<K, V> ExactSizeIterator for Keys<K, V> {}

/// An iterator over the values of a `BTreeMap`, in order by key.
///
/// This `struct` is created by the [`values`](BTreeMap::values) method on
/// [`BTreeMap`].
///
/// # Examples
///
/// ```
/// use std::collections::BTreeMap;
///
/// let map = BTreeMap::from([(2, "b"), (1, "a")]);
/// let mut values = map.values();
/// assert_eq(values.next(), Some(&"a"));
/// assert_eq(values.next(), Some(&"b"));
/// assert_eq(values.next(), None);
/// ```
pub struct Values<K, V> {
    it: Iter<K, V>,
}
impl<K, V> Iterator for Values<K, V> {
    type Item = &V;
    fn next(&mut self) -> Option<&V> {
        match self.it.next() {
            Some((_, v)) => Some(v),
            None => None,
        }
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        self.it.size_hint()
    }
}
impl<K, V> DoubleEndedIterator for Values<K, V> {
    fn next_back(&mut self) -> Option<&V> {
        match self.it.next_back() {
            Some((_, v)) => Some(v),
            None => None,
        }
    }
}
impl<K, V> ExactSizeIterator for Values<K, V> {}

/// A mutable iterator over the values of a `BTreeMap`, in order by key.
///
/// This `struct` is created by the [`values_mut`](BTreeMap::values_mut) method
/// on [`BTreeMap`].
///
/// # Examples
///
/// ```
/// use std::collections::BTreeMap;
///
/// let mut map = BTreeMap::from([(1, 1), (2, 2)]);
/// for v in map.values_mut() {
///     *v *= 10;
/// }
/// assert_eq(map[&2], 20);
