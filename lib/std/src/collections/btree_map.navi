pub struct ValuesMut<K, V> {
    it: IterMut<K, V>,
}
impl<K, V> Iterator for ValuesMut<K, V> {
    type Item = &mut V;
    fn next(&mut self) -> Option<&mut V> {
        match self.it.next() {
            Some((_, v)) => Some(v),
            None => None,
        }
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        self.it.size_hint()
    }
}
impl<K, V> DoubleEndedIterator for ValuesMut<K, V> {
    fn next_back(&mut self) -> Option<&mut V> {
        match self.it.next_back() {
            Some((_, v)) => Some(v),
            None => None,
        }
    }
}
impl<K, V> ExactSizeIterator for ValuesMut<K, V> {}

/// An owning iterator over the keys of a `BTreeMap`, in sorted order.
///
/// This `struct` is created by the [`into_keys`](BTreeMap::into_keys) method on
/// [`BTreeMap`].
///
/// # Examples
///
/// ```
/// use std::collections::BTreeMap;
///
/// let map = BTreeMap::from([(2, "b"), (1, "a")]);
