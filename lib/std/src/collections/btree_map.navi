/// assert_eq(values, Vec::from(["a", "b"]));
/// ```
pub struct IntoValues<K, V> {
    it: IntoIter<K, V>,
}
impl<K, V> Iterator for IntoValues<K, V> {
    type Item = V;
    fn next(&mut self) -> Option<V> {
        match self.it.next() {
            Some((_, v)) => Some(v),
            None => None,
        }
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        self.it.size_hint()
    }
}
impl<K, V> DoubleEndedIterator for IntoValues<K, V> {
    fn next_back(&mut self) -> Option<V> {
        match self.it.next_back() {
            Some((_, v)) => Some(v),
            None => None,
        }
    }
}

/// An iterator over a sub-range of the entries of a `BTreeMap`, in key order.
///
/// This `struct` is created by the [`range`](BTreeMap::range) method on
/// [`BTreeMap`]. It can be iterated from both ends.
///
/// # Examples
///
/// ```
/// use std::collections::BTreeMap;
///
/// let map = BTreeMap::from([(1, "a"), (2, "b"), (3, "c"), (4, "d")]);
/// let mut range = map.range(2..=3);
/// assert_eq(range.next(), Some((&2, &"b")));
/// assert_eq(range.next_back(), Some((&3, &"c")));
/// assert_eq(range.next(), None);
/// ```
pub struct Range<K, V> {
    w: Walk<K, V>,
}
impl<K, V> Iterator for Range<K, V> {
    type Item = (&K, &V);
    fn next(&mut self) -> Option<(&K, &V)> {
        let (n, i) = self.w.next()?;
        Some((&n.keys[i], &n.vals[i]))
    }
}
impl<K, V> DoubleEndedIterator for Range<K, V> {
    fn next_back(&mut self) -> Option<(&K, &V)> {
        let (n, i) = self.w.next_back()?;
        Some((&n.keys[i], &n.vals[i]))
    }
}

/// A mutable iterator over a sub-range of the entries of a `BTreeMap`, in key
/// order.
///
/// This `struct` is created by the [`range_mut`](BTreeMap::range_mut) method on
/// [`BTreeMap`].
///
/// # Examples
///
/// ```
/// use std::collections::BTreeMap;
///
/// let mut map = BTreeMap::from([(1, 0), (2, 0), (3, 0)]);
/// for (_, v) in map.range_mut(2..) {
///     *v = 1;
/// }
/// let values: Vec<i32> = map.values().cloned().collect();
/// assert_eq(values, Vec::from([0, 1, 1]));
/// ```
pub struct RangeMut<K, V> {
    w: Walk<K, V>,
}
impl<K, V> Iterator for RangeMut<K, V> {
    type Item = (&K, &mut V);
    fn next(&mut self) -> Option<(&K, &mut V)> {
        let (n, i) = self.w.next()?;
        Some((&n.keys[i], &mut n.vals[i]))
    }
}
impl<K, V> DoubleEndedIterator for RangeMut<K, V> {
    fn next_back(&mut self) -> Option<(&K, &mut V)> {
        let (n, i) = self.w.next_back()?;
        Some((&n.keys[i], &mut n.vals[i]))
    }
}

impl<K, V> IntoIterator for BTreeMap<K, V> {
    type Item = (K, V);
    type IntoIter = IntoIter<K, V>;
    /// Gets an owning iterator over the entries of the map, sorted by key.
    ///
    /// Unlike Rust's, this does not empty the map: its other handles still see
    /// the entries.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map = BTreeMap::new();
    /// map.insert(3, "c");
    /// map.insert(2, "b");
    /// map.insert(1, "a");
    ///
    /// for (key, value) in map {
    ///     println(`${key}: ${value}`);
    /// }
    /// ```
    fn into_iter(self) -> IntoIter<K, V> {
        IntoIter {
            w: Walk::all(self.t),
            left: self.t.len,
        }
    }
}

impl<K, V> IntoIterator for &BTreeMap<K, V> {
    type Item = (&K, &V);
    type IntoIter = Iter<K, V>;
    fn into_iter(self) -> Iter<K, V> {
        self.iter()
    }
}

impl<K, V> IntoIterator for &mut BTreeMap<K, V> {
    type Item = (&K, &mut V);
    type IntoIter = IterMut<K, V>;
    fn into_iter(self) -> IterMut<K, V> {
        self.iter_mut()
    }
}

impl<K: Ord, V> Index<&K> for BTreeMap<K, V> {
    type Output = V;
    /// Returns a reference to the value corresponding to the supplied key.
    ///
    /// # Panics
    ///
    /// Panics if the key is not present in the `BTreeMap`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let map = BTreeMap::from([("a", 1)]);
    /// assert_eq(map[&"a"], 1);
    /// ```
    ///
    /// ```should_panic
    /// use std::collections::BTreeMap;
    ///
    /// let map = BTreeMap::from([("a", 1)]);
    /// let _ = map[&"b"];
    /// ```
    #[track_caller]
    fn index(&self, k: &K) -> &V {
        match self.get(k) {
            Some(v) => v,
            None => panic("key not found in BTreeMap"),
        }
    }
}

impl<K: Clone, V: Clone> Clone for BTreeMap<K, V> {
    /// Makes an independent copy of the map, cloning every key and value.
    ///
    /// Assigning a `BTreeMap` only copies its handle; `clone` copies the tree.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let a = BTreeMap::from([(1, "a")]);
    /// let mut b = a.clone();
    /// b.insert(2, "b");
    /// assert_eq(a.len(), 1);
    /// assert_eq(b.len(), 2);
    /// ```
    fn clone(&self) -> BTreeMap<K, V> {
        let root = match self.t.root {
            Some(r) => Some(clone_node(r)),
            None => None,
        };
        BTreeMap {
            t: &mut Tree {
                root,
                len: self.t.len,
            },
        }
    }
}

impl<K, V> Default for BTreeMap<K, V> {
    /// Creates an empty `BTreeMap`.
    fn default() -> BTreeMap<K, V> {
        BTreeMap::new()
    }
}

impl<K: Debug, V: Debug> Debug for BTreeMap<K, V> {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        let mut m = f.debug_map();
        for (k, v) in self.iter() {
            m.entry(k, v);
        }
        m.finish()
    }
}

impl<K: PartialEq, V: PartialEq> PartialEq for BTreeMap<K, V> {
    /// Returns `true` if both maps have the same entries, in the same order.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let a = BTreeMap::from([(1, "a"), (2, "b")]);
    /// let mut b = BTreeMap::new();
    /// b.insert(2, "b");
    /// b.insert(1, "a");
    /// assert(a == b);
    /// b.insert(3, "c");
    /// assert(a != b);
    /// ```
    fn eq(&self, other: &BTreeMap<K, V>) -> bool {
        if self.len() != other.len() {
            return false;
        }
        let mut a = self.iter();
        let mut b = other.iter();
        while let Some((k, v)) = a.next() {
            match b.next() {
                Some((k2, v2)) => {
                    if k != k2 || v != v2 {
                        return false;
                    }
                }
                None => return false,
            }
        }
        true
    }
}

impl<K: Eq, V: Eq> Eq for BTreeMap<K, V> {}

impl<K: crate::hash::Hash, V: crate::hash::Hash> crate::hash::Hash for BTreeMap<K, V> {
    fn hash<H: crate::hash::Hasher>(&self, state: &mut H) {
        state.write_usize(self.len());
        for (k, v) in self.iter() {
            k.hash(state);
            v.hash(state);
        }
    }
}

impl<K: Ord, V> FromIterator<(K, V)> for BTreeMap<K, V> {
    /// Constructs a `BTreeMap` from an iterator of key-value pairs.
    ///
    /// If the iterator produces any pairs with equal keys, all but one of the
    /// corresponding values will be dropped: the last one is kept.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let map: BTreeMap<i32, char> = Vec::from([(2, 'b'), (1, 'a'), (2, 'c')]).into_iter().collect();
    /// assert_eq(map.len(), 2);
    /// assert_eq(map[&2], 'c');
    /// ```
    fn from_iter<I: IntoIterator<Item = (K, V)>>(iter: I) -> BTreeMap<K, V> {
        let mut m = BTreeMap::new();
        for (k, v) in iter {
            m.insert(k, v);
        }
        m
    }
}

impl<K: Ord, V> Extend<(K, V)> for BTreeMap<K, V> {
    /// Inserts every key-value pair of the iterator into the map, replacing the
    /// values of keys already present.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let mut map = BTreeMap::from([(1, "a")]);
    /// map.extend([(1, "b"), (2, "c")]);
    /// assert_eq(map[&1], "b");
    /// assert_eq(map.len(), 2);
    /// ```
    fn extend<I: IntoIterator<Item = (K, V)>>(&mut self, iter: I) {
        for (k, v) in iter {
            self.insert(k, v);
        }
    }
}

impl<K: Ord, V, const N: usize> From<[(K, V); N]> for BTreeMap<K, V> {
    /// Converts a `[(K, V); N]` into a `BTreeMap<K, V>`.
    ///
    /// If any entries in the array have equal keys, all but one of the
    /// corresponding values will be dropped: the last one is kept.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::collections::BTreeMap;
    ///
    /// let map1 = BTreeMap::from([(1, 2), (3, 4)]);
    /// let map2: BTreeMap<i32, i32> = [(1, 2), (3, 4)].into_iter().collect();
    /// assert_eq(map1, map2);
    /// ```
    fn from(a: [(K, V); N]) -> BTreeMap<K, V> {
        let mut m = BTreeMap::new();
        for e in a.iter() {
            m.insert(e.0, e.1);
        }
        m
    }
}
