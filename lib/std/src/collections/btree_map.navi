/// assert_eq(keys, Vec::from([2, 1]));
/// ```
pub struct IntoKeys<K, V> {
    it: IntoIter<K, V>,
}
impl<K, V> Iterator for IntoKeys<K, V> {
    type Item = K;
    fn next(&mut self) -> Option<K> {
        match self.it.next() {
            Some((k, _)) => Some(k),
            None => None,
        }
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        self.it.size_hint()
    }
}
impl<K, V> DoubleEndedIterator for IntoKeys<K, V> {
    fn next_back(&mut self) -> Option<K> {
        match self.it.next_back() {
            Some((k, _)) => Some(k),
            None => None,
        }
    }
}

/// An owning iterator over the values of a `BTreeMap`, in order by key.
///
/// This `struct` is created by the [`into_values`](BTreeMap::into_values)
/// method on [`BTreeMap`].
///
/// # Examples
///
/// ```
/// use std::collections::BTreeMap;
///
/// let map = BTreeMap::from([(2, "b"), (1, "a")]);
