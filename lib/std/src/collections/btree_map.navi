//! An ordered map: a B-tree with up to 11 entries in a node. BTreeMap has
//! reference semantics like Vec: copies share the tree; use clone() for an
//! independent copy.

use crate::cmp::Ordering;
use crate::fmt::{self, Debug, Formatter};
use crate::ops::{Bound, Index, RangeBounds};

// Minimum degree: a node other than the root holds B - 1 to 2B - 1
// entries; an internal node has one more child than entries.
const B: usize = 6;
const CAP: usize = 11;
const MIN: usize = 5;

struct Node<K, V> {
    len: usize,
    keys: [K; CAP],
    vals: [V; CAP],
    // CAP + 1 children; null in a leaf.
    edges: *mut &mut Node<K, V>,
}

fn new_leaf<K, V>() -> &mut Node<K, V> {
    // Zeroed: len 0, no edges (the arrays' slots past len are unused).
    unsafe { &mut *crate::rt::alloc_array::<Node<K, V>>(1) }
}

// An internal node: a node and its children in one object (the node's
// edges point at the children here).
struct Internal<K, V> {
    node: Node<K, V>,
    edges: [&mut Node<K, V>; CAP + 1],
}

fn new_internal<K, V>() -> &mut Node<K, V> {
    let x = unsafe { &mut *crate::rt::alloc_array::<Internal<K, V>>(1) };
    x.node.edges = &mut x.edges[0] as *mut &mut Node<K, V>;
    &mut x.node
}

fn same<K, V>(a: &Node<K, V>, b: &Node<K, V>) -> bool {
    (a as *const Node<K, V>) == (b as *const Node<K, V>)
}

impl<K, V> Node<K, V> {
    fn is_leaf(&self) -> bool { self.edges.is_null() }
    fn edge(&self, i: usize) -> &mut Node<K, V> { unsafe { self.edges.add(i).read() } }
    fn set_edge(&mut self, i: usize, e: &mut Node<K, V>) { unsafe { self.edges.add(i).write(e); } }

    // Inserts an entry at i (the node is not full).
    fn insert_kv(&mut self, i: usize, k: K, v: V) {
        let mut j = self.len;
        while j > i {
            self.keys[j] = self.keys[j - 1];
            self.vals[j] = self.vals[j - 1];
            j -= 1;
        }
        self.keys[i] = k;
        self.vals[i] = v;
        self.len += 1;
    }

    // Inserts a child at i, after insert_kv made room for it.
    fn insert_edge(&mut self, i: usize, e: &mut Node<K, V>) {
        let mut j = self.len;
        while j > i {
            self.set_edge(j, self.edge(j - 1));
            j -= 1;
        }
        self.set_edge(i, e);
    }

    fn remove_kv(&mut self, i: usize) -> (K, V) {
        let k = self.keys[i];
        let v = self.vals[i];
        let mut j = i;
        while j + 1 < self.len {
            self.keys[j] = self.keys[j + 1];
            self.vals[j] = self.vals[j + 1];
            j += 1;
        }
        self.len -= 1;
        (k, v)
    }

    // Removes the child at i, after remove_kv.
    fn remove_edge(&mut self, i: usize) {
        let mut j = i;
        while j <= self.len {
            self.set_edge(j, self.edge(j + 1));
            j += 1;
        }
    }
}

// The index of k in n, or of the child to look in.
fn search<K: Ord, V>(n: &Node<K, V>, k: &K) -> (usize, bool) {
    let mut i = 0;
    while i < n.len {
        match k.cmp(&n.keys[i]) {
            Ordering::Greater => { i += 1; }
            Ordering::Equal => return (i, true),
            Ordering::Less => return (i, false),
        }
    }
    (i, false)
}

// Splits the full child i of p, moving its middle entry up into p.
fn split_child<K, V>(p: &mut Node<K, V>, i: usize) {
    let y = p.edge(i);
    let z: &mut Node<K, V> = if y.is_leaf() { new_leaf() } else { new_internal() };
    let mut j = 0;
    while j < MIN {
        z.keys[j] = y.keys[B + j];
        z.vals[j] = y.vals[B + j];
        j += 1;
    }
    if !y.is_leaf() {
        let mut j = 0;
        while j <= MIN {
            z.set_edge(j, y.edge(B + j));
            j += 1;
        }
    }
    z.len = MIN;
    y.len = MIN;
    p.insert_kv(i, y.keys[MIN], y.vals[MIN]);
    p.insert_edge(i + 1, z);
}

// Merges child i + 1 of p and the entry between them into child i.
fn merge<K, V>(p: &mut Node<K, V>, i: usize) {
    let y = p.edge(i);
    let z = p.edge(i + 1);
    let (k, v) = p.remove_kv(i);
    p.remove_edge(i + 1);
    let base = y.len;
    y.keys[base] = k;
    y.vals[base] = v;
    let mut j = 0;
    while j < z.len {
        y.keys[base + 1 + j] = z.keys[j];
        y.vals[base + 1 + j] = z.vals[j];
        j += 1;
    }
    if !y.is_leaf() {
        let mut j = 0;
        while j <= z.len {
            y.set_edge(base + 1 + j, z.edge(j));
            j += 1;
        }
    }
    y.len = base + 1 + z.len;
}

// Makes child i of p hold more than MIN entries (borrowing from a sibling
// or merging with one) before a removal descends into it. Returns the
// index of the child that now covers the keys child i covered.
fn fill_child<K, V>(p: &mut Node<K, V>, i: usize) -> usize {
    let c = p.edge(i);
    if c.len > MIN { return i; }
    if i > 0 && p.edge(i - 1).len > MIN {
        // Rotate right through p.
        let l = p.edge(i - 1);
        c.insert_kv(0, p.keys[i - 1], p.vals[i - 1]);
        if !c.is_leaf() { c.insert_edge(0, l.edge(l.len)); }
        p.keys[i - 1] = l.keys[l.len - 1];
        p.vals[i - 1] = l.vals[l.len - 1];
        l.len -= 1;
        return i;
    }
    if i < p.len && p.edge(i + 1).len > MIN {
        // Rotate left through p.
        let r = p.edge(i + 1);
        c.keys[c.len] = p.keys[i];
        c.vals[c.len] = p.vals[i];
        c.len += 1;
        if !c.is_leaf() { c.set_edge(c.len, r.edge(0)); }
        p.keys[i] = r.keys[0];
        p.vals[i] = r.vals[0];
        r.remove_kv(0);
        if !r.is_leaf() { r.remove_edge(0); }
        return i;
    }
    if i < p.len {
        merge(p, i);
        i
    } else {
        merge(p, i - 1);
        i - 1
    }
}

// What a removal looks for.
const BY_KEY: u8 = 0;
const FIRST: u8 = 1;
const LAST: u8 = 2;

// Removes the entry from the subtree at n (which holds more than MIN
// entries, or is the root), top-down: each child is filled before the
// removal descends into it.
fn remove_from<K: Ord, V>(n: &mut Node<K, V>, key: Option<&K>, what: u8) -> Option<(K, V)> {
    let mut n = n;
    loop {
        let (i, found) = if what == FIRST {
            (0, n.is_leaf())
        } else if what == LAST {
            if n.is_leaf() { (n.len - 1, true) } else { (n.len, false) }
        } else {
            search(n, key.unwrap())
        };
        if found {
            if n.is_leaf() { return Some(n.remove_kv(i)); }
            // An internal entry: replace it with its predecessor or
            // successor, or merge its two children and go on in them.
            if n.edge(i).len > MIN {
                let (k, v) = remove_from(n.edge(i), None, LAST).unwrap();
                let old = (n.keys[i], n.vals[i]);
                n.keys[i] = k;
                n.vals[i] = v;
                return Some(old);
            }
            if n.edge(i + 1).len > MIN {
                let (k, v) = remove_from(n.edge(i + 1), None, FIRST).unwrap();
                let old = (n.keys[i], n.vals[i]);
                n.keys[i] = k;
                n.vals[i] = v;
                return Some(old);
            }
            merge(n, i);
            n = n.edge(i);
        } else {
            if n.is_leaf() { return None; }
            let j = fill_child(n, i);
            n = n.edge(j);
        }
    }
}

fn clone_node<K: Clone, V: Clone>(n: &Node<K, V>) -> &mut Node<K, V> {
    let c: &mut Node<K, V> = if n.is_leaf() { new_leaf() } else { new_internal() };
    let mut i = 0;
    while i < n.len {
        c.keys[i] = n.keys[i].clone();
        c.vals[i] = n.vals[i].clone();
        i += 1;
    }
    if !n.is_leaf() {
        let mut i = 0;
        while i <= n.len {
            c.set_edge(i, clone_node(n.edge(i)));
            i += 1;
        }
    }
    c.len = n.len;
    c
}

pub struct BTreeMap<K, V> {
    t: &mut Tree<K, V>,
}

struct Tree<K, V> {
    root: Option<&mut Node<K, V>>,
    len: usize,
}

impl<K, V> BTreeMap<K, V> {
    pub fn new() -> BTreeMap<K, V> { BTreeMap { t: &mut Tree { root: None, len: 0 } } }
    pub fn len(&self) -> usize { self.t.len }
    pub fn is_empty(&self) -> bool { self.t.len == 0 }

    pub fn clear(&mut self) {
        self.t.root = None;
        self.t.len = 0;
    }

    pub fn iter(&self) -> Iter<K, V> { Iter { w: Walk::all(self.t), left: self.t.len } }
    pub fn iter_mut(&mut self) -> IterMut<K, V> { IterMut { w: Walk::all(self.t), left: self.t.len } }
    pub fn keys(&self) -> Keys<K, V> { Keys { it: self.iter() } }
    pub fn values(&self) -> Values<K, V> { Values { it: self.iter() } }
    pub fn values_mut(&mut self) -> ValuesMut<K, V> { ValuesMut { it: self.iter_mut() } }
    pub fn into_keys(self) -> IntoKeys<K, V> { IntoKeys { it: self.into_iter() } }
    pub fn into_values(self) -> IntoValues<K, V> { IntoValues { it: self.into_iter() } }

    pub fn first_key_value(&self) -> Option<(&K, &V)> {
        let mut n = self.t.root?;
        while !n.is_leaf() { n = n.edge(0); }
        Some((&n.keys[0], &n.vals[0]))
    }

    pub fn last_key_value(&self) -> Option<(&K, &V)> {
        let mut n = self.t.root?;
        while !n.is_leaf() { n = n.edge(n.len); }
        Some((&n.keys[n.len - 1], &n.vals[n.len - 1]))
    }
}

impl<K: Ord, V> BTreeMap<K, V> {
    // The node and index of k.
    fn find(&self, k: &K) -> Option<(&mut Node<K, V>, usize)> {
        let mut n = self.t.root?;
        loop {
            let (i, found) = search(n, k);
            if found { return Some((n, i)); }
            if n.is_leaf() { return None; }
            n = n.edge(i);
        }
    }

    pub fn get(&self, k: &K) -> Option<&V> {
        match self.find(k) { Some((n, i)) => Some(&n.vals[i]), None => None }
    }

    pub fn get_mut(&mut self, k: &K) -> Option<&mut V> {
        match self.find(k) { Some((n, i)) => Some(&mut n.vals[i]), None => None }
    }

    pub fn get_key_value(&self, k: &K) -> Option<(&K, &V)> {
        match self.find(k) { Some((n, i)) => Some((&n.keys[i], &n.vals[i])), None => None }
    }

    pub fn contains_key(&self, k: &K) -> bool { self.find(k).is_some() }

    /// Inserts a value, returning the previous value of the key (the key
    /// itself is not replaced).
    pub fn insert(&mut self, k: K, v: V) -> Option<V> {
        let (_, _, old) = self.insert_at(k, v);
        old
    }

    // Inserts or replaces, splitting full nodes on the way down. Returns
    // where the value is and the old value.
    fn insert_at(&mut self, k: K, v: V) -> (&mut Node<K, V>, usize, Option<V>) {
        let mut n = match self.t.root {
            Some(r) => r,
            None => {
                let r: &mut Node<K, V> = new_leaf();
                self.t.root = Some(r);
                r
            }
        };
        if n.len == CAP {
            let r: &mut Node<K, V> = new_internal();
            r.set_edge(0, n);
            split_child(r, 0);
            self.t.root = Some(r);
            n = r;
        }
        loop {
            let (i, found) = search(n, &k);
            if found {
                let old = crate::mem::replace(&mut n.vals[i], v);
                return (n, i, Some(old));
            }
            if n.is_leaf() {
                n.insert_kv(i, k, v);
                self.t.len += 1;
                return (n, i, None);
            }
            let mut i = i;
            if n.edge(i).len == CAP {
                split_child(n, i);
                match k.cmp(&n.keys[i]) {
                    Ordering::Equal => {
                        let old = crate::mem::replace(&mut n.vals[i], v);
                        return (n, i, Some(old));
                    }
                    Ordering::Greater => { i += 1; }
                    Ordering::Less => {}
                }
            }
            n = n.edge(i);
        }
    }

    pub fn remove(&mut self, k: &K) -> Option<V> {
        match self.remove_entry(k) { Some((_, v)) => Some(v), None => None }
    }

    pub fn remove_entry(&mut self, k: &K) -> Option<(K, V)> { self.remove_what(Some(k), BY_KEY) }
    pub fn pop_first(&mut self) -> Option<(K, V)> { self.remove_what(None, FIRST) }
    pub fn pop_last(&mut self) -> Option<(K, V)> { self.remove_what(None, LAST) }

    fn remove_what(&mut self, key: Option<&K>, what: u8) -> Option<(K, V)> {
        let root = self.t.root?;
        let r = remove_from(root, key, what);
        if r.is_some() {
            self.t.len -= 1;
            if root.len == 0 {
                self.t.root = if root.is_leaf() { None } else { Some(root.edge(0)) };
            }
        }
        r
    }

    pub fn entry(&mut self, key: K) -> Entry<K, V> {
        match self.find(&key) {
            Some((n, i)) => Entry::Occupied(OccupiedEntry { map: BTreeMap { t: self.t }, node: n, idx: i }),
            None => Entry::Vacant(VacantEntry { map: BTreeMap { t: self.t }, key }),
        }
    }

    pub fn first_entry(&mut self) -> Option<OccupiedEntry<K, V>> {
        let mut n = self.t.root?;
        while !n.is_leaf() { n = n.edge(0); }
        Some(OccupiedEntry { map: BTreeMap { t: self.t }, node: n, idx: 0 })
    }

    pub fn last_entry(&mut self) -> Option<OccupiedEntry<K, V>> {
        let mut n = self.t.root?;
        while !n.is_leaf() { n = n.edge(n.len); }
        Some(OccupiedEntry { map: BTreeMap { t: self.t }, node: n, idx: n.len - 1 })
    }

    /// The entries with keys in range, in order.
    #[track_caller]
    pub fn range<R: RangeBounds<K>>(&self, range: R) -> Range<K, V> {
        Range { w: Walk::range(self.t, range.start_bound(), range.end_bound()) }
    }

    #[track_caller]
    pub fn range_mut<R: RangeBounds<K>>(&mut self, range: R) -> RangeMut<K, V> {
        RangeMut { w: Walk::range(self.t, range.start_bound(), range.end_bound()) }
    }

    /// Keeps the entries for which f returns true.
    pub fn retain(&mut self, f: fn(&K, &mut V) -> bool) {
        let mut gone: Vec<K> = Vec::new();
        for (k, v) in self.iter_mut() {
            if !f(k, v) { gone.push(*k); }
        }
        for k in gone.iter() { self.remove(k); }
    }

    /// Moves all the entries of other into this map, leaving other empty.
    pub fn append(&mut self, other: &mut BTreeMap<K, V>) {
        if same_tree(self.t, other.t) { return; }
        for (k, v) in other.iter() { self.insert(*k, *v); }
        other.clear();
    }

    /// Splits off the entries with keys from key on into a new map.
    pub fn split_off(&mut self, key: &K) -> BTreeMap<K, V> {
        let mut out = BTreeMap::new();
        let mut moved: Vec<K> = Vec::new();
        for (k, v) in self.range(*key..) {
            out.insert(*k, *v);
            moved.push(*k);
        }
        for k in moved.iter() { self.remove(k); }
        out
    }
}

fn same_tree<K, V>(a: &Tree<K, V>, b: &Tree<K, V>) -> bool {
    (a as *const Tree<K, V>) == (b as *const Tree<K, V>)
}

/// A view into a single entry of a map, vacant or occupied.
pub enum Entry<K, V> {
    Vacant(VacantEntry<K, V>),
    Occupied(OccupiedEntry<K, V>),
}

pub struct VacantEntry<K, V> {
    map: BTreeMap<K, V>,
    key: K,
}

pub struct OccupiedEntry<K, V> {
    map: BTreeMap<K, V>,
    node: &mut Node<K, V>,
    idx: usize,
}

impl<K: Ord, V> Entry<K, V> {
    pub fn or_insert(self, default: V) -> &mut V {
        match self { Entry::Occupied(e) => e.into_mut(), Entry::Vacant(e) => e.insert(default) }
    }
    pub fn or_insert_with(self, f: fn() -> V) -> &mut V {
        match self { Entry::Occupied(e) => e.into_mut(), Entry::Vacant(e) => e.insert(f()) }
    }
    pub fn or_insert_with_key(self, f: fn(&K) -> V) -> &mut V {
        match self {
            Entry::Occupied(e) => e.into_mut(),
            Entry::Vacant(e) => { let v = f(&e.key); e.insert(v) }
        }
    }
    pub fn and_modify(self, f: fn(&mut V)) -> Entry<K, V> {
        match self {
            Entry::Occupied(e) => { f(e.get_mut()); Entry::Occupied(e) }
            Entry::Vacant(e) => Entry::Vacant(e),
        }
    }
    pub fn key(&self) -> &K {
        match self { Entry::Occupied(e) => e.key(), Entry::Vacant(e) => e.key() }
    }
}

impl<K: Ord, V: Default> Entry<K, V> {
    pub fn or_default(self) -> &mut V {
        match self { Entry::Occupied(e) => e.into_mut(), Entry::Vacant(e) => e.insert(V::default()) }
    }
}

impl<K: Ord, V> VacantEntry<K, V> {
    pub fn key(&self) -> &K { &self.key }
    pub fn into_key(self) -> K { self.key }
    pub fn insert(self, value: V) -> &mut V {
        let mut m = self.map;
        let (n, i, _) = m.insert_at(self.key, value);
        &mut n.vals[i]
    }
}

impl<K: Ord, V> OccupiedEntry<K, V> {
    pub fn key(&self) -> &K { &self.node.keys[self.idx] }
    pub fn get(&self) -> &V { &self.node.vals[self.idx] }
    pub fn get_mut(&mut self) -> &mut V { &mut self.node.vals[self.idx] }
    pub fn into_mut(self) -> &mut V { &mut self.node.vals[self.idx] }
    /// Replaces the value, returning the old one.
    pub fn insert(&mut self, value: V) -> V { crate::mem::replace(&mut self.node.vals[self.idx], value) }
    pub fn remove(self) -> V { self.remove_entry().1 }
    pub fn remove_entry(self) -> (K, V) {
        let k = self.node.keys[self.idx];
        let mut m = self.map;
        m.remove_entry(&k).unwrap()
    }
}

// A stack of nodes and indexes leading to an entry.
struct Frame<K, V> {
    n: &mut Node<K, V>,
    i: usize,
}

// A double-ended walk over entries: front's top frame is at the next entry
// from the front (n.keys[i]); back's at the next from the back
// (n.keys[i - 1]). The walk ends when they have met.
struct Walk<K, V> {
    front: Vec<Frame<K, V>>,
    back: Vec<Frame<K, V>>,
    done: bool,
}

impl<K, V> Walk<K, V> {
    fn all(t: &Tree<K, V>) -> Walk<K, V> {
        let mut w = Walk { front: Vec::new(), back: Vec::new(), done: true };
        if let Some(root) = t.root {
            if root.len > 0 {
                down_front(&mut w.front, root, 0);
                down_back(&mut w.back, root, root.len);
                w.done = false;
            }
        }
        w
    }

    // The node and index of the next entry from the front.
    fn next(&mut self) -> Option<(&mut Node<K, V>, usize)> {
        if self.done { return None; }
        let top = self.front[self.front.len() - 1];
        let n = top.n;
        let i = top.i;
        let b = self.back[self.back.len() - 1];
        if same(n, b.n) && i + 1 == b.i {
            self.done = true;
            return Some((n, i));
        }
        let last = self.front.len() - 1;
        self.front[last].i = i + 1;
        if !n.is_leaf() { down_front(&mut self.front, n.edge(i + 1), 0); }
        while self.front[self.front.len() - 1].i == self.front[self.front.len() - 1].n.len { self.front.pop(); }
        Some((n, i))
    }

    fn next_back(&mut self) -> Option<(&mut Node<K, V>, usize)> {
        if self.done { return None; }
        let top = self.back[self.back.len() - 1];
        let n = top.n;
        let i = top.i - 1;
        let f = self.front[self.front.len() - 1];
        if same(n, f.n) && i == f.i {
            self.done = true;
            return Some((n, i));
        }
        let last = self.back.len() - 1;
        self.back[last].i = i;
        if !n.is_leaf() { let c = n.edge(i); down_back(&mut self.back, c, c.len); }
        while self.back[self.back.len() - 1].i == 0 { self.back.pop(); }
        Some((n, i))
    }
}

// Pushes n at i, then the leftmost path below edge i.
fn down_front<K, V>(st: &mut Vec<Frame<K, V>>, n: &mut Node<K, V>, i: usize) {
    st.push(Frame { n, i });
    let mut n = n;
    while !n.is_leaf() {
        n = n.edge(0);
        st.push(Frame { n, i: 0 });
    }
}

// Pushes n at i, then the rightmost path below n.
fn down_back<K, V>(st: &mut Vec<Frame<K, V>>, n: &mut Node<K, V>, i: usize) {
    st.push(Frame { n, i });
    let mut n = n;
    while !n.is_leaf() {
        n = n.edge(n.len);
        st.push(Frame { n, i: n.len });
    }
}

impl<K: Ord, V> Walk<K, V> {
    #[track_caller]
    fn range(t: &Tree<K, V>, lo: Bound<&K>, hi: Bound<&K>) -> Walk<K, V> {
        match (lo, hi) {
            (Bound::Included(a), Bound::Included(b)) => { if a > b { panic("range start is greater than range end in BTreeMap"); } }
            (Bound::Included(a), Bound::Excluded(b)) => { if a > b { panic("range start is greater than range end in BTreeMap"); } }
            (Bound::Excluded(a), Bound::Included(b)) => { if a > b { panic("range start is greater than range end in BTreeMap"); } }
            (Bound::Excluded(a), Bound::Excluded(b)) => {
                if a > b { panic("range start is greater than range end in BTreeMap"); }
                if a == b { panic("range start and end are equal and excluded in BTreeMap"); }
            }
            _ => {}
        }
        let mut w = Walk { front: Vec::new(), back: Vec::new(), done: true };
        let root = match t.root { Some(r) => r, None => return w };
        // The front: the first entry at or after lo.
        let mut n = root;
        loop {
            let mut i = 0;
            let mut exact = false;
            match lo {
                Bound::Included(k) => {
                    while i < n.len {
                        match k.cmp(&n.keys[i]) {
                            Ordering::Greater => { i += 1; }
                            Ordering::Equal => { exact = true; break; }
                            Ordering::Less => break,
                        }
                    }
                }
                Bound::Excluded(k) => { while i < n.len && n.keys[i] <= *k { i += 1; } }
                Bound::Unbounded => {}
            }
            w.front.push(Frame { n, i });
            if exact || n.is_leaf() { break; }
            n = n.edge(i);
        }
        while w.front.len() > 0 && w.front[w.front.len() - 1].i == w.front[w.front.len() - 1].n.len { w.front.pop(); }
        // The back: the last entry at or before hi.
        let mut n = root;
        loop {
            let mut i = 0;
            let mut exact = false;
            match hi {
                Bound::Included(k) => {
                    while i < n.len {
                        match k.cmp(&n.keys[i]) {
                            Ordering::Greater => { i += 1; }
                            Ordering::Equal => { i += 1; exact = true; break; }
                            Ordering::Less => break,
                        }
                    }
                }
                Bound::Excluded(k) => { while i < n.len && n.keys[i] < *k { i += 1; } }
                Bound::Unbounded => { i = n.len; }
            }
            w.back.push(Frame { n, i });
            if exact || n.is_leaf() { break; }
            n = n.edge(i);
        }
        while w.back.len() > 0 && w.back[w.back.len() - 1].i == 0 { w.back.pop(); }
        if w.front.len() > 0 && w.back.len() > 0 {
            let f = w.front[w.front.len() - 1];
            let b = w.back[w.back.len() - 1];
            w.done = f.n.keys[f.i] > b.n.keys[b.i - 1];
        }
        w
    }
}

pub struct Iter<K, V> { w: Walk<K, V>, left: usize }
impl<K, V> Iterator for Iter<K, V> {
    type Item = (&K, &V);
    fn next(&mut self) -> Option<(&K, &V)> {
        let (n, i) = self.w.next()?;
        self.left -= 1;
        Some((&n.keys[i], &n.vals[i]))
    }
    fn size_hint(&self) -> (usize, Option<usize>) { (self.left, Some(self.left)) }
}
impl<K, V> DoubleEndedIterator for Iter<K, V> {
    fn next_back(&mut self) -> Option<(&K, &V)> {
        let (n, i) = self.w.next_back()?;
        self.left -= 1;
        Some((&n.keys[i], &n.vals[i]))
    }
}
impl<K, V> ExactSizeIterator for Iter<K, V> {}

pub struct IterMut<K, V> { w: Walk<K, V>, left: usize }
impl<K, V> Iterator for IterMut<K, V> {
    type Item = (&K, &mut V);
    fn next(&mut self) -> Option<(&K, &mut V)> {
        let (n, i) = self.w.next()?;
        self.left -= 1;
        Some((&n.keys[i], &mut n.vals[i]))
    }
    fn size_hint(&self) -> (usize, Option<usize>) { (self.left, Some(self.left)) }
}
impl<K, V> DoubleEndedIterator for IterMut<K, V> {
    fn next_back(&mut self) -> Option<(&K, &mut V)> {
        let (n, i) = self.w.next_back()?;
        self.left -= 1;
        Some((&n.keys[i], &mut n.vals[i]))
    }
}
impl<K, V> ExactSizeIterator for IterMut<K, V> {}

/// The by-value iterator of a BTreeMap.
pub struct IntoIter<K, V> { w: Walk<K, V>, left: usize }
impl<K, V> Iterator for IntoIter<K, V> {
    type Item = (K, V);
    fn next(&mut self) -> Option<(K, V)> {
        let (n, i) = self.w.next()?;
        self.left -= 1;
        Some((n.keys[i], n.vals[i]))
    }
    fn size_hint(&self) -> (usize, Option<usize>) { (self.left, Some(self.left)) }
}
impl<K, V> DoubleEndedIterator for IntoIter<K, V> {
    fn next_back(&mut self) -> Option<(K, V)> {
        let (n, i) = self.w.next_back()?;
        self.left -= 1;
        Some((n.keys[i], n.vals[i]))
    }
}
impl<K, V> ExactSizeIterator for IntoIter<K, V> {}

pub struct Keys<K, V> { it: Iter<K, V> }
impl<K, V> Iterator for Keys<K, V> {
    type Item = &K;
    fn next(&mut self) -> Option<&K> { match self.it.next() { Some((k, _)) => Some(k), None => None } }
    fn size_hint(&self) -> (usize, Option<usize>) { self.it.size_hint() }
}
impl<K, V> DoubleEndedIterator for Keys<K, V> {
    fn next_back(&mut self) -> Option<&K> { match self.it.next_back() { Some((k, _)) => Some(k), None => None } }
}
impl<K, V> ExactSizeIterator for Keys<K, V> {}

