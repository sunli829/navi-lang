//! A double-ended queue in a growable ring buffer. VecDeque has reference
//! semantics like Vec: copies share the buffer; use clone() for an
//! independent copy.

use crate::fmt::{self, Debug, Formatter};
use crate::ops::{Index, IndexMut};

pub struct VecDeque<T> {
    r: &mut Ring<T>,
}

// The elements are ptr[(head + i) & (cap - 1)] for i < len; cap is 0 or a
// power of two.
struct Ring<T> {
    ptr: *mut T,
    cap: usize,
    head: usize,
    len: usize,
}

impl<T> Ring<T> {
    fn slot(&self, i: usize) -> *mut T {
        unsafe { self.ptr.add((self.head + i) & (self.cap - 1)) }
    }
    fn read(&self, i: usize) -> T {
        unsafe { self.slot(i).read() }
    }
    fn write(&mut self, i: usize, v: T) {
        unsafe {
            self.slot(i).write(v);
        }
    }

    // Moves the elements into a new buffer of cap slots, from slot 0.
    fn realloc(&mut self, cap: usize) {
        let ptr = crate::rt::alloc_array::<T>(cap);
        let n = self.len;
        if n > 0 {
            let first = if self.head + n <= self.cap {
                n
            } else {
                self.cap - self.head
            };
            crate::rt::copy(unsafe { self.ptr.add(self.head) } as *const T, ptr, first);
            if first < n {
                crate::rt::copy(self.ptr as *const T, unsafe { ptr.add(first) }, n - first);
            }
        }
        self.ptr = ptr;
        self.cap = cap;
        self.head = 0;
    }
}

impl<T> VecDeque<T> {
    pub fn new() -> VecDeque<T> {
        VecDeque {
            r: &mut Ring {
                ptr: crate::ptr::null_mut(),
                cap: 0,
                head: 0,
                len: 0,
            },
        }
    }

    pub fn with_capacity(capacity: usize) -> VecDeque<T> {
        let mut d = VecDeque::new();
        d.reserve(capacity);
        d
    }

    pub fn capacity(&self) -> usize {
        self.r.cap
    }
    pub fn len(&self) -> usize {
        self.r.len
    }
    pub fn is_empty(&self) -> bool {
        self.r.len == 0
    }

    /// Makes room for at least additional more elements.
    pub fn reserve(&mut self, additional: usize) {
        let need = self.r.len + additional;
        if need <= self.r.cap {
            return;
        }
        let mut cap = if self.r.cap == 0 { 4 } else { self.r.cap * 2 };
        while cap < need {
            cap = cap * 2;
        }
        self.r.realloc(cap);
    }

    pub fn push_back(&mut self, value: T) {
        if self.r.len == self.r.cap {
            self.reserve(1);
        }
        let n = self.r.len;
        self.r.write(n, value);
        self.r.len += 1;
    }

    pub fn push_front(&mut self, value: T) {
        if self.r.len == self.r.cap {
            self.reserve(1);
        }
        self.r.head = (self.r.head + self.r.cap - 1) & (self.r.cap - 1);
        self.r.write(0, value);
        self.r.len += 1;
    }

    pub fn pop_back(&mut self) -> Option<T> {
        if self.r.len == 0 {
            return None;
        }
        self.r.len -= 1;
        Some(self.r.read(self.r.len))
    }

    pub fn pop_front(&mut self) -> Option<T> {
        if self.r.len == 0 {
            return None;
        }
        let v = self.r.read(0);
        self.r.head = (self.r.head + 1) & (self.r.cap - 1);
        self.r.len -= 1;
        Some(v)
    }

    pub fn get(&self, index: usize) -> Option<&T> {
        if index < self.r.len {
            Some(unsafe { &*self.r.slot(index) })
        } else {
            None
        }
    }

    pub fn get_mut(&mut self, index: usize) -> Option<&mut T> {
        if index < self.r.len {
            Some(unsafe { &mut *self.r.slot(index) })
        } else {
            None
        }
    }

    pub fn front(&self) -> Option<&T> {
        self.get(0)
    }
    pub fn front_mut(&mut self) -> Option<&mut T> {
        self.get_mut(0)
    }
    pub fn back(&self) -> Option<&T> {
        if self.r.len == 0 {
            None
        } else {
            self.get(self.r.len - 1)
        }
    }
    pub fn back_mut(&mut self) -> Option<&mut T> {
        if self.r.len == 0 {
            None
        } else {
            let n = self.r.len;
            self.get_mut(n - 1)
        }
    }

    pub fn iter(&self) -> Iter<T> {
        Iter {
            r: self.r,
            i: 0,
            end: self.r.len,
        }
    }
    pub fn iter_mut(&mut self) -> IterMut<T> {
        IterMut {
            r: self.r,
            i: 0,
            end: self.r.len,
        }
    }

    pub fn clear(&mut self) {
        self.r.len = 0;
        self.r.head = 0;
    }

    /// Keeps the first len elements.
    pub fn truncate(&mut self, len: usize) {
        if len < self.r.len {
            self.r.len = len;
        }
    }

    #[track_caller]
    pub fn swap(&mut self, i: usize, j: usize) {
        let n = self.r.len;
        if i >= n || j >= n {
            panic(`swap index out of bounds: the len is ${n} but the indices are ${i} and ${j}`);
        }
        let a = self.r.read(i);
        let b = self.r.read(j);
        self.r.write(i, b);
        self.r.write(j, a);
    }

    /// Inserts value at index, shifting the shorter side of the queue.
    #[track_caller]
    pub fn insert(&mut self, index: usize, value: T) {
        let n = self.r.len;
        if index > n {
            panic(`index out of bounds: the len is ${n} but the index is ${index}`);
        }
        if self.r.len == self.r.cap {
            self.reserve(1);
        }
        if index < n - index {
            self.r.head = (self.r.head + self.r.cap - 1) & (self.r.cap - 1);
            let mut i = 0;
            while i < index {
                let v = self.r.read(i + 1);
                self.r.write(i, v);
                i += 1;
            }
        } else {
            let mut i = n;
            while i > index {
                let v = self.r.read(i - 1);
                self.r.write(i, v);
                i -= 1;
            }
        }
        self.r.write(index, value);
        self.r.len += 1;
    }

    /// Removes and returns the element at index, shifting the shorter
    /// side of the queue.
    pub fn remove(&mut self, index: usize) -> Option<T> {
        let n = self.r.len;
        if index >= n {
            return None;
        }
        let v = self.r.read(index);
        if index < n - 1 - index {
            let mut i = index;
            while i > 0 {
                let w = self.r.read(i - 1);
                self.r.write(i, w);
                i -= 1;
            }
            self.r.head = (self.r.head + 1) & (self.r.cap - 1);
        } else {
            let mut i = index;
            while i + 1 < n {
                let w = self.r.read(i + 1);
                self.r.write(i, w);
                i += 1;
            }
        }
        self.r.len -= 1;
        Some(v)
    }

    /// Removes the element at index, putting the front element in its
    /// place.
    pub fn swap_remove_front(&mut self, index: usize) -> Option<T> {
        if index >= self.r.len {
            return None;
        }
        let v = self.r.read(index);
        let f = self.r.read(0);
        self.r.write(index, f);
        self.r.head = (self.r.head + 1) & (self.r.cap - 1);
        self.r.len -= 1;
        Some(v)
    }

    /// Removes the element at index, putting the back element in its
    /// place.
    pub fn swap_remove_back(&mut self, index: usize) -> Option<T> {
        let n = self.r.len;
        if index >= n {
            return None;
        }
        let v = self.r.read(index);
        let b = self.r.read(n - 1);
        self.r.write(index, b);
        self.r.len -= 1;
        Some(v)
    }

    pub fn retain(&mut self, f: fn(&T) -> bool) {
        let n = self.r.len;
        let mut w = 0;
        let mut i = 0;
        while i < n {
            let v = self.r.read(i);
            if f(&v) {
                self.r.write(w, v);
                w += 1;
            }
            i += 1;
        }
        self.r.len = w;
    }

    pub fn retain_mut(&mut self, f: fn(&mut T) -> bool) {
        let n = self.r.len;
        let mut w = 0;
        let mut i = 0;
        while i < n {
            if f(unsafe { &mut *self.r.slot(i) }) {
                let v = self.r.read(i);
                self.r.write(w, v);
                w += 1;
            }
            i += 1;
        }
        self.r.len = w;
    }

    /// Rotates the queue mid places to the left: the element at mid
    /// becomes the first. O(min(mid, len - mid)).
    #[track_caller]
    pub fn rotate_left(&mut self, mid: usize) {
        let n = self.r.len;
        if mid > n {
            panic(`rotate_left: mid (is ${mid}) should be <= len (is ${n})`);
        }
        if mid <= n - mid {
            let mut i = 0;
            while i < mid {
                let v = self.r.read(0);
                self.r.write(n, v);
                self.r.head = (self.r.head + 1) & (self.r.cap - 1);
                i += 1;
            }
        } else {
            self.rotate_back(n - mid);
        }
    }

    /// Rotates the queue k places to the right: the element at len - k
    /// becomes the first. O(min(k, len - k)).
    #[track_caller]
    pub fn rotate_right(&mut self, k: usize) {
        let n = self.r.len;
        if k > n {
            panic(`rotate_right: k (is ${k}) should be <= len (is ${n})`);
        }
        if k <= n - k {
            self.rotate_back(k);
        } else {
            self.rotate_left(n - k);
        }
    }

    // Moves the last k elements to the front, one by one.
    fn rotate_back(&mut self, k: usize) {
        let mut i = 0;
        while i < k {
            let n = self.r.len;
            let v = self.r.read(n - 1);
            self.r.head = (self.r.head + self.r.cap - 1) & (self.r.cap - 1);
            self.r.write(0, v);
            i += 1;
        }
    }

    /// Lays the elements out in one piece and returns them as a slice.
    pub fn make_contiguous(&mut self) -> &mut [T] {
        if self.r.len == 0 {
            return crate::rt::slice_from_raw_mut(self.r.ptr, 0);
        }
        if self.r.head + self.r.len > self.r.cap {
            let cap = self.r.cap;
            self.r.realloc(cap);
        }
        crate::rt::slice_from_raw_mut(unsafe { self.r.ptr.add(self.r.head) }, self.r.len)
    }

    /// The elements as two slices: the front part, then the rest.
    pub fn as_slices(&self) -> (&[T], &[T]) {
        let n = self.r.len;
        if n == 0 {
            return (
                crate::rt::slice_from_raw(self.r.ptr as *const T, 0),
                crate::rt::slice_from_raw(self.r.ptr as *const T, 0),
            );
        }
        let first = if self.r.head + n <= self.r.cap {
            n
        } else {
            self.r.cap - self.r.head
        };
        let a =
            crate::rt::slice_from_raw(unsafe { self.r.ptr.add(self.r.head) } as *const T, first);
        let b = crate::rt::slice_from_raw(self.r.ptr as *const T, n - first);
        (a, b)
    }

    pub fn as_mut_slices(&mut self) -> (&mut [T], &mut [T]) {
        let n = self.r.len;
        if n == 0 {
            return (
                crate::rt::slice_from_raw_mut(self.r.ptr, 0),
                crate::rt::slice_from_raw_mut(self.r.ptr, 0),
            );
        }
        let first = if self.r.head + n <= self.r.cap {
            n
        } else {
            self.r.cap - self.r.head
        };
        let a = crate::rt::slice_from_raw_mut(unsafe { self.r.ptr.add(self.r.head) }, first);
        let b = crate::rt::slice_from_raw_mut(self.r.ptr, n - first);
        (a, b)
    }

    /// Moves all the elements of other to the back, leaving other empty.
    pub fn append(&mut self, other: &mut VecDeque<T>) {
        let n = other.r.len;
        self.reserve(n);
        let mut i = 0;
        while i < n {
            let v = other.r.read(i);
            self.push_back(v);
            i += 1;
        }
        other.clear();
    }

    /// Splits off the elements from at on into a new queue.
    #[track_caller]
    pub fn split_off(&mut self, at: usize) -> VecDeque<T> {
        let n = self.r.len;
        if at > n {
            panic(`split_off: at (is ${at}) should be <= len (is ${n})`);
        }
        let mut out = VecDeque::with_capacity(n - at);
        let mut i = at;
        while i < n {
            out.push_back(self.r.read(i));
            i += 1;
        }
        self.r.len = at;
        out
    }
}

impl<T: PartialEq> VecDeque<T> {
    pub fn contains(&self, x: &T) -> bool {
        let n = self.r.len;
        let mut i = 0;
        while i < n {
            if unsafe { &*self.r.slot(i) } == x {
                return true;
            }
            i += 1;
        }
        false
    }
}

impl<T: Clone> VecDeque<T> {
    pub fn resize(&mut self, new_len: usize, value: T) {
        if new_len < self.r.len {
            self.truncate(new_len);
            return;
        }
        self.reserve(new_len - self.r.len);
        while self.r.len < new_len {
            self.push_back(value.clone());
        }
    }
}

pub struct Iter<T> {
    r: &Ring<T>,
    i: usize,
    end: usize,
}
impl<T> Iterator for Iter<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        if self.i >= self.end {
            return None;
        }
        let p = self.r.slot(self.i);
        self.i += 1;
        Some(unsafe { &*p })
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        let n = self.end - self.i;
        (n, Some(n))
    }
}
impl<T> DoubleEndedIterator for Iter<T> {
    fn next_back(&mut self) -> Option<&T> {
        if self.i >= self.end {
            return None;
        }
        self.end -= 1;
        Some(unsafe { &*self.r.slot(self.end) })
    }
}
impl<T> ExactSizeIterator for Iter<T> {}

pub struct IterMut<T> {
    r: &mut Ring<T>,
    i: usize,
    end: usize,
}
impl<T> Iterator for IterMut<T> {
    type Item = &mut T;
    fn next(&mut self) -> Option<&mut T> {
        if self.i >= self.end {
            return None;
        }
        let p = self.r.slot(self.i);
        self.i += 1;
        Some(unsafe { &mut *p })
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        let n = self.end - self.i;
        (n, Some(n))
    }
}
impl<T> DoubleEndedIterator for IterMut<T> {
    fn next_back(&mut self) -> Option<&mut T> {
        if self.i >= self.end {
            return None;
        }
        self.end -= 1;
        Some(unsafe { &mut *self.r.slot(self.end) })
    }
}
impl<T> ExactSizeIterator for IterMut<T> {}

/// The by-value iterator of a VecDeque.
pub struct IntoIter<T> {
    r: &Ring<T>,
    i: usize,
    end: usize,
}
impl<T> Iterator for IntoIter<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        if self.i >= self.end {
            return None;
        }
        let v = self.r.read(self.i);
        self.i += 1;
        Some(v)
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        let n = self.end - self.i;
        (n, Some(n))
    }
}
impl<T> DoubleEndedIterator for IntoIter<T> {
    fn next_back(&mut self) -> Option<T> {
        if self.i >= self.end {
            return None;
        }
        self.end -= 1;
        Some(self.r.read(self.end))
    }
}
impl<T> ExactSizeIterator for IntoIter<T> {}

impl<T> IntoIterator for VecDeque<T> {
    type Item = T;
    type IntoIter = IntoIter<T>;
    fn into_iter(self) -> IntoIter<T> {
        IntoIter {
            r: self.r,
            i: 0,
            end: self.r.len,
        }
    }
}

impl<T> IntoIterator for &VecDeque<T> {
    type Item = &T;
    type IntoIter = Iter<T>;
    fn into_iter(self) -> Iter<T> {
        self.iter()
    }
}

impl<T> IntoIterator for &mut VecDeque<T> {
    type Item = &mut T;
    type IntoIter = IterMut<T>;
    fn into_iter(self) -> IterMut<T> {
        self.iter_mut()
    }
}

impl<T> Index<usize> for VecDeque<T> {
    type Output = T;
    #[track_caller]
    fn index(&self, index: usize) -> &T {
        match self.get(index) {
            Some(v) => v,
            None => panic("Out of bounds access"),
        }
    }
}

impl<T> IndexMut<usize> for VecDeque<T> {
    #[track_caller]
    fn index_mut(&mut self, index: usize) -> &mut T {
        match self.get_mut(index) {
            Some(v) => v,
            None => panic("Out of bounds access"),
        }
    }
}

impl<T: Clone> Clone for VecDeque<T> {
    fn clone(&self) -> VecDeque<T> {
        let mut d = VecDeque::with_capacity(self.r.len);
        for x in self.iter() {
            d.push_back(x.clone());
        }
        d
    }
}

impl<T: Debug> Debug for VecDeque<T> {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        let mut l = f.debug_list();
        for x in self.iter() {
            l.entry(x);
        }
        l.finish()
    }
}

impl<T: PartialEq> PartialEq for VecDeque<T> {
    fn eq(&self, other: &VecDeque<T>) -> bool {
        let n = self.r.len;
        if n != other.r.len {
            return false;
        }
        let mut i = 0;
        while i < n {
            if unsafe { &*self.r.slot(i) } != unsafe { &*other.r.slot(i) } {
                return false;
            }
            i += 1;
        }
        true
    }
}

impl<T: Eq> Eq for VecDeque<T> {}

impl<T: crate::hash::Hash> crate::hash::Hash for VecDeque<T> {
    fn hash<H: crate::hash::Hasher>(&self, state: &mut H) {
        let (a, b) = self.as_slices();
        state.write_usize(self.r.len);
        for x in a {
            x.hash(state);
        }
        for x in b {
            x.hash(state);
        }
    }
}

impl<T> Default for VecDeque<T> {
    fn default() -> VecDeque<T> {
        VecDeque::new()
    }
}

impl<T> FromIterator<T> for VecDeque<T> {
    fn from_iter<I: IntoIterator<Item = T>>(iter: I) -> VecDeque<T> {
        let mut d = VecDeque::new();
        for x in iter {
            d.push_back(x);
        }
        d
    }
}

impl<T> Extend<T> for VecDeque<T> {
    fn extend<I: IntoIterator<Item = T>>(&mut self, iter: I) {
        for x in iter {
            self.push_back(x);
        }
    }
}

impl<T> From<Vec<T>> for VecDeque<T> {
    fn from(v: Vec<T>) -> VecDeque<T> {
        let mut d = VecDeque::with_capacity(v.len());
        for x in v {
            d.push_back(x);
        }
        d
    }
}

impl<T> From<VecDeque<T>> for Vec<T> {
    fn from(d: VecDeque<T>) -> Vec<T> {
        let mut v = Vec::with_capacity(d.len());
        for x in d {
            v.push(x);
        }
        v
    }
}
