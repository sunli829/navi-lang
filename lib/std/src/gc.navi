//! The garbage collector (navi addition; Rust has no GC). See spec/std-diff.md.

use crate::fmt;
use crate::marker::PhantomData;

/// Collector statistics.
#[derive(Clone, Debug, Default)]
pub struct Stats {
    /// Collections run so far.
    pub collections: usize,
    /// Bytes that survived the last collection.
    pub live_bytes: usize,
    /// Bytes allocated since the last collection.
    pub allocated_bytes: usize,
    /// Bytes of heap memory taken from the system and in use (as Go's
    /// `HeapSys - HeapReleased`).
    pub heap_bytes: usize,
    /// Bytes of heap memory returned to the system (as Go's `HeapReleased`).
    pub released_bytes: usize,
    /// Bytes of the spawned threads' stacks (as Go's `StackInuse`; the main
    /// thread's is fixed and not counted). A stack grows as needed and
    /// shrinks by half at a collection that finds most of it unused.
    pub stack_bytes: usize,
}

/// Runs a full collection.
pub fn collect() {
    crate::rt::gc::collect();
}

/// Runs a collection and returns as much memory to the system as possible
/// (as Go's `debug.FreeOSMemory`). The collector also does that by itself
/// after each collection, down to what the heap needs.
pub fn free_os_memory() {
    crate::rt::gc::free_os_memory();
}

/// Sets the heap size below which no collection starts (default 32 MiB);
/// programs that build large heaps quickly can trade memory for time.
pub fn set_min_heap(bytes: usize) {
    crate::rt::gc::set_min_heap(bytes);
}

/// Sets how much the heap may grow past what survived the last collection
/// before the next is done, in percent of it (default 100; as Go's
/// `debug.SetGCPercent`; `NAVI_GC=percent` sets it at start). `usize::MAX`
/// turns it off (`NAVI_GC=off`, as `GOGC=off`): then only the memory limit
/// starts a collection. Returns the previous setting.
pub fn set_percent(percent: usize) -> usize {
    crate::rt::gc::set_percent(percent)
}

/// Sets a soft limit on the memory of the heap and the stacks, in bytes (as
/// Go's `debug.SetMemoryLimit`; `NAVI_MEMLIMIT=bytes`, with a suffix `KiB`,
/// `MiB`, `GiB` or `TiB`, sets it at start): collections run as often as
/// needed to stay under it (the heap may still grow by at least 4 MiB past
/// what survives), and freed memory goes back to the system below it.
/// `usize::MAX` (the default) is no limit. Returns the previous limit.
pub fn set_memory_limit(bytes: usize) -> usize {
    crate::rt::gc::set_memory_limit(bytes)
}

/// The collector's statistics.
pub fn stats() -> Stats {
    let (collections, live_bytes, allocated_bytes) = crate::rt::gc::stats();
    let (heap_bytes, released_bytes) = crate::rt::gc::heap_bytes();
    let stack_bytes = crate::rt::sched::stack_bytes();
    Stats {
        collections,
        live_bytes,
        allocated_bytes,
        heap_bytes,
        released_bytes,
        stack_bytes,
    }
}

// A weak handle: the address it was made from, cleared when that object
// dies (the collector never scans it).
struct Handle {
    addr: usize,
}

/// A weak reference (as Go's `weak.Pointer`; Rust's `rc::Weak` without
/// the `Rc`): it does not keep its object alive, and `upgrade` gives the
/// object back while something else does. Weak references made from the
/// same reference are equal.
pub struct Weak<T> {
    handle: &Handle,
    t: PhantomData<T>,
}

impl<T> Weak<T> {
    /// A weak reference to what `value` points to (an object of the heap;
    /// one of a static never dies).
    pub fn new(value: &T) -> Weak<T> {
        let h = crate::rt::gc::weak_handle(value as *const T as usize);
        Weak {
            handle: unsafe { &*(h as *const Handle) },
            t: PhantomData,
        }
    }

    /// The object, unless it died (it lives on from here).
    pub fn upgrade(&self) -> Option<&T> {
        let a = crate::rt::gc::weak_get(self.handle as *const Handle as usize);
        if a == 0 {
            None
        } else {
            Some(unsafe { &*(a as *const T) })
        }
    }

    // The same reference, its type erased (std::unique's table).
    pub(crate) fn erase(&self) -> Weak<u8> {
        Weak {
            handle: self.handle,
            t: PhantomData,
        }
    }

    /// Whether two weak references were made from the same reference.
    pub fn ptr_eq(&self, other: &Weak<T>) -> bool {
        crate::ptr::eq(self.handle, other.handle)
    }
}

impl<T> Clone for Weak<T> {
    fn clone(&self) -> Weak<T> {
        Weak {
            handle: self.handle,
            t: PhantomData,
        }
    }
}

impl<T> PartialEq for Weak<T> {
    fn eq(&self, other: &Weak<T>) -> bool {
        self.ptr_eq(other)
    }
}

impl<T> fmt::Debug for Weak<T> {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        f.write_str("(Weak)")
    }
}

/// A registered cleanup (`add_cleanup`).
pub struct Cleanup {
    id: usize,
}

impl Cleanup {
    /// Cancels the cleanup if it has not been queued to run.
    pub fn stop(&self) {
        crate::rt::gc::stop_cleanup(self.id);
    }
}

/// Calls `cleanup(arg)` some time after the object `value` points to has
/// become unreachable (as Go's `runtime.AddCleanup`), on a thread that
/// runs the cleanups one after another. `arg` and `cleanup` must not
/// reach the object (it would never become unreachable). Not run if the
/// program exits first.
pub fn add_cleanup<T, A>(value: &T, cleanup: fn(A), arg: A) -> Cleanup {
    let run: fn() = || cleanup(arg);
    Cleanup {
        id: crate::rt::gc::add_cleanup(value as *const T as usize, run),
    }
}
