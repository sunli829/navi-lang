//! The garbage collector (navi addition; Rust has no GC). See spec/std-diff.md.

/// Collector statistics.
#[derive(Clone, Debug, Default)]
pub struct Stats {
    /// Collections run so far.
    pub collections: usize,
    /// Bytes that survived the last collection.
    pub live_bytes: usize,
    /// Bytes allocated since the last collection.
    pub allocated_bytes: usize,
}

/// Runs a full collection.
pub fn collect() { crate::rt::gc::collect(); }

/// The collector's statistics.
pub fn stats() -> Stats {
    let (collections, live_bytes, allocated_bytes) = crate::rt::gc::stats();
    Stats { collections, live_bytes, allocated_bytes }
}
