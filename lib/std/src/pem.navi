//! Reading and writing PEM (RFC 7468), with the API of Rust's `pem` crate.
//!
//! A PEM block is binary data (a certificate, a key) as base64 between
//! `-----BEGIN <tag>-----` and `-----END <tag>-----` lines. [`parse`] and
//! [`parse_many`] read blocks into [`Pem`] values; [`encode`] and
//! [`encode_many`] write them.
//!
//! Text outside the blocks is ignored (as in the crate and Go's
//! `encoding/pem`); RFC 1421 headers (`Proc-Type: ...`) are skipped, not
//! kept.
//!
//! # Examples
//!
//! ```
//! use std::pem;
//!
//! let mut bundle = String::from("Two blocks:\n");
//! bundle.push_str("-----BEGIN CERTIFICATE-----\nAQID\n-----END CERTIFICATE-----\n");
//! bundle.push_str("-----BEGIN PRIVATE KEY-----\nBAUG\n-----END PRIVATE KEY-----\n");
//! let blocks = pem::parse_many(bundle).unwrap();
//! assert_eq(blocks.len(), 2);
//! assert_eq(blocks[0].tag(), "CERTIFICATE");
//! assert_eq(blocks[0].contents(), b"\x01\x02\x03");
//! assert_eq(blocks[1].tag(), "PRIVATE KEY");
//! ```

use crate::{
    base64::prelude::*,
    fmt::{self, Display, Formatter},
};

/// The error returned when PEM input cannot be read.
///
/// # Examples
///
/// ```
/// use std::pem::{self, PemError};
///
/// assert_eq(pem::parse("no PEM here"), Err(PemError::MissingBeginTag));
/// let e = pem::parse("-----BEGIN A-----\nAQID\n-----END B-----\n").unwrap_err();
/// assert_eq(
///     e,
///     PemError::MismatchedTags("A".to_string(), "B".to_string()),
/// );
/// assert_eq(
///     e.to_string(),
///     "mismatching BEGIN (\"A\") and END (\"B\") tags",
/// );
/// ```
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum PemError {
    /// The input has no `-----BEGIN <tag>-----` line.
    MissingBeginTag,
    /// A BEGIN line has no END line after it.
    MissingEndTag,
    /// The END line's tag (the second field) is not the BEGIN line's (the
    /// first).
    MismatchedTags(String, String),
    /// The body between the lines is not valid base64.
    InvalidData(crate::base64::DecodeError),
}

impl Display for PemError {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        match self {
            PemError::MissingBeginTag => f.write_str("missing BEGIN tag"),
            PemError::MissingEndTag => f.write_str("missing END tag"),
            PemError::MismatchedTags(a, b) => {
                f.write_fmt(`mismatching BEGIN (\"${a}\") and END (\"${b}\") tags`)
            }
            PemError::InvalidData(e) => f.write_fmt(`invalid data: ${e}`),
        }
    }
}

/// A PEM block: its tag (such as `"CERTIFICATE"`) and its decoded
/// contents.
///
/// # Examples
///
/// ```
/// use std::pem::{self, Pem};
///
/// let p = Pem::new("DATA", Vec::from([1u8, 2, 3]));
/// assert_eq(
///     pem::encode(&p),
///     "-----BEGIN DATA-----\r\nAQID\r\n-----END DATA-----\r\n",
/// );
/// assert_eq(pem::parse(pem::encode(&p)).unwrap(), p);
/// ```
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct Pem {
    tag: String,
    contents: Vec<u8>,
}

impl Pem {
    /// Creates a block with the given tag and contents.
    pub fn new(tag: &str, contents: Vec<u8>) -> Pem {
        Pem {
            tag: tag.to_string(),
            contents,
        }
    }

    /// Returns the block's tag, the text after `BEGIN ` (such as
    /// `"CERTIFICATE"`).
    pub fn tag(&self) -> &str {
        self.tag.as_str()
    }

    /// Returns the block's decoded contents.
    pub fn contents(&self) -> &[u8] {
        self.contents.as_slice()
    }

    /// Consumes the block, returning its decoded contents.
    ///
    /// # Examples
    ///
    /// ```
    /// let p = std::pem::Pem::new("DATA", Vec::from([1u8, 2]));
    /// assert_eq(p.into_contents(), Vec::from([1u8, 2]));
    /// ```
    pub fn into_contents(self) -> Vec<u8> {
        self.contents
    }
}

// The tag of a "-----BEGIN x-----" (or END) line.
fn boundary(line: &str, kind: &str) -> Option<String> {
    let l = line.trim_end();
    let pre = `-----${kind} `.to_string();
    if !l.starts_with(pre.as_str()) || !l.ends_with("-----") || l.len() < pre.len() + 5 {
        return None;
    }
    Some(l[pre.len()..l.len() - 5].to_string())
}

// The next block from lines[*i..], moving *i past it.
fn next_block(lines: &[&str], i: &mut usize) -> Option<Result<Pem, PemError>> {
    while *i < lines.len() {
        let line = lines[*i];
        *i += 1;
        let tag = match boundary(line, "BEGIN") {
            Some(t) => t,
            None => continue,
        };
        let mut body = String::new();
        let mut in_headers = true;
        while *i < lines.len() {
            let l = lines[*i].trim();
            *i += 1;
            if let Some(end) = boundary(l, "END") {
                if end != tag {
                    return Some(Err(PemError::MismatchedTags(tag, end)));
                }
                return Some(match BASE64_STANDARD.decode(body.as_str()) {
                    Ok(c) => Ok(Pem { tag, contents: c }),
                    Err(e) => Err(PemError::InvalidData(e)),
                });
            }
            // Headers come first, up to a blank line.
            if in_headers && l.contains(":") {
                continue;
            }
            in_headers = false;
            body.push_str(l);
        }
        return Some(Err(PemError::MissingEndTag));
    }
    None
}

/// Parses the first PEM block in `input`.
///
/// Text before the block and anything after it are ignored.
///
/// # Errors
///
/// [`PemError::MissingBeginTag`] if `input` has no block, and the other
/// [`PemError`]s if the first block is malformed.
///
/// # Examples
///
/// ```
/// use std::pem;
///
/// let text = "-----BEGIN MESSAGE-----\naGVsbG8=\n-----END MESSAGE-----\n";
/// let p = pem::parse(text).unwrap();
/// assert_eq(p.tag(), "MESSAGE");
/// assert_eq(p.contents(), b"hello");
/// ```
pub fn parse<B: AsRef<[u8]>>(input: B) -> Result<Pem, PemError> {
    let text = String::from_utf8_lossy(input.as_ref());
    let lines: Vec<&str> = text.lines().collect();
    let mut i = 0;
    match next_block(&lines, &mut i) {
        Some(r) => r,
        None => Err(PemError::MissingBeginTag),
    }
}

/// Parses every PEM block in `input`, in order.
///
/// The result is empty if `input` has no blocks.
///
/// # Errors
///
/// The first block that is malformed (see [`PemError`]) makes it fail.
///
/// # Examples
///
/// ```
/// use std::pem::{self, Pem};
///
/// let text = pem::encode_many(&[
///     Pem::new("A", Vec::from([1u8])),
///     Pem::new("B", Vec::from([2u8])),
/// ]);
/// let blocks = pem::parse_many(text).unwrap();
/// assert_eq(blocks.len(), 2);
/// assert_eq(blocks[1].tag(), "B");
/// assert(pem::parse_many("nothing").unwrap().is_empty());
/// ```
pub fn parse_many<B: AsRef<[u8]>>(input: B) -> Result<Vec<Pem>, PemError> {
    let text = String::from_utf8_lossy(input.as_ref());
    let lines: Vec<&str> = text.lines().collect();
    let mut i = 0;
    let mut out: Vec<Pem> = Vec::new();
    while let Some(r) = next_block(&lines, &mut i) {
        out.push(r?);
    }
    Ok(out)
}

/// Encodes a block as PEM text: 64 base64 characters a line, with `"\r\n"`
/// line ends (as the crate's default).
///
/// # Examples
///
/// ```
/// use std::pem::{self, Pem};
///
/// let text = pem::encode(&Pem::new("MESSAGE", Vec::from(b"hello")));
/// assert_eq(
///     text,
///     "-----BEGIN MESSAGE-----\r\naGVsbG8=\r\n-----END MESSAGE-----\r\n",
/// );
/// ```
pub fn encode(pem: &Pem) -> String {
    let b = BASE64_STANDARD.encode(pem.contents.as_slice());
    let mut out = `-----BEGIN ${pem.tag}-----\r\n`.to_string();
    let mut i = 0;
    while i < b.len() {
        let end = if i + 64 < b.len() { i + 64 } else { b.len() };
        out.push_str(&b[i..end]);
        out.push_str("\r\n");
        i = end;
    }
    out.push_str(`-----END ${pem.tag}-----\r\n`.to_string().as_str());
    out
}

/// Encodes every block as PEM text, one after the other (see [`encode`]).
pub fn encode_many(pems: &[Pem]) -> String {
    let mut out = String::new();
    for p in pems.iter() {
        out.push_str(encode(p).as_str());
    }
    out
}
