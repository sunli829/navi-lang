//! Canonical values (as Go's `unique` package; Rust's std has none): equal
//! values made into handles get the same handle, which compares and hashes
//! by address. The table holds the values weakly (std::gc::Weak): a value
//! no handle refers to any more goes when it is collected, and its entry
//! with it (std::gc::add_cleanup). See spec/std-diff.md.
//!
//! Interning values this way saves memory when many equal values are
//! kept (each is stored once), and makes comparing them cheap.
//!
//! # Examples
//!
//! ```
//! use std::unique::Handle;
//!
//! let a = Handle::new("hello".to_string());
//! let b = Handle::new(`hel${"lo"}`.to_string());
//! let c = Handle::new("world".to_string());
//! assert(a == b); // one comparison of addresses
//! assert(a != c);
//! assert_eq(a.value(), "hello");
//! ```

use crate::collections::HashMap;
use crate::fmt;
use crate::gc::{self, Weak};
use crate::hash::{DefaultHasher, Hash, Hasher};
use crate::sync::Mutex;

/// The handle of a canonical value: equal values give equal handles (the
/// same address), so comparing two is one comparison of addresses.
///
/// Handles are cheap to copy. `==` and [`Hash`] use the address only, so
/// handles make fast keys for a [`HashMap`]; [`Handle::value`] gives the
/// value back.
///
/// # Examples
///
/// ```
/// use std::collections::HashMap;
/// use std::unique::Handle;
///
/// let mut counts: HashMap<Handle<String>, i32> = HashMap::new();
/// for w in "a b a c a".split(' ') {
///     let h = Handle::new(w.to_string());
///     match counts.get_mut(&h) {
///         Some(n) => *n += 1,
///         None => { counts.insert(h, 1); }
///     }
/// }
/// assert_eq(counts[&Handle::new("a".to_string())], 3);
/// ```
pub struct Handle<T> {
    v: &T,
}

// The table: (the type's descriptor, the value's hash) to weak references
// to the values (of that type) with that hash.
static mut TABLE: Option<&Mutex<HashMap<(usize, u64), Vec<Weak<u8>>>>> = None;
static mut INIT: usize = 0;

fn table() -> &Mutex<HashMap<(usize, u64), Vec<Weak<u8>>>> {
    // (Made once: the first G to get here, the others wait.)
    if crate::rt::sched::word_load(&mut INIT as *mut usize) != 2 {
        if crate::rt::sched::word_cas(&mut INIT as *mut usize, 0, 1) {
            TABLE = Some(&Mutex::new(HashMap::new()));
            crate::rt::sched::word_store(&mut INIT as *mut usize, 2);
        } else {
            while crate::rt::sched::word_load(&mut INIT as *mut usize) != 2 {
                crate::thread::yield_now();
            }
        }
    }
    TABLE.unwrap()
}

impl<T> Handle<T>
where
    T: Eq + Hash + Clone,
{
    /// Returns the handle of `value`: the same as that of any equal value
    /// made into a handle before (and still referred to).
    ///
    /// The first time a value is seen, a copy of it (`value.clone()`) is
    /// stored and becomes the canonical value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::unique::Handle;
    ///
    /// let a = Handle::new((1, 2));
    /// let b = Handle::new((1, 2));
    /// assert(a == b);
    /// assert(std::ptr::eq(a.value(), b.value()));
    /// ```
    pub fn new(value: T) -> Handle<T> {
        let ty = crate::intrinsics::type_desc::<T>() as usize;
        let mut h = DefaultHasher::new();
        value.hash(&mut h);
        let key = (ty, h.finish());
        let t = table();
        let m = t.lock();
        if let Some(list) = m.get(&key) {
            for w in list.iter() {
                if let Some(p) = w.upgrade() {
                    let r = unsafe { &*(p as *const u8 as *const T) };
                    if *r == value {
                        t.unlock();
                        return Handle { v: r };
                    }
                }
            }
        }
        let r: &T = &value.clone();
        let w = Weak::new(r).erase();
        match m.get_mut(&key) {
            Some(list) => list.push(w),
            None => {
                let mut list = Vec::new();
                list.push(w);
                m.insert(key, list);
            }
        }
        t.unlock();
        // Once the value is collected, its entry goes.
        gc::add_cleanup(r, |k: (usize, u64)| prune(k), key);
        Handle { v: r }
    }
}

impl<T> Handle<T> {
    /// Returns the canonical value the handle refers to.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::unique::Handle;
    ///
    /// let h = Handle::new(Vec::from([1, 2, 3]));
    /// assert_eq(h.value().len(), 3);
    /// ```
    pub fn value(&self) -> &T {
        self.v
    }
}

// Drops the references to collected values under key.
fn prune(key: (usize, u64)) {
    let t = table();
    let m = t.lock();
    let mut empty = false;
    if let Some(list) = m.get_mut(&key) {
        list.retain(|w: &Weak<u8>| w.upgrade().is_some());
        empty = list.len() == 0;
    }
    if empty {
        m.remove(&key);
    }
    t.unlock();
}

impl<T> Clone for Handle<T> {
    fn clone(&self) -> Handle<T> {
        Handle { v: self.v }
    }
}

impl<T> PartialEq for Handle<T> {
    fn eq(&self, other: &Handle<T>) -> bool {
        crate::ptr::eq(self.v, other.v)
    }
}

impl<T> Eq for Handle<T> {}

impl<T> Hash for Handle<T> {
    fn hash<H: Hasher>(&self, state: &mut H) {
        (self.v as *const T as usize).hash(state);
    }
}

impl<T> fmt::Debug for Handle<T>
where
    T: fmt::Debug,
{
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        f.debug_tuple("Handle").field(self.v).finish()
    }
}
