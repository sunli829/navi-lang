//! The parser: pattern text to Hir, a tree in which flags are applied
//! (case folding is done, `.` is a class, `^` and `$` are resolved).

use super::Error;
use super::class::{self, CharSet};

pub const INF: u32 = u32::MAX;

#[derive(Clone, Debug)]
pub enum Hir {
    Empty,
    Lit(u32),
    Class(CharSet),
    Look(Look),
    /// A capture group and its index.
    Capture(&Hir, usize),
    Concat(Vec<Hir>),
    Alt(Vec<Hir>),
    /// sub, min, max (INF: unbounded), greedy.
    Repeat(&Hir, u32, u32, bool),
}

/// Zero-width assertions; the bool is true for ASCII-only word chars.
#[derive(Clone, Debug, PartialEq)]
pub enum Look {
    Start,
    End,
    StartLine,
    EndLine,
    Word(bool),
    NotWord(bool),
    WordStart(bool),
    WordEnd(bool),
    WordStartHalf(bool),
    WordEndHalf(bool),
}

#[derive(Clone)]
pub struct Flags {
    pub i: bool,
    pub m: bool,
    pub s: bool,
    pub x: bool,
    pub swap_greed: bool,
    pub unicode: bool,
}

pub struct Parsed {
    pub hir: Hir,
    /// The names of the capture groups by index (group 0 has none).
    pub names: Vec<Option<String>>,
}

fn bx(h: Hir) -> &Hir {
    &h
}

enum Esc {
    Char(u32),
    Class(CharSet),
    Look(Look),
}

struct Parser {
    pattern: &str,
    p: Vec<char>,
    pos: usize,
    flags: Flags,
    names: Vec<Option<String>>,
    depth: u32,
    nest_limit: u32,
    octal: bool,
}

pub fn parse(pattern: &str, flags: &Flags, nest_limit: u32, octal: bool) -> Result<Parsed, Error> {
    let mut names: Vec<Option<String>> = Vec::new();
    names.push(None);
    let mut p = Parser {
        pattern,
        p: pattern.chars().collect(),
        pos: 0,
        flags: flags.clone(),
        names,
        depth: 0,
        nest_limit,
        octal,
    };
    let hir = p.parse_alt()?;
    if p.pos < p.p.len() {
        return p.err("unopened group", p.pos, p.pos + 1);
    }
    Ok(Parsed {
        hir,
        names: p.names,
    })
}

fn is_space(c: char) -> bool {
    c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\u{B}' || c == '\u{C}'
}

impl Parser {
    // A syntax error over the chars start..end, shown under the pattern.
    fn err<T>(&self, msg: &str, start: usize, end: usize) -> Result<T, Error> {
        let mut line_start = 0;
        let mut line_no = 1;
        let mut multi = false;
        let mut i = 0;
        while i < self.p.len() {
            if self.p[i] == '\n' {
                multi = true;
                if i < start {
                    line_start = i + 1;
                    line_no += 1;
                }
            }
            i += 1;
        }
        let mut line = String::new();
        let mut j = line_start;
        while j < self.p.len() && self.p[j] != '\n' {
            line.push(self.p[j]);
            j += 1;
        }
        let mut marks = String::new();
        let mut k = line_start;
        while k < start {
            marks.push(' ');
            k += 1;
        }
        let stop = if end > start { end } else { start + 1 };
        while k < stop && (k >= self.p.len() || self.p[k] != '\n') {
            marks.push('^');
            k += 1;
        }
        let at = if multi {
            `${line_no}: `.to_string()
        } else {
            String::new()
        };
        let pad = " ".repeat(at.len());
        Err(Error::Syntax(
            `regex parse error:\n    ${at}${line}\n    ${pad}${marks}\nerror: ${msg}`.to_string(),
        ))
    }

    fn peek(&self) -> Option<char> {
        if self.pos < self.p.len() {
            Some(self.p[self.pos])
        } else {
            None
        }
    }

    fn peek_at(&self, k: usize) -> Option<char> {
        if self.pos + k < self.p.len() {
            Some(self.p[self.pos + k])
        } else {
            None
        }
    }

    fn is(&self, c: char) -> bool {
        self.pos < self.p.len() && self.p[self.pos] == c
    }

    fn eat(&mut self, c: char) -> bool {
        if self.is(c) {
            self.pos += 1;
            true
        } else {
            false
        }
    }

    // In x mode, whitespace and # comments between items are ignored.
    fn skip_space(&mut self) {
        if !self.flags.x {
            return;
        }
        while self.pos < self.p.len() {
            let c = self.p[self.pos];
            if is_space(c) {
                self.pos += 1;
            } else if c == '#' {
                while self.pos < self.p.len() && self.p[self.pos] != '\n' {
                    self.pos += 1;
                }
            } else {
                break;
            }
        }
    }

    fn enter(&mut self, start: usize) -> Result<(), Error> {
        self.depth += 1;
        if self.depth > self.nest_limit {
            return self.err("exceed the maximum nest depth", start, start + 1);
        }
        Ok(())
    }

    fn parse_alt(&mut self) -> Result<Hir, Error> {
        let mut alts: Vec<Hir> = Vec::new();
        loop {
            alts.push(self.parse_concat()?);
            if !self.eat('|') {
                break;
            }
        }
        if alts.len() == 1 {
            Ok(alts.pop().unwrap())
        } else {
            Ok(Hir::Alt(alts))
        }
    }

    fn parse_concat(&mut self) -> Result<Hir, Error> {
        let mut items: Vec<Hir> = Vec::new();
        loop {
            self.skip_space();
            match self.peek() {
                None | Some('|') | Some(')') => break,
                _ => {}
            }
            let start = self.pos;
            let Some(atom) = self.parse_atom()? else {
                continue;
            };
            let h = self.parse_repeats(atom, start)?;
            match h {
                Hir::Concat(xs) => items.extend_from_slice(xs.as_slice()),
                Hir::Empty => {}
                _ => items.push(h),
            }
        }
        if items.len() == 0 {
            return Ok(Hir::Empty);
        }
        if items.len() == 1 {
            return Ok(items.pop().unwrap());
        }
        Ok(Hir::Concat(items))
    }

    fn lit(&self, c: u32) -> Hir {
        if self.flags.i {
            let s = class::fold_char(c, self.flags.unicode);
            if s.single().is_none() {
                return Hir::Class(s);
            }
        }
        Hir::Lit(c)
    }

    fn parse_atom(&mut self) -> Result<Option<Hir>, Error> {
        let start = self.pos;
        let c = self.p[self.pos];
        match c {
            '(' => self.parse_group(),
            '[' => {
                let s = self.parse_class()?;
                Ok(Some(Hir::Class(s)))
            }
            '.' => {
                self.pos += 1;
                let s = if self.flags.s {
                    CharSet::all()
                } else {
                    CharSet::range(10, 10).negate()
                };
                Ok(Some(Hir::Class(s)))
            }
            '^' => {
                self.pos += 1;
                Ok(Some(Hir::Look(if self.flags.m {
                    Look::StartLine
                } else {
                    Look::Start
                })))
            }
            '$' => {
                self.pos += 1;
                Ok(Some(Hir::Look(if self.flags.m {
                    Look::EndLine
                } else {
                    Look::End
                })))
            }
            '\\' => match self.parse_escape(false)? {
                Esc::Char(c) => Ok(Some(self.lit(c))),
                Esc::Class(s) => Ok(Some(Hir::Class(s))),
                Esc::Look(l) => Ok(Some(Hir::Look(l))),
            },
            '*' | '+' | '?' | '{' => {
                self.err("repetition operator missing expression", start, start + 1)
            }
            _ => {
                self.pos += 1;
                Ok(Some(self.lit(c as u32)))
            }
        }
    }

    fn parse_repeats(&mut self, atom: Hir, start: usize) -> Result<Hir, Error> {
        let mut h = atom;
        let mut nested = 0u32;
        loop {
            self.skip_space();
            let op = self.pos;
            let (min, max) = match self.peek() {
                Some('*') => {
                    self.pos += 1;
                    (0, INF)
                }
                Some('+') => {
                    self.pos += 1;
                    (1, INF)
                }
                Some('?') => {
                    self.pos += 1;
                    (0, 1)
                }
                Some('{') => self.parse_counted()?,
                _ => break,
            };
            let mut greedy = true;
            if self.eat('?') {
                greedy = false;
            }
            if self.flags.swap_greed {
                greedy = !greedy;
            }
            nested += 1;
            if self.depth + nested > self.nest_limit {
                return self.err("exceed the maximum nest depth", op, self.pos);
            }
            h = Hir::Repeat(bx(h), min, max, greedy);
        }
        Ok(h)
    }

    fn parse_decimal(&mut self) -> Result<u32, Error> {
        self.skip_space();
        let start = self.pos;
        let mut n: u64 = 0;
        while let Some(c) = self.peek()
            && c >= '0'
            && c <= '9'
        {
            n = n * 10 + (c as u64 - '0' as u64);
            if n > u32::MAX as u64 - 1 {
                return self.err("decimal literal invalid", start, self.pos + 1);
            }
            self.pos += 1;
        }
        if self.pos == start {
            if self.pos >= self.p.len() {
                return self.err("unclosed counted repetition", start, start);
            }
            return self.err(
                "repetition quantifier expects a valid decimal",
                start,
                start + 1,
            );
        }
        self.skip_space();
        Ok(n as u32)
    }

    // {n}, {n,} or {n,m}; at '{'.
    fn parse_counted(&mut self) -> Result<(u32, u32), Error> {
        let start = self.pos;
        self.pos += 1;
        let min = self.parse_decimal()?;
        let mut max = min;
        if self.eat(',') {
            self.skip_space();
            max = if self.is('}') {
                INF
            } else {
                self.parse_decimal()?
            };
        }
        if !self.eat('}') {
            return self.err("unclosed counted repetition", start, self.pos);
        }
        if min > max {
            return self.err(
                "invalid repetition count range, the start must be <= the end",
                start,
                self.pos,
            );
        }
        Ok((min, max))
    }

    fn parse_group(&mut self) -> Result<Option<Hir>, Error> {
        let open = self.pos;
        self.pos += 1;
        let mut name: Option<String> = None;
        if self.eat('?') {
            let c = self.peek();
            if c == Some('P') && self.peek_at(1) == Some('<') {
                self.pos += 2;
                name = Some(self.parse_name(open)?);
            } else if c == Some('P')
                && (self.peek_at(1) == Some('=') || self.peek_at(1) == Some('>'))
            {
                return self.err("backreferences are not supported", open, self.pos + 2);
            } else if c == Some('<') && self.peek_at(1) != Some('=') && self.peek_at(1) != Some('!')
            {
                self.pos += 1;
                name = Some(self.parse_name(open)?);
            } else if c == Some('=') || c == Some('!') || c == Some('<') {
                return self.err(
                    "look-around, including look-ahead and look-behind, is not supported",
                    open,
                    self.pos + 1,
                );
            } else {
                return self.parse_flags(open);
            }
        }
        self.enter(open)?;
        let index = self.names.len();
        self.names.push(name);
        let saved = self.flags.clone();
        let sub = self.parse_alt()?;
        self.flags = saved;
        if !self.eat(')') {
            return self.err("unclosed group", open, open + 1);
        }
        self.depth -= 1;
        Ok(Some(Hir::Capture(bx(sub), index)))
    }

    // A group name up to '>'; the name is checked like the regex crate does.
    fn parse_name(&mut self, open: usize) -> Result<String, Error> {
        let start = self.pos;
        let mut name = String::new();
        loop {
            let Some(c) = self.peek() else {
                return self.err("unclosed capture group name", start, start);
            };
            if c == '>' {
                break;
            }
            let ok = c == '_'
                || c.is_ascii_alphabetic()
                || (c as u32) > 0x7F
                || (name.len() > 0 && (c.is_ascii_digit() || c == '.' || c == '[' || c == ']'));
            if !ok {
                return self.err("invalid capture group character", self.pos, self.pos + 1);
            }
            name.push(c);
            self.pos += 1;
        }
        if name.len() == 0 {
            return self.err("empty capture group name", start, start + 1);
        }
        let end = self.pos;
        self.pos += 1;
        for n in self.names.iter() {
            if let Some(m) = n
                && *m == name
            {
                return self.err("duplicate capture group name", start, end);
            }
        }
        Ok(name)
    }

    // (?flags) or (?flags:...), after "(?".
    fn parse_flags(&mut self, open: usize) -> Result<Option<Hir>, Error> {
        let mut f = self.flags.clone();
        let mut negate = false;
        let mut seen = String::new();
        let mut since_negate = 0;
        loop {
            let at = self.pos;
            let Some(c) = self.peek() else {
                return self.err("unclosed group", open, open + 1);
            };
            self.pos += 1;
            match c {
                ':' | ')' => {
                    if negate && since_negate == 0 {
                        return self.err("flag negation operator dangling", at - 1, at);
                    }
                    if c == ')' {
                        if seen.len() == 0 && !negate {
                            return self.err("empty flag group", open, self.pos);
                        }
                        self.flags = f;
                        return Ok(None);
                    }
                    self.enter(open)?;
                    let saved = self.flags.clone();
                    self.flags = f;
                    let sub = self.parse_alt()?;
                    self.flags = saved;
                    if !self.eat(')') {
                        return self.err("unclosed group", open, open + 1);
                    }
                    self.depth -= 1;
                    return Ok(Some(sub));
                }
                '-' => {
                    if negate {
                        return self.err("flag negation operator repeated", at, at + 1);
                    }
                    negate = true;
                }
                'i' | 'm' | 's' | 'x' | 'U' | 'u' => {
                    if seen.contains(c) {
                        return self.err("duplicate flag", at, at + 1);
                    }
                    seen.push(c);
                    since_negate += if negate { 1 } else { 0 };
                    let on = !negate;
                    match c {
                        'i' => f.i = on,
                        'm' => f.m = on,
                        's' => f.s = on,
                        'x' => f.x = on,
                        'U' => f.swap_greed = on,
                        _ => f.unicode = on,
                    }
                }
                _ => return self.err("unrecognized flag", at, at + 1),
            }
        }
    }

    fn hex(&mut self, start: usize, digits: usize) -> Result<u32, Error> {
        let braced = self.eat('{');
        let mut v: u32 = 0;
        let mut n = 0;
        loop {
            if braced && self.is('}') {
                self.pos += 1;
                break;
            }
            if !braced && n == digits {
                break;
            }
            let Some(c) = self.peek() else {
                return self.err(
                    "incomplete escape sequence, reached end of pattern prematurely",
                    start,
                    self.pos,
                );
            };
            let Some(d) = c.to_digit(16) else {
                return self.err(
                    "hexadecimal literal is not a valid digit",
                    self.pos,
                    self.pos + 1,
                );
            };
            if n >= 8 {
                return self.err(
                    "hexadecimal literal is not a Unicode scalar value",
                    start,
                    self.pos + 1,
                );
            }
            v = v * 16 + d;
            n += 1;
            self.pos += 1;
        }
        if n == 0 {
            return self.err("hexadecimal literal empty", start, self.pos);
        }
        if v > class::MAX_CHAR || (v >= 0xD800 && v <= 0xDFFF) {
            return self.err(
                "hexadecimal literal is not a Unicode scalar value",
                start,
                self.pos,
            );
        }
        Ok(v)
    }

    fn perl(&self, c: char) -> CharSet {
        let u = self.flags.unicode;
        let s = match c.to_ascii_lowercase() {
            'd' => class::digit(u),
            's' => class::space(u),
            _ => class::word(u),
        };
        if c.is_uppercase() { s.negate() } else { s }
    }

    // \p{...} or \pX, at the char after 'p'/'P'.
    fn unicode_class(&mut self, start: usize, negated: bool) -> Result<CharSet, Error> {
        let mut name = String::new();
        if self.eat('{') {
            loop {
                let Some(c) = self.peek() else {
                    return self.err("unclosed Unicode class literal", start, self.pos);
                };
                self.pos += 1;
                if c == '}' {
                    break;
                }
                name.push(c);
            }
        } else {
            let Some(c) = self.peek() else {
                return self.err(
                    "incomplete escape sequence, reached end of pattern prematurely",
                    start,
                    self.pos,
                );
            };
            self.pos += 1;
            name.push(c);
        }
        let mut neg = negated;
        let mut n = name.as_str();
        if n.starts_with("^") {
            neg = !neg;
            n = &n[1..];
        }
        let mut owned = String::new();
        if let Some(i) = n.find("!=") {
            neg = !neg;
            owned = `${&n[0..i]}=${&n[i + 2..]}`.to_string();
            n = owned.as_str();
        }
        let Some(mut s) = class::unicode_class(n) else {
            return self.err("Unicode property not found", start, self.pos);
        };
        if self.flags.i {
            s.case_fold(self.flags.unicode);
        }
        Ok(if neg { s.negate() } else { s })
    }

    // After '\\': \b{start} and friends.
    fn word_look(&mut self, start: usize) -> Result<Look, Error> {
        let a = !self.flags.unicode;
        if !self.is('{') {
            return Ok(Look::Word(a));
        }
        let save = self.pos;
        self.pos += 1;
        let mut name = String::new();
        while let Some(c) = self.peek()
            && (c.is_ascii_alphabetic() || c == '-')
        {
            name.push(c);
            self.pos += 1;
        }
        if !self.eat('}') {
            // Not a special word boundary: \b followed by a counted repetition.
            self.pos = save;
            return Ok(Look::Word(a));
        }
        match name.as_str() {
            "start" => Ok(Look::WordStart(a)),
            "end" => Ok(Look::WordEnd(a)),
            "start-half" => Ok(Look::WordStartHalf(a)),
            "end-half" => Ok(Look::WordEndHalf(a)),
            _ => {
                if name.len() == 0 || name.as_bytes()[0].is_ascii_digit() {
                    self.pos = save;
                    return Ok(Look::Word(a));
                }
                self.err(
                    "unrecognized special word boundary assertion",
                    start,
                    self.pos,
                )
            }
        }
    }

    fn parse_escape(&mut self, in_class: bool) -> Result<Esc, Error> {
        let start = self.pos;
        self.pos += 1;
        let Some(c) = self.peek() else {
            return self.err(
                "incomplete escape sequence, reached end of pattern prematurely",
                start,
                self.pos,
            );
        };
        self.pos += 1;
        let look = |p: &Parser, l: Look| -> Result<Esc, Error> {
            if in_class {
                p.err("unrecognized escape sequence", start, p.pos)
            } else {
                Ok(Esc::Look(l))
            }
        };
        match c {
            'a' => Ok(Esc::Char(7)),
            'f' => Ok(Esc::Char(0xC)),
            't' => Ok(Esc::Char(9)),
            'n' => Ok(Esc::Char(10)),
            'r' => Ok(Esc::Char(13)),
            'v' => Ok(Esc::Char(0xB)),
            'x' => Ok(Esc::Char(self.hex(start, 2)?)),
            'u' => Ok(Esc::Char(self.hex(start, 4)?)),
            'U' => Ok(Esc::Char(self.hex(start, 8)?)),
            'd' | 'D' | 's' | 'S' | 'w' | 'W' => Ok(Esc::Class(self.perl(c))),
            'p' | 'P' => Ok(Esc::Class(self.unicode_class(start, c == 'P')?)),
            'A' => look(self, Look::Start),
            'z' => look(self, Look::End),
            'B' => look(self, Look::NotWord(!self.flags.unicode)),
            '<' => look(self, Look::WordStart(!self.flags.unicode)),
            '>' => look(self, Look::WordEnd(!self.flags.unicode)),
            'b' => {
                if in_class {
                    return self.err("unrecognized escape sequence", start, self.pos);
                }
                Ok(Esc::Look(self.word_look(start)?))
            }
            '0'..='7' if self.octal => {
                let mut v = c as u32 - '0' as u32;
                let mut n = 1;
                while n < 3
                    && let Some(d) = self.peek()
                    && d >= '0'
                    && d <= '7'
                {
                    v = v * 8 + (d as u32 - '0' as u32);
                    self.pos += 1;
                    n += 1;
                }
                Ok(Esc::Char(v))
            }
            '0'..='9' => self.err("backreferences are not supported", start, self.pos),
            _ => {
                if (c as u32) < 0x80 && !c.is_ascii_alphanumeric() {
                    return Ok(Esc::Char(c as u32));
                }
                self.err("unrecognized escape sequence", start, self.pos)
            }
        }
    }

    fn class_space(&mut self) {
        self.skip_space();
    }

    // [:name:] or [:^name:] at '[', inside a class.
    fn ascii_class(&mut self) -> Result<Option<CharSet>, Error> {
        if self.peek_at(1) != Some(':') {
            return Ok(None);
        }
        let start = self.pos;
        let mut i = self.pos + 2;
        let negated = i < self.p.len() && self.p[i] == '^';
        if negated {
            i += 1;
        }
        let mut name = String::new();
        while i < self.p.len() && self.p[i].is_ascii_lowercase() {
            name.push(self.p[i]);
            i += 1;
        }
        if i + 1 >= self.p.len() || self.p[i] != ':' || self.p[i + 1] != ']' {
            return Ok(None);
        }
        self.pos = i + 2;
        let Some(mut s) = class::ascii_class(name.as_str()) else {
            return self.err("invalid ASCII character class", start, self.pos);
        };
        if self.flags.i {
            s.case_fold(self.flags.unicode);
        }
        Ok(Some(if negated { s.negate() } else { s }))
    }

    // A char of a class: a literal or an escape.
    fn class_atom(&mut self) -> Result<Esc, Error> {
        if self.is('\\') {
            return self.parse_escape(true);
        }
        let c = self.p[self.pos];
        self.pos += 1;
        Ok(Esc::Char(c as u32))
    }

    fn parse_class(&mut self) -> Result<CharSet, Error> {
        let open = self.pos;
        self.pos += 1;
        self.enter(open)?;
        let negated = self.eat('^');
        let mut set = self.parse_class_union(true, open)?;
        loop {
            self.class_space();
            let (a, b) = (self.peek(), self.peek_at(1));
            let op = if a == Some('&') && b == Some('&') {
                0
            } else if a == Some('-') && b == Some('-') {
                1
            } else if a == Some('~') && b == Some('~') {
                2
            } else {
                break;
            };
            self.pos += 2;
            let rhs = self.parse_class_union(false, open)?;
            set = match op {
                0 => set.intersect(&rhs),
                1 => set.difference(&rhs),
                _ => set.symmetric_difference(&rhs),
            };
        }
        if !self.eat(']') {
            return self.err("unclosed character class", open, open + 1);
        }
        self.depth -= 1;
        Ok(if negated { set.negate() } else { set })
    }

    fn parse_class_union(&mut self, first: bool, open: usize) -> Result<CharSet, Error> {
        let mut set = CharSet::new();
        let mut first = first;
        loop {
            self.class_space();
            let Some(c) = self.peek() else {
                return self.err("unclosed character class", open, open + 1);
            };
            if c == ']' && !first {
                break;
            }
            let next = self.peek_at(1);
            if (c == '&' && next == Some('&'))
                || (c == '~' && next == Some('~'))
                || (c == '-' && next == Some('-') && !first)
            {
                break;
            }
            first = false;
            if c == '[' {
                if let Some(s) = self.ascii_class()? {
                    set = set.unite(&s);
                } else {
                    let s = self.parse_class()?;
                    set = set.unite(&s);
                }
                continue;
            }
            let item = self.pos;
            let lo = match self.class_atom()? {
                Esc::Char(c) => c,
                Esc::Class(s) => {
                    set = set.unite(&s);
                    continue;
                }
                Esc::Look(_) => return self.err("unrecognized escape sequence", item, self.pos),
            };
            self.class_space();
            let n1 = self.peek_at(1);
            if self.is('-') && n1.is_some() && n1 != Some(']') && n1 != Some('-') {
                self.pos += 1;
                self.class_space();
                let hi = match self.class_atom()? {
                    Esc::Char(c) => c,
                    _ => return self.err("invalid character class range", item, self.pos),
                };
                if hi < lo {
                    return self.err(
                        "invalid character class range, the start must be <= the end",
                        item,
                        self.pos,
                    );
                }
                set.push(lo, hi);
            } else {
                set.push(lo, lo);
            }
        }
        set.canonicalize();
        if self.flags.i {
            set.case_fold(self.flags.unicode);
        }
        Ok(set)
    }
}
