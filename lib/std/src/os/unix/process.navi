//! std::os::unix::process: wait statuses.

use crate::process::ExitStatus;

pub trait ExitStatusExt {
    /// An ExitStatus from a raw wait status.
    fn from_raw(raw: i32) -> Self;
    /// The signal that ended the process, if one did.
    fn signal(&self) -> Option<i32>;
    fn core_dumped(&self) -> bool;
    fn into_raw(self) -> i32;
}

impl ExitStatusExt for ExitStatus {
    fn from_raw(raw: i32) -> ExitStatus { ExitStatus { raw } }
    fn signal(&self) -> Option<i32> {
        let s = self.raw & 0x7f;
        if s != 0 && s != 0x7f { Some(s) } else { None }
    }
    fn core_dumped(&self) -> bool { self.signal().is_some() && self.raw & 0x80 != 0 }
    fn into_raw(self) -> i32 { self.raw }
}
