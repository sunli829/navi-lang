//! Unix-specific extensions to primitives in the [`crate::process`] module.
//!
//! [`ExitStatusExt`] reads a raw wait status: the signal that ended a process
//! and whether it dumped core.

use crate::process::ExitStatus;

/// Unix-specific extensions to [`ExitStatus`].
///
/// On Unix an [`ExitStatus`] holds the raw wait status (as `waitpid` returns
/// it): the exit code if the process exited, or the signal that terminated it.
///
/// # Examples
///
/// ```
/// use std::os::unix::process::ExitStatusExt;
/// use std::process::Command;
///
/// fn main() -> std::io::Result<()> {
///     let status = Command::new("sh").arg("-c").arg("kill -9 $$").status()?;
///     assert_eq(status.signal(), Some(9));
///     assert_eq(status.code(), None);
///     Ok(())
/// }
/// ```
pub trait ExitStatusExt {
    /// Creates a new `ExitStatus` from the raw underlying integer status value
    /// from `wait`.
    ///
    /// The value should be a wait status, not an exit status: exit code `n` is
    /// `n << 8`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::os::unix::process::ExitStatusExt;
    /// use std::process::ExitStatus;
    ///
    /// let exited = ExitStatus::from_raw(3 << 8);
    /// assert_eq(exited.code(), Some(3));
    /// assert(!exited.success());
    ///
    /// let killed = ExitStatus::from_raw(15);
    /// assert_eq(killed.code(), None);
    /// assert_eq(killed.signal(), Some(15));
    /// ```
    fn from_raw(raw: i32) -> Self;
    /// If the process was terminated by a signal, returns that signal.
    ///
    /// In other words, if `WIFSIGNALED`, this returns `WTERMSIG`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::os::unix::process::ExitStatusExt;
    /// use std::process::ExitStatus;
    ///
    /// assert_eq(ExitStatus::from_raw(9).signal(), Some(9));
    /// assert_eq(ExitStatus::from_raw(0).signal(), None);
    /// assert_eq(ExitStatus::from_raw(1 << 8).signal(), None);
    /// ```
    fn signal(&self) -> Option<i32>;
    /// If the process was terminated by a signal, says whether it dumped core.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::os::unix::process::ExitStatusExt;
    /// use std::process::ExitStatus;
    ///
    /// // SIGABRT (6) with the core dump flag (0x80).
    /// assert(ExitStatus::from_raw(0x80 | 6).core_dumped());
    /// assert(!ExitStatus::from_raw(6).core_dumped());
    /// assert(!ExitStatus::from_raw(0).core_dumped());
    /// ```
    fn core_dumped(&self) -> bool;
    /// Returns the underlying raw `wait` status.
    ///
    /// The returned integer is a wait status, not an exit status.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::os::unix::process::ExitStatusExt;
    /// use std::process::ExitStatus;
    ///
    /// assert_eq(ExitStatus::from_raw(2 << 8).into_raw(), 512);
    /// ```
    fn into_raw(self) -> i32;
}

impl ExitStatusExt for ExitStatus {
    fn from_raw(raw: i32) -> ExitStatus {
        ExitStatus { raw }
    }

    fn signal(&self) -> Option<i32> {
        let s = self.raw & 0x7f;
        if s != 0 && s != 0x7f { Some(s) } else { None }
    }

    fn core_dumped(&self) -> bool {
        self.signal().is_some() && self.raw & 0x80 != 0
    }

    fn into_raw(self) -> i32 {
        self.raw
    }
}
