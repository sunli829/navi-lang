//! Platform-specific extensions to `std` for Unix platforms.
//!
//! Provides access to platform-level information on Unix platforms, and exposes
//! Unix-specific functions that would otherwise be inappropriate as part of the
//! core `std` library: [`fs`] has symbolic links, permission modes and the raw
//! `stat` fields; [`process`] reads wait statuses (signals, core dumps).
//!
//! It exists only when the target is not Windows.
//!
//! # Examples
//!
//! ```
//! use std::fs;
//! use std::os::unix::fs::{symlink, PermissionsExt};
//!
//! fn main() -> std::io::Result<()> {
//!     let dir = std::env::temp_dir().join("navi-doc-os-unix-module");
//!     let _ = fs::remove_dir_all(&dir);
//!     fs::create_dir(&dir)?;
//!     fs::write(dir.join("script.sh"), "#!/bin/sh\n")?;
//!     fs::set_permissions(dir.join("script.sh"), fs::Permissions::from_mode(0o755))?;
//!     symlink("script.sh", dir.join("run"))?;
//!     assert_eq(fs::metadata(dir.join("run"))?.permissions().mode(), 0o755);
//!     fs::remove_dir_all(&dir)?;
//!     Ok(())
//! }
//! ```

pub mod fs;
pub mod process;
