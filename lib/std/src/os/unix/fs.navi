//! Unix-specific extensions to primitives in the [`crate::fs`] module.
//!
//! [`symlink`] creates symbolic links; the extension traits give the Unix side
//! of [`Permissions`] ([`PermissionsExt`]: the mode bits), [`OpenOptions`] and
//! [`DirBuilder`] ([`OpenOptionsExt`], [`DirBuilderExt`]: the mode of what they
//! create), [`Metadata`] ([`MetadataExt`]: the `stat` fields) and [`FileType`]
//! ([`FileTypeExt`]: devices, FIFOs and sockets).

use crate::fs::{DirBuilder, FileType, Metadata, OpenOptions, Permissions};
use crate::io;
use crate::path::Path;

/// Creates a new symbolic link on the filesystem.
///
/// The `link` path will be a symbolic link pointing to the `original` path.
/// `original` is stored as given: a relative one is resolved from the link's
/// directory when the link is followed, and it need not exist.
///
/// # Errors
///
/// Returns an error if `link` already exists
/// ([`crate::io::ErrorKind::AlreadyExists`]), its directory does not exist, or
/// the user lacks permission to create it.
///
/// # Examples
///
/// ```
/// use std::fs;
/// use std::os::unix::fs::symlink;
///
/// fn main() -> std::io::Result<()> {
///     let dir = std::env::temp_dir().join("navi-doc-unix-symlink");
///     let _ = fs::remove_dir_all(&dir);
///     fs::create_dir(&dir)?;
///     fs::write(dir.join("a.txt"), "hello")?;
///     symlink("a.txt", dir.join("b.txt"))?;
///     assert_eq(fs::read_to_string(dir.join("b.txt"))?, "hello");
///     assert_eq(fs::read_link(dir.join("b.txt"))?.as_str(), "a.txt");
///     fs::remove_dir_all(&dir)?;
///     Ok(())
/// }
/// ```
pub fn symlink<P: AsRef<Path>, Q: AsRef<Path>>(original: P, link: Q) -> io::Result<()> {
    crate::sys::symlink(original.as_ref().as_str(), link.as_ref().as_str(), false)
}

/// Unix-specific extensions to [`Permissions`].
///
/// # Examples
///
/// ```
/// use std::fs::{self, Permissions};
/// use std::os::unix::fs::PermissionsExt;
///
/// fn main() -> std::io::Result<()> {
///     let path = std::env::temp_dir().join("navi-doc-unix-permissions-ext.txt");
///     fs::write(&path, "x")?;
///     fs::set_permissions(&path, Permissions::from_mode(0o640))?;
///     let permissions = fs::metadata(&path)?.permissions();
///     assert_eq(permissions.mode(), 0o640);
///     fs::remove_file(&path)?;
///     Ok(())
/// }
/// ```
pub trait PermissionsExt {
    /// Returns the underlying raw `st_mode` bits that contain the standard Unix
    /// permissions for this file.
    ///
    /// These are the permission bits only (`mode & 0o7777`: the read, write and
    /// execute bits for owner, group and others, plus setuid, setgid and
    /// sticky); [`MetadataExt::mode`] has the file type bits as well.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs::{self, File};
    /// use std::os::unix::fs::PermissionsExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let path = std::env::temp_dir().join("navi-doc-unix-permissions-mode.txt");
    ///     let mut f = File::create(&path)?;
    ///     let metadata = f.metadata()?;
    ///     f.close();
    ///     let permissions = metadata.permissions();
    ///     // The owner may read and write the file it created.
    ///     assert_eq(permissions.mode() & 0o600, 0o600);
    ///     fs::remove_file(&path)?;
    ///     Ok(())
    /// }
    /// ```
    fn mode(&self) -> u32;
    /// Sets the underlying raw bits for this set of permissions.
    ///
    /// This only changes the value: use [`crate::fs::set_permissions`] or
    /// [`crate::fs::File::set_permissions`] to apply it to a file.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    /// use std::os::unix::fs::PermissionsExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let path = std::env::temp_dir().join("navi-doc-unix-permissions-set-mode.txt");
    ///     fs::write(&path, "x")?;
    ///     let mut permissions = fs::metadata(&path)?.permissions();
    ///     permissions.set_mode(0o644);
    ///     assert_eq(permissions.mode(), 0o644);
    ///     fs::set_permissions(&path, permissions)?;
    ///     assert_eq(fs::metadata(&path)?.permissions().mode(), 0o644);
    ///     fs::remove_file(&path)?;
    ///     Ok(())
    /// }
    /// ```
    fn set_mode(&mut self, mode: u32);
    /// Creates a new instance of `Permissions` from the given set of Unix
    /// permission bits.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs::Permissions;
    /// use std::os::unix::fs::PermissionsExt;
    ///
    /// // Read/write for owner and read for others.
    /// let permissions = Permissions::from_mode(0o644);
    /// assert_eq(permissions.mode(), 0o644);
    /// assert(!permissions.readonly());
    /// assert(Permissions::from_mode(0o444).readonly());
    /// ```
    fn from_mode(mode: u32) -> Self;
}

impl PermissionsExt for Permissions {
    fn mode(&self) -> u32 {
        self.mode
    }
    fn set_mode(&mut self, mode: u32) {
        self.mode = mode;
    }
    fn from_mode(mode: u32) -> Permissions {
        Permissions { mode }
    }
}

/// Unix-specific extensions to [`OpenOptions`].
///
/// # Examples
///
/// ```
/// use std::fs::{self, OpenOptions};
/// use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
///
/// fn main() -> std::io::Result<()> {
///     let path = std::env::temp_dir().join("navi-doc-unix-open-options-ext.txt");
///     let _ = fs::remove_file(&path);
///     let mut file = OpenOptions::new().write(true).create(true).mode(0o600).open(&path)?;
///     file.close();
///     assert_eq(fs::metadata(&path)?.permissions().mode() & 0o777, 0o600);
///     fs::remove_file(&path)?;
///     Ok(())
/// }
/// ```
pub trait OpenOptionsExt {
    /// Sets the mode bits that a new file will be created with.
    ///
    /// If a new file is created as part of an [`OpenOptions::open`] call then
    /// this specified `mode` will be used as the permission bits for the new
    /// file. If no `mode` is set, the default of `0o666` will be used. The
    /// operating system masks out bits with the system's `umask`, to produce
    /// the final permissions. The mode of an existing file is not changed.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs::{self, OpenOptions};
    /// use std::os::unix::fs::{OpenOptionsExt, PermissionsExt};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let path = std::env::temp_dir().join("navi-doc-unix-open-options-mode.txt");
    ///     let _ = fs::remove_file(&path);
    ///     let mut options = OpenOptions::new();
    ///     options.mode(0o600); // only the owner can read and write
    ///     let mut file = options.write(true).create(true).open(&path)?;
    ///     file.close();
    ///     assert_eq(fs::metadata(&path)?.permissions().mode() & 0o077, 0);
    ///     fs::remove_file(&path)?;
    ///     Ok(())
    /// }
    /// ```
    fn mode(&mut self, mode: u32) -> &mut Self;
}

impl OpenOptionsExt for OpenOptions {
    fn mode(&mut self, mode: u32) -> &mut OpenOptions {
        self.mode = mode;
        self
    }
}

/// Unix-specific extensions to [`DirBuilder`].
///
/// # Examples
///
/// ```
/// use std::fs::{self, DirBuilder};
/// use std::os::unix::fs::{DirBuilderExt, PermissionsExt};
///
/// fn main() -> std::io::Result<()> {
///     let dir = std::env::temp_dir().join("navi-doc-unix-dir-builder-ext");
///     let _ = fs::remove_dir_all(&dir);
///     DirBuilder::new().mode(0o700).create(&dir)?;
///     assert_eq(fs::metadata(&dir)?.permissions().mode() & 0o777, 0o700);
///     fs::remove_dir(&dir)?;
///     Ok(())
/// }
/// ```
pub trait DirBuilderExt {
    /// Sets the mode to create new directories with.
    ///
    /// This option defaults to `0o777`; the operating system masks out bits
    /// with the system's `umask`. With [`DirBuilder::recursive`], the missing
    /// parents get the same mode.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs::{self, DirBuilder};
    /// use std::os::unix::fs::{DirBuilderExt, PermissionsExt};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let dir = std::env::temp_dir().join("navi-doc-unix-dir-builder-mode");
    ///     let _ = fs::remove_dir_all(&dir);
    ///     let mut builder = DirBuilder::new();
    ///     builder.mode(0o755).recursive(true);
    ///     builder.create(dir.join("a/b"))?;
    ///     assert_eq(fs::metadata(dir.join("a"))?.permissions().mode() & 0o700, 0o700);
    ///     fs::remove_dir_all(&dir)?;
    ///     Ok(())
    /// }
    /// ```
    fn mode(&mut self, mode: u32) -> &mut Self;
}

impl DirBuilderExt for DirBuilder {
    fn mode(&mut self, mode: u32) -> &mut DirBuilder {
        self.mode = mode;
        self
    }
}

/// Unix-specific extensions to [`Metadata`]: the fields of `stat`.
///
/// The times are split into whole seconds since the Unix epoch and nanoseconds,
/// as in `stat`'s `timespec`s.
///
/// # Examples
///
/// ```
/// use std::fs;
/// use std::os::unix::fs::MetadataExt;
///
/// fn main() -> std::io::Result<()> {
///     let path = std::env::temp_dir().join("navi-doc-unix-metadata-ext.txt");
///     fs::write(&path, "hello")?;
///     let meta = fs::metadata(&path)?;
///     assert_eq(meta.size(), 5);
///     assert_eq(meta.nlink(), 1);
///     assert_eq(meta.mode() & 0o170000, 0o100000); // a regular file
///     fs::remove_file(&path)?;
///     Ok(())
/// }
/// ```
pub trait MetadataExt {
    /// Returns the ID of the device containing the file.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    /// use std::os::unix::fs::MetadataExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let dir = std::env::temp_dir();
    ///     let path = dir.join("navi-doc-unix-metadata-dev.txt");
    ///     fs::write(&path, "x")?;
    ///     // A file is on the same device as its directory (unless one is mounted there).
    ///     assert_eq(fs::metadata(&path)?.dev(), fs::metadata(&dir)?.dev());
    ///     fs::remove_file(&path)?;
    ///     Ok(())
    /// }
    /// ```
    fn dev(&self) -> u64;
    /// Returns the inode number.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    /// use std::os::unix::fs::MetadataExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let dir = std::env::temp_dir().join("navi-doc-unix-metadata-ino");
    ///     let _ = fs::remove_dir_all(&dir);
    ///     fs::create_dir(&dir)?;
    ///     fs::write(dir.join("a"), "x")?;
    ///     fs::write(dir.join("b"), "x")?;
    ///     fs::hard_link(dir.join("a"), dir.join("c"))?;
    ///     // Hard links share the inode; other files do not.
    ///     assert_eq(fs::metadata(dir.join("a"))?.ino(), fs::metadata(dir.join("c"))?.ino());
    ///     assert_ne(fs::metadata(dir.join("a"))?.ino(), fs::metadata(dir.join("b"))?.ino());
    ///     fs::remove_dir_all(&dir)?;
    ///     Ok(())
    /// }
    /// ```
    fn ino(&self) -> u64;
    /// Returns the rights applied to this file, with the file type bits.
    ///
    /// This is the whole `st_mode`: the permission bits (as
    /// [`PermissionsExt::mode`]) and the file type (`mode & 0o170000`:
    /// `0o100000` for a regular file, `0o040000` for a directory, `0o120000`
    /// for a symbolic link, ...).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs::{self, Permissions};
    /// use std::os::unix::fs::{MetadataExt, PermissionsExt};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let path = std::env::temp_dir().join("navi-doc-unix-metadata-mode.txt");
    ///     fs::write(&path, "x")?;
    ///     fs::set_permissions(&path, Permissions::from_mode(0o640))?;
    ///     let mode = fs::metadata(&path)?.mode();
    ///     assert_eq(mode & 0o777, 0o640);
    ///     assert_eq(mode & 0o170000, 0o100000);
    ///     assert_eq(fs::metadata(std::env::temp_dir())?.mode() & 0o170000, 0o040000);
    ///     fs::remove_file(&path)?;
    ///     Ok(())
    /// }
    /// ```
    fn mode(&self) -> u32;
    /// Returns the number of hard links pointing to this file.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    /// use std::os::unix::fs::MetadataExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let dir = std::env::temp_dir().join("navi-doc-unix-metadata-nlink");
    ///     let _ = fs::remove_dir_all(&dir);
    ///     fs::create_dir(&dir)?;
    ///     fs::write(dir.join("a"), "x")?;
    ///     assert_eq(fs::metadata(dir.join("a"))?.nlink(), 1);
    ///     fs::hard_link(dir.join("a"), dir.join("b"))?;
    ///     assert_eq(fs::metadata(dir.join("a"))?.nlink(), 2);
    ///     fs::remove_dir_all(&dir)?;
    ///     Ok(())
    /// }
    /// ```
    fn nlink(&self) -> u64;
    /// Returns the user ID of the owner of this file.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    /// use std::os::unix::fs::MetadataExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let dir = std::env::temp_dir();
    ///     let a = dir.join("navi-doc-unix-metadata-uid-a");
    ///     let b = dir.join("navi-doc-unix-metadata-uid-b");
    ///     fs::write(&a, "")?;
    ///     fs::write(&b, "")?;
    ///     // Files the process creates belong to its user.
    ///     assert_eq(fs::metadata(&a)?.uid(), fs::metadata(&b)?.uid());
    ///     fs::remove_file(&a)?;
    ///     fs::remove_file(&b)?;
    ///     Ok(())
    /// }
    /// ```
    fn uid(&self) -> u32;
    /// Returns the group ID of the owner of this file.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    /// use std::os::unix::fs::MetadataExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let meta = fs::metadata("/")?;
    ///     let gid = meta.gid();
    ///     # let _ = gid;
    ///     Ok(())
    /// }
    /// ```
    fn gid(&self) -> u32;
    /// Returns the device ID of this file (if it is a special one).
    ///
    /// It is 0 for a file that is not a device.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    /// use std::os::unix::fs::MetadataExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let path = std::env::temp_dir().join("navi-doc-unix-metadata-rdev.txt");
    ///     fs::write(&path, "x")?;
    ///     assert_eq(fs::metadata(&path)?.rdev(), 0);
    ///     fs::remove_file(&path)?;
    ///     Ok(())
    /// }
    /// ```
    fn rdev(&self) -> u64;
    /// Returns the total size of this file in bytes.
    ///
    /// It is the same as [`Metadata::len`].
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    /// use std::os::unix::fs::MetadataExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let path = std::env::temp_dir().join("navi-doc-unix-metadata-size.txt");
    ///     fs::write(&path, "12345")?;
    ///     let meta = fs::metadata(&path)?;
    ///     assert_eq(meta.size(), 5);
    ///     assert_eq(meta.size(), meta.len());
    ///     fs::remove_file(&path)?;
    ///     Ok(())
    /// }
    /// ```
    fn size(&self) -> u64;
    /// Returns the last access time of the file, in seconds since Unix Epoch.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs::{self, File, FileTimes};
    /// use std::os::unix::fs::MetadataExt;
    /// use std::time::{Duration, UNIX_EPOCH};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let path = std::env::temp_dir().join("navi-doc-unix-metadata-atime.txt");
    ///     fs::write(&path, "x")?;
    ///     let mut f = File::options().write(true).open(&path)?;
    ///     f.set_times(FileTimes::new().set_accessed(UNIX_EPOCH + Duration::from_secs(1000)))?;
    ///     f.close();
    ///     assert_eq(fs::metadata(&path)?.atime(), 1000);
    ///     fs::remove_file(&path)?;
    ///     Ok(())
    /// }
    /// ```
    fn atime(&self) -> i64;
    /// Returns the last access time of the file, in nanoseconds since
    /// [`MetadataExt::atime`].
    ///
    /// It is in `0..1_000_000_000`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    /// use std::os::unix::fs::MetadataExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let nanos = fs::metadata(std::env::temp_dir())?.atime_nsec();
    ///     assert(nanos >= 0 && nanos < 1000000000);
    ///     Ok(())
    /// }
    /// ```
    fn atime_nsec(&self) -> i64;
    /// Returns the last modification time of the file, in seconds since Unix
    /// Epoch.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs::{self, File};
    /// use std::os::unix::fs::MetadataExt;
    /// use std::time::{Duration, UNIX_EPOCH};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let path = std::env::temp_dir().join("navi-doc-unix-metadata-mtime.txt");
    ///     fs::write(&path, "x")?;
    ///     let mut f = File::options().write(true).open(&path)?;
    ///     f.set_modified(UNIX_EPOCH + Duration::from_secs(1500000000))?;
    ///     f.close();
    ///     let meta = fs::metadata(&path)?;
    ///     assert_eq(meta.mtime(), 1500000000);
    ///     assert_eq(meta.mtime_nsec(), 0);
    ///     fs::remove_file(&path)?;
    ///     Ok(())
    /// }
    /// ```
    fn mtime(&self) -> i64;
    /// Returns the last modification time of the file, in nanoseconds since
    /// [`MetadataExt::mtime`].
    ///
    /// It is in `0..1_000_000_000`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    /// use std::os::unix::fs::MetadataExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let nanos = fs::metadata(std::env::temp_dir())?.mtime_nsec();
    ///     assert(nanos >= 0 && nanos < 1000000000);
    ///     Ok(())
    /// }
    /// ```
    fn mtime_nsec(&self) -> i64;
    /// Returns the last status change time of the file, in seconds since Unix
    /// Epoch.
    ///
    /// The status changes when the file's contents or metadata (permissions,
    /// owner, links...) change; unlike the other times, it cannot be set.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    /// use std::os::unix::fs::MetadataExt;
    /// use std::time::{SystemTime, UNIX_EPOCH};
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let path = std::env::temp_dir().join("navi-doc-unix-metadata-ctime.txt");
    ///     fs::write(&path, "x")?;
    ///     let now = SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_secs() as i64;
    ///     assert((fs::metadata(&path)?.ctime() - now).abs() < 60);
    ///     fs::remove_file(&path)?;
    ///     Ok(())
    /// }
    /// ```
    fn ctime(&self) -> i64;
    /// Returns the last status change time of the file, in nanoseconds since
    /// [`MetadataExt::ctime`].
    ///
    /// It is in `0..1_000_000_000`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    /// use std::os::unix::fs::MetadataExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let nanos = fs::metadata(std::env::temp_dir())?.ctime_nsec();
    ///     assert(nanos >= 0 && nanos < 1000000000);
    ///     Ok(())
    /// }
    /// ```
    fn ctime_nsec(&self) -> i64;
    /// Returns the block size for filesystem I/O.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    /// use std::os::unix::fs::MetadataExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let blocksize = fs::metadata(std::env::temp_dir())?.blksize();
    ///     assert(blocksize > 0);
    ///     Ok(())
    /// }
    /// ```
    fn blksize(&self) -> u64;
    /// Returns the number of blocks allocated to the file, in 512-byte units.
    ///
    /// Please note that this may be smaller than `st_size / 512` when the file
    /// has holes.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    /// use std::os::unix::fs::MetadataExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let path = std::env::temp_dir().join("navi-doc-unix-metadata-blocks.txt");
    ///     fs::write(&path, "")?;
    ///     let blocks = fs::metadata(&path)?.blocks();
    ///     # let _ = blocks;
    ///     fs::remove_file(&path)?;
    ///     Ok(())
    /// }
    /// ```
    fn blocks(&self) -> u64;
}

fn secs(n: i128) -> i64 {
    let s = n / 1000000000;
    (if n % 1000000000 < 0 { s - 1 } else { s }) as i64
}

fn nsecs(n: i128) -> i64 {
    let r = n % 1000000000;
    (if r < 0 { r + 1000000000 } else { r }) as i64
}

impl MetadataExt for Metadata {
    fn dev(&self) -> u64 {
        self.attr.dev
    }
    fn ino(&self) -> u64 {
        self.attr.ino
    }
    fn mode(&self) -> u32 {
        self.attr.mode
    }
    fn nlink(&self) -> u64 {
        self.attr.nlink
    }
    fn uid(&self) -> u32 {
        self.attr.uid
    }
    fn gid(&self) -> u32 {
        self.attr.gid
    }
    fn rdev(&self) -> u64 {
        self.attr.rdev
    }
    fn size(&self) -> u64 {
        self.attr.size
    }
    fn atime(&self) -> i64 {
        secs(self.attr.atime)
    }
    fn atime_nsec(&self) -> i64 {
        nsecs(self.attr.atime)
    }
    fn mtime(&self) -> i64 {
        secs(self.attr.mtime)
    }
    fn mtime_nsec(&self) -> i64 {
        nsecs(self.attr.mtime)
    }
    fn ctime(&self) -> i64 {
        secs(self.attr.ctime)
    }
    fn ctime_nsec(&self) -> i64 {
        nsecs(self.attr.ctime)
    }
    fn blksize(&self) -> u64 {
        self.attr.blksize
    }
    fn blocks(&self) -> u64 {
        self.attr.blocks
    }
}

/// Unix-specific extensions for [`FileType`].
///
/// Adds support for special Unix file types such as block/character devices,
/// pipes, and sockets.
///
/// # Examples
///
/// ```
/// use std::fs;
/// use std::os::unix::fs::FileTypeExt;
///
/// fn main() -> std::io::Result<()> {
///     let file_type = fs::metadata("/dev/null")?.file_type();
///     assert(file_type.is_char_device());
///     assert(!file_type.is_file());
///     Ok(())
/// }
/// ```
pub trait FileTypeExt {
    /// Returns `true` if this file type is a block device.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    /// use std::os::unix::fs::FileTypeExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     assert(!fs::metadata("/dev/null")?.file_type().is_block_device());
    ///     Ok(())
    /// }
    /// ```
    fn is_block_device(&self) -> bool;
    /// Returns `true` if this file type is a char device.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    /// use std::os::unix::fs::FileTypeExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     assert(fs::metadata("/dev/null")?.file_type().is_char_device());
    ///     assert(!fs::metadata("/")?.file_type().is_char_device());
    ///     Ok(())
    /// }
    /// ```
    fn is_char_device(&self) -> bool;
    /// Returns `true` if this file type is a fifo (a named pipe).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    /// use std::os::unix::fs::FileTypeExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     assert(!fs::metadata("/dev/null")?.file_type().is_fifo());
    ///     Ok(())
    /// }
    /// ```
    fn is_fifo(&self) -> bool;
    /// Returns `true` if this file type is a socket (a Unix domain socket in
    /// the filesystem).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    /// use std::os::unix::fs::FileTypeExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     assert(!fs::metadata("/dev/null")?.file_type().is_socket());
    ///     Ok(())
    /// }
    /// ```
    fn is_socket(&self) -> bool;
}

impl FileTypeExt for FileType {
    fn is_block_device(&self) -> bool {
        self.mode & crate::sys::S_IFMT == crate::sys::S_IFBLK
    }
    fn is_char_device(&self) -> bool {
        self.mode & crate::sys::S_IFMT == crate::sys::S_IFCHR
    }
    fn is_fifo(&self) -> bool {
        self.mode & crate::sys::S_IFMT == crate::sys::S_IFIFO
    }
    fn is_socket(&self) -> bool {
        self.mode & crate::sys::S_IFMT == crate::sys::S_IFSOCK
    }
}
