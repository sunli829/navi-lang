//! std::os::unix::fs: symlink and the Unix sides of permissions, metadata,
//! OpenOptions and DirBuilder.

use crate::io;
use crate::path::Path;
use crate::fs::{Permissions, Metadata, OpenOptions, DirBuilder, FileType};

/// Creates a symbolic link at link pointing to original.
pub fn symlink<P: AsRef<Path>, Q: AsRef<Path>>(original: P, link: Q) -> io::Result<()> {
    crate::sys::symlink(original.as_ref().as_str(), link.as_ref().as_str(), false)
}

pub trait PermissionsExt {
    /// The permission bits (mode & 0o7777).
    fn mode(&self) -> u32;
    fn set_mode(&mut self, mode: u32);
    fn from_mode(mode: u32) -> Self;
}

impl PermissionsExt for Permissions {
    fn mode(&self) -> u32 { self.mode }
    fn set_mode(&mut self, mode: u32) { self.mode = mode; }
    fn from_mode(mode: u32) -> Permissions { Permissions { mode } }
}

pub trait OpenOptionsExt {
    /// The mode of a file the open creates (before the umask; 0o666 by
    /// default).
    fn mode(&mut self, mode: u32) -> &mut Self;
}

impl OpenOptionsExt for OpenOptions {
    fn mode(&mut self, mode: u32) -> &mut OpenOptions {
        self.mode = mode;
        self
    }
}

pub trait DirBuilderExt {
    /// The mode of the directories created (before the umask; 0o777 by
    /// default).
    fn mode(&mut self, mode: u32) -> &mut Self;
}

impl DirBuilderExt for DirBuilder {
    fn mode(&mut self, mode: u32) -> &mut DirBuilder {
        self.mode = mode;
        self
    }
}

/// stat's fields.
pub trait MetadataExt {
    fn dev(&self) -> u64;
    fn ino(&self) -> u64;
    fn mode(&self) -> u32;
    fn nlink(&self) -> u64;
    fn uid(&self) -> u32;
    fn gid(&self) -> u32;
    fn rdev(&self) -> u64;
    fn size(&self) -> u64;
    fn atime(&self) -> i64;
    fn atime_nsec(&self) -> i64;
    fn mtime(&self) -> i64;
    fn mtime_nsec(&self) -> i64;
    fn ctime(&self) -> i64;
    fn ctime_nsec(&self) -> i64;
    fn blksize(&self) -> u64;
    fn blocks(&self) -> u64;
}

fn secs(n: i128) -> i64 {
    let s = n / 1000000000;
    (if n % 1000000000 < 0 { s - 1 } else { s }) as i64
}

fn nsecs(n: i128) -> i64 {
    let r = n % 1000000000;
    (if r < 0 { r + 1000000000 } else { r }) as i64
}

impl MetadataExt for Metadata {
    fn dev(&self) -> u64 { self.attr.dev }
    fn ino(&self) -> u64 { self.attr.ino }
    fn mode(&self) -> u32 { self.attr.mode }
    fn nlink(&self) -> u64 { self.attr.nlink }
    fn uid(&self) -> u32 { self.attr.uid }
    fn gid(&self) -> u32 { self.attr.gid }
    fn rdev(&self) -> u64 { self.attr.rdev }
    fn size(&self) -> u64 { self.attr.size }
    fn atime(&self) -> i64 { secs(self.attr.atime) }
    fn atime_nsec(&self) -> i64 { nsecs(self.attr.atime) }
    fn mtime(&self) -> i64 { secs(self.attr.mtime) }
    fn mtime_nsec(&self) -> i64 { nsecs(self.attr.mtime) }
    fn ctime(&self) -> i64 { secs(self.attr.ctime) }
    fn ctime_nsec(&self) -> i64 { nsecs(self.attr.ctime) }
    fn blksize(&self) -> u64 { self.attr.blksize }
    fn blocks(&self) -> u64 { self.attr.blocks }
}

pub trait FileTypeExt {
    fn is_block_device(&self) -> bool;
    fn is_char_device(&self) -> bool;
    fn is_fifo(&self) -> bool;
    fn is_socket(&self) -> bool;
}

impl FileTypeExt for FileType {
    fn is_block_device(&self) -> bool { self.mode & crate::sys::S_IFMT == crate::sys::S_IFBLK }
    fn is_char_device(&self) -> bool { self.mode & crate::sys::S_IFMT == crate::sys::S_IFCHR }
    fn is_fifo(&self) -> bool { self.mode & crate::sys::S_IFMT == crate::sys::S_IFIFO }
    fn is_socket(&self) -> bool { self.mode & crate::sys::S_IFMT == crate::sys::S_IFSOCK }
}
