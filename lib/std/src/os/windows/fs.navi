//! Windows-specific extensions to primitives in the [`crate::fs`] module.
//!
//! Windows tells symbolic links to files from symbolic links to directories, so
//! there are two functions to make them, [`symlink_file`] and [`symlink_dir`].
//! [`MetadataExt`] gives the file attributes.

use crate::{fs::Metadata, io, path::Path};

/// Creates a new symlink to a non-directory file on the filesystem.
///
/// The `link` path will be a file symbolic link pointing to the `original`
/// path. The `original` path should not be a directory or a symlink to a
/// directory, otherwise the symlink will be broken; use [`symlink_dir`] for
/// directories.
///
/// # Errors
///
/// Creating symbolic links on Windows requires the
/// `SeCreateSymbolicLinkPrivilege`, which is by default only granted to
/// administrators, unless Developer Mode is enabled; without it this fails with
/// a permission error. It also fails if `link` already exists.
///
/// # Examples
///
/// ```ignore
/// use std::os::windows::fs::symlink_file;
///
/// fn main() -> std::io::Result<()> {
///     symlink_file("a.txt", "b.txt")?;
///     Ok(())
/// }
/// ```
pub fn symlink_file<P: AsRef<Path>, Q: AsRef<Path>>(original: P, link: Q) -> io::Result<()> {
    crate::sys::symlink(original.as_ref().as_str(), link.as_ref().as_str(), false)
}

/// Creates a new symlink to a directory on the filesystem.
///
/// The `link` path will be a directory symbolic link pointing to the `original`
/// path. The `original` path must be a directory or a symlink to a directory,
/// otherwise the symlink will be broken; use [`symlink_file`] for other files.
///
/// # Errors
///
/// As [`symlink_file`]: creating symbolic links requires the
/// `SeCreateSymbolicLinkPrivilege` (administrators, or Developer Mode), and
/// `link` must not exist.
///
/// # Examples
///
/// ```ignore
/// use std::os::windows::fs::symlink_dir;
///
/// fn main() -> std::io::Result<()> {
///     symlink_dir("a", "b")?;
///     Ok(())
/// }
/// ```
pub fn symlink_dir<P: AsRef<Path>, Q: AsRef<Path>>(original: P, link: Q) -> io::Result<()> {
    crate::sys::symlink(original.as_ref().as_str(), link.as_ref().as_str(), true)
}

/// Windows-specific extensions to [`Metadata`].
///
/// navi has the attributes and the size; Rust's creation/access/write times as
/// raw `FILETIME`s and the volume and file indexes are not provided (the times
/// are on [`Metadata`] itself).
///
/// # Examples
///
/// ```ignore
/// use std::fs;
/// use std::os::windows::fs::MetadataExt;
///
/// fn main() -> std::io::Result<()> {
///     let metadata = fs::metadata("foo.txt")?;
///     assert_eq(metadata.file_size(), metadata.len());
///     Ok(())
/// }
/// ```
pub trait MetadataExt {
    /// Returns the value of the `dwFileAttributes` field of this metadata.
    ///
    /// This field contains the file system attribute information for a file or
    /// directory: the `FILE_ATTRIBUTE_*` bits, such as
    /// `FILE_ATTRIBUTE_READONLY` (0x1), `FILE_ATTRIBUTE_HIDDEN` (0x2) and
    /// `FILE_ATTRIBUTE_DIRECTORY` (0x10).
    ///
    /// # Examples
    ///
    /// ```ignore
    /// use std::fs;
    /// use std::os::windows::fs::MetadataExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let attributes = fs::metadata("C:\\Windows")?.file_attributes();
    ///     assert(attributes & 0x10 != 0); // FILE_ATTRIBUTE_DIRECTORY
    ///     Ok(())
    /// }
    /// ```
    fn file_attributes(&self) -> u32;
    /// Returns the value of the `nFileSize` fields of this metadata.
    ///
    /// The returned value does not have meaning for directories. It is the same
    /// as [`Metadata::len`].
    ///
    /// # Examples
    ///
    /// ```ignore
    /// use std::fs;
    /// use std::os::windows::fs::MetadataExt;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let metadata = fs::metadata("foo.txt")?;
    ///     assert_eq(metadata.file_size(), metadata.len());
    ///     Ok(())
    /// }
    /// ```
    fn file_size(&self) -> u64;
}

impl MetadataExt for Metadata {
    fn file_attributes(&self) -> u32 {
        self.attr.attrib
    }

    fn file_size(&self) -> u64 {
        self.attr.size
    }
}
