//! Windows-specific extensions to primitives in the [`crate::process`] module.
//!
//! [`ExitStatusExt`] makes an [`ExitStatus`] from an exit code.

use crate::process::ExitStatus;

/// Windows-specific extensions to [`ExitStatus`].
///
/// On Windows an [`ExitStatus`] holds the process's exit code.
///
/// # Examples
///
/// ```ignore
/// use std::os::windows::process::ExitStatusExt;
/// use std::process::ExitStatus;
///
/// let status = ExitStatus::from_raw(1);
/// assert_eq(status.code(), Some(1));
/// ```
pub trait ExitStatusExt {
    /// Creates a new `ExitStatus` from the raw underlying `u32` return value of
    /// a process (its exit code, as `GetExitCodeProcess` gives it).
    ///
    /// # Examples
    ///
    /// ```ignore
    /// use std::os::windows::process::ExitStatusExt;
    /// use std::process::ExitStatus;
    ///
    /// assert(ExitStatus::from_raw(0).success());
    /// assert(!ExitStatus::from_raw(3).success());
    /// ```
    fn from_raw(raw: u32) -> Self;
}

impl ExitStatusExt for ExitStatus {
    fn from_raw(raw: u32) -> ExitStatus {
        ExitStatus { raw: raw as i32 }
    }
}
