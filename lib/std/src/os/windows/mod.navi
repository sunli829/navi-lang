//! Platform-specific extensions to `std` for Windows.
//!
//! Provides access to platform-level information for Windows, and exposes
//! Windows-specific idioms that would otherwise be inappropriate as part of the
//! core `std` library: [`fs`] has symbolic links to files and directories and
//! the file attributes; [`process`] makes an [`crate::process::ExitStatus`]
//! from an exit code.
//!
//! It exists only when the target is Windows.

pub mod fs;
pub mod process;
