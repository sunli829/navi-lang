//! OS-specific functionality.
//!
//! This module contains extensions to the cross-platform modules for the
//! platform the program is built for: [`unix`] on Unix-like systems (Linux,
//! macOS, Android, ...) and `windows` on Windows. Only the module of the target
//! platform exists, so code using it must be guarded with `#[cfg(...)]` to stay
//! portable.
//!
//! Each offers a subset of Rust's: `fs` (symbolic links, permission modes, raw
//! metadata) and `process` (wait statuses or exit codes). There is no
//! `std::os::fd` (`AsRawFd` and the like).
//!
//! # Examples
//!
//! ```
//! #[cfg(not(target_os = "windows"))]
//! use std::os::unix::fs::PermissionsExt;
//!
//! // Whether only the owner may access a file.
//! #[cfg(not(target_os = "windows"))]
//! fn is_private(m: &std::fs::Metadata) -> bool {
//!     m.permissions().mode() & 0o077 == 0
//! }
//! #[cfg(target_os = "windows")]
//! fn is_private(_m: &std::fs::Metadata) -> bool {
//!     false
//! }
//!
//! fn main() -> std::io::Result<()> {
//!     assert(!is_private(&std::fs::metadata("/")?));
//!     Ok(())
//! }
//! ```

#[cfg(not(target_os = "windows"))]
pub mod unix;
#[cfg(target_os = "windows")]
pub mod windows;
