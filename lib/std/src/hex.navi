//! Hexadecimal encoding, with the API of Rust's hex crate.
//!
//!     let s = hex::encode("Hello");                 // "48656c6c6f"
//!     let u = hex::encode_upper(&[0xcau8, 0xfe]);   // "CAFE"
//!     let v = hex::decode("48656c6c6f").unwrap();   // b"Hello"
//!     let k = <[u8; 2]>::from_hex("cafe").unwrap(); // [0xca, 0xfe]
//!
//! Decoding accepts either case and rejects anything else, including
//! whitespace and a "0x" prefix.

use crate::fmt::{self, Debug, Display, Formatter};
use crate::string::String;

/// Why a string is not hex.
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum FromHexError {
    /// A character that is not a hex digit, at a byte offset.
    InvalidHexCharacter { c: char, index: usize },
    /// An odd number of digits.
    OddLength,
    /// Decoding into a fixed-size buffer: the digits do not fill it exactly.
    InvalidStringLength,
}

impl Display for FromHexError {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        match self {
            FromHexError::InvalidHexCharacter { c, index } => f.write_fmt(`Invalid character ${*c:?} at position ${*index}`),
            FromHexError::OddLength => f.write_str("Odd number of digits"),
            FromHexError::InvalidStringLength => f.write_str("Invalid string length"),
        }
    }
}

static LOWER: [u8; 16] = [b'0', b'1', b'2', b'3', b'4', b'5', b'6', b'7', b'8', b'9', b'a', b'b', b'c', b'd', b'e', b'f'];
static UPPER: [u8; 16] = [b'0', b'1', b'2', b'3', b'4', b'5', b'6', b'7', b'8', b'9', b'A', b'B', b'C', b'D', b'E', b'F'];

fn encode_with(data: &[u8], digits: &[u8; 16]) -> String {
    let n = data.len();
    let mut v = Vec::with_capacity(2 * n);
    v.resize(2 * n, 0u8);
    let out = v.as_mut_slice();
    let mut i = 0;
    while i < n {
        let b = data[i];
        out[2 * i] = digits[(b >> 4) as usize];
        out[2 * i + 1] = digits[(b & 15) as usize];
        i += 1;
    }
    unsafe { String::from_utf8_unchecked(v) }
}

/// The lowercase hex digits of data.
pub fn encode<T: AsRef<[u8]>>(data: T) -> String { encode_with(data.as_ref(), &LOWER) }

/// The uppercase hex digits of data.
pub fn encode_upper<T: AsRef<[u8]>>(data: T) -> String { encode_with(data.as_ref(), &UPPER) }

// The value of a hex digit, or 255.
fn digit(c: u8) -> u8 {
    if c >= b'0' && c <= b'9' {
        c - b'0'
    } else if c >= b'a' && c <= b'f' {
        c - b'a' + 10
    } else if c >= b'A' && c <= b'F' {
        c - b'A' + 10
    } else {
        255
    }
}

fn decode_into(data: &[u8], out: &mut [u8]) -> Result<(), FromHexError> {
    let mut i = 0;
    while i < out.len() {
        let hi = digit(data[2 * i]);
        if hi == 255 { return Err(FromHexError::InvalidHexCharacter { c: data[2 * i] as char, index: 2 * i }); }
        let lo = digit(data[2 * i + 1]);
        if lo == 255 { return Err(FromHexError::InvalidHexCharacter { c: data[2 * i + 1] as char, index: 2 * i + 1 }); }
        out[i] = hi << 4 | lo;
        i += 1;
    }
    Ok(())
}

/// The bytes that the hex digits in data stand for.
pub fn decode<T: AsRef<[u8]>>(data: T) -> Result<Vec<u8>, FromHexError> {
    let d = data.as_ref();
    if d.len() % 2 != 0 { return Err(FromHexError::OddLength); }
    let mut v = Vec::with_capacity(d.len() / 2);
    v.resize(d.len() / 2, 0u8);
    decode_into(d, v.as_mut_slice())?;
    Ok(v)
}

/// Decodes into out, which the digits must fill exactly.
pub fn decode_to_slice<T: AsRef<[u8]>>(data: T, out: &mut [u8]) -> Result<(), FromHexError> {
    let d = data.as_ref();
    if d.len() % 2 != 0 { return Err(FromHexError::OddLength); }
    if d.len() / 2 != out.len() { return Err(FromHexError::InvalidStringLength); }
    decode_into(d, out)
}

/// Writes the lowercase digits of input to output, which must be twice
/// as long.
pub fn encode_to_slice<T: AsRef<[u8]>>(input: T, output: &mut [u8]) -> Result<(), FromHexError> {
    let d = input.as_ref();
    if d.len() * 2 != output.len() { return Err(FromHexError::InvalidStringLength); }
    let mut i = 0;
    while i < d.len() {
        output[2 * i] = LOWER[(d[i] >> 4) as usize];
        output[2 * i + 1] = LOWER[(d[i] & 15) as usize];
        i += 1;
    }
    Ok(())
}

/// Values that can be written as hex: everything that is `AsRef<[u8]>`.
pub trait ToHex {
    /// The lowercase hex digits.
    fn encode_hex(&self) -> String;
    /// The uppercase hex digits.
    fn encode_hex_upper(&self) -> String;
}

impl<T: AsRef<[u8]>> ToHex for T {
    fn encode_hex(&self) -> String { encode_with(self.as_ref(), &LOWER) }
    fn encode_hex_upper(&self) -> String { encode_with(self.as_ref(), &UPPER) }
}

/// Values that can be read from hex: `Vec<u8>` and byte arrays.
pub trait FromHex {
    type Error;
    fn from_hex<T: AsRef<[u8]>>(hex: T) -> Result<Self, Self::Error>;
}

impl FromHex for Vec<u8> {
    type Error = FromHexError;
    fn from_hex<T: AsRef<[u8]>>(hex: T) -> Result<Vec<u8>, FromHexError> { decode(hex) }
}

impl<const N: usize> FromHex for [u8; N] {
    type Error = FromHexError;
    fn from_hex<T: AsRef<[u8]>>(hex: T) -> Result<[u8; N], FromHexError> {
        let mut out = [0u8; N];
        decode_to_slice(hex, &mut out)?;
        Ok(out)
    }
}
