//! Encoding and decoding hexadecimal strings, with the API of Rust's
//! `hex` crate.
//!
//! [`encode`] and [`encode_upper`] write each byte as two hex digits;
//! [`decode`] reads them back. The [`ToHex`] and [`FromHex`] traits do the
//! same as methods, and [`FromHex`] can decode into a fixed-size byte
//! array.
//!
//! Decoding accepts digits of either case and rejects anything else,
//! including whitespace and a `0x` prefix.
//!
//! # Examples
//!
//! ```
//! use std::hex::{self, FromHex};
//!
//! assert_eq(hex::encode("Hello"), "48656c6c6f");
//! assert_eq(hex::encode_upper(b"\xca\xfe"), "CAFE");
//! assert_eq(hex::decode("48656c6c6f").unwrap(), b"Hello");
//! assert_eq(<[u8; 2]>::from_hex("cafe").unwrap(), [0xca, 0xfe]);
//! ```

use crate::fmt::{self, Debug, Display, Formatter};
use crate::string::String;

/// The error returned when a string is not valid hex.
///
/// # Examples
///
/// ```
/// use std::hex::{self, FromHexError};
///
/// assert_eq(hex::decode("abc"), Err(FromHexError::OddLength));
/// assert_eq(hex::decode("0x"), Err(FromHexError::InvalidHexCharacter { c: 'x', index: 1 }));
/// assert_eq(hex::decode("0x").unwrap_err().to_string(), "Invalid character 'x' at position 1");
/// ```
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum FromHexError {
    /// A character that is not a hex digit, at a byte offset.
    InvalidHexCharacter { c: char, index: usize },
    /// An odd number of digits.
    OddLength,
    /// Decoding into a fixed-size buffer: the digits do not fill it exactly.
    InvalidStringLength,
}

impl Display for FromHexError {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        match self {
            FromHexError::InvalidHexCharacter { c, index } => {
                f.write_fmt(`Invalid character ${*c:?} at position ${*index}`)
            }
            FromHexError::OddLength => f.write_str("Odd number of digits"),
            FromHexError::InvalidStringLength => f.write_str("Invalid string length"),
        }
    }
}

static LOWER: [u8; 16] = [
    b'0', b'1', b'2', b'3', b'4', b'5', b'6', b'7', b'8', b'9', b'a', b'b', b'c', b'd', b'e', b'f',
];
static UPPER: [u8; 16] = [
    b'0', b'1', b'2', b'3', b'4', b'5', b'6', b'7', b'8', b'9', b'A', b'B', b'C', b'D', b'E', b'F',
];

fn encode_with(data: &[u8], digits: &[u8; 16]) -> String {
    let n = data.len();
    let mut v = Vec::with_capacity(2 * n);
    v.resize(2 * n, 0u8);
    let out = v.as_mut_slice();
    let mut i = 0;
    while i < n {
        let b = data[i];
        out[2 * i] = digits[(b >> 4) as usize];
        out[2 * i + 1] = digits[(b & 15) as usize];
        i += 1;
    }
    unsafe { String::from_utf8_unchecked(v) }
}

/// Encodes `data` as a string of lowercase hex digits, two per byte.
///
/// # Examples
///
/// ```
/// assert_eq(std::hex::encode("kiwi"), "6b697769");
/// assert_eq(std::hex::encode(b"\x00\xff"), "00ff");
/// assert_eq(std::hex::encode(Vec::from([1u8, 2, 255])), "0102ff");
/// ```
pub fn encode<T: AsRef<[u8]>>(data: T) -> String {
    encode_with(data.as_ref(), &LOWER)
}

/// Encodes `data` as a string of uppercase hex digits, two per byte.
///
/// # Examples
///
/// ```
/// assert_eq(std::hex::encode_upper("kiwi"), "6B697769");
/// assert_eq(std::hex::encode_upper(b"\xde\xad"), "DEAD");
/// ```
pub fn encode_upper<T: AsRef<[u8]>>(data: T) -> String {
    encode_with(data.as_ref(), &UPPER)
}

// The value of a hex digit, or 255.
fn digit(c: u8) -> u8 {
    if c >= b'0' && c <= b'9' {
        c - b'0'
    } else if c >= b'a' && c <= b'f' {
        c - b'a' + 10
    } else if c >= b'A' && c <= b'F' {
        c - b'A' + 10
    } else {
        255
    }
}

fn decode_into(data: &[u8], out: &mut [u8]) -> Result<(), FromHexError> {
    let mut i = 0;
    while i < out.len() {
        let hi = digit(data[2 * i]);
        if hi == 255 {
            return Err(FromHexError::InvalidHexCharacter {
                c: data[2 * i] as char,
                index: 2 * i,
            });
        }
        let lo = digit(data[2 * i + 1]);
        if lo == 255 {
            return Err(FromHexError::InvalidHexCharacter {
                c: data[2 * i + 1] as char,
                index: 2 * i + 1,
            });
        }
        out[i] = hi << 4 | lo;
        i += 1;
    }
    Ok(())
}

/// Decodes a string of hex digits into the bytes it stands for.
///
/// Digits may be lowercase or uppercase.
///
/// # Errors
///
/// [`FromHexError::OddLength`] if `data` has an odd number of characters,
/// and [`FromHexError::InvalidHexCharacter`] (with the first offending
/// character and its byte offset) if a character is not a hex digit.
///
/// # Examples
///
/// ```
/// use std::hex::{self, FromHexError};
///
/// assert_eq(hex::decode("48656C6c6f").unwrap(), b"Hello");
/// assert_eq(hex::decode("123"), Err(FromHexError::OddLength));
/// assert_eq(hex::decode("foo"), Err(FromHexError::OddLength));
/// assert_eq(hex::decode("fo"), Err(FromHexError::InvalidHexCharacter { c: 'o', index: 1 }));
/// ```
pub fn decode<T: AsRef<[u8]>>(data: T) -> Result<Vec<u8>, FromHexError> {
    let d = data.as_ref();
    if d.len() % 2 != 0 {
        return Err(FromHexError::OddLength);
    }
    let mut v = Vec::with_capacity(d.len() / 2);
    v.resize(d.len() / 2, 0u8);
    decode_into(d, v.as_mut_slice())?;
    Ok(v)
}

/// Decodes a string of hex digits into `out`, which the decoded bytes must
/// fill exactly.
///
/// # Errors
///
/// [`FromHexError::OddLength`] if `data` has an odd number of characters,
/// [`FromHexError::InvalidStringLength`] if it does not decode to exactly
/// `out.len()` bytes, and [`FromHexError::InvalidHexCharacter`] if a
/// character is not a hex digit.
///
/// # Examples
///
/// ```
/// use std::hex::{self, FromHexError};
///
/// let mut bytes = [0u8; 4];
/// assert_eq(hex::decode_to_slice("6b697769", &mut bytes), Ok(()));
/// assert_eq(&bytes[..], b"kiwi");
/// assert_eq(hex::decode_to_slice("6b69", &mut bytes), Err(FromHexError::InvalidStringLength));
/// ```
pub fn decode_to_slice<T: AsRef<[u8]>>(data: T, out: &mut [u8]) -> Result<(), FromHexError> {
    let d = data.as_ref();
    if d.len() % 2 != 0 {
        return Err(FromHexError::OddLength);
    }
    if d.len() / 2 != out.len() {
        return Err(FromHexError::InvalidStringLength);
    }
    decode_into(d, out)
}

/// Writes the lowercase hex digits of `input` into `output`, which must be
/// exactly twice as long as `input`.
///
/// # Errors
///
/// [`FromHexError::InvalidStringLength`] if `output.len()` is not
/// `2 * input.len()`; `output` is left unchanged then.
///
/// # Examples
///
/// ```
/// use std::hex::{self, FromHexError};
///
/// let mut out = [0u8; 4];
/// assert_eq(hex::encode_to_slice(b"\x01\xab", &mut out), Ok(()));
/// assert_eq(&out[..], b"01ab");
/// assert_eq(hex::encode_to_slice(b"\x01", &mut out), Err(FromHexError::InvalidStringLength));
/// ```
pub fn encode_to_slice<T: AsRef<[u8]>>(input: T, output: &mut [u8]) -> Result<(), FromHexError> {
    let d = input.as_ref();
    if d.len() * 2 != output.len() {
        return Err(FromHexError::InvalidStringLength);
    }
    let mut i = 0;
    while i < d.len() {
        output[2 * i] = LOWER[(d[i] >> 4) as usize];
        output[2 * i + 1] = LOWER[(d[i] & 15) as usize];
        i += 1;
    }
    Ok(())
}

/// Encoding values as hex strings.
///
/// Implemented for every type that is `AsRef<[u8]>` (strings, byte slices,
/// byte arrays, `Vec<u8>`).
///
/// # Examples
///
/// ```
/// use std::hex::ToHex;
///
/// assert_eq("Hi".encode_hex(), "4869");
/// assert_eq(Vec::from([0xabu8, 0xcd]).encode_hex_upper(), "ABCD");
/// ```
pub trait ToHex {
    /// The lowercase hex digits.
    fn encode_hex(&self) -> String;
    /// The uppercase hex digits.
    fn encode_hex_upper(&self) -> String;
}

impl<T: AsRef<[u8]>> ToHex for T {
    fn encode_hex(&self) -> String {
        encode_with(self.as_ref(), &LOWER)
    }

    fn encode_hex_upper(&self) -> String {
        encode_with(self.as_ref(), &UPPER)
    }
}

/// Decoding values from hex strings.
///
/// Implemented for `Vec<u8>` (any even number of digits) and for byte
/// arrays `[u8; N]` (exactly `2 * N` digits).
///
/// # Examples
///
/// ```
/// use std::hex::{FromHex, FromHexError};
///
/// assert_eq(Vec::<u8>::from_hex("0102"), Ok(Vec::from([1u8, 2])));
/// assert_eq(<[u8; 4]>::from_hex("deadbeef"), Ok([0xde, 0xad, 0xbe, 0xef]));
/// assert_eq(<[u8; 4]>::from_hex("dead"), Err(FromHexError::InvalidStringLength));
/// ```
pub trait FromHex {
    /// The error returned when decoding fails.
    type Error;
    /// Decodes `hex` into a value of this type.
    ///
    /// # Errors
    ///
    /// The implementations return a [`FromHexError`].
    fn from_hex<T: AsRef<[u8]>>(hex: T) -> Result<Self, Self::Error>;
}

impl FromHex for Vec<u8> {
    type Error = FromHexError;
    fn from_hex<T: AsRef<[u8]>>(hex: T) -> Result<Vec<u8>, FromHexError> {
        decode(hex)
    }
}

impl<const N: usize> FromHex for [u8; N] {
    type Error = FromHexError;
    fn from_hex<T: AsRef<[u8]>>(hex: T) -> Result<[u8; N], FromHexError> {
        let mut out = [0u8; N];
        decode_to_slice(hex, &mut out)?;
        Ok(out)
    }
}
