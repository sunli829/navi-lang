//! Utilities for the array primitive type, `[T; N]`, and impls for arrays of
//! any length (with const generics).
//!
//! An array is a fixed-size sequence of `N` elements of type `T`, written
//! `[a, b, c]` or `[x; N]` (`N` copies of `x`). Arrays are values: assigning
//! an array copies its elements (shallowly, as every assignment in navi).
//!
//! The methods of slices are available on arrays (they are called on a slice
//! of the whole array); this module adds `as_slice`, `map`, the by-value
//! iterator [`IntoIter`], and the impls of `IntoIterator`, `AsRef<[T]>`,
//! `Default`, `From<[T; N]> for Vec<T>`, `PartialEq<[T; N]> for Vec<T>` and
//! `Concat` for arrays.
//!
//! # Examples
//!
//! ```
//! let mut a = [3, 1, 2];
//! a.sort();
//! assert_eq(a, [1, 2, 3]);
//!
//! let b = a; // a copy
//! a[0] = 10;
//! assert_eq(b[0], 1);
//!
//! let v = Vec::from(a);
//! assert_eq(v, [10, 2, 3]);
//!
//! let mut sum = 0;
//! for x in [1, 2, 3] {
//!     sum += x;
//! }
//! assert_eq(sum, 6);
//! ```

use crate::{convert::From, str::pattern::Pattern, vec::Vec};

impl<T: Clone, const N: usize> From<[T; N]> for Vec<T> {
    /// Converts an array into a [`Vec`], cloning each element.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(Vec::from([1, 2, 3]), [1, 2, 3]);
    /// ```
    fn from(a: [T; N]) -> Vec<T> {
        let mut v = Vec::with_capacity(N);
        for x in a.iter() {
            v.push(x.clone());
        }
        v
    }
}

impl<T, const N: usize> [T; N] {
    /// Returns a slice of the whole array.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = [1, 2, 3];
    /// let s: &[i32] = a.as_slice();
    /// assert_eq(s.len(), 3);
    /// assert_eq(s, &[1, 2, 3][..]);
    /// ```
    pub fn as_slice(&self) -> &[T] {
        crate::rt::slice_from_raw(self as *const [T; N] as *const T, N)
    }

    /// Returns a mutable slice of the whole array.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut a = [1, 2, 3];
    /// let s = a.as_mut_slice();
    /// s[0] = 7;
    /// assert_eq(a, [7, 2, 3]);
    /// ```
    pub fn as_mut_slice(&mut self) -> &mut [T] {
        crate::rt::slice_from_raw_mut(self as *mut [T; N] as *mut T, N)
    }

    /// Returns an array of the same length, with `f` applied to each element in
    /// order.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = [1, 2, 3];
    /// let y = x.map(|v| v + 1);
    /// assert_eq(y, [2, 3, 4]);
    ///
    /// let x = [1, 2, 3];
    /// let y = x.map(|v| v.to_string());
    /// assert_eq(y[2], "3");
    /// ```
    pub fn map<U>(self, f: fn(T) -> U) -> [U; N] {
        let p = crate::rt::alloc_array::<U>(if N == 0 { 1 } else { N });
        let mut i = 0;
        while i < N {
            unsafe {
                p.add(i).write(f(self[i]));
            }
            i += 1;
        }
        unsafe { *(p as *const [U; N]) }
    }
}

/// An iterator yielding the elements of an array by value.
///
/// Made by the `into_iter` method of arrays (from the
/// [`IntoIterator`](crate::iter::IntoIterator) trait), as in a `for` loop
/// over an array. The iterator holds a copy of the array.
///
/// # Examples
///
/// ```
/// let a = [1, 2, 3];
/// let mut it = a.into_iter();
/// assert_eq(it.next(), Some(1));
/// assert_eq(it.next_back(), Some(3));
/// assert_eq(it.len(), 1);
/// ```
pub struct IntoIter<T, const N: usize> {
    a: [T; N],
    i: usize,
    end: usize,
}

impl<T, const N: usize> IntoIter<T, N> {
    /// Returns the elements not yet yielded, as a slice.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut it = ['a', 'b', 'c'].into_iter();
    /// assert_eq(it.as_slice(), &['a', 'b', 'c'][..]);
    /// let _ = it.next().unwrap();
    /// assert_eq(it.as_slice(), &['b', 'c'][..]);
    /// ```
    pub fn as_slice(&self) -> &[T] {
        &self.a.as_slice()[self.i..self.end]
    }
}

impl<T, const N: usize> Iterator for IntoIter<T, N> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        if self.i < self.end {
            let x = self.a[self.i];
            self.i += 1;
            Some(x)
        } else {
            None
        }
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        (self.end - self.i, Some(self.end - self.i))
    }
}

impl<T, const N: usize> DoubleEndedIterator for IntoIter<T, N> {
    fn next_back(&mut self) -> Option<T> {
        if self.i < self.end {
            self.end -= 1;
            Some(self.a[self.end])
        } else {
            None
        }
    }
}

impl<T, const N: usize> ExactSizeIterator for IntoIter<T, N> {}

impl<T, const N: usize> Clone for IntoIter<T, N> {
    fn clone(&self) -> IntoIter<T, N> {
        IntoIter {
            a: self.a,
            i: self.i,
            end: self.end,
        }
    }
}

impl<T, const N: usize> IntoIterator for [T; N] {
    type Item = T;
    type IntoIter = IntoIter<T, N>;
    fn into_iter(self) -> IntoIter<T, N> {
        IntoIter {
            a: self,
            i: 0,
            end: N,
        }
    }
}

impl<T, const N: usize> IntoIterator for &[T; N] {
    type Item = &T;
    type IntoIter = crate::slice::Iter<T>;
    fn into_iter(self) -> crate::slice::Iter<T> {
        self.as_slice().iter()
    }
}

impl<T, const N: usize> IntoIterator for &mut [T; N] {
    type Item = &mut T;
    type IntoIter = crate::slice::IterMut<T>;
    fn into_iter(self) -> crate::slice::IterMut<T> {
        self.as_mut_slice().iter_mut()
    }
}

impl<T, const N: usize> AsRef<[T]> for [T; N] {
    fn as_ref(&self) -> &[T] {
        self.as_slice()
    }
}

impl<T, const N: usize> AsMut<[T]> for [T; N] {
    fn as_mut(&mut self) -> &mut [T] {
        self.as_mut_slice()
    }
}

impl<T: Default, const N: usize> Default for [T; N] {
    /// Returns an array with the default value of `T` in each element.
    ///
    /// # Examples
    ///
    /// ```
    /// let a: [i32; 3] = Default::default();
    /// assert_eq(a, [0, 0, 0]);
    /// ```
    fn default() -> [T; N] {
        let p = crate::rt::alloc_array::<T>(if N == 0 { 1 } else { N });
        let mut i = 0;
        while i < N {
            unsafe {
                p.add(i).write(T::default());
            }
            i += 1;
        }
        unsafe { *(p as *const [T; N]) }
    }
}

// Impls of other modules for arrays of any length.

impl<const N: usize> Pattern for [char; N] {
    fn next_match(&self, hay: &str, from: usize) -> Option<(usize, usize)> {
        self.as_slice().next_match(hay, from)
    }

    fn last_match(&self, hay: &str) -> Option<(usize, usize)> {
        self.as_slice().last_match(hay)
    }

    fn prefix_len(&self, hay: &str) -> Option<usize> {
        self.as_slice().prefix_len(hay)
    }

    fn suffix_len(&self, hay: &str) -> Option<usize> {
        self.as_slice().suffix_len(hay)
    }
}

impl<const N: usize> Pattern for &[char; N] {
    fn next_match(&self, hay: &str, from: usize) -> Option<(usize, usize)> {
        self.as_slice().next_match(hay, from)
    }

    fn last_match(&self, hay: &str) -> Option<(usize, usize)> {
        self.as_slice().last_match(hay)
    }

    fn prefix_len(&self, hay: &str) -> Option<usize> {
        self.as_slice().prefix_len(hay)
    }

    fn suffix_len(&self, hay: &str) -> Option<usize> {
        self.as_slice().suffix_len(hay)
    }
}

impl<T: Clone, const N: usize> crate::slice::Concat for [[T; N]] {
    type Output = crate::vec::Vec<T>;
    fn concat(slice: &[[T; N]]) -> crate::vec::Vec<T> {
        let mut out = crate::vec::Vec::with_capacity(slice.len() * N);
        for a in slice {
            out.extend_from_slice(a.as_slice());
        }
        out
    }
}

impl<T: PartialEq, const N: usize> PartialEq<[T; N]> for Vec<T> {
    fn eq(&self, other: &[T; N]) -> bool {
        self.as_slice() == other.as_slice()
    }
}
