//! Impls for arrays of any length (with const generics).

use crate::vec::Vec;
use crate::convert::From;
use crate::str::pattern::Pattern;

impl<T: Clone, const N: usize> From<[T; N]> for Vec<T> {
    fn from(a: [T; N]) -> Vec<T> {
        let mut v = Vec::with_capacity(N);
        for x in a.iter() { v.push(x.clone()); }
        v
    }
}

impl<T, const N: usize> [T; N] {
    pub fn as_slice(&self) -> &[T] { crate::rt::slice_from_raw(self as *const [T; N] as *const T, N) }
    pub fn as_mut_slice(&mut self) -> &mut [T] { crate::rt::slice_from_raw_mut(self as *mut [T; N] as *mut T, N) }

    /// An array of f applied to each element.
    pub fn map<U>(self, f: fn(T) -> U) -> [U; N] {
        let p = crate::rt::alloc_array::<U>(if N == 0 { 1 } else { N });
        let mut i = 0;
        while i < N {
            unsafe { p.add(i).write(f(self[i])); }
            i += 1;
        }
        unsafe { *(p as *const [U; N]) }
    }
}

/// The by-value iterator of an array.
pub struct IntoIter<T, const N: usize> { a: [T; N], i: usize, end: usize }

impl<T, const N: usize> IntoIter<T, N> {
    /// The elements not yet yielded.
    pub fn as_slice(&self) -> &[T] { &self.a.as_slice()[self.i..self.end] }
}

impl<T, const N: usize> Iterator for IntoIter<T, N> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        if self.i < self.end {
            let x = self.a[self.i];
            self.i += 1;
            Some(x)
        } else {
            None
        }
    }
    fn size_hint(&self) -> (usize, Option<usize>) { (self.end - self.i, Some(self.end - self.i)) }
}

impl<T, const N: usize> DoubleEndedIterator for IntoIter<T, N> {
    fn next_back(&mut self) -> Option<T> {
        if self.i < self.end {
            self.end -= 1;
            Some(self.a[self.end])
        } else {
            None
        }
    }
}

impl<T, const N: usize> ExactSizeIterator for IntoIter<T, N> {}

impl<T, const N: usize> Clone for IntoIter<T, N> {
    fn clone(&self) -> IntoIter<T, N> { IntoIter { a: self.a, i: self.i, end: self.end } }
}

impl<T, const N: usize> IntoIterator for [T; N] {
    type Item = T;
    type IntoIter = IntoIter<T, N>;
    fn into_iter(self) -> IntoIter<T, N> { IntoIter { a: self, i: 0, end: N } }
}

impl<T, const N: usize> IntoIterator for &[T; N] {
    type Item = &T;
    type IntoIter = crate::slice::Iter<T>;
    fn into_iter(self) -> crate::slice::Iter<T> { self.as_slice().iter() }
}

impl<T, const N: usize> IntoIterator for &mut [T; N] {
    type Item = &mut T;
    type IntoIter = crate::slice::IterMut<T>;
    fn into_iter(self) -> crate::slice::IterMut<T> { self.as_mut_slice().iter_mut() }
}

impl<T, const N: usize> AsRef<[T]> for [T; N] { fn as_ref(&self) -> &[T] { self.as_slice() } }
impl<T, const N: usize> AsMut<[T]> for [T; N] { fn as_mut(&mut self) -> &mut [T] { self.as_mut_slice() } }

impl<T: Default, const N: usize> Default for [T; N] {
    fn default() -> [T; N] {
        let p = crate::rt::alloc_array::<T>(if N == 0 { 1 } else { N });
        let mut i = 0;
        while i < N {
            unsafe { p.add(i).write(T::default()); }
            i += 1;
        }
        unsafe { *(p as *const [T; N]) }
    }
}

// Impls of other modules for arrays of any length.

impl<const N: usize> Pattern for [char; N] {
    fn next_match(&self, hay: &str, from: usize) -> Option<(usize, usize)> { self.as_slice().next_match(hay, from) }
    fn last_match(&self, hay: &str) -> Option<(usize, usize)> { self.as_slice().last_match(hay) }
    fn prefix_len(&self, hay: &str) -> Option<usize> { self.as_slice().prefix_len(hay) }
    fn suffix_len(&self, hay: &str) -> Option<usize> { self.as_slice().suffix_len(hay) }
}

impl<const N: usize> Pattern for &[char; N] {
    fn next_match(&self, hay: &str, from: usize) -> Option<(usize, usize)> { self.as_slice().next_match(hay, from) }
    fn last_match(&self, hay: &str) -> Option<(usize, usize)> { self.as_slice().last_match(hay) }
    fn prefix_len(&self, hay: &str) -> Option<usize> { self.as_slice().prefix_len(hay) }
    fn suffix_len(&self, hay: &str) -> Option<usize> { self.as_slice().suffix_len(hay) }
}

impl<T: Clone, const N: usize> crate::slice::Concat for [[T; N]] {
    type Output = crate::vec::Vec<T>;
    fn concat(slice: &[[T; N]]) -> crate::vec::Vec<T> {
        let mut out = crate::vec::Vec::with_capacity(slice.len() * N);
        for a in slice { out.extend_from_slice(a.as_slice()); }
        out
    }
}

impl<T: PartialEq, const N: usize> PartialEq<[T; N]> for Vec<T> {
    fn eq(&self, other: &[T; N]) -> bool { self.as_slice() == other.as_slice() }
}

