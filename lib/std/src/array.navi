//! Impls for arrays of any length (they need const generics, which only
//! navic has: this module is hidden from stage0).

use crate::vec::Vec;
use crate::convert::From;

impl<T: Clone, const N: usize> From<[T; N]> for Vec<T> {
    fn from(a: [T; N]) -> Vec<T> {
        let mut v = Vec::with_capacity(N);
        for x in a.iter() { v.push(x.clone()); }
        v
    }
}

/// An array by value iterates over its elements (as in Rust 2021).
/// (Elements are copied shallowly, as every value in navi.)
impl<T, const N: usize> crate::iter::IntoIterator for [T; N] {
    type Item = T;
    type IntoIter = crate::vec::IntoIter<T>;
    fn into_iter(self) -> crate::vec::IntoIter<T> {
        let mut v: Vec<T> = Vec::with_capacity(N);
        let mut i = 0;
        while i < N {
            v.push(self[i]);
            i += 1;
        }
        v.into_iter()
    }
}
