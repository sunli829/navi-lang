//! Slices: GC-managed (pointer, length) views.

pub struct Iter<T> { ptr: *const T, end: *const T }
impl<T> Iterator for Iter<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> { todo() }
}

pub struct IterMut<T> { ptr: *mut T, end: *mut T }
impl<T> Iterator for IterMut<T> {
    type Item = &mut T;
    fn next(&mut self) -> Option<&mut T> { todo() }
}

impl<T> [T] {
    pub fn len(&self) -> usize { todo() }
    pub fn is_empty(&self) -> bool { self.len() == 0 }
    pub fn as_ptr(&self) -> *const T { todo() }
    pub fn as_mut_ptr(&mut self) -> *mut T { todo() }
    pub fn iter(&self) -> Iter<T> { todo() }
    pub fn iter_mut(&mut self) -> IterMut<T> { todo() }
    pub fn first(&self) -> Option<&T> { todo() }
    pub fn last(&self) -> Option<&T> { todo() }
    pub fn get(&self, index: usize) -> Option<&T> { todo() }
    pub fn get_mut(&mut self, index: usize) -> Option<&mut T> { todo() }
    pub fn swap(&mut self, a: usize, b: usize) { todo() }
    pub fn reverse(&mut self) { todo() }
}

impl<T: PartialEq> [T] {
    pub fn contains(&self, x: &T) -> bool { todo() }
}

impl<T: Clone> [T] {
    pub fn to_vec(&self) -> crate::vec::Vec<T> { crate::vec::Vec::from(self) }
}

impl<T: Ord> [T] {
    pub fn sort(&mut self) { todo() }
}

impl<T> IntoIterator for &[T] {
    type Item = &T;
    type IntoIter = Iter<T>;
    fn into_iter(self) -> Iter<T> { self.iter() }
}

impl<T> IntoIterator for &mut [T] {
    type Item = &mut T;
    type IntoIter = IterMut<T>;
    fn into_iter(self) -> IterMut<T> { self.iter_mut() }
}
