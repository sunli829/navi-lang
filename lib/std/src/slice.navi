//! Slices: GC-managed (pointer, length) views.

pub struct Iter<T> { ptr: *const T, end: *const T }
impl<T> Iterator for Iter<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> { todo() }
}

pub struct IterMut<T> { ptr: *mut T, end: *mut T }
impl<T> Iterator for IterMut<T> {
    type Item = &mut T;
    fn next(&mut self) -> Option<&mut T> { todo() }
}
