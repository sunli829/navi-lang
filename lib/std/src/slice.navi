//! Slices: GC-managed (pointer, length) views.

use crate::cmp::Ordering;

pub struct Iter<T> { s: &[T], i: usize, end: usize }
impl<T> Iterator for Iter<T> {
    type Item = &T;
    #[inline]
    fn next(&mut self) -> Option<&T> {
        if self.i < self.end {
            let r = &self.s[self.i];
            self.i += 1;
            Some(r)
        } else {
            None
        }
    }
    fn size_hint(&self) -> (usize, Option<usize>) { (self.end - self.i, Some(self.end - self.i)) }
}
impl<T> DoubleEndedIterator for Iter<T> {
    fn next_back(&mut self) -> Option<&T> {
        if self.i < self.end {
            self.end -= 1;
            Some(&self.s[self.end])
        } else {
            None
        }
    }
}
impl<T> ExactSizeIterator for Iter<T> {}

pub struct IterMut<T> { s: &mut [T], i: usize, end: usize }
impl<T> Iterator for IterMut<T> {
    type Item = &mut T;
    #[inline]
    fn next(&mut self) -> Option<&mut T> {
        if self.i < self.end {
            let r = &mut self.s[self.i];
            self.i += 1;
            Some(r)
        } else {
            None
        }
    }
    fn size_hint(&self) -> (usize, Option<usize>) { (self.end - self.i, Some(self.end - self.i)) }
}
impl<T> DoubleEndedIterator for IterMut<T> {
    fn next_back(&mut self) -> Option<&mut T> {
        if self.i < self.end {
            self.end -= 1;
            Some(&mut self.s[self.end])
        } else {
            None
        }
    }
}

pub struct Windows<T> { s: &[T], size: usize, i: usize }
impl<T> Iterator for Windows<T> {
    type Item = &[T];
    fn next(&mut self) -> Option<&[T]> {
        if self.i + self.size > self.s.len() { return None; }
        let w = &self.s[self.i..self.i + self.size];
        self.i += 1;
        Some(w)
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        let n = if self.i + self.size > self.s.len() { 0 } else { self.s.len() - self.size - self.i + 1 };
        (n, Some(n))
    }
}

pub struct Chunks<T> { s: &[T], size: usize, i: usize }
impl<T> Iterator for Chunks<T> {
    type Item = &[T];
    fn next(&mut self) -> Option<&[T]> {
        if self.i >= self.s.len() { return None; }
        let end = if self.i + self.size > self.s.len() { self.s.len() } else { self.i + self.size };
        let c = &self.s[self.i..end];
        self.i = end;
        Some(c)
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        let n = (self.s.len() - self.i + self.size - 1) / self.size;
        (n, Some(n))
    }
}

// Stable merge sort of s by cmp (insertion sort for short runs).
fn merge_sort<T>(s: &mut [T], cmp: fn(&T, &T) -> Ordering) {
    let n = s.len();
    if n <= 16 {
        let mut i = 1;
        while i < n {
            let mut j = i;
            while j > 0 && cmp(&s[j - 1], &s[j]) == Ordering::Greater {
                s.swap(j - 1, j);
                j -= 1;
            }
            i += 1;
        }
        return;
    }
    let mid = n / 2;
    merge_sort(&mut s[0..mid], cmp);
    merge_sort(&mut s[mid..n], cmp);
    if cmp(&s[mid - 1], &s[mid]) != Ordering::Greater { return; }
    let mut tmp: crate::vec::Vec<T> = crate::vec::Vec::with_capacity(n);
    let mut i = 0;
    let mut j = mid;
    while i < mid && j < n {
        if cmp(&s[j], &s[i]) == Ordering::Less {
            tmp.push(s[j]);
            j += 1;
        } else {
            tmp.push(s[i]);
            i += 1;
        }
    }
    while i < mid { tmp.push(s[i]); i += 1; }
    while j < n { tmp.push(s[j]); j += 1; }
    let mut k = 0;
    while k < n { s[k] = tmp[k]; k += 1; }
}

impl<T> [T] {
    pub fn len(&self) -> usize { crate::rt::slice_len(self) }
    pub fn is_empty(&self) -> bool { self.len() == 0 }
    pub fn as_ptr(&self) -> *const T { crate::rt::slice_ptr(self) }
    pub fn iter(&self) -> Iter<T> { Iter { s: self, i: 0, end: self.len() } }
    pub fn iter_mut(&mut self) -> IterMut<T> { let n = self.len(); IterMut { s: self, i: 0, end: n } }
    pub fn first_mut(&mut self) -> Option<&mut T> { if self.len() == 0 { None } else { Some(&mut self[0]) } }
    pub fn last_mut(&mut self) -> Option<&mut T> { let n = self.len(); if n == 0 { None } else { Some(&mut self[n - 1]) } }
    pub fn split_first(&self) -> Option<(&T, &[T])> { if self.len() == 0 { None } else { Some((&self[0], &self[1..])) } }
    pub fn split_last(&self) -> Option<(&T, &[T])> {
        let n = self.len();
        if n == 0 { None } else { Some((&self[n - 1], &self[0..n - 1])) }
    }
    pub fn split_at(&self, mid: usize) -> (&[T], &[T]) { (&self[0..mid], &self[mid..]) }
    pub fn windows(&self, size: usize) -> Windows<T> { Windows { s: self, size, i: 0 } }
    pub fn chunks(&self, size: usize) -> Chunks<T> { Chunks { s: self, size, i: 0 } }
    pub fn sort_by(&mut self, cmp: fn(&T, &T) -> Ordering) { merge_sort(self, cmp); }
    pub fn sort_unstable_by(&mut self, cmp: fn(&T, &T) -> Ordering) { merge_sort(self, cmp); }
    pub fn sort_by_key<K: Ord>(&mut self, f: fn(&T) -> K) { merge_sort(self, |a: &T, b: &T| f(a).cmp(&f(b))); }
    pub fn sort_unstable_by_key<K: Ord>(&mut self, f: fn(&T) -> K) { merge_sort(self, |a: &T, b: &T| f(a).cmp(&f(b))); }
    pub fn binary_search_by(&self, f: fn(&T) -> Ordering) -> Result<usize, usize> {
        let mut lo = 0;
        let mut hi = self.len();
        while lo < hi {
            let mid = lo + (hi - lo) / 2;
            match f(&self[mid]) {
                Ordering::Less => { lo = mid + 1; }
                Ordering::Greater => { hi = mid; }
                Ordering::Equal => return Ok(mid),
            }
        }
        Err(lo)
    }
    pub fn binary_search_by_key<K: Ord>(&self, key: &K, f: fn(&T) -> K) -> Result<usize, usize> {
        self.binary_search_by(|x: &T| f(x).cmp(key))
    }
    pub fn fill(&mut self, v: T) {
        let mut i = 0;
        while i < self.len() { self[i] = v; i += 1; }
    }
    pub fn rotate_left(&mut self, k: usize) {
        let n = self.len();
        if n == 0 { return; }
        let k = k % n;
        self[0..k].reverse();
        self[k..n].reverse();
        self.reverse();
    }
    pub fn first(&self) -> Option<&T> { if self.len() == 0 { None } else { Some(&self[0]) } }
    pub fn last(&self) -> Option<&T> { let n = self.len(); if n == 0 { None } else { Some(&self[n - 1]) } }
    #[inline]
    pub fn get(&self, index: usize) -> Option<&T> { if index < self.len() { Some(&self[index]) } else { None } }
    #[inline]
    pub fn get_mut(&mut self, index: usize) -> Option<&mut T> { if index < self.len() { Some(&mut self[index]) } else { None } }
    pub fn swap(&mut self, a: usize, b: usize) { let t = self[a]; self[a] = self[b]; self[b] = t; }
    pub fn reverse(&mut self) {
        let n = self.len();
        let mut i = 0;
        while i < n / 2 { self.swap(i, n - 1 - i); i += 1; }
    }
}

impl<T: PartialEq> [T] {
    pub fn contains(&self, x: &T) -> bool {
        for e in self { if e == x { return true; } }
        false
    }
    pub fn starts_with(&self, p: &[T]) -> bool {
        if p.len() > self.len() { return false; }
        let mut i = 0;
        while i < p.len() { if self[i] != p[i] { return false; } i += 1; }
        true
    }
    pub fn ends_with(&self, p: &[T]) -> bool {
        if p.len() > self.len() { return false; }
        let off = self.len() - p.len();
        let mut i = 0;
        while i < p.len() { if self[off + i] != p[i] { return false; } i += 1; }
        true
    }
}

impl<T: Clone> [T] {
    pub fn copy_from_slice(&mut self, src: &[T]) {
        if src.len() != self.len() { panic("source slice length does not match destination"); }
        let mut i = 0;
        while i < src.len() { self[i] = src[i].clone(); i += 1; }
    }
    pub fn clone_from_slice(&mut self, src: &[T]) { self.copy_from_slice(src); }
}


impl<T: Clone> [T] {
    pub fn to_vec(&self) -> crate::vec::Vec<T> { crate::vec::Vec::from(self) }
}

impl<T: Ord> [T] {
    /// Sorts the slice (stable merge sort).
    pub fn sort(&mut self) { merge_sort(self, |a: &T, b: &T| a.cmp(b)); }
    pub fn sort_unstable(&mut self) { merge_sort(self, |a: &T, b: &T| a.cmp(b)); }
    pub fn binary_search(&self, x: &T) -> Result<usize, usize> { self.binary_search_by(|e: &T| e.cmp(x)) }
}

impl<T> IntoIterator for &[T] {
    type Item = &T;
    type IntoIter = Iter<T>;
    fn into_iter(self) -> Iter<T> { self.iter() }
}

impl<T> IntoIterator for &mut [T] {
    type Item = &mut T;
    type IntoIter = IterMut<T>;
    fn into_iter(self) -> IterMut<T> { self.iter_mut() }
}

// Helpers for the compiler's builtin impls on arrays and slices.

pub fn eq_slices<A, B>(a: &[A], b: &[B]) -> bool where A: PartialEq<B> {
    if a.len() != b.len() { return false; }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] { return false; }
        i += 1;
    }
    true
}

pub fn partial_cmp_slices<T: PartialOrd>(a: &[T], b: &[T]) -> Option<crate::cmp::Ordering> {
    let mut i = 0;
    while i < a.len() && i < b.len() {
        match a[i].partial_cmp(&b[i]) {
            Some(crate::cmp::Ordering::Equal) => {}
            other => return other,
        }
        i += 1;
    }
    a.len().partial_cmp(&b.len())
}

pub fn cmp_slices<T: Ord>(a: &[T], b: &[T]) -> crate::cmp::Ordering {
    let mut i = 0;
    while i < a.len() && i < b.len() {
        match a[i].cmp(&b[i]) {
            crate::cmp::Ordering::Equal => {}
            other => return other,
        }
        i += 1;
    }
    a.len().cmp(&b.len())
}

pub fn hash_slice<T: crate::hash::Hash, H: crate::hash::Hasher>(s: &[T], state: &mut H) {
    state.write(crate::rt::slice_from_raw(&s.len() as *const usize as *const u8, 8));
    for x in s { x.hash(state); }
}

#[track_caller]
pub fn index_ref<T>(s: &[T], i: usize) -> &T { &s[i] }

#[track_caller]
pub fn index_range<T>(s: &[T], start: usize, end: usize) -> &[T] {
    let n = s.len();
    if start > end { panic(`slice index starts at ${start} but ends at ${end}`); }
    if end > n { panic(`range end index ${end} out of range for slice of length ${n}`); }
    crate::rt::slice_from_raw(crate::rt::ptr_offset(s.as_ptr(), start), end - start)
}

#[track_caller]
pub fn index_range_mut<T>(s: &mut [T], start: usize, end: usize) -> &mut [T] {
    let n = s.len();
    if start > end { panic(`slice index starts at ${start} but ends at ${end}`); }
    if end > n { panic(`range end index ${end} out of range for slice of length ${n}`); }
    crate::rt::slice_from_raw_mut(crate::rt::ptr_offset(s.as_ptr(), start) as *mut T, end - start)
}

// ---------------------------------------------------------------------------

/// The result of [T]::concat (Rust's Concat<Item>, without the Item
/// parameter).
pub trait Concat {
    type Output;
    fn concat(slice: &Self) -> Self::Output;
}

/// The result of [T]::join.
pub trait Join<Separator> {
    type Output;
    fn join(slice: &Self, sep: Separator) -> Self::Output;
}

impl<S: AsRef<str>> Concat for [S] {
    type Output = crate::string::String;
    fn concat(slice: &[S]) -> crate::string::String { Join::join(slice, "") }
}

impl<S: AsRef<str>> Join<&str> for [S] {
    type Output = crate::string::String;
    fn join(slice: &[S], sep: &str) -> crate::string::String {
        let mut n = 0;
        for s in slice { n += s.as_ref().len() + sep.len(); }
        let mut out = crate::string::String::with_capacity(n);
        let mut first = true;
        for s in slice {
            if !first { out.push_str(sep); }
            out.push_str(s.as_ref());
            first = false;
        }
        out
    }
}

fn concat_parts<T, V>(slice: &[V], sep: &[T]) -> crate::vec::Vec<T> where T: Clone, V: AsRef<[T]> {
    let mut n = 0;
    for v in slice { n += v.as_ref().len() + sep.len(); }
    let mut out = crate::vec::Vec::with_capacity(n);
    let mut first = true;
    for v in slice {
        if !first { out.extend_from_slice(sep); }
        out.extend_from_slice(v.as_ref());
        first = false;
    }
    out
}

impl<T: Clone> Concat for [crate::vec::Vec<T>] {
    type Output = crate::vec::Vec<T>;
    fn concat(slice: &[crate::vec::Vec<T>]) -> crate::vec::Vec<T> { concat_parts(slice, &[]) }
}
impl<T: Clone> Concat for [&[T]] {
    type Output = crate::vec::Vec<T>;
    fn concat(slice: &[&[T]]) -> crate::vec::Vec<T> { concat_parts(slice, &[]) }
}
impl<T: Clone> Join<&T> for [crate::vec::Vec<T>] {
    type Output = crate::vec::Vec<T>;
    fn join(slice: &[crate::vec::Vec<T>], sep: &T) -> crate::vec::Vec<T> {
        let s = [sep.clone()];
        concat_parts(slice, s.as_slice())
    }
}
impl<T: Clone> Join<&[T]> for [crate::vec::Vec<T>] {
    type Output = crate::vec::Vec<T>;
    fn join(slice: &[crate::vec::Vec<T>], sep: &[T]) -> crate::vec::Vec<T> { concat_parts(slice, sep) }
}
impl<T: Clone> Join<&T> for [&[T]] {
    type Output = crate::vec::Vec<T>;
    fn join(slice: &[&[T]], sep: &T) -> crate::vec::Vec<T> {
        let s = [sep.clone()];
        concat_parts(slice, s.as_slice())
    }
}
impl<T: Clone> Join<&[T]> for [&[T]] {
    type Output = crate::vec::Vec<T>;
    fn join(slice: &[&[T]], sep: &[T]) -> crate::vec::Vec<T> { concat_parts(slice, sep) }
}

// Stable sort of s by a key computed once per element.
fn sort_cached<T, K: Ord>(s: &mut [T], f: fn(&T) -> K) {
    let n = s.len();
    let mut keys: crate::vec::Vec<(K, usize)> = crate::vec::Vec::with_capacity(n);
    let mut i = 0;
    while i < n { keys.push((f(&s[i]), i)); i += 1; }
    merge_sort(keys.as_mut_slice(), |a: &(K, usize), b: &(K, usize)| a.0.cmp(&b.0));
    let mut tmp: crate::vec::Vec<T> = crate::vec::Vec::with_capacity(n);
    for k in keys.iter() { tmp.push(s[k.1]); }
    i = 0;
    while i < n { s[i] = tmp[i]; i += 1; }
}

impl<T> [T] {
    /// Flattens a slice of strings or of sequences.
    pub fn concat<O>(&self) -> O where [T]: Concat<Output = O> { Concat::concat(self) }
    /// Flattens a slice of strings or of sequences, with sep between the
    /// parts.
    pub fn join<Separator, O>(&self, sep: Separator) -> O where [T]: Join<Separator, Output = O> { Join::join(self, sep) }

    pub fn as_mut_ptr(&mut self) -> *mut T { crate::rt::slice_ptr(self) as *mut T }

    pub fn rotate_right(&mut self, k: usize) {
        let n = self.len();
        if n == 0 { return; }
        let k = k % n;
        self.rotate_left(n - k);
    }

    pub fn split_at_mut(&mut self, mid: usize) -> (&mut [T], &mut [T]) {
        let n = self.len();
        if mid > n { panic(`mid > len (${mid} > ${n})`); }
        (&mut self[0..mid], &mut self[mid..n])
    }

    pub fn split_first_mut(&mut self) -> Option<(&mut T, &mut [T])> {
        let n = self.len();
        if n == 0 { None } else { Some((&mut self[0], &mut self[1..n])) }
    }

    pub fn split_last_mut(&mut self) -> Option<(&mut T, &mut [T])> {
        let n = self.len();
        if n == 0 { None } else { Some((&mut self[n - 1], &mut self[0..n - 1])) }
    }

    pub fn chunks_exact(&self, chunk_size: usize) -> ChunksExact<T> {
        if chunk_size == 0 { panic("chunk size must be non-zero"); }
        let n = self.len() - self.len() % chunk_size;
        ChunksExact { s: &self[0..n], rem: &self[n..], size: chunk_size, i: 0, end: n }
    }

    pub fn chunks_mut(&mut self, chunk_size: usize) -> ChunksMut<T> {
        if chunk_size == 0 { panic("chunk size must be non-zero"); }
        ChunksMut { s: self, size: chunk_size, i: 0 }
    }

    pub fn chunks_exact_mut(&mut self, chunk_size: usize) -> ChunksExactMut<T> {
        if chunk_size == 0 { panic("chunk size must be non-zero"); }
        let n = self.len() - self.len() % chunk_size;
        ChunksExactMut { s: self, size: chunk_size, i: 0, end: n }
    }

    /// Chunks from the end (the last one, at the start, may be shorter).
    pub fn rchunks(&self, chunk_size: usize) -> RChunks<T> {
        if chunk_size == 0 { panic("chunk size must be non-zero"); }
        RChunks { s: self, size: chunk_size, end: self.len() }
    }

    /// Subslices separated by elements matching pred.
    pub fn split(&self, pred: fn(&T) -> bool) -> Split<T> { Split { s: self, pred, done: false } }

    pub fn fill_with(&mut self, f: fn() -> T) {
        let mut i = 0;
        while i < self.len() { self[i] = f(); i += 1; }
    }

    pub fn swap_with_slice(&mut self, other: &mut [T]) {
        if self.len() != other.len() { panic("destination and source slices have different lengths"); }
        let mut i = 0;
        while i < self.len() {
            let t = self[i];
            self[i] = other[i];
            other[i] = t;
            i += 1;
        }
    }

    /// The index of the first element for which pred is false (the slice
    /// is partitioned: pred holds for a prefix).
    pub fn partition_point(&self, pred: fn(&T) -> bool) -> usize {
        let mut lo = 0;
        let mut hi = self.len();
        while lo < hi {
            let mid = lo + (hi - lo) / 2;
            if pred(&self[mid]) { lo = mid + 1; } else { hi = mid; }
        }
        lo
    }

    pub fn is_sorted_by(&self, compare: fn(&T, &T) -> bool) -> bool {
        let mut i = 1;
        while i < self.len() {
            if !compare(&self[i - 1], &self[i]) { return false; }
            i += 1;
        }
        true
    }

    pub fn is_sorted_by_key<K: PartialOrd>(&self, f: fn(&T) -> K) -> bool {
        let mut i = 1;
        while i < self.len() {
            if f(&self[i - 1]) > f(&self[i]) { return false; }
            i += 1;
        }
        true
    }

    /// Sorts by a key computed once per element (stable).
    pub fn sort_by_cached_key<K: Ord>(&mut self, f: fn(&T) -> K) { sort_cached(self, f); }

    /// Reorders the slice so that the element at index is where a sort
    /// would put it, smaller ones before it and larger ones after it.
    pub fn select_nth_unstable_by(&mut self, index: usize, compare: fn(&T, &T) -> Ordering) -> (&mut [T], &mut T, &mut [T]) {
        let n = self.len();
        if index >= n { panic(`partition_at_index index ${index} greater than length of slice ${n}`); }
        select_nth(self, index, compare);
        (&mut self[0..index], &mut self[index], &mut self[index + 1..n])
    }

    pub fn select_nth_unstable_by_key<K: Ord>(&mut self, index: usize, f: fn(&T) -> K) -> (&mut [T], &mut T, &mut [T]) {
        self.select_nth_unstable_by(index, |a: &T, b: &T| f(a).cmp(&f(b)))
    }
}

// Quickselect with a three-way partition around the median of three
// (insertion sort for short ranges).
fn select_nth<T>(s: &mut [T], k: usize, cmp: fn(&T, &T) -> Ordering) {
    let mut lo = 0;
    let mut hi = s.len();
    while hi - lo > 16 {
        let mid = lo + (hi - lo) / 2;
        let (a, b, c) = (lo, mid, hi - 1);
        let ab = cmp(&s[a], &s[b]) == Ordering::Less;
        let bc = cmp(&s[b], &s[c]) == Ordering::Less;
        let ac = cmp(&s[a], &s[c]) == Ordering::Less;
        let m = if ab == bc { b } else if ab == ac { c } else { a };
        let p = s[m];
        let mut lt = lo;
        let mut i = lo;
        let mut gt = hi;
        while i < gt {
            match cmp(&s[i], &p) {
                Ordering::Less => { s.swap(lt, i); lt += 1; i += 1; }
                Ordering::Greater => { gt -= 1; s.swap(i, gt); }
                Ordering::Equal => { i += 1; }
            }
        }
        if k < lt { hi = lt; } else if k >= gt { lo = gt; } else { return; }
    }
    let mut i = lo + 1;
    while i < hi {
        let mut j = i;
        while j > lo && cmp(&s[j - 1], &s[j]) == Ordering::Greater {
            s.swap(j - 1, j);
            j -= 1;
        }
        i += 1;
    }
}

impl<T: Ord> [T] {
    pub fn select_nth_unstable(&mut self, index: usize) -> (&mut [T], &mut T, &mut [T]) {
        self.select_nth_unstable_by(index, |a: &T, b: &T| a.cmp(b))
    }
}

impl<T: PartialOrd> [T] {
    pub fn is_sorted(&self) -> bool {
        let mut i = 1;
        while i < self.len() {
            if self[i - 1] > self[i] { return false; }
            i += 1;
        }
        true
    }
}

impl<T: Clone> [T] {
    /// The slice repeated n times.
    pub fn repeat(&self, n: usize) -> crate::vec::Vec<T> {
        let mut out = crate::vec::Vec::with_capacity(self.len() * n);
        let mut i = 0;
        while i < n { out.extend_from_slice(self); i += 1; }
        out
    }
}

impl [u8] {
    pub fn is_ascii(&self) -> bool {
        for b in self { if *b >= 128 { return false; } }
        true
    }
    pub fn eq_ignore_ascii_case(&self, other: &[u8]) -> bool {
        if self.len() != other.len() { return false; }
        let mut i = 0;
        while i < self.len() {
            if self[i].to_ascii_lowercase() != other[i].to_ascii_lowercase() { return false; }
            i += 1;
        }
        true
    }
    pub fn to_ascii_uppercase(&self) -> crate::vec::Vec<u8> {
        let mut v = crate::vec::Vec::with_capacity(self.len());
        for b in self { v.push(b.to_ascii_uppercase()); }
        v
    }
    pub fn to_ascii_lowercase(&self) -> crate::vec::Vec<u8> {
        let mut v = crate::vec::Vec::with_capacity(self.len());
        for b in self { v.push(b.to_ascii_lowercase()); }
        v
    }
    pub fn make_ascii_uppercase(&mut self) {
        let mut i = 0;
        while i < self.len() { self[i] = self[i].to_ascii_uppercase(); i += 1; }
    }
    pub fn make_ascii_lowercase(&mut self) {
        let mut i = 0;
        while i < self.len() { self[i] = self[i].to_ascii_lowercase(); i += 1; }
    }
    pub fn trim_ascii_start(&self) -> &[u8] {
        let mut i = 0;
        while i < self.len() && self[i].is_ascii_whitespace() { i += 1; }
        &self[i..]
    }
    pub fn trim_ascii_end(&self) -> &[u8] {
        let mut n = self.len();
        while n > 0 && self[n - 1].is_ascii_whitespace() { n -= 1; }
        &self[0..n]
    }
    pub fn trim_ascii(&self) -> &[u8] { self.trim_ascii_start().trim_ascii_end() }
}

impl<T> Iter<T> {
    /// The rest of the slice.
    pub fn as_slice(&self) -> &[T] { &self.s[self.i..self.end] }
}
impl<T> Clone for Iter<T> { fn clone(&self) -> Iter<T> { Iter { s: self.s, i: self.i, end: self.end } } }
impl<T> ExactSizeIterator for IterMut<T> {}

impl<T> DoubleEndedIterator for Windows<T> {
    fn next_back(&mut self) -> Option<&[T]> {
        if self.i + self.size > self.s.len() { return None; }
        let n = self.s.len();
        let w = &self.s[n - self.size..n];
        self.s = &self.s[0..n - 1];
        Some(w)
    }
}
impl<T> ExactSizeIterator for Windows<T> {}
impl<T> Clone for Windows<T> { fn clone(&self) -> Windows<T> { Windows { s: self.s, size: self.size, i: self.i } } }

impl<T> DoubleEndedIterator for Chunks<T> {
    fn next_back(&mut self) -> Option<&[T]> {
        let n = self.s.len();
        if self.i >= n { return None; }
        let rem = (n - self.i) % self.size;
        let start = if rem == 0 { n - self.size } else { n - rem };
        let c = &self.s[start..n];
        self.s = &self.s[0..start];
        Some(c)
    }
}
impl<T> ExactSizeIterator for Chunks<T> {}
impl<T> Clone for Chunks<T> { fn clone(&self) -> Chunks<T> { Chunks { s: self.s, size: self.size, i: self.i } } }

/// The iterator of [T]::chunks_exact.
pub struct ChunksExact<T> { s: &[T], rem: &[T], size: usize, i: usize, end: usize }
impl<T> ChunksExact<T> {
    /// The elements left over at the end.
    pub fn remainder(&self) -> &[T] { self.rem }
}
impl<T> Iterator for ChunksExact<T> {
    type Item = &[T];
    fn next(&mut self) -> Option<&[T]> {
        if self.i >= self.end { return None; }
        let c = &self.s[self.i..self.i + self.size];
        self.i += self.size;
        Some(c)
    }
    fn size_hint(&self) -> (usize, Option<usize>) { let n = (self.end - self.i) / self.size; (n, Some(n)) }
}
impl<T> DoubleEndedIterator for ChunksExact<T> {
    fn next_back(&mut self) -> Option<&[T]> {
        if self.i >= self.end { return None; }
        self.end -= self.size;
        Some(&self.s[self.end..self.end + self.size])
    }
}
impl<T> ExactSizeIterator for ChunksExact<T> {}

/// The iterator of [T]::chunks_mut.
pub struct ChunksMut<T> { s: &mut [T], size: usize, i: usize }
impl<T> Iterator for ChunksMut<T> {
    type Item = &mut [T];
    fn next(&mut self) -> Option<&mut [T]> {
        let n = self.s.len();
        if self.i >= n { return None; }
        let end = if self.i + self.size > n { n } else { self.i + self.size };
        let start = self.i;
        self.i = end;
        Some(&mut self.s[start..end])
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        let r = self.s.len() - self.i;
        let n = (r + self.size - 1) / self.size;
        (n, Some(n))
    }
}
impl<T> ExactSizeIterator for ChunksMut<T> {}

/// The iterator of [T]::chunks_exact_mut.
pub struct ChunksExactMut<T> { s: &mut [T], size: usize, i: usize, end: usize }
impl<T> ChunksExactMut<T> {
    pub fn into_remainder(self) -> &mut [T] { let n = self.s.len(); &mut self.s[self.end..n] }
}
impl<T> Iterator for ChunksExactMut<T> {
    type Item = &mut [T];
    fn next(&mut self) -> Option<&mut [T]> {
        if self.i >= self.end { return None; }
        let start = self.i;
        self.i += self.size;
        Some(&mut self.s[start..start + self.size])
    }
    fn size_hint(&self) -> (usize, Option<usize>) { let n = (self.end - self.i) / self.size; (n, Some(n)) }
}
impl<T> ExactSizeIterator for ChunksExactMut<T> {}

/// The iterator of [T]::rchunks.
pub struct RChunks<T> { s: &[T], size: usize, end: usize }
impl<T> Iterator for RChunks<T> {
    type Item = &[T];
    fn next(&mut self) -> Option<&[T]> {
        if self.end == 0 { return None; }
        let start = if self.end > self.size { self.end - self.size } else { 0 };
        let c = &self.s[start..self.end];
        self.end = start;
        Some(c)
    }
    fn size_hint(&self) -> (usize, Option<usize>) { let n = (self.end + self.size - 1) / self.size; (n, Some(n)) }
}
impl<T> ExactSizeIterator for RChunks<T> {}

/// The iterator of [T]::split.
pub struct Split<T> { s: &[T], pred: fn(&T) -> bool, done: bool }
impl<T> Iterator for Split<T> {
    type Item = &[T];
    fn next(&mut self) -> Option<&[T]> {
        if self.done { return None; }
        let mut i = 0;
        while i < self.s.len() {
            if (self.pred)(&self.s[i]) {
                let head = &self.s[0..i];
                self.s = &self.s[i + 1..];
                return Some(head);
            }
            i += 1;
        }
        self.done = true;
        Some(self.s)
    }
}
impl<T> DoubleEndedIterator for Split<T> {
    fn next_back(&mut self) -> Option<&[T]> {
        if self.done { return None; }
        let mut i = self.s.len();
        while i > 0 {
            if (self.pred)(&self.s[i - 1]) {
                let tail = &self.s[i..];
                self.s = &self.s[0..i - 1];
                return Some(tail);
            }
            i -= 1;
        }
        self.done = true;
        Some(self.s)
    }
}
