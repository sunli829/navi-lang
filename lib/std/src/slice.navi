//! Slices: GC-managed (pointer, length) views.

use crate::cmp::Ordering;

pub struct Iter<T> { s: &[T], i: usize, end: usize }
impl<T> Iterator for Iter<T> {
    type Item = &T;
    fn next(&mut self) -> Option<&T> {
        if self.i < self.end {
            let r = &self.s[self.i];
            self.i += 1;
            Some(r)
        } else {
            None
        }
    }
    fn size_hint(&self) -> (usize, Option<usize>) { (self.end - self.i, Some(self.end - self.i)) }
}
impl<T> DoubleEndedIterator for Iter<T> {
    fn next_back(&mut self) -> Option<&T> {
        if self.i < self.end {
            self.end -= 1;
            Some(&self.s[self.end])
        } else {
            None
        }
    }
}
impl<T> ExactSizeIterator for Iter<T> {}

pub struct IterMut<T> { s: &mut [T], i: usize, end: usize }
impl<T> Iterator for IterMut<T> {
    type Item = &mut T;
    fn next(&mut self) -> Option<&mut T> {
        if self.i < self.end {
            let r = &mut self.s[self.i];
            self.i += 1;
            Some(r)
        } else {
            None
        }
    }
}
impl<T> DoubleEndedIterator for IterMut<T> {
    fn next_back(&mut self) -> Option<&mut T> {
        if self.i < self.end {
            self.end -= 1;
            Some(&mut self.s[self.end])
        } else {
            None
        }
    }
}

pub struct Windows<T> { s: &[T], size: usize, i: usize }
impl<T> Iterator for Windows<T> {
    type Item = &[T];
    fn next(&mut self) -> Option<&[T]> {
        if self.i + self.size > self.s.len() { return None; }
        let w = &self.s[self.i..self.i + self.size];
        self.i += 1;
        Some(w)
    }
}

pub struct Chunks<T> { s: &[T], size: usize, i: usize }
impl<T> Iterator for Chunks<T> {
    type Item = &[T];
    fn next(&mut self) -> Option<&[T]> {
        if self.i >= self.s.len() { return None; }
        let end = if self.i + self.size > self.s.len() { self.s.len() } else { self.i + self.size };
        let c = &self.s[self.i..end];
        self.i = end;
        Some(c)
    }
}

// Stable merge sort of s by cmp (insertion sort for short runs).
fn merge_sort<T>(s: &mut [T], cmp: fn(&T, &T) -> Ordering) {
    let n = s.len();
    if n <= 16 {
        let mut i = 1;
        while i < n {
            let mut j = i;
            while j > 0 && cmp(&s[j - 1], &s[j]) == Ordering::Greater {
                s.swap(j - 1, j);
                j -= 1;
            }
            i += 1;
        }
        return;
    }
    let mid = n / 2;
    merge_sort(&mut s[0..mid], cmp);
    merge_sort(&mut s[mid..n], cmp);
    if cmp(&s[mid - 1], &s[mid]) != Ordering::Greater { return; }
    let mut tmp: crate::vec::Vec<T> = crate::vec::Vec::with_capacity(n);
    let mut i = 0;
    let mut j = mid;
    while i < mid && j < n {
        if cmp(&s[j], &s[i]) == Ordering::Less {
            tmp.push(s[j]);
            j += 1;
        } else {
            tmp.push(s[i]);
            i += 1;
        }
    }
    while i < mid { tmp.push(s[i]); i += 1; }
    while j < n { tmp.push(s[j]); j += 1; }
    let mut k = 0;
    while k < n { s[k] = tmp[k]; k += 1; }
}

impl<T> [T] {
    pub fn len(&self) -> usize { crate::rt::slice_len(self) }
    pub fn is_empty(&self) -> bool { self.len() == 0 }
    pub fn as_ptr(&self) -> *const T { crate::rt::slice_ptr(self) }
    pub fn iter(&self) -> Iter<T> { Iter { s: self, i: 0, end: self.len() } }
    pub fn iter_mut(&mut self) -> IterMut<T> { let n = self.len(); IterMut { s: self, i: 0, end: n } }
    pub fn first_mut(&mut self) -> Option<&mut T> { if self.len() == 0 { None } else { Some(&mut self[0]) } }
    pub fn last_mut(&mut self) -> Option<&mut T> { let n = self.len(); if n == 0 { None } else { Some(&mut self[n - 1]) } }
    pub fn split_first(&self) -> Option<(&T, &[T])> { if self.len() == 0 { None } else { Some((&self[0], &self[1..])) } }
    pub fn split_last(&self) -> Option<(&T, &[T])> {
        let n = self.len();
        if n == 0 { None } else { Some((&self[n - 1], &self[0..n - 1])) }
    }
    pub fn split_at(&self, mid: usize) -> (&[T], &[T]) { (&self[0..mid], &self[mid..]) }
    pub fn windows(&self, size: usize) -> Windows<T> { Windows { s: self, size, i: 0 } }
    pub fn chunks(&self, size: usize) -> Chunks<T> { Chunks { s: self, size, i: 0 } }
    pub fn sort_by(&mut self, cmp: fn(&T, &T) -> Ordering) { merge_sort(self, cmp); }
    pub fn sort_unstable_by(&mut self, cmp: fn(&T, &T) -> Ordering) { merge_sort(self, cmp); }
    pub fn sort_by_key<K: Ord>(&mut self, f: fn(&T) -> K) { merge_sort(self, |a: &T, b: &T| f(a).cmp(&f(b))); }
    pub fn sort_unstable_by_key<K: Ord>(&mut self, f: fn(&T) -> K) { merge_sort(self, |a: &T, b: &T| f(a).cmp(&f(b))); }
    pub fn binary_search_by(&self, f: fn(&T) -> Ordering) -> Result<usize, usize> {
        let mut lo = 0;
        let mut hi = self.len();
        while lo < hi {
            let mid = lo + (hi - lo) / 2;
            match f(&self[mid]) {
                Ordering::Less => { lo = mid + 1; }
                Ordering::Greater => { hi = mid; }
                Ordering::Equal => return Ok(mid),
            }
        }
        Err(lo)
    }
    pub fn binary_search_by_key<K: Ord>(&self, key: &K, f: fn(&T) -> K) -> Result<usize, usize> {
        self.binary_search_by(|x: &T| f(x).cmp(key))
    }
    pub fn fill(&mut self, v: T) {
        let mut i = 0;
        while i < self.len() { self[i] = v; i += 1; }
    }
    pub fn rotate_left(&mut self, k: usize) {
        let n = self.len();
        if n == 0 { return; }
        let k = k % n;
        self[0..k].reverse();
        self[k..n].reverse();
        self.reverse();
    }
    pub fn first(&self) -> Option<&T> { if self.len() == 0 { None } else { Some(&self[0]) } }
    pub fn last(&self) -> Option<&T> { let n = self.len(); if n == 0 { None } else { Some(&self[n - 1]) } }
    pub fn get(&self, index: usize) -> Option<&T> { if index < self.len() { Some(&self[index]) } else { None } }
    pub fn get_mut(&mut self, index: usize) -> Option<&mut T> { if index < self.len() { Some(&mut self[index]) } else { None } }
    pub fn swap(&mut self, a: usize, b: usize) { let t = self[a]; self[a] = self[b]; self[b] = t; }
    pub fn reverse(&mut self) {
        let n = self.len();
        let mut i = 0;
        while i < n / 2 { self.swap(i, n - 1 - i); i += 1; }
    }
}

impl<T: PartialEq> [T] {
    pub fn contains(&self, x: &T) -> bool {
        for e in self { if e == x { return true; } }
        false
    }
    pub fn starts_with(&self, p: &[T]) -> bool {
        if p.len() > self.len() { return false; }
        let mut i = 0;
        while i < p.len() { if self[i] != p[i] { return false; } i += 1; }
        true
    }
    pub fn ends_with(&self, p: &[T]) -> bool {
        if p.len() > self.len() { return false; }
        let off = self.len() - p.len();
        let mut i = 0;
        while i < p.len() { if self[off + i] != p[i] { return false; } i += 1; }
        true
    }
}

impl<T: Clone> [T] {
    pub fn copy_from_slice(&mut self, src: &[T]) {
        if src.len() != self.len() { panic("source slice length does not match destination"); }
        let mut i = 0;
        while i < src.len() { self[i] = src[i].clone(); i += 1; }
    }
    pub fn clone_from_slice(&mut self, src: &[T]) { self.copy_from_slice(src); }
}

impl<S: AsRef<str>> [S] {
    /// Joins string slices with a separator.
    pub fn join(&self, sep: &str) -> crate::string::String {
        let mut out = crate::string::String::new();
        let mut first = true;
        for s in self {
            if !first { out.push_str(sep); }
            out.push_str(s.as_ref());
            first = false;
        }
        out
    }
    pub fn concat(&self) -> crate::string::String { self.join("") }
}

impl<T: Clone> [T] {
    pub fn to_vec(&self) -> crate::vec::Vec<T> { crate::vec::Vec::from(self) }
}

impl<T: Ord> [T] {
    /// Sorts the slice (stable merge sort).
    pub fn sort(&mut self) { merge_sort(self, |a: &T, b: &T| a.cmp(b)); }
    pub fn sort_unstable(&mut self) { merge_sort(self, |a: &T, b: &T| a.cmp(b)); }
    pub fn binary_search(&self, x: &T) -> Result<usize, usize> { self.binary_search_by(|e: &T| e.cmp(x)) }
}

impl<T> IntoIterator for &[T] {
    type Item = &T;
    type IntoIter = Iter<T>;
    fn into_iter(self) -> Iter<T> { self.iter() }
}

impl<T> IntoIterator for &mut [T] {
    type Item = &mut T;
    type IntoIter = IterMut<T>;
    fn into_iter(self) -> IterMut<T> { self.iter_mut() }
}

// Helpers for the compiler's builtin impls on arrays and slices.

pub fn eq_slices<A: PartialEq<B>, B>(a: &[A], b: &[B]) -> bool {
    if a.len() != b.len() { return false; }
    let mut i = 0;
    while i < a.len() {
        if a[i] != b[i] { return false; }
        i += 1;
    }
    true
}

pub fn partial_cmp_slices<T: PartialOrd>(a: &[T], b: &[T]) -> Option<crate::cmp::Ordering> {
    let mut i = 0;
    while i < a.len() && i < b.len() {
        match a[i].partial_cmp(&b[i]) {
            Some(crate::cmp::Ordering::Equal) => {}
            other => return other,
        }
        i += 1;
    }
    a.len().partial_cmp(&b.len())
}

pub fn cmp_slices<T: Ord>(a: &[T], b: &[T]) -> crate::cmp::Ordering {
    let mut i = 0;
    while i < a.len() && i < b.len() {
        match a[i].cmp(&b[i]) {
            crate::cmp::Ordering::Equal => {}
            other => return other,
        }
        i += 1;
    }
    a.len().cmp(&b.len())
}

pub fn hash_slice<T: crate::hash::Hash, H: crate::hash::Hasher>(s: &[T], state: &mut H) {
    state.write(crate::rt::slice_from_raw(&s.len() as *const usize as *const u8, 8));
    for x in s { x.hash(state); }
}

#[track_caller]
pub fn index_ref<T>(s: &[T], i: usize) -> &T { &s[i] }

#[track_caller]
pub fn index_range<T>(s: &[T], start: usize, end: usize) -> &[T] {
    let n = s.len();
    if start > end { panic(`slice index starts at ${start} but ends at ${end}`); }
    if end > n { panic(`range end index ${end} out of range for slice of length ${n}`); }
    crate::rt::slice_from_raw(crate::rt::ptr_offset(s.as_ptr(), start), end - start)
}

#[track_caller]
pub fn index_range_mut<T>(s: &mut [T], start: usize, end: usize) -> &mut [T] {
    let n = s.len();
    if start > end { panic(`slice index starts at ${start} but ends at ${end}`); }
    if end > n { panic(`range end index ${end} out of range for slice of length ${n}`); }
    crate::rt::slice_from_raw_mut(crate::rt::ptr_offset(s.as_ptr(), start) as *mut T, end - start)
}
