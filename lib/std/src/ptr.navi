//! Raw pointers and pointer identity.

/// Reports whether two references point to the same object.
pub fn eq<T>(a: &T, b: &T) -> bool {
    (a as *const T) == (b as *const T)
}

pub fn null<T>() -> *const T {
    0usize as *const T
}
pub fn null_mut<T>() -> *mut T {
    0usize as *mut T
}

impl<T> *const T {
    pub fn is_null(self) -> bool {
        self == null()
    }
    pub unsafe fn add(self, n: usize) -> *const T {
        crate::rt::ptr_offset(self, n)
    }
    pub unsafe fn read(self) -> T {
        *self
    }
}

impl<T> *mut T {
    pub fn is_null(self) -> bool {
        self == null_mut()
    }
    pub unsafe fn add(self, n: usize) -> *mut T {
        crate::rt::ptr_offset(self as *const T, n) as *mut T
    }
    pub unsafe fn read(self) -> T {
        *self
    }
    pub unsafe fn write(self, v: T) {
        *self = v;
    }
}
