//! Raw pointers and pointer identity.
//!
//! References (`&T`, `&mut T`) are pointers managed by the garbage
//! collector; `==` on them compares the values they point to. [`eq`]
//! compares the addresses instead. Raw pointers (`*const T`, `*mut T`) are
//! used in `unsafe` code and FFI; dereferencing them is unsafe.

/// Compares two references by address: whether they point to the same
/// object.
///
/// `a == b` on references compares the values they point to; `ptr::eq`
/// tells two equal but distinct values apart.
///
/// # Examples
///
/// ```
/// use std::ptr;
///
/// let a = &5;
/// let b = &5;
/// let c = a;
/// assert(a == b); // equal values
/// assert(!ptr::eq(a, b)); // different objects
/// assert(ptr::eq(a, c));
/// ```
pub fn eq<T>(a: &T, b: &T) -> bool {
    (a as *const T) == (b as *const T)
}

/// Creates a null raw pointer.
///
/// # Examples
///
/// ```
/// use std::ptr;
///
/// let p: *const i32 = ptr::null();
/// assert(p.is_null());
/// ```
pub fn null<T>() -> *const T {
    0usize as *const T
}

/// Creates a null mutable raw pointer.
///
/// # Examples
///
/// ```
/// use std::ptr;
///
/// let p: *mut i32 = ptr::null_mut();
/// assert(p.is_null());
/// ```
pub fn null_mut<T>() -> *mut T {
    0usize as *mut T
}

impl<T> *const T {
    /// Returns `true` if the pointer is null.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 10;
    /// let p = &x as *const i32;
    /// assert(!p.is_null());
    /// assert(std::ptr::null::<i32>().is_null());
    /// ```
    pub fn is_null(self) -> bool {
        self == null()
    }

    /// Adds an offset of `n` elements (`n * size_of::<T>()` bytes) to the
    /// pointer.
    ///
    /// # Safety
    ///
    /// The result must point into (or one past the end of) the same
    /// object as `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = [1, 2, 3];
    /// let p = a.as_slice().as_ptr();
    /// assert_eq(unsafe { p.add(2).read() }, 3);
    /// ```
    pub unsafe fn add(self, n: usize) -> *const T {
        crate::rt::ptr_offset(self, n)
    }

    /// Reads the value the pointer points to (a copy of it, as `*p`).
    ///
    /// # Safety
    ///
    /// The pointer must point to a valid value of type `T`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 12;
    /// let p = &x as *const i32;
    /// assert_eq(unsafe { p.read() }, 12);
    /// ```
    pub unsafe fn read(self) -> T {
        *self
    }
}

impl<T> *mut T {
    /// Returns `true` if the pointer is null.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut x = 10;
    /// let p = &mut x as *mut i32;
    /// assert(!p.is_null());
    /// assert(std::ptr::null_mut::<i32>().is_null());
    /// ```
    pub fn is_null(self) -> bool {
        self == null_mut()
    }

    /// Adds an offset of `n` elements (`n * size_of::<T>()` bytes) to the
    /// pointer.
    ///
    /// # Safety
    ///
    /// The result must point into (or one past the end of) the same
    /// object as `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut a = [1, 2, 3];
    /// let p = a.as_mut_slice().as_mut_ptr();
    /// unsafe {
    ///     p.add(1).write(20);
    /// }
    /// assert_eq(a, [1, 20, 3]);
    /// ```
    pub unsafe fn add(self, n: usize) -> *mut T {
        crate::rt::ptr_offset(self as *const T, n) as *mut T
    }

    /// Reads the value the pointer points to (a copy of it, as `*p`).
    ///
    /// # Safety
    ///
    /// The pointer must point to a valid value of type `T`.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut x = 12;
    /// let p = &mut x as *mut i32;
    /// assert_eq(unsafe { p.read() }, 12);
    /// ```
    pub unsafe fn read(self) -> T {
        *self
    }

    /// Overwrites the value the pointer points to with `v` (as `*p = v`).
    ///
    /// # Safety
    ///
    /// The pointer must point to a valid, writable location for a `T`.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut x = 0;
    /// let p = &mut x as *mut i32;
    /// unsafe {
    ///     p.write(7);
    /// }
    /// assert_eq(x, 7);
    /// ```
    pub unsafe fn write(self, v: T) {
        *self = v;
    }
}
