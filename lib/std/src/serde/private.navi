//! What the code #[derive(Serialize, Deserialize)] makes calls (as serde's
//! __private; not for use otherwise).

use crate::marker::PhantomData;
use crate::serde::de::{Deserialize, Deserializer, Visitor, Error};

/// The value of a field missing from the input: None for an Option, else a
/// missing field error (as serde's).
pub fn missing_field<V: Deserialize, E: Error>(field: &str) -> Result<V, E> {
    V::deserialize(MissingField::<E> { field, marker: PhantomData })
}

struct MissingField<E> {
    field: &str,
    marker: PhantomData<E>,
}

impl<E: Error> Deserializer for MissingField<E> {
    type Error = E;
    fn deserialize_any<V: Visitor>(self, visitor: V) -> Result<V::Value, E> { Err(E::missing_field(self.field)) }
    fn deserialize_option<V: Visitor>(self, visitor: V) -> Result<V::Value, E> { visitor.visit_none() }
}
