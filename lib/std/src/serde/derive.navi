//! The derive macros `Serialize` and `Deserialize`, re-exported by
//! [`crate::serde`] with the traits of the same names.
//!
//! They make the code serde_derive makes, for structs (with named fields,
//! tuple, newtype and unit structs) and enums, with the `#[serde(...)]`
//! attributes `rename`, `rename_all`, `skip`, `skip_serializing`,
//! `skip_deserializing`, `default` (or `default = "path"`),
//! `skip_serializing_if` and `deny_unknown_fields`, and serde's four enum
//! representations: externally tagged (`"Variant"` or
//! `{"Variant": content}`, the default), internally tagged (`tag = "t"`:
//! `{"t": "Variant", fields...}`), adjacently tagged (`tag = "t", content =
//! "c"`: `{"t": "Variant", "c": content}`) and untagged (the content alone;
//! reading tries the variants in order). See [`crate::serde`] for
//! examples.
//!
//! The helper types of a `Deserialize` implementation (field and variant
//! identifiers, visitors) are put next to the type, named `__Type_...`.

use crate::derive::{
    AttrArgs, AttrValue, Binding, Code, Error, FromAttrValue, FromAttrs, Kind, TypeInfo, Variant,
    quote,
};

// Code of text as written (a path, a number).
fn c(text: &str) -> Code {
    Code::from_text(text)
}

const SER: &str = "::std::serde::ser";
const DE: &str = "::std::serde::de";

// --- Attributes --------------------------------------------------------------

// The #[serde(...)] settings of an item, field or variant.
struct Attrs {
    rename: Option<String>,
    rename_all: Option<String>,
    skip: bool,
    skip_serializing: bool,
    skip_deserializing: bool,
    default: Option<DefaultTo>,
    skip_serializing_if: Option<String>,
    deny_unknown_fields: bool,
    tag: Option<String>,
    content: Option<String>,
    untagged: bool,
}

// #[serde(default)] (the type's Default) or default = "path" (a function).
struct DefaultTo {
    path: String,
}

impl FromAttrValue for DefaultTo {
    fn from_value(v: &AttrValue) -> Option<DefaultTo> {
        match v {
            AttrValue::Str(s, _) => Some(DefaultTo { path: s.clone() }),
            _ => None,
        }
    }

    fn from_word() -> Option<DefaultTo> {
        Some(DefaultTo {
            path: String::new(),
        })
    }

    fn expected() -> &str {
        "a function's path as a string"
    }
}

// (By hand: std cannot use its own derive macros, FromAttrs's.)
impl FromAttrs for Attrs {
    fn from_attrs(a: &mut AttrArgs) -> Result<Attrs, Error> {
        Ok(Attrs {
            rename: a.get::<Option<String>>("rename")?,
            rename_all: a.get::<Option<String>>("rename_all")?,
            skip: a.get::<bool>("skip")?,
            skip_serializing: a.get::<bool>("skip_serializing")?,
            skip_deserializing: a.get::<bool>("skip_deserializing")?,
            default: a.get::<Option<DefaultTo>>("default")?,
            skip_serializing_if: a.get::<Option<String>>("skip_serializing_if")?,
            deny_unknown_fields: a.get::<bool>("deny_unknown_fields")?,
            tag: a.get::<Option<String>>("tag")?,
            content: a.get::<Option<String>>("content")?,
            untagged: a.get::<bool>("untagged")?,
        })
    }
}

impl Attrs {
    fn skip_ser(&self) -> bool {
        self.skip || self.skip_serializing
    }

    fn skip_de(&self) -> bool {
        self.skip || self.skip_deserializing
    }

    fn rule(&self) -> String {
        match &self.rename_all {
            Some(r) => r.clone(),
            None => String::new(),
        }
    }
}

// A field's default (#[serde(default)] or default = "path").
fn default_of(a: &Attrs) -> Code {
    match &a.default {
        Some(d) => {
            if d.path.len() > 0 {
                c(`${d.path}()`.to_string().as_str())
            } else {
                c("::std::default::Default::default()")
            }
        }
        None => c("::std::default::Default::default()"),
    }
}

// A name as rename_all says (serde's casing rules: fields are written in
// snake_case, variants in PascalCase).
fn renamed(name: &str, rule: &str, variant: bool) -> String {
    if rule.len() == 0 {
        return name.to_string();
    }
    // The words of the name.
    let mut words: Vec<String> = Vec::new();
    if variant {
        let mut cur = String::new();
        for c in name.chars() {
            if c.is_uppercase() && cur.len() > 0 {
                words.push(cur);
                cur = String::new();
            }
            cur.push(c);
        }
        if cur.len() > 0 {
            words.push(cur);
        }
    } else {
        for w in name.split('_') {
            if w.len() > 0 {
                words.push(w.to_string());
            }
        }
    }
    let lower: Vec<String> = words.iter().map(|w| w.to_lowercase()).collect();
    let cap = |w: &String| -> String {
        let mut out = String::new();
        let mut first = true;
        for c in w.chars() {
            if first {
                out.push_str(c.to_uppercase().to_string().as_str());
                first = false;
            } else {
                out.push(c);
            }
        }
        out
    };
    match rule {
        "lowercase" => {
            if variant {
                name.to_lowercase()
            } else {
                name.to_string()
            }
        }
        "UPPERCASE" => name.to_uppercase(),
        "PascalCase" => {
            let mut s = String::new();
            for w in lower.iter() {
                s.push_str(cap(w).as_str());
            }
            s
        }
        "camelCase" => {
            let mut s = String::new();
            let mut i = 0;
            while i < lower.len() {
                if i == 0 {
                    s.push_str(lower[i].as_str());
                } else {
                    s.push_str(cap(&lower[i]).as_str());
                }
                i += 1;
            }
            s
        }
        "snake_case" => lower.join("_"),
        "SCREAMING_SNAKE_CASE" => lower.join("_").to_uppercase(),
        "kebab-case" => lower.join("-"),
        "SCREAMING-KEBAB-CASE" => lower.join("-").to_uppercase(),
        _ => name.to_string(),
    }
}

// What a field or variant is called in the data.
fn data_name(name: &str, own: &Attrs, rule: &str, variant: bool) -> String {
    match &own.rename {
        Some(r) => r.clone(),
        None => renamed(name, rule, variant),
    }
}

// A number as written (no suffix: its type is inferred).
fn num(n: usize) -> Code {
    c(`${n}`.to_string().as_str())
}

// &["a", "b"] of the names.
fn name_list(names: &[String]) -> Code {
    let mut parts: Vec<Code> = Vec::new();
    let mut i = 0;
    while i < names.len() {
        let n = names[i].clone();
        if i > 0 {
            parts.push(c(","));
        }
        parts.push(quote`${n}`);
        i += 1;
    }
    quote`&[${parts}]`
}

// --- Serialize ---------------------------------------------------------------

// How an enum is represented (serde's enum representations).
enum Repr {
    External,
    Internal(String),
    Adjacent(String, String),
    Untagged,
}

fn repr(t: &TypeInfo, ia: &Attrs) -> Result<Repr, Error> {
    if ia.untagged {
        if ia.tag.is_some() || ia.content.is_some() {
            return Err(Error::at(t, "untagged cannot be used with tag or content"));
        }
        if !t.is_enum() {
            return Err(Error::at(t, "untagged is for enums"));
        }
        return Ok(Repr::Untagged);
    }
    match (&ia.tag, &ia.content) {
        (None, None) => Ok(Repr::External),
        (Some(tg), None) => {
            if t.is_enum() {
                Ok(Repr::Internal(tg.clone()))
            } else {
                Err(Error::at(t, "tag is for enums"))
            }
        }
        (Some(tg), Some(ct)) => {
            if t.is_enum() {
                Ok(Repr::Adjacent(tg.clone(), ct.clone()))
            } else {
                Err(Error::at(t, "tag and content are for enums"))
            }
        }
        (None, Some(_)) => Err(Error::at(t, "content needs tag")),
    }
}

/// Derives [`Serialize`](crate::serde::Serialize) for a struct or enum,
/// as serde_derive does.
///
/// A struct is serialized as a struct (its fields by name), a tuple
/// struct as a tuple struct, a newtype struct as its field and a unit
/// struct as a unit; an enum's variants are serialized as the enum
/// representation chosen by its attributes (see [`crate::serde`]).
#[derive_macro(Serialize, attrs = [serde])]
pub fn serialize(t: &TypeInfo) -> Result<Code, Error> {
    let ia: Attrs = t.parse_attrs("serde")?;
    let r = repr(t, &ia)?;
    let mut helpers = Code::new();
    let body = match &r {
        Repr::External => t.each_variant(|v| ser_fields(t, v, &ia))?,
        _ => t.each_variant(|v| ser_tagged(t, v, &ia, &r, &mut helpers))?,
    };
    let ser = c(SER);
    let items = quote`fn serialize<__S: ${ser}::Serializer>(&self, __serializer: __S) -> ::std::result::Result<__S::Ok, __S::Error> { ${body} }`;
    helpers.push(&t.impl_for(`${SER}::Serialize`.to_string().as_str(), items));
    Ok(helpers)
}

// The fields of a struct or struct variant written to a SerializeStruct-like
// state __st (trait tr) by key, and how many.
fn struct_fields(bs: &[Binding], ia: &Attrs, tr: &Code) -> Result<(Vec<Code>, usize), Error> {
    let ser = c(SER);
    let mut fields: Vec<Code> = Vec::new();
    let mut n = 0;
    for b in bs.iter() {
        let fa: Attrs = b.field().parse_attrs("serde")?;
        if fa.skip_ser() {
            continue;
        }
        n += 1;
        let key = data_name(
            b.field().ident().to_string().as_str(),
            &fa,
            ia.rule().as_str(),
            false,
        );
        let field = quote`${ser}::${tr}::serialize_field(&mut __st, ${key}, &${b})?;`;
        match &fa.skip_serializing_if {
            Some(p) => {
                let skip = c(p.as_str());
                fields.push(quote`if ${skip}(&${b}) { ${ser}::${tr}::skip_field(&mut __st, ${key})?; } else { ${field} }`);
            }
            None => fields.push(field),
        }
    }
    Ok((fields, n))
}

// A variant of an internally or adjacently tagged or untagged enum written
// (helpers: the types an adjacently tagged variant's content needs).
fn ser_tagged(
    t: &TypeInfo,
    v: &Variant,
    ia: &Attrs,
    r: &Repr,
    helpers: &mut Code,
) -> Result<Code, Error> {
    let ser = c(SER);
    let tname = t.name().to_string();
    let va: Attrs = v.parse_attrs("serde")?;
    let vname = data_name(v.name().to_string().as_str(), &va, ia.rule().as_str(), true);
    let bs = v.bindings();
    let st = c("SerializeStruct");
    let tu = c("SerializeTuple");
    match r {
        Repr::Internal(tag) => Ok(match v.kind() {
            Kind::Unit => {
                quote`let mut __st = __serializer.serialize_struct(${tname}, 1)?; ${ser}::SerializeStruct::serialize_field(&mut __st, ${tag}, ${vname})?; ${ser}::SerializeStruct::end(__st)`
            }
            Kind::Tuple => {
                if bs.len() != 1 {
                    return Err(Error::at(
                        v,
                        "an internally tagged enum cannot have tuple variants",
                    ));
                }
                let x = &bs[0];
                quote`${ser}::Serialize::serialize(&${x}, ::std::serde::private::TaggedSerializer { tag: ${tag}, variant: ${vname}, delegate: __serializer })`
            }
            Kind::Named => {
                let (fields, n) = struct_fields(&bs, ia, &st)?;
                let n1 = num(n + 1);
                quote`let mut __st = __serializer.serialize_struct(${tname}, ${n1})?; ${ser}::SerializeStruct::serialize_field(&mut __st, ${tag}, ${vname})?; ${fields} ${ser}::SerializeStruct::end(__st)`
            }
        }),
        Repr::Adjacent(tag, content) => {
            if v.kind() == Kind::Unit {
                return Ok(
                    quote`let mut __st = __serializer.serialize_struct(${tname}, 1)?; ${ser}::SerializeStruct::serialize_field(&mut __st, ${tag}, ${vname})?; ${ser}::SerializeStruct::end(__st)`,
                );
            }
            let value = if v.kind() == Kind::Tuple && bs.len() == 1 {
                let x = &bs[0];
                quote`&${x}`
            } else {
                helpers.push(&adjacent_content(t, v, ia, vname.as_str())?);
                let h = c(`__${t.name()}_${v.name()}_Content`.to_string().as_str());
                let mut inits: Vec<Code> = Vec::new();
                let mut i = 0;
                for b in bs.iter() {
                    let f = c(`f${i}`.to_string().as_str());
                    inits.push(quote`${f}: &${b},`);
                    i += 1;
                }
                quote`&${h} { ${inits} __m: ::std::marker::PhantomData }`
            };
            Ok(
                quote`let mut __st = __serializer.serialize_struct(${tname}, 2)?; ${ser}::SerializeStruct::serialize_field(&mut __st, ${tag}, ${vname})?; ${ser}::SerializeStruct::serialize_field(&mut __st, ${content}, ${value})?; ${ser}::SerializeStruct::end(__st)`,
            )
        }
        _ => Ok(match v.kind() {
            Kind::Unit => quote`__serializer.serialize_unit()`,
            Kind::Tuple => {
                if bs.len() == 1 {
                    let x = &bs[0];
                    return Ok(quote`${ser}::Serialize::serialize(&${x}, __serializer)`);
                }
                let n = num(bs.len());
                let mut elems: Vec<Code> = Vec::new();
                for b in bs.iter() {
                    elems.push(quote`${ser}::${tu}::serialize_element(&mut __st, &${b})?;`);
                }
                quote`let mut __st = __serializer.serialize_tuple(${n})?; ${elems} ${ser}::${tu}::end(__st)`
            }
            Kind::Named => {
                let (fields, n) = struct_fields(&bs, ia, &st)?;
                let nn = num(n);
                quote`let mut __st = __serializer.serialize_struct(${vname}, ${nn})?; ${fields} ${ser}::SerializeStruct::end(__st)`
            }
        }),
    }
}

// The content of an adjacently tagged tuple or struct variant: a struct of
// references to its fields that serializes as the variant's content would
// (a tuple, or a struct named after the variant).
fn adjacent_content(t: &TypeInfo, v: &Variant, ia: &Attrs, vname: &str) -> Result<Code, Error> {
    let ser = c(SER);
    let h = c(`__${t.name()}_${v.name()}_Content`.to_string().as_str());
    let ps = t.params();
    let me = t.self_type();
    let mut decls: Vec<Code> = Vec::new();
    let mut i = 0;
    for f in v.fields().iter() {
        let fname = c(`f${i}`.to_string().as_str());
        let ty = f.ty();
        decls.push(quote`${fname}: &${ty},`);
        i += 1;
    }
    let mut body: Vec<Code> = Vec::new();
    let mut count = 0;
    i = 0;
    for f in v.fields().iter() {
        let fname = c(`f${i}`.to_string().as_str());
        i += 1;
        if v.kind() == Kind::Tuple {
            body.push(quote`${ser}::SerializeTuple::serialize_element(&mut __st, self.${fname})?;`);
            count += 1;
            continue;
        }
        let fa: Attrs = f.parse_attrs("serde")?;
        if fa.skip_ser() {
            continue;
        }
        count += 1;
        let key = data_name(
            f.ident().to_string().as_str(),
            &fa,
            ia.rule().as_str(),
            false,
        );
        body.push(
            quote`${ser}::SerializeStruct::serialize_field(&mut __st, ${key}, self.${fname})?;`,
        );
    }
    let n = num(count);
    let write = if v.kind() == Kind::Tuple {
        quote`let mut __st = __serializer.serialize_tuple(${n})?; ${body} ${ser}::SerializeTuple::end(__st)`
    } else {
        quote`let mut __st = __serializer.serialize_struct(${vname}, ${n})?; ${body} ${ser}::SerializeStruct::end(__st)`
    };
    let items = quote`fn serialize<__S: ${ser}::Serializer>(&self, __serializer: __S) -> ::std::result::Result<__S::Ok, __S::Error> { ${write} }`;
    let self_ty = quote`${h}${ps}`;
    let bound = c(`${SER}::Serialize`.to_string().as_str());
    let decl = quote`#[allow(non_camel_case_types)] struct ${h}${ps} { ${decls} __m: ::std::marker::PhantomData<${me}> }`;
    let mut out = decl;
    out.push(&t.impl_for_type(
        `${SER}::Serialize`.to_string().as_str(),
        bound,
        self_ty,
        items,
    ));
    Ok(out)
}

// The serialization of a struct's or variant's fields (its bindings).
fn ser_fields(t: &TypeInfo, v: &Variant, ia: &Attrs) -> Result<Code, Error> {
    let ser = c(SER);
    let tname = t.name().to_string();
    let variant = t.is_enum();
    let vi = num(v.index());
    let va: Attrs = v.parse_attrs("serde")?;
    let vname = data_name(v.name().to_string().as_str(), &va, ia.rule().as_str(), true);
    let bs = v.bindings();
    Ok(match v.kind() {
        Kind::Unit => {
            if variant {
                quote`__serializer.serialize_unit_variant(${tname}, ${vi}, ${vname})`
            } else {
                quote`__serializer.serialize_unit_struct(${tname})`
            }
        }
        Kind::Tuple => {
            if bs.len() == 1 {
                let x = &bs[0];
                return Ok(if variant {
                    quote`__serializer.serialize_newtype_variant(${tname}, ${vi}, ${vname}, &${x})`
                } else {
                    quote`__serializer.serialize_newtype_struct(${tname}, &${x})`
                });
            }
            let n = num(bs.len());
            let (open, tr) = if variant {
                (
                    quote`__serializer.serialize_tuple_variant(${tname}, ${vi}, ${vname}, ${n})`,
                    c("SerializeTupleVariant"),
                )
            } else {
                (
                    quote`__serializer.serialize_tuple_struct(${tname}, ${n})`,
                    c("SerializeTupleStruct"),
                )
            };
            let mut fields: Vec<Code> = Vec::new();
            for b in bs.iter() {
                fields.push(quote`${ser}::${tr}::serialize_field(&mut __st, &${b})?;`);
            }
            quote`let mut __st = ${open}?; ${fields} ${ser}::${tr}::end(__st)`
        }
        Kind::Named => {
            let mut count = 0;
            for b in bs.iter() {
                let fa: Attrs = b.field().parse_attrs("serde")?;
                if !fa.skip_ser() {
                    count += 1;
                }
            }
            let n = num(count);
            let (open, tr) = if variant {
                (
                    quote`__serializer.serialize_struct_variant(${tname}, ${vi}, ${vname}, ${n})`,
                    c("SerializeStructVariant"),
                )
            } else {
                (
                    quote`__serializer.serialize_struct(${tname}, ${n})`,
                    c("SerializeStruct"),
                )
            };
            let mut fields: Vec<Code> = Vec::new();
            for b in bs.iter() {
                let fa: Attrs = b.field().parse_attrs("serde")?;
                if fa.skip_ser() {
                    continue;
                }
                let key = data_name(
                    b.field().ident().to_string().as_str(),
                    &fa,
                    ia.rule().as_str(),
                    false,
                );
                let field = quote`${ser}::${tr}::serialize_field(&mut __st, ${key}, &${b})?;`;
                match &fa.skip_serializing_if {
                    Some(p) => {
                        let skip = c(p.as_str());
                        fields.push(quote`if ${skip}(&${b}) { ${ser}::${tr}::skip_field(&mut __st, ${key})?; } else { ${field} }`);
                    }
                    None => fields.push(field),
                }
            }
            quote`let mut __st = ${open}?; ${fields} ${ser}::${tr}::end(__st)`
        }
    })
}

// --- Deserialize -------------------------------------------------------------

/// Derives [`Deserialize`](crate::serde::Deserialize) for a struct or
/// enum, as serde_derive does.
///
/// A struct reads its fields by name from a map or in order from a
/// sequence; unknown fields are skipped unless `deny_unknown_fields`, and a
/// missing field is an error unless it is an `Option` (then `None`) or has
/// `default`. Enums read the representation chosen by their attributes
/// (see [`crate::serde`]).
#[derive_macro(Deserialize, attrs = [serde])]
pub fn deserialize(t: &TypeInfo) -> Result<Code, Error> {
    let de = c(DE);
    let ia: Attrs = t.parse_attrs("serde")?;
    let r = repr(t, &ia)?;
    match &r {
        Repr::External => {}
        _ => return de_tagged(t, &ia, &r),
    }
    let mut out = Code::new();
    let vis = c(`__${t.name()}_Visitor`.to_string().as_str());
    out.push(&visitor_struct(t, &vis));
    let tname = t.name().to_string();
    let mk = marker();
    let call = if !t.is_enum() {
        let v = &t.variants()[0];
        out.push(&struct_visitor(t, v, &ia, &vis, "")?);
        match v.kind() {
            Kind::Unit => quote`__deserializer.deserialize_unit_struct(${tname}, ${vis}${mk})`,
            Kind::Tuple => {
                if v.fields().len() == 1 {
                    quote`__deserializer.deserialize_newtype_struct(${tname}, ${vis}${mk})`
                } else {
                    let n = num(v.fields().len());
                    quote`__deserializer.deserialize_tuple_struct(${tname}, ${n}, ${vis}${mk})`
                }
            }
            Kind::Named => {
                let list = name_list(&field_names(v, &ia)?);
                quote`__deserializer.deserialize_struct(${tname}, ${list}, ${vis}${mk})`
            }
        }
    } else {
        out.push(&enum_visitor(t, &ia, &vis)?);
        let list = name_list(&variant_names(t, &ia)?);
        quote`__deserializer.deserialize_enum(${tname}, ${list}, ${vis}${mk})`
    };
    let items = quote`fn deserialize<__D: ${de}::Deserializer>(__deserializer: __D) -> ::std::result::Result<Self, __D::Error> { ${call} }`;
    out.push(&t.impl_for(`${DE}::Deserialize`.to_string().as_str(), items));
    Ok(out)
}

// struct Name<P...> { marker: PhantomData<Type<P...>> } (Name: a visitor).
fn visitor_struct(t: &TypeInfo, name: &Code) -> Code {
    let ps = t.params();
    let st = t.self_type();
    quote`struct ${name}${ps} { marker: ::std::marker::PhantomData<${st}> }`
}

// The construction of a visitor.
fn marker() -> Code {
    quote` { marker: ::std::marker::PhantomData }`
}

// The visitor's impl (of Visitor, its value the type).
fn visitor_impl(t: &TypeInfo, vis: &Code, items: Code) -> Code {
    let ps = t.params();
    let self_ty = quote`${vis}${ps}`;
    let bound = c(`${DE}::Deserialize`.to_string().as_str());
    t.impl_for_type(`${DE}::Visitor`.to_string().as_str(), bound, self_ty, items)
}

fn field_names(v: &Variant, ia: &Attrs) -> Result<Vec<String>, Error> {
    let mut out: Vec<String> = Vec::new();
    for f in v.fields().iter() {
        let fa: Attrs = f.parse_attrs("serde")?;
        if !fa.skip_de() {
            out.push(data_name(
                f.ident().to_string().as_str(),
                &fa,
                ia.rule().as_str(),
                false,
            ));
        }
    }
    Ok(out)
}

fn variant_names(t: &TypeInfo, ia: &Attrs) -> Result<Vec<String>, Error> {
    let mut out: Vec<String> = Vec::new();
    for v in t.variants().iter() {
        let va: Attrs = v.parse_attrs("serde")?;
        out.push(data_name(
            v.name().to_string().as_str(),
            &va,
            ia.rule().as_str(),
            true,
        ));
    }
    Ok(out)
}

// The local each field is read into.
fn local(i: usize) -> Code {
    c(`__${i}`.to_string().as_str())
}

// The struct or variant v built from the locals.
fn made(v: &Variant) -> Code {
    let mut vals: Vec<Code> = Vec::new();
    let mut i = 0;
    while i < v.fields().len() {
        vals.push(local(i));
        i += 1;
    }
    v.construct(&vals)
}

// A visitor (struct vis, declared already) building a struct or a variant
// from a sequence or a map; for named fields also their identifier
// __Type_Field (prefix: the variant's name and _, for a struct variant's).
fn struct_visitor(
    t: &TypeInfo,
    v: &Variant,
    ia: &Attrs,
    vis: &Code,
    prefix: &str,
) -> Result<Code, Error> {
    let de = c(DE);
    let mut out = Code::new();
    let value = t.self_type();
    let what = if prefix.len() > 0 {
        `struct variant ${t.name()}::${v.name()}`.to_string()
    } else {
        `${if v.kind() == Kind::Unit { "unit struct" } else if v.kind() == Kind::Tuple { "tuple struct" } else { "struct" }} ${t.name()}`.to_string()
    };
    let mut methods = quote`fn expecting(&self, __f: &mut ::std::fmt::Formatter) -> ::std::fmt::Result { __f.write_str(${what}) }`;
    // From a sequence: the fields in order (skipped ones from their
    // defaults).
    let mut seq: Vec<Code> = Vec::new();
    let mut k = 0;
    let mut i = 0;
    for f in v.fields().iter() {
        let fa: Attrs = f.parse_attrs("serde")?;
        let ty = f.ty();
        let x = local(i);
        if fa.skip_de() {
            let d = default_of(&fa);
            seq.push(quote`let ${x}: ${ty} = ${d};`);
        } else {
            let kn = num(k);
            seq.push(quote`let ${x}: ${ty} = match ${de}::SeqAccess::next_element::<${ty}>(&mut __seq)? { ::std::option::Option::Some(__v) => __v, ::std::option::Option::None => return ::std::result::Result::Err(<__A::Error as ${de}::Error>::invalid_length(${kn}, &self)), };`);
            k += 1;
        }
        i += 1;
    }
    let mv = made(v);
    match v.kind() {
        Kind::Unit => {
            methods.push(&quote`fn visit_unit<__E: ${de}::Error>(self) -> ::std::result::Result<${value}, __E> { ::std::result::Result::Ok(${mv}) }`);
        }
        Kind::Tuple => {
            if v.fields().len() == 1 && prefix.len() == 0 {
                let ty = v.fields()[0].ty();
                let x = local(0);
                methods.push(&quote`fn visit_newtype_struct<__E2: ${de}::Deserializer>(self, __e: __E2) -> ::std::result::Result<${value}, __E2::Error> { let ${x}: ${ty} = <${ty} as ${de}::Deserialize>::deserialize(__e)?; ::std::result::Result::Ok(${mv}) }`);
            }
            methods.push(&quote`fn visit_seq<__A: ${de}::SeqAccess>(self, __s: __A) -> ::std::result::Result<${value}, __A::Error> { let mut __seq = __s; ${seq} ::std::result::Result::Ok(${mv}) }`);
        }
        Kind::Named => {
            methods.push(&quote`fn visit_seq<__A: ${de}::SeqAccess>(self, __s: __A) -> ::std::result::Result<${value}, __A::Error> { let mut __seq = __s; ${seq} ::std::result::Result::Ok(${mv}) }`);
            let fid = c(`__${t.name()}_${prefix}Field`.to_string().as_str());
            out.push(&identifier(
                &fid,
                &field_names(v, ia)?,
                ia.deny_unknown_fields,
                false,
            ));
            methods.push(&visit_map(v, ia, &fid, &value, &mv)?);
        }
    }
    out.push(&visitor_impl(
        t,
        vis,
        quote`type Value = ${value}; ${methods}`,
    ));
    Ok(out)
}

// The fields (not skipped) from a map: each once, unknown ones skipped (or
// an error with deny_unknown_fields), missing ones from their defaults or
// missing_field (None for an Option).
fn visit_map(v: &Variant, ia: &Attrs, fid: &Code, value: &Code, mv: &Code) -> Result<Code, Error> {
    let de = c(DE);
    let mut lets: Vec<Code> = Vec::new();
    let mut arms: Vec<Code> = Vec::new();
    let mut finals: Vec<Code> = Vec::new();
    let mut k = 0;
    let mut i = 0;
    for f in v.fields().iter() {
        let fa: Attrs = f.parse_attrs("serde")?;
        let ty = f.ty();
        let x = local(i);
        let dn = data_name(
            f.ident().to_string().as_str(),
            &fa,
            ia.rule().as_str(),
            false,
        );
        if !fa.skip_de() {
            lets.push(
                quote`let mut ${x}: ::std::option::Option<${ty}> = ::std::option::Option::None;`,
            );
            let fk = c(`__f${k}`.to_string().as_str());
            arms.push(quote`${fid}::${fk} => { if ${x}.is_some() { return ::std::result::Result::Err(<__A::Error as ${de}::Error>::duplicate_field(${dn})); } ${x} = ::std::option::Option::Some(${de}::MapAccess::next_value::<${ty}>(&mut __map)?); }`);
            k += 1;
        }
        let missing = if fa.default.is_some() || fa.skip_de() {
            default_of(&fa)
        } else if ia.default.is_some() {
            let fi = f.ident();
            quote`__default.${fi}`
        } else {
            quote`::std::serde::private::missing_field::<${ty}, __A::Error>(${dn})?`
        };
        if fa.skip_de() {
            finals.push(quote`let ${x}: ${ty} = ${missing};`);
        } else {
            finals.push(quote`let ${x}: ${ty} = match ${x} { ::std::option::Option::Some(__v) => __v, ::std::option::Option::None => ${missing}, };`);
        }
        i += 1;
    }
    // A container #[serde(default)]: missing fields from the default value.
    let mut dflt = Code::new();
    if ia.default.is_some() {
        let d = default_of(ia);
        dflt = quote`let __default: ${value} = ${d};`;
    }
    Ok(quote`fn visit_map<__A: ${de}::MapAccess>(self, __m: __A) -> ::std::result::Result<${value}, __A::Error> {
        let mut __map = __m;
        ${lets}
        while let ::std::option::Option::Some(__key) = ${de}::MapAccess::next_key::<${fid}>(&mut __map)? {
            match __key { ${arms} _ => { let _ = ${de}::MapAccess::next_value::<${de}::IgnoredAny>(&mut __map)?; } }
        }
        ${dflt} ${finals}
        ::std::result::Result::Ok(${mv})
    }`)
}

// An identifier enum (fields or variants) and its Deserialize: from a name
// or an index; an unknown one is __ignore (fields) or an error (variants,
// and fields with deny_unknown_fields).
fn identifier(name: &Code, names: &[String], deny: bool, variants: bool) -> Code {
    let de = c(DE);
    let mut cases: Vec<Code> = Vec::new();
    let mut by_str: Vec<Code> = Vec::new();
    let mut by_index: Vec<Code> = Vec::new();
    let mut i = 0;
    while i < names.len() {
        let f = c(`__f${i}`.to_string().as_str());
        let n = names[i].clone();
        let ix = num(i);
        cases.push(quote`${f},`);
        by_str.push(quote`${n} => ::std::result::Result::Ok(${name}::${f}),`);
        by_index.push(quote`${ix} => ::std::result::Result::Ok(${name}::${f}),`);
        i += 1;
    }
    let vis = c(`${name.text()}Visitor`.to_string().as_str());
    let list = name_list(names);
    let unknown_str = if variants {
        quote`return ::std::result::Result::Err(__E::unknown_variant(__v, ${list}))`
    } else if deny {
        quote`return ::std::result::Result::Err(__E::unknown_field(__v, ${list}))`
    } else {
        quote`::std::result::Result::Ok(${name}::__ignore)`
    };
    let below = `an index below ${names.len()}`.to_string();
    let bad_index = if variants || deny {
        quote`::std::result::Result::Err(__E::invalid_value(${de}::Unexpected::Unsigned(__v), ${below}))`
    } else {
        quote`::std::result::Result::Ok(${name}::__ignore)`
    };
    let what = if variants {
        "variant identifier"
    } else {
        "field identifier"
    };
    quote`#[allow(non_camel_case_types)] enum ${name} { ${cases} __ignore }
    struct ${vis};
    impl ${de}::Visitor for ${vis} {
        type Value = ${name};
        fn expecting(&self, __f: &mut ::std::fmt::Formatter) -> ::std::fmt::Result { __f.write_str(${what}) }
        fn visit_u64<__E: ${de}::Error>(self, __v: u64) -> ::std::result::Result<${name}, __E> { match __v { ${by_index} _ => ${bad_index}, } }
        fn visit_str<__E: ${de}::Error>(self, __v: &str) -> ::std::result::Result<${name}, __E> { match __v { ${by_str} _ => { ${unknown_str} } } }
    }

    impl ${de}::Deserialize for ${name} {
        fn deserialize<__D: ${de}::Deserializer>(__d: __D) -> ::std::result::Result<${name}, __D::Error> { __d.deserialize_identifier(${vis}) }
    }`
}

// An enum's visitor (externally tagged): the variant identifier, then the
// variant's content (a visitor per tuple and struct variant).
fn enum_visitor(t: &TypeInfo, ia: &Attrs, vis: &Code) -> Result<Code, Error> {
    let de = c(DE);
    let mut out = Code::new();
    let vid = c(`__${t.name()}_Variant`.to_string().as_str());
    out.push(&identifier(&vid, &variant_names(t, ia)?, true, true));
    let value = t.self_type();
    let mk = marker();
    let mut arms: Vec<Code> = Vec::new();
    for v in t.variants().iter() {
        let path = v.path();
        let f = c(`__f${v.index()}`.to_string().as_str());
        let arm = match v.kind() {
            Kind::Unit => {
                quote`{ ${de}::VariantAccess::unit_variant(__va)?; ::std::result::Result::Ok(${path}) }`
            }
            Kind::Tuple => {
                if v.fields().len() == 1 {
                    let ty = v.fields()[0].ty();
                    quote`::std::result::Result::Ok(${path}(${de}::VariantAccess::newtype_variant::<${ty}>(__va)?))`
                } else {
                    let vv = c(`__${t.name()}_${v.name()}_Visitor`.to_string().as_str());
                    out.push(&visitor_struct(t, &vv));
                    out.push(&struct_visitor(
                        t,
                        v,
                        ia,
                        &vv,
                        `${v.name()}_`.to_string().as_str(),
                    )?);
                    let n = num(v.fields().len());
                    quote`${de}::VariantAccess::tuple_variant(__va, ${n}, ${vv}${mk})`
                }
            }
            Kind::Named => {
                let vv = c(`__${t.name()}_${v.name()}_Visitor`.to_string().as_str());
                out.push(&visitor_struct(t, &vv));
                out.push(&struct_visitor(
                    t,
                    v,
                    ia,
                    &vv,
                    `${v.name()}_`.to_string().as_str(),
                )?);
                let list = name_list(&field_names(v, ia)?);
                quote`${de}::VariantAccess::struct_variant(__va, ${list}, ${vv}${mk})`
            }
        };
        arms.push(quote`${vid}::${f} => ${arm},`);
    }
    let what = `enum ${t.name()}`.to_string();
    let items = quote`type Value = ${value};
        fn expecting(&self, __f: &mut ::std::fmt::Formatter) -> ::std::fmt::Result { __f.write_str(${what}) }
        fn visit_enum<__A: ${de}::EnumAccess>(self, __data: __A) -> ::std::result::Result<${value}, __A::Error> {
            let (__tag, __va) = ${de}::EnumAccess::variant::<${vid}>(__data)?;
            match __tag { ${arms} ${vid}::__ignore => ::std::result::Result::Err(<__A::Error as ${de}::Error>::custom("unknown variant")), }
        }`;
    out.push(&visitor_impl(t, vis, items));
    Ok(out)
}

// The Deserialize of an internally or adjacently tagged or untagged enum:
// the input read as Content first (std::serde::private), then the variant
// it names (or, untagged, the first that takes it) from that.
fn de_tagged(t: &TypeInfo, ia: &Attrs, r: &Repr) -> Result<Code, Error> {
    let de = c(DE);
    let p = c("::std::serde::private");
    let mut out = Code::new();
    let mk = marker();
    let tname = t.name().to_string();
    let list = name_list(&variant_names(t, ia)?);
    let mut arms: Vec<Code> = Vec::new();
    for v in t.variants().iter() {
        let path = v.path();
        let va: Attrs = v.parse_attrs("serde")?;
        let vname = data_name(v.name().to_string().as_str(), &va, ia.rule().as_str(), true);
        let newtype = v.kind() == Kind::Tuple && v.fields().len() == 1;
        // A visitor for a tuple or struct variant's content.
        let vv = c(`__${t.name()}_${v.name()}_Visitor`.to_string().as_str());
        if v.kind() == Kind::Named || (v.kind() == Kind::Tuple && !newtype) {
            if let Repr::Internal(_) = r {
                if v.kind() == Kind::Tuple {
                    return Err(Error::at(
                        v,
                        "an internally tagged enum cannot have tuple variants",
                    ));
                }
            }
            out.push(&visitor_struct(t, &vv));
            out.push(&struct_visitor(
                t,
                v,
                ia,
                &vv,
                `${v.name()}_`.to_string().as_str(),
            )?);
        }
        let read = if v.kind() == Kind::Named {
            c("deserialize_map")
        } else {
            c("deserialize_seq")
        };
        let arm = match r {
            Repr::Internal(_) => match v.kind() {
                Kind::Unit => quote`${vname} => ::std::result::Result::Ok(${path}),`,
                Kind::Tuple => {
                    let ty = v.fields()[0].ty();
                    quote`${vname} => ::std::result::Result::Ok(${path}(<${ty} as ${de}::Deserialize>::deserialize(${p}::ContentDeserializer::<__D::Error>::new(__rest))?)),`
                }
                Kind::Named => {
                    quote`${vname} => ${de}::Deserializer::deserialize_map(${p}::ContentDeserializer::<__D::Error>::new(__rest), ${vv}${mk}),`
                }
            },
            Repr::Adjacent(_, content) => {
                let missing = quote`::std::option::Option::None => ::std::result::Result::Err(<__D::Error as ${de}::Error>::missing_field(${content})),`;
                if v.kind() == Kind::Unit {
                    quote`${vname} => ::std::result::Result::Ok(${path}),`
                } else if newtype {
                    let ty = v.fields()[0].ty();
                    quote`${vname} => match __val { ::std::option::Option::Some(__v) => ::std::result::Result::Ok(${path}(<${ty} as ${de}::Deserialize>::deserialize(${p}::ContentDeserializer::<__D::Error>::new(__v))?)), ${missing} },`
                } else {
                    quote`${vname} => match __val { ::std::option::Option::Some(__v) => ${de}::Deserializer::${read}(${p}::ContentDeserializer::<__D::Error>::new(__v), ${vv}${mk}), ${missing} },`
                }
            }
            _ => {
                if v.kind() == Kind::Unit {
                    quote`if let ${p}::Content::Unit = __c { return ::std::result::Result::Ok(${path}); }`
                } else if newtype {
                    let ty = v.fields()[0].ty();
                    quote`if let ::std::result::Result::Ok(__x) = <${ty} as ${de}::Deserialize>::deserialize(${p}::ContentDeserializer::<__D::Error>::new(__c.clone())) { return ::std::result::Result::Ok(${path}(__x)); }`
                } else {
                    quote`if let ::std::result::Result::Ok(__x) = ${de}::Deserializer::${read}(${p}::ContentDeserializer::<__D::Error>::new(__c.clone()), ${vv}${mk}) { return ::std::result::Result::Ok(__x); }`
                }
            }
        };
        arms.push(arm);
    }
    let unknown = quote`_ => ::std::result::Result::Err(<__D::Error as ${de}::Error>::unknown_variant(__name.as_str(), ${list})),`;
    let body = match r {
        Repr::Internal(tag) => {
            quote`let (__name, __rest) = ${p}::take_tag::<__D::Error>(__c, ${tag})?; match __name.as_str() { ${arms} ${unknown} }`
        }
        Repr::Adjacent(tag, content) => {
            quote`let (__name, __val) = ${p}::take_adjacent::<__D::Error>(__c, ${tag}, ${content})?; match __name.as_str() { ${arms} ${unknown} }`
        }
        _ => {
            quote`${arms} ::std::result::Result::Err(${p}::untagged_error::<__D::Error>(${tname}))`
        }
    };
    let items = quote`fn deserialize<__D: ${de}::Deserializer>(__deserializer: __D) -> ::std::result::Result<Self, __D::Error> {
        let __c = <${p}::Content as ${de}::Deserialize>::deserialize(__deserializer)?;
        ${body}
    }`;
    out.push(&t.impl_for(`${DE}::Deserialize`.to_string().as_str(), items));
    Ok(out)
}
