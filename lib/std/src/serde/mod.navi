//! A framework for serializing and deserializing values, as the serde
//! crate (without lifetimes).
//!
//! Types implement [`Serialize`] and [`Deserialize`], usually with
//! `#[derive(Serialize, Deserialize)]`; data formats ([`crate::json`],
//! [`crate::csv`]) implement [`Serializer`] and [`Deserializer`]. The two
//! meet in serde's data model (booleans, integers, floats, strings,
//! options, sequences, maps, structs and enum variants), so any type with
//! the derives can be written in any format.
//!
//! `use std::serde::{Deserialize, Serialize};` brings in both the traits
//! and the derive macros of the same names. Hand-written implementations
//! use the traits of [`ser`] and [`de`] (see [`Serialize`] and
//! [`de::Visitor`] for examples).
//!
//! # Examples
//!
//! ```
//! use std::{
//!     json,
//!     serde::{Deserialize, Serialize},
//! };
//!
//! #[derive(Serialize, Deserialize, Clone, Debug, PartialEq)]
//! enum Shape {
//!     Circle { r: f64 },
//!     Square(f64),
//!     Empty,
//! }
//!
//! #[derive(Serialize, Deserialize, Debug, PartialEq)]
//! struct Drawing {
//!     name: String,
//!     shapes: Vec<Shape>,
//!     scale: Option<f64>,
//! }
//!
//! let d = Drawing {
//!     name: "logo".to_string(),
//!     shapes: Vec::from([Shape::Circle { r: 1.5 }, Shape::Square(2.0), Shape::Empty]),
//!     scale: None,
//! };
//! let s = json::to_string(&d).unwrap();
//! assert_eq(
//!     s,
//!     r#"{"name":"logo","shapes":[{"Circle":{"r":1.5}},{"Square":2},"Empty"],"scale":null}"#,
//! );
//! assert_eq(json::from_str::<Drawing>(s.as_str()).unwrap(), d);
//! ```
//!
//! # Attributes
//!
//! The derives take serde_derive's `#[serde(...)]` attributes:
//!
//! - on a struct or enum: `rename_all = "..."` (`lowercase`, `UPPERCASE`,
//!   `PascalCase`, `camelCase`, `snake_case`, `SCREAMING_SNAKE_CASE`,
//!   `kebab-case`), `deny_unknown_fields`, `default` (missing fields from the
//!   type's `Default`), and the enum representations below;
//! - on a field: `rename = "name"`, `skip`, `skip_serializing`,
//!   `skip_deserializing`, `default` or `default = "path"`,
//!   `skip_serializing_if = "path"`;
//! - on a variant: `rename = "name"`.
//!
//! Enums are externally tagged by default (`"Variant"` or
//! `{"Variant": content}`); `#[serde(tag = "t")]` makes them internally
//! tagged (`{"t": "Variant", ...fields}`), `#[serde(tag = "t", content =
//! "c")]` adjacently tagged (`{"t": "Variant", "c": content}`), and
//! `#[serde(untagged)]` untagged (the content alone; reading tries the
//! variants in order).
//!
//! ```
//! use std::{
//!     json,
//!     serde::{Deserialize, Serialize},
//! };
//!
//! #[derive(Serialize, Deserialize, Debug, PartialEq)]
//! #[serde(rename_all = "camelCase")]
//! struct User {
//!     user_id: u64,
//!     #[serde(skip_serializing_if = "Option::is_none")]
//!     nick_name: Option<String>,
//!     #[serde(default)]
//!     login_count: i32,
//! }
//!
//! #[derive(Serialize, Deserialize, Debug, PartialEq)]
//! #[serde(tag = "type")]
//! enum Event {
//!     Login { user: u64 },
//!     Logout { user: u64 },
//! }
//!
//! let u = User {
//!     user_id: 7,
//!     nick_name: None,
//!     login_count: 3,
//! };
//! assert_eq(
//!     json::to_string(&u).unwrap(),
//!     r#"{"userId":7,"loginCount":3}"#,
//! );
//! let back: User = json::from_str(r#"{"userId":7}"#).unwrap();
//! assert_eq(back.login_count, 0);
//!
//! let e = Event::Login { user: 7 };
//! assert_eq(json::to_string(&e).unwrap(), r#"{"type":"Login","user":7}"#);
//! assert_eq(
//!     json::from_str::<Event>(r#"{"user":1,"type":"Logout"}"#).unwrap(),
//!     Event::Logout { user: 1 },
//! );
//! ```

pub mod de;
pub mod derive;
pub mod private;
pub mod ser;

// The derives, with the traits' names (one use takes both).
pub use self::derive::{Deserialize, Serialize};
pub use self::{
    de::{Deserialize, Deserializer},
    ser::{Serialize, Serializer},
};
