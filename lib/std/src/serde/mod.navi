//! A framework for serializing and deserializing values (as Rust's serde,
//! without lifetimes): types implement Serialize and Deserialize, usually
//! with #[derive(Serialize, Deserialize)]; data formats (std::json,
//! std::csv) implement Serializer and Deserializer. The derives and their
//! #[serde(...)] attributes follow serde_derive (docs/derive.md).

pub mod ser;
pub mod de;
pub mod private;
pub mod derive;

pub use self::ser::{Serialize, Serializer};
pub use self::de::{Deserialize, Deserializer};
// The derives, with the traits' names (one use takes both).
pub use self::derive::{Serialize, Deserialize};
