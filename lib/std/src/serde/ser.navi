//! Generic serialization: the [`Serialize`] and [`Serializer`] traits.
//!
//! This is serde's `ser` module without lifetimes. A data structure that
//! implements [`Serialize`] writes itself to any [`Serializer`] by calling
//! the serializer's methods, one per kind of value in serde's data model
//! (booleans, integers, floats, strings, options, unit, sequences, tuples,
//! maps, structs and the four kinds of enum variants). A data format such as
//! [`std::json`](crate::json) implements [`Serializer`] and decides how each
//! kind of value is written.
//!
//! Compound values are written in three steps: a `serialize_*` method such
//! as [`Serializer::serialize_struct`] starts the value and returns a state
//! ([`SerializeStruct`] and so on), the state takes the elements one at a
//! time, and its `end` method finishes the value.
//!
//! Most types derive [`Serialize`] with `#[derive(Serialize)]` (see
//! [`crate::serde`]); std implements it for the primitive types, `String`
//! and `str`, `Option`, references, tuples of up to four elements, arrays,
//! slices, `Vec`, `VecDeque`, `HashSet`, `BTreeSet`, `HashMap` and
//! `BTreeMap`.
//!
//! # Examples
//!
//! Implementing [`Serialize`] by hand for a struct, as the derive would:
//!
//! ```
//! use std::json;
//! use std::serde::ser::{Serialize, SerializeStruct, Serializer};
//!
//! struct Color {
//!     r: u8,
//!     g: u8,
//!     b: u8,
//! }
//!
//! impl Serialize for Color {
//!     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
//!         // 3 is the number of fields in the struct.
//!         let mut state = serializer.serialize_struct("Color", 3)?;
//!         state.serialize_field("r", &self.r)?;
//!         state.serialize_field("g", &self.g)?;
//!         state.serialize_field("b", &self.b)?;
//!         state.end()
//!     }
//! }
//!
//! let red = Color { r: 255, g: 0, b: 0 };
//! assert_eq(json::to_string(&red).unwrap(), "{\"r\":255,\"g\":0,\"b\":0}");
//! ```

use crate::cmp::Eq;
use crate::collections::{BTreeMap, BTreeSet, HashMap, HashSet, VecDeque};
use crate::fmt::Display;
use crate::hash::Hash;

/// The error type a [`Serializer`] returns, as serde's `ser::Error`.
///
/// [`Serialize`] implementations use it to make errors of whatever
/// serializer they are running against, without knowing its error type.
///
/// # Examples
///
/// ```
/// use std::json;
/// use std::serde::ser::{self, Serialize, Serializer};
///
/// struct Password(String);
///
/// impl Serialize for Password {
///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
///         Err(<S::Error as ser::Error>::custom("passwords are never serialized"))
///     }
/// }
///
/// let e = json::to_string(&Password("hunter2".to_string())).unwrap_err();
/// assert_eq(e.to_string(), "json: passwords are never serialized");
/// ```
pub trait Error: Display {
    /// Makes an error from a message, for a [`Serialize`] implementation
    /// that fails for a reason of its own.
    ///
    /// The message should not be capitalized and should not end with a
    /// period.
    fn custom<T: Display>(msg: T) -> Self;
}

/// A data structure that can be serialized into any data format supported
/// by serde.
///
/// std implements `Serialize` for its common types (see the
/// [module documentation](crate::serde::ser)). Your own structs and enums
/// usually derive it with `#[derive(Serialize)]` (imported with
/// `use std::serde::Serialize;`, which brings in both the trait and the
/// derive); the `#[serde(...)]` attributes described in [`crate::serde`]
/// adjust what the derive writes. In rare cases it is implemented by hand,
/// by calling the [`Serializer`]'s methods.
///
/// # Examples
///
/// Deriving it:
///
/// ```
/// use std::json;
/// use std::serde::Serialize;
///
/// #[derive(Serialize)]
/// struct Point {
///     x: i32,
///     y: i32,
/// }
///
/// assert_eq(json::to_string(&Point { x: 1, y: -2 }).unwrap(), "{\"x\":1,\"y\":-2}");
/// ```
///
/// Implementing it by hand, here to write a collection type as a
/// sequence:
///
/// ```
/// use std::json;
/// use std::serde::ser::{Serialize, SerializeSeq, Serializer};
///
/// struct Stack {
///     items: Vec<i32>,
/// }
///
/// impl Serialize for Stack {
///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
///         let mut seq = serializer.serialize_seq(Some(self.items.len()))?;
///         for x in self.items.iter() {
///             seq.serialize_element(x)?;
///         }
///         seq.end()
///     }
/// }
///
/// let s = Stack { items: Vec::from([1, 2, 3]) };
/// assert_eq(json::to_string(&s).unwrap(), "[1,2,3]");
/// ```
pub trait Serialize {
    /// Serializes this value into the given serializer.
    ///
    /// # Errors
    ///
    /// Returns the serializer's error if it fails to write the value, or an
    /// error made with [`Error::custom`] if the value cannot be serialized.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json;
    /// use std::serde::ser::{Serialize, Serializer};
    ///
    /// struct Meters(f64);
    ///
    /// impl Serialize for Meters {
    ///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
    ///         serializer.serialize_f64(self.0)
    ///     }
    /// }
    ///
    /// assert_eq(json::to_string(&Meters(2.5)).unwrap(), "2.5");
    /// ```
    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error>;
}

/// A data format that can serialize any data structure supported by serde.
///
/// The methods correspond to the types of serde's data model. A
/// [`Serialize`] implementation maps its type into the data model by
/// calling exactly one of them; the data format decides how each is
/// written. The methods for compound values (sequences, tuples, maps,
/// structs and non-unit variants) return a state, one of the
/// `Serialize*` traits, that takes the elements and then finishes the
/// value with `end`.
///
/// The methods take `self` by value, so a serializer writes exactly one
/// value; formats usually implement this trait for `&mut` a writer type
/// ([`std::json`](crate::json)'s is `&mut json::Writer`).
///
/// Methods with default implementations forward to a wider method: the
/// smaller integers to [`serialize_i64`](Serializer::serialize_i64) and
/// [`serialize_u64`](Serializer::serialize_u64), `f32` to
/// [`serialize_f64`](Serializer::serialize_f64) and `char` to
/// [`serialize_str`](Serializer::serialize_str) (serde leaves them to the
/// format, and has `i128` and `u128` as well).
///
/// # Examples
///
/// A [`Serialize`] implementation for an enum, calling the method for the
/// kind of each variant:
///
/// ```
/// use std::json;
/// use std::serde::ser::{Serialize, Serializer};
///
/// enum Shape {
///     Dot,
///     Circle(f64),
/// }
///
/// impl Serialize for Shape {
///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
///         match self {
///             Shape::Dot => serializer.serialize_unit_variant("Shape", 0, "Dot"),
///             Shape::Circle(r) => serializer.serialize_newtype_variant("Shape", 1, "Circle", r),
///         }
///     }
/// }
///
/// assert_eq(json::to_string(&Shape::Dot).unwrap(), "\"Dot\"");
/// assert_eq(json::to_string(&Shape::Circle(1.5)).unwrap(), "{\"Circle\":1.5}");
/// ```
pub trait Serializer {
    /// The output of a successful serialization.
    ///
    /// Serializers that write text or bytes into a buffer they hold usually
    /// set `Ok = ()`; ones that build a value in memory return it here.
    type Ok;
    /// The error type when serialization fails.
    type Error: Error;
    /// The state [`serialize_seq`](Serializer::serialize_seq) returns, which
    /// takes the sequence's elements.
    type SerializeSeq: SerializeSeq<Ok = Self::Ok, Error = Self::Error>;
    /// The state [`serialize_tuple`](Serializer::serialize_tuple) returns,
    /// which takes the tuple's elements.
    type SerializeTuple: SerializeTuple<Ok = Self::Ok, Error = Self::Error>;
    /// The state [`serialize_tuple_struct`](Serializer::serialize_tuple_struct)
    /// returns, which takes the tuple struct's fields.
    type SerializeTupleStruct: SerializeTupleStruct<Ok = Self::Ok, Error = Self::Error>;
    /// The state
    /// [`serialize_tuple_variant`](Serializer::serialize_tuple_variant)
    /// returns, which takes the tuple variant's fields.
    type SerializeTupleVariant: SerializeTupleVariant<Ok = Self::Ok, Error = Self::Error>;
    /// The state [`serialize_map`](Serializer::serialize_map) returns, which
    /// takes the map's entries.
    type SerializeMap: SerializeMap<Ok = Self::Ok, Error = Self::Error>;
    /// The state [`serialize_struct`](Serializer::serialize_struct) returns,
    /// which takes the struct's fields.
    type SerializeStruct: SerializeStruct<Ok = Self::Ok, Error = Self::Error>;
    /// The state
    /// [`serialize_struct_variant`](Serializer::serialize_struct_variant)
    /// returns, which takes the struct variant's fields.
    type SerializeStructVariant: SerializeStructVariant<Ok = Self::Ok, Error = Self::Error>;

    /// Serializes a `bool`.
    fn serialize_bool(self, v: bool) -> Result<Self::Ok, Self::Error>;
    /// Serializes an `i8`.
    ///
    /// The default implementation casts it to `i64` and calls
    /// [`serialize_i64`](Serializer::serialize_i64).
    fn serialize_i8(self, v: i8) -> Result<Self::Ok, Self::Error> {
        self.serialize_i64(v as i64)
    }

    /// Serializes an `i16`.
    ///
    /// The default implementation casts it to `i64` and calls
    /// [`serialize_i64`](Serializer::serialize_i64).
    fn serialize_i16(self, v: i16) -> Result<Self::Ok, Self::Error> {
        self.serialize_i64(v as i64)
    }

    /// Serializes an `i32`.
    ///
    /// The default implementation casts it to `i64` and calls
    /// [`serialize_i64`](Serializer::serialize_i64).
    fn serialize_i32(self, v: i32) -> Result<Self::Ok, Self::Error> {
        self.serialize_i64(v as i64)
    }

    /// Serializes an `i64` (std's `Serialize` for `isize` calls this too).
    fn serialize_i64(self, v: i64) -> Result<Self::Ok, Self::Error>;
    /// Serializes a `u8`.
    ///
    /// The default implementation casts it to `u64` and calls
    /// [`serialize_u64`](Serializer::serialize_u64).
    fn serialize_u8(self, v: u8) -> Result<Self::Ok, Self::Error> {
        self.serialize_u64(v as u64)
    }

    /// Serializes a `u16`.
    ///
    /// The default implementation casts it to `u64` and calls
    /// [`serialize_u64`](Serializer::serialize_u64).
    fn serialize_u16(self, v: u16) -> Result<Self::Ok, Self::Error> {
        self.serialize_u64(v as u64)
    }

    /// Serializes a `u32`.
    ///
    /// The default implementation casts it to `u64` and calls
    /// [`serialize_u64`](Serializer::serialize_u64).
    fn serialize_u32(self, v: u32) -> Result<Self::Ok, Self::Error> {
        self.serialize_u64(v as u64)
    }

    /// Serializes a `u64` (std's `Serialize` for `usize` calls this too).
    fn serialize_u64(self, v: u64) -> Result<Self::Ok, Self::Error>;
    /// Serializes an `f32`.
    ///
    /// The default implementation casts it to `f64` and calls
    /// [`serialize_f64`](Serializer::serialize_f64).
    fn serialize_f32(self, v: f32) -> Result<Self::Ok, Self::Error> {
        self.serialize_f64(v as f64)
    }

    /// Serializes an `f64`.
    fn serialize_f64(self, v: f64) -> Result<Self::Ok, Self::Error>;
    /// Serializes a `char`.
    ///
    /// The default implementation writes it as a string of one character
    /// with [`serialize_str`](Serializer::serialize_str).
    fn serialize_char(self, v: char) -> Result<Self::Ok, Self::Error> {
        let mut s = String::new();
        s.push(v);
        self.serialize_str(s.as_str())
    }

    /// Serializes a string.
    fn serialize_str(self, v: &str) -> Result<Self::Ok, Self::Error>;
    /// Serializes a chunk of raw bytes.
    ///
    /// `Vec<u8>` and `[u8]` do not call this (they are sequences of
    /// numbers); a type calls it to be written as bytes where the format has
    /// them. JSON writes the bytes as an array of numbers.
    fn serialize_bytes(self, v: &[u8]) -> Result<Self::Ok, Self::Error>;
    /// Serializes a `None`.
    fn serialize_none(self) -> Result<Self::Ok, Self::Error>;
    /// Serializes a `Some(value)`.
    fn serialize_some<T: Serialize>(self, value: &T) -> Result<Self::Ok, Self::Error>;
    /// Serializes a `()`.
    fn serialize_unit(self) -> Result<Self::Ok, Self::Error>;
    /// Serializes a unit struct like `struct Unit`.
    ///
    /// `name` is the struct's name. A reasonable implementation forwards to
    /// [`serialize_unit`](Serializer::serialize_unit), as JSON does
    /// (`null`).
    fn serialize_unit_struct(self, name: &str) -> Result<Self::Ok, Self::Error>;
    /// Serializes a unit variant like `E::A` in `enum E { A, B }`.
    ///
    /// `name` is the enum's name, `variant_index` the variant's position in
    /// the enum and `variant` its name. JSON writes the name as a string.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json;
    /// use std::serde::ser::{Serialize, Serializer};
    ///
    /// enum Dir {
    ///     North,
    ///     South,
    /// }
    ///
    /// impl Serialize for Dir {
    ///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
    ///         match self {
    ///             Dir::North => serializer.serialize_unit_variant("Dir", 0, "North"),
    ///             Dir::South => serializer.serialize_unit_variant("Dir", 1, "South"),
    ///         }
    ///     }
    /// }
    ///
    /// assert_eq(json::to_string(&Dir::South).unwrap(), "\"South\"");
    /// ```
    fn serialize_unit_variant(
        self,
        name: &str,
        variant_index: u32,
        variant: &str,
    ) -> Result<Self::Ok, Self::Error>;
    /// Serializes a newtype struct like `struct Millimeters(u8)`.
    ///
    /// Serializers are encouraged to treat a newtype struct as an
    /// insignificant wrapper around its value, as JSON does: a reasonable
    /// implementation forwards to `value.serialize(self)`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json;
    /// use std::serde::ser::{Serialize, Serializer};
    ///
    /// struct Millimeters(u8);
    ///
    /// impl Serialize for Millimeters {
    ///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
    ///         serializer.serialize_newtype_struct("Millimeters", &self.0)
    ///     }
    /// }
    ///
    /// assert_eq(json::to_string(&Millimeters(12)).unwrap(), "12");
    /// ```
    fn serialize_newtype_struct<T: Serialize>(
        self,
        name: &str,
        value: &T,
    ) -> Result<Self::Ok, Self::Error>;
    /// Serializes a newtype variant like `E::N` in `enum E { N(u8) }`.
    ///
    /// `name` is the enum's name, `variant_index` the variant's position in
    /// the enum, `variant` its name and `value` its field. JSON writes
    /// `{"N":value}`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json;
    /// use std::serde::ser::{Serialize, Serializer};
    ///
    /// enum Id {
    ///     Number(u32),
    ///     Name(String),
    /// }
    ///
    /// impl Serialize for Id {
    ///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
    ///         match self {
    ///             Id::Number(n) => serializer.serialize_newtype_variant("Id", 0, "Number", n),
    ///             Id::Name(s) => serializer.serialize_newtype_variant("Id", 1, "Name", s),
    ///         }
    ///     }
    /// }
    ///
    /// assert_eq(json::to_string(&Id::Number(7)).unwrap(), "{\"Number\":7}");
    /// ```
    fn serialize_newtype_variant<T: Serialize>(
        self,
        name: &str,
        variant_index: u32,
        variant: &str,
        value: &T,
    ) -> Result<Self::Ok, Self::Error>;
    /// Begins to serialize a sequence whose length may not be known in
    /// advance.
    ///
    /// The call must be followed by zero or more calls to
    /// [`serialize_element`](SerializeSeq::serialize_element) on the
    /// returned state, then a call to [`end`](SerializeSeq::end). `len` is
    /// the number of elements, if it is known before iterating; some
    /// formats only support sequences whose length is known up front.
    ///
    /// # Errors
    ///
    /// Returns an error if the format cannot start a sequence (for example
    /// one without a length, where the format needs it).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json;
    /// use std::serde::ser::{Serialize, SerializeSeq, Serializer};
    ///
    /// struct Evens {
    ///     below: u32,
    /// }
    ///
    /// impl Serialize for Evens {
    ///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
    ///         let mut seq = serializer.serialize_seq(None)?;
    ///         let mut n = 0u32;
    ///         while n < self.below {
    ///             seq.serialize_element(&n)?;
    ///             n += 2;
    ///         }
    ///         seq.end()
    ///     }
    /// }
    ///
    /// assert_eq(json::to_string(&Evens { below: 7 }).unwrap(), "[0,2,4,6]");
    /// ```
    fn serialize_seq(self, len: Option<usize>) -> Result<Self::SerializeSeq, Self::Error>;
    /// Begins to serialize a sequence of fixed length, such as a tuple or
    /// an array, whose length the deserializer knows without reading it
    /// from the data.
    ///
    /// The call must be followed by exactly `len` calls to
    /// [`serialize_element`](SerializeTuple::serialize_element) on the
    /// returned state, then a call to [`end`](SerializeTuple::end).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json;
    /// use std::serde::ser::{Serialize, SerializeTuple, Serializer};
    ///
    /// struct Pair {
    ///     key: String,
    ///     value: i32,
    /// }
    ///
    /// impl Serialize for Pair {
    ///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
    ///         let mut t = serializer.serialize_tuple(2)?;
    ///         t.serialize_element(&self.key)?;
    ///         t.serialize_element(&self.value)?;
    ///         t.end()
    ///     }
    /// }
    ///
    /// let p = Pair { key: "a".to_string(), value: 1 };
    /// assert_eq(json::to_string(&p).unwrap(), "[\"a\",1]");
    /// ```
    fn serialize_tuple(self, len: usize) -> Result<Self::SerializeTuple, Self::Error>;
    /// Begins to serialize a tuple struct like `struct Rgb(u8, u8, u8)`.
    ///
    /// The call must be followed by exactly `len` calls to
    /// [`serialize_field`](SerializeTupleStruct::serialize_field) on the
    /// returned state, then a call to [`end`](SerializeTupleStruct::end).
    /// `name` is the struct's name. JSON writes an array.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json;
    /// use std::serde::ser::{Serialize, SerializeTupleStruct, Serializer};
    ///
    /// struct Rgb(u8, u8, u8);
    ///
    /// impl Serialize for Rgb {
    ///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
    ///         let mut ts = serializer.serialize_tuple_struct("Rgb", 3)?;
    ///         ts.serialize_field(&self.0)?;
    ///         ts.serialize_field(&self.1)?;
    ///         ts.serialize_field(&self.2)?;
    ///         ts.end()
    ///     }
    /// }
    ///
    /// assert_eq(json::to_string(&Rgb(255, 128, 0)).unwrap(), "[255,128,0]");
    /// ```
    fn serialize_tuple_struct(
        self,
        name: &str,
        len: usize,
    ) -> Result<Self::SerializeTupleStruct, Self::Error>;
    /// Begins to serialize a tuple variant like `E::T` in
    /// `enum E { T(u8, u8) }`.
    ///
    /// The call must be followed by exactly `len` calls to
    /// [`serialize_field`](SerializeTupleVariant::serialize_field) on the
    /// returned state, then a call to [`end`](SerializeTupleVariant::end).
    /// `name` is the enum's name, `variant_index` the variant's position and
    /// `variant` its name. JSON writes `{"T":[...]}`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json;
    /// use std::serde::ser::{Serialize, SerializeTupleVariant, Serializer};
    ///
    /// enum Shape {
    ///     Line(i32, i32),
    /// }
    ///
    /// impl Serialize for Shape {
    ///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
    ///         match self {
    ///             Shape::Line(a, b) => {
    ///                 let mut tv = serializer.serialize_tuple_variant("Shape", 0, "Line", 2)?;
    ///                 tv.serialize_field(a)?;
    ///                 tv.serialize_field(b)?;
    ///                 tv.end()
    ///             }
    ///         }
    ///     }
    /// }
    ///
    /// assert_eq(json::to_string(&Shape::Line(1, 5)).unwrap(), "{\"Line\":[1,5]}");
    /// ```
    fn serialize_tuple_variant(
        self,
        name: &str,
        variant_index: u32,
        variant: &str,
        len: usize,
    ) -> Result<Self::SerializeTupleVariant, Self::Error>;
    /// Begins to serialize a map.
    ///
    /// The call must be followed by zero or more calls to
    /// [`serialize_key`](SerializeMap::serialize_key) and
    /// [`serialize_value`](SerializeMap::serialize_value) (or
    /// [`serialize_entry`](SerializeMap::serialize_entry)) on the returned
    /// state, then a call to [`end`](SerializeMap::end). `len` is the number
    /// of entries, if it is known before iterating.
    ///
    /// # Errors
    ///
    /// Returns an error if the format cannot start a map (for example one
    /// without a length, where the format needs it).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json;
    /// use std::serde::ser::{Serialize, SerializeMap, Serializer};
    ///
    /// struct Scores {
    ///     entries: Vec<(String, u32)>,
    /// }
    ///
    /// impl Serialize for Scores {
    ///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
    ///         let mut map = serializer.serialize_map(Some(self.entries.len()))?;
    ///         for (name, score) in self.entries.iter() {
    ///             map.serialize_entry(name, score)?;
    ///         }
    ///         map.end()
    ///     }
    /// }
    ///
    /// let s = Scores { entries: Vec::from([("ann".to_string(), 3), ("bo".to_string(), 5)]) };
    /// assert_eq(json::to_string(&s).unwrap(), "{\"ann\":3,\"bo\":5}");
    /// ```
    fn serialize_map(self, len: Option<usize>) -> Result<Self::SerializeMap, Self::Error>;
    /// Begins to serialize a struct like `struct Rgb { r: u8, g: u8, b: u8 }`.
    ///
    /// The call must be followed by zero or more calls to
    /// [`serialize_field`](SerializeStruct::serialize_field) on the returned
    /// state, then a call to [`end`](SerializeStruct::end). `name` is the
    /// struct's name and `len` the number of fields that will be serialized
    /// (fields left out with [`skip_field`](SerializeStruct::skip_field) are
    /// not counted). JSON writes an object.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json;
    /// use std::serde::ser::{Serialize, SerializeStruct, Serializer};
    ///
    /// struct Rgb {
    ///     r: u8,
    ///     g: u8,
    ///     b: u8,
    /// }
    ///
    /// impl Serialize for Rgb {
    ///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
    ///         let mut st = serializer.serialize_struct("Rgb", 3)?;
    ///         st.serialize_field("r", &self.r)?;
    ///         st.serialize_field("g", &self.g)?;
    ///         st.serialize_field("b", &self.b)?;
    ///         st.end()
    ///     }
    /// }
    ///
    /// assert_eq(json::to_string(&Rgb { r: 1, g: 2, b: 3 }).unwrap(), "{\"r\":1,\"g\":2,\"b\":3}");
    /// ```
    fn serialize_struct(self, name: &str, len: usize)
    -> Result<Self::SerializeStruct, Self::Error>;
    /// Begins to serialize a struct variant like `E::S` in
    /// `enum E { S { r: u8, g: u8, b: u8 } }`.
    ///
    /// The call must be followed by zero or more calls to
    /// [`serialize_field`](SerializeStructVariant::serialize_field) on the
    /// returned state, then a call to [`end`](SerializeStructVariant::end).
    /// `name` is the enum's name, `variant_index` the variant's position,
    /// `variant` its name and `len` the number of fields that will be
    /// serialized. JSON writes `{"S":{...}}`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json;
    /// use std::serde::ser::{Serialize, SerializeStructVariant, Serializer};
    ///
    /// enum Event {
    ///     Move { x: i32, y: i32 },
    /// }
    ///
    /// impl Serialize for Event {
    ///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
    ///         match self {
    ///             Event::Move { x, y } => {
    ///                 let mut sv = serializer.serialize_struct_variant("Event", 0, "Move", 2)?;
    ///                 sv.serialize_field("x", x)?;
    ///                 sv.serialize_field("y", y)?;
    ///                 sv.end()
    ///             }
    ///         }
    ///     }
    /// }
    ///
    /// let e = Event::Move { x: 1, y: 2 };
    /// assert_eq(json::to_string(&e).unwrap(), "{\"Move\":{\"x\":1,\"y\":2}}");
    /// ```
    fn serialize_struct_variant(
        self,
        name: &str,
        variant_index: u32,
        variant: &str,
        len: usize,
    ) -> Result<Self::SerializeStructVariant, Self::Error>;

    /// Whether [`Serialize`] implementations should write the
    /// human-readable form of their value.
    ///
    /// Some types have a readable form (a date as a string) and a compact
    /// one (a number) and pick by asking the serializer. The default
    /// returns `true`; JSON is human-readable.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json;
    /// use std::serde::ser::{Serialize, Serializer};
    ///
    /// struct Millis(u64);
    ///
    /// impl Serialize for Millis {
    ///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
    ///         if serializer.is_human_readable() {
    ///             serializer.serialize_str(`${self.0}ms`.to_string().as_str())
    ///         } else {
    ///             serializer.serialize_u64(self.0)
    ///         }
    ///     }
    /// }
    ///
    /// assert_eq(json::to_string(&Millis(250)).unwrap(), "\"250ms\"");
    /// ```
    fn is_human_readable(&self) -> bool {
        true
    }
}

/// The state returned by [`Serializer::serialize_seq`], which takes the
/// elements of a sequence.
///
/// # Examples
///
/// ```
/// use std::json;
/// use std::serde::ser::{Serialize, SerializeSeq, Serializer};
///
/// struct Words {
///     text: String,
/// }
///
/// // Serialized as the list of its words.
/// impl Serialize for Words {
///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
///         let mut seq = serializer.serialize_seq(None)?;
///         for w in self.text.split_whitespace() {
///             seq.serialize_element(&w)?;
///         }
///         seq.end()
///     }
/// }
///
/// let w = Words { text: "to be or".to_string() };
/// assert_eq(json::to_string(&w).unwrap(), "[\"to\",\"be\",\"or\"]");
/// ```
pub trait SerializeSeq {
    /// Must match the `Ok` type of the [`Serializer`].
    type Ok;
    /// Must match the `Error` type of the [`Serializer`].
    type Error: Error;
    /// Serializes one element of the sequence.
    fn serialize_element<T: Serialize>(&mut self, value: &T) -> Result<(), Self::Error>;
    /// Finishes the sequence.
    fn end(self) -> Result<Self::Ok, Self::Error>;
}

/// The state returned by [`Serializer::serialize_tuple`], which takes the
/// elements of a tuple or array.
///
/// # Examples
///
/// ```
/// use std::json;
/// use std::serde::ser::{Serialize, SerializeTuple, Serializer};
///
/// struct Triple {
///     items: [i32; 3],
/// }
///
/// impl Serialize for Triple {
///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
///         let mut t = serializer.serialize_tuple(3)?;
///         for x in self.items.iter() {
///             t.serialize_element(x)?;
///         }
///         t.end()
///     }
/// }
///
/// assert_eq(json::to_string(&Triple { items: [1, 2, 3] }).unwrap(), "[1,2,3]");
/// ```
pub trait SerializeTuple {
    /// Must match the `Ok` type of the [`Serializer`].
    type Ok;
    /// Must match the `Error` type of the [`Serializer`].
    type Error: Error;
    /// Serializes one element of the tuple.
    fn serialize_element<T: Serialize>(&mut self, value: &T) -> Result<(), Self::Error>;
    /// Finishes the tuple.
    fn end(self) -> Result<Self::Ok, Self::Error>;
}

/// The state returned by [`Serializer::serialize_tuple_struct`], which
/// takes the fields of a tuple struct.
///
/// # Examples
///
/// ```
/// use std::json;
/// use std::serde::ser::{Serialize, SerializeTupleStruct, Serializer};
///
/// struct Point3(f64, f64, f64);
///
/// impl Serialize for Point3 {
///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
///         let mut ts = serializer.serialize_tuple_struct("Point3", 3)?;
///         ts.serialize_field(&self.0)?;
///         ts.serialize_field(&self.1)?;
///         ts.serialize_field(&self.2)?;
///         ts.end()
///     }
/// }
///
/// assert_eq(json::to_string(&Point3(1.0, 2.5, -3.0)).unwrap(), "[1,2.5,-3]");
/// ```
pub trait SerializeTupleStruct {
    /// Must match the `Ok` type of the [`Serializer`].
    type Ok;
    /// Must match the `Error` type of the [`Serializer`].
    type Error: Error;
    /// Serializes one field of the tuple struct.
    fn serialize_field<T: Serialize>(&mut self, value: &T) -> Result<(), Self::Error>;
    /// Finishes the tuple struct.
    fn end(self) -> Result<Self::Ok, Self::Error>;
}

/// The state returned by [`Serializer::serialize_tuple_variant`], which
/// takes the fields of a tuple variant.
///
/// # Examples
///
/// ```
/// use std::json;
/// use std::serde::ser::{Serialize, SerializeTupleVariant, Serializer};
///
/// enum Cmd {
///     Resize(u32, u32),
/// }
///
/// impl Serialize for Cmd {
///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
///         match self {
///             Cmd::Resize(w, h) => {
///                 let mut tv = serializer.serialize_tuple_variant("Cmd", 0, "Resize", 2)?;
///                 tv.serialize_field(w)?;
///                 tv.serialize_field(h)?;
///                 tv.end()
///             }
///         }
///     }
/// }
///
/// assert_eq(json::to_string(&Cmd::Resize(80, 24)).unwrap(), "{\"Resize\":[80,24]}");
/// ```
pub trait SerializeTupleVariant {
    /// Must match the `Ok` type of the [`Serializer`].
    type Ok;
    /// Must match the `Error` type of the [`Serializer`].
    type Error: Error;
    /// Serializes one field of the tuple variant.
    fn serialize_field<T: Serialize>(&mut self, value: &T) -> Result<(), Self::Error>;
    /// Finishes the tuple variant.
    fn end(self) -> Result<Self::Ok, Self::Error>;
}

/// The state returned by [`Serializer::serialize_map`], which takes the
/// entries of a map.
///
/// Each entry is a call to [`serialize_key`](SerializeMap::serialize_key)
/// followed by one to [`serialize_value`](SerializeMap::serialize_value),
/// or a call to [`serialize_entry`](SerializeMap::serialize_entry), which
/// does both.
///
/// # Examples
///
/// ```
/// use std::json;
/// use std::serde::ser::{Serialize, SerializeMap, Serializer};
///
/// struct Env {
///     vars: Vec<(String, String)>,
/// }
///
/// impl Serialize for Env {
///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
///         let mut map = serializer.serialize_map(Some(self.vars.len()))?;
///         for (k, v) in self.vars.iter() {
///             map.serialize_key(k)?;
///             map.serialize_value(v)?;
///         }
///         map.end()
///     }
/// }
///
/// let env = Env { vars: Vec::from([("HOME".to_string(), "/root".to_string())]) };
/// assert_eq(json::to_string(&env).unwrap(), "{\"HOME\":\"/root\"}");
/// ```
pub trait SerializeMap {
    /// Must match the `Ok` type of the [`Serializer`].
    type Ok;
    /// Must match the `Error` type of the [`Serializer`].
    type Error: Error;
    /// Serializes a map key.
    ///
    /// # Errors
    ///
    /// Returns an error if the format does not support this kind of key
    /// (JSON takes strings, chars and integers as keys).
    fn serialize_key<T: Serialize>(&mut self, key: &T) -> Result<(), Self::Error>;
    /// Serializes the value of the key passed last to
    /// [`serialize_key`](SerializeMap::serialize_key).
    fn serialize_value<T: Serialize>(&mut self, value: &T) -> Result<(), Self::Error>;
    /// Serializes a map entry: its key, then its value.
    ///
    /// The default implementation calls
    /// [`serialize_key`](SerializeMap::serialize_key) and
    /// [`serialize_value`](SerializeMap::serialize_value).
    fn serialize_entry<K: Serialize, V: Serialize>(
        &mut self,
        key: &K,
        value: &V,
    ) -> Result<(), Self::Error> {
        self.serialize_key(key)?;
        self.serialize_value(value)
    }

    /// Finishes the map.
    fn end(self) -> Result<Self::Ok, Self::Error>;
}

/// The state returned by [`Serializer::serialize_struct`], which takes the
/// fields of a struct.
///
/// # Examples
///
/// ```
/// use std::json;
/// use std::serde::ser::{Serialize, SerializeStruct, Serializer};
///
/// struct User {
///     name: String,
///     email: Option<String>,
/// }
///
/// impl Serialize for User {
///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
///         let mut st = serializer.serialize_struct("User", 2)?;
///         st.serialize_field("name", &self.name)?;
///         // Leave the email out when there is none.
///         match &self.email {
///             Some(e) => st.serialize_field("email", e)?,
///             None => st.skip_field("email")?,
///         }
///         st.end()
///     }
/// }
///
/// let u = User { name: "ann".to_string(), email: None };
/// assert_eq(json::to_string(&u).unwrap(), "{\"name\":\"ann\"}");
/// ```
pub trait SerializeStruct {
    /// Must match the `Ok` type of the [`Serializer`].
    type Ok;
    /// Must match the `Error` type of the [`Serializer`].
    type Error: Error;
    /// Serializes a struct field with its name.
    fn serialize_field<T: Serialize>(&mut self, key: &str, value: &T) -> Result<(), Self::Error>;
    /// Notes that the field `key` is left out (as
    /// `#[serde(skip_serializing_if = "...")]` does).
    ///
    /// The default implementation does nothing.
    fn skip_field(&mut self, key: &str) -> Result<(), Self::Error> {
        Ok(())
    }

    /// Finishes the struct.
    fn end(self) -> Result<Self::Ok, Self::Error>;
}

/// The state returned by [`Serializer::serialize_struct_variant`], which
/// takes the fields of a struct variant.
///
/// # Examples
///
/// ```
/// use std::json;
/// use std::serde::ser::{Serialize, SerializeStructVariant, Serializer};
///
/// enum Msg {
///     Write { text: String },
/// }
///
/// impl Serialize for Msg {
///     fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
///         match self {
///             Msg::Write { text } => {
///                 let mut sv = serializer.serialize_struct_variant("Msg", 0, "Write", 1)?;
///                 sv.serialize_field("text", text)?;
///                 sv.end()
///             }
///         }
///     }
/// }
///
/// let m = Msg::Write { text: "hi".to_string() };
/// assert_eq(json::to_string(&m).unwrap(), "{\"Write\":{\"text\":\"hi\"}}");
/// ```
pub trait SerializeStructVariant {
    /// Must match the `Ok` type of the [`Serializer`].
    type Ok;
    /// Must match the `Error` type of the [`Serializer`].
    type Error: Error;
    /// Serializes a struct variant field with its name.
    fn serialize_field<T: Serialize>(&mut self, key: &str, value: &T) -> Result<(), Self::Error>;
    /// Notes that the field `key` is left out (as
    /// `#[serde(skip_serializing_if = "...")]` does).
    ///
    /// The default implementation does nothing.
    fn skip_field(&mut self, key: &str) -> Result<(), Self::Error> {
        Ok(())
    }

    /// Finishes the struct variant.
    fn end(self) -> Result<Self::Ok, Self::Error>;
}

// --- std's types -------------------------------------------------------------

impl Serialize for bool {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        s.serialize_bool(*self)
    }
}

impl Serialize for i8 {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        s.serialize_i8(*self)
    }
}

impl Serialize for i16 {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        s.serialize_i16(*self)
    }
}

impl Serialize for i32 {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        s.serialize_i32(*self)
    }
}

impl Serialize for i64 {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        s.serialize_i64(*self)
    }
}

impl Serialize for isize {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        s.serialize_i64(*self as i64)
    }
}

impl Serialize for u8 {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        s.serialize_u8(*self)
    }
}

impl Serialize for u16 {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        s.serialize_u16(*self)
    }
}

impl Serialize for u32 {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        s.serialize_u32(*self)
    }
}

impl Serialize for u64 {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        s.serialize_u64(*self)
    }
}

impl Serialize for usize {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        s.serialize_u64(*self as u64)
    }
}

impl Serialize for f32 {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        s.serialize_f32(*self)
    }
}

impl Serialize for f64 {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        s.serialize_f64(*self)
    }
}

impl Serialize for char {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        s.serialize_char(*self)
    }
}

impl Serialize for str {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        s.serialize_str(self)
    }
}

impl Serialize for String {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        s.serialize_str(self.as_str())
    }
}

impl Serialize for () {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        s.serialize_unit()
    }
}

impl<T: Serialize> Serialize for &T {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        (**self).serialize(s)
    }
}

impl<T: Serialize> Serialize for &mut T {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        (**self).serialize(s)
    }
}

impl<T: Serialize> Serialize for Option<T> {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        match self {
            Some(v) => s.serialize_some(v),
            None => s.serialize_none(),
        }
    }
}

impl<T: Serialize> Serialize for [T] {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        let mut seq = s.serialize_seq(Some(self.len()))?;
        for x in self.iter() {
            seq.serialize_element(x)?;
        }
        seq.end()
    }
}

impl<T: Serialize> Serialize for Vec<T> {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        let mut seq = s.serialize_seq(Some(self.len()))?;
        for x in self.iter() {
            seq.serialize_element(x)?;
        }
        seq.end()
    }
}

impl<T: Serialize> Serialize for VecDeque<T> {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        let mut seq = s.serialize_seq(Some(self.len()))?;
        for x in self.iter() {
            seq.serialize_element(x)?;
        }
        seq.end()
    }
}

impl<T: Serialize + Hash + Eq> Serialize for HashSet<T> {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        let mut seq = s.serialize_seq(Some(self.len()))?;
        for x in self.iter() {
            seq.serialize_element(x)?;
        }
        seq.end()
    }
}

impl<T: Serialize> Serialize for BTreeSet<T> {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        let mut seq = s.serialize_seq(Some(self.len()))?;
        for x in self.iter() {
            seq.serialize_element(x)?;
        }
        seq.end()
    }
}

impl<K: Serialize + Hash + Eq, V: Serialize> Serialize for HashMap<K, V> {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        let mut m = s.serialize_map(Some(self.len()))?;
        for (k, v) in self.iter() {
            m.serialize_entry(k, v)?;
        }
        m.end()
    }
}

impl<K: Serialize, V: Serialize> Serialize for BTreeMap<K, V> {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        let mut m = s.serialize_map(Some(self.len()))?;
        for (k, v) in self.iter() {
            m.serialize_entry(k, v)?;
        }
        m.end()
    }
}

impl<A: Serialize> Serialize for (A,) {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        let mut t = s.serialize_tuple(1)?;
        t.serialize_element(&self.0)?;
        t.end()
    }
}

impl<A: Serialize, B: Serialize> Serialize for (A, B) {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        let mut t = s.serialize_tuple(2)?;
        t.serialize_element(&self.0)?;
        t.serialize_element(&self.1)?;
        t.end()
    }
}

impl<A: Serialize, B: Serialize, C: Serialize> Serialize for (A, B, C) {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        let mut t = s.serialize_tuple(3)?;
        t.serialize_element(&self.0)?;
        t.serialize_element(&self.1)?;
        t.serialize_element(&self.2)?;
        t.end()
    }
}

impl<A: Serialize, B: Serialize, C: Serialize, D: Serialize> Serialize for (A, B, C, D) {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        let mut t = s.serialize_tuple(4)?;
        t.serialize_element(&self.0)?;
        t.serialize_element(&self.1)?;
        t.serialize_element(&self.2)?;
        t.serialize_element(&self.3)?;
        t.end()
    }
}

impl<T: Serialize, const N: usize> Serialize for [T; N] {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        let mut t = s.serialize_tuple(N)?;
        for x in self.iter() {
            t.serialize_element(x)?;
        }
        t.end()
    }
}
