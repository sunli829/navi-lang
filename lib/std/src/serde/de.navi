//! Generic deserialization: the [`Deserialize`] and [`Deserializer`]
//! traits, and the [`Visitor`] a type gives a deserializer.
//!
//! This is serde's `de` module without lifetimes: there is no `'de`, and
//! nothing is borrowed from the input (navi has a garbage collector, so a
//! deserialized `&str` or `&T` points to a new allocation instead).
//!
//! Deserialization goes in two directions. A type that implements
//! [`Deserialize`] asks a [`Deserializer`] (the data format, such as
//! [`std::json`](crate::json)) for the kind of value it expects by calling
//! one of its `deserialize_*` methods, and passes a [`Visitor`]. The
//! deserializer reads the input and calls the visitor's `visit_*` method
//! for what it actually finds; the visitor builds the value, or returns an
//! error if it cannot accept that kind of input. Compound inputs come to
//! the visitor as a [`SeqAccess`], a [`MapAccess`] or an [`EnumAccess`],
//! from which it pulls the elements.
//!
//! A self-describing format like JSON can ignore what it is asked for and
//! report what the input holds; the type's visitor then decides. Every
//! `deserialize_*` method has a default implementation that calls
//! [`Deserializer::deserialize_any`], so only that one has to be written.
//!
//! Most types derive [`Deserialize`] with `#[derive(Deserialize)]` (see
//! [`crate::serde`]). std implements it for the primitive types, `String`,
//! `&str`, `Option`, references, `()`, pairs and triples, arrays, `Vec`,
//! `VecDeque`, `HashSet`, `BTreeSet`, `HashMap` and `BTreeMap`.
//!
//! # Examples
//!
//! Implementing [`Deserialize`] by hand with a [`Visitor`], for a type
//! written as a string:
//!
//! ```
//! use std::fmt;
//! use std::json;
//! use std::serde::de::{self, Deserialize, Deserializer, Unexpected, Visitor};
//!
//! #[derive(Debug, PartialEq)]
//! struct Celsius(f64);
//!
//! struct CelsiusVisitor;
//!
//! impl Visitor for CelsiusVisitor {
//!     type Value = Celsius;
//!
//!     fn expecting(&self, formatter: &mut fmt::Formatter) -> fmt::Result {
//!         formatter.write_str("a temperature such as \"21.5C\"")
//!     }
//!
//!     fn visit_str<E: de::Error>(self, v: &str) -> Result<Celsius, E> {
//!         match v.strip_suffix("C").and_then(|n| n.parse::<f64>().ok()) {
//!             Some(x) => Ok(Celsius(x)),
//!             None => Err(E::invalid_value(Unexpected::Str(v.to_string()), &self)),
//!         }
//!     }
//! }
//!
//! impl Deserialize for Celsius {
//!     fn deserialize<D: Deserializer>(deserializer: D) -> Result<Celsius, D::Error> {
//!         deserializer.deserialize_str(CelsiusVisitor)
//!     }
//! }
//!
//! let t: Celsius = json::from_str("\"21.5C\"").unwrap();
//! assert_eq(t, Celsius(21.5));
//!
//! // A string the visitor does not accept, and a number where it wants a string.
//! let e = json::from_str::<Celsius>("\"warm\"").unwrap_err();
//! assert_eq(
//!     e.to_string(),
//!     "json: invalid value: string \"warm\", expected a temperature such as \"21.5C\" at offset 6",
//! );
//! let e = json::from_str::<Celsius>("3").unwrap_err();
//! assert_eq(
//!     e.to_string(),
//!     "json: invalid type: integer `3`, expected a temperature such as \"21.5C\" at offset 1",
//! );
//! ```

use crate::{
    cmp::{Eq, Ord},
    collections::{BTreeMap, BTreeSet, HashMap, HashSet, VecDeque},
    fmt::{self, Display, Formatter},
    hash::Hash,
    marker::PhantomData,
};

/// The error type a [`Deserializer`] returns, as serde's `de::Error`.
///
/// [`Deserialize`] implementations and [`Visitor`]s use it to make errors
/// of whatever deserializer they are running against. Only
/// [`custom`](Error::custom) must be implemented; the other constructors
/// make serde's usual messages with it.
///
/// # Examples
///
/// ```
/// use std::{json, serde::de::Error};
///
/// let e = <json::Error as Error>::missing_field("id");
/// assert_eq(e.to_string(), "json: missing field `id`");
///
/// let e = <json::Error as Error>::unknown_field("nmae", &["name", "age"]);
/// assert_eq(
///     e.to_string(),
///     "json: unknown field `nmae`, expected one of `name`, `age`",
/// );
/// ```
pub trait Error: Display {
    /// Makes an error from a message, for a [`Deserialize`] implementation
    /// or [`Visitor`] that fails for a reason of its own.
    ///
    /// The message should not be capitalized and should not end with a
    /// period.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::{json, serde::de::Error};
    ///
    /// let e = <json::Error as Error>::custom("port must not be 0");
    /// assert_eq(e.to_string(), "json: port must not be 0");
    /// ```
    fn custom<T: Display>(msg: T) -> Self;

    /// An error for input of the wrong kind: `unexp` is what was found,
    /// `exp` what was wanted (usually the visitor, `&self`).
    ///
    /// The message is ``invalid type: <unexp>, expected <exp>``. Use it
    /// when the input is the wrong kind of value, and
    /// [`invalid_value`](Error::invalid_value) when it is the right kind
    /// with a wrong value.
    fn invalid_type(unexp: Unexpected, exp: &dyn Expected) -> Self {
        Self::custom(`invalid type: ${unexp}, expected ${ExpectedText(exp)}`)
    }

    /// An error for input of the right kind but a wrong value: `unexp` is
    /// what was found, `exp` what was wanted.
    ///
    /// The message is ``invalid value: <unexp>, expected <exp>``; for
    /// example std's `u8` reports `300` as
    /// ``invalid value: integer `300`, expected u8``.
    fn invalid_value(unexp: Unexpected, exp: &dyn Expected) -> Self {
        Self::custom(`invalid value: ${unexp}, expected ${ExpectedText(exp)}`)
    }

    /// An error for a sequence or map with the wrong number of elements:
    /// `len` is how many were found, `exp` what was wanted.
    ///
    /// The message is ``invalid length <len>, expected <exp>``.
    fn invalid_length(len: usize, exp: &dyn Expected) -> Self {
        Self::custom(`invalid length ${len}, expected ${ExpectedText(exp)}`)
    }

    /// An error for an enum variant that is not one of `expected`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::{json, serde::de::Error};
    ///
    /// let e = <json::Error as Error>::unknown_variant("Purple", &["Red", "Green"]);
    /// assert_eq(
    ///     e.to_string(),
    ///     "json: unknown variant `Purple`, expected one of `Red`, `Green`",
    /// );
    /// ```
    fn unknown_variant(variant: &str, expected: &[&str]) -> Self {
        Self::custom(`unknown variant \`${variant}\`, ${one_of(expected)}`)
    }

    /// An error for a struct field that is not one of `expected` (the
    /// derive reports it with `#[serde(deny_unknown_fields)]`; otherwise
    /// unknown fields are skipped).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::{json, serde::de::Error};
    ///
    /// let e = <json::Error as Error>::unknown_field("colour", &["color"]);
    /// assert_eq(
    ///     e.to_string(),
    ///     "json: unknown field `colour`, expected `color`",
    /// );
    /// ```
    fn unknown_field(field: &str, expected: &[&str]) -> Self {
        Self::custom(`unknown field \`${field}\`, ${one_of(expected)}`)
    }

    /// An error for a struct field missing from the input.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::{json, serde::de::Error};
    ///
    /// let e = <json::Error as Error>::missing_field("name");
    /// assert_eq(e.to_string(), "json: missing field `name`");
    /// ```
    fn missing_field(field: &str) -> Self {
        Self::custom(`missing field \`${field}\``)
    }

    /// An error for a struct field given more than once in the input.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::{json, serde::de::Error};
    ///
    /// let e = <json::Error as Error>::duplicate_field("id");
    /// assert_eq(e.to_string(), "json: duplicate field `id`");
    /// ```
    fn duplicate_field(field: &str) -> Self {
        Self::custom(`duplicate field \`${field}\``)
    }
}

fn one_of(names: &[&str]) -> String {
    if names.len() == 0 {
        return "there are no fields".to_string();
    }
    let mut s = String::new();
    s.push_str(if names.len() == 1 {
        "expected "
    } else {
        "expected one of "
    });
    let mut i = 0;
    while i < names.len() {
        if i > 0 {
            s.push_str(", ");
        }
        s.push('`');
        s.push_str(names[i]);
        s.push('`');
        i += 1;
    }
    s
}

/// What a deserializer found in the input where something else was
/// expected, for the messages of [`Error::invalid_type`] and
/// [`Error::invalid_value`].
///
/// As serde's `Unexpected`, but `Str` and `Other` own their `String` (and
/// there is no `Bytes` payload or `Other(&str)` borrowing from the input).
/// Its [`Display`] is the phrase used in error messages.
///
/// # Examples
///
/// ```
/// use std::serde::de::Unexpected;
///
/// assert_eq(Unexpected::Bool(true).to_string(), "boolean `true`");
/// assert_eq(Unexpected::Signed(-3).to_string(), "integer `-3`");
/// assert_eq(
///     Unexpected::Str("abc".to_string()).to_string(),
///     "string \"abc\"",
/// );
/// assert_eq(Unexpected::Seq.to_string(), "sequence");
/// ```
#[derive(Clone, Debug, PartialEq)]
pub enum Unexpected {
    /// A boolean (shown as ``boolean `true` ``).
    Bool(bool),
    /// An unsigned integer (shown as ``integer `1` ``).
    Unsigned(u64),
    /// A signed integer (shown as ``integer `-1` ``).
    Signed(i64),
    /// A floating-point number (shown as ``floating point `1.5` ``).
    Float(f64),
    /// A character (shown as ``character `c` ``).
    Char(char),
    /// A string (shown as `string "text"`).
    Str(String),
    /// A byte array.
    Bytes,
    /// The unit value `()` (JSON's `null`).
    Unit,
    /// An `Option` value.
    Option,
    /// A newtype struct.
    NewtypeStruct,
    /// A sequence (JSON's array).
    Seq,
    /// A map (JSON's object).
    Map,
    /// An enum.
    Enum,
    /// A unit variant of an enum.
    UnitVariant,
    /// A newtype variant of an enum.
    NewtypeVariant,
    /// A tuple variant of an enum.
    TupleVariant,
    /// A struct variant of an enum.
    StructVariant,
    /// Anything else, described by the string (shown as it is).
    Other(String),
}

impl Display for Unexpected {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        match self {
            Unexpected::Bool(b) => f.write_fmt(`boolean \`${b}\``),
            Unexpected::Unsigned(n) => f.write_fmt(`integer \`${n}\``),
            Unexpected::Signed(n) => f.write_fmt(`integer \`${n}\``),
            Unexpected::Float(x) => f.write_fmt(`floating point \`${x}\``),
            Unexpected::Char(c) => f.write_fmt(`character \`${c}\``),
            Unexpected::Str(s) => f.write_fmt(`string ${s:?}`),
            Unexpected::Bytes => f.write_str("byte array"),
            Unexpected::Unit => f.write_str("unit value"),
            Unexpected::Option => f.write_str("Option value"),
            Unexpected::NewtypeStruct => f.write_str("newtype struct"),
            Unexpected::Seq => f.write_str("sequence"),
            Unexpected::Map => f.write_str("map"),
            Unexpected::Enum => f.write_str("enum"),
            Unexpected::UnitVariant => f.write_str("unit variant"),
            Unexpected::NewtypeVariant => f.write_str("newtype variant"),
            Unexpected::TupleVariant => f.write_str("tuple variant"),
            Unexpected::StructVariant => f.write_str("struct variant"),
            Unexpected::Other(s) => f.write_str(s.as_str()),
        }
    }
}

/// What a deserializer expected, for the messages of [`Error`]'s
/// constructors, as serde's `Expected`.
///
/// Every [`Visitor`] is one (its [`expecting`](Visitor::expecting) text),
/// which is why visitors pass `&self` as the expected value.
///
/// # Examples
///
/// ```
/// use std::{
///     fmt, json,
///     serde::de::{Error, Expected},
/// };
///
/// struct Between(usize, usize);
///
/// impl Expected for Between {
///     fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
///         f.write_str(
///             `between ${self.0} and ${self.1} elements`
///                 .to_string()
///                 .as_str(),
///         )
///     }
/// }
///
/// let e = <json::Error as Error>::invalid_length(5, &Between(1, 3));
/// assert_eq(
///     e.to_string(),
///     "json: invalid length 5, expected between 1 and 3 elements",
/// );
/// ```
pub trait Expected {
    /// Writes what was expected, as a phrase such as `a string` that
    /// follows the word "expected".
    fn fmt(&self, f: &mut Formatter) -> fmt::Result;
}

impl<V: Visitor> Expected for V {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        self.expecting(f)
    }
}

impl Expected for str {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str(self)
    }
}

// An Expected to show in a message.
struct ExpectedText(&dyn Expected);

impl Display for ExpectedText {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        Expected::fmt(self.0, f)
    }
}

/// A data structure that can be deserialized from any data format
/// supported by serde.
///
/// std implements `Deserialize` for its common types (listed in the
/// [module documentation](crate::serde::de)). Your own structs and enums
/// usually derive it with `#[derive(Deserialize)]` (imported with
/// `use std::serde::Deserialize;`, which brings in both the trait and the
/// derive); the `#[serde(...)]` attributes described in [`crate::serde`]
/// adjust what the derive reads. Implementing it by hand means asking the
/// [`Deserializer`] for a kind of value with a [`Visitor`] (see the module
/// documentation for an example).
///
/// # Examples
///
/// ```
/// use std::{json, serde::Deserialize};
///
/// #[derive(Deserialize, Debug, PartialEq)]
/// struct Point {
///     x: i32,
///     y: i32,
/// }
///
/// let p: Point = json::from_str("{\"y\": 2, \"x\": 1}").unwrap();
/// assert_eq(p, Point { x: 1, y: 2 });
///
/// let e = json::from_str::<Point>("{\"x\": 1}").unwrap_err();
/// assert_eq(e.to_string(), "json: missing field `y` at offset 8");
/// ```
pub trait Deserialize {
    /// Deserializes a value of this type from the given deserializer.
    ///
    /// # Errors
    ///
    /// Returns the deserializer's error if the input is malformed or does
    /// not hold a value of this type.
    ///
    /// # Examples
    ///
    /// Any deserializer works, such as this one, which holds one integer:
    ///
    /// ```
    /// use std::{
    ///     fmt,
    ///     serde::de::{self, Deserialize, Deserializer, Visitor},
    /// };
    ///
    /// #[derive(Debug)]
    /// struct Error(String);
    ///
    /// impl fmt::Display for Error {
    ///     fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
    ///         f.write_str(self.0.as_str())
    ///     }
    /// }
    ///
    /// impl de::Error for Error {
    ///     fn custom<T: fmt::Display>(msg: T) -> Error {
    ///         Error(msg.to_string())
    ///     }
    /// }
    ///
    /// struct Int(i64);
    ///
    /// impl Deserializer for Int {
    ///     type Error = Error;
    ///
    ///     fn deserialize_any<V: Visitor>(self, visitor: V) -> Result<V::Value, Error> {
    ///         visitor.visit_i64(self.0)
    ///     }
    /// }
    ///
    /// assert_eq(i32::deserialize(Int(7)).unwrap(), 7);
    /// assert_eq(f64::deserialize(Int(7)).unwrap(), 7.0);
    /// let e = u8::deserialize(Int(300)).unwrap_err();
    /// assert_eq(e.to_string(), "invalid value: integer `300`, expected u8");
    /// ```
    fn deserialize<D: Deserializer>(deserializer: D) -> Result<Self, D::Error>;
}

/// A data format that can deserialize any data structure supported by
/// serde.
///
/// A [`Deserialize`] implementation calls one of the `deserialize_*`
/// methods to say what kind of value it expects, and passes a [`Visitor`].
/// The deserializer reads the input and calls the visitor's `visit_*`
/// method for what it holds: a self-describing format such as JSON reports
/// whatever the input holds (the visitor rejects what it cannot take),
/// while a format that does not describe its data relies on the hint.
///
/// Only [`deserialize_any`](Deserializer::deserialize_any) is required:
/// every other method's default implementation calls it (or a related
/// method, as noted on each). The methods take `self` by value, so a
/// deserializer reads exactly one value; formats usually implement this
/// trait for `&mut` a reader type ([`std::json`](crate::json)'s is
/// `&mut json::Reader`). serde's `i128`/`u128` methods are not provided.
///
/// # Examples
///
/// A deserializer reading a value from a list of words, "true"/"false",
/// integers and anything else as strings:
///
/// ```
/// use std::{
///     fmt,
///     serde::de::{self, Deserialize, Deserializer, Visitor},
/// };
///
/// #[derive(Debug)]
/// struct Error(String);
///
/// impl fmt::Display for Error {
///     fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
///         f.write_str(self.0.as_str())
///     }
/// }
///
/// impl de::Error for Error {
///     fn custom<T: fmt::Display>(msg: T) -> Error {
///         Error(msg.to_string())
///     }
/// }
///
/// struct Word {
///     text: String,
/// }
///
/// impl Deserializer for Word {
///     type Error = Error;
///
///     fn deserialize_any<V: Visitor>(self, visitor: V) -> Result<V::Value, Error> {
///         match self.text.as_str() {
///             "true" => visitor.visit_bool(true),
///             "false" => visitor.visit_bool(false),
///             t => match t.parse::<i64>() {
///                 Ok(n) => visitor.visit_i64(n),
///                 Err(_) => visitor.visit_string(self.text),
///             },
///         }
///     }
/// }
///
/// fn word(s: &str) -> Word {
///     Word {
///         text: s.to_string(),
///     }
/// }
///
/// assert_eq(bool::deserialize(word("true")).unwrap(), true);
/// assert_eq(u16::deserialize(word("8080")).unwrap(), 8080);
/// assert_eq(String::deserialize(word("hello")).unwrap(), "hello");
/// let e = u16::deserialize(word("hello")).unwrap_err();
/// assert_eq(
///     e.to_string(),
///     "invalid type: string \"hello\", expected u16",
/// );
/// ```
pub trait Deserializer {
    /// The error type when deserialization fails.
    type Error: Error;

    /// Reads whatever value the input holds and passes it to the visitor's
    /// matching `visit_*` method.
    ///
    /// Self-describing formats implement it; a format that cannot tell
    /// what its input holds returns an error.
    fn deserialize_any<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error>;
    /// Hints that the type expects a `bool`. The default calls
    /// [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_bool<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects an `i8`. The default calls
    /// [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_i8<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects an `i16`. The default calls
    /// [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_i16<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects an `i32`. The default calls
    /// [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_i32<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects an `i64` (std's `isize` asks for this
    /// too). The default calls
    /// [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_i64<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects a `u8`. The default calls
    /// [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_u8<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects a `u16`. The default calls
    /// [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_u16<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects a `u32`. The default calls
    /// [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_u32<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects a `u64` (std's `usize` asks for this
    /// too). The default calls
    /// [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_u64<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects an `f32`. The default calls
    /// [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_f32<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects an `f64`. The default calls
    /// [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_f64<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects a `char`. The default calls
    /// [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_char<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects a string and only needs to look at it
    /// ([`Visitor::visit_str`]). The default calls
    /// [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_str<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects a string it keeps
    /// ([`Visitor::visit_string`] can hand over an owned `String`). The
    /// default calls [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_string<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects bytes and only needs to look at them.
    /// The default calls
    /// [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_bytes<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects bytes it keeps. The default calls
    /// [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_byte_buf<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects an optional value: the deserializer
    /// calls [`Visitor::visit_none`] or [`Visitor::visit_some`]. The
    /// default calls [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_option<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects `()`. The default calls
    /// [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_unit<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects a unit struct named `name`. The default
    /// calls [`deserialize_unit`](Deserializer::deserialize_unit).
    fn deserialize_unit_struct<V: Visitor>(
        self,
        name: &str,
        visitor: V,
    ) -> Result<V::Value, Self::Error> {
        self.deserialize_unit(visitor)
    }

    /// Hints that the type expects a newtype struct named `name`; formats
    /// usually pass its content to [`Visitor::visit_newtype_struct`]. The
    /// default calls [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_newtype_struct<V: Visitor>(
        self,
        name: &str,
        visitor: V,
    ) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects a sequence of values. The default calls
    /// [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_seq<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects a sequence of `len` values (a tuple or
    /// an array). The default calls
    /// [`deserialize_seq`](Deserializer::deserialize_seq).
    fn deserialize_tuple<V: Visitor>(
        self,
        len: usize,
        visitor: V,
    ) -> Result<V::Value, Self::Error> {
        self.deserialize_seq(visitor)
    }

    /// Hints that the type expects a tuple struct named `name` with `len`
    /// fields. The default calls
    /// [`deserialize_seq`](Deserializer::deserialize_seq).
    fn deserialize_tuple_struct<V: Visitor>(
        self,
        name: &str,
        len: usize,
        visitor: V,
    ) -> Result<V::Value, Self::Error> {
        self.deserialize_seq(visitor)
    }

    /// Hints that the type expects a map of key-value pairs. The default
    /// calls [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_map<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects a struct named `name` with the given
    /// field names. The default calls
    /// [`deserialize_map`](Deserializer::deserialize_map).
    fn deserialize_struct<V: Visitor>(
        self,
        name: &str,
        fields: &[&str],
        visitor: V,
    ) -> Result<V::Value, Self::Error> {
        self.deserialize_map(visitor)
    }

    /// Hints that the type expects an enum named `name` with the given
    /// variant names; formats pass it to [`Visitor::visit_enum`]. The
    /// default calls [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_enum<V: Visitor>(
        self,
        name: &str,
        variants: &[&str],
        visitor: V,
    ) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Hints that the type expects the name of a struct field or an enum
    /// variant. The default calls
    /// [`deserialize_str`](Deserializer::deserialize_str).
    fn deserialize_identifier<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_str(visitor)
    }

    /// Hints that the type will ignore the value, whatever it is (as
    /// [`IgnoredAny`] does for unknown fields); formats may skip it
    /// quickly. The default calls
    /// [`deserialize_any`](Deserializer::deserialize_any).
    fn deserialize_ignored_any<V: Visitor>(self, visitor: V) -> Result<V::Value, Self::Error> {
        self.deserialize_any(visitor)
    }

    /// Whether the input is in a human-readable form, for types that
    /// have both a readable and a compact form (see
    /// [`Serializer::is_human_readable`](crate::serde::Serializer::is_human_readable)).
    ///
    /// The default returns `true`; JSON is human-readable.
    fn is_human_readable(&self) -> bool {
        true
    }
}

/// Builds a value from what a [`Deserializer`] finds in the input, as
/// serde's `Visitor`.
///
/// A [`Deserialize`] implementation passes a visitor to the deserializer,
/// which calls the `visit_*` method for the kind of value the input holds.
/// Implement the methods for the kinds the type accepts; the default of
/// each other method rejects its input with [`Error::invalid_type`] (whose
/// message uses [`expecting`](Visitor::expecting)). Several defaults
/// forward instead, so one method covers a family: the smaller integers to
/// [`visit_i64`](Visitor::visit_i64) and [`visit_u64`](Visitor::visit_u64),
/// `f32` to [`visit_f64`](Visitor::visit_f64), `char` and `String` to
/// [`visit_str`](Visitor::visit_str), and `Vec<u8>` to
/// [`visit_bytes`](Visitor::visit_bytes).
///
/// # Examples
///
/// A visitor taking an integer, or a string holding one:
///
/// ```
/// use std::{
///     fmt, json,
///     serde::de::{self, Deserialize, Deserializer, Unexpected, Visitor},
/// };
///
/// #[derive(Clone, Debug, PartialEq)]
/// struct Port(u16);
///
/// struct PortVisitor;
///
/// impl Visitor for PortVisitor {
///     type Value = Port;
///
///     fn expecting(&self, formatter: &mut fmt::Formatter) -> fmt::Result {
///         formatter.write_str("a port number")
///     }
///
///     fn visit_u64<E: de::Error>(self, v: u64) -> Result<Port, E> {
///         if v > 65535 {
///             return Err(E::invalid_value(Unexpected::Unsigned(v), &self));
///         }
///         Ok(Port(v as u16))
///     }
///
///     fn visit_str<E: de::Error>(self, v: &str) -> Result<Port, E> {
///         match v.parse::<u16>() {
///             Ok(n) => Ok(Port(n)),
///             Err(_) => Err(E::invalid_value(Unexpected::Str(v.to_string()), &self)),
///         }
///     }
/// }
///
/// impl Deserialize for Port {
///     fn deserialize<D: Deserializer>(deserializer: D) -> Result<Port, D::Error> {
///         deserializer.deserialize_any(PortVisitor)
///     }
/// }
///
/// let ports: Vec<Port> = json::from_str("[80, \"8080\"]").unwrap();
/// assert_eq(ports, Vec::from([Port(80), Port(8080)]));
///
/// let e = json::from_str::<Port>("true").unwrap_err();
/// assert_eq(
///     e.to_string(),
///     "json: invalid type: boolean `true`, expected a port number at offset 4",
/// );
/// ```
pub trait Visitor {
    /// The type of value this visitor builds.
    type Value;

    /// Writes what the visitor expects, for error messages: a phrase that
    /// follows "expected", such as `a string` or `struct Point`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::{fmt, serde::de::Visitor};
    ///
    /// struct Even;
    ///
    /// impl Visitor for Even {
    ///     type Value = u64;
    ///
    ///     fn expecting(&self, formatter: &mut fmt::Formatter) -> fmt::Result {
    ///         formatter.write_str("an even number")
    ///     }
    /// }
    /// ```
    fn expecting(&self, formatter: &mut Formatter) -> fmt::Result;

    /// The input holds a `bool`. The default rejects it.
    fn visit_bool<E: Error>(self, v: bool) -> Result<Self::Value, E> {
        Err(E::invalid_type(Unexpected::Bool(v), &self))
    }

    /// The input holds an `i8`. The default calls
    /// [`visit_i64`](Visitor::visit_i64).
    fn visit_i8<E: Error>(self, v: i8) -> Result<Self::Value, E> {
        self.visit_i64(v as i64)
    }

    /// The input holds an `i16`. The default calls
    /// [`visit_i64`](Visitor::visit_i64).
    fn visit_i16<E: Error>(self, v: i16) -> Result<Self::Value, E> {
        self.visit_i64(v as i64)
    }

    /// The input holds an `i32`. The default calls
    /// [`visit_i64`](Visitor::visit_i64).
    fn visit_i32<E: Error>(self, v: i32) -> Result<Self::Value, E> {
        self.visit_i64(v as i64)
    }

    /// The input holds an `i64` (JSON reports negative integers this way).
    /// The default rejects it.
    fn visit_i64<E: Error>(self, v: i64) -> Result<Self::Value, E> {
        Err(E::invalid_type(Unexpected::Signed(v), &self))
    }

    /// The input holds a `u8`. The default calls
    /// [`visit_u64`](Visitor::visit_u64).
    fn visit_u8<E: Error>(self, v: u8) -> Result<Self::Value, E> {
        self.visit_u64(v as u64)
    }

    /// The input holds a `u16`. The default calls
    /// [`visit_u64`](Visitor::visit_u64).
    fn visit_u16<E: Error>(self, v: u16) -> Result<Self::Value, E> {
        self.visit_u64(v as u64)
    }

    /// The input holds a `u32`. The default calls
    /// [`visit_u64`](Visitor::visit_u64).
    fn visit_u32<E: Error>(self, v: u32) -> Result<Self::Value, E> {
        self.visit_u64(v as u64)
    }

    /// The input holds a `u64` (JSON reports non-negative integers this
    /// way). The default rejects it.
    fn visit_u64<E: Error>(self, v: u64) -> Result<Self::Value, E> {
        Err(E::invalid_type(Unexpected::Unsigned(v), &self))
    }

    /// The input holds an `f32`. The default calls
    /// [`visit_f64`](Visitor::visit_f64).
    fn visit_f32<E: Error>(self, v: f32) -> Result<Self::Value, E> {
        self.visit_f64(v as f64)
    }

    /// The input holds an `f64`. The default rejects it.
    fn visit_f64<E: Error>(self, v: f64) -> Result<Self::Value, E> {
        Err(E::invalid_type(Unexpected::Float(v), &self))
    }

    /// The input holds a `char`. The default calls
    /// [`visit_str`](Visitor::visit_str) with a string of that one
    /// character.
    fn visit_char<E: Error>(self, v: char) -> Result<Self::Value, E> {
        let mut s = String::new();
        s.push(v);
        self.visit_str(s.as_str())
    }

    /// The input holds a string. The default rejects it.
    fn visit_str<E: Error>(self, v: &str) -> Result<Self::Value, E> {
        Err(E::invalid_type(Unexpected::Str(v.to_string()), &self))
    }

    /// The input holds a string the deserializer hands over, which the
    /// visitor may keep without copying it. The default calls
    /// [`visit_str`](Visitor::visit_str).
    fn visit_string<E: Error>(self, v: String) -> Result<Self::Value, E> {
        self.visit_str(v.as_str())
    }

    /// The input holds bytes. The default rejects them.
    fn visit_bytes<E: Error>(self, v: &[u8]) -> Result<Self::Value, E> {
        Err(E::invalid_type(Unexpected::Bytes, &self))
    }

    /// The input holds bytes the deserializer hands over. The default calls
    /// [`visit_bytes`](Visitor::visit_bytes).
    fn visit_byte_buf<E: Error>(self, v: Vec<u8>) -> Result<Self::Value, E> {
        self.visit_bytes(v.as_slice())
    }

    /// The input holds an absent optional value (JSON's `null`, read with
    /// [`Deserializer::deserialize_option`]). The default rejects it.
    fn visit_none<E: Error>(self) -> Result<Self::Value, E> {
        Err(E::invalid_type(Unexpected::Option, &self))
    }

    /// The input holds a present optional value, which the visitor reads
    /// from `deserializer` (as `Option<T>` does with `T::deserialize`). The
    /// default rejects it.
    fn visit_some<D: Deserializer>(self, deserializer: D) -> Result<Self::Value, D::Error> {
        Err(<D::Error as Error>::invalid_type(Unexpected::Option, &self))
    }

    /// The input holds `()` (JSON's `null`). The default rejects it.
    fn visit_unit<E: Error>(self) -> Result<Self::Value, E> {
        Err(E::invalid_type(Unexpected::Unit, &self))
    }

    /// The input holds a newtype struct, whose content the visitor reads
    /// from `deserializer`. The default rejects it.
    fn visit_newtype_struct<D: Deserializer>(
        self,
        deserializer: D,
    ) -> Result<Self::Value, D::Error> {
        Err(<D::Error as Error>::invalid_type(
            Unexpected::NewtypeStruct,
            &self,
        ))
    }

    /// The input holds a sequence, whose elements the visitor reads from
    /// `seq` (see [`SeqAccess`] for an example). The default rejects it.
    fn visit_seq<A: SeqAccess>(self, seq: A) -> Result<Self::Value, A::Error> {
        Err(<A::Error as Error>::invalid_type(Unexpected::Seq, &self))
    }

    /// The input holds a map, whose entries the visitor reads from `map`
    /// (see [`MapAccess`] for an example). The default rejects it.
    fn visit_map<A: MapAccess>(self, map: A) -> Result<Self::Value, A::Error> {
        Err(<A::Error as Error>::invalid_type(Unexpected::Map, &self))
    }

    /// The input holds an enum variant, which the visitor reads from
    /// `data` (see [`EnumAccess`] for an example). The default rejects it.
    fn visit_enum<A: EnumAccess>(self, data: A) -> Result<Self::Value, A::Error> {
        Err(<A::Error as Error>::invalid_type(Unexpected::Enum, &self))
    }
}

/// Gives a [`Visitor`] the elements of a sequence, one at a time.
///
/// The deserializer passes it to [`Visitor::visit_seq`].
///
/// # Examples
///
/// A visitor adding up a list of numbers:
///
/// ```
/// use std::{
///     fmt, json,
///     serde::de::{Deserialize, Deserializer, SeqAccess, Visitor},
/// };
///
/// struct Total(i64);
///
/// struct TotalVisitor;
///
/// impl Visitor for TotalVisitor {
///     type Value = Total;
///
///     fn expecting(&self, formatter: &mut fmt::Formatter) -> fmt::Result {
///         formatter.write_str("a list of integers")
///     }
///
///     fn visit_seq<A: SeqAccess>(self, seq: A) -> Result<Total, A::Error> {
///         let mut seq = seq;
///         let mut sum = 0;
///         while let Some(n) = seq.next_element::<i64>()? {
///             sum += n;
///         }
///         Ok(Total(sum))
///     }
/// }
///
/// impl Deserialize for Total {
///     fn deserialize<D: Deserializer>(deserializer: D) -> Result<Total, D::Error> {
///         deserializer.deserialize_seq(TotalVisitor)
///     }
/// }
///
/// let t: Total = json::from_str("[1, 2, 3, 4]").unwrap();
/// assert_eq(t.0, 10);
/// ```
pub trait SeqAccess {
    /// The error type of the deserializer.
    type Error: Error;
    /// Reads the next element as a `T`, or returns `Ok(None)` at the end
    /// of the sequence.
    ///
    /// # Errors
    ///
    /// Returns an error if the input is malformed or the element is not a
    /// `T`.
    fn next_element<T: Deserialize>(&mut self) -> Result<Option<T>, Self::Error>;
    /// The number of elements left, if known. The default returns `None`.
    fn size_hint(&self) -> Option<usize> {
        None
    }
}

/// Gives a [`Visitor`] the entries of a map, each a key then its value.
///
/// The deserializer passes it to [`Visitor::visit_map`]. Call
/// [`next_key`](MapAccess::next_key) then
/// [`next_value`](MapAccess::next_value) for each entry, or
/// [`next_entry`](MapAccess::next_entry) for both.
///
/// # Examples
///
/// A visitor keeping a JSON object's entries in their order:
///
/// ```
/// use std::{
///     fmt, json,
///     serde::de::{Deserialize, Deserializer, MapAccess, Visitor},
/// };
///
/// struct Ordered(Vec<(String, i32)>);
///
/// struct OrderedVisitor;
///
/// impl Visitor for OrderedVisitor {
///     type Value = Ordered;
///
///     fn expecting(&self, formatter: &mut fmt::Formatter) -> fmt::Result {
///         formatter.write_str("a map of integers")
///     }
///
///     fn visit_map<A: MapAccess>(self, map: A) -> Result<Ordered, A::Error> {
///         let mut map = map;
///         let mut out = Vec::new();
///         while let Some(key) = map.next_key::<String>()? {
///             let value = map.next_value::<i32>()?;
///             out.push((key, value));
///         }
///         Ok(Ordered(out))
///     }
/// }
///
/// impl Deserialize for Ordered {
///     fn deserialize<D: Deserializer>(deserializer: D) -> Result<Ordered, D::Error> {
///         deserializer.deserialize_map(OrderedVisitor)
///     }
/// }
///
/// let o: Ordered = json::from_str("{\"b\": 2, \"a\": 1}").unwrap();
/// assert_eq(o.0, Vec::from([("b".to_string(), 2), ("a".to_string(), 1)]));
/// ```
pub trait MapAccess {
    /// The error type of the deserializer.
    type Error: Error;
    /// Reads the next key as a `K`, or returns `Ok(None)` at the end of the
    /// map.
    ///
    /// # Errors
    ///
    /// Returns an error if the input is malformed or the key is not a `K`.
    fn next_key<K: Deserialize>(&mut self) -> Result<Option<K>, Self::Error>;
    /// Reads the value of the key read last, as a `V`.
    ///
    /// # Errors
    ///
    /// Returns an error if the input is malformed or the value is not a
    /// `V`.
    fn next_value<V: Deserialize>(&mut self) -> Result<V, Self::Error>;
    /// Reads the next entry, or returns `Ok(None)` at the end of the map.
    ///
    /// The default implementation calls [`next_key`](MapAccess::next_key)
    /// and then [`next_value`](MapAccess::next_value).
    ///
    /// # Errors
    ///
    /// Returns an error if the input is malformed or the key or value has
    /// the wrong type.
    fn next_entry<K: Deserialize, V: Deserialize>(
        &mut self,
    ) -> Result<Option<(K, V)>, Self::Error> {
        match self.next_key::<K>()? {
            Some(k) => {
                let v = self.next_value::<V>()?;
                Ok(Some((k, v)))
            }
            None => Ok(None),
        }
    }

    /// The number of entries left, if known. The default returns `None`.
    fn size_hint(&self) -> Option<usize> {
        None
    }
}

/// Gives a [`Visitor`] an enum variant: first which variant it is, then
/// (through [`VariantAccess`]) its content.
///
/// The deserializer passes it to [`Visitor::visit_enum`], when the type
/// asked with [`Deserializer::deserialize_enum`]. JSON gives a unit
/// variant as `"Name"` and the others as `{"Name": content}`.
///
/// # Examples
///
/// ```
/// use std::{
///     fmt, json,
///     serde::de::{self, Deserialize, Deserializer, EnumAccess, VariantAccess, Visitor},
/// };
///
/// #[derive(Debug, PartialEq, Clone)]
/// enum Level {
///     Low,
///     High,
///     Custom(u8),
/// }
///
/// const VARIANTS: [&str; 3] = ["Low", "High", "Custom"];
///
/// struct LevelVisitor;
///
/// impl Visitor for LevelVisitor {
///     type Value = Level;
///
///     fn expecting(&self, formatter: &mut fmt::Formatter) -> fmt::Result {
///         formatter.write_str("enum Level")
///     }
///
///     fn visit_enum<A: EnumAccess>(self, data: A) -> Result<Level, A::Error> {
///         let (name, variant): (String, A::Variant) = data.variant::<String>()?;
///         match name.as_str() {
///             "Low" => {
///                 variant.unit_variant()?;
///                 Ok(Level::Low)
///             }
///             "High" => {
///                 variant.unit_variant()?;
///                 Ok(Level::High)
///             }
///             "Custom" => Ok(Level::Custom(variant.newtype_variant::<u8>()?)),
///             _ => Err(<A::Error as de::Error>::unknown_variant(
///                 name.as_str(),
///                 &VARIANTS,
///             )),
///         }
///     }
/// }
///
/// impl Deserialize for Level {
///     fn deserialize<D: Deserializer>(deserializer: D) -> Result<Level, D::Error> {
///         deserializer.deserialize_enum("Level", &VARIANTS, LevelVisitor)
///     }
/// }
///
/// let v: Vec<Level> = json::from_str("[\"Low\", {\"Custom\": 7}, \"High\"]").unwrap();
/// assert_eq(v, Vec::from([Level::Low, Level::Custom(7), Level::High]));
///
/// let e = json::from_str::<Level>("\"Mid\"").unwrap_err();
/// assert_eq(
///     e.to_string(),
///     "json: unknown variant `Mid`, expected one of `Low`, `High`, `Custom` at offset 5",
/// );
/// ```
pub trait EnumAccess {
    /// The error type of the deserializer.
    type Error: Error;
    /// The [`VariantAccess`] that reads the variant's content.
    type Variant: VariantAccess<Error = Self::Error>;
    /// Reads which variant the input holds, as a `V` (usually a `String`
    /// or an identifier type), and returns it with the access to its
    /// content.
    ///
    /// # Errors
    ///
    /// Returns an error if the input is not an enum variant, or its name
    /// is not a `V`.
    fn variant<V: Deserialize>(self) -> Result<(V, Self::Variant), Self::Error>;
}

/// Reads the content of an enum variant, as the kind of variant the
/// [`Visitor`] expects.
///
/// [`EnumAccess::variant`] returns it after the variant's name; call the
/// one method for that variant's kind (see [`EnumAccess`] for an example).
pub trait VariantAccess {
    /// The error type of the deserializer.
    type Error: Error;
    /// Reads a unit variant (no content).
    ///
    /// # Errors
    ///
    /// Returns an error if the input has content for the variant.
    fn unit_variant(self) -> Result<(), Self::Error>;
    /// Reads a newtype variant's one field as a `T`.
    ///
    /// # Errors
    ///
    /// Returns an error if the input has no content for the variant, or
    /// the content is not a `T`.
    fn newtype_variant<T: Deserialize>(self) -> Result<T, Self::Error>;
    /// Reads a tuple variant's `len` fields: passes them to the visitor's
    /// [`visit_seq`](Visitor::visit_seq).
    ///
    /// # Errors
    ///
    /// Returns an error if the content is not a sequence, or the visitor
    /// fails.
    fn tuple_variant<V: Visitor>(self, len: usize, visitor: V) -> Result<V::Value, Self::Error>;
    /// Reads a struct variant with the given fields: passes them to the
    /// visitor's [`visit_map`](Visitor::visit_map) (or
    /// [`visit_seq`](Visitor::visit_seq), for a format that writes structs
    /// as sequences).
    ///
    /// # Errors
    ///
    /// Returns an error if the content is not a map, or the visitor fails.
    fn struct_variant<V: Visitor>(
        self,
        fields: &[&str],
        visitor: V,
    ) -> Result<V::Value, Self::Error>;
}

/// A value of any kind, read and thrown away, as serde's `IgnoredAny`.
///
/// Deserializing it accepts any input (and reads all of it); the derive
/// uses it to skip the values of unknown struct fields.
///
/// # Examples
///
/// Reading only the second element of a pair:
///
/// ```
/// use std::{json, serde::de::IgnoredAny};
///
/// let (_, n): (IgnoredAny, i32) = json::from_str("[{\"a\": [1, null]}, 7]").unwrap();
/// assert_eq(n, 7);
/// ```
#[derive(Clone, Debug, Default, PartialEq)]
pub struct IgnoredAny;

impl Visitor for IgnoredAny {
    type Value = IgnoredAny;
    fn expecting(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("anything at all")
    }

    fn visit_bool<E: Error>(self, v: bool) -> Result<IgnoredAny, E> {
        Ok(IgnoredAny)
    }

    fn visit_i64<E: Error>(self, v: i64) -> Result<IgnoredAny, E> {
        Ok(IgnoredAny)
    }

    fn visit_u64<E: Error>(self, v: u64) -> Result<IgnoredAny, E> {
        Ok(IgnoredAny)
    }

    fn visit_f64<E: Error>(self, v: f64) -> Result<IgnoredAny, E> {
        Ok(IgnoredAny)
    }

    fn visit_str<E: Error>(self, v: &str) -> Result<IgnoredAny, E> {
        Ok(IgnoredAny)
    }

    fn visit_bytes<E: Error>(self, v: &[u8]) -> Result<IgnoredAny, E> {
        Ok(IgnoredAny)
    }

    fn visit_none<E: Error>(self) -> Result<IgnoredAny, E> {
        Ok(IgnoredAny)
    }

    fn visit_some<D: Deserializer>(self, d: D) -> Result<IgnoredAny, D::Error> {
        IgnoredAny::deserialize(d)
    }

    fn visit_unit<E: Error>(self) -> Result<IgnoredAny, E> {
        Ok(IgnoredAny)
    }

    fn visit_newtype_struct<D: Deserializer>(self, d: D) -> Result<IgnoredAny, D::Error> {
        IgnoredAny::deserialize(d)
    }

    fn visit_seq<A: SeqAccess>(self, seq: A) -> Result<IgnoredAny, A::Error> {
        let mut s = seq;
        while let Some(_) = s.next_element::<IgnoredAny>()? {}
        Ok(IgnoredAny)
    }

    fn visit_map<A: MapAccess>(self, map: A) -> Result<IgnoredAny, A::Error> {
        let mut m = map;
        while let Some((_, _)) = m.next_entry::<IgnoredAny, IgnoredAny>()? {}
        Ok(IgnoredAny)
    }

    fn visit_enum<A: EnumAccess>(self, data: A) -> Result<IgnoredAny, A::Error> {
        let (_, v) = data.variant::<IgnoredAny>()?;
        v.newtype_variant::<IgnoredAny>()
    }
}

impl Deserialize for IgnoredAny {
    fn deserialize<D: Deserializer>(d: D) -> Result<IgnoredAny, D::Error> {
        d.deserialize_ignored_any(IgnoredAny)
    }
}

// --- std's types -------------------------------------------------------------

struct BoolVisitor;
impl Visitor for BoolVisitor {
    type Value = bool;
    fn expecting(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("a boolean")
    }

    fn visit_bool<E: Error>(self, v: bool) -> Result<bool, E> {
        Ok(v)
    }
}

impl Deserialize for bool {
    fn deserialize<D: Deserializer>(d: D) -> Result<bool, D::Error> {
        d.deserialize_bool(BoolVisitor)
    }
}

// Integers: from any integer that fits (a float only if whole and in
// range, as JSON numbers are), else an invalid value.
struct IntVisitor<T> {
    what: &str,
    lo: i128,
    hi: i128,
    marker: PhantomData<T>,
}

trait FromI128 {
    fn from_i128(v: i128) -> Self;
}

impl FromI128 for i8 {
    fn from_i128(v: i128) -> i8 {
        v as i8
    }
}

impl FromI128 for i16 {
    fn from_i128(v: i128) -> i16 {
        v as i16
    }
}

impl FromI128 for i32 {
    fn from_i128(v: i128) -> i32 {
        v as i32
    }
}

impl FromI128 for i64 {
    fn from_i128(v: i128) -> i64 {
        v as i64
    }
}

impl FromI128 for isize {
    fn from_i128(v: i128) -> isize {
        v as isize
    }
}

impl FromI128 for u8 {
    fn from_i128(v: i128) -> u8 {
        v as u8
    }
}

impl FromI128 for u16 {
    fn from_i128(v: i128) -> u16 {
        v as u16
    }
}

impl FromI128 for u32 {
    fn from_i128(v: i128) -> u32 {
        v as u32
    }
}

impl FromI128 for u64 {
    fn from_i128(v: i128) -> u64 {
        v as u64
    }
}

impl FromI128 for usize {
    fn from_i128(v: i128) -> usize {
        v as usize
    }
}

impl<T: FromI128> Visitor for IntVisitor<T> {
    type Value = T;
    fn expecting(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str(self.what)
    }

    fn visit_i64<E: Error>(self, v: i64) -> Result<T, E> {
        let w = v as i128;
        if w < self.lo || w > self.hi {
            return Err(E::invalid_value(Unexpected::Signed(v), &self));
        }
        Ok(T::from_i128(w))
    }

    fn visit_u64<E: Error>(self, v: u64) -> Result<T, E> {
        let w = v as i128;
        if w < self.lo || w > self.hi {
            return Err(E::invalid_value(Unexpected::Unsigned(v), &self));
        }
        Ok(T::from_i128(w))
    }

    fn visit_f64<E: Error>(self, v: f64) -> Result<T, E> {
        if v != v.trunc() || v < self.lo as f64 || v > self.hi as f64 {
            return Err(E::invalid_type(Unexpected::Float(v), &self));
        }
        Ok(T::from_i128(v as i128))
    }
}

fn int_visitor<T>(what: &str, lo: i128, hi: i128) -> IntVisitor<T> {
    IntVisitor {
        what,
        lo,
        hi,
        marker: PhantomData,
    }
}

impl Deserialize for i8 {
    fn deserialize<D: Deserializer>(d: D) -> Result<i8, D::Error> {
        d.deserialize_i8(int_visitor::<i8>("i8", -128, 127))
    }
}

impl Deserialize for i16 {
    fn deserialize<D: Deserializer>(d: D) -> Result<i16, D::Error> {
        d.deserialize_i16(int_visitor::<i16>("i16", -32768, 32767))
    }
}

impl Deserialize for i32 {
    fn deserialize<D: Deserializer>(d: D) -> Result<i32, D::Error> {
        d.deserialize_i32(int_visitor::<i32>("i32", -2147483648, 2147483647))
    }
}

impl Deserialize for i64 {
    fn deserialize<D: Deserializer>(d: D) -> Result<i64, D::Error> {
        d.deserialize_i64(int_visitor::<i64>(
            "i64",
            i64::MIN as i128,
            i64::MAX as i128,
        ))
    }
}

impl Deserialize for isize {
    fn deserialize<D: Deserializer>(d: D) -> Result<isize, D::Error> {
        d.deserialize_i64(int_visitor::<isize>(
            "isize",
            i64::MIN as i128,
            i64::MAX as i128,
        ))
    }
}

impl Deserialize for u8 {
    fn deserialize<D: Deserializer>(d: D) -> Result<u8, D::Error> {
        d.deserialize_u8(int_visitor::<u8>("u8", 0, 255))
    }
}

impl Deserialize for u16 {
    fn deserialize<D: Deserializer>(d: D) -> Result<u16, D::Error> {
        d.deserialize_u16(int_visitor::<u16>("u16", 0, 65535))
    }
}

impl Deserialize for u32 {
    fn deserialize<D: Deserializer>(d: D) -> Result<u32, D::Error> {
        d.deserialize_u32(int_visitor::<u32>("u32", 0, 4294967295))
    }
}

impl Deserialize for u64 {
    fn deserialize<D: Deserializer>(d: D) -> Result<u64, D::Error> {
        d.deserialize_u64(int_visitor::<u64>("u64", 0, u64::MAX as i128))
    }
}

impl Deserialize for usize {
    fn deserialize<D: Deserializer>(d: D) -> Result<usize, D::Error> {
        d.deserialize_u64(int_visitor::<usize>("usize", 0, u64::MAX as i128))
    }
}

struct F64Visitor;
impl Visitor for F64Visitor {
    type Value = f64;
    fn expecting(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("a number")
    }

    fn visit_i64<E: Error>(self, v: i64) -> Result<f64, E> {
        Ok(v as f64)
    }

    fn visit_u64<E: Error>(self, v: u64) -> Result<f64, E> {
        Ok(v as f64)
    }

    fn visit_f64<E: Error>(self, v: f64) -> Result<f64, E> {
        Ok(v)
    }
    // (A format without NaN and the infinities writes them as null.)
    fn visit_unit<E: Error>(self) -> Result<f64, E> {
        Ok(0.0 / 0.0)
    }
}

impl Deserialize for f64 {
    fn deserialize<D: Deserializer>(d: D) -> Result<f64, D::Error> {
        d.deserialize_f64(F64Visitor)
    }
}

impl Deserialize for f32 {
    fn deserialize<D: Deserializer>(d: D) -> Result<f32, D::Error> {
        let v = d.deserialize_f32(F64Visitor)?;
        Ok(v as f32)
    }
}

struct CharVisitor;
impl Visitor for CharVisitor {
    type Value = char;
    fn expecting(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("a character")
    }

    fn visit_char<E: Error>(self, v: char) -> Result<char, E> {
        Ok(v)
    }

    fn visit_str<E: Error>(self, v: &str) -> Result<char, E> {
        let mut it = v.chars();
        match (it.next(), it.next()) {
            (Some(c), None) => Ok(c),
            _ => Err(E::invalid_value(Unexpected::Str(v.to_string()), &self)),
        }
    }
}

impl Deserialize for char {
    fn deserialize<D: Deserializer>(d: D) -> Result<char, D::Error> {
        d.deserialize_char(CharVisitor)
    }
}

struct StringVisitor;
impl Visitor for StringVisitor {
    type Value = String;
    fn expecting(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("a string")
    }

    fn visit_str<E: Error>(self, v: &str) -> Result<String, E> {
        Ok(v.to_string())
    }

    fn visit_string<E: Error>(self, v: String) -> Result<String, E> {
        Ok(v)
    }
}

impl Deserialize for String {
    fn deserialize<D: Deserializer>(d: D) -> Result<String, D::Error> {
        d.deserialize_string(StringVisitor)
    }
}

struct UnitVisitor;
impl Visitor for UnitVisitor {
    type Value = ();
    fn expecting(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("unit")
    }

    fn visit_unit<E: Error>(self) -> Result<(), E> {
        Ok(())
    }
}

impl Deserialize for () {
    fn deserialize<D: Deserializer>(d: D) -> Result<(), D::Error> {
        d.deserialize_unit(UnitVisitor)
    }
}

struct OptionVisitor<T> {
    marker: PhantomData<T>,
}

impl<T: Deserialize> Visitor for OptionVisitor<T> {
    type Value = Option<T>;
    fn expecting(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("option")
    }

    fn visit_none<E: Error>(self) -> Result<Option<T>, E> {
        Ok(None)
    }

    fn visit_unit<E: Error>(self) -> Result<Option<T>, E> {
        Ok(None)
    }

    fn visit_some<D: Deserializer>(self, d: D) -> Result<Option<T>, D::Error> {
        Ok(Some(T::deserialize(d)?))
    }
}

impl<T: Deserialize> Deserialize for Option<T> {
    fn deserialize<D: Deserializer>(d: D) -> Result<Option<T>, D::Error> {
        d.deserialize_option(OptionVisitor::<T> {
            marker: PhantomData,
        })
    }
}

struct VecVisitor<T> {
    marker: PhantomData<T>,
}

impl<T: Deserialize> Visitor for VecVisitor<T> {
    type Value = Vec<T>;
    fn expecting(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("a sequence")
    }

    fn visit_seq<A: SeqAccess>(self, seq: A) -> Result<Vec<T>, A::Error> {
        let mut s = seq;
        let mut out = Vec::new();
        while let Some(x) = s.next_element::<T>()? {
            out.push(x);
        }
        Ok(out)
    }
}

impl<T: Deserialize> Deserialize for Vec<T> {
    fn deserialize<D: Deserializer>(d: D) -> Result<Vec<T>, D::Error> {
        d.deserialize_seq(VecVisitor::<T> {
            marker: PhantomData,
        })
    }
}

impl<T: Deserialize> Deserialize for VecDeque<T> {
    fn deserialize<D: Deserializer>(d: D) -> Result<VecDeque<T>, D::Error> {
        let v = Vec::<T>::deserialize(d)?;
        let mut out = VecDeque::new();
        for x in v.iter() {
            out.push_back(*x);
        }
        Ok(out)
    }
}

impl<T: Deserialize + Hash + Eq> Deserialize for HashSet<T> {
    fn deserialize<D: Deserializer>(d: D) -> Result<HashSet<T>, D::Error> {
        let v = Vec::<T>::deserialize(d)?;
        let mut out = HashSet::new();
        for x in v.iter() {
            out.insert(*x);
        }
        Ok(out)
    }
}

impl<T: Deserialize + Ord> Deserialize for BTreeSet<T> {
    fn deserialize<D: Deserializer>(d: D) -> Result<BTreeSet<T>, D::Error> {
        let v = Vec::<T>::deserialize(d)?;
        let mut out = BTreeSet::new();
        for x in v.iter() {
            out.insert(*x);
        }
        Ok(out)
    }
}

struct MapVisitor<K, V> {
    marker: PhantomData<(K, V)>,
}

impl<K: Deserialize + Hash + Eq, V: Deserialize> Visitor for MapVisitor<K, V> {
    type Value = HashMap<K, V>;
    fn expecting(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("a map")
    }

    fn visit_map<A: MapAccess>(self, map: A) -> Result<HashMap<K, V>, A::Error> {
        let mut m = map;
        let mut out = HashMap::new();
        while let Some((k, v)) = m.next_entry::<K, V>()? {
            out.insert(k, v);
        }
        Ok(out)
    }
}

impl<K: Deserialize + Hash + Eq, V: Deserialize> Deserialize for HashMap<K, V> {
    fn deserialize<D: Deserializer>(d: D) -> Result<HashMap<K, V>, D::Error> {
        d.deserialize_map(MapVisitor::<K, V> {
            marker: PhantomData,
        })
    }
}

struct BTreeMapVisitor<K, V> {
    marker: PhantomData<(K, V)>,
}

impl<K: Deserialize + Ord, V: Deserialize> Visitor for BTreeMapVisitor<K, V> {
    type Value = BTreeMap<K, V>;
    fn expecting(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("a map")
    }

    fn visit_map<A: MapAccess>(self, map: A) -> Result<BTreeMap<K, V>, A::Error> {
        let mut m = map;
        let mut out = BTreeMap::new();
        while let Some((k, v)) = m.next_entry::<K, V>()? {
            out.insert(k, v);
        }
        Ok(out)
    }
}

impl<K: Deserialize + Ord, V: Deserialize> Deserialize for BTreeMap<K, V> {
    fn deserialize<D: Deserializer>(d: D) -> Result<BTreeMap<K, V>, D::Error> {
        d.deserialize_map(BTreeMapVisitor::<K, V> {
            marker: PhantomData,
        })
    }
}

// Tuples: a sequence of exactly their length.
struct Tuple2Visitor<A, B> {
    marker: PhantomData<(A, B)>,
}

impl<A: Deserialize, B: Deserialize> Visitor for Tuple2Visitor<A, B> {
    type Value = (A, B);
    fn expecting(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("a tuple of size 2")
    }

    fn visit_seq<S: SeqAccess>(self, seq: S) -> Result<(A, B), S::Error> {
        let mut s = seq;
        let a = match s.next_element::<A>()? {
            Some(x) => x,
            None => return Err(<S::Error as Error>::invalid_length(0, &self)),
        };
        let b = match s.next_element::<B>()? {
            Some(x) => x,
            None => return Err(<S::Error as Error>::invalid_length(1, &self)),
        };
        Ok((a, b))
    }
}

impl<A: Deserialize, B: Deserialize> Deserialize for (A, B) {
    fn deserialize<D: Deserializer>(d: D) -> Result<(A, B), D::Error> {
        d.deserialize_tuple(
            2,
            Tuple2Visitor::<A, B> {
                marker: PhantomData,
            },
        )
    }
}

struct Tuple3Visitor<A, B, C> {
    marker: PhantomData<(A, B, C)>,
}

impl<A: Deserialize, B: Deserialize, C: Deserialize> Visitor for Tuple3Visitor<A, B, C> {
    type Value = (A, B, C);
    fn expecting(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("a tuple of size 3")
    }

    fn visit_seq<S: SeqAccess>(self, seq: S) -> Result<(A, B, C), S::Error> {
        let mut s = seq;
        let a = match s.next_element::<A>()? {
            Some(x) => x,
            None => return Err(<S::Error as Error>::invalid_length(0, &self)),
        };
        let b = match s.next_element::<B>()? {
            Some(x) => x,
            None => return Err(<S::Error as Error>::invalid_length(1, &self)),
        };
        let c = match s.next_element::<C>()? {
            Some(x) => x,
            None => return Err(<S::Error as Error>::invalid_length(2, &self)),
        };
        Ok((a, b, c))
    }
}

impl<A: Deserialize, B: Deserialize, C: Deserialize> Deserialize for (A, B, C) {
    fn deserialize<D: Deserializer>(d: D) -> Result<(A, B, C), D::Error> {
        d.deserialize_tuple(
            3,
            Tuple3Visitor::<A, B, C> {
                marker: PhantomData,
            },
        )
    }
}

// References and &str: a new value (navi has a collector: what they point
// to is allocated, where serde borrows from the input).
impl<T: Deserialize> Deserialize for &T {
    fn deserialize<D: Deserializer>(d: D) -> Result<&T, D::Error> {
        Ok(&T::deserialize(d)?)
    }
}

impl<T: Deserialize> Deserialize for &mut T {
    fn deserialize<D: Deserializer>(d: D) -> Result<&mut T, D::Error> {
        Ok(&mut T::deserialize(d)?)
    }
}

impl Deserialize for &str {
    fn deserialize<D: Deserializer>(d: D) -> Result<&str, D::Error> {
        let s = String::deserialize(d)?;
        Ok(s.as_str())
    }
}

// Arrays: a sequence of exactly their length.
struct ArrayVisitor<T, const N: usize> {
    marker: PhantomData<T>,
}

impl<T: Deserialize, const N: usize> Visitor for ArrayVisitor<T, N> {
    type Value = [T; N];
    fn expecting(&self, f: &mut Formatter) -> fmt::Result {
        f.write_fmt(`an array of length ${N}`)
    }

    fn visit_seq<A: SeqAccess>(self, seq: A) -> Result<[T; N], A::Error> {
        let mut s = seq;
        let p = crate::rt::alloc_array::<T>(if N == 0 { 1 } else { N });
        let mut i = 0;
        while i < N {
            match s.next_element::<T>()? {
                Some(x) => unsafe {
                    p.add(i).write(x);
                },
                None => return Err(<A::Error as Error>::invalid_length(i, &self)),
            }
            i += 1;
        }
        Ok(unsafe { *(p as *const [T; N]) })
    }
}

impl<T: Deserialize, const N: usize> Deserialize for [T; N] {
    fn deserialize<D: Deserializer>(d: D) -> Result<[T; N], D::Error> {
        d.deserialize_tuple(
            N,
            ArrayVisitor::<T, N> {
                marker: PhantomData,
            },
        )
    }
}
