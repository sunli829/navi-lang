//! Hints to the compiler.

/// Returns `x` unchanged, keeping the compiler from optimizing away the
/// computation of `x` or the use of its result.
///
/// Its use is in benchmarks (see `std::bench::Bencher`): it is a function
/// the compiler never inlines, so the work being measured is not removed
/// as dead code.
///
/// # Examples
///
/// ```
/// use std::hint::black_box;
///
/// fn contains(haystack: &[&str], needle: &str) -> bool {
///     haystack.iter().any(|x: &&str| -> bool { *x == needle })
/// }
///
/// let haystack = ["a", "b", "c"];
/// let found = contains(black_box(haystack.as_slice()), black_box("c"));
/// assert(black_box(found));
/// ```
#[inline(never)]
pub fn black_box<T>(x: T) -> T {
    x
}
