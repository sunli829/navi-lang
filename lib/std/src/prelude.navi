//! Names available in every module without an import, as in Rust's
//! std::prelude, plus the functions that replace Rust's printing and
//! assertion macros.
//!
//! The prelude has [`Option`] (with `Some` and `None`), [`Result`] (with
//! `Ok` and `Err`), [`String`], [`Vec`], the common traits ([`Clone`],
//! [`Default`], the comparison, conversion and iterator traits), the
//! printing functions (`print`, `println`, `eprint`, `eprintln`) and the
//! panic and assertion functions (`panic`, `assert`, `assert_msg`,
//! `assert_eq`, `assert_ne`, `todo`, `unimplemented`, `unreachable`).
//!
//! # Examples
//!
//! ```
//! // No `use` needed for any of these.
//! let mut v: Vec<String> = Vec::new();
//! v.push("a".to_string());
//! let first: Option<&String> = v.first();
//! assert_eq(first.cloned(), Some("a".to_string()));
//! let n: Result<i32, String> = Ok(1);
//! println(`${v:?} ${n:?}`);
//! ```

pub use crate::{
    clone::Clone,
    cmp::{Eq, Ord, PartialEq, PartialOrd},
    convert::{AsMut, AsRef, From, Into, TryFrom, TryInto},
    default::Default,
    io::{eprint, eprintln, print, println},
    iter::{DoubleEndedIterator, ExactSizeIterator, Extend, FromIterator, IntoIterator, Iterator},
    option::Option::{self, None, Some},
    panic::{assert, assert_eq, assert_msg, assert_ne, panic, todo, unimplemented, unreachable},
    result::Result::{self, Err, Ok},
    string::{String, ToString},
    vec::Vec,
};
