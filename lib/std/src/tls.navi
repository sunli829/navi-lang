//! TLS clients and servers (TLS 1.3, RFC 8446, and 1.2, RFC 5246),
//! written in navi as Go's `crypto/tls`, with the API of Rust's
//! `native-tls` crate.
//!
//! A [`TlsConnector`](crate::tls::TlsConnector) wraps a connected stream in
//! a [`TlsStream`](crate::tls::TlsStream), which reads and writes
//! plaintext; a [`TlsAcceptor`](crate::tls::TlsAcceptor) does the same for
//! a server. Streams block (there is no `WouldBlock` handshake error).
//!
//! # Examples
//!
//! ```no_run
//! use std::{
//!     io::{Read, Write},
//!     net::TcpStream,
//!     tls::TlsConnector,
//! };
//!
//! fn main() -> std::io::Result<()> {
//!     let connector = TlsConnector::new()?;
//!     let stream = TcpStream::connect("example.com:443")?;
//!     let mut tls = connector.connect("example.com", stream)?;
//!     tls.write_all(b"GET / HTTP/1.0\r\nHost: example.com\r\n\r\n")?;
//!     let mut page = Vec::new();
//!     tls.read_to_end(&mut page)?;
//!     Ok(())
//! }
//! ```
//!
//! A server and a client in one program, with a root of one's own:
//!
//! ```
//! use std::io::{Read, Write};
//! use std::net::{TcpListener, TcpStream};
//! use std::tls::{Certificate, Identity, TlsAcceptor, TlsConnector};
//!
//! # // A test PKI: an Ed25519 root, and a server certificate for localhost
//! # // (valid 2025 to 2125) with its key.
//! # let mut root_pem = String::new();
//! # root_pem.push_str("-----BEGIN CERTIFICATE-----\n");
//! # root_pem.push_str("MIIBIDCB06ADAgECAgEBMAUGAytlcDAXMRUwEwYDVQQDEwxlZDI1NTE5IHJvb3Qw\n");
//! # root_pem.push_str("IBcNMjUwMTAxMDAwMDAwWhgPMjEyNTAxMDEwMDAwMDBaMBcxFTATBgNVBAMTDGVk\n");
//! # root_pem.push_str("MjU1MTkgcm9vdDAqMAUGAytlcAMhAOqug4Ff3BRnzivlQOiloXfbZoMO+62SgSG5\n");
//! # root_pem.push_str("08PMs3pRo0IwQDAOBgNVHQ8BAf8EBAMCAgQwDwYDVR0TAQH/BAUwAwEB/zAdBgNV\n");
//! # root_pem.push_str("HQ4EFgQUPl0gIDTo2x7nu7h529GnEHmZxagwBQYDK2VwA0EAhtjpwIs07XwZdWRU\n");
//! # root_pem.push_str("RBHIraY1z7j+TOy9ii/PWeo76r8RTnej8nrbtb5heb8yGsga0eE/tcRW+o2SAkJW\n");
//! # root_pem.push_str("t3qfCg==\n");
//! # root_pem.push_str("-----END CERTIFICATE-----\n");
//! # let mut cert_pem = String::new();
//! # cert_pem.push_str("-----BEGIN CERTIFICATE-----\n");
//! # cert_pem.push_str("MIIBOTCB7KADAgECAgECMAUGAytlcDAXMRUwEwYDVQQDEwxlZDI1NTE5IHJvb3Qw\n");
//! # cert_pem.push_str("IBcNMjUwMTAxMDAwMDAwWhgPMjEyNTAxMDEwMDAwMDBaMBQxEjAQBgNVBAMTCWxv\n");
//! # cert_pem.push_str("Y2FsaG9zdDAqMAUGAytlcAMhAMPfosir7qhzlT6oRo6N3Dshou0cuFSeGiLED2pS\n");
//! # cert_pem.push_str("32HRo14wXDAOBgNVHQ8BAf8EBAMCB4AwEwYDVR0lBAwwCgYIKwYBBQUHAwEwHwYD\n");
//! # cert_pem.push_str("VR0jBBgwFoAUPl0gIDTo2x7nu7h529GnEHmZxagwFAYDVR0RBA0wC4IJbG9jYWxo\n");
//! # cert_pem.push_str("b3N0MAUGAytlcANBANurjGjmXB96qqGnuBQpsa/+f/Xinyvj4BUdBZCHaJ+Vf/yt\n");
//! # cert_pem.push_str("2b2Q+ykPlft0o1Vs/d7s0lNEGx6y6mdYik/CZA4=\n");
//! # cert_pem.push_str("-----END CERTIFICATE-----\n");
//! # let mut key_pem = String::new();
//! # key_pem.push_str("-----BEGIN PRIVATE KEY-----\n");
//! # key_pem.push_str("MC4CAQAwBQYDK2VwBCIEIGXkuTV2sHFM6SgUmOqJvQUbFxRaj2i7ujaE3iQAp+dW\n");
//! # key_pem.push_str("-----END PRIVATE KEY-----\n");
//! let identity = Identity::from_pkcs8(cert_pem.as_bytes(), key_pem.as_bytes()).unwrap();
//! let acceptor = TlsAcceptor::new(identity).unwrap();
//! let listener = TcpListener::bind("127.0.0.1:0").unwrap();
//! let port = listener.local_addr().unwrap().port();
//! std::thread::spawn(|| {
//!     let (stream, _) = listener.accept().unwrap();
//!     let mut tls = acceptor.accept(stream).unwrap();
//!     tls.write_all(b"hello").unwrap();
//!     tls.shutdown().unwrap();
//! });
//!
//! let connector = TlsConnector::builder()
//!     .add_root_certificate(Certificate::from_pem(root_pem.as_bytes()).unwrap())
//!     .disable_built_in_roots(true)
//!     .build()
//!     .unwrap();
//! let stream = TcpStream::connect(`127.0.0.1:${port}`.to_string().as_str()).unwrap();
//! let mut tls = connector.connect("localhost", stream).unwrap();
//! let mut s = String::new();
//! tls.read_to_string(&mut s).unwrap();
//! assert_eq(s, "hello");
//! ```
//!
//! The server's certificate is verified as `crypto::x509` does (the
//! system's roots: on macOS and Windows the platform's verifier), for the
//! domain given to `connect`; the builder adds roots, turns off the
//! system's, or (danger_*) skips the checks. Cipher suites:
//! TLS_AES_128_GCM_SHA256, TLS_AES_256_GCM_SHA384 and
//! TLS_CHACHA20_POLY1305_SHA256 (AES first when the CPU has AES
//! instructions, as Go); key exchange: X25519, P-256 or P-384 (after a
//! HelloRetryRequest); server signatures: ECDSA (P-256, P-384) and
//! RSA-PSS. TLS 1.2 (when the server does not speak 1.3): ECDHE with
//! AES-GCM, ChaCha20-Poly1305 or (last) AES-CBC with HMAC-SHA1 (Go's
//! defaults), ECDSA
//! and RSA certificates (PKCS#1 v1.5 or PSS), the extended master secret;
//! no renegotiation. Client certificates: `TlsConnectorBuilder::identity`
//! (sent when the server asks). Session resumption with tickets (servers
//! send them; clients keep them with `TlsConnectorBuilder::session_cache`),
//! as Go; no 0-RTT.
//!
//! Servers: a `TlsAcceptor` of an `Identity` (a certificate chain and its
//! key: RSA, ECDSA P-256 or P-384, Ed25519) accepts TLS 1.3 and 1.2
//! clients the same way (`client_auth` asks clients for certificates, as
//! Go's `ClientAuth`).

pub use crate::crypto::x509::Certificate;
use crate::{
    crypto::{
        Digest,
        aead::{AeadInPlace, KeyInit},
        aes::{Aes128, Aes256},
        aes_gcm::{Aes128Gcm, Aes256Gcm},
        chacha20poly1305::ChaCha20Poly1305,
        ed25519,
        hkdf::Hkdf,
        hmac::{Hmac, Mac},
        p256, p384,
        rsa::{Pkcs1v15Sign, Pss},
        sha1::Sha1,
        sha2::{Sha256, Sha384, Sha512},
        subtle::constant_time_eq,
        x509::{self, CertPool, PublicKey, VerifyOptions},
        x25519,
    },
    fmt::{self, Debug, Display, Formatter},
    io::{self, Read, Write},
    rand::{RngCore, rngs::OsRng},
};

/// A TLS error: why the handshake or a record failed.
///
/// It converts into an [`io::Error`] (so `?` works in functions returning
/// `io::Result`); its text is Go's message.
#[derive(Clone)]
pub struct Error {
    msg: String,
    cert: Option<x509::Error>,
    /// The transport ended between records.
    eof: bool,
    /// The alert to send the server (0: none).
    alert: u8,
}

impl Error {
    fn new(msg: &str) -> Error {
        Error {
            msg: msg.to_string(),
            cert: None,
            eof: false,
            alert: 0,
        }
    }

    fn with_alert(msg: &str, alert: u8) -> Error {
        Error {
            msg: msg.to_string(),
            cert: None,
            eof: false,
            alert,
        }
    }

    /// The certificate error, when the server's certificate was rejected.
    pub fn certificate_error(&self) -> Option<&x509::Error> {
        match &self.cert {
            Some(e) => Some(e),
            None => None,
        }
    }
}

impl Display for Error {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str(self.msg.as_str())
    }
}

impl Debug for Error {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_fmt(`tls::Error(${quote(self.msg.as_str())})`)
    }
}

fn quote(s: &str) -> String {
    `"${s}"`.to_string()
}

impl From<Error> for io::Error {
    fn from(e: Error) -> io::Error {
        io::Error::new(io::ErrorKind::Other, e.msg)
    }
}

fn io_err(e: io::Error) -> Error {
    Error::new(`tls: ${e}`.to_string().as_str())
}

/// TLS versions (native-tls's `Protocol`), for the builders'
/// `min_protocol_version` and `max_protocol_version`.
///
/// Only TLS 1.2 and 1.3 are implemented; asking for an older one as the
/// minimum means 1.2.
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum Protocol {
    /// SSL 3.0 (not implemented).
    Sslv3,
    /// TLS 1.0 (not implemented).
    Tlsv10,
    /// TLS 1.1 (not implemented).
    Tlsv11,
    /// TLS 1.2.
    Tlsv12,
    /// TLS 1.3.
    Tlsv13,
}

/// A builder of [`TlsConnector`]s (native-tls's `TlsConnectorBuilder`).
///
/// # Examples
///
/// ```no_run
/// use std::tls::{Protocol, TlsConnector};
///
/// let connector = TlsConnector::builder()
///     .min_protocol_version(Some(Protocol::Tlsv13))
///     .request_alpns(&["h2", "http/1.1"])
///     .session_cache(64)
///     .build()
///     .unwrap();
/// ```
#[derive(Clone)]
pub struct TlsConnectorBuilder {
    roots: Vec<Certificate>,
    builtin_roots: bool,
    invalid_certs: bool,
    invalid_hostnames: bool,
    sni: bool,
    alpn: Vec<String>,
    min: Option<Protocol>,
    max: Option<Protocol>,
    test_hello: Option<(Vec<u8>, Vec<u8>)>,
    test_rand: Option<Vec<u8>>,
    test_suites: Option<Vec<u16>>,
    identity: Option<Identity>,
    cache: Option<&SessionCache>,
}

impl TlsConnectorBuilder {
    /// Keeps up to capacity sessions (by server name) from the servers'
    /// tickets and resumes them, skipping the certificates and their
    /// signatures (Go's ClientSessionCache with an LRU of capacity; off by
    /// default as Go's: tickets let servers link a client's connections).
    /// Clones of the connector share the cache.
    pub fn session_cache(&mut self, capacity: usize) -> &mut TlsConnectorBuilder {
        self.cache = if capacity == 0 {
            None
        } else {
            Some(&SessionCache {
                cap: capacity,
                m: crate::sync::Mutex::new(Vec::new()),
            })
        };
        self
    }

    /// The client certificate (and key) to send when the server asks.
    pub fn identity(&mut self, identity: Identity) -> &mut TlsConnectorBuilder {
        self.identity = Some(identity);
        self
    }

    /// Trusts cert too (as a root).
    pub fn add_root_certificate(&mut self, cert: Certificate) -> &mut TlsConnectorBuilder {
        self.roots.push(cert);
        self
    }

    /// Whether to trust the system's roots (default true).
    pub fn disable_built_in_roots(&mut self, disable: bool) -> &mut TlsConnectorBuilder {
        self.builtin_roots = !disable;
        self
    }

    /// Accepts any certificate: no chain, validity or name checks. The
    /// connection is then open to anyone in the middle.
    pub fn danger_accept_invalid_certs(&mut self, accept: bool) -> &mut TlsConnectorBuilder {
        self.invalid_certs = accept;
        self
    }

    /// Accepts certificates for other names.
    pub fn danger_accept_invalid_hostnames(&mut self, accept: bool) -> &mut TlsConnectorBuilder {
        self.invalid_hostnames = accept;
        self
    }

    /// Whether to send the domain as SNI (default true; never for an IP
    /// address).
    pub fn use_sni(&mut self, sni: bool) -> &mut TlsConnectorBuilder {
        self.sni = sni;
        self
    }

    /// The application protocols to offer (ALPN), most preferred first.
    pub fn request_alpns(&mut self, protocols: &[&str]) -> &mut TlsConnectorBuilder {
        self.alpn = protocols
            .iter()
            .map(|p: &&str| -> String { p.to_string() })
            .collect();
        self
    }

    /// The oldest version to accept (None: the default).
    pub fn min_protocol_version(&mut self, p: Option<Protocol>) -> &mut TlsConnectorBuilder {
        self.min = p;
        self
    }

    /// The newest version to offer (None: the newest).
    pub fn max_protocol_version(&mut self, p: Option<Protocol>) -> &mut TlsConnectorBuilder {
        self.max = p;
        self
    }

    #[doc(hidden)]
    /// (Tests: the ClientHello message to send and its X25519 private key,
    /// as RFC 8448's traces.)
    pub fn test_client_hello(
        &mut self,
        hello: Vec<u8>,
        x25519_private: Vec<u8>,
    ) -> &mut TlsConnectorBuilder {
        self.test_hello = Some((hello, x25519_private));
        self
    }

    #[doc(hidden)]
    /// (Tests: the bytes the handshake takes its randomness from, in turn:
    /// the client random, the session ID, the key shares' private keys.)
    pub fn test_randomness(&mut self, bytes: Vec<u8>) -> &mut TlsConnectorBuilder {
        self.test_rand = Some(bytes);
        self
    }

    #[doc(hidden)]
    /// (Tests: offer only these cipher suites.)
    pub fn test_cipher_suites(&mut self, ids: &[u16]) -> &mut TlsConnectorBuilder {
        self.test_suites = Some(ids.to_vec());
        self
    }

    /// Makes the connector.
    ///
    /// # Errors
    ///
    /// An [`Error`] if the newest version allowed is older than TLS 1.2,
    /// or the versions allowed leave none.
    pub fn build(&self) -> Result<TlsConnector, Error> {
        // TLS 1.2 and 1.3 (Go's defaults).
        let v13 = match &self.max {
            None | Some(Protocol::Tlsv13) => true,
            Some(Protocol::Tlsv12) => false,
            _ => return Err(Error::new("tls: TLS 1.1 and older are not supported")),
        };
        let v12 = match &self.min {
            Some(Protocol::Tlsv13) => false,
            _ => true,
        };
        if !v13 && !v12 {
            return Err(Error::new(
                "tls: no protocol version between the minimum and the maximum",
            ));
        }
        let mut pool: Option<CertPool> = None;
        if self.builtin_roots {
            if self.roots.len() > 0 {
                let mut p = x509::system_cert_pool()
                    .map_err(|e: x509::Error| -> Error { Error::new(e.to_string().as_str()) })?;
                for c in self.roots.iter() {
                    p.add_cert(c.clone());
                }
                pool = Some(p);
            }
        } else {
            let mut p = CertPool::new();
            for c in self.roots.iter() {
                p.add_cert(c.clone());
            }
            pool = Some(p);
        }
        Ok(TlsConnector {
            b: self.clone(),
            roots: pool,
            v12,
            v13,
        })
    }
}

/// Connects TLS clients (native-tls's `TlsConnector`): it runs the
/// client's handshake over a connected stream.
///
/// Clones share the session cache.
///
/// # Examples
///
/// ```no_run
/// use std::{net::TcpStream, tls::TlsConnector};
///
/// let connector = TlsConnector::new().unwrap();
/// let stream = TcpStream::connect("example.com:443").unwrap();
/// let tls = connector.connect("example.com", stream).unwrap();
/// let cert = tls.peer_certificate().unwrap().unwrap();
/// println(cert.subject().common_name());
/// ```
#[derive(Clone)]
pub struct TlsConnector {
    b: TlsConnectorBuilder,
    /// None: the system's.
    roots: Option<CertPool>,
    /// The versions offered.
    v12: bool,
    v13: bool,
}

impl TlsConnector {
    /// Makes a connector with the defaults: the system's roots, TLS 1.2
    /// and 1.3, SNI, no session cache.
    ///
    /// # Errors
    ///
    /// None with the defaults (the `Result` is native-tls's signature).
    pub fn new() -> Result<TlsConnector, Error> {
        TlsConnector::builder().build()
    }

    /// Returns a builder of connectors with other settings.
    pub fn builder() -> TlsConnectorBuilder {
        TlsConnectorBuilder {
            roots: Vec::new(),
            builtin_roots: true,
            invalid_certs: false,
            invalid_hostnames: false,
            sni: true,
            alpn: Vec::new(),
            min: None,
            max: None,
            test_hello: None,
            test_rand: None,
            test_suites: None,
            identity: None,
            cache: None,
        }
    }

    /// Runs the handshake over `stream` (connected to `domain`'s server),
    /// checking the server's certificate for `domain`, and returns the
    /// encrypted stream. (native-tls returns a `HandshakeError` that may be
    /// `WouldBlock`; streams here block.)
    ///
    /// # Errors
    ///
    /// An [`Error`] if the handshake fails: the server's certificate is
    /// not trusted or not for `domain` ([`Error::certificate_error`] tells
    /// why), the server speaks no common version or cipher suite, or the
    /// stream fails.
    pub fn connect<S: Read + Write>(&self, domain: &str, stream: S) -> Result<TlsStream<S>, Error> {
        let mut s = TlsStream {
            conn: Conn::new(),
            stream,
        };
        let mut hs = Handshake::new(self, domain);
        let r = hs.run(&mut s.conn, &mut s.stream);
        if let Some(t) = &hs.rand {
            if s.conn.rand.is_none() {
                s.conn.rand = Some(t[hs.rand_at..].to_vec());
            }
        }
        if let Err(e) = r {
            // Tells the server why (as Go), if there is an alert for it.
            if e.alert != 0 {
                let _ = s.conn.write_record(&mut s.stream, ALERT, &[2, e.alert]);
                let _ = s.stream.flush();
            }
            return Err(e);
        }
        Ok(s)
    }
}

/// An encrypted stream over the stream `S` (native-tls's `TlsStream`):
/// reading and writing it reads and writes plaintext.
///
/// Call [`TlsStream::shutdown`] when done writing (there is no `Drop` to
/// send `close_notify`).
pub struct TlsStream<S> {
    conn: Conn,
    stream: S,
}

impl<S: Read + Write> TlsStream<S> {
    /// Returns a reference to the underlying stream.
    pub fn get_ref(&self) -> &S {
        &self.stream
    }

    /// Returns a mutable reference to the underlying stream.
    ///
    /// Reading or writing it directly corrupts the TLS stream.
    pub fn get_mut(&mut self) -> &mut S {
        &mut self.stream
    }

    /// The protocol the server chose by ALPN.
    pub fn negotiated_alpn(&self) -> Result<Option<Vec<u8>>, Error> {
        Ok(self.conn.alpn.clone())
    }

    /// The server's certificate.
    pub fn peer_certificate(&self) -> Result<Option<Certificate>, Error> {
        if self.conn.peer_certs.len() == 0 {
            return Ok(None);
        }
        Ok(Some(self.conn.peer_certs[0].clone()))
    }

    /// The server's certificates as it sent them (the leaf first).
    pub fn peer_certificates(&self) -> &[Certificate] {
        self.conn.peer_certs.as_slice()
    }

    /// Whether the handshake resumed an earlier session (Go's
    /// ConnectionState.DidResume; native-tls has none).
    pub fn did_resume(&self) -> bool {
        self.conn.resumed
    }

    /// Sends close_notify: the server sees the end of the data. Reading
    /// may go on until the server closes too.
    pub fn shutdown(&mut self) -> io::Result<()> {
        self.conn.out.lock();
        let mut r = Ok(());
        if !self.conn.closed_write {
            self.conn.closed_write = true;
            r = self.conn.write_record(&mut self.stream, ALERT, &[1, 0]);
        }
        self.conn.out.unlock();
        r
    }
}

impl<S: Read + Write> Read for TlsStream<S> {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        if buf.len() == 0 {
            return Ok(0);
        }
        while self.conn.app_pos >= self.conn.app.len() {
            if self.conn.eof {
                return Ok(0);
            }
            self.conn.read_app(&mut self.stream)?;
        }
        let n = crate::cmp::min(buf.len(), self.conn.app.len() - self.conn.app_pos);
        buf[..n].copy_from_slice(&self.conn.app[self.conn.app_pos..self.conn.app_pos + n]);
        self.conn.app_pos += n;
        Ok(n)
    }
}

impl<S: Read + Write> TlsStream<S> {
    fn write_locked(&mut self, buf: &[u8]) -> io::Result<usize> {
        if self.conn.closed_write {
            return Err(io::Error::new(
                io::ErrorKind::BrokenPipe,
                "tls: write after shutdown",
            ));
        }
        let mut at = 0;
        while at < buf.len() {
            let end = crate::cmp::min(buf.len(), at + MAX_PLAINTEXT);
            self.conn
                .write_record(&mut self.stream, APPLICATION_DATA, &buf[at..end])?;
            at = end;
        }
        Ok(buf.len())
    }
}

impl<S: Read + Write> Write for TlsStream<S> {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        self.conn.out.lock();
        let r = self.write_locked(buf);
        self.conn.out.unlock();
        r
    }

    fn flush(&mut self) -> io::Result<()> {
        self.stream.flush()
    }
}

// --- Records -----------------------------------------------------------------

const CHANGE_CIPHER_SPEC: u8 = 20;
const ALERT: u8 = 21;
const HANDSHAKE: u8 = 22;
const APPLICATION_DATA: u8 = 23;

const MAX_PLAINTEXT: usize = 16384;

#[derive(Clone)]
enum Cipher {
    Aes128(Aes128Gcm),
    Aes256(Aes256Gcm),
    ChaCha(ChaCha20Poly1305),
    /// TLS 1.2's AES-CBC with HMAC-SHA1 (MAC, then encrypt).
    Cbc128(Aes128),
    Cbc256(Aes256),
}

// One direction's keys (RFC 8446 5.3): the AEAD, the IV and the record
// number.
#[derive(Clone)]
struct HalfConn {
    cipher: Option<Cipher>,
    iv: Vec<u8>,
    seq: u64,
    secret: Vec<u8>,
    /// TLS 1.2's AES-GCM: a 4-byte IV and an explicit nonce (the record
    /// number) in each record.
    explicit: bool,
    /// TLS 1.2's CBC suites: the HMAC-SHA1 key.
    mac_key: Vec<u8>,
}

impl HalfConn {
    fn plain() -> HalfConn {
        HalfConn {
            cipher: None,
            iv: Vec::new(),
            seq: 0,
            secret: Vec::new(),
            explicit: false,
            mac_key: Vec::new(),
        }
    }

    // The record MAC of the CBC suites: HMAC-SHA1 over the AAD and data.
    fn mac12(&self, kind: u8, data: &[u8]) -> Vec<u8> {
        let mut m = Hmac::<Sha1>::new_from_slice(self.mac_key.as_slice()).unwrap();
        m.update(self.aad12(kind, data.len()).as_slice());
        m.update(data);
        m.finalize()
    }

    // TLS 1.2's nonce: the IV and the record number (explicit), or as TLS
    // 1.3's (ChaCha20-Poly1305).
    fn nonce12(&self) -> Vec<u8> {
        if !self.explicit {
            return self.nonce();
        }
        let mut n = self.iv.clone();
        n.extend_from_slice(be64(self.seq).as_slice());
        n
    }

    // TLS 1.2's additional data: the record number, type, version and
    // plaintext length.
    fn aad12(&self, kind: u8, len: usize) -> Vec<u8> {
        let mut a = be64(self.seq);
        a.push(kind);
        a.push(3);
        a.push(3);
        push16(&mut a, len);
        a
    }

    fn nonce(&self) -> Vec<u8> {
        let mut n = self.iv.clone();
        let mut i = 0;
        while i < 8 {
            n[11 - i] = n[11 - i] ^ ((self.seq >> (8 * i) as u64) as u8);
            i += 1;
        }
        n
    }
}

// The connection's state below the handshake: the record layer and the
// application data read but not returned.
struct Conn {
    read: HalfConn,
    write: HalfConn,
    suite: Suite,
    /// Handshake bytes read and not yet taken.
    hs_buf: Vec<u8>,
    /// Application data read and the position returned up to.
    app: Vec<u8>,
    app_pos: usize,
    eof: bool,
    closed_write: bool,
    alpn: Option<Vec<u8>>,
    peer_certs: Vec<Certificate>,
    /// TLS 1.2: the records' format, and the read keys the server's
    /// change_cipher_spec switches to.
    v12: bool,
    pending_read: Option<HalfConn>,
    /// The server side (its first record says TLS 1.2).
    server: bool,
    /// (Servers) the client's SNI.
    sni: Option<String>,
    /// (Tests: what is left of the fixed randomness, for CBC's IVs.)
    rand: Option<Vec<u8>>,
    /// (Clients with a session cache) the resumption master secret, the
    /// cache and the server's name, for the tickets that follow.
    res_master: Vec<u8>,
    cache: Option<&SessionCache>,
    cache_key: String,
    /// Whether the handshake resumed a session.
    resumed: bool,
    /// Held by a write after the handshake (as Go's Conn.out): a reader
    /// answering a key update writes too, while another thread may.
    out: crate::sync::Mutex<u8>,
}

fn alert_name(code: u8) -> &str {
    match code {
        0 => "close notify",
        10 => "unexpected message",
        20 => "bad record MAC",
        40 => "handshake failure",
        42 => "bad certificate",
        43 => "unsupported certificate",
        44 => "revoked certificate",
        45 => "expired certificate",
        46 => "unknown certificate",
        47 => "illegal parameter",
        48 => "unknown certificate authority",
        50 => "error decoding message",
        51 => "error decrypting message",
        70 => "protocol version not supported",
        71 => "insufficient security level",
        80 => "internal error",
        86 => "inappropriate fallback",
        90 => "user canceled",
        109 => "missing extension",
        110 => "unsupported extension",
        112 => "unrecognized name",
        116 => "certificate required",
        120 => "no application protocol",
        _ => "alert",
    }
}

impl Conn {
    fn new() -> Conn {
        Conn {
            read: HalfConn::plain(),
            write: HalfConn::plain(),
            suite: Suite::Aes128GcmSha256,
            hs_buf: Vec::new(),
            app: Vec::new(),
            app_pos: 0,
            eof: false,
            closed_write: false,
            alpn: None,
            peer_certs: Vec::new(),
            v12: false,
            pending_read: None,
            server: false,
            sni: None,
            rand: None,
            res_master: Vec::new(),
            cache: None,
            cache_key: String::new(),
            resumed: false,
            out: crate::sync::Mutex::new(0),
        }
    }

    // Writes one record of content type kind (encrypted when there are
    // keys).
    fn write_record<S: Write>(&mut self, s: &mut S, kind: u8, data: &[u8]) -> io::Result<()> {
        let mut rec: Vec<u8> = Vec::with_capacity(data.len() + 22);
        match &self.write.cipher {
            None => {
                rec.push(kind);
                // (The first ClientHello's record says TLS 1.0, as Go.)
                rec.push(3);
                rec.push(
                    if kind == HANDSHAKE && self.write.seq == 0 && !self.server {
                        1
                    } else {
                        3
                    },
                );
                push16(&mut rec, data.len());
                rec.extend_from_slice(data);
                self.write.seq += 1;
            }
            Some(c) => {
                if self.v12 && is_cbc(c) {
                    // data || MAC || padding, encrypted after a random IV.
                    let mut pt = data.to_vec();
                    pt.extend_from_slice(self.write.mac12(kind, data).as_slice());
                    let pad = 16 - pt.len() % 16;
                    let mut i = 0;
                    while i < pad {
                        pt.push((pad - 1) as u8);
                        i += 1;
                    }
                    let iv = match &self.rand {
                        Some(r) => {
                            if r.len() < 16 {
                                panic("tls: test randomness used up");
                            }
                            let v = r[..16].to_vec();
                            self.rand = Some(r[16..].to_vec());
                            v
                        }
                        None => random_bytes(16),
                    };
                    cbc_encrypt(c, iv.as_slice(), pt.as_mut_slice());
                    rec.push(kind);
                    rec.push(3);
                    rec.push(3);
                    push16(&mut rec, 16 + pt.len());
                    rec.extend_from_slice(iv.as_slice());
                    rec.extend_from_slice(pt.as_slice());
                    self.write.seq += 1;
                } else if self.v12 {
                    let mut body = data.to_vec();
                    let explicit = if self.write.explicit { 8 } else { 0 };
                    rec.push(kind);
                    rec.push(3);
                    rec.push(3);
                    push16(&mut rec, explicit + body.len() + 16);
                    if explicit > 0 {
                        rec.extend_from_slice(be64(self.write.seq).as_slice());
                    }
                    let nonce = self.write.nonce12();
                    let aad = self.write.aad12(kind, body.len());
                    let tag = seal(c, nonce.as_slice(), aad.as_slice(), body.as_mut_slice());
                    rec.extend_from_slice(body.as_slice());
                    rec.extend_from_slice(tag.as_slice());
                    self.write.seq += 1;
                } else {
                    // TLSInnerPlaintext: the data and its type, no padding.
                    let mut body = data.to_vec();
                    body.push(kind);
                    let len = body.len() + 16;
                    rec.push(APPLICATION_DATA);
                    rec.push(3);
                    rec.push(3);
                    push16(&mut rec, len);
                    let nonce = self.write.nonce();
                    let tag = seal(c, nonce.as_slice(), rec.as_slice(), body.as_mut_slice());
                    rec.extend_from_slice(body.as_slice());
                    rec.extend_from_slice(tag.as_slice());
                    self.write.seq += 1;
                }
            }
        }
        s.write_all(rec.as_slice())
    }

    // Reads one record: its content type and (decrypted) contents.
    fn read_record<S: Read>(&mut self, s: &mut S) -> Result<(u8, Vec<u8>), Error> {
        loop {
            let mut hdr = [0u8; 5];
            let n = loop {
                match s.read(&mut hdr) {
                    Ok(n) => break n,
                    Err(e) => {
                        if e.kind() != io::ErrorKind::Interrupted {
                            return Err(io_err(e));
                        }
                    }
                }
            };
            if n == 0 {
                let mut e = Error::new("tls: unexpected EOF");
                e.eof = true;
                return Err(e);
            }
            read_full(s, &mut hdr[n..])?;
            let len = ((hdr[3] as usize) << 8) | (hdr[4] as usize);
            if hdr[1] != 3 {
                return Err(Error::new(
                    "tls: first record does not look like a TLS handshake",
                ));
            }
            if len > MAX_PLAINTEXT + 256 {
                return Err(Error::new("tls: oversized record received"));
            }
            let mut body: Vec<u8> = Vec::new();
            body.resize(len, 0);
            read_full(s, body.as_mut_slice())?;
            let kind = hdr[0];
            // (Middlebox compatibility: change_cipher_spec records are
            // dropped during the handshake.)
            if kind == CHANGE_CIPHER_SPEC {
                if body.len() != 1 || body[0] != 1 {
                    return Err(Error::new("tls: unexpected change_cipher_spec"));
                }
                // (TLS 1.2: the server's next records use its keys.)
                if self.v12 {
                    match self.pending_read.take() {
                        Some(h) => self.read = h,
                        None => {
                            return Err(Error::with_alert(
                                "tls: unexpected change_cipher_spec",
                                10,
                            ));
                        }
                    }
                }
                continue;
            }
            let c = match &self.read.cipher {
                None => return Ok((kind, body)),
                Some(c) => c.clone(),
            };
            if self.v12 && is_cbc(&c) {
                // (Go's checks: whole blocks, the padding in constant time,
                // then the MAC in constant time.)
                if body.len() < 16 + 32 || body.len() % 16 != 0 {
                    return Err(Error::with_alert("tls: bad record MAC", 20));
                }
                let mut pt = body[16..].to_vec();
                cbc_decrypt(&c, &body[..16], pt.as_mut_slice());
                let n = pt.len();
                let pad = pt[n - 1] as usize;
                let mut good: u8 = if pad + 1 + 20 <= n { 1 } else { 0 };
                let check = if n < 256 { n } else { 256 };
                let mut i = 0;
                while i < check {
                    let in_pad = if i <= pad { 1u8 } else { 0u8 };
                    let same = if pt[n - 1 - i] as usize == pad {
                        1u8
                    } else {
                        0u8
                    };
                    good = good & (same | (in_pad ^ 1));
                    i += 1;
                }
                let data_len = if good == 1 { n - pad - 1 - 20 } else { n - 20 };
                let mac = self.read.mac12(kind, &pt[..data_len]);
                let mac_ok = constant_time_eq(mac.as_slice(), &pt[data_len..data_len + 20]);
                if good == 0 || !mac_ok {
                    return Err(Error::with_alert("tls: bad record MAC", 20));
                }
                self.read.seq += 1;
                pt.truncate(data_len);
                if pt.len() > MAX_PLAINTEXT {
                    return Err(Error::new("tls: oversized record received"));
                }
                return Ok((kind, pt));
            }
            if self.v12 {
                let explicit = if self.read.explicit { 8 } else { 0 };
                if body.len() < explicit + 16 {
                    return Err(Error::with_alert("tls: bad record MAC", 20));
                }
                let mut nonce = self.read.nonce12();
                if explicit > 0 {
                    nonce = self.read.iv.clone();
                    nonce.extend_from_slice(&body[..8]);
                }
                let tl = body.len() - 16;
                let tag = body[tl..].to_vec();
                let mut ct = body[explicit..tl].to_vec();
                let aad = self.read.aad12(kind, ct.len());
                if !open(
                    &c,
                    nonce.as_slice(),
                    aad.as_slice(),
                    ct.as_mut_slice(),
                    tag.as_slice(),
                ) {
                    return Err(Error::with_alert("tls: bad record MAC", 20));
                }
                self.read.seq += 1;
                if ct.len() > MAX_PLAINTEXT {
                    return Err(Error::new("tls: oversized record received"));
                }
                return Ok((kind, ct));
            }
            if kind != APPLICATION_DATA {
                return Err(Error::new(
                    `tls: unexpected unencrypted record of type ${kind}`
                        .to_string()
                        .as_str(),
                ));
            }
            if body.len() < 17 {
                return Err(Error::new("tls: bad record MAC"));
            }
            let nonce = self.read.nonce();
            let tl = body.len() - 16;
            let tag = body[tl..].to_vec();
            body.truncate(tl);
            if !open(
                &c,
                nonce.as_slice(),
                &hdr,
                body.as_mut_slice(),
                tag.as_slice(),
            ) {
                return Err(Error::new("tls: bad record MAC"));
            }
            self.read.seq += 1;
            // The type is the last non-zero byte.
            while body.len() > 0 && body[body.len() - 1] == 0 {
                body.pop();
            }
            if body.len() == 0 {
                return Err(Error::new("tls: record without a content type"));
            }
            let inner = body.pop().unwrap();
            if body.len() > MAX_PLAINTEXT {
                return Err(Error::new("tls: oversized record received"));
            }
            return Ok((inner, body));
        }
    }

    // An alert record's error (close_notify is the end of the data).
    fn alert(&mut self, body: &[u8]) -> Result<(), Error> {
        if body.len() != 2 {
            return Err(Error::new("tls: malformed alert"));
        }
        if body[1] == 0 {
            self.eof = true;
            return Ok(());
        }
        Err(Error::new(
            `remote error: tls: ${alert_name(body[1])}`
                .to_string()
                .as_str(),
        ))
    }

    // The next handshake message (type, whole message with its header).
    fn read_handshake<S: Read>(&mut self, s: &mut S) -> Result<(u8, Vec<u8>), Error> {
        loop {
            if self.hs_buf.len() >= 4 {
                let n = ((self.hs_buf[1] as usize) << 16)
                    | ((self.hs_buf[2] as usize) << 8)
                    | (self.hs_buf[3] as usize);
                if n > 65536 * 4 {
                    return Err(Error::new("tls: handshake message too large"));
                }
                if self.hs_buf.len() >= 4 + n {
                    let msg = self.hs_buf[..4 + n].to_vec();
                    self.hs_buf = self.hs_buf[4 + n..].to_vec();
                    return Ok((msg[0], msg));
                }
            }
            let (kind, body) = self.read_record(s)?;
            if kind == ALERT {
                self.alert(body.as_slice())?;
                return Err(Error::new("tls: connection closed during the handshake"));
            }
            if kind != HANDSHAKE {
                return Err(Error::new("tls: unexpected record during the handshake"));
            }
            if self.read.cipher.is_some() && body.len() == 0 {
                return Err(Error::new("tls: empty handshake record"));
            }
            self.hs_buf.extend_from_slice(body.as_slice());
        }
    }

    // Reads records until application data (or the end).
    fn read_app<S: Read + Write>(&mut self, s: &mut S) -> io::Result<()> {
        // The transport's end between records is the data's (as Go: many
        // servers close without close_notify).
        let (kind, body) = match self.read_record(s) {
            Ok(r) => r,
            Err(e) => {
                if e.eof {
                    self.eof = true;
                    return Ok(());
                }
                return Err(e.into());
            }
        };
        if kind == APPLICATION_DATA {
            self.app = body;
            self.app_pos = 0;
            return Ok(());
        }
        if kind == ALERT {
            self.alert(body.as_slice())?;
            return Ok(());
        }
        if kind != HANDSHAKE {
            return Err(Error::new("tls: unexpected record").into());
        }
        // (TLS 1.2: a HelloRequest asks for renegotiation, which Go and this
        // refuse.)
        if self.v12 {
            self.out.lock();
            let _ = self.write_record(s, ALERT, &[1, 100]);
            self.out.unlock();
            return Err(
                Error::new("tls: server requested renegotiation, which is not supported").into(),
            );
        }
        // Post-handshake messages: tickets (ignored), key updates.
        self.hs_buf.extend_from_slice(body.as_slice());
        while self.hs_buf.len() >= 4 {
            let n = ((self.hs_buf[1] as usize) << 16)
                | ((self.hs_buf[2] as usize) << 8)
                | (self.hs_buf[3] as usize);
            if self.hs_buf.len() < 4 + n {
                break;
            }
            let msg = self.hs_buf[..4 + n].to_vec();
            self.hs_buf = self.hs_buf[4 + n..].to_vec();
            if msg[0] == 24 {
                // KeyUpdate: new read keys; answer a request.
                if n != 1 || msg[4] > 1 {
                    return Err(Error::new("tls: malformed key update").into());
                }
                let next = self.suite.expand_label(
                    self.read.secret.as_slice(),
                    "traffic upd",
                    &[],
                    self.suite.hash_len(),
                );
                self.read = self.suite.half(next.as_slice());
                if msg[4] == 1 {
                    self.out.lock();
                    let mut r = Ok(());
                    if !self.closed_write {
                        r = self.write_record(s, HANDSHAKE, &[24, 0, 0, 1, 0]);
                        let wn = self.suite.expand_label(
                            self.write.secret.as_slice(),
                            "traffic upd",
                            &[],
                            self.suite.hash_len(),
                        );
                        self.write = self.suite.half(wn.as_slice());
                    }
                    self.out.unlock();
                    r?;
                }
            } else if msg[0] == 4 {
                if !self.server {
                    self.new_session_ticket(&msg[4..])?;
                }
            } else {
                return Err(
                    Error::new("tls: unexpected handshake message after the handshake").into(),
                );
            }
        }
        Ok(())
    }
}

impl Conn {
    // A NewSessionTicket: kept in the session cache, if any (as Go's
    // handleNewSessionTicket; lifetime 0 drops the session).
    fn new_session_ticket(&mut self, body: &[u8]) -> Result<(), Error> {
        let cache = match self.cache {
            Some(c) => c,
            None => return Ok(()),
        };
        let mut m = Msg::new(body);
        let lifetime = read_be(m.bytes(4)?.as_slice());
        let age_add = read_be(m.bytes(4)?.as_slice()) as u32;
        let nonce = m.vec8()?;
        let ticket = m.vec16()?;
        m.vec16()?;
        if m.left() != 0 || ticket.len() == 0 {
            return Err(Error::new("tls: invalid NewSessionTicket message"));
        }
        if lifetime == 0 {
            cache.remove(self.cache_key.as_str());
            return Ok(());
        }
        let lifetime = if lifetime > TICKET_LIFETIME {
            TICKET_LIFETIME
        } else {
            lifetime
        };
        let psk = self.suite.expand_label(
            self.res_master.as_slice(),
            "resumption",
            nonce.as_slice(),
            self.suite.hash_len(),
        );
        let sess = ClientSession {
            version: 0x0304,
            ems: false,
            suite: self.suite.id(),
            psk,
            ticket,
            age_add,
            received_ms: now_ms(),
            lifetime,
            certs: self.peer_certs.clone(),
        };
        cache.put(self.cache_key.as_str(), sess);
        Ok(())
    }
}

fn read_full<S: Read>(s: &mut S, buf: &mut [u8]) -> Result<(), Error> {
    let mut at = 0;
    while at < buf.len() {
        let n = match s.read(&mut buf[at..]) {
            Ok(n) => n,
            Err(e) => {
                if e.kind() == io::ErrorKind::Interrupted {
                    continue;
                }
                return Err(io_err(e));
            }
        };
        if n == 0 {
            return Err(Error::new("tls: unexpected EOF"));
        }
        at += n;
    }
    Ok(())
}

fn seal(c: &Cipher, nonce: &[u8], aad: &[u8], buf: &mut [u8]) -> Vec<u8> {
    let r = match c {
        Cipher::Aes128(k) => k.encrypt_in_place_detached(nonce, aad, buf),
        Cipher::Aes256(k) => k.encrypt_in_place_detached(nonce, aad, buf),
        Cipher::ChaCha(k) => k.encrypt_in_place_detached(nonce, aad, buf),
        _ => panic("tls: seal with a CBC cipher"),
    };
    r.unwrap()
}

fn open(c: &Cipher, nonce: &[u8], aad: &[u8], buf: &mut [u8], tag: &[u8]) -> bool {
    let r = match c {
        Cipher::Aes128(k) => k.decrypt_in_place_detached(nonce, aad, buf, tag),
        Cipher::Aes256(k) => k.decrypt_in_place_detached(nonce, aad, buf, tag),
        Cipher::ChaCha(k) => k.decrypt_in_place_detached(nonce, aad, buf, tag),
        _ => return false,
    };
    r.is_ok()
}

fn is_cbc(c: &Cipher) -> bool {
    match c {
        Cipher::Cbc128(_) | Cipher::Cbc256(_) => true,
        _ => false,
    }
}

// AES-CBC over whole blocks, in place.
fn cbc_encrypt(c: &Cipher, iv: &[u8], buf: &mut [u8]) {
    let mut prev = iv.to_vec();
    let mut at = 0;
    while at < buf.len() {
        let mut i = 0;
        while i < 16 {
            buf[at + i] = buf[at + i] ^ prev[i];
            i += 1;
        }
        match c {
            Cipher::Cbc128(k) => k.encrypt_block(&mut buf[at..at + 16]),
            Cipher::Cbc256(k) => k.encrypt_block(&mut buf[at..at + 16]),
            _ => {}
        }
        prev = buf[at..at + 16].to_vec();
        at += 16;
    }
}

fn cbc_decrypt(c: &Cipher, iv: &[u8], buf: &mut [u8]) {
    let mut prev = iv.to_vec();
    let mut at = 0;
    while at < buf.len() {
        let ct = buf[at..at + 16].to_vec();
        match c {
            Cipher::Cbc128(k) => k.decrypt_block(&mut buf[at..at + 16]),
            Cipher::Cbc256(k) => k.decrypt_block(&mut buf[at..at + 16]),
            _ => {}
        }
        let mut i = 0;
        while i < 16 {
            buf[at + i] = buf[at + i] ^ prev[i];
            i += 1;
        }
        prev = ct;
        at += 16;
    }
}

fn be64(v: u64) -> Vec<u8> {
    let mut b: Vec<u8> = Vec::new();
    let mut i = 8;
    while i > 0 {
        i -= 1;
        b.push((v >> (8 * i) as u64) as u8);
    }
    b
}

fn push16(b: &mut Vec<u8>, v: usize) {
    b.push((v >> 8) as u8);
    b.push(v as u8);
}

fn push24(b: &mut Vec<u8>, v: usize) {
    b.push((v >> 16) as u8);
    b.push((v >> 8) as u8);
    b.push(v as u8);
}

// --- Cipher suites and the key schedule (RFC 8446 7.1) -----------------------

#[derive(Clone, PartialEq)]
enum Suite {
    Aes128GcmSha256,
    Aes256GcmSha384,
    ChaCha20Poly1305Sha256,
}

impl Suite {
    fn id(&self) -> u16 {
        match self {
            Suite::Aes128GcmSha256 => 0x1301,
            Suite::Aes256GcmSha384 => 0x1302,
            Suite::ChaCha20Poly1305Sha256 => 0x1303,
        }
    }

    fn of(id: u16) -> Option<Suite> {
        if id == 0x1301 {
            return Some(Suite::Aes128GcmSha256);
        }
        if id == 0x1302 {
            return Some(Suite::Aes256GcmSha384);
        }
        if id == 0x1303 {
            return Some(Suite::ChaCha20Poly1305Sha256);
        }
        None
    }

    fn sha384(&self) -> bool {
        *self == Suite::Aes256GcmSha384
    }

    fn hash_len(&self) -> usize {
        if self.sha384() { 48 } else { 32 }
    }

    fn hash(&self, b: &[u8]) -> Vec<u8> {
        if self.sha384() {
            Sha384::digest(b)
        } else {
            Sha256::digest(b)
        }
    }

    fn hmac(&self, key: &[u8], data: &[u8]) -> Vec<u8> {
        if self.sha384() {
            let mut m = Hmac::<Sha384>::new_from_slice(key).unwrap();
            m.update(data);
            m.finalize()
        } else {
            let mut m = Hmac::<Sha256>::new_from_slice(key).unwrap();
            m.update(data);
            m.finalize()
        }
    }

    fn extract(&self, salt: &[u8], ikm: &[u8]) -> Vec<u8> {
        if self.sha384() {
            Hkdf::<Sha384>::extract(Some(salt), ikm).0
        } else {
            Hkdf::<Sha256>::extract(Some(salt), ikm).0
        }
    }

    // HKDF-Expand-Label(secret, label, context, length).
    fn expand_label(&self, secret: &[u8], label: &str, context: &[u8], len: usize) -> Vec<u8> {
        let mut info: Vec<u8> = Vec::new();
        push16(&mut info, len);
        info.push((6 + label.len()) as u8);
        info.extend_from_slice(b"tls13 ");
        info.extend_from_slice(label.as_bytes());
        info.push(context.len() as u8);
        info.extend_from_slice(context);
        let mut out: Vec<u8> = Vec::new();
        out.resize(len, 0);
        if self.sha384() {
            Hkdf::<Sha384>::from_prk(secret)
                .unwrap()
                .expand(info.as_slice(), out.as_mut_slice())
                .unwrap();
        } else {
            Hkdf::<Sha256>::from_prk(secret)
                .unwrap()
                .expand(info.as_slice(), out.as_mut_slice())
                .unwrap();
        }
        out
    }

    // Derive-Secret(secret, label, messages) of the transcript's hash.
    fn derive(&self, secret: &[u8], label: &str, transcript: &[u8]) -> Vec<u8> {
        let h = self.hash(transcript);
        self.expand_label(secret, label, h.as_slice(), self.hash_len())
    }

    // The keys of a traffic secret.
    fn half(&self, secret: &[u8]) -> HalfConn {
        let key_len = if *self == Suite::Aes128GcmSha256 {
            16
        } else {
            32
        };
        let key = self.expand_label(secret, "key", &[], key_len);
        let iv = self.expand_label(secret, "iv", &[], 12);
        let cipher = match self {
            Suite::Aes128GcmSha256 => {
                Cipher::Aes128(Aes128Gcm::new_from_slice(key.as_slice()).unwrap())
            }
            Suite::Aes256GcmSha384 => {
                Cipher::Aes256(Aes256Gcm::new_from_slice(key.as_slice()).unwrap())
            }
            Suite::ChaCha20Poly1305Sha256 => {
                Cipher::ChaCha(ChaCha20Poly1305::new_from_slice(key.as_slice()).unwrap())
            }
        };
        HalfConn {
            cipher: Some(cipher),
            iv,
            seq: 0,
            secret: secret.to_vec(),
            explicit: false,
            mac_key: Vec::new(),
        }
    }
}

// --- The client handshake (RFC 8446 4, Go's handshake_client_tls13.go) -------

const X25519: u16 = 0x001d;
const SECP256R1: u16 = 0x0017;
const SECP384R1: u16 = 0x0018;

// SHA-256("HelloRetryRequest"): a ServerHello with this random is one.
const HRR_RANDOM: [u8; 32] = [
    0xcf, 0x21, 0xad, 0x74, 0xe5, 0x9a, 0x61, 0x11, 0xbe, 0x1d, 0x8c, 0x02, 0x1e, 0x65, 0xb8, 0x91,
    0xc2, 0xa2, 0x11, 0x16, 0x7a, 0xbb, 0x8c, 0x5e, 0x07, 0x9e, 0x09, 0xe2, 0xc8, 0xa8, 0x33, 0x9c,
];

// The signature schemes offered (and accepted in CertificateVerify, but
// for the PKCS#1 ones, which only certificates may use).
const SIG_SCHEMES: [u16; 9] = [
    0x0403, 0x0503, 0x0807, 0x0804, 0x0805, 0x0806, 0x0401, 0x0501, 0x0601,
];

// A key share: the group and its private key.
#[derive(Clone)]
enum KeyShare {
    X25519(Vec<u8>),
    P256(p256::ecdh::EphemeralSecret),
    P384(p384::ecdh::EphemeralSecret),
}

impl KeyShare {
    // The share of group with a private key of random bytes (None when
    // they are not a valid scalar: try others).
    fn of(group: u16, k: &[u8]) -> Option<KeyShare> {
        if group == SECP256R1 {
            return match p256::ecdh::EphemeralSecret::from_bytes(k) {
                Ok(s) => Some(KeyShare::P256(s)),
                Err(_) => None,
            };
        }
        if group == SECP384R1 {
            return match p384::ecdh::EphemeralSecret::from_bytes(k) {
                Ok(s) => Some(KeyShare::P384(s)),
                Err(_) => None,
            };
        }
        Some(KeyShare::X25519(k.to_vec()))
    }

    fn private_len(group: u16) -> usize {
        if group == SECP384R1 { 48 } else { 32 }
    }

    fn group(&self) -> u16 {
        match self {
            KeyShare::X25519(_) => X25519,
            KeyShare::P256(_) => SECP256R1,
            KeyShare::P384(_) => SECP384R1,
        }
    }

    fn public(&self) -> Vec<u8> {
        match self {
            KeyShare::X25519(k) => {
                x25519::PublicKey::from(&x25519::StaticSecret::from_bytes(k.as_slice()))
                    .to_bytes()
                    .to_vec()
            }
            KeyShare::P256(k) => k.public_key().to_sec1_bytes(),
            KeyShare::P384(k) => k.public_key().to_sec1_bytes(),
        }
    }

    // The shared secret with the server's share.
    fn shared(&self, peer: &[u8]) -> Result<Vec<u8>, Error> {
        let bad = Error::new("tls: invalid server key share");
        match self {
            KeyShare::X25519(k) => {
                if peer.len() != 32 {
                    return Err(bad);
                }
                let s = x25519::StaticSecret::from_bytes(k.as_slice())
                    .diffie_hellman(&x25519::PublicKey::from_bytes(peer));
                let b = s.as_bytes().to_vec();
                let mut zero = true;
                for x in b.iter() {
                    if *x != 0 {
                        zero = false;
                    }
                }
                if zero {
                    return Err(bad);
                }
                Ok(b)
            }
            KeyShare::P256(k) => {
                let p = p256::ecdh::PublicKey::from_sec1_bytes(peer).map_err(
                    |_e: crate::crypto::ec::Error| -> Error {
                        Error::new("tls: invalid server key share")
                    },
                )?;
                Ok(k.diffie_hellman(&p).raw_secret_bytes().to_vec())
            }
            KeyShare::P384(k) => {
                let p = p384::ecdh::PublicKey::from_sec1_bytes(peer).map_err(
                    |_e: crate::crypto::ec::Error| -> Error {
                        Error::new("tls: invalid server key share")
                    },
                )?;
                Ok(k.diffie_hellman(&p).raw_secret_bytes().to_vec())
            }
        }
    }
}

// A cursor over handshake message bytes (as Go's cryptobyte for TLS).
struct Msg {
    b: Vec<u8>,
    at: usize,
}

impl Msg {
    fn new(b: &[u8]) -> Msg {
        Msg {
            b: b.to_vec(),
            at: 0,
        }
    }

    fn left(&self) -> usize {
        self.b.len() - self.at
    }

    fn u8(&mut self) -> Result<u8, Error> {
        if self.left() < 1 {
            return Err(decode_error());
        }
        self.at += 1;
        Ok(self.b[self.at - 1])
    }

    fn u16(&mut self) -> Result<usize, Error> {
        if self.left() < 2 {
            return Err(decode_error());
        }
        self.at += 2;
        Ok(((self.b[self.at - 2] as usize) << 8) | (self.b[self.at - 1] as usize))
    }

    fn u24(&mut self) -> Result<usize, Error> {
        if self.left() < 3 {
            return Err(decode_error());
        }
        self.at += 3;
        Ok(((self.b[self.at - 3] as usize) << 16)
            | ((self.b[self.at - 2] as usize) << 8)
            | (self.b[self.at - 1] as usize))
    }

    fn bytes(&mut self, n: usize) -> Result<Vec<u8>, Error> {
        if self.left() < n {
            return Err(decode_error());
        }
        self.at += n;
        Ok(self.b[self.at - n..self.at].to_vec())
    }

    // A vector with a length prefix of 1, 2 or 3 bytes.
    fn vec8(&mut self) -> Result<Vec<u8>, Error> {
        let n = self.u8()? as usize;
        self.bytes(n)
    }

    fn vec16(&mut self) -> Result<Vec<u8>, Error> {
        let n = self.u16()?;
        self.bytes(n)
    }

    fn vec24(&mut self) -> Result<Vec<u8>, Error> {
        let n = self.u24()?;
        self.bytes(n)
    }
}

fn decode_error() -> Error {
    Error::with_alert("tls: error decoding message", 50)
}

// The extensions of a vector: (type, data).
fn extensions(b: &[u8]) -> Result<Vec<(usize, Vec<u8>)>, Error> {
    let mut m = Msg::new(b);
    let mut out: Vec<(usize, Vec<u8>)> = Vec::new();
    while m.left() > 0 {
        let t = m.u16()?;
        let d = m.vec16()?;
        for e in out.iter() {
            if e.0 == t {
                return Err(Error::new("tls: duplicate extension"));
            }
        }
        out.push((t, d));
    }
    Ok(out)
}

fn ext_of(exts: &[(usize, Vec<u8>)], t: usize) -> Option<Vec<u8>> {
    for e in exts.iter() {
        if e.0 == t {
            return Some(e.1.clone());
        }
    }
    None
}

fn is_ip(host: &str) -> bool {
    host.parse::<crate::net::IpAddr>().is_ok()
}

fn random_bytes(n: usize) -> Vec<u8> {
    let mut b: Vec<u8> = Vec::new();
    b.resize(n, 0);
    OsRng.fill_bytes(b.as_mut_slice());
    b
}

// --- Session resumption (TLS 1.3 tickets) ------------------------------------

// A ticket's lifetime (Go's maxSessionTicketLifetime: 7 days).
const TICKET_LIFETIME: u64 = 604800;

// A session a client can resume: the server's ticket and what it stands for.
#[derive(Clone)]
struct ClientSession {
    /// 0x0304 (a PSK) or 0x0303 (a master secret, and whether it is an
    /// extended one).
    version: u16,
    ems: bool,
    suite: u16,
    /// The resumption PSK, or TLS 1.2's master secret.
    psk: Vec<u8>,
    ticket: Vec<u8>,
    age_add: u32,
    /// When it was received, and for how long it may be used (seconds).
    received_ms: u64,
    lifetime: u64,
    certs: Vec<Certificate>,
}

// The sessions by server name, least recently used first.
struct SessionCache {
    cap: usize,
    m: crate::sync::Mutex<Vec<(String, ClientSession)>>,
}

impl SessionCache {
    fn get(&self, key: &str) -> Option<ClientSession> {
        let v = self.m.lock();
        let mut found: Option<ClientSession> = None;
        for e in v.iter() {
            if e.0 == key {
                found = Some(e.1.clone());
            }
        }
        self.m.unlock();
        found
    }

    fn put(&self, key: &str, sess: ClientSession) {
        let v = self.m.lock();
        let mut i = 0;
        while i < v.len() {
            if v[i].0 == key {
                v.remove(i);
            } else {
                i += 1;
            }
        }
        v.push((key.to_string(), sess));
        while v.len() > self.cap {
            v.remove(0);
        }
        self.m.unlock();
    }

    fn remove(&self, key: &str) {
        let v = self.m.lock();
        let mut i = 0;
        while i < v.len() {
            if v[i].0 == key {
                v.remove(i);
            } else {
                i += 1;
            }
        }
        self.m.unlock();
    }
}

fn now_ms() -> u64 {
    match crate::time::SystemTime::now().duration_since(crate::time::UNIX_EPOCH) {
        Ok(d) => d.as_millis() as u64,
        Err(_) => 0,
    }
}

fn be32(v: u32) -> Vec<u8> {
    vec_of(&[(v >> 24) as u8, (v >> 16) as u8, (v >> 8) as u8, v as u8])
}

fn read_be(b: &[u8]) -> u64 {
    let mut v = 0u64;
    for x in b.iter() {
        v = (v << 8) | (*x as u64);
    }
    v
}

// The PSK binder of a ClientHello truncated before its binders, after the
// transcript prefix (RFC 8446 4.2.11.2).
fn psk_binder(suite: &Suite, psk: &[u8], prefix: &[u8], truncated: &[u8]) -> Vec<u8> {
    let zeros = vec_zero(suite.hash_len());
    let early = suite.extract(zeros.as_slice(), psk);
    let binder_key = suite.derive(early.as_slice(), "res binder", &[]);
    let fk = suite.expand_label(binder_key.as_slice(), "finished", &[], suite.hash_len());
    let mut t = prefix.to_vec();
    t.extend_from_slice(truncated);
    suite.hmac(fk.as_slice(), suite.hash(t.as_slice()).as_slice())
}

// A session a server resumes: what its ticket holds (TLS 1.2: the master
// secret as the psk, and whether it is an extended one).
struct ServerSession {
    version: u16,
    ems: bool,
    suite: u16,
    created: u64,
    psk: Vec<u8>,
    certs: Vec<Certificate>,
}

// A ticket: the session sealed with key (AES-256-GCM: nonce, ciphertext,
// tag). The plaintext: version, suite, creation time, PSK, the client's
// certificates.
fn seal_ticket(key: &[u8], sess: &ServerSession) -> Vec<u8> {
    let mut pt: Vec<u8> = Vec::new();
    push16(&mut pt, sess.version as usize);
    push16(&mut pt, sess.suite as usize);
    pt.extend_from_slice(be64(sess.created).as_slice());
    pt.push(sess.psk.len() as u8);
    pt.extend_from_slice(sess.psk.as_slice());
    if sess.version == 0x0303 {
        pt.push(sess.ems as u8);
    }
    push16(&mut pt, sess.certs.len());
    for c in sess.certs.iter() {
        push24(&mut pt, c.raw().len());
        pt.extend_from_slice(c.raw());
    }
    let nonce = random_bytes(12);
    let tag = Aes256Gcm::new_from_slice(key)
        .unwrap()
        .encrypt_in_place_detached(nonce.as_slice(), &[], pt.as_mut_slice())
        .unwrap();
    let mut out = nonce;
    out.extend_from_slice(pt.as_slice());
    out.extend_from_slice(tag.as_slice());
    out
}

// The session of a ticket sealed with key, if it opens and parses.
fn open_ticket(key: &[u8], t: &[u8]) -> Option<ServerSession> {
    if t.len() < 12 + 16 {
        return None;
    }
    let mut pt = t[12..t.len() - 16].to_vec();
    if Aes256Gcm::new_from_slice(key)
        .unwrap()
        .decrypt_in_place_detached(&t[..12], &[], pt.as_mut_slice(), &t[t.len() - 16..])
        .is_err()
    {
        return None;
    }
    let mut m = Msg::new(pt.as_slice());
    let version = m.u16().ok()? as u16;
    if version != 0x0304 && version != 0x0303 {
        return None;
    }
    let suite = m.u16().ok()? as u16;
    let created = read_be(m.bytes(8).ok()?.as_slice());
    let psk = m.vec8().ok()?;
    let ems = if version == 0x0303 {
        m.u8().ok()? == 1
    } else {
        false
    };
    let n = m.u16().ok()?;
    let mut certs: Vec<Certificate> = Vec::new();
    let mut i = 0;
    while i < n {
        certs.push(Certificate::from_der(m.vec24().ok()?.as_slice()).ok()?);
        i += 1;
    }
    if m.left() != 0 {
        return None;
    }
    if version == 0x0304 && Suite::of(suite).is_none() {
        return None;
    }
    Some(ServerSession {
        version,
        ems,
        suite,
        created,
        psk,
        certs,
    })
}

struct Handshake {
    c: TlsConnector,
    domain: String,
    random: Vec<u8>,
    session_id: Vec<u8>,
    suites: Vec<Suite>,
    share: KeyShare,
    /// The handshake messages so far (hashed when needed).
    transcript: Vec<u8>,
    hello: Vec<u8>,
    /// TLS 1.2's suites offered.
    suites12: Vec<Suite12>,
    /// (Tests: the randomness and how much is taken.)
    rand: Option<Vec<u8>>,
    rand_at: usize,
    /// The session offered for resumption.
    resume: Option<ClientSession>,
}

impl Handshake {
    fn new(c: &TlsConnector, domain: &str) -> Handshake {
        // AES first when the CPU has instructions for it (as Go; always in
        // tests, whose ClientHello is fixed).
        let aes_first = crate::crypto::aes::has_hardware() || c.b.test_rand.is_some();
        let mut suites: Vec<Suite> = Vec::new();
        if !c.v13 {
        } else if aes_first {
            suites.push(Suite::Aes128GcmSha256);
            suites.push(Suite::Aes256GcmSha384);
            suites.push(Suite::ChaCha20Poly1305Sha256);
        } else {
            suites.push(Suite::ChaCha20Poly1305Sha256);
            suites.push(Suite::Aes128GcmSha256);
            suites.push(Suite::Aes256GcmSha384);
        }
        let mut suites12 = if c.v12 {
            suites12(aes_first)
        } else {
            Vec::new()
        };
        if let Some(only) = &c.b.test_suites {
            suites = suites
                .iter()
                .filter(|x: &&Suite| -> bool { only.contains(&x.id()) })
                .map(|x: &Suite| -> Suite { x.clone() })
                .collect();
            suites12 = suites12
                .iter()
                .filter(|x: &&Suite12| -> bool { only.contains(&x.id) })
                .map(|x: &Suite12| -> Suite12 { x.clone() })
                .collect();
        }
        let mut h = Handshake {
            c: c.clone(),
            domain: domain.to_string(),
            random: Vec::new(),
            session_id: Vec::new(),
            suites,
            share: KeyShare::X25519(Vec::new()),
            transcript: Vec::new(),
            hello: Vec::new(),
            suites12,
            rand: c.b.test_rand.clone(),
            rand_at: 0,
            resume: None,
        };
        // A cached session for this name, if TLS 1.3, its suite offered
        // and not expired.
        if let Some(cache) = c.b.cache {
            if let Some(sess) = cache.get(domain) {
                let mut offered = false;
                if sess.version == 0x0304 {
                    for x in h.suites.iter() {
                        if x.id() == sess.suite {
                            offered = true;
                        }
                    }
                } else {
                    for x in h.suites12.iter() {
                        if x.id == sess.suite {
                            offered = true;
                        }
                    }
                }
                if offered && now_ms() < sess.received_ms + 1000 * sess.lifetime {
                    h.resume = Some(sess);
                } else {
                    cache.remove(domain);
                }
            }
        }
        h.random = h.random_bytes(32);
        h.session_id = h.random_bytes(32);
        h.share = h.new_share(X25519);
        h
    }

    fn random_bytes(&mut self, n: usize) -> Vec<u8> {
        match &self.rand {
            None => random_bytes(n),
            Some(r) => {
                if self.rand_at + n > r.len() {
                    panic("tls: test randomness used up");
                }
                self.rand_at += n;
                r[self.rand_at - n..self.rand_at].to_vec()
            }
        }
    }

    // A new key share for group.
    fn new_share(&mut self, group: u16) -> KeyShare {
        loop {
            let k = self.random_bytes(KeyShare::private_len(group));
            if let Some(ks) = KeyShare::of(group, k.as_slice()) {
                return ks;
            }
        }
    }

    // The ClientHello message (with its header), for the current share and
    // (after a HelloRetryRequest) the server's cookie.
    fn client_hello(&self, cookie: &Option<Vec<u8>>) -> Vec<u8> {
        let mut b: Vec<u8> = Vec::new();
        b.push(3);
        b.push(3);
        b.extend_from_slice(self.random.as_slice());
        b.push(self.session_id.len() as u8);
        b.extend_from_slice(self.session_id.as_slice());
        push16(&mut b, 2 * (self.suites.len() + self.suites12.len()));
        for s in self.suites.iter() {
            push16(&mut b, s.id() as usize);
        }
        for s in self.suites12.iter() {
            push16(&mut b, s.id as usize);
        }
        b.push(1);
        b.push(0);
        let mut ext: Vec<u8> = Vec::new();
        // server_name
        if self.c.b.sni && self.domain.len() > 0 && !is_ip(self.domain.as_str()) {
            let name = if self.domain.ends_with(".") {
                &self.domain[..self.domain.len() - 1]
            } else {
                self.domain.as_str()
            };
            push16(&mut ext, 0);
            push16(&mut ext, name.len() + 5);
            push16(&mut ext, name.len() + 3);
            ext.push(0);
            push16(&mut ext, name.len());
            ext.extend_from_slice(name.as_bytes());
        }
        // supported_groups
        push16(&mut ext, 10);
        push16(&mut ext, 8);
        push16(&mut ext, 6);
        push16(&mut ext, X25519 as usize);
        push16(&mut ext, SECP256R1 as usize);
        push16(&mut ext, SECP384R1 as usize);
        // signature_algorithms
        push16(&mut ext, 13);
        push16(&mut ext, 2 + 2 * SIG_SCHEMES.len());
        push16(&mut ext, 2 * SIG_SCHEMES.len());
        for s in SIG_SCHEMES.iter() {
            push16(&mut ext, *s as usize);
        }
        // application_layer_protocol_negotiation
        if self.c.b.alpn.len() > 0 {
            let mut list: Vec<u8> = Vec::new();
            for p in self.c.b.alpn.iter() {
                list.push(p.len() as u8);
                list.extend_from_slice(p.as_bytes());
            }
            push16(&mut ext, 16);
            push16(&mut ext, list.len() + 2);
            push16(&mut ext, list.len());
            ext.extend_from_slice(list.as_slice());
        }
        if self.c.v12 {
            // ec_point_formats: uncompressed; extended_master_secret;
            // renegotiation_info (empty: none is supported).
            push16(&mut ext, 11);
            push16(&mut ext, 2);
            ext.push(1);
            ext.push(0);
            push16(&mut ext, 23);
            push16(&mut ext, 0);
            push16(&mut ext, 0xff01);
            push16(&mut ext, 1);
            ext.push(0);
            // session_ticket, with a cache: a TLS 1.2 session's ticket, else
            // empty (asking for one).
            if self.c.b.cache.is_some() {
                let empty: Vec<u8> = Vec::new();
                let t = match &self.resume {
                    Some(x) => {
                        if x.version == 0x0303 {
                            x.ticket.clone()
                        } else {
                            empty
                        }
                    }
                    None => empty,
                };
                push16(&mut ext, 35);
                push16(&mut ext, t.len());
                ext.extend_from_slice(t.as_slice());
            }
        }
        if !self.c.v13 {
            push16(&mut b, ext.len());
            b.extend_from_slice(ext.as_slice());
            let mut msg: Vec<u8> = vec_of(&[1]);
            push24(&mut msg, b.len());
            msg.extend_from_slice(b.as_slice());
            return msg;
        }
        // supported_versions: TLS 1.3 (and 1.2)
        push16(&mut ext, 43);
        if self.c.v12 {
            push16(&mut ext, 5);
            ext.push(4);
            push16(&mut ext, 0x0304);
            push16(&mut ext, 0x0303);
        } else {
            push16(&mut ext, 3);
            ext.push(2);
            push16(&mut ext, 0x0304);
        }
        // psk_key_exchange_modes: psk_dhe_ke (as Go; no tickets are used)
        push16(&mut ext, 45);
        push16(&mut ext, 2);
        ext.push(1);
        ext.push(1);
        // cookie
        if let Some(ck) = cookie {
            push16(&mut ext, 44);
            push16(&mut ext, ck.len() + 2);
            push16(&mut ext, ck.len());
            ext.extend_from_slice(ck.as_slice());
        }
        // key_share
        let public = self.share.public();
        push16(&mut ext, 51);
        push16(&mut ext, public.len() + 6);
        push16(&mut ext, public.len() + 4);
        push16(&mut ext, self.share.group() as usize);
        push16(&mut ext, public.len());
        ext.extend_from_slice(public.as_slice());
        // pre_shared_key (last): the ticket, its obfuscated age, and a
        // binder filled in below.
        let mut psk_suite: Option<Suite> = None;
        if let Some(sess) = &self
            .resume
            .as_ref()
            .filter(|x: &&ClientSession| -> bool { x.version == 0x0304 })
        {
            let suite = Suite::of(sess.suite).unwrap();
            let age = ((now_ms() - sess.received_ms) as u32).wrapping_add(sess.age_add);
            let hl = suite.hash_len();
            push16(&mut ext, 41);
            push16(&mut ext, 2 + 2 + sess.ticket.len() + 4 + 2 + 1 + hl);
            push16(&mut ext, 2 + sess.ticket.len() + 4);
            push16(&mut ext, sess.ticket.len());
            ext.extend_from_slice(sess.ticket.as_slice());
            ext.extend_from_slice(be32(age).as_slice());
            push16(&mut ext, 1 + hl);
            ext.push(hl as u8);
            ext.resize(ext.len() + hl, 0);
            psk_suite = Some(suite);
        }
        push16(&mut b, ext.len());
        b.extend_from_slice(ext.as_slice());
        let mut msg: Vec<u8> = Vec::new();
        msg.push(1);
        push24(&mut msg, b.len());
        msg.extend_from_slice(b.as_slice());
        if let Some(suite) = psk_suite {
            // (After a HelloRetryRequest the transcript so far precedes it.)
            let prefix: Vec<u8> = if cookie.is_some() || self.transcript.len() > 0 {
                self.transcript.clone()
            } else {
                Vec::new()
            };
            let cut = msg.len() - (3 + suite.hash_len());
            let binder = psk_binder(
                &suite,
                self.resume.as_ref().unwrap().psk.as_slice(),
                prefix.as_slice(),
                &msg[..cut],
            );
            let n = msg.len();
            msg[n - binder.len()..].copy_from_slice(binder.as_slice());
        }
        msg
    }

    fn run<S: Read + Write>(&mut self, conn: &mut Conn, s: &mut S) -> Result<(), Error> {
        let mut x25519_test = false;
        match &self.c.b.test_hello {
            Some((hello, private)) => {
                self.hello = hello.clone();
                self.share = KeyShare::X25519(private.clone());
                x25519_test = true;
                // (The trace's session ID, for its echo.)
                let mut m = Msg::new(&hello[4..]);
                m.bytes(34)?;
                self.session_id = m.vec8()?;
            }
            None => self.hello = self.client_hello(&None),
        }
        conn.write_record(s, HANDSHAKE, self.hello.as_slice())
            .map_err(io_err)?;
        self.transcript.extend_from_slice(self.hello.as_slice());
        let (t, mut sh) = conn.read_handshake(s)?;
        if t != 2 {
            return Err(Error::new(
                "tls: received unexpected handshake message instead of ServerHello",
            ));
        }
        let mut sent_ccs = false;
        if sh.len() >= 38 && &sh[6..38] == HRR_RANDOM.as_slice() {
            if x25519_test {
                return Err(Error::new("tls: HelloRetryRequest in a test trace"));
            }
            // HelloRetryRequest: the transcript starts with the first
            // ClientHello's hash; then a ClientHello for the group asked for.
            let (group, cookie) = self.retry_request(&sh)?;
            let hrr_suite = Suite::of(self.selected_suite(&sh)?).unwrap();
            if let Some(sess) = &self.resume {
                if sess.version != 0x0304
                    || Suite::of(sess.suite).unwrap().hash_len() != hrr_suite.hash_len()
                {
                    self.resume = None;
                }
            }
            let h = hrr_suite.hash(self.transcript.as_slice());
            let mut t2: Vec<u8> = vec_of(&[254, 0, 0, h.len() as u8]);
            t2.extend_from_slice(h.as_slice());
            t2.extend_from_slice(sh.as_slice());
            self.transcript = t2;
            self.share = self.new_share(group);
            self.hello = self.client_hello(&cookie);
            conn.write_record(s, CHANGE_CIPHER_SPEC, &[1])
                .map_err(io_err)?;
            sent_ccs = true;
            conn.write_record(s, HANDSHAKE, self.hello.as_slice())
                .map_err(io_err)?;
            self.transcript.extend_from_slice(self.hello.as_slice());
            let (t3, sh2) = conn.read_handshake(s)?;
            if t3 != 2 {
                return Err(Error::new(
                    "tls: received unexpected handshake message instead of ServerHello",
                ));
            }
            if sh2.len() >= 38 && &sh2[6..38] == HRR_RANDOM.as_slice() {
                return Err(Error::new(
                    "tls: server sent two HelloRetryRequest messages",
                ));
            }
            sh = sh2;
        }
        // TLS 1.2 when the server says so (no supported_versions).
        if !is_tls13(&sh)? {
            if !self.c.v12 {
                return Err(Error::with_alert(
                    "tls: server selected an unsupported protocol version",
                    70,
                ));
            }
            if x25519_test {
                return Err(Error::new("tls: TLS 1.2 in a TLS 1.3 test trace"));
            }
            return self.run12(conn, s, sh);
        }
        if !self.c.v13 {
            return Err(Error::with_alert(
                "tls: server selected an unsupported protocol version",
                70,
            ));
        }
        let shared = self.server_hello(&sh)?;
        let suite = Suite::of(self.selected_suite(&sh)?).unwrap();
        // Resumed: the server took the PSK (with a suite of its hash).
        let resumed = psk_selected(&sh)?;
        if resumed {
            let sess = self.resume.as_ref().unwrap();
            if Suite::of(sess.suite).unwrap().hash_len() != suite.hash_len() {
                return Err(Error::with_alert(
                    "tls: server selected an invalid PSK and cipher suite pair",
                    47,
                ));
            }
        }
        self.transcript.extend_from_slice(sh.as_slice());
        conn.suite = suite.clone();
        // The key schedule.
        let zeros: Vec<u8> = vec_zero(suite.hash_len());
        let psk: Vec<u8> = if resumed {
            self.resume.as_ref().unwrap().psk.clone()
        } else {
            zeros.clone()
        };
        let early = suite.extract(zeros.as_slice(), psk.as_slice());
        let derived = suite.derive(early.as_slice(), "derived", &[]);
        let hs_secret = suite.extract(derived.as_slice(), shared.as_slice());
        let c_hs = suite.derive(
            hs_secret.as_slice(),
            "c hs traffic",
            self.transcript.as_slice(),
        );
        let s_hs = suite.derive(
            hs_secret.as_slice(),
            "s hs traffic",
            self.transcript.as_slice(),
        );
        let derived2 = suite.derive(hs_secret.as_slice(), "derived", &[]);
        let master = suite.extract(derived2.as_slice(), zeros.as_slice());
        // (A dummy change_cipher_spec for middleboxes when the session ID
        // is not empty, as Go, before the first encrypted record.)
        if !sent_ccs && self.session_id.len() > 0 {
            conn.write_record(s, CHANGE_CIPHER_SPEC, &[1])
                .map_err(io_err)?;
        }
        conn.read = suite.half(s_hs.as_slice());
        conn.write = suite.half(c_hs.as_slice());
        // EncryptedExtensions.
        let (t, ee) = conn.read_handshake(s)?;
        if t != 8 {
            return Err(Error::new(
                "tls: received unexpected handshake message instead of EncryptedExtensions",
            ));
        }
        self.transcript.extend_from_slice(ee.as_slice());
        let mut m = Msg::new(&ee[4..]);
        let exts = extensions(m.vec16()?.as_slice())?;
        if m.left() != 0 {
            return Err(decode_error());
        }
        if let Some(a) = ext_of(&exts, 16) {
            let mut am = Msg::new(a.as_slice());
            let mut list = Msg::new(am.vec16()?.as_slice());
            let p = list.vec8()?;
            if list.left() != 0 || am.left() != 0 || p.len() == 0 {
                return Err(Error::new("tls: server selected invalid ALPN protocol"));
            }
            let mut offered = false;
            for o in self.c.b.alpn.iter() {
                if o.as_bytes() == p.as_slice() {
                    offered = true;
                }
            }
            if !offered {
                return Err(Error::new(
                    "tls: server selected unadvertised ALPN protocol",
                ));
            }
            conn.alpn = Some(p);
        }
        if resumed {
            // No certificates: the session's stand.
            conn.peer_certs = self.resume.as_ref().unwrap().certs.clone();
            conn.resumed = true;
            return self.finish13(
                conn,
                s,
                &suite,
                s_hs.as_slice(),
                c_hs.as_slice(),
                master.as_slice(),
                false,
                Vec::new(),
                Vec::new(),
            );
        }
        // CertificateRequest, Certificate.
        let (mut t, mut msg) = conn.read_handshake(s)?;
        let mut cert_requested = false;
        let mut request_context: Vec<u8> = Vec::new();
        let mut request_schemes: Vec<u16> = Vec::new();
        if t == 13 {
            cert_requested = true;
            let mut cm = Msg::new(&msg[4..]);
            request_context = cm.vec8()?;
            let rx = extensions(cm.vec16()?.as_slice())?;
            if cm.left() != 0 {
                return Err(decode_error());
            }
            if let Some(sa) = ext_of(&rx, 13) {
                let mut sm = Msg::new(sa.as_slice());
                request_schemes = u16s(sm.vec16()?.as_slice())?;
            }
            self.transcript.extend_from_slice(msg.as_slice());
            let (t2, msg2) = conn.read_handshake(s)?;
            t = t2;
            msg = msg2;
        }
        if t != 11 {
            return Err(Error::new(
                "tls: received unexpected handshake message instead of Certificate",
            ));
        }
        self.transcript.extend_from_slice(msg.as_slice());
        let certs = self.certificates(&msg)?;
        conn.peer_certs = certs.clone();
        self.verify_server(&certs)?;
        // CertificateVerify.
        let (t, cv) = conn.read_handshake(s)?;
        if t != 15 {
            return Err(Error::new(
                "tls: received unexpected handshake message instead of CertificateVerify",
            ));
        }
        let mut vm = Msg::new(&cv[4..]);
        let scheme = vm.u16()?;
        let sig = vm.vec16()?;
        if vm.left() != 0 {
            return Err(decode_error());
        }
        let mut signed: Vec<u8> = Vec::new();
        signed.resize(64, 0x20);
        signed.extend_from_slice(b"TLS 1.3, server CertificateVerify");
        signed.push(0);
        signed.extend_from_slice(suite.hash(self.transcript.as_slice()).as_slice());
        check_certificate_verify(&certs[0], scheme as u16, signed.as_slice(), sig.as_slice())?;
        self.transcript.extend_from_slice(cv.as_slice());
        self.finish13(
            conn,
            s,
            &suite,
            s_hs.as_slice(),
            c_hs.as_slice(),
            master.as_slice(),
            cert_requested,
            request_context,
            request_schemes,
        )
    }

    // The server's Finished, the client's flight, the traffic keys; the
    // resumption secret kept for the server's tickets.
    fn finish13<S: Read + Write>(
        &mut self,
        conn: &mut Conn,
        s: &mut S,
        suite: &Suite,
        s_hs: &[u8],
        c_hs: &[u8],
        master: &[u8],
        cert_requested: bool,
        request_context: Vec<u8>,
        request_schemes: Vec<u16>,
    ) -> Result<(), Error> {
        let suite = suite.clone();
        // The server's Finished.
        let (t, fin) = conn.read_handshake(s)?;
        if t != 20 {
            return Err(Error::new(
                "tls: received unexpected handshake message instead of Finished",
            ));
        }
        let s_key = suite.expand_label(s_hs, "finished", &[], suite.hash_len());
        let want = suite.hmac(
            s_key.as_slice(),
            suite.hash(self.transcript.as_slice()).as_slice(),
        );
        if !crate::crypto::subtle::constant_time_eq(&fin[4..], want.as_slice()) {
            return Err(Error::with_alert("tls: invalid server finished hash", 51));
        }
        self.transcript.extend_from_slice(fin.as_slice());
        if conn.hs_buf.len() != 0 {
            return Err(Error::new(
                "tls: handshake data after the server's Finished in one record",
            ));
        }
        let c_ap = suite.derive(master, "c ap traffic", self.transcript.as_slice());
        let s_ap = suite.derive(master, "s ap traffic", self.transcript.as_slice());
        // The client's flight: if asked, its Certificate (empty without an
        // identity the server's schemes fit) and CertificateVerify;
        // Finished.
        if cert_requested {
            let mut chosen: Option<(Identity, u16)> = None;
            if let Some(id) = &self.c.b.identity {
                if let Some(sc) = pick_scheme(&id.key, &request_schemes, true) {
                    chosen = Some((id.clone(), sc));
                }
            }
            let empty: Vec<Certificate> = Vec::new();
            let certs = match &chosen {
                Some((id, _)) => id.certs.clone(),
                None => empty,
            };
            let cm = certificate_msg(certs.as_slice(), Some(request_context.as_slice()));
            conn.write_record(s, HANDSHAKE, cm.as_slice())
                .map_err(io_err)?;
            self.transcript.extend_from_slice(cm.as_slice());
            if let Some((id, sc)) = &chosen {
                let signed =
                    verify_content(false, suite.hash(self.transcript.as_slice()).as_slice());
                let cv = certificate_verify_msg(
                    *sc,
                    sign_with(&id.key, *sc, signed.as_slice())?.as_slice(),
                );
                conn.write_record(s, HANDSHAKE, cv.as_slice())
                    .map_err(io_err)?;
                self.transcript.extend_from_slice(cv.as_slice());
            }
        }
        let c_key = suite.expand_label(c_hs, "finished", &[], suite.hash_len());
        let verify = suite.hmac(
            c_key.as_slice(),
            suite.hash(self.transcript.as_slice()).as_slice(),
        );
        let mut fm: Vec<u8> = vec_of(&[20]);
        push24(&mut fm, verify.len());
        fm.extend_from_slice(verify.as_slice());
        conn.write_record(s, HANDSHAKE, fm.as_slice())
            .map_err(io_err)?;
        s.flush().map_err(io_err)?;
        conn.read = suite.half(s_ap.as_slice());
        conn.write = suite.half(c_ap.as_slice());
        // For tickets: the resumption master secret.
        if let Some(cache) = self.c.b.cache {
            self.transcript.extend_from_slice(fm.as_slice());
            conn.res_master = suite.derive(master, "res master", self.transcript.as_slice());
            conn.cache = Some(cache);
            conn.cache_key = self.domain.clone();
        }
        Ok(())
    }

    fn selected_suite(&self, sh: &[u8]) -> Result<u16, Error> {
        let mut m = Msg::new(&sh[4..]);
        m.bytes(34)?;
        m.vec8()?;
        let id = m.u16()? as u16;
        for s in self.suites.iter() {
            if s.id() == id {
                return Ok(id);
            }
        }
        if self.c.b.test_hello.is_some() && Suite::of(id).is_some() {
            return Ok(id);
        }
        Err(Error::new("tls: server chose an unconfigured cipher suite"))
    }

    // A HelloRetryRequest's group and cookie.
    fn retry_request(&self, sh: &[u8]) -> Result<(u16, Option<Vec<u8>>), Error> {
        let mut m = Msg::new(&sh[4..]);
        m.bytes(34)?;
        m.vec8()?;
        m.u16()?;
        m.u8()?;
        let exts = extensions(m.vec16()?.as_slice())?;
        let mut group = self.share.group();
        if let Some(ks) = ext_of(&exts, 51) {
            if ks.len() != 2 {
                return Err(decode_error());
            }
            group = ((ks[0] as u16) << 8) | (ks[1] as u16);
            if group != X25519 && group != SECP256R1 && group != SECP384R1 {
                return Err(Error::new("tls: server selected unsupported group"));
            }
            if group == self.share.group() {
                return Err(Error::new(
                    "tls: server sent an unnecessary HelloRetryRequest key_share",
                ));
            }
        }
        let cookie = match ext_of(&exts, 44) {
            Some(c) => {
                let mut cm = Msg::new(c.as_slice());
                Some(cm.vec16()?)
            }
            None => None,
        };
        Ok((group, cookie))
    }

    // Checks the ServerHello; the shared secret.
    fn server_hello(&self, sh: &[u8]) -> Result<Vec<u8>, Error> {
        let mut m = Msg::new(&sh[4..]);
        let version = m.u16()?;
        m.bytes(32)?;
        let echo = m.vec8()?;
        m.u16()?;
        let compression = m.u8()?;
        if m.left() == 0 {
            return Err(Error::new(
                "tls: server selected TLS 1.2 or older, and only TLS 1.3 is implemented",
            ));
        }
        let exts = extensions(m.vec16()?.as_slice())?;
        if m.left() != 0 {
            return Err(decode_error());
        }
        let sv = match ext_of(&exts, 43) {
            Some(v) => v,
            None => {
                return Err(Error::new(
                    "tls: server selected TLS 1.2 or older, and only TLS 1.3 is implemented",
                ));
            }
        };
        if version != 0x0303 || sv.len() != 2 || sv[0] != 3 || sv[1] != 4 {
            return Err(Error::new("tls: server selected an invalid version"));
        }
        if echo != self.session_id {
            return Err(Error::new("tls: server did not echo the legacy session ID"));
        }
        if compression != 0 {
            return Err(Error::new(
                "tls: server selected unsupported compression format",
            ));
        }
        if let Some(p) = ext_of(&exts, 41) {
            let offered = match &self.resume {
                Some(x) => x.version == 0x0304,
                None => false,
            };
            if !offered {
                return Err(Error::new("tls: server selected unadvertised PSK"));
            }
            if p.len() != 2 || p[0] != 0 || p[1] != 0 {
                return Err(Error::new("tls: server selected an invalid PSK"));
            }
        }
        let ks = match ext_of(&exts, 51) {
            Some(k) => k,
            None => return Err(Error::new("tls: server did not send a key share")),
        };
        let mut km = Msg::new(ks.as_slice());
        let group = km.u16()? as u16;
        let key = km.vec16()?;
        if km.left() != 0 {
            return Err(decode_error());
        }
        if group != self.share.group() {
            return Err(Error::new("tls: server selected unsupported group"));
        }
        self.share.shared(key.as_slice())
    }

    // The Certificate message's certificates.
    fn certificates(&self, msg: &[u8]) -> Result<Vec<Certificate>, Error> {
        let mut m = Msg::new(&msg[4..]);
        let ctx = m.vec8()?;
        if ctx.len() != 0 {
            return Err(Error::new(
                "tls: received certificate with a request context",
            ));
        }
        let mut list = Msg::new(m.vec24()?.as_slice());
        if m.left() != 0 {
            return Err(decode_error());
        }
        let mut out: Vec<Certificate> = Vec::new();
        while list.left() > 0 {
            let der = list.vec24()?;
            list.vec16()?;
            out.push(
                Certificate::from_der(der.as_slice()).map_err(|e: x509::Error| -> Error {
                    Error {
                        msg: `tls: failed to parse certificate from server: ${e}`.to_string(),
                        cert: Some(e),
                        eof: false,
                        alert: 42,
                    }
                })?,
            );
        }
        if out.len() == 0 {
            return Err(Error::new("tls: received empty certificates message"));
        }
        Ok(out)
    }

    // The chain's verification (Go's verifyServerCertificate).
    fn verify_server(&self, certs: &[Certificate]) -> Result<(), Error> {
        if self.c.b.invalid_certs {
            return Ok(());
        }
        let mut opts = VerifyOptions::default();
        opts.roots = self.c.roots.clone();
        if !self.c.b.invalid_hostnames {
            let d = if self.domain.ends_with(".") {
                &self.domain[..self.domain.len() - 1]
            } else {
                self.domain.as_str()
            };
            opts.dns_name = Some(d.to_string());
        }
        let mut i = 1;
        while i < certs.len() {
            opts.intermediates.add_cert(certs[i].clone());
            i += 1;
        }
        match certs[0].verify(&opts) {
            Ok(_) => Ok(()),
            Err(e) => {
                // (Go's alerts for certificate errors.)
                let alert = match &e {
                    x509::Error::UnknownAuthority { .. } => 48,
                    x509::Error::Expired(_) => 45,
                    _ => 42,
                };
                Err(Error {
                    msg: `tls: failed to verify certificate: ${e}`.to_string(),
                    cert: Some(e),
                    eof: false,
                    alert,
                })
            }
        }
    }
}

// --- TLS 1.2 (RFC 5246; Go's handshake_client.go) ----------------------------

// The last 8 bytes of a TLS 1.3 server's random when it chose TLS 1.2
// (RFC 8446 4.1.3).
const DOWNGRADE_TLS12: [u8; 8] = [0x44, 0x4f, 0x57, 0x4e, 0x47, 0x52, 0x44, 0x01];

// Whether a ServerHello chose TLS 1.3 (by supported_versions).
// Whether a (TLS 1.3) ServerHello has a pre_shared_key extension.
fn psk_selected(sh: &[u8]) -> Result<bool, Error> {
    let mut m = Msg::new(&sh[4..]);
    m.bytes(34)?;
    m.vec8()?;
    m.u16()?;
    m.u8()?;
    let exts = extensions(m.vec16()?.as_slice())?;
    Ok(ext_of(&exts, 41).is_some())
}

fn is_tls13(sh: &[u8]) -> Result<bool, Error> {
    let mut m = Msg::new(&sh[4..]);
    m.u16()?;
    m.bytes(32)?;
    m.vec8()?;
    m.u16()?;
    m.u8()?;
    if m.left() == 0 {
        return Ok(false);
    }
    let exts = extensions(m.vec16()?.as_slice())?;
    Ok(ext_of(&exts, 43).is_some())
}

// A TLS 1.2 suite: ECDHE with an AEAD (Go's defaults but CBC).
#[derive(Clone, PartialEq)]
struct Suite12 {
    id: u16,
    /// ECDSA certificates (else RSA).
    ecdsa: bool,
    /// 0: AES-128-GCM, 1: AES-256-GCM, 2: ChaCha20-Poly1305, 3:
    /// AES-128-CBC-SHA, 4: AES-256-CBC-SHA.
    aead: u8,
    /// The PRF's hash is SHA-384 (else SHA-256).
    sha384: bool,
}

fn suites12(aes_first: bool) -> Vec<Suite12> {
    let aes: Vec<Suite12> = vec_of_suites(&[
        Suite12 {
            id: 0xc02b,
            ecdsa: true,
            aead: 0,
            sha384: false,
        },
        Suite12 {
            id: 0xc02f,
            ecdsa: false,
            aead: 0,
            sha384: false,
        },
        Suite12 {
            id: 0xc02c,
            ecdsa: true,
            aead: 1,
            sha384: true,
        },
        Suite12 {
            id: 0xc030,
            ecdsa: false,
            aead: 1,
            sha384: true,
        },
    ]);
    let chacha: Vec<Suite12> = vec_of_suites(&[
        Suite12 {
            id: 0xcca9,
            ecdsa: true,
            aead: 2,
            sha384: false,
        },
        Suite12 {
            id: 0xcca8,
            ecdsa: false,
            aead: 2,
            sha384: false,
        },
    ]);
    // (Last, as Go: CBC with HMAC-SHA1.)
    let cbc: Vec<Suite12> = vec_of_suites(&[
        Suite12 {
            id: 0xc009,
            ecdsa: true,
            aead: 3,
            sha384: false,
        },
        Suite12 {
            id: 0xc013,
            ecdsa: false,
            aead: 3,
            sha384: false,
        },
        Suite12 {
            id: 0xc00a,
            ecdsa: true,
            aead: 4,
            sha384: false,
        },
        Suite12 {
            id: 0xc014,
            ecdsa: false,
            aead: 4,
            sha384: false,
        },
    ]);
    let mut out: Vec<Suite12> = Vec::new();
    if aes_first {
        out.extend_from_slice(aes.as_slice());
        out.extend_from_slice(chacha.as_slice());
    } else {
        out.extend_from_slice(chacha.as_slice());
        out.extend_from_slice(aes.as_slice());
    }
    out.extend_from_slice(cbc.as_slice());
    out
}

fn vec_of_suites(s: &[Suite12]) -> Vec<Suite12> {
    s.to_vec()
}

impl Suite12 {
    fn key_len(&self) -> usize {
        if self.aead == 0 || self.aead == 3 {
            16
        } else {
            32
        }
    }

    fn iv_len(&self) -> usize {
        if self.aead == 2 {
            return 12;
        }
        if self.aead >= 3 {
            return 16;
        }
        4
    }

    fn mac_len(&self) -> usize {
        if self.aead >= 3 { 20 } else { 0 }
    }

    fn hash(&self, b: &[u8]) -> Vec<u8> {
        if self.sha384 {
            Sha384::digest(b)
        } else {
            Sha256::digest(b)
        }
    }

    fn hmac(&self, key: &[u8], data: &[u8]) -> Vec<u8> {
        if self.sha384 {
            let mut m = Hmac::<Sha384>::new_from_slice(key).unwrap();
            m.update(data);
            m.finalize()
        } else {
            let mut m = Hmac::<Sha256>::new_from_slice(key).unwrap();
            m.update(data);
            m.finalize()
        }
    }

    // PRF(secret, label, seed) = P_hash(secret, label + seed) (RFC 5246 5).
    fn prf(&self, secret: &[u8], label: &str, seed: &[u8], len: usize) -> Vec<u8> {
        let mut ls: Vec<u8> = label.as_bytes().to_vec();
        ls.extend_from_slice(seed);
        let mut out: Vec<u8> = Vec::new();
        let mut a = self.hmac(secret, ls.as_slice());
        while out.len() < len {
            let mut x = a.clone();
            x.extend_from_slice(ls.as_slice());
            out.extend_from_slice(self.hmac(secret, x.as_slice()).as_slice());
            a = self.hmac(secret, a.as_slice());
        }
        out.truncate(len);
        out
    }

    fn half(&self, mac: &[u8], key: &[u8], iv: &[u8]) -> HalfConn {
        let cipher = match self.aead {
            0 => Cipher::Aes128(Aes128Gcm::new_from_slice(key).unwrap()),
            1 => Cipher::Aes256(Aes256Gcm::new_from_slice(key).unwrap()),
            2 => Cipher::ChaCha(ChaCha20Poly1305::new_from_slice(key).unwrap()),
            3 => Cipher::Cbc128(Aes128::new_from_slice(key).unwrap()),
            _ => Cipher::Cbc256(Aes256::new_from_slice(key).unwrap()),
        };
        HalfConn {
            cipher: Some(cipher),
            iv: iv.to_vec(),
            seq: 0,
            secret: Vec::new(),
            explicit: self.aead < 2,
            mac_key: mac.to_vec(),
        }
    }

    // The client's and server's halves of the key block (RFC 5246 6.3).
    fn halves(
        &self,
        master: &[u8],
        client_random: &[u8],
        server_random: &[u8],
    ) -> (HalfConn, HalfConn) {
        let mut seed = server_random.to_vec();
        seed.extend_from_slice(client_random);
        let (ml, kl, il) = (self.mac_len(), self.key_len(), self.iv_len());
        let kb = self.prf(master, "key expansion", seed.as_slice(), 2 * (ml + kl + il));
        let ck = 2 * ml;
        let ci = 2 * ml + 2 * kl;
        let client = self.half(&kb[..ml], &kb[ck..ck + kl], &kb[ci..ci + il]);
        let server = self.half(
            &kb[ml..2 * ml],
            &kb[ck + kl..ck + 2 * kl],
            &kb[ci + il..ci + 2 * il],
        );
        (client, server)
    }
}

// The protocol an ALPN extension (from the server) chose, if offered.
fn alpn_choice(a: &[u8], offered: &[String]) -> Result<Vec<u8>, Error> {
    let mut am = Msg::new(a);
    let mut list = Msg::new(am.vec16()?.as_slice());
    let p = list.vec8()?;
    if list.left() != 0 || am.left() != 0 || p.len() == 0 {
        return Err(Error::new("tls: server selected invalid ALPN protocol"));
    }
    for o in offered.iter() {
        if o.as_bytes() == p.as_slice() {
            return Ok(p);
        }
    }
    Err(Error::with_alert(
        "tls: server selected unadvertised ALPN protocol",
        120,
    ))
}

impl Handshake {
    // The rest of a TLS 1.2 handshake after the ServerHello sh.
    fn run12<S: Read + Write>(
        &mut self,
        conn: &mut Conn,
        s: &mut S,
        sh: Vec<u8>,
    ) -> Result<(), Error> {
        let mut m = Msg::new(&sh[4..]);
        let version = m.u16()?;
        let server_random = m.bytes(32)?;
        let echo = m.vec8()?;
        let id = m.u16()? as u16;
        let compression = m.u8()?;
        let exts = if m.left() > 0 {
            extensions(m.vec16()?.as_slice())?
        } else {
            Vec::new()
        };
        if m.left() != 0 {
            return Err(decode_error());
        }
        if version != 0x0303 {
            return Err(Error::with_alert(
                "tls: server selected an unsupported protocol version",
                70,
            ));
        }
        if self.c.v13 && &server_random[24..] == DOWNGRADE_TLS12.as_slice() {
            return Err(Error::with_alert(
                "tls: downgrade attempt detected, possibly due to a MitM attack or a broken middlebox",
                47,
            ));
        }
        let mut suite: Option<Suite12> = None;
        for x in self.suites12.iter() {
            if x.id == id {
                suite = Some(x.clone());
            }
        }
        let suite = match suite {
            Some(x) => x,
            None => {
                return Err(Error::with_alert(
                    "tls: server chose an unconfigured cipher suite",
                    47,
                ));
            }
        };
        if compression != 0 {
            return Err(Error::with_alert(
                "tls: server selected unsupported compression format",
                47,
            ));
        }
        if let Some(ri) = ext_of(&exts, 0xff01) {
            if ri.len() != 1 || ri[0] != 0 {
                return Err(Error::with_alert(
                    "tls: initial handshake had non-empty renegotiation extension",
                    40,
                ));
            }
        }
        let ems = ext_of(&exts, 23).is_some();
        if let Some(a) = ext_of(&exts, 16) {
            conn.alpn = Some(alpn_choice(&a, &self.c.b.alpn)?);
        }
        conn.v12 = true;
        self.transcript.extend_from_slice(sh.as_slice());
        // A ticket follows the client's Finished (or, resumed, the
        // ServerHello) when the server answered session_ticket.
        let ticket_coming = ext_of(&exts, 35).is_some();
        // Resumed: the server echoed the session ID of our ticket (Go).
        let sent_ticket = match &self.resume {
            Some(x) => x.version == 0x0303,
            None => false,
        };
        if sent_ticket && echo == self.session_id {
            return self.resume12(conn, s, &suite, server_random, ems, ticket_coming);
        }
        // Certificate.
        let (t, msg) = conn.read_handshake(s)?;
        if t != 11 {
            return Err(Error::with_alert(
                "tls: received unexpected handshake message instead of Certificate",
                10,
            ));
        }
        self.transcript.extend_from_slice(msg.as_slice());
        let mut cm = Msg::new(&msg[4..]);
        let mut list = Msg::new(cm.vec24()?.as_slice());
        if cm.left() != 0 {
            return Err(decode_error());
        }
        let mut certs: Vec<Certificate> = Vec::new();
        while list.left() > 0 {
            let der = list.vec24()?;
            certs.push(Certificate::from_der(der.as_slice()).map_err(
                |e: x509::Error| -> Error {
                    Error {
                        msg: `tls: failed to parse certificate from server: ${e}`.to_string(),
                        cert: Some(e),
                        eof: false,
                        alert: 42,
                    }
                },
            )?);
        }
        if certs.len() == 0 {
            return Err(Error::with_alert(
                "tls: received empty certificates message",
                42,
            ));
        }
        conn.peer_certs = certs.clone();
        self.verify_server(&certs)?;
        let key = certs[0].public_key();
        let key_ok = match &key {
            PublicKey::Rsa(_) => !suite.ecdsa,
            PublicKey::P256(_) | PublicKey::P384(_) | PublicKey::Ed25519(_) => suite.ecdsa,
            PublicKey::Unsupported(_) => false,
        };
        if !key_ok {
            return Err(Error::with_alert(
                "tls: server's certificate contains an unsupported type of public key",
                43,
            ));
        }
        // ServerKeyExchange: the curve, the server's share, its signature.
        let (t, ske) = conn.read_handshake(s)?;
        if t != 12 {
            return Err(Error::with_alert(
                "tls: received unexpected handshake message instead of ServerKeyExchange",
                10,
            ));
        }
        self.transcript.extend_from_slice(ske.as_slice());
        let mut km = Msg::new(&ske[4..]);
        let curve_type = km.u8()?;
        let group = km.u16()? as u16;
        let public = km.vec8()?;
        let params_len = km.at;
        let scheme = km.u16()? as u16;
        let sig = km.vec16()?;
        if km.left() != 0 {
            return Err(decode_error());
        }
        if curve_type != 3 || (group != X25519 && group != SECP256R1 && group != SECP384R1) {
            return Err(Error::with_alert(
                "tls: server selected unsupported curve",
                47,
            ));
        }
        let mut signed = self.random.clone();
        signed.extend_from_slice(server_random.as_slice());
        signed.extend_from_slice(&ske[4..4 + params_len]);
        check_key_exchange_signature(&key, scheme, signed.as_slice(), sig.as_slice())?;
        // CertificateRequest (answered with no certificate), ServerHelloDone.
        let (mut t, mut msg) = conn.read_handshake(s)?;
        let mut cert_requested = false;
        let mut chosen: Option<(Identity, u16)> = None;
        if t == 13 {
            cert_requested = true;
            // certificate_types, supported_signature_algorithms,
            // certificate_authorities.
            let mut rm = Msg::new(&msg[4..]);
            let types = rm.vec8()?;
            let schemes = u16s(rm.vec16()?.as_slice())?;
            rm.vec16()?;
            if rm.left() != 0 {
                return Err(decode_error());
            }
            if let Some(id) = &self.c.b.identity {
                let kind: u8 = match &id.key {
                    x509::PrivateKey::Rsa(_) => 1,
                    _ => 64,
                };
                if types.contains(&kind) {
                    if let Some(sc) = pick_scheme(&id.key, &schemes, false) {
                        chosen = Some((id.clone(), sc));
                    }
                }
            }
            self.transcript.extend_from_slice(msg.as_slice());
            let (t2, msg2) = conn.read_handshake(s)?;
            t = t2;
            msg = msg2;
        }
        if t != 14 || msg.len() != 4 {
            return Err(Error::with_alert(
                "tls: received unexpected handshake message instead of ServerHelloDone",
                10,
            ));
        }
        self.transcript.extend_from_slice(msg.as_slice());
        // The client's flight: (Certificate), ClientKeyExchange,
        // change_cipher_spec, Finished.
        let share = self.new_share(group);
        let pms = share.shared(public.as_slice())?;
        if cert_requested {
            let empty: Vec<Certificate> = Vec::new();
            let certs = match &chosen {
                Some((id, _)) => id.certs.clone(),
                None => empty,
            };
            let cm = certificate_msg(certs.as_slice(), None);
            conn.write_record(s, HANDSHAKE, cm.as_slice())
                .map_err(io_err)?;
            self.transcript.extend_from_slice(cm.as_slice());
        }
        let mine = share.public();
        let mut cke: Vec<u8> = vec_of(&[16]);
        push24(&mut cke, mine.len() + 1);
        cke.push(mine.len() as u8);
        cke.extend_from_slice(mine.as_slice());
        conn.write_record(s, HANDSHAKE, cke.as_slice())
            .map_err(io_err)?;
        self.transcript.extend_from_slice(cke.as_slice());
        let master = if ems {
            suite.prf(
                pms.as_slice(),
                "extended master secret",
                suite.hash(self.transcript.as_slice()).as_slice(),
                48,
            )
        } else {
            let mut seed = self.random.clone();
            seed.extend_from_slice(server_random.as_slice());
            suite.prf(pms.as_slice(), "master secret", seed.as_slice(), 48)
        };
        // CertificateVerify: the handshake so far, signed (after the master
        // secret, whose session hash ends at ClientKeyExchange).
        if let Some((id, sc)) = &chosen {
            let cv = certificate_verify_msg(
                *sc,
                sign_with(&id.key, *sc, self.transcript.as_slice())?.as_slice(),
            );
            conn.write_record(s, HANDSHAKE, cv.as_slice())
                .map_err(io_err)?;
            self.transcript.extend_from_slice(cv.as_slice());
        }
        let (client_half, server_half) = suite.halves(
            master.as_slice(),
            self.random.as_slice(),
            server_random.as_slice(),
        );
        // (Tests: the rest of the randomness is the records' (CBC's IVs).)
        if let Some(t) = &self.rand {
            conn.rand = Some(t[self.rand_at..].to_vec());
            self.rand_at = t.len();
        }
        conn.write_record(s, CHANGE_CIPHER_SPEC, &[1])
            .map_err(io_err)?;
        conn.write = client_half;
        conn.pending_read = Some(server_half);
        let verify = suite.prf(
            master.as_slice(),
            "client finished",
            suite.hash(self.transcript.as_slice()).as_slice(),
            12,
        );
        let mut fin: Vec<u8> = vec_of(&[20, 0, 0, 12]);
        fin.extend_from_slice(verify.as_slice());
        conn.write_record(s, HANDSHAKE, fin.as_slice())
            .map_err(io_err)?;
        self.transcript.extend_from_slice(fin.as_slice());
        s.flush().map_err(io_err)?;
        // The server's NewSessionTicket, change_cipher_spec and Finished.
        let (mut t, mut sf) = conn.read_handshake(s)?;
        if ticket_coming {
            if t != 4 {
                return Err(Error::with_alert(
                    "tls: received unexpected handshake message instead of NewSessionTicket",
                    10,
                ));
            }
            self.transcript.extend_from_slice(sf.as_slice());
            self.keep_ticket12(conn, &sf, suite.id, master.as_slice(), ems)?;
            let (t2, sf2) = conn.read_handshake(s)?;
            t = t2;
            sf = sf2;
        }
        if t != 20 {
            return Err(Error::with_alert(
                "tls: received unexpected handshake message instead of Finished",
                10,
            ));
        }
        if conn.read.cipher.is_none() {
            return Err(Error::with_alert(
                "tls: server's Finished before its change_cipher_spec",
                10,
            ));
        }
        let want = suite.prf(
            master.as_slice(),
            "server finished",
            suite.hash(self.transcript.as_slice()).as_slice(),
            12,
        );
        if !crate::crypto::subtle::constant_time_eq(&sf[4..], want.as_slice()) {
            return Err(Error::with_alert(
                "tls: server's Finished message was incorrect",
                51,
            ));
        }
        if conn.hs_buf.len() != 0 {
            return Err(Error::new(
                "tls: handshake data after the server's Finished in one record",
            ));
        }
        Ok(())
    }

    // TLS 1.2's abbreviated handshake (RFC 5077 3.1): the session's master
    // secret; the server's (NewSessionTicket), change_cipher_spec and
    // Finished first, then the client's.
    fn resume12<S: Read + Write>(
        &mut self,
        conn: &mut Conn,
        s: &mut S,
        suite: &Suite12,
        server_random: Vec<u8>,
        ems: bool,
        ticket_coming: bool,
    ) -> Result<(), Error> {
        let sess = self.resume.clone().unwrap();
        if sess.suite != suite.id {
            return Err(Error::with_alert(
                "tls: server resumed a session with a different cipher suite",
                47,
            ));
        }
        if sess.ems != ems {
            return Err(Error::with_alert(
                "tls: server resumed a session with a different EMS extension",
                47,
            ));
        }
        let master = sess.psk.clone();
        conn.peer_certs = sess.certs.clone();
        let (client_half, server_half) = suite.halves(
            master.as_slice(),
            self.random.as_slice(),
            server_random.as_slice(),
        );
        conn.pending_read = Some(server_half);
        let (mut t, mut sf) = conn.read_handshake(s)?;
        if ticket_coming {
            if t != 4 {
                return Err(Error::with_alert(
                    "tls: received unexpected handshake message instead of NewSessionTicket",
                    10,
                ));
            }
            self.transcript.extend_from_slice(sf.as_slice());
            self.keep_ticket12(conn, &sf, suite.id, master.as_slice(), ems)?;
            let (t2, sf2) = conn.read_handshake(s)?;
            t = t2;
            sf = sf2;
        }
        if t != 20 {
            return Err(Error::with_alert(
                "tls: received unexpected handshake message instead of Finished",
                10,
            ));
        }
        if conn.read.cipher.is_none() {
            return Err(Error::with_alert(
                "tls: server's Finished before its change_cipher_spec",
                10,
            ));
        }
        let want = suite.prf(
            master.as_slice(),
            "server finished",
            suite.hash(self.transcript.as_slice()).as_slice(),
            12,
        );
        if !crate::crypto::subtle::constant_time_eq(&sf[4..], want.as_slice()) {
            return Err(Error::with_alert(
                "tls: server's Finished message was incorrect",
                51,
            ));
        }
        self.transcript.extend_from_slice(sf.as_slice());
        if let Some(t) = &self.rand {
            conn.rand = Some(t[self.rand_at..].to_vec());
            self.rand_at = t.len();
        }
        conn.write_record(s, CHANGE_CIPHER_SPEC, &[1])
            .map_err(io_err)?;
        conn.write = client_half;
        let verify = suite.prf(
            master.as_slice(),
            "client finished",
            suite.hash(self.transcript.as_slice()).as_slice(),
            12,
        );
        let mut fin: Vec<u8> = vec_of(&[20, 0, 0, 12]);
        fin.extend_from_slice(verify.as_slice());
        conn.write_record(s, HANDSHAKE, fin.as_slice())
            .map_err(io_err)?;
        s.flush().map_err(io_err)?;
        if conn.hs_buf.len() != 0 {
            return Err(Error::new(
                "tls: handshake data after the server's Finished in one record",
            ));
        }
        conn.resumed = true;
        Ok(())
    }

    // A TLS 1.2 NewSessionTicket (lifetime hint, ticket) kept in the cache
    // with the session it resumes.
    fn keep_ticket12(
        &self,
        conn: &Conn,
        msg: &[u8],
        suite: u16,
        master: &[u8],
        ems: bool,
    ) -> Result<(), Error> {
        let mut m = Msg::new(&msg[4..]);
        let hint = read_be(m.bytes(4)?.as_slice());
        let ticket = m.vec16()?;
        if m.left() != 0 {
            return Err(decode_error());
        }
        if let Some(cache) = self.c.b.cache {
            if ticket.len() == 0 {
                return Ok(());
            }
            let lifetime = if hint == 0 || hint > TICKET_LIFETIME {
                TICKET_LIFETIME
            } else {
                hint
            };
            cache.put(
                self.domain.as_str(),
                ClientSession {
                    version: 0x0303,
                    ems,
                    suite,
                    psk: master.to_vec(),
                    ticket,
                    age_add: 0,
                    received_ms: now_ms(),
                    lifetime,
                    certs: conn.peer_certs.clone(),
                },
            );
        }
        Ok(())
    }
}

// The ServerKeyExchange's signature by the leaf's key (TLS 1.2: PKCS#1
// v1.5 too, and ECDSA with any curve).
fn check_key_exchange_signature(
    key: &PublicKey,
    scheme: u16,
    signed: &[u8],
    sig: &[u8],
) -> Result<(), Error> {
    let mut offered = false;
    for x in SIG_SCHEMES.iter() {
        if *x == scheme {
            offered = true;
        }
    }
    if !offered {
        return Err(Error::with_alert(
            "tls: server used an unadvertised signature algorithm",
            47,
        ));
    }
    let bad = Error::with_alert("tls: invalid signature by the server certificate", 51);
    let ok = match key {
        PublicKey::Rsa(k) => {
            if scheme == 0x0401 {
                k.verify(
                    Pkcs1v15Sign::new::<Sha256>(),
                    Sha256::digest(signed).as_slice(),
                    sig,
                )
                .is_ok()
            } else if scheme == 0x0501 {
                k.verify(
                    Pkcs1v15Sign::new::<Sha384>(),
                    Sha384::digest(signed).as_slice(),
                    sig,
                )
                .is_ok()
            } else if scheme == 0x0601 {
                k.verify(
                    Pkcs1v15Sign::new::<Sha512>(),
                    Sha512::digest(signed).as_slice(),
                    sig,
                )
                .is_ok()
            } else if scheme == 0x0804 {
                k.verify(Pss::new::<Sha256>(), Sha256::digest(signed).as_slice(), sig)
                    .is_ok()
            } else if scheme == 0x0805 {
                k.verify(Pss::new::<Sha384>(), Sha384::digest(signed).as_slice(), sig)
                    .is_ok()
            } else if scheme == 0x0806 {
                k.verify(Pss::new::<Sha512>(), Sha512::digest(signed).as_slice(), sig)
                    .is_ok()
            } else {
                return Err(Error::with_alert(
                    "tls: certificate used with invalid signature algorithm",
                    47,
                ));
            }
        }
        PublicKey::P256(_) | PublicKey::P384(_) => {
            let h = if scheme == 0x0403 {
                Sha256::digest(signed)
            } else if scheme == 0x0503 {
                Sha384::digest(signed)
            } else {
                return Err(Error::with_alert(
                    "tls: certificate used with invalid signature algorithm",
                    47,
                ));
            };
            match key {
                PublicKey::P256(k) => match p256::ecdsa::Signature::from_der(sig) {
                    Ok(x) => k.verify_prehash(h.as_slice(), &x).is_ok(),
                    Err(_) => false,
                },
                PublicKey::P384(k) => match p384::ecdsa::Signature::from_der(sig) {
                    Ok(x) => k.verify_prehash(h.as_slice(), &x).is_ok(),
                    Err(_) => false,
                },
                _ => false,
            }
        }
        PublicKey::Ed25519(k) => {
            if scheme != 0x0807 {
                return Err(Error::with_alert(
                    "tls: certificate used with invalid signature algorithm",
                    47,
                ));
            }
            match ed25519::Signature::from_slice(sig) {
                Ok(x) => k.verify(signed, &x).is_ok(),
                Err(_) => false,
            }
        }
        PublicKey::Unsupported(_) => {
            return Err(Error::with_alert("tls: unsupported certificate key", 43));
        }
    };
    if ok { Ok(()) } else { Err(bad) }
}

// The server's CertificateVerify signature by the leaf's key (Go's
// verifyHandshakeSignature for TLS 1.3: no PKCS#1 v1.5, the curve as the
// scheme says).
fn check_certificate_verify(
    leaf: &Certificate,
    scheme: u16,
    signed: &[u8],
    sig: &[u8],
) -> Result<(), Error> {
    let bad = Error::with_alert("tls: invalid signature by the server certificate", 51);
    let key = leaf.public_key();
    let ok = match key {
        PublicKey::P256(k) => {
            if scheme != 0x0403 {
                return Err(Error::new(
                    "tls: certificate used with invalid signature algorithm",
                ));
            }
            match p256::ecdsa::Signature::from_der(sig) {
                Ok(s) => k
                    .verify_prehash(Sha256::digest(signed).as_slice(), &s)
                    .is_ok(),
                Err(_) => false,
            }
        }
        PublicKey::P384(k) => {
            if scheme != 0x0503 {
                return Err(Error::new(
                    "tls: certificate used with invalid signature algorithm",
                ));
            }
            match p384::ecdsa::Signature::from_der(sig) {
                Ok(s) => k
                    .verify_prehash(Sha384::digest(signed).as_slice(), &s)
                    .is_ok(),
                Err(_) => false,
            }
        }
        PublicKey::Rsa(k) => {
            if scheme == 0x0804 {
                k.verify(Pss::new::<Sha256>(), Sha256::digest(signed).as_slice(), sig)
                    .is_ok()
            } else if scheme == 0x0805 {
                k.verify(
                    Pss::new::<crate::crypto::sha2::Sha384>(),
                    Sha384::digest(signed).as_slice(),
                    sig,
                )
                .is_ok()
            } else if scheme == 0x0806 {
                k.verify(
                    Pss::new::<crate::crypto::sha2::Sha512>(),
                    crate::crypto::sha2::Sha512::digest(signed).as_slice(),
                    sig,
                )
                .is_ok()
            } else {
                return Err(Error::new(
                    "tls: certificate used with invalid signature algorithm",
                ));
            }
        }
        PublicKey::Ed25519(k) => {
            if scheme != 0x0807 {
                return Err(Error::new(
                    "tls: certificate used with invalid signature algorithm",
                ));
            }
            match ed25519::Signature::from_slice(sig) {
                Ok(s) => k.verify(signed, &s).is_ok(),
                Err(_) => false,
            }
        }
        PublicKey::Unsupported(_) => return Err(Error::new("tls: unsupported certificate key")),
    };
    if ok { Ok(()) } else { Err(bad) }
}

fn vec_of(b: &[u8]) -> Vec<u8> {
    b.to_vec()
}

fn vec_zero(n: usize) -> Vec<u8> {
    let mut v: Vec<u8> = Vec::new();
    v.resize(n, 0);
    v
}

// --- Servers (Go's handshake_server_tls13.go, handshake_server.go) -----------

/// A certificate chain and its private key (native-tls's `Identity`): a
/// server's, or a client's to send when the server asks.
///
/// # Examples
///
/// ```
/// use std::tls::Identity;
///
/// # // A test PKI: an Ed25519 root, and a server certificate for localhost
/// # // (valid 2025 to 2125) with its key.
/// # let mut root_pem = String::new();
/// # root_pem.push_str("-----BEGIN CERTIFICATE-----\n");
/// # root_pem.push_str("MIIBIDCB06ADAgECAgEBMAUGAytlcDAXMRUwEwYDVQQDEwxlZDI1NTE5IHJvb3Qw\n");
/// # root_pem.push_str("IBcNMjUwMTAxMDAwMDAwWhgPMjEyNTAxMDEwMDAwMDBaMBcxFTATBgNVBAMTDGVk\n");
/// # root_pem.push_str("MjU1MTkgcm9vdDAqMAUGAytlcAMhAOqug4Ff3BRnzivlQOiloXfbZoMO+62SgSG5\n");
/// # root_pem.push_str("08PMs3pRo0IwQDAOBgNVHQ8BAf8EBAMCAgQwDwYDVR0TAQH/BAUwAwEB/zAdBgNV\n");
/// # root_pem.push_str("HQ4EFgQUPl0gIDTo2x7nu7h529GnEHmZxagwBQYDK2VwA0EAhtjpwIs07XwZdWRU\n");
/// # root_pem.push_str("RBHIraY1z7j+TOy9ii/PWeo76r8RTnej8nrbtb5heb8yGsga0eE/tcRW+o2SAkJW\n");
/// # root_pem.push_str("t3qfCg==\n");
/// # root_pem.push_str("-----END CERTIFICATE-----\n");
/// # let mut cert_pem = String::new();
/// # cert_pem.push_str("-----BEGIN CERTIFICATE-----\n");
/// # cert_pem.push_str("MIIBOTCB7KADAgECAgECMAUGAytlcDAXMRUwEwYDVQQDEwxlZDI1NTE5IHJvb3Qw\n");
/// # cert_pem.push_str("IBcNMjUwMTAxMDAwMDAwWhgPMjEyNTAxMDEwMDAwMDBaMBQxEjAQBgNVBAMTCWxv\n");
/// # cert_pem.push_str("Y2FsaG9zdDAqMAUGAytlcAMhAMPfosir7qhzlT6oRo6N3Dshou0cuFSeGiLED2pS\n");
/// # cert_pem.push_str("32HRo14wXDAOBgNVHQ8BAf8EBAMCB4AwEwYDVR0lBAwwCgYIKwYBBQUHAwEwHwYD\n");
/// # cert_pem.push_str("VR0jBBgwFoAUPl0gIDTo2x7nu7h529GnEHmZxagwFAYDVR0RBA0wC4IJbG9jYWxo\n");
/// # cert_pem.push_str("b3N0MAUGAytlcANBANurjGjmXB96qqGnuBQpsa/+f/Xinyvj4BUdBZCHaJ+Vf/yt\n");
/// # cert_pem.push_str("2b2Q+ykPlft0o1Vs/d7s0lNEGx6y6mdYik/CZA4=\n");
/// # cert_pem.push_str("-----END CERTIFICATE-----\n");
/// # let mut key_pem = String::new();
/// # key_pem.push_str("-----BEGIN PRIVATE KEY-----\n");
/// # key_pem.push_str("MC4CAQAwBQYDK2VwBCIEIGXkuTV2sHFM6SgUmOqJvQUbFxRaj2i7ujaE3iQAp+dW\n");
/// # key_pem.push_str("-----END PRIVATE KEY-----\n");
/// let id = Identity::from_pkcs8(cert_pem.as_bytes(), key_pem.as_bytes()).unwrap();
/// assert_eq(id.certificates()[0].subject().common_name(), "localhost");
/// // A key that is not the certificate's is refused.
/// assert(Identity::from_pkcs8(root_pem.as_bytes(), key_pem.as_bytes()).is_err());
/// ```
#[derive(Clone)]
pub struct Identity {
    certs: Vec<Certificate>,
    key: x509::PrivateKey,
}

impl Identity {
    /// The chain of PEM text (the leaf first) and its key, PEM: PKCS#8 as
    /// native-tls ("PRIVATE KEY"), or PKCS#1 or SEC 1 ("RSA PRIVATE KEY",
    /// "EC PRIVATE KEY").
    pub fn from_pkcs8(pem: &[u8], key: &[u8]) -> Result<Identity, Error> {
        let certs = Certificate::from_pem_many(pem)
            .map_err(|e: x509::Error| -> Error { Error::new(`tls: ${e}`.to_string().as_str()) })?;
        let k = x509::parse_private_key_pem(key)
            .map_err(|e: x509::Error| -> Error { Error::new(`tls: ${e}`.to_string().as_str()) })?;
        Identity::from_parts(certs, k)
    }

    /// The chain (the leaf first) and the leaf's key.
    pub fn from_parts(certs: Vec<Certificate>, key: x509::PrivateKey) -> Result<Identity, Error> {
        if certs.len() == 0 {
            return Err(Error::new("tls: no certificates"));
        }
        if !key.matches(&certs[0]) {
            return Err(Error::new("tls: private key does not match public key"));
        }
        Ok(Identity { certs, key })
    }

    /// Returns the certificate chain, the leaf first.
    pub fn certificates(&self) -> &[Certificate] {
        self.certs.as_slice()
    }
}

/// Whether a server asks clients for certificates and checks them (Go's
/// ClientAuthType).
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum ClientAuth {
    /// Not asked (the default).
    NoClientCert,
    /// Asked; none or any is taken, unchecked.
    RequestClientCert,
    /// Required; any is taken, unchecked.
    RequireAnyClientCert,
    /// Asked; one sent must verify.
    VerifyClientCertIfGiven,
    /// Required and must verify.
    RequireAndVerifyClientCert,
}

/// A builder of [`TlsAcceptor`]s.
///
/// # Examples
///
/// ```no_run
/// use std::tls::{ClientAuth, Identity, TlsAcceptor};
///
/// let id = Identity::from_pkcs8(
///     &std::fs::read("cert.pem").unwrap(),
///     &std::fs::read("key.pem").unwrap(),
/// )
/// .unwrap();
/// let acceptor = TlsAcceptor::builder(id)
///     .alpn_protocols(&["h2", "http/1.1"])
///     .client_auth(ClientAuth::VerifyClientCertIfGiven)
///     .build()
///     .unwrap();
/// ```
#[derive(Clone)]
pub struct TlsAcceptorBuilder {
    identity: Identity,
    min: Option<Protocol>,
    max: Option<Protocol>,
    alpn: Vec<String>,
    client_auth: ClientAuth,
    client_cas: Vec<Certificate>,
}

impl TlsAcceptorBuilder {
    /// The oldest version to accept (`None`: the default, TLS 1.2).
    pub fn min_protocol_version(&mut self, p: Option<Protocol>) -> &mut TlsAcceptorBuilder {
        self.min = p;
        self
    }

    /// The newest version to accept (`None`: the newest, TLS 1.3).
    pub fn max_protocol_version(&mut self, p: Option<Protocol>) -> &mut TlsAcceptorBuilder {
        self.max = p;
        self
    }

    /// The application protocols the server speaks (ALPN), most preferred
    /// first (as Go's NextProtos; native-tls has none): a client offering
    /// others is refused.
    pub fn alpn_protocols(&mut self, protocols: &[&str]) -> &mut TlsAcceptorBuilder {
        self.alpn = protocols
            .iter()
            .map(|p: &&str| -> String { p.to_string() })
            .collect();
        self
    }

    /// Asks clients for certificates (as Go's Config.ClientAuth; native-tls
    /// has none).
    pub fn client_auth(&mut self, mode: ClientAuth) -> &mut TlsAcceptorBuilder {
        self.client_auth = mode;
        self
    }

    /// Trusts cert as a root for client certificates (Go's ClientCAs; none
    /// added: the system's roots).
    pub fn add_client_ca(&mut self, cert: Certificate) -> &mut TlsAcceptorBuilder {
        self.client_cas.push(cert);
        self
    }

    /// Makes the acceptor.
    ///
    /// # Errors
    ///
    /// An [`Error`] if the newest version allowed is older than TLS 1.2,
    /// or the versions allowed leave none.
    pub fn build(&self) -> Result<TlsAcceptor, Error> {
        let v13 = match &self.max {
            None | Some(Protocol::Tlsv13) => true,
            Some(Protocol::Tlsv12) => false,
            _ => return Err(Error::new("tls: TLS 1.1 and older are not supported")),
        };
        let v12 = match &self.min {
            Some(Protocol::Tlsv13) => false,
            _ => true,
        };
        if !v13 && !v12 {
            return Err(Error::new(
                "tls: no protocol version between the minimum and the maximum",
            ));
        }
        Ok(TlsAcceptor {
            b: self.clone(),
            v12,
            v13,
            ticket_key: random_bytes(32),
        })
    }
}

/// Accepts TLS clients (native-tls's `TlsAcceptor`): it runs the server's
/// handshake over a connected stream.
///
/// Clones share the key session tickets are sealed with. See the
/// [module's example](crate::tls) for a server and client.
#[derive(Clone)]
pub struct TlsAcceptor {
    b: TlsAcceptorBuilder,
    v12: bool,
    v13: bool,
    /// The key the session tickets are sealed with (AES-256-GCM; random
    /// per acceptor and its clones, as Go's per-Config keys).
    ticket_key: Vec<u8>,
}

impl TlsAcceptor {
    /// Makes an acceptor with the defaults that presents `identity`.
    ///
    /// # Errors
    ///
    /// None with the defaults (the `Result` is native-tls's signature).
    pub fn new(identity: Identity) -> Result<TlsAcceptor, Error> {
        TlsAcceptor::builder(identity).build()
    }

    /// Returns a builder of acceptors that present `identity`, with other
    /// settings.
    pub fn builder(identity: Identity) -> TlsAcceptorBuilder {
        TlsAcceptorBuilder {
            identity,
            min: None,
            max: None,
            alpn: Vec::new(),
            client_auth: ClientAuth::NoClientCert,
            client_cas: Vec::new(),
        }
    }

    // (std::http) The acceptor offering protocols by ALPN if it was given
    // none (as Go's server fills an empty NextProtos).
    pub(crate) fn with_default_alpn(&self, protocols: &[&str]) -> TlsAcceptor {
        if self.b.alpn.len() > 0 {
            return self.clone();
        }
        let mut a = self.clone();
        a.b.alpn = protocols
            .iter()
            .map(|p: &&str| -> String { p.to_string() })
            .collect();
        a
    }

    /// Runs the server's handshake over stream (connected to a client) and
    /// returns the encrypted stream.
    pub fn accept<S: Read + Write>(&self, stream: S) -> Result<TlsStream<S>, Error> {
        let mut s = TlsStream {
            conn: Conn::new(),
            stream,
        };
        s.conn.server = true;
        let mut hs = ServerHandshake {
            a: self.clone(),
            transcript: Vec::new(),
        };
        if let Err(e) = hs.run(&mut s.conn, &mut s.stream) {
            if e.alert != 0 {
                let _ = s.conn.write_record(&mut s.stream, ALERT, &[2, e.alert]);
                let _ = s.stream.flush();
            }
            return Err(e);
        }
        Ok(s)
    }
}

impl<S: Read + Write> TlsStream<S> {
    /// (Servers) the name the client asked for (SNI), if any.
    pub fn server_name(&self) -> Option<&str> {
        match &self.conn.sni {
            Some(n) => Some(n.as_str()),
            None => None,
        }
    }
}

// A ClientHello's fields.
struct ClientHello {
    version: usize,
    random: Vec<u8>,
    session_id: Vec<u8>,
    suites: Vec<u16>,
    compression: Vec<u8>,
    server_name: Option<String>,
    groups: Vec<u16>,
    sig_algs: Vec<u16>,
    alpn: Vec<Vec<u8>>,
    versions: Vec<u16>,
    shares: Vec<(u16, Vec<u8>)>,
    ems: bool,
    /// renegotiation_info or the SCSV.
    reneg: bool,
    point_formats: Option<Vec<u8>>,
    cookie: Option<Vec<u8>>,
    /// pre_shared_key: the tickets and their obfuscated ages, the binders,
    /// and the binders' length at the message's end.
    psk_ids: Vec<(Vec<u8>, u32)>,
    binders: Vec<Vec<u8>>,
    binders_len: usize,
    psk_modes: Vec<u8>,
    /// session_ticket (TLS 1.2): Some (maybe empty) when sent.
    ticket: Option<Vec<u8>>,
}

fn u16s(b: &[u8]) -> Result<Vec<u16>, Error> {
    if b.len() % 2 != 0 {
        return Err(decode_error());
    }
    let mut out: Vec<u16> = Vec::new();
    let mut i = 0;
    while i < b.len() {
        out.push(((b[i] as u16) << 8) | (b[i + 1] as u16));
        i += 2;
    }
    Ok(out)
}

fn parse_client_hello(msg: &[u8]) -> Result<ClientHello, Error> {
    let mut m = Msg::new(&msg[4..]);
    let version = m.u16()?;
    let random = m.bytes(32)?;
    let session_id = m.vec8()?;
    if session_id.len() > 32 {
        return Err(decode_error());
    }
    let suites = u16s(m.vec16()?.as_slice())?;
    let compression = m.vec8()?;
    let exts = if m.left() > 0 {
        extensions(m.vec16()?.as_slice())?
    } else {
        Vec::new()
    };
    if m.left() != 0 {
        return Err(decode_error());
    }
    let mut ch = ClientHello {
        version,
        random,
        session_id,
        suites,
        compression,
        server_name: None,
        groups: Vec::new(),
        sig_algs: Vec::new(),
        alpn: Vec::new(),
        versions: Vec::new(),
        shares: Vec::new(),
        ems: false,
        reneg: false,
        point_formats: None,
        cookie: None,
        psk_ids: Vec::new(),
        binders: Vec::new(),
        binders_len: 0,
        psk_modes: Vec::new(),
        ticket: None,
    };
    let mut ei = 0;
    for e in exts.iter() {
        ei += 1;
        let mut x = Msg::new(e.1.as_slice());
        if e.0 == 0 {
            let mut list = Msg::new(x.vec16()?.as_slice());
            while list.left() > 0 {
                let t = list.u8()?;
                let name = list.vec16()?;
                if t == 0 {
                    ch.server_name = Some(String::from_utf8_lossy(name.as_slice()));
                }
            }
        } else if e.0 == 10 {
            ch.groups = u16s(x.vec16()?.as_slice())?;
        } else if e.0 == 11 {
            ch.point_formats = Some(x.vec8()?);
        } else if e.0 == 13 {
            ch.sig_algs = u16s(x.vec16()?.as_slice())?;
        } else if e.0 == 16 {
            let mut list = Msg::new(x.vec16()?.as_slice());
            while list.left() > 0 {
                ch.alpn.push(list.vec8()?);
            }
        } else if e.0 == 23 {
            ch.ems = true;
        } else if e.0 == 43 {
            ch.versions = u16s(x.vec8()?.as_slice())?;
        } else if e.0 == 44 {
            ch.cookie = Some(x.vec16()?);
        } else if e.0 == 51 {
            let mut list = Msg::new(x.vec16()?.as_slice());
            while list.left() > 0 {
                let g = list.u16()? as u16;
                let k = list.vec16()?;
                ch.shares.push((g, k));
            }
        } else if e.0 == 41 {
            // (RFC 8446 4.2.11: the last extension.)
            if ei != exts.len() {
                return Err(Error::with_alert(
                    "tls: invalid ClientHello: pre_shared_key is not the last extension",
                    47,
                ));
            }
            let mut ids = Msg::new(x.vec16()?.as_slice());
            while ids.left() > 0 {
                let t = ids.vec16()?;
                let age = read_be(ids.bytes(4)?.as_slice()) as u32;
                ch.psk_ids.push((t, age));
            }
            let bl = x.vec16()?;
            ch.binders_len = 2 + bl.len();
            let mut bm = Msg::new(bl.as_slice());
            while bm.left() > 0 {
                ch.binders.push(bm.vec8()?);
            }
            if x.left() != 0 || ch.binders.len() != ch.psk_ids.len() || ch.psk_ids.len() == 0 {
                return Err(decode_error());
            }
        } else if e.0 == 45 {
            ch.psk_modes = x.vec8()?;
        } else if e.0 == 35 {
            ch.ticket = Some(e.1.clone());
        } else if e.0 == 0xff01 {
            ch.reneg = true;
            if e.1.len() != 1 || e.1[0] != 0 {
                return Err(Error::with_alert(
                    "tls: initial handshake had non-empty renegotiation extension",
                    40,
                ));
            }
        }
    }
    for x in ch.suites.iter() {
        if *x == 0x00ff {
            ch.reneg = true;
        }
    }
    Ok(ch)
}

// The groups a server takes, its preference first.
const SERVER_GROUPS: [u16; 3] = [X25519, SECP256R1, SECP384R1];

struct ServerHandshake {
    a: TlsAcceptor,
    transcript: Vec<u8>,
}

fn server_random() -> Vec<u8> {
    random_bytes(32)
}

impl ServerHandshake {
    fn key(&self) -> &x509::PrivateKey {
        &self.a.b.identity.key
    }

    fn scheme(&self, offered: &[u16], tls13: bool) -> Result<u16, Error> {
        match pick_scheme(self.key(), offered, tls13) {
            Some(x) => Ok(x),
            None => Err(Error::with_alert(
                "tls: peer doesn't support any of the certificate's signature algorithms",
                40,
            )),
        }
    }

    fn sign(&self, scheme: u16, signed: &[u8]) -> Result<Vec<u8>, Error> {
        sign_with(self.key(), scheme, signed)
    }

    fn asks_cert(&self) -> bool {
        self.a.b.client_auth != ClientAuth::NoClientCert
    }

    // Whether a session may be resumed now: not expired, and the client
    // certificate mode met (Go's checkForResumption).
    fn session_ok(&self, sess: &ServerSession) -> bool {
        let now = now_ms() / 1000;
        let need_certs = self.a.b.client_auth == ClientAuth::RequireAnyClientCert
            || self.a.b.client_auth == ClientAuth::RequireAndVerifyClientCert;
        now < sess.created + TICKET_LIFETIME
            && !(need_certs && sess.certs.len() == 0)
            && !(sess.certs.len() > 0 && now as i64 > sess.certs[0].not_after())
    }

    // A TLS 1.2 NewSessionTicket for the session (master secret).
    fn ticket12_msg(
        &self,
        suite: u16,
        master: &[u8],
        ems: bool,
        created: u64,
        certs: &[Certificate],
    ) -> Vec<u8> {
        let ticket = seal_ticket(
            self.a.ticket_key.as_slice(),
            &ServerSession {
                version: 0x0303,
                ems,
                suite,
                created,
                psk: master.to_vec(),
                certs: certs.to_vec(),
            },
        );
        let mut nst: Vec<u8> = vec_of(&[4]);
        push24(&mut nst, 4 + 2 + ticket.len());
        nst.extend_from_slice(be32(TICKET_LIFETIME as u32).as_slice());
        push16(&mut nst, ticket.len());
        nst.extend_from_slice(ticket.as_slice());
        nst
    }

    // The client's certificates checked as the mode says (Go's
    // processCertsFromClient); certificate_required is TLS 1.3's alert.
    fn client_certs(
        &self,
        conn: &mut Conn,
        certs: Vec<Certificate>,
        tls13: bool,
    ) -> Result<(), Error> {
        let mode = &self.a.b.client_auth;
        if certs.len() == 0 {
            if *mode == ClientAuth::RequireAnyClientCert
                || *mode == ClientAuth::RequireAndVerifyClientCert
            {
                return Err(Error::with_alert(
                    "tls: client didn't provide a certificate",
                    if tls13 { 116 } else { 42 },
                ));
            }
            return Ok(());
        }
        if *mode == ClientAuth::VerifyClientCertIfGiven
            || *mode == ClientAuth::RequireAndVerifyClientCert
        {
            let mut opts = VerifyOptions::default();
            if self.a.b.client_cas.len() > 0 {
                let mut p = CertPool::new();
                for c in self.a.b.client_cas.iter() {
                    p.add_cert(c.clone());
                }
                opts.roots = Some(p);
            }
            let mut i = 1;
            while i < certs.len() {
                opts.intermediates.add_cert(certs[i].clone());
                i += 1;
            }
            opts.key_usages.push(x509::ExtKeyUsage::ClientAuth);
            if let Err(e) = certs[0].verify(&opts) {
                return Err(Error {
                    msg: `tls: failed to verify certificate: ${e}`.to_string(),
                    cert: Some(e),
                    eof: false,
                    alert: 42,
                });
            }
        }
        conn.peer_certs = certs;
        Ok(())
    }

    // The protocol for the client's ALPN list (the server's preference);
    // an error when both have lists that do not meet (as Go).
    fn alpn(&self, offered: &[Vec<u8>]) -> Result<Option<Vec<u8>>, Error> {
        if offered.len() == 0 || self.a.b.alpn.len() == 0 {
            return Ok(None);
        }
        for p in self.a.b.alpn.iter() {
            for o in offered.iter() {
                if p.as_bytes() == o.as_slice() {
                    return Ok(Some(o.clone()));
                }
            }
        }
        Err(Error::with_alert(
            "tls: client requested unsupported application protocols",
            120,
        ))
    }

    fn write_msg<S: Write>(&mut self, conn: &mut Conn, s: &mut S, msg: &[u8]) -> Result<(), Error> {
        conn.write_record(s, HANDSHAKE, msg).map_err(io_err)?;
        self.transcript.extend_from_slice(msg);
        Ok(())
    }

    fn run<S: Read + Write>(&mut self, conn: &mut Conn, s: &mut S) -> Result<(), Error> {
        let (t, msg) = conn.read_handshake(s)?;
        if t != 1 {
            return Err(Error::with_alert(
                "tls: unexpected message instead of ClientHello",
                10,
            ));
        }
        let ch = parse_client_hello(&msg)?;
        conn.sni = ch.server_name.clone();
        self.transcript.extend_from_slice(msg.as_slice());
        if self.a.v13 && ch.versions.contains(&0x0304) {
            return self.run13(conn, s, ch, msg);
        }
        let v12 = if ch.versions.len() > 0 {
            ch.versions.contains(&0x0303)
        } else {
            ch.version >= 0x0303
        };
        if self.a.v12 && v12 {
            return self.run12(conn, s, ch);
        }
        Err(Error::with_alert(
            "tls: client offered only unsupported versions",
            70,
        ))
    }

    fn run13<S: Read + Write>(
        &mut self,
        conn: &mut Conn,
        s: &mut S,
        first: ClientHello,
        first_msg: Vec<u8>,
    ) -> Result<(), Error> {
        let mut ch = first;
        if ch.compression.len() != 1 || ch.compression[0] != 0 {
            return Err(Error::with_alert("tls: client used legacy compression", 47));
        }
        // The suite: AES-128 unless the client puts ChaCha20 first (or
        // the CPU has no AES instructions).
        let mut suite: Option<Suite> = None;
        let mut first_ok: Option<u16> = None;
        for id in ch.suites.iter() {
            if Suite::of(*id).is_some() && first_ok.is_none() {
                first_ok = Some(*id);
            }
        }
        let chacha_first = first_ok == Some(0x1303) || !crate::crypto::aes::has_hardware();
        let order: [u16; 3] = if chacha_first {
            [0x1303, 0x1301, 0x1302]
        } else {
            [0x1301, 0x1302, 0x1303]
        };
        for id in order.iter() {
            if suite.is_none() && ch.suites.contains(id) {
                suite = Suite::of(*id);
            }
        }
        let suite = match suite {
            Some(x) => x,
            None => {
                return Err(Error::with_alert(
                    "tls: no cipher suite supported by both client and server",
                    40,
                ));
            }
        };
        let scheme = self.scheme(&ch.sig_algs, true)?;
        let alpn = self.alpn(&ch.alpn)?;
        // The group: the first of ours the client sent a share for, else a
        // HelloRetryRequest for the first both support.
        let mut group: Option<u16> = None;
        for g in SERVER_GROUPS.iter() {
            if group.is_none() && ch.groups.contains(g) {
                for sh in ch.shares.iter() {
                    if sh.0 == *g {
                        group = Some(*g);
                    }
                }
            }
        }
        let mut sent_ccs = false;
        // The final ClientHello and the transcript before it (the PSK
        // binders' input).
        let mut hello = first_msg.clone();
        let mut prefix: Vec<u8> = Vec::new();
        if group.is_none() {
            let mut g2: Option<u16> = None;
            for g in SERVER_GROUPS.iter() {
                if g2.is_none() && ch.groups.contains(g) {
                    g2 = Some(*g);
                }
            }
            let g = match g2 {
                Some(x) => x,
                None => {
                    return Err(Error::with_alert(
                        "tls: no ECDHE curve supported by both client and server",
                        40,
                    ));
                }
            };
            let mut ext: Vec<u8> = Vec::new();
            push16(&mut ext, 43);
            push16(&mut ext, 2);
            push16(&mut ext, 0x0304);
            push16(&mut ext, 51);
            push16(&mut ext, 2);
            push16(&mut ext, g as usize);
            let hrr = server_hello_msg(
                HRR_RANDOM.as_slice(),
                &ch.session_id,
                suite.id(),
                ext.as_slice(),
            );
            // The transcript: the first ClientHello's hash, the request.
            let h = suite.hash(first_msg.as_slice());
            let mut t2: Vec<u8> = vec_of(&[254, 0, 0, h.len() as u8]);
            t2.extend_from_slice(h.as_slice());
            self.transcript = t2;
            self.write_msg(conn, s, hrr.as_slice())?;
            if ch.session_id.len() > 0 {
                conn.write_record(s, CHANGE_CIPHER_SPEC, &[1])
                    .map_err(io_err)?;
                sent_ccs = true;
            }
            s.flush().map_err(io_err)?;
            let (t, msg2) = conn.read_handshake(s)?;
            if t != 1 {
                return Err(Error::with_alert(
                    "tls: unexpected message instead of the second ClientHello",
                    10,
                ));
            }
            let ch2 = parse_client_hello(&msg2)?;
            if ch2.shares.len() != 1 || ch2.shares[0].0 != g {
                return Err(Error::with_alert(
                    "tls: client sent invalid key share in second ClientHello",
                    47,
                ));
            }
            if ch2.session_id != ch.session_id || ch2.suites != ch.suites {
                return Err(Error::with_alert(
                    "tls: client illegally modified second ClientHello",
                    47,
                ));
            }
            prefix = self.transcript.clone();
            self.transcript.extend_from_slice(msg2.as_slice());
            hello = msg2.clone();
            ch = ch2;
            group = Some(g);
        }
        // Resumption: the first ticket that opens, of a suite with this
        // hash, not expired and fitting the client certificate mode (Go's
        // checkForResumption); its binder must verify.
        let mut resumed: Option<ServerSession> = None;
        let mut psk_index = 0usize;
        if ch.psk_ids.len() > 0 && ch.psk_modes.contains(&1) {
            let mut i = 0;
            while i < ch.psk_ids.len() && resumed.is_none() {
                if let Some(sess) =
                    open_ticket(self.a.ticket_key.as_slice(), ch.psk_ids[i].0.as_slice())
                {
                    let fits = sess.version == 0x0304
                        && Suite::of(sess.suite).unwrap().hash_len() == suite.hash_len()
                        && self.session_ok(&sess);
                    if fits {
                        let want = psk_binder(
                            &suite,
                            sess.psk.as_slice(),
                            prefix.as_slice(),
                            &hello[..hello.len() - ch.binders_len],
                        );
                        if !constant_time_eq(ch.binders[i].as_slice(), want.as_slice()) {
                            return Err(Error::with_alert("tls: invalid PSK binder", 51));
                        }
                        psk_index = i;
                        resumed = Some(sess);
                    }
                }
                i += 1;
            }
        }
        let group = group.unwrap();
        let mut peer: Vec<u8> = Vec::new();
        for sh in ch.shares.iter() {
            if sh.0 == group {
                peer = sh.1.clone();
            }
        }
        let share = new_server_share(group);
        let shared = share
            .shared(peer.as_slice())
            .map_err(|_e: Error| -> Error {
                Error::with_alert("tls: invalid client key share", 47)
            })?;
        let public = share.public();
        let mut ext: Vec<u8> = Vec::new();
        push16(&mut ext, 43);
        push16(&mut ext, 2);
        push16(&mut ext, 0x0304);
        push16(&mut ext, 51);
        push16(&mut ext, public.len() + 4);
        push16(&mut ext, group as usize);
        push16(&mut ext, public.len());
        ext.extend_from_slice(public.as_slice());
        if resumed.is_some() {
            push16(&mut ext, 41);
            push16(&mut ext, 2);
            push16(&mut ext, psk_index);
        }
        let sh = server_hello_msg(
            server_random().as_slice(),
            &ch.session_id,
            suite.id(),
            ext.as_slice(),
        );
        self.write_msg(conn, s, sh.as_slice())?;
        if !sent_ccs && ch.session_id.len() > 0 {
            conn.write_record(s, CHANGE_CIPHER_SPEC, &[1])
                .map_err(io_err)?;
        }
        conn.suite = suite.clone();
        let zeros: Vec<u8> = vec_zero(suite.hash_len());
        let psk: Vec<u8> = match &resumed {
            Some(x) => x.psk.clone(),
            None => zeros.clone(),
        };
        let early = suite.extract(zeros.as_slice(), psk.as_slice());
        let derived = suite.derive(early.as_slice(), "derived", &[]);
        let hs_secret = suite.extract(derived.as_slice(), shared.as_slice());
        let c_hs = suite.derive(
            hs_secret.as_slice(),
            "c hs traffic",
            self.transcript.as_slice(),
        );
        let s_hs = suite.derive(
            hs_secret.as_slice(),
            "s hs traffic",
            self.transcript.as_slice(),
        );
        let derived2 = suite.derive(hs_secret.as_slice(), "derived", &[]);
        let master = suite.extract(derived2.as_slice(), zeros.as_slice());
        conn.write = suite.half(s_hs.as_slice());
        conn.read = suite.half(c_hs.as_slice());
        let full = resumed.is_none();
        if let Some(x) = &resumed {
            conn.peer_certs = x.certs.clone();
            conn.resumed = true;
        }
        // EncryptedExtensions, Certificate, CertificateVerify, Finished.
        let mut ee_ext: Vec<u8> = Vec::new();
        if let Some(p) = &alpn {
            push16(&mut ee_ext, 16);
            push16(&mut ee_ext, p.len() + 3);
            push16(&mut ee_ext, p.len() + 1);
            ee_ext.push(p.len() as u8);
            ee_ext.extend_from_slice(p.as_slice());
        }
        conn.alpn = alpn.clone();
        let mut ee: Vec<u8> = vec_of(&[8]);
        push24(&mut ee, ee_ext.len() + 2);
        push16(&mut ee, ee_ext.len());
        ee.extend_from_slice(ee_ext.as_slice());
        self.write_msg(conn, s, ee.as_slice())?;
        // CertificateRequest: no context, the schemes accepted.
        if full && self.asks_cert() {
            let mut sa: Vec<u8> = Vec::new();
            push16(&mut sa, 2 * SIG_SCHEMES.len());
            for x in SIG_SCHEMES.iter() {
                push16(&mut sa, *x as usize);
            }
            let mut cr: Vec<u8> = vec_of(&[13]);
            push24(&mut cr, 1 + 2 + 4 + sa.len());
            cr.push(0);
            push16(&mut cr, 4 + sa.len());
            push16(&mut cr, 13);
            push16(&mut cr, sa.len());
            cr.extend_from_slice(sa.as_slice());
            self.write_msg(conn, s, cr.as_slice())?;
        }
        if full {
            let cm = certificate_msg(self.a.b.identity.certs.as_slice(), Some(&[]));
            self.write_msg(conn, s, cm.as_slice())?;
            let signed = verify_content(true, suite.hash(self.transcript.as_slice()).as_slice());
            let sig = self.sign(scheme, signed.as_slice())?;
            let cv = certificate_verify_msg(scheme, sig.as_slice());
            self.write_msg(conn, s, cv.as_slice())?;
        }
        let s_key = suite.expand_label(s_hs.as_slice(), "finished", &[], suite.hash_len());
        let verify = suite.hmac(
            s_key.as_slice(),
            suite.hash(self.transcript.as_slice()).as_slice(),
        );
        let mut fin: Vec<u8> = vec_of(&[20]);
        push24(&mut fin, verify.len());
        fin.extend_from_slice(verify.as_slice());
        self.write_msg(conn, s, fin.as_slice())?;
        s.flush().map_err(io_err)?;
        let c_ap = suite.derive(
            master.as_slice(),
            "c ap traffic",
            self.transcript.as_slice(),
        );
        let s_ap = suite.derive(
            master.as_slice(),
            "s ap traffic",
            self.transcript.as_slice(),
        );
        conn.write = suite.half(s_ap.as_slice());
        // The client's Certificate and CertificateVerify, if asked.
        if full && self.asks_cert() {
            let (t, cm) = conn.read_handshake(s)?;
            if t != 11 {
                return Err(Error::with_alert(
                    "tls: unexpected message instead of the client's Certificate",
                    10,
                ));
            }
            let mut m = Msg::new(&cm[4..]);
            if m.vec8()?.len() != 0 {
                return Err(Error::with_alert(
                    "tls: client's Certificate has a context",
                    47,
                ));
            }
            let mut list = Msg::new(m.vec24()?.as_slice());
            if m.left() != 0 {
                return Err(decode_error());
            }
            let mut certs: Vec<Certificate> = Vec::new();
            while list.left() > 0 {
                let der = list.vec24()?;
                list.vec16()?;
                certs.push(Certificate::from_der(der.as_slice()).map_err(
                    |e: x509::Error| -> Error {
                        Error {
                            msg: `tls: failed to parse client certificate: ${e}`.to_string(),
                            cert: Some(e),
                            eof: false,
                            alert: 42,
                        }
                    },
                )?);
            }
            self.transcript.extend_from_slice(cm.as_slice());
            let given = certs.len() > 0;
            let leaf = if given { Some(certs[0].clone()) } else { None };
            self.client_certs(conn, certs, true)?;
            if let Some(leaf) = leaf {
                let (t, cv) = conn.read_handshake(s)?;
                if t != 15 {
                    return Err(Error::with_alert(
                        "tls: unexpected message instead of the client's CertificateVerify",
                        10,
                    ));
                }
                let mut vm = Msg::new(&cv[4..]);
                let scheme = vm.u16()? as u16;
                let sig = vm.vec16()?;
                if vm.left() != 0 {
                    return Err(decode_error());
                }
                if !SIG_SCHEMES.contains(&scheme) {
                    return Err(Error::with_alert(
                        "tls: client certificate used with invalid signature algorithm",
                        47,
                    ));
                }
                let signed =
                    verify_content(false, suite.hash(self.transcript.as_slice()).as_slice());
                check_certificate_verify(&leaf, scheme, signed.as_slice(), sig.as_slice())?;
                self.transcript.extend_from_slice(cv.as_slice());
            }
        }
        // The client's Finished.
        let (t, cf) = conn.read_handshake(s)?;
        if t != 20 {
            return Err(Error::with_alert(
                "tls: unexpected message instead of the client's Finished",
                10,
            ));
        }
        let c_key = suite.expand_label(c_hs.as_slice(), "finished", &[], suite.hash_len());
        let want = suite.hmac(
            c_key.as_slice(),
            suite.hash(self.transcript.as_slice()).as_slice(),
        );
        if !constant_time_eq(&cf[4..], want.as_slice()) {
            return Err(Error::with_alert("tls: invalid client finished hash", 51));
        }
        if conn.hs_buf.len() != 0 {
            return Err(Error::new(
                "tls: handshake data after the client's Finished in one record",
            ));
        }
        conn.read = suite.half(c_ap.as_slice());
        // A ticket (as Go, one after each handshake): the resumption PSK
        // (empty nonce), the client's certificates.
        self.transcript.extend_from_slice(cf.as_slice());
        let res_master = suite.derive(master.as_slice(), "res master", self.transcript.as_slice());
        let psk = suite.expand_label(res_master.as_slice(), "resumption", &[], suite.hash_len());
        let created = match &resumed {
            Some(x) => x.created,
            None => now_ms() / 1000,
        };
        let ticket = seal_ticket(
            self.a.ticket_key.as_slice(),
            &ServerSession {
                version: 0x0304,
                ems: false,
                suite: suite.id(),
                created,
                psk,
                certs: conn.peer_certs.clone(),
            },
        );
        let mut body: Vec<u8> = Vec::new();
        let left = created + TICKET_LIFETIME - now_ms() / 1000;
        body.extend_from_slice(be32(left as u32).as_slice());
        body.extend_from_slice(random_bytes(4).as_slice());
        body.push(0);
        push16(&mut body, ticket.len());
        body.extend_from_slice(ticket.as_slice());
        push16(&mut body, 0);
        let mut nst: Vec<u8> = vec_of(&[4]);
        push24(&mut nst, body.len());
        nst.extend_from_slice(body.as_slice());
        conn.write_record(s, HANDSHAKE, nst.as_slice())
            .map_err(io_err)?;
        s.flush().map_err(io_err)?;
        Ok(())
    }

    fn run12<S: Read + Write>(
        &mut self,
        conn: &mut Conn,
        s: &mut S,
        ch: ClientHello,
    ) -> Result<(), Error> {
        if !ch.compression.contains(&0) {
            return Err(Error::with_alert(
                "tls: client does not support uncompressed connections",
                40,
            ));
        }
        if let Some(pf) = &ch.point_formats {
            if !pf.contains(&0) {
                return Err(Error::with_alert(
                    "tls: client does not support uncompressed points",
                    40,
                ));
            }
        }
        let ecdsa = match self.key() {
            x509::PrivateKey::Rsa(_) => false,
            _ => true,
        };
        // The server's order (ChaCha20 first when the client puts it
        // first among the AEADs).
        let mut first_ok: Option<u16> = None;
        let mine = suites12(true);
        for id in ch.suites.iter() {
            for x in mine.iter() {
                if x.id == *id && first_ok.is_none() {
                    first_ok = Some(*id);
                }
            }
        }
        let chacha_first = first_ok == Some(0xcca9)
            || first_ok == Some(0xcca8)
            || !crate::crypto::aes::has_hardware();
        let mut suite: Option<Suite12> = None;
        for x in suites12(!chacha_first).iter() {
            if suite.is_none() && x.ecdsa == ecdsa && ch.suites.contains(&x.id) {
                suite = Some(x.clone());
            }
        }
        let suite = match suite {
            Some(x) => x,
            None => {
                return Err(Error::with_alert(
                    "tls: no cipher suite supported by both client and server",
                    40,
                ));
            }
        };
        let mut group: Option<u16> = None;
        for g in SERVER_GROUPS.iter() {
            if group.is_none() && ch.groups.contains(g) {
                group = Some(*g);
            }
        }
        let group = match group {
            Some(g) => g,
            None => {
                return Err(Error::with_alert(
                    "tls: no ECDHE curve supported by both client and server",
                    40,
                ));
            }
        };
        let alpn = self.alpn(&ch.alpn)?;
        conn.alpn = alpn.clone();
        // Resumption (RFC 5077): a TLS 1.2 ticket of ours, its suite one the
        // client offers and our key takes, the extended master secret as
        // before (Go: a session that had one needs it).
        if let Some(t) = &ch.ticket {
            if let Some(sess) = open_ticket(self.a.ticket_key.as_slice(), t.as_slice()) {
                let mut s12: Option<Suite12> = None;
                for x in suites12(true).iter() {
                    if x.id == sess.suite && x.ecdsa == ecdsa && ch.suites.contains(&x.id) {
                        s12 = Some(x.clone());
                    }
                }
                if sess.version == 0x0303
                    && s12.is_some()
                    && self.session_ok(&sess)
                    && !(!sess.ems && ch.ems)
                {
                    if sess.ems && !ch.ems {
                        return Err(Error::with_alert(
                            "tls: session supported extended_master_secret but client does not",
                            40,
                        ));
                    }
                    return self.resume12(conn, s, &ch, s12.unwrap(), sess, alpn);
                }
            }
        }
        let scheme = self.scheme(&ch.sig_algs, false)?;
        // ServerHello (the downgrade sentinel when TLS 1.3 was possible).
        let mut random = server_random();
        if self.a.v13 {
            let mut i = 0;
            while i < 8 {
                random[24 + i] = DOWNGRADE_TLS12[i];
                i += 1;
            }
        }
        let mut ext: Vec<u8> = Vec::new();
        if ch.reneg {
            push16(&mut ext, 0xff01);
            push16(&mut ext, 1);
            ext.push(0);
        }
        if ch.ems {
            push16(&mut ext, 23);
            push16(&mut ext, 0);
        }
        if let Some(p) = &alpn {
            push16(&mut ext, 16);
            push16(&mut ext, p.len() + 3);
            push16(&mut ext, p.len() + 1);
            ext.push(p.len() as u8);
            ext.extend_from_slice(p.as_slice());
        }
        push16(&mut ext, 11);
        push16(&mut ext, 2);
        ext.push(1);
        ext.push(0);
        if ch.ticket.is_some() {
            push16(&mut ext, 35);
            push16(&mut ext, 0);
        }
        let sh = server_hello_msg(random.as_slice(), &Vec::new(), suite.id, ext.as_slice());
        self.write_msg(conn, s, sh.as_slice())?;
        conn.v12 = true;
        // Certificate, ServerKeyExchange, ServerHelloDone.
        let mut list: Vec<u8> = Vec::new();
        for c in self.a.b.identity.certs.iter() {
            push24(&mut list, c.raw().len());
            list.extend_from_slice(c.raw());
        }
        let mut cm: Vec<u8> = vec_of(&[11]);
        push24(&mut cm, list.len() + 3);
        push24(&mut cm, list.len());
        cm.extend_from_slice(list.as_slice());
        self.write_msg(conn, s, cm.as_slice())?;
        let share = new_server_share(group);
        let public = share.public();
        let mut params: Vec<u8> = vec_of(&[3]);
        push16(&mut params, group as usize);
        params.push(public.len() as u8);
        params.extend_from_slice(public.as_slice());
        let mut signed = ch.random.clone();
        signed.extend_from_slice(random.as_slice());
        signed.extend_from_slice(params.as_slice());
        let sig = self.sign(scheme, signed.as_slice())?;
        let mut ske: Vec<u8> = vec_of(&[12]);
        push24(&mut ske, params.len() + 4 + sig.len());
        ske.extend_from_slice(params.as_slice());
        push16(&mut ske, scheme as usize);
        push16(&mut ske, sig.len());
        ske.extend_from_slice(sig.as_slice());
        self.write_msg(conn, s, ske.as_slice())?;
        // CertificateRequest: RSA and ECDSA certificates, the schemes, the
        // client CAs' names.
        if self.asks_cert() {
            let mut cas: Vec<u8> = Vec::new();
            for c in self.a.b.client_cas.iter() {
                push16(&mut cas, c.raw_subject().len());
                cas.extend_from_slice(c.raw_subject());
            }
            let mut body: Vec<u8> = vec_of(&[2, 1, 64]);
            push16(&mut body, 2 * SIG_SCHEMES.len());
            for x in SIG_SCHEMES.iter() {
                push16(&mut body, *x as usize);
            }
            push16(&mut body, cas.len());
            body.extend_from_slice(cas.as_slice());
            let mut cr: Vec<u8> = vec_of(&[13]);
            push24(&mut cr, body.len());
            cr.extend_from_slice(body.as_slice());
            self.write_msg(conn, s, cr.as_slice())?;
        }
        self.write_msg(conn, s, &[14, 0, 0, 0])?;
        s.flush().map_err(io_err)?;
        // The client's Certificate, if asked.
        let mut client_leaf: Option<Certificate> = None;
        if self.asks_cert() {
            let (t, cm) = conn.read_handshake(s)?;
            if t != 11 {
                return Err(Error::with_alert(
                    "tls: unexpected message instead of the client's Certificate",
                    10,
                ));
            }
            let mut m = Msg::new(&cm[4..]);
            let mut list = Msg::new(m.vec24()?.as_slice());
            if m.left() != 0 {
                return Err(decode_error());
            }
            let mut certs: Vec<Certificate> = Vec::new();
            while list.left() > 0 {
                let der = list.vec24()?;
                certs.push(Certificate::from_der(der.as_slice()).map_err(
                    |e: x509::Error| -> Error {
                        Error {
                            msg: `tls: failed to parse client certificate: ${e}`.to_string(),
                            cert: Some(e),
                            eof: false,
                            alert: 42,
                        }
                    },
                )?);
            }
            self.transcript.extend_from_slice(cm.as_slice());
            if certs.len() > 0 {
                client_leaf = Some(certs[0].clone());
            }
            self.client_certs(conn, certs, false)?;
        }
        // ClientKeyExchange.
        let (t, cke) = conn.read_handshake(s)?;
        if t != 16 {
            return Err(Error::with_alert(
                "tls: unexpected message instead of ClientKeyExchange",
                10,
            ));
        }
        let mut km = Msg::new(&cke[4..]);
        let peer = km.vec8()?;
        if km.left() != 0 {
            return Err(decode_error());
        }
        self.transcript.extend_from_slice(cke.as_slice());
        let pms = share
            .shared(peer.as_slice())
            .map_err(|_e: Error| -> Error {
                Error::with_alert("tls: invalid client key share", 47)
            })?;
        let master = if ch.ems {
            suite.prf(
                pms.as_slice(),
                "extended master secret",
                suite.hash(self.transcript.as_slice()).as_slice(),
                48,
            )
        } else {
            let mut seed = ch.random.clone();
            seed.extend_from_slice(random.as_slice());
            suite.prf(pms.as_slice(), "master secret", seed.as_slice(), 48)
        };
        // The client's CertificateVerify: the handshake so far, signed.
        if let Some(leaf) = &client_leaf {
            let (t, cv) = conn.read_handshake(s)?;
            if t != 15 {
                return Err(Error::with_alert(
                    "tls: unexpected message instead of the client's CertificateVerify",
                    10,
                ));
            }
            let mut vm = Msg::new(&cv[4..]);
            let scheme = vm.u16()? as u16;
            let sig = vm.vec16()?;
            if vm.left() != 0 {
                return Err(decode_error());
            }
            check_key_exchange_signature(
                &leaf.public_key(),
                scheme,
                self.transcript.as_slice(),
                sig.as_slice(),
            )?;
            self.transcript.extend_from_slice(cv.as_slice());
        }
        let (client_half, server_half) =
            suite.halves(master.as_slice(), ch.random.as_slice(), random.as_slice());
        conn.pending_read = Some(client_half);
        // The client's change_cipher_spec and Finished.
        let (t, cf) = conn.read_handshake(s)?;
        if t != 20 {
            return Err(Error::with_alert(
                "tls: unexpected message instead of the client's Finished",
                10,
            ));
        }
        if conn.read.cipher.is_none() {
            return Err(Error::with_alert(
                "tls: client's Finished before its change_cipher_spec",
                10,
            ));
        }
        let want = suite.prf(
            master.as_slice(),
            "client finished",
            suite.hash(self.transcript.as_slice()).as_slice(),
            12,
        );
        if !constant_time_eq(&cf[4..], want.as_slice()) {
            return Err(Error::with_alert(
                "tls: client's Finished message is incorrect",
                51,
            ));
        }
        if conn.hs_buf.len() != 0 {
            return Err(Error::new(
                "tls: handshake data after the client's Finished in one record",
            ));
        }
        self.transcript.extend_from_slice(cf.as_slice());
        // A ticket, if the client asked (before change_cipher_spec).
        if ch.ticket.is_some() {
            let nst = self.ticket12_msg(
                suite.id,
                master.as_slice(),
                ch.ems,
                now_ms() / 1000,
                conn.peer_certs.as_slice(),
            );
            self.write_msg(conn, s, nst.as_slice())?;
        }
        conn.write_record(s, CHANGE_CIPHER_SPEC, &[1])
            .map_err(io_err)?;
        conn.write = server_half;
        let verify = suite.prf(
            master.as_slice(),
            "server finished",
            suite.hash(self.transcript.as_slice()).as_slice(),
            12,
        );
        let mut fin: Vec<u8> = vec_of(&[20, 0, 0, 12]);
        fin.extend_from_slice(verify.as_slice());
        conn.write_record(s, HANDSHAKE, fin.as_slice())
            .map_err(io_err)?;
        s.flush().map_err(io_err)?;
        Ok(())
    }
}

impl ServerHandshake {
    // TLS 1.2's abbreviated handshake: ServerHello echoing the session ID,
    // (a new ticket), change_cipher_spec and Finished; then the client's.
    fn resume12<S: Read + Write>(
        &mut self,
        conn: &mut Conn,
        s: &mut S,
        ch: &ClientHello,
        suite: Suite12,
        sess: ServerSession,
        alpn: Option<Vec<u8>>,
    ) -> Result<(), Error> {
        let mut random = server_random();
        if self.a.v13 {
            let mut i = 0;
            while i < 8 {
                random[24 + i] = DOWNGRADE_TLS12[i];
                i += 1;
            }
        }
        let mut ext: Vec<u8> = Vec::new();
        if ch.reneg {
            push16(&mut ext, 0xff01);
            push16(&mut ext, 1);
            ext.push(0);
        }
        if sess.ems {
            push16(&mut ext, 23);
            push16(&mut ext, 0);
        }
        if let Some(p) = &alpn {
            push16(&mut ext, 16);
            push16(&mut ext, p.len() + 3);
            push16(&mut ext, p.len() + 1);
            ext.push(p.len() as u8);
            ext.extend_from_slice(p.as_slice());
        }
        push16(&mut ext, 35);
        push16(&mut ext, 0);
        let sh = server_hello_msg(random.as_slice(), &ch.session_id, suite.id, ext.as_slice());
        self.write_msg(conn, s, sh.as_slice())?;
        conn.v12 = true;
        conn.peer_certs = sess.certs.clone();
        conn.resumed = true;
        let master = sess.psk.clone();
        let nst = self.ticket12_msg(
            suite.id,
            master.as_slice(),
            sess.ems,
            sess.created,
            sess.certs.as_slice(),
        );
        self.write_msg(conn, s, nst.as_slice())?;
        let (client_half, server_half) =
            suite.halves(master.as_slice(), ch.random.as_slice(), random.as_slice());
        conn.write_record(s, CHANGE_CIPHER_SPEC, &[1])
            .map_err(io_err)?;
        conn.write = server_half;
        let verify = suite.prf(
            master.as_slice(),
            "server finished",
            suite.hash(self.transcript.as_slice()).as_slice(),
            12,
        );
        let mut fin: Vec<u8> = vec_of(&[20, 0, 0, 12]);
        fin.extend_from_slice(verify.as_slice());
        self.write_msg(conn, s, fin.as_slice())?;
        s.flush().map_err(io_err)?;
        conn.pending_read = Some(client_half);
        let (t, cf) = conn.read_handshake(s)?;
        if t != 20 {
            return Err(Error::with_alert(
                "tls: unexpected message instead of the client's Finished",
                10,
            ));
        }
        if conn.read.cipher.is_none() {
            return Err(Error::with_alert(
                "tls: client's Finished before its change_cipher_spec",
                10,
            ));
        }
        let want = suite.prf(
            master.as_slice(),
            "client finished",
            suite.hash(self.transcript.as_slice()).as_slice(),
            12,
        );
        if !constant_time_eq(&cf[4..], want.as_slice()) {
            return Err(Error::with_alert(
                "tls: client's Finished message is incorrect",
                51,
            ));
        }
        if conn.hs_buf.len() != 0 {
            return Err(Error::new(
                "tls: handshake data after the client's Finished in one record",
            ));
        }
        Ok(())
    }
}

fn vec_u16(v: &[u16]) -> Vec<u16> {
    v.to_vec()
}

// The signature scheme for the peer's list (its preference, as Go) and
// the key; TLS 1.3 takes no PKCS#1 v1.5.
fn pick_scheme(key: &x509::PrivateKey, offered: &[u16], tls13: bool) -> Option<u16> {
    let ok: Vec<u16> = match key {
        x509::PrivateKey::P256(_) => {
            if tls13 {
                vec_u16(&[0x0403])
            } else {
                vec_u16(&[0x0403, 0x0503])
            }
        }
        x509::PrivateKey::P384(_) => {
            if tls13 {
                vec_u16(&[0x0503])
            } else {
                vec_u16(&[0x0503, 0x0403])
            }
        }
        x509::PrivateKey::Rsa(_) => {
            if tls13 {
                vec_u16(&[0x0804, 0x0805, 0x0806])
            } else {
                vec_u16(&[0x0804, 0x0805, 0x0806, 0x0401, 0x0501, 0x0601])
            }
        }
        x509::PrivateKey::Ed25519(_) => vec_u16(&[0x0807]),
    };
    for o in offered.iter() {
        if ok.contains(o) {
            return Some(*o);
        }
    }
    None
}

// signed's signature by key under scheme.
fn sign_with(key: &x509::PrivateKey, scheme: u16, signed: &[u8]) -> Result<Vec<u8>, Error> {
    let fail =
        |_e: crate::crypto::rsa::Error| -> Error { Error::with_alert("tls: signing failed", 80) };
    match key {
        x509::PrivateKey::P256(k) => {
            let h = if scheme == 0x0503 {
                Sha384::digest(signed)
            } else {
                Sha256::digest(signed)
            };
            Ok(k.sign_prehash(h.as_slice()).unwrap().to_der())
        }
        x509::PrivateKey::P384(k) => {
            let h = if scheme == 0x0403 {
                Sha256::digest(signed)
            } else {
                Sha384::digest(signed)
            };
            Ok(k.sign_prehash(h.as_slice()).unwrap().to_der())
        }
        x509::PrivateKey::Rsa(k) => {
            if scheme == 0x0804 {
                return k
                    .sign(Pss::new::<Sha256>(), Sha256::digest(signed).as_slice())
                    .map_err(fail);
            }
            if scheme == 0x0805 {
                return k
                    .sign(Pss::new::<Sha384>(), Sha384::digest(signed).as_slice())
                    .map_err(fail);
            }
            if scheme == 0x0806 {
                return k
                    .sign(Pss::new::<Sha512>(), Sha512::digest(signed).as_slice())
                    .map_err(fail);
            }
            if scheme == 0x0401 {
                return k
                    .sign(
                        Pkcs1v15Sign::new::<Sha256>(),
                        Sha256::digest(signed).as_slice(),
                    )
                    .map_err(fail);
            }
            if scheme == 0x0501 {
                return k
                    .sign(
                        Pkcs1v15Sign::new::<Sha384>(),
                        Sha384::digest(signed).as_slice(),
                    )
                    .map_err(fail);
            }
            k.sign(
                Pkcs1v15Sign::new::<Sha512>(),
                Sha512::digest(signed).as_slice(),
            )
            .map_err(fail)
        }
        // (Ed25519 signs the data itself.)
        x509::PrivateKey::Ed25519(k) => Ok(k.sign(signed).to_vec()),
    }
}

// A Certificate message: TLS 1.3's (a context, extensions per
// certificate) or 1.2's.
fn certificate_msg(certs: &[Certificate], context: Option<&[u8]>) -> Vec<u8> {
    let mut list: Vec<u8> = Vec::new();
    for c in certs.iter() {
        push24(&mut list, c.raw().len());
        list.extend_from_slice(c.raw());
        if context.is_some() {
            push16(&mut list, 0);
        }
    }
    let mut body: Vec<u8> = Vec::new();
    if let Some(ctx) = context {
        body.push(ctx.len() as u8);
        body.extend_from_slice(ctx);
    }
    push24(&mut body, list.len());
    body.extend_from_slice(list.as_slice());
    let mut m: Vec<u8> = vec_of(&[11]);
    push24(&mut m, body.len());
    m.extend_from_slice(body.as_slice());
    m
}

// A CertificateVerify message.
fn certificate_verify_msg(scheme: u16, sig: &[u8]) -> Vec<u8> {
    let mut m: Vec<u8> = vec_of(&[15]);
    push24(&mut m, sig.len() + 4);
    push16(&mut m, scheme as usize);
    push16(&mut m, sig.len());
    m.extend_from_slice(sig);
    m
}

// The content TLS 1.3's CertificateVerify signs (RFC 8446 4.4.3).
fn verify_content(server: bool, transcript_hash: &[u8]) -> Vec<u8> {
    let mut signed: Vec<u8> = Vec::new();
    signed.resize(64, 0x20);
    signed.extend_from_slice(if server {
        b"TLS 1.3, server CertificateVerify"
    } else {
        b"TLS 1.3, client CertificateVerify"
    });
    signed.push(0);
    signed.extend_from_slice(transcript_hash);
    signed
}

// A server's key share for group.
fn new_server_share(group: u16) -> KeyShare {
    loop {
        let k = random_bytes(KeyShare::private_len(group));
        if let Some(ks) = KeyShare::of(group, k.as_slice()) {
            return ks;
        }
    }
}

// A ServerHello message (or HelloRetryRequest).
fn server_hello_msg(random: &[u8], session_id: &[u8], suite: u16, ext: &[u8]) -> Vec<u8> {
    let mut b: Vec<u8> = vec_of(&[3, 3]);
    b.extend_from_slice(random);
    b.push(session_id.len() as u8);
    b.extend_from_slice(session_id);
    push16(&mut b, suite as usize);
    b.push(0);
    push16(&mut b, ext.len());
    b.extend_from_slice(ext);
    let mut msg: Vec<u8> = vec_of(&[2]);
    push24(&mut msg, b.len());
    msg.extend_from_slice(b.as_slice());
    msg
}
