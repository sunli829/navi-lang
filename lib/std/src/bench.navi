//! Benchmarks for navi bench: a #[bench] function takes &mut Bencher and
//! times its workload with iter (Rust's equivalent is the unstable
//! test::Bencher). A #[bench] function without parameters is timed as a
//! whole.

use crate::time::Instant;

pub struct Bencher {
    iters: u64,
    nanos: u64,
}

impl Bencher {
    pub(crate) fn new() -> Bencher { Bencher { iters: 0, nanos: 0 } }

    /// Runs f repeatedly (about half a second in total) and records the
    /// time per call.
    pub fn iter<T>(&mut self, f: fn() -> T) {
        let mut n = 1u64;
        loop {
            let start = Instant::now();
            let mut i = 0u64;
            while i < n {
                crate::hint::black_box(f());
                i += 1;
            }
            let ns = start.elapsed().as_nanos();
            if ns >= 500000000 || n >= 1073741824 {
                self.iters = n;
                self.nanos = ns;
                return;
            }
            let want = if ns == 0 { n * 100 } else { n * 600000000 / ns };
            n = if want > n * 100 { n * 100 } else if want <= n { n * 2 } else { want };
        }
    }

    pub(crate) fn iterations(&self) -> u64 { self.iters }

    /// Nanoseconds per call of the measured workload.
    pub(crate) fn ns_per_iter(&self) -> u64 { if self.iters == 0 { 0 } else { self.nanos / self.iters } }
}
