//! Benchmarks for `navi bench`.
//!
//! A function marked `#[bench]` takes a `&mut` [`Bencher`] and times its
//! workload with [`Bencher::iter`]; `navi bench` runs the benchmarks of a crate
//! and prints the time per iteration. (Rust's equivalent is the unstable
//! `test::Bencher`.) A `#[bench]` function without parameters is timed as a
//! whole.
//!
//! # Examples
//!
//! ```
//! use std::bench::Bencher;
//!
//! fn fib(n: u64) -> u64 {
//!     if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
//! }
//!
//! #[bench]
//! fn bench_fib(b: &mut Bencher) {
//!     b.iter(|| fib(15));
//! }
//! # assert_eq(fib(10), 55);
//! ```

use crate::time::Instant;

/// The timer passed to a `#[bench]` function by `navi bench`.
///
/// Only `navi bench` creates one; the function passes its workload to
/// [`Bencher::iter`].
///
/// # Examples
///
/// ```
/// use std::bench::Bencher;
///
/// #[bench]
/// fn bench_sort(b: &mut Bencher) {
///     b.iter(|| {
///         let mut v = Vec::from([5, 3, 1, 4, 2]);
///         v.sort();
///         v
///     });
/// }
/// ```
pub struct Bencher {
    iters: u64,
    nanos: u64,
}

impl Bencher {
    pub(crate) fn new() -> Bencher {
        Bencher { iters: 0, nanos: 0 }
    }

    /// Runs `f` repeatedly and records the time per call.
    ///
    /// The number of calls grows until a run takes about half a second (or
    /// reaches 2^30 calls); the result of each call goes through
    /// [`black_box`](crate::hint::black_box) so the work is not optimized away.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::bench::Bencher;
    ///
    /// #[bench]
    /// fn bench_sum(b: &mut Bencher) {
    ///     let v: Vec<u64> = (0..1000).collect();
    ///     b.iter(|| v.iter().sum::<u64>());
    /// }
    /// ```
    pub fn iter<T>(&mut self, f: fn() -> T) {
        let mut n = 1u64;
        loop {
            let start = Instant::now();
            let mut i = 0u64;
            while i < n {
                crate::hint::black_box(f());
                i += 1;
            }
            let ns = start.elapsed().as_nanos() as u64;
            if ns >= 500000000 || n >= 1073741824 {
                self.iters = n;
                self.nanos = ns;
                return;
            }
            let want = if ns == 0 { n * 100 } else { n * 600000000 / ns };
            n = if want > n * 100 {
                n * 100
            } else if want <= n {
                n * 2
            } else {
                want
            };
        }
    }

    pub(crate) fn iterations(&self) -> u64 {
        self.iters
    }

    /// Nanoseconds per call of the measured workload.
    pub(crate) fn ns_per_iter(&self) -> u64 {
        if self.iters == 0 {
            0
        } else {
            self.nanos / self.iters
        }
    }
}
