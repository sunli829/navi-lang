//! Processes.

use crate::string::String;
use crate::io;
use crate::fmt::{self, Display, Formatter};

/// Ends the process with an exit code (no deferred calls run).
pub fn exit(code: i32) -> ! { crate::rt::exit(code) }

/// Aborts the process.
pub fn abort() -> ! { crate::intrinsics::abort() }

/// A command to run. The arguments are passed through the system shell
/// with quoting (no separate stdin/stdout configuration yet).
pub struct Command { program: String, args: Vec<String> }

impl Command {
    pub fn new(program: &str) -> Command { Command { program: program.to_string(), args: Vec::new() } }

    pub fn arg(&mut self, a: &str) -> &mut Command {
        self.args.push(a.to_string());
        self
    }

    pub fn args<I: IntoIterator<Item = S>, S: AsRef<str>>(&mut self, args: I) -> &mut Command {
        for a in args { self.args.push(a.as_ref().to_string()); }
        self
    }

    /// Runs the command and waits for it.
    pub fn status(&mut self) -> io::Result<ExitStatus> {
        let mut cmd = quote(self.program.as_str());
        for a in self.args.iter() {
            cmd.push(' ');
            cmd.push_str(quote(a.as_str()).as_str());
        }
        Ok(ExitStatus { code: crate::rt::os_system(cmd.as_str()) })
    }
}

#[cfg(not(target_os = "windows"))]
fn quote(s: &str) -> String {
    let mut out = String::from("'");
    for c in s.chars() {
        if c == '\'' { out.push_str("'\\''"); } else { out.push(c); }
    }
    out.push('\'');
    out
}

#[cfg(target_os = "windows")]
fn quote(s: &str) -> String {
    let mut out = String::from("\"");
    for c in s.chars() {
        if c == '"' { out.push_str("\\\""); } else { out.push(c); }
    }
    out.push('"');
    out
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct ExitStatus { code: i32 }

impl ExitStatus {
    pub fn success(&self) -> bool { self.code == 0 }
    pub fn code(&self) -> Option<i32> { Some(self.code) }
}

impl Display for ExitStatus {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { f.write_fmt(`exit status: ${self.code}`) }
}
