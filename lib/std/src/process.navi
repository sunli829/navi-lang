//! Processes: commands run with posix_spawn (CreateProcess on Windows; see
//! process/imp.navi).

mod imp;
pub use self::imp::*;

/// Ends the process with an exit code (no deferred calls run).
pub fn exit(code: i32) -> ! {
    crate::rt::exit(code)
}

/// Aborts the process.
pub fn abort() -> ! {
    crate::intrinsics::abort()
}
