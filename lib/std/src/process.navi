//! A module for working with processes.
//!
//! This module is mostly concerned with spawning and interacting with child
//! processes, but it also provides [`abort`] and [`exit`] for terminating the
//! current process, and [`id`] for its process id.
//!
//! # Spawning a process
//!
//! The [`Command`] struct is used to configure and spawn processes:
//!
//! ```
//! use std::process::Command;
//!
//! let output = Command::new("echo")
//!     .arg("Hello world")
//!     .output()
//!     .expect("Failed to execute command");
//!
//! assert_eq(output.stdout, "Hello world\n".as_bytes().to_vec());
//! ```
//!
//! Several methods on [`Command`], such as [`spawn`] or [`output`], can be
//! used to spawn a process. In particular, [`output`] spawns the child process
//! and waits until the process terminates, while [`spawn`] will return a
//! [`Child`] that represents the spawned child process.
//!
//! # Handling I/O
//!
//! The [`stdout`], [`stdin`], and [`stderr`] of a child process can be
//! configured by passing an [`Stdio`] to the corresponding method on
//! [`Command`]. Once spawned, they can be accessed from the [`Child`]. For
//! example, piping output from one command into another command can be done
//! like so:
//!
//! ```
//! use std::process::{Command, Stdio};
//!
//! fn main() -> std::io::Result<()> {
//!     // stdout must be configured with `Stdio::piped` in order to use
//!     // `echo_child.stdout`
//!     let mut echo_child = Command::new("echo")
//!         .arg("Oh no, a tpyo!")
//!         .stdout(Stdio::piped())
//!         .spawn()?;
//!
//!     // Note that `echo_child` is moved here, but we won't be needing
//!     // `echo_child` anymore
//!     let mut echo_out = echo_child.stdout.take().unwrap();
//!     let sed_child = Command::new("sed")
//!         .arg("s/tpyo/typo/")
//!         .stdin(echo_out)
//!         .stdout(Stdio::piped())
//!         .spawn()?;
//!
//!     let output = sed_child.wait_with_output()?;
//!     echo_child.wait()?;
//!     // The parent's copy of the pipe is not closed by passing it on.
//!     echo_out.close();
//!     assert_eq(output.stdout, "Oh no, a typo!\n".as_bytes().to_vec());
//!     Ok(())
//! }
//! ```
//!
//! Unlike Rust's, navi has no Drop: the pipes of a child are closed with
//! [`ChildStdin::close`], [`ChildStdout::close`] and [`ChildStderr::close`]
//! (see the [`Child`] documentation). On POSIX systems a child is started with
//! `posix_spawn` (`CreateProcessW` on Windows), and the program is searched in
//! the `PATH` by std itself (see [`Command::new`]).
//!
//! [`spawn`]: Command::spawn
//! [`output`]: Command::output
//! [`stdout`]: Command::stdout
//! [`stdin`]: Command::stdin
//! [`stderr`]: Command::stderr

mod imp;
pub use self::imp::*;

/// Terminates the current process with the specified exit code.
///
/// This function will never return and will immediately terminate the current
/// process. The exit code is passed through to the underlying OS and will be
/// available for consumption by another process.
///
/// Note that because this function never returns, and that it terminates the
/// process, no `defer`red calls of the current thread or any other thread
/// are run, and other threads are stopped wherever they are. Standard
/// output is not buffered in navi, so what was printed has been written.
///
/// Platform-specific behavior: on Unix-like platforms, it is unlikely that all
/// 32 bits of `code` are visible to a parent process; only the low 8 bits are.
///
/// # Examples
///
/// ```no_run
/// use std::process;
///
/// fn main() {
///     println("about to exit");
///     process::exit(2);
/// }
/// ```
pub fn exit(code: i32) -> ! {
    crate::rt::exit(code)
}

/// Terminates the process in an abnormal fashion.
///
/// The function will never return and will immediately terminate the current
/// process in a platform specific "abnormal" manner (on Unix, with the
/// `SIGABRT` signal). As with [`exit`], no deferred calls are run.
///
/// # Examples
///
/// ```no_run
/// use std::process;
///
/// fn main() {
///     println("aborting");
///     process::abort();
///     // execution never gets here
/// }
/// ```
pub fn abort() -> ! {
    crate::intrinsics::abort()
}
