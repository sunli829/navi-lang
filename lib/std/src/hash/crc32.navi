//! CRC-32 (IEEE 802.3, the one in zlib, gzip, PNG and zip), with the API
//! of Rust's crc32fast crate (Go's hash/crc32 with the IEEE table).
//!
//!     use std::hash::crc32;
//!
//!     let c = crc32::hash(b"123456789");      // 0xcbf43926
//!     let mut h = crc32::Hasher::new();
//!     h.update(b"1234");
//!     h.update(b"56789");
//!     let same = h.finalize();
//!
//! The tables are computed at compile time; the loop takes 8 bytes a step
//! (slicing-by-8).

use crate::io;

const POLY: u32 = 0xedb88320;

// TABLE[k * 256 + b]: the CRC of byte b followed by k zero bytes.
const fn make_table() -> [u32; 2048] {
    let mut t = [0u32; 2048];
    let mut i = 0;
    while i < 256 {
        let mut c = i as u32;
        let mut k = 0;
        while k < 8 {
            if c & 1 != 0 { c = POLY ^ (c >> 1); } else { c = c >> 1; }
            k += 1;
        }
        t[i] = c;
        i += 1;
    }
    let mut k = 1;
    while k < 8 {
        i = 0;
        while i < 256 {
            let p = t[(k - 1) * 256 + i];
            t[k * 256 + i] = (p >> 8) ^ t[(p & 0xff) as usize];
            i += 1;
        }
        k += 1;
    }
    t
}

static TABLE: [u32; 2048] = make_table();

/// Continues the (finished) CRC crc over data.
fn update_crc(crc: u32, data: &[u8]) -> u32 {
    let t = &TABLE;
    let mut c = !crc;
    let n = data.len();
    let p = crate::rt::slice_ptr(data);
    let mut i = 0;
    while i + 8 <= n {
        // Little-endian load of 8 bytes (every target is little-endian).
        let w = unsafe { *(p.add(i) as *const u64) };
        let lo = c ^ (w as u32);
        let hi = (w >> 32) as u32;
        c = t[1792 + (lo & 0xff) as usize] ^ t[1536 + ((lo >> 8) & 0xff) as usize]
            ^ t[1280 + ((lo >> 16) & 0xff) as usize] ^ t[1024 + (lo >> 24) as usize]
            ^ t[768 + (hi & 0xff) as usize] ^ t[512 + ((hi >> 8) & 0xff) as usize]
            ^ t[256 + ((hi >> 16) & 0xff) as usize] ^ t[(hi >> 24) as usize];
        i += 8;
    }
    while i < n {
        c = t[((c ^ data[i] as u32) & 0xff) as usize] ^ (c >> 8);
        i += 1;
    }
    !c
}

/// The CRC-32 of data.
pub fn hash(data: &[u8]) -> u32 { update_crc(0, data) }

/// A running CRC-32.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct Hasher {
    state: u32,
    amount: u64,
}

impl Hasher {
    /// A CRC of nothing.
    pub fn new() -> Hasher { Hasher { state: 0, amount: 0 } }

    /// Continues from a CRC computed earlier.
    pub fn new_with_initial(init: u32) -> Hasher { Hasher { state: init, amount: 0 } }

    /// Continues from a CRC of amount bytes computed earlier (amount
    /// matters only to combine).
    pub fn new_with_initial_len(init: u32, amount: u64) -> Hasher { Hasher { state: init, amount } }

    /// Feeds bytes.
    pub fn update(&mut self, buf: &[u8]) {
        self.state = update_crc(self.state, buf);
        self.amount += buf.len() as u64;
    }

    /// The CRC of everything fed.
    pub fn finalize(self) -> u32 { self.state }

    /// Forgets the input.
    pub fn reset(&mut self) {
        self.state = 0;
        self.amount = 0;
    }

    /// Makes this the CRC of its input followed by other's input.
    pub fn combine(&mut self, other: &Hasher) {
        self.state = combine(self.state, other.state, other.amount);
        self.amount += other.amount;
    }
}

impl Default for Hasher {
    fn default() -> Hasher { Hasher::new() }
}

impl crate::hash::Hasher for Hasher {
    fn finish(&self) -> u64 { self.state as u64 }
    fn write(&mut self, bytes: &[u8]) { self.update(bytes); }
}

impl io::Write for Hasher {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        self.update(buf);
        Ok(buf.len())
    }
    fn flush(&mut self) -> io::Result<()> { Ok(()) }
}

// a * b modulo the polynomial (bit-reversed, as zlib's multmodp).
fn multmodp(a: u32, b0: u32) -> u32 {
    let mut m = 1u32 << 31;
    let mut p = 0u32;
    let mut b = b0;
    loop {
        if a & m != 0 {
            p = p ^ b;
            if a & (m - 1) == 0 { break; }
        }
        m = m >> 1;
        b = if b & 1 != 0 { (b >> 1) ^ POLY } else { b >> 1 };
    }
    p
}

/// The CRC of A followed by B, from crc1 = CRC(A), crc2 = CRC(B) and the
/// length of B (zlib's crc32_combine).
pub fn combine(crc1: u32, crc2: u32, len2: u64) -> u32 {
    // x^(8 * len2) mod p, by squaring: x^(2^k) for each set bit.
    let mut sq = 1u32 << 30; // x^1
    let mut k = 0;
    while k < 3 {
        sq = multmodp(sq, sq);
        k += 1;
    }
    // sq = x^8: one byte.
    let mut p = 1u32 << 31; // x^0
    let mut n = len2;
    while n != 0 {
        if n & 1 != 0 { p = multmodp(sq, p); }
        sq = multmodp(sq, sq);
        n = n >> 1;
    }
    multmodp(p, crc1) ^ crc2
}
