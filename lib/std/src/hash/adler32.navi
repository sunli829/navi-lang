//! Adler-32 (RFC 1950, the checksum of zlib streams), with the API of
//! Rust's adler crate (Go's hash/adler32).
//!
//!     use std::hash::adler32;
//!
//!     let a = adler32::hash(b"Wikipedia");    // 0x11e60398
//!     let mut h = adler32::Adler32::new();
//!     h.write_slice(b"Wiki");
//!     h.write_slice(b"pedia");
//!     let same = h.checksum();

use crate::io;

const MOD: u32 = 65521;
// The most bytes before the sums can overflow a u32.
const NMAX: usize = 5552;

/// A running Adler-32.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct Adler32 {
    a: u32,
    b: u32,
}

impl Adler32 {
    /// The checksum of nothing (1).
    pub fn new() -> Adler32 {
        Adler32 { a: 1, b: 0 }
    }

    /// Continues from a checksum computed earlier.
    pub fn from_checksum(sum: u32) -> Adler32 {
        Adler32 {
            a: sum & 0xffff,
            b: sum >> 16,
        }
    }

    /// The checksum of everything fed.
    pub fn checksum(&self) -> u32 {
        self.b << 16 | self.a
    }

    /// Feeds bytes.
    pub fn write_slice(&mut self, bytes: &[u8]) {
        let mut a = self.a;
        let mut b = self.b;
        let n = bytes.len();
        let mut i = 0;
        while i < n {
            let end = if n - i > NMAX { i + NMAX } else { n };
            while i + 4 <= end {
                a += bytes[i] as u32;
                b += a;
                a += bytes[i + 1] as u32;
                b += a;
                a += bytes[i + 2] as u32;
                b += a;
                a += bytes[i + 3] as u32;
                b += a;
                i += 4;
            }
            while i < end {
                a += bytes[i] as u32;
                b += a;
                i += 1;
            }
            a = a % MOD;
            b = b % MOD;
        }
        self.a = a;
        self.b = b;
    }
}

impl Default for Adler32 {
    fn default() -> Adler32 {
        Adler32::new()
    }
}

/// The Adler-32 of data.
pub fn hash(data: &[u8]) -> u32 {
    let mut h = Adler32::new();
    h.write_slice(data);
    h.checksum()
}

/// The adler crate's name for hash.
pub fn adler32_slice(data: &[u8]) -> u32 {
    hash(data)
}

impl crate::hash::Hasher for Adler32 {
    fn finish(&self) -> u64 {
        self.checksum() as u64
    }
    fn write(&mut self, bytes: &[u8]) {
        self.write_slice(bytes);
    }
}

impl io::Write for Adler32 {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        self.write_slice(buf);
        Ok(buf.len())
    }
    fn flush(&mut self) -> io::Result<()> {
        Ok(())
    }
}
