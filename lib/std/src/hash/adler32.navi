//! The Adler-32 checksum (RFC 1950, the checksum of zlib streams), with the
//! API of Rust's `adler` crate (Go's `hash/adler32`).
//!
//! Adler-32 is fast but weak: it detects accidental corruption, not
//! deliberate tampering. Use [`crate::crypto::sha2`] for that.
//!
//! # Examples
//!
//! ```
//! use std::hash::adler32;
//!
//! assert_eq(adler32::hash(b"Wikipedia"), 0x11e60398);
//!
//! // The same, fed in parts.
//! let mut h = adler32::Adler32::new();
//! h.write_slice(b"Wiki");
//! h.write_slice(b"pedia");
//! assert_eq(h.checksum(), 0x11e60398);
//! ```

use crate::io;

const MOD: u32 = 65521;
// The most bytes before the sums can overflow a u32.
const NMAX: usize = 5552;

/// A running Adler-32 checksum, fed bytes in any number of parts.
///
/// It also implements [`crate::hash::Hasher`] (`finish` is the checksum)
/// and [`crate::io::Write`], so it can be the target of
/// [`crate::io::copy`].
///
/// # Examples
///
/// ```
/// use std::hash::adler32::Adler32;
///
/// let mut h = Adler32::new();
/// h.write_slice(b"abc");
/// assert_eq(h.checksum(), 0x024d0127);
/// ```
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct Adler32 {
    a: u32,
    b: u32,
}

impl Adler32 {
    /// Creates a checksum of no bytes, whose value is 1.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(std::hash::adler32::Adler32::new().checksum(), 1);
    /// ```
    pub fn new() -> Adler32 {
        Adler32 { a: 1, b: 0 }
    }

    /// Creates a running checksum that continues from `sum`, the checksum
    /// of some earlier bytes.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::hash::adler32::{self, Adler32};
    ///
    /// let mut h = Adler32::from_checksum(adler32::hash(b"Wiki"));
    /// h.write_slice(b"pedia");
    /// assert_eq(h.checksum(), adler32::hash(b"Wikipedia"));
    /// ```
    pub fn from_checksum(sum: u32) -> Adler32 {
        Adler32 {
            a: sum & 0xffff,
            b: sum >> 16,
        }
    }

    /// Returns the checksum of all the bytes fed so far.
    pub fn checksum(&self) -> u32 {
        self.b << 16 | self.a
    }

    /// Feeds `bytes` to the checksum.
    pub fn write_slice(&mut self, bytes: &[u8]) {
        let mut a = self.a;
        let mut b = self.b;
        let n = bytes.len();
        let mut i = 0;
        while i < n {
            let end = if n - i > NMAX { i + NMAX } else { n };
            while i + 4 <= end {
                a += bytes[i] as u32;
                b += a;
                a += bytes[i + 1] as u32;
                b += a;
                a += bytes[i + 2] as u32;
                b += a;
                a += bytes[i + 3] as u32;
                b += a;
                i += 4;
            }
            while i < end {
                a += bytes[i] as u32;
                b += a;
                i += 1;
            }
            a = a % MOD;
            b = b % MOD;
        }
        self.a = a;
        self.b = b;
    }
}

impl Default for Adler32 {
    fn default() -> Adler32 {
        Adler32::new()
    }
}

/// Computes the Adler-32 checksum of `data`.
///
/// # Examples
///
/// ```
/// use std::hash::adler32;
///
/// assert_eq(adler32::hash(b""), 1);
/// assert_eq(adler32::hash(b"Wikipedia"), 0x11e60398);
/// ```
pub fn hash(data: &[u8]) -> u32 {
    let mut h = Adler32::new();
    h.write_slice(data);
    h.checksum()
}

/// Computes the Adler-32 checksum of `data`; the same as [`hash`] (the
/// name the `adler32` crate uses).
///
/// # Examples
///
/// ```
/// use std::hash::adler32;
///
/// assert_eq(adler32::adler32_slice(b"Wikipedia"), adler32::hash(b"Wikipedia"));
/// ```
pub fn adler32_slice(data: &[u8]) -> u32 {
    hash(data)
}

impl crate::hash::Hasher for Adler32 {
    fn finish(&self) -> u64 {
        self.checksum() as u64
    }
    fn write(&mut self, bytes: &[u8]) {
        self.write_slice(bytes);
    }
}

impl io::Write for Adler32 {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        self.write_slice(buf);
        Ok(buf.len())
    }
    fn flush(&mut self) -> io::Result<()> {
        Ok(())
    }
}
