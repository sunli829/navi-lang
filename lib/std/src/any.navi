//! Type names (Rust's std::any; TypeId and Any are not provided).
//!
//! # Examples
//!
//! ```
//! use std::any::type_name;
//!
//! assert_eq(type_name::<Vec<i32>>(), "Vec<i32>");
//! ```

/// Returns the name of a type as a string slice, as written in source, e.g.
/// `"Vec<i32>"`.
///
/// Unlike Rust's, the name does not include module paths (Rust gives
/// `alloc::vec::Vec<i32>`). It is meant for diagnostics: do not rely on
/// its exact form.
///
/// # Examples
///
/// ```
/// use std::any::type_name;
///
/// assert_eq(type_name::<i32>(), "i32");
/// assert_eq(type_name::<Option<String>>(), "Option<String>");
/// assert_eq(type_name::<(i32, &str)>(), "(i32, &str)");
/// assert_eq(type_name::<fn(i32) -> bool>(), "fn(i32) -> bool");
/// ```
pub fn type_name<T>() -> &str {
    // (The words of T's description: kind, size, align, name, its length.)
    let d = crate::intrinsics::type_desc::<T>() as *const usize;
    unsafe { crate::rt::str_from_raw(*d.add(3) as *const u8, *d.add(4)) }
}

/// Returns the name of the type of the pointed-to value, as
/// [`type_name`] does.
///
/// # Examples
///
/// ```
/// use std::any::type_name_of_val;
///
/// let x = 1.5;
/// assert_eq(type_name_of_val(&x), "f64");
/// let v = Vec::from(["a"]);
/// assert_eq(type_name_of_val(&v), "Vec<&str>");
/// ```
pub fn type_name_of_val<T>(x: &T) -> &str {
    type_name::<T>()
}
