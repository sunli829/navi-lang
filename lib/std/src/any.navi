//! Type names (Rust's std::any; TypeId and Any are not provided).

/// The name of T as written in source, e.g. "Vec<i32>" (Rust's includes
/// the module path).
pub fn type_name<T>() -> &str {
    // (The words of T's description: kind, size, align, name, its length.)
    let d = crate::intrinsics::type_desc::<T>() as *const usize;
    unsafe { crate::rt::str_from_raw(*d.add(3) as *const u8, *d.add(4)) }
}

/// The name of the type of x.
pub fn type_name_of_val<T>(x: &T) -> &str {
    type_name::<T>()
}
