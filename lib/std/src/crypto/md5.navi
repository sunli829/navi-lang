//! MD5 (RFC 1321), as the md-5 crate. Broken for collision resistance:
//! only for compatibility (checksums of old formats and protocols).
//!
//!     use std::crypto::md5::{Digest, Md5};
//!     let h = Md5::digest(b"abc"); // 90015098...

use super::{BlockCore, Buffer, le32, push_le32};
use crate::io;

pub use super::Digest;

static K: [u32; 64] = [
    0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee, 0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
    0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be, 0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
    0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa, 0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
    0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed, 0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
    0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c, 0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
    0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05, 0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
    0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039, 0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
    0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1, 0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391,
];

static S: [u32; 16] = [7, 12, 17, 22, 5, 9, 14, 20, 4, 11, 16, 23, 6, 10, 15, 21];

fn add(a: u32, b: u32) -> u32 {
    crate::intrinsics::wrapping_add(a, b)
}
fn rotl(x: u32, n: u32) -> u32 {
    x << n | x >> (32 - n)
}

#[derive(Clone)]
pub(crate) struct Core {
    h: [u32; 4],
}

impl BlockCore for Core {
    const BLOCK: usize = 64;
    fn compress(&mut self, data: &[u8], at: usize, n: usize) {
        let mut m = [0u32; 16];
        let mut a0 = self.h[0];
        let mut b0 = self.h[1];
        let mut c0 = self.h[2];
        let mut d0 = self.h[3];
        let mut blk = 0;
        while blk < n {
            let p = at + 64 * blk;
            let mut i = 0;
            while i < 16 {
                m[i] = le32(data, p + 4 * i);
                i += 1;
            }
            let mut a = a0;
            let mut b = b0;
            let mut c = c0;
            let mut d = d0;
            i = 0;
            while i < 64 {
                let mut f = 0u32;
                let mut g = 0;
                if i < 16 {
                    f = (b & c) | (!b & d);
                    g = i;
                } else if i < 32 {
                    f = (d & b) | (!d & c);
                    g = (5 * i + 1) & 15;
                } else if i < 48 {
                    f = b ^ c ^ d;
                    g = (3 * i + 5) & 15;
                } else {
                    f = c ^ (b | !d);
                    g = (7 * i) & 15;
                }
                let t = d;
                d = c;
                c = b;
                b = add(
                    b,
                    rotl(add(add(a, f), add(K[i], m[g])), S[(i >> 4) * 4 + (i & 3)]),
                );
                a = t;
                i += 1;
            }
            a0 = add(a0, a);
            b0 = add(b0, b);
            c0 = add(c0, c);
            d0 = add(d0, d);
            blk += 1;
        }
        self.h = [a0, b0, c0, d0];
    }
}

const IV: [u32; 4] = [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476];

/// MD5 (16 bytes of output).
#[derive(Clone)]
pub struct Md5 {
    b: Buffer<Core>,
}

impl Digest for Md5 {
    const OUTPUT_SIZE: usize = 16;
    const BLOCK_SIZE: usize = 64;
    fn new() -> Md5 {
        Md5 {
            b: Buffer::new(Core { h: IV }),
        }
    }
    fn update_bytes(&mut self, data: &[u8]) {
        self.b.update(data);
    }
    fn finalize_bytes(&mut self) -> Vec<u8> {
        self.b.pad(8, false);
        let mut out = Vec::with_capacity(16);
        let mut i = 0;
        while i < 4 {
            push_le32(&mut out, self.b.core.h[i]);
            i += 1;
        }
        out
    }
    fn reset(&mut self) {
        self.b = Buffer::new(Core { h: IV });
    }
}

impl io::Write for Md5 {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        self.b.update(buf);
        Ok(buf.len())
    }
    fn flush(&mut self) -> io::Result<()> {
        Ok(())
    }
}

impl Default for Md5 {
    fn default() -> Md5 {
        Md5::new()
    }
}
