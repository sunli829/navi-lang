//! The NIST P-384 curve (secp384r1), with the API of RustCrypto's p384
//! crate: `ecdsa::{VerifyingKey, Signature}` (verifying; `verify` hashes
//! with SHA-384) and `ecdh::{EphemeralSecret, PublicKey, SharedSecret}`.
//! The arithmetic is crypto::ec's.

use crate::sync::LazyLock;
use crate::crypto::ec::{Curve, CurveId};
use crate::crypto::Digest;
use crate::crypto::sha2::Sha384;

/// The curve, as a type parameter.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct NistP384;

static CURVE: LazyLock<Curve> = LazyLock::new(make);

fn make() -> Curve {
    Curve::new("P-384",
        "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffeffffffff0000000000000000ffffffff",
        "ffffffffffffffffffffffffffffffffffffffffffffffffc7634d81f4372ddf581a0db248b0a77aecec196accc52973",
        "b3312fa7e23ee7e4988e056be3f82d19181d9c6efe8141120314088f5013875ac656398d8a2ed19d2a85c8edd3ec2aef",
        "aa87ca22be8b05378eb1c71ef320ad746e1d3b628ba79b9859f741e082542a385502f25dbf55296c3a545e3872760ab7",
        "3617de4a96262c6f5d9e98bf9292dc29f8f41dbd289a147ce9da3113b5f0b8c00a60b1ce1d7e819d7a431d7c90ea0e5f")
}

impl CurveId for NistP384 {
    fn curve() -> &Curve { LazyLock::force(&CURVE) }
    fn hash(msg: &[u8]) -> Vec<u8> { Sha384::digest(msg) }
}

pub mod ecdsa {
    pub use crate::crypto::ec::Error;
    pub type Signature = crate::crypto::ec::Signature<super::NistP384>;
    pub type VerifyingKey = crate::crypto::ec::VerifyingKey<super::NistP384>;
}

pub mod ecdh {
    pub use crate::crypto::ec::{Error, SharedSecret};
    pub type EphemeralSecret = crate::crypto::ec::EphemeralSecret<super::NistP384>;
    pub type PublicKey = crate::crypto::ec::PublicKey<super::NistP384>;
}
