fn add32(a: u32, b: u32) -> u32 { crate::intrinsics::wrapping_add(a, b) }
fn add64(a: u64, b: u64) -> u64 { crate::intrinsics::wrapping_add(a, b) }
fn rotr32(x: u32, n: u32) -> u32 { x >> n | x << (32 - n) }
fn rotr64(x: u64, n: u64) -> u64 { x >> n | x << (64 - n) }

#[derive(Clone)]
pub(crate) struct Core256 { h: [u32; 8] }

impl BlockCore for Core256 {
    const BLOCK: usize = 64;
    fn compress(&mut self, data: &[u8], at: usize, n: usize) {
        let mut w = [0u32; 64];
        let mut a0 = self.h[0];
        let mut b0 = self.h[1];
        let mut c0 = self.h[2];
        let mut d0 = self.h[3];
        let mut e0 = self.h[4];
        let mut f0 = self.h[5];
        let mut g0 = self.h[6];
        let mut h0 = self.h[7];
        let mut blk = 0;
        while blk < n {
            let p = at + 64 * blk;
            let mut i = 0;
            while i < 16 {
                w[i] = be32(data, p + 4 * i);
                i += 1;
            }
            while i < 64 {
                let x = w[i - 15];
                let y = w[i - 2];
                let s0 = rotr32(x, 7) ^ rotr32(x, 18) ^ (x >> 3);
                let s1 = rotr32(y, 17) ^ rotr32(y, 19) ^ (y >> 10);
                w[i] = add32(add32(w[i - 16], s0), add32(w[i - 7], s1));
                i += 1;
            }
            let mut a = a0;
            let mut b = b0;
            let mut c = c0;
            let mut d = d0;
            let mut e = e0;
            let mut f = f0;
            let mut g = g0;
            let mut h = h0;
            i = 0;
            while i < 64 {
                let s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25);
                let ch = (e & f) ^ (!e & g);
                let t1 = add32(add32(add32(h, s1), add32(ch, K256[i])), w[i]);
                let s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22);
                let maj = (a & b) ^ (a & c) ^ (b & c);
                h = g;
                g = f;
                f = e;
                e = add32(d, t1);
                d = c;
                c = b;
                b = a;
                a = add32(t1, add32(s0, maj));
                i += 1;
            }
            a0 = add32(a0, a);
            b0 = add32(b0, b);
            c0 = add32(c0, c);
            d0 = add32(d0, d);
            e0 = add32(e0, e);
            f0 = add32(f0, f);
            g0 = add32(g0, g);
            h0 = add32(h0, h);
            blk += 1;
        }
        self.h = [a0, b0, c0, d0, e0, f0, g0, h0];
    }
}

#[derive(Clone)]
pub(crate) struct Core512 { h: [u64; 8] }

impl BlockCore for Core512 {
    const BLOCK: usize = 128;
    fn compress(&mut self, data: &[u8], at: usize, n: usize) {
        let mut w = [0u64; 80];
        let mut a0 = self.h[0];
        let mut b0 = self.h[1];
        let mut c0 = self.h[2];
        let mut d0 = self.h[3];
        let mut e0 = self.h[4];
        let mut f0 = self.h[5];
        let mut g0 = self.h[6];
        let mut h0 = self.h[7];
        let mut blk = 0;
        while blk < n {
            let p = at + 128 * blk;
            let mut i = 0;
            while i < 16 {
                w[i] = be64(data, p + 8 * i);
                i += 1;
            }
            while i < 80 {
                let x = w[i - 15];
                let y = w[i - 2];
                let s0 = rotr64(x, 1) ^ rotr64(x, 8) ^ (x >> 7);
                let s1 = rotr64(y, 19) ^ rotr64(y, 61) ^ (y >> 6);
                w[i] = add64(add64(w[i - 16], s0), add64(w[i - 7], s1));
                i += 1;
            }
            let mut a = a0;
            let mut b = b0;
            let mut c = c0;
            let mut d = d0;
            let mut e = e0;
            let mut f = f0;
            let mut g = g0;
            let mut h = h0;
            i = 0;
            while i < 80 {
                let s1 = rotr64(e, 14) ^ rotr64(e, 18) ^ rotr64(e, 41);
                let ch = (e & f) ^ (!e & g);
                let t1 = add64(add64(add64(h, s1), add64(ch, K512[i])), w[i]);
                let s0 = rotr64(a, 28) ^ rotr64(a, 34) ^ rotr64(a, 39);
                let maj = (a & b) ^ (a & c) ^ (b & c);
                h = g;
                g = f;
                f = e;
                e = add64(d, t1);
                d = c;
                c = b;
                b = a;
                a = add64(t1, add64(s0, maj));
                i += 1;
            }
            a0 = add64(a0, a);
            b0 = add64(b0, b);
            c0 = add64(c0, c);
            d0 = add64(d0, d);
            e0 = add64(e0, e);
            f0 = add64(f0, f);
            g0 = add64(g0, g);
            h0 = add64(h0, h);
            blk += 1;
        }
        self.h = [a0, b0, c0, d0, e0, f0, g0, h0];
    }
}

const IV224: [u32; 8] = [0xc1059ed8, 0x367cd507, 0x3070dd17, 0xf70e5939, 0xffc00b31, 0x68581511, 0x64f98fa7, 0xbefa4fa4];
const IV256: [u32; 8] = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];
const IV384: [u64; 8] = [
    0xcbbb9d5dc1059ed8, 0x629a292a367cd507, 0x9159015a3070dd17, 0x152fecd8f70e5939,
    0x67332667ffc00b31, 0x8eb44a8768581511, 0xdb0c2e0d64f98fa7, 0x47b5481dbefa4fa4,
];
const IV512: [u64; 8] = [
    0x6a09e667f3bcc908, 0xbb67ae8584caa73b, 0x3c6ef372fe94f82b, 0xa54ff53a5f1d36f1,
    0x510e527fade682d1, 0x9b05688c2b3e6c1f, 0x1f83d9abfb41bd6b, 0x5be0cd19137e2179,
];

fn out256(b: &mut Buffer<Core256>, words: usize) -> Vec<u8> {
    b.pad(8, true);
    let mut out = Vec::with_capacity(4 * words);
    let mut i = 0;
    while i < words { push_be32(&mut out, b.core.h[i]); i += 1; }
    out
}

fn out512(b: &mut Buffer<Core512>, bytes: usize) -> Vec<u8> {
    b.pad(16, true);
    let mut out = Vec::with_capacity(64);
    let mut i = 0;
    while i < 8 { push_be64(&mut out, b.core.h[i]); i += 1; }
    out.truncate(bytes);
    out
}

/// SHA-224: SHA-256 with another start and 28 bytes of output.
#[derive(Clone)]
pub struct Sha224 { b: Buffer<Core256> }

/// SHA-256 (32 bytes of output).
#[derive(Clone)]
pub struct Sha256 { b: Buffer<Core256> }

/// SHA-384: SHA-512 with another start and 48 bytes of output.
#[derive(Clone)]
pub struct Sha384 { b: Buffer<Core512> }

/// SHA-512 (64 bytes of output).
#[derive(Clone)]
pub struct Sha512 { b: Buffer<Core512> }

impl Digest for Sha224 {
    const OUTPUT_SIZE: usize = 28;
    const BLOCK_SIZE: usize = 64;
    fn new() -> Sha224 { Sha224 { b: Buffer::new(Core256 { h: IV224 }) } }
    fn update_bytes(&mut self, data: &[u8]) { self.b.update(data); }
    fn finalize_bytes(&mut self) -> Vec<u8> { out256(&mut self.b, 7) }
    fn reset(&mut self) { self.b = Buffer::new(Core256 { h: IV224 }); }
}

impl Digest for Sha256 {
    const OUTPUT_SIZE: usize = 32;
    const BLOCK_SIZE: usize = 64;
    fn new() -> Sha256 { Sha256 { b: Buffer::new(Core256 { h: IV256 }) } }
    fn update_bytes(&mut self, data: &[u8]) { self.b.update(data); }
    fn finalize_bytes(&mut self) -> Vec<u8> { out256(&mut self.b, 8) }
    fn reset(&mut self) { self.b = Buffer::new(Core256 { h: IV256 }); }
}

impl Digest for Sha384 {
    const OUTPUT_SIZE: usize = 48;
    const BLOCK_SIZE: usize = 128;
    fn new() -> Sha384 { Sha384 { b: Buffer::new(Core512 { h: IV384 }) } }
    fn update_bytes(&mut self, data: &[u8]) { self.b.update(data); }
    fn finalize_bytes(&mut self) -> Vec<u8> { out512(&mut self.b, 48) }
    fn reset(&mut self) { self.b = Buffer::new(Core512 { h: IV384 }); }
}

impl Digest for Sha512 {
    const OUTPUT_SIZE: usize = 64;
    const BLOCK_SIZE: usize = 128;
    fn new() -> Sha512 { Sha512 { b: Buffer::new(Core512 { h: IV512 }) } }
    fn update_bytes(&mut self, data: &[u8]) { self.b.update(data); }
    fn finalize_bytes(&mut self) -> Vec<u8> { out512(&mut self.b, 64) }
    fn reset(&mut self) { self.b = Buffer::new(Core512 { h: IV512 }); }
}

impl io::Write for Sha224 {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> { self.b.update(buf); Ok(buf.len()) }
    fn flush(&mut self) -> io::Result<()> { Ok(()) }
}

impl io::Write for Sha256 {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> { self.b.update(buf); Ok(buf.len()) }
    fn flush(&mut self) -> io::Result<()> { Ok(()) }
}

impl io::Write for Sha384 {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> { self.b.update(buf); Ok(buf.len()) }
    fn flush(&mut self) -> io::Result<()> { Ok(()) }
}

impl io::Write for Sha512 {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> { self.b.update(buf); Ok(buf.len()) }
    fn flush(&mut self) -> io::Result<()> { Ok(()) }
}

impl Default for Sha224 { fn default() -> Sha224 { Sha224::new() } }
impl Default for Sha256 { fn default() -> Sha256 { Sha256::new() } }
impl Default for Sha384 { fn default() -> Sha384 { Sha384::new() } }
impl Default for Sha512 { fn default() -> Sha512 { Sha512::new() } }
