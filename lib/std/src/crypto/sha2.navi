//! SHA-2 (FIPS 180-4): SHA-224, SHA-256, SHA-384 and SHA-512, as the sha2
//! crate.
//!
//!     use std::crypto::sha2::{Digest, Sha256};
//!     let h = Sha256::digest(b"abc"); // ba7816bf...

use crate::io;
use super::{be32, be64, push_be32, push_be64, BlockCore, Buffer};

pub use super::Digest;

