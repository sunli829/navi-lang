//! Comparisons that take the same time whatever the data, for secrets
//! such as MAC tags (as the `subtle` and `constant_time_eq` crates).
//!
//! # Examples
//!
//! ```
//! use std::crypto::subtle::{ConstantTimeEq, constant_time_eq};
//!
//! let tag = Vec::from([1u8, 2, 3]);
//! let expected = Vec::from([1u8, 2, 3]);
//! assert(constant_time_eq(&tag, &expected));
//! let same: bool = tag.ct_eq(&expected).into();
//! assert(same);
//! ```

/// Returns whether `a` and `b` are equal, looking at every byte.
///
/// Only different lengths end the comparison early; the time does not
/// depend on where the bytes differ.
///
/// # Examples
///
/// ```
/// use std::crypto::subtle::constant_time_eq;
///
/// assert(constant_time_eq(b"secret", b"secret"));
/// assert(!constant_time_eq(b"secret", b"secreT"));
/// assert(!constant_time_eq(b"secret", b"secrets"));
/// ```
pub fn constant_time_eq(a: &[u8], b: &[u8]) -> bool {
    if a.len() != b.len() {
        return false;
    }
    let mut d = 0u8;
    let mut i = 0;
    while i < a.len() {
        d = d | (a[i] ^ b[i]);
        i += 1;
    }
    // 0 when equal, without a data-dependent branch.
    ((d as u32 + 0xff) >> 8) == 0
}

/// A boolean as the byte 0 or 1, which the constant-time comparisons
/// return (`subtle`'s `Choice`); convert it with `bool::from`.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct Choice(u8);

impl Choice {
    /// Returns 1 for true and 0 for false.
    pub fn unwrap_u8(&self) -> u8 {
        self.0
    }
}

impl From<u8> for Choice {
    fn from(v: u8) -> Choice {
        Choice(v & 1)
    }
}

impl From<Choice> for bool {
    fn from(c: Choice) -> bool {
        c.0 != 0
    }
}

/// Equality in constant time, for byte slices and `Vec<u8>`.
pub trait ConstantTimeEq {
    /// Returns whether `self` and `other` are equal, as a [`Choice`],
    /// looking at every byte.
    fn ct_eq(&self, other: &Self) -> Choice;
}

impl ConstantTimeEq for [u8] {
    fn ct_eq(&self, other: &[u8]) -> Choice {
        Choice(if constant_time_eq(self, other) { 1 } else { 0 })
    }
}

impl ConstantTimeEq for Vec<u8> {
    fn ct_eq(&self, other: &Vec<u8>) -> Choice {
        Choice(if constant_time_eq(self.as_slice(), other.as_slice()) {
            1
        } else {
            0
        })
    }
}
