//! Cryptography: hashes, MACs, ciphers, signatures, key exchange and
//! X.509 certificates, with the APIs of the RustCrypto crates (and
//! ed25519-dalek, x25519-dalek, p256, p384, rsa).
//!
//! - [`md5::Md5`](crate::crypto::md5::Md5),
//!   [`sha1::Sha1`](crate::crypto::sha1::Sha1), [`sha2`](crate::crypto::sha2)'s
//!   `Sha224`, `Sha256`, `Sha384` and `Sha512`: hashes, used through the
//!   [`Digest`](crate::crypto::Digest) trait.
//! - [`hmac::Hmac<D>`](crate::crypto::hmac::Hmac): HMAC (RFC 2104) over
//!   any of them, used through the [`Mac`](crate::crypto::hmac::Mac)
//!   trait.
//! - [`hkdf::Hkdf<D>`](crate::crypto::hkdf::Hkdf): HKDF (RFC 5869).
//! - [`subtle`](crate::crypto::subtle): constant-time comparison.
//! - [`aes`](crate::crypto::aes): the AES block cipher;
//!   [`aes_gcm`](crate::crypto::aes_gcm) and
//!   [`chacha20poly1305`](crate::crypto::chacha20poly1305): authenticated
//!   encryption, used through [`aead`](crate::crypto::aead)'s traits.
//! - [`ed25519`](crate::crypto::ed25519): Ed25519 signatures;
//!   [`x25519`](crate::crypto::x25519): X25519 key exchange;
//!   [`p256`](crate::crypto::p256), [`p384`](crate::crypto::p384): ECDSA
//!   and ECDH on the NIST curves; [`rsa`](crate::crypto::rsa): RSA
//!   signatures (PKCS#1 v1.5, PSS).
//! - [`x509`](crate::crypto::x509): X.509 certificates and chain
//!   verification; [`der`](crate::crypto::der) reads DER;
//!   [`nat`](crate::crypto::nat) is constant-time modular arithmetic.
//!
//! Outputs are `Vec<u8>` (the crates return fixed-size `GenericArray`s),
//! and keys and nonces are `&[u8]` whose length is checked. Hashers
//! implement `io::Write`, so `io::copy(&mut file, &mut hasher)` hashes a
//! whole stream.
//!
//! # Security
//!
//! MD5 and SHA-1 are broken for collision resistance: use them only for
//! compatibility with existing formats. Compare MACs and other secrets in
//! constant time
//! ([`Mac::verify_slice`](crate::crypto::hmac::Mac::verify_slice),
//! [`subtle::constant_time_eq`](crate::crypto::subtle::constant_time_eq)),
//! never with `==`.
//!
//! # Examples
//!
//! ```
//! use std::crypto::sha2::{Digest, Sha256};
//! use std::crypto::hmac::{Hmac, Mac};
//! use std::hex;
//!
//! let mut h = Sha256::new();
//! h.update(b"hello ");
//! h.update("world");
//! let sum: Vec<u8> = h.finalize();
//! assert_eq(hex::encode(&sum), "b94d27b9934d3e08a52e52d7da7dabfac484efe37a5380ee9088f7ace2efcde9");
//! assert_eq(Sha256::digest(b"hello world"), sum);
//!
//! let mut mac = Hmac::<Sha256>::new_from_slice(b"key").unwrap();
//! mac.update(b"The quick brown fox jumps over the lazy dog");
//! let tag = mac.finalize();
//! assert_eq(hex::encode(&tag), "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8");
//! ```

pub mod aead;
pub mod aes;
pub mod aes_gcm;
pub mod chacha20poly1305;
pub mod der;
pub mod ec;
pub mod ed25519;
pub mod hkdf;
pub mod hmac;
pub mod md5;
pub mod nat;
pub(crate) mod nistec_p256;
pub(crate) mod nistec_p384;
pub mod p256;
pub mod p384;
pub mod rsa;
pub mod sha1;
pub mod sha2;
pub mod subtle;
pub mod x509;
pub mod x25519;

/// A cryptographic hash function.
///
/// Implementations provide `new`, `update_bytes`, `finalize_bytes` and
/// `reset`; the rest is the API of RustCrypto's `Digest`. Hashers are
/// values: cloning one forks the state.
///
/// # Examples
///
/// ```
/// use std::crypto::sha2::{Digest, Sha256};
/// use std::hex;
///
/// let mut h = Sha256::new();
/// h.update(b"ab");
/// let fork = h.clone();
/// h.update(b"c");
/// assert_eq(hex::encode(h.finalize()), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
/// assert_eq(fork.finalize(), Sha256::digest(b"ab"));
/// ```
pub trait Digest {
    /// The length of the hash in bytes.
    const OUTPUT_SIZE: usize;
    /// The length of the blocks the function works on (HMAC needs it).
    const BLOCK_SIZE: usize;

    /// Creates a hasher with no input.
    fn new() -> Self;
    /// Feeds bytes (the non-generic form of [`Digest::update`]).
    fn update_bytes(&mut self, data: &[u8]);
    /// Returns the hash of the input so far; the state is spent afterwards
    /// (call [`Digest::reset`] before reusing it). Prefer
    /// [`Digest::finalize`] or [`Digest::finalize_reset`].
    fn finalize_bytes(&mut self) -> Vec<u8>;
    /// Resets the hasher to its state with no input.
    fn reset(&mut self);

    /// Creates a hasher that has been fed `data`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::crypto::sha2::{Digest, Sha256};
    ///
    /// let h = Sha256::new_with_prefix(b"ab").chain_update(b"c");
    /// assert_eq(h.finalize(), Sha256::digest(b"abc"));
    /// ```
    fn new_with_prefix<T: AsRef<[u8]>>(data: T) -> Self {
        let mut h = Self::new();
        h.update_bytes(data.as_ref());
        h
    }

    /// Feeds `data` (anything that is `AsRef<[u8]>`) to the hasher.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::crypto::sha1::{Digest, Sha1};
    /// use std::hex;
    ///
    /// let mut h = Sha1::new();
    /// h.update("a");
    /// h.update(b"bc");
    /// assert_eq(hex::encode(h.finalize()), "a9993e364706816aba3e25717850c26c9cd0d89d");
    /// ```
    fn update<T: AsRef<[u8]>>(&mut self, data: T) {
        self.update_bytes(data.as_ref());
    }

    /// Feeds `data` and returns the hasher, for chains of calls.
    fn chain_update<T: AsRef<[u8]>>(mut self, data: T) -> Self {
        self.update_bytes(data.as_ref());
        self
    }

    /// Returns the hash of everything fed, consuming the hasher.
    fn finalize(mut self) -> Vec<u8> {
        self.finalize_bytes()
    }

    /// Writes the hash to `out`, consuming the hasher.
    ///
    /// # Panics
    ///
    /// If `out` is not [`Digest::output_size`] bytes long.
    fn finalize_into(mut self, out: &mut [u8]) {
        let h = self.finalize_bytes();
        out.copy_from_slice(h.as_slice());
    }

    /// Returns the hash of everything fed and resets the hasher, which can
    /// then hash something else.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::crypto::sha2::{Digest, Sha256};
    ///
    /// let mut h = Sha256::new();
    /// h.update(b"abc");
    /// let first = h.finalize_reset();
    /// h.update(b"abc");
    /// assert_eq(h.finalize(), first);
    /// ```
    fn finalize_reset(&mut self) -> Vec<u8> {
        let h = self.finalize_bytes();
        self.reset();
        h
    }

    /// Returns the length of the hash in bytes.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::crypto::sha2::{Digest, Sha256, Sha512};
    ///
    /// assert_eq(Sha256::output_size(), 32);
    /// assert_eq(Sha512::output_size(), 64);
    /// ```
    fn output_size() -> usize {
        Self::OUTPUT_SIZE
    }

    /// Returns the hash of `data`, in one call.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::crypto::md5::{Digest, Md5};
    /// use std::hex;
    ///
    /// assert_eq(hex::encode(Md5::digest(b"abc")), "900150983cd24fb0d6963f7d28e17f72");
    /// ```
    fn digest<T: AsRef<[u8]>>(data: T) -> Vec<u8> {
        let mut h = Self::new();
        h.update_bytes(data.as_ref());
        h.finalize_bytes()
    }
}

// --- Merkle-Damgard block buffering shared by the hashes ---------------------

/// A compression function over blocks of BLOCK_SIZE bytes.
pub(crate) trait BlockCore {
    const BLOCK: usize;
    /// Compresses n whole blocks of data starting at at.
    fn compress(&mut self, data: &[u8], at: usize, n: usize);
}

/// The state of a hash: its compression function, a partial block and
/// the length so far. Plain values throughout, so copies are independent.
#[derive(Clone)]
pub(crate) struct Buffer<C: BlockCore> {
    pub(crate) core: C,
    buf: [u8; 128],
    len: usize,
    total: u64,
}

impl<C: BlockCore> Buffer<C> {
    pub(crate) fn new(core: C) -> Buffer<C> {
        Buffer {
            core,
            buf: [0u8; 128],
            len: 0,
            total: 0,
        }
    }

    pub(crate) fn update(&mut self, data: &[u8]) {
        let bs = C::BLOCK;
        let n = data.len();
        self.total = crate::intrinsics::wrapping_add(self.total, n as u64);
        let mut i = 0;
        if self.len > 0 {
            while self.len < bs && i < n {
                self.buf[self.len] = data[i];
                self.len += 1;
                i += 1;
            }
            if self.len < bs {
                return;
            }
            self.core.compress(&self.buf, 0, 1);
            self.len = 0;
        }
        let blocks = (n - i) / bs;
        if blocks > 0 {
            self.core.compress(data, i, blocks);
            i += blocks * bs;
        }
        while i < n {
            self.buf[self.len] = data[i];
            self.len += 1;
            i += 1;
        }
    }

    /// Appends the padding: 0x80, zeros, and the length in bits in
    /// len_bytes bytes (big-endian, or little-endian for MD5).
    pub(crate) fn pad(&mut self, len_bytes: usize, big_endian: bool) {
        let bs = C::BLOCK;
        let bits = self.total << 3;
        let hi = self.total >> 61;
        self.buf[self.len] = 0x80;
        self.len += 1;
        if self.len > bs - len_bytes {
            while self.len < bs {
                self.buf[self.len] = 0;
                self.len += 1;
            }
            self.core.compress(&self.buf, 0, 1);
            self.len = 0;
        }
        while self.len < bs {
            self.buf[self.len] = 0;
            self.len += 1;
        }
        let mut k = 0;
        while k < 8 {
            if big_endian {
                self.buf[bs - 1 - k] = (bits >> (8 * k as u64)) as u8;
                if len_bytes == 16 {
                    self.buf[bs - 9 - k] = (hi >> (8 * k as u64)) as u8;
                }
            } else {
                self.buf[bs - 8 + k] = (bits >> (8 * k as u64)) as u8;
            }
            k += 1;
        }
        self.core.compress(&self.buf, 0, 1);
        self.len = 0;
    }
}

pub(crate) fn be32(b: &[u8], i: usize) -> u32 {
    (b[i] as u32) << 24 | (b[i + 1] as u32) << 16 | (b[i + 2] as u32) << 8 | b[i + 3] as u32
}

pub(crate) fn le32(b: &[u8], i: usize) -> u32 {
    (b[i + 3] as u32) << 24 | (b[i + 2] as u32) << 16 | (b[i + 1] as u32) << 8 | b[i] as u32
}

pub(crate) fn be64(b: &[u8], i: usize) -> u64 {
    (be32(b, i) as u64) << 32 | be32(b, i + 4) as u64
}

pub(crate) fn push_be32(out: &mut Vec<u8>, v: u32) {
    out.push((v >> 24) as u8);
    out.push((v >> 16) as u8);
    out.push((v >> 8) as u8);
    out.push(v as u8);
}

pub(crate) fn push_le32(out: &mut Vec<u8>, v: u32) {
    out.push(v as u8);
    out.push((v >> 8) as u8);
    out.push((v >> 16) as u8);
    out.push((v >> 24) as u8);
}

pub(crate) fn push_be64(out: &mut Vec<u8>, v: u64) {
    push_be32(out, (v >> 32) as u32);
    push_be32(out, v as u32);
}
