//! The AES block cipher (FIPS 197), with the API of RustCrypto's `aes`
//! crate: [`Aes128`](crate::crypto::aes::Aes128),
//! [`Aes192`](crate::crypto::aes::Aes192) and
//! [`Aes256`](crate::crypto::aes::Aes256), made with `new_from_slice(key)`,
//! encrypting and decrypting 16-byte blocks in place.
//!
//! A block cipher alone is not encryption: to encrypt messages use an AEAD
//! such as [`crate::crypto::aes_gcm`].
//!
//! With the CPU's AES instructions (arm64's crypto extension, x86's
//! AES-NI; aes_arm64.s, aes_amd64.s) encryption runs on them; otherwise in
//! software, with tables (as Go's generic code: lookups depend on the
//! data). Decryption is in software (GCM and CTR only encrypt).
//!
//! # Examples
//!
//! FIPS 197, appendix C.1:
//!
//! ```
//! use std::{crypto::aes::Aes128, hex};
//!
//! let key = hex::decode("000102030405060708090a0b0c0d0e0f").unwrap();
//! let c = Aes128::new_from_slice(key.as_slice()).unwrap();
//! let mut block = hex::decode("00112233445566778899aabbccddeeff").unwrap();
//! c.encrypt_block(block.as_mut_slice());
//! assert_eq(hex::encode(&block), "69c4e0d86a7b0430d8cdb78070b4c55a");
//! c.decrypt_block(block.as_mut_slice());
//! assert_eq(hex::encode(&block), "00112233445566778899aabbccddeeff");
//! ```

use crate::{crypto::aead::InvalidLength, sync::LazyLock};

const SBOX: [u8; 256] = [
    0x63, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5, 0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76,
    0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0,
    0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15,
    0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75,
    0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84,
    0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf,
    0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8,
    0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2,
    0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73,
    0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb,
    0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79,
    0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
    0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
    0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
    0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
    0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16,
];

// x * 2 in GF(2^8).
fn xtime(x: u8) -> u8 {
    let h = x >> 7;
    (x << 1) ^ (h * 0x1b)
}

// x * y in GF(2^8).
fn gmul(x: u8, y: u8) -> u8 {
    let mut a = x;
    let mut b = y;
    let mut r = 0u8;
    while b != 0 {
        if (b & 1) != 0 {
            r = r ^ a;
        }
        a = xtime(a);
        b = b >> 1;
    }
    r
}

// The encryption tables (te0..te3, 256 words each) and the inverse S-box.
struct Tables {
    te: Vec<u32>,
    inv: Vec<u8>,
}

fn make_tables() -> Tables {
    let mut te: Vec<u32> = Vec::with_capacity(1024);
    let mut i = 0;
    while i < 1024 {
        te.push(0);
        i += 1;
    }
    let mut inv: Vec<u8> = Vec::with_capacity(256);
    i = 0;
    while i < 256 {
        inv.push(0);
        i += 1;
    }
    i = 0;
    while i < 256 {
        let s = SBOX[i];
        let w = ((xtime(s) as u32) << 24)
            | ((s as u32) << 16)
            | ((s as u32) << 8)
            | (gmul(s, 3) as u32);
        te[i] = w;
        te[256 + i] = w.rotate_right(8);
        te[512 + i] = w.rotate_right(16);
        te[768 + i] = w.rotate_right(24);
        inv[s as usize] = i as u8;
        i += 1;
    }
    Tables { te, inv }
}

static TABLES: LazyLock<Tables> = LazyLock::new(make_tables);

// --- The CPU's instructions --------------------------------------------------

#[cfg(target_arch = "aarch64")]
#[asm]
fn aes_encrypt_blocks(xk: *const u8, rounds: usize, src: *const u8, dst: *mut u8, n: usize);

#[cfg(target_arch = "x86_64")]
#[asm]
fn aes_encrypt_blocks(xk: *const u8, rounds: usize, src: *const u8, dst: *mut u8, n: usize);

// ECX of CPUID leaf 1 (AES-NI: bit 25, PCLMULQDQ: bit 1).
#[cfg(target_arch = "x86_64")]
#[asm]
fn cpuid1_ecx() -> u64;

#[cfg(target_arch = "x86_64")]
fn detect() -> bool {
    (cpuid1_ecx() & (1 << 25)) != 0 && (cpuid1_ecx() & 2) != 0
}

// Apple's chips all have the crypto extension.
#[cfg(all(target_arch = "aarch64", target_os = "macos"))]
fn detect() -> bool {
    true
}

#[cfg(all(target_arch = "aarch64", target_os = "linux"))]
extern "C" {
    #[nonblocking]
    fn getauxval(t: u64) -> u64;
}

// AT_HWCAP: HWCAP_AES (bit 3) and HWCAP_PMULL (bit 4).
#[cfg(all(target_arch = "aarch64", target_os = "linux"))]
fn detect() -> bool {
    let caps = unsafe { getauxval(16) };
    (caps & (1 << 3)) != 0 && (caps & (1 << 4)) != 0
}

#[cfg(not(any(
    target_arch = "x86_64",
    all(target_arch = "aarch64", any(target_os = "macos", target_os = "linux"))
)))]
fn detect() -> bool {
    false
}

static HW: LazyLock<bool> = LazyLock::new(detect_now);

// (NAVI_DEBUG=noaes: the software code even with the instructions, to test it.)
fn detect_now() -> bool {
    if crate::rt::native::debug_on("noaes") {
        return false;
    }
    detect()
}

/// Whether AES and carry-less multiplication run on the CPU's instructions
/// (AES-NI and PCLMULQDQ, or arm64's AES and PMULL).
pub fn has_hardware() -> bool {
    *LazyLock::force(&HW)
}

// --- The cipher --------------------------------------------------------------

/// An expanded AES key of any size.
#[derive(Clone)]
pub struct Key {
    rounds: usize,
    /// The round keys as words (software).
    ek: Vec<u32>,
    /// The same as bytes (the instructions).
    xk: Vec<u8>,
    hw: bool,
}

fn be32(b: &[u8], i: usize) -> u32 {
    ((b[i] as u32) << 24) | ((b[i + 1] as u32) << 16) | ((b[i + 2] as u32) << 8) | (b[i + 3] as u32)
}

fn put32(b: &mut [u8], i: usize, v: u32) {
    b[i] = (v >> 24) as u8;
    b[i + 1] = (v >> 16) as u8;
    b[i + 2] = (v >> 8) as u8;
    b[i + 3] = v as u8;
}

fn sub_word(w: u32) -> u32 {
    ((SBOX[(w >> 24) as usize] as u32) << 24)
        | ((SBOX[((w >> 16) & 255) as usize] as u32) << 16)
        | ((SBOX[((w >> 8) & 255) as usize] as u32) << 8)
        | (SBOX[(w & 255) as usize] as u32)
}

impl Key {
    /// The expansion of a 16, 24 or 32-byte key.
    pub fn new(key: &[u8]) -> Result<Key, InvalidLength> {
        let nk = key.len() / 4;
        if key.len() != 16 && key.len() != 24 && key.len() != 32 {
            return Err(InvalidLength);
        }
        let rounds = nk + 6;
        let total = 4 * (rounds + 1);
        let mut ek: Vec<u32> = Vec::with_capacity(total);
        let mut i = 0;
        while i < nk {
            ek.push(be32(key, 4 * i));
            i += 1;
        }
        let mut rcon: u8 = 1;
        while i < total {
            let mut t = ek[i - 1];
            if i % nk == 0 {
                t = sub_word(t.rotate_left(8)) ^ ((rcon as u32) << 24);
                rcon = xtime(rcon);
            } else if nk > 6 && i % nk == 4 {
                t = sub_word(t);
            }
            ek.push(ek[i - nk] ^ t);
            i += 1;
        }
        let mut xk: Vec<u8> = Vec::with_capacity(4 * total);
        for w in ek.iter() {
            xk.push((*w >> 24) as u8);
            xk.push((*w >> 16) as u8);
            xk.push((*w >> 8) as u8);
            xk.push(*w as u8);
        }
        Ok(Key {
            rounds,
            ek,
            xk,
            hw: has_hardware(),
        })
    }

    /// The same key run in software even with the CPU's instructions (to
    /// compare the two).
    pub fn software(&self) -> Key {
        Key {
            rounds: self.rounds,
            ek: self.ek.clone(),
            xk: self.xk.clone(),
            hw: false,
        }
    }

    /// Whether it runs on the CPU's instructions.
    pub fn hardware(&self) -> bool {
        self.hw
    }

    /// The number of rounds (10, 12 or 14).
    pub fn rounds(&self) -> usize {
        self.rounds
    }

    /// The round keys as bytes (16 each, rounds + 1 of them).
    pub fn round_keys(&self) -> &[u8] {
        self.xk.as_slice()
    }

    /// Encrypts n = src.len() / 16 blocks from src to dst (as long).
    pub fn encrypt_blocks(&self, src: &[u8], dst: &mut [u8]) {
        let n = src.len() / 16;
        if dst.len() < 16 * n {
            crate::panic::panic("aes: the destination is too short");
        }
        if n == 0 {
            return;
        }
        if self.hw {
            hw_encrypt(self.xk.as_slice(), self.rounds, src, dst, n);
            return;
        }
        let t = LazyLock::force(&TABLES);
        let mut b = 0;
        while b < n {
            self.soft_encrypt(t, src, 16 * b, dst);
            b += 1;
        }
    }

    // One block at src[at..] to dst[at..], with the tables.
    fn soft_encrypt(&self, t: &Tables, src: &[u8], at: usize, dst: &mut [u8]) {
        let te = &t.te;
        let ek = &self.ek;
        let mut s0 = be32(src, at) ^ ek[0];
        let mut s1 = be32(src, at + 4) ^ ek[1];
        let mut s2 = be32(src, at + 8) ^ ek[2];
        let mut s3 = be32(src, at + 12) ^ ek[3];
        let mut k = 4;
        let mut r = 1;
        while r < self.rounds {
            let t0 = te[(s0 >> 24) as usize]
                ^ te[256 + ((s1 >> 16) & 255) as usize]
                ^ te[512 + ((s2 >> 8) & 255) as usize]
                ^ te[768 + (s3 & 255) as usize]
                ^ ek[k];
            let t1 = te[(s1 >> 24) as usize]
                ^ te[256 + ((s2 >> 16) & 255) as usize]
                ^ te[512 + ((s3 >> 8) & 255) as usize]
                ^ te[768 + (s0 & 255) as usize]
                ^ ek[k + 1];
            let t2 = te[(s2 >> 24) as usize]
                ^ te[256 + ((s3 >> 16) & 255) as usize]
                ^ te[512 + ((s0 >> 8) & 255) as usize]
                ^ te[768 + (s1 & 255) as usize]
                ^ ek[k + 2];
            let t3 = te[(s3 >> 24) as usize]
                ^ te[256 + ((s0 >> 16) & 255) as usize]
                ^ te[512 + ((s1 >> 8) & 255) as usize]
                ^ te[768 + (s2 & 255) as usize]
                ^ ek[k + 3];
            s0 = t0;
            s1 = t1;
            s2 = t2;
            s3 = t3;
            k += 4;
            r += 1;
        }
        let o0 = sub_word((s0 & 0xff000000) | (s1 & 0x00ff0000) | (s2 & 0x0000ff00) | (s3 & 0xff))
            ^ ek[k];
        let o1 = sub_word((s1 & 0xff000000) | (s2 & 0x00ff0000) | (s3 & 0x0000ff00) | (s0 & 0xff))
            ^ ek[k + 1];
        let o2 = sub_word((s2 & 0xff000000) | (s3 & 0x00ff0000) | (s0 & 0x0000ff00) | (s1 & 0xff))
            ^ ek[k + 2];
        let o3 = sub_word((s3 & 0xff000000) | (s0 & 0x00ff0000) | (s1 & 0x0000ff00) | (s2 & 0xff))
            ^ ek[k + 3];
        put32(dst, at, o0);
        put32(dst, at + 4, o1);
        put32(dst, at + 8, o2);
        put32(dst, at + 12, o3);
    }

    /// Encrypts a 16-byte block in place.
    pub fn encrypt_block(&self, block: &mut [u8]) {
        let src = block[..16].to_vec();
        self.encrypt_blocks(src.as_slice(), block);
    }

    /// Decrypts a 16-byte block in place (in software).
    pub fn decrypt_block(&self, block: &mut [u8]) {
        let inv = &LazyLock::force(&TABLES).inv;
        let mut s: [u8; 16] = [0; 16];
        let mut i = 0;
        while i < 16 {
            s[i] = block[i] ^ self.xk[16 * self.rounds + i];
            i += 1;
        }
        let mut r = self.rounds;
        while r > 0 {
            r -= 1;
            // InvShiftRows and InvSubBytes.
            let mut t: [u8; 16] = [0; 16];
            let mut c = 0;
            while c < 4 {
                let mut row = 0;
                while row < 4 {
                    t[4 * ((c + row) % 4) + row] = inv[s[4 * c + row] as usize];
                    row += 1;
                }
                c += 1;
            }
            // AddRoundKey.
            i = 0;
            while i < 16 {
                t[i] = t[i] ^ self.xk[16 * r + i];
                i += 1;
            }
            // InvMixColumns (not after the first round key).
            if r > 0 {
                c = 0;
                while c < 4 {
                    let a0 = t[4 * c];
                    let a1 = t[4 * c + 1];
                    let a2 = t[4 * c + 2];
                    let a3 = t[4 * c + 3];
                    t[4 * c] = gmul(a0, 14) ^ gmul(a1, 11) ^ gmul(a2, 13) ^ gmul(a3, 9);
                    t[4 * c + 1] = gmul(a0, 9) ^ gmul(a1, 14) ^ gmul(a2, 11) ^ gmul(a3, 13);
                    t[4 * c + 2] = gmul(a0, 13) ^ gmul(a1, 9) ^ gmul(a2, 14) ^ gmul(a3, 11);
                    t[4 * c + 3] = gmul(a0, 11) ^ gmul(a1, 13) ^ gmul(a2, 9) ^ gmul(a3, 14);
                    c += 1;
                }
            }
            s = t;
        }
        i = 0;
        while i < 16 {
            block[i] = s[i];
            i += 1;
        }
    }
}

#[cfg(any(target_arch = "aarch64", target_arch = "x86_64"))]
fn hw_encrypt(xk: &[u8], rounds: usize, src: &[u8], dst: &mut [u8], n: usize) {
    aes_encrypt_blocks(xk.as_ptr(), rounds, src.as_ptr(), dst.as_mut_ptr(), n);
}

#[cfg(not(any(target_arch = "aarch64", target_arch = "x86_64")))]
fn hw_encrypt(xk: &[u8], rounds: usize, src: &[u8], dst: &mut [u8], n: usize) {}

/// The AES-128 block cipher (16-byte keys, 16-byte blocks).
///
/// # Examples
///
/// FIPS 197, appendix C.1:
///
/// ```
/// use std::{crypto::aes::Aes128, hex};
///
/// let key = hex::decode("000102030405060708090a0b0c0d0e0f").unwrap();
/// let c = Aes128::new_from_slice(key.as_slice()).unwrap();
/// let mut block = hex::decode("00112233445566778899aabbccddeeff").unwrap();
/// c.encrypt_block(block.as_mut_slice());
/// assert_eq(hex::encode(&block), "69c4e0d86a7b0430d8cdb78070b4c55a");
/// ```
#[derive(Clone)]
pub struct Aes128 {
    key: Key,
}

impl Aes128 {
    /// Creates the cipher with a 16-byte key.
    ///
    /// # Errors
    ///
    /// [`InvalidLength`] for a key of another length.
    pub fn new_from_slice(key: &[u8]) -> Result<Aes128, InvalidLength> {
        if key.len() != 16 {
            return Err(InvalidLength);
        }
        Ok(Aes128 {
            key: Key::new(key)?,
        })
    }

    /// Encrypts a 16-byte block in place.
    pub fn encrypt_block(&self, block: &mut [u8]) {
        self.key.encrypt_block(block);
    }

    /// Decrypts a 16-byte block in place.
    pub fn decrypt_block(&self, block: &mut [u8]) {
        self.key.decrypt_block(block);
    }

    /// Encrypts whole blocks from src to dst.
    pub fn encrypt_blocks(&self, src: &[u8], dst: &mut [u8]) {
        self.key.encrypt_blocks(src, dst);
    }

    /// The expanded key.
    pub fn key(&self) -> &Key {
        &self.key
    }
}

/// The AES-192 block cipher (24-byte keys, 16-byte blocks).
///
/// # Examples
///
/// FIPS 197, appendix C.2:
///
/// ```
/// use std::{crypto::aes::Aes192, hex};
///
/// let key = hex::decode("000102030405060708090a0b0c0d0e0f1011121314151617").unwrap();
/// let c = Aes192::new_from_slice(key.as_slice()).unwrap();
/// let mut block = hex::decode("00112233445566778899aabbccddeeff").unwrap();
/// c.encrypt_block(block.as_mut_slice());
/// assert_eq(hex::encode(&block), "dda97ca4864cdfe06eaf70a0ec0d7191");
/// ```
#[derive(Clone)]
pub struct Aes192 {
    key: Key,
}

impl Aes192 {
    /// Creates the cipher with a 24-byte key.
    ///
    /// # Errors
    ///
    /// [`InvalidLength`] for a key of another length.
    pub fn new_from_slice(key: &[u8]) -> Result<Aes192, InvalidLength> {
        if key.len() != 24 {
            return Err(InvalidLength);
        }
        Ok(Aes192 {
            key: Key::new(key)?,
        })
    }

    /// Encrypts a 16-byte block in place.
    pub fn encrypt_block(&self, block: &mut [u8]) {
        self.key.encrypt_block(block);
    }

    /// Decrypts a 16-byte block in place.
    pub fn decrypt_block(&self, block: &mut [u8]) {
        self.key.decrypt_block(block);
    }

    /// Encrypts whole blocks from src to dst.
    pub fn encrypt_blocks(&self, src: &[u8], dst: &mut [u8]) {
        self.key.encrypt_blocks(src, dst);
    }

    /// The expanded key.
    pub fn key(&self) -> &Key {
        &self.key
    }
}

/// The AES-256 block cipher (32-byte keys, 16-byte blocks).
///
/// # Examples
///
/// FIPS 197, appendix C.3:
///
/// ```
/// use std::{crypto::aes::Aes256, hex};
///
/// let key =
///     hex::decode("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f").unwrap();
/// let c = Aes256::new_from_slice(key.as_slice()).unwrap();
/// let mut block = hex::decode("00112233445566778899aabbccddeeff").unwrap();
/// c.encrypt_block(block.as_mut_slice());
/// assert_eq(hex::encode(&block), "8ea2b7ca516745bfeafc49904b496089");
/// ```
#[derive(Clone)]
pub struct Aes256 {
    key: Key,
}

impl Aes256 {
    /// Creates the cipher with a 32-byte key.
    ///
    /// # Errors
    ///
    /// [`InvalidLength`] for a key of another length.
    pub fn new_from_slice(key: &[u8]) -> Result<Aes256, InvalidLength> {
        if key.len() != 32 {
            return Err(InvalidLength);
        }
        Ok(Aes256 {
            key: Key::new(key)?,
        })
    }

    /// Encrypts a 16-byte block in place.
    pub fn encrypt_block(&self, block: &mut [u8]) {
        self.key.encrypt_block(block);
    }

    /// Decrypts a 16-byte block in place.
    pub fn decrypt_block(&self, block: &mut [u8]) {
        self.key.decrypt_block(block);
    }

    /// Encrypts whole blocks from src to dst.
    pub fn encrypt_blocks(&self, src: &[u8], dst: &mut [u8]) {
        self.key.encrypt_blocks(src, dst);
    }

    /// The expanded key.
    pub fn key(&self) -> &Key {
        &self.key
    }
}
