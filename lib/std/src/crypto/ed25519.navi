//! Ed25519 signatures (RFC 8032), with the API of the `ed25519-dalek`
//! crate: [`SigningKey`](crate::crypto::ed25519::SigningKey) (from a
//! 32-byte seed), [`VerifyingKey`](crate::crypto::ed25519::VerifyingKey)
//! (32 bytes) and [`Signature`](crate::crypto::ed25519::Signature) (64
//! bytes); `sign` and `verify` are inherent methods (there are no
//! `Signer`/`Verifier` traits).
//!
//! Signing is deterministic and constant-time; keep the seed secret.
//!
//! # Examples
//!
//! ```
//! use std::{crypto::ed25519::SigningKey, rand::rngs::OsRng};
//!
//! let key = SigningKey::generate(&mut OsRng);
//! let sig = key.sign(b"hello");
//! let public = key.verifying_key();
//! assert(public.verify(b"hello", &sig).is_ok());
//! assert(public.verify(b"hellO", &sig).is_err());
//! ```
//!
//! # Implementation
//!
//! As Go's crypto/ed25519: the field is crypto::x25519's (five 51-bit
//! limbs), points in extended coordinates with the complete formulas
//! (Hisil et al. 2008, a = -1) and Go's completed and projective forms
//! between them, k * B on signed 4-bit digits over the generator's affine
//! multiples (a table built on first use; constant-time lookups, in
//! assembly on aarch64 and x86_64), verification's `[k](-A) + [S]B` with the
//! doublings shared on width-5 and width-8 non-adjacent forms, the scalars
//! mod L crypto::nat's. Verification is Go's: S below L, the sum encoded
//! equal to R (non-canonical encodings of A and R accepted as Go does).

use crate::{
    crypto::{Digest, nat::Modulus, sha2::Sha512, x25519::Fe},
    fmt,
    rand::RngCore,
    sync::LazyLock,
};

/// The length of a secret key (the seed) in bytes.
pub const SECRET_KEY_LENGTH: usize = 32;
/// The length of a public key in bytes.
pub const PUBLIC_KEY_LENGTH: usize = 32;
/// The length of a signature in bytes.
pub const SIGNATURE_LENGTH: usize = 64;

/// A signature or key that does not check out.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct SignatureError;

impl fmt::Display for SignatureError {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        f.write_str("signature error")
    }
}

// -d / 121666 (the curve's d) and 2d.
const D: Fe = Fe {
    l: [
        929955233495203,
        466365720129213,
        1662059464998953,
        2033849074728123,
        1442794654840575,
    ],
};
const D2: Fe = Fe {
    l: [
        1859910466990425,
        932731440258426,
        1072319116312658,
        1815898335770999,
        633789495995903,
    ],
};

// A point in extended coordinates: x = X/Z, y = Y/Z, xy = T/Z.
#[derive(Clone)]
struct Point {
    x: Fe,
    y: Fe,
    z: Fe,
    t: Fe,
}

fn identity() -> Point {
    Point {
        x: Fe::zero(),
        y: Fe::one(),
        z: Fe::one(),
        t: Fe::zero(),
    }
}

fn generator() -> Point {
    Point {
        x: Fe {
            l: [
                1738742601995546,
                1146398526822698,
                2070867633025821,
                562264141797630,
                587772402128613,
            ],
        },
        y: Fe {
            l: [
                1801439850948184,
                1351079888211148,
                450359962737049,
                900719925474099,
                1801439850948198,
            ],
        },
        z: Fe::one(),
        t: Fe {
            l: [
                1841354044333475,
                16398895984059,
                755974180946558,
                900171276175154,
                1821297809914039,
            ],
        },
    }
}

// Go's other representations (edwards25519/edwards25519.go): the
// completed point an addition or doubling gives (x = X/Z, y = Y/T), the
// projective point a doubling takes (x = X/Z, y = Y/Z), and the addends
// with y + x, y - x and 2dT ready (cached: Z kept; affine: Z = 1).
struct P1xP1 {
    x: Fe,
    y: Fe,
    z: Fe,
    t: Fe,
}

struct P2 {
    x: Fe,
    y: Fe,
    z: Fe,
}

#[derive(Clone)]
struct Cached {
    yplusx: Fe,
    yminusx: Fe,
    z: Fe,
    t2d: Fe,
}

#[derive(Clone)]
struct Affine {
    yplusx: Fe,
    yminusx: Fe,
    t2d: Fe,
}

fn p1_zero() -> P1xP1 {
    P1xP1 {
        x: Fe::zero(),
        y: Fe::zero(),
        z: Fe::zero(),
        t: Fe::zero(),
    }
}

fn cached_zero() -> Cached {
    Cached {
        yplusx: Fe::one(),
        yminusx: Fe::one(),
        z: Fe::one(),
        t2d: Fe::zero(),
    }
}

fn affine_zero() -> Affine {
    Affine {
        yplusx: Fe::one(),
        yminusx: Fe::one(),
        t2d: Fe::zero(),
    }
}

fn p3_from_p1(v: &mut Point, p: &P1xP1) {
    v.x.set_mul(&p.x, &p.t);
    v.y.set_mul(&p.y, &p.z);
    v.z.set_mul(&p.z, &p.t);
    v.t.set_mul(&p.x, &p.y);
}

fn p2_from_p1(v: &mut P2, p: &P1xP1) {
    v.x.set_mul(&p.x, &p.t);
    v.y.set_mul(&p.y, &p.z);
    v.z.set_mul(&p.z, &p.t);
}

fn cached_from(v: &mut Cached, p: &Point) {
    v.yplusx.set_add(&p.y, &p.x);
    v.yminusx.set_sub(&p.y, &p.x);
    v.z = p.z;
    v.t2d.set_mul(&p.t, &D2);
}

fn affine_from(p: &Point) -> Affine {
    let zi = p.z.invert();
    let mut v = affine_zero();
    v.yplusx.set_add(&p.y, &p.x);
    v.yminusx.set_sub(&p.y, &p.x);
    v.t2d.set_mul(&p.t, &D2);
    v.yplusx.set_mul(&v.yplusx, &zi);
    v.yminusx.set_mul(&v.yminusx, &zi);
    v.t2d.set_mul(&v.t2d, &zi);
    v
}

// v = p + q, or p - q with neg (q's y + x and y - x swapped, 2dT negated):
// add-2008-hwcd-3 (a = -1), complete.
fn p1_add(v: &mut P1xP1, p: &Point, q: &Cached, neg: bool) {
    let mut pp = Fe::zero();
    let mut mm = Fe::zero();
    let mut tt = Fe::zero();
    let mut zz = Fe::zero();
    pp.set_add(&p.y, &p.x);
    mm.set_sub(&p.y, &p.x);
    if neg {
        pp.set_mul(&pp, &q.yminusx);
        mm.set_mul(&mm, &q.yplusx);
    } else {
        pp.set_mul(&pp, &q.yplusx);
        mm.set_mul(&mm, &q.yminusx);
    }
    tt.set_mul(&p.t, &q.t2d);
    zz.set_mul(&p.z, &q.z);
    zz.set_add(&zz, &zz);
    v.x.set_sub(&pp, &mm);
    v.y.set_add(&pp, &mm);
    if neg {
        v.z.set_sub(&zz, &tt);
        v.t.set_add(&zz, &tt);
    } else {
        v.z.set_add(&zz, &tt);
        v.t.set_sub(&zz, &tt);
    }
}

// The same with q's Z = 1 (madd-2008-hwcd-3).
fn p1_add_affine(v: &mut P1xP1, p: &Point, q: &Affine, neg: bool) {
    let mut pp = Fe::zero();
    let mut mm = Fe::zero();
    let mut tt = Fe::zero();
    let mut zz = Fe::zero();
    pp.set_add(&p.y, &p.x);
    mm.set_sub(&p.y, &p.x);
    if neg {
        pp.set_mul(&pp, &q.yminusx);
        mm.set_mul(&mm, &q.yplusx);
    } else {
        pp.set_mul(&pp, &q.yplusx);
        mm.set_mul(&mm, &q.yminusx);
    }
    tt.set_mul(&p.t, &q.t2d);
    zz.set_add(&p.z, &p.z);
    v.x.set_sub(&pp, &mm);
    v.y.set_add(&pp, &mm);
    if neg {
        v.z.set_sub(&zz, &tt);
        v.t.set_add(&zz, &tt);
    } else {
        v.z.set_add(&zz, &tt);
        v.t.set_sub(&zz, &tt);
    }
}

// v = 2p (dbl-2008-hwcd, a = -1).
fn p1_double(v: &mut P1xP1, p: &P2) {
    let mut xx = Fe::zero();
    let mut yy = Fe::zero();
    let mut zz = Fe::zero();
    let mut s = Fe::zero();
    xx.set_square(&p.x);
    yy.set_square(&p.y);
    zz.set_square(&p.z);
    zz.set_add(&zz, &zz);
    s.set_add(&p.x, &p.y);
    s.set_square(&s);
    v.y.set_add(&yy, &xx);
    v.z.set_sub(&yy, &xx);
    v.x.set_sub(&s, &v.y);
    v.t.set_sub(&zz, &v.z);
}

fn add(p: &Point, q: &Point) -> Point {
    let mut c = cached_zero();
    cached_from(&mut c, q);
    let mut t = p1_zero();
    p1_add(&mut t, p, &c, false);
    let mut r = identity();
    p3_from_p1(&mut r, &t);
    r
}

fn double(p: &Point) -> Point {
    let mut t = p1_zero();
    p1_double(
        &mut t,
        &P2 {
            x: p.x,
            y: p.y,
            z: p.z,
        },
    );
    let mut r = identity();
    p3_from_p1(&mut r, &t);
    r
}

fn neg(p: &Point) -> Point {
    Point {
        x: p.x.neg(),
        y: p.y,
        z: p.z,
        t: p.t.neg(),
    }
}

// The 32-byte encoding: y, the sign of x in the top bit.
fn encode(p: &Point) -> [u8; 32] {
    let zi = p.z.invert();
    let x = p.x.mul(&zi);
    let y = p.y.mul(&zi);
    let mut b = y.to_bytes();
    b[31] = b[31] | ((x.is_negative() as u8) << 7);
    b
}

// The point of an encoding, if on the curve (Go's Point.SetBytes: y need
// not be reduced; x = 0 with the sign bit set is accepted).
fn decode(b: &[u8]) -> Option<Point> {
    if b.len() != 32 {
        return None;
    }
    let y = Fe::from_bytes(b);
    let y2 = y.square();
    let u = y2.sub(&Fe::one());
    let v = y2.mul(&D).add(&Fe::one());
    let (x, ok) = Fe::sqrt_ratio(&u, &v);
    if ok == 0 {
        return None;
    }
    let x = Fe::choose((b[31] >> 7) as u64, &x.neg(), &x);
    let t = x.mul(&y);
    Some(Point {
        x,
        y,
        z: Fe::one(),
        t,
    })
}

// The generator's multiples (Go's basepointTable): for i of 32, j of 8,
// (j + 1) * 256^i * B at 8 * i + j.
static BASE: LazyLock<Vec<Affine>> = LazyLock::new(base_table);

fn base_table() -> Vec<Affine> {
    let mut out: Vec<Affine> = Vec::with_capacity(256);
    let mut g = generator();
    let mut i = 0;
    while i < 32 {
        let mut acc = g;
        let mut j = 0;
        while j < 8 {
            out.push(affine_from(&acc));
            acc = add(&acc, &g);
            j += 1;
        }
        j = 0;
        while j < 8 {
            g = double(&g);
            j += 1;
        }
        i += 1;
    }
    out
}

// The odd multiples B, 3B, ..., 127B (Go's basepointNafTable).
static BASE_NAF: LazyLock<Vec<Affine>> = LazyLock::new(base_naf_table);

fn base_naf_table() -> Vec<Affine> {
    let mut out: Vec<Affine> = Vec::with_capacity(64);
    let g = generator();
    let g2 = double(&g);
    let mut acc = g;
    let mut j = 0;
    while j < 64 {
        out.push(affine_from(&acc));
        acc = add(&acc, &g2);
        j += 1;
    }
    out
}

// table[idx - 1] (idx 0: the identity), negated with neg 1, every entry
// read. In assembly on aarch64, x86_64 (ed25519_<arch>.s).
#[cfg(any(target_arch = "aarch64", target_arch = "x86_64"))]
#[asm]
fn lookup_affine(table: *const Affine, idx: u64, neg: u64) -> Affine;

// v = x * table's point (x in -8..=8; table the 8 multiples), in constant
// time (Go's affineLookupTable.SelectInto).
#[cfg(any(target_arch = "aarch64", target_arch = "x86_64"))]
fn select_affine(v: &mut Affine, table: &[Affine], x: i64) {
    let xm = x >> 63;
    *v = lookup_affine(table.as_ptr(), ((x + xm) ^ xm) as u64, (xm & 1) as u64);
}

#[cfg(not(any(target_arch = "aarch64", target_arch = "x86_64")))]
fn select_affine(v: &mut Affine, table: &[Affine], x: i64) {
    let xm = x >> 63;
    let xabs = ((x + xm) ^ xm) as u64;
    *v = affine_zero();
    let mut j = 0;
    while j < 8 {
        let d = (j + 1) as u64 ^ xabs;
        let m = (((d | d.wrapping_neg()) >> 63) ^ 1).wrapping_neg();
        let e = &table[j];
        let mut i = 0;
        while i < 5 {
            v.yplusx.l[i] = v.yplusx.l[i] ^ ((v.yplusx.l[i] ^ e.yplusx.l[i]) & m);
            v.yminusx.l[i] = v.yminusx.l[i] ^ ((v.yminusx.l[i] ^ e.yminusx.l[i]) & m);
            v.t2d.l[i] = v.t2d.l[i] ^ ((v.t2d.l[i] ^ e.t2d.l[i]) & m);
            i += 1;
        }
        j += 1;
    }
    // Negated: y + x and y - x swapped, 2dT negated.
    let m = xm as u64;
    let nt = v.t2d.neg();
    let mut i = 0;
    while i < 5 {
        let s = (v.yplusx.l[i] ^ v.yminusx.l[i]) & m;
        v.yplusx.l[i] = v.yplusx.l[i] ^ s;
        v.yminusx.l[i] = v.yminusx.l[i] ^ s;
        v.t2d.l[i] = v.t2d.l[i] ^ ((v.t2d.l[i] ^ nt.l[i]) & m);
        i += 1;
    }
}

// k * B (k 32 little-endian bytes, below 2^255), in constant time (Go's
// ScalarBaseMult): signed 4-bit digits, the odd ones' multiples added,
// times 16, the even ones'.
fn base_mult(k: &[u8]) -> Point {
    let t = LazyLock::force(&BASE);
    let mut digits: [i64; 64] = [0; 64];
    let mut i = 0;
    while i < 32 {
        digits[2 * i] = (k[i] & 15) as i64;
        digits[2 * i + 1] = (k[i] >> 4) as i64;
        i += 1;
    }
    i = 0;
    while i < 63 {
        let c = (digits[i] + 8) >> 4;
        digits[i] -= c << 4;
        digits[i + 1] += c;
        i += 1;
    }
    let mut v = identity();
    let mut m = affine_zero();
    let mut p1 = p1_zero();
    i = 1;
    while i < 64 {
        select_affine(&mut m, &t[8 * (i / 2)..8 * (i / 2) + 8], digits[i]);
        p1_add_affine(&mut p1, &v, &m, false);
        p3_from_p1(&mut v, &p1);
        i += 2;
    }
    let mut p2 = P2 {
        x: v.x,
        y: v.y,
        z: v.z,
    };
    i = 0;
    while i < 4 {
        p1_double(&mut p1, &p2);
        if i < 3 {
            p2_from_p1(&mut p2, &p1);
        }
        i += 1;
    }
    p3_from_p1(&mut v, &p1);
    i = 0;
    while i < 64 {
        select_affine(&mut m, &t[8 * (i / 2)..8 * (i / 2) + 8], digits[i]);
        p1_add_affine(&mut p1, &v, &m, false);
        p3_from_p1(&mut v, &p1);
        i += 2;
    }
    v
}

// The width-w non-adjacent form of k (32 little-endian bytes, below
// 2^255): odd digits below 2^(w-1) in magnitude, w - 1 zeros after each
// (Go's Scalar.nonAdjacentForm).
fn naf(k: &[u8], w: u64) -> [i64; 256] {
    let mut d: [u64; 5] = [0; 5];
    let mut i = 0;
    while i < 32 {
        d[i / 8] = d[i / 8] | ((k[i] as u64) << (8 * (i % 8)) as u64);
        i += 1;
    }
    let mut out: [i64; 256] = [0; 256];
    let width = 1u64 << w;
    let mut pos = 0u64;
    let mut carry = 0u64;
    while pos < 256 {
        let iu = (pos / 64) as usize;
        let ib = pos % 64;
        let bits = if ib < 64 - w {
            d[iu] >> ib
        } else {
            (d[iu] >> ib) | (d[iu + 1] << (64 - ib))
        };
        let window = carry + (bits & (width - 1));
        if window & 1 == 0 {
            pos += 1;
            continue;
        }
        if window < width / 2 {
            carry = 0;
            out[pos as usize] = window as i64;
        } else {
            carry = 1;
            out[pos as usize] = window as i64 - width as i64;
        }
        pos += w;
    }
    out
}

// a * p + b * B in variable time (public scalars; Go's
// VarTimeDoubleScalarBaseMult): the doublings shared, a's width-5 and b's
// width-8 non-adjacent forms, p's odd multiples to 15p made here.
fn double_mult(a: &[u8], p: &Point, b: &[u8]) -> Point {
    let bt = LazyLock::force(&BASE_NAF);
    let mut at: Vec<Cached> = Vec::with_capacity(8);
    let mut c = cached_zero();
    cached_from(&mut c, p);
    at.push(c.clone());
    let p2 = double(p);
    let mut acc = *p;
    let mut t = p1_zero();
    let mut j = 1;
    while j < 8 {
        p1_add(&mut t, &p2, &at[j - 1], false);
        p3_from_p1(&mut acc, &t);
        cached_from(&mut c, &acc);
        at.push(c.clone());
        j += 1;
    }
    let an = naf(a, 5);
    let bn = naf(b, 8);
    let mut i = 255;
    while i > 0 && an[i] == 0 && bn[i] == 0 {
        i -= 1;
    }
    let mut v = identity();
    let mut q = P2 {
        x: Fe::zero(),
        y: Fe::one(),
        z: Fe::one(),
    };
    loop {
        p1_double(&mut t, &q);
        let x = an[i];
        if x != 0 {
            p3_from_p1(&mut v, &t);
            if x > 0 {
                p1_add(&mut t, &v, &at[(x / 2) as usize], false);
            } else {
                p1_add(&mut t, &v, &at[(-x / 2) as usize], true);
            }
        }
        let y = bn[i];
        if y != 0 {
            p3_from_p1(&mut v, &t);
            if y > 0 {
                p1_add_affine(&mut t, &v, &bt[(y / 2) as usize], false);
            } else {
                p1_add_affine(&mut t, &v, &bt[(-y / 2) as usize], true);
            }
        }
        p2_from_p1(&mut q, &t);
        if i == 0 {
            break;
        }
        i -= 1;
    }
    // From P2: (XZ, YZ, Z^2, XY).
    v.x.set_mul(&q.x, &q.z);
    v.y.set_mul(&q.y, &q.z);
    v.z.set_square(&q.z);
    v.t.set_mul(&q.x, &q.y);
    v
}

// --- Scalars mod L (as little-endian bytes outside, nat limbs inside) ---

// L = 2^252 + 27742317777372353535851937790883648493, the group order.
static L: LazyLock<Modulus> = LazyLock::new(make_l);

fn make_l() -> Modulus {
    Modulus::new(&[
        0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x00, 0x14, 0xde, 0xf9, 0xde, 0xa2, 0xf7, 0x9c, 0xd6, 0x58, 0x12, 0x63, 0x1a, 0x5c, 0xf5,
        0xd3, 0xed,
    ])
}

// Little-endian bytes (32 at most) as 4 limbs.
fn limbs(le: &[u8]) -> Vec<u64> {
    let mut out: Vec<u64> = Vec::new();
    out.resize(4, 0);
    let mut i = 0;
    while i < le.len() {
        out[i / 8] = out[i / 8] | ((le[i] as u64) << (8 * (i % 8)) as u64);
        i += 1;
    }
    out
}

fn limbs_le(x: &[u64]) -> [u8; 32] {
    let mut out: [u8; 32] = [0; 32];
    let mut i = 0;
    while i < 32 {
        out[i] = (x[i / 8] >> (8 * (i % 8)) as u64) as u8;
        i += 1;
    }
    out
}

// A 64-byte little-endian number (a SHA-512 digest) mod L: lo + hi * 2^256,
// each turned by Montgomery multiplications by R^2 (inputs below R, so the
// products reduce).
fn reduce64(b: &[u8]) -> Vec<u64> {
    let l = LazyLock::force(&L);
    let lo = limbs(&b[..32]);
    let hi = limbs(&b[32..]);
    let rr = l.to_mont(&l.one());
    // hi * R = mont(hi, R^2); lo mod L = mont(mont(lo, R^2), 1).
    let hi_r = l.mont_mul(&hi, &rr);
    let lo_m = l.from_mont(&l.mont_mul(&lo, &rr));
    l.add(&lo_m, &hi_r)
}

// a * b + c mod L (all below L).
fn mul_add(a: &[u64], b: &[u64], c: &[u64]) -> Vec<u64> {
    let l = LazyLock::force(&L);
    l.add(&l.mont_mul(&l.to_mont(a), b), c)
}

fn sha512(parts: &[&[u8]]) -> Vec<u8> {
    let mut h = Sha512::new();
    for p in parts.iter() {
        h.update_bytes(*p);
    }
    h.finalize_bytes()
}

/// An Ed25519 signature: R (32 bytes) and S (32 bytes).
///
/// # Examples
///
/// ```
/// use std::crypto::ed25519::Signature;
///
/// let sig = Signature::from_bytes(&[0u8; 64]);
/// assert_eq(sig.to_bytes(), [0u8; 64]);
/// assert(Signature::from_slice(&[0u8; 63]).is_err());
/// ```
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct Signature {
    b: [u8; 64],
}

impl Signature {
    /// The length of a signature in bytes.
    pub const BYTE_SIZE: usize = 64;

    /// Makes a signature of its 64 bytes (R, then S); whether it is valid
    /// is checked when verifying.
    pub fn from_bytes(b: &[u8; 64]) -> Signature {
        Signature { b: *b }
    }

    /// Makes a signature of a 64-byte slice.
    ///
    /// # Errors
    ///
    /// [`SignatureError`] if `b` is not 64 bytes long.
    pub fn from_slice(b: &[u8]) -> Result<Signature, SignatureError> {
        if b.len() != 64 {
            return Err(SignatureError);
        }
        let mut s: [u8; 64] = [0; 64];
        s.copy_from_slice(b);
        Ok(Signature { b: s })
    }

    /// Returns the signature's 64 bytes.
    pub fn to_bytes(&self) -> [u8; 64] {
        self.b
    }

    /// Returns the signature's 64 bytes as a `Vec`.
    pub fn to_vec(&self) -> Vec<u8> {
        self.b.to_vec()
    }

    /// Returns R, the first 32 bytes (an encoded point).
    pub fn r_bytes(&self) -> &[u8] {
        &self.b[..32]
    }

    /// Returns S, the last 32 bytes (a scalar, little-endian).
    pub fn s_bytes(&self) -> &[u8] {
        &self.b[32..]
    }
}

/// An Ed25519 public key: the 32-byte encoding of the point A.
///
/// # Examples
///
/// RFC 8032, section 7.1, test 1 (the empty message):
///
/// ```
/// use std::crypto::ed25519::{Signature, VerifyingKey};
/// use std::hex::FromHex;
///
/// let public = <[u8; 32]>::from_hex("d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a").unwrap();
/// let sig = <[u8; 64]>::from_hex("e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b").unwrap();
/// let key = VerifyingKey::from_bytes(&public).unwrap();
/// assert(key.verify(b"", &Signature::from_bytes(&sig)).is_ok());
/// assert(key.verify(b"x", &Signature::from_bytes(&sig)).is_err());
/// ```
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct VerifyingKey {
    b: [u8; 32],
}

impl VerifyingKey {
    /// Makes a public key of its 32-byte encoding.
    ///
    /// # Errors
    ///
    /// [`SignatureError`] if the bytes do not encode a point of the curve.
    pub fn from_bytes(b: &[u8; 32]) -> Result<VerifyingKey, SignatureError> {
        match decode(b) {
            Some(_) => Ok(VerifyingKey { b: *b }),
            None => Err(SignatureError),
        }
    }

    /// Returns the key's 32-byte encoding.
    pub fn to_bytes(&self) -> [u8; 32] {
        self.b
    }

    /// Returns a reference to the 32-byte encoding.
    pub fn as_bytes(&self) -> &[u8; 32] {
        &self.b
    }

    /// Checks that `sig` is this key's signature of `msg` (as Go's
    /// `ed25519.Verify`).
    ///
    /// # Errors
    ///
    /// [`SignatureError`] if it is not.
    pub fn verify(&self, msg: &[u8], sig: &Signature) -> Result<(), SignatureError> {
        let r = &sig.b[..32];
        let s = &sig.b[32..];
        if (s[31] & 224) != 0 {
            return Err(SignatureError);
        }
        let a = match decode(&self.b) {
            Some(a) => a,
            None => return Err(SignatureError),
        };
        // S < L (canonical).
        let l = LazyLock::force(&L);
        let mut sbe: Vec<u8> = s.to_vec();
        sbe.reverse();
        if l.from_be(&sbe).is_none() {
            return Err(SignatureError);
        }
        let k = limbs_le(&reduce64(&sha512(&[r, &self.b, msg])));
        // [k](-A) + [S]B == R
        let rp = double_mult(&k, &neg(&a), s);
        if encode(&rp)[..] != *r {
            return Err(SignatureError);
        }
        Ok(())
    }

    /// The same as [`VerifyingKey::verify`]: its checks (S below L) are
    /// already those of ed25519-dalek's `verify_strict` that matter.
    ///
    /// # Errors
    ///
    /// [`SignatureError`] if `sig` is not this key's signature of `msg`.
    pub fn verify_strict(&self, msg: &[u8], sig: &Signature) -> Result<(), SignatureError> {
        self.verify(msg, sig)
    }
}

/// An Ed25519 private key: the 32-byte seed, its expanded scalar and
/// prefix, and the public key.
///
/// # Examples
///
/// RFC 8032, section 7.1, test 1:
///
/// ```
/// use std::{
///     crypto::ed25519::SigningKey,
///     hex::{self, FromHex},
/// };
///
/// let seed =
///     <[u8; 32]>::from_hex("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60")
///         .unwrap();
/// let key = SigningKey::from_bytes(&seed);
/// assert_eq(
///     hex::encode(key.verifying_key().to_bytes()),
///     "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a",
/// );
/// let sig = key.sign(b"");
/// assert_eq(
///     hex::encode(&sig.to_bytes()[..32]),
///     "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e06522490155",
/// );
/// ```
///
/// # Security
///
/// The seed is the secret: whoever has it can sign.
#[derive(Clone)]
pub struct SigningKey {
    seed: [u8; 32],
    a: [u8; 32],
    prefix: [u8; 32],
    public: VerifyingKey,
}

impl SigningKey {
    /// Makes the key of a 32-byte seed (RFC 8032 section 5.1.5).
    pub fn from_bytes(seed: &[u8; 32]) -> SigningKey {
        let h = sha512(&[seed]);
        let mut a: [u8; 32] = [0; 32];
        a.copy_from_slice(&h[..32]);
        a[0] = a[0] & 248;
        a[31] = (a[31] & 127) | 64;
        let mut prefix: [u8; 32] = [0; 32];
        prefix.copy_from_slice(&h[32..]);
        let public = VerifyingKey {
            b: encode(&base_mult(&a)),
        };
        SigningKey {
            seed: *seed,
            a,
            prefix,
            public,
        }
    }

    /// Generates a key from 32 random bytes of `rng`, which should be a
    /// cryptographically secure generator such as
    /// [`OsRng`](crate::rand::rngs::OsRng).
    pub fn generate<R: RngCore>(rng: &mut R) -> SigningKey {
        let mut seed: [u8; 32] = [0; 32];
        rng.fill_bytes(&mut seed);
        SigningKey::from_bytes(&seed)
    }

    /// Makes a key of 64 bytes: the seed followed by the public key.
    ///
    /// # Errors
    ///
    /// [`SignatureError`] if the public key is not the seed's.
    pub fn from_keypair_bytes(b: &[u8; 64]) -> Result<SigningKey, SignatureError> {
        let mut seed: [u8; 32] = [0; 32];
        seed.copy_from_slice(&b[..32]);
        let k = SigningKey::from_bytes(&seed);
        if k.public.b[..] != b[32..] {
            return Err(SignatureError);
        }
        Ok(k)
    }

    /// Returns the 32-byte seed.
    pub fn to_bytes(&self) -> [u8; 32] {
        self.seed
    }

    /// Returns a reference to the 32-byte encoding.
    pub fn as_bytes(&self) -> &[u8; 32] {
        &self.seed
    }

    /// Returns the seed followed by the public key (64 bytes).
    pub fn to_keypair_bytes(&self) -> [u8; 64] {
        let mut out: [u8; 64] = [0; 64];
        out[..32].copy_from_slice(&self.seed);
        out[32..].copy_from_slice(&self.public.b);
        out
    }

    /// Returns the public key.
    pub fn verifying_key(&self) -> VerifyingKey {
        self.public.clone()
    }

    /// Signs `msg` (RFC 8032 section 5.1.6). The signature is
    /// deterministic: the same key and message give the same signature.
    pub fn sign(&self, msg: &[u8]) -> Signature {
        let r = reduce64(&sha512(&[&self.prefix, msg]));
        let rb = encode(&base_mult(&limbs_le(&r)));
        let k = reduce64(&sha512(&[&rb, &self.public.b, msg]));
        let l = LazyLock::force(&L);
        let a = l.from_mont(&l.mont_mul(&limbs(&self.a), &l.to_mont(&l.one())));
        let s = mul_add(&k, &a, &r);
        let mut out: [u8; 64] = [0; 64];
        out[..32].copy_from_slice(&rb);
        out[32..].copy_from_slice(&limbs_le(&s));
        Signature { b: out }
    }

    /// Whether sig is this key's signature of msg.
    pub fn verify(&self, msg: &[u8], sig: &Signature) -> Result<(), SignatureError> {
        self.public.verify(msg, sig)
    }
}
