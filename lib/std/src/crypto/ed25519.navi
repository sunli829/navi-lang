//! Ed25519 signatures (RFC 8032), with the API of the ed25519-dalek crate:
//! `SigningKey` (from a 32-byte seed), `VerifyingKey` (32 bytes) and
//! `Signature` (64 bytes), `sign` and `verify`.
//!
//!     use std::crypto::ed25519::SigningKey;
//!     let key = SigningKey::generate(&mut std::rand::rngs::OsRng);
//!     let sig = key.sign(b"hello");
//!     assert(key.verifying_key().verify(b"hello", &sig).is_ok());
//!
//! As Go's crypto/ed25519: the field is crypto::x25519's (five 51-bit
//! limbs), points in extended coordinates with the complete formulas
//! (Hisil et al. 2008, a = -1), the generator's multiples per 4-bit window a
//! table built on first use (constant-time lookups), the scalars mod L
//! crypto::nat's. Verification is Go's: S below L, [S]B - [k]A encoded equal
//! to R (non-canonical encodings of A and R accepted as Go does).

use crate::crypto::x25519::Fe;
use crate::crypto::sha2::Sha512;
use crate::crypto::Digest;
use crate::crypto::nat::Modulus;
use crate::rand::RngCore;
use crate::sync::LazyLock;
use crate::fmt;

pub const SECRET_KEY_LENGTH: usize = 32;
pub const PUBLIC_KEY_LENGTH: usize = 32;
pub const SIGNATURE_LENGTH: usize = 64;

/// A signature or key that does not check out.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct SignatureError;

impl fmt::Display for SignatureError {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result { f.write_str("signature error") }
}


// -d / 121666 (the curve's d) and 2d.
const D: Fe = Fe { l: [929955233495203, 466365720129213, 1662059464998953, 2033849074728123, 1442794654840575] };
const D2: Fe = Fe { l: [1859910466990425, 932731440258426, 1072319116312658, 1815898335770999, 633789495995903] };

// A point in extended coordinates: x = X/Z, y = Y/Z, xy = T/Z.
#[derive(Clone)]
struct Point {
    x: Fe,
    y: Fe,
    z: Fe,
    t: Fe,
}

fn identity() -> Point { Point { x: Fe::zero(), y: Fe::one(), z: Fe::one(), t: Fe::zero() } }

fn generator() -> Point {
    Point {
        x: Fe { l: [1738742601995546, 1146398526822698, 2070867633025821, 562264141797630, 587772402128613] },
        y: Fe { l: [1801439850948184, 1351079888211148, 450359962737049, 900719925474099, 1801439850948198] },
        z: Fe::one(),
        t: Fe { l: [1841354044333475, 16398895984059, 755974180946558, 900171276175154, 1821297809914039] },
    }
}

// r = p + q (add-2008-hwcd-3, a = -1): complete, no special cases; r may
// be p or q (the field operations in place, as Go's).
fn add_to(r: &mut Point, p: &Point, q: &Point) {
    let mut a = Fe::zero();
    let mut b = Fe::zero();
    let mut c = Fe::zero();
    let mut d = Fe::zero();
    let mut t = Fe::zero();
    a.set_sub(&p.y, &p.x);
    t.set_sub(&q.y, &q.x);
    a.set_mul(&a, &t);
    b.set_add(&p.y, &p.x);
    t.set_add(&q.y, &q.x);
    b.set_mul(&b, &t);
    c.set_mul(&p.t, &D2);
    c.set_mul(&c, &q.t);
    d.set_mul(&p.z, &q.z);
    d.set_add(&d, &d);
    // e = b - a, f = d - c, g = d + c, h = b + a
    t.set_sub(&b, &a);
    b.set_add(&b, &a);
    a.set_sub(&d, &c);
    d.set_add(&d, &c);
    r.x.set_mul(&t, &a);
    r.y.set_mul(&d, &b);
    r.z.set_mul(&a, &d);
    r.t.set_mul(&t, &b);
}

fn add(p: &Point, q: &Point) -> Point {
    let mut r = identity();
    add_to(&mut r, p, q);
    r
}

// r = p + p (dbl-2008-hwcd, a = -1); r may be p.
fn double_to(r: &mut Point, p: &Point) {
    let mut a = Fe::zero();
    let mut b = Fe::zero();
    let mut c = Fe::zero();
    let mut e = Fe::zero();
    a.set_square(&p.x);
    b.set_square(&p.y);
    c.set_square(&p.z);
    c.set_add(&c, &c);
    e.set_add(&p.x, &p.y);
    e.set_square(&e);
    e.set_sub(&e, &a);
    e.set_sub(&e, &b);
    // D = -A: G = B - A, F = G - C, H = -A - B
    let mut g = Fe::zero();
    g.set_sub(&b, &a);
    c.set_sub(&g, &c);
    a.set_add(&a, &b);
    b.set_sub(&Fe::zero(), &a);
    r.x.set_mul(&e, &c);
    r.y.set_mul(&g, &b);
    r.z.set_mul(&c, &g);
    r.t.set_mul(&e, &b);
}

fn double(p: &Point) -> Point {
    let mut r = identity();
    double_to(&mut r, p);
    r
}

fn neg(p: &Point) -> Point { Point { x: p.x.neg(), y: p.y.clone(), z: p.z.clone(), t: p.t.neg() } }

// The 32-byte encoding: y, the sign of x in the top bit.
fn encode(p: &Point) -> [u8; 32] {
    let zi = p.z.invert();
    let x = p.x.mul(&zi);
    let y = p.y.mul(&zi);
    let mut b = y.to_bytes();
    b[31] = b[31] | ((x.is_negative() as u8) << 7);
    b
}

// The point of an encoding, if on the curve (Go's Point.SetBytes: y need
// not be reduced; x = 0 with the sign bit set is accepted).
fn decode(b: &[u8]) -> Option<Point> {
    if b.len() != 32 { return None; }
    let y = Fe::from_bytes(b);
    let y2 = y.square();
    let u = y2.sub(&Fe::one());
    let v = y2.mul(&D).add(&Fe::one());
    let (x, ok) = Fe::sqrt_ratio(&u, &v);
    if ok == 0 { return None; }
    let x = Fe::choose((b[31] >> 7) as u64, &x.neg(), &x);
    let t = x.mul(&y);
    Some(Point { x, y, z: Fe::one(), t })
}

// The generator's multiples: for window w (of 64, least significant
// first), j * 16^w * B at 16 * w + j.
static BASE: LazyLock<Vec<Point>> = LazyLock::new(base_table);

fn base_table() -> Vec<Point> {
    let mut out: Vec<Point> = Vec::with_capacity(1024);
    let mut g = generator();
    let mut w = 0;
    while w < 64 {
        let mut acc = identity();
        let mut j = 0;
        while j < 16 {
            out.push(acc.clone());
            acc = add(&acc, &g);
            j += 1;
        }
        g = double(&double(&double(&double(&g))));
        w += 1;
    }
    out
}

// r = table[idx], every entry read (masked limbs, in place).
fn lookup_to(r: &mut Point, table: &[Point], idx: u64) {
    let mut i = 0;
    while i < 5 {
        r.x.l[i] = 0;
        r.y.l[i] = 0;
        r.z.l[i] = 0;
        r.t.l[i] = 0;
        i += 1;
    }
    let mut j = 0;
    while j < table.len() {
        let d = (j as u64) ^ idx;
        let m = (((d | d.wrapping_neg()) >> 63) ^ 1).wrapping_neg();
        let e = &table[j];
        i = 0;
        while i < 5 {
            r.x.l[i] = r.x.l[i] | (e.x.l[i] & m);
            r.y.l[i] = r.y.l[i] | (e.y.l[i] & m);
            r.z.l[i] = r.z.l[i] | (e.z.l[i] & m);
            r.t.l[i] = r.t.l[i] | (e.t.l[i] & m);
            i += 1;
        }
        j += 1;
    }
}

// k * B (k 32 little-endian bytes), in constant time: a lookup and an
// addition per 4-bit window.
fn base_mult(k: &[u8]) -> Point {
    let t = LazyLock::force(&BASE);
    let mut q = identity();
    let mut e = identity();
    let mut w = 0;
    while w < 64 {
        let nib = ((k[w / 2] >> (4 * (w % 2)) as u8) & 15) as u64;
        lookup_to(&mut e, &t[16 * w..16 * w + 16], nib);
        add_to(&mut q, &q, &e);
        w += 1;
    }
    q
}

// k * p (k 32 little-endian bytes), in variable time (public scalars).
fn var_mult(p: &Point, k: &[u8]) -> Point {
    let mut table: Vec<Point> = Vec::with_capacity(16);
    table.push(identity());
    let mut j = 1;
    while j < 16 {
        let t = add(&table[j - 1], p);
        table.push(t);
        j += 1;
    }
    let mut q = identity();
    let mut w = 64;
    while w > 0 {
        w -= 1;
        double_to(&mut q, &q);
        double_to(&mut q, &q);
        double_to(&mut q, &q);
        double_to(&mut q, &q);
        let nib = ((k[w / 2] >> (4 * (w % 2)) as u8) & 15) as usize;
        if nib != 0 { add_to(&mut q, &q, &table[nib]); }
    }
    q
}

// --- Scalars mod L (as little-endian bytes outside, nat limbs inside) ---

// L = 2^252 + 27742317777372353535851937790883648493, the group order.
static L: LazyLock<Modulus> = LazyLock::new(make_l);

fn make_l() -> Modulus {
    Modulus::new(&[
        0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
        0x14, 0xde, 0xf9, 0xde, 0xa2, 0xf7, 0x9c, 0xd6, 0x58, 0x12, 0x63, 0x1a, 0x5c, 0xf5, 0xd3, 0xed,
    ])
}

// Little-endian bytes (32 at most) as 4 limbs.
fn limbs(le: &[u8]) -> Vec<u64> {
    let mut out: Vec<u64> = Vec::new();
    out.resize(4, 0);
    let mut i = 0;
    while i < le.len() {
        out[i / 8] = out[i / 8] | ((le[i] as u64) << (8 * (i % 8)) as u64);
        i += 1;
    }
    out
}

fn limbs_le(x: &[u64]) -> [u8; 32] {
    let mut out: [u8; 32] = [0; 32];
    let mut i = 0;
    while i < 32 {
        out[i] = (x[i / 8] >> (8 * (i % 8)) as u64) as u8;
        i += 1;
    }
    out
}

// A 64-byte little-endian number (a SHA-512 digest) mod L: lo + hi * 2^256,
// each turned by Montgomery multiplications by R^2 (inputs below R, so the
// products reduce).
fn reduce64(b: &[u8]) -> Vec<u64> {
    let l = LazyLock::force(&L);
    let lo = limbs(&b[..32]);
    let hi = limbs(&b[32..]);
    let rr = l.to_mont(&l.one());
    // hi * R = mont(hi, R^2); lo mod L = mont(mont(lo, R^2), 1).
    let hi_r = l.mont_mul(&hi, &rr);
    let lo_m = l.from_mont(&l.mont_mul(&lo, &rr));
    l.add(&lo_m, &hi_r)
}

// a * b + c mod L (all below L).
fn mul_add(a: &[u64], b: &[u64], c: &[u64]) -> Vec<u64> {
    let l = LazyLock::force(&L);
    l.add(&l.mont_mul(&l.to_mont(a), b), c)
}

fn sha512(parts: &[&[u8]]) -> Vec<u8> {
    let mut h = Sha512::new();
    for p in parts.iter() { h.update_bytes(*p); }
    h.finalize_bytes()
}

/// An Ed25519 signature: R (32 bytes) and S (32 bytes).
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct Signature {
    b: [u8; 64],
}

impl Signature {
    pub const BYTE_SIZE: usize = 64;

    pub fn from_bytes(b: &[u8; 64]) -> Signature { Signature { b: *b } }

    /// The signature of 64 bytes, else an error.
    pub fn from_slice(b: &[u8]) -> Result<Signature, SignatureError> {
        if b.len() != 64 { return Err(SignatureError); }
        let mut s: [u8; 64] = [0; 64];
        s.copy_from_slice(b);
        Ok(Signature { b: s })
    }

    pub fn to_bytes(&self) -> [u8; 64] { self.b }

    pub fn to_vec(&self) -> Vec<u8> { self.b.to_vec() }

    pub fn r_bytes(&self) -> &[u8] { &self.b[..32] }

    pub fn s_bytes(&self) -> &[u8] { &self.b[32..] }
}

/// A public key: the encoding of the point A.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct VerifyingKey {
    b: [u8; 32],
}

impl VerifyingKey {
    /// The key of 32 bytes, if they encode a point.
    pub fn from_bytes(b: &[u8; 32]) -> Result<VerifyingKey, SignatureError> {
        match decode(b) {
            Some(_) => Ok(VerifyingKey { b: *b }),
            None => Err(SignatureError),
        }
    }

    pub fn to_bytes(&self) -> [u8; 32] { self.b }

    pub fn as_bytes(&self) -> &[u8; 32] { &self.b }

    /// Whether sig is this key's signature of msg (Go's ed25519.Verify).
    pub fn verify(&self, msg: &[u8], sig: &Signature) -> Result<(), SignatureError> {
        let r = &sig.b[..32];
        let s = &sig.b[32..];
        if (s[31] & 224) != 0 { return Err(SignatureError); }
        let a = match decode(&self.b) {
            Some(a) => a,
            None => return Err(SignatureError),
        };
        // S < L (canonical).
        let l = LazyLock::force(&L);
        let mut sbe: Vec<u8> = s.to_vec();
        sbe.reverse();
        if l.from_be(&sbe).is_none() { return Err(SignatureError); }
        let k = limbs_le(&reduce64(&sha512(&[r, &self.b, msg])));
        // [S]B + [k](-A) == R
        let rp = add(&base_mult(s), &var_mult(&neg(&a), &k));
        if encode(&rp)[..] != *r { return Err(SignatureError); }
        Ok(())
    }

    /// As verify (Go's verification already rejects non-canonical S).
    pub fn verify_strict(&self, msg: &[u8], sig: &Signature) -> Result<(), SignatureError> { self.verify(msg, sig) }
}

/// A private key: the 32-byte seed, its expanded scalar and prefix, and
/// the public key.
#[derive(Clone)]
pub struct SigningKey {
    seed: [u8; 32],
    a: [u8; 32],
    prefix: [u8; 32],
    public: VerifyingKey,
}

impl SigningKey {
    /// The key of a 32-byte seed (RFC 8032 5.1.5).
    pub fn from_bytes(seed: &[u8; 32]) -> SigningKey {
        let h = sha512(&[seed]);
        let mut a: [u8; 32] = [0; 32];
        a.copy_from_slice(&h[..32]);
        a[0] = a[0] & 248;
        a[31] = (a[31] & 127) | 64;
        let mut prefix: [u8; 32] = [0; 32];
        prefix.copy_from_slice(&h[32..]);
        let public = VerifyingKey { b: encode(&base_mult(&a)) };
        SigningKey { seed: *seed, a, prefix, public }
    }

    /// A key from 32 random bytes of rng.
    pub fn generate<R: RngCore>(rng: &mut R) -> SigningKey {
        let mut seed: [u8; 32] = [0; 32];
        rng.fill_bytes(&mut seed);
        SigningKey::from_bytes(&seed)
    }

    /// The key of the 64-byte seed || public key, if they match.
    pub fn from_keypair_bytes(b: &[u8; 64]) -> Result<SigningKey, SignatureError> {
        let mut seed: [u8; 32] = [0; 32];
        seed.copy_from_slice(&b[..32]);
        let k = SigningKey::from_bytes(&seed);
        if k.public.b[..] != b[32..] { return Err(SignatureError); }
        Ok(k)
    }

    /// The seed.
    pub fn to_bytes(&self) -> [u8; 32] { self.seed }

    pub fn as_bytes(&self) -> &[u8; 32] { &self.seed }

    /// The seed followed by the public key.
    pub fn to_keypair_bytes(&self) -> [u8; 64] {
        let mut out: [u8; 64] = [0; 64];
        out[..32].copy_from_slice(&self.seed);
        out[32..].copy_from_slice(&self.public.b);
        out
    }

    pub fn verifying_key(&self) -> VerifyingKey { self.public.clone() }

    /// The signature of msg (RFC 8032 5.1.6; deterministic).
    pub fn sign(&self, msg: &[u8]) -> Signature {
        let r = reduce64(&sha512(&[&self.prefix, msg]));
        let rb = encode(&base_mult(&limbs_le(&r)));
        let k = reduce64(&sha512(&[&rb, &self.public.b, msg]));
        let l = LazyLock::force(&L);
        let a = l.from_mont(&l.mont_mul(&limbs(&self.a), &l.to_mont(&l.one())));
        let s = mul_add(&k, &a, &r);
        let mut out: [u8; 64] = [0; 64];
        out[..32].copy_from_slice(&rb);
        out[32..].copy_from_slice(&limbs_le(&s));
        Signature { b: out }
    }

    /// Whether sig is this key's signature of msg.
    pub fn verify(&self, msg: &[u8], sig: &Signature) -> Result<(), SignatureError> { self.public.verify(msg, sig) }
}
