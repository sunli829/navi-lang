//! Reading DER (X.690), for [`crate::crypto::x509`] and TLS, as Go's
//! `cryptobyte`.
//!
//! A [`Reader`](crate::crypto::der::Reader) is a cursor over the bytes
//! whose reads take one element off the front. Every read returns `None`
//! on anything that is not strict DER (long forms where short ones fit,
//! leading zeros in lengths and integers, indefinite lengths, tags of more
//! than one byte) or not of the tag asked for.
//!
//! # Examples
//!
//! ```
//! use std::crypto::der::{self, Reader};
//!
//! // SEQUENCE { INTEGER 5, BOOLEAN true, OCTET STRING "hi" }
//! let bytes = b"\x30\x0a\x02\x01\x05\x01\x01\xff\x04\x02hi";
//! let mut r = Reader::new(bytes);
//! let mut seq = r.read_nested(der::SEQUENCE).unwrap();
//! assert(r.is_empty());
//! assert_eq(seq.read_i64(), Some(5));
//! assert_eq(seq.read_bool(), Some(true));
//! assert_eq(seq.read(der::OCTET_STRING), Some(b"hi"));
//! assert(seq.is_empty());
//! ```

/// The tag of a BOOLEAN.
pub const BOOLEAN: u8 = 0x01;
/// The tag of a INTEGER.
pub const INTEGER: u8 = 0x02;
/// The tag of a BIT STRING.
pub const BIT_STRING: u8 = 0x03;
/// The tag of a OCTET STRING.
pub const OCTET_STRING: u8 = 0x04;
/// The tag of a NULL.
pub const NULL: u8 = 0x05;
/// The tag of a OBJECT IDENTIFIER.
pub const OID: u8 = 0x06;
/// The tag of a UTF8String.
pub const UTF8_STRING: u8 = 0x0c;
/// The tag of a PrintableString.
pub const PRINTABLE_STRING: u8 = 0x13;
/// The tag of a T61String (TeletexString).
pub const T61_STRING: u8 = 0x14;
/// The tag of a IA5String.
pub const IA5_STRING: u8 = 0x16;
/// The tag of a UTCTime.
pub const UTC_TIME: u8 = 0x17;
/// The tag of a GeneralizedTime.
pub const GENERALIZED_TIME: u8 = 0x18;
/// The tag of a UniversalString.
pub const UNIVERSAL_STRING: u8 = 0x1c;
/// The tag of a BMPString.
pub const BMP_STRING: u8 = 0x1e;
/// The tag of a SEQUENCE (and SEQUENCE OF), constructed.
pub const SEQUENCE: u8 = 0x30;
/// The tag of a SET (and SET OF), constructed.
pub const SET: u8 = 0x31;

/// The tag of context-specific element n, constructed (`[n] EXPLICIT`,
/// or `IMPLICIT` of a constructed type).
pub fn context(n: u8) -> u8 {
    0xa0 | n
}

/// The tag of primitive context-specific element n (`[n] IMPLICIT` of a
/// primitive type).
pub fn context_primitive(n: u8) -> u8 {
    0x80 | n
}

/// A cursor over DER bytes: each read takes one element off the front.
///
/// Copying a reader (it is `Clone`) saves a position to come back to.
#[derive(Clone)]
pub struct Reader {
    b: &[u8],
}

impl Reader {
    /// Creates a reader over `b`.
    pub fn new(b: &[u8]) -> Reader {
        Reader { b }
    }

    /// Returns the bytes not read yet.
    pub fn rest(&self) -> &[u8] {
        self.b
    }

    /// Returns whether everything has been read.
    pub fn is_empty(&self) -> bool {
        self.b.len() == 0
    }

    /// The next element's tag.
    pub fn peek_tag(&self) -> Option<u8> {
        if self.b.len() == 0 {
            None
        } else {
            Some(self.b[0])
        }
    }

    /// The next element: its tag, contents and whole encoding.
    pub fn read_any(&mut self) -> Option<(u8, &[u8], &[u8])> {
        let b = self.b;
        if b.len() < 2 {
            return None;
        }
        let tag = b[0];
        // (High tag numbers: none in X.509 or TLS.)
        if (tag & 0x1f) == 0x1f {
            return None;
        }
        let first = b[1] as usize;
        let mut len = 0usize;
        let mut at = 2;
        if first < 0x80 {
            len = first;
        } else {
            let n = first & 0x7f;
            // At most 4 bytes, none leading zero, and not short-form
            // lengths.
            if n == 0 || n > 4 || b.len() < 2 + n || b[2] == 0 {
                return None;
            }
            let mut k = 0;
            while k < n {
                len = (len << 8) | (b[2 + k] as usize);
                k += 1;
            }
            if len < 0x80 {
                return None;
            }
            at = 2 + n;
        }
        if len > b.len() - at {
            return None;
        }
        self.b = &b[at + len..];
        Some((tag, &b[at..at + len], &b[..at + len]))
    }

    /// The contents of the next element, which must have tag.
    pub fn read(&mut self, tag: u8) -> Option<&[u8]> {
        if self.peek_tag() != Some(tag) {
            return None;
        }
        let (_, c, _) = self.read_any()?;
        Some(c)
    }

    /// The whole encoding of the next element, which must have tag.
    pub fn read_element(&mut self, tag: u8) -> Option<&[u8]> {
        if self.peek_tag() != Some(tag) {
            return None;
        }
        let (_, _, all) = self.read_any()?;
        Some(all)
    }

    /// The contents of the next element if it has tag: Some(None) when the
    /// next is another (or there is none), None when it is malformed.
    pub fn read_optional(&mut self, tag: u8) -> Option<Option<&[u8]>> {
        if self.peek_tag() != Some(tag) {
            return Some(None);
        }
        let c = self.read(tag)?;
        Some(Some(c))
    }

    /// A reader over the contents of the next element, which must have
    /// tag (as cryptobyte's ReadASN1 into a String).
    pub fn read_nested(&mut self, tag: u8) -> Option<Reader> {
        let c = self.read(tag)?;
        Some(Reader::new(c))
    }

    /// Skips the next element, which must have tag.
    pub fn skip(&mut self, tag: u8) -> Option<()> {
        self.read(tag)?;
        Some(())
    }

    /// Skips the next element if it has tag.
    pub fn skip_optional(&mut self, tag: u8) -> Option<()> {
        if self.peek_tag() == Some(tag) {
            self.skip(tag)?;
        }
        Some(())
    }

    /// A BOOLEAN (DER: 0x00 or 0xff).
    pub fn read_bool(&mut self) -> Option<bool> {
        let c = self.read(BOOLEAN)?;
        if c.len() != 1 {
            return None;
        }
        match c[0] {
            0 => Some(false),
            0xff => Some(true),
            _ => None,
        }
    }

    /// An INTEGER's two's-complement bytes, minimally encoded.
    pub fn read_integer_bytes(&mut self) -> Option<&[u8]> {
        let c = self.read(INTEGER)?;
        if c.len() == 0 {
            return None;
        }
        if c.len() > 1
            && ((c[0] == 0 && (c[1] & 0x80) == 0) || (c[0] == 0xff && (c[1] & 0x80) != 0))
        {
            return None;
        }
        Some(c)
    }

    /// A non-negative INTEGER's magnitude (big-endian, no leading zero
    /// unless it is zero).
    pub fn read_unsigned(&mut self) -> Option<&[u8]> {
        let c = self.read_integer_bytes()?;
        if (c[0] & 0x80) != 0 {
            return None;
        }
        if c.len() > 1 && c[0] == 0 {
            Some(&c[1..])
        } else {
            Some(c)
        }
    }

    /// An INTEGER that fits an i64.
    pub fn read_i64(&mut self) -> Option<i64> {
        let c = self.read_integer_bytes()?;
        if c.len() > 8 {
            return None;
        }
        let mut v: i64 = if (c[0] & 0x80) != 0 { -1 } else { 0 };
        for x in c.iter() {
            v = (v << 8) | (*x as i64);
        }
        Some(v)
    }

    /// An OBJECT IDENTIFIER's contents (compared as bytes: see `oid`).
    pub fn read_oid(&mut self) -> Option<&[u8]> {
        let c = self.read(OID)?;
        // Non-empty, the last byte ends an arc, no arc starts with 0x80.
        if c.len() == 0 || (c[c.len() - 1] & 0x80) != 0 {
            return None;
        }
        let mut start = true;
        for x in c.iter() {
            if start && *x == 0x80 {
                return None;
            }
            start = (*x & 0x80) == 0;
        }
        Some(c)
    }

    /// A BIT STRING: its bytes and how many bits of the last are unused
    /// (and zero, as DER wants).
    pub fn read_bit_string(&mut self) -> Option<(&[u8], u8)> {
        let c = self.read(BIT_STRING)?;
        if c.len() == 0 {
            return None;
        }
        let unused = c[0];
        if unused > 7 || (c.len() == 1 && unused != 0) {
            return None;
        }
        if unused != 0 && (c[c.len() - 1] & ((1u8 << unused) - 1)) != 0 {
            return None;
        }
        Some((&c[1..], unused))
    }

    /// A BIT STRING whose bits are all used (keys and signatures).
    pub fn read_bytes_bit_string(&mut self) -> Option<&[u8]> {
        let (b, unused) = self.read_bit_string()?;
        if unused != 0 {
            return None;
        }
        Some(b)
    }

    /// A UTCTime or GeneralizedTime (UTC, to the second, as RFC 5280
    /// wants) as seconds since the Unix epoch.
    pub fn read_time(&mut self) -> Option<i64> {
        let tag = self.peek_tag()?;
        if tag == UTC_TIME {
            let c = self.read(UTC_TIME)?;
            // YYMMDDHHMMSSZ; YY of 50 and up is 19YY.
            if c.len() != 13 || c[12] != b'Z' {
                return None;
            }
            let yy = digits(&c[0..2])?;
            let year = if yy >= 50 { 1900 + yy } else { 2000 + yy };
            civil_seconds(year, &c[2..12])
        } else if tag == GENERALIZED_TIME {
            let c = self.read(GENERALIZED_TIME)?;
            // YYYYMMDDHHMMSSZ
            if c.len() != 15 || c[14] != b'Z' {
                return None;
            }
            civil_seconds(digits(&c[0..4])?, &c[4..14])
        } else {
            None
        }
    }
}

fn digits(b: &[u8]) -> Option<i64> {
    let mut v = 0i64;
    for c in b.iter() {
        if *c < b'0' || *c > b'9' {
            return None;
        }
        v = v * 10 + ((*c - b'0') as i64);
    }
    Some(v)
}

// MMDDHHMMSS of year as Unix seconds, if a real date and time.
fn civil_seconds(year: i64, b: &[u8]) -> Option<i64> {
    let month = digits(&b[0..2])?;
    let day = digits(&b[2..4])?;
    let hour = digits(&b[4..6])?;
    let min = digits(&b[6..8])?;
    let sec = digits(&b[8..10])?;
    if month < 1
        || month > 12
        || day < 1
        || day > days_in_month(year, month)
        || hour > 23
        || min > 59
        || sec > 59
    {
        return None;
    }
    Some(days_from_civil(year, month, day) * 86400 + hour * 3600 + min * 60 + sec)
}

fn days_in_month(year: i64, month: i64) -> i64 {
    match month {
        2 => {
            if (year % 4 == 0 && year % 100 != 0) || year % 400 == 0 {
                29
            } else {
                28
            }
        }
        4 | 6 | 9 | 11 => 30,
        _ => 31,
    }
}

/// Days since 1970-01-01 of a proleptic Gregorian date (Howard Hinnant's
/// days_from_civil).
pub fn days_from_civil(year: i64, month: i64, day: i64) -> i64 {
    let y = if month <= 2 { year - 1 } else { year };
    let era = (if y >= 0 { y } else { y - 399 }) / 400;
    let yoe = y - era * 400;
    let mp = (month + 9) % 12;
    let doy = (153 * mp + 2) / 5 + day - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

/// An OID's DER contents from its dotted form ("1.2.840.113549.1.1.11"),
/// to compare with `read_oid`'s.
pub fn oid(dotted: &str) -> Vec<u8> {
    let arcs: Vec<u64> = dotted
        .split('.')
        .map(|s: &str| -> u64 { s.parse::<u64>().unwrap() })
        .collect();
    let mut out: Vec<u8> = Vec::new();
    push_arc(&mut out, arcs[0] * 40 + arcs[1]);
    let mut i = 2;
    while i < arcs.len() {
        push_arc(&mut out, arcs[i]);
        i += 1;
    }
    out
}

fn push_arc(out: &mut Vec<u8>, v: u64) {
    let mut n = 1;
    while n < 10 && (v >> (7 * n)) != 0 {
        n += 1;
    }
    while n > 1 {
        n -= 1;
        out.push(0x80 | ((v >> (7 * n)) as u8 & 0x7f));
    }
    out.push(v as u8 & 0x7f);
}

/// An OID's dotted form, for messages.
pub fn oid_string(b: &[u8]) -> String {
    let mut out = String::new();
    let mut v = 0u64;
    let mut first = true;
    for x in b.iter() {
        v = (v << 7) | ((*x & 0x7f) as u64);
        if (*x & 0x80) == 0 {
            if first {
                let a = if v < 80 { v / 40 } else { 2 };
                out.push_str(`${a}.${v - a * 40}`.to_string().as_str());
                first = false;
            } else {
                out.push_str(`.${v}`.to_string().as_str());
            }
            v = 0;
        }
    }
    out
}
