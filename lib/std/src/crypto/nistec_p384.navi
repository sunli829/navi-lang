//! Generated by tools/gennistec.py (do not edit): P-384 for crypto::ec,
//! as Go's crypto/internal/fips140/nistec. Field elements are
//! [u64; 6] in Montgomery form (little-endian limbs); points are
//! projective (X : Y : Z), the identity (0 : 1 : 0), added by the complete
//! formulas of Renes, Costello and Batina (2016, algorithm 4, a = -3).
//! Scalar multiplication reads a 4-bit window's table in constant time;
//! the generator's multiples per window are a table built on first use.

use crate::sync::LazyLock;

type Fe = [u64; 6];

const P: Fe = [0xffffffff, 0xffffffff00000000, 0xfffffffffffffffe, 0xffffffffffffffff, 0xffffffffffffffff, 0xffffffffffffffff];
const ZERO: Fe = [0x0, 0x0, 0x0, 0x0, 0x0, 0x0];
// 1, R^2, b, the generator (Montgomery form).
const ONE: Fe = [0xffffffff00000001, 0xffffffff, 0x1, 0x0, 0x0, 0x0];
const RR: Fe = [0xfffffffe00000001, 0x200000000, 0xfffffffe00000000, 0x200000000, 0x1, 0x0];
const B: Fe = [0x81188719d412dcc, 0xf729add87a4c32ec, 0x77f2209b1920022e, 0xe3374bee94938ae2, 0xb62b21f41f022094, 0xcd08114b604fbff9];
const GX: Fe = [0x3dd0756649c0b528, 0x20e378e2a0d6ce38, 0x879c3afc541b4d6e, 0x6454868459a30eff, 0x812ff723614ede2b, 0x4d3aadc2299e1513];
const GY: Fe = [0x23043dad4b03a4fe, 0xa1bfa8bf7bb4a9ac, 0x8bade7562e83b050, 0xc6c3521968f4ffd9, 0xdd8002263969a840, 0x2b78abc25a15c5e9];
const SIZE: usize = 48;
// p - 2 (inversion) and (p + 1) / 4 (square roots), big-endian.
const P_MINUS_2: [u8; 48] = [0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xfe, 0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xfd];
const SQRT_EXP: [u8; 48] = [0x3f, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xbf, 0xff, 0xff, 0xff, 0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x40, 0x00, 0x00, 0x00];

// The carries are bools: carrying_add / borrowing_sub chains are adcs / sbcs.
#[inline(always)]
fn adc(a: u64, b: u64, c: bool) -> (u64, bool) { a.carrying_add(b, c) }

#[inline(always)]
fn sbb(a: u64, b: u64, borrow: bool) -> (u64, bool) { a.borrowing_sub(b, borrow) }

// a * b + c + d (fits 128 bits): (lo, hi).
#[inline(always)]
fn mac(a: u64, b: u64, c: u64, d: u64) -> (u64, u64) {
    let (lo, hi) = a.widening_mul(b);
    let (s, c1) = lo.carrying_add(c, false);
    let (h, _) = hi.carrying_add(0, c1);
    let (s2, c2) = s.carrying_add(d, false);
    let (h2, _) = h.carrying_add(0, c2);
    (s2, h2)
}

// a * b / R mod p (CIOS, unrolled).
fn fe_mul(a: &Fe, b: &Fe) -> Fe {
    let mut t0 = 0u64;
    let mut t1 = 0u64;
    let mut t2 = 0u64;
    let mut t3 = 0u64;
    let mut t4 = 0u64;
    let mut t5 = 0u64;
    let mut t6 = 0u64;
    let mut t7 = 0u64;
    let mut c: u64;
    let bi = b[0];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = mac(a[4], bi, t4, c); t4 = x; c = y;
    let (x, y) = mac(a[5], bi, t5, c); t5 = x; c = y;
    let (x, y) = adc(t6, c, false); t6 = x; t7 = y as u64;
    let q = t0.wrapping_mul(0x100000001);
    let (_, y) = mac(q, P[0], t0, 0); c = y;
    let (x, y) = mac(q, P[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, P[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, P[3], t3, c); t2 = x; c = y;
    let (x, y) = mac(q, P[4], t4, c); t3 = x; c = y;
    let (x, y) = mac(q, P[5], t5, c); t4 = x; c = y;
    let (x, y) = adc(t6, c, false); t5 = x; t6 = t7.wrapping_add(y as u64);
    let bi = b[1];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = mac(a[4], bi, t4, c); t4 = x; c = y;
    let (x, y) = mac(a[5], bi, t5, c); t5 = x; c = y;
    let (x, y) = adc(t6, c, false); t6 = x; t7 = y as u64;
    let q = t0.wrapping_mul(0x100000001);
    let (_, y) = mac(q, P[0], t0, 0); c = y;
    let (x, y) = mac(q, P[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, P[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, P[3], t3, c); t2 = x; c = y;
    let (x, y) = mac(q, P[4], t4, c); t3 = x; c = y;
    let (x, y) = mac(q, P[5], t5, c); t4 = x; c = y;
    let (x, y) = adc(t6, c, false); t5 = x; t6 = t7.wrapping_add(y as u64);
    let bi = b[2];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = mac(a[4], bi, t4, c); t4 = x; c = y;
    let (x, y) = mac(a[5], bi, t5, c); t5 = x; c = y;
    let (x, y) = adc(t6, c, false); t6 = x; t7 = y as u64;
    let q = t0.wrapping_mul(0x100000001);
    let (_, y) = mac(q, P[0], t0, 0); c = y;
    let (x, y) = mac(q, P[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, P[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, P[3], t3, c); t2 = x; c = y;
    let (x, y) = mac(q, P[4], t4, c); t3 = x; c = y;
    let (x, y) = mac(q, P[5], t5, c); t4 = x; c = y;
    let (x, y) = adc(t6, c, false); t5 = x; t6 = t7.wrapping_add(y as u64);
    let bi = b[3];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = mac(a[4], bi, t4, c); t4 = x; c = y;
    let (x, y) = mac(a[5], bi, t5, c); t5 = x; c = y;
    let (x, y) = adc(t6, c, false); t6 = x; t7 = y as u64;
    let q = t0.wrapping_mul(0x100000001);
    let (_, y) = mac(q, P[0], t0, 0); c = y;
    let (x, y) = mac(q, P[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, P[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, P[3], t3, c); t2 = x; c = y;
    let (x, y) = mac(q, P[4], t4, c); t3 = x; c = y;
    let (x, y) = mac(q, P[5], t5, c); t4 = x; c = y;
    let (x, y) = adc(t6, c, false); t5 = x; t6 = t7.wrapping_add(y as u64);
    let bi = b[4];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = mac(a[4], bi, t4, c); t4 = x; c = y;
    let (x, y) = mac(a[5], bi, t5, c); t5 = x; c = y;
    let (x, y) = adc(t6, c, false); t6 = x; t7 = y as u64;
    let q = t0.wrapping_mul(0x100000001);
    let (_, y) = mac(q, P[0], t0, 0); c = y;
    let (x, y) = mac(q, P[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, P[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, P[3], t3, c); t2 = x; c = y;
    let (x, y) = mac(q, P[4], t4, c); t3 = x; c = y;
    let (x, y) = mac(q, P[5], t5, c); t4 = x; c = y;
    let (x, y) = adc(t6, c, false); t5 = x; t6 = t7.wrapping_add(y as u64);
    let bi = b[5];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = mac(a[4], bi, t4, c); t4 = x; c = y;
    let (x, y) = mac(a[5], bi, t5, c); t5 = x; c = y;
    let (x, y) = adc(t6, c, false); t6 = x; t7 = y as u64;
    let q = t0.wrapping_mul(0x100000001);
    let (_, y) = mac(q, P[0], t0, 0); c = y;
    let (x, y) = mac(q, P[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, P[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, P[3], t3, c); t2 = x; c = y;
    let (x, y) = mac(q, P[4], t4, c); t3 = x; c = y;
    let (x, y) = mac(q, P[5], t5, c); t4 = x; c = y;
    let (x, y) = adc(t6, c, false); t5 = x; t6 = t7.wrapping_add(y as u64);
    // t < 2p: subtract p unless t < p.
    let (r0, w0) = sbb(t0, P[0], false);
    let (r1, w1) = sbb(t1, P[1], w0);
    let (r2, w2) = sbb(t2, P[2], w1);
    let (r3, w3) = sbb(t3, P[3], w2);
    let (r4, w4) = sbb(t4, P[4], w3);
    let (r5, w5) = sbb(t5, P[5], w4);
    let (_, bb) = sbb(t6, 0, w5);
    let mask = 0u64.wrapping_sub(bb as u64);
    [(t0 & mask) | (r0 & !mask), (t1 & mask) | (r1 & !mask), (t2 & mask) | (r2 & !mask), (t3 & mask) | (r3 & !mask), (t4 & mask) | (r4 & !mask), (t5 & mask) | (r5 & !mask)]
}

// a * a / R mod p.
fn fe_sqr(a: &Fe) -> Fe { fe_mul(a, a) }

// a + b mod p.
fn fe_add(a: &Fe, b: &Fe) -> Fe {
    let (s0, c0) = adc(a[0], b[0], false);
    let (s1, c1) = adc(a[1], b[1], c0);
    let (s2, c2) = adc(a[2], b[2], c1);
    let (s3, c3) = adc(a[3], b[3], c2);
    let (s4, c4) = adc(a[4], b[4], c3);
    let (s5, c5) = adc(a[5], b[5], c4);
    let (d0, w0) = sbb(s0, P[0], false);
    let (d1, w1) = sbb(s1, P[1], w0);
    let (d2, w2) = sbb(s2, P[2], w1);
    let (d3, w3) = sbb(s3, P[3], w2);
    let (d4, w4) = sbb(s4, P[4], w3);
    let (d5, w5) = sbb(s5, P[5], w4);
    // Keep the sum when it is below p (no carry, a borrow).
    let (_, keep) = sbb(c5 as u64, 0, w5);
    let mask = 0u64.wrapping_sub(keep as u64);
    [(s0 & mask) | (d0 & !mask), (s1 & mask) | (d1 & !mask), (s2 & mask) | (d2 & !mask), (s3 & mask) | (d3 & !mask), (s4 & mask) | (d4 & !mask), (s5 & mask) | (d5 & !mask)]
}

// a - b mod p.
fn fe_sub(a: &Fe, b: &Fe) -> Fe {
    let (d0, w0) = sbb(a[0], b[0], false);
    let (d1, w1) = sbb(a[1], b[1], w0);
    let (d2, w2) = sbb(a[2], b[2], w1);
    let (d3, w3) = sbb(a[3], b[3], w2);
    let (d4, w4) = sbb(a[4], b[4], w3);
    let (d5, w5) = sbb(a[5], b[5], w4);
    // Add p back on a borrow.
    let mask = 0u64.wrapping_sub(w5 as u64);
    let (r0, c0) = adc(d0, P[0] & mask, false);
    let (r1, c1) = adc(d1, P[1] & mask, c0);
    let (r2, c2) = adc(d2, P[2] & mask, c1);
    let (r3, c3) = adc(d3, P[3] & mask, c2);
    let (r4, c4) = adc(d4, P[4] & mask, c3);
    let (r5, c5) = adc(d5, P[5] & mask, c4);
    let _ = c5;
    [r0, r1, r2, r3, r4, r5]
}

// c ? a : b (c is 0 or 1), in constant time.
fn fe_select(c: u64, a: &Fe, b: &Fe) -> Fe {
    let mask = 0u64.wrapping_sub(c);
    [(a[0] & mask) | (b[0] & !mask), (a[1] & mask) | (b[1] & !mask), (a[2] & mask) | (b[2] & !mask), (a[3] & mask) | (b[3] & !mask), (a[4] & mask) | (b[4] & !mask), (a[5] & mask) | (b[5] & !mask)]
}

// 1 if a is zero, else 0.
fn fe_is_zero(a: &Fe) -> u64 {
    let x = a[0] | a[1] | a[2] | a[3] | a[4] | a[5];
    ((x | x.wrapping_neg()) >> 63) ^ 1
}

fn fe_eq(a: &Fe, b: &Fe) -> bool { fe_is_zero(&fe_sub(a, b)) == 1 }

// a^e, e big-endian (public: the steps depend on its bits).
fn fe_pow(a: &Fe, e: &[u8]) -> Fe {
    let mut r = ONE;
    for byte in e.iter() {
        let mut k = 8;
        while k > 0 {
            k -= 1;
            r = fe_sqr(&r);
            if ((*byte >> k as u8) & 1) != 0 { r = fe_mul(&r, a); }
        }
    }
    r
}

fn fe_inv(a: &Fe) -> Fe { fe_pow(a, &P_MINUS_2) }

// The element of big-endian bytes (SIZE of them), if below p.
fn fe_from_be(b: &[u8]) -> Option<Fe> {
    if b.len() != SIZE { return None; }
    let mut x: Fe = ZERO;
    let mut i = 0;
    while i < SIZE {
        let k = SIZE - 1 - i;
        x[k / 8] = x[k / 8] | ((b[i] as u64) << (8 * (k % 8)) as u64);
        i += 1;
    }
    let (_, w0) = sbb(x[0], P[0], false);
    let (_, w1) = sbb(x[1], P[1], w0);
    let (_, w2) = sbb(x[2], P[2], w1);
    let (_, w3) = sbb(x[3], P[3], w2);
    let (_, w4) = sbb(x[4], P[4], w3);
    let (_, w5) = sbb(x[5], P[5], w4);
    if !w5 { return None; }
    Some(fe_mul(&x, &RR))
}

// Big-endian bytes (SIZE) of an element.
fn fe_to_be(a: &Fe) -> Vec<u8> {
    let mut one: Fe = ZERO;
    one[0] = 1;
    let x = fe_mul(a, &one);
    let mut out: Vec<u8> = Vec::with_capacity(SIZE);
    let mut k = SIZE;
    while k > 0 {
        k -= 1;
        out.push((x[k / 8] >> (8 * (k % 8)) as u64) as u8);
    }
    out
}

#[derive(Clone)]
struct Point {
    x: Fe,
    y: Fe,
    z: Fe,
}

fn identity() -> Point { Point { x: ZERO, y: ONE, z: ZERO } }

fn generator() -> Point { Point { x: GX, y: GY, z: ONE } }

// p1 + p2 (RCB16 algorithm 4, a = -3): no special cases.
fn add(p1: &Point, p2: &Point) -> Point {
    let mut t0 = fe_mul(&p1.x, &p2.x);
    let mut t1 = fe_mul(&p1.y, &p2.y);
    let mut t2 = fe_mul(&p1.z, &p2.z);
    let mut t3 = fe_add(&p1.x, &p1.y);
    let mut t4 = fe_add(&p2.x, &p2.y);
    t3 = fe_mul(&t3, &t4);
    t4 = fe_add(&t0, &t1);
    t3 = fe_sub(&t3, &t4);
    t4 = fe_add(&p1.y, &p1.z);
    let mut x3 = fe_add(&p2.y, &p2.z);
    t4 = fe_mul(&t4, &x3);
    x3 = fe_add(&t1, &t2);
    t4 = fe_sub(&t4, &x3);
    x3 = fe_add(&p1.x, &p1.z);
    let mut y3 = fe_add(&p2.x, &p2.z);
    x3 = fe_mul(&x3, &y3);
    y3 = fe_add(&t0, &t2);
    y3 = fe_sub(&x3, &y3);
    let mut z3 = fe_mul(&B, &t2);
    x3 = fe_sub(&y3, &z3);
    z3 = fe_add(&x3, &x3);
    x3 = fe_add(&x3, &z3);
    z3 = fe_sub(&t1, &x3);
    x3 = fe_add(&t1, &x3);
    y3 = fe_mul(&B, &y3);
    t1 = fe_add(&t2, &t2);
    t2 = fe_add(&t1, &t2);
    y3 = fe_sub(&y3, &t2);
    y3 = fe_sub(&y3, &t0);
    t1 = fe_add(&y3, &y3);
    y3 = fe_add(&t1, &y3);
    t1 = fe_add(&t0, &t0);
    t0 = fe_add(&t1, &t0);
    t0 = fe_sub(&t0, &t2);
    t1 = fe_mul(&t4, &y3);
    t2 = fe_mul(&t0, &y3);
    y3 = fe_mul(&x3, &z3);
    y3 = fe_add(&y3, &t2);
    x3 = fe_mul(&t3, &x3);
    x3 = fe_sub(&x3, &t1);
    z3 = fe_mul(&t4, &z3);
    t1 = fe_mul(&t3, &t0);
    z3 = fe_add(&z3, &t1);
    Point { x: x3, y: y3, z: z3 }
}

// 2p (RCB16 algorithm 6, a = -3; Go's nistec Double).
fn double(p: &Point) -> Point {
    let mut t0 = fe_sqr(&p.x);
    let t1 = fe_sqr(&p.y);
    let mut t2 = fe_sqr(&p.z);
    let mut t3 = fe_mul(&p.x, &p.y);
    t3 = fe_add(&t3, &t3);
    let mut z3 = fe_mul(&p.x, &p.z);
    z3 = fe_add(&z3, &z3);
    let mut y3 = fe_mul(&B, &t2);
    y3 = fe_sub(&y3, &z3);
    let mut x3 = fe_add(&y3, &y3);
    y3 = fe_add(&x3, &y3);
    x3 = fe_sub(&t1, &y3);
    y3 = fe_add(&t1, &y3);
    y3 = fe_mul(&x3, &y3);
    x3 = fe_mul(&x3, &t3);
    t3 = fe_add(&t2, &t2);
    t2 = fe_add(&t2, &t3);
    z3 = fe_mul(&B, &z3);
    z3 = fe_sub(&z3, &t2);
    z3 = fe_sub(&z3, &t0);
    t3 = fe_add(&z3, &z3);
    z3 = fe_add(&z3, &t3);
    t3 = fe_add(&t0, &t0);
    t0 = fe_add(&t3, &t0);
    t0 = fe_sub(&t0, &t2);
    t0 = fe_mul(&t0, &z3);
    y3 = fe_add(&y3, &t0);
    t0 = fe_mul(&p.y, &p.z);
    t0 = fe_add(&t0, &t0);
    z3 = fe_mul(&t0, &z3);
    x3 = fe_sub(&x3, &z3);
    z3 = fe_mul(&t0, &t1);
    z3 = fe_add(&z3, &z3);
    z3 = fe_add(&z3, &z3);
    Point { x: x3, y: y3, z: z3 }
}

// table[idx] (idx < table.len()), every entry read.
fn lookup(table: &[Point], idx: u64) -> Point {
    let mut r = identity();
    r.y = ZERO;
    let mut j = 0;
    while j < table.len() {
        let d = (j as u64) ^ idx;
        let eq = ((d | d.wrapping_neg()) >> 63) ^ 1;
        let t = &table[j];
        r.x = fe_select(eq, &t.x, &r.x);
        r.y = fe_select(eq, &t.y, &r.y);
        r.z = fe_select(eq, &t.z, &r.z);
        j += 1;
    }
    r
}

// k * p (k big-endian bytes, any length), in constant time: 4-bit
// windows, most significant first.
fn scalar_mult(p: &Point, k: &[u8]) -> Point {
    let mut table: Vec<Point> = Vec::with_capacity(16);
    table.push(identity());
    table.push(p.clone());
    let mut i = 2;
    while i < 16 {
        let t = if i % 2 == 0 { double(&table[i / 2]) } else { add(&table[i - 1], p) };
        table.push(t);
        i += 1;
    }
    let mut q = identity();
    for byte in k.iter() {
        let mut half = 0;
        while half < 2 {
            q = double(&double(&double(&double(&q))));
            let nib = if half == 0 { (*byte >> 4) as u64 } else { (*byte & 15) as u64 };
            q = add(&q, &lookup(table.as_slice(), nib));
            half += 1;
        }
    }
    q
}

// The generator's multiples: for window w (of 2 * SIZE, least
// significant first), j * 16^w * G at 16 * w + j.
static BASE: LazyLock<Vec<Point>> = LazyLock::new(base_table);

fn base_table() -> Vec<Point> {
    let mut out: Vec<Point> = Vec::with_capacity(32 * SIZE);
    let mut g = generator();
    let mut wi = 0;
    while wi < 2 * SIZE {
        out.push(identity());
        let mut acc = g.clone();
        let mut j = 1;
        while j < 16 {
            out.push(acc.clone());
            acc = add(&acc, &g);
            j += 1;
        }
        g = double(&double(&double(&double(&g))));
        wi += 1;
    }
    out
}

// k * G (k big-endian, SIZE bytes or fewer), in constant time: a
// lookup and an addition per window, no doubling.
fn scalar_base_mult(k: &[u8]) -> Point {
    let t = LazyLock::force(&BASE);
    let mut q = identity();
    let mut wi = 0;
    let mut i = k.len();
    while i > 0 && wi < 2 * SIZE {
        i -= 1;
        let lo = (k[i] & 15) as u64;
        let hi = (k[i] >> 4) as u64;
        q = add(&q, &lookup(&t[16 * wi..16 * wi + 16], lo));
        q = add(&q, &lookup(&t[16 * wi + 16..16 * wi + 32], hi));
        wi += 2;
    }
    q
}

// (x, y) of p (Montgomery form); None for the identity.
fn affine(p: &Point) -> Option<(Fe, Fe)> {
    if fe_is_zero(&p.z) == 1 { return None; }
    let zi = fe_inv(&p.z);
    Some((fe_mul(&p.x, &zi), fe_mul(&p.y, &zi)))
}

// x^3 - 3x + b.
fn rhs(x: &Fe) -> Fe {
    let x3 = fe_mul(&fe_sqr(x), x);
    let three_x = fe_add(&fe_add(x, x), x);
    fe_add(&fe_sub(&x3, &three_x), &B)
}

// The point of a SEC 1 encoding (uncompressed or compressed), if on the
// curve.
fn decode(b: &[u8]) -> Option<Point> {
    if b.len() == 1 + 2 * SIZE && b[0] == 4 {
        let x = fe_from_be(&b[1..1 + SIZE])?;
        let y = fe_from_be(&b[1 + SIZE..])?;
        if !fe_eq(&fe_sqr(&y), &rhs(&x)) { return None; }
        return Some(Point { x, y, z: ONE });
    }
    if b.len() == 1 + SIZE && (b[0] == 2 || b[0] == 3) {
        let x = fe_from_be(&b[1..])?;
        let r = rhs(&x);
        let mut y = fe_pow(&r, &SQRT_EXP);
        if !fe_eq(&fe_sqr(&y), &r) { return None; }
        let odd = fe_to_be(&y)[SIZE - 1] & 1;
        if odd != (b[0] & 1) { y = fe_sub(&ZERO, &y); }
        return Some(Point { x, y, z: ONE });
    }
    None
}

// The uncompressed SEC 1 encoding (empty for the identity).
fn encode(p: &Point) -> Vec<u8> {
    let mut out: Vec<u8> = Vec::new();
    if let Some((x, y)) = affine(p) {
        out.reserve(1 + 2 * SIZE);
        out.push(4);
        out.extend_from_slice(fe_to_be(&x).as_slice());
        out.extend_from_slice(fe_to_be(&y).as_slice());
    }
    out
}

// --- For crypto::ec (bytes in, bytes out) ---

/// The uncompressed encoding of a SEC 1 point, if valid.
pub(crate) fn decode_point(b: &[u8]) -> Option<Vec<u8>> {
    let p = decode(b)?;
    Some(encode(&p))
}

/// k * G, uncompressed (empty for the identity).
pub(crate) fn base_mult(k: &[u8]) -> Vec<u8> { encode(&scalar_base_mult(k)) }

/// The x-coordinate of k * peer (a valid uncompressed point), if not the
/// identity.
pub(crate) fn ecdh(k: &[u8], peer: &[u8]) -> Option<Vec<u8>> {
    let p = decode(peer)?;
    let (x, _) = affine(&scalar_mult(&p, k))?;
    Some(fe_to_be(&x))
}

/// The x-coordinate of u1 * G + u2 * q (q a valid uncompressed point), if
/// not the identity.
pub(crate) fn mul2_x(u1: &[u8], u2: &[u8], q: &[u8]) -> Option<Vec<u8>> {
    let qp = decode(q)?;
    let r = add(&scalar_base_mult(u1), &scalar_mult(&qp, u2));
    let (x, _) = affine(&r)?;
    Some(fe_to_be(&x))
}

// --- Scalars: modulo the group order N (Montgomery form) ---

const N: Fe = [0xecec196accc52973, 0x581a0db248b0a77a, 0xc7634d81f4372ddf, 0xffffffffffffffff, 0xffffffffffffffff, 0xffffffffffffffff];
const N_ONE: Fe = [0x1313e695333ad68d, 0xa7e5f24db74f5885, 0x389cb27e0bc8d220, 0x0, 0x0, 0x0];
const N_RR: Fe = [0x2d319b2419b409a9, 0xff3d81e5df1aa419, 0xbc3e483afcb82947, 0xd40d49174aab1cc5, 0x3fb05b7a28266895, 0xc84ee012b39bf21];
const N_MINUS_2: [u8; 48] = [0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xc7, 0x63, 0x4d, 0x81, 0xf4, 0x37, 0x2d, 0xdf, 0x58, 0x1a, 0x0d, 0xb2, 0x48, 0xb0, 0xa7, 0x7a, 0xec, 0xec, 0x19, 0x6a, 0xcc, 0xc5, 0x29, 0x71];

fn sc_mul(a: &Fe, b: &Fe) -> Fe {
    let mut t0 = 0u64;
    let mut t1 = 0u64;
    let mut t2 = 0u64;
    let mut t3 = 0u64;
    let mut t4 = 0u64;
    let mut t5 = 0u64;
    let mut t6 = 0u64;
    let mut t7 = 0u64;
    let mut c: u64;
    let bi = b[0];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = mac(a[4], bi, t4, c); t4 = x; c = y;
    let (x, y) = mac(a[5], bi, t5, c); t5 = x; c = y;
    let (x, y) = adc(t6, c, false); t6 = x; t7 = y as u64;
    let q = t0.wrapping_mul(0x6ed46089e88fdc45);
    let (_, y) = mac(q, N[0], t0, 0); c = y;
    let (x, y) = mac(q, N[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, N[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, N[3], t3, c); t2 = x; c = y;
    let (x, y) = mac(q, N[4], t4, c); t3 = x; c = y;
    let (x, y) = mac(q, N[5], t5, c); t4 = x; c = y;
    let (x, y) = adc(t6, c, false); t5 = x; t6 = t7.wrapping_add(y as u64);
    let bi = b[1];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = mac(a[4], bi, t4, c); t4 = x; c = y;
    let (x, y) = mac(a[5], bi, t5, c); t5 = x; c = y;
    let (x, y) = adc(t6, c, false); t6 = x; t7 = y as u64;
    let q = t0.wrapping_mul(0x6ed46089e88fdc45);
    let (_, y) = mac(q, N[0], t0, 0); c = y;
    let (x, y) = mac(q, N[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, N[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, N[3], t3, c); t2 = x; c = y;
    let (x, y) = mac(q, N[4], t4, c); t3 = x; c = y;
    let (x, y) = mac(q, N[5], t5, c); t4 = x; c = y;
    let (x, y) = adc(t6, c, false); t5 = x; t6 = t7.wrapping_add(y as u64);
    let bi = b[2];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = mac(a[4], bi, t4, c); t4 = x; c = y;
    let (x, y) = mac(a[5], bi, t5, c); t5 = x; c = y;
    let (x, y) = adc(t6, c, false); t6 = x; t7 = y as u64;
    let q = t0.wrapping_mul(0x6ed46089e88fdc45);
    let (_, y) = mac(q, N[0], t0, 0); c = y;
    let (x, y) = mac(q, N[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, N[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, N[3], t3, c); t2 = x; c = y;
    let (x, y) = mac(q, N[4], t4, c); t3 = x; c = y;
    let (x, y) = mac(q, N[5], t5, c); t4 = x; c = y;
    let (x, y) = adc(t6, c, false); t5 = x; t6 = t7.wrapping_add(y as u64);
    let bi = b[3];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = mac(a[4], bi, t4, c); t4 = x; c = y;
    let (x, y) = mac(a[5], bi, t5, c); t5 = x; c = y;
    let (x, y) = adc(t6, c, false); t6 = x; t7 = y as u64;
    let q = t0.wrapping_mul(0x6ed46089e88fdc45);
    let (_, y) = mac(q, N[0], t0, 0); c = y;
    let (x, y) = mac(q, N[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, N[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, N[3], t3, c); t2 = x; c = y;
    let (x, y) = mac(q, N[4], t4, c); t3 = x; c = y;
    let (x, y) = mac(q, N[5], t5, c); t4 = x; c = y;
    let (x, y) = adc(t6, c, false); t5 = x; t6 = t7.wrapping_add(y as u64);
    let bi = b[4];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = mac(a[4], bi, t4, c); t4 = x; c = y;
    let (x, y) = mac(a[5], bi, t5, c); t5 = x; c = y;
    let (x, y) = adc(t6, c, false); t6 = x; t7 = y as u64;
    let q = t0.wrapping_mul(0x6ed46089e88fdc45);
    let (_, y) = mac(q, N[0], t0, 0); c = y;
    let (x, y) = mac(q, N[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, N[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, N[3], t3, c); t2 = x; c = y;
    let (x, y) = mac(q, N[4], t4, c); t3 = x; c = y;
    let (x, y) = mac(q, N[5], t5, c); t4 = x; c = y;
    let (x, y) = adc(t6, c, false); t5 = x; t6 = t7.wrapping_add(y as u64);
    let bi = b[5];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = mac(a[4], bi, t4, c); t4 = x; c = y;
    let (x, y) = mac(a[5], bi, t5, c); t5 = x; c = y;
    let (x, y) = adc(t6, c, false); t6 = x; t7 = y as u64;
    let q = t0.wrapping_mul(0x6ed46089e88fdc45);
    let (_, y) = mac(q, N[0], t0, 0); c = y;
    let (x, y) = mac(q, N[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, N[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, N[3], t3, c); t2 = x; c = y;
    let (x, y) = mac(q, N[4], t4, c); t3 = x; c = y;
    let (x, y) = mac(q, N[5], t5, c); t4 = x; c = y;
    let (x, y) = adc(t6, c, false); t5 = x; t6 = t7.wrapping_add(y as u64);
    let (r0, w0) = sbb(t0, N[0], false);
    let (r1, w1) = sbb(t1, N[1], w0);
    let (r2, w2) = sbb(t2, N[2], w1);
    let (r3, w3) = sbb(t3, N[3], w2);
    let (r4, w4) = sbb(t4, N[4], w3);
    let (r5, w5) = sbb(t5, N[5], w4);
    let (_, bb) = sbb(t6, 0, w5);
    let mask = 0u64.wrapping_sub(bb as u64);
    [(t0 & mask) | (r0 & !mask), (t1 & mask) | (r1 & !mask), (t2 & mask) | (r2 & !mask), (t3 & mask) | (r3 & !mask), (t4 & mask) | (r4 & !mask), (t5 & mask) | (r5 & !mask)]
}

fn sc_add(a: &Fe, b: &Fe) -> Fe {
    let (s0, c0) = adc(a[0], b[0], false);
    let (s1, c1) = adc(a[1], b[1], c0);
    let (s2, c2) = adc(a[2], b[2], c1);
    let (s3, c3) = adc(a[3], b[3], c2);
    let (s4, c4) = adc(a[4], b[4], c3);
    let (s5, c5) = adc(a[5], b[5], c4);
    let (d0, w0) = sbb(s0, N[0], false);
    let (d1, w1) = sbb(s1, N[1], w0);
    let (d2, w2) = sbb(s2, N[2], w1);
    let (d3, w3) = sbb(s3, N[3], w2);
    let (d4, w4) = sbb(s4, N[4], w3);
    let (d5, w5) = sbb(s5, N[5], w4);
    let (_, keep) = sbb(c5 as u64, 0, w5);
    let mask = 0u64.wrapping_sub(keep as u64);
    [(s0 & mask) | (d0 & !mask), (s1 & mask) | (d1 & !mask), (s2 & mask) | (d2 & !mask), (s3 & mask) | (d3 & !mask), (s4 & mask) | (d4 & !mask), (s5 & mask) | (d5 & !mask)]
}

// a^(n-2): 1/a (a in Montgomery form; the exponent is public).
fn sc_inv(a: &Fe) -> Fe {
    let mut r = N_ONE;
    for byte in N_MINUS_2.iter() {
        let mut k = 8;
        while k > 0 {
            k -= 1;
            r = sc_mul(&r, &r);
            if ((*byte >> k as u8) & 1) != 0 { r = sc_mul(&r, a); }
        }
    }
    r
}

// Big-endian bytes (SIZE or fewer) as limbs, and whether below n.
fn sc_limbs(b: &[u8]) -> (Fe, bool) {
    let mut x: Fe = ZERO;
    let mut i = 0;
    while i < b.len() && i < SIZE {
        let k = b.len() - 1 - i;
        x[i / 8] = x[i / 8] | ((b[k] as u64) << (8 * (i % 8)) as u64);
        i += 1;
    }
    let (_, w0) = sbb(x[0], N[0], false);
    let (_, w1) = sbb(x[1], N[1], w0);
    let (_, w2) = sbb(x[2], N[2], w1);
    let (_, w3) = sbb(x[3], N[3], w2);
    let (_, w4) = sbb(x[4], N[4], w3);
    let (_, w5) = sbb(x[5], N[5], w4);
    (x, w5)
}

// x - n if x >= n (x < 2n), in constant time.
fn sc_reduce(x: &Fe) -> Fe {
    let (d0, w0) = sbb(x[0], N[0], false);
    let (d1, w1) = sbb(x[1], N[1], w0);
    let (d2, w2) = sbb(x[2], N[2], w1);
    let (d3, w3) = sbb(x[3], N[3], w2);
    let (d4, w4) = sbb(x[4], N[4], w3);
    let (d5, w5) = sbb(x[5], N[5], w4);
    let mask = 0u64.wrapping_sub(w5 as u64);
    [(x[0] & mask) | (d0 & !mask), (x[1] & mask) | (d1 & !mask), (x[2] & mask) | (d2 & !mask), (x[3] & mask) | (d3 & !mask), (x[4] & mask) | (d4 & !mask), (x[5] & mask) | (d5 & !mask)]
}

fn sc_to_mont(x: &Fe) -> Fe { sc_mul(x, &N_RR) }

fn sc_from_mont(x: &Fe) -> Fe {
    let mut one: Fe = ZERO;
    one[0] = 1;
    sc_mul(x, &one)
}

fn limbs_to_be(x: &Fe) -> Vec<u8> {
    let mut out: Vec<u8> = Vec::with_capacity(SIZE);
    let mut k = SIZE;
    while k > 0 {
        k -= 1;
        out.push((x[k / 8] >> (8 * (k % 8)) as u64) as u8);
    }
    out
}

// The hash as a scalar: its leftmost SIZE bytes, mod n (n has whole
// bytes for these curves).
fn hash_scalar(hash: &[u8]) -> Fe {
    let e = if hash.len() > SIZE { &hash[..SIZE] } else { hash };
    let (x, _) = sc_limbs(e);
    sc_reduce(&x)
}

/// An ECDSA signature (r, s) of hash by the secret scalar d with the
/// nonce k (both in [1, n), big-endian); None if r or s is zero (pick
/// another nonce). Constant-time in d and k.
pub(crate) fn sign(d: &[u8], k: &[u8], hash: &[u8]) -> Option<(Vec<u8>, Vec<u8>)> {
    let (rx, _) = affine(&scalar_base_mult(k))?;
    let (xl, _) = sc_limbs(fe_to_be(&rx).as_slice());
    let r = sc_reduce(&xl);
    if fe_is_zero(&r) == 1 { return None; }
    let (kl, _) = sc_limbs(k);
    let (dl, _) = sc_limbs(d);
    let e = sc_to_mont(&hash_scalar(hash));
    let kinv = sc_inv(&sc_to_mont(&kl));
    // s = (e + r d) / k
    let rd = sc_mul(&sc_to_mont(&r), &sc_to_mont(&dl));
    let s = sc_from_mont(&sc_mul(&kinv, &sc_add(&e, &rd)));
    if fe_is_zero(&s) == 1 { return None; }
    Some((limbs_to_be(&r), limbs_to_be(&s)))
}

/// Whether (r, s) is an ECDSA signature of hash by q (uncompressed).
pub(crate) fn verify(q: &[u8], hash: &[u8], r: &[u8], s: &[u8]) -> bool {
    if r.len() > SIZE || s.len() > SIZE { return false; }
    let (rl, r_ok) = sc_limbs(r);
    let (sl, s_ok) = sc_limbs(s);
    if !r_ok || !s_ok || fe_is_zero(&rl) == 1 || fe_is_zero(&sl) == 1 { return false; }
    let e = sc_to_mont(&hash_scalar(hash));
    let w = sc_inv(&sc_to_mont(&sl));
    let u1 = sc_from_mont(&sc_mul(&e, &w));
    let u2 = sc_from_mont(&sc_mul(&sc_to_mont(&rl), &w));
    let x = match mul2_x(limbs_to_be(&u1).as_slice(), limbs_to_be(&u2).as_slice(), q) {
        Some(x) => x,
        None => return false,
    };
    let (xl, _) = sc_limbs(x.as_slice());
    let xr = sc_reduce(&xl);
    let d = (xr[0] ^ rl[0]) | (xr[1] ^ rl[1]) | (xr[2] ^ rl[2]) | (xr[3] ^ rl[3]) | (xr[4] ^ rl[4]) | (xr[5] ^ rl[5]);
    d == 0
}
