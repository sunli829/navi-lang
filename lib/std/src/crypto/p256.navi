//! The NIST P-256 curve (secp256r1), with the API of RustCrypto's p256
//! crate: `ecdsa::{SigningKey, VerifyingKey, Signature}` (`sign`/`verify` hash
//! with SHA-256) and `ecdh::{EphemeralSecret, PublicKey, SharedSecret}`.
//! The arithmetic is crypto::ec's.

use crate::crypto::Digest;
use crate::crypto::ec::{Curve, CurveId};
use crate::crypto::sha2::Sha256;
use crate::sync::LazyLock;

/// The curve, as a type parameter.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct NistP256;

static CURVE: LazyLock<Curve> = LazyLock::new(make);

fn make() -> Curve {
    Curve::new(
        "P-256",
        "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551",
    )
}

impl CurveId for NistP256 {
    fn curve() -> &Curve {
        LazyLock::force(&CURVE)
    }
    fn hash(msg: &[u8]) -> Vec<u8> {
        Sha256::digest(msg)
    }
}

pub mod ecdsa {
    pub use crate::crypto::ec::Error;
    pub type Signature = crate::crypto::ec::Signature<super::NistP256>;
    pub type VerifyingKey = crate::crypto::ec::VerifyingKey<super::NistP256>;
    pub type SigningKey = crate::crypto::ec::SigningKey<super::NistP256>;
}

pub mod ecdh {
    pub use crate::crypto::ec::{Error, SharedSecret};
    pub type EphemeralSecret = crate::crypto::ec::EphemeralSecret<super::NistP256>;
    pub type PublicKey = crate::crypto::ec::PublicKey<super::NistP256>;
}
