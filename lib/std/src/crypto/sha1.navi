//! The SHA-1 hash function (FIPS 180-4), as the `sha1` crate.
//!
//! # Security
//!
//! SHA-1 is broken for collision resistance: use it only for
//! compatibility (git object names, old protocols), and SHA-256 for
//! anything new.
//!
//! # Examples
//!
//! ```
//! use std::crypto::sha1::{Digest, Sha1};
//! use std::hex;
//!
//! assert_eq(hex::encode(Sha1::digest(b"abc")), "a9993e364706816aba3e25717850c26c9cd0d89d");
//! ```

use super::{BlockCore, Buffer, be32, push_be32};
use crate::io;

pub use super::Digest;

fn add(a: u32, b: u32) -> u32 {
    crate::intrinsics::wrapping_add(a, b)
}

fn rotl(x: u32, n: u32) -> u32 {
    x << n | x >> (32 - n)
}

#[derive(Clone)]
pub(crate) struct Core {
    h: [u32; 5],
}

impl BlockCore for Core {
    const BLOCK: usize = 64;
    fn compress(&mut self, data: &[u8], at: usize, n: usize) {
        let mut w = [0u32; 80];
        let mut a0 = self.h[0];
        let mut b0 = self.h[1];
        let mut c0 = self.h[2];
        let mut d0 = self.h[3];
        let mut e0 = self.h[4];
        let mut blk = 0;
        while blk < n {
            let p = at + 64 * blk;
            let mut i = 0;
            while i < 16 {
                w[i] = be32(data, p + 4 * i);
                i += 1;
            }
            while i < 80 {
                w[i] = rotl(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
                i += 1;
            }
            let mut a = a0;
            let mut b = b0;
            let mut c = c0;
            let mut d = d0;
            let mut e = e0;
            i = 0;
            while i < 20 {
                let t = add(
                    add(rotl(a, 5), (b & c) | (!b & d)),
                    add(add(e, 0x5a827999), w[i]),
                );
                e = d;
                d = c;
                c = rotl(b, 30);
                b = a;
                a = t;
                i += 1;
            }
            while i < 40 {
                let t = add(add(rotl(a, 5), b ^ c ^ d), add(add(e, 0x6ed9eba1), w[i]));
                e = d;
                d = c;
                c = rotl(b, 30);
                b = a;
                a = t;
                i += 1;
            }
            while i < 60 {
                let t = add(
                    add(rotl(a, 5), (b & c) | (b & d) | (c & d)),
                    add(add(e, 0x8f1bbcdc), w[i]),
                );
                e = d;
                d = c;
                c = rotl(b, 30);
                b = a;
                a = t;
                i += 1;
            }
            while i < 80 {
                let t = add(add(rotl(a, 5), b ^ c ^ d), add(add(e, 0xca62c1d6), w[i]));
                e = d;
                d = c;
                c = rotl(b, 30);
                b = a;
                a = t;
                i += 1;
            }
            a0 = add(a0, a);
            b0 = add(b0, b);
            c0 = add(c0, c);
            d0 = add(d0, d);
            e0 = add(e0, e);
            blk += 1;
        }
        self.h = [a0, b0, c0, d0, e0];
    }
}

const IV: [u32; 5] = [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0];

/// The SHA-1 hash (20 bytes of output). Broken for collision resistance.
///
/// # Examples
///
/// ```
/// use std::crypto::sha1::{Digest, Sha1};
/// use std::hex;
///
/// assert_eq(hex::encode(Sha1::digest(b"abc")), "a9993e364706816aba3e25717850c26c9cd0d89d");
///
/// let mut h = Sha1::new();
/// h.update(b"a");
/// h.update(b"bc");
/// assert_eq(h.finalize(), Sha1::digest(b"abc"));
/// ```
#[derive(Clone)]
pub struct Sha1 {
    b: Buffer<Core>,
}

impl Digest for Sha1 {
    const OUTPUT_SIZE: usize = 20;
    const BLOCK_SIZE: usize = 64;
    fn new() -> Sha1 {
        Sha1 {
            b: Buffer::new(Core { h: IV }),
        }
    }

    fn update_bytes(&mut self, data: &[u8]) {
        self.b.update(data);
    }

    fn finalize_bytes(&mut self) -> Vec<u8> {
        self.b.pad(8, true);
        let mut out = Vec::with_capacity(20);
        let mut i = 0;
        while i < 5 {
            push_be32(&mut out, self.b.core.h[i]);
            i += 1;
        }
        out
    }

    fn reset(&mut self) {
        self.b = Buffer::new(Core { h: IV });
    }
}

impl io::Write for Sha1 {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        self.b.update(buf);
        Ok(buf.len())
    }

    fn flush(&mut self) -> io::Result<()> {
        Ok(())
    }
}

impl Default for Sha1 {
    fn default() -> Sha1 {
        Sha1::new()
    }
}
