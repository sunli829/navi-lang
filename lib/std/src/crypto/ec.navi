//! The NIST prime curves y^2 = x^3 - 3x + b (P-256, P-384), for
//! crypto::p256 and crypto::p384: the point arithmetic is each curve's
//! generated module (crypto::nistec_p256, nistec_p384: fixed-size field
//! elements, complete addition formulas, constant-time windows and a table
//! of the generator's multiples, as Go's nistec); here are the scalars
//! (through crypto::nat, modulo the group's order) and ECDSA.
//!
//! The types here are generic over the curve; use them through
//! [`crate::crypto::p256`] and [`crate::crypto::p384`], whose `ecdsa` and
//! `ecdh` modules name them for their curve.
//!
//! # Examples
//!
//! ```
//! use std::crypto::p256::ecdsa::{Signature, SigningKey, VerifyingKey};
//!
//! let key = SigningKey::random();
//! let sig: Signature = key.sign(b"message");
//! let public: VerifyingKey = key.verifying_key();
//! assert(public.verify(b"message", &sig).is_ok());
//! assert(public.verify(b"massage", &sig).is_err());
//! ```

use crate::crypto::nat::Modulus;
use crate::crypto::{nistec_p256, nistec_p384};
use crate::hex;
use crate::rand::RngCore;
use crate::rand::rngs::OsRng;

/// A point: its uncompressed SEC 1 encoding (validated).
#[derive(Clone)]
pub struct Point {
    enc: Vec<u8>,
}

/// A curve's constants.
pub struct Curve {
    /// The curve's name: `"P-256"` or `"P-384"`.
    pub name: &str,
    n: Modulus,
    size: usize,
    /// 0: P-256, 1: P-384.
    kind: u8,
}

fn h(s: &str) -> Vec<u8> {
    hex::decode(s).unwrap()
}

impl Curve {
    /// The curve of name ("P-256" or "P-384") and order n (hex).
    pub fn new(name: &str, n: &str) -> Curve {
        let kind: u8 = if name == "P-384" { 1 } else { 0 };
        Curve {
            name,
            n: Modulus::new(h(n).as_slice()),
            size: if kind == 1 { 48 } else { 32 },
            kind,
        }
    }

    /// The length of a coordinate or a scalar in bytes.
    pub fn size(&self) -> usize {
        self.size
    }

    /// The point of a SEC1 encoding (uncompressed 04 || x || y, or
    /// compressed 02/03 || x), if on the curve (and not the identity).
    pub fn decode(&self, b: &[u8]) -> Option<Point> {
        let enc = if self.kind == 1 {
            nistec_p384::decode_point(b)?
        } else {
            nistec_p256::decode_point(b)?
        };
        if enc.len() == 0 {
            return None;
        }
        Some(Point { enc })
    }

    /// The uncompressed SEC1 encoding of a point.
    pub fn encode(&self, pt: &Point) -> Vec<u8> {
        pt.enc.clone()
    }

    /// A random scalar in [1, n).
    pub fn random_scalar(&self) -> Vec<u8> {
        let size = self.size();
        loop {
            let mut k: Vec<u8> = Vec::new();
            k.resize(size, 0);
            OsRng.fill_bytes(k.as_mut_slice());
            if let Some(v) = self.n.from_be(k.as_slice()) {
                if !self.n.is_zero(&v) {
                    return k;
                }
            }
        }
    }

    /// Whether k (big-endian) is a valid secret scalar: in [1, n).
    pub fn valid_scalar(&self, k: &[u8]) -> bool {
        if k.len() != self.size() {
            return false;
        }
        match self.n.from_be(k) {
            Some(v) => !self.n.is_zero(&v),
            None => false,
        }
    }

    // k * G, uncompressed.
    fn base_mult(&self, k: &[u8]) -> Vec<u8> {
        if self.kind == 1 {
            nistec_p384::base_mult(k)
        } else {
            nistec_p256::base_mult(k)
        }
    }

    /// The public key (uncompressed) of the secret scalar k.
    pub fn public_key(&self, k: &[u8]) -> Vec<u8> {
        self.base_mult(k)
    }

    /// ECDH: the x-coordinate of k * peer (big-endian, the size), if not
    /// the identity.
    pub fn ecdh(&self, k: &[u8], peer: &Point) -> Option<Vec<u8>> {
        if self.kind == 1 {
            nistec_p384::ecdh(k, peer.enc.as_slice())
        } else {
            nistec_p256::ecdh(k, peer.enc.as_slice())
        }
    }

    /// An ECDSA signature (r, s), big-endian, of hash by the secret scalar
    /// d (FIPS 186-4 6.4.1), with a random nonce; constant-time in d and
    /// the nonce.
    pub fn sign(&self, d: &[u8], hash: &[u8]) -> (Vec<u8>, Vec<u8>) {
        loop {
            let k = self.random_scalar();
            let r = if self.kind == 1 {
                nistec_p384::sign(d, k.as_slice(), hash)
            } else {
                nistec_p256::sign(d, k.as_slice(), hash)
            };
            if let Some(rs) = r {
                return rs;
            }
        }
    }

    /// Whether (r, s) (big-endian) is the ECDSA signature of hash by the
    /// key q (FIPS 186-4 6.4.2).
    pub fn verify(&self, q: &Point, hash: &[u8], r: &[u8], s: &[u8]) -> bool {
        if self.kind == 1 {
            nistec_p384::verify(q.enc.as_slice(), hash, r, s)
        } else {
            nistec_p256::verify(q.enc.as_slice(), hash, r, s)
        }
    }
}

// --- The API of RustCrypto's p256 and p384 crates, over any curve ---------------

use crate::fmt::{self, Display, Formatter};
use crate::marker::PhantomData;

/// A curve of crypto::p256 or crypto::p384.
pub trait CurveId {
    /// Returns the curve's constants.
    fn curve() -> &Curve;
    /// The hash `VerifyingKey::verify` applies (SHA-256 for P-256, SHA-384
    /// for P-384, as the crates).
    fn hash(msg: &[u8]) -> Vec<u8>;
}

/// A bad key, point or signature (as signature::Error and
/// elliptic_curve::Error: no detail).
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct Error;

impl Display for Error {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("elliptic curve error")
    }
}

/// An ECDSA signature (r, s), each the curve's size (32 bytes for P-256,
/// 48 for P-384).
///
/// It converts from and to the fixed-size form `r || s` (as JOSE and the
/// crates' `to_bytes`) and the DER form (as X.509 and TLS).
///
/// # Examples
///
/// ```
/// use std::crypto::p256::ecdsa::{Signature, SigningKey};
///
/// let sig = SigningKey::random().sign(b"message");
/// assert_eq(sig.to_bytes().len(), 64);
/// assert_eq(Signature::from_der(sig.to_der().as_slice()).unwrap(), sig);
/// assert_eq(Signature::from_slice(sig.to_bytes().as_slice()).unwrap(), sig);
/// ```
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct Signature<C: CurveId> {
    r: Vec<u8>,
    s: Vec<u8>,
    marker: PhantomData<C>,
}

// A DER INTEGER's value as the curve's size (unsigned, big-endian).
fn fixed(v: &[u8], size: usize) -> Option<Vec<u8>> {
    let mut b = v;
    while b.len() > 0 && b[0] == 0 {
        b = &b[1..];
    }
    if b.len() > size {
        return None;
    }
    let mut out: Vec<u8> = Vec::new();
    out.resize(size - b.len(), 0);
    out.extend_from_slice(b);
    Some(out)
}

// A DER length at b[i..]: the length and where the contents start.
fn der_len(b: &[u8], i: usize) -> Option<(usize, usize)> {
    if i >= b.len() {
        return None;
    }
    let first = b[i] as usize;
    if first < 0x80 {
        return Some((first, i + 1));
    }
    let n = first & 0x7f;
    if n == 0 || n > 2 || i + 1 + n > b.len() {
        return None;
    }
    let mut len = 0usize;
    let mut k = 0;
    while k < n {
        len = (len << 8) | (b[i + 1 + k] as usize);
        k += 1;
    }
    Some((len, i + 1 + n))
}

impl<C: CurveId> Signature<C> {
    /// Makes a signature of `r || s`, each the curve's size.
    ///
    /// # Errors
    ///
    /// [`Error`] if `b` has the wrong length, or r or s is zero or not
    /// below the group's order.
    pub fn from_slice(b: &[u8]) -> Result<Signature<C>, Error> {
        let size = C::curve().size();
        if b.len() != 2 * size {
            return Err(Error);
        }
        Ok(Signature {
            r: b[..size].to_vec(),
            s: b[size..].to_vec(),
            marker: PhantomData,
        })
    }

    /// Makes a signature of its DER encoding:
    /// `SEQUENCE { INTEGER r, INTEGER s }`.
    ///
    /// # Errors
    ///
    /// [`Error`] if `b` is not that DER, or r or s is out of range.
    pub fn from_der(b: &[u8]) -> Result<Signature<C>, Error> {
        let size = C::curve().size();
        if b.len() < 2 || b[0] != 0x30 {
            return Err(Error);
        }
        let (len, at) = der_len(b, 1).ok_or(Error)?;
        if at + len != b.len() {
            return Err(Error);
        }
        let mut i = at;
        let mut ints: Vec<Vec<u8>> = Vec::new();
        while ints.len() < 2 {
            if i >= b.len() || b[i] != 2 {
                return Err(Error);
            }
            let (l, s) = der_len(b, i + 1).ok_or(Error)?;
            if s + l > b.len() || l == 0 || (b[s] & 0x80) != 0 {
                return Err(Error);
            }
            ints.push(fixed(&b[s..s + l], size).ok_or(Error)?);
            i = s + l;
        }
        if i != b.len() {
            return Err(Error);
        }
        Ok(Signature {
            r: ints[0].clone(),
            s: ints[1].clone(),
            marker: PhantomData,
        })
    }

    /// Returns r, big-endian, the curve's size.
    pub fn r(&self) -> &[u8] {
        self.r.as_slice()
    }

    /// Returns s, big-endian, the curve's size.
    pub fn s(&self) -> &[u8] {
        self.s.as_slice()
    }

    /// Returns `r || s`.
    pub fn to_bytes(&self) -> Vec<u8> {
        let mut v = self.r.clone();
        v.extend_from_slice(self.s.as_slice());
        v
    }

    /// Returns the DER encoding: `SEQUENCE { INTEGER r, INTEGER s }`.
    pub fn to_der(&self) -> Vec<u8> {
        let mut body: Vec<u8> = Vec::new();
        der_integer(&mut body, self.r.as_slice());
        der_integer(&mut body, self.s.as_slice());
        let mut out: Vec<u8> = Vec::new();
        out.push(0x30);
        der_push_len(&mut out, body.len());
        out.extend_from_slice(body.as_slice());
        out
    }
}

fn der_push_len(out: &mut Vec<u8>, n: usize) {
    if n < 0x80 {
        out.push(n as u8);
    } else if n < 0x100 {
        out.push(0x81);
        out.push(n as u8);
    } else {
        out.push(0x82);
        out.push((n >> 8) as u8);
        out.push(n as u8);
    }
}

// An unsigned big-endian value as a DER INTEGER.
fn der_integer(out: &mut Vec<u8>, v: &[u8]) {
    let mut b = v;
    while b.len() > 1 && b[0] == 0 {
        b = &b[1..];
    }
    let pad = b.len() > 0 && (b[0] & 0x80) != 0;
    out.push(2);
    der_push_len(out, b.len() + if pad { 1 } else { 0 });
    if pad {
        out.push(0);
    }
    out.extend_from_slice(b);
}

/// An ECDSA secret key: a scalar in [1, n).
///
/// # Examples
///
/// The key whose scalar is 1 has the generator as its public key:
///
/// ```
/// use std::crypto::p256::ecdsa::SigningKey;
/// use std::hex;
///
/// let key = SigningKey::from_bytes(b"\x01").unwrap();
/// assert_eq(
///     hex::encode(key.verifying_key().to_sec1_bytes()),
///     "046b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c2964fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5",
/// );
/// ```
///
/// # Security
///
/// Signing is constant-time in the key and the nonce; the nonce comes from
/// the operating system's random source (so signatures of the same message
/// differ).
#[derive(Clone)]
pub struct SigningKey<C: CurveId> {
    d: Vec<u8>,
    marker: PhantomData<C>,
}

impl<C: CurveId> SigningKey<C> {
    /// Generates a random key with the operating system's random source.
    pub fn random() -> SigningKey<C> {
        SigningKey {
            d: C::curve().random_scalar(),
            marker: PhantomData,
        }
    }

    /// Makes the key of the scalar `d` (big-endian; shorter than the
    /// curve's size is padded with leading zeros).
    ///
    /// # Errors
    ///
    /// [`Error`] if `d` is longer than the curve's size, zero, or not below
    /// the group's order.
    pub fn from_bytes(d: &[u8]) -> Result<SigningKey<C>, Error> {
        let size = C::curve().size();
        if d.len() > size {
            return Err(Error);
        }
        let mut k: Vec<u8> = Vec::new();
        k.resize(size - d.len(), 0);
        k.extend_from_slice(d);
        if !C::curve().valid_scalar(k.as_slice()) {
            return Err(Error);
        }
        Ok(SigningKey {
            d: k,
            marker: PhantomData,
        })
    }

    /// Returns the scalar, big-endian, the curve's size.
    pub fn to_bytes(&self) -> Vec<u8> {
        self.d.clone()
    }

    /// Returns the public key.
    pub fn verifying_key(&self) -> VerifyingKey<C> {
        let c = C::curve();
        VerifyingKey {
            q: c.decode(c.public_key(self.d.as_slice()).as_slice())
                .unwrap(),
            marker: PhantomData,
        }
    }

    /// Signs `msg`, hashed with the curve's hash (SHA-256 for P-256,
    /// SHA-384 for P-384).
    pub fn sign(&self, msg: &[u8]) -> Signature<C> {
        self.sign_prehash(C::hash(msg).as_slice()).unwrap()
    }

    /// Signs a message's hash, made with any hash (its leftmost bits are
    /// used, as FIPS 186-4 says).
    ///
    /// # Errors
    ///
    /// [`Error`] if `hash` is empty.
    pub fn sign_prehash(&self, hash: &[u8]) -> Result<Signature<C>, Error> {
        let (r, s) = C::curve().sign(self.d.as_slice(), hash);
        Ok(Signature {
            r,
            s,
            marker: PhantomData,
        })
    }
}

/// An ECDSA public key: a point of the curve.
///
/// # Examples
///
/// ```
/// use std::crypto::p384::ecdsa::{SigningKey, VerifyingKey};
///
/// let key = SigningKey::random();
/// let encoded = key.verifying_key().to_sec1_bytes();
/// assert_eq(encoded.len(), 97); // 04 || x || y
/// let public = VerifyingKey::from_sec1_bytes(encoded.as_slice()).unwrap();
/// assert(public.verify(b"msg", &key.sign(b"msg")).is_ok());
/// ```
#[derive(Clone)]
pub struct VerifyingKey<C: CurveId> {
    q: Point,
    marker: PhantomData<C>,
}

impl<C: CurveId> VerifyingKey<C> {
    /// Makes a key of a SEC 1 encoded point (uncompressed `04 || x || y`
    /// or compressed `02`/`03 || x`).
    ///
    /// # Errors
    ///
    /// [`Error`] if the bytes are not a point of the curve (or are the
    /// identity).
    pub fn from_sec1_bytes(b: &[u8]) -> Result<VerifyingKey<C>, Error> {
        match C::curve().decode(b) {
            Some(q) => Ok(VerifyingKey {
                q,
                marker: PhantomData,
            }),
            None => Err(Error),
        }
    }

    /// The uncompressed SEC1 encoding.
    pub fn to_sec1_bytes(&self) -> Vec<u8> {
        C::curve().encode(&self.q)
    }

    /// Checks that `sig` is this key's signature of `msg`, hashed with the
    /// curve's hash.
    ///
    /// # Errors
    ///
    /// [`Error`] if it is not.
    pub fn verify(&self, msg: &[u8], sig: &Signature<C>) -> Result<(), Error> {
        self.verify_prehash(C::hash(msg).as_slice(), sig)
    }

    /// Checks that `sig` is this key's signature of a message's hash, made
    /// with any hash (its leftmost bits are used).
    ///
    /// # Errors
    ///
    /// [`Error`] if it is not.
    pub fn verify_prehash(&self, hash: &[u8], sig: &Signature<C>) -> Result<(), Error> {
        if C::curve().verify(&self.q, hash, sig.r.as_slice(), sig.s.as_slice()) {
            Ok(())
        } else {
            Err(Error)
        }
    }
}

/// An ECDH secret key, for one Diffie-Hellman exchange.
///
/// # Examples
///
/// ```
/// use std::crypto::p256::ecdh::EphemeralSecret;
///
/// let alice = EphemeralSecret::random();
/// let bob = EphemeralSecret::random();
/// let ab = alice.diffie_hellman(&bob.public_key());
/// let ba = bob.diffie_hellman(&alice.public_key());
/// assert_eq(ab.raw_secret_bytes(), ba.raw_secret_bytes());
/// assert_eq(ab.raw_secret_bytes().len(), 32);
/// ```
#[derive(Clone)]
pub struct EphemeralSecret<C: CurveId> {
    k: Vec<u8>,
    marker: PhantomData<C>,
}

/// An ECDH public key: a point of the curve.
#[derive(Clone)]
pub struct PublicKey<C: CurveId> {
    q: Point,
    marker: PhantomData<C>,
}

/// The secret an ECDH exchange shares: the x-coordinate of the shared
/// point (the curve's size).
///
/// Derive keys from it with a KDF such as [`crate::crypto::hkdf`] rather
/// than using it directly.
#[derive(Clone)]
pub struct SharedSecret {
    s: Vec<u8>,
}

impl SharedSecret {
    /// Returns the shared secret's bytes.
    pub fn raw_secret_bytes(&self) -> &[u8] {
        self.s.as_slice()
    }
}

impl<C: CurveId> EphemeralSecret<C> {
    /// Generates a random secret with the operating system's random
    /// source.
    pub fn random() -> EphemeralSecret<C> {
        EphemeralSecret {
            k: C::curve().random_scalar(),
            marker: PhantomData,
        }
    }

    /// Makes a secret of the given scalar (big-endian, in [1, n)).
    ///
    /// # Errors
    ///
    /// [`Error`] if the scalar is out of range.
    pub fn from_bytes(k: &[u8]) -> Result<EphemeralSecret<C>, Error> {
        if !C::curve().valid_scalar(k) {
            return Err(Error);
        }
        Ok(EphemeralSecret {
            k: k.to_vec(),
            marker: PhantomData,
        })
    }

    /// Returns the public key to send to the peer.
    pub fn public_key(&self) -> PublicKey<C> {
        let c = C::curve();
        PublicKey {
            q: c.decode(c.public_key(self.k.as_slice()).as_slice())
                .unwrap(),
            marker: PhantomData,
        }
    }

    /// Returns the secret shared with the holder of the public key
    /// `their`: both sides compute the same value.
    pub fn diffie_hellman(&self, their: &PublicKey<C>) -> SharedSecret {
        // (A valid public key times a valid scalar is never the identity.)
        SharedSecret {
            s: C::curve().ecdh(self.k.as_slice(), &their.q).unwrap(),
        }
    }
}

impl<C: CurveId> PublicKey<C> {
    /// Makes a public key of a SEC 1 encoded point (uncompressed or
    /// compressed).
    ///
    /// # Errors
    ///
    /// [`Error`] if the bytes are not a point of the curve.
    pub fn from_sec1_bytes(b: &[u8]) -> Result<PublicKey<C>, Error> {
        match C::curve().decode(b) {
            Some(q) => Ok(PublicKey {
                q,
                marker: PhantomData,
            }),
            None => Err(Error),
        }
    }

    /// The uncompressed SEC1 encoding.
    pub fn to_sec1_bytes(&self) -> Vec<u8> {
        C::curve().encode(&self.q)
    }
}
