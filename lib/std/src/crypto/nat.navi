//! Arithmetic modulo an odd number (RSA's n, the NIST curves' p and n):
//! numbers as little-endian 64-bit limbs, as many as the modulus has,
//! multiplied in Montgomery form (CIOS; 64x64 -> 128-bit products with
//! u64::widening_mul, carries by comparison: no u128). Constant-time but
//! for `pow`, whose exponent's bits decide the steps (exponents are public
//! here: RSA's e, p - 2, n - 2).

/// An odd modulus and what Montgomery multiplication needs of it.
#[derive(Clone)]
pub struct Modulus {
    m: Vec<u64>,
    /// -m^-1 mod 2^64.
    m0inv: u64,
    /// R^2 mod m (R = 2^(64 * limbs)).
    rr: Vec<u64>,
    bits: usize,
}

fn be_to_limbs(b: &[u8], n: usize) -> Vec<u64> {
    let mut out: Vec<u64> = Vec::with_capacity(n);
    let mut i = 0;
    while i < n {
        out.push(0);
        i += 1;
    }
    let mut k = 0;
    while k < b.len() {
        let byte = b[b.len() - 1 - k] as u64;
        if k / 8 < n { out[k / 8] = out[k / 8] | (byte << (8 * (k % 8))); }
        k += 1;
    }
    out
}

// a - b over n limbs; the borrow out (1 if a < b).
fn sub_limbs(a: &[u64], b: &[u64], out: &mut [u64]) -> u64 {
    let mut borrow = 0u64;
    let mut i = 0;
    while i < a.len() {
        let d = a[i].wrapping_sub(b[i]);
        let b1 = (a[i] < b[i]) as u64;
        let d2 = d.wrapping_sub(borrow);
        let b2 = (d < borrow) as u64;
        out[i] = d2;
        borrow = b1 | b2;
        i += 1;
    }
    borrow
}

// a + b over n limbs; the carry out.
fn add_limbs(a: &[u64], b: &[u64], out: &mut [u64]) -> u64 {
    let mut carry = 0u64;
    let mut i = 0;
    while i < a.len() {
        let s = a[i].wrapping_add(b[i]);
        let c1 = (s < a[i]) as u64;
        let s2 = s.wrapping_add(carry);
        let c2 = (s2 < s) as u64;
        out[i] = s2;
        carry = c1 | c2;
        i += 1;
    }
    carry
}

/// a * b (little-endian limbs): a.len() + b.len() limbs. Constant-time.
pub fn mul_wide(a: &[u64], b: &[u64]) -> Vec<u64> {
    let mut out: Vec<u64> = Vec::new();
    out.resize(a.len() + b.len(), 0);
    let mut i = 0;
    while i < a.len() {
        let mut c = 0u64;
        let mut j = 0;
        while j < b.len() {
            let (lo, hi) = a[i].widening_mul(b[j]);
            let s1 = lo.wrapping_add(out[i + j]);
            let h1 = hi.wrapping_add((s1 < lo) as u64);
            let s2 = s1.wrapping_add(c);
            c = h1.wrapping_add((s2 < s1) as u64);
            out[i + j] = s2;
            j += 1;
        }
        out[i + b.len()] = c;
        i += 1;
    }
    out
}

/// a + b (b no longer than a): a.len() limbs (the caller knows it fits).
pub fn add_wide(a: &[u64], b: &[u64]) -> Vec<u64> {
    let mut out: Vec<u64> = Vec::with_capacity(a.len());
    let mut carry = 0u64;
    let mut i = 0;
    while i < a.len() {
        let bi = if i < b.len() { b[i] } else { 0 };
        let s = a[i].wrapping_add(bi);
        let c1 = (s < a[i]) as u64;
        let s2 = s.wrapping_add(carry);
        carry = c1 | ((s2 < s) as u64);
        out.push(s2);
        i += 1;
    }
    out
}

// out = c ? a : b, in constant time (c is 0 or 1).
fn pick(c: u64, a: &[u64], b: &[u64], out: &mut [u64]) {
    let mask = 0u64.wrapping_sub(c);
    let mut i = 0;
    while i < a.len() {
        out[i] = (a[i] & mask) | (b[i] & !mask);
        i += 1;
    }
}

impl Modulus {
    /// The modulus of big-endian bytes (odd, above 1).
    pub fn new(be: &[u8]) -> Modulus {
        let mut nb = be;
        while nb.len() > 1 && nb[0] == 0 { nb = &nb[1..]; }
        let n = (nb.len() + 7) / 8;
        let m = be_to_limbs(nb, n);
        // -m^-1 mod 2^64 by Newton's iteration.
        let mut inv = 1u64;
        let mut k = 0;
        while k < 7 {
            inv = inv.wrapping_mul(2u64.wrapping_sub(m[0].wrapping_mul(inv)));
            k += 1;
        }
        let mut bits = 64 * n;
        let top = m[n - 1];
        let mut z = 63;
        while z > 0 && (top >> z) == 0 { z -= 1; }
        bits = 64 * (n - 1) + z + 1;
        let mut md = Modulus { m, m0inv: inv.wrapping_neg(), rr: Vec::new(), bits };
        // R^2 mod m: 1 doubled 2 * 64n times.
        let mut x: Vec<u64> = Vec::new();
        x.resize(n, 0);
        x[0] = 1;
        let mut i = 0;
        while i < 128 * n {
            x = md.add(&x, &x);
            i += 1;
        }
        md.rr = x;
        md
    }

    /// The number of limbs.
    pub fn limbs(&self) -> usize { self.m.len() }

    /// The modulus's length in bits and bytes.
    pub fn bits(&self) -> usize { self.bits }

    pub fn byte_len(&self) -> usize { (self.bits + 7) / 8 }

    /// x (big-endian bytes) as limbs, if it is below the modulus.
    pub fn from_be(&self, be: &[u8]) -> Option<Vec<u64>> {
        let mut b = be;
        while b.len() > 0 && b[0] == 0 { b = &b[1..]; }
        if b.len() > 8 * self.m.len() { return None; }
        let x = be_to_limbs(b, self.m.len());
        let mut t: Vec<u64> = Vec::new();
        t.resize(self.m.len(), 0);
        if sub_limbs(&x, &self.m, &mut t) == 0 { return None; }
        Some(x)
    }

    /// x (big-endian bytes, at most twice the modulus's limbs... any length
    /// up to its own) reduced: for hashes as scalars, x < 2m.
    pub fn reduce_once(&self, x: &[u64]) -> Vec<u64> {
        let n = self.m.len();
        let mut t: Vec<u64> = Vec::new();
        t.resize(n, 0);
        let borrow = sub_limbs(x, &self.m, &mut t);
        let mut out: Vec<u64> = Vec::new();
        out.resize(n, 0);
        pick(borrow, x, &t, &mut out);
        out
    }

    /// x mod m for x of big-endian bytes up to twice the modulus's limbs,
    /// when the modulus fills its top limb (so 2^(64 limbs) < 2m: each half
    /// needs one subtraction); None otherwise. Constant-time.
    pub fn reduce_wide(&self, be: &[u8]) -> Option<Vec<u64>> {
        let n = self.m.len();
        if self.bits != 64 * n { return None; }
        let mut b = be;
        while b.len() > 0 && b[0] == 0 { b = &b[1..]; }
        if b.len() > 16 * n { return None; }
        let all = be_to_limbs(b, 2 * n);
        let lo = self.reduce_once(&all[..n]);
        let hi = self.reduce_once(&all[n..]);
        // hi * 2^(64 n) = hi * R: mont_mul(hi, R^2).
        Some(self.add(&lo, &self.mont_mul(&hi, &self.rr)))
    }

    /// The modulus's limbs.
    pub fn value(&self) -> Vec<u64> { self.m.clone() }

    /// x as big-endian bytes, the modulus's length.
    pub fn to_be(&self, x: &[u64]) -> Vec<u8> {
        let len = self.byte_len();
        let mut out: Vec<u8> = Vec::with_capacity(len);
        let mut k = len;
        while k > 0 {
            k -= 1;
            out.push((x[k / 8] >> (8 * (k % 8))) as u8);
        }
        out
    }

    /// (a + b) mod m.
    pub fn add(&self, a: &[u64], b: &[u64]) -> Vec<u64> {
        let n = self.m.len();
        let mut s: Vec<u64> = Vec::new();
        s.resize(n, 0);
        let carry = add_limbs(a, b, &mut s);
        let mut t: Vec<u64> = Vec::new();
        t.resize(n, 0);
        let borrow = sub_limbs(&s, &self.m, &mut t);
        // s - m unless s < m (no carry and a borrow).
        let keep = borrow & (carry ^ 1);
        let mut out: Vec<u64> = Vec::new();
        out.resize(n, 0);
        pick(keep, &s, &t, &mut out);
        out
    }

    /// (a - b) mod m.
    pub fn sub(&self, a: &[u64], b: &[u64]) -> Vec<u64> {
        let n = self.m.len();
        let mut d: Vec<u64> = Vec::new();
        d.resize(n, 0);
        let borrow = sub_limbs(a, b, &mut d);
        let mut t: Vec<u64> = Vec::new();
        t.resize(n, 0);
        add_limbs(&d, &self.m, &mut t);
        let mut out: Vec<u64> = Vec::new();
        out.resize(n, 0);
        pick(borrow, &t, &d, &mut out);
        out
    }

    /// a * b * R^-1 mod m (CIOS).
    pub fn mont_mul(&self, a: &[u64], b: &[u64]) -> Vec<u64> {
        let n = self.m.len();
        let m = &self.m;
        let mut t: Vec<u64> = Vec::new();
        t.resize(n + 2, 0);
        let mut i = 0;
        while i < n {
            // t += a * b[i]
            let bi = b[i];
            let mut c = 0u64;
            let mut j = 0;
            while j < n {
                let (lo, hi) = a[j].widening_mul(bi);
                let s1 = lo.wrapping_add(t[j]);
                let h1 = hi + ((s1 < lo) as u64);
                let s2 = s1.wrapping_add(c);
                c = h1 + ((s2 < s1) as u64);
                t[j] = s2;
                j += 1;
            }
            let s = t[n].wrapping_add(c);
            t[n + 1] = (s < c) as u64;
            t[n] = s;
            // t = (t + q * m) / 2^64
            let q = t[0].wrapping_mul(self.m0inv);
            let (lo0, hi0) = q.widening_mul(m[0]);
            let s0 = lo0.wrapping_add(t[0]);
            c = hi0 + ((s0 < lo0) as u64);
            j = 1;
            while j < n {
                let (lo, hi) = q.widening_mul(m[j]);
                let s1 = lo.wrapping_add(t[j]);
                let h1 = hi + ((s1 < lo) as u64);
                let s2 = s1.wrapping_add(c);
                c = h1 + ((s2 < s1) as u64);
                t[j - 1] = s2;
                j += 1;
            }
            let s3 = t[n].wrapping_add(c);
            t[n - 1] = s3;
            t[n] = t[n + 1] + ((s3 < c) as u64);
            i += 1;
        }
        // t < 2m: subtract m unless t < m.
        let mut r: Vec<u64> = Vec::new();
        r.resize(n, 0);
        let borrow = sub_limbs(&t[..n], &self.m, &mut r);
        let keep = borrow & ((t[n] != 0) as u64 ^ 1);
        let mut out: Vec<u64> = Vec::new();
        out.resize(n, 0);
        pick(keep, &t[..n], &r, &mut out);
        out
    }

    /// x * R mod m (into Montgomery form).
    pub fn to_mont(&self, x: &[u64]) -> Vec<u64> { self.mont_mul(x, &self.rr) }

    /// x * R^-1 mod m (out of Montgomery form).
    pub fn from_mont(&self, x: &[u64]) -> Vec<u64> {
        let mut one: Vec<u64> = Vec::new();
        one.resize(self.m.len(), 0);
        one[0] = 1;
        self.mont_mul(x, &one)
    }

    /// R mod m: 1 in Montgomery form.
    pub fn one(&self) -> Vec<u64> {
        let mut one: Vec<u64> = Vec::new();
        one.resize(self.m.len(), 0);
        one[0] = 1;
        self.to_mont(&one)
    }

    /// x^e (x in Montgomery form, e big-endian bytes; the result too).
    /// Variable-time in e.
    pub fn pow(&self, x: &[u64], e: &[u8]) -> Vec<u64> {
        let mut r = self.one();
        for byte in e.iter() {
            let mut k = 8;
            while k > 0 {
                k -= 1;
                r = self.mont_mul(&r, &r);
                if ((*byte >> k as u8) & 1) != 0 { r = self.mont_mul(&r, x); }
            }
        }
        r
    }

    /// x^e (x in Montgomery form, e big-endian bytes; the result too) in
    /// time that depends only on e's length: a 4-bit fixed window whose
    /// table entries are read by masked selects (for secret exponents: RSA
    /// signing).
    pub fn pow_secret(&self, x: &[u64], e: &[u8]) -> Vec<u64> {
        let mut table: Vec<Vec<u64>> = Vec::new();
        table.push(self.one());
        table.push(x.to_vec());
        let mut i = 2;
        while i < 16 {
            let t = self.mont_mul(&table[i - 1], x);
            table.push(t);
            i += 1;
        }
        let n = self.m.len();
        let mut r = self.one();
        for byte in e.iter() {
            let mut half = 0;
            while half < 2 {
                let nib = if half == 0 { (*byte >> 4) as u64 } else { (*byte & 15) as u64 };
                let mut k = 0;
                while k < 4 {
                    r = self.mont_mul(&r, &r);
                    k += 1;
                }
                // t = table[nib], every entry read.
                let mut t: Vec<u64> = Vec::new();
                t.resize(n, 0);
                let mut j = 0;
                while j < 16 {
                    let d = (j as u64) ^ nib;
                    // 1 when d == 0.
                    let eq = ((d | d.wrapping_neg()) >> 63) ^ 1;
                    let mask = 0u64.wrapping_sub(eq);
                    let mut l = 0;
                    while l < n {
                        t[l] = t[l] | (table[j][l] & mask);
                        l += 1;
                    }
                    j += 1;
                }
                r = self.mont_mul(&r, &t);
                half += 1;
            }
        }
        r
    }

    /// 1/x (x in Montgomery form, m prime): x^(m-2).
    pub fn inv(&self, x: &[u64]) -> Vec<u64> {
        let mut two: Vec<u64> = Vec::new();
        two.resize(self.m.len(), 0);
        two[0] = 2;
        let mut e: Vec<u64> = Vec::new();
        e.resize(self.m.len(), 0);
        sub_limbs(&self.m, &two, &mut e);
        self.pow(x, self.to_be(&e).as_slice())
    }

    /// Whether x is zero, in constant time.
    pub fn is_zero(&self, x: &[u64]) -> bool {
        let mut acc = 0u64;
        for l in x.iter() { acc = acc | *l; }
        acc == 0
    }

    /// Whether a == b, in constant time.
    pub fn eq(&self, a: &[u64], b: &[u64]) -> bool {
        let mut acc = 0u64;
        let mut i = 0;
        while i < a.len() {
            acc = acc | (a[i] ^ b[i]);
            i += 1;
        }
        acc == 0
    }

    /// out = c ? a : b in constant time.
    pub fn pick(&self, c: u64, a: &[u64], b: &[u64]) -> Vec<u64> {
        let mut out: Vec<u64> = Vec::new();
        out.resize(self.m.len(), 0);
        pick(c, a, b, &mut out);
        out
    }
}
