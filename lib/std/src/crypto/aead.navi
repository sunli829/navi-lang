//! Authenticated encryption with associated data, with the API of
//! RustCrypto's aead crate: ciphers (crypto::aes_gcm,
//! crypto::chacha20poly1305) are made with `KeyInit::new_from_slice` and
//! used through `Aead` (ciphertext with the tag appended) or `AeadInPlace`
//! (a buffer and a detached tag).
//!
//!     use std::crypto::aead::{Aead, KeyInit, Payload};
//!     use std::crypto::aes_gcm::Aes256Gcm;
//!
//!     let cipher = Aes256Gcm::new_from_slice(&key).unwrap();
//!     let ct = cipher.encrypt(&nonce, b"plaintext".as_slice()).unwrap();
//!     let pt = cipher.decrypt(&nonce, Payload { msg: &ct, aad: b"header" })?;
//!
//! Keys, nonces and tags are byte slices (the crate uses fixed-size
//! arrays); a nonce of the wrong length is an Error.

use crate::fmt::{self, Display, Formatter};

/// The error of encryption or decryption (as the crate's: no detail, so
/// that a failed decryption tells nothing).
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct Error;

impl Display for Error {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("aead::Error")
    }
}

/// A key of the wrong length.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct InvalidLength;

impl Display for InvalidLength {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("invalid key length")
    }
}

/// A message and its associated data (authenticated, not encrypted).
pub struct Payload {
    pub msg: &[u8],
    pub aad: &[u8],
}

impl From<&[u8]> for Payload {
    fn from(msg: &[u8]) -> Payload {
        Payload { msg, aad: &[] }
    }
}

impl From<&Vec<u8>> for Payload {
    fn from(msg: &Vec<u8>) -> Payload {
        Payload {
            msg: msg.as_slice(),
            aad: &[],
        }
    }
}

/// A cipher made from a key.
pub trait KeyInit {
    /// The key's length in bytes.
    const KEY_SIZE: usize;
    fn new_from_slice(key: &[u8]) -> Result<Self, InvalidLength>;
}

/// Encryption and decryption in place: the ciphertext replaces the
/// plaintext in buffer, the tag is apart.
pub trait AeadInPlace {
    /// The nonce's and the tag's lengths in bytes.
    const NONCE_SIZE: usize;
    const TAG_SIZE: usize;

    fn encrypt_in_place_detached(
        &self,
        nonce: &[u8],
        aad: &[u8],
        buffer: &mut [u8],
    ) -> Result<Vec<u8>, Error>;
    /// The plaintext replaces the ciphertext if the tag is right; else an
    /// Error and buffer unchanged.
    fn decrypt_in_place_detached(
        &self,
        nonce: &[u8],
        aad: &[u8],
        buffer: &mut [u8],
        tag: &[u8],
    ) -> Result<(), Error>;
}

/// Encryption to a new buffer: the ciphertext, then the tag.
pub trait Aead {
    fn encrypt<P: Into<Payload>>(&self, nonce: &[u8], plaintext: P) -> Result<Vec<u8>, Error>;
    fn decrypt<P: Into<Payload>>(&self, nonce: &[u8], ciphertext: P) -> Result<Vec<u8>, Error>;
}

impl<C: AeadInPlace> Aead for C {
    fn encrypt<P: Into<Payload>>(&self, nonce: &[u8], plaintext: P) -> Result<Vec<u8>, Error> {
        let p: Payload = plaintext.into();
        let mut buf = p.msg.to_vec();
        let tag = self.encrypt_in_place_detached(nonce, p.aad, buf.as_mut_slice())?;
        buf.extend_from_slice(tag.as_slice());
        Ok(buf)
    }

    fn decrypt<P: Into<Payload>>(&self, nonce: &[u8], ciphertext: P) -> Result<Vec<u8>, Error> {
        let p: Payload = ciphertext.into();
        if p.msg.len() < C::TAG_SIZE {
            return Err(Error);
        }
        let n = p.msg.len() - C::TAG_SIZE;
        let mut buf = p.msg[..n].to_vec();
        self.decrypt_in_place_detached(nonce, p.aad, buf.as_mut_slice(), &p.msg[n..])?;
        Ok(buf)
    }
}
