//! RSA signatures (RFC 8017), with the API of RustCrypto's `rsa` crate.
//!
//! An [`RsaPublicKey`](crate::crypto::rsa::RsaPublicKey) (from n and e, or
//! PKCS#1 DER) verifies a hash's signature under
//! [`Pkcs1v15Sign`](crate::crypto::rsa::Pkcs1v15Sign) or
//! [`Pss`](crate::crypto::rsa::Pss); an
//! [`RsaPrivateKey`](crate::crypto::rsa::RsaPrivateKey) signs.
//!
//! # Examples
//!
//! ```
//! use std::crypto::rsa::{Pkcs1v15Sign, Pss, RsaPrivateKey};
//! use std::crypto::sha2::{Digest, Sha256};
//! use std::hex;
//!
//! // A 512-bit test key in PKCS#1 DER (too small for real use).
//! let mut der_hex = String::new();
//! # der_hex.push_str("3082013a020100024100e37ad93203e151cf83fa7b12eff9237063f36f2394715ee5d8dedfdfce9a");
//! # der_hex.push_str("4d1cc210f2fca6d698803fb5e0b7f140d20ce64692021e9d050fd1a0c6269a8567d3020301000102");
//! # der_hex.push_str("4100cd3063b7ecae12a87768ba1943e2dba7a650d0002d06f24dab88a631efdf590b932bf98ba8f8");
//! # der_hex.push_str("c829ce0adad60f57cf6fddd7cb671304b296ad6bcf253a3b8d99022100f88289a04c6a44aaa74d7c");
//! # der_hex.push_str("c153f4bd92af8c588bed2b29570abc0acaa712ed8f022100ea560be4547ad003b28910a072e91027");
//! # der_hex.push_str("0fd3e0a5acfbadf35e7eb81b566f877d02201315ab4e1530400fbf0373664175552db3af9a893c70");
//! # der_hex.push_str("891f3722d3cd56615cbf0220470229fa578b1b8b73474b6d8344926b73c55d7676b391238507db1c");
//! # der_hex.push_str("15961835022061f1c1f31c6e3b9ac3101e3750531454ae3d9f9f8ee29aed3424da8a0fa1a8ec");
//! let key = RsaPrivateKey::from_pkcs1_der(hex::decode(der_hex).unwrap().as_slice()).unwrap();
//! let public = key.to_public_key();
//! let hashed = Sha256::digest(b"hello");
//!
//! let sig = key.sign(Pkcs1v15Sign::new::<Sha256>(), hashed.as_slice()).unwrap();
//! assert(public.verify(Pkcs1v15Sign::new::<Sha256>(), hashed.as_slice(), sig.as_slice()).is_ok());
//!
//! // (A salt as long as the hash would not fit this small key.)
//! let sig = key.sign(Pss::new_with_salt::<Sha256>(16), hashed.as_slice()).unwrap();
//! assert(public.verify(Pss::new_with_salt::<Sha256>(16), hashed.as_slice(), sig.as_slice()).is_ok());
//! ```
//!
//! Signing too (`RsaPrivateKey::sign`, from PKCS#1 or PKCS#8 DER): the
//! private exponentiation is constant-time (a fixed window, masked table
//! reads) and checked against the public key. No encryption or
//! decryption: TLS (1.2 with ECDHE, 1.3) does not use them.

use crate::{
    crypto::{
        Digest,
        der::{self, Reader},
        nat::{self, Modulus},
        subtle::constant_time_eq,
    },
    fmt::{self, Display, Formatter},
    rand::{RngCore, rngs::OsRng},
};

/// A bad key or a signature that does not verify (as the crate's
/// `rsa::Error`, without detail for signatures).
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum Error {
    /// The key is malformed, too small or inconsistent, or too small for
    /// the scheme and hash.
    InvalidKey,
    /// The signature does not verify.
    Verification,
}

impl Display for Error {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        match self {
            Error::InvalidKey => f.write_str("invalid RSA public key"),
            Error::Verification => f.write_str("verification error"),
        }
    }
}

/// An RSA public key: the modulus n and the exponent e.
///
/// # Examples
///
/// ```
/// use std::crypto::rsa::{Pkcs1v15Sign, RsaPublicKey};
/// use std::crypto::sha2::{Digest, Sha256};
/// use std::hex;
///
/// // A 512-bit test key (PKCS#1 RSAPublicKey DER) and its signature of
/// // "hello", made with `openssl dgst -sha256 -sign`.
/// let der = hex::decode("3048024100e37ad93203e151cf83fa7b12eff9237063f36f2394715ee5d8dedfdfce9a4d1cc210f2fca6d698803fb5e0b7f140d20ce64692021e9d050fd1a0c6269a8567d30203010001").unwrap();
/// let sig = hex::decode("22668f4a925383f8af457dba3fce1983f657cd9a8b9271f5aa638c67569f623a2f35dbed1e65b9a6832610e021ab53e15ec87dc940309b4aabb94f26f335e292").unwrap();
/// let key = RsaPublicKey::from_pkcs1_der(der.as_slice()).unwrap();
/// assert_eq(key.size(), 64);
/// assert_eq(key.e(), b"\x01\x00\x01");
/// let hashed = Sha256::digest(b"hello");
/// assert(key.verify(Pkcs1v15Sign::new::<Sha256>(), hashed.as_slice(), sig.as_slice()).is_ok());
/// let other = Sha256::digest(b"hellO");
/// assert(key.verify(Pkcs1v15Sign::new::<Sha256>(), other.as_slice(), sig.as_slice()).is_err());
/// ```
#[derive(Clone)]
pub struct RsaPublicKey {
    n: Vec<u8>,
    e: Vec<u8>,
    m: Modulus,
}

fn strip(b: &[u8]) -> Vec<u8> {
    let mut s = b;
    while s.len() > 0 && s[0] == 0 {
        s = &s[1..];
    }
    s.to_vec()
}

// A DER length at b[i..]: the length and where the contents start.
fn der_len(b: &[u8], i: usize) -> Option<(usize, usize)> {
    if i >= b.len() {
        return None;
    }
    let first = b[i] as usize;
    if first < 0x80 {
        return Some((first, i + 1));
    }
    let n = first & 0x7f;
    if n == 0 || n > 3 || i + 1 + n > b.len() {
        return None;
    }
    let mut len = 0usize;
    let mut k = 0;
    while k < n {
        len = (len << 8) | (b[i + 1 + k] as usize);
        k += 1;
    }
    Some((len, i + 1 + n))
}

impl RsaPublicKey {
    /// Makes the key of modulus `n` and exponent `e` (big-endian).
    ///
    /// # Errors
    ///
    /// [`Error::InvalidKey`] if `n` is even or shorter than 512 bits, or
    /// `e` is even, below 3 or longer than 8 bytes.
    pub fn from_be_bytes(n: &[u8], e: &[u8]) -> Result<RsaPublicKey, Error> {
        let n = strip(n);
        let e = strip(e);
        // At least 512 bits, odd; e odd, above 1, at most 8 bytes.
        if n.len() < 64 || (n[n.len() - 1] & 1) == 0 {
            return Err(Error::InvalidKey);
        }
        if e.len() == 0 || e.len() > 8 || (e[e.len() - 1] & 1) == 0 || (e.len() == 1 && e[0] < 3) {
            return Err(Error::InvalidKey);
        }
        let m = Modulus::new(n.as_slice());
        Ok(RsaPublicKey { n, e, m })
    }

    /// Makes the key of a PKCS#1 RSAPublicKey in DER:
    /// `SEQUENCE { INTEGER n, INTEGER e }`.
    ///
    /// # Errors
    ///
    /// [`Error::InvalidKey`] if `der` is not such a key, or the key is not
    /// accepted (see [`RsaPublicKey::from_be_bytes`]).
    pub fn from_pkcs1_der(der: &[u8]) -> Result<RsaPublicKey, Error> {
        if der.len() < 2 || der[0] != 0x30 {
            return Err(Error::InvalidKey);
        }
        let (len, at) = der_len(der, 1).ok_or(Error::InvalidKey)?;
        if at + len != der.len() {
            return Err(Error::InvalidKey);
        }
        let mut i = at;
        let mut ints: Vec<Vec<u8>> = Vec::new();
        while ints.len() < 2 {
            if i >= der.len() || der[i] != 2 {
                return Err(Error::InvalidKey);
            }
            let (l, s) = der_len(der, i + 1).ok_or(Error::InvalidKey)?;
            if s + l > der.len() || l == 0 {
                return Err(Error::InvalidKey);
            }
            ints.push(der[s..s + l].to_vec());
            i = s + l;
        }
        if i != der.len() {
            return Err(Error::InvalidKey);
        }
        RsaPublicKey::from_be_bytes(ints[0].as_slice(), ints[1].as_slice())
    }

    /// The modulus's length in bytes.
    pub fn size(&self) -> usize {
        self.m.byte_len()
    }

    /// The modulus (big-endian).
    pub fn n(&self) -> &[u8] {
        self.n.as_slice()
    }

    /// Returns the exponent (big-endian).
    pub fn e(&self) -> &[u8] {
        self.e.as_slice()
    }

    /// Checks that `sig` is this key's signature of `hashed` (a message's
    /// hash) under `scheme`.
    ///
    /// # Errors
    ///
    /// [`Error::Verification`] if it is not, and [`Error::InvalidKey`] if
    /// the key is too small for the scheme.
    pub fn verify<S: SignatureScheme>(
        &self,
        scheme: S,
        hashed: &[u8],
        sig: &[u8],
    ) -> Result<(), Error> {
        scheme.verify(self, hashed, sig)
    }

    // sig^e mod n as the modulus's length in bytes; None if sig is not
    // below n or not its length.
    fn public_op(&self, sig: &[u8]) -> Option<Vec<u8>> {
        if sig.len() != self.size() {
            return None;
        }
        let s = self.m.from_be(sig)?;
        let r = self.m.pow(&self.m.to_mont(&s), self.e.as_slice());
        Some(self.m.to_be(&self.m.from_mont(&r)))
    }
}

/// An RSA secret key.
///
/// Signing uses the CRT values when the key has them (PKCS#1 keys do),
/// else d; either way in constant time, and the signature is checked with
/// the public key before it is returned.
///
/// # Examples
///
/// The PKCS#1 v1.5 signature is deterministic: the same as OpenSSL's.
///
/// ```
/// use std::crypto::rsa::{Pkcs1v15Sign, RsaPrivateKey};
/// use std::crypto::sha2::{Digest, Sha256};
/// use std::hex;
///
/// // A 512-bit test key in PKCS#1 DER (too small for real use).
/// let mut der_hex = String::new();
/// # der_hex.push_str("3082013a020100024100e37ad93203e151cf83fa7b12eff9237063f36f2394715ee5d8dedfdfce9a");
/// # der_hex.push_str("4d1cc210f2fca6d698803fb5e0b7f140d20ce64692021e9d050fd1a0c6269a8567d3020301000102");
/// # der_hex.push_str("4100cd3063b7ecae12a87768ba1943e2dba7a650d0002d06f24dab88a631efdf590b932bf98ba8f8");
/// # der_hex.push_str("c829ce0adad60f57cf6fddd7cb671304b296ad6bcf253a3b8d99022100f88289a04c6a44aaa74d7c");
/// # der_hex.push_str("c153f4bd92af8c588bed2b29570abc0acaa712ed8f022100ea560be4547ad003b28910a072e91027");
/// # der_hex.push_str("0fd3e0a5acfbadf35e7eb81b566f877d02201315ab4e1530400fbf0373664175552db3af9a893c70");
/// # der_hex.push_str("891f3722d3cd56615cbf0220470229fa578b1b8b73474b6d8344926b73c55d7676b391238507db1c");
/// # der_hex.push_str("15961835022061f1c1f31c6e3b9ac3101e3750531454ae3d9f9f8ee29aed3424da8a0fa1a8ec");
/// let key = RsaPrivateKey::from_pkcs1_der(hex::decode(der_hex).unwrap().as_slice()).unwrap();
/// let sig = key.sign(Pkcs1v15Sign::new::<Sha256>(), Sha256::digest(b"hello").as_slice()).unwrap();
/// assert_eq(hex::encode(sig), "22668f4a925383f8af457dba3fce1983f657cd9a8b9271f5aa638c67569f623a2f35dbed1e65b9a6832610e021ab53e15ec87dc940309b4aabb94f26f335e292");
/// ```
#[derive(Clone)]
pub struct RsaPrivateKey {
    public: RsaPublicKey,
    d: Vec<u8>,
    primes: Vec<Vec<u8>>,
    crt: Option<Crt>,
}

// The Chinese remainder theorem's values (PKCS#1's): signing is two
// exponentiations of half the size, about 4 times faster.
#[derive(Clone)]
struct Crt {
    p: Modulus,
    q: Modulus,
    dp: Vec<u8>,
    dq: Vec<u8>,
    /// q^-1 mod p, in p's Montgomery form.
    qinv: Vec<u64>,
    q_limbs: Vec<u64>,
}

fn crt_of(p: &[u8], q: &[u8], dp: &[u8], dq: &[u8], qinv: &[u8]) -> Option<Crt> {
    let pm = Modulus::new(p);
    let qm = Modulus::new(q);
    // (Two primes that fill their limbs, as RSA's are: see reduce_wide.)
    if pm.limbs() != qm.limbs() || pm.bits() != 64 * pm.limbs() || qm.bits() != 64 * qm.limbs() {
        return None;
    }
    let qi = pm.from_be(qinv)?;
    Some(Crt {
        p: pm.clone(),
        q: qm.clone(),
        dp: strip(dp),
        dq: strip(dq),
        qinv: pm.to_mont(&qi),
        q_limbs: qm.value(),
    })
}

impl RsaPrivateKey {
    /// Makes the key of `n`, `e`, `d` and the primes (big-endian).
    ///
    /// # Errors
    ///
    /// [`Error::InvalidKey`] if the public part is not accepted (see
    /// [`RsaPublicKey::from_be_bytes`]) or the components do not match.
    pub fn from_components(
        n: &[u8],
        e: &[u8],
        d: &[u8],
        primes: Vec<Vec<u8>>,
    ) -> Result<RsaPrivateKey, Error> {
        let public = RsaPublicKey::from_be_bytes(n, e)?;
        let d = strip(d);
        if d.len() == 0 || d.len() > public.size() {
            return Err(Error::InvalidKey);
        }
        let k = RsaPrivateKey {
            public,
            d,
            primes,
            crt: None,
        };
        // A sign-and-check round trip catches inconsistent components.
        let mut m: Vec<u8> = Vec::new();
        m.resize(k.public.size(), 0);
        m[k.public.size() - 1] = 2;
        k.private_op(m.as_slice())?;
        Ok(k)
    }

    /// Makes the key of a PKCS#1 RSAPrivateKey in DER (two primes):
    /// `SEQUENCE { version, n, e, d, p, q, dP, dQ, qInv }`.
    ///
    /// # Errors
    ///
    /// [`Error::InvalidKey`] if `der` is not such a key or its components
    /// do not match.
    pub fn from_pkcs1_der(der: &[u8]) -> Result<RsaPrivateKey, Error> {
        let mut top = Reader::new(der);
        let mut r = top.read_nested(der::SEQUENCE).ok_or(Error::InvalidKey)?;
        if !top.is_empty() {
            return Err(Error::InvalidKey);
        }
        if r.read_i64() != Some(0) {
            return Err(Error::InvalidKey);
        }
        let mut v: Vec<Vec<u8>> = Vec::new();
        while v.len() < 8 {
            v.push(r.read_unsigned().ok_or(Error::InvalidKey)?.to_vec());
        }
        if !r.is_empty() {
            return Err(Error::InvalidKey);
        }
        let mut k = RsaPrivateKey::from_components(
            v[0].as_slice(),
            v[1].as_slice(),
            v[2].as_slice(),
            vec_of2(v[3].clone(), v[4].clone()),
        )?;
        k.crt = crt_of(
            v[3].as_slice(),
            v[4].as_slice(),
            v[5].as_slice(),
            v[6].as_slice(),
            v[7].as_slice(),
        );
        // (The round trip again, through the CRT: bad values are an error.)
        let mut m: Vec<u8> = Vec::new();
        m.resize(k.public.size(), 0);
        m[k.public.size() - 1] = 2;
        k.private_op(m.as_slice())?;
        Ok(k)
    }

    /// Makes the key of a PKCS#8 PrivateKeyInfo in DER holding an
    /// rsaEncryption key (the usual `-----BEGIN PRIVATE KEY-----` PEM's
    /// contents).
    ///
    /// # Errors
    ///
    /// [`Error::InvalidKey`] if `der` is not such a key.
    pub fn from_pkcs8_der(der: &[u8]) -> Result<RsaPrivateKey, Error> {
        let mut top = Reader::new(der);
        let mut r = top.read_nested(der::SEQUENCE).ok_or(Error::InvalidKey)?;
        if r.read_i64() != Some(0) {
            return Err(Error::InvalidKey);
        }
        let mut alg = r.read_nested(der::SEQUENCE).ok_or(Error::InvalidKey)?;
        let oid = alg.read_oid().ok_or(Error::InvalidKey)?;
        if der::oid_string(oid) != "1.2.840.113549.1.1.1" {
            return Err(Error::InvalidKey);
        }
        let inner = r.read(der::OCTET_STRING).ok_or(Error::InvalidKey)?;
        RsaPrivateKey::from_pkcs1_der(inner)
    }

    /// Returns the public key.
    pub fn to_public_key(&self) -> RsaPublicKey {
        self.public.clone()
    }

    /// The modulus's length in bytes.
    pub fn size(&self) -> usize {
        self.public.size()
    }

    /// Returns the private exponent (big-endian).
    pub fn d(&self) -> &[u8] {
        self.d.as_slice()
    }

    /// Returns the primes (big-endian), as given.
    pub fn primes(&self) -> &[Vec<u8>] {
        self.primes.as_slice()
    }

    /// Signs `hashed` (a message's hash) under `scheme`, returning a
    /// signature of [`RsaPrivateKey::size`] bytes. PSS salts come from the
    /// operating system's random source.
    ///
    /// # Errors
    ///
    /// [`Error::InvalidKey`] if the key is too small for the scheme and
    /// hash.
    pub fn sign<S: SignatureScheme>(&self, scheme: S, hashed: &[u8]) -> Result<Vec<u8>, Error> {
        scheme.sign(self, hashed)
    }

    // m^d mod n (m the modulus's length), constant-time in d; checked by
    // raising back to e.
    fn private_op(&self, m: &[u8]) -> Result<Vec<u8>, Error> {
        let md = &self.public.m;
        let x = md.from_be(m).ok_or(Error::Verification)?;
        let c = match self.crt_op(m) {
            Some(c) => c,
            None => md.from_mont(&md.pow_secret(&md.to_mont(&x), self.d.as_slice())),
        };
        let back = md.from_mont(&md.pow(&md.to_mont(&c), self.public.e.as_slice()));
        if !md.eq(&back, &x) {
            return Err(Error::InvalidKey);
        }
        Ok(md.to_be(&c))
    }
}

impl RsaPrivateKey {
    // m^d mod n by the CRT (Garner): m1 = m^dP mod p, m2 = m^dQ mod q,
    // h = qInv (m1 - m2) mod p, m2 + h q. None without the CRT values.
    fn crt_op(&self, m: &[u8]) -> Option<Vec<u64>> {
        let crt = match &self.crt {
            Some(c) => c,
            None => return None,
        };
        let (p, q) = (&crt.p, &crt.q);
        let cp = p.reduce_wide(m)?;
        let cq = q.reduce_wide(m)?;
        let m1 = p.from_mont(&p.pow_secret(&p.to_mont(&cp), crt.dp.as_slice()));
        let m2 = q.from_mont(&q.pow_secret(&q.to_mont(&cq), crt.dq.as_slice()));
        // m2 < q < 2^(64 limbs) < 2p.
        let m2p = p.reduce_once(&m2);
        let h = p.mont_mul(&crt.qinv, &p.sub(&m1, &m2p));
        let r = nat::add_wide(nat::mul_wide(&h, crt.q_limbs.as_slice()).as_slice(), &m2);
        // As many limbs as n.
        let n = self.public.m.limbs();
        let mut out: Vec<u64> = Vec::new();
        let mut i = 0;
        while i < n {
            out.push(if i < r.len() { r[i] } else { 0 });
            i += 1;
        }
        Some(out)
    }
}

fn vec_of2(a: Vec<u8>, b: Vec<u8>) -> Vec<Vec<u8>> {
    let mut v: Vec<Vec<u8>> = Vec::new();
    v.push(a);
    v.push(b);
    v
}

/// A signature scheme (as the crate's `SignatureScheme`): [`Pkcs1v15Sign`]
/// or [`Pss`].
pub trait SignatureScheme {
    /// Checks that `sig` is `key`'s signature of `hashed`.
    ///
    /// # Errors
    ///
    /// An [`Error`] if it is not.
    fn verify(&self, key: &RsaPublicKey, hashed: &[u8], sig: &[u8]) -> Result<(), Error>;
    /// Signs `hashed` with `key`.
    ///
    /// # Errors
    ///
    /// An [`Error`] if the key is too small for the scheme.
    fn sign(&self, key: &RsaPrivateKey, hashed: &[u8]) -> Result<Vec<u8>, Error>;
}

// The DigestInfo prefix of a hash by its output length (SHA-1, SHA-224,
// SHA-256, SHA-384, SHA-512).
fn digest_info(len: usize) -> Vec<u8> {
    let hex = match len {
        20 => "3021300906052b0e03021a05000414",
        28 => "302d300d06096086480165030402040500041c",
        32 => "3031300d060960864801650304020105000420",
        48 => "3041300d060960864801650304020205000430",
        64 => "3051300d060960864801650304020305000440",
        _ => "",
    };
    crate::hex::decode(hex).unwrap()
}

/// PKCS#1 v1.5 signatures (RFC 8017 8.2).
#[derive(Clone)]
pub struct Pkcs1v15Sign {
    prefix: Vec<u8>,
    hash_len: usize,
}

impl Pkcs1v15Sign {
    /// For hashes by D (SHA-1 or SHA-2).
    pub fn new<D: Digest>() -> Pkcs1v15Sign {
        Pkcs1v15Sign {
            prefix: digest_info(D::OUTPUT_SIZE),
            hash_len: D::OUTPUT_SIZE,
        }
    }

    /// Without a DigestInfo (the hash alone, as TLS 1.1's MD5-SHA1).
    pub fn new_unprefixed() -> Pkcs1v15Sign {
        Pkcs1v15Sign {
            prefix: Vec::new(),
            hash_len: 0,
        }
    }
}

impl Pkcs1v15Sign {
    // 00 01 ff... 00 || DigestInfo || hash, k bytes.
    fn encode(&self, hashed: &[u8], k: usize) -> Option<Vec<u8>> {
        if self.hash_len != 0 && hashed.len() != self.hash_len {
            return None;
        }
        let t_len = self.prefix.len() + hashed.len();
        if k < t_len + 11 {
            return None;
        }
        let mut em: Vec<u8> = Vec::with_capacity(k);
        em.push(0);
        em.push(1);
        while em.len() < k - t_len - 1 {
            em.push(0xff);
        }
        em.push(0);
        em.extend_from_slice(self.prefix.as_slice());
        em.extend_from_slice(hashed);
        Some(em)
    }
}

impl SignatureScheme for Pkcs1v15Sign {
    fn verify(&self, key: &RsaPublicKey, hashed: &[u8], sig: &[u8]) -> Result<(), Error> {
        let want = self.encode(hashed, key.size()).ok_or(Error::Verification)?;
        let em = key.public_op(sig).ok_or(Error::Verification)?;
        if constant_time_eq(em.as_slice(), want.as_slice()) {
            Ok(())
        } else {
            Err(Error::Verification)
        }
    }

    fn sign(&self, key: &RsaPrivateKey, hashed: &[u8]) -> Result<Vec<u8>, Error> {
        let em = self.encode(hashed, key.size()).ok_or(Error::Verification)?;
        key.private_op(em.as_slice())
    }
}

/// PSS signatures (RFC 8017 8.1), MGF1 with the same hash.
#[derive(Clone)]
pub struct Pss {
    hash: fn(&[u8]) -> Vec<u8>,
    hash_len: usize,
    /// None: any salt length (found from the encoding).
    salt_len: Option<usize>,
}

impl Pss {
    /// For hashes by D, the salt as long as the hash (as the crate's, and
    /// TLS 1.3's).
    pub fn new<D: Digest>() -> Pss {
        Pss {
            hash: |b: &[u8]| -> Vec<u8> { D::digest(b) },
            hash_len: D::OUTPUT_SIZE,
            salt_len: Some(D::OUTPUT_SIZE),
        }
    }

    /// With a salt of len bytes.
    pub fn new_with_salt<D: Digest>(len: usize) -> Pss {
        Pss {
            hash: |b: &[u8]| -> Vec<u8> { D::digest(b) },
            hash_len: D::OUTPUT_SIZE,
            salt_len: Some(len),
        }
    }

    /// With a salt of any length (as Go's PSSSaltLengthAuto).
    pub fn new_with_any_salt<D: Digest>() -> Pss {
        Pss {
            hash: |b: &[u8]| -> Vec<u8> { D::digest(b) },
            hash_len: D::OUTPUT_SIZE,
            salt_len: None,
        }
    }

    // MGF1(seed, len).
    fn mgf1(&self, seed: &[u8], len: usize) -> Vec<u8> {
        let mut out: Vec<u8> = Vec::with_capacity(len + self.hash_len);
        let mut counter = 0u32;
        while out.len() < len {
            let mut b = seed.to_vec();
            b.push((counter >> 24) as u8);
            b.push((counter >> 16) as u8);
            b.push((counter >> 8) as u8);
            b.push(counter as u8);
            out.extend_from_slice((self.hash)(b.as_slice()).as_slice());
            counter += 1;
        }
        out.truncate(len);
        out
    }
}

impl SignatureScheme for Pss {
    fn verify(&self, key: &RsaPublicKey, hashed: &[u8], sig: &[u8]) -> Result<(), Error> {
        let h_len = self.hash_len;
        if hashed.len() != h_len {
            return Err(Error::Verification);
        }
        let mod_bits = key.m.bits();
        let em_bits = mod_bits - 1;
        let em_len = (em_bits + 7) / 8;
        let full = key.public_op(sig).ok_or(Error::Verification)?;
        // (k bytes; when emBits is a multiple of 8 the first is zero.)
        if full.len() > em_len && full[0] != 0 {
            return Err(Error::Verification);
        }
        let em = &full[full.len() - em_len..];
        if em_len < h_len + 2 || em[em_len - 1] != 0xbc {
            return Err(Error::Verification);
        }
        let db_len = em_len - h_len - 1;
        let masked = &em[..db_len];
        let h = &em[db_len..db_len + h_len];
        let top = 8 * em_len - em_bits;
        let top_mask: u8 = if top == 0 {
            0
        } else {
            (0xffu16 << (8 - top) as u16) as u8
        };
        if (masked[0] & top_mask) != 0 {
            return Err(Error::Verification);
        }
        let mask = self.mgf1(h, db_len);
        let mut db: Vec<u8> = Vec::with_capacity(db_len);
        let mut i = 0;
        while i < db_len {
            db.push(masked[i] ^ mask[i]);
            i += 1;
        }
        db[0] = db[0] & !top_mask;
        // PS (zeros), 01, salt.
        let mut p = 0;
        while p < db_len && db[p] == 0 {
            p += 1;
        }
        if p >= db_len || db[p] != 1 {
            return Err(Error::Verification);
        }
        let salt = &db[p + 1..];
        if let Some(want) = self.salt_len {
            if salt.len() != want {
                return Err(Error::Verification);
            }
        }
        let mut m2: Vec<u8> = Vec::with_capacity(8 + h_len + salt.len());
        m2.resize(8, 0);
        m2.extend_from_slice(hashed);
        m2.extend_from_slice(salt);
        let h2 = (self.hash)(m2.as_slice());
        if constant_time_eq(h2.as_slice(), h) {
            Ok(())
        } else {
            Err(Error::Verification)
        }
    }

    // EMSA-PSS-ENCODE (RFC 8017 9.1.1) with a random salt (as long as the
    // hash when the length is any).
    fn sign(&self, key: &RsaPrivateKey, hashed: &[u8]) -> Result<Vec<u8>, Error> {
        let h_len = self.hash_len;
        if hashed.len() != h_len {
            return Err(Error::Verification);
        }
        let em_bits = key.public.m.bits() - 1;
        let em_len = (em_bits + 7) / 8;
        let s_len = match self.salt_len {
            Some(n) => n,
            None => h_len,
        };
        if em_len < h_len + s_len + 2 {
            return Err(Error::Verification);
        }
        let mut salt: Vec<u8> = Vec::new();
        salt.resize(s_len, 0);
        OsRng.fill_bytes(salt.as_mut_slice());
        let mut m2: Vec<u8> = Vec::new();
        m2.resize(8, 0);
        m2.extend_from_slice(hashed);
        m2.extend_from_slice(salt.as_slice());
        let h = (self.hash)(m2.as_slice());
        let db_len = em_len - h_len - 1;
        let mut db: Vec<u8> = Vec::new();
        db.resize(db_len - s_len - 1, 0);
        db.push(1);
        db.extend_from_slice(salt.as_slice());
        let mask = self.mgf1(h.as_slice(), db_len);
        let mut i = 0;
        while i < db_len {
            db[i] = db[i] ^ mask[i];
            i += 1;
        }
        let top = 8 * em_len - em_bits;
        if top > 0 {
            db[0] = db[0] & (0xffu16 >> top as u16) as u8;
        }
        // EM, left-padded to the modulus's length.
        let mut em: Vec<u8> = Vec::new();
        em.resize(key.size() - em_len, 0);
        em.extend_from_slice(db.as_slice());
        em.extend_from_slice(h.as_slice());
        em.push(0xbc);
        key.private_op(em.as_slice())
    }
}
