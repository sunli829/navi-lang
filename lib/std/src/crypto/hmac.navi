//! HMAC (RFC 2104), a message authentication code over any hash, as the
//! `hmac` crate.
//!
//! # Security
//!
//! Check a tag with
//! [`Mac::verify_slice`](crate::crypto::hmac::Mac::verify_slice), which
//! compares in constant time, not with `==` on the output of `finalize` (which
//! can leak how much of a forged tag is right).
//!
//! # Examples
//!
//! ```
//! use std::crypto::hmac::{Hmac, Mac};
//! use std::crypto::sha2::Sha256;
//! use std::hex;
//!
//! type HmacSha256 = Hmac<Sha256>;
//!
//! // RFC 4231, test case 2.
//! let mut mac = HmacSha256::new_from_slice(b"Jefe").unwrap();
//! mac.update(b"what do ya want for nothing?");
//! let tag: Vec<u8> = mac.finalize();
//! assert_eq(hex::encode(&tag), "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843");
//!
//! let mut check = HmacSha256::new_from_slice(b"Jefe").unwrap();
//! check.update(b"what do ya want for nothing?");
//! assert(check.verify_slice(&tag).is_ok());
//! ```

use super::Digest;
use super::subtle::constant_time_eq;
use crate::fmt::{self, Debug, Display, Formatter};
use crate::io;

/// The error returned when a key is not accepted.
///
/// HMAC takes keys of any length and never returns it; the type exists for
/// the crate's signatures.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct InvalidLength;

impl Display for InvalidLength {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("Invalid Length")
    }
}

/// The error returned when a tag does not match.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct MacError;

impl Display for MacError {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("MAC tag mismatch")
    }
}

/// A message authentication code (RustCrypto's `Mac`).
///
/// # Examples
///
/// ```
/// use std::crypto::hmac::{Hmac, Mac};
/// use std::crypto::sha1::Sha1;
/// use std::hex;
///
/// let mac = Hmac::<Sha1>::new_from_slice(b"key").unwrap()
///     .chain_update(b"The quick brown fox ")
///     .chain_update(b"jumps over the lazy dog");
/// assert_eq(hex::encode(mac.finalize()), "de7c9b85b8b78aa6bc8a7a36f70a90701c9db4d9");
/// ```
pub trait Mac {
    /// Creates a MAC keyed with `key`.
    ///
    /// # Errors
    ///
    /// [`InvalidLength`] if the key's length is not accepted (never for
    /// HMAC).
    fn new_from_slice(key: &[u8]) -> Result<Self, InvalidLength>;
    /// Feeds `data` to the MAC.
    fn update<T: AsRef<[u8]>>(&mut self, data: T);
    /// Returns the tag of everything fed, consuming the MAC.
    ///
    /// To check a tag, use [`Mac::verify_slice`] instead of comparing.
    fn finalize(self) -> Vec<u8>;
    /// Returns the tag of everything fed and resets the MAC (keeping the
    /// key).
    fn finalize_reset(&mut self) -> Vec<u8>;
    /// Resets the MAC to its state with no input, keeping the key.
    fn reset(&mut self);
    /// Returns the length of the tag in bytes.
    fn output_size() -> usize;

    /// Feeds `data` and returns the MAC, for chains of calls.
    fn chain_update<T: AsRef<[u8]>>(mut self, data: T) -> Self {
        self.update(data);
        self
    }

    /// Checks `tag` against the tag of everything fed, in constant time.
    ///
    /// # Errors
    ///
    /// [`MacError`] if they differ (including in length).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::crypto::hmac::{Hmac, Mac};
    /// use std::crypto::sha2::Sha256;
    ///
    /// let tag = Hmac::<Sha256>::new_from_slice(b"k").unwrap().chain_update(b"msg").finalize();
    /// let ok = Hmac::<Sha256>::new_from_slice(b"k").unwrap().chain_update(b"msg").verify_slice(&tag);
    /// assert(ok.is_ok());
    /// let bad = Hmac::<Sha256>::new_from_slice(b"k").unwrap().chain_update(b"msh").verify_slice(&tag);
    /// assert(bad.is_err());
    /// ```
    fn verify_slice(self, tag: &[u8]) -> Result<(), MacError> {
        let t = self.finalize();
        if constant_time_eq(t.as_slice(), tag) {
            Ok(())
        } else {
            Err(MacError)
        }
    }

    /// Checks `tag` against the leftmost bytes of the tag of everything
    /// fed (for truncated tags), in constant time.
    ///
    /// # Errors
    ///
    /// [`MacError`] if they differ, or if `tag` is empty or longer than the
    /// tag.
    fn verify_truncated_left(self, tag: &[u8]) -> Result<(), MacError> {
        let t = self.finalize();
        if tag.len() == 0 || tag.len() > t.len() {
            return Err(MacError);
        }
        if constant_time_eq(&t[0..tag.len()], tag) {
            Ok(())
        } else {
            Err(MacError)
        }
    }

    /// Checks `tag` against the rightmost bytes of the tag of everything
    /// fed, in constant time.
    ///
    /// # Errors
    ///
    /// [`MacError`] if they differ, or if `tag` is empty or longer than the
    /// tag.
    fn verify_truncated_right(self, tag: &[u8]) -> Result<(), MacError> {
        let t = self.finalize();
        if tag.len() == 0 || tag.len() > t.len() {
            return Err(MacError);
        }
        if constant_time_eq(&t[t.len() - tag.len()..], tag) {
            Ok(())
        } else {
            Err(MacError)
        }
    }
}

/// HMAC with the hash `D` (`Hmac<Sha256>` and so on), used through the
/// [`Mac`] trait.
///
/// # Examples
///
/// ```
/// use std::crypto::hmac::{Hmac, Mac};
/// use std::crypto::sha2::Sha256;
///
/// let mut mac = Hmac::<Sha256>::new_from_slice(b"secret").unwrap();
/// mac.update(b"message");
/// assert_eq(mac.finalize().len(), 32);
/// ```
#[derive(Clone)]
pub struct Hmac<D: Digest> {
    inner: D,
    outer: D,
    // The states after the padded keys, for reset.
    inner_start: D,
    outer_start: D,
}

impl<D: Digest> Mac for Hmac<D> {
    fn new_from_slice(key: &[u8]) -> Result<Hmac<D>, InvalidLength> {
        let bs = D::BLOCK_SIZE;
        let mut k = Vec::with_capacity(bs);
        if key.len() > bs {
            k = D::digest(key);
        } else {
            k.extend_from_slice(key);
        }
        k.resize(bs, 0u8);
        let mut pad = Vec::with_capacity(bs);
        pad.resize(bs, 0u8);
        let mut i = 0;
        while i < bs {
            pad[i] = k[i] ^ 0x36;
            i += 1;
        }
        let mut inner = D::new();
        inner.update_bytes(pad.as_slice());
        i = 0;
        while i < bs {
            pad[i] = k[i] ^ 0x5c;
            i += 1;
        }
        let mut outer = D::new();
        outer.update_bytes(pad.as_slice());
        Ok(Hmac {
            inner,
            outer,
            inner_start: inner,
            outer_start: outer,
        })
    }

    fn update<T: AsRef<[u8]>>(&mut self, data: T) {
        self.inner.update_bytes(data.as_ref());
    }

    fn finalize(mut self) -> Vec<u8> {
        let h = self.inner.finalize_bytes();
        self.outer.update_bytes(h.as_slice());
        self.outer.finalize_bytes()
    }

    fn finalize_reset(&mut self) -> Vec<u8> {
        let h = self.inner.finalize_bytes();
        self.outer.update_bytes(h.as_slice());
        let t = self.outer.finalize_bytes();
        self.reset();
        t
    }

    fn reset(&mut self) {
        self.inner = self.inner_start;
        self.outer = self.outer_start;
    }

    fn output_size() -> usize {
        D::OUTPUT_SIZE
    }
}

impl<D: Digest> io::Write for Hmac<D> {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        self.inner.update_bytes(buf);
        Ok(buf.len())
    }

    fn flush(&mut self) -> io::Result<()> {
        Ok(())
    }
}
