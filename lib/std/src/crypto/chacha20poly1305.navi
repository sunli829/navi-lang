//! ChaCha20-Poly1305 (RFC 8439), authenticated encryption, with the API of
//! RustCrypto's `chacha20poly1305` crate:
//! [`ChaCha20Poly1305`](crate::crypto::chacha20poly1305::ChaCha20Poly1305),
//! a 32-byte key, 12-byte nonces and 16-byte tags, used through
//! [`crate::crypto::aead`]'s traits; also the ChaCha20 and Poly1305
//! primitives.
//!
//! Constant-time (additions, rotations and xors; Poly1305 in 64-bit limbs,
//! as Go's); in assembly on arm64 (ChaCha20 four blocks at a time in NEON,
//! as Go) and amd64 (a block at a time in SSE2).
//!
//! # Security
//!
//! A nonce must never be used twice with the same key.
//!
//! # Examples
//!
//! ```
//! use std::crypto::{
//!     aead::{Aead, KeyInit, Payload},
//!     chacha20poly1305::ChaCha20Poly1305,
//! };
//!
//! let cipher = ChaCha20Poly1305::new_from_slice(&[0x42u8; 32]).unwrap();
//! let nonce = [0u8; 12];
//! let ct = cipher
//!     .encrypt(
//!         &nonce,
//!         Payload {
//!             msg: b"attack at dawn",
//!             aad: b"v1",
//!         },
//!     )
//!     .unwrap();
//! let pt = cipher
//!     .decrypt(
//!         &nonce,
//!         Payload {
//!             msg: ct.as_slice(),
//!             aad: b"v1",
//!         },
//!     )
//!     .unwrap();
//! assert_eq(pt, b"attack at dawn");
//! ```

use crate::crypto::{
    aead::{AeadInPlace, Error, InvalidLength, KeyInit},
    subtle::constant_time_eq,
};

fn le32(b: &[u8], i: usize) -> u32 {
    (b[i] as u32) | ((b[i + 1] as u32) << 8) | ((b[i + 2] as u32) << 16) | ((b[i + 3] as u32) << 24)
}

fn qr(s: &mut [u32; 16], a: usize, b: usize, c: usize, d: usize) {
    s[a] = s[a].wrapping_add(s[b]);
    s[d] = (s[d] ^ s[a]).rotate_left(16);
    s[c] = s[c].wrapping_add(s[d]);
    s[b] = (s[b] ^ s[c]).rotate_left(12);
    s[a] = s[a].wrapping_add(s[b]);
    s[d] = (s[d] ^ s[a]).rotate_left(8);
    s[c] = s[c].wrapping_add(s[d]);
    s[b] = (s[b] ^ s[c]).rotate_left(7);
}

/// Computes the ChaCha20 block (64 bytes) of a 32-byte `key`, a block
/// `counter` and a 12-byte `nonce` into `out` (RFC 8439 section 2.3).
///
/// # Examples
///
/// RFC 8439, section 2.3.2:
///
/// ```
/// use std::{crypto::chacha20poly1305::chacha20_block, hex};
///
/// let key =
///     hex::decode("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f").unwrap();
/// let nonce = hex::decode("000000090000004a00000000").unwrap();
/// let mut out = [0u8; 64];
/// chacha20_block(key.as_slice(), 1, nonce.as_slice(), &mut out);
/// assert_eq(hex::encode(&out[..16]), "10f1e7e4d13b5915500fdd1fa32071c4");
/// ```
pub fn chacha20_block(key: &[u8], counter: u32, nonce: &[u8], out: &mut [u8]) {
    let mut init: [u32; 16] = [0; 16];
    init[0] = 0x61707865;
    init[1] = 0x3320646e;
    init[2] = 0x79622d32;
    init[3] = 0x6b206574;
    let mut i = 0;
    while i < 8 {
        init[4 + i] = le32(key, 4 * i);
        i += 1;
    }
    init[12] = counter;
    init[13] = le32(nonce, 0);
    init[14] = le32(nonce, 4);
    init[15] = le32(nonce, 8);
    let mut s = init;
    i = 0;
    while i < 10 {
        qr(&mut s, 0, 4, 8, 12);
        qr(&mut s, 1, 5, 9, 13);
        qr(&mut s, 2, 6, 10, 14);
        qr(&mut s, 3, 7, 11, 15);
        qr(&mut s, 0, 5, 10, 15);
        qr(&mut s, 1, 6, 11, 12);
        qr(&mut s, 2, 7, 8, 13);
        qr(&mut s, 3, 4, 9, 14);
        i += 1;
    }
    i = 0;
    while i < 16 {
        let w = s[i].wrapping_add(init[i]);
        out[4 * i] = w as u8;
        out[4 * i + 1] = (w >> 8) as u8;
        out[4 * i + 2] = (w >> 16) as u8;
        out[4 * i + 3] = (w >> 24) as u8;
        i += 1;
    }
}

// Four blocks at a time in NEON (chacha20poly1305_arm64.s, as Go's
// chacha_arm64.s): dst = src ^ the key stream of n 256-byte chunks, the
// state's 16 words each in 4 lanes (one per block), its counters advanced.
#[cfg(target_arch = "aarch64")]
#[asm]
fn chacha20_blocks(state: *mut u32, dst: *mut u8, src: *const u8, n: usize);

#[cfg(target_arch = "aarch64")]
fn xor_wide(key: &[u8], counter: u32, nonce: &[u8], buf: &mut [u8]) -> bool {
    let mut w: [u32; 16] = [
        0x61707865, 0x3320646e, 0x79622d32, 0x6b206574, 0, 0, 0, 0, 0, 0, 0, 0, counter, 0, 0, 0,
    ];
    let mut i = 0;
    while i < 8 {
        w[4 + i] = le32(key, 4 * i);
        i += 1;
    }
    w[13] = le32(nonce, 0);
    w[14] = le32(nonce, 4);
    w[15] = le32(nonce, 8);
    let mut st: [u32; 64] = [0; 64];
    i = 0;
    while i < 64 {
        st[i] = w[i / 4];
        i += 1;
    }
    i = 0;
    while i < 4 {
        st[48 + i] = counter.wrapping_add(i as u32);
        i += 1;
    }
    let full = buf.len() / 256;
    if full > 0 {
        unsafe { chacha20_blocks(st.as_mut_ptr(), buf.as_mut_ptr(), buf.as_ptr(), full) };
    }
    let at = full * 256;
    if at < buf.len() {
        // The rest through a whole chunk.
        let mut t: [u8; 256] = [0; 256];
        let n = buf.len() - at;
        t[..n].copy_from_slice(&buf[at..]);
        unsafe { chacha20_blocks(st.as_mut_ptr(), t.as_mut_ptr(), t.as_ptr(), 1) };
        buf[at..].copy_from_slice(&t[..n]);
    }
    true
}

// A block at a time in SSE2 (chacha20poly1305_amd64.s): dst = src ^ the
// key stream of n 64-byte blocks, the state's counter advanced.
#[cfg(target_arch = "x86_64")]
#[asm]
fn chacha20_blocks(state: *mut u32, dst: *mut u8, src: *const u8, n: usize);

#[cfg(target_arch = "x86_64")]
fn xor_wide(key: &[u8], counter: u32, nonce: &[u8], buf: &mut [u8]) -> bool {
    let mut st: [u32; 16] = [
        0x61707865, 0x3320646e, 0x79622d32, 0x6b206574, 0, 0, 0, 0, 0, 0, 0, 0, counter, 0, 0, 0,
    ];
    let mut i = 0;
    while i < 8 {
        st[4 + i] = le32(key, 4 * i);
        i += 1;
    }
    st[13] = le32(nonce, 0);
    st[14] = le32(nonce, 4);
    st[15] = le32(nonce, 8);
    let full = buf.len() / 64;
    if full > 0 {
        unsafe { chacha20_blocks(st.as_mut_ptr(), buf.as_mut_ptr(), buf.as_ptr(), full) };
    }
    let at = full * 64;
    if at < buf.len() {
        let mut t: [u8; 64] = [0; 64];
        let n = buf.len() - at;
        t[..n].copy_from_slice(&buf[at..]);
        unsafe { chacha20_blocks(st.as_mut_ptr(), t.as_mut_ptr(), t.as_ptr(), 1) };
        buf[at..].copy_from_slice(&t[..n]);
    }
    true
}

#[cfg(not(any(target_arch = "aarch64", target_arch = "x86_64")))]
fn xor_wide(key: &[u8], counter: u32, nonce: &[u8], buf: &mut [u8]) -> bool {
    false
}

/// Xors `buf` with the ChaCha20 key stream of `key` and `nonce` from block
/// `counter` on: encryption and decryption without authentication (RFC
/// 8439 section 2.4).
///
/// # Examples
///
/// ```
/// use std::crypto::chacha20poly1305::chacha20_xor;
///
/// let key = [1u8; 32];
/// let nonce = [2u8; 12];
/// let mut buf = [0u8; 5];
/// buf.copy_from_slice(b"hello");
/// chacha20_xor(&key, 1, &nonce, &mut buf);
/// chacha20_xor(&key, 1, &nonce, &mut buf);
/// assert_eq(&buf[..], b"hello");
/// ```
pub fn chacha20_xor(key: &[u8], counter: u32, nonce: &[u8], buf: &mut [u8]) {
    if xor_wide(key, counter, nonce, buf) {
        return;
    }
    let mut ks: [u8; 64] = [0; 64];
    let mut c = counter;
    let mut at = 0;
    while at < buf.len() {
        chacha20_block(key, c, nonce, &mut ks);
        c = c.wrapping_add(1);
        let mut i = 0;
        while i < 64 && at + i < buf.len() {
            buf[at + i] = buf[at + i] ^ ks[i];
            i += 1;
        }
        at += 64;
    }
}

/// Returns the 16-byte Poly1305 tag of `msg` under a one-time 32-byte
/// `key` (RFC 8439 section 2.5).
///
/// # Security
///
/// A Poly1305 key must be used for one message only.
///
/// # Examples
///
/// RFC 8439, section 2.5.2:
///
/// ```
/// use std::{crypto::chacha20poly1305::poly1305, hex};
///
/// let key =
///     hex::decode("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b").unwrap();
/// let tag = poly1305(key.as_slice(), b"Cryptographic Forum Research Group");
/// assert_eq(hex::encode(tag), "a8061dc1305136c6c22b8baf0c0127a9");
/// ```
pub fn poly1305(key: &[u8], msg: &[u8]) -> Vec<u8> {
    let mut p = Poly1305::new(key);
    p.update(msg);
    p.finish()
}

/// Poly1305 in 64-bit limbs, as Go's x/crypto/internal/poly1305
/// (sum_generic.go): h < 2^130 in three limbs, r clamped (so the products
/// leave room), the reduction by 2^130 = 5 partial until finish.
struct Poly1305 {
    r: [u64; 2],
    s: [u64; 2],
    h: [u64; 3],
    buf: [u8; 16],
    n: usize,
}

fn le64(b: &[u8], i: usize) -> u64 {
    (le32(b, i) as u64) | ((le32(b, i + 4) as u64) << 32)
}

#[inline(always)]
fn add64(a: u64, b: u64, c: u64) -> (u64, u64) {
    let s = a.wrapping_add(b);
    let s2 = s.wrapping_add(c);
    (s2, ((s < a) as u64) | ((s2 < s) as u64))
}

impl Poly1305 {
    fn new(key: &[u8]) -> Poly1305 {
        let r = [
            le64(key, 0) & 0x0ffffffc0fffffff,
            le64(key, 8) & 0x0ffffffc0ffffffc,
        ];
        Poly1305 {
            r,
            s: [le64(key, 16), le64(key, 24)],
            h: [0; 3],
            buf: [0; 16],
            n: 0,
        }
    }

    // The 16-byte blocks of m from at, n of them (hibit 1: full blocks;
    // 0: the padded last one, its 1 already in place).
    fn blocks(&mut self, m: &[u8], at: usize, n: usize, hibit: u64) {
        if n == 0 {
            return;
        }
        if poly_asm(&mut self.h, &self.r, m, at, n, hibit) {
            return;
        }
        poly1305_generic(&mut self.h, &self.r, m, at, n, hibit);
    }

    fn update(&mut self, data: &[u8]) {
        let mut at = 0;
        if self.n > 0 {
            while self.n < 16 && at < data.len() {
                self.buf[self.n] = data[at];
                self.n += 1;
                at += 1;
            }
            if self.n < 16 {
                return;
            }
            let b = self.buf;
            self.blocks(&b, 0, 1, 1);
            self.n = 0;
        }
        let n = (data.len() - at) / 16;
        self.blocks(data, at, n, 1);
        at += 16 * n;
        while at < data.len() {
            self.buf[self.n] = data[at];
            self.n += 1;
            at += 1;
        }
    }

    fn finish(&mut self) -> Vec<u8> {
        if self.n > 0 {
            let mut b: [u8; 16] = [0; 16];
            let mut i = 0;
            while i < self.n {
                b[i] = self.buf[i];
                i += 1;
            }
            b[self.n] = 1;
            self.blocks(&b, 0, 1, 0);
        }
        // h < 2 (2^130 - 5): h - p unless that borrows.
        let (g0, b) = sub64(self.h[0], 0xfffffffffffffffb, 0);
        let (g1, b) = sub64(self.h[1], 0xffffffffffffffff, b);
        let (_, b) = sub64(self.h[2], 3, b);
        let keep = b.wrapping_neg();
        let h0 = (self.h[0] & keep) | (g0 & !keep);
        let h1 = (self.h[1] & keep) | (g1 & !keep);
        // + s mod 2^128.
        let (o0, c) = add64(h0, self.s[0], 0);
        let (o1, _) = add64(h1, self.s[1], c);
        let mut out: Vec<u8> = Vec::with_capacity(16);
        for w in [o0, o1].iter() {
            let mut k = 0;
            while k < 8 {
                out.push((*w >> (8 * k)) as u8);
                k += 1;
            }
        }
        out
    }
}

/// h = (h + each block + hibit 2^128) r (Go's updateGeneric).
pub(crate) fn poly1305_generic(
    h: &mut [u64; 3],
    r: &[u64; 2],
    m: &[u8],
    at: usize,
    n: usize,
    hibit: u64,
) {
    let r0 = r[0];
    let r1 = r[1];
    let mut h0 = h[0];
    let mut h1 = h[1];
    let mut h2 = h[2];
    let mut i = 0;
    while i < n {
        let o = at + 16 * i;
        let (a0, c0) = add64(h0, le64(m, o), 0);
        let (a1, c1) = add64(h1, le64(m, o + 8), c0);
        h0 = a0;
        h1 = a1;
        h2 = h2 + c1 + hibit;
        // h * r in 128-bit columns (h2 is small, r's top bits clear:
        // the h2 products and the column sums fit).
        let (h0r0l, h0r0h) = h0.widening_mul(r0);
        let (h1r0l, h1r0h) = h1.widening_mul(r0);
        let (h0r1l, h0r1h) = h0.widening_mul(r1);
        let (h1r1l, h1r1h) = h1.widening_mul(r1);
        let h2r0 = h2 * r0;
        let h2r1 = h2 * r1;
        let (m1l, c) = add64(h1r0l, h0r1l, 0);
        let m1h = h1r0h + h0r1h + c;
        let (m2l, c) = add64(h2r0, h1r1l, 0);
        let m2h = h1r1h + c;
        let t0 = h0r0l;
        let (t1, c) = add64(m1l, h0r0h, 0);
        let (t2, c) = add64(m2l, m1h, c);
        let t3 = h2r1 + m2h + c;
        // Above 2^130 (cc = 4c): + cc, + cc >> 2 (2^130 = 5).
        h0 = t0;
        h1 = t1;
        h2 = t2 & 3;
        let cl = t2 & !3;
        let (a0, c) = add64(h0, cl, 0);
        let (a1, c) = add64(h1, t3, c);
        h2 = h2 + c;
        let (a0, c) = add64(a0, (cl >> 2) | (t3 << 62), 0);
        let (a1, c) = add64(a1, t3 >> 2, c);
        h0 = a0;
        h1 = a1;
        h2 = h2 + c;
        i += 1;
    }
    *h = [h0, h1, h2];
}

#[cfg(any(target_arch = "aarch64", target_arch = "x86_64"))]
#[asm]
fn poly1305_blocks(h: *mut u64, r: *const u64, m: *const u8, n: usize, hibit: u64);

#[cfg(any(target_arch = "aarch64", target_arch = "x86_64"))]
fn poly_asm(h: &mut [u64; 3], r: &[u64; 2], m: &[u8], at: usize, n: usize, hibit: u64) -> bool {
    assert(at + 16 * n <= m.len());
    unsafe { poly1305_blocks(h.as_mut_ptr(), r.as_ptr(), m.as_ptr().add(at), n, hibit) };
    true
}

#[cfg(not(any(target_arch = "aarch64", target_arch = "x86_64")))]
fn poly_asm(h: &mut [u64; 3], r: &[u64; 2], m: &[u8], at: usize, n: usize, hibit: u64) -> bool {
    false
}

#[inline(always)]
fn sub64(a: u64, b: u64, borrow: u64) -> (u64, u64) {
    let d = a.wrapping_sub(b);
    let d2 = d.wrapping_sub(borrow);
    (d2, ((a < b) as u64) | ((d < borrow) as u64))
}

/// The ChaCha20-Poly1305 AEAD: a 32-byte key, 12-byte nonces, 16-byte
/// tags.
///
/// # Examples
///
/// ```
/// use std::crypto::{
///     aead::{Aead, KeyInit},
///     chacha20poly1305::ChaCha20Poly1305,
/// };
///
/// let cipher = ChaCha20Poly1305::new_from_slice(&[0u8; 32]).unwrap();
/// let ct = cipher.encrypt(&[1u8; 12], b"msg").unwrap();
/// assert_eq(cipher.decrypt(&[1u8; 12], ct.as_slice()).unwrap(), b"msg");
/// assert(cipher.decrypt(&[2u8; 12], ct.as_slice()).is_err()); // another nonce
/// ```
#[derive(Clone)]
pub struct ChaCha20Poly1305 {
    key: Vec<u8>,
}

impl KeyInit for ChaCha20Poly1305 {
    const KEY_SIZE: usize = 32;
    fn new_from_slice(key: &[u8]) -> Result<ChaCha20Poly1305, InvalidLength> {
        if key.len() != 32 {
            return Err(InvalidLength);
        }
        Ok(ChaCha20Poly1305 { key: key.to_vec() })
    }
}

impl ChaCha20Poly1305 {
    // The tag of aad and ciphertext ct (RFC 8439 2.8).
    fn tag(&self, nonce: &[u8], aad: &[u8], ct: &[u8]) -> Vec<u8> {
        let mut otk: [u8; 64] = [0; 64];
        chacha20_block(self.key.as_slice(), 0, nonce, &mut otk);
        let mut p = Poly1305::new(&otk[..32]);
        let zeros: [u8; 16] = [0; 16];
        p.update(aad);
        p.update(&zeros[..(16 - aad.len() % 16) % 16]);
        p.update(ct);
        p.update(&zeros[..(16 - ct.len() % 16) % 16]);
        let mut lens: [u8; 16] = [0; 16];
        let mut i = 0;
        while i < 8 {
            lens[i] = ((aad.len() as u64) >> (8 * i)) as u8;
            lens[8 + i] = ((ct.len() as u64) >> (8 * i)) as u8;
            i += 1;
        }
        p.update(&lens);
        p.finish()
    }
}

impl AeadInPlace for ChaCha20Poly1305 {
    const NONCE_SIZE: usize = 12;
    const TAG_SIZE: usize = 16;

    fn encrypt_in_place_detached(
        &self,
        nonce: &[u8],
        aad: &[u8],
        buffer: &mut [u8],
    ) -> Result<Vec<u8>, Error> {
        if nonce.len() != 12 {
            return Err(Error);
        }
        chacha20_xor(self.key.as_slice(), 1, nonce, buffer);
        Ok(self.tag(nonce, aad, buffer))
    }

    fn decrypt_in_place_detached(
        &self,
        nonce: &[u8],
        aad: &[u8],
        buffer: &mut [u8],
        tag: &[u8],
    ) -> Result<(), Error> {
        if nonce.len() != 12 || tag.len() != 16 {
            return Err(Error);
        }
        let want = self.tag(nonce, aad, buffer);
        if !constant_time_eq(want.as_slice(), tag) {
            return Err(Error);
        }
        chacha20_xor(self.key.as_slice(), 1, nonce, buffer);
        Ok(())
    }
}
