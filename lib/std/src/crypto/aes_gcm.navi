//! AES-GCM (NIST SP 800-38D), authenticated encryption, with the API of
//! RustCrypto's `aes-gcm` crate:
//! [`Aes128Gcm`](crate::crypto::aes_gcm::Aes128Gcm) and
//! [`Aes256Gcm`](crate::crypto::aes_gcm::Aes256Gcm), 12-byte nonces and 16-byte
//! tags, used through [`crate::crypto::aead`]'s traits.
//!
//! With the CPU's AES and carry-less multiplication instructions, the
//! counter mode and GHASH run in assembly (aes_gcm_arm64.s,
//! aes_gcm_amd64.s; in one pass, eight blocks at a time, as Go's);
//! otherwise in software, constant-time (GHASH as BearSSL's ctmul64:
//! carry-less products from integer multiplications, no table lookups).
//!
//! # Security
//!
//! A nonce must never be used twice with the same key: with GCM that also
//! reveals the authentication key, so an attacker can forge messages.
//!
//! # Examples
//!
//! The test case 2 of the GCM specification (a zero key, nonce and block):
//!
//! ```
//! use std::crypto::aead::{Aead, KeyInit};
//! use std::crypto::aes_gcm::Aes128Gcm;
//! use std::hex;
//!
//! let cipher = Aes128Gcm::new_from_slice(&[0u8; 16]).unwrap();
//! let ct = cipher.encrypt(&[0u8; 12], [0u8; 16].as_slice()).unwrap();
//! assert_eq(hex::encode(&ct[..16]), "0388dace60b6a392f328c2b971b2fe78");
//! assert_eq(hex::encode(&ct[16..]), "ab6e47d42cec13bdf53a67b21257bddf");
//! assert_eq(cipher.decrypt(&[0u8; 12], ct.as_slice()).unwrap(), Vec::from([0u8; 16]));
//! ```

use crate::crypto::aead::{AeadInPlace, Error, InvalidLength, KeyInit};
use crate::crypto::aes::Key;
use crate::crypto::subtle::constant_time_eq;

// hp: H, H^2, ..., H^8 (arm64 takes eight blocks at a time; amd64 reads
// H only).
#[cfg(target_arch = "aarch64")]
#[asm]
fn ghash_blocks(hp: *const u8, y: *mut u8, data: *const u8, n: usize);

#[cfg(target_arch = "aarch64")]
#[asm]
fn aes_ctr_xor(xk: *const u8, rounds: usize, ctr: *mut u8, src: *const u8, dst: *mut u8, n: usize);

#[cfg(target_arch = "x86_64")]
#[asm]
fn ghash_blocks(hp: *const u8, y: *mut u8, data: *const u8, n: usize);

#[cfg(target_arch = "x86_64")]
#[asm]
fn aes_ctr_xor(xk: *const u8, rounds: usize, ctr: *mut u8, src: *const u8, dst: *mut u8, n: usize);

// Counter mode and GHASH together, eight blocks at a time.
#[cfg(any(target_arch = "aarch64", target_arch = "x86_64"))]
#[asm]
fn gcm_crypt8(
    xk: *const u8,
    rounds: usize,
    ctr: *mut u8,
    src: *const u8,
    dst: *mut u8,
    n: usize,
    ht: *const u8,
    y: *mut u8,
    dec: u64,
);

#[cfg(any(target_arch = "aarch64", target_arch = "x86_64"))]
const FUSED: bool = true;

#[cfg(not(any(target_arch = "aarch64", target_arch = "x86_64")))]
const FUSED: bool = false;

#[cfg(any(target_arch = "aarch64", target_arch = "x86_64"))]
fn hw_crypt8(
    k: &Key,
    ht: &[u8],
    ctr: &mut [u8],
    buf: &mut [u8],
    n: usize,
    y: &mut [u8],
    dec: bool,
) {
    gcm_crypt8(
        k.round_keys().as_ptr(),
        k.rounds(),
        ctr.as_mut_ptr(),
        buf.as_ptr(),
        buf.as_mut_ptr(),
        n,
        ht.as_ptr(),
        y.as_mut_ptr(),
        dec as u64,
    );
}

#[cfg(not(any(target_arch = "aarch64", target_arch = "x86_64")))]
fn hw_crypt8(
    k: &Key,
    ht: &[u8],
    ctr: &mut [u8],
    buf: &mut [u8],
    n: usize,
    y: &mut [u8],
    dec: bool,
) {
}

#[cfg(any(target_arch = "aarch64", target_arch = "x86_64"))]
fn hw_ghash(hp: &[u8], y: &mut [u8], data: &[u8], n: usize) {
    ghash_blocks(hp.as_ptr(), y.as_mut_ptr(), data.as_ptr(), n);
}

#[cfg(not(any(target_arch = "aarch64", target_arch = "x86_64")))]
fn hw_ghash(hp: &[u8], y: &mut [u8], data: &[u8], n: usize) {}

#[cfg(any(target_arch = "aarch64", target_arch = "x86_64"))]
fn hw_ctr(k: &Key, ctr: &mut [u8], buf: &mut [u8], n: usize) {
    aes_ctr_xor(
        k.round_keys().as_ptr(),
        k.rounds(),
        ctr.as_mut_ptr(),
        buf.as_ptr(),
        buf.as_mut_ptr(),
        n,
    );
}

#[cfg(not(any(target_arch = "aarch64", target_arch = "x86_64")))]
fn hw_ctr(k: &Key, ctr: &mut [u8], buf: &mut [u8], n: usize) {}

/// AES-GCM with a key of any AES size (16, 24 or 32 bytes), used through
/// [`crate::crypto::aead`]'s traits.
#[derive(Clone)]
pub struct AesGcm {
    key: Key,
    // H = E(K, 0^128), as two big-endian words.
    h1: u64,
    h0: u64,
    // H, H^2, ..., H^8 (for the assembly).
    hp: [u8; 128],
    // gcm_crypt8's: H^8, ..., H bits reversed in each byte, each with its
    // halves xored.
    ht: [u8; 256],
}

fn be64(b: &[u8], i: usize) -> u64 {
    let mut v = 0u64;
    let mut k = 0;
    while k < 8 {
        v = (v << 8) | (b[i + k] as u64);
        k += 1;
    }
    v
}

fn put64(b: &mut [u8], i: usize, v: u64) {
    let mut k = 0;
    while k < 8 {
        b[i + k] = (v >> (56 - 8 * k)) as u8;
        k += 1;
    }
}

// The carry-less product of x and y, its low 64 bits (BearSSL's bmul64:
// four interleaved integer products whose carries fall in unused bits).
fn bmul64(x: u64, y: u64) -> u64 {
    let x0 = x & 0x1111111111111111;
    let x1 = x & 0x2222222222222222;
    let x2 = x & 0x4444444444444444;
    let x3 = x & 0x8888888888888888;
    let y0 = y & 0x1111111111111111;
    let y1 = y & 0x2222222222222222;
    let y2 = y & 0x4444444444444444;
    let y3 = y & 0x8888888888888888;
    let z0 = x0.wrapping_mul(y0) ^ x1.wrapping_mul(y3) ^ x2.wrapping_mul(y2) ^ x3.wrapping_mul(y1);
    let z1 = x0.wrapping_mul(y1) ^ x1.wrapping_mul(y0) ^ x2.wrapping_mul(y3) ^ x3.wrapping_mul(y2);
    let z2 = x0.wrapping_mul(y2) ^ x1.wrapping_mul(y1) ^ x2.wrapping_mul(y0) ^ x3.wrapping_mul(y3);
    let z3 = x0.wrapping_mul(y3) ^ x1.wrapping_mul(y2) ^ x2.wrapping_mul(y1) ^ x3.wrapping_mul(y0);
    (z0 & 0x1111111111111111)
        | (z1 & 0x2222222222222222)
        | (z2 & 0x4444444444444444)
        | (z3 & 0x8888888888888888)
}

fn rev64(v: u64) -> u64 {
    let mut x = v;
    x = ((x & 0x5555555555555555) << 1) | ((x >> 1) & 0x5555555555555555);
    x = ((x & 0x3333333333333333) << 2) | ((x >> 2) & 0x3333333333333333);
    x = ((x & 0x0f0f0f0f0f0f0f0f) << 4) | ((x >> 4) & 0x0f0f0f0f0f0f0f0f);
    x = ((x & 0x00ff00ff00ff00ff) << 8) | ((x >> 8) & 0x00ff00ff00ff00ff);
    x = ((x & 0x0000ffff0000ffff) << 16) | ((x >> 16) & 0x0000ffff0000ffff);
    (x << 32) | (x >> 32)
}

/// GHASH state: Y as two big-endian words.
struct Ghash {
    y1: u64,
    y0: u64,
}

impl Ghash {
    // Y = (Y ^ block) * H for each 16-byte block of data (the last padded
    // with zeros); BearSSL's br_ghash_ctmul64.
    fn update(&mut self, h1: u64, h0: u64, data: &[u8]) {
        let h0r = rev64(h0);
        let h1r = rev64(h1);
        let h2 = h0 ^ h1;
        let h2r = h0r ^ h1r;
        let mut y0 = self.y0;
        let mut y1 = self.y1;
        let mut at = 0;
        while at < data.len() {
            if data.len() - at >= 16 {
                y1 = y1 ^ be64(data, at);
                y0 = y0 ^ be64(data, at + 8);
            } else {
                let mut tmp: [u8; 16] = [0; 16];
                let mut k = 0;
                while at + k < data.len() {
                    tmp[k] = data[at + k];
                    k += 1;
                }
                y1 = y1 ^ be64(&tmp, 0);
                y0 = y0 ^ be64(&tmp, 8);
            }
            at += 16;
            let y0r = rev64(y0);
            let y1r = rev64(y1);
            let y2 = y0 ^ y1;
            let y2r = y0r ^ y1r;
            let z0 = bmul64(y0, h0);
            let z1 = bmul64(y1, h1);
            let mut z2 = bmul64(y2, h2);
            let mut z0h = bmul64(y0r, h0r);
            let mut z1h = bmul64(y1r, h1r);
            let mut z2h = bmul64(y2r, h2r);
            z2 = z2 ^ z0 ^ z1;
            z2h = z2h ^ z0h ^ z1h;
            z0h = rev64(z0h) >> 1;
            z1h = rev64(z1h) >> 1;
            z2h = rev64(z2h) >> 1;
            let mut v0 = z0;
            let mut v1 = z0h ^ z2;
            let mut v2 = z1 ^ z2h;
            let mut v3 = z1h;
            v3 = (v3 << 1) | (v2 >> 63);
            v2 = (v2 << 1) | (v1 >> 63);
            v1 = (v1 << 1) | (v0 >> 63);
            v0 = v0 << 1;
            v2 = v2 ^ v0 ^ (v0 >> 1) ^ (v0 >> 2) ^ (v0 >> 7);
            v1 = v1 ^ (v0 << 63) ^ (v0 << 62) ^ (v0 << 57);
            v3 = v3 ^ v1 ^ (v1 >> 1) ^ (v1 >> 2) ^ (v1 >> 7);
            v2 = v2 ^ (v1 << 63) ^ (v1 << 62) ^ (v1 << 57);
            y0 = v2;
            y1 = v3;
        }
        self.y0 = y0;
        self.y1 = y1;
    }
}

impl AesGcm {
    /// Creates AES-GCM with a 16, 24 or 32-byte key.
    ///
    /// # Errors
    ///
    /// [`InvalidLength`] for a key of another length.
    pub fn new_any(key: &[u8]) -> Result<AesGcm, InvalidLength> {
        let k = Key::new(key)?;
        let mut h: [u8; 16] = [0; 16];
        k.encrypt_block(&mut h);
        let (h1, h0) = (be64(&h, 0), be64(&h, 8));
        let mut hp: [u8; 128] = [0; 128];
        if k.hardware() {
            // H^(i+1) = H^i * H: GHASH of a zero block from Y = H^i.
            let mut g = Ghash { y1: h1, y0: h0 };
            let mut i = 0;
            while i < 8 {
                put64(&mut hp, 16 * i, g.y1);
                put64(&mut hp, 16 * i + 8, g.y0);
                g.update(h1, h0, &[0u8; 16]);
                i += 1;
            }
        }
        let mut ht: [u8; 256] = [0; 256];
        if k.hardware() {
            let mut i = 0;
            while i < 8 {
                let src = 16 * (7 - i);
                let mut j = 0;
                while j < 16 {
                    ht[32 * i + j] = hp[src + j].reverse_bits();
                    j += 1;
                }
                j = 0;
                while j < 16 {
                    ht[32 * i + 16 + j] = ht[32 * i + j] ^ ht[32 * i + (j + 8) % 16];
                    j += 1;
                }
                i += 1;
            }
        }
        Ok(AesGcm {
            key: k,
            h1,
            h0,
            hp,
            ht,
        })
    }

    /// The same with AES in software even with the CPU's instructions (to
    /// compare the two).
    pub fn software(&self) -> AesGcm {
        AesGcm {
            key: self.key.software(),
            h1: self.h1,
            h0: self.h0,
            hp: self.hp,
            ht: self.ht,
        }
    }

    // The counter block nonce || c.
    fn counter(nonce: &[u8], c: u32) -> [u8; 16] {
        let mut cb: [u8; 16] = [0; 16];
        let mut i = 0;
        while i < 12 {
            cb[i] = nonce[i];
            i += 1;
        }
        cb[12] = (c >> 24) as u8;
        cb[13] = (c >> 16) as u8;
        cb[14] = (c >> 8) as u8;
        cb[15] = c as u8;
        cb
    }

    // buf ^= the key stream from the counter block cb on, on the CPU's
    // instructions (cb advanced past the whole blocks).
    fn hw_ctr_from(&self, cb: &mut [u8; 16], buf: &mut [u8]) {
        let full = buf.len() / 16;
        hw_ctr(&self.key, cb, buf, full);
        let rest = buf.len() - 16 * full;
        if rest > 0 {
            let mut ks: [u8; 16] = [0; 16];
            self.key.encrypt_blocks(cb, &mut ks);
            let mut i = 0;
            while i < rest {
                buf[16 * full + i] = buf[16 * full + i] ^ ks[i];
                i += 1;
            }
        }
    }

    // Sealing or opening buf in one pass over it: the groups of
    // eight blocks through gcm_crypt8, the rest as before; the tag.
    fn fused(&self, nonce: &[u8], aad: &[u8], buf: &mut [u8], dec: bool) -> Vec<u8> {
        let mut y: [u8; 16] = [0; 16];
        self.hw_update(&mut y, aad);
        let mut cb = AesGcm::counter(nonce, 2);
        let n8 = buf.len() / 128;
        hw_crypt8(&self.key, &self.ht, &mut cb, buf, n8, &mut y, dec);
        let rest = &mut buf[128 * n8..];
        if dec {
            self.hw_update(&mut y, rest);
        }
        self.hw_ctr_from(&mut cb, rest);
        if !dec {
            self.hw_update(&mut y, rest);
        }
        self.finish(nonce, &mut y, aad.len(), buf.len())
    }

    // buf ^= the key stream of the counter blocks nonce || c, c from
    // first on (wrapping at 32 bits).
    fn ctr(&self, nonce: &[u8], first: u32, buf: &mut [u8]) {
        if self.key.hardware() {
            let mut cb = AesGcm::counter(nonce, first);
            self.hw_ctr_from(&mut cb, buf);
            return;
        }
        let chunk = 64;
        let mut ctrs: Vec<u8> = Vec::with_capacity(16 * chunk);
        let mut ks: Vec<u8> = Vec::with_capacity(16 * chunk);
        let mut c = first;
        let mut at = 0;
        while at < buf.len() {
            let left = buf.len() - at;
            let blocks = if left >= 16 * chunk {
                chunk
            } else {
                (left + 15) / 16
            };
            ctrs.clear();
            let mut b = 0;
            while b < blocks {
                ctrs.extend_from_slice(nonce);
                ctrs.push((c >> 24) as u8);
                ctrs.push((c >> 16) as u8);
                ctrs.push((c >> 8) as u8);
                ctrs.push(c as u8);
                c = c.wrapping_add(1);
                b += 1;
            }
            ks.clear();
            ks.resize(16 * blocks, 0);
            self.key.encrypt_blocks(ctrs.as_slice(), ks.as_mut_slice());
            let n = if left < 16 * blocks {
                left
            } else {
                16 * blocks
            };
            let mut i = 0;
            while i < n {
                buf[at + i] = buf[at + i] ^ ks[i];
                i += 1;
            }
            at += n;
        }
    }

    // GHASH of data (padded) into y, on the CPU's instructions.
    fn hw_update(&self, y: &mut [u8], data: &[u8]) {
        let full = data.len() / 16;
        hw_ghash(&self.hp, y, data, full);
        let rest = data.len() - 16 * full;
        if rest > 0 {
            let mut b: [u8; 16] = [0; 16];
            let mut i = 0;
            while i < rest {
                b[i] = data[16 * full + i];
                i += 1;
            }
            hw_ghash(&self.hp, y, &b, 1);
        }
    }

    // The tag of aad and ciphertext ct under nonce.
    fn tag(&self, nonce: &[u8], aad: &[u8], ct: &[u8]) -> Vec<u8> {
        let mut t: [u8; 16] = [0; 16];
        if self.key.hardware() {
            self.hw_update(&mut t, aad);
            self.hw_update(&mut t, ct);
            return self.finish(nonce, &mut t, aad.len(), ct.len());
        }
        let mut lens: [u8; 16] = [0; 16];
        put64(&mut lens, 0, (aad.len() as u64) * 8);
        put64(&mut lens, 8, (ct.len() as u64) * 8);
        let mut g = Ghash { y1: 0, y0: 0 };
        g.update(self.h1, self.h0, aad);
        g.update(self.h1, self.h0, ct);
        g.update(self.h1, self.h0, &lens);
        put64(&mut t, 0, g.y1);
        put64(&mut t, 8, g.y0);
        self.mask(nonce, &t)
    }

    // The tag from the GHASH state t of aad and the ciphertext (on the
    // CPU's instructions): their lengths hashed in, then masked.
    fn finish(&self, nonce: &[u8], t: &mut [u8; 16], alen: usize, clen: usize) -> Vec<u8> {
        let mut lens: [u8; 16] = [0; 16];
        put64(&mut lens, 0, (alen as u64) * 8);
        put64(&mut lens, 8, (clen as u64) * 8);
        self.hw_update(t, &lens);
        self.mask(nonce, t)
    }

    fn mask(&self, nonce: &[u8], t: &[u8; 16]) -> Vec<u8> {
        // E(K, J0) ^ S, J0 = nonce || 1.
        let mut j0: Vec<u8> = nonce.to_vec();
        j0.extend_from_slice(&[0, 0, 0, 1]);
        let mut ek: [u8; 16] = [0; 16];
        self.key.encrypt_blocks(j0.as_slice(), &mut ek);
        let mut out: Vec<u8> = Vec::with_capacity(16);
        let mut i = 0;
        while i < 16 {
            out.push(t[i] ^ ek[i]);
            i += 1;
        }
        out
    }
}

impl AeadInPlace for AesGcm {
    const NONCE_SIZE: usize = 12;
    const TAG_SIZE: usize = 16;

    fn encrypt_in_place_detached(
        &self,
        nonce: &[u8],
        aad: &[u8],
        buffer: &mut [u8],
    ) -> Result<Vec<u8>, Error> {
        if nonce.len() != 12 {
            return Err(Error);
        }
        if FUSED && self.key.hardware() {
            return Ok(self.fused(nonce, aad, buffer, false));
        }
        self.ctr(nonce, 2, buffer);
        Ok(self.tag(nonce, aad, buffer))
    }

    fn decrypt_in_place_detached(
        &self,
        nonce: &[u8],
        aad: &[u8],
        buffer: &mut [u8],
        tag: &[u8],
    ) -> Result<(), Error> {
        if nonce.len() != 12 || tag.len() != 16 {
            return Err(Error);
        }
        if FUSED && self.key.hardware() {
            // Decrypted while hashed: a wrong tag encrypts buffer back.
            let want = self.fused(nonce, aad, buffer, true);
            if !constant_time_eq(want.as_slice(), tag) {
                self.ctr(nonce, 2, buffer);
                return Err(Error);
            }
            return Ok(());
        }
        let want = self.tag(nonce, aad, buffer);
        if !constant_time_eq(want.as_slice(), tag) {
            return Err(Error);
        }
        self.ctr(nonce, 2, buffer);
        Ok(())
    }
}

/// AES-128-GCM: a 16-byte key, 12-byte nonces, 16-byte tags.
///
/// # Examples
///
/// ```
/// use std::crypto::aead::{Aead, KeyInit};
/// use std::crypto::aes_gcm::Aes128Gcm;
///
/// let cipher = Aes128Gcm::new_from_slice(b"0123456789abcdef").unwrap();
/// let ct = cipher.encrypt(b"unique nonce", b"secret").unwrap();
/// assert_eq(cipher.decrypt(b"unique nonce", ct.as_slice()).unwrap(), b"secret");
/// ```
#[derive(Clone)]
pub struct Aes128Gcm {
    g: AesGcm,
}

/// AES-256-GCM: a 32-byte key, 12-byte nonces, 16-byte tags.
///
/// # Examples
///
/// ```
/// use std::crypto::aead::{Aead, KeyInit};
/// use std::crypto::aes_gcm::Aes256Gcm;
///
/// let cipher = Aes256Gcm::new_from_slice(&[3u8; 32]).unwrap();
/// let ct = cipher.encrypt(&[0u8; 12], b"secret").unwrap();
/// assert_eq(cipher.decrypt(&[0u8; 12], ct.as_slice()).unwrap(), b"secret");
/// ```
#[derive(Clone)]
pub struct Aes256Gcm {
    g: AesGcm,
}

impl KeyInit for Aes128Gcm {
    const KEY_SIZE: usize = 16;
    fn new_from_slice(key: &[u8]) -> Result<Aes128Gcm, InvalidLength> {
        if key.len() != 16 {
            return Err(InvalidLength);
        }
        Ok(Aes128Gcm {
            g: AesGcm::new_any(key)?,
        })
    }
}

impl KeyInit for Aes256Gcm {
    const KEY_SIZE: usize = 32;
    fn new_from_slice(key: &[u8]) -> Result<Aes256Gcm, InvalidLength> {
        if key.len() != 32 {
            return Err(InvalidLength);
        }
        Ok(Aes256Gcm {
            g: AesGcm::new_any(key)?,
        })
    }
}

impl AeadInPlace for Aes128Gcm {
    const NONCE_SIZE: usize = 12;
    const TAG_SIZE: usize = 16;
    fn encrypt_in_place_detached(
        &self,
        nonce: &[u8],
        aad: &[u8],
        buffer: &mut [u8],
    ) -> Result<Vec<u8>, Error> {
        self.g.encrypt_in_place_detached(nonce, aad, buffer)
    }

    fn decrypt_in_place_detached(
        &self,
        nonce: &[u8],
        aad: &[u8],
        buffer: &mut [u8],
        tag: &[u8],
    ) -> Result<(), Error> {
        self.g.decrypt_in_place_detached(nonce, aad, buffer, tag)
    }
}

impl AeadInPlace for Aes256Gcm {
    const NONCE_SIZE: usize = 12;
    const TAG_SIZE: usize = 16;
    fn encrypt_in_place_detached(
        &self,
        nonce: &[u8],
        aad: &[u8],
        buffer: &mut [u8],
    ) -> Result<Vec<u8>, Error> {
        self.g.encrypt_in_place_detached(nonce, aad, buffer)
    }

    fn decrypt_in_place_detached(
        &self,
        nonce: &[u8],
        aad: &[u8],
        buffer: &mut [u8],
        tag: &[u8],
    ) -> Result<(), Error> {
        self.g.decrypt_in_place_detached(nonce, aad, buffer, tag)
    }
}
