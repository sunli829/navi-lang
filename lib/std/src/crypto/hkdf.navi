//! HKDF (RFC 5869), with the API of RustCrypto's hkdf crate:
//! `Hkdf::<Sha256>::new(salt, ikm)`, then `expand(info, okm)`.
//!
//!     use std::crypto::hkdf::Hkdf;
//!     use std::crypto::sha2::Sha256;
//!     let hk = Hkdf::<Sha256>::new(Some(&salt), &ikm);
//!     let mut okm = [0u8; 42];
//!     hk.expand(&info, &mut okm).unwrap();

use crate::fmt::{self, Display, Formatter};
use crate::marker::PhantomData;
use crate::crypto::Digest;
use crate::crypto::hmac::{Hmac, Mac};

/// More output than HKDF gives (255 times the hash's length).
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct InvalidLength;

impl Display for InvalidLength {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { f.write_str("invalid number of blocks, too large output") }
}

/// A pseudorandom key shorter than the hash.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct InvalidPrkLength;

impl Display for InvalidPrkLength {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { f.write_str("invalid pseudorandom key length, too short") }
}

/// HKDF with the hash D: a pseudorandom key to expand.
#[derive(Clone)]
pub struct Hkdf<D: Digest> {
    prk: Vec<u8>,
    marker: PhantomData<D>,
}

impl<D: Digest> Hkdf<D> {
    /// Extracts from ikm (salt: none is the hash's length of zeros).
    pub fn new(salt: Option<&[u8]>, ikm: &[u8]) -> Hkdf<D> { Hkdf::<D>::extract(salt, ikm).1 }

    /// The pseudorandom key extracted from ikm, and the HKDF of it.
    pub fn extract(salt: Option<&[u8]>, ikm: &[u8]) -> (Vec<u8>, Hkdf<D>) {
        let mut zeros: Vec<u8> = Vec::new();
        zeros.resize(D::OUTPUT_SIZE, 0);
        let s: &[u8] = match salt { Some(x) => x, None => zeros.as_slice() };
        let mut m = Hmac::<D>::new_from_slice(s).unwrap();
        m.update(ikm);
        let prk = m.finalize();
        (prk.clone(), Hkdf { prk, marker: PhantomData })
    }

    /// The HKDF of a pseudorandom key already extracted.
    pub fn from_prk(prk: &[u8]) -> Result<Hkdf<D>, InvalidPrkLength> {
        if prk.len() < D::OUTPUT_SIZE { return Err(InvalidPrkLength); }
        Ok(Hkdf { prk: prk.to_vec(), marker: PhantomData })
    }

    /// Fills okm with the expansion of info.
    pub fn expand(&self, info: &[u8], okm: &mut [u8]) -> Result<(), InvalidLength> {
        let mut infos: Vec<&[u8]> = Vec::new();
        infos.push(info);
        self.expand_multi_info(&infos, okm)
    }

    /// expand with info the concatenation of infos (TLS labels).
    pub fn expand_multi_info(&self, infos: &[&[u8]], okm: &mut [u8]) -> Result<(), InvalidLength> {
        let hl = D::OUTPUT_SIZE;
        if okm.len() > 255 * hl { return Err(InvalidLength); }
        let mut prev: Vec<u8> = Vec::new();
        let mut at = 0;
        let mut i: u8 = 1;
        while at < okm.len() {
            let mut m = Hmac::<D>::new_from_slice(self.prk.as_slice()).unwrap();
            m.update(prev.as_slice());
            for x in infos.iter() { m.update(*x); }
            m.update(&[i]);
            prev = m.finalize();
            let mut k = 0;
            while k < hl && at < okm.len() {
                okm[at] = prev[k];
                at += 1;
                k += 1;
            }
            i = i.wrapping_add(1);
        }
        Ok(())
    }
}
