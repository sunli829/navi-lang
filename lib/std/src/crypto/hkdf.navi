//! HKDF (RFC 5869), the HMAC-based key derivation function, with the API
//! of RustCrypto's `hkdf` crate.
//!
//! HKDF turns input keying material (a shared secret from a key exchange,
//! a master key) into one or more strong keys: `Hkdf::<Sha256>::new(salt,
//! ikm)` extracts a pseudorandom key, then `expand(info, okm)` derives
//! output keying material for each purpose (`info`).
//!
//! # Examples
//!
//! RFC 5869, test case 1:
//!
//! ```
//! use std::crypto::hkdf::Hkdf;
//! use std::crypto::sha2::Sha256;
//! use std::hex;
//!
//! let ikm = hex::decode("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b").unwrap();
//! let salt = hex::decode("000102030405060708090a0b0c").unwrap();
//! let info = hex::decode("f0f1f2f3f4f5f6f7f8f9").unwrap();
//!
//! let hk = Hkdf::<Sha256>::new(Some(salt.as_slice()), ikm.as_slice());
//! let mut okm = [0u8; 42];
//! hk.expand(info.as_slice(), &mut okm).unwrap();
//! assert_eq(
//!     hex::encode(okm),
//!     "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865",
//! );
//! ```

use crate::crypto::Digest;
use crate::crypto::hmac::{Hmac, Mac};
use crate::fmt::{self, Display, Formatter};
use crate::marker::PhantomData;

/// The error returned when more output is asked for than HKDF gives (255
/// times the hash's length).
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct InvalidLength;

impl Display for InvalidLength {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("invalid number of blocks, too large output")
    }
}

/// The error returned by [`Hkdf::from_prk`] for a pseudorandom key shorter
/// than the hash.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct InvalidPrkLength;

impl Display for InvalidPrkLength {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("invalid pseudorandom key length, too short")
    }
}

/// HKDF with the hash `D`: a pseudorandom key, ready to expand into keys.
///
/// # Examples
///
/// ```
/// use std::crypto::hkdf::Hkdf;
/// use std::crypto::sha2::Sha256;
///
/// let hk = Hkdf::<Sha256>::new(None, b"shared secret");
/// let mut enc_key = [0u8; 32];
/// let mut mac_key = [0u8; 32];
/// hk.expand(b"encryption", &mut enc_key).unwrap();
/// hk.expand(b"authentication", &mut mac_key).unwrap();
/// assert_ne(enc_key, mac_key);
/// ```
#[derive(Clone)]
pub struct Hkdf<D: Digest> {
    prk: Vec<u8>,
    marker: PhantomData<D>,
}

impl<D: Digest> Hkdf<D> {
    /// Extracts a pseudorandom key from the input keying material `ikm`
    /// and the optional `salt` (`None` is the hash's length of zero bytes,
    /// as the RFC says).
    pub fn new(salt: Option<&[u8]>, ikm: &[u8]) -> Hkdf<D> {
        Hkdf::<D>::extract(salt, ikm).1
    }

    /// Extracts a pseudorandom key as [`Hkdf::new`] does, and returns it
    /// with the HKDF of it.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::crypto::hkdf::Hkdf;
    /// use std::crypto::sha2::Sha256;
    /// use std::hex;
    ///
    /// let ikm = hex::decode("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b").unwrap();
    /// let salt = hex::decode("000102030405060708090a0b0c").unwrap();
    /// let (prk, _hk) = Hkdf::<Sha256>::extract(Some(salt.as_slice()), ikm.as_slice());
    /// assert_eq(hex::encode(prk), "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5");
    /// ```
    pub fn extract(salt: Option<&[u8]>, ikm: &[u8]) -> (Vec<u8>, Hkdf<D>) {
        let mut zeros: Vec<u8> = Vec::new();
        zeros.resize(D::OUTPUT_SIZE, 0);
        let s: &[u8] = match salt {
            Some(x) => x,
            None => zeros.as_slice(),
        };
        let mut m = Hmac::<D>::new_from_slice(s).unwrap();
        m.update(ikm);
        let prk = m.finalize();
        (
            prk.clone(),
            Hkdf {
                prk,
                marker: PhantomData,
            },
        )
    }

    /// Creates the HKDF of a pseudorandom key already extracted (skipping
    /// the extract step).
    ///
    /// # Errors
    ///
    /// [`InvalidPrkLength`] if `prk` is shorter than the hash's output.
    pub fn from_prk(prk: &[u8]) -> Result<Hkdf<D>, InvalidPrkLength> {
        if prk.len() < D::OUTPUT_SIZE {
            return Err(InvalidPrkLength);
        }
        Ok(Hkdf {
            prk: prk.to_vec(),
            marker: PhantomData,
        })
    }

    /// Fills `okm` with output keying material for `info`.
    ///
    /// # Errors
    ///
    /// [`InvalidLength`] if `okm` is longer than 255 times the hash's
    /// output.
    pub fn expand(&self, info: &[u8], okm: &mut [u8]) -> Result<(), InvalidLength> {
        let mut infos: Vec<&[u8]> = Vec::new();
        infos.push(info);
        self.expand_multi_info(&infos, okm)
    }

    /// The same as [`Hkdf::expand`] with `info` the concatenation of
    /// `infos` (handy for TLS labels).
    ///
    /// # Errors
    ///
    /// [`InvalidLength`] if `okm` is longer than 255 times the hash's
    /// output.
    pub fn expand_multi_info(&self, infos: &[&[u8]], okm: &mut [u8]) -> Result<(), InvalidLength> {
        let hl = D::OUTPUT_SIZE;
        if okm.len() > 255 * hl {
            return Err(InvalidLength);
        }
        let mut prev: Vec<u8> = Vec::new();
        let mut at = 0;
        let mut i: u8 = 1;
        while at < okm.len() {
            let mut m = Hmac::<D>::new_from_slice(self.prk.as_slice()).unwrap();
            m.update(prev.as_slice());
            for x in infos.iter() {
                m.update(*x);
            }
            m.update(&[i]);
            prev = m.finalize();
            let mut k = 0;
            while k < hl && at < okm.len() {
                okm[at] = prev[k];
                at += 1;
                k += 1;
            }
            i = i.wrapping_add(1);
        }
        Ok(())
    }
}
