//! Generated by tools/gennistec.py (do not edit): P-256 for crypto::ec,
//! as Go's crypto/internal/fips140/nistec. Field elements are
//! [u64; 4] in Montgomery form (little-endian limbs); points are
//! Jacobian (x = X/Z^2, y = Y/Z^3), the identity Z = 0, with the formulas
//! of Go's P-256 assembly (a = -3). Scalar multiplication reads signed
//! 5-bit windows' table in constant time (Go's p256ScalarMult); the
//! generator's multiples per 4-bit window are an affine table built on
//! first use, added by mixed additions.

use crate::sync::LazyLock;

type Fe = [u64; 4];

const P: Fe = [0xffffffffffffffff, 0xffffffff, 0x0, 0xffffffff00000001];
const ZERO: Fe = [0x0, 0x0, 0x0, 0x0];
// 1, R^2, b, the generator (Montgomery form).
const ONE: Fe = [0x1, 0xffffffff00000000, 0xffffffffffffffff, 0xfffffffe];
const RR: Fe = [0x3, 0xfffffffbffffffff, 0xfffffffffffffffe, 0x4fffffffd];
const B: Fe = [0xd89cdf6229c4bddf, 0xacf005cd78843090, 0xe5a220abf7212ed6, 0xdc30061d04874834];
const GX: Fe = [0x79e730d418a9143c, 0x75ba95fc5fedb601, 0x79fb732b77622510, 0x18905f76a53755c6];
const GY: Fe = [0xddf25357ce95560a, 0x8b4ab8e4ba19e45c, 0xd2e88688dd21f325, 0x8571ff1825885d85];
const SIZE: usize = 32;
const LIMBS: usize = 4;
const TOP_WINDOW: usize = 254;
// p - 2 (inversion) and (p + 1) / 4 (square roots), big-endian.
const P_MINUS_2: [u8; 32] = [0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xfd];
const SQRT_EXP: [u8; 32] = [0x3f, 0xff, 0xff, 0xff, 0xc0, 0x00, 0x00, 0x00, 0x40, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x40, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00];

// The carries are bools: carrying_add / borrowing_sub chains are adcs / sbcs.
#[inline(always)]
fn adc(a: u64, b: u64, c: bool) -> (u64, bool) { a.carrying_add(b, c) }

#[inline(always)]
fn sbb(a: u64, b: u64, borrow: bool) -> (u64, bool) { a.borrowing_sub(b, borrow) }

// a * b + c + d (fits 128 bits): (lo, hi).
#[inline(always)]
fn mac(a: u64, b: u64, c: u64, d: u64) -> (u64, u64) {
    let (lo, hi) = a.widening_mul(b);
    let (s, c1) = lo.carrying_add(c, false);
    let (h, _) = hi.carrying_add(0, c1);
    let (s2, c2) = s.carrying_add(d, false);
    let (h2, _) = h.carrying_add(0, c2);
    (s2, h2)
}

// a * b / R mod p (CIOS, unrolled). In assembly on aarch64, x86_64 (nistec_p256_<arch>.s).
#[cfg(any(target_arch = "aarch64", target_arch = "x86_64"))]
#[asm]
fn fe_mul(a: &Fe, b: &Fe) -> Fe;

#[cfg(not(any(target_arch = "aarch64", target_arch = "x86_64")))]
fn fe_mul(a: &Fe, b: &Fe) -> Fe {
    let mut t0 = 0u64;
    let mut t1 = 0u64;
    let mut t2 = 0u64;
    let mut t3 = 0u64;
    let mut t4 = 0u64;
    let mut t5 = 0u64;
    let mut c: u64;
    let bi = b[0];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = adc(t4, c, false); t4 = x; t5 = y as u64;
    let q = t0;
    let (_, y) = mac(q, P[0], t0, 0); c = y;
    let (x, y) = mac(q, P[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, P[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, P[3], t3, c); t2 = x; c = y;
    let (x, y) = adc(t4, c, false); t3 = x; t4 = t5.wrapping_add(y as u64);
    let bi = b[1];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = adc(t4, c, false); t4 = x; t5 = y as u64;
    let q = t0;
    let (_, y) = mac(q, P[0], t0, 0); c = y;
    let (x, y) = mac(q, P[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, P[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, P[3], t3, c); t2 = x; c = y;
    let (x, y) = adc(t4, c, false); t3 = x; t4 = t5.wrapping_add(y as u64);
    let bi = b[2];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = adc(t4, c, false); t4 = x; t5 = y as u64;
    let q = t0;
    let (_, y) = mac(q, P[0], t0, 0); c = y;
    let (x, y) = mac(q, P[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, P[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, P[3], t3, c); t2 = x; c = y;
    let (x, y) = adc(t4, c, false); t3 = x; t4 = t5.wrapping_add(y as u64);
    let bi = b[3];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = adc(t4, c, false); t4 = x; t5 = y as u64;
    let q = t0;
    let (_, y) = mac(q, P[0], t0, 0); c = y;
    let (x, y) = mac(q, P[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, P[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, P[3], t3, c); t2 = x; c = y;
    let (x, y) = adc(t4, c, false); t3 = x; t4 = t5.wrapping_add(y as u64);
    // t < 2p: subtract p unless t < p.
    let (r0, w0) = sbb(t0, P[0], false);
    let (r1, w1) = sbb(t1, P[1], w0);
    let (r2, w2) = sbb(t2, P[2], w1);
    let (r3, w3) = sbb(t3, P[3], w2);
    let (_, bb) = sbb(t4, 0, w3);
    let mask = 0u64.wrapping_sub(bb as u64);
    [(t0 & mask) | (r0 & !mask), (t1 & mask) | (r1 & !mask), (t2 & mask) | (r2 & !mask), (t3 & mask) | (r3 & !mask)]
}

// a * a / R mod p. In assembly on aarch64, x86_64 (nistec_p256_<arch>.s).
#[cfg(any(target_arch = "aarch64", target_arch = "x86_64"))]
#[asm]
fn fe_sqr(a: &Fe) -> Fe;

#[cfg(not(any(target_arch = "aarch64", target_arch = "x86_64")))]
fn fe_sqr(a: &Fe) -> Fe { fe_mul(a, a) }

// a + b mod p. In assembly on aarch64, x86_64 (nistec_p256_<arch>.s).
#[cfg(any(target_arch = "aarch64", target_arch = "x86_64"))]
#[asm]
fn fe_add(a: &Fe, b: &Fe) -> Fe;

#[cfg(not(any(target_arch = "aarch64", target_arch = "x86_64")))]
fn fe_add(a: &Fe, b: &Fe) -> Fe {
    let (s0, c0) = adc(a[0], b[0], false);
    let (s1, c1) = adc(a[1], b[1], c0);
    let (s2, c2) = adc(a[2], b[2], c1);
    let (s3, c3) = adc(a[3], b[3], c2);
    let (d0, w0) = sbb(s0, P[0], false);
    let (d1, w1) = sbb(s1, P[1], w0);
    let (d2, w2) = sbb(s2, P[2], w1);
    let (d3, w3) = sbb(s3, P[3], w2);
    // Keep the sum when it is below p (no carry, a borrow).
    let (_, keep) = sbb(c3 as u64, 0, w3);
    let mask = 0u64.wrapping_sub(keep as u64);
    [(s0 & mask) | (d0 & !mask), (s1 & mask) | (d1 & !mask), (s2 & mask) | (d2 & !mask), (s3 & mask) | (d3 & !mask)]
}

// a - b mod p. In assembly on aarch64, x86_64 (nistec_p256_<arch>.s).
#[cfg(any(target_arch = "aarch64", target_arch = "x86_64"))]
#[asm]
fn fe_sub(a: &Fe, b: &Fe) -> Fe;

#[cfg(not(any(target_arch = "aarch64", target_arch = "x86_64")))]
fn fe_sub(a: &Fe, b: &Fe) -> Fe {
    let (d0, w0) = sbb(a[0], b[0], false);
    let (d1, w1) = sbb(a[1], b[1], w0);
    let (d2, w2) = sbb(a[2], b[2], w1);
    let (d3, w3) = sbb(a[3], b[3], w2);
    // Add p back on a borrow.
    let mask = 0u64.wrapping_sub(w3 as u64);
    let (r0, c0) = adc(d0, P[0] & mask, false);
    let (r1, c1) = adc(d1, P[1] & mask, c0);
    let (r2, c2) = adc(d2, P[2] & mask, c1);
    let (r3, c3) = adc(d3, P[3] & mask, c2);
    let _ = c3;
    [r0, r1, r2, r3]
}

// c ? a : b (c is 0 or 1), in constant time.
fn fe_select(c: u64, a: &Fe, b: &Fe) -> Fe {
    let mask = 0u64.wrapping_sub(c);
    [(a[0] & mask) | (b[0] & !mask), (a[1] & mask) | (b[1] & !mask), (a[2] & mask) | (b[2] & !mask), (a[3] & mask) | (b[3] & !mask)]
}

// 1 if a is zero, else 0.
fn fe_is_zero(a: &Fe) -> u64 {
    let x = a[0] | a[1] | a[2] | a[3];
    ((x | x.wrapping_neg()) >> 63) ^ 1
}

fn fe_eq(a: &Fe, b: &Fe) -> bool { fe_is_zero(&fe_sub(a, b)) == 1 }

// a^e, e big-endian (public: the steps depend on its bits).
fn fe_pow(a: &Fe, e: &[u8]) -> Fe {
    let mut r = ONE;
    for byte in e.iter() {
        let mut k = 8;
        while k > 0 {
            k -= 1;
            r = fe_sqr(&r);
            if ((*byte >> k as u8) & 1) != 0 { r = fe_mul(&r, a); }
        }
    }
    r
}

fn fe_inv(a: &Fe) -> Fe { fe_pow(a, &P_MINUS_2) }

// The element of big-endian bytes (SIZE of them), if below p.
fn fe_from_be(b: &[u8]) -> Option<Fe> {
    if b.len() != SIZE { return None; }
    let mut x: Fe = ZERO;
    let mut i = 0;
    while i < SIZE {
        let k = SIZE - 1 - i;
        x[k / 8] = x[k / 8] | ((b[i] as u64) << (8 * (k % 8)) as u64);
        i += 1;
    }
    let (_, w0) = sbb(x[0], P[0], false);
    let (_, w1) = sbb(x[1], P[1], w0);
    let (_, w2) = sbb(x[2], P[2], w1);
    let (_, w3) = sbb(x[3], P[3], w2);
    if !w3 { return None; }
    Some(fe_mul(&x, &RR))
}

// Big-endian bytes (SIZE) of an element.
fn fe_to_be(a: &Fe) -> Vec<u8> {
    let mut one: Fe = ZERO;
    one[0] = 1;
    let x = fe_mul(a, &one);
    let mut out: Vec<u8> = Vec::with_capacity(SIZE);
    let mut k = SIZE;
    while k > 0 {
        k -= 1;
        out.push((x[k / 8] >> (8 * (k % 8)) as u64) as u8);
    }
    out
}

#[derive(Clone)]
struct Point {
    x: Fe,
    y: Fe,
    z: Fe,
}

fn identity() -> Point { Point { x: ZERO, y: ONE, z: ZERO } }

fn generator() -> Point { Point { x: GX, y: GY, z: ONE } }

// The point formulas are Go's for P-256 (p256_asm_*.s: Jacobian
// coordinates, x = X/Z^2, y = Y/Z^3, a = -3; the identity has Z = 0).

// p + p (dbl-2001-b: 4M + 4S); the identity doubles to itself.
fn double(p: &Point) -> Point {
    let delta = fe_sqr(&p.z);
    let gamma = fe_sqr(&p.y);
    let beta = fe_mul(&p.x, &gamma);
    // alpha = 3 (x - delta) (x + delta)
    let t = fe_mul(&fe_sub(&p.x, &delta), &fe_add(&p.x, &delta));
    let alpha = fe_add(&fe_add(&t, &t), &t);
    let beta2 = fe_add(&beta, &beta);
    let beta4 = fe_add(&beta2, &beta2);
    let x3 = fe_sub(&fe_sqr(&alpha), &fe_add(&beta4, &beta4));
    let z = fe_mul(&p.y, &p.z);
    let z3 = fe_add(&z, &z);
    let g2 = fe_sqr(&gamma);
    let g4 = fe_add(&g2, &g2);
    let g4 = fe_add(&g4, &g4);
    let g8 = fe_add(&g4, &g4);
    let y3 = fe_sub(&fe_mul(&alpha, &fe_sub(&beta4, &x3)), &g8);
    Point { x: x3, y: y3, z: z3 }
}

// p1 + p2 (add-2007-bl, 12M + 4S) for p1, p2 not the identity, and 1 if
// they are equal (the sum is then wrong: double instead), else 0. p1 =
// -p2 gives the identity.
fn add_jac(p1: &Point, p2: &Point) -> (Point, u64) {
    let z1z1 = fe_sqr(&p1.z);
    let z2z2 = fe_sqr(&p2.z);
    let u1 = fe_mul(&p1.x, &z2z2);
    let u2 = fe_mul(&p2.x, &z1z1);
    let s1 = fe_mul(&p1.y, &fe_mul(&p2.z, &z2z2));
    let s2 = fe_mul(&p2.y, &fe_mul(&p1.z, &z1z1));
    let h = fe_sub(&u2, &u1);
    let r = fe_sub(&s2, &s1);
    let equal = fe_is_zero(&h) & fe_is_zero(&r);
    let hh = fe_sqr(&h);
    let hhh = fe_mul(&h, &hh);
    let v = fe_mul(&u1, &hh);
    let x3 = fe_sub(&fe_sub(&fe_sqr(&r), &hhh), &fe_add(&v, &v));
    let y3 = fe_sub(&fe_mul(&r, &fe_sub(&v, &x3)), &fe_mul(&s1, &hhh));
    let z3 = fe_mul(&fe_mul(&p1.z, &p2.z), &h);
    (Point { x: x3, y: y3, z: z3 }, equal)
}

// p1 + (x2, y2) (madd, 8M + 3S) for p1 not the identity and not equal to
// (x2, y2).
fn add_affine(p1: &Point, x2: &Fe, y2: &Fe) -> Point {
    let z1z1 = fe_sqr(&p1.z);
    let u2 = fe_mul(x2, &z1z1);
    let s2 = fe_mul(y2, &fe_mul(&p1.z, &z1z1));
    let h = fe_sub(&u2, &p1.x);
    let r = fe_sub(&s2, &p1.y);
    let hh = fe_sqr(&h);
    let hhh = fe_mul(&h, &hh);
    let v = fe_mul(&p1.x, &hh);
    let x3 = fe_sub(&fe_sub(&fe_sqr(&r), &hhh), &fe_add(&v, &v));
    let y3 = fe_sub(&fe_mul(&r, &fe_sub(&v, &x3)), &fe_mul(&p1.y, &hhh));
    let z3 = fe_mul(&p1.z, &h);
    Point { x: x3, y: y3, z: z3 }
}

// c ? a : b (c is 0 or 1), in constant time.
fn point_select(c: u64, a: &Point, b: &Point) -> Point {
    Point { x: fe_select(c, &a.x, &b.x), y: fe_select(c, &a.y, &b.y), z: fe_select(c, &a.z, &b.z) }
}

// 1 if p is the identity, else 0.
fn is_identity(p: &Point) -> u64 { fe_is_zero(&p.z) }

// p1 + p2 for any points (Go's P256Point.Add): the doubling when they are
// equal, the other when one is the identity; constant time.
fn add(p1: &Point, p2: &Point) -> Point {
    let (sum, equal) = add_jac(p1, p2);
    let dbl = double(p1);
    let s = point_select(equal, &dbl, &sum);
    let s = point_select(is_identity(p2), p1, &s);
    point_select(is_identity(p1), p2, &s)
}

// table[idx] (idx < table.len()), every entry read. In assembly on aarch64, x86_64
// (nistec_p256_<arch>.s).
#[cfg(any(target_arch = "aarch64", target_arch = "x86_64"))]
#[asm]
fn select_point(table: *const Point, n: usize, idx: u64) -> Point;

#[cfg(any(target_arch = "aarch64", target_arch = "x86_64"))]
fn lookup(table: &[Point], idx: u64) -> Point { select_point(table.as_ptr(), table.len(), idx) }

#[cfg(not(any(target_arch = "aarch64", target_arch = "x86_64")))]
fn lookup(table: &[Point], idx: u64) -> Point {
    let mut r = identity();
    r.y = ZERO;
    let mut j = 0;
    while j < table.len() {
        let d = (j as u64) ^ idx;
        let eq = ((d | d.wrapping_neg()) >> 63) ^ 1;
        let t = &table[j];
        r.x = fe_select(eq, &t.x, &r.x);
        r.y = fe_select(eq, &t.y, &r.y);
        r.z = fe_select(eq, &t.z, &r.z);
        j += 1;
    }
    r
}

// Booth's signed recoding of a 6-bit window (Go's boothW5): (|digit|,
// 1 if negative), the digit in [-16, 16].
fn booth5(w: u64) -> (u64, u64) {
    let s = !((w >> 5).wrapping_sub(1));
    let mut d = (1u64 << 6).wrapping_sub(w).wrapping_sub(1);
    d = (d & s) | (w & !s);
    d = (d >> 1) + (d & 1);
    (d, s & 1)
}

// Bits index .. index + 5 of the limbs (zero above them).
fn window6(k: &Fe, index: usize) -> u64 {
    let i = index / 64;
    let sh = index % 64;
    let mut w = k[i] >> sh as u64;
    if sh > 58 && i + 1 < LIMBS { w = w | (k[i + 1] << (64 - sh) as u64); }
    w & 0x3f
}

// k * p (k big-endian, below n), in constant time: Go's p256ScalarMult,
// signed 5-bit windows over a table of p, 2p, ..., 16p.
fn scalar_mult(p: &Point, k: &[u8]) -> Point {
    let (kl, _) = sc_limbs(k);
    let kl = sc_reduce(&kl);
    let mut table: Vec<Point> = Vec::with_capacity(16);
    table.push(p.clone());
    table.push(double(p));
    let mut i = 2;
    while i < 16 {
        let t = if i % 2 == 1 { double(&table[i / 2]) } else { add_jac(&table[i - 1], p).0 };
        table.push(t);
        i += 1;
    }
    // Entry sel - 1 for the digit sel in 1..16 (0: none, all zero).
    let mut index = TOP_WINDOW;
    let (sel0, _) = booth5(window6(&kl, index));
    let mut q = lookup(table.as_slice(), sel0.wrapping_sub(1));
    let mut zero = sel0;
    while index > 4 {
        index -= 5;
        q = double(&double(&double(&double(&double(&q)))));
        let (sel, sign) = booth5(window6(&kl, index));
        let mut t0 = lookup(table.as_slice(), sel.wrapping_sub(1));
        t0.y = fe_select(sign, &fe_sub(&ZERO, &t0.y), &t0.y);
        let (sum, _) = add_jac(&q, &t0);
        let t1 = point_select(nonzero(sel), &sum, &q);
        q = point_select(nonzero(zero), &t1, &t0);
        zero = zero | sel;
    }
    q = double(&double(&double(&double(&double(&q)))));
    let (sel, sign) = booth5((kl[0] << 1) & 0x3f);
    let mut t0 = lookup(table.as_slice(), sel.wrapping_sub(1));
    t0.y = fe_select(sign, &fe_sub(&ZERO, &t0.y), &t0.y);
    let (sum, _) = add_jac(&q, &t0);
    let t1 = point_select(nonzero(sel), &sum, &q);
    q = point_select(nonzero(zero), &t1, &t0);
    // The identity (all zero above) as (1, 1, 0).
    point_select(nonzero(zero | sel), &q, &identity())
}

// 1 if x is not 0, else 0.
fn nonzero(x: u64) -> u64 { (x | x.wrapping_neg()) >> 63 }

// An affine point (x, y), Montgomery form, never the identity.
#[derive(Clone)]
struct Affine {
    x: Fe,
    y: Fe,
}

// The generator's multiples as affine points: for window w (of 2 * SIZE,
// least significant first), j * 16^w * G (j in 1..16) at 15 * w + j - 1.
// Computed in Jacobian coordinates, then made affine with one inversion
// (Montgomery's trick).
static BASE: LazyLock<Vec<Affine>> = LazyLock::new(base_table);

fn base_table() -> Vec<Affine> {
    let mut pts: Vec<Point> = Vec::with_capacity(30 * SIZE);
    let mut g = generator();
    let mut wi = 0;
    while wi < 2 * SIZE {
        let mut acc = g.clone();
        let mut j = 1;
        while j < 16 {
            pts.push(acc.clone());
            if j < 15 { acc = add(&acc, &g); }
            j += 1;
        }
        g = double(&double(&double(&double(&g))));
        wi += 1;
    }
    // prefix[i] = z0 * ... * zi; then each 1/zi from 1/prefix.
    let mut prefix: Vec<Fe> = Vec::with_capacity(pts.len());
    let mut acc = ONE;
    for p in pts.iter() {
        acc = fe_mul(&acc, &p.z);
        prefix.push(acc);
    }
    let mut inv = fe_inv(&acc);
    let mut out: Vec<Affine> = Vec::with_capacity(pts.len());
    out.resize(pts.len(), Affine { x: ZERO, y: ZERO });
    let mut i = pts.len();
    while i > 0 {
        i -= 1;
        let zi = if i > 0 { fe_mul(&inv, &prefix[i - 1]) } else { inv };
        inv = fe_mul(&inv, &pts[i].z);
        let zi2 = fe_sqr(&zi);
        out[i] = Affine { x: fe_mul(&pts[i].x, &zi2), y: fe_mul(&pts[i].y, &fe_mul(&zi2, &zi)) };
    }
    out
}

// table[idx] (idx < 15 or none: zero), every entry read.
fn lookup_affine(table: &[Affine], idx: u64) -> Affine {
    let mut r = Affine { x: ZERO, y: ZERO };
    let mut j = 0;
    while j < table.len() {
        let d = (j as u64) ^ idx;
        let eq = ((d | d.wrapping_neg()) >> 63) ^ 1;
        r.x = fe_select(eq, &table[j].x, &r.x);
        r.y = fe_select(eq, &table[j].y, &r.y);
        j += 1;
    }
    r
}

// k * G (k big-endian, SIZE bytes or fewer), in constant time: a lookup and
// a mixed addition per 4-bit window, no doubling (as Go's p256BaseMult with
// its affine tables).
fn scalar_base_mult(k: &[u8]) -> Point {
    let t = LazyLock::force(&BASE);
    let mut q = identity();
    let mut zero = 0u64;
    let mut wi = 0;
    let mut i = k.len();
    while i > 0 && wi < 2 * SIZE {
        i -= 1;
        let mut h = 0;
        while h < 2 {
            let nib = if h == 0 { (k[i] & 15) as u64 } else { (k[i] >> 4) as u64 };
            let e = lookup_affine(&t[15 * wi..15 * wi + 15], nib.wrapping_sub(1));
            let sum = add_affine(&q, &e.x, &e.y);
            let r = point_select(nonzero(nib), &sum, &q);
            q = point_select(nonzero(zero), &r, &Point { x: e.x, y: e.y, z: ONE });
            zero = zero | nib;
            wi += 1;
            h += 1;
        }
    }
    point_select(nonzero(zero), &q, &identity())
}

// (x, y) of p (Montgomery form); None for the identity.
fn affine(p: &Point) -> Option<(Fe, Fe)> {
    if fe_is_zero(&p.z) == 1 { return None; }
    let zi = fe_inv(&p.z);
    let zi2 = fe_sqr(&zi);
    Some((fe_mul(&p.x, &zi2), fe_mul(&p.y, &fe_mul(&zi2, &zi))))
}

// x^3 - 3x + b.
fn rhs(x: &Fe) -> Fe {
    let x3 = fe_mul(&fe_sqr(x), x);
    let three_x = fe_add(&fe_add(x, x), x);
    fe_add(&fe_sub(&x3, &three_x), &B)
}

// The point of a SEC 1 encoding (uncompressed or compressed), if on the
// curve.
fn decode(b: &[u8]) -> Option<Point> {
    if b.len() == 1 + 2 * SIZE && b[0] == 4 {
        let x = fe_from_be(&b[1..1 + SIZE])?;
        let y = fe_from_be(&b[1 + SIZE..])?;
        if !fe_eq(&fe_sqr(&y), &rhs(&x)) { return None; }
        return Some(Point { x, y, z: ONE });
    }
    if b.len() == 1 + SIZE && (b[0] == 2 || b[0] == 3) {
        let x = fe_from_be(&b[1..])?;
        let r = rhs(&x);
        let mut y = fe_pow(&r, &SQRT_EXP);
        if !fe_eq(&fe_sqr(&y), &r) { return None; }
        let odd = fe_to_be(&y)[SIZE - 1] & 1;
        if odd != (b[0] & 1) { y = fe_sub(&ZERO, &y); }
        return Some(Point { x, y, z: ONE });
    }
    None
}

// The uncompressed SEC 1 encoding (empty for the identity).
fn encode(p: &Point) -> Vec<u8> {
    let mut out: Vec<u8> = Vec::new();
    if let Some((x, y)) = affine(p) {
        out.reserve(1 + 2 * SIZE);
        out.push(4);
        out.extend_from_slice(fe_to_be(&x).as_slice());
        out.extend_from_slice(fe_to_be(&y).as_slice());
    }
    out
}

// --- For crypto::ec (bytes in, bytes out) ---

/// The uncompressed encoding of a SEC 1 point, if valid.
pub(crate) fn decode_point(b: &[u8]) -> Option<Vec<u8>> {
    let p = decode(b)?;
    Some(encode(&p))
}

/// k * G, uncompressed (empty for the identity).
pub(crate) fn base_mult(k: &[u8]) -> Vec<u8> { encode(&scalar_base_mult(k)) }

/// The x-coordinate of k * peer (a valid uncompressed point), if not the
/// identity.
pub(crate) fn ecdh(k: &[u8], peer: &[u8]) -> Option<Vec<u8>> {
    let p = decode(peer)?;
    let (x, _) = affine(&scalar_mult(&p, k))?;
    Some(fe_to_be(&x))
}

/// The x-coordinate of u1 * G + u2 * q (q a valid uncompressed point), if
/// not the identity.
pub(crate) fn mul2_x(u1: &[u8], u2: &[u8], q: &[u8]) -> Option<Vec<u8>> {
    let qp = decode(q)?;
    let r = add(&scalar_base_mult(u1), &scalar_mult(&qp, u2));
    let (x, _) = affine(&r)?;
    Some(fe_to_be(&x))
}

// --- Scalars: modulo the group order N (Montgomery form) ---

const N: Fe = [0xf3b9cac2fc632551, 0xbce6faada7179e84, 0xffffffffffffffff, 0xffffffff00000000];
const N_ONE: Fe = [0xc46353d039cdaaf, 0x4319055258e8617b, 0x0, 0xffffffff];
const N_RR: Fe = [0x83244c95be79eea2, 0x4699799c49bd6fa6, 0x2845b2392b6bec59, 0x66e12d94f3d95620];
const N_MINUS_2: [u8; 32] = [0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xbc, 0xe6, 0xfa, 0xad, 0xa7, 0x17, 0x9e, 0x84, 0xf3, 0xb9, 0xca, 0xc2, 0xfc, 0x63, 0x25, 0x4f];

fn sc_mul(a: &Fe, b: &Fe) -> Fe {
    let mut t0 = 0u64;
    let mut t1 = 0u64;
    let mut t2 = 0u64;
    let mut t3 = 0u64;
    let mut t4 = 0u64;
    let mut t5 = 0u64;
    let mut c: u64;
    let bi = b[0];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = adc(t4, c, false); t4 = x; t5 = y as u64;
    let q = t0.wrapping_mul(0xccd1c8aaee00bc4f);
    let (_, y) = mac(q, N[0], t0, 0); c = y;
    let (x, y) = mac(q, N[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, N[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, N[3], t3, c); t2 = x; c = y;
    let (x, y) = adc(t4, c, false); t3 = x; t4 = t5.wrapping_add(y as u64);
    let bi = b[1];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = adc(t4, c, false); t4 = x; t5 = y as u64;
    let q = t0.wrapping_mul(0xccd1c8aaee00bc4f);
    let (_, y) = mac(q, N[0], t0, 0); c = y;
    let (x, y) = mac(q, N[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, N[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, N[3], t3, c); t2 = x; c = y;
    let (x, y) = adc(t4, c, false); t3 = x; t4 = t5.wrapping_add(y as u64);
    let bi = b[2];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = adc(t4, c, false); t4 = x; t5 = y as u64;
    let q = t0.wrapping_mul(0xccd1c8aaee00bc4f);
    let (_, y) = mac(q, N[0], t0, 0); c = y;
    let (x, y) = mac(q, N[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, N[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, N[3], t3, c); t2 = x; c = y;
    let (x, y) = adc(t4, c, false); t3 = x; t4 = t5.wrapping_add(y as u64);
    let bi = b[3];
    c = 0;
    let (x, y) = mac(a[0], bi, t0, c); t0 = x; c = y;
    let (x, y) = mac(a[1], bi, t1, c); t1 = x; c = y;
    let (x, y) = mac(a[2], bi, t2, c); t2 = x; c = y;
    let (x, y) = mac(a[3], bi, t3, c); t3 = x; c = y;
    let (x, y) = adc(t4, c, false); t4 = x; t5 = y as u64;
    let q = t0.wrapping_mul(0xccd1c8aaee00bc4f);
    let (_, y) = mac(q, N[0], t0, 0); c = y;
    let (x, y) = mac(q, N[1], t1, c); t0 = x; c = y;
    let (x, y) = mac(q, N[2], t2, c); t1 = x; c = y;
    let (x, y) = mac(q, N[3], t3, c); t2 = x; c = y;
    let (x, y) = adc(t4, c, false); t3 = x; t4 = t5.wrapping_add(y as u64);
    let (r0, w0) = sbb(t0, N[0], false);
    let (r1, w1) = sbb(t1, N[1], w0);
    let (r2, w2) = sbb(t2, N[2], w1);
    let (r3, w3) = sbb(t3, N[3], w2);
    let (_, bb) = sbb(t4, 0, w3);
    let mask = 0u64.wrapping_sub(bb as u64);
    [(t0 & mask) | (r0 & !mask), (t1 & mask) | (r1 & !mask), (t2 & mask) | (r2 & !mask), (t3 & mask) | (r3 & !mask)]
}

fn sc_add(a: &Fe, b: &Fe) -> Fe {
    let (s0, c0) = adc(a[0], b[0], false);
    let (s1, c1) = adc(a[1], b[1], c0);
    let (s2, c2) = adc(a[2], b[2], c1);
    let (s3, c3) = adc(a[3], b[3], c2);
    let (d0, w0) = sbb(s0, N[0], false);
    let (d1, w1) = sbb(s1, N[1], w0);
    let (d2, w2) = sbb(s2, N[2], w1);
    let (d3, w3) = sbb(s3, N[3], w2);
    let (_, keep) = sbb(c3 as u64, 0, w3);
    let mask = 0u64.wrapping_sub(keep as u64);
    [(s0 & mask) | (d0 & !mask), (s1 & mask) | (d1 & !mask), (s2 & mask) | (d2 & !mask), (s3 & mask) | (d3 & !mask)]
}

// a^(n-2): 1/a (a in Montgomery form; the exponent is public).
fn sc_inv(a: &Fe) -> Fe {
    let mut r = N_ONE;
    for byte in N_MINUS_2.iter() {
        let mut k = 8;
        while k > 0 {
            k -= 1;
            r = sc_mul(&r, &r);
            if ((*byte >> k as u8) & 1) != 0 { r = sc_mul(&r, a); }
        }
    }
    r
}

// Big-endian bytes (SIZE or fewer) as limbs, and whether below n.
fn sc_limbs(b: &[u8]) -> (Fe, bool) {
    let mut x: Fe = ZERO;
    let mut i = 0;
    while i < b.len() && i < SIZE {
        let k = b.len() - 1 - i;
        x[i / 8] = x[i / 8] | ((b[k] as u64) << (8 * (i % 8)) as u64);
        i += 1;
    }
    let (_, w0) = sbb(x[0], N[0], false);
    let (_, w1) = sbb(x[1], N[1], w0);
    let (_, w2) = sbb(x[2], N[2], w1);
    let (_, w3) = sbb(x[3], N[3], w2);
    (x, w3)
}

// x - n if x >= n (x < 2n), in constant time.
fn sc_reduce(x: &Fe) -> Fe {
    let (d0, w0) = sbb(x[0], N[0], false);
    let (d1, w1) = sbb(x[1], N[1], w0);
    let (d2, w2) = sbb(x[2], N[2], w1);
    let (d3, w3) = sbb(x[3], N[3], w2);
    let mask = 0u64.wrapping_sub(w3 as u64);
    [(x[0] & mask) | (d0 & !mask), (x[1] & mask) | (d1 & !mask), (x[2] & mask) | (d2 & !mask), (x[3] & mask) | (d3 & !mask)]
}

fn sc_to_mont(x: &Fe) -> Fe { sc_mul(x, &N_RR) }

fn sc_from_mont(x: &Fe) -> Fe {
    let mut one: Fe = ZERO;
    one[0] = 1;
    sc_mul(x, &one)
}

fn limbs_to_be(x: &Fe) -> Vec<u8> {
    let mut out: Vec<u8> = Vec::with_capacity(SIZE);
    let mut k = SIZE;
    while k > 0 {
        k -= 1;
        out.push((x[k / 8] >> (8 * (k % 8)) as u64) as u8);
    }
    out
}

// The hash as a scalar: its leftmost SIZE bytes, mod n (n has whole
// bytes for these curves).
fn hash_scalar(hash: &[u8]) -> Fe {
    let e = if hash.len() > SIZE { &hash[..SIZE] } else { hash };
    let (x, _) = sc_limbs(e);
    sc_reduce(&x)
}

/// An ECDSA signature (r, s) of hash by the secret scalar d with the
/// nonce k (both in [1, n), big-endian); None if r or s is zero (pick
/// another nonce). Constant-time in d and k.
pub(crate) fn sign(d: &[u8], k: &[u8], hash: &[u8]) -> Option<(Vec<u8>, Vec<u8>)> {
    let (rx, _) = affine(&scalar_base_mult(k))?;
    let (xl, _) = sc_limbs(fe_to_be(&rx).as_slice());
    let r = sc_reduce(&xl);
    if fe_is_zero(&r) == 1 { return None; }
    let (kl, _) = sc_limbs(k);
    let (dl, _) = sc_limbs(d);
    let e = sc_to_mont(&hash_scalar(hash));
    let kinv = sc_inv(&sc_to_mont(&kl));
    // s = (e + r d) / k
    let rd = sc_mul(&sc_to_mont(&r), &sc_to_mont(&dl));
    let s = sc_from_mont(&sc_mul(&kinv, &sc_add(&e, &rd)));
    if fe_is_zero(&s) == 1 { return None; }
    Some((limbs_to_be(&r), limbs_to_be(&s)))
}

/// Whether (r, s) is an ECDSA signature of hash by q (uncompressed).
pub(crate) fn verify(q: &[u8], hash: &[u8], r: &[u8], s: &[u8]) -> bool {
    if r.len() > SIZE || s.len() > SIZE { return false; }
    let (rl, r_ok) = sc_limbs(r);
    let (sl, s_ok) = sc_limbs(s);
    if !r_ok || !s_ok || fe_is_zero(&rl) == 1 || fe_is_zero(&sl) == 1 { return false; }
    let e = sc_to_mont(&hash_scalar(hash));
    let w = sc_inv(&sc_to_mont(&sl));
    let u1 = sc_from_mont(&sc_mul(&e, &w));
    let u2 = sc_from_mont(&sc_mul(&sc_to_mont(&rl), &w));
    let x = match mul2_x(limbs_to_be(&u1).as_slice(), limbs_to_be(&u2).as_slice(), q) {
        Some(x) => x,
        None => return false,
    };
    let (xl, _) = sc_limbs(x.as_slice());
    let xr = sc_reduce(&xl);
    let d = (xr[0] ^ rl[0]) | (xr[1] ^ rl[1]) | (xr[2] ^ rl[2]) | (xr[3] ^ rl[3]);
    d == 0
}
