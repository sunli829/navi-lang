//! String slices. Methods on str itself are declared in an inherent impl on
//! the primitive type (only std may do that).

pub struct Chars { bytes: &[u8], pos: usize }
impl Iterator for Chars {
    type Item = char;
    fn next(&mut self) -> Option<char> { todo() }
}

pub struct Bytes { bytes: &[u8], pos: usize }
impl Iterator for Bytes {
    type Item = u8;
    fn next(&mut self) -> Option<u8> { todo() }
}

pub struct Split { rest: &str, sep: &str, done: bool }
impl Iterator for Split {
    type Item = &str;
    fn next(&mut self) -> Option<&str> { todo() }
}

pub struct SplitWhitespace { rest: &str }
impl Iterator for SplitWhitespace {
    type Item = &str;
    fn next(&mut self) -> Option<&str> { todo() }
}

impl str {
    pub fn len(&self) -> usize { todo() }
    pub fn is_empty(&self) -> bool { self.len() == 0 }
    pub fn as_bytes(&self) -> &[u8] { todo() }
    pub fn as_ptr(&self) -> *const u8 { todo() }
    pub fn chars(&self) -> Chars { todo() }
    pub fn bytes(&self) -> Bytes { todo() }
    pub fn split(&self, sep: &str) -> Split { todo() }
    pub fn split_whitespace(&self) -> SplitWhitespace { todo() }
    pub fn lines(&self) -> Split { todo() }
    pub fn trim(&self) -> &str { todo() }
    pub fn trim_start(&self) -> &str { todo() }
    pub fn trim_end(&self) -> &str { todo() }
    pub fn starts_with(&self, prefix: &str) -> bool { todo() }
    pub fn ends_with(&self, suffix: &str) -> bool { todo() }
    pub fn contains(&self, pat: &str) -> bool { todo() }
    pub fn find(&self, pat: &str) -> Option<usize> { todo() }
    pub fn to_string(&self) -> crate::string::String { crate::string::String::from(self) }
    pub fn to_uppercase(&self) -> crate::string::String { todo() }
    pub fn to_lowercase(&self) -> crate::string::String { todo() }
    pub fn parse<F: FromStr>(&self) -> Result<F, F::Err> { F::from_str(self) }
}

/// Parsing a value from a string, used by str::parse.
pub trait FromStr {
    type Err;
    fn from_str(s: &str) -> Result<Self, Self::Err>;
}
