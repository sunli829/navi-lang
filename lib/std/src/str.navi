//! Utilities for the `str` primitive type: string slices.
//!
//! A `&str` is a view of UTF-8 text: a pointer and a length in bytes. String
//! literals are `&str`s, and a [`String`] dereferences to one, so every
//! method of `str` is also available on a `String`. Methods on `str` itself
//! are declared in an inherent impl on the primitive type (only std may do
//! that).
//!
//! This module also has the iterators returned by `str`'s methods
//! ([`Chars`](crate::str::Chars), [`Split`](crate::str::Split),
//! [`Lines`](crate::str::Lines) ...), the
//! [`pattern::Pattern`](crate::str::pattern::Pattern) trait for the things a
//! string can be searched for, [`from_utf8`](crate::str::from_utf8) to make a
//! `&str` from bytes, and the [`FromStr`](crate::str::FromStr) trait behind
//! `str::parse`.
//!
//! # Examples
//!
//! ```
//! let hello = "Hello, world!";
//! assert_eq(hello.len(), 13);
//! assert(hello.starts_with("Hello"));
//!
//! let words: Vec<&str> = hello.split(", ").collect();
//! assert_eq(words, ["Hello", "world!"]);
//!
//! let n: i32 = "42".parse().unwrap();
//! assert_eq(n, 42);
//! ```

use crate::string::String;

/// An iterator of the UTF-16 code units of a string.
///
/// This struct is created by `str::encode_utf16`.
///
/// # Examples
///
/// ```
/// let units: Vec<u16> = "a😀".encode_utf16().collect();
/// assert_eq(units, [0x61, 0xD83D, 0xDE00]);
/// ```
pub struct EncodeUtf16 {
    chars: Chars,
    extra: u16,
}

impl Iterator for EncodeUtf16 {
    type Item = u16;
    fn next(&mut self) -> Option<u16> {
        if self.extra != 0 {
            let u = self.extra;
            self.extra = 0;
            return Some(u);
        }
        let c = self.chars.next()? as u32;
        if c < 0x10000 {
            return Some(c as u16);
        }
        let v = c - 0x10000;
        self.extra = (0xDC00 + (v & 0x3FF)) as u16;
        Some((0xD800 + (v >> 10)) as u16)
    }
}

/// An iterator over the `char`s of a string slice.
///
/// This struct is created by `str::chars`. It is double-ended: it can also
/// be iterated from the back, and [`Chars::as_str`] gives the part not yet
/// iterated.
///
/// # Examples
///
/// ```
/// let mut chars = "añb".chars();
/// assert_eq(chars.next(), Some('a'));
/// assert_eq(chars.next_back(), Some('b'));
/// assert_eq(chars.as_str(), "ñ");
/// ```
pub struct Chars {
    bytes: &[u8],
    pos: usize,
    end: usize,
}

impl DoubleEndedIterator for Chars {
    fn next_back(&mut self) -> Option<char> {
        if self.end <= self.pos {
            return None;
        }
        let b = self.bytes;
        let mut i = self.end - 1;
        while i > self.pos && b[i] & 0xC0 == 0x80 {
            i -= 1;
        }
        let mut it = Chars {
            bytes: b,
            pos: i,
            end: self.end,
        };
        let c = it.next();
        self.end = i;
        c
    }
}

impl Iterator for Chars {
    type Item = char;
    fn next(&mut self) -> Option<char> {
        let b = self.bytes;
        let n = self.end;
        if self.pos >= n {
            return None;
        }
        let c0 = b[self.pos] as u32;
        let (len, init) = if c0 < 0x80 {
            (1, c0)
        } else if c0 < 0xE0 {
            (2, c0 & 0x1F)
        } else if c0 < 0xF0 {
            (3, c0 & 0x0F)
        } else {
            (4, c0 & 0x07)
        };
        let mut c = init;
        let mut i = 1;
        while i < len {
            c = (c << 6) | (b[self.pos + i] as u32 & 0x3F);
            i += 1;
        }
        self.pos += len;
        Some(char_from_u32(c))
    }
}

fn char_from_u32(c: u32) -> char {
    unsafe { *(&c as *const u32 as *const char) }
}

/// An iterator over the bytes of a string slice.
///
/// This struct is created by `str::bytes`. It is double-ended and knows
/// its exact length.
///
/// # Examples
///
/// ```
/// let mut bytes = "abc".bytes();
/// assert_eq(bytes.len(), 3);
/// assert_eq(bytes.next(), Some(b'a'));
/// assert_eq(bytes.next_back(), Some(b'c'));
/// assert_eq(bytes.len(), 1);
/// ```
pub struct Bytes {
    bytes: &[u8],
    pos: usize,
}

impl Iterator for Bytes {
    type Item = u8;
    fn next(&mut self) -> Option<u8> {
        if self.pos < self.bytes.len() {
            let b = self.bytes[self.pos];
            self.pos += 1;
            Some(b)
        } else {
            None
        }
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        (
            self.bytes.len() - self.pos,
            Some(self.bytes.len() - self.pos),
        )
    }
}

/// An iterator over the substrings of a string separated by a pattern.
///
/// This struct is created by `str::split`.
///
/// # Examples
///
/// ```
/// let mut parts = "a,b".split(',');
/// assert_eq(parts.next(), Some("a"));
/// assert_eq(parts.next(), Some("b"));
/// assert_eq(parts.next(), None);
/// ```
pub struct Split<P: Pattern> {
    rest: &str,
    pat: P,
    done: bool,
}

impl<P: Pattern> Iterator for Split<P> {
    type Item = &str;
    fn next(&mut self) -> Option<&str> {
        if self.done {
            return None;
        }
        match self.pat.next_match(self.rest, 0) {
            Some((a, b)) => {
                let head = &self.rest[0..a];
                // An empty match still advances by one character.
                self.rest = if b > 0 {
                    &self.rest[b..]
                } else {
                    &self.rest[next_char(self.rest, 0)..]
                };
                Some(head)
            }
            None => {
                self.done = true;
                Some(self.rest)
            }
        }
    }
}

/// An iterator over at most a given number of substrings of a string
/// separated by a pattern; the last one is the rest of the string.
///
/// This struct is created by `str::splitn`.
///
/// # Examples
///
/// ```
/// let mut parts = "a=b=c".splitn(2, '=');
/// assert_eq(parts.next(), Some("a"));
/// assert_eq(parts.next(), Some("b=c"));
/// assert_eq(parts.next(), None);
/// ```
pub struct SplitN<P: Pattern> {
    it: Split<P>,
    left: usize,
}

impl<P: Pattern> Iterator for SplitN<P> {
    type Item = &str;
    fn next(&mut self) -> Option<&str> {
        if self.left == 0 {
            return None;
        }
        self.left -= 1;
        if self.left == 0 {
            if self.it.done {
                return None;
            }
            self.it.done = true;
            return Some(self.it.rest);
        }
        self.it.next()
    }
}

/// An iterator over the lines of a string.
///
/// This struct is created by `str::lines`.
///
/// # Examples
///
/// ```
/// let mut lines = "one\r\ntwo\n".lines();
/// assert_eq(lines.next(), Some("one"));
/// assert_eq(lines.next(), Some("two"));
/// assert_eq(lines.next(), None);
/// ```
pub struct Lines {
    rest: &str,
}

impl Iterator for Lines {
    type Item = &str;
    fn next(&mut self) -> Option<&str> {
        if self.rest.is_empty() {
            return None;
        }
        let line = match self.rest.find('\n') {
            Some(i) => {
                let l = &self.rest[0..i];
                self.rest = &self.rest[i + 1..];
                l
            }
            None => {
                let l = self.rest;
                self.rest = "";
                l
            }
        };
        Some(match line.strip_suffix('\r') {
            Some(l) => l,
            None => line,
        })
    }
}

/// An iterator over the `char`s of a string slice and their byte
/// positions.
///
/// This struct is created by `str::char_indices`. It is double-ended.
///
/// # Examples
///
/// ```
/// let mut it = "añb".char_indices();
/// assert_eq(it.next(), Some((0, 'a')));
/// assert_eq(it.next(), Some((1, 'ñ')));
/// assert_eq(it.next(), Some((3, 'b')));
/// assert_eq(it.next(), None);
/// ```
pub struct CharIndices {
    s: &str,
    pos: usize,
}

impl Iterator for CharIndices {
    type Item = (usize, char);
    fn next(&mut self) -> Option<(usize, char)> {
        if self.pos >= self.s.len() {
            return None;
        }
        let i = self.pos;
        let c = self.s[i..].chars().next().unwrap();
        self.pos += c.len_utf8();
        Some((i, c))
    }
}

// The byte index of the character after the one at i.
fn next_char(s: &str, i: usize) -> usize {
    let b = s.as_bytes();
    let mut j = i + 1;
    while j < b.len() && b[j] & 0xC0 == 0x80 {
        j += 1;
    }
    j
}

/// The string pattern API: the [`Pattern`](crate::str::pattern::Pattern) trait
/// for what the searching methods of `str` take.
pub mod pattern {
    /// Something to search for in a string.
    ///
    /// The searching and splitting methods of `str` (`str::find`,
    /// `str::split`, `str::trim_matches`, `str::replace` ...) take
    /// any `Pattern`, as in Rust's `std::str::pattern`. It is implemented
    /// for:
    ///
    /// - `&str` and `&String`: a substring;
    /// - `char`: one character;
    /// - `fn(char) -> bool` (a closure taking a `char`): a character for
    ///   which it returns `true`;
    /// - `&[char]`, `[char; N]` and `&[char; N]`: any one of the
    ///   characters.
    ///
    /// The positions a pattern reports are byte indices into the haystack,
    /// always on character boundaries.
    ///
    /// # Examples
    ///
    /// ```
    /// let s = "Hello, world!";
    /// assert_eq(s.find("world"), Some(7));
    /// assert_eq(s.find('o'), Some(4));
    /// assert_eq(s.find(|c: char| c.is_ascii_punctuation()), Some(5));
    /// assert_eq(s.find(['w', 'r']), Some(7));
    /// assert_eq(s.find(&['x', '!'][..]), Some(12));
    /// ```
    ///
    /// Using the trait's methods directly:
    ///
    /// ```
    /// use std::str::pattern::Pattern;
    ///
    /// assert_eq("ab".next_match("xabab", 2), Some((3, 5)));
    /// assert_eq('b'.last_match("abab"), Some((3, 4)));
    /// assert_eq("x".prefix_len("xyz"), Some(1));
    /// assert_eq('z'.suffix_len("xyz"), Some(1));
    /// ```
    pub trait Pattern {
        /// Returns the first match in `hay` starting at or after byte
        /// index `from`, as the byte range `(start, end)`, or `None` if
        /// there is none.
        fn next_match(&self, hay: &str, from: usize) -> Option<(usize, usize)>;
        /// Returns the last match in `hay`, as the byte range
        /// `(start, end)`, or `None` if there is none.
        fn last_match(&self, hay: &str) -> Option<(usize, usize)>;
        /// Returns the length in bytes of a match at the start of `hay`, or
        /// `None` if `hay` does not start with a match.
        fn prefix_len(&self, hay: &str) -> Option<usize>;
        /// Returns the length in bytes of a match at the end of `hay`, or
        /// `None` if `hay` does not end with a match.
        fn suffix_len(&self, hay: &str) -> Option<usize>;
    }

    impl Pattern for &str {
        fn next_match(&self, hay: &str, from: usize) -> Option<(usize, usize)> {
            let n = hay.len();
            let m = self.len();
            let mut i = from;
            while i + m <= n {
                if &hay[i..i + m] == *self {
                    return Some((i, i + m));
                }
                i += 1;
            }
            None
        }

        fn last_match(&self, hay: &str) -> Option<(usize, usize)> {
            let n = hay.len();
            let m = self.len();
            if m > n {
                return None;
            }
            let mut i = n - m + 1;
            while i > 0 {
                i -= 1;
                if &hay[i..i + m] == *self {
                    return Some((i, i + m));
                }
            }
            None
        }

        fn prefix_len(&self, hay: &str) -> Option<usize> {
            if hay.len() >= self.len() && &hay[0..self.len()] == *self {
                Some(self.len())
            } else {
                None
            }
        }

        fn suffix_len(&self, hay: &str) -> Option<usize> {
            let n = hay.len();
            if n >= self.len() && &hay[n - self.len()..] == *self {
                Some(self.len())
            } else {
                None
            }
        }
    }

    impl Pattern for &String {
        fn next_match(&self, hay: &str, from: usize) -> Option<(usize, usize)> {
            self.as_str().next_match(hay, from)
        }

        fn last_match(&self, hay: &str) -> Option<(usize, usize)> {
            self.as_str().last_match(hay)
        }

        fn prefix_len(&self, hay: &str) -> Option<usize> {
            self.as_str().prefix_len(hay)
        }

        fn suffix_len(&self, hay: &str) -> Option<usize> {
            self.as_str().suffix_len(hay)
        }
    }

    impl Pattern for char {
        fn next_match(&self, hay: &str, from: usize) -> Option<(usize, usize)> {
            for (i, c) in hay[from..].char_indices() {
                if c == *self {
                    return Some((from + i, from + i + c.len_utf8()));
                }
            }
            None
        }

        fn last_match(&self, hay: &str) -> Option<(usize, usize)> {
            let mut it = hay.chars();
            let mut end = hay.len();
            while let Some(c) = it.next_back() {
                let start = end - c.len_utf8();
                if c == *self {
                    return Some((start, end));
                }
                end = start;
            }
            None
        }

        fn prefix_len(&self, hay: &str) -> Option<usize> {
            match hay.chars().next() {
                Some(c) => {
                    if c == *self {
                        Some(c.len_utf8())
                    } else {
                        None
                    }
                }
                None => None,
            }
        }

        fn suffix_len(&self, hay: &str) -> Option<usize> {
            match hay.chars().next_back() {
                Some(c) => {
                    if c == *self {
                        Some(c.len_utf8())
                    } else {
                        None
                    }
                }
                None => None,
            }
        }
    }

    impl Pattern for fn(char) -> bool {
        fn next_match(&self, hay: &str, from: usize) -> Option<(usize, usize)> {
            for (i, c) in hay[from..].char_indices() {
                if (*self)(c) {
                    return Some((from + i, from + i + c.len_utf8()));
                }
            }
            None
        }

        fn last_match(&self, hay: &str) -> Option<(usize, usize)> {
            let mut it = hay.chars();
            let mut end = hay.len();
            while let Some(c) = it.next_back() {
                let start = end - c.len_utf8();
                if (*self)(c) {
                    return Some((start, end));
                }
                end = start;
            }
            None
        }

        fn prefix_len(&self, hay: &str) -> Option<usize> {
            match hay.chars().next() {
                Some(c) => {
                    if (*self)(c) {
                        Some(c.len_utf8())
                    } else {
                        None
                    }
                }
                None => None,
            }
        }

        fn suffix_len(&self, hay: &str) -> Option<usize> {
            match hay.chars().next_back() {
                Some(c) => {
                    if (*self)(c) {
                        Some(c.len_utf8())
                    } else {
                        None
                    }
                }
                None => None,
            }
        }
    }
}

pub use self::pattern::Pattern;

/// An iterator over the whitespace-separated words of a string.
///
/// This struct is created by `str::split_whitespace`.
///
/// # Examples
///
/// ```
/// let mut words = "  hello \t world\n".split_whitespace();
/// assert_eq(words.next(), Some("hello"));
/// assert_eq(words.next(), Some("world"));
/// assert_eq(words.next(), None);
/// ```
pub struct SplitWhitespace {
    rest: &str,
}

impl Iterator for SplitWhitespace {
    type Item = &str;
    fn next(&mut self) -> Option<&str> {
        let s = self.rest.trim_start();
        if s.is_empty() {
            self.rest = s;
            return None;
        }
        let b = s.as_bytes();
        let mut i = 0;
        while i < b.len() && !is_space(b[i]) {
            i += 1;
        }
        self.rest = &s[i..];
        Some(&s[0..i])
    }
}

fn is_space(b: u8) -> bool {
    b == b' ' || b == b'\t' || b == b'\n' || b == b'\r'
}

/// Returns the length of the valid UTF-8 sequence starting at `b[i]`, or 0
/// if the bytes there are not a valid sequence.
///
/// A sequence is invalid if it is truncated, has a bad continuation byte,
/// is an overlong encoding, encodes a surrogate (U+D800 to U+DFFF) or a
/// value above U+10FFFF.
///
/// # Panics
///
/// Panics if `i` is out of bounds.
///
/// # Examples
///
/// ```
/// use std::str::utf8_seq_len;
///
/// let b = "aé😀".as_bytes();
/// assert_eq(utf8_seq_len(b, 0), 1);
/// assert_eq(utf8_seq_len(b, 1), 2);
/// assert_eq(utf8_seq_len(b, 3), 4);
/// assert_eq(utf8_seq_len(b, 2), 0); // a continuation byte
/// assert_eq(utf8_seq_len(&[0xC0, 0x80], 0), 0); // overlong
/// ```
pub fn utf8_seq_len(b: &[u8], i: usize) -> usize {
    let c = b[i];
    let (n, min) = if c < 0x80 {
        return 1;
    } else if c & 0xE0 == 0xC0 {
        (2, 0x80)
    } else if c & 0xF0 == 0xE0 {
        (3, 0x800)
    } else if c & 0xF8 == 0xF0 {
        (4, 0x10000)
    } else {
        return 0;
    };
    if i + n > b.len() {
        return 0;
    }
    let mut v = (c as u32) & (0x7F >> n);
    let mut j = 1;
    while j < n {
        if b[i + j] & 0xC0 != 0x80 {
            return 0;
        }
        v = (v << 6) | (b[i + j] as u32 & 0x3F);
        j += 1;
    }
    if v < min || v > 0x10FFFF || (v >= 0xD800 && v <= 0xDFFF) {
        return 0;
    }
    n
}

/// Returns `true` if the bytes are valid UTF-8.
///
/// # Examples
///
/// ```
/// use std::str::utf8_valid;
///
/// assert(utf8_valid("héllo".as_bytes()));
/// assert(utf8_valid(&[]));
/// assert(!utf8_valid(&[0x61, 0xFF]));
/// ```
pub fn utf8_valid(b: &[u8]) -> bool {
    let mut i = 0;
    while i < b.len() {
        let n = utf8_seq_len(b, i);
        if n == 0 {
            return false;
        }
        i += n;
    }
    true
}

/// Converts a slice of bytes to a string slice.
///
/// The `&str` shares the bytes: nothing is copied. To get an owned
/// [`String`] instead, see [`String::from_utf8`].
///
/// # Errors
///
/// Returns [`Utf8Error`] if the bytes are not valid UTF-8.
///
/// # Examples
///
/// ```
/// use std::str;
///
/// let sparkle_heart = [240u8, 159, 146, 150];
/// assert_eq(str::from_utf8(&sparkle_heart), Ok("💖"));
///
/// let invalid = [0u8, 159, 146, 150];
/// assert(str::from_utf8(&invalid).is_err());
/// ```
pub fn from_utf8(b: &[u8]) -> Result<&str, Utf8Error> {
    if utf8_valid(b) {
        Ok(crate::rt::str_from_raw(crate::rt::slice_ptr(b), b.len()))
    } else {
        Err(Utf8Error)
    }
}

/// Converts a slice of bytes to a string slice without checking that it is
/// valid UTF-8.
///
/// # Safety
///
/// The bytes must be valid UTF-8; the methods of `str` assume it, and may
/// panic or return garbage otherwise. See [`from_utf8`](crate::str::from_utf8)
/// for the checked version.
///
/// # Examples
///
/// ```
/// use std::str;
///
/// let sparkle_heart = [240u8, 159, 146, 150];
/// let s = unsafe { str::from_utf8_unchecked(&sparkle_heart) };
/// assert_eq(s, "💖");
/// ```
#[inline]
pub unsafe fn from_utf8_unchecked(b: &[u8]) -> &str {
    crate::rt::str_from_raw(crate::rt::slice_ptr(b), b.len())
}

/// The error returned by [`from_utf8`](crate::str::from_utf8) when the bytes
/// are not valid UTF-8.
///
/// Unlike Rust's, it carries no position (there is no `valid_up_to` or
/// `error_len`).
///
/// # Examples
///
/// ```
/// use std::str::{self, Utf8Error};
///
/// assert_eq(str::from_utf8(&[0xFFu8]), Err(Utf8Error));
/// ```
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct Utf8Error;

/// Returns `true` if two strings are equal (byte for byte), used by string
/// literal patterns.
///
/// # Examples
///
/// ```
/// assert(std::str::str_eq("abc", "abc"));
/// assert(!std::str::str_eq("abc", "ABC"));
/// ```
#[inline]
pub fn str_eq(a: &str, b: &str) -> bool {
    crate::slice::eq_slices(a.as_bytes(), b.as_bytes())
}

impl str {
    /// Returns the length of `self` in bytes.
    ///
    /// This is not the number of `char`s or graphemes: a character may
    /// take up to four bytes.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq("foo".len(), 3);
    /// assert_eq("ƒoo".len(), 4); // fancy f!
    /// assert_eq("ƒoo".chars().count(), 3);
    /// ```
    #[inline]
    pub fn len(&self) -> usize {
        self.as_bytes().len()
    }

    /// Returns `true` if `self` has a length of zero bytes.
    ///
    /// # Examples
    ///
    /// ```
    /// assert("".is_empty());
    /// assert(!"not empty".is_empty());
    /// ```
    #[inline]
    pub fn is_empty(&self) -> bool {
        self.len() == 0
    }

    /// Converts a string slice to a byte slice.
    ///
    /// To convert the bytes back, use [`from_utf8`](crate::str::from_utf8).
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = "bors".as_bytes();
    /// assert_eq(bytes, b"bors");
    /// ```
    #[inline]
    pub fn as_bytes(&self) -> &[u8] {
        crate::rt::str_as_bytes(self)
    }

    /// Returns a raw pointer to the first byte of the string slice.
    ///
    /// # Examples
    ///
    /// ```
    /// let s = "Hello";
    /// let ptr = s.as_ptr();
    /// assert_eq(unsafe { *ptr }, b'H');
    /// ```
    #[inline]
    pub fn as_ptr(&self) -> *const u8 {
        self.as_bytes().as_ptr()
    }

    /// Returns an iterator over the `char`s of a string slice.
    ///
    /// A `char` is a Unicode scalar value, which is not always what is
    /// meant by a "character": a letter with a combining accent is two
    /// `char`s.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut chars = "goodbye".chars();
    /// assert_eq(chars.next(), Some('g'));
    /// assert_eq(chars.next_back(), Some('e'));
    ///
    /// let count = "ñandú".chars().count();
    /// assert_eq(count, 5);
    ///
    /// let reversed: String = "abc".chars().rev().collect();
    /// assert_eq(reversed, "cba");
    /// ```
    #[inline]
    pub fn chars(&self) -> Chars {
        Chars {
            bytes: self.as_bytes(),
            pos: 0,
            end: self.len(),
        }
    }

    /// Returns an iterator of the string's UTF-16 code units.
    ///
    /// # Examples
    ///
    /// ```
    /// let text = "Zażółć gęślą jaźń";
    /// let utf8_len = text.len();
    /// let utf16_len = text.encode_utf16().count();
    /// assert(utf16_len <= utf8_len);
    ///
    /// let units: Vec<u16> = "a😀".encode_utf16().collect();
    /// assert_eq(units, [0x61, 0xD83D, 0xDE00]);
    /// ```
    #[inline]
    pub fn encode_utf16(&self) -> EncodeUtf16 {
        EncodeUtf16 {
            chars: self.chars(),
            extra: 0,
        }
    }

    /// Returns an iterator over the bytes of a string slice.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut bytes = "bors".bytes();
    /// assert_eq(bytes.next(), Some(b'b'));
    /// assert_eq(bytes.next(), Some(b'o'));
    /// assert_eq(bytes.next(), Some(b'r'));
    /// assert_eq(bytes.next(), Some(b's'));
    /// assert_eq(bytes.next(), None);
    /// ```
    #[inline]
    pub fn bytes(&self) -> Bytes {
        Bytes {
            bytes: self.as_bytes(),
            pos: 0,
        }
    }

    /// Returns an iterator over the substrings of this string slice,
    /// separated by matches of a pattern.
    ///
    /// The pattern can be a `&str`, a `char`, a slice or array of `char`s,
    /// or a closure that decides whether a `char` matches (see
    /// [`Pattern`]).
    ///
    /// If there are no matches, the iterator yields the whole string. Two
    /// adjacent separators, or a separator at the start or end, give empty
    /// substrings; use `str::split_whitespace` or
    /// `str::split_terminator` to avoid some of them.
    ///
    /// # Examples
    ///
    /// ```
    /// let v: Vec<&str> = "Mary had a little lamb".split(' ').collect();
    /// assert_eq(v, ["Mary", "had", "a", "little", "lamb"]);
    ///
    /// let v: Vec<&str> = "lionXXtigerXleopard".split('X').collect();
    /// assert_eq(v, ["lion", "", "tiger", "leopard"]);
    ///
    /// let v: Vec<&str> = "lion::tiger::leopard".split("::").collect();
    /// assert_eq(v, ["lion", "tiger", "leopard"]);
    ///
    /// let v: Vec<&str> = "abc1defXghi".split(|c: char| c == '1' || c == 'X').collect();
    /// assert_eq(v, ["abc", "def", "ghi"]);
    ///
    /// let v: Vec<&str> = "2020-11-03 23:59".split(['-', ' ', ':']).collect();
    /// assert_eq(v, ["2020", "11", "03", "23", "59"]);
    ///
    /// let v: Vec<&str> = ",a,,b,".split(',').collect();
    /// assert_eq(v, ["", "a", "", "b", ""]);
    /// ```
    #[inline]
    pub fn split<P: Pattern>(&self, pat: P) -> Split<P> {
        Split {
            rest: self,
            pat,
            done: false,
        }
    }

    /// Returns an iterator over at most `n` substrings of this string
    /// slice, separated by a pattern.
    ///
    /// The last substring returned is the rest of the string, separators
    /// included. With `n` 0 the iterator is empty.
    ///
    /// # Examples
    ///
    /// ```
    /// let v: Vec<&str> = "Mary had a little lambda".splitn(3, ' ').collect();
    /// assert_eq(v, ["Mary", "had", "a little lambda"]);
    ///
    /// let v: Vec<&str> = "lionXXtigerXleopard".splitn(3, "X").collect();
    /// assert_eq(v, ["lion", "", "tigerXleopard"]);
    ///
    /// let v: Vec<&str> = "abcXdef".splitn(1, 'X').collect();
    /// assert_eq(v, ["abcXdef"]);
    ///
    /// let v: Vec<&str> = "".splitn(1, 'X').collect();
    /// assert_eq(v, [""]);
    /// ```
    #[inline]
    pub fn splitn<P: Pattern>(&self, n: usize, pat: P) -> SplitN<P> {
        SplitN {
            it: self.split(pat),
            left: n,
        }
    }

    /// Returns an iterator over the whitespace-separated words of a string
    /// slice.
    ///
    /// Unlike Rust's, the whitespace here is only ASCII space, tab (`\t`),
    /// newline (`\n`) and carriage return (`\r`); other characters, such as
    /// form feed or Unicode spaces, are part of the words. Runs of
    /// whitespace and whitespace at either end give no empty words.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut iter = "A few words".split_whitespace();
    /// assert_eq(Some("A"), iter.next());
    /// assert_eq(Some("few"), iter.next());
    /// assert_eq(Some("words"), iter.next());
    /// assert_eq(None, iter.next());
    ///
    /// let words: Vec<&str> = "  Mary   had\ta\nlittle  \r\n lamb  ".split_whitespace().collect();
    /// assert_eq(words, ["Mary", "had", "a", "little", "lamb"]);
    ///
    /// assert_eq("   ".split_whitespace().next(), None);
    /// ```
    #[inline]
    pub fn split_whitespace(&self) -> SplitWhitespace {
        SplitWhitespace { rest: self }
    }

    /// Returns an iterator over the lines of a string, as string slices.
    ///
    /// Lines end with a newline (`\n`) or a carriage return followed by a
    /// newline (`\r\n`); the line terminators are not part of the lines.
    /// The final line ending is optional: a string that ends with one gives
    /// the same lines as without it.
    ///
    /// # Examples
    ///
    /// ```
    /// let text = "foo\r\nbar\n\nbaz\n";
    /// let mut lines = text.lines();
    /// assert_eq(Some("foo"), lines.next());
    /// assert_eq(Some("bar"), lines.next());
    /// assert_eq(Some(""), lines.next());
    /// assert_eq(Some("baz"), lines.next());
    /// assert_eq(None, lines.next());
    ///
    /// assert_eq("no ending".lines().count(), 1);
    /// assert_eq("".lines().count(), 0);
    /// ```
    #[inline]
    pub fn lines(&self) -> Lines {
        Lines { rest: self }
    }

    /// Returns an iterator over the `char`s of a string slice, and their
    /// byte positions.
    ///
    /// # Examples
    ///
    /// ```
    /// let v: Vec<(usize, char)> = "goodbye".char_indices().take(3).collect();
    /// assert_eq(v, [(0, 'g'), (1, 'o'), (2, 'o')]);
    ///
    /// // multi-byte characters advance the position by more than one
    /// let v: Vec<(usize, char)> = "yés".char_indices().collect();
    /// assert_eq(v, [(0, 'y'), (1, 'é'), (3, 's')]);
    /// ```
    #[inline]
    pub fn char_indices(&self) -> CharIndices {
        CharIndices { s: self, pos: 0 }
    }

    /// Splits the string on the first match of a pattern.
    ///
    /// Returns the parts before and after the match (the match itself is
    /// in neither), or `None` if the pattern does not match.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq("cfg".split_once('='), None);
    /// assert_eq("cfg=".split_once('='), Some(("cfg", "")));
    /// assert_eq("cfg=foo".split_once('='), Some(("cfg", "foo")));
    /// assert_eq("cfg=foo=bar".split_once('='), Some(("cfg", "foo=bar")));
    /// ```
    pub fn split_once<P: Pattern>(&self, pat: P) -> Option<(&str, &str)> {
        let (a, b) = pat.next_match(self, 0)?;
        Some((&self[0..a], &self[b..]))
    }

    /// Splits the string on the last match of a pattern.
    ///
    /// Returns the parts before and after the match, or `None` if the
    /// pattern does not match.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq("cfg".rsplit_once('='), None);
    /// assert_eq("cfg=foo".rsplit_once('='), Some(("cfg", "foo")));
    /// assert_eq("cfg=foo=bar".rsplit_once('='), Some(("cfg=foo", "bar")));
    /// ```
    pub fn rsplit_once<P: Pattern>(&self, pat: P) -> Option<(&str, &str)> {
        let (a, b) = pat.last_match(self)?;
        Some((&self[0..a], &self[b..]))
    }

    /// Divides one string slice into two at a byte index.
    ///
    /// The first slice has the bytes `[0, mid)`, the second `[mid, len)`.
    /// See `str::split_at_checked` for a version that returns `None`
    /// instead of panicking.
    ///
    /// # Panics
    ///
    /// Panics if `mid` is past the end of the string. Unlike Rust, `mid` is
    /// not checked to be on a `char` boundary: splitting a character in
    /// two gives slices that are not valid UTF-8.
    ///
    /// # Examples
    ///
    /// ```
    /// let s = "Per Martin-Löf";
    /// let (first, last) = s.split_at(3);
    /// assert_eq("Per", first);
    /// assert_eq(" Martin-Löf", last);
    /// ```
    #[inline]
    pub fn split_at(&self, mid: usize) -> (&str, &str) {
        (&self[0..mid], &self[mid..])
    }

    /// Returns the string slice with a prefix removed.
    ///
    /// If the string starts with the pattern, returns the rest after one
    /// match, in `Some`; otherwise `None`. Unlike
    /// `str::trim_start_matches`, this removes the prefix exactly once.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq("foo:bar".strip_prefix("foo:"), Some("bar"));
    /// assert_eq("foo:bar".strip_prefix("bar"), None);
    /// assert_eq("foofoo".strip_prefix("foo"), Some("foo"));
    /// ```
    pub fn strip_prefix<P: Pattern>(&self, pat: P) -> Option<&str> {
        let n = pat.prefix_len(self)?;
        Some(&self[n..])
    }

    /// Returns the string slice with a suffix removed.
    ///
    /// If the string ends with the pattern, returns what comes before one
    /// match, in `Some`; otherwise `None`. Unlike `str::trim_end_matches`,
    /// this removes the suffix exactly once.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq("bar:foo".strip_suffix(":foo"), Some("bar"));
    /// assert_eq("bar:foo".strip_suffix("bar"), None);
    /// assert_eq("foofoo".strip_suffix("foo"), Some("foo"));
    /// ```
    pub fn strip_suffix<P: Pattern>(&self, pat: P) -> Option<&str> {
        let n = pat.suffix_len(self)?;
        Some(&self[0..self.len() - n])
    }

    /// Returns a string slice with all prefixes that match a pattern
    /// repeatedly removed.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq("11foo1bar11".trim_start_matches('1'), "foo1bar11");
    /// assert_eq("123foo1bar123".trim_start_matches(|c: char| c.is_numeric()), "foo1bar123");
    /// assert_eq("xyxyz".trim_start_matches("xy"), "z");
    /// ```
    pub fn trim_start_matches<P: Pattern>(&self, pat: P) -> &str {
        let mut s = self;
        loop {
            match pat.prefix_len(s) {
                Some(n) => {
                    if n == 0 {
                        return s;
                    }
                    s = &s[n..];
                }
                None => return s,
            }
        }
    }

    /// Returns a string slice with all suffixes that match a pattern
    /// repeatedly removed.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq("11foo1bar11".trim_end_matches('1'), "11foo1bar");
    /// assert_eq("123foo1bar123".trim_end_matches(|c: char| c.is_numeric()), "123foo1bar");
    /// assert_eq("1fooX".trim_end_matches(['X', 'o']), "1f");
    /// ```
    pub fn trim_end_matches<P: Pattern>(&self, pat: P) -> &str {
        let mut s = self;
        loop {
            match pat.suffix_len(s) {
                Some(n) => {
                    if n == 0 {
                        return s;
                    }
                    s = &s[0..s.len() - n];
                }
                None => return s,
            }
        }
    }

    /// Replaces all matches of a pattern with another string.
    ///
    /// `replace` creates a new [`String`] and copies the data from this
    /// string slice into it. While doing so, it searches for matches of the
    /// pattern; each one is replaced by `to`. Matches do not overlap: the
    /// search goes on after the end of each match.
    ///
    /// # Examples
    ///
    /// ```
    /// let s = "this is old";
    /// assert_eq(s.replace("old", "new"), "this is new");
    /// assert_eq(s.replace("is", "an"), "than an old");
    ///
    /// // the pattern may be anything that is a Pattern
    /// assert_eq("a-b_c".replace(['-', '_'], " "), "a b c");
    ///
    /// // no match: the string is copied unchanged
    /// assert_eq(s.replace("cookie monster", "little lamb"), s);
    /// ```
    pub fn replace<P: Pattern>(&self, from: P, to: &str) -> String {
        let mut out = String::new();
        let mut pos = 0;
        loop {
            match from.next_match(self, pos) {
                Some((a, b)) => {
                    out.push_str(&self[pos..a]);
                    out.push_str(to);
                    if b == a {
                        if a >= self.len() {
                            return out;
                        }
                        let n = next_char(self, a);
                        out.push_str(&self[a..n]);
                        pos = n;
                    } else {
                        pos = b;
                    }
                }
                None => {
                    out.push_str(&self[pos..]);
                    return out;
                }
            }
        }
    }

    /// Creates a new [`String`] by repeating a string `n` times.
    ///
    /// # Panics
    ///
    /// Panics if the length of the result overflows `usize`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq("abc".repeat(4), "abcabcabcabc");
    /// assert_eq("abc".repeat(0), "");
    /// ```
    pub fn repeat(&self, n: usize) -> String {
        let mut out = String::new();
        let mut i = 0;
        while i < n {
            out.push_str(self);
            i += 1;
        }
        out
    }

    /// Converts the string slice to an owned [`String`].
    ///
    /// The same as [`ToString::to_string`](crate::string::ToString::to_string)
    /// (which formats through `Display`), without the formatting machinery.
    ///
    /// # Examples
    ///
    /// ```
    /// let s: String = "hello".to_string();
    /// assert_eq(s, "hello");
    /// ```
    #[inline]
    pub fn to_string(&self) -> String {
        String::from(self)
    }

    /// Creates an owned [`String`] with a copy of this string slice.
    ///
    /// The same as `str::to_string`.
    ///
    /// # Examples
    ///
    /// ```
    /// let s: &str = "a";
    /// let mut owned: String = s.to_owned();
    /// owned.push('b');
    /// assert_eq(owned, "ab");
    /// assert_eq(s, "a");
    /// ```
    #[inline]
    pub fn to_owned(&self) -> String {
        String::from(self)
    }

    /// Converts the string slice to an owned [`String`].
    ///
    /// In Rust this converts a `Box<str>`; in navi it copies the text, as
    /// `str::to_string`.
    ///
    /// # Examples
    ///
    /// ```
    /// let s = "hello";
    /// assert_eq(s.into_string(), String::from("hello"));
    /// ```
    #[inline]
    pub fn into_string(&self) -> String {
        self.to_string()
    }

    /// Checks that the `index`-th byte is the first byte of a UTF-8
    /// sequence or the end of the string.
    ///
    /// The start and end of the string (`index == 0` and
    /// `index == self.len()`) are boundaries. Returns `false` if `index` is
    /// greater than `self.len()`.
    ///
    /// # Examples
    ///
    /// ```
    /// let s = "Löwe 老虎 Léopard";
    /// assert(s.is_char_boundary(0));
    /// // start of `老`
    /// assert(s.is_char_boundary(6));
    /// assert(s.is_char_boundary(s.len()));
    ///
    /// // second byte of `ö`
    /// assert(!s.is_char_boundary(2));
    ///
    /// // third byte of `老`
    /// assert(!s.is_char_boundary(8));
    ///
    /// assert(!s.is_char_boundary(100));
    /// ```
    pub fn is_char_boundary(&self, i: usize) -> bool {
        if i == 0 || i == self.len() {
            return true;
        }
        if i > self.len() {
            return false;
        }
        self.as_bytes()[i] & 0xC0 != 0x80
    }

    /// Checks that two strings are an ASCII case-insensitive match.
    ///
    /// The same as `to_ascii_lowercase(a) == to_ascii_lowercase(b)`, but
    /// without making new strings. Non-ASCII characters must be equal.
    ///
    /// # Examples
    ///
    /// ```
    /// assert("Ferris".eq_ignore_ascii_case("FERRIS"));
    /// assert("Ferrös".eq_ignore_ascii_case("FERRöS"));
    /// assert(!"Ferrös".eq_ignore_ascii_case("FERRÖS"));
    /// ```
    pub fn eq_ignore_ascii_case(&self, other: &str) -> bool {
        if self.len() != other.len() {
            return false;
        }
        let a = self.as_bytes();
        let b = other.as_bytes();
        let mut i = 0;
        while i < a.len() {
            if a[i].to_ascii_lowercase() != b[i].to_ascii_lowercase() {
                return false;
            }
            i += 1;
        }
        true
    }

    /// Returns a string slice with leading and trailing whitespace removed.
    ///
    /// Unlike Rust's, the whitespace removed is only ASCII space, tab
    /// (`\t`), newline (`\n`) and carriage return (`\r`), as in
    /// `str::split_whitespace`; form feed and Unicode spaces are kept.
    /// See `str::trim_matches` to trim other characters.
    ///
    /// # Examples
    ///
    /// ```
    /// let s = "\n Hello\tworld\t\r\n";
    /// assert_eq("Hello\tworld", s.trim());
    /// ```
    #[inline]
    pub fn trim(&self) -> &str {
        self.trim_start().trim_end()
    }

    /// Returns a string slice with leading whitespace removed.
    ///
    /// The whitespace removed is ASCII space, tab, newline and carriage
    /// return, as in `str::trim`.
    ///
    /// # Examples
    ///
    /// ```
    /// let s = "\n Hello\tworld\t\n";
    /// assert_eq("Hello\tworld\t\n", s.trim_start());
    /// ```
    pub fn trim_start(&self) -> &str {
        let b = self.as_bytes();
        let mut i = 0;
        while i < b.len() && is_space(b[i]) {
            i += 1;
        }
        &self[i..]
    }

    /// Returns a string slice with trailing whitespace removed.
    ///
    /// The whitespace removed is ASCII space, tab, newline and carriage
    /// return, as in `str::trim`.
    ///
    /// # Examples
    ///
    /// ```
    /// let s = "\n Hello\tworld\t\n";
    /// assert_eq("\n Hello\tworld", s.trim_end());
    /// ```
    pub fn trim_end(&self) -> &str {
        let b = self.as_bytes();
        let mut n = b.len();
        while n > 0 && is_space(b[n - 1]) {
            n -= 1;
        }
        &self[0..n]
    }

    /// Returns `true` if the given pattern matches a prefix of this string
    /// slice.
    ///
    /// # Examples
    ///
    /// ```
    /// let bananas = "bananas";
    /// assert(bananas.starts_with("bana"));
    /// assert(!bananas.starts_with("nana"));
    /// assert(bananas.starts_with('b'));
    /// assert(bananas.starts_with(|c: char| c.is_lowercase()));
    /// assert(bananas.starts_with(""));
    /// ```
    #[inline]
    pub fn starts_with<P: Pattern>(&self, pat: P) -> bool {
        pat.prefix_len(self).is_some()
    }

    /// Returns `true` if the given pattern matches a suffix of this string
    /// slice.
    ///
    /// # Examples
    ///
    /// ```
    /// let bananas = "bananas";
    /// assert(bananas.ends_with("anas"));
    /// assert(!bananas.ends_with("nana"));
    /// assert(bananas.ends_with(['a', 's']));
    /// ```
    #[inline]
    pub fn ends_with<P: Pattern>(&self, pat: P) -> bool {
        pat.suffix_len(self).is_some()
    }

    /// Returns the byte index of the first character of this string slice
    /// that matches the pattern, or `None` if it doesn't match.
    ///
    /// # Examples
    ///
    /// ```
    /// let s = "Löwe 老虎 Léopard Gepardi";
    /// assert_eq(s.find('L'), Some(0));
    /// assert_eq(s.find('é'), Some(14));
    /// assert_eq(s.find("pard"), Some(17));
    ///
    /// // with a closure or an array of chars
    /// assert_eq(s.find(|c: char| c.is_whitespace() || c.is_lowercase()), Some(1));
    /// assert_eq(s.find(['老', '虎']), Some(6));
    ///
    /// assert_eq(s.find("x"), None);
    /// ```
    pub fn find<P: Pattern>(&self, pat: P) -> Option<usize> {
        match pat.next_match(self, 0) {
            Some((a, _)) => Some(a),
            None => None,
        }
    }

    /// Returns the byte index of the start of the last match of the pattern
    /// in this string slice, or `None` if it doesn't match.
    ///
    /// # Examples
    ///
    /// ```
    /// let s = "Löwe 老虎 Léopard Gepardi";
    /// assert_eq(s.rfind('L'), Some(13));
    /// assert_eq(s.rfind('é'), Some(14));
    /// assert_eq(s.rfind("pard"), Some(24));
    /// assert_eq(s.rfind(|c: char| c.is_whitespace()), Some(21));
    /// assert_eq(s.rfind("x"), None);
    /// ```
    pub fn rfind<P: Pattern>(&self, pat: P) -> Option<usize> {
        match pat.last_match(self) {
            Some((a, _)) => Some(a),
            None => None,
        }
    }

    /// Returns `true` if the given pattern matches a substring of this
    /// string slice.
    ///
    /// # Examples
    ///
    /// ```
    /// let bananas = "bananas";
    /// assert(bananas.contains("nana"));
    /// assert(!bananas.contains("apples"));
    /// assert(bananas.contains('s'));
    /// assert(bananas.contains(""));
    /// ```
    #[inline]
    pub fn contains<P: Pattern>(&self, pat: P) -> bool {
        pat.next_match(self, 0).is_some()
    }

    /// Returns the number of non-overlapping matches of a pattern in this
    /// string slice.
    ///
    /// The same as `self.matches(pat).count()` (see `str::matches`), a
    /// navi addition.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq("abcXXXabcYYYabc".matches_count("abc"), 3);
    /// assert_eq("aaaa".matches_count("aa"), 2);
    /// assert_eq("1abc2".matches_count(|c: char| c.is_numeric()), 2);
    /// assert_eq("abc".matches_count('x'), 0);
    /// ```
    pub fn matches_count<P: Pattern>(&self, pat: P) -> usize {
        let mut n = 0;
        let mut pos = 0;
        while let Some((a, b)) = pat.next_match(self, pos) {
            n += 1;
            pos = if b > a { b } else { next_char(self, a) };
            if pos > self.len() {
                break;
            }
        }
        n
    }

    /// Parses this string slice into another type.
    ///
    /// `parse` can parse into any type that implements the
    /// [`FromStr`](crate::str::FromStr) trait. Because it is so general, the
    /// type often has to be given, either with a type annotation on the result
    /// or with the "turbofish" `::<>`.
    ///
    /// # Errors
    ///
    /// Returns `Err(F::Err)` if the string cannot be parsed into the type
    /// (the error type of `F`'s `FromStr` impl, such as [`ParseIntError`]).
    ///
    /// # Examples
    ///
    /// ```
    /// let four: u32 = "4".parse().unwrap();
    /// assert_eq(four, 4);
    ///
    /// let four = "4".parse::<u32>();
    /// assert_eq(four, Ok(4));
    ///
    /// let nope = "j".parse::<u32>();
    /// assert(nope.is_err());
    ///
    /// assert_eq("-1.5".parse::<f64>(), Ok(-1.5));
    /// assert_eq("true".parse::<bool>(), Ok(true));
    /// ```
    #[inline]
    pub fn parse<F: FromStr>(&self) -> Result<F, F::Err> {
        F::from_str(self)
    }
}

/// Parse a value from a string.
///
/// `FromStr`'s [`from_str`](FromStr::from_str) method is often used
/// implicitly, through `str::parse`. It is implemented for the integer
/// types, `f32`, `f64`, `bool` and [`String`], and can be implemented for
/// your own types.
///
/// # Examples
///
/// ```
/// use std::str::FromStr;
///
/// #[derive(Debug, PartialEq)]
/// struct Point { x: i32, y: i32 }
///
/// #[derive(Debug, PartialEq)]
/// struct ParsePointError;
///
/// impl FromStr for Point {
///     type Err = ParsePointError;
///     fn from_str(s: &str) -> Result<Point, ParsePointError> {
///         let (x, y) = s
///             .strip_prefix('(')
///             .and_then(|s: &str| -> Option<&str> { s.strip_suffix(')') })
///             .and_then(|s: &str| -> Option<(&str, &str)> { s.split_once(',') })
///             .ok_or(ParsePointError)?;
///         let x = x.parse::<i32>().map_err(|_e: std::str::ParseIntError| -> ParsePointError { ParsePointError })?;
///         let y = y.parse::<i32>().map_err(|_e: std::str::ParseIntError| -> ParsePointError { ParsePointError })?;
///         Ok(Point { x, y })
///     }
/// }
///
/// assert_eq(Point::from_str("(1,2)"), Ok(Point { x: 1, y: 2 }));
/// assert_eq("(1,2)".parse::<Point>(), Ok(Point { x: 1, y: 2 }));
/// assert(Point::from_str("(1 2)").is_err());
/// ```
pub trait FromStr {
    /// The associated error which can be returned from parsing.
    type Err;
    /// Parses a string `s` to return a value of this type.
    ///
    /// # Errors
    ///
    /// Returns `Err(Self::Err)` if the string is not a valid
    /// representation of a value of this type.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::str::FromStr;
    ///
    /// let s = "5";
    /// let x = i32::from_str(s).unwrap();
    /// assert_eq(5, x);
    /// assert(i32::from_str("five").is_err());
    /// ```
    fn from_str(s: &str) -> Result<Self, Self::Err>;
}

/// The error returned when parsing an integer fails.
///
/// This error is the `Err` of the [`FromStr`](crate::str::FromStr) impls of the
/// integer types (and of their `from_str_radix`). Unlike Rust's, it has no
/// `kind`: an empty string, a bad digit and an out-of-range value all give the
/// same error, which displays as "invalid digit found in string".
///
/// # Examples
///
/// ```
/// use std::str::ParseIntError;
///
/// assert_eq("12a".parse::<i32>(), Err(ParseIntError));
/// assert_eq("256".parse::<u8>(), Err(ParseIntError));
/// assert_eq("".parse::<u8>(), Err(ParseIntError));
///
/// let e = "x".parse::<i32>().unwrap_err();
/// assert_eq(e.to_string(), "invalid digit found in string");
/// ```
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct ParseIntError;

impl crate::fmt::Display for ParseIntError {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        f.pad("invalid digit found in string")
    }
}

/// Parses an optionally signed integer in the given radix, returning the
/// sign (`true` if negative) and the magnitude.
///
/// The string is an optional `+` (or `-` if `signed`) followed by one or
/// more digits of the radix (`0`-`9`, then `a`-`z` or `A`-`Z`). Returns
/// `None` if it is empty, has a bad digit, or the magnitude overflows
/// `u64`. This is the helper behind the integer types' `from_str_radix`.
///
/// # Examples
///
/// ```
/// use std::str::parse_radix;
///
/// assert_eq(parse_radix("-ff", 16, true), Some((true, 255)));
/// assert_eq(parse_radix("+101", 2, false), Some((false, 5)));
/// assert_eq(parse_radix("-1", 10, false), None);
/// assert_eq(parse_radix("12", 2, false), None);
/// assert_eq(parse_radix("", 10, true), None);
/// ```
pub fn parse_radix(s: &str, radix: u32, signed: bool) -> Option<(bool, u64)> {
    let b = s.as_bytes();
    if b.len() == 0 {
        return None;
    }
    let mut i = 0;
    let mut neg = false;
    if b[0] == b'-' || b[0] == b'+' {
        neg = b[0] == b'-';
        if neg && !signed {
            return None;
        }
        i = 1;
        if b.len() == 1 {
            return None;
        }
    }
    let r = radix as u64;
    let mut v: u64 = 0;
    while i < b.len() {
        let c = b[i];
        let d = if c >= b'0' && c <= b'9' {
            (c - b'0') as u64
        } else if c >= b'a' && c <= b'z' {
            (c - b'a') as u64 + 10
        } else if c >= b'A' && c <= b'Z' {
            (c - b'A') as u64 + 10
        } else {
            return None;
        };
        if d >= r {
            return None;
        }
        let (m, o1) = v.overflowing_mul(r);
        let (a, o2) = m.overflowing_add(d);
        if o1 || o2 {
            return None;
        }
        v = a;
        i += 1;
    }
    Some((neg, v))
}

impl FromStr for i8 {
    type Err = ParseIntError;
    fn from_str(s: &str) -> Result<i8, ParseIntError> {
        i8::from_str_radix(s, 10)
    }
}

impl FromStr for i16 {
    type Err = ParseIntError;
    fn from_str(s: &str) -> Result<i16, ParseIntError> {
        i16::from_str_radix(s, 10)
    }
}

impl FromStr for i32 {
    type Err = ParseIntError;
    fn from_str(s: &str) -> Result<i32, ParseIntError> {
        i32::from_str_radix(s, 10)
    }
}

impl FromStr for i64 {
    type Err = ParseIntError;
    fn from_str(s: &str) -> Result<i64, ParseIntError> {
        i64::from_str_radix(s, 10)
    }
}

impl FromStr for isize {
    type Err = ParseIntError;
    fn from_str(s: &str) -> Result<isize, ParseIntError> {
        isize::from_str_radix(s, 10)
    }
}

impl FromStr for u8 {
    type Err = ParseIntError;
    fn from_str(s: &str) -> Result<u8, ParseIntError> {
        u8::from_str_radix(s, 10)
    }
}

impl FromStr for u16 {
    type Err = ParseIntError;
    fn from_str(s: &str) -> Result<u16, ParseIntError> {
        u16::from_str_radix(s, 10)
    }
}

impl FromStr for u32 {
    type Err = ParseIntError;
    fn from_str(s: &str) -> Result<u32, ParseIntError> {
        u32::from_str_radix(s, 10)
    }
}

impl FromStr for u64 {
    type Err = ParseIntError;
    fn from_str(s: &str) -> Result<u64, ParseIntError> {
        u64::from_str_radix(s, 10)
    }
}

impl FromStr for usize {
    type Err = ParseIntError;
    fn from_str(s: &str) -> Result<usize, ParseIntError> {
        usize::from_str_radix(s, 10)
    }
}

/// The error returned when parsing a float fails.
///
/// This error is the `Err` of the [`FromStr`](crate::str::FromStr) impls of
/// `f32` and `f64`. It displays as "invalid float literal".
///
/// # Examples
///
/// ```
/// use std::str::ParseFloatError;
///
/// assert_eq("3.25".parse::<f64>(), Ok(3.25));
/// assert_eq("1e3".parse::<f32>(), Ok(1000.0));
/// assert_eq("x1.0".parse::<f64>(), Err(ParseFloatError));
/// ```
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct ParseFloatError;

impl crate::fmt::Display for ParseFloatError {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        f.pad("invalid float literal")
    }
}

impl FromStr for f64 {
    type Err = ParseFloatError;
    fn from_str(s: &str) -> Result<f64, ParseFloatError> {
        match crate::rt::float::parse(s) {
            Some(v) => Ok(v),
            None => Err(ParseFloatError),
        }
    }
}

impl FromStr for f32 {
    type Err = ParseFloatError;
    fn from_str(s: &str) -> Result<f32, ParseFloatError> {
        match crate::rt::float::parse(s) {
            Some(v) => Ok(v as f32),
            None => Err(ParseFloatError),
        }
    }
}

impl FromStr for bool {
    type Err = ParseBoolError;
    fn from_str(s: &str) -> Result<bool, ParseBoolError> {
        if s == "true" {
            Ok(true)
        } else if s == "false" {
            Ok(false)
        } else {
            Err(ParseBoolError)
        }
    }
}

/// The error returned when parsing a `bool` fails.
///
/// `bool`'s [`FromStr`](crate::str::FromStr) accepts exactly `"true"` and
/// `"false"`.
///
/// # Examples
///
/// ```
/// use std::str::ParseBoolError;
///
/// assert_eq("true".parse::<bool>(), Ok(true));
/// assert_eq("false".parse::<bool>(), Ok(false));
/// assert_eq("yes".parse::<bool>(), Err(ParseBoolError));
/// assert_eq("True".parse::<bool>(), Err(ParseBoolError));
/// ```
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct ParseBoolError;

// Helpers for the compiler's builtin impls on str.

/// Compares two strings lexicographically by their bytes; the compiler's
/// builtin `Ord` for `str` uses it.
///
/// # Examples
///
/// ```
/// use std::cmp::Ordering;
/// use std::str::str_cmp;
///
/// assert_eq(str_cmp("abc", "abd"), Ordering::Less);
/// assert_eq(str_cmp("ab", "a"), Ordering::Greater);
/// assert_eq(str_cmp("a", "a"), Ordering::Equal);
/// ```
#[inline]
pub fn str_cmp(a: &str, b: &str) -> crate::cmp::Ordering {
    crate::slice::cmp_slices(a.as_bytes(), b.as_bytes())
}

/// Feeds a string into a [`Hasher`](crate::hash::Hasher); the compiler's
/// builtin `Hash` for `str` uses it.
///
/// It writes the bytes followed by a `0xFF` byte, so that `("ab", "c")`
/// and `("a", "bc")` hash differently.
///
/// # Examples
///
/// ```
/// use std::hash::{DefaultHasher, Hash, Hasher};
///
/// let mut a = DefaultHasher::new();
/// std::str::str_hash("hello", &mut a);
/// let mut b = DefaultHasher::new();
/// "hello".hash(&mut b);
/// assert_eq(a.finish(), b.finish());
/// ```
pub fn str_hash<H: crate::hash::Hasher>(s: &str, state: &mut H) {
    state.write(s.as_bytes());
    state.write(crate::rt::slice_from_raw(&255u8 as *const u8, 1));
}

/// Returns the substring of the bytes `start..end`; the compiler uses it
/// for indexing a `str` with a range (`&s[a..b]`).
///
/// # Panics
///
/// Panics if `start > end` or `end > s.len()`. The indices are not
/// checked to be on `char` boundaries.
///
/// # Examples
///
/// ```
/// assert_eq(std::str::str_index_range("hello", 1, 3), "el");
/// assert_eq(&"hello"[1..3], "el");
/// ```
#[track_caller]
pub fn str_index_range(s: &str, start: usize, end: usize) -> &str {
    let b = crate::slice::index_range(s.as_bytes(), start, end);
    crate::rt::str_from_raw(b.as_ptr(), b.len())
}

// ---------------------------------------------------------------------------

// The byte index of the start of the character before i.
fn prev_char(s: &str, i: usize) -> usize {
    let b = s.as_bytes();
    let mut j = i - 1;
    while j > 0 && b[j] & 0xC0 == 0x80 {
        j -= 1;
    }
    j
}

impl pattern::Pattern for &[char] {
    fn next_match(&self, hay: &str, from: usize) -> Option<(usize, usize)> {
        for (i, c) in hay[from..].char_indices() {
            if self.contains(&c) {
                return Some((from + i, from + i + c.len_utf8()));
            }
        }
        None
    }

    fn last_match(&self, hay: &str) -> Option<(usize, usize)> {
        let mut end = hay.len();
        while end > 0 {
            let i = prev_char(hay, end);
            let c = hay[i..end].chars().next().unwrap();
            if self.contains(&c) {
                return Some((i, end));
            }
            end = i;
        }
        None
    }

    fn prefix_len(&self, hay: &str) -> Option<usize> {
        match hay.chars().next() {
            Some(c) => {
                if self.contains(&c) {
                    Some(c.len_utf8())
                } else {
                    None
                }
            }
            None => None,
        }
    }

    fn suffix_len(&self, hay: &str) -> Option<usize> {
        match hay.chars().next_back() {
            Some(c) => {
                if self.contains(&c) {
                    Some(c.len_utf8())
                } else {
                    None
                }
            }
            None => None,
        }
    }
}

/// An iterator over the substrings of a string separated by a pattern,
/// from the end.
///
/// This struct is created by `str::rsplit`.
///
/// # Examples
///
/// ```
/// let mut parts = "a,b".rsplit(',');
/// assert_eq(parts.next(), Some("b"));
/// assert_eq(parts.next(), Some("a"));
/// assert_eq(parts.next(), None);
/// ```
pub struct RSplit<P: Pattern> {
    rest: &str,
    pat: P,
    done: bool,
}

impl<P: Pattern> Iterator for RSplit<P> {
    type Item = &str;
    fn next(&mut self) -> Option<&str> {
        if self.done {
            return None;
        }
        match self.pat.last_match(self.rest) {
            Some((a, b)) => {
                let tail = &self.rest[b..];
                // An empty match still moves back by one character.
                self.rest = if b > a {
                    &self.rest[0..a]
                } else if a > 0 {
                    &self.rest[0..prev_char(self.rest, a)]
                } else {
                    self.done = true;
                    ""
                };
                Some(tail)
            }
            None => {
                self.done = true;
                Some(self.rest)
            }
        }
    }
}

/// An iterator over at most a given number of substrings of a string
/// separated by a pattern, from the end; the last one is the rest of the
/// string.
///
/// This struct is created by `str::rsplitn`.
///
/// # Examples
///
/// ```
/// let mut parts = "a=b=c".rsplitn(2, '=');
/// assert_eq(parts.next(), Some("c"));
/// assert_eq(parts.next(), Some("a=b"));
/// assert_eq(parts.next(), None);
/// ```
pub struct RSplitN<P: Pattern> {
    it: RSplit<P>,
    left: usize,
}

impl<P: Pattern> Iterator for RSplitN<P> {
    type Item = &str;
    fn next(&mut self) -> Option<&str> {
        if self.left == 0 {
            return None;
        }
        self.left -= 1;
        if self.left == 0 {
            if self.it.done {
                return None;
            }
            self.it.done = true;
            return Some(self.it.rest);
        }
        self.it.next()
    }
}

/// An iterator over the substrings of a string separated by a pattern,
/// without a trailing empty substring.
///
/// This struct is created by `str::split_terminator`.
///
/// # Examples
///
/// ```
/// let v: Vec<&str> = "a;b;".split_terminator(';').collect();
/// assert_eq(v, ["a", "b"]);
/// ```
pub struct SplitTerminator<P: Pattern> {
    it: Split<P>,
    peeked: Option<&str>,
}

impl<P: Pattern> Iterator for SplitTerminator<P> {
    type Item = &str;
    fn next(&mut self) -> Option<&str> {
        let cur = match self.peeked.take() {
            Some(s) => s,
            None => self.it.next()?,
        };
        match self.it.next() {
            Some(n) => {
                self.peeked = Some(n);
                Some(cur)
            }
            None => {
                if cur.is_empty() {
                    None
                } else {
                    Some(cur)
                }
            }
        }
    }
}

/// An iterator over the substrings of a string each ending with a match
/// of a pattern (the match is kept).
///
/// This struct is created by `str::split_inclusive`.
///
/// # Examples
///
/// ```
/// let v: Vec<&str> = "a\nb\nc".split_inclusive('\n').collect();
/// assert_eq(v, ["a\n", "b\n", "c"]);
/// ```
pub struct SplitInclusive<P: Pattern> {
    rest: &str,
    pat: P,
}

impl<P: Pattern> Iterator for SplitInclusive<P> {
    type Item = &str;
    fn next(&mut self) -> Option<&str> {
        if self.rest.is_empty() {
            return None;
        }
        let end = match self.pat.next_match(self.rest, 0) {
            Some((a, b)) => {
                if b > 0 {
                    b
                } else {
                    next_char(self.rest, a)
                }
            }
            None => self.rest.len(),
        };
        let end = if end > self.rest.len() {
            self.rest.len()
        } else {
            end
        };
        let head = &self.rest[0..end];
        self.rest = &self.rest[end..];
        Some(head)
    }
}

/// An iterator over the non-overlapping matches of a pattern in a string,
/// with their byte positions.
///
/// This struct is created by `str::match_indices`.
///
/// # Examples
///
/// ```
/// let v: Vec<(usize, &str)> = "a1b22".match_indices(|c: char| c.is_numeric()).collect();
/// assert_eq(v, [(1, "1"), (3, "2"), (4, "2")]);
/// ```
pub struct MatchIndices<P: Pattern> {
    s: &str,
    pat: P,
    pos: usize,
}

impl<P: Pattern> Iterator for MatchIndices<P> {
    type Item = (usize, &str);
    fn next(&mut self) -> Option<(usize, &str)> {
        if self.pos > self.s.len() {
            return None;
        }
        let (a, b) = self.pat.next_match(self.s, self.pos)?;
        self.pos = if b > a { b } else { next_char(self.s, a) };
        Some((a, &self.s[a..b]))
    }
}

/// An iterator over the non-overlapping matches of a pattern in a string.
///
/// This struct is created by `str::matches`.
///
/// # Examples
///
/// ```
/// let mut it = "1a2".matches(|c: char| c.is_numeric());
/// assert_eq(it.next(), Some("1"));
/// assert_eq(it.next(), Some("2"));
/// assert_eq(it.next(), None);
/// ```
pub struct Matches<P: Pattern> {
    it: MatchIndices<P>,
}

impl<P: Pattern> Iterator for Matches<P> {
    type Item = &str;
    fn next(&mut self) -> Option<&str> {
        match self.it.next() {
            Some((_, m)) => Some(m),
            None => None,
        }
    }
}

/// An iterator over the non-overlapping matches of a pattern in a string,
/// with their byte positions, from the end.
///
/// This struct is created by `str::rmatch_indices`.
///
/// # Examples
///
/// ```
/// let v: Vec<(usize, &str)> = "abab".rmatch_indices("ab").collect();
/// assert_eq(v, [(2, "ab"), (0, "ab")]);
/// ```
pub struct RMatchIndices<P: Pattern> {
    s: &str,
    pat: P,
    done: bool,
}

impl<P: Pattern> Iterator for RMatchIndices<P> {
    type Item = (usize, &str);
    fn next(&mut self) -> Option<(usize, &str)> {
        if self.done {
            return None;
        }
        let (a, b) = match self.pat.last_match(self.s) {
            Some(m) => m,
            None => {
                self.done = true;
                return None;
            }
        };
        let m = &self.s[a..b];
        if b > a {
            self.s = &self.s[0..a];
        } else if a > 0 {
            self.s = &self.s[0..prev_char(self.s, a)];
        } else {
            self.done = true;
        }
        Some((a, m))
    }
}

/// An iterator over the words of a string separated by ASCII whitespace.
///
/// This struct is created by `str::split_ascii_whitespace`.
///
/// # Examples
///
/// ```
/// let v: Vec<&str> = " a  b\tc ".split_ascii_whitespace().collect();
/// assert_eq(v, ["a", "b", "c"]);
/// ```
pub struct SplitAsciiWhitespace {
    it: SplitWhitespace,
}

impl Iterator for SplitAsciiWhitespace {
    type Item = &str;
    fn next(&mut self) -> Option<&str> {
        self.it.next()
    }
}

impl Chars {
    /// Views the underlying data as a subslice of the original data: the
    /// part of the string not yet iterated.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut chars = "abc".chars();
    /// assert_eq(chars.as_str(), "abc");
    /// chars.next();
    /// assert_eq(chars.as_str(), "bc");
    /// chars.next_back();
    /// assert_eq(chars.as_str(), "b");
    /// ```
    #[inline]
    pub fn as_str(&self) -> &str {
        crate::rt::str_from_raw(
            crate::rt::ptr_offset(self.bytes.as_ptr(), self.pos),
            self.end - self.pos,
        )
    }
}

impl Clone for Chars {
    fn clone(&self) -> Chars {
        Chars {
            bytes: self.bytes,
            pos: self.pos,
            end: self.end,
        }
    }
}

impl CharIndices {
    /// Views the underlying data as a subslice of the original data: the
    /// part of the string not yet iterated.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut it = "abc".char_indices();
    /// it.next();
    /// assert_eq(it.as_str(), "bc");
    /// ```
    #[inline]
    pub fn as_str(&self) -> &str {
        &self.s[self.pos..]
    }

    /// Returns the byte position of the next character, or the length of
    /// the string if there are no more characters.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut it = "añb".char_indices();
    /// assert_eq(it.offset(), 0);
    /// it.next();
    /// assert_eq(it.offset(), 1);
    /// it.next();
    /// assert_eq(it.offset(), 3);
    /// it.next();
    /// assert_eq(it.offset(), 4);
    /// ```
    #[inline]
    pub fn offset(&self) -> usize {
        self.pos
    }
}

impl DoubleEndedIterator for CharIndices {
    fn next_back(&mut self) -> Option<(usize, char)> {
        if self.pos >= self.s.len() {
            return None;
        }
        let n = self.s.len();
        let i = prev_char(self.s, n);
        let c = self.s[i..n].chars().next().unwrap();
        self.s = &self.s[0..i];
        Some((i, c))
    }
}

impl Clone for CharIndices {
    fn clone(&self) -> CharIndices {
        CharIndices {
            s: self.s,
            pos: self.pos,
        }
    }
}

impl DoubleEndedIterator for Bytes {
    fn next_back(&mut self) -> Option<u8> {
        if self.pos < self.bytes.len() {
            let n = self.bytes.len() - 1;
            let b = self.bytes[n];
            self.bytes = &self.bytes[0..n];
            Some(b)
        } else {
            None
        }
    }
}

impl ExactSizeIterator for Bytes {}
impl Clone for Bytes {
    fn clone(&self) -> Bytes {
        Bytes {
            bytes: self.bytes,
            pos: self.pos,
        }
    }
}

impl str {
    /// Returns an iterator over the substrings of this string slice,
    /// separated by matches of a pattern, in reverse order.
    ///
    /// It yields the same substrings as `str::split`, last first.
    ///
    /// # Examples
    ///
    /// ```
    /// let v: Vec<&str> = "Mary had a little lamb".rsplit(' ').collect();
    /// assert_eq(v, ["lamb", "little", "a", "had", "Mary"]);
    ///
    /// let v: Vec<&str> = "lionXXtigerXleopard".rsplit('X').collect();
    /// assert_eq(v, ["leopard", "tiger", "", "lion"]);
    ///
    /// let v: Vec<&str> = "lion::tiger::leopard".rsplit("::").collect();
    /// assert_eq(v, ["leopard", "tiger", "lion"]);
    /// ```
    #[inline]
    pub fn rsplit<P: Pattern>(&self, pat: P) -> RSplit<P> {
        RSplit {
            rest: self,
            pat,
            done: false,
        }
    }

    /// Returns an iterator over at most `n` substrings of this string
    /// slice, separated by a pattern, starting from the end of the string.
    ///
    /// The last substring returned is the rest of the string (its
    /// beginning). With `n` 0 the iterator is empty.
    ///
    /// # Examples
    ///
    /// ```
    /// let v: Vec<&str> = "Mary had a little lamb".rsplitn(3, ' ').collect();
    /// assert_eq(v, ["lamb", "little", "Mary had a"]);
    ///
    /// let v: Vec<&str> = "lionXXtigerXleopard".rsplitn(3, 'X').collect();
    /// assert_eq(v, ["leopard", "tiger", "lionX"]);
    ///
    /// let v: Vec<&str> = "lion::tiger::leopard".rsplitn(2, "::").collect();
    /// assert_eq(v, ["leopard", "lion::tiger"]);
    /// ```
    #[inline]
    pub fn rsplitn<P: Pattern>(&self, n: usize, pat: P) -> RSplitN<P> {
        RSplitN {
            it: self.rsplit(pat),
            left: n,
        }
    }

    /// Returns an iterator over the substrings of this string slice,
    /// separated by a pattern, without a trailing empty substring.
    ///
    /// Equivalent to `str::split`, except that if the string ends with a
    /// match (as in a list of terminated items), the empty substring after
    /// it is skipped.
    ///
    /// # Examples
    ///
    /// ```
    /// let v: Vec<&str> = "A.B.".split_terminator('.').collect();
    /// assert_eq(v, ["A", "B"]);
    ///
    /// let v: Vec<&str> = "A..B..".split_terminator(".").collect();
    /// assert_eq(v, ["A", "", "B", ""]);
    ///
    /// let v: Vec<&str> = "A.B:C.D".split_terminator(['.', ':']).collect();
    /// assert_eq(v, ["A", "B", "C", "D"]);
    /// ```
    #[inline]
    pub fn split_terminator<P: Pattern>(&self, pat: P) -> SplitTerminator<P> {
        SplitTerminator {
            it: self.split(pat),
            peeked: None,
        }
    }

    /// Returns an iterator over the substrings of this string slice, each
    /// ending with a match of a pattern.
    ///
    /// Differs from `str::split` in that the matched part is kept, as
    /// the end of each substring. A match at the end of the string gives no
    /// empty substring after it.
    ///
    /// # Examples
    ///
    /// ```
    /// let v: Vec<&str> = "Mary had a little lamb\nlittle lamb\nlittle lamb.\n"
    ///     .split_inclusive('\n')
    ///     .collect();
    /// assert_eq(v, ["Mary had a little lamb\n", "little lamb\n", "little lamb.\n"]);
    ///
    /// let v: Vec<&str> = "a1b2c".split_inclusive(|c: char| c.is_numeric()).collect();
    /// assert_eq(v, ["a1", "b2", "c"]);
    /// ```
    #[inline]
    pub fn split_inclusive<P: Pattern>(&self, pat: P) -> SplitInclusive<P> {
        SplitInclusive { rest: self, pat }
    }

    /// Returns an iterator over the words of a string slice, separated by
    /// ASCII whitespace.
    ///
    /// In navi this is the same as `str::split_whitespace` (which also
    /// splits only on ASCII space, tab, newline and carriage return); note
    /// that, unlike Rust's, form feed does not separate words.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut iter = " Mary   had\ta little  \n\t lamb".split_ascii_whitespace();
    /// assert_eq(Some("Mary"), iter.next());
    /// assert_eq(Some("had"), iter.next());
    /// assert_eq(Some("a"), iter.next());
    /// assert_eq(Some("little"), iter.next());
    /// assert_eq(Some("lamb"), iter.next());
    /// assert_eq(None, iter.next());
    /// ```
    #[inline]
    pub fn split_ascii_whitespace(&self) -> SplitAsciiWhitespace {
        SplitAsciiWhitespace {
            it: self.split_whitespace(),
        }
    }

    /// Returns an iterator over the non-overlapping matches of a pattern
    /// within this string slice.
    ///
    /// To only count them, see `str::matches_count`.
    ///
    /// # Examples
    ///
    /// ```
    /// let v: Vec<&str> = "abcXXXabcYYYabc".matches("abc").collect();
    /// assert_eq(v, ["abc", "abc", "abc"]);
    ///
    /// let v: Vec<&str> = "1abc2abc3".matches(|c: char| c.is_numeric()).collect();
    /// assert_eq(v, ["1", "2", "3"]);
    /// ```
    #[inline]
    pub fn matches<P: Pattern>(&self, pat: P) -> Matches<P> {
        Matches {
            it: self.match_indices(pat),
        }
    }

    /// Returns an iterator over the non-overlapping matches of a pattern
    /// within this string slice, with the byte index where each starts.
    ///
    /// When matches overlap, only the first one of them is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// let v: Vec<(usize, &str)> = "abcXXXabcYYYabc".match_indices("abc").collect();
    /// assert_eq(v, [(0, "abc"), (6, "abc"), (12, "abc")]);
    ///
    /// let v: Vec<(usize, &str)> = "1abcabc2".match_indices("abc").collect();
    /// assert_eq(v, [(1, "abc"), (4, "abc")]);
    ///
    /// let v: Vec<(usize, &str)> = "ababa".match_indices("aba").collect();
    /// assert_eq(v, [(0, "aba")]); // only the first `aba`
    /// ```
    #[inline]
    pub fn match_indices<P: Pattern>(&self, pat: P) -> MatchIndices<P> {
        MatchIndices {
            s: self,
            pat,
            pos: 0,
        }
    }

    /// Returns an iterator over the non-overlapping matches of a pattern
    /// within this string slice, with their byte indices, in reverse order.
    ///
    /// When matches overlap, only the last one of them is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// let v: Vec<(usize, &str)> = "abcXXXabcYYYabc".rmatch_indices("abc").collect();
    /// assert_eq(v, [(12, "abc"), (6, "abc"), (0, "abc")]);
    ///
    /// let v: Vec<(usize, &str)> = "ababa".rmatch_indices("aba").collect();
    /// assert_eq(v, [(2, "aba")]); // only the last `aba`
    /// ```
    #[inline]
    pub fn rmatch_indices<P: Pattern>(&self, pat: P) -> RMatchIndices<P> {
        RMatchIndices {
            s: self,
            pat,
            done: false,
        }
    }

    /// Returns a string slice with all prefixes and suffixes that match a
    /// pattern repeatedly removed.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq("11foo1bar11".trim_matches('1'), "foo1bar");
    /// assert_eq("123foo1bar123".trim_matches(|c: char| c.is_numeric()), "foo1bar");
    /// assert_eq("1foo1barXX".trim_matches(['1', 'X']), "foo1bar");
    /// assert_eq("xyfooxyxy".trim_matches("xy"), "foo");
    /// ```
    #[inline]
    pub fn trim_matches<P: Pattern>(&self, pat: P) -> &str {
        self.trim_start_matches(pat).trim_end_matches(pat)
    }

    /// Replaces the first `count` matches of a pattern with another string.
    ///
    /// `replacen` creates a new [`String`] and copies the data from this
    /// string slice into it, replacing at most `count` matches of the
    /// pattern by `to`.
    ///
    /// # Examples
    ///
    /// ```
    /// let s = "foo foo 123 foo";
    /// assert_eq(s.replacen("foo", "new", 2), "new new 123 foo");
    /// assert_eq(s.replacen('o', "e", 3), "fee feo 123 foo");
    /// assert_eq("foo1bar2".replacen(|c: char| c.is_numeric(), "!", 1), "foo!bar2");
    ///
    /// // no match: the string is copied unchanged
    /// assert_eq("this is old".replacen("cookie monster", "little lamb", 10), "this is old");
    /// ```
    pub fn replacen<P: Pattern>(&self, pat: P, to: &str, count: usize) -> String {
        let mut out = String::with_capacity(self.len());
        let mut pos = 0;
        let mut n = 0;
        while n < count {
            match pat.next_match(self, pos) {
                Some((a, b)) => {
                    out.push_str(&self[pos..a]);
                    out.push_str(to);
                    n += 1;
                    if b == a {
                        if a >= self.len() {
                            return out;
                        }
                        let e = next_char(self, a);
                        out.push_str(&self[a..e]);
                        pos = e;
                    } else {
                        pos = b;
                    }
                }
                None => break,
            }
        }
        out.push_str(&self[pos..]);
        out
    }

    /// Returns a subslice of `str` for a range of byte indices.
    ///
    /// This is the non-panicking alternative to indexing the `str` with a
    /// range (`&s[a..b]`). Returns `None` whenever the range is out of
    /// bounds, reversed, or does not start and end on `char` boundaries.
    /// Unlike Rust's, it only takes ranges, not a single index.
    ///
    /// # Examples
    ///
    /// ```
    /// let v = "🗻∈🌏";
    /// assert_eq(v.get(0..4), Some("🗻"));
    /// assert_eq(v.get(4..), Some("∈🌏"));
    /// assert_eq(v.get(..=3), Some("🗻"));
    ///
    /// // indices not on UTF-8 sequence boundaries
    /// assert(v.get(1..).is_none());
    /// assert(v.get(..8).is_none());
    ///
    /// // out of bounds
    /// assert(v.get(..42).is_none());
    /// ```
    pub fn get<R: crate::ops::RangeBounds<usize>>(&self, range: R) -> Option<&str> {
        let n = self.len();
        let start = match range.start_bound() {
            crate::ops::Bound::Included(s) => *s,
            crate::ops::Bound::Excluded(s) => *s + 1,
            crate::ops::Bound::Unbounded => 0,
        };
        let end = match range.end_bound() {
            crate::ops::Bound::Included(e) => *e + 1,
            crate::ops::Bound::Excluded(e) => *e,
            crate::ops::Bound::Unbounded => n,
        };
        if start > end || end > n || !self.is_char_boundary(start) || !self.is_char_boundary(end) {
            return None;
        }
        Some(&self[start..end])
    }

    /// Divides one string slice into two at a byte index, returning `None`
    /// if the index is out of bounds or not on a `char` boundary.
    ///
    /// The first slice has the bytes `[0, mid)`, the second `[mid, len)`.
    ///
    /// # Examples
    ///
    /// ```
    /// let s = "Per Martin-Löf";
    /// assert_eq(s.split_at_checked(3), Some(("Per", " Martin-Löf")));
    ///
    /// assert_eq(s.split_at_checked(13), None); // inside “ö”
    /// assert_eq(s.split_at_checked(16), None); // beyond the string length
    /// ```
    pub fn split_at_checked(&self, mid: usize) -> Option<(&str, &str)> {
        if mid > self.len() || !self.is_char_boundary(mid) {
            return None;
        }
        Some((&self[0..mid], &self[mid..]))
    }

    /// Checks if all characters in this string are within the ASCII range.
    ///
    /// # Examples
    ///
    /// ```
    /// let ascii = "hello!\n";
    /// let non_ascii = "Grüße, Jürgen ❤";
    ///
    /// assert(ascii.is_ascii());
    /// assert(!non_ascii.is_ascii());
    /// ```
    #[inline]
    pub fn is_ascii(&self) -> bool {
        self.as_bytes().is_ascii()
    }

    /// Returns a copy of this string where each character is mapped to its
    /// ASCII upper case equivalent.
    ///
    /// ASCII letters `a` to `z` are mapped to `A` to `Z`; other characters
    /// are unchanged. To uppercase all letters, use `str::to_uppercase`.
    ///
    /// # Examples
    ///
    /// ```
    /// let s = "Grüße, Jürgen ❤";
    /// assert_eq(s.to_ascii_uppercase(), "GRüßE, JüRGEN ❤");
    /// ```
    pub fn to_ascii_uppercase(&self) -> String {
        let mut s = String::with_capacity(self.len());
        for c in self.chars() {
            s.push(c.to_ascii_uppercase());
        }
        s
    }

    /// Returns a copy of this string where each character is mapped to its
    /// ASCII lower case equivalent.
    ///
    /// ASCII letters `A` to `Z` are mapped to `a` to `z`; other characters
    /// are unchanged. To lowercase all letters, use `str::to_lowercase`.
    ///
    /// # Examples
    ///
    /// ```
    /// let s = "Grüße, Jürgen ❤";
    /// assert_eq(s.to_ascii_lowercase(), "grüße, jürgen ❤");
    /// ```
    pub fn to_ascii_lowercase(&self) -> String {
        let mut s = String::with_capacity(self.len());
        for c in self.chars() {
            s.push(c.to_ascii_lowercase());
        }
        s
    }

    /// Returns the uppercase equivalent of this string slice, as a new
    /// [`String`].
    ///
    /// Each character is mapped with `char::to_uppercase`, so one
    /// character may become several (`ß` becomes `SS`). As described there,
    /// navi only maps the Latin (ASCII, Latin-1, Extended-A, Extended
    /// Additional), Greek, Cyrillic, Armenian and fullwidth Latin letters;
    /// other characters are unchanged.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq("hello".to_uppercase(), "HELLO");
    /// assert_eq("tschüß".to_uppercase(), "TSCHÜSS");
    /// assert_eq("привет".to_uppercase(), "ПРИВЕТ");
    ///
    /// // characters without case are not changed
    /// assert_eq("农历新年".to_uppercase(), "农历新年");
    /// ```
    pub fn to_uppercase(&self) -> String {
        let mut s = String::with_capacity(self.len());
        for c in self.chars() {
            if (c as u32) < 128 {
                s.push(c.to_ascii_uppercase());
            } else {
                for u in c.to_uppercase() {
                    s.push(u);
                }
            }
        }
        s
    }

    /// Returns the lowercase equivalent of this string slice, as a new
    /// [`String`].
    ///
    /// Each character is mapped with `char::to_lowercase` (with the same
    /// coverage limits as `str::to_uppercase`), except that, as in Rust, a
    /// `Σ` at the end of a word becomes `ς` rather than `σ`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq("HELLO".to_lowercase(), "hello");
    /// assert_eq("ΣΑΣ".to_lowercase(), "σας");
    /// assert_eq("ΑΣ ΣΑ".to_lowercase(), "ας σα");
    ///
    /// // characters without case are not changed
    /// assert_eq("农历新年".to_lowercase(), "农历新年");
    /// ```
    pub fn to_lowercase(&self) -> String {
        let mut s = String::with_capacity(self.len());
        for (i, c) in self.char_indices() {
            if (c as u32) < 128 {
                s.push(c.to_ascii_lowercase());
            } else if c == 'Σ'
                && i > 0
                && self[0..i].chars().next_back().unwrap().is_alphabetic()
                && !self[i + 2..].starts_with(|d: char| d.is_alphabetic())
            {
                s.push('ς');
            } else {
                for l in c.to_lowercase() {
                    s.push(l);
                }
            }
        }
        s
    }

    /// Returns a string slice with leading ASCII whitespace removed.
    ///
    /// ASCII whitespace is space, tab, newline, form feed and carriage
    /// return (as `u8::is_ascii_whitespace`).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(" \t \u{3000}hello world\n".trim_ascii_start(), "\u{3000}hello world\n");
    /// assert_eq("  ".trim_ascii_start(), "");
    /// assert_eq("".trim_ascii_start(), "");
    /// ```
    pub fn trim_ascii_start(&self) -> &str {
        let b = self.as_bytes();
        let mut i = 0;
        while i < b.len() && b[i].is_ascii_whitespace() {
            i += 1;
        }
        &self[i..]
    }

    /// Returns a string slice with trailing ASCII whitespace removed.
    ///
    /// ASCII whitespace is space, tab, newline, form feed and carriage
    /// return (as `u8::is_ascii_whitespace`).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq("\r hello world\u{3000}\n ".trim_ascii_end(), "\r hello world\u{3000}");
    /// assert_eq("  ".trim_ascii_end(), "");
    /// assert_eq("".trim_ascii_end(), "");
    /// ```
    pub fn trim_ascii_end(&self) -> &str {
        let b = self.as_bytes();
        let mut n = b.len();
        while n > 0 && b[n - 1].is_ascii_whitespace() {
            n -= 1;
        }
        &self[0..n]
    }

    /// Returns a string slice with leading and trailing ASCII whitespace
    /// removed.
    ///
    /// ASCII whitespace is space, tab, newline, form feed and carriage
    /// return (as `u8::is_ascii_whitespace`).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq("\r hello world\n ".trim_ascii(), "hello world");
    /// assert_eq("  ".trim_ascii(), "");
    /// assert_eq("".trim_ascii(), "");
    /// ```
    #[inline]
    pub fn trim_ascii(&self) -> &str {
        self.trim_ascii_start().trim_ascii_end()
    }
}
