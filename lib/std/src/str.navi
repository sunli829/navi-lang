//! String slices. Methods on str itself are declared in an inherent impl on
//! the primitive type (only std may do that).

pub struct Chars { bytes: &[u8], pos: usize }
impl Iterator for Chars {
    type Item = char;
    fn next(&mut self) -> Option<char> { todo() }
}

pub struct Bytes { bytes: &[u8], pos: usize }
impl Iterator for Bytes {
    type Item = u8;
    fn next(&mut self) -> Option<u8> { todo() }
}

pub struct Split { rest: &str, sep: &str, done: bool }
impl Iterator for Split {
    type Item = &str;
    fn next(&mut self) -> Option<&str> { todo() }
}

pub struct SplitWhitespace { rest: &str }
impl Iterator for SplitWhitespace {
    type Item = &str;
    fn next(&mut self) -> Option<&str> { todo() }
}
