//! String slices. Methods on str itself are declared in an inherent impl on
//! the primitive type (only std may do that).

use crate::string::String;

pub struct Chars { bytes: &[u8], pos: usize, end: usize }
impl DoubleEndedIterator for Chars {
    fn next_back(&mut self) -> Option<char> {
        if self.end <= self.pos { return None; }
        let b = self.bytes;
        let mut i = self.end - 1;
        while i > self.pos && b[i] & 0xC0 == 0x80 { i -= 1; }
        let mut it = Chars { bytes: b, pos: i, end: self.end };
        let c = it.next();
        self.end = i;
        c
    }
}
impl Iterator for Chars {
    type Item = char;
    fn next(&mut self) -> Option<char> {
        let b = self.bytes;
        let n = self.end;
        if self.pos >= n { return None; }
        let c0 = b[self.pos] as u32;
        let (len, init) = if c0 < 0x80 {
            (1, c0)
        } else if c0 < 0xE0 {
            (2, c0 & 0x1F)
        } else if c0 < 0xF0 {
            (3, c0 & 0x0F)
        } else {
            (4, c0 & 0x07)
        };
        let mut c = init;
        let mut i = 1;
        while i < len {
            c = (c << 6) | (b[self.pos + i] as u32 & 0x3F);
            i += 1;
        }
        self.pos += len;
        Some(char_from_u32(c))
    }
}

fn char_from_u32(c: u32) -> char { unsafe { *(&c as *const u32 as *const char) } }

pub struct Bytes { bytes: &[u8], pos: usize }
impl Iterator for Bytes {
    type Item = u8;
    fn next(&mut self) -> Option<u8> {
        if self.pos < self.bytes.len() {
            let b = self.bytes[self.pos];
            self.pos += 1;
            Some(b)
        } else {
            None
        }
    }
}

pub struct Split<P: Pattern> { rest: &str, pat: P, done: bool }
impl<P: Pattern> Iterator for Split<P> {
    type Item = &str;
    fn next(&mut self) -> Option<&str> {
        if self.done { return None; }
        match self.pat.next_match(self.rest, 0) {
            Some((a, b)) => {
                let head = &self.rest[0..a];
                // An empty match still advances by one character.
                self.rest = if b > 0 { &self.rest[b..] } else { &self.rest[next_char(self.rest, 0)..] };
                Some(head)
            }
            None => {
                self.done = true;
                Some(self.rest)
            }
        }
    }
}

pub struct SplitN<P: Pattern> { it: Split<P>, left: usize }
impl<P: Pattern> Iterator for SplitN<P> {
    type Item = &str;
    fn next(&mut self) -> Option<&str> {
        if self.left == 0 { return None; }
        self.left -= 1;
        if self.left == 0 {
            if self.it.done { return None; }
            self.it.done = true;
            return Some(self.it.rest);
        }
        self.it.next()
    }
}

pub struct Lines { rest: &str }
impl Iterator for Lines {
    type Item = &str;
    fn next(&mut self) -> Option<&str> {
        if self.rest.is_empty() { return None; }
        let line = match self.rest.find('\n') {
            Some(i) => { let l = &self.rest[0..i]; self.rest = &self.rest[i + 1..]; l }
            None => { let l = self.rest; self.rest = ""; l }
        };
        Some(match line.strip_suffix('\r') { Some(l) => l, None => line })
    }
}

pub struct CharIndices { s: &str, pos: usize }
impl Iterator for CharIndices {
    type Item = (usize, char);
    fn next(&mut self) -> Option<(usize, char)> {
        if self.pos >= self.s.len() { return None; }
        let i = self.pos;
        let c = self.s[i..].chars().next().unwrap();
        self.pos += c.len_utf8();
        Some((i, c))
    }
}

// The byte index of the character after the one at i.
fn next_char(s: &str, i: usize) -> usize {
    let b = s.as_bytes();
    let mut j = i + 1;
    while j < b.len() && b[j] & 0xC0 == 0x80 { j += 1; }
    j
}

pub mod pattern {
    /// Something to search for in a string: a &str, a char or a predicate
    /// on chars (as in Rust's std::str::pattern).
    pub trait Pattern {
        /// The first match starting at or after from: (start, end).
        fn next_match(&self, hay: &str, from: usize) -> Option<(usize, usize)>;
        /// The last match.
        fn last_match(&self, hay: &str) -> Option<(usize, usize)>;
        /// The length of a match at the start of hay.
        fn prefix_len(&self, hay: &str) -> Option<usize>;
        /// The length of a match at the end of hay.
        fn suffix_len(&self, hay: &str) -> Option<usize>;
    }

    impl Pattern for &str {
        fn next_match(&self, hay: &str, from: usize) -> Option<(usize, usize)> {
            let n = hay.len();
            let m = self.len();
            let mut i = from;
            while i + m <= n {
                if &hay[i..i + m] == *self { return Some((i, i + m)); }
                i += 1;
            }
            None
        }
        fn last_match(&self, hay: &str) -> Option<(usize, usize)> {
            let n = hay.len();
            let m = self.len();
            if m > n { return None; }
            let mut i = n - m + 1;
            while i > 0 {
                i -= 1;
                if &hay[i..i + m] == *self { return Some((i, i + m)); }
            }
            None
        }
        fn prefix_len(&self, hay: &str) -> Option<usize> {
            if hay.len() >= self.len() && &hay[0..self.len()] == *self { Some(self.len()) } else { None }
        }
        fn suffix_len(&self, hay: &str) -> Option<usize> {
            let n = hay.len();
            if n >= self.len() && &hay[n - self.len()..] == *self { Some(self.len()) } else { None }
        }
    }

    impl Pattern for &String {
        fn next_match(&self, hay: &str, from: usize) -> Option<(usize, usize)> { self.as_str().next_match(hay, from) }
        fn last_match(&self, hay: &str) -> Option<(usize, usize)> { self.as_str().last_match(hay) }
        fn prefix_len(&self, hay: &str) -> Option<usize> { self.as_str().prefix_len(hay) }
        fn suffix_len(&self, hay: &str) -> Option<usize> { self.as_str().suffix_len(hay) }
    }

    impl Pattern for char {
        fn next_match(&self, hay: &str, from: usize) -> Option<(usize, usize)> {
            for (i, c) in hay[from..].char_indices() {
                if c == *self { return Some((from + i, from + i + c.len_utf8())); }
            }
            None
        }
        fn last_match(&self, hay: &str) -> Option<(usize, usize)> {
            let mut last = None;
            for (i, c) in hay.char_indices() {
                if c == *self { last = Some((i, i + c.len_utf8())); }
            }
            last
        }
        fn prefix_len(&self, hay: &str) -> Option<usize> {
            match hay.chars().next() { Some(c) => if c == *self { Some(c.len_utf8()) } else { None }, None => None }
        }
        fn suffix_len(&self, hay: &str) -> Option<usize> {
            let mut last = None;
            for (_, c) in hay.char_indices() { last = Some(c); }
            match last { Some(c) => if c == *self { Some(c.len_utf8()) } else { None }, None => None }
        }
    }

    impl Pattern for fn(char) -> bool {
        fn next_match(&self, hay: &str, from: usize) -> Option<(usize, usize)> {
            for (i, c) in hay[from..].char_indices() {
                if (*self)(c) { return Some((from + i, from + i + c.len_utf8())); }
            }
            None
        }
        fn last_match(&self, hay: &str) -> Option<(usize, usize)> {
            let mut last = None;
            for (i, c) in hay.char_indices() {
                if (*self)(c) { last = Some((i, i + c.len_utf8())); }
            }
            last
        }
        fn prefix_len(&self, hay: &str) -> Option<usize> {
            match hay.chars().next() { Some(c) => if (*self)(c) { Some(c.len_utf8()) } else { None }, None => None }
        }
        fn suffix_len(&self, hay: &str) -> Option<usize> {
            let mut last = None;
            for (_, c) in hay.char_indices() { last = Some(c); }
            match last { Some(c) => if (*self)(c) { Some(c.len_utf8()) } else { None }, None => None }
        }
    }
}

pub use self::pattern::Pattern;

pub struct SplitWhitespace { rest: &str }
impl Iterator for SplitWhitespace {
    type Item = &str;
    fn next(&mut self) -> Option<&str> {
        let s = self.rest.trim_start();
        if s.is_empty() {
            self.rest = s;
            return None;
        }
        let b = s.as_bytes();
        let mut i = 0;
        while i < b.len() && !is_space(b[i]) { i += 1; }
        self.rest = &s[i..];
        Some(&s[0..i])
    }
}

fn is_space(b: u8) -> bool { b == b' ' || b == b'\t' || b == b'\n' || b == b'\r' }

/// The length of the valid UTF-8 sequence at b[i], or 0 if invalid.
pub fn utf8_seq_len(b: &[u8], i: usize) -> usize {
    let c = b[i];
    let (n, min) = if c < 0x80 { return 1; } else if c & 0xE0 == 0xC0 { (2, 0x80) } else if c & 0xF0 == 0xE0 { (3, 0x800) } else if c & 0xF8 == 0xF0 { (4, 0x10000) } else { return 0; };
    if i + n > b.len() { return 0; }
    let mut v = (c as u32) & (0x7F >> n);
    let mut j = 1;
    while j < n {
        if b[i + j] & 0xC0 != 0x80 { return 0; }
        v = (v << 6) | (b[i + j] as u32 & 0x3F);
        j += 1;
    }
    if v < min || v > 0x10FFFF || (v >= 0xD800 && v <= 0xDFFF) { return 0; }
    n
}

/// Whether bytes are valid UTF-8.
pub fn utf8_valid(b: &[u8]) -> bool {
    let mut i = 0;
    while i < b.len() {
        let n = utf8_seq_len(b, i);
        if n == 0 { return false; }
        i += n;
    }
    true
}

/// Converts bytes to a str if they are valid UTF-8.
pub fn from_utf8(b: &[u8]) -> Result<&str, Utf8Error> {
    if utf8_valid(b) { Ok(crate::rt::str_from_raw(crate::rt::slice_ptr(b), b.len())) } else { Err(Utf8Error) }
}

/// Converts bytes to a str without checking.
pub unsafe fn from_utf8_unchecked(b: &[u8]) -> &str { crate::rt::str_from_raw(crate::rt::slice_ptr(b), b.len()) }

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct Utf8Error;

/// String equality, used by string literal patterns.
pub fn str_eq(a: &str, b: &str) -> bool { crate::slice::eq_slices(a.as_bytes(), b.as_bytes()) }

impl str {
    pub fn len(&self) -> usize { self.as_bytes().len() }
    pub fn is_empty(&self) -> bool { self.len() == 0 }
    pub fn as_bytes(&self) -> &[u8] { crate::rt::str_as_bytes(self) }
    pub fn as_ptr(&self) -> *const u8 { self.as_bytes().as_ptr() }
    pub fn chars(&self) -> Chars { Chars { bytes: self.as_bytes(), pos: 0, end: self.len() } }
    pub fn bytes(&self) -> Bytes { Bytes { bytes: self.as_bytes(), pos: 0 } }
    pub fn split<P: Pattern>(&self, pat: P) -> Split<P> { Split { rest: self, pat, done: false } }
    pub fn splitn<P: Pattern>(&self, n: usize, pat: P) -> SplitN<P> { SplitN { it: self.split(pat), left: n } }
    pub fn split_whitespace(&self) -> SplitWhitespace { SplitWhitespace { rest: self } }
    pub fn lines(&self) -> Lines { Lines { rest: self } }
    pub fn char_indices(&self) -> CharIndices { CharIndices { s: self, pos: 0 } }

    pub fn split_once<P: Pattern>(&self, pat: P) -> Option<(&str, &str)> {
        let (a, b) = pat.next_match(self, 0)?;
        Some((&self[0..a], &self[b..]))
    }

    pub fn rsplit_once<P: Pattern>(&self, pat: P) -> Option<(&str, &str)> {
        let (a, b) = pat.last_match(self)?;
        Some((&self[0..a], &self[b..]))
    }

    pub fn split_at(&self, mid: usize) -> (&str, &str) { (&self[0..mid], &self[mid..]) }

    pub fn strip_prefix<P: Pattern>(&self, pat: P) -> Option<&str> {
        let n = pat.prefix_len(self)?;
        Some(&self[n..])
    }

    pub fn strip_suffix<P: Pattern>(&self, pat: P) -> Option<&str> {
        let n = pat.suffix_len(self)?;
        Some(&self[0..self.len() - n])
    }

    pub fn trim_start_matches<P: Pattern>(&self, pat: P) -> &str {
        let mut s = self;
        loop {
            match pat.prefix_len(s) { Some(n) => { if n == 0 { return s; } s = &s[n..]; } None => return s }
        }
    }

    pub fn trim_end_matches<P: Pattern>(&self, pat: P) -> &str {
        let mut s = self;
        loop {
            match pat.suffix_len(s) { Some(n) => { if n == 0 { return s; } s = &s[0..s.len() - n]; } None => return s }
        }
    }

    pub fn trim_matches(&self, c: char) -> &str { self.trim_start_matches(c).trim_end_matches(c) }

    pub fn replace<P: Pattern>(&self, from: P, to: &str) -> String {
        let mut out = String::new();
        let mut pos = 0;
        loop {
            match from.next_match(self, pos) {
                Some((a, b)) => {
                    out.push_str(&self[pos..a]);
                    out.push_str(to);
                    if b == a {
                        if a >= self.len() { return out; }
                        let n = next_char(self, a);
                        out.push_str(&self[a..n]);
                        pos = n;
                    } else {
                        pos = b;
                    }
                }
                None => {
                    out.push_str(&self[pos..]);
                    return out;
                }
            }
        }
    }

    pub fn repeat(&self, n: usize) -> String {
        let mut out = String::new();
        let mut i = 0;
        while i < n { out.push_str(self); i += 1; }
        out
    }

    pub fn to_owned(&self) -> String { self.to_string() }
    pub fn into_string(&self) -> String { self.to_string() }

    pub fn is_char_boundary(&self, i: usize) -> bool {
        if i == 0 || i == self.len() { return true; }
        if i > self.len() { return false; }
        self.as_bytes()[i] & 0xC0 != 0x80
    }

    pub fn eq_ignore_ascii_case(&self, other: &str) -> bool {
        if self.len() != other.len() { return false; }
        let a = self.as_bytes();
        let b = other.as_bytes();
        let mut i = 0;
        while i < a.len() {
            if a[i].to_ascii_lowercase() != b[i].to_ascii_lowercase() { return false; }
            i += 1;
        }
        true
    }

    pub fn trim(&self) -> &str { self.trim_start().trim_end() }

    pub fn trim_start(&self) -> &str {
        let b = self.as_bytes();
        let mut i = 0;
        while i < b.len() && is_space(b[i]) { i += 1; }
        &self[i..]
    }

    pub fn trim_end(&self) -> &str {
        let b = self.as_bytes();
        let mut n = b.len();
        while n > 0 && is_space(b[n - 1]) { n -= 1; }
        &self[0..n]
    }

    pub fn starts_with<P: Pattern>(&self, pat: P) -> bool { pat.prefix_len(self).is_some() }
    pub fn ends_with<P: Pattern>(&self, pat: P) -> bool { pat.suffix_len(self).is_some() }

    pub fn find<P: Pattern>(&self, pat: P) -> Option<usize> {
        match pat.next_match(self, 0) { Some((a, _)) => Some(a), None => None }
    }

    pub fn rfind<P: Pattern>(&self, pat: P) -> Option<usize> {
        match pat.last_match(self) { Some((a, _)) => Some(a), None => None }
    }

    pub fn contains<P: Pattern>(&self, pat: P) -> bool { pat.next_match(self, 0).is_some() }

    pub fn matches_count<P: Pattern>(&self, pat: P) -> usize {
        let mut n = 0;
        let mut pos = 0;
        while let Some((a, b)) = pat.next_match(self, pos) {
            n += 1;
            pos = if b > a { b } else { next_char(self, a) };
            if pos > self.len() { break; }
        }
        n
    }

    pub fn to_uppercase(&self) -> String {
        let mut s = String::new();
        for c in self.chars() { s.push(c.to_ascii_uppercase()); }
        s
    }

    pub fn to_lowercase(&self) -> String {
        let mut s = String::new();
        for c in self.chars() { s.push(c.to_ascii_lowercase()); }
        s
    }

    pub fn parse<F: FromStr>(&self) -> Result<F, F::Err> { F::from_str(self) }
}

/// Parsing a value from a string, used by str::parse.
pub trait FromStr {
    type Err;
    fn from_str(s: &str) -> Result<Self, Self::Err>;
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct ParseIntError;

impl crate::fmt::Display for ParseIntError {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result { f.pad("invalid digit found in string") }
}

/// Parses an optionally signed integer in the given radix: the sign and
/// the magnitude (None on bad digits or u64 overflow).
pub fn parse_radix(s: &str, radix: u32, signed: bool) -> Option<(bool, u64)> {
    let b = s.as_bytes();
    if b.len() == 0 { return None; }
    let mut i = 0;
    let mut neg = false;
    if b[0] == b'-' || b[0] == b'+' {
        neg = b[0] == b'-';
        if neg && !signed { return None; }
        i = 1;
        if b.len() == 1 { return None; }
    }
    let r = radix as u64;
    let mut v: u64 = 0;
    while i < b.len() {
        let c = b[i];
        let d = if c >= b'0' && c <= b'9' {
            (c - b'0') as u64
        } else if c >= b'a' && c <= b'z' {
            (c - b'a') as u64 + 10
        } else if c >= b'A' && c <= b'Z' {
            (c - b'A') as u64 + 10
        } else {
            return None;
        };
        if d >= r { return None; }
        let (m, o1) = v.overflowing_mul(r);
        let (a, o2) = m.overflowing_add(d);
        if o1 || o2 { return None; }
        v = a;
        i += 1;
    }
    Some((neg, v))
}

impl FromStr for i8 { type Err = ParseIntError; fn from_str(s: &str) -> Result<i8, ParseIntError> { i8::from_str_radix(s, 10) } }
impl FromStr for i16 { type Err = ParseIntError; fn from_str(s: &str) -> Result<i16, ParseIntError> { i16::from_str_radix(s, 10) } }
impl FromStr for i32 { type Err = ParseIntError; fn from_str(s: &str) -> Result<i32, ParseIntError> { i32::from_str_radix(s, 10) } }
impl FromStr for i64 { type Err = ParseIntError; fn from_str(s: &str) -> Result<i64, ParseIntError> { i64::from_str_radix(s, 10) } }
impl FromStr for isize { type Err = ParseIntError; fn from_str(s: &str) -> Result<isize, ParseIntError> { isize::from_str_radix(s, 10) } }
impl FromStr for u8 { type Err = ParseIntError; fn from_str(s: &str) -> Result<u8, ParseIntError> { u8::from_str_radix(s, 10) } }
impl FromStr for u16 { type Err = ParseIntError; fn from_str(s: &str) -> Result<u16, ParseIntError> { u16::from_str_radix(s, 10) } }
impl FromStr for u32 { type Err = ParseIntError; fn from_str(s: &str) -> Result<u32, ParseIntError> { u32::from_str_radix(s, 10) } }
impl FromStr for u64 { type Err = ParseIntError; fn from_str(s: &str) -> Result<u64, ParseIntError> { u64::from_str_radix(s, 10) } }
impl FromStr for usize { type Err = ParseIntError; fn from_str(s: &str) -> Result<usize, ParseIntError> { usize::from_str_radix(s, 10) } }

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct ParseFloatError;

impl crate::fmt::Display for ParseFloatError {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result { f.pad("invalid float literal") }
}

impl FromStr for f64 {
    type Err = ParseFloatError;
    fn from_str(s: &str) -> Result<f64, ParseFloatError> {
        match crate::rt::float::parse(s) { Some(v) => Ok(v), None => Err(ParseFloatError) }
    }
}

impl FromStr for f32 {
    type Err = ParseFloatError;
    fn from_str(s: &str) -> Result<f32, ParseFloatError> {
        match crate::rt::float::parse(s) { Some(v) => Ok(v as f32), None => Err(ParseFloatError) }
    }
}

impl FromStr for bool {
    type Err = ParseBoolError;
    fn from_str(s: &str) -> Result<bool, ParseBoolError> {
        if s == "true" { Ok(true) } else if s == "false" { Ok(false) } else { Err(ParseBoolError) }
    }
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct ParseBoolError;

// Helpers for the compiler's builtin impls on str.

pub fn str_cmp(a: &str, b: &str) -> crate::cmp::Ordering { crate::slice::cmp_slices(a.as_bytes(), b.as_bytes()) }

pub fn str_hash<H: crate::hash::Hasher>(s: &str, state: &mut H) {
    state.write(s.as_bytes());
    state.write(crate::rt::slice_from_raw(&255u8 as *const u8, 1));
}

#[track_caller]
pub fn str_index_range(s: &str, start: usize, end: usize) -> &str {
    let b = crate::slice::index_range(s.as_bytes(), start, end);
    crate::rt::str_from_raw(b.as_ptr(), b.len())
}
