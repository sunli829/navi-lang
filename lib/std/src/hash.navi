//! Hashing.

#[cfg(feature = "navic")]
pub mod crc32;
#[cfg(feature = "navic")]
pub mod adler32;

pub trait Hasher {
    fn finish(&self) -> u64;
    fn write(&mut self, bytes: &[u8]);
    fn write_u8(&mut self, i: u8) { self.write(&i.to_le_bytes()); }
    fn write_u16(&mut self, i: u16) { self.write(&i.to_le_bytes()); }
    fn write_u32(&mut self, i: u32) { self.write(&i.to_le_bytes()); }
    fn write_u64(&mut self, i: u64) { self.write(&i.to_le_bytes()); }
    fn write_usize(&mut self, i: usize) { self.write(&i.to_le_bytes()); }
    fn write_i8(&mut self, i: i8) { self.write_u8(i as u8); }
    fn write_i16(&mut self, i: i16) { self.write_u16(i as u16); }
    fn write_i32(&mut self, i: i32) { self.write_u32(i as u32); }
    fn write_i64(&mut self, i: i64) { self.write_u64(i as u64); }
    fn write_isize(&mut self, i: isize) { self.write_usize(i as usize); }
}

pub trait Hash {
    fn hash<H: Hasher>(&self, state: &mut H);
}

/// The default hasher (FxHash: fast and good enough for compiler-style
/// keys; not DoS-resistant, unlike Rust's SipHash).
#[derive(Clone, Debug, Default)]
pub struct DefaultHasher { h: u64 }

impl DefaultHasher {
    pub fn new() -> DefaultHasher { DefaultHasher { h: 0 } }
}

impl Hasher for DefaultHasher {
    // FxHash leaves keys that differ only in high bits (such as id << 32)
    // equal in their low bits, which hash tables index with: mix them in
    // (murmur3's finalizer).
    fn finish(&self) -> u64 {
        let mut h = self.h;
        h = h ^ (h >> 33);
        h = crate::intrinsics::wrapping_mul(h, 0xff51afd7ed558ccd);
        h = h ^ (h >> 33);
        h = crate::intrinsics::wrapping_mul(h, 0xc4ceb9fe1a85ec53);
        h ^ (h >> 33)
    }
    // Integers (and bool, char) hash as one word (the compiler's Hash for
    // them calls this).
    fn write_u64(&mut self, i: u64) {
        let h = self.h;
        self.h = crate::intrinsics::wrapping_mul((h << 5 | h >> 59) ^ i, 0x51_7c_c1_b7_27_22_0a_95);
    }
    fn write(&mut self, bytes: &[u8]) {
        // FxHash over little-endian words, then the remaining bytes.
        let mut h = self.h;
        let mut i = 0;
        let n = bytes.len();
        let p = crate::rt::slice_ptr(bytes);
        while i + 8 <= n {
            let w = unsafe { *(p.add(i) as *const u64) };
            h = crate::intrinsics::wrapping_mul((h << 5 | h >> 59) ^ w, 0x51_7c_c1_b7_27_22_0a_95);
            i += 8;
        }
        while i < n {
            h = crate::intrinsics::wrapping_mul((h << 5 | h >> 59) ^ bytes[i] as u64, 0x51_7c_c1_b7_27_22_0a_95);
            i += 1;
        }
        self.h = h;
    }
}

/// Hashes a value with the default hasher.
pub fn hash_one<T: Hash>(v: &T) -> u64 {
    let mut h = DefaultHasher::new();
    v.hash(&mut h);
    h.finish()
}
