//! Generic hashing support.
//!
//! This module provides a generic way to compute the hash of a value.
//! Hashes are most commonly used with
//! [`HashMap`](crate::collections::HashMap) and
//! [`HashSet`](crate::collections::HashSet).
//!
//! The simplest way to make a type hashable is to use `#[derive(Hash)]`.
//! [`hash_one`] hashes a value with the [`DefaultHasher`].
//!
//! Unlike Rust's (SipHash, randomly seeded), the default hasher is FxHash
//! with a fixed seed: fast and deterministic, but not resistant to
//! hash-flooding attacks (see spec/std-diff.md). The checksums
//! [`crc32`] and [`adler32`] are here too.
//!
//! # Examples
//!
//! ```
//! use std::hash::{DefaultHasher, Hash, Hasher};
//!
//! #[derive(Hash)]
//! struct Person {
//!     id: u32,
//!     name: String,
//!     phone: u64,
//! }
//!
//! let person1 = Person { id: 5, name: "Janet".to_string(), phone: 555_666_7777 };
//! let person2 = Person { id: 5, name: "Bob".to_string(), phone: 555_666_7777 };
//!
//! assert(calculate_hash(&person1) != calculate_hash(&person2));
//!
//! fn calculate_hash<T: Hash>(t: &T) -> u64 {
//!     let mut s = DefaultHasher::new();
//!     t.hash(&mut s);
//!     s.finish()
//! }
//! ```
//!
//! If you need more control over how a value is hashed, you need to
//! implement the [`Hash`] trait:
//!
//! ```
//! use std::hash::{Hash, Hasher, hash_one};
//!
//! struct Person {
//!     id: u32,
//!     name: String,
//!     phone: u64,
//! }
//!
//! impl Hash for Person {
//!     fn hash<H: Hasher>(&self, state: &mut H) {
//!         self.id.hash(state);
//!         self.phone.hash(state);
//!     }
//! }
//!
//! let person1 = Person { id: 5, name: "Janet".to_string(), phone: 555_666_7777 };
//! let person2 = Person { id: 5, name: "Bob".to_string(), phone: 555_666_7777 };
//!
//! assert_eq(hash_one(&person1), hash_one(&person2));
//! ```

pub mod adler32;
pub mod crc32;

/// A trait for hashing an arbitrary stream of bytes.
///
/// Instances of `Hasher` usually represent state that is changed while
/// hashing data. `Hasher` provides a fairly basic interface for retrieving
/// the generated hash (with [`Hasher::finish`]), and writing integers as
/// well as slices of bytes into an instance (with [`Hasher::write`] and
/// [`Hasher::write_u8`] etc.). Most of the time, `Hasher` instances are
/// used in conjunction with the [`Hash`] trait.
///
/// Only `finish` and `write` must be written; the `write_*` methods for
/// integers default to writing the integer's little-endian bytes.
///
/// # Examples
///
/// ```
/// use std::hash::{DefaultHasher, Hasher};
///
/// let mut hasher = DefaultHasher::new();
///
/// hasher.write_u32(1989);
/// hasher.write_u8(11);
/// hasher.write_u8(9);
/// hasher.write(b"Huh?");
///
/// println(`Hash is ${hasher.finish():x}!`);
/// ```
///
/// A hasher of your own (here: FNV-1a):
///
/// ```
/// use std::hash::{Hash, Hasher};
///
/// struct Fnv(u64);
///
/// impl Hasher for Fnv {
///     fn finish(&self) -> u64 {
///         self.0
///     }
///     fn write(&mut self, bytes: &[u8]) {
///         for b in bytes {
///             self.0 = (self.0 ^ *b as u64).wrapping_mul(0x100000001b3);
///         }
///     }
/// }
///
/// let mut h = Fnv(0xcbf29ce484222325);
/// h.write(b"a");
/// assert_eq(h.finish(), 0xaf63dc4c8601ec8c);
/// ```
pub trait Hasher {
    /// Returns the hash value for the values written so far.
    ///
    /// Despite its name, the method does not reset the hasher's internal
    /// state. Additional writes will continue from the current value. If you
    /// need to start a fresh hash value, you will have to create a new hasher.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::hash::{DefaultHasher, Hasher};
    ///
    /// let mut hasher = DefaultHasher::new();
    /// hasher.write(b"Cool!");
    ///
    /// println(`Hash is ${hasher.finish():x}!`);
    /// ```
    fn finish(&self) -> u64;
    /// Writes some data into this `Hasher`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::hash::{DefaultHasher, Hasher};
    ///
    /// let mut hasher = DefaultHasher::new();
    /// let data = [0x01u8, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef];
    ///
    /// hasher.write(&data);
    ///
    /// println(`Hash is ${hasher.finish():x}!`);
    /// ```
    fn write(&mut self, bytes: &[u8]);
    /// Writes a single `u8` into this hasher.
    fn write_u8(&mut self, i: u8) {
        self.write(&i.to_le_bytes());
    }

    /// Writes a single `u16` into this hasher.
    fn write_u16(&mut self, i: u16) {
        self.write(&i.to_le_bytes());
    }

    /// Writes a single `u32` into this hasher.
    fn write_u32(&mut self, i: u32) {
        self.write(&i.to_le_bytes());
    }

    /// Writes a single `u64` into this hasher.
    fn write_u64(&mut self, i: u64) {
        self.write(&i.to_le_bytes());
    }

    /// Writes a single `usize` into this hasher.
    fn write_usize(&mut self, i: usize) {
        self.write(&i.to_le_bytes());
    }

    /// Writes a single `i8` into this hasher.
    fn write_i8(&mut self, i: i8) {
        self.write_u8(i as u8);
    }

    /// Writes a single `i16` into this hasher.
    fn write_i16(&mut self, i: i16) {
        self.write_u16(i as u16);
    }

    /// Writes a single `i32` into this hasher.
    fn write_i32(&mut self, i: i32) {
        self.write_u32(i as u32);
    }

    /// Writes a single `i64` into this hasher.
    fn write_i64(&mut self, i: i64) {
        self.write_u64(i as u64);
    }

    /// Writes a single `isize` into this hasher.
    fn write_isize(&mut self, i: isize) {
        self.write_usize(i as usize);
    }
}

/// A hashable type.
///
/// Types implementing `Hash` are able to be hashed with an instance of
/// [`Hasher`](crate::hash::Hasher).
///
/// ## Implementing `Hash`
///
/// You can derive `Hash` with `#[derive(Hash)]` if all fields implement
/// `Hash`. The resulting hash will be the combination of the values from
/// calling `hash` on each field.
///
/// If you need more control over how a value is hashed, you can of course
/// implement the `Hash` trait yourself, calling `hash` on the parts that
/// matter.
///
/// ## `Hash` and `Eq`
///
/// When implementing both `Hash` and [`Eq`], it is important that the
/// following property holds:
///
/// ```text
/// k1 == k2 -> hash(k1) == hash(k2)
/// ```
///
/// In other words, if two keys are equal, their hashes must also be equal.
/// [`HashMap`](crate::collections::HashMap) and
/// [`HashSet`](crate::collections::HashSet) both rely on this behavior.
///
/// Thankfully, you won't need to worry about upholding this property when
/// deriving both [`Eq`] and `Hash` with `#[derive(PartialEq, Eq, Hash)]`.
///
/// # Examples
///
/// ```
/// use std::collections::HashMap;
///
/// #[derive(PartialEq, Eq, Hash, Debug)]
/// struct Point {
///     x: i32,
///     y: i32,
/// }
///
/// let mut names = HashMap::new();
/// names.insert(Point { x: 1, y: 2 }, "a");
/// assert_eq(names.get(&Point { x: 1, y: 2 }), Some(&"a"));
/// ```
pub trait Hash {
    /// Feeds this value into the given [`Hasher`](crate::hash::Hasher).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::hash::{DefaultHasher, Hash, Hasher};
    ///
    /// let mut hasher = DefaultHasher::new();
    /// 7920.hash(&mut hasher);
    /// println(`Hash is ${hasher.finish():x}!`);
    /// ```
    fn hash<H: Hasher>(&self, state: &mut H);
}

/// The default [`Hasher`](crate::hash::Hasher) used by
/// [`HashMap`](crate::collections::HashMap) and [`hash_one`].
///
/// It is FxHash, with a finalizing mix of the bits (murmur3's): fast and
/// good enough for compiler-style keys. Unlike Rust's SipHash it is not
/// seeded randomly and not resistant to hash flooding, so hashes are the
/// same from run to run.
///
/// # Examples
///
/// ```
/// use std::hash::{DefaultHasher, Hash, Hasher};
///
/// let mut a = DefaultHasher::new();
/// "hello".hash(&mut a);
/// let mut b = DefaultHasher::new();
/// "hello".hash(&mut b);
/// assert_eq(a.finish(), b.finish());
/// ```
#[derive(Clone, Debug, Default)]
pub struct DefaultHasher {
    h: u64,
}

impl DefaultHasher {
    /// Creates a new `DefaultHasher`.
    ///
    /// All `DefaultHasher` instances made by `new` are the same: the same
    /// input gives the same hash.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::hash::{DefaultHasher, Hasher};
    ///
    /// let mut h = DefaultHasher::new();
    /// h.write_u32(1);
    /// let first = h.finish();
    /// let mut h = DefaultHasher::new();
    /// h.write_u32(1);
    /// assert_eq(h.finish(), first);
    /// ```
    pub fn new() -> DefaultHasher {
        DefaultHasher { h: 0 }
    }
}

impl Hasher for DefaultHasher {
    // FxHash leaves keys that differ only in high bits (such as id << 32)
    // equal in their low bits, which hash tables index with: mix them in
    // (murmur3's finalizer).
    fn finish(&self) -> u64 {
        let mut h = self.h;
        h = h ^ (h >> 33);
        h = crate::intrinsics::wrapping_mul(h, 0xff51afd7ed558ccd);
        h = h ^ (h >> 33);
        h = crate::intrinsics::wrapping_mul(h, 0xc4ceb9fe1a85ec53);
        h ^ (h >> 33)
    }
    // Integers (and bool, char) hash as one word (the compiler's Hash for
    // them calls this).
    fn write_u64(&mut self, i: u64) {
        let h = self.h;
        self.h = crate::intrinsics::wrapping_mul((h << 5 | h >> 59) ^ i, 0x51_7c_c1_b7_27_22_0a_95);
    }

    fn write(&mut self, bytes: &[u8]) {
        // FxHash over little-endian words, then the remaining bytes.
        let mut h = self.h;
        let mut i = 0;
        let n = bytes.len();
        let p = crate::rt::slice_ptr(bytes);
        while i + 8 <= n {
            let w = unsafe { *(p.add(i) as *const u64) };
            h = crate::intrinsics::wrapping_mul((h << 5 | h >> 59) ^ w, 0x51_7c_c1_b7_27_22_0a_95);
            i += 8;
        }
        while i < n {
            h = crate::intrinsics::wrapping_mul(
                (h << 5 | h >> 59) ^ bytes[i] as u64,
                0x51_7c_c1_b7_27_22_0a_95,
            );
            i += 1;
        }
        self.h = h;
    }
}

/// Hashes a value with the [`DefaultHasher`]: the same as
/// `v.hash(&mut h); h.finish()` with a new hasher `h`.
///
/// Rust has this as `BuildHasher::hash_one`; navi has no `BuildHasher`,
/// so it is a function.
///
/// # Examples
///
/// ```
/// use std::hash::hash_one;
///
/// assert_eq(hash_one(&"abc"), hash_one(&"abc".to_string().as_str()));
/// assert_ne(hash_one(&1), hash_one(&2));
/// ```
pub fn hash_one<T: Hash>(v: &T) -> u64 {
    let mut h = DefaultHasher::new();
    v.hash(&mut h);
    h.finish()
}
