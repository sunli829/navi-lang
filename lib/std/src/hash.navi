//! Hashing.

pub trait Hasher {
    fn finish(&self) -> u64;
    fn write(&mut self, bytes: &[u8]);
}

pub trait Hash {
    fn hash<H: Hasher>(&self, state: &mut H);
}

/// The default hasher (FxHash: fast and good enough for compiler-style
/// keys; not DoS-resistant, unlike Rust's SipHash).
#[derive(Clone, Debug, Default)]
pub struct DefaultHasher { h: u64 }

impl DefaultHasher {
    pub fn new() -> DefaultHasher { DefaultHasher { h: 0 } }
}

impl Hasher for DefaultHasher {
    fn finish(&self) -> u64 { self.h }
    fn write(&mut self, bytes: &[u8]) {
        // FxHash over little-endian words, then the remaining bytes.
        let mut h = self.h;
        let mut i = 0;
        let n = bytes.len();
        let p = crate::rt::slice_ptr(bytes);
        while i + 8 <= n {
            let w = unsafe { *(p.add(i) as *const u64) };
            h = crate::intrinsics::wrapping_mul((h << 5 | h >> 59) ^ w, 0x51_7c_c1_b7_27_22_0a_95);
            i += 8;
        }
        while i < n {
            h = crate::intrinsics::wrapping_mul((h << 5 | h >> 59) ^ bytes[i] as u64, 0x51_7c_c1_b7_27_22_0a_95);
            i += 1;
        }
        self.h = h;
    }
}

/// Hashes a value with the default hasher.
pub fn hash_one<T: Hash>(v: &T) -> u64 {
    let mut h = DefaultHasher::new();
    v.hash(&mut h);
    h.finish()
}
