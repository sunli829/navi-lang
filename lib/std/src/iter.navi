impl StepChecked for char {
    fn checked_succ(&self) -> Option<char> {
        let c = *self as u32;
        if c == 0xD7FF {
            char::from_u32(0xE000)
        } else {
            char::from_u32(c + 1)
        }
    }

    fn checked_pred(&self) -> Option<char> {
        let c = *self as u32;
        if c == 0 {
            None
        } else if c == 0xE000 {
            char::from_u32(0xD7FF)
        } else {
            char::from_u32(c - 1)
        }
    }

    fn steps_between(start: &char, end: &char) -> (usize, Option<usize>) {
        let (a, b) = (*start as u32, *end as u32);
        if b <= a {
            return (0, Some(0));
        }
        // (Less the surrogates between.)
        let mut d = b - a;
        if a <= 0xD7FF && b >= 0xE000 {
            d -= 0x800;
        }
        (d as usize, Some(d as usize))
    }
}

// The last value taken leaves start past end: by moving start on, or (at
// the type's maximum) end back.
impl<A> Iterator for crate::ops::RangeInclusive<A>
where
    A: Step + StepChecked,
{
    type Item = A;

    fn size_hint(&self) -> (usize, Option<usize>) {
        if self.end < self.start {
            return (0, Some(0));
        }
        let (lo, hi) = A::steps_between(&self.start, &self.end);
        (
            lo.saturating_add(1),
            match hi {
                Some(h) => h.checked_add(1),
                None => None,
            },
        )
    }

    fn next(&mut self) -> Option<A> {
        if self.start < self.end {
            let n = self.start.clone();
            self.start = n.checked_succ().unwrap();
            Some(n)
        } else if self.start == self.end {
            let n = self.start.clone();
            match n.checked_succ() {
                Some(s) => self.start = s,
                None => self.end = self.end.checked_pred().unwrap(),
            }
            Some(n)
        } else {
            None
        }
    }
}

impl<A> DoubleEndedIterator for crate::ops::RangeInclusive<A>
where
    A: Step + StepChecked,
{
    fn next_back(&mut self) -> Option<A> {
        if self.start < self.end {
            let n = self.end.clone();
            self.end = n.checked_pred().unwrap();
            Some(n)
        } else if self.start == self.end {
            let n = self.end.clone();
            match n.checked_pred() {
                Some(p) => self.end = p,
                None => self.start = self.start.checked_succ().unwrap(),
            }
            Some(n)
        } else {
            None
        }
    }
}

impl<A: Step> Iterator for crate::ops::RangeFrom<A> {
    type Item = A;
    fn next(&mut self) -> Option<A> {
        let n = self.start.clone();
        self.start = Step::forward(n.clone(), 1);
        Some(n)
    }
}

// ---------------------------------------------------------------------------

/// An iterator that flattens one level of nesting in an iterator of things
/// that can be turned into iterators.
///
/// This struct is created by the [`Iterator::flatten`] method. See its
/// documentation for more. Unlike Rust's `Flatten<I>`, it has the item
/// type of `I` as a second type parameter `U`, and it is not double-ended.
pub struct Flatten<I, U: IntoIterator> {
    iter: I,
    inner: Option<U::IntoIter>,
}

impl<I, U> Iterator for Flatten<I, U>
where
    I: Iterator<Item = U>,
    U: IntoIterator,
{
    type Item = U::Item;
    fn next(&mut self) -> Option<U::Item> {
        loop {
            if let Some(inner) = &mut self.inner {
                if let Some(x) = inner.next() {
                    return Some(x);
                }
            }
            match self.iter.next() {
                Some(x) => {
                    self.inner = Some(x.into_iter());
                }
                None => return None,
            }
        }
    }
}

/// An iterator that repeats endlessly.
///
/// This struct is created by the [`Iterator::cycle`] method. See its
/// documentation for more.
pub struct Cycle<I> {
    orig: I,
    iter: I,
}

impl<I> Iterator for Cycle<I>
where
    I: Iterator + Clone,
{
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        match self.iter.next() {
            Some(x) => Some(x),
            None => {
                self.iter = self.orig.clone();
                self.iter.next()
            }
        }
    }
}

/// An iterator to maintain state while iterating another iterator.
///
/// This struct is created by the [`Iterator::scan`] method. See its
/// documentation for more.
pub struct Scan<I: Iterator, St, B> {
    iter: I,
    f: fn(&mut St, I::Item) -> Option<B>,
    state: St,
}

impl<I: Iterator, St, B> Iterator for Scan<I, St, B> {
    type Item = B;
    fn next(&mut self) -> Option<B> {
        let x = self.iter.next()?;
        (self.f)(&mut self.state, x)
    }
}

/// An iterator that only accepts elements while `f` returns `Some(_)`.
///
/// This struct is created by the [`Iterator::map_while`] method. See its
/// documentation for more.
pub struct MapWhile<I: Iterator, B> {
    iter: I,
    f: fn(I::Item) -> Option<B>,
    done: bool,
}

impl<I: Iterator, B> Iterator for MapWhile<I, B> {
    type Item = B;
    fn next(&mut self) -> Option<B> {
        if self.done {
            return None;
        }
        let x = self.iter.next()?;
        match (self.f)(x) {
            Some(y) => Some(y),
            None => {
                self.done = true;
                None
            }
        }
    }
}

/// An iterator that yields `None` forever after the underlying iterator
/// yields `None` once.
///
/// This struct is created by [`Iterator::fuse`]. See its documentation for
/// more.
pub struct Fuse<I> {
    iter: I,
    done: bool,
}

impl<I: Iterator> Iterator for Fuse<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        if self.done {
            return None;
        }
        match self.iter.next() {
            Some(x) => Some(x),
            None => {
                self.done = true;
                None
            }
        }
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        if self.done {
            (0, Some(0))
        } else {
            self.iter.size_hint()
        }
    }
}

impl<I: DoubleEndedIterator> DoubleEndedIterator for Fuse<I> {
    fn next_back(&mut self) -> Option<I::Item> {
        if self.done {
            return None;
        }
        match self.iter.next_back() {
            Some(x) => Some(x),
            None => {
                self.done = true;
                None
            }
        }
    }
}

/// An iterator that clones the elements of an underlying iterator.
///
/// This struct is created by the [`Iterator::cloned`] method. See its
/// documentation for more. Unlike Rust's `Cloned<I>`, it has the type the
/// items refer to as a second type parameter `T` (the items are `&T`).
pub struct Cloned<I, T> {
    iter: I,
    marker: Option<&T>,
}

impl<T, I> Iterator for Cloned<I, T>
where
    T: Clone,
    I: Iterator<Item = &T>,
{
    type Item = T;
    fn next(&mut self) -> Option<T> {
        match self.iter.next() {
            Some(x) => Some(x.clone()),
            None => None,
        }
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        self.iter.size_hint()
    }
}

impl<T, I> DoubleEndedIterator for Cloned<I, T>
where
    T: Clone,
    I: DoubleEndedIterator<Item = &T>,
{
    fn next_back(&mut self) -> Option<T> {
        match self.iter.next_back() {
            Some(x) => Some(x.clone()),
            None => None,
        }
    }
}

/// An iterator that copies the elements of an underlying iterator.
///
/// This struct is created by the [`Iterator::copied`] method. See its
/// documentation for more. Unlike Rust's `Copied<I>`, it has the type the
/// items refer to as a second type parameter `T` (the items are `&T`).
pub struct Copied<I, T> {
    iter: I,
    marker: Option<&T>,
}

impl<T, I> Iterator for Copied<I, T>
where
    I: Iterator<Item = &T>,
{
    type Item = T;
    fn next(&mut self) -> Option<T> {
        match self.iter.next() {
            Some(x) => Some(*x),
            None => None,
        }
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        self.iter.size_hint()
    }
}

impl<T, I> DoubleEndedIterator for Copied<I, T>
where
    I: DoubleEndedIterator<Item = &T>,
{
    fn next_back(&mut self) -> Option<T> {
        match self.iter.next_back() {
            Some(x) => Some(*x),
            None => None,
        }
    }
}

// Double-ended adapters.

impl<I: DoubleEndedIterator, B> DoubleEndedIterator for Map<I, B> {
    fn next_back(&mut self) -> Option<B> {
        match self.iter.next_back() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
}

impl<I: DoubleEndedIterator> DoubleEndedIterator for Filter<I> {
    fn next_back(&mut self) -> Option<I::Item> {
        while let Some(x) = self.iter.next_back() {
            if (self.pred)(&x) {
                return Some(x);
            }
        }
        None
    }
}

impl<I: DoubleEndedIterator, B> DoubleEndedIterator for FilterMap<I, B> {
    fn next_back(&mut self) -> Option<B> {
        while let Some(x) = self.iter.next_back() {
            if let Some(y) = (self.f)(x) {
                return Some(y);
            }
        }
        None
    }
}

impl<I: DoubleEndedIterator> DoubleEndedIterator for Inspect<I> {
    fn next_back(&mut self) -> Option<I::Item> {
        let x = self.iter.next_back()?;
        (self.f)(&x);
        Some(x)
    }
}

impl<I> DoubleEndedIterator for Enumerate<I>
where
    I: DoubleEndedIterator + ExactSizeIterator,
{
    fn next_back(&mut self) -> Option<(usize, I::Item)> {
        let n = self.iter.len();
        let x = self.iter.next_back()?;
        Some((self.count + n - 1, x))
    }
}

impl<A, B> DoubleEndedIterator for Chain<A, B>
where
    A: DoubleEndedIterator,
    B: DoubleEndedIterator<Item = A::Item>,
{
    fn next_back(&mut self) -> Option<A::Item> {
        match self.b.next_back() {
            Some(x) => Some(x),
            None => self.a.next_back(),
        }
    }
}

impl<A, B> DoubleEndedIterator for Zip<A, B>
where
    A: DoubleEndedIterator + ExactSizeIterator,
    B: DoubleEndedIterator + ExactSizeIterator,
{
    fn next_back(&mut self) -> Option<(A::Item, B::Item)> {
        let mut al = self.a.len();
        let mut bl = self.b.len();
        while al > bl {
            self.a.next_back();
            al -= 1;
        }
        while bl > al {
            self.b.next_back();
            bl -= 1;
        }
        let x = self.a.next_back()?;
        let y = self.b.next_back()?;
        Some((x, y))
    }
}

impl<I> DoubleEndedIterator for Take<I>
where
    I: DoubleEndedIterator + ExactSizeIterator,
{
    fn next_back(&mut self) -> Option<I::Item> {
        if self.n == 0 {
            return None;
        }
        let mut len = self.iter.len();
        while len > self.n {
            self.iter.next_back();
            len -= 1;
        }
        let x = self.iter.next_back()?;
        self.n -= 1;
        Some(x)
    }
}

impl<I> DoubleEndedIterator for Skip<I>
where
    I: DoubleEndedIterator + ExactSizeIterator,
{
    fn next_back(&mut self) -> Option<I::Item> {
        if self.iter.len() > self.n {
            self.iter.next_back()
        } else {
            None
        }
    }
}

impl<T> DoubleEndedIterator for Once<T> {
    fn next_back(&mut self) -> Option<T> {
        self.v.take()
    }
}

impl<T> DoubleEndedIterator for Empty<T> {
    fn next_back(&mut self) -> Option<T> {
        None
    }
}

// Exact sizes.

impl<I: ExactSizeIterator, B> ExactSizeIterator for Map<I, B> {}
impl<I: ExactSizeIterator> ExactSizeIterator for Enumerate<I> {}
impl<I> ExactSizeIterator for Rev<I> where I: ExactSizeIterator + DoubleEndedIterator {}

impl<A: ExactSizeIterator, B: ExactSizeIterator> ExactSizeIterator for Zip<A, B> {}
impl<I: ExactSizeIterator> ExactSizeIterator for Take<I> {}
impl<I: ExactSizeIterator> ExactSizeIterator for Skip<I> {}
impl<I: ExactSizeIterator> ExactSizeIterator for Inspect<I> {}
impl<I: ExactSizeIterator> ExactSizeIterator for Fuse<I> {}
impl<T, I> ExactSizeIterator for Cloned<I, T>
where
    T: Clone,
    I: ExactSizeIterator<Item = &T>,
{
}

impl<T, I> ExactSizeIterator for Copied<I, T> where I: ExactSizeIterator<Item = &T> {}

impl<T> ExactSizeIterator for Once<T> {}

// Clones (cycle needs them).

impl<I, B> Clone for Map<I, B>
where
    I: Iterator + Clone,
{
    fn clone(&self) -> Map<I, B> {
        Map {
            iter: self.iter.clone(),
            f: self.f,
        }
    }
}

impl<I> Clone for Filter<I>
where
    I: Iterator + Clone,
{
    fn clone(&self) -> Filter<I> {
        Filter {
            iter: self.iter.clone(),
            pred: self.pred,
        }
    }
}

impl<I, B> Clone for FilterMap<I, B>
where
    I: Iterator + Clone,
{
    fn clone(&self) -> FilterMap<I, B> {
        FilterMap {
            iter: self.iter.clone(),
            f: self.f,
        }
    }
}

impl<I: Clone> Clone for Enumerate<I> {
    fn clone(&self) -> Enumerate<I> {
        Enumerate {
            iter: self.iter.clone(),
            count: self.count,
        }
    }
}

impl<I: Clone> Clone for Take<I> {
    fn clone(&self) -> Take<I> {
        Take {
            iter: self.iter.clone(),
            n: self.n,
        }
    }
}

impl<I: Clone> Clone for Skip<I> {
    fn clone(&self) -> Skip<I> {
        Skip {
            iter: self.iter.clone(),
            n: self.n,
        }
    }
}

impl<I: Clone> Clone for Rev<I> {
    fn clone(&self) -> Rev<I> {
        Rev {
            iter: self.iter.clone(),
        }
    }
}

impl<A: Clone, B: Clone> Clone for Zip<A, B> {
    fn clone(&self) -> Zip<A, B> {
        Zip {
            a: self.a.clone(),
            b: self.b.clone(),
        }
    }
}

impl<A: Clone, B: Clone> Clone for Chain<A, B> {
    fn clone(&self) -> Chain<A, B> {
        Chain {
            a: self.a.clone(),
            b: self.b.clone(),
            first: self.first,
        }
    }
}

impl<I: Clone> Clone for StepBy<I> {
    fn clone(&self) -> StepBy<I> {
        StepBy {
            iter: self.iter.clone(),
            step: self.step,
            first: self.first,
        }
    }
}

impl<I: Clone, T> Clone for Cloned<I, T> {
    fn clone(&self) -> Cloned<I, T> {
        Cloned {
            iter: self.iter.clone(),
            marker: None,
        }
    }
}

impl<I: Clone, T> Clone for Copied<I, T> {
    fn clone(&self) -> Copied<I, T> {
        Copied {
            iter: self.iter.clone(),
            marker: None,
        }
    }
}

impl<I: Clone> Clone for Fuse<I> {
    fn clone(&self) -> Fuse<I> {
        Fuse {
            iter: self.iter.clone(),
            done: self.done,
        }
    }
}

impl<T: Clone> Clone for Once<T> {
    fn clone(&self) -> Once<T> {
        Once { v: self.v.clone() }
    }
}

// More of Peekable.

impl<I: Iterator> Peekable<I> {
    /// Returns a mutable reference to the [`Iterator::next`] value without
    /// advancing the iterator.
    ///
    /// Like `next`, if there is a value, it is wrapped in a `Some(T)`. But if
    /// the iteration is over, `None` is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut iter = Vec::from([1, 2, 3]).into_iter().peekable();
    ///
    /// // Like with `peek()`, we can see into the future without advancing the
    /// // iterator.
    /// assert_eq(iter.peek_mut(), Some(&mut 1));
    /// assert_eq(iter.next(), Some(1));
    ///
    /// // Peek into the iterator and set the value behind the mutable reference.
    /// if let Some(p) = iter.peek_mut() {
    ///     assert_eq(*p, 2);
    ///     *p = 5;
    /// }
    ///
    /// // The value we put in reappears as the iterator continues.
    /// let rest: Vec<i32> = iter.collect();
    /// assert_eq(rest, Vec::from([5, 3]));
    /// ```
    pub fn peek_mut(&mut self) -> Option<&mut I::Item> {
        if self.peeked.is_none() {
            self.peeked = Some(self.iter.next());
        }
        match &mut self.peeked {
            Some(Some(v)) => Some(v),
            _ => None,
        }
    }

    /// Consumes and returns the next value of this iterator if a condition is
    /// true.
    ///
    /// If `func` returns `true` for the next value of this iterator, it is
    /// consumed and returned. Otherwise, `None` is returned, and the value is
    /// kept to be returned by the next call.
    ///
    /// # Examples
    ///
    /// Consume a number if it's equal to 0.
    ///
    /// ```
    /// let mut iter = (0..5).peekable();
    /// // The first item of the iterator is 0; consume it.
    /// assert_eq(iter.next_if(|x| *x == 0), Some(0));
    /// // The next item returned is now 1, so `next_if` will return `None`.
    /// assert_eq(iter.next_if(|x| *x == 0), None);
    /// // `next_if` retains the next item if the predicate evaluates to `false`
    /// // for it.
    /// assert_eq(iter.next(), Some(1));
    /// ```
    ///
    /// Consume any number less than 10.
    ///
    /// ```
    /// let mut iter = (1..20).peekable();
    /// // Consume all numbers less than 10
    /// while iter.next_if(|x| *x < 10).is_some() {}
    /// // The next value returned will be 10
    /// assert_eq(iter.next(), Some(10));
    /// ```
    pub fn next_if(&mut self, func: fn(&I::Item) -> bool) -> Option<I::Item> {
        let x = match self.peeked.take() {
            Some(v) => v,
            None => self.iter.next(),
        };
        match x {
            Some(v) => {
                if func(&v) {
                    return Some(v);
                }
                self.peeked = Some(Some(v));
                None
            }
            None => {
                self.peeked = Some(None);
                None
            }
        }
    }

    /// Consumes and returns the next item if it is equal to `expected`.
    ///
    /// # Examples
    ///
    /// Consume a number if it's equal to 0.
    ///
    /// ```
    /// let mut iter = (0..5).peekable();
    /// // The first item of the iterator is 0; consume it.
    /// assert_eq(iter.next_if_eq(&0), Some(0));
    /// // The next item returned is now 1, so `next_if_eq` will return `None`.
    /// assert_eq(iter.next_if_eq(&0), None);
    /// // `next_if_eq` retains the next item if it was not equal to `expected`.
    /// assert_eq(iter.next(), Some(1));
    /// ```
    pub fn next_if_eq<T>(&mut self, expected: &T) -> Option<I::Item>
    where
        I::Item: PartialEq<T>,
    {
        let x = match self.peeked.take() {
            Some(v) => v,
            None => self.iter.next(),
        };
        match x {
            Some(v) => {
                if v == *expected {
                    return Some(v);
                }
                self.peeked = Some(Some(v));
                None
            }
            None => {
                self.peeked = Some(None);
                None
            }
        }
    }
}

// Ranges.

impl ExactSizeIterator for crate::ops::Range<usize> {
    fn len(&self) -> usize {
        if self.end > self.start {
            self.end - self.start
        } else {
            0
        }
    }
}

impl ExactSizeIterator for crate::ops::Range<u8> {
    fn len(&self) -> usize {
        if self.end > self.start {
            (self.end - self.start) as usize
        } else {
            0
        }
    }
}

impl ExactSizeIterator for crate::ops::Range<u16> {
    fn len(&self) -> usize {
        if self.end > self.start {
            (self.end - self.start) as usize
        } else {
            0
        }
    }
}

