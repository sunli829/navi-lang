// Sums and products of the other number types.

impl Sum for i8 {
    fn sum<I: Iterator<Item = i8>>(iter: I) -> i8 {
        iter.fold(0, |a, b| a + b)
    }
}

impl Sum for i16 {
    fn sum<I: Iterator<Item = i16>>(iter: I) -> i16 {
        iter.fold(0, |a, b| a + b)
    }
}

impl Sum for isize {
    fn sum<I: Iterator<Item = isize>>(iter: I) -> isize {
        iter.fold(0, |a, b| a + b)
    }
}

impl Sum for u8 {
    fn sum<I: Iterator<Item = u8>>(iter: I) -> u8 {
        iter.fold(0, |a, b| a + b)
    }
}

impl Sum for u16 {
    fn sum<I: Iterator<Item = u16>>(iter: I) -> u16 {
        iter.fold(0, |a, b| a + b)
    }
