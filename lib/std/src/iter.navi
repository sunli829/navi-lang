        iter.fold(0.0, |a, b| a + *b)
    }
}
impl Product for i8 {
    fn product<I: Iterator<Item = i8>>(iter: I) -> i8 {
        iter.fold(1, |a, b| a * b)
    }
}
impl Product for i16 {
