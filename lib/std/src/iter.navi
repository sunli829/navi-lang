// More of Peekable.

#[cfg(feature = "navic")]
impl<I: Iterator> Peekable<I> {
    pub fn peek_mut(&mut self) -> Option<&mut I::Item> {
        if self.peeked.is_none() {
            self.peeked = Some(self.iter.next());
        }
        match &mut self.peeked {
            Some(Some(v)) => Some(v),
            _ => None,
        }
    }

    /// The next item if func accepts it.
    pub fn next_if(&mut self, func: fn(&I::Item) -> bool) -> Option<I::Item> {
        let x = match self.peeked.take() { Some(v) => v, None => self.iter.next() };
        match x {
            Some(v) => {
                if func(&v) { return Some(v); }
                self.peeked = Some(Some(v));
                None
            }
            None => {
                self.peeked = Some(None);
                None
            }
        }
    }

    /// The next item if it equals expected.
    pub fn next_if_eq<T>(&mut self, expected: &T) -> Option<I::Item> where I::Item: PartialEq<T> {
        let x = match self.peeked.take() { Some(v) => v, None => self.iter.next() };
        match x {
            Some(v) => {
                if v == *expected { return Some(v); }
                self.peeked = Some(Some(v));
                None
            }
            None => {
                self.peeked = Some(None);
                None
            }
        }
    }
}

