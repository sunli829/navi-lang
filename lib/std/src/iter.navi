//! Iteration. Closure parameters are fn types (see spec/std-diff.md).

pub trait Iterator {
    type Item;
    fn next(&mut self) -> Option<Self::Item>;

    fn size_hint(&self) -> (usize, Option<usize>) {
        (0, None)
    }

    fn count(self) -> usize {
        let mut it = self;
        let mut n = 0;
        while let Some(_) = it.next() {
            n += 1;
        }
        n
    }

    fn last(self) -> Option<Self::Item> {
        let mut it = self;
        let mut last = None;
        while let Some(x) = it.next() {
            last = Some(x);
        }
        last
    }

    fn nth(&mut self, n: usize) -> Option<Self::Item> {
        let mut i = 0;
        while i < n {
            self.next()?;
            i += 1;
        }
        self.next()
    }

    fn map<B>(self, f: fn(Self::Item) -> B) -> Map<Self, B> {
        Map { iter: self, f }
    }
    fn filter(self, pred: fn(&Self::Item) -> bool) -> Filter<Self> {
        Filter { iter: self, pred }
    }
    fn enumerate(self) -> Enumerate<Self> {
        Enumerate {
            iter: self,
            count: 0,
        }
    }
    fn peekable(self) -> Peekable<Self> {
        Peekable {
            iter: self,
            peeked: None,
        }
    }
    fn take(self, n: usize) -> Take<Self> {
        Take { iter: self, n }
    }
    fn skip(self, n: usize) -> Skip<Self> {
        Skip { iter: self, n }
    }

    fn fold<B>(self, init: B, f: fn(B, Self::Item) -> B) -> B {
        let mut it = self;
        let mut acc = init;
        while let Some(x) = it.next() {
            acc = f(acc, x);
        }
        acc
    }

    fn for_each(self, f: fn(Self::Item)) {
        let mut it = self;
        while let Some(x) = it.next() {
            f(x);
        }
    }

    fn any(&mut self, f: fn(Self::Item) -> bool) -> bool {
        while let Some(x) = self.next() {
            if f(x) {
                return true;
            }
        }
        false
    }

    fn all(&mut self, f: fn(Self::Item) -> bool) -> bool {
        while let Some(x) = self.next() {
            if !f(x) {
                return false;
            }
        }
        true
    }

    fn find(&mut self, pred: fn(&Self::Item) -> bool) -> Option<Self::Item> {
        while let Some(x) = self.next() {
            if pred(&x) {
                return Some(x);
            }
        }
        None
    }

    fn position(&mut self, pred: fn(Self::Item) -> bool) -> Option<usize> {
        let mut i = 0;
        while let Some(x) = self.next() {
            if pred(x) {
                return Some(i);
            }
            i += 1;
        }
        None
    }

    fn collect<C: FromIterator<Self::Item>>(self) -> C {
        C::from_iter(self)
    }

    fn rev(self) -> Rev<Self>
    where
        Self: DoubleEndedIterator,
    {
        Rev { iter: self }
    }
    fn zip<U: IntoIterator>(self, other: U) -> Zip<Self, U::IntoIter> {
        Zip {
            a: self,
            b: other.into_iter(),
        }
    }
    fn chain<U: IntoIterator<Item = Self::Item>>(self, other: U) -> Chain<Self, U::IntoIter> {
        Chain {
            a: self,
            b: other.into_iter(),
            first: true,
        }
    }
    fn step_by(self, step: usize) -> StepBy<Self> {
        StepBy {
            iter: self,
            step,
            first: true,
        }
    }
    fn filter_map<B>(self, f: fn(Self::Item) -> Option<B>) -> FilterMap<Self, B> {
        FilterMap { iter: self, f }
    }
    fn flat_map<U: IntoIterator>(self, f: fn(Self::Item) -> U) -> FlatMap<Self, U> {
        FlatMap {
            iter: self,
            f,
            inner: None,
        }
    }
    fn take_while(self, pred: fn(&Self::Item) -> bool) -> TakeWhile<Self> {
        TakeWhile {
            iter: self,
            pred,
            done: false,
        }
    }
    fn skip_while(self, pred: fn(&Self::Item) -> bool) -> SkipWhile<Self> {
        SkipWhile {
            iter: self,
            pred,
            started: false,
        }
    }
    fn inspect(self, f: fn(&Self::Item)) -> Inspect<Self> {
        Inspect { iter: self, f }
    }

    fn find_map<B>(&mut self, f: fn(Self::Item) -> Option<B>) -> Option<B> {
        while let Some(x) = self.next() {
            if let Some(y) = f(x) {
                return Some(y);
            }
        }
        None
    }

    fn max(self) -> Option<Self::Item>
    where
        Self::Item: Ord,
    {
        let mut it = self;
        let mut best = it.next()?;
        while let Some(x) = it.next() {
            if x >= best {
                best = x;
            }
        }
        Some(best)
    }

    fn min(self) -> Option<Self::Item>
    where
        Self::Item: Ord,
    {
        let mut it = self;
        let mut best = it.next()?;
        while let Some(x) = it.next() {
            if x < best {
                best = x;
            }
        }
        Some(best)
    }

    fn max_by_key<B: Ord>(self, f: fn(&Self::Item) -> B) -> Option<Self::Item> {
        let mut it = self;
        let mut best = it.next()?;
        let mut key = f(&best);
        while let Some(x) = it.next() {
            let k = f(&x);
            if k >= key {
                best = x;
                key = k;
            }
        }
        Some(best)
    }

    fn min_by_key<B: Ord>(self, f: fn(&Self::Item) -> B) -> Option<Self::Item> {
        let mut it = self;
        let mut best = it.next()?;
        let mut key = f(&best);
        while let Some(x) = it.next() {
            let k = f(&x);
            if k < key {
                best = x;
                key = k;
            }
        }
        Some(best)
    }

    fn max_by(
        self,
        cmp: fn(&Self::Item, &Self::Item) -> crate::cmp::Ordering,
    ) -> Option<Self::Item> {
        let mut it = self;
        let mut best = it.next()?;
        while let Some(x) = it.next() {
            if cmp(&x, &best) != crate::cmp::Ordering::Less {
                best = x;
            }
        }
        Some(best)
    }

    fn min_by(
        self,
        cmp: fn(&Self::Item, &Self::Item) -> crate::cmp::Ordering,
    ) -> Option<Self::Item> {
        let mut it = self;
        let mut best = it.next()?;
        while let Some(x) = it.next() {
            if cmp(&x, &best) == crate::cmp::Ordering::Less {
                best = x;
            }
        }
        Some(best)
    }

    fn sum<S: Sum<Self::Item>>(self) -> S {
        S::sum(self)
    }
    fn product<S: Product<Self::Item>>(self) -> S {
        S::product(self)
    }

    fn partition<B>(self, pred: fn(&Self::Item) -> bool) -> (B, B)
    where
        B: Default + Extend<Self::Item>,
    {
        let mut yes = B::default();
        let mut no = B::default();
        let mut it = self;
        while let Some(x) = it.next() {
            if pred(&x) {
                yes.extend(Some(x));
            } else {
                no.extend(Some(x));
            }
        }
        (yes, no)
    }

    fn by_ref(&mut self) -> &mut Self {
        self
    }

    fn reduce(self, f: fn(Self::Item, Self::Item) -> Self::Item) -> Option<Self::Item> {
        let mut it = self;
        let first = it.next()?;
        Some(it.fold(first, f))
    }

    fn flatten(self) -> Flatten<Self, Self::Item>
    where
        Self::Item: IntoIterator,
    {
        Flatten {
            iter: self,
            inner: None,
        }
    }

    fn cycle(self) -> Cycle<Self>
    where
        Self: Clone,
    {
        Cycle {
            orig: self.clone(),
            iter: self,
        }
    }

    fn scan<St, B>(
        self,
        initial_state: St,
        f: fn(&mut St, Self::Item) -> Option<B>,
    ) -> Scan<Self, St, B> {
        Scan {
            iter: self,
            f,
            state: initial_state,
        }
    }

    fn map_while<B>(self, predicate: fn(Self::Item) -> Option<B>) -> MapWhile<Self, B> {
        MapWhile {
            iter: self,
            f: predicate,
            done: false,
        }
    }

    fn fuse(self) -> Fuse<Self> {
        Fuse {
            iter: self,
            done: false,
        }
    }

    fn cloned<T: Clone>(self) -> Cloned<Self, T>
    where
        Self: Iterator<Item = &T>,
    {
        Cloned {
            iter: self,
            marker: None,
        }
    }

    fn copied<T>(self) -> Copied<Self, T>
    where
        Self: Iterator<Item = &T>,
    {
        Copied {
            iter: self,
            marker: None,
        }
    }

    fn unzip<A, B, FromA, FromB>(self) -> (FromA, FromB)
    where
        FromA: Default + Extend<A>,
        FromB: Default + Extend<B>,
        Self: Iterator<Item = (A, B)>,
    {
        let mut a = FromA::default();
        let mut b = FromB::default();
        let mut it = self;
        while let Some((x, y)) = it.next() {
            a.extend(Some(x));
            b.extend(Some(y));
        }
        (a, b)
    }

    fn rposition(&mut self, predicate: fn(Self::Item) -> bool) -> Option<usize>
    where
        Self: ExactSizeIterator + DoubleEndedIterator,
    {
        let mut i = self.len();
        while let Some(x) = self.next_back() {
            i -= 1;
            if predicate(x) {
                return Some(i);
            }
        }
        None
    }

    fn is_sorted(self) -> bool
    where
        Self::Item: PartialOrd,
    {
        let mut it = self;
        let mut last = match it.next() {
            Some(x) => x,
            None => return true,
        };
        while let Some(x) = it.next() {
            if last > x {
                return false;
            }
            last = x;
        }
        true
    }

    fn is_sorted_by(self, compare: fn(&Self::Item, &Self::Item) -> bool) -> bool {
        let mut it = self;
        let mut last = match it.next() {
            Some(x) => x,
            None => return true,
        };
        while let Some(x) = it.next() {
            if !compare(&last, &x) {
                return false;
            }
            last = x;
        }
        true
    }

    fn is_sorted_by_key<K: PartialOrd>(self, f: fn(Self::Item) -> K) -> bool {
        let mut it = self;
        let mut last = match it.next() {
            Some(x) => f(x),
            None => return true,
        };
        while let Some(x) = it.next() {
            let k = f(x);
            if last > k {
                return false;
            }
            last = k;
        }
        true
    }
}

impl<I: Iterator> Iterator for &mut I {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        (**self).next()
    }
}

/// Types that can be made by adding up an iterator's items.
pub trait Sum<A = Self> {
    fn sum<I: Iterator<Item = A>>(iter: I) -> Self;
}

/// Types that can be made by multiplying an iterator's items.
pub trait Product<A = Self> {
    fn product<I: Iterator<Item = A>>(iter: I) -> Self;
}

impl Sum for i32 {
    fn sum<I: Iterator<Item = i32>>(iter: I) -> i32 {
        iter.fold(0, |a, b| a + b)
    }
}
impl Sum for i64 {
    fn sum<I: Iterator<Item = i64>>(iter: I) -> i64 {
        iter.fold(0, |a, b| a + b)
    }
}
impl Sum for u32 {
    fn sum<I: Iterator<Item = u32>>(iter: I) -> u32 {
        iter.fold(0, |a, b| a + b)
    }
}
impl Sum for u64 {
    fn sum<I: Iterator<Item = u64>>(iter: I) -> u64 {
        iter.fold(0, |a, b| a + b)
    }
}
impl Sum for usize {
    fn sum<I: Iterator<Item = usize>>(iter: I) -> usize {
        iter.fold(0, |a, b| a + b)
    }
}
impl Sum for f64 {
    fn sum<I: Iterator<Item = f64>>(iter: I) -> f64 {
        iter.fold(0.0, |a, b| a + b)
    }
}
impl Sum<&i32> for i32 {
    fn sum<I: Iterator<Item = &i32>>(iter: I) -> i32 {
        iter.fold(0, |a, b| a + *b)
    }
}
impl Sum<&i64> for i64 {
    fn sum<I: Iterator<Item = &i64>>(iter: I) -> i64 {
        iter.fold(0, |a, b| a + *b)
    }
}
impl Sum<&u32> for u32 {
    fn sum<I: Iterator<Item = &u32>>(iter: I) -> u32 {
        iter.fold(0, |a, b| a + *b)
    }
}
impl Sum<&u64> for u64 {
    fn sum<I: Iterator<Item = &u64>>(iter: I) -> u64 {
        iter.fold(0, |a, b| a + *b)
    }
}
impl Sum<&usize> for usize {
    fn sum<I: Iterator<Item = &usize>>(iter: I) -> usize {
        iter.fold(0, |a, b| a + *b)
    }
}
impl Sum<&f64> for f64 {
    fn sum<I: Iterator<Item = &f64>>(iter: I) -> f64 {
        iter.fold(0.0, |a, b| a + *b)
    }
}
impl Product for i32 {
    fn product<I: Iterator<Item = i32>>(iter: I) -> i32 {
        iter.fold(1, |a, b| a * b)
    }
}
impl Product for i64 {
    fn product<I: Iterator<Item = i64>>(iter: I) -> i64 {
        iter.fold(1, |a, b| a * b)
    }
}
impl Product for u64 {
    fn product<I: Iterator<Item = u64>>(iter: I) -> u64 {
        iter.fold(1, |a, b| a * b)
    }
}
impl Product for usize {
    fn product<I: Iterator<Item = usize>>(iter: I) -> usize {
        iter.fold(1, |a, b| a * b)
    }
}
impl Product for f64 {
    fn product<I: Iterator<Item = f64>>(iter: I) -> f64 {
        iter.fold(1.0, |a, b| a * b)
    }
}

pub struct Rev<I> {
    iter: I,
}
impl<I: DoubleEndedIterator> Iterator for Rev<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        self.iter.next_back()
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        self.iter.size_hint()
    }
}
impl<I: DoubleEndedIterator> DoubleEndedIterator for Rev<I> {
    fn next_back(&mut self) -> Option<I::Item> {
        self.iter.next()
    }
}

pub struct Zip<A, B> {
    a: A,
    b: B,
}
impl<A: Iterator, B: Iterator> Iterator for Zip<A, B> {
    type Item = (A::Item, B::Item);
    fn next(&mut self) -> Option<(A::Item, B::Item)> {
        let x = self.a.next()?;
        let y = self.b.next()?;
        Some((x, y))
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        let (al, ah) = self.a.size_hint();
        let (bl, bh) = self.b.size_hint();
        let hi = match (ah, bh) {
            (Some(x), Some(y)) => Some(if x < y { x } else { y }),
            (Some(x), None) => Some(x),
            (None, h) => h,
        };
        (if al < bl { al } else { bl }, hi)
    }
}

pub struct Chain<A, B> {
    a: A,
    b: B,
    first: bool,
}
impl<A, B> Iterator for Chain<A, B>
where
    A: Iterator,
    B: Iterator<Item = A::Item>,
{
    type Item = A::Item;
    fn next(&mut self) -> Option<A::Item> {
        if self.first {
            match self.a.next() {
                Some(x) => return Some(x),
                None => {
                    self.first = false;
                }
            }
        }
        self.b.next()
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        let (al, ah) = if self.first {
            self.a.size_hint()
        } else {
            (0, Some(0))
        };
        let (bl, bh) = self.b.size_hint();
        let hi = match (ah, bh) {
            (Some(x), Some(y)) => x.checked_add(y),
            _ => None,
        };
        (al.saturating_add(bl), hi)
    }
}

pub struct StepBy<I> {
    iter: I,
    step: usize,
    first: bool,
}
impl<I: Iterator> Iterator for StepBy<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        if self.first {
            self.first = false;
            return self.iter.next();
        }
        self.iter.nth(self.step - 1)
    }
}

pub struct FilterMap<I: Iterator, B> {
    iter: I,
    f: fn(I::Item) -> Option<B>,
}
impl<I: Iterator, B> Iterator for FilterMap<I, B> {
    type Item = B;
    fn next(&mut self) -> Option<B> {
        while let Some(x) = self.iter.next() {
            if let Some(y) = (self.f)(x) {
                return Some(y);
            }
        }
        None
    }
}

pub struct FlatMap<I: Iterator, U: IntoIterator> {
    iter: I,
    f: fn(I::Item) -> U,
    inner: Option<U::IntoIter>,
}
impl<I: Iterator, U: IntoIterator> Iterator for FlatMap<I, U> {
    type Item = U::Item;
    fn next(&mut self) -> Option<U::Item> {
        loop {
            if let Some(inner) = &mut self.inner {
                if let Some(x) = inner.next() {
                    return Some(x);
                }
            }
            match self.iter.next() {
                Some(x) => {
                    self.inner = Some((self.f)(x).into_iter());
                }
                None => return None,
            }
        }
    }
}

pub struct TakeWhile<I: Iterator> {
    iter: I,
    pred: fn(&I::Item) -> bool,
    done: bool,
}
impl<I: Iterator> Iterator for TakeWhile<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        if self.done {
            return None;
        }
        let x = self.iter.next()?;
        if (self.pred)(&x) {
            Some(x)
        } else {
            self.done = true;
            None
        }
    }
}

pub struct SkipWhile<I: Iterator> {
    iter: I,
    pred: fn(&I::Item) -> bool,
    started: bool,
}
impl<I: Iterator> Iterator for SkipWhile<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        loop {
            let x = self.iter.next()?;
            if self.started || !(self.pred)(&x) {
                self.started = true;
                return Some(x);
            }
        }
    }
}

pub struct Inspect<I: Iterator> {
    iter: I,
    f: fn(&I::Item),
}
impl<I: Iterator> Iterator for Inspect<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        let x = self.iter.next()?;
        (self.f)(&x);
        Some(x)
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        self.iter.size_hint()
    }
}

/// An iterator over a single value (std::iter::once).
pub struct Once<T> {
    v: Option<T>,
}
pub fn once<T>(v: T) -> Once<T> {
    Once { v: Some(v) }
}
impl<T> Iterator for Once<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        self.v.take()
    }
}

/// An iterator yielding a value forever (std::iter::repeat).
pub struct Repeat<T: Clone> {
    v: T,
}
pub fn repeat<T: Clone>(v: T) -> Repeat<T> {
    Repeat { v }
}
impl<T: Clone> Iterator for Repeat<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        Some(self.v.clone())
    }
}

/// An empty iterator (std::iter::empty).
pub struct Empty<T> {
    marker: Option<T>,
}
pub fn empty<T>() -> Empty<T> {
    Empty { marker: None }
}
impl<T> Iterator for Empty<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        None
    }
}

pub trait IntoIterator {
    type Item;
    type IntoIter: Iterator<Item = Self::Item>;
    fn into_iter(self) -> Self::IntoIter;
}

impl<I: Iterator> IntoIterator for I {
    type Item = I::Item;
    type IntoIter = I;
    fn into_iter(self) -> I {
        self
    }
}

pub trait FromIterator<A> {
    fn from_iter<T: IntoIterator<Item = A>>(iter: T) -> Self;
}

pub trait Extend<A> {
    fn extend<T: IntoIterator<Item = A>>(&mut self, iter: T);
}

pub trait DoubleEndedIterator: Iterator {
    fn next_back(&mut self) -> Option<Self::Item>;

    fn nth_back(&mut self, n: usize) -> Option<Self::Item> {
        let mut i = 0;
        while i < n {
            self.next_back()?;
            i += 1;
        }
        self.next_back()
    }

    fn rfold<B>(self, init: B, f: fn(B, Self::Item) -> B) -> B {
        let mut it = self;
        let mut acc = init;
        while let Some(x) = it.next_back() {
            acc = f(acc, x);
        }
        acc
    }

    fn rfind(&mut self, predicate: fn(&Self::Item) -> bool) -> Option<Self::Item> {
        while let Some(x) = self.next_back() {
            if predicate(&x) {
                return Some(x);
            }
        }
        None
    }
}

pub trait ExactSizeIterator: Iterator {
    fn len(&self) -> usize {
        self.size_hint().0
    }
}

pub struct Map<I: Iterator, B> {
    iter: I,
    f: fn(I::Item) -> B,
}
impl<I: Iterator, B> Iterator for Map<I, B> {
    type Item = B;
    fn next(&mut self) -> Option<B> {
        match self.iter.next() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        self.iter.size_hint()
    }
}

pub struct Filter<I: Iterator> {
    iter: I,
    pred: fn(&I::Item) -> bool,
}
impl<I: Iterator> Iterator for Filter<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        while let Some(x) = self.iter.next() {
            if (self.pred)(&x) {
                return Some(x);
            }
        }
        None
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        (0, self.iter.size_hint().1)
    }
}

pub struct Enumerate<I> {
    iter: I,
    count: usize,
}
impl<I: Iterator> Iterator for Enumerate<I> {
    type Item = (usize, I::Item);
    fn next(&mut self) -> Option<(usize, I::Item)> {
        let x = self.iter.next()?;
        let i = self.count;
        self.count += 1;
        Some((i, x))
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        self.iter.size_hint()
    }
}

pub struct Take<I> {
    iter: I,
    n: usize,
}
impl<I: Iterator> Iterator for Take<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        if self.n == 0 {
            return None;
        }
        self.n -= 1;
        self.iter.next()
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        if self.n == 0 {
            return (0, Some(0));
        }
        let (lo, hi) = self.iter.size_hint();
        let lo = if lo < self.n { lo } else { self.n };
        let hi = match hi {
            Some(h) => {
                if h < self.n {
                    h
                } else {
                    self.n
                }
            }
            None => self.n,
        };
        (lo, Some(hi))
    }
}

pub struct Skip<I> {
    iter: I,
    n: usize,
}
impl<I: Iterator> Iterator for Skip<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        while self.n > 0 {
            self.n -= 1;
            self.iter.next()?;
        }
        self.iter.next()
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        let (lo, hi) = self.iter.size_hint();
        (
            lo.saturating_sub(self.n),
            match hi {
                Some(h) => Some(h.saturating_sub(self.n)),
                None => None,
            },
        )
    }
}

pub struct Peekable<I: Iterator> {
    iter: I,
    peeked: Option<Option<I::Item>>,
}
impl<I: Iterator> Peekable<I> {
    pub fn peek(&mut self) -> Option<&I::Item> {
        if self.peeked.is_none() {
            self.peeked = Some(self.iter.next());
        }
        match &self.peeked {
            Some(Some(v)) => Some(v),
            _ => None,
        }
    }
}
impl<I: Iterator> Iterator for Peekable<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        match self.peeked.take() {
            Some(v) => v,
            None => self.iter.next(),
        }
    }
}

/// Types with successor operations, used by range iteration. Implemented
/// by the compiler for integers and char.
pub trait Step: Clone + PartialOrd {
    fn forward(start: Self, n: usize) -> Self;
    fn backward(start: Self, n: usize) -> Self;
}

// (start < end: the successor of start and the predecessor of end exist.)
impl<A> Iterator for crate::ops::Range<A>
where
    A: Step + StepChecked,
{
    type Item = A;
    // Large only before its comparison and clone become operations.
    #[inline(always)]
    fn next(&mut self) -> Option<A> {
        if self.start < self.end {
            let n = self.start.clone();
            self.start = n.checked_succ().unwrap();
            Some(n)
        } else {
            None
        }
    }
}

impl<A> DoubleEndedIterator for crate::ops::Range<A>
where
    A: Step + StepChecked,
{
    fn next_back(&mut self) -> Option<A> {
        if self.start < self.end {
            self.end = self.end.checked_pred().unwrap();
            Some(self.end.clone())
        } else {
            None
        }
    }
}

/// The next and previous values of the Step types, None at their ends
/// (an inclusive range up to the maximum ends without overflowing).
pub trait StepChecked {
    fn checked_succ(&self) -> Option<Self>;
    fn checked_pred(&self) -> Option<Self>;
}

impl StepChecked for u8 {
    // No calls: inlined into the range loops.
    #[inline]
    fn checked_succ(&self) -> Option<u8> {
        if *self == 255u8 {
            None
        } else {
            Some(*self + 1)
        }
    }
    #[inline]
    fn checked_pred(&self) -> Option<u8> {
        if *self == 0u8 { None } else { Some(*self - 1) }
    }
}
impl StepChecked for u16 {
    // No calls: inlined into the range loops.
    #[inline]
    fn checked_succ(&self) -> Option<u16> {
        if *self == 65535u16 {
            None
        } else {
            Some(*self + 1)
        }
    }
    #[inline]
    fn checked_pred(&self) -> Option<u16> {
        if *self == 0u16 { None } else { Some(*self - 1) }
    }
}
impl StepChecked for u32 {
    // No calls: inlined into the range loops.
    #[inline]
    fn checked_succ(&self) -> Option<u32> {
        if *self == 4294967295u32 {
            None
        } else {
            Some(*self + 1)
        }
    }
    #[inline]
    fn checked_pred(&self) -> Option<u32> {
        if *self == 0u32 { None } else { Some(*self - 1) }
    }
}
impl StepChecked for u64 {
    // No calls: inlined into the range loops.
    #[inline]
    fn checked_succ(&self) -> Option<u64> {
        if *self == 18446744073709551615u64 {
            None
        } else {
            Some(*self + 1)
        }
    }
    #[inline]
    fn checked_pred(&self) -> Option<u64> {
        if *self == 0u64 { None } else { Some(*self - 1) }
    }
}
impl StepChecked for u128 {
    fn checked_succ(&self) -> Option<u128> {
        self.checked_add(1)
    }
    fn checked_pred(&self) -> Option<u128> {
        self.checked_sub(1)
    }
}
impl StepChecked for usize {
    // No calls: inlined into the range loops.
    #[inline]
    fn checked_succ(&self) -> Option<usize> {
        if *self == 18446744073709551615usize {
            None
        } else {
            Some(*self + 1)
        }
    }
    #[inline]
    fn checked_pred(&self) -> Option<usize> {
        if *self == 0usize {
            None
        } else {
            Some(*self - 1)
        }
    }
}
impl StepChecked for i8 {
    // No calls: inlined into the range loops.
    #[inline]
    fn checked_succ(&self) -> Option<i8> {
        if *self == 127i8 {
            None
        } else {
            Some(*self + 1)
        }
    }
    #[inline]
    fn checked_pred(&self) -> Option<i8> {
        if *self == -128i8 {
            None
        } else {
            Some(*self - 1)
        }
    }
}
impl StepChecked for i16 {
    // No calls: inlined into the range loops.
    #[inline]
    fn checked_succ(&self) -> Option<i16> {
        if *self == 32767i16 {
            None
        } else {
            Some(*self + 1)
        }
    }
    #[inline]
    fn checked_pred(&self) -> Option<i16> {
        if *self == -32768i16 {
            None
        } else {
            Some(*self - 1)
        }
    }
}
impl StepChecked for i32 {
    // No calls: inlined into the range loops.
    #[inline]
    fn checked_succ(&self) -> Option<i32> {
        if *self == 2147483647i32 {
            None
        } else {
            Some(*self + 1)
        }
    }
    #[inline]
    fn checked_pred(&self) -> Option<i32> {
        if *self == -2147483648i32 {
            None
        } else {
            Some(*self - 1)
        }
    }
}
impl StepChecked for i64 {
    // No calls: inlined into the range loops.
    #[inline]
    fn checked_succ(&self) -> Option<i64> {
        if *self == 9223372036854775807i64 {
            None
        } else {
            Some(*self + 1)
        }
    }
    #[inline]
    fn checked_pred(&self) -> Option<i64> {
        if *self == -9223372036854775808i64 {
            None
        } else {
            Some(*self - 1)
        }
    }
}
impl StepChecked for i128 {
    fn checked_succ(&self) -> Option<i128> {
        self.checked_add(1)
    }
    fn checked_pred(&self) -> Option<i128> {
        self.checked_sub(1)
    }
}
impl StepChecked for isize {
    // No calls: inlined into the range loops.
    #[inline]
    fn checked_succ(&self) -> Option<isize> {
        if *self == 9223372036854775807isize {
            None
        } else {
            Some(*self + 1)
        }
    }
    #[inline]
    fn checked_pred(&self) -> Option<isize> {
        if *self == -9223372036854775808isize {
            None
        } else {
            Some(*self - 1)
        }
    }
}
impl StepChecked for char {
    fn checked_succ(&self) -> Option<char> {
        let c = *self as u32;
        if c == 0xD7FF {
            char::from_u32(0xE000)
        } else {
            char::from_u32(c + 1)
        }
    }
    fn checked_pred(&self) -> Option<char> {
        let c = *self as u32;
        if c == 0 {
            None
        } else if c == 0xE000 {
            char::from_u32(0xD7FF)
        } else {
            char::from_u32(c - 1)
        }
    }
}

// The last value taken leaves start past end: by moving start on, or (at
// the type's maximum) end back.
impl<A> Iterator for crate::ops::RangeInclusive<A>
where
    A: Step + StepChecked,
{
    type Item = A;
    fn next(&mut self) -> Option<A> {
        if self.start < self.end {
            let n = self.start.clone();
            self.start = n.checked_succ().unwrap();
            Some(n)
        } else if self.start == self.end {
            let n = self.start.clone();
            match n.checked_succ() {
                Some(s) => self.start = s,
                None => self.end = self.end.checked_pred().unwrap(),
            }
            Some(n)
        } else {
            None
        }
    }
}

impl<A> DoubleEndedIterator for crate::ops::RangeInclusive<A>
where
    A: Step + StepChecked,
{
    fn next_back(&mut self) -> Option<A> {
        if self.start < self.end {
            let n = self.end.clone();
            self.end = n.checked_pred().unwrap();
            Some(n)
        } else if self.start == self.end {
            let n = self.end.clone();
            match n.checked_pred() {
                Some(p) => self.end = p,
                None => self.start = self.start.checked_succ().unwrap(),
            }
            Some(n)
        } else {
            None
        }
    }
}

impl<A: Step> Iterator for crate::ops::RangeFrom<A> {
    type Item = A;
    fn next(&mut self) -> Option<A> {
        let n = self.start.clone();
        self.start = Step::forward(n.clone(), 1);
        Some(n)
    }
}

// ---------------------------------------------------------------------------

/// The iterator of Iterator::flatten (Rust's Flatten<I>; U is I::Item).
pub struct Flatten<I, U: IntoIterator> {
    iter: I,
    inner: Option<U::IntoIter>,
}
impl<I, U> Iterator for Flatten<I, U>
where
    I: Iterator<Item = U>,
    U: IntoIterator,
{
    type Item = U::Item;
    fn next(&mut self) -> Option<U::Item> {
        loop {
            if let Some(inner) = &mut self.inner {
                if let Some(x) = inner.next() {
                    return Some(x);
                }
            }
            match self.iter.next() {
                Some(x) => {
                    self.inner = Some(x.into_iter());
                }
                None => return None,
            }
        }
    }
}

pub struct Cycle<I> {
    orig: I,
    iter: I,
}
impl<I> Iterator for Cycle<I>
where
    I: Iterator + Clone,
{
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        match self.iter.next() {
            Some(x) => Some(x),
            None => {
                self.iter = self.orig.clone();
                self.iter.next()
            }
        }
    }
}

pub struct Scan<I: Iterator, St, B> {
    iter: I,
    f: fn(&mut St, I::Item) -> Option<B>,
    state: St,
}
impl<I: Iterator, St, B> Iterator for Scan<I, St, B> {
    type Item = B;
    fn next(&mut self) -> Option<B> {
        let x = self.iter.next()?;
        (self.f)(&mut self.state, x)
    }
}

pub struct MapWhile<I: Iterator, B> {
    iter: I,
    f: fn(I::Item) -> Option<B>,
    done: bool,
}
impl<I: Iterator, B> Iterator for MapWhile<I, B> {
    type Item = B;
    fn next(&mut self) -> Option<B> {
        if self.done {
            return None;
        }
        let x = self.iter.next()?;
        match (self.f)(x) {
            Some(y) => Some(y),
            None => {
                self.done = true;
                None
            }
        }
    }
}

pub struct Fuse<I> {
    iter: I,
    done: bool,
}
impl<I: Iterator> Iterator for Fuse<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        if self.done {
            return None;
        }
        match self.iter.next() {
            Some(x) => Some(x),
            None => {
                self.done = true;
                None
            }
        }
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        if self.done {
            (0, Some(0))
        } else {
            self.iter.size_hint()
        }
    }
}
impl<I: DoubleEndedIterator> DoubleEndedIterator for Fuse<I> {
    fn next_back(&mut self) -> Option<I::Item> {
        if self.done {
            return None;
        }
        match self.iter.next_back() {
            Some(x) => Some(x),
            None => {
                self.done = true;
                None
            }
        }
    }
}

/// The iterator of Iterator::cloned (Rust's Cloned<I>; T is the item's
/// referent type).
pub struct Cloned<I, T> {
    iter: I,
    marker: Option<&T>,
}
impl<T, I> Iterator for Cloned<I, T>
where
    T: Clone,
    I: Iterator<Item = &T>,
{
    type Item = T;
    fn next(&mut self) -> Option<T> {
        match self.iter.next() {
            Some(x) => Some(x.clone()),
            None => None,
        }
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        self.iter.size_hint()
    }
}
impl<T, I> DoubleEndedIterator for Cloned<I, T>
where
    T: Clone,
    I: DoubleEndedIterator<Item = &T>,
{
    fn next_back(&mut self) -> Option<T> {
        match self.iter.next_back() {
            Some(x) => Some(x.clone()),
            None => None,
        }
    }
}

/// The iterator of Iterator::copied (Rust's Copied<I>).
pub struct Copied<I, T> {
    iter: I,
    marker: Option<&T>,
}
impl<T, I> Iterator for Copied<I, T>
where
    I: Iterator<Item = &T>,
{
    type Item = T;
    fn next(&mut self) -> Option<T> {
        match self.iter.next() {
            Some(x) => Some(*x),
            None => None,
        }
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        self.iter.size_hint()
    }
}
impl<T, I> DoubleEndedIterator for Copied<I, T>
where
    I: DoubleEndedIterator<Item = &T>,
{
    fn next_back(&mut self) -> Option<T> {
        match self.iter.next_back() {
            Some(x) => Some(*x),
            None => None,
        }
    }
}

// Double-ended adapters.

impl<I: DoubleEndedIterator, B> DoubleEndedIterator for Map<I, B> {
    fn next_back(&mut self) -> Option<B> {
        match self.iter.next_back() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
}
impl<I: DoubleEndedIterator> DoubleEndedIterator for Filter<I> {
    fn next_back(&mut self) -> Option<I::Item> {
        while let Some(x) = self.iter.next_back() {
            if (self.pred)(&x) {
                return Some(x);
            }
        }
        None
    }
}
impl<I: DoubleEndedIterator, B> DoubleEndedIterator for FilterMap<I, B> {
    fn next_back(&mut self) -> Option<B> {
        while let Some(x) = self.iter.next_back() {
            if let Some(y) = (self.f)(x) {
                return Some(y);
            }
        }
        None
    }
}
impl<I: DoubleEndedIterator> DoubleEndedIterator for Inspect<I> {
    fn next_back(&mut self) -> Option<I::Item> {
        let x = self.iter.next_back()?;
        (self.f)(&x);
        Some(x)
    }
}
impl<I> DoubleEndedIterator for Enumerate<I>
where
    I: DoubleEndedIterator + ExactSizeIterator,
{
    fn next_back(&mut self) -> Option<(usize, I::Item)> {
        let n = self.iter.len();
        let x = self.iter.next_back()?;
        Some((self.count + n - 1, x))
    }
}
impl<A, B> DoubleEndedIterator for Chain<A, B>
where
    A: DoubleEndedIterator,
    B: DoubleEndedIterator<Item = A::Item>,
{
    fn next_back(&mut self) -> Option<A::Item> {
        match self.b.next_back() {
            Some(x) => Some(x),
            None => self.a.next_back(),
        }
    }
}
impl<A, B> DoubleEndedIterator for Zip<A, B>
where
    A: DoubleEndedIterator + ExactSizeIterator,
    B: DoubleEndedIterator + ExactSizeIterator,
{
    fn next_back(&mut self) -> Option<(A::Item, B::Item)> {
        let mut al = self.a.len();
        let mut bl = self.b.len();
        while al > bl {
            self.a.next_back();
            al -= 1;
        }
        while bl > al {
            self.b.next_back();
            bl -= 1;
        }
        let x = self.a.next_back()?;
        let y = self.b.next_back()?;
        Some((x, y))
    }
}
impl<I> DoubleEndedIterator for Take<I>
where
    I: DoubleEndedIterator + ExactSizeIterator,
{
    fn next_back(&mut self) -> Option<I::Item> {
        if self.n == 0 {
            return None;
        }
        let mut len = self.iter.len();
        while len > self.n {
            self.iter.next_back();
            len -= 1;
        }
        let x = self.iter.next_back()?;
        self.n -= 1;
        Some(x)
    }
}
impl<I> DoubleEndedIterator for Skip<I>
where
    I: DoubleEndedIterator + ExactSizeIterator,
{
    fn next_back(&mut self) -> Option<I::Item> {
        if self.iter.len() > self.n {
            self.iter.next_back()
        } else {
            None
        }
    }
}
impl<T> DoubleEndedIterator for Once<T> {
    fn next_back(&mut self) -> Option<T> {
        self.v.take()
    }
}
impl<T> DoubleEndedIterator for Empty<T> {
    fn next_back(&mut self) -> Option<T> {
        None
    }
}

// Exact sizes.

impl<I: ExactSizeIterator, B> ExactSizeIterator for Map<I, B> {}
impl<I: ExactSizeIterator> ExactSizeIterator for Enumerate<I> {}
impl<I> ExactSizeIterator for Rev<I> where
    I: ExactSizeIterator + DoubleEndedIterator,
{
}
impl<A: ExactSizeIterator, B: ExactSizeIterator> ExactSizeIterator for Zip<A, B> {}
impl<I: ExactSizeIterator> ExactSizeIterator for Take<I> {}
impl<I: ExactSizeIterator> ExactSizeIterator for Skip<I> {}
impl<I: ExactSizeIterator> ExactSizeIterator for Inspect<I> {}
impl<I: ExactSizeIterator> ExactSizeIterator for Fuse<I> {}
impl<T, I> ExactSizeIterator for Cloned<I, T>
where
    T: Clone,
    I: ExactSizeIterator<Item = &T>,
{
}
impl<T, I> ExactSizeIterator for Copied<I, T> where
    I: ExactSizeIterator<Item = &T>,
{
}
impl<T> ExactSizeIterator for Once<T> {}

// Clones (cycle needs them).

impl<I, B> Clone for Map<I, B>
where
    I: Iterator + Clone,
{
    fn clone(&self) -> Map<I, B> {
        Map {
            iter: self.iter.clone(),
            f: self.f,
        }
    }
}
impl<I> Clone for Filter<I>
where
    I: Iterator + Clone,
{
    fn clone(&self) -> Filter<I> {
        Filter {
            iter: self.iter.clone(),
            pred: self.pred,
        }
    }
}
impl<I, B> Clone for FilterMap<I, B>
where
    I: Iterator + Clone,
{
    fn clone(&self) -> FilterMap<I, B> {
        FilterMap {
            iter: self.iter.clone(),
            f: self.f,
        }
    }
}
impl<I: Clone> Clone for Enumerate<I> {
    fn clone(&self) -> Enumerate<I> {
        Enumerate {
            iter: self.iter.clone(),
            count: self.count,
        }
    }
}
impl<I: Clone> Clone for Take<I> {
    fn clone(&self) -> Take<I> {
        Take {
            iter: self.iter.clone(),
            n: self.n,
        }
    }
}
impl<I: Clone> Clone for Skip<I> {
    fn clone(&self) -> Skip<I> {
        Skip {
            iter: self.iter.clone(),
            n: self.n,
        }
    }
}
impl<I: Clone> Clone for Rev<I> {
    fn clone(&self) -> Rev<I> {
        Rev {
            iter: self.iter.clone(),
        }
    }
}
impl<A: Clone, B: Clone> Clone for Zip<A, B> {
    fn clone(&self) -> Zip<A, B> {
        Zip {
            a: self.a.clone(),
            b: self.b.clone(),
        }
    }
}
impl<A: Clone, B: Clone> Clone for Chain<A, B> {
    fn clone(&self) -> Chain<A, B> {
        Chain {
            a: self.a.clone(),
            b: self.b.clone(),
            first: self.first,
        }
    }
}
impl<I: Clone> Clone for StepBy<I> {
    fn clone(&self) -> StepBy<I> {
        StepBy {
            iter: self.iter.clone(),
            step: self.step,
            first: self.first,
        }
    }
}
impl<I: Clone, T> Clone for Cloned<I, T> {
    fn clone(&self) -> Cloned<I, T> {
        Cloned {
            iter: self.iter.clone(),
            marker: None,
        }
    }
}
impl<I: Clone, T> Clone for Copied<I, T> {
    fn clone(&self) -> Copied<I, T> {
        Copied {
            iter: self.iter.clone(),
            marker: None,
        }
    }
}
impl<I: Clone> Clone for Fuse<I> {
    fn clone(&self) -> Fuse<I> {
        Fuse {
            iter: self.iter.clone(),
            done: self.done,
        }
    }
}
impl<T: Clone> Clone for Once<T> {
    fn clone(&self) -> Once<T> {
        Once { v: self.v.clone() }
    }
}

// More of Peekable.

impl<I: Iterator> Peekable<I> {
    pub fn peek_mut(&mut self) -> Option<&mut I::Item> {
        if self.peeked.is_none() {
            self.peeked = Some(self.iter.next());
        }
        match &mut self.peeked {
            Some(Some(v)) => Some(v),
            _ => None,
        }
    }

    /// The next item if func accepts it.
    pub fn next_if(&mut self, func: fn(&I::Item) -> bool) -> Option<I::Item> {
        let x = match self.peeked.take() {
            Some(v) => v,
            None => self.iter.next(),
        };
        match x {
            Some(v) => {
                if func(&v) {
                    return Some(v);
                }
                self.peeked = Some(Some(v));
                None
            }
            None => {
                self.peeked = Some(None);
                None
            }
        }
    }

    /// The next item if it equals expected.
    pub fn next_if_eq<T>(&mut self, expected: &T) -> Option<I::Item>
    where
        I::Item: PartialEq<T>,
    {
        let x = match self.peeked.take() {
            Some(v) => v,
            None => self.iter.next(),
        };
        match x {
            Some(v) => {
                if v == *expected {
                    return Some(v);
                }
                self.peeked = Some(Some(v));
                None
            }
            None => {
                self.peeked = Some(None);
                None
            }
        }
    }
}

// Ranges.

impl ExactSizeIterator for crate::ops::Range<usize> {
    fn len(&self) -> usize {
        if self.end > self.start {
            self.end - self.start
        } else {
            0
        }
    }
}
impl ExactSizeIterator for crate::ops::Range<u8> {
    fn len(&self) -> usize {
        if self.end > self.start {
            (self.end - self.start) as usize
        } else {
            0
        }
    }
}
impl ExactSizeIterator for crate::ops::Range<u16> {
    fn len(&self) -> usize {
        if self.end > self.start {
