}

impl ExactSizeIterator for crate::ops::RangeInclusive<u8> {
    fn len(&self) -> usize {
        if self.end >= self.start {
            (self.end - self.start) as usize + 1
        } else {
            0
        }
    }
}

impl ExactSizeIterator for crate::ops::RangeInclusive<u16> {
    fn len(&self) -> usize {
        if self.end >= self.start {
