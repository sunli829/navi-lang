//! Iteration. Closure parameters are fn types (see spec/std-diff.md).

pub trait Iterator {
    type Item;
    fn next(&mut self) -> Option<Self::Item>;

    fn size_hint(&self) -> (usize, Option<usize>) { (0, None) }

    fn count(self) -> usize {
        let mut it = self;
        let mut n = 0;
        while let Some(_) = it.next() { n += 1; }
        n
    }

    fn last(self) -> Option<Self::Item> {
        let mut it = self;
        let mut last = None;
        while let Some(x) = it.next() { last = Some(x); }
        last
    }

    fn nth(&mut self, n: usize) -> Option<Self::Item> {
        let mut i = 0;
        while i < n {
            self.next()?;
            i += 1;
        }
        self.next()
    }

    fn map<B>(self, f: fn(Self::Item) -> B) -> Map<Self, B> { Map { iter: self, f } }
    fn filter(self, pred: fn(&Self::Item) -> bool) -> Filter<Self> { Filter { iter: self, pred } }
    fn enumerate(self) -> Enumerate<Self> { Enumerate { iter: self, count: 0 } }
    fn peekable(self) -> Peekable<Self> { Peekable { iter: self, peeked: None } }
    fn take(self, n: usize) -> Take<Self> { Take { iter: self, n } }
    fn skip(self, n: usize) -> Skip<Self> { Skip { iter: self, n } }

    fn fold<B>(self, init: B, f: fn(B, Self::Item) -> B) -> B {
        let mut it = self;
        let mut acc = init;
        while let Some(x) = it.next() { acc = f(acc, x); }
        acc
    }

    fn for_each(self, f: fn(Self::Item)) {
        let mut it = self;
        while let Some(x) = it.next() { f(x); }
    }

    fn any(&mut self, f: fn(Self::Item) -> bool) -> bool {
        while let Some(x) = self.next() { if f(x) { return true; } }
        false
    }

    fn all(&mut self, f: fn(Self::Item) -> bool) -> bool {
        while let Some(x) = self.next() { if !f(x) { return false; } }
        true
    }

    fn find(&mut self, pred: fn(&Self::Item) -> bool) -> Option<Self::Item> {
        while let Some(x) = self.next() { if pred(&x) { return Some(x); } }
        None
    }

    fn position(&mut self, pred: fn(Self::Item) -> bool) -> Option<usize> {
        let mut i = 0;
        while let Some(x) = self.next() {
            if pred(x) { return Some(i); }
            i += 1;
        }
        None
    }

    fn collect<C: FromIterator<Self::Item>>(self) -> C { C::from_iter(self) }

    fn rev(self) -> Rev<Self> where Self: DoubleEndedIterator { Rev { iter: self } }
    fn zip<U: IntoIterator>(self, other: U) -> Zip<Self, U::IntoIter> { Zip { a: self, b: other.into_iter() } }
    fn chain<U: IntoIterator<Item = Self::Item>>(self, other: U) -> Chain<Self, U::IntoIter> {
        Chain { a: self, b: other.into_iter(), first: true }
    }
    fn step_by(self, step: usize) -> StepBy<Self> { StepBy { iter: self, step, first: true } }
    fn filter_map<B>(self, f: fn(Self::Item) -> Option<B>) -> FilterMap<Self, B> { FilterMap { iter: self, f } }
    fn flat_map<U: IntoIterator>(self, f: fn(Self::Item) -> U) -> FlatMap<Self, U> {
        FlatMap { iter: self, f, inner: None }
    }
    fn take_while(self, pred: fn(&Self::Item) -> bool) -> TakeWhile<Self> { TakeWhile { iter: self, pred, done: false } }
    fn skip_while(self, pred: fn(&Self::Item) -> bool) -> SkipWhile<Self> { SkipWhile { iter: self, pred, started: false } }
    fn inspect(self, f: fn(&Self::Item)) -> Inspect<Self> { Inspect { iter: self, f } }

    fn find_map<B>(&mut self, f: fn(Self::Item) -> Option<B>) -> Option<B> {
        while let Some(x) = self.next() {
            if let Some(y) = f(x) { return Some(y); }
        }
        None
    }

    fn max(self) -> Option<Self::Item> where Self::Item: Ord {
        let mut it = self;
        let mut best = it.next()?;
        while let Some(x) = it.next() { if x >= best { best = x; } }
        Some(best)
    }

    fn min(self) -> Option<Self::Item> where Self::Item: Ord {
        let mut it = self;
        let mut best = it.next()?;
        while let Some(x) = it.next() { if x < best { best = x; } }
        Some(best)
    }

    fn max_by_key<B: Ord>(self, f: fn(&Self::Item) -> B) -> Option<Self::Item> {
        let mut it = self;
        let mut best = it.next()?;
        let mut key = f(&best);
        while let Some(x) = it.next() {
            let k = f(&x);
            if k >= key { best = x; key = k; }
        }
        Some(best)
    }

    fn min_by_key<B: Ord>(self, f: fn(&Self::Item) -> B) -> Option<Self::Item> {
        let mut it = self;
        let mut best = it.next()?;
        let mut key = f(&best);
        while let Some(x) = it.next() {
            let k = f(&x);
            if k < key { best = x; key = k; }
        }
        Some(best)
    }

    fn max_by(self, cmp: fn(&Self::Item, &Self::Item) -> crate::cmp::Ordering) -> Option<Self::Item> {
        let mut it = self;
        let mut best = it.next()?;
        while let Some(x) = it.next() {
            if cmp(&x, &best) != crate::cmp::Ordering::Less { best = x; }
        }
        Some(best)
    }

    fn min_by(self, cmp: fn(&Self::Item, &Self::Item) -> crate::cmp::Ordering) -> Option<Self::Item> {
        let mut it = self;
        let mut best = it.next()?;
        while let Some(x) = it.next() {
            if cmp(&x, &best) == crate::cmp::Ordering::Less { best = x; }
        }
        Some(best)
    }

    fn sum<S: Sum<Self::Item>>(self) -> S { S::sum(self) }
    fn product<S: Product<Self::Item>>(self) -> S { S::product(self) }

    fn partition<B: Default + Extend<Self::Item>>(self, pred: fn(&Self::Item) -> bool) -> (B, B) {
        let mut yes = B::default();
        let mut no = B::default();
        let mut it = self;
        while let Some(x) = it.next() {
            if pred(&x) { yes.extend(Some(x)); } else { no.extend(Some(x)); }
        }
        (yes, no)
    }

    fn by_ref(&mut self) -> &mut Self { self }

    // Added for navic (stage0 compiles std without them).

    #[cfg(feature = "navic")]
    fn reduce(self, f: fn(Self::Item, Self::Item) -> Self::Item) -> Option<Self::Item> {
        let mut it = self;
        let first = it.next()?;
        Some(it.fold(first, f))
    }

    #[cfg(feature = "navic")]
    fn flatten(self) -> Flatten<Self, Self::Item> where Self::Item: IntoIterator { Flatten { iter: self, inner: None } }

    #[cfg(feature = "navic")]
    fn cycle(self) -> Cycle<Self> where Self: Clone { Cycle { orig: self.clone(), iter: self } }

    #[cfg(feature = "navic")]
    fn scan<St, B>(self, initial_state: St, f: fn(&mut St, Self::Item) -> Option<B>) -> Scan<Self, St, B> {
        Scan { iter: self, f, state: initial_state }
    }

    #[cfg(feature = "navic")]
    fn map_while<B>(self, predicate: fn(Self::Item) -> Option<B>) -> MapWhile<Self, B> {
        MapWhile { iter: self, f: predicate, done: false }
    }

    #[cfg(feature = "navic")]
    fn fuse(self) -> Fuse<Self> { Fuse { iter: self, done: false } }

    #[cfg(feature = "navic")]
    fn cloned<T: Clone>(self) -> Cloned<Self, T> where Self: Iterator<Item = &T> { Cloned { iter: self, marker: None } }

    #[cfg(feature = "navic")]
    fn copied<T>(self) -> Copied<Self, T> where Self: Iterator<Item = &T> { Copied { iter: self, marker: None } }

    #[cfg(feature = "navic")]
    fn unzip<A, B, FromA: Default + Extend<A>, FromB: Default + Extend<B>>(self) -> (FromA, FromB) where Self: Iterator<Item = (A, B)> {
        let mut a = FromA::default();
        let mut b = FromB::default();
        let mut it = self;
        while let Some((x, y)) = it.next() {
            a.extend(Some(x));
            b.extend(Some(y));
        }
        (a, b)
    }

    #[cfg(feature = "navic")]
    fn rposition(&mut self, predicate: fn(Self::Item) -> bool) -> Option<usize> where Self: ExactSizeIterator + DoubleEndedIterator {
        let mut i = self.len();
        while let Some(x) = self.next_back() {
            i -= 1;
            if predicate(x) { return Some(i); }
        }
        None
    }

    #[cfg(feature = "navic")]
    fn is_sorted(self) -> bool where Self::Item: PartialOrd {
        let mut it = self;
        let mut last = match it.next() { Some(x) => x, None => return true };
        while let Some(x) = it.next() {
            if last > x { return false; }
            last = x;
        }
        true
    }

    #[cfg(feature = "navic")]
    fn is_sorted_by(self, compare: fn(&Self::Item, &Self::Item) -> bool) -> bool {
        let mut it = self;
        let mut last = match it.next() { Some(x) => x, None => return true };
        while let Some(x) = it.next() {
            if !compare(&last, &x) { return false; }
            last = x;
        }
        true
    }

    #[cfg(feature = "navic")]
    fn is_sorted_by_key<K: PartialOrd>(self, f: fn(Self::Item) -> K) -> bool {
        let mut it = self;
        let mut last = match it.next() { Some(x) => f(x), None => return true };
        while let Some(x) = it.next() {
            let k = f(x);
            if last > k { return false; }
            last = k;
        }
        true
    }

}

impl<I: Iterator> Iterator for &mut I {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> { (**self).next() }
}

/// Types that can be made by adding up an iterator's items.
pub trait Sum<A = Self> {
    fn sum<I: Iterator<Item = A>>(iter: I) -> Self;
}

/// Types that can be made by multiplying an iterator's items.
pub trait Product<A = Self> {
    fn product<I: Iterator<Item = A>>(iter: I) -> Self;
}

impl Sum for i32 { fn sum<I: Iterator<Item = i32>>(iter: I) -> i32 { iter.fold(0, |a, b| a + b) } }
impl Sum for i64 { fn sum<I: Iterator<Item = i64>>(iter: I) -> i64 { iter.fold(0, |a, b| a + b) } }
impl Sum for u32 { fn sum<I: Iterator<Item = u32>>(iter: I) -> u32 { iter.fold(0, |a, b| a + b) } }
impl Sum for u64 { fn sum<I: Iterator<Item = u64>>(iter: I) -> u64 { iter.fold(0, |a, b| a + b) } }
impl Sum for usize { fn sum<I: Iterator<Item = usize>>(iter: I) -> usize { iter.fold(0, |a, b| a + b) } }
impl Sum for f64 { fn sum<I: Iterator<Item = f64>>(iter: I) -> f64 { iter.fold(0.0, |a, b| a + b) } }
impl Sum<&i32> for i32 { fn sum<I: Iterator<Item = &i32>>(iter: I) -> i32 { iter.fold(0, |a, b| a + *b) } }
impl Sum<&i64> for i64 { fn sum<I: Iterator<Item = &i64>>(iter: I) -> i64 { iter.fold(0, |a, b| a + *b) } }
impl Sum<&u32> for u32 { fn sum<I: Iterator<Item = &u32>>(iter: I) -> u32 { iter.fold(0, |a, b| a + *b) } }
impl Sum<&u64> for u64 { fn sum<I: Iterator<Item = &u64>>(iter: I) -> u64 { iter.fold(0, |a, b| a + *b) } }
impl Sum<&usize> for usize { fn sum<I: Iterator<Item = &usize>>(iter: I) -> usize { iter.fold(0, |a, b| a + *b) } }
impl Sum<&f64> for f64 { fn sum<I: Iterator<Item = &f64>>(iter: I) -> f64 { iter.fold(0.0, |a, b| a + *b) } }
impl Product for i32 { fn product<I: Iterator<Item = i32>>(iter: I) -> i32 { iter.fold(1, |a, b| a * b) } }
impl Product for i64 { fn product<I: Iterator<Item = i64>>(iter: I) -> i64 { iter.fold(1, |a, b| a * b) } }
impl Product for u64 { fn product<I: Iterator<Item = u64>>(iter: I) -> u64 { iter.fold(1, |a, b| a * b) } }
impl Product for usize { fn product<I: Iterator<Item = usize>>(iter: I) -> usize { iter.fold(1, |a, b| a * b) } }
impl Product for f64 { fn product<I: Iterator<Item = f64>>(iter: I) -> f64 { iter.fold(1.0, |a, b| a * b) } }

pub struct Rev<I> { iter: I }
impl<I: DoubleEndedIterator> Iterator for Rev<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> { self.iter.next_back() }
    #[cfg(feature = "navic")]
    fn size_hint(&self) -> (usize, Option<usize>) { self.iter.size_hint() }
}
impl<I: DoubleEndedIterator> DoubleEndedIterator for Rev<I> {
    fn next_back(&mut self) -> Option<I::Item> { self.iter.next() }
}

pub struct Zip<A, B> { a: A, b: B }
impl<A: Iterator, B: Iterator> Iterator for Zip<A, B> {
    type Item = (A::Item, B::Item);
    fn next(&mut self) -> Option<(A::Item, B::Item)> {
        let x = self.a.next()?;
        let y = self.b.next()?;
        Some((x, y))
    }
    #[cfg(feature = "navic")]
    fn size_hint(&self) -> (usize, Option<usize>) {
        let (al, ah) = self.a.size_hint();
        let (bl, bh) = self.b.size_hint();
        let hi = match (ah, bh) { (Some(x), Some(y)) => Some(if x < y { x } else { y }), (Some(x), None) => Some(x), (None, h) => h };
        (if al < bl { al } else { bl }, hi)
    }
}

pub struct Chain<A, B> { a: A, b: B, first: bool }
impl<A: Iterator, B: Iterator<Item = A::Item>> Iterator for Chain<A, B> {
    type Item = A::Item;
    fn next(&mut self) -> Option<A::Item> {
        if self.first {
            match self.a.next() {
                Some(x) => return Some(x),
                None => { self.first = false; }
            }
        }
        self.b.next()
    }
    #[cfg(feature = "navic")]
    fn size_hint(&self) -> (usize, Option<usize>) {
        let (al, ah) = if self.first { self.a.size_hint() } else { (0, Some(0)) };
        let (bl, bh) = self.b.size_hint();
        let hi = match (ah, bh) { (Some(x), Some(y)) => x.checked_add(y), _ => None };
        (al.saturating_add(bl), hi)
    }
}

pub struct StepBy<I> { iter: I, step: usize, first: bool }
impl<I: Iterator> Iterator for StepBy<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        if self.first {
            self.first = false;
            return self.iter.next();
        }
        self.iter.nth(self.step - 1)
    }
}

pub struct FilterMap<I: Iterator, B> { iter: I, f: fn(I::Item) -> Option<B> }
impl<I: Iterator, B> Iterator for FilterMap<I, B> {
    type Item = B;
    fn next(&mut self) -> Option<B> {
        while let Some(x) = self.iter.next() {
            if let Some(y) = (self.f)(x) { return Some(y); }
        }
        None
    }
}

pub struct FlatMap<I: Iterator, U: IntoIterator> { iter: I, f: fn(I::Item) -> U, inner: Option<U::IntoIter> }
impl<I: Iterator, U: IntoIterator> Iterator for FlatMap<I, U> {
    type Item = U::Item;
    fn next(&mut self) -> Option<U::Item> {
        loop {
            if let Some(inner) = &mut self.inner {
                if let Some(x) = inner.next() { return Some(x); }
            }
            match self.iter.next() {
                Some(x) => { self.inner = Some((self.f)(x).into_iter()); }
                None => return None,
            }
        }
    }
}

pub struct TakeWhile<I: Iterator> { iter: I, pred: fn(&I::Item) -> bool, done: bool }
impl<I: Iterator> Iterator for TakeWhile<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        if self.done { return None; }
        let x = self.iter.next()?;
        if (self.pred)(&x) { Some(x) } else { self.done = true; None }
    }
}

pub struct SkipWhile<I: Iterator> { iter: I, pred: fn(&I::Item) -> bool, started: bool }
impl<I: Iterator> Iterator for SkipWhile<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        loop {
            let x = self.iter.next()?;
            if self.started || !(self.pred)(&x) {
                self.started = true;
                return Some(x);
            }
        }
    }
}

pub struct Inspect<I: Iterator> { iter: I, f: fn(&I::Item) }
impl<I: Iterator> Iterator for Inspect<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        let x = self.iter.next()?;
        (self.f)(&x);
        Some(x)
    }
    #[cfg(feature = "navic")]
    fn size_hint(&self) -> (usize, Option<usize>) { self.iter.size_hint() }
}

/// An iterator over a single value (std::iter::once).
pub struct Once<T> { v: Option<T> }
pub fn once<T>(v: T) -> Once<T> { Once { v: Some(v) } }
impl<T> Iterator for Once<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> { self.v.take() }
}

/// An iterator yielding a value forever (std::iter::repeat).
pub struct Repeat<T: Clone> { v: T }
pub fn repeat<T: Clone>(v: T) -> Repeat<T> { Repeat { v } }
impl<T: Clone> Iterator for Repeat<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> { Some(self.v.clone()) }
}

/// An empty iterator (std::iter::empty).
pub struct Empty<T> { marker: Option<T> }
pub fn empty<T>() -> Empty<T> { Empty { marker: None } }
impl<T> Iterator for Empty<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> { None }
}

pub trait IntoIterator {
    type Item;
    type IntoIter: Iterator<Item = Self::Item>;
    fn into_iter(self) -> Self::IntoIter;
}

impl<I: Iterator> IntoIterator for I {
    type Item = I::Item;
    type IntoIter = I;
    fn into_iter(self) -> I { self }
}

pub trait FromIterator<A> {
    fn from_iter<T: IntoIterator<Item = A>>(iter: T) -> Self;
}

pub trait Extend<A> {
    fn extend<T: IntoIterator<Item = A>>(&mut self, iter: T);
}

pub trait DoubleEndedIterator: Iterator {
    fn next_back(&mut self) -> Option<Self::Item>;

    #[cfg(feature = "navic")]
    fn nth_back(&mut self, n: usize) -> Option<Self::Item> {
        let mut i = 0;
        while i < n {
            self.next_back()?;
            i += 1;
        }
        self.next_back()
    }

    #[cfg(feature = "navic")]
    fn rfold<B>(self, init: B, f: fn(B, Self::Item) -> B) -> B {
        let mut it = self;
        let mut acc = init;
        while let Some(x) = it.next_back() { acc = f(acc, x); }
        acc
    }

    #[cfg(feature = "navic")]
    fn rfind(&mut self, predicate: fn(&Self::Item) -> bool) -> Option<Self::Item> {
        while let Some(x) = self.next_back() { if predicate(&x) { return Some(x); } }
        None
    }
}

pub trait ExactSizeIterator: Iterator {
    fn len(&self) -> usize { self.size_hint().0 }
}

pub struct Map<I: Iterator, B> { iter: I, f: fn(I::Item) -> B }
impl<I: Iterator, B> Iterator for Map<I, B> {
    type Item = B;
    fn next(&mut self) -> Option<B> {
        match self.iter.next() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
    #[cfg(feature = "navic")]
    fn size_hint(&self) -> (usize, Option<usize>) { self.iter.size_hint() }
}

pub struct Filter<I: Iterator> { iter: I, pred: fn(&I::Item) -> bool }
impl<I: Iterator> Iterator for Filter<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        while let Some(x) = self.iter.next() {
            if (self.pred)(&x) { return Some(x); }
        }
        None
    }
    #[cfg(feature = "navic")]
    fn size_hint(&self) -> (usize, Option<usize>) { (0, self.iter.size_hint().1) }
}

pub struct Enumerate<I> { iter: I, count: usize }
impl<I: Iterator> Iterator for Enumerate<I> {
    type Item = (usize, I::Item);
    fn next(&mut self) -> Option<(usize, I::Item)> {
        let x = self.iter.next()?;
        let i = self.count;
        self.count += 1;
        Some((i, x))
    }
    #[cfg(feature = "navic")]
    fn size_hint(&self) -> (usize, Option<usize>) { self.iter.size_hint() }
}

pub struct Take<I> { iter: I, n: usize }
impl<I: Iterator> Iterator for Take<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        if self.n == 0 { return None; }
        self.n -= 1;
        self.iter.next()
    }
    #[cfg(feature = "navic")]
    fn size_hint(&self) -> (usize, Option<usize>) {
        if self.n == 0 { return (0, Some(0)); }
        let (lo, hi) = self.iter.size_hint();
        let lo = if lo < self.n { lo } else { self.n };
        let hi = match hi { Some(h) => if h < self.n { h } else { self.n }, None => self.n };
        (lo, Some(hi))
    }
}

pub struct Skip<I> { iter: I, n: usize }
impl<I: Iterator> Iterator for Skip<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        while self.n > 0 {
            self.n -= 1;
            self.iter.next()?;
        }
        self.iter.next()
    }
    #[cfg(feature = "navic")]
    fn size_hint(&self) -> (usize, Option<usize>) {
        let (lo, hi) = self.iter.size_hint();
        (lo.saturating_sub(self.n), match hi { Some(h) => Some(h.saturating_sub(self.n)), None => None })
    }
}

pub struct Peekable<I: Iterator> { iter: I, peeked: Option<Option<I::Item>> }
impl<I: Iterator> Peekable<I> {
    pub fn peek(&mut self) -> Option<&I::Item> {
        if self.peeked.is_none() {
            self.peeked = Some(self.iter.next());
        }
        match &self.peeked {
            Some(Some(v)) => Some(v),
            _ => None,
        }
    }
}
impl<I: Iterator> Iterator for Peekable<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        match self.peeked.take() {
            Some(v) => v,
            None => self.iter.next(),
        }
    }
}

/// Types with successor operations, used by range iteration. Implemented
/// by the compiler for integers and char.
pub trait Step: Clone + PartialOrd {
    fn forward(start: Self, n: usize) -> Self;
    fn backward(start: Self, n: usize) -> Self;
}

#[cfg(not(feature = "navic"))]
impl<A: Step> Iterator for crate::ops::Range<A> {
    type Item = A;
    fn next(&mut self) -> Option<A> {
        if self.start < self.end {
            let n = self.start.clone();
            self.start = Step::forward(n.clone(), 1);
            Some(n)
        } else {
            None
        }
    }
}

#[cfg(not(feature = "navic"))]
impl<A: Step> DoubleEndedIterator for crate::ops::Range<A> {
    fn next_back(&mut self) -> Option<A> {
        if self.start < self.end {
            self.end = Step::backward(self.end.clone(), 1);
            Some(self.end.clone())
        } else {
            None
        }
    }
}

// (start < end: the successor of start and the predecessor of end exist.)
#[cfg(feature = "navic")]
impl<A: Step + StepChecked> Iterator for crate::ops::Range<A> {
    type Item = A;
    fn next(&mut self) -> Option<A> {
        if self.start < self.end {
            let n = self.start.clone();
            self.start = n.checked_succ().unwrap();
            Some(n)
        } else {
            None
        }
    }
}

#[cfg(feature = "navic")]
impl<A: Step + StepChecked> DoubleEndedIterator for crate::ops::Range<A> {
    fn next_back(&mut self) -> Option<A> {
        if self.start < self.end {
            self.end = self.end.checked_pred().unwrap();
            Some(self.end.clone())
        } else {
            None
        }
    }
}

#[cfg(not(feature = "navic"))]
impl<A: Step> Iterator for crate::ops::RangeInclusive<A> {
    type Item = A;
    fn next(&mut self) -> Option<A> {
        if self.start <= self.end {
            let n = self.start.clone();
            self.start = Step::forward(n.clone(), 1);
            Some(n)
        } else {
            None
        }
    }
}

/// The next and previous values of the Step types, None at their ends
/// (an inclusive range up to the maximum ends without overflowing).
#[cfg(feature = "navic")]
pub trait StepChecked {
    fn checked_succ(&self) -> Option<Self>;
    fn checked_pred(&self) -> Option<Self>;
}

#[cfg(feature = "navic")]
impl StepChecked for u8 {
    fn checked_succ(&self) -> Option<u8> { self.checked_add(1) }
    fn checked_pred(&self) -> Option<u8> { self.checked_sub(1) }
}
#[cfg(feature = "navic")]
impl StepChecked for u16 {
    fn checked_succ(&self) -> Option<u16> { self.checked_add(1) }
    fn checked_pred(&self) -> Option<u16> { self.checked_sub(1) }
}
#[cfg(feature = "navic")]
impl StepChecked for u32 {
    fn checked_succ(&self) -> Option<u32> { self.checked_add(1) }
    fn checked_pred(&self) -> Option<u32> { self.checked_sub(1) }
}
#[cfg(feature = "navic")]
impl StepChecked for u64 {
    fn checked_succ(&self) -> Option<u64> { self.checked_add(1) }
    fn checked_pred(&self) -> Option<u64> { self.checked_sub(1) }
}
#[cfg(feature = "navic")]
impl StepChecked for u128 {
    fn checked_succ(&self) -> Option<u128> { self.checked_add(1) }
    fn checked_pred(&self) -> Option<u128> { self.checked_sub(1) }
}
#[cfg(feature = "navic")]
impl StepChecked for usize {
    fn checked_succ(&self) -> Option<usize> { self.checked_add(1) }
    fn checked_pred(&self) -> Option<usize> { self.checked_sub(1) }
}
#[cfg(feature = "navic")]
impl StepChecked for i8 {
    fn checked_succ(&self) -> Option<i8> { self.checked_add(1) }
    fn checked_pred(&self) -> Option<i8> { self.checked_sub(1) }
}
#[cfg(feature = "navic")]
impl StepChecked for i16 {
    fn checked_succ(&self) -> Option<i16> { self.checked_add(1) }
    fn checked_pred(&self) -> Option<i16> { self.checked_sub(1) }
}
#[cfg(feature = "navic")]
impl StepChecked for i32 {
    fn checked_succ(&self) -> Option<i32> { self.checked_add(1) }
    fn checked_pred(&self) -> Option<i32> { self.checked_sub(1) }
}
#[cfg(feature = "navic")]
impl StepChecked for i64 {
    fn checked_succ(&self) -> Option<i64> { self.checked_add(1) }
    fn checked_pred(&self) -> Option<i64> { self.checked_sub(1) }
}
#[cfg(feature = "navic")]
impl StepChecked for i128 {
    fn checked_succ(&self) -> Option<i128> { self.checked_add(1) }
    fn checked_pred(&self) -> Option<i128> { self.checked_sub(1) }
}
#[cfg(feature = "navic")]
impl StepChecked for isize {
    fn checked_succ(&self) -> Option<isize> { self.checked_add(1) }
    fn checked_pred(&self) -> Option<isize> { self.checked_sub(1) }
}
#[cfg(feature = "navic")]
impl StepChecked for char {
    fn checked_succ(&self) -> Option<char> {
        let c = *self as u32;
        if c == 0xD7FF { char::from_u32(0xE000) } else { char::from_u32(c + 1) }
    }
    fn checked_pred(&self) -> Option<char> {
        let c = *self as u32;
        if c == 0 { None } else if c == 0xE000 { char::from_u32(0xD7FF) } else { char::from_u32(c - 1) }
    }
}

// The last value taken leaves start past end: by moving start on, or (at
// the type's maximum) end back.
#[cfg(feature = "navic")]
impl<A: Step + StepChecked> Iterator for crate::ops::RangeInclusive<A> {
    type Item = A;
    fn next(&mut self) -> Option<A> {
        if self.start < self.end {
            let n = self.start.clone();
            self.start = n.checked_succ().unwrap();
            Some(n)
        } else if self.start == self.end {
            let n = self.start.clone();
            match n.checked_succ() {
                Some(s) => self.start = s,
                None => self.end = self.end.checked_pred().unwrap(),
            }
            Some(n)
        } else {
            None
        }
    }
}

#[cfg(feature = "navic")]
impl<A: Step + StepChecked> DoubleEndedIterator for crate::ops::RangeInclusive<A> {
    fn next_back(&mut self) -> Option<A> {
        if self.start < self.end {
            let n = self.end.clone();
            self.end = n.checked_pred().unwrap();
            Some(n)
        } else if self.start == self.end {
            let n = self.end.clone();
            match n.checked_pred() {
                Some(p) => self.end = p,
                None => self.start = self.start.checked_succ().unwrap(),
            }
            Some(n)
        } else {
            None
        }
    }
}

impl<A: Step> Iterator for crate::ops::RangeFrom<A> {
    type Item = A;
    fn next(&mut self) -> Option<A> {
        let n = self.start.clone();
        self.start = Step::forward(n.clone(), 1);
        Some(n)
    }
}

// ---------------------------------------------------------------------------
// Added for navic (hidden from stage0, which compiles std without them).

/// The iterator of Iterator::flatten (Rust's Flatten<I>; U is I::Item).
#[cfg(feature = "navic")]
pub struct Flatten<I, U: IntoIterator> { iter: I, inner: Option<U::IntoIter> }
#[cfg(feature = "navic")]
impl<I: Iterator<Item = U>, U: IntoIterator> Iterator for Flatten<I, U> {
    type Item = U::Item;
    fn next(&mut self) -> Option<U::Item> {
        loop {
            if let Some(inner) = &mut self.inner {
                if let Some(x) = inner.next() { return Some(x); }
            }
            match self.iter.next() {
                Some(x) => { self.inner = Some(x.into_iter()); }
                None => return None,
            }
        }
    }
}

#[cfg(feature = "navic")]
pub struct Cycle<I> { orig: I, iter: I }
#[cfg(feature = "navic")]
impl<I: Iterator + Clone> Iterator for Cycle<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        match self.iter.next() {
            Some(x) => Some(x),
            None => {
                self.iter = self.orig.clone();
                self.iter.next()
            }
        }
    }
}

#[cfg(feature = "navic")]
pub struct Scan<I: Iterator, St, B> { iter: I, f: fn(&mut St, I::Item) -> Option<B>, state: St }
#[cfg(feature = "navic")]
impl<I: Iterator, St, B> Iterator for Scan<I, St, B> {
    type Item = B;
    fn next(&mut self) -> Option<B> {
        let x = self.iter.next()?;
        (self.f)(&mut self.state, x)
    }
}

#[cfg(feature = "navic")]
pub struct MapWhile<I: Iterator, B> { iter: I, f: fn(I::Item) -> Option<B>, done: bool }
#[cfg(feature = "navic")]
impl<I: Iterator, B> Iterator for MapWhile<I, B> {
    type Item = B;
    fn next(&mut self) -> Option<B> {
        if self.done { return None; }
        let x = self.iter.next()?;
        match (self.f)(x) {
            Some(y) => Some(y),
            None => { self.done = true; None }
        }
    }
}

#[cfg(feature = "navic")]
pub struct Fuse<I> { iter: I, done: bool }
#[cfg(feature = "navic")]
impl<I: Iterator> Iterator for Fuse<I> {
    type Item = I::Item;
    fn next(&mut self) -> Option<I::Item> {
        if self.done { return None; }
        match self.iter.next() {
            Some(x) => Some(x),
            None => { self.done = true; None }
        }
    }
    fn size_hint(&self) -> (usize, Option<usize>) { if self.done { (0, Some(0)) } else { self.iter.size_hint() } }
}
#[cfg(feature = "navic")]
impl<I: DoubleEndedIterator> DoubleEndedIterator for Fuse<I> {
    fn next_back(&mut self) -> Option<I::Item> {
        if self.done { return None; }
        match self.iter.next_back() {
            Some(x) => Some(x),
            None => { self.done = true; None }
        }
    }
}

/// The iterator of Iterator::cloned (Rust's Cloned<I>; T is the item's
/// referent type).
#[cfg(feature = "navic")]
pub struct Cloned<I, T> { iter: I, marker: Option<&T> }
#[cfg(feature = "navic")]
impl<T: Clone, I: Iterator<Item = &T>> Iterator for Cloned<I, T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        match self.iter.next() { Some(x) => Some(x.clone()), None => None }
    }
    fn size_hint(&self) -> (usize, Option<usize>) { self.iter.size_hint() }
}
#[cfg(feature = "navic")]
impl<T: Clone, I: DoubleEndedIterator<Item = &T>> DoubleEndedIterator for Cloned<I, T> {
    fn next_back(&mut self) -> Option<T> {
        match self.iter.next_back() { Some(x) => Some(x.clone()), None => None }
    }
}

/// The iterator of Iterator::copied (Rust's Copied<I>).
#[cfg(feature = "navic")]
pub struct Copied<I, T> { iter: I, marker: Option<&T> }
#[cfg(feature = "navic")]
impl<T, I: Iterator<Item = &T>> Iterator for Copied<I, T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        match self.iter.next() { Some(x) => Some(*x), None => None }
    }
    fn size_hint(&self) -> (usize, Option<usize>) { self.iter.size_hint() }
}
#[cfg(feature = "navic")]
impl<T, I: DoubleEndedIterator<Item = &T>> DoubleEndedIterator for Copied<I, T> {
    fn next_back(&mut self) -> Option<T> {
        match self.iter.next_back() { Some(x) => Some(*x), None => None }
    }
}

// Double-ended adapters.

#[cfg(feature = "navic")]
impl<I: DoubleEndedIterator, B> DoubleEndedIterator for Map<I, B> {
    fn next_back(&mut self) -> Option<B> {
        match self.iter.next_back() { Some(x) => Some((self.f)(x)), None => None }
    }
}
#[cfg(feature = "navic")]
impl<I: DoubleEndedIterator> DoubleEndedIterator for Filter<I> {
    fn next_back(&mut self) -> Option<I::Item> {
        while let Some(x) = self.iter.next_back() {
            if (self.pred)(&x) { return Some(x); }
        }
        None
    }
}
#[cfg(feature = "navic")]
impl<I: DoubleEndedIterator, B> DoubleEndedIterator for FilterMap<I, B> {
    fn next_back(&mut self) -> Option<B> {
        while let Some(x) = self.iter.next_back() {
            if let Some(y) = (self.f)(x) { return Some(y); }
        }
        None
    }
}
#[cfg(feature = "navic")]
impl<I: DoubleEndedIterator> DoubleEndedIterator for Inspect<I> {
    fn next_back(&mut self) -> Option<I::Item> {
        let x = self.iter.next_back()?;
        (self.f)(&x);
        Some(x)
    }
}
#[cfg(feature = "navic")]
impl<I: DoubleEndedIterator + ExactSizeIterator> DoubleEndedIterator for Enumerate<I> {
    fn next_back(&mut self) -> Option<(usize, I::Item)> {
        let n = self.iter.len();
        let x = self.iter.next_back()?;
        Some((self.count + n - 1, x))
    }
}
#[cfg(feature = "navic")]
impl<A: DoubleEndedIterator, B: DoubleEndedIterator<Item = A::Item>> DoubleEndedIterator for Chain<A, B> {
    fn next_back(&mut self) -> Option<A::Item> {
        match self.b.next_back() {
            Some(x) => Some(x),
            None => self.a.next_back(),
        }
    }
}
#[cfg(feature = "navic")]
impl<A: DoubleEndedIterator + ExactSizeIterator, B: DoubleEndedIterator + ExactSizeIterator> DoubleEndedIterator for Zip<A, B> {
    fn next_back(&mut self) -> Option<(A::Item, B::Item)> {
        let mut al = self.a.len();
        let mut bl = self.b.len();
        while al > bl { self.a.next_back(); al -= 1; }
        while bl > al { self.b.next_back(); bl -= 1; }
        let x = self.a.next_back()?;
        let y = self.b.next_back()?;
        Some((x, y))
    }
}
#[cfg(feature = "navic")]
impl<I: DoubleEndedIterator + ExactSizeIterator> DoubleEndedIterator for Take<I> {
    fn next_back(&mut self) -> Option<I::Item> {
        if self.n == 0 { return None; }
        let mut len = self.iter.len();
        while len > self.n { self.iter.next_back(); len -= 1; }
        let x = self.iter.next_back()?;
        self.n -= 1;
        Some(x)
    }
}
#[cfg(feature = "navic")]
impl<I: DoubleEndedIterator + ExactSizeIterator> DoubleEndedIterator for Skip<I> {
    fn next_back(&mut self) -> Option<I::Item> {
        if self.iter.len() > self.n { self.iter.next_back() } else { None }
    }
}
#[cfg(feature = "navic")]
impl<T> DoubleEndedIterator for Once<T> {
    fn next_back(&mut self) -> Option<T> { self.v.take() }
}
#[cfg(feature = "navic")]
impl<T> DoubleEndedIterator for Empty<T> {
    fn next_back(&mut self) -> Option<T> { None }
}

