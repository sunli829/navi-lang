//! The char type. Classification is ASCII-only in this version; Unicode
//! tables come with the full standard library.

impl char {
    pub const MAX: char = '\u{10FFFF}';

    pub fn from_u32(i: u32) -> Option<char> {
        if i > 0x10FFFF || (i >= 0xD800 && i <= 0xDFFF) { None } else { Some(unsafe { *(&i as *const u32 as *const char) }) }
    }

    pub fn from_digit(num: u32, radix: u32) -> Option<char> {
        if num >= radix { return None; }
        if num < 10 { Some((b'0' + num as u8) as char) } else { Some((b'a' + (num - 10) as u8) as char) }
    }

    pub fn is_ascii_hexdigit(&self) -> bool { (*self as u32) < 128 && (*self as u8).is_ascii_hexdigit() }
    pub fn is_ascii_alphabetic(&self) -> bool { (*self as u32) < 128 && (*self as u8).is_ascii_alphabetic() }
    pub fn is_ascii_alphanumeric(&self) -> bool { (*self as u32) < 128 && (*self as u8).is_ascii_alphanumeric() }
    pub fn is_ascii_whitespace(&self) -> bool { (*self as u32) < 128 && (*self as u8).is_ascii_whitespace() }
    pub fn is_ascii_punctuation(&self) -> bool { (*self as u32) < 128 && (*self as u8).is_ascii_punctuation() }

    pub fn is_alphabetic(self) -> bool { (self >= 'a' && self <= 'z') || (self >= 'A' && self <= 'Z') || self as u32 > 127 }
    pub fn is_numeric(self) -> bool { self >= '0' && self <= '9' }
    pub fn is_alphanumeric(self) -> bool { self.is_alphabetic() || self.is_numeric() }
    pub fn is_whitespace(self) -> bool { self == ' ' || self == '\t' || self == '\n' || self == '\r' }
    pub fn is_uppercase(self) -> bool { self >= 'A' && self <= 'Z' }
    pub fn is_lowercase(self) -> bool { self >= 'a' && self <= 'z' }
    pub fn is_ascii(&self) -> bool { (*self as u32) < 128 }
    pub fn is_ascii_digit(&self) -> bool { *self >= '0' && *self <= '9' }
    pub fn to_ascii_uppercase(&self) -> char { if self.is_lowercase() { ((*self as u8) - 32) as char } else { *self } }
    pub fn to_ascii_lowercase(&self) -> char { if self.is_uppercase() { ((*self as u8) + 32) as char } else { *self } }

    pub fn to_digit(self, radix: u32) -> Option<u32> {
        let c = self as u32;
        let d = if c >= 48 && c <= 57 {
            c - 48
        } else if c >= 97 && c <= 122 {
            c - 97 + 10
        } else if c >= 65 && c <= 90 {
            c - 65 + 10
        } else {
            return None;
        };
        if d < radix { Some(d) } else { None }
    }

    pub fn len_utf8(self) -> usize {
        let c = self as u32;
        if c < 0x80 { 1 } else if c < 0x800 { 2 } else if c < 0x10000 { 3 } else { 4 }
    }
}

impl u8 {
    pub fn is_ascii(&self) -> bool { *self < 128 }
    pub fn is_ascii_digit(&self) -> bool { *self >= b'0' && *self <= b'9' }
    pub fn is_ascii_hexdigit(&self) -> bool { self.is_ascii_digit() || (*self >= b'a' && *self <= b'f') || (*self >= b'A' && *self <= b'F') }
    pub fn is_ascii_uppercase(&self) -> bool { *self >= b'A' && *self <= b'Z' }
    pub fn is_ascii_lowercase(&self) -> bool { *self >= b'a' && *self <= b'z' }
    pub fn is_ascii_alphabetic(&self) -> bool { self.is_ascii_uppercase() || self.is_ascii_lowercase() }
    pub fn is_ascii_alphanumeric(&self) -> bool { self.is_ascii_alphabetic() || self.is_ascii_digit() }
    pub fn is_ascii_whitespace(&self) -> bool { *self == b' ' || *self == b'\t' || *self == b'\n' || *self == b'\r' || *self == 12 }
    pub fn is_ascii_punctuation(&self) -> bool {
        (*self >= 33 && *self <= 47) || (*self >= 58 && *self <= 64) || (*self >= 91 && *self <= 96) || (*self >= 123 && *self <= 126)
    }
    pub fn to_ascii_uppercase(&self) -> u8 { if self.is_ascii_lowercase() { *self - 32 } else { *self } }
    pub fn to_ascii_lowercase(&self) -> u8 { if self.is_ascii_uppercase() { *self + 32 } else { *self } }
}
