//! The char type. Classification is ASCII-only in this version; Unicode
//! tables come with the full standard library.

impl char {
    pub const MAX: char = '\u{10FFFF}';

    pub fn from_u32(i: u32) -> Option<char> {
        if i > 0x10FFFF || (i >= 0xD800 && i <= 0xDFFF) {
            None
        } else {
            Some(unsafe { *(&i as *const u32 as *const char) })
        }
    }

    pub fn from_digit(num: u32, radix: u32) -> Option<char> {
        if num >= radix {
            return None;
        }
        if num < 10 {
            Some((b'0' + num as u8) as char)
        } else {
            Some((b'a' + (num - 10) as u8) as char)
        }
    }

    #[inline]
    pub fn is_ascii_hexdigit(&self) -> bool {
        (*self as u32) < 128 && (*self as u8).is_ascii_hexdigit()
    }
    #[inline]
    pub fn is_ascii_alphabetic(&self) -> bool {
        (*self as u32) < 128 && (*self as u8).is_ascii_alphabetic()
    }
    #[inline]
    pub fn is_ascii_alphanumeric(&self) -> bool {
        (*self as u32) < 128 && (*self as u8).is_ascii_alphanumeric()
    }
    #[inline]
    pub fn is_ascii_whitespace(&self) -> bool {
        (*self as u32) < 128 && (*self as u8).is_ascii_whitespace()
    }
    #[inline]
    pub fn is_ascii_punctuation(&self) -> bool {
        (*self as u32) < 128 && (*self as u8).is_ascii_punctuation()
    }

    #[inline]
    pub fn is_alphabetic(self) -> bool {
        (self >= 'a' && self <= 'z') || (self >= 'A' && self <= 'Z') || self as u32 > 127
    }
    #[inline]
    pub fn is_numeric(self) -> bool {
        self >= '0' && self <= '9'
    }
    #[inline]
    pub fn is_alphanumeric(self) -> bool {
        self.is_alphabetic() || self.is_numeric()
    }
    #[inline]
    pub fn is_ascii(&self) -> bool {
        (*self as u32) < 128
    }
    #[inline]
    pub fn is_ascii_digit(&self) -> bool {
        *self >= '0' && *self <= '9'
    }
    #[inline]
    pub fn to_ascii_uppercase(&self) -> char {
        if *self >= 'a' && *self <= 'z' {
            ((*self as u8) - 32) as char
        } else {
            *self
        }
    }
    #[inline]
    pub fn to_ascii_lowercase(&self) -> char {
        if *self >= 'A' && *self <= 'Z' {
            ((*self as u8) + 32) as char
        } else {
            *self
        }
    }

    pub fn to_digit(self, radix: u32) -> Option<u32> {
        let c = self as u32;
        let d = if c >= 48 && c <= 57 {
            c - 48
        } else if c >= 97 && c <= 122 {
            c - 97 + 10
        } else if c >= 65 && c <= 90 {
            c - 65 + 10
        } else {
            return None;
        };
        if d < radix { Some(d) } else { None }
    }

    pub fn len_utf8(self) -> usize {
        let c = self as u32;
        if c < 0x80 {
            1
        } else if c < 0x800 {
            2
        } else if c < 0x10000 {
            3
        } else {
            4
        }
    }
}

impl u8 {
    #[inline]
    pub fn is_ascii(&self) -> bool {
        *self < 128
    }
    #[inline]
    pub fn is_ascii_digit(&self) -> bool {
        *self >= b'0' && *self <= b'9'
    }
    #[inline]
    pub fn is_ascii_hexdigit(&self) -> bool {
        self.is_ascii_digit()
            || (*self >= b'a' && *self <= b'f')
            || (*self >= b'A' && *self <= b'F')
    }
    #[inline]
    pub fn is_ascii_uppercase(&self) -> bool {
        *self >= b'A' && *self <= b'Z'
    }
    #[inline]
    pub fn is_ascii_lowercase(&self) -> bool {
        *self >= b'a' && *self <= b'z'
    }
    #[inline]
    pub fn is_ascii_alphabetic(&self) -> bool {
        self.is_ascii_uppercase() || self.is_ascii_lowercase()
    }
    #[inline]
    pub fn is_ascii_alphanumeric(&self) -> bool {
        self.is_ascii_alphabetic() || self.is_ascii_digit()
    }
    #[inline]
    pub fn is_ascii_whitespace(&self) -> bool {
        *self == b' ' || *self == b'\t' || *self == b'\n' || *self == b'\r' || *self == 12
    }
    pub fn is_ascii_punctuation(&self) -> bool {
        (*self >= 33 && *self <= 47)
            || (*self >= 58 && *self <= 64)
            || (*self >= 91 && *self <= 96)
            || (*self >= 123 && *self <= 126)
    }
    #[inline]
    pub fn to_ascii_uppercase(&self) -> u8 {
        if self.is_ascii_lowercase() {
            *self - 32
        } else {
            *self
        }
    }
    #[inline]
    pub fn to_ascii_lowercase(&self) -> u8 {
        if self.is_ascii_uppercase() {
            *self + 32
        } else {
            *self
        }
    }
}

// ---------------------------------------------------------------------------

// Simple case mappings for Latin (ASCII, Latin-1, Extended-A and
// Additional), Greek, Cyrillic, Armenian and the fullwidth Latin letters;
// other characters map to themselves.

fn upper_of(c: u32) -> u32 {
    if c < 0x80 {
        return if c >= 0x61 && c <= 0x7A { c - 32 } else { c };
    }
    if c < 0x100 {
        if c == 0xB5 {
            return 0x39C;
        }
        if c == 0xFF {
            return 0x178;
        }
        return if c >= 0xE0 && c != 0xF7 { c - 32 } else { c };
    }
    if c < 0x180 {
        if c == 0x131 {
            return 0x49;
        }
        if c == 0x17F {
            return 0x53;
        }
        if (c <= 0x137 || (c >= 0x14A && c <= 0x177)) && c % 2 == 1 {
            return c - 1;
        }
        if ((c >= 0x139 && c <= 0x148) || (c >= 0x179 && c <= 0x17E)) && c % 2 == 0 {
            return c - 1;
        }
        return c;
    }
    if c >= 0x3AC && c <= 0x3CE {
        if c == 0x3AC {
            return 0x386;
        }
        if c <= 0x3AF {
            return c - 37;
        }
        if c == 0x3C2 {
            return 0x3A3;
        }
        if c >= 0x3B1 && c <= 0x3CB {
            return c - 32;
        }
        if c == 0x3CC {
            return 0x38C;
        }
        if c >= 0x3CD {
            return c - 63;
        }
        return c;
    }
    if c >= 0x430 && c <= 0x52F {
        if c <= 0x44F {
            return c - 32;
        }
        if c <= 0x45F {
            return c - 80;
        }
        if ((c >= 0x460 && c <= 0x481) || (c >= 0x48A && c <= 0x4BF) || c >= 0x4D0) && c % 2 == 1 {
            return c - 1;
        }
        if c >= 0x4C1 && c <= 0x4CE && c % 2 == 0 {
            return c - 1;
        }
        if c == 0x4CF {
            return 0x4C0;
        }
        return c;
    }
    if c >= 0x561 && c <= 0x586 {
        return c - 48;
    }
    if ((c >= 0x1E00 && c <= 0x1E95) || (c >= 0x1EA0 && c <= 0x1EFF)) && c % 2 == 1 {
        return c - 1;
    }
    if c >= 0xFF41 && c <= 0xFF5A {
        return c - 32;
    }
    c
}

fn lower_of(c: u32) -> u32 {
    if c < 0x80 {
        return if c >= 0x41 && c <= 0x5A { c + 32 } else { c };
    }
    if c < 0x100 {
        return if c >= 0xC0 && c <= 0xDE && c != 0xD7 {
            c + 32
        } else {
            c
        };
    }
    if c < 0x180 {
        if c == 0x178 {
            return 0xFF;
        }
        if (c <= 0x137 || (c >= 0x14A && c <= 0x177)) && c % 2 == 0 && c != 0x130 {
            return c + 1;
        }
        if ((c >= 0x139 && c <= 0x148) || (c >= 0x179 && c <= 0x17E)) && c % 2 == 1 {
            return c + 1;
        }
        return c;
    }
    if c >= 0x386 && c <= 0x3AB {
        if c == 0x386 {
            return 0x3AC;
        }
        if c >= 0x388 && c <= 0x38A {
            return c + 37;
        }
        if c == 0x38C {
            return 0x3CC;
        }
        if c == 0x38E || c == 0x38F {
            return c + 63;
        }
        if c >= 0x391 && c != 0x3A2 {
            return c + 32;
        }
        return c;
    }
    if c >= 0x400 && c <= 0x52F {
        if c <= 0x40F {
            return c + 80;
        }
        if c <= 0x42F {
            return c + 32;
        }
        if ((c >= 0x460 && c <= 0x481) || (c >= 0x48A && c <= 0x4BF) || c >= 0x4D0) && c % 2 == 0 {
            return c + 1;
        }
        if c >= 0x4C1 && c <= 0x4CE && c % 2 == 1 {
            return c + 1;
        }
        if c == 0x4C0 {
            return 0x4CF;
        }
        return c;
    }
    if c >= 0x531 && c <= 0x556 {
        return c + 48;
    }
    if c == 0x1E9E {
        return 0xDF;
    }
    if ((c >= 0x1E00 && c <= 0x1E95) || (c >= 0x1EA0 && c <= 0x1EFF)) && c % 2 == 0 {
        return c + 1;
    }
    if c >= 0xFF21 && c <= 0xFF3A {
        return c + 32;
    }
    c
}

/// The iterator of char::to_uppercase (one to three chars).
pub struct ToUppercase {
    c: [char; 3],
    i: usize,
    n: usize,
}

/// The iterator of char::to_lowercase (one or two chars).
pub struct ToLowercase {
    c: [char; 3],
    i: usize,
    n: usize,
}

impl Iterator for ToUppercase {
    type Item = char;
    fn next(&mut self) -> Option<char> {
        if self.i < self.n {
            self.i += 1;
            Some(self.c[self.i - 1])
        } else {
            None
        }
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        (self.n - self.i, Some(self.n - self.i))
    }
}
impl DoubleEndedIterator for ToUppercase {
    fn next_back(&mut self) -> Option<char> {
        if self.i < self.n {
            self.n -= 1;
            Some(self.c[self.n])
        } else {
            None
        }
    }
}
impl ExactSizeIterator for ToUppercase {}
impl crate::fmt::Display for ToUppercase {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        let mut s = crate::string::String::new();
        let mut i = self.i;
        while i < self.n {
            s.push(self.c[i]);
            i += 1;
        }
        f.write_str(s.as_str())
    }
}

impl Iterator for ToLowercase {
    type Item = char;
    fn next(&mut self) -> Option<char> {
        if self.i < self.n {
            self.i += 1;
            Some(self.c[self.i - 1])
        } else {
            None
        }
    }
    fn size_hint(&self) -> (usize, Option<usize>) {
        (self.n - self.i, Some(self.n - self.i))
    }
}
impl DoubleEndedIterator for ToLowercase {
    fn next_back(&mut self) -> Option<char> {
        if self.i < self.n {
            self.n -= 1;
            Some(self.c[self.n])
        } else {
            None
        }
    }
}
impl ExactSizeIterator for ToLowercase {}
impl crate::fmt::Display for ToLowercase {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        let mut s = crate::string::String::new();
        let mut i = self.i;
        while i < self.n {
            s.push(self.c[i]);
            i += 1;
        }
        f.write_str(s.as_str())
    }
}

fn char_of(c: u32) -> char {
    unsafe { *(&c as *const u32 as *const char) }
}

impl char {
    pub const MIN: char = '\0';
    pub const REPLACEMENT_CHARACTER: char = '\u{FFFD}';

    #[inline]
    pub unsafe fn from_u32_unchecked(i: u32) -> char {
        char_of(i)
    }

    #[inline]
    pub fn is_digit(self, radix: u32) -> bool {
        self.to_digit(radix).is_some()
    }
    #[inline]
    pub fn is_ascii_uppercase(&self) -> bool {
        *self >= 'A' && *self <= 'Z'
    }
    #[inline]
    pub fn is_ascii_lowercase(&self) -> bool {
        *self >= 'a' && *self <= 'z'
    }
    #[inline]
    pub fn is_ascii_graphic(&self) -> bool {
        *self >= '!' && *self <= '~'
    }
    #[inline]
    pub fn is_ascii_control(&self) -> bool {
        (*self as u32) < 32 || *self as u32 == 127
    }
    #[inline]
    pub fn is_control(self) -> bool {
        let c = self as u32;
        c < 32 || (c >= 127 && c < 160)
    }
    #[inline]
    pub fn eq_ignore_ascii_case(&self, other: &char) -> bool {
        self.to_ascii_lowercase() == other.to_ascii_lowercase()
    }
    #[inline]
    pub fn make_ascii_uppercase(&mut self) {
        *self = self.to_ascii_uppercase();
    }
    #[inline]
    pub fn make_ascii_lowercase(&mut self) {
        *self = self.to_ascii_lowercase();
    }

    /// The uppercase form (one to three chars; see the module comment for
    /// the scripts covered).
    pub fn to_uppercase(self) -> ToUppercase {
        let c = self as u32;
        if c == 0xDF {
            return ToUppercase {
                c: ['S', 'S', '\0'],
                i: 0,
                n: 2,
            };
        }
        ToUppercase {
            c: [char_of(upper_of(c)), '\0', '\0'],
            i: 0,
            n: 1,
        }
    }

    pub fn to_lowercase(self) -> ToLowercase {
        let c = self as u32;
        if c == 0x130 {
            return ToLowercase {
                c: ['i', '\u{307}', '\0'],
                i: 0,
                n: 2,
            };
        }
        ToLowercase {
            c: [char_of(lower_of(c)), '\0', '\0'],
            i: 0,
            n: 1,
        }
    }

    /// Whether the char has the White_Space property.
    pub fn is_whitespace(self) -> bool {
        let c = self as u32;
        if c < 0x80 {
            return c == 0x20 || (c >= 0x09 && c <= 0x0D);
        }
        c == 0x85
            || c == 0xA0
            || c == 0x1680
            || (c >= 0x2000 && c <= 0x200A)
            || c == 0x2028
            || c == 0x2029
            || c == 0x202F
            || c == 0x205F
            || c == 0x3000
    }
    pub fn is_uppercase(self) -> bool {
        let c = self as u32;
        if c < 0x80 {
            return c >= 0x41 && c <= 0x5A;
        }
        c == 0x130 || lower_of(c) != c
    }
    pub fn is_lowercase(self) -> bool {
        let c = self as u32;
        if c < 0x80 {
            return c >= 0x61 && c <= 0x7A;
        }
        c == 0xDF || upper_of(c) != c
    }

    #[inline]
    pub fn len_utf16(self) -> usize {
        if (self as u32) < 0x10000 { 1 } else { 2 }
    }

    /// Writes the UTF-8 encoding into dst and returns it as a str.
    pub fn encode_utf8(self, dst: &mut [u8]) -> &mut str {
        let n = self.len_utf8();
        if dst.len() < n {
            panic(
                `encode_utf8: need ${n} bytes to encode U+${self as u32:X}, but the buffer has ${dst.len()}`,
            );
        }
        let v = self as u32;
        if n == 1 {
            dst[0] = v as u8;
        } else if n == 2 {
            dst[0] = (0xC0 | (v >> 6)) as u8;
            dst[1] = (0x80 | (v & 0x3F)) as u8;
        } else if n == 3 {
            dst[0] = (0xE0 | (v >> 12)) as u8;
            dst[1] = (0x80 | ((v >> 6) & 0x3F)) as u8;
            dst[2] = (0x80 | (v & 0x3F)) as u8;
        } else {
            dst[0] = (0xF0 | (v >> 18)) as u8;
            dst[1] = (0x80 | ((v >> 12) & 0x3F)) as u8;
            dst[2] = (0x80 | ((v >> 6) & 0x3F)) as u8;
            dst[3] = (0x80 | (v & 0x3F)) as u8;
        }
        let s = crate::rt::str_from_raw(crate::rt::slice_ptr(dst), n);
        unsafe { *(&s as *const &str as *const &mut str) }
    }
}

impl u8 {
    #[inline]
    pub fn is_ascii_graphic(&self) -> bool {
        *self >= 33 && *self <= 126
    }
    #[inline]
    pub fn is_ascii_control(&self) -> bool {
        *self < 32 || *self == 127
    }
    #[inline]
    pub fn eq_ignore_ascii_case(&self, other: &u8) -> bool {
        self.to_ascii_lowercase() == other.to_ascii_lowercase()
    }
    #[inline]
    pub fn make_ascii_uppercase(&mut self) {
        *self = self.to_ascii_uppercase();
    }
    #[inline]
    pub fn make_ascii_lowercase(&mut self) {
        *self = self.to_ascii_lowercase();
    }
}

impl From<u8> for char {
    fn from(b: u8) -> char {
        char_of(b as u32)
    }
}
impl From<char> for u32 {
    fn from(c: char) -> u32 {
        c as u32
    }
}
impl From<char> for u64 {
    fn from(c: char) -> u64 {
        c as u64
    }
}
impl From<char> for u128 {
    fn from(c: char) -> u128 {
        c as u32 as u128
    }
}

/// The error of char::try_from(u32).
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct CharTryFromError;

impl crate::fmt::Display for CharTryFromError {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        f.pad("converted integer out of range for `char`")
    }
}

impl TryFrom<u32> for char {
    type Error = CharTryFromError;
    fn try_from(i: u32) -> Result<char, CharTryFromError> {
        match char::from_u32(i) {
            Some(c) => Ok(c),
            None => Err(CharTryFromError),
        }
    }
}

/// The error of u8::try_from(char).
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct TryFromCharError;

impl TryFrom<char> for u8 {
    type Error = TryFromCharError;
    fn try_from(c: char) -> Result<u8, TryFromCharError> {
        if (c as u32) < 256 {
            Ok(c as u32 as u8)
        } else {
            Err(TryFromCharError)
        }
    }
}

/// Why a string is not one char.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct ParseCharError {
    empty: bool,
}

impl crate::fmt::Display for ParseCharError {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        f.pad(if self.empty {
            "cannot parse char from empty string"
        } else {
            "too many characters in string"
        })
    }
}

/// A string of exactly one char.
impl crate::str::FromStr for char {
    type Err = ParseCharError;
    fn from_str(s: &str) -> Result<char, ParseCharError> {
        let mut cs = s.chars();
        match (cs.next(), cs.next()) {
            (Some(c), None) => Ok(c),
            (None, _) => Err(ParseCharError { empty: true }),
            _ => Err(ParseCharError { empty: false }),
        }
    }
}
