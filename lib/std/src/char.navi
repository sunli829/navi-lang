//! The char type. Classification is ASCII-only in this version; Unicode
//! tables come with the full standard library.

impl char {
    pub fn is_alphabetic(self) -> bool { (self >= 'a' && self <= 'z') || (self >= 'A' && self <= 'Z') || self as u32 > 127 }
    pub fn is_numeric(self) -> bool { self >= '0' && self <= '9' }
    pub fn is_alphanumeric(self) -> bool { self.is_alphabetic() || self.is_numeric() }
    pub fn is_whitespace(self) -> bool { self == ' ' || self == '\t' || self == '\n' || self == '\r' }
    pub fn is_uppercase(self) -> bool { self >= 'A' && self <= 'Z' }
    pub fn is_lowercase(self) -> bool { self >= 'a' && self <= 'z' }
    pub fn is_ascii(&self) -> bool { (*self as u32) < 128 }
    pub fn is_ascii_digit(&self) -> bool { *self >= '0' && *self <= '9' }
    pub fn to_ascii_uppercase(&self) -> char { if self.is_lowercase() { ((*self as u8) - 32) as char } else { *self } }
    pub fn to_ascii_lowercase(&self) -> char { if self.is_uppercase() { ((*self as u8) + 32) as char } else { *self } }

    pub fn to_digit(self, radix: u32) -> Option<u32> {
        let c = self as u32;
        let d = if c >= 48 && c <= 57 {
            c - 48
        } else if c >= 97 && c <= 122 {
            c - 97 + 10
        } else if c >= 65 && c <= 90 {
            c - 65 + 10
        } else {
            return None;
        };
        if d < radix { Some(d) } else { None }
    }

    pub fn len_utf8(self) -> usize {
        let c = self as u32;
        if c < 0x80 { 1 } else if c < 0x800 { 2 } else if c < 0x10000 { 3 } else { 4 }
    }
}
