//! Utilities for the `char` primitive type, and the ASCII methods of `u8`.
//!
//! A `char` is a Unicode scalar value (any code point except the
//! surrogates `U+D800` to `U+DFFF`), stored in 4 bytes.
//!
//! Unicode support is partial in this version (see spec/std-diff.md):
//!
//! - `char::is_whitespace` follows Unicode's White_Space property.
//! - Case mapping (`char::to_uppercase`, `char::to_lowercase`,
//!   `char::is_uppercase`, `char::is_lowercase`) covers Latin (ASCII,
//!   Latin-1, Extended-A, Extended Additional), Greek, Cyrillic, Armenian
//!   and the fullwidth Latin letters (plus `ß` to `SS` and `İ` to `i̇`);
//!   other characters map to themselves.
//! - `char::is_alphabetic` is true for ASCII letters and for every
//!   non-ASCII character; `char::is_numeric` only for the ASCII digits.
//! - The `is_ascii_*` methods are exact.
//!
//! # Examples
//!
//! ```
//! let c = 'ß';
//! assert_eq(c.len_utf8(), 2);
//! assert_eq(c.to_uppercase().to_string(), "SS");
//! assert_eq('7'.to_digit(10), Some(7));
//! assert(b'a'.is_ascii_lowercase());
//! ```

impl char {
    /// The highest valid code point a `char` can have, `'\u{10FFFF}'`.
    ///
    /// # Examples
    ///
    /// ```
    /// let c: u32 = char::MAX as u32;
    /// assert_eq(c, 0x10FFFF);
    /// assert(char::from_u32(c + 1).is_none());
    /// ```
    pub const MAX: char = '\u{10FFFF}';

    /// Converts a `u32` to a `char`.
    ///
    /// Not all `u32`s are valid `char`s: this returns [`None`] if the input is
    /// not a valid `char` (a surrogate, or greater than `char::MAX`).
    ///
    /// # Examples
    ///
    /// ```
    /// let c = char::from_u32(0x2764);
    /// assert_eq(Some('❤'), c);
    ///
    /// // Surrogates are not chars.
    /// assert_eq(None, char::from_u32(0xD800));
    /// assert_eq(None, char::from_u32(0x110000));
    /// ```
    pub fn from_u32(i: u32) -> Option<char> {
        if i > 0x10FFFF || (i >= 0xD800 && i <= 0xDFFF) {
            None
        } else {
            Some(unsafe { *(&i as *const u32 as *const char) })
        }
    }

    /// Converts a digit in the given radix to a `char`.
    ///
    /// A 'radix' here is sometimes also called a 'base'. A radix of two
    /// indicates a binary number, a radix of ten, decimal, and a radix of
    /// sixteen, hexadecimal, to give some common values. Digits above 9 are
    /// lowercase letters.
    ///
    /// `from_digit()` will return `None` if the input is not a digit in the
    /// given radix. (Unlike Rust's, it does not panic for a radix above 36;
    /// keep the radix in 2..=36.)
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(char::from_digit(4, 10), Some('4'));
    /// assert_eq(char::from_digit(11, 16), Some('b'));
    /// // Returns None: 20 is not a digit in base 10.
    /// assert_eq(char::from_digit(20, 10), None);
    /// ```
    pub fn from_digit(num: u32, radix: u32) -> Option<char> {
        if num >= radix {
            return None;
        }
        if num < 10 {
            Some((b'0' + num as u8) as char)
        } else {
            Some((b'a' + (num - 10) as u8) as char)
        }
    }

    /// Checks if the value is an ASCII hexadecimal digit: `0-9`, `A-F` or
    /// `a-f`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert('A'.is_ascii_hexdigit());
    /// assert('f'.is_ascii_hexdigit());
    /// assert('9'.is_ascii_hexdigit());
    /// assert(!'g'.is_ascii_hexdigit());
    /// assert(!'%'.is_ascii_hexdigit());
    /// ```
    #[inline]
    pub fn is_ascii_hexdigit(&self) -> bool {
        (*self as u32) < 128 && (*self as u8).is_ascii_hexdigit()
    }

    /// Checks if the value is an ASCII alphabetic character: `A-Z` or `a-z`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert('A'.is_ascii_alphabetic());
    /// assert('g'.is_ascii_alphabetic());
    /// assert(!'0'.is_ascii_alphabetic());
    /// assert(!'é'.is_ascii_alphabetic());
    /// ```
    #[inline]
    pub fn is_ascii_alphabetic(&self) -> bool {
        (*self as u32) < 128 && (*self as u8).is_ascii_alphabetic()
    }

    /// Checks if the value is an ASCII alphanumeric character: `A-Z`, `a-z`
    /// or `0-9`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert('A'.is_ascii_alphanumeric());
    /// assert('0'.is_ascii_alphanumeric());
    /// assert(!'%'.is_ascii_alphanumeric());
    /// assert(!' '.is_ascii_alphanumeric());
    /// ```
    #[inline]
    pub fn is_ascii_alphanumeric(&self) -> bool {
        (*self as u32) < 128 && (*self as u8).is_ascii_alphanumeric()
    }

    /// Checks if the value is an ASCII whitespace character: space, horizontal
    /// tab, line feed, form feed or carriage return (as Rust's, vertical tab is
    /// not included).
    ///
    /// # Examples
    ///
    /// ```
    /// assert(' '.is_ascii_whitespace());
    /// assert('\n'.is_ascii_whitespace());
    /// assert('\t'.is_ascii_whitespace());
    /// assert(!'a'.is_ascii_whitespace());
    /// assert(!'\u{A0}'.is_ascii_whitespace());
    /// ```
    #[inline]
    pub fn is_ascii_whitespace(&self) -> bool {
        (*self as u32) < 128 && (*self as u8).is_ascii_whitespace()
    }

    /// Checks if the value is an ASCII punctuation character:
    /// ``! " # $ % & ' ( ) * + , - . /``, `: ; < = > ? @`,
    /// ``[ \ ] ^ _ ` `` or `{ | } ~`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert('%'.is_ascii_punctuation());
    /// assert('~'.is_ascii_punctuation());
    /// assert(!'a'.is_ascii_punctuation());
    /// assert(!' '.is_ascii_punctuation());
    /// ```
    #[inline]
    pub fn is_ascii_punctuation(&self) -> bool {
        (*self as u32) < 128 && (*self as u8).is_ascii_punctuation()
    }

    /// Returns `true` if this `char` is alphabetic.
    ///
    /// In this version that means an ASCII letter (`A-Z`, `a-z`) or any
    /// non-ASCII character (Rust checks Unicode's Alphabetic property; navi
    /// has no Unicode tables here yet), so non-ASCII symbols count as
    /// alphabetic too.
    ///
    /// # Examples
    ///
    /// ```
    /// assert('a'.is_alphabetic());
    /// assert('京'.is_alphabetic());
    /// assert(!'1'.is_alphabetic());
    /// assert(!'&'.is_alphabetic());
    /// ```
    #[inline]
    pub fn is_alphabetic(self) -> bool {
        (self >= 'a' && self <= 'z') || (self >= 'A' && self <= 'Z') || self as u32 > 127
    }

    /// Returns `true` if this `char` is numeric.
    ///
    /// In this version that means an ASCII digit `0-9` (Rust checks the
    /// Unicode Numeric categories, so `'½'` and `'٣'` are numeric there).
    ///
    /// # Examples
    ///
    /// ```
    /// assert('7'.is_numeric());
    /// assert(!'K'.is_numeric());
    /// ```
    #[inline]
    pub fn is_numeric(self) -> bool {
        self >= '0' && self <= '9'
    }

    /// Returns `true` if this `char` satisfies either
    /// `char::is_alphabetic` or `char::is_numeric`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert('a'.is_alphanumeric());
    /// assert('7'.is_alphanumeric());
    /// assert(!'_'.is_alphanumeric());
    /// ```
    #[inline]
    pub fn is_alphanumeric(self) -> bool {
        self.is_alphabetic() || self.is_numeric()
    }

    /// Checks if the value is within the ASCII range (below 128).
    ///
    /// # Examples
    ///
    /// ```
    /// let ascii = 'a';
    /// let non_ascii = '❤';
    ///
    /// assert(ascii.is_ascii());
    /// assert(!non_ascii.is_ascii());
    /// ```
    #[inline]
    pub fn is_ascii(&self) -> bool {
        (*self as u32) < 128
    }

    /// Checks if the value is an ASCII decimal digit: `0-9`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert('0'.is_ascii_digit());
    /// assert('9'.is_ascii_digit());
    /// assert(!'a'.is_ascii_digit());
    /// ```
    #[inline]
    pub fn is_ascii_digit(&self) -> bool {
        *self >= '0' && *self <= '9'
    }

    /// Makes a copy of the value in its ASCII upper case equivalent.
    ///
    /// ASCII letters 'a' to 'z' are mapped to 'A' to 'Z', but non-ASCII
    /// letters are unchanged. To uppercase the value in-place, use
    /// `char::make_ascii_uppercase`; to uppercase non-ASCII characters too,
    /// use `char::to_uppercase`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq('a'.to_ascii_uppercase(), 'A');
    /// assert_eq('A'.to_ascii_uppercase(), 'A');
    /// assert_eq('❤'.to_ascii_uppercase(), '❤');
    /// ```
    #[inline]
    pub fn to_ascii_uppercase(&self) -> char {
        if *self >= 'a' && *self <= 'z' {
            ((*self as u8) - 32) as char
        } else {
            *self
        }
    }

    /// Makes a copy of the value in its ASCII lower case equivalent.
    ///
    /// ASCII letters 'A' to 'Z' are mapped to 'a' to 'z', but non-ASCII
    /// letters are unchanged. To lowercase the value in-place, use
    /// `char::make_ascii_lowercase`; to lowercase non-ASCII characters too,
    /// use `char::to_lowercase`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq('A'.to_ascii_lowercase(), 'a');
    /// assert_eq('a'.to_ascii_lowercase(), 'a');
    /// assert_eq('❤'.to_ascii_lowercase(), '❤');
    /// ```
    #[inline]
    pub fn to_ascii_lowercase(&self) -> char {
        if *self >= 'A' && *self <= 'Z' {
            ((*self as u8) + 32) as char
        } else {
            *self
        }
    }

    /// Converts a `char` to a digit in the given radix.
    ///
    /// 'Digit' is defined to be only the following characters: `0-9`, `a-z`,
    /// `A-Z` (letters are the digits from 10 up).
    ///
    /// Returns `None` if the `char` does not refer to a digit in the given
    /// radix. (Unlike Rust's, it does not panic for a radix above 36.)
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq('1'.to_digit(10), Some(1));
    /// assert_eq('f'.to_digit(16), Some(15));
    /// assert_eq('F'.to_digit(16), Some(15));
    /// assert_eq('z'.to_digit(16), None);
    /// assert_eq('a'.to_digit(10), None);
    /// ```
    pub fn to_digit(self, radix: u32) -> Option<u32> {
        let c = self as u32;
        let d = if c >= 48 && c <= 57 {
            c - 48
        } else if c >= 97 && c <= 122 {
            c - 97 + 10
        } else if c >= 65 && c <= 90 {
            c - 65 + 10
        } else {
            return None;
        };
        if d < radix { Some(d) } else { None }
    }

    /// Returns the number of bytes this `char` would need if encoded in UTF-8.
    ///
    /// That number of bytes is always between 1 and 4, inclusive.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq('A'.len_utf8(), 1);
    /// assert_eq('ß'.len_utf8(), 2);
    /// assert_eq('ℝ'.len_utf8(), 3);
    /// assert_eq('💣'.len_utf8(), 4);
    /// ```
    pub fn len_utf8(self) -> usize {
        let c = self as u32;
        if c < 0x80 {
            1
        } else if c < 0x800 {
            2
        } else if c < 0x10000 {
            3
        } else {
            4
        }
    }
}

impl u8 {
    /// Checks if the value is within the ASCII range (below 128).
    ///
    /// # Examples
    ///
    /// ```
    /// assert(b'a'.is_ascii());
    /// assert(!0xE2u8.is_ascii());
    /// ```
    #[inline]
    pub fn is_ascii(&self) -> bool {
        *self < 128
    }

    /// Checks if the value is an ASCII decimal digit: `0-9`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(b'7'.is_ascii_digit());
    /// assert(!b'a'.is_ascii_digit());
    /// ```
    #[inline]
    pub fn is_ascii_digit(&self) -> bool {
        *self >= b'0' && *self <= b'9'
    }

    /// Checks if the value is an ASCII hexadecimal digit: `0-9`, `A-F` or
    /// `a-f`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(b'F'.is_ascii_hexdigit());
    /// assert(!b'g'.is_ascii_hexdigit());
    /// ```
    #[inline]
    pub fn is_ascii_hexdigit(&self) -> bool {
        self.is_ascii_digit()
            || (*self >= b'a' && *self <= b'f')
            || (*self >= b'A' && *self <= b'F')
    }

    /// Checks if the value is an ASCII uppercase character: `A-Z`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(b'G'.is_ascii_uppercase());
    /// assert(!b'g'.is_ascii_uppercase());
    /// ```
    #[inline]
    pub fn is_ascii_uppercase(&self) -> bool {
        *self >= b'A' && *self <= b'Z'
    }

    /// Checks if the value is an ASCII lowercase character: `a-z`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(b'g'.is_ascii_lowercase());
    /// assert(!b'G'.is_ascii_lowercase());
    /// ```
    #[inline]
    pub fn is_ascii_lowercase(&self) -> bool {
        *self >= b'a' && *self <= b'z'
    }

    /// Checks if the value is an ASCII alphabetic character: `A-Z` or `a-z`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(b'A'.is_ascii_alphabetic());
    /// assert(!b'1'.is_ascii_alphabetic());
    /// ```
    #[inline]
    pub fn is_ascii_alphabetic(&self) -> bool {
        self.is_ascii_uppercase() || self.is_ascii_lowercase()
    }

    /// Checks if the value is an ASCII alphanumeric character: `A-Z`, `a-z`
    /// or `0-9`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(b'1'.is_ascii_alphanumeric());
    /// assert(!b'%'.is_ascii_alphanumeric());
    /// ```
    #[inline]
    pub fn is_ascii_alphanumeric(&self) -> bool {
        self.is_ascii_alphabetic() || self.is_ascii_digit()
    }

    /// Checks if the value is an ASCII whitespace character: space, horizontal
    /// tab, line feed, form feed or carriage return.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(b' '.is_ascii_whitespace());
    /// assert(b'\n'.is_ascii_whitespace());
    /// assert(!b'a'.is_ascii_whitespace());
    /// ```
    #[inline]
    pub fn is_ascii_whitespace(&self) -> bool {
        *self == b' ' || *self == b'\t' || *self == b'\n' || *self == b'\r' || *self == 12
    }

    /// Checks if the value is an ASCII punctuation character.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(b'%'.is_ascii_punctuation());
    /// assert(!b'a'.is_ascii_punctuation());
    /// ```
    pub fn is_ascii_punctuation(&self) -> bool {
        (*self >= 33 && *self <= 47)
            || (*self >= 58 && *self <= 64)
            || (*self >= 91 && *self <= 96)
            || (*self >= 123 && *self <= 126)
    }

    /// Makes a copy of the value in its ASCII upper case equivalent.
    ///
    /// ASCII letters 'a' to 'z' are mapped to 'A' to 'Z', but non-ASCII
    /// letters are unchanged.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(b'a'.to_ascii_uppercase(), b'A');
    /// assert_eq(b'1'.to_ascii_uppercase(), b'1');
    /// ```
    #[inline]
    pub fn to_ascii_uppercase(&self) -> u8 {
        if self.is_ascii_lowercase() {
            *self - 32
        } else {
            *self
        }
    }

    /// Makes a copy of the value in its ASCII lower case equivalent.
    ///
    /// ASCII letters 'A' to 'Z' are mapped to 'a' to 'z', but non-ASCII
    /// letters are unchanged.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(b'A'.to_ascii_lowercase(), b'a');
    /// assert_eq(b'1'.to_ascii_lowercase(), b'1');
    /// ```
    #[inline]
    pub fn to_ascii_lowercase(&self) -> u8 {
        if self.is_ascii_uppercase() {
            *self + 32
        } else {
            *self
        }
    }
}

// ---------------------------------------------------------------------------

// Simple case mappings for Latin (ASCII, Latin-1, Extended-A and
// Additional), Greek, Cyrillic, Armenian and the fullwidth Latin letters;
// other characters map to themselves.

fn upper_of(c: u32) -> u32 {
    if c < 0x80 {
        return if c >= 0x61 && c <= 0x7A { c - 32 } else { c };
    }
    if c < 0x100 {
        if c == 0xB5 {
            return 0x39C;
        }
        if c == 0xFF {
            return 0x178;
        }
        return if c >= 0xE0 && c != 0xF7 { c - 32 } else { c };
    }
    if c < 0x180 {
        if c == 0x131 {
            return 0x49;
        }
        if c == 0x17F {
            return 0x53;
        }
        if (c <= 0x137 || (c >= 0x14A && c <= 0x177)) && c % 2 == 1 {
            return c - 1;
        }
        if ((c >= 0x139 && c <= 0x148) || (c >= 0x179 && c <= 0x17E)) && c % 2 == 0 {
            return c - 1;
        }
        return c;
    }
    if c >= 0x3AC && c <= 0x3CE {
        if c == 0x3AC {
            return 0x386;
        }
        if c <= 0x3AF {
            return c - 37;
        }
        if c == 0x3C2 {
            return 0x3A3;
        }
        if c >= 0x3B1 && c <= 0x3CB {
            return c - 32;
        }
        if c == 0x3CC {
            return 0x38C;
        }
        if c >= 0x3CD {
            return c - 63;
        }
        return c;
    }
    if c >= 0x430 && c <= 0x52F {
        if c <= 0x44F {
            return c - 32;
        }
        if c <= 0x45F {
            return c - 80;
        }
        if ((c >= 0x460 && c <= 0x481) || (c >= 0x48A && c <= 0x4BF) || c >= 0x4D0) && c % 2 == 1 {
            return c - 1;
        }
        if c >= 0x4C1 && c <= 0x4CE && c % 2 == 0 {
            return c - 1;
        }
        if c == 0x4CF {
            return 0x4C0;
        }
        return c;
    }
    if c >= 0x561 && c <= 0x586 {
        return c - 48;
    }
    if ((c >= 0x1E00 && c <= 0x1E95) || (c >= 0x1EA0 && c <= 0x1EFF)) && c % 2 == 1 {
        return c - 1;
    }
    if c >= 0xFF41 && c <= 0xFF5A {
        return c - 32;
    }
    c
}

fn lower_of(c: u32) -> u32 {
    if c < 0x80 {
        return if c >= 0x41 && c <= 0x5A { c + 32 } else { c };
    }
    if c < 0x100 {
        return if c >= 0xC0 && c <= 0xDE && c != 0xD7 {
            c + 32
        } else {
            c
        };
    }
    if c < 0x180 {
        if c == 0x178 {
            return 0xFF;
        }
        if (c <= 0x137 || (c >= 0x14A && c <= 0x177)) && c % 2 == 0 && c != 0x130 {
            return c + 1;
        }
        if ((c >= 0x139 && c <= 0x148) || (c >= 0x179 && c <= 0x17E)) && c % 2 == 1 {
            return c + 1;
        }
        return c;
    }
    if c >= 0x386 && c <= 0x3AB {
        if c == 0x386 {
            return 0x3AC;
        }
        if c >= 0x388 && c <= 0x38A {
            return c + 37;
        }
        if c == 0x38C {
            return 0x3CC;
        }
        if c == 0x38E || c == 0x38F {
            return c + 63;
        }
        if c >= 0x391 && c != 0x3A2 {
            return c + 32;
        }
        return c;
    }
    if c >= 0x400 && c <= 0x52F {
        if c <= 0x40F {
            return c + 80;
        }
        if c <= 0x42F {
            return c + 32;
        }
        if ((c >= 0x460 && c <= 0x481) || (c >= 0x48A && c <= 0x4BF) || c >= 0x4D0) && c % 2 == 0 {
            return c + 1;
        }
        if c >= 0x4C1 && c <= 0x4CE && c % 2 == 1 {
            return c + 1;
        }
        if c == 0x4C0 {
            return 0x4CF;
        }
        return c;
    }
    if c >= 0x531 && c <= 0x556 {
        return c + 48;
    }
    if c == 0x1E9E {
        return 0xDF;
    }
    if ((c >= 0x1E00 && c <= 0x1E95) || (c >= 0x1EA0 && c <= 0x1EFF)) && c % 2 == 0 {
        return c + 1;
    }
    if c >= 0xFF21 && c <= 0xFF3A {
        return c + 32;
    }
    c
}

/// Returns an iterator that yields the uppercase equivalent of a `char`.
///
/// This `struct` is created by the `char::to_uppercase` method. It
/// yields one to three chars, and displays as them.
///
/// # Examples
///
/// ```
/// let up = 'ß'.to_uppercase();
/// assert_eq(up.len(), 2);
/// assert_eq(up.to_string(), "SS");
/// let v: Vec<char> = 'a'.to_uppercase().collect();
/// assert_eq(v, ['A']);
/// ```
pub struct ToUppercase {
    c: [char; 3],
    i: usize,
    n: usize,
}

/// Returns an iterator that yields the lowercase equivalent of a `char`.
///
/// This `struct` is created by the `char::to_lowercase` method. It
/// yields one or two chars, and displays as them.
///
/// # Examples
///
/// ```
/// assert_eq('İ'.to_lowercase().to_string(), "i\u{307}");
/// assert_eq('Ω'.to_lowercase().next(), Some('ω'));
/// ```
pub struct ToLowercase {
    c: [char; 3],
    i: usize,
    n: usize,
}

impl Iterator for ToUppercase {
    type Item = char;
    fn next(&mut self) -> Option<char> {
        if self.i < self.n {
            self.i += 1;
            Some(self.c[self.i - 1])
        } else {
            None
        }
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        (self.n - self.i, Some(self.n - self.i))
    }
}

impl DoubleEndedIterator for ToUppercase {
    fn next_back(&mut self) -> Option<char> {
        if self.i < self.n {
            self.n -= 1;
            Some(self.c[self.n])
        } else {
            None
        }
    }
}

impl ExactSizeIterator for ToUppercase {}
impl crate::fmt::Display for ToUppercase {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        let mut s = crate::string::String::new();
        let mut i = self.i;
        while i < self.n {
            s.push(self.c[i]);
            i += 1;
        }
        f.write_str(s.as_str())
    }
}

impl Iterator for ToLowercase {
    type Item = char;
    fn next(&mut self) -> Option<char> {
        if self.i < self.n {
            self.i += 1;
            Some(self.c[self.i - 1])
        } else {
            None
        }
    }

    fn size_hint(&self) -> (usize, Option<usize>) {
        (self.n - self.i, Some(self.n - self.i))
    }
}

impl DoubleEndedIterator for ToLowercase {
    fn next_back(&mut self) -> Option<char> {
        if self.i < self.n {
            self.n -= 1;
            Some(self.c[self.n])
        } else {
            None
        }
    }
}

impl ExactSizeIterator for ToLowercase {}
impl crate::fmt::Display for ToLowercase {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        let mut s = crate::string::String::new();
        let mut i = self.i;
        while i < self.n {
            s.push(self.c[i]);
            i += 1;
        }
        f.write_str(s.as_str())
    }
}

fn char_of(c: u32) -> char {
    unsafe { *(&c as *const u32 as *const char) }
}

impl char {
    /// The lowest valid code point a `char` can have, `'\0'`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(char::MIN as u32, 0);
    /// ```
    pub const MIN: char = '\0';
    /// `U+FFFD REPLACEMENT CHARACTER` (�) is used in Unicode to represent a
    /// decoding error.
    ///
    /// It can occur, for example, when giving ill-formed UTF-8 bytes to
    /// [`String::from_utf8_lossy`](crate::string::String::from_utf8_lossy).
    ///
    /// # Examples
    ///
    /// ```
    /// let s = String::from_utf8_lossy(&[b'a', 0xFF]);
    /// assert_eq(s.chars().last(), Some(char::REPLACEMENT_CHARACTER));
    /// ```
    pub const REPLACEMENT_CHARACTER: char = '\u{FFFD}';

    /// Converts a `u32` to a `char`, ignoring validity.
    ///
    /// # Safety
    ///
    /// This function is unsafe, as it may construct invalid `char` values:
    /// `i` must be a valid Unicode scalar value (see `char::from_u32`).
    ///
    /// # Examples
    ///
    /// ```
    /// let c = unsafe { char::from_u32_unchecked(0x2764) };
    /// assert_eq('❤', c);
    /// ```
    #[inline]
    pub unsafe fn from_u32_unchecked(i: u32) -> char {
        char_of(i)
    }

    /// Checks if a `char` is a digit in the given radix.
    ///
    /// A 'radix' here is sometimes also called a 'base'. Digits are `0-9`,
    /// then the letters `a-z` / `A-Z` for 10 and up (see `char::to_digit`).
    ///
    /// # Examples
    ///
    /// ```
    /// assert('1'.is_digit(10));
    /// assert('f'.is_digit(16));
    /// assert(!'f'.is_digit(10));
    /// ```
    #[inline]
    pub fn is_digit(self, radix: u32) -> bool {
        self.to_digit(radix).is_some()
    }

    /// Checks if the value is an ASCII uppercase character: `A-Z`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert('A'.is_ascii_uppercase());
    /// assert(!'a'.is_ascii_uppercase());
    /// assert(!'Ä'.is_ascii_uppercase());
    /// ```
    #[inline]
    pub fn is_ascii_uppercase(&self) -> bool {
        *self >= 'A' && *self <= 'Z'
    }

    /// Checks if the value is an ASCII lowercase character: `a-z`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert('a'.is_ascii_lowercase());
    /// assert(!'A'.is_ascii_lowercase());
    /// assert(!'ä'.is_ascii_lowercase());
    /// ```
    #[inline]
    pub fn is_ascii_lowercase(&self) -> bool {
        *self >= 'a' && *self <= 'z'
    }

    /// Checks if the value is an ASCII graphic character: `U+0021 '!'` to
    /// `U+007E '~'`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert('A'.is_ascii_graphic());
    /// assert('%'.is_ascii_graphic());
    /// assert(!' '.is_ascii_graphic());
    /// assert(!'\n'.is_ascii_graphic());
    /// ```
    #[inline]
    pub fn is_ascii_graphic(&self) -> bool {
        *self >= '!' && *self <= '~'
    }

    /// Checks if the value is an ASCII control character: `U+0000 NUL` to
    /// `U+001F UNIT SEPARATOR`, or `U+007F DELETE`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert('\n'.is_ascii_control());
    /// assert('\u{7F}'.is_ascii_control());
    /// assert(!'a'.is_ascii_control());
    /// ```
    #[inline]
    pub fn is_ascii_control(&self) -> bool {
        (*self as u32) < 32 || *self as u32 == 127
    }

    /// Returns `true` if this `char` has the general category for control
    /// codes (`U+0000` to `U+001F` and `U+007F` to `U+009F`).
    ///
    /// # Examples
    ///
    /// ```
    /// assert('\u{9c}'.is_control());
    /// assert(!'q'.is_control());
    /// ```
    #[inline]
    pub fn is_control(self) -> bool {
        let c = self as u32;
        c < 32 || (c >= 127 && c < 160)
    }

    /// Checks that two values are an ASCII case-insensitive match.
    ///
    /// Equivalent to `to_ascii_lowercase(a) == to_ascii_lowercase(b)`.
    ///
    /// # Examples
    ///
    /// ```
    /// let upper_a = 'A';
    /// let lower_a = 'a';
    /// let lower_z = 'z';
    ///
    /// assert(upper_a.eq_ignore_ascii_case(&lower_a));
    /// assert(upper_a.eq_ignore_ascii_case(&upper_a));
    /// assert(!upper_a.eq_ignore_ascii_case(&lower_z));
    /// ```
    #[inline]
    pub fn eq_ignore_ascii_case(&self, other: &char) -> bool {
        self.to_ascii_lowercase() == other.to_ascii_lowercase()
    }

    /// Converts this type to its ASCII upper case equivalent in-place.
    ///
    /// ASCII letters 'a' to 'z' are mapped to 'A' to 'Z', but non-ASCII
    /// letters are unchanged.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut ascii = 'a';
    /// ascii.make_ascii_uppercase();
    /// assert_eq('A', ascii);
    /// ```
    #[inline]
    pub fn make_ascii_uppercase(&mut self) {
        *self = self.to_ascii_uppercase();
    }

    /// Converts this type to its ASCII lower case equivalent in-place.
    ///
    /// ASCII letters 'A' to 'Z' are mapped to 'a' to 'z', but non-ASCII
    /// letters are unchanged.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut ascii = 'A';
    /// ascii.make_ascii_lowercase();
    /// assert_eq('a', ascii);
    /// ```
    #[inline]
    pub fn make_ascii_lowercase(&mut self) {
        *self = self.to_ascii_lowercase();
    }

    /// Returns an iterator that yields the uppercase mapping of this `char`
    /// as one or more `char`s.
    ///
    /// The mapping covers the scripts listed in the
    /// [module documentation](self) (Latin, Greek, Cyrillic, Armenian,
    /// fullwidth Latin); other characters map to themselves. `ß` becomes
    /// `SS`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq('c'.to_uppercase().to_string(), "C");
    /// assert_eq('ñ'.to_uppercase().to_string(), "Ñ");
    /// assert_eq('ß'.to_uppercase().to_string(), "SS");
    /// // Characters without case map to themselves.
    /// assert_eq('山'.to_uppercase().to_string(), "山");
    /// ```
    pub fn to_uppercase(self) -> ToUppercase {
        let c = self as u32;
        if c == 0xDF {
            return ToUppercase {
                c: ['S', 'S', '\0'],
                i: 0,
                n: 2,
            };
        }
        ToUppercase {
            c: [char_of(upper_of(c)), '\0', '\0'],
            i: 0,
            n: 1,
        }
    }

    /// Returns an iterator that yields the lowercase mapping of this `char`
    /// as one or more `char`s.
    ///
    /// The mapping covers the scripts listed in the
    /// [module documentation](self); other characters map to themselves.
    /// `İ` becomes `i` followed by `U+0307 COMBINING DOT ABOVE`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq('C'.to_lowercase().to_string(), "c");
    /// assert_eq('Δ'.to_lowercase().to_string(), "δ");
    /// assert_eq('山'.to_lowercase().to_string(), "山");
    /// ```
    pub fn to_lowercase(self) -> ToLowercase {
        let c = self as u32;
        if c == 0x130 {
            return ToLowercase {
                c: ['i', '\u{307}', '\0'],
                i: 0,
                n: 2,
            };
        }
        ToLowercase {
            c: [char_of(lower_of(c)), '\0', '\0'],
            i: 0,
            n: 1,
        }
    }

    /// Returns `true` if this `char` has the `White_Space` property.
    ///
    /// `White_Space` is specified in the Unicode Character Database: it
    /// includes the ASCII whitespace (and vertical tab), `U+0085`, the
    /// no-break spaces and the other Unicode spaces and separators.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(' '.is_whitespace());
    /// // line break
    /// assert('\n'.is_whitespace());
    /// // a non-breaking space
    /// assert('\u{A0}'.is_whitespace());
    /// assert(!'越'.is_whitespace());
    /// ```
    pub fn is_whitespace(self) -> bool {
        let c = self as u32;
        if c < 0x80 {
            return c == 0x20 || (c >= 0x09 && c <= 0x0D);
        }
        c == 0x85
            || c == 0xA0
            || c == 0x1680
            || (c >= 0x2000 && c <= 0x200A)
            || c == 0x2028
            || c == 0x2029
            || c == 0x202F
            || c == 0x205F
            || c == 0x3000
    }

    /// Returns `true` if this `char` is uppercase: in this version, a
    /// character that `char::to_lowercase` changes (so only in the scripts
    /// it covers).
    ///
    /// # Examples
    ///
    /// ```
    /// assert('A'.is_uppercase());
    /// assert('Δ'.is_uppercase());
    /// assert(!'a'.is_uppercase());
    /// assert(!'中'.is_uppercase());
    /// ```
    pub fn is_uppercase(self) -> bool {
        let c = self as u32;
        if c < 0x80 {
            return c >= 0x41 && c <= 0x5A;
        }
        c == 0x130 || lower_of(c) != c
    }

    /// Returns `true` if this `char` is lowercase: in this version, a
    /// character that `char::to_uppercase` changes (so only in the scripts
    /// it covers).
    ///
    /// # Examples
    ///
    /// ```
    /// assert('a'.is_lowercase());
    /// assert('δ'.is_lowercase());
    /// assert(!'A'.is_lowercase());
    /// assert(!'中'.is_lowercase());
    /// ```
    pub fn is_lowercase(self) -> bool {
        let c = self as u32;
        if c < 0x80 {
            return c >= 0x61 && c <= 0x7A;
        }
        c == 0xDF || upper_of(c) != c
    }

    /// Returns the number of 16-bit code units this `char` would need if
    /// encoded in UTF-16: 1 or 2.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq('ß'.len_utf16(), 1);
    /// assert_eq('💣'.len_utf16(), 2);
    /// ```
    #[inline]
    pub fn len_utf16(self) -> usize {
        if (self as u32) < 0x10000 { 1 } else { 2 }
    }

    /// Encodes this character as UTF-8 into the provided byte buffer, and then
    /// returns the subslice of the buffer that contains the encoded character.
    ///
    /// # Panics
    ///
    /// Panics if the buffer is not large enough. A buffer of length four is
    /// large enough to encode any `char`.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut b = [0u8; 4];
    /// let n = 'ß'.encode_utf8(b.as_mut_slice()).len();
    /// assert_eq(n, 2);
    /// assert_eq(&b[..2], &[0xC3u8, 0x9F][..]);
    /// ```
    pub fn encode_utf8(self, dst: &mut [u8]) -> &mut str {
        let n = self.len_utf8();
        if dst.len() < n {
            panic(
                `encode_utf8: need ${n} bytes to encode U+${self as u32:X}, but the buffer has ${dst.len()}`,
            );
        }
        let v = self as u32;
        if n == 1 {
            dst[0] = v as u8;
        } else if n == 2 {
            dst[0] = (0xC0 | (v >> 6)) as u8;
            dst[1] = (0x80 | (v & 0x3F)) as u8;
        } else if n == 3 {
            dst[0] = (0xE0 | (v >> 12)) as u8;
            dst[1] = (0x80 | ((v >> 6) & 0x3F)) as u8;
            dst[2] = (0x80 | (v & 0x3F)) as u8;
        } else {
            dst[0] = (0xF0 | (v >> 18)) as u8;
            dst[1] = (0x80 | ((v >> 12) & 0x3F)) as u8;
            dst[2] = (0x80 | ((v >> 6) & 0x3F)) as u8;
            dst[3] = (0x80 | (v & 0x3F)) as u8;
        }
        let s = crate::rt::str_from_raw(crate::rt::slice_ptr(dst), n);
        unsafe { *(&s as *const &str as *const &mut str) }
    }
}

impl u8 {
    /// Checks if the value is an ASCII graphic character: `b'!'` to `b'~'`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(b'A'.is_ascii_graphic());
    /// assert(!b' '.is_ascii_graphic());
    /// ```
    #[inline]
    pub fn is_ascii_graphic(&self) -> bool {
        *self >= 33 && *self <= 126
    }

    /// Checks if the value is an ASCII control character: 0 to 31, or 127.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(b'\n'.is_ascii_control());
    /// assert(!b'a'.is_ascii_control());
    /// ```
    #[inline]
    pub fn is_ascii_control(&self) -> bool {
        *self < 32 || *self == 127
    }

    /// Checks that two values are an ASCII case-insensitive match.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(b'a'.eq_ignore_ascii_case(&b'A'));
    /// assert(!b'a'.eq_ignore_ascii_case(&b'b'));
    /// ```
    #[inline]
    pub fn eq_ignore_ascii_case(&self, other: &u8) -> bool {
        self.to_ascii_lowercase() == other.to_ascii_lowercase()
    }

    /// Converts this value to its ASCII upper case equivalent in-place.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut byte = b'a';
    /// byte.make_ascii_uppercase();
    /// assert_eq(b'A', byte);
    /// ```
    #[inline]
    pub fn make_ascii_uppercase(&mut self) {
        *self = self.to_ascii_uppercase();
    }

    /// Converts this value to its ASCII lower case equivalent in-place.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut byte = b'A';
    /// byte.make_ascii_lowercase();
    /// assert_eq(b'a', byte);
    /// ```
    #[inline]
    pub fn make_ascii_lowercase(&mut self) {
        *self = self.to_ascii_lowercase();
    }
}

impl From<u8> for char {
    fn from(b: u8) -> char {
        char_of(b as u32)
    }
}

impl From<char> for u32 {
    fn from(c: char) -> u32 {
        c as u32
    }
}

impl From<char> for u64 {
    fn from(c: char) -> u64 {
        c as u64
    }
}

impl From<char> for u128 {
    fn from(c: char) -> u128 {
        c as u32 as u128
    }
}

/// The error type returned when a conversion from `u32` to `char` fails
/// (`char::try_from(u32)`).
///
/// # Examples
///
/// ```
/// assert(char::try_from(0x41u32).is_ok());
/// let e = char::try_from(0xD800u32).unwrap_err();
/// assert_eq(e.to_string(), "converted integer out of range for `char`");
/// ```
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct CharTryFromError;

impl crate::fmt::Display for CharTryFromError {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        f.pad("converted integer out of range for `char`")
    }
}

impl TryFrom<u32> for char {
    type Error = CharTryFromError;
    fn try_from(i: u32) -> Result<char, CharTryFromError> {
        match char::from_u32(i) {
            Some(c) => Ok(c),
            None => Err(CharTryFromError),
        }
    }
}

/// The error type returned when a checked char conversion fails
/// (`u8::try_from(char)` for a char above `U+00FF`).
///
/// # Examples
///
/// ```
/// assert_eq(u8::try_from('ÿ'), Ok(0xFF));
/// assert(u8::try_from('Ā').is_err());
/// ```
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct TryFromCharError;

impl TryFrom<char> for u8 {
    type Error = TryFromCharError;
    fn try_from(c: char) -> Result<u8, TryFromCharError> {
        if (c as u32) < 256 {
            Ok(c as u32 as u8)
        } else {
            Err(TryFromCharError)
        }
    }
}

/// An error which can be returned when parsing a char: the string is
/// empty or has more than one char.
///
/// # Examples
///
/// ```
/// assert_eq("a".parse::<char>(), Ok('a'));
/// let e = "ab".parse::<char>().unwrap_err();
/// assert_eq(e.to_string(), "too many characters in string");
/// let e = "".parse::<char>().unwrap_err();
/// assert_eq(e.to_string(), "cannot parse char from empty string");
/// ```
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct ParseCharError {
    empty: bool,
}

impl crate::fmt::Display for ParseCharError {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        f.pad(if self.empty {
            "cannot parse char from empty string"
        } else {
            "too many characters in string"
        })
    }
}

/// A string of exactly one char.
impl crate::str::FromStr for char {
    type Err = ParseCharError;
    fn from_str(s: &str) -> Result<char, ParseCharError> {
        let mut cs = s.chars();
        match (cs.next(), cs.next()) {
            (Some(c), None) => Ok(c),
            (None, _) => Err(ParseCharError { empty: true }),
            _ => Err(ParseCharError { empty: false }),
        }
    }
}
