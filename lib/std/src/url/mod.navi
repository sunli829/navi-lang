//! URL parsing and manipulation, as the url crate.
//!
//! [`Url`] parses and serializes URLs following the
//! [WHATWG URL Standard](https://url.spec.whatwg.org/), the way web
//! browsers do (the implementation follows Go's net/url where the two
//! agree). Its accessors return the parts of a URL (scheme, user name,
//! host, port, path, query, fragment), its setters change them, and
//! [`Url::join`] resolves a relative URL against it.
//!
//! The submodules [`form_urlencoded`] (`application/x-www-form-urlencoded`
//! query strings) and [`percent_encoding`] are the crates of the same names.
//!
//! Unlike the url crate, non-ASCII host names are rejected with
//! [`ParseError::IdnaError`] (there are no IDNA tables), and a URL is sliced
//! with [`Url::slice`] instead of indexing with a range of [`Position`]s.
//!
//! # Examples
//!
//! ```
//! use std::url::{Host, Url};
//!
//! let u = Url::parse("https://user@example.com:8443/a/b?x=1#top").unwrap();
//! assert_eq(u.scheme(), "https");
//! assert_eq(u.username(), "user");
//! assert_eq(u.host_str(), Some("example.com"));
//! assert_eq(u.host(), Some(Host::Domain("example.com".to_string())));
//! assert_eq(u.port(), Some(8443));
//! assert_eq(u.path(), "/a/b");
//! assert_eq(u.query(), Some("x=1"));
//! assert_eq(u.fragment(), Some("top"));
//!
//! // Resolving a relative URL.
//! let v = u.join("../c?y=2").unwrap();
//! assert_eq(v.as_str(), "https://user@example.com:8443/c?y=2");
//! ```
//!
//! Reading and building a query string:
//!
//! ```
//! use std::url::Url;
//!
//! let mut u = Url::parse("https://example.com/search?q=navi+lang&page=2").unwrap();
//! let pairs: Vec<(String, String)> = u.query_pairs().collect();
//! assert_eq(pairs[0], ("q".to_string(), "navi lang".to_string()));
//! assert_eq(pairs[1], ("page".to_string(), "2".to_string()));
//!
//! u.query_pairs_mut().append_pair("lang", "en & fr");
//! assert_eq(u.as_str(), "https://example.com/search?q=navi+lang&page=2&lang=en+%26+fr");
//! ```

pub mod form_urlencoded;
pub mod percent_encoding;

use crate::cmp::Ordering;
use crate::fmt::{self, Debug, Display, Formatter};
use crate::hash::{Hash, Hasher};
use crate::net::{Ipv4Addr, Ipv6Addr};
use crate::str::FromStr;
use percent_encoding::{AsciiSet, CONTROLS, encode_into};

/// Errors that can occur during parsing.
///
/// Returned by [`Url::parse`], [`Url::join`], [`Host::parse`] and
/// [`Url::set_host`]. Its `Display` is the url crate's message.
///
/// # Examples
///
/// ```
/// use std::url::{ParseError, Url};
///
/// assert_eq(Url::parse("/relative/path"), Err(ParseError::RelativeUrlWithoutBase));
/// assert_eq(Url::parse("http://example.com:99999/"), Err(ParseError::InvalidPort));
/// assert_eq(ParseError::EmptyHost.to_string(), "empty host");
/// ```
#[derive(Clone, PartialEq, Eq, Debug)]
pub enum ParseError {
    /// A special URL (such as `http:`) has no host, as in `http://`.
    EmptyHost,
    /// The host name is not ASCII: navi has no IDNA support.
    IdnaError,
    /// The port is not a number or is larger than 65535.
    InvalidPort,
    /// The host looks like an IPv4 address but is not a valid one.
    InvalidIpv4Address,
    /// The host in brackets is not a valid IPv6 address.
    InvalidIpv6Address,
    /// The host contains a character a domain name cannot have.
    InvalidDomainCharacter,
    /// A relative URL was parsed without a base URL.
    RelativeUrlWithoutBase,
    /// A relative URL was resolved against a cannot-be-a-base URL (such as
    /// `mailto:x`).
    RelativeUrlWithCannotBeABaseBase,
    /// A host was set on a cannot-be-a-base URL.
    SetHostOnCannotBeABaseUrl,
    /// The URL is too long (more than 4 GB).
    Overflow,
}

impl Display for ParseError {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str(match self {
            ParseError::EmptyHost => "empty host",
            ParseError::IdnaError => "invalid international domain name",
            ParseError::InvalidPort => "invalid port number",
            ParseError::InvalidIpv4Address => "invalid IPv4 address",
            ParseError::InvalidIpv6Address => "invalid IPv6 address",
            ParseError::InvalidDomainCharacter => "invalid domain character",
            ParseError::RelativeUrlWithoutBase => "relative URL without a base",
            ParseError::RelativeUrlWithCannotBeABaseBase => {
                "relative URL with a cannot-be-a-base base"
            }
            ParseError::SetHostOnCannotBeABaseUrl => {
                "a cannot-be-a-base URL doesn’t have a host to set"
            }
            ParseError::Overflow => "URLs more than 4 GB are not supported",
        })
    }
}

/// The host name of a URL.
///
/// Unlike the url crate's `Host<S>`, the domain is always a `String`.
/// `Display` writes it as in a URL (an IPv6 address in brackets).
///
/// # Examples
///
/// ```
/// use std::net::Ipv4Addr;
/// use std::url::{Host, Url};
///
/// let u = Url::parse("http://192.168.0.1:8080/").unwrap();
/// assert_eq(u.host(), Some(Host::Ipv4(Ipv4Addr::new(192, 168, 0, 1))));
///
/// let u = Url::parse("http://[::1]/").unwrap();
/// assert_eq(u.host().unwrap().to_string(), "[::1]");
/// ```
#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub enum Host {
    /// A DNS domain name (lowercased in special URLs), as `.` separated
    /// labels.
    Domain(String),
    /// An IPv4 address.
    Ipv4(Ipv4Addr),
    /// An IPv6 address.
    Ipv6(Ipv6Addr),
}

impl Host {
    /// Parses a host as in a special URL (`http`, `https`, `ws`, `wss`,
    /// `ftp`, `file`).
    ///
    /// The host is percent-decoded and lowercased; an IPv6 address must be
    /// in brackets, and IPv4 addresses are accepted in the forms the URL
    /// Standard allows (such as `0x7f.1`).
    ///
    /// # Errors
    ///
    /// Fails if the host is empty, contains a forbidden character, is not
    /// ASCII, or is an invalid IP address.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::net::Ipv4Addr;
    /// use std::url::{Host, ParseError};
    ///
    /// assert_eq(Host::parse("Example.COM"), Ok(Host::Domain("example.com".to_string())));
    /// assert_eq(Host::parse("0x7f.1"), Ok(Host::Ipv4(Ipv4Addr::new(127, 0, 0, 1))));
    /// assert_eq(Host::parse("[::1"), Err(ParseError::InvalidIpv6Address));
    /// ```
    pub fn parse(input: &str) -> Result<Host, ParseError> {
        parse_host(input, true)
    }

    /// Parses a host as in a non-special URL.
    ///
    /// The host is kept percent-encoded and is not lowercased, and only an
    /// IPv6 address in brackets is taken as an IP address.
    ///
    /// # Errors
    ///
    /// Fails if the host contains a forbidden character or an invalid IPv6
    /// address.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Host;
    ///
    /// assert_eq(Host::parse_opaque("Example.COM"), Ok(Host::Domain("Example.COM".to_string())));
    /// assert_eq(Host::parse_opaque("[::1]").unwrap().to_string(), "[::1]");
    /// ```
    pub fn parse_opaque(input: &str) -> Result<Host, ParseError> {
        parse_host(input, false)
    }
}

impl Display for Host {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        match self {
            Host::Domain(d) => f.write_str(d.as_str()),
            Host::Ipv4(a) => f.write_fmt(`${a}`),
            Host::Ipv6(a) => f.write_fmt(`[${a}]`),
        }
    }
}

/// A position in a URL's serialization, for [`Url::slice`].
///
/// The url crate indexes a `Url` with a range of positions
/// (`&url[Position::BeforePath..]`); navi writes
/// `url.slice(Position::BeforePath, Position::AfterFragment)`. A part
/// that is missing is an empty range at the place it would be; the
/// delimiters (`://`, `@`, `:`, `?`, `#`) are between the `After` position
/// of one part and the `Before` position of the next.
///
/// # Examples
///
/// ```
/// use std::url::{Position, Url};
///
/// let u = Url::parse("https://user:pw@example.com:8080/a/b?q=1#frag").unwrap();
/// assert_eq(u.slice(Position::BeforeScheme, Position::AfterScheme), "https");
/// assert_eq(u.slice(Position::BeforeHost, Position::AfterPort), "example.com:8080");
/// assert_eq(u.slice(Position::BeforePath, Position::AfterQuery), "/a/b?q=1");
/// assert_eq(u.slice(Position::BeforeScheme, Position::AfterPath), "https://user:pw@example.com:8080/a/b");
/// ```
#[derive(Clone, PartialEq, Eq, Debug)]
pub enum Position {
    /// The start of the URL.
    BeforeScheme,
    /// After the scheme, before its `:`.
    AfterScheme,
    /// The start of the user name (after `://`).
    BeforeUsername,
    /// The end of the user name.
    AfterUsername,
    /// The start of the password (after its `:`).
    BeforePassword,
    /// The end of the password.
    AfterPassword,
    /// The start of the host (after the `@` of the credentials, if any).
    BeforeHost,
    /// The end of the host.
    AfterHost,
    /// The start of the port (after its `:`).
    BeforePort,
    /// The end of the port.
    AfterPort,
    /// The start of the path.
    BeforePath,
    /// The end of the path.
    AfterPath,
    /// The start of the query (after `?`).
    BeforeQuery,
    /// The end of the query.
    AfterQuery,
    /// The start of the fragment (after `#`).
    BeforeFragment,
    /// The end of the URL.
    AfterFragment,
}

/// A parsed URL record.
///
/// A `Url` is always absolute and valid: [`Url::parse`] normalizes its
/// input (lowercasing the scheme and a special URL's host, removing a
/// default port, resolving `.` and `..` path segments and percent-encoding
/// the characters that need it), and the setters keep it so. Its parts are
/// kept percent-encoded; [`as_str`](Url::as_str) (and `Display`) is its
/// serialization, and two URLs are equal, ordered and hashed by it.
///
/// A URL is *special* if its scheme is `http`, `https`, `ws`, `wss`, `ftp`
/// or `file` ([`is_special`](Url::is_special)); a URL like `mailto:x` or
/// `data:...`, whose path is not a list of segments, *cannot be a base*
/// ([`cannot_be_a_base`](Url::cannot_be_a_base)).
///
/// # Examples
///
/// ```
/// use std::url::Url;
///
/// let u: Url = "HTTP://Example.com:80/a/./b/../c d".parse().unwrap();
/// assert_eq(u.as_str(), "http://example.com/a/c%20d");
/// assert_eq(u.to_string(), "http://example.com/a/c%20d");
/// assert(u.is_special());
///
/// let m = Url::parse("mailto:joe@example.com").unwrap();
/// assert(m.cannot_be_a_base());
/// assert_eq(m.path(), "joe@example.com");
/// ```
#[derive(Clone)]
pub struct Url {
    s: String,
    scheme: String,
    username: String,
    password: Option<String>,
    host: Option<Host>,
    port: Option<u16>,
    path: String,
    query: Option<String>,
    fragment: Option<String>,
    // A URL like mailto:x or data:..., whose path is not a list of segments.
    opaque: bool,
}

// The percent-encode sets of the URL Standard.
fn fragment_set() -> AsciiSet {
    CONTROLS.add(b' ').add(b'"').add(b'<').add(b'>').add(b'`')
}
fn query_set() -> AsciiSet {
    CONTROLS.add(b' ').add(b'"').add(b'#').add(b'<').add(b'>')
}
fn special_query_set() -> AsciiSet {
    query_set().add(b'\'')
}
fn path_set() -> AsciiSet {
    query_set().add(b'?').add(b'`').add(b'{').add(b'}')
}
fn userinfo_set() -> AsciiSet {
    path_set()
        .add(b'/')
        .add(b':')
        .add(b';')
        .add(b'=')
        .add(b'@')
        .add(b'[')
        .add(b'\\')
        .add(b']')
        .add(b'^')
        .add(b'|')
}

/// Returns the default port of a special scheme.
///
/// It is 80 for `http` and `ws`, 443 for `https` and `wss`, 21 for `ftp`,
/// and `None` for the others.
///
/// # Examples
///
/// ```
/// use std::url::default_port;
///
/// assert_eq(default_port("https"), Some(443));
/// assert_eq(default_port("ws"), Some(80));
/// assert_eq(default_port("file"), None);
/// assert_eq(default_port("mailto"), None);
/// ```
pub fn default_port(scheme: &str) -> Option<u16> {
    match scheme {
        "http" | "ws" => Some(80),
        "https" | "wss" => Some(443),
        "ftp" => Some(21),
        _ => None,
    }
}

fn is_special(scheme: &str) -> bool {
    scheme == "file" || default_port(scheme).is_some()
}

impl Url {
    /// Parses an absolute URL from a string.
    ///
    /// Leading and trailing C0 control characters and spaces are removed,
    /// and tabs and newlines inside are ignored, as the URL Standard says.
    /// To parse a relative URL, use [`join`](Url::join) on a base URL or
    /// [`Url::options`].
    ///
    /// # Errors
    ///
    /// Fails if the input is not an absolute URL (no scheme:
    /// [`ParseError::RelativeUrlWithoutBase`]) or one of its parts is
    /// invalid (an empty host, a bad port or IP address...).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::{ParseError, Url};
    ///
    /// let u = Url::parse("https://example.net/").unwrap();
    /// assert_eq(u.host_str(), Some("example.net"));
    ///
    /// assert_eq(Url::parse("http://"), Err(ParseError::EmptyHost));
    /// assert_eq(Url::parse("example.net"), Err(ParseError::RelativeUrlWithoutBase));
    /// ```
    pub fn parse(input: &str) -> Result<Url, ParseError> {
        parse_url(input, None)
    }

    /// Parses an absolute URL from a string and adds the key/value pairs to
    /// its query.
    ///
    /// The pairs are `application/x-www-form-urlencoded`, as with
    /// [`query_pairs_mut`](Url::query_pairs_mut).
    ///
    /// # Errors
    ///
    /// Fails as [`Url::parse`].
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let u = Url::parse_with_params("https://example.net?dont=clobberme", [("lang", "rust"), ("browser", "servo")]).unwrap();
    /// assert_eq(u.as_str(), "https://example.net/?dont=clobberme&lang=rust&browser=servo");
    /// ```
    pub fn parse_with_params<I, K, V>(input: &str, iter: I) -> Result<Url, ParseError>
    where
        I: IntoIterator<Item = (K, V)>,
        K: AsRef<str>,
        V: AsRef<str>,
    {
        let mut u = Url::parse(input)?;
        {
            let mut q = u.query_pairs_mut();
            for (k, v) in iter {
                q.append_pair(k.as_ref(), v.as_ref());
            }
        }
        Ok(u)
    }

    /// Parses a string as a URL, with this URL as the base URL.
    ///
    /// The input may be absolute (then the base is not used) or relative: a
    /// path relative to the base's directory, an absolute path, a query or
    /// fragment alone, or a scheme-relative `//host/path`.
    ///
    /// Note that a trailing slash matters: `https://example.net/a/b` joined
    /// with `c` is `https://example.net/a/c`, while `https://example.net/a/b/`
    /// joined with `c` is `https://example.net/a/b/c`.
    ///
    /// # Errors
    ///
    /// Fails as [`Url::parse`], and with
    /// [`ParseError::RelativeUrlWithCannotBeABaseBase`] if the input is
    /// relative and this URL cannot be a base.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let base = Url::parse("https://example.net/a/b.html?q#f").unwrap();
    /// assert_eq(base.join("c.png").unwrap().as_str(), "https://example.net/a/c.png");
    /// assert_eq(base.join("../up").unwrap().as_str(), "https://example.net/up");
    /// assert_eq(base.join("/root").unwrap().as_str(), "https://example.net/root");
    /// assert_eq(base.join("?x=1").unwrap().as_str(), "https://example.net/a/b.html?x=1");
    /// assert_eq(base.join("//other.org/p").unwrap().as_str(), "https://other.org/p");
    /// assert_eq(base.join("http://abs.com/").unwrap().as_str(), "http://abs.com/");
    /// ```
    pub fn join(&self, input: &str) -> Result<Url, ParseError> {
        parse_url(input, Some(self))
    }

    /// Returns the options of a parse, to set a base URL before parsing.
    ///
    /// `Url::options().base_url(Some(&base)).parse(s)` is `base.join(s)`;
    /// without a base URL it is `Url::parse(s)`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let base = Url::parse("https://example.net/api/").unwrap();
    /// let u = Url::options().base_url(Some(&base)).parse("v1/items").unwrap();
    /// assert_eq(u.as_str(), "https://example.net/api/v1/items");
    /// ```
    pub fn options() -> ParseOptions {
        ParseOptions { base: None }
    }

    /// Returns the serialization of this URL.
    ///
    /// This is fast, since the serialization is kept up to date.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let u = Url::parse("HTTPS://example.net:443").unwrap();
    /// assert_eq(u.as_str(), "https://example.net/");
    /// ```
    pub fn as_str(&self) -> &str {
        self.s.as_str()
    }

    /// Returns the serialization of this URL as a `String`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let u = Url::parse("https://example.net/a").unwrap();
    /// assert_eq(u.into_string(), "https://example.net/a".to_string());
    /// ```
    pub fn into_string(self) -> String {
        self.s
    }

    /// Returns the scheme of this URL, lowercased, without the `:`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// assert_eq(Url::parse("FILE:///tmp/foo").unwrap().scheme(), "file");
    /// assert_eq(Url::parse("mailto:joe@example.com").unwrap().scheme(), "mailto");
    /// ```
    pub fn scheme(&self) -> &str {
        self.scheme.as_str()
    }

    /// Returns `true` if this URL cannot be a base URL.
    ///
    /// Such a URL (like `mailto:joe@example.com` or `data:text/plain,hi`)
    /// has no host, and its path is not a list of segments; relative URLs
    /// cannot be resolved against it.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// assert(!Url::parse("ftp://rms@example.com").unwrap().cannot_be_a_base());
    /// assert(!Url::parse("unix:/run/foo.socket").unwrap().cannot_be_a_base());
    /// assert(Url::parse("data:text/plain,Stuff").unwrap().cannot_be_a_base());
    /// ```
    pub fn cannot_be_a_base(&self) -> bool {
        self.opaque
    }

    /// Returns `true` if the scheme is special: `http`, `https`, `ws`,
    /// `wss`, `ftp` or `file`.
    ///
    /// Special URLs always have a host (but `file:` URLs may have an empty
    /// one) and a path starting with `/`, and a backslash in them reads as
    /// a slash.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// assert(Url::parse("wss://example.com").unwrap().is_special());
    /// assert(!Url::parse("git://example.com/repo").unwrap().is_special());
    /// ```
    pub fn is_special(&self) -> bool {
        is_special(self.scheme.as_str())
    }

    /// Returns `true` if this URL has an authority: a `//` after the scheme,
    /// with a (possibly empty) host.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// assert(Url::parse("ftp://rms@example.com").unwrap().has_authority());
    /// assert(Url::parse("file:///tmp/foo").unwrap().has_authority());
    /// assert(!Url::parse("unix:/run/foo.socket").unwrap().has_authority());
    /// assert(!Url::parse("mailto:rms@example.com").unwrap().has_authority());
    /// ```
    pub fn has_authority(&self) -> bool {
        self.host.is_some()
    }

    /// Returns the authority of this URL: `user:password@host:port`, as it
    /// is in the URL (percent-encoded), or `""` if it has none.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// assert_eq(Url::parse("ftp://rms:secret@example.com:2121/x").unwrap().authority(), "rms:secret@example.com:2121");
    /// assert_eq(Url::parse("https://example.com:443/").unwrap().authority(), "example.com");
    /// assert_eq(Url::parse("mailto:rms@example.com").unwrap().authority(), "");
    /// ```
    pub fn authority(&self) -> &str {
        if self.host.is_none() {
            return "";
        }
        let start = self.scheme.len() + 3;
        let end = start + self.authority_len();
        &self.s[start..end]
    }

    fn authority_len(&self) -> usize {
        let mut n = self.host_string().len();
        if self.username.len() > 0 || self.password.is_some() {
            n += self.username.len() + 1;
            if let Some(p) = &self.password {
                n += p.len() + 1;
            }
        }
        if let Some(p) = self.port {
            n += 1 + p.to_string().len();
        }
        n
    }

    /// Returns the user name of this URL, percent-encoded, or `""` if it has
    /// none.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// assert_eq(Url::parse("ftp://rms@example.com").unwrap().username(), "rms");
    /// assert_eq(Url::parse("ftp://:secret@example.com").unwrap().username(), "");
    /// assert_eq(Url::parse("https://example.com").unwrap().username(), "");
    /// ```
    pub fn username(&self) -> &str {
        self.username.as_str()
    }

    /// Returns the password of this URL, percent-encoded, if it has one.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// assert_eq(Url::parse("ftp://rms:secret123@example.com").unwrap().password(), Some("secret123"));
    /// assert_eq(Url::parse("ftp://rms@example.com").unwrap().password(), None);
    /// ```
    pub fn password(&self) -> Option<&str> {
        match &self.password {
            Some(p) => Some(p.as_str()),
            None => None,
        }
    }

    /// Returns `true` if this URL has a host (possibly empty, as in
    /// `file:///tmp`).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// assert(Url::parse("ftp://rms@example.com").unwrap().has_host());
    /// assert(!Url::parse("unix:/run/foo.socket").unwrap().has_host());
    /// assert(!Url::parse("data:text/plain,Stuff").unwrap().has_host());
    /// ```
    pub fn has_host(&self) -> bool {
        self.host.is_some()
    }

    /// Returns the host of this URL as it is written in it: a domain
    /// (percent-encoded in a non-special URL), an IPv4 address, or an IPv6
    /// address in brackets.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// assert_eq(Url::parse("https://127.0.0.1/index.html").unwrap().host_str(), Some("127.0.0.1"));
    /// assert_eq(Url::parse("http://[::1]:8080/").unwrap().host_str(), Some("[::1]"));
    /// assert_eq(Url::parse("ftp://rms@example.com").unwrap().host_str(), Some("example.com"));
    /// assert_eq(Url::parse("file:///tmp").unwrap().host_str(), Some(""));
    /// assert_eq(Url::parse("unix:/run/foo.socket").unwrap().host_str(), None);
    /// ```
    pub fn host_str(&self) -> Option<&str> {
        if self.host.is_none() {
            return None;
        }
        let start = self.scheme.len() + 3 + self.userinfo_len();
        Some(&self.s[start..start + self.host_string().len()])
    }

    fn userinfo_len(&self) -> usize {
        if self.username.len() == 0 && self.password.is_none() {
            return 0;
        }
        let mut n = self.username.len() + 1;
        if let Some(p) = &self.password {
            n += p.len() + 1;
        }
        n
    }

    fn host_string(&self) -> String {
        match &self.host {
            Some(h) => h.to_string(),
            None => String::new(),
        }
    }

    /// Returns the parsed host of this URL, if it has one.
    ///
    /// Unlike the url crate, which returns `Option<Host<&str>>`, this
    /// returns a copy.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::net::Ipv4Addr;
    /// use std::url::{Host, Url};
    ///
    /// let u = Url::parse("https://127.0.0.1/index.html").unwrap();
    /// assert_eq(u.host(), Some(Host::Ipv4(Ipv4Addr::new(127, 0, 0, 1))));
    ///
    /// let u = Url::parse("https://Example.com/").unwrap();
    /// assert_eq(u.host(), Some(Host::Domain("example.com".to_string())));
    ///
    /// assert_eq(Url::parse("data:text/plain,Stuff").unwrap().host(), None);
    /// ```
    pub fn host(&self) -> Option<Host> {
        self.host.clone()
    }

    /// Returns the host of this URL if it is a domain name (not an IP
    /// address).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// assert_eq(Url::parse("https://example.com/").unwrap().domain(), Some("example.com"));
    /// assert_eq(Url::parse("https://127.0.0.1/").unwrap().domain(), None);
    /// assert_eq(Url::parse("mailto:rms@example.net").unwrap().domain(), None);
    /// ```
    pub fn domain(&self) -> Option<&str> {
        match &self.host {
            Some(Host::Domain(_)) => self.host_str(),
            _ => None,
        }
    }

    /// Returns the port of this URL, unless it is missing or is the default
    /// port of the scheme (see [`default_port`]).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// assert_eq(Url::parse("https://example.com").unwrap().port(), None);
    /// assert_eq(Url::parse("https://example.com:443/").unwrap().port(), None);
    /// assert_eq(Url::parse("ssh://example.com:22").unwrap().port(), Some(22));
    /// ```
    pub fn port(&self) -> Option<u16> {
        self.port
    }

    /// Returns the port of this URL, or the default port of its scheme if
    /// it has none.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// assert_eq(Url::parse("foo://example.com").unwrap().port_or_known_default(), None);
    /// assert_eq(Url::parse("foo://example.com:1456").unwrap().port_or_known_default(), Some(1456));
    /// assert_eq(Url::parse("https://example.com").unwrap().port_or_known_default(), Some(443));
    /// ```
    pub fn port_or_known_default(&self) -> Option<u16> {
        match self.port {
            Some(p) => Some(p),
            None => default_port(self.scheme.as_str()),
        }
    }

    /// Resolves the host of this URL to socket addresses.
    ///
    /// The port is the URL's, else the default port of its scheme, else
    /// what `default_port` returns. An IP address is used as it is; a
    /// domain is looked up (which may block).
    ///
    /// # Errors
    ///
    /// Fails with an [`io::ErrorKind::InvalidInput`](crate::io::ErrorKind)
    /// error if the URL has no host or no port can be found, or with the
    /// error of the name lookup.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let u = Url::parse("http://127.0.0.1/").unwrap();
    /// let addrs = u.socket_addrs(|| None).unwrap();
    /// assert_eq(addrs[0].to_string(), "127.0.0.1:80");
    ///
    /// let u = Url::parse("myproto://[::1]/").unwrap();
    /// assert(u.socket_addrs(|| None).is_err());
    /// assert_eq(u.socket_addrs(|| Some(7000)).unwrap()[0].to_string(), "[::1]:7000");
    /// ```
    pub fn socket_addrs(
        &self,
        default_port: fn() -> Option<u16>,
    ) -> crate::io::Result<Vec<crate::net::SocketAddr>> {
        let port = match self.port_or_known_default() {
            Some(p) => p,
            None => match default_port() {
                Some(p) => p,
                None => {
                    return Err(crate::io::Error::new(
                        crate::io::ErrorKind::InvalidInput,
                        "no port number",
                    ));
                }
            },
        };
        let mut v = Vec::new();
        match &self.host {
            None => {
                return Err(crate::io::Error::new(
                    crate::io::ErrorKind::InvalidInput,
                    "no host",
                ));
            }
            Some(Host::Ipv4(a)) => v.push(crate::net::SocketAddr::new(
                crate::net::IpAddr::V4(a.clone()),
                port,
            )),
            Some(Host::Ipv6(a)) => v.push(crate::net::SocketAddr::new(
                crate::net::IpAddr::V6(a.clone()),
                port,
            )),
            Some(Host::Domain(d)) => {
                for a in crate::net::ToSocketAddrs::to_socket_addrs(&(d.as_str(), port))? {
                    v.push(a);
                }
            }
        }
        Ok(v)
    }

    /// Returns the path of this URL, percent-encoded.
    ///
    /// The path of a special URL starts with `/` (and is at least `/`); a
    /// URL that cannot be a base has an opaque path; other URLs may have an
    /// empty path.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// assert_eq(Url::parse("https://example.com/countries/việt nam").unwrap().path(), "/countries/vi%E1%BB%87t%20nam");
    /// assert_eq(Url::parse("https://example.com").unwrap().path(), "/");
    /// assert_eq(Url::parse("mailto:rms@example.net").unwrap().path(), "rms@example.net");
    /// ```
    pub fn path(&self) -> &str {
        self.path.as_str()
    }

    /// Returns an iterator over the `/`-separated segments of the path, if
    /// this URL can be a base.
    ///
    /// The segments are percent-encoded. A path ending with `/` has an empty
    /// last segment. Returns `None` for a URL that cannot be a base (or
    /// whose path does not start with `/`).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let u = Url::parse("https://example.com/foo/bar/").unwrap();
    /// let segs: Vec<&str> = u.path_segments().unwrap().collect();
    /// assert_eq(segs, Vec::from(["foo", "bar", ""]));
    ///
    /// assert(Url::parse("data:text/plain,HelloWorld").unwrap().path_segments().is_none());
    /// ```
    pub fn path_segments(&self) -> Option<crate::str::Split<char>> {
        if self.opaque || !self.path.starts_with("/") {
            return None;
        }
        Some(self.path[1..].split('/'))
    }

    /// Returns the query of this URL (after `?`), percent-encoded, if it has
    /// one.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// assert_eq(Url::parse("https://example.com/products?page=2").unwrap().query(), Some("page=2"));
    /// assert_eq(Url::parse("https://example.com/products?").unwrap().query(), Some(""));
    /// assert_eq(Url::parse("https://example.com/products").unwrap().query(), None);
    /// assert_eq(Url::parse("https://example.com/?country=español").unwrap().query(), Some("country=espa%C3%B1ol"));
    /// ```
    pub fn query(&self) -> Option<&str> {
        match &self.query {
            Some(q) => Some(q.as_str()),
            None => None,
        }
    }

    /// Parses the query as `application/x-www-form-urlencoded` and returns an
    /// iterator over its decoded name/value pairs.
    ///
    /// The pairs are `(String, String)` (the url crate's are
    /// `(Cow<str>, Cow<str>)`). A URL without a query has no pairs.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let u = Url::parse("https://example.com/products?page=2&sort=desc&q=a+b%21").unwrap();
    /// let mut pairs = u.query_pairs();
    /// assert_eq(pairs.next(), Some(("page".to_string(), "2".to_string())));
    /// assert_eq(pairs.next(), Some(("sort".to_string(), "desc".to_string())));
    /// assert_eq(pairs.next(), Some(("q".to_string(), "a b!".to_string())));
    /// assert_eq(pairs.next(), None);
    /// ```
    pub fn query_pairs(&self) -> form_urlencoded::Parse {
        match &self.query {
            Some(q) => form_urlencoded::parse(q.as_bytes()),
            None => form_urlencoded::parse(b""),
        }
    }

    /// Returns the fragment of this URL (after `#`), percent-encoded, if it
    /// has one.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// assert_eq(Url::parse("https://example.com/data.csv#row=4").unwrap().fragment(), Some("row=4"));
    /// assert_eq(Url::parse("https://example.com/data.csv#cell=4,1-6,2").unwrap().fragment(), Some("cell=4,1-6,2"));
    /// assert_eq(Url::parse("https://example.com/data.csv").unwrap().fragment(), None);
    /// ```
    pub fn fragment(&self) -> Option<&str> {
        match &self.fragment {
            Some(q) => Some(q.as_str()),
            None => None,
        }
    }

    /// Returns a serializer that appends name/value pairs to the query of
    /// this URL.
    ///
    /// The pairs are `application/x-www-form-urlencoded`. Unlike the url
    /// crate, where the URL is updated when the serializer is dropped, each
    /// call (such as [`append_pair`](form_urlencoded::Serializer::append_pair))
    /// updates the URL at once.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let mut u = Url::parse("https://example.net?lang=fr#nav").unwrap();
    /// u.query_pairs_mut().clear().append_pair("foo", "bar & baz").append_pair("saisons", "Été+hiver");
    /// assert_eq(u.query(), Some("foo=bar+%26+baz&saisons=%C3%89t%C3%A9%2Bhiver"));
    /// assert_eq(u.as_str(), "https://example.net/?foo=bar+%26+baz&saisons=%C3%89t%C3%A9%2Bhiver#nav");
    /// ```
    pub fn query_pairs_mut(&mut self) -> form_urlencoded::Serializer {
        let start = match &self.query {
            Some(q) => q.clone(),
            None => String::new(),
        };
        let u: &mut Url = self;
        form_urlencoded::Serializer::for_url(start, u)
    }

    // The serializer's result as the query (None when empty, as the crate
    // does when nothing was appended).
    pub(crate) fn set_query_raw(&mut self, q: String) {
        self.query = Some(q);
        self.serialize();
    }

    /// Changes the fragment of this URL; `None` removes it.
    ///
    /// The characters that cannot be in a fragment are percent-encoded.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let mut u = Url::parse("https://example.com/data.csv").unwrap();
    /// u.set_fragment(Some("cell=4,1-6,2"));
    /// assert_eq(u.as_str(), "https://example.com/data.csv#cell=4,1-6,2");
    /// u.set_fragment(Some("a b"));
    /// assert_eq(u.fragment(), Some("a%20b"));
    /// u.set_fragment(None);
    /// assert_eq(u.as_str(), "https://example.com/data.csv");
    /// ```
    pub fn set_fragment(&mut self, fragment: Option<&str>) {
        self.fragment = match fragment {
            Some(f) => Some(encode(f, fragment_set())),
            None => None,
        };
        self.serialize();
    }

    /// Changes the query of this URL; `None` removes it.
    ///
    /// The characters that cannot be in a query are percent-encoded (in a
    /// special URL, `'` too). To build a query from pairs, use
    /// [`query_pairs_mut`](Url::query_pairs_mut).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let mut u = Url::parse("https://example.com/products").unwrap();
    /// u.set_query(Some("page=2"));
    /// assert_eq(u.as_str(), "https://example.com/products?page=2");
    /// u.set_query(Some("q=a b"));
    /// assert_eq(u.query(), Some("q=a%20b"));
    /// u.set_query(None);
    /// assert_eq(u.query(), None);
    /// ```
    pub fn set_query(&mut self, query: Option<&str>) {
        let set = if self.is_special() {
            special_query_set()
        } else {
            query_set()
        };
        self.query = match query {
            Some(q) => Some(encode(q, set)),
            None => None,
        };
        self.serialize();
    }

    /// Changes the path of this URL.
    ///
    /// The characters that cannot be in a path are percent-encoded, `.` and
    /// `..` segments are resolved, and a special URL's path gets a leading
    /// `/`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let mut u = Url::parse("https://example.com").unwrap();
    /// u.set_path("api/comments");
    /// assert_eq(u.as_str(), "https://example.com/api/comments");
    /// u.set_path("/data/report 1.csv");
    /// assert_eq(u.path(), "/data/report%201.csv");
    /// u.set_path("/a/../b/./c");
    /// assert_eq(u.path(), "/b/c");
    /// ```
    pub fn set_path(&mut self, path: &str) {
        if self.opaque {
            self.path = encode(path, CONTROLS);
        } else {
            let special = self.is_special();
            let mut segs: Vec<String> = Vec::new();
            let p = if path.starts_with("/") || (special && path.starts_with("\\")) {
                &path[1..]
            } else {
                path
            };
            if path.len() > 0 || special {
                push_path(&mut segs, p, special);
            }
            self.path = join_path(&segs, special, self.host.is_some());
        }
        self.serialize();
    }

    /// Changes the port of this URL; `None` removes it.
    ///
    /// Setting the default port of the scheme removes the port, as parsing
    /// does.
    ///
    /// # Errors
    ///
    /// Fails, leaving the URL unchanged, if it has no host or an empty host,
    /// or if it is a `file:` URL.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let mut u = Url::parse("ssh://example.net:2048/").unwrap();
    /// u.set_port(Some(4096)).unwrap();
    /// assert_eq(u.as_str(), "ssh://example.net:4096/");
    /// u.set_port(None).unwrap();
    /// assert_eq(u.as_str(), "ssh://example.net/");
    ///
    /// let mut h = Url::parse("https://example.org/").unwrap();
    /// h.set_port(Some(443)).unwrap();
    /// assert_eq(h.port(), None);
    ///
    /// assert(Url::parse("mailto:rms@example.net").unwrap().set_port(Some(80)).is_err());
    /// ```
    pub fn set_port(&mut self, port: Option<u16>) -> Result<(), ()> {
        if self.host.is_none() || self.scheme == "file" {
            return Err(());
        }
        if let Some(Host::Domain(d)) = &self.host {
            if d.len() == 0 {
                return Err(());
            }
        }
        self.port = match port {
            Some(p) => {
                if Some(p) == default_port(self.scheme.as_str()) {
                    None
                } else {
                    Some(p)
                }
            }
            None => None,
        };
        self.serialize();
        Ok(())
    }

    /// Changes the host of this URL; `None` removes it (with the user name,
    /// password and port), which only a non-special URL allows.
    ///
    /// The host is parsed as by [`Host::parse`] (in a special URL) or
    /// [`Host::parse_opaque`].
    ///
    /// # Errors
    ///
    /// Fails, leaving the URL unchanged, if the URL cannot be a base
    /// ([`ParseError::SetHostOnCannotBeABaseUrl`]), if the host is removed
    /// or empty in a special URL other than `file:`
    /// ([`ParseError::EmptyHost`]), or if the host is invalid.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::{ParseError, Url};
    ///
    /// let mut u = Url::parse("https://example.net").unwrap();
    /// u.set_host(Some("rust-lang.org")).unwrap();
    /// assert_eq(u.as_str(), "https://rust-lang.org/");
    ///
    /// assert_eq(u.set_host(None), Err(ParseError::EmptyHost));
    ///
    /// let mut f = Url::parse("foo://example.net/x").unwrap();
    /// f.set_host(None).unwrap();
    /// assert_eq(f.as_str(), "foo:/x");
    /// ```
    pub fn set_host(&mut self, host: Option<&str>) -> Result<(), ParseError> {
        if self.opaque {
            return Err(ParseError::SetHostOnCannotBeABaseUrl);
        }
        let special = self.is_special();
        match host {
            None => {
                if special {
                    return Err(ParseError::EmptyHost);
                }
                self.host = None;
                self.username = String::new();
                self.password = None;
                self.port = None;
            }
            Some(h) => {
                if h.len() == 0 && special && self.scheme != "file" {
                    return Err(ParseError::EmptyHost);
                }
                self.host = Some(if h.len() == 0 {
                    Host::Domain(String::new())
                } else {
                    parse_host(h, special)?
                });
            }
        }
        self.serialize();
        Ok(())
    }

    /// Changes the host of this URL to an IP address.
    ///
    /// # Errors
    ///
    /// Fails, leaving the URL unchanged, if the URL cannot be a base.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::net::{IpAddr, Ipv4Addr};
    /// use std::url::Url;
    ///
    /// let mut u = Url::parse("http://example.com/path").unwrap();
    /// u.set_ip_host(IpAddr::V4(Ipv4Addr::new(127, 0, 0, 1))).unwrap();
    /// assert_eq(u.as_str(), "http://127.0.0.1/path");
    ///
    /// let mut m = Url::parse("mailto:rms@example.com").unwrap();
    /// assert(m.set_ip_host(IpAddr::V4(Ipv4Addr::new(127, 0, 0, 1))).is_err());
    /// ```
    pub fn set_ip_host(&mut self, address: crate::net::IpAddr) -> Result<(), ()> {
        if self.opaque {
            return Err(());
        }
        self.host = Some(match address {
            crate::net::IpAddr::V4(a) => Host::Ipv4(a),
            crate::net::IpAddr::V6(a) => Host::Ipv6(a),
        });
        self.serialize();
        Ok(())
    }

    /// Changes the user name of this URL.
    ///
    /// The characters that cannot be in the user info are percent-encoded;
    /// an empty user name removes it (unless there is a password).
    ///
    /// # Errors
    ///
    /// Fails, leaving the URL unchanged, if the URL has no host or an empty
    /// host, or is a `file:` URL.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let mut u = Url::parse("ftp://:secret@example.com/").unwrap();
    /// u.set_username("user1").unwrap();
    /// assert_eq(u.as_str(), "ftp://user1:secret@example.com/");
    ///
    /// let mut m = Url::parse("mailto:rmz@example.com").unwrap();
    /// assert(m.set_username("user1").is_err());
    /// ```
    pub fn set_username(&mut self, username: &str) -> Result<(), ()> {
        if !self.can_have_credentials() {
            return Err(());
        }
        self.username = encode(username, userinfo_set());
        self.serialize();
        Ok(())
    }

    /// Changes the password of this URL; `None` or an empty password
    /// removes it.
    ///
    /// The characters that cannot be in the user info are percent-encoded.
    ///
    /// # Errors
    ///
    /// Fails, leaving the URL unchanged, if the URL has no host or an empty
    /// host, or is a `file:` URL.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let mut u = Url::parse("ftp://user1@example.com/").unwrap();
    /// u.set_password(Some("secret password")).unwrap();
    /// assert_eq(u.as_str(), "ftp://user1:secret%20password@example.com/");
    /// u.set_password(None).unwrap();
    /// assert_eq(u.as_str(), "ftp://user1@example.com/");
    ///
    /// assert(Url::parse("mailto:rms@example.com").unwrap().set_password(Some("x")).is_err());
    /// ```
    pub fn set_password(&mut self, password: Option<&str>) -> Result<(), ()> {
        if !self.can_have_credentials() {
            return Err(());
        }
        self.password = match password {
            Some(p) => {
                if p.len() == 0 {
                    None
                } else {
                    Some(encode(p, userinfo_set()))
                }
            }
            None => None,
        };
        self.serialize();
        Ok(())
    }

    fn can_have_credentials(&self) -> bool {
        match &self.host {
            Some(Host::Domain(d)) => d.len() > 0 && self.scheme != "file",
            Some(_) => self.scheme != "file",
            None => false,
        }
    }

    /// Changes the scheme of this URL.
    ///
    /// The new scheme is lowercased; a port that becomes the default port of
    /// the new scheme is removed.
    ///
    /// # Errors
    ///
    /// Fails, leaving the URL unchanged, if the scheme is not valid (a
    /// letter followed by letters, digits, `+`, `-` or `.`), if it would
    /// change a special URL into a non-special one or the other way around,
    /// or if it would make a `file:` URL with credentials or a port.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let mut u = Url::parse("http://example.net:443/").unwrap();
    /// u.set_scheme("HTTPS").unwrap();
    /// assert_eq(u.as_str(), "https://example.net/");
    ///
    /// // Not between special and non-special schemes.
    /// assert(u.set_scheme("foo").is_err());
    /// assert(u.set_scheme("1http").is_err());
    /// assert_eq(u.scheme(), "https");
    /// ```
    pub fn set_scheme(&mut self, scheme: &str) -> Result<(), ()> {
        let b = scheme.as_bytes();
        if b.len() == 0 || !b[0].is_ascii_alphabetic() {
            return Err(());
        }
        for c in b.iter() {
            if !(c.is_ascii_alphanumeric() || *c == b'+' || *c == b'-' || *c == b'.') {
                return Err(());
            }
        }
        let s = scheme.to_ascii_lowercase();
        if is_special(s.as_str()) != self.is_special() {
            return Err(());
        }
        if s == "file"
            && (self.username.len() > 0 || self.password.is_some() || self.port.is_some())
        {
            return Err(());
        }
        self.scheme = s;
        if self.port.is_some() && self.port == default_port(self.scheme.as_str()) {
            self.port = None;
        }
        self.serialize();
        Ok(())
    }

    /// Returns the origin of this URL, as the URL Standard defines it.
    ///
    /// The origin of a URL with a special scheme other than `file:` is its
    /// scheme, host and port (a tuple origin); a `blob:` URL has the origin
    /// of the `http(s):` URL in its path; the others have an opaque origin.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let o = Url::parse("https://example.com:443/index.html").unwrap().origin();
    /// assert(o.is_tuple());
    /// assert_eq(o.ascii_serialization(), "https://example.com");
    ///
    /// let b = Url::parse("blob:https://example.com:8080/uuid").unwrap().origin();
    /// assert_eq(b.ascii_serialization(), "https://example.com:8080");
    ///
    /// let f = Url::parse("file:///tmp/foo").unwrap().origin();
    /// assert(!f.is_tuple());
    /// assert_eq(f.ascii_serialization(), "null");
    /// ```
    pub fn origin(&self) -> Origin {
        let s = self.scheme.as_str();
        if default_port(s).is_some() {
            if let Some(h) = &self.host {
                return Origin {
                    tuple: true,
                    scheme: self.scheme.clone(),
                    host: h.clone(),
                    port: self.port_or_known_default().unwrap_or(0),
                };
            }
        }
        if s == "blob" {
            if let Ok(u) = Url::parse(self.path.as_str()) {
                if u.scheme == "http" || u.scheme == "https" {
                    return u.origin();
                }
            }
        }
        Origin {
            tuple: false,
            scheme: String::new(),
            host: Host::Domain(String::new()),
            port: 0,
        }
    }

    /// Returns the part of the serialization between two [`Position`]s.
    ///
    /// This is the url crate's `&url[from..to]` (navi cannot index with a
    /// range of a custom type).
    ///
    /// # Panics
    ///
    /// Panics if `from` is after `to`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::{Position, Url};
    ///
    /// let u = Url::parse("https://example.com/a/b?q=1#top").unwrap();
    /// assert_eq(u.slice(Position::BeforeScheme, Position::AfterPath), "https://example.com/a/b");
    /// assert_eq(u.slice(Position::BeforePath, Position::AfterFragment), "/a/b?q=1#top");
    /// assert_eq(u.slice(Position::BeforeQuery, Position::AfterQuery), "q=1");
    /// ```
    pub fn slice(&self, from: Position, to: Position) -> &str {
        &self.s[self.index(from)..self.index(to)]
    }

    fn index(&self, p: Position) -> usize {
        let after_scheme = self.scheme.len() + 1;
        let auth = if self.host.is_some() {
            after_scheme + 2
        } else {
            after_scheme
        };
        let user_end = auth + self.username.len();
        let pass_end = match &self.password {
            Some(pw) => user_end + 1 + pw.len(),
            None => user_end,
        };
        let host_start = auth + self.userinfo_len();
        let host_end = host_start + self.host_string().len();
        let port_end = match self.port {
            Some(pt) => host_end + 1 + pt.to_string().len(),
            None => host_end,
        };
        let path_end = port_end + self.path.len();
        let query_end = match &self.query {
            Some(q) => path_end + 1 + q.len(),
            None => path_end,
        };
        match p {
            Position::BeforeScheme => 0,
            Position::AfterScheme => self.scheme.len(),
            Position::BeforeUsername => auth,
            Position::AfterUsername => user_end,
            Position::BeforePassword => {
                if self.password.is_some() {
                    user_end + 1
                } else {
                    user_end
                }
            }
            Position::AfterPassword => pass_end,
            Position::BeforeHost => host_start,
            Position::AfterHost => host_end,
            Position::BeforePort => {
                if self.port.is_some() {
                    host_end + 1
                } else {
                    host_end
                }
            }
            Position::AfterPort => port_end,
            Position::BeforePath => port_end,
            Position::AfterPath => path_end,
            Position::BeforeQuery => {
                if self.query.is_some() {
                    path_end + 1
                } else {
                    path_end
                }
            }
            Position::AfterQuery => query_end,
            Position::BeforeFragment => {
                if self.fragment.is_some() {
                    query_end + 1
                } else {
                    query_end
                }
            }
            Position::AfterFragment => self.s.len(),
        }
    }

    // Rebuilds the serialization from the parts.
    fn serialize(&mut self) {
        let mut s = String::with_capacity(self.s.len() + 8);
        s.push_str(self.scheme.as_str());
        s.push(':');
        if let Some(h) = &self.host {
            s.push_str("//");
            if self.username.len() > 0 || self.password.is_some() {
                s.push_str(self.username.as_str());
                if let Some(p) = &self.password {
                    s.push(':');
                    s.push_str(p.as_str());
                }
                s.push('@');
            }
            s.push_str(h.to_string().as_str());
            if let Some(p) = self.port {
                s.push(':');
                s.push_str(p.to_string().as_str());
            }
        } else if !self.opaque && self.path.starts_with("//") {
            // Keeps a path starting with "//" from reading as a host.
            s.push_str("/.");
        }
        s.push_str(self.path.as_str());
        if let Some(q) = &self.query {
            s.push('?');
            s.push_str(q.as_str());
        }
        if let Some(f) = &self.fragment {
            s.push('#');
            s.push_str(f.as_str());
        }
        self.s = s;
    }
}

/// Options for parsing a URL, made by [`Url::options`].
///
/// # Examples
///
/// ```
/// use std::url::Url;
///
/// let base = Url::parse("https://example.org/docs/").unwrap();
/// let opts = Url::options().base_url(Some(&base));
/// assert_eq(opts.parse("intro.html").unwrap().as_str(), "https://example.org/docs/intro.html");
/// assert_eq(opts.parse("https://other.org/").unwrap().as_str(), "https://other.org/");
/// ```
#[derive(Clone)]
pub struct ParseOptions {
    base: Option<Url>,
}

impl ParseOptions {
    /// Returns these options with a base URL to resolve relative URLs
    /// against (`None`: no base URL).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::{ParseError, Url};
    ///
    /// let base = Url::parse("https://example.org/a/").unwrap();
    /// assert_eq(Url::options().base_url(Some(&base)).parse("b").unwrap().as_str(), "https://example.org/a/b");
    /// assert_eq(Url::options().base_url(None).parse("b"), Err(ParseError::RelativeUrlWithoutBase));
    /// ```
    pub fn base_url(&self, base: Option<&Url>) -> ParseOptions {
        ParseOptions {
            base: match base {
                Some(b) => Some(b.clone()),
                None => None,
            },
        }
    }

    /// Parses a URL with these options: as [`Url::join`] on the base URL,
    /// or as [`Url::parse`] without one.
    ///
    /// # Errors
    ///
    /// Fails as [`Url::join`] or [`Url::parse`].
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let base = Url::parse("https://example.org/a/b").unwrap();
    /// let u = Url::options().base_url(Some(&base)).parse("../c?x").unwrap();
    /// assert_eq(u.as_str(), "https://example.org/c?x");
    /// ```
    pub fn parse(&self, input: &str) -> Result<Url, ParseError> {
        match &self.base {
            Some(b) => parse_url(input, Some(b)),
            None => parse_url(input, None),
        }
    }
}

/// The origin of a URL, as [`Url::origin`] returns it.
///
/// An origin is either a tuple of a scheme, a host and a port, or opaque.
/// Two tuple origins are equal when their parts are; opaque origins are
/// all equal to each other here (the URL Standard makes each one unique).
///
/// # Examples
///
/// ```
/// use std::url::Url;
///
/// let a = Url::parse("https://example.com/a").unwrap().origin();
/// let b = Url::parse("https://example.com:443/b?x").unwrap().origin();
/// let c = Url::parse("http://example.com/").unwrap().origin();
/// assert_eq(a, b);
/// assert_ne(a, c);
/// ```
#[derive(Clone, PartialEq, Eq, Debug)]
pub struct Origin {
    tuple: bool,
    scheme: String,
    host: Host,
    port: u16,
}

impl Origin {
    /// Returns `true` if this is a tuple origin (scheme, host and port), not
    /// an opaque one.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// assert(Url::parse("wss://example.com/chat").unwrap().origin().is_tuple());
    /// assert(!Url::parse("data:text/plain,hi").unwrap().origin().is_tuple());
    /// ```
    pub fn is_tuple(&self) -> bool {
        self.tuple
    }

    /// Returns the ASCII serialization of this origin:
    /// `scheme://host[:port]` (the port only if it is not the scheme's
    /// default), or `null` for an opaque origin.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// assert_eq(Url::parse("http://example.com:8080/x").unwrap().origin().ascii_serialization(), "http://example.com:8080");
    /// assert_eq(Url::parse("mailto:x@example.com").unwrap().origin().ascii_serialization(), "null");
    /// ```
    pub fn ascii_serialization(&self) -> String {
        if !self.tuple {
            return "null".to_string();
        }
        let mut s = `${self.scheme}://${self.host}`.to_string();
        if Some(self.port) != default_port(self.scheme.as_str()) {
            s.push_str(`:${self.port}`.to_string().as_str());
        }
        s
    }
}

impl Display for Url {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str(self.s.as_str())
    }
}

impl Debug for Url {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.debug_struct("Url")
            .field("scheme", &self.scheme())
            .field("cannot_be_a_base", &self.opaque)
            .field("username", &self.username())
            .field("password", &self.password())
            .field("host", &self.host)
            .field("port", &self.port)
            .field("path", &self.path())
            .field("query", &self.query())
            .field("fragment", &self.fragment())
            .finish()
    }
}

impl PartialEq for Url {
    fn eq(&self, other: &Url) -> bool {
        self.s == other.s
    }
}

impl Eq for Url {}

impl PartialOrd for Url {
    fn partial_cmp(&self, other: &Url) -> Option<Ordering> {
        self.s.partial_cmp(&other.s)
    }
}

impl Ord for Url {
    fn cmp(&self, other: &Url) -> Ordering {
        self.s.cmp(&other.s)
    }
}

impl Hash for Url {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.s.hash(state);
    }
}

impl FromStr for Url {
    type Err = ParseError;
    fn from_str(s: &str) -> Result<Url, ParseError> {
        Url::parse(s)
    }
}

impl AsRef<str> for Url {
    fn as_ref(&self) -> &str {
        self.s.as_str()
    }
}

impl From<Url> for String {
    fn from(u: Url) -> String {
        u.s
    }
}

fn encode(s: &str, set: AsciiSet) -> String {
    let mut out = String::with_capacity(s.len());
    encode_into(&mut out, s.as_bytes(), set);
    out
}

// The parser.

fn is_c0_or_space(c: u8) -> bool {
    c <= b' '
}

// input without leading and trailing C0 controls and spaces, and without
// tabs and newlines.
fn clean(input: &str) -> String {
    let b = input.as_bytes();
    let mut i = 0;
    let mut j = b.len();
    while i < j && is_c0_or_space(b[i]) {
        i += 1;
    }
    while j > i && is_c0_or_space(b[j - 1]) {
        j -= 1;
    }
    let mut v = Vec::with_capacity(j - i);
    while i < j {
        let c = b[i];
        if c != b'\t' && c != b'\n' && c != b'\r' {
            v.push(c);
        }
        i += 1;
    }
    unsafe { String::from_utf8_unchecked(v) }
}

// The scheme (lowercased) and the rest, if input starts with one.
fn split_scheme(s: &str) -> Option<(String, &str)> {
    let b = s.as_bytes();
    if b.len() == 0 || !b[0].is_ascii_alphabetic() {
        return None;
    }
    let mut i = 1;
    while i < b.len() {
        let c = b[i];
        if c == b':' {
            return Some((s[0..i].to_ascii_lowercase(), &s[i + 1..]));
        }
        if !(c.is_ascii_alphanumeric() || c == b'+' || c == b'-' || c == b'.') {
            return None;
        }
        i += 1;
    }
    None
}

fn is_slash(c: u8, special: bool) -> bool {
    c == b'/' || (special && c == b'\\')
}

fn starts_with_two_slashes(s: &str, special: bool) -> bool {
    let b = s.as_bytes();
    b.len() >= 2 && is_slash(b[0], special) && is_slash(b[1], special)
}

fn new_url(scheme: String) -> Url {
    Url {
        s: String::new(),
        scheme,
        username: String::new(),
        password: None,
        host: None,
        port: None,
        path: String::new(),
        query: None,
        fragment: None,
        opaque: false,
    }
}

fn parse_url(input: &str, base: Option<&Url>) -> Result<Url, ParseError> {
    let cleaned = clean(input);
    let s = cleaned.as_str();
    if s.len() > 0xffffffff {
        return Err(ParseError::Overflow);
    }
    let mut u = match split_scheme(s) {
        Some((scheme, rest)) => {
            let special = is_special(scheme.as_str());
            match base {
                // "http:foo" against an http base is relative.
                Some(b)
                    if special
                        && scheme != "file"
                        && b.scheme == scheme
                        && !(rest.len() > 0 && is_slash(rest.as_bytes()[0], true)) =>
                {
                    relative(b, rest)?
                }
                _ => absolute(scheme, rest, base)?,
            }
        }
        None => match base {
            Some(b) => relative(b, s)?,
            None => return Err(ParseError::RelativeUrlWithoutBase),
        },
    };
    u.serialize();
    Ok(u)
}

fn absolute(scheme: String, rest: &str, base: Option<&Url>) -> Result<Url, ParseError> {
    let special = is_special(scheme.as_str());
    let mut u = new_url(scheme);
    if u.scheme == "file" {
        let fb = match base {
            Some(b) if b.scheme == "file" => Some(b),
            _ => None,
        };
        parse_file(&mut u, rest, fb)?;
        return Ok(u);
    }
    if special {
        let b = rest.as_bytes();
        let mut i = 0;
        while i < b.len() && is_slash(b[i], true) {
            i += 1;
        }
        let tail = parse_authority(&mut u, &rest[i..], true)?;
        parse_path_query_fragment(&mut u, tail, Vec::new());
        return Ok(u);
    }
    if rest.starts_with("//") {
        let tail = parse_authority(&mut u, &rest[2..], false)?;
        parse_path_query_fragment(&mut u, tail, Vec::new());
    } else if rest.starts_with("/") {
        parse_path_query_fragment(&mut u, rest, Vec::new());
    } else {
        // An opaque path.
        u.opaque = true;
        let (p, q, f) = split_qf(rest);
        u.path = encode(p, CONTROLS);
        set_qf(&mut u, q, f);
    }
    Ok(u)
}

// The path, query and fragment of s (the query and fragment without their
// '?' and '#').
fn split_qf(s: &str) -> (&str, Option<&str>, Option<&str>) {
    let (before, frag) = match s.find('#') {
        Some(i) => (&s[0..i], Some(&s[i + 1..])),
        None => (s, None),
    };
    match before.find('?') {
        Some(i) => (&before[0..i], Some(&before[i + 1..]), frag),
        None => (before, None, frag),
    }
}

fn set_qf(u: &mut Url, q: Option<&str>, f: Option<&str>) {
    let set = if u.is_special() {
        special_query_set()
    } else {
        query_set()
    };
    u.query = match q {
        Some(x) => Some(encode(x, set)),
        None => None,
    };
    u.fragment = match f {
        Some(x) => Some(encode(x, fragment_set())),
        None => None,
    };
}

// Parses "userinfo@host:port" up to the path, query or fragment; returns
// the rest.
fn parse_authority(u: &mut Url, s: &str, special: bool) -> Result<&str, ParseError> {
    let b = s.as_bytes();
    let mut end = 0;
    while end < b.len() && !(is_slash(b[end], special) || b[end] == b'?' || b[end] == b'#') {
        end += 1;
    }
    let auth = &s[0..end];
    let hostport = match auth.rfind('@') {
        Some(at) => {
            let info = &auth[0..at];
            match info.find(':') {
                Some(c) => {
                    u.username = encode(&info[0..c], userinfo_set());
                    let p = &info[c + 1..];
                    if p.len() > 0 {
                        u.password = Some(encode(p, userinfo_set()));
                    }
                }
                None => u.username = encode(info, userinfo_set()),
            }
            &auth[at + 1..]
        }
        None => auth,
    };
    let (host, port) = split_port(hostport)?;
    if host.len() == 0 {
        if special {
            return Err(ParseError::EmptyHost);
        }
        if u.username.len() > 0 || u.password.is_some() || port.is_some() {
            return Err(ParseError::EmptyHost);
        }
        u.host = Some(Host::Domain(String::new()));
    } else {
        u.host = Some(parse_host(host, special)?);
    }
    u.port = match port {
        Some(p) => {
            if Some(p) == default_port(u.scheme.as_str()) {
                None
            } else {
                Some(p)
            }
        }
        None => None,
    };
    Ok(&s[end..])
}

// "host:port" into the host and the port (None when absent or empty).
fn split_port(s: &str) -> Result<(&str, Option<u16>), ParseError> {
    let b = s.as_bytes();
    let colon = if b.len() > 0 && b[0] == b'[' {
        match s.find(']') {
            Some(i) => {
                if i + 1 < b.len() {
                    if b[i + 1] == b':' {
                        Some(i + 1)
                    } else {
                        return Err(ParseError::InvalidIpv6Address);
                    }
                } else {
                    None
                }
            }
            None => return Err(ParseError::InvalidIpv6Address),
        }
    } else {
        s.find(':')
    };
    match colon {
        None => Ok((s, None)),
        Some(c) => {
            let ps = &s[c + 1..];
            if ps.len() == 0 {
                return Ok((&s[0..c], None));
            }
            let mut n = 0u32;
            for d in ps.as_bytes().iter() {
                if !d.is_ascii_digit() {
                    return Err(ParseError::InvalidPort);
                }
                n = n * 10 + (*d - b'0') as u32;
                if n > 65535 {
                    return Err(ParseError::InvalidPort);
                }
            }
            Ok((&s[0..c], Some(n as u16)))
        }
    }
}

fn forbidden_host_byte(c: u8) -> bool {
    match c {
        0 | b'\t' | b'\n' | b'\r' | b' ' | b'#' | b'/' | b':' | b'<' | b'>' | b'?' | b'@'
        | b'[' | b'\\' | b']' | b'^' | b'|' => true,
        _ => false,
    }
}

fn parse_host(s: &str, special: bool) -> Result<Host, ParseError> {
    if s.starts_with("[") {
        if !s.ends_with("]") {
            return Err(ParseError::InvalidIpv6Address);
        }
        return match s[1..s.len() - 1].parse::<Ipv6Addr>() {
            Ok(a) => Ok(Host::Ipv6(a)),
            Err(_) => Err(ParseError::InvalidIpv6Address),
        };
    }
    if !special {
        for c in s.as_bytes().iter() {
            if forbidden_host_byte(*c) {
                return Err(ParseError::InvalidDomainCharacter);
            }
        }
        return Ok(Host::Domain(encode(s, CONTROLS)));
    }
    let raw = percent_encoding::decode_bytes(s.as_bytes());
    let mut d = String::with_capacity(raw.len());
    for c in raw.iter() {
        let c = *c;
        if c >= 0x80 {
            return Err(ParseError::IdnaError);
        }
        if c < 0x20 || c == 0x7f || c == b'%' || forbidden_host_byte(c) {
            return Err(ParseError::InvalidDomainCharacter);
        }
        d.push(c.to_ascii_lowercase() as char);
    }
    if d.len() == 0 {
        return Err(ParseError::EmptyHost);
    }
    if ends_in_number(d.as_str()) {
        return match parse_ipv4(d.as_str()) {
            Some(a) => Ok(Host::Ipv4(a)),
            None => Err(ParseError::InvalidIpv4Address),
        };
    }
    Ok(Host::Domain(d))
}

// Whether the last label (ignoring a final dot) is a number: then the host
// must be an IPv4 address.
fn ends_in_number(s: &str) -> bool {
    let t = if s.ends_with(".") {
        &s[0..s.len() - 1]
    } else {
        s
    };
    let last = match t.rfind('.') {
        Some(i) => &t[i + 1..],
        None => t,
    };
    if last.len() == 0 {
        return false;
    }
    if last.as_bytes().iter().all(|c| c.is_ascii_digit()) {
        return true;
    }
    parse_ipv4_number(last).is_some()
}

fn parse_ipv4_number(s: &str) -> Option<u64> {
    if s.len() == 0 {
        return None;
    }
    let b = s.as_bytes();
    let (radix, digits) = if b.len() >= 2 && b[0] == b'0' && (b[1] == b'x' || b[1] == b'X') {
        (16u64, &s[2..])
    } else if b.len() >= 2 && b[0] == b'0' {
        (8u64, &s[1..])
    } else {
        (10u64, s)
    };
    let mut n = 0u64;
    for c in digits.as_bytes().iter() {
        let v = match (*c as char).to_digit(radix as u32) {
            Some(v) => v as u64,
            None => return None,
        };
        n = n * radix + v;
        if n > 0xffffffff {
            n = 0x100000000;
        }
    }
    Some(n)
}

// The URL Standard's IPv4 parser ("127.1", "0x7f.0.0.1", "2130706433").
fn parse_ipv4(s: &str) -> Option<Ipv4Addr> {
    let t = if s.ends_with(".") {
        &s[0..s.len() - 1]
    } else {
        s
    };
    let mut nums: Vec<u64> = Vec::new();
    for part in t.split('.') {
        nums.push(parse_ipv4_number(part)?);
    }
    if nums.len() == 0 || nums.len() > 4 {
        return None;
    }
    let n = nums.len();
    let mut i = 0;
    while i + 1 < n {
        if nums[i] > 255 {
            return None;
        }
        i += 1;
    }
    let limit = 1u64 << (8 * (5 - n) as u64);
    if nums[n - 1] >= limit {
        return None;
    }
    let mut v = nums[n - 1];
    i = 0;
    while i + 1 < n {
        v += nums[i] << (8 * (3 - i) as u64);
        i += 1;
    }
    Some(Ipv4Addr::new(
        (v >> 24) as u8,
        (v >> 16) as u8,
        (v >> 8) as u8,
        v as u8,
    ))
}

// Whether a segment is "." or ".." (also percent-encoded).
fn single_dot(s: &str) -> bool {
    s == "." || s.eq_ignore_ascii_case("%2e")
}
fn double_dot(s: &str) -> bool {
    s == ".."
        || s.eq_ignore_ascii_case(".%2e")
        || s.eq_ignore_ascii_case("%2e.")
        || s.eq_ignore_ascii_case("%2e%2e")
}

// Appends the segments of p (after its leading slash) to segs, resolving
// "." and "..".
fn push_path(segs: &mut Vec<String>, p: &str, special: bool) {
    let b = p.as_bytes();
    let set = path_set();
    let mut start = 0;
    let mut i = 0;
    loop {
        let end = i == b.len();
        if end || is_slash(b[i], special) {
            let seg = &p[start..i];
            if double_dot(seg) {
                segs.pop();
                if end {
                    segs.push(String::new());
                }
            } else if single_dot(seg) {
                if end {
                    segs.push(String::new());
                }
            } else {
                segs.push(encode(seg, set));
            }
            if end {
                break;
            }
            start = i + 1;
        }
        i += 1;
    }
}

fn join_path(segs: &[String], special: bool, has_host: bool) -> String {
    if segs.len() == 0 {
        return if special {
            "/".to_string()
        } else {
            String::new()
        };
    }
    let mut s = String::new();
    for x in segs.iter() {
        s.push('/');
        s.push_str(x.as_str());
    }
    s
}

// The path (from an optional leading slash), query and fragment.
fn parse_path_query_fragment(u: &mut Url, s: &str, mut segs: Vec<String>) {
    let special = u.is_special();
    let (p, q, f) = split_qf(s);
    let rel = if p.len() > 0 && is_slash(p.as_bytes()[0], special) {
        &p[1..]
    } else {
        p
    };
    if p.len() > 0 || special {
        push_path(&mut segs, rel, special);
    }
    u.path = join_path(&segs, special, u.host.is_some());
    set_qf(u, q, f);
}

fn base_segments(b: &Url) -> Vec<String> {
    let mut v: Vec<String> = Vec::new();
    if b.path.starts_with("/") {
        for s in b.path[1..].split('/') {
            v.push(s.to_string());
        }
    }
    v
}

fn relative(base: &Url, s: &str) -> Result<Url, ParseError> {
    if base.opaque {
        if !s.starts_with("#") {
            return Err(ParseError::RelativeUrlWithCannotBeABaseBase);
        }
        let mut u = base.clone();
        u.fragment = Some(encode(&s[1..], fragment_set()));
        return Ok(u);
    }
    if base.scheme == "file" {
        let mut u = new_url(base.scheme.clone());
        parse_file(&mut u, s, Some(base))?;
        return Ok(u);
    }
    let special = base.is_special();
    if starts_with_two_slashes(s, special) {
        let mut u = new_url(base.scheme.clone());
        let tail = parse_authority(&mut u, &s[2..], special)?;
        parse_path_query_fragment(&mut u, tail, Vec::new());
        return Ok(u);
    }
    let mut u = base.clone();
    u.fragment = None;
    let b = s.as_bytes();
    if b.len() == 0 {
        return Ok(u);
    }
    if is_slash(b[0], special) {
        u.query = None;
        parse_path_query_fragment(&mut u, s, Vec::new());
    } else if b[0] == b'?' {
        let (_, q, f) = split_qf(s);
        set_qf(&mut u, q, f);
    } else if b[0] == b'#' {
        u.fragment = Some(encode(&s[1..], fragment_set()));
    } else {
        u.query = None;
        let mut segs = base_segments(base);
        segs.pop();
        let (p, q, f) = split_qf(s);
        push_path(&mut segs, p, special);
        u.path = join_path(&segs, special, true);
        set_qf(&mut u, q, f);
    }
    Ok(u)
}

// file: URLs (the host may be empty; "localhost" is empty).
fn parse_file(u: &mut Url, s: &str, base: Option<&Url>) -> Result<(), ParseError> {
    u.host = Some(Host::Domain(String::new()));
    if starts_with_two_slashes(s, true) {
        let rest = &s[2..];
        let b = rest.as_bytes();
        let mut end = 0;
        while end < b.len() && !(is_slash(b[end], true) || b[end] == b'?' || b[end] == b'#') {
            end += 1;
        }
        let h = &rest[0..end];
        if h.len() > 0 {
            let host = parse_host(h, true)?;
            if host != Host::Domain("localhost".to_string()) {
                u.host = Some(host);
            }
        }
        parse_path_query_fragment(u, &rest[end..], Vec::new());
        return Ok(());
    }
    match base {
        Some(b) => {
            u.host = b.host.clone();
            let c = s.as_bytes();
            if c.len() == 0 {
                u.path = b.path.clone();
                u.query = b.query.clone();
            } else if is_slash(c[0], true) {
                parse_path_query_fragment(u, s, Vec::new());
            } else if c[0] == b'?' {
                u.path = b.path.clone();
                let (_, q, f) = split_qf(s);
                set_qf(u, q, f);
            } else if c[0] == b'#' {
                u.path = b.path.clone();
                u.query = b.query.clone();
                u.fragment = Some(encode(&s[1..], fragment_set()));
            } else {
                let mut segs = base_segments(b);
                segs.pop();
                let (p, q, f) = split_qf(s);
                push_path(&mut segs, p, true);
                u.path = join_path(&segs, true, true);
                set_qf(u, q, f);
            }
        }
        None => parse_path_query_fragment(u, s, Vec::new()),
    }
    Ok(())
}
