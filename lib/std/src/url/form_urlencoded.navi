//! Parser and serializer for the `application/x-www-form-urlencoded`
//! syntax, as the form_urlencoded crate.
//!
//! This is the format of URL query strings ([`Url::query_pairs`] and
//! [`Url::query_pairs_mut`] use it) and of HTML form bodies: name/value
//! pairs joined with `&`, each written `name=value`, with spaces as `+`
//! and the bytes other than ASCII letters, digits and `*-._`
//! percent-encoded.
//!
//! # Examples
//!
//! ```
//! use std::url::form_urlencoded;
//!
//! let pairs: Vec<(String, String)> = form_urlencoded::parse(b"a=1&b=x+y%21").collect();
//! assert_eq(
//!     pairs,
//!     Vec::from([
//!         ("a".to_string(), "1".to_string()),
//!         ("b".to_string(), "x y!".to_string()),
//!     ]),
//! );
//!
//! let s = form_urlencoded::Serializer::new(String::new())
//!     .append_pair("q", "a&b")
//!     .append_pair("lang", "en")
//!     .finish();
//! assert_eq(s, "q=a%26b&lang=en");
//! ```

use crate::{
    fmt::{self, Display, Formatter},
    url::{
        Url,
        percent_encoding::{self, AsciiSet, NON_ALPHANUMERIC},
    },
};

/// An iterator over the decoded name/value pairs of an
/// `application/x-www-form-urlencoded` string, made by [`parse`].
///
/// Each item is a `(String, String)` (the crate's are `Cow<str>`): `+` is
/// decoded as a space, `%XX` escapes as their byte, and invalid UTF-8 is
/// replaced by U+FFFD. Empty pieces (as in `a=1&&b=2`) are skipped, and a
/// piece without `=` is a name with an empty value.
///
/// # Examples
///
/// ```
/// use std::url::form_urlencoded;
///
/// let mut it = form_urlencoded::parse(b"k&&x=%E2%9C%93");
/// assert_eq(it.next(), Some(("k".to_string(), "".to_string())));
/// assert_eq(it.next(), Some(("x".to_string(), "✓".to_string())));
/// assert_eq(it.next(), None);
/// ```
#[derive(Clone)]
pub struct Parse {
    input: &[u8],
}

/// Parses an `application/x-www-form-urlencoded` string into an iterator
/// of decoded name/value pairs.
///
/// See [`Parse`] for how pairs are decoded.
///
/// # Examples
///
/// ```
/// use std::url::form_urlencoded;
///
/// let mut names = Vec::new();
/// for (name, value) in form_urlencoded::parse("user=ann+lee&id=7".as_bytes()) {
///     names.push(`${name}: ${value}`.to_string());
/// }
/// assert_eq(
///     names,
///     Vec::from(["user: ann lee".to_string(), "id: 7".to_string()]),
/// );
/// ```
pub fn parse(input: &[u8]) -> Parse {
    Parse { input }
}

fn decode(b: &[u8]) -> String {
    let mut v: Vec<u8> = Vec::with_capacity(b.len());
    for c in b.iter() {
        v.push(if *c == b'+' { b' ' } else { *c });
    }
    String::from_utf8_lossy(percent_encoding::decode_bytes(v.as_slice()).as_slice())
}

impl Iterator for Parse {
    type Item = (String, String);
    fn next(&mut self) -> Option<(String, String)> {
        loop {
            if self.input.len() == 0 {
                return None;
            }
            let b = self.input;
            let mut end = 0;
            while end < b.len() && b[end] != b'&' {
                end += 1;
            }
            let piece = &b[0..end];
            self.input = if end < b.len() {
                &b[end + 1..]
            } else {
                &b[end..]
            };
            if piece.len() == 0 {
                continue;
            }
            let mut eq = 0;
            while eq < piece.len() && piece[eq] != b'=' {
                eq += 1;
            }
            let name = decode(&piece[0..eq]);
            let value = if eq < piece.len() {
                decode(&piece[eq + 1..])
            } else {
                String::new()
            };
            return Some((name, value));
        }
    }
}

// Encoded as is: ASCII letters and digits and *-._
fn form_set() -> AsciiSet {
    NON_ALPHANUMERIC
        .remove(b'*')
        .remove(b'-')
        .remove(b'.')
        .remove(b'_')
}

fn append_encoded(out: &mut String, s: &[u8]) {
    let set = form_set();
    for c in s.iter() {
        let c = *c;
        if c == b' ' {
            out.push('+');
        } else if set.should_percent_encode(c) {
            out.push_str(percent_encoding::percent_encode_byte(c));
        } else {
            out.push(c as char);
        }
    }
}

/// The `application/x-www-form-urlencoded` encoding of a byte string,
/// made by [`byte_serialize`].
///
/// It implements `Display` (use `to_string` for the whole encoding) and is
/// an iterator over its pieces: runs of bytes left as they are, `+` for a
/// space, and `%XX` for each other byte.
///
/// # Examples
///
/// ```
/// use std::url::form_urlencoded::byte_serialize;
///
/// let pieces: Vec<&str> = byte_serialize("a b&c".as_bytes()).collect();
/// assert_eq(pieces, Vec::from(["a", "+", "b", "%26", "c"]));
/// ```
#[derive(Clone)]
pub struct ByteSerialize {
    bytes: &[u8],
}

/// Encodes a byte string as a name or value of
/// `application/x-www-form-urlencoded`.
///
/// ASCII letters, digits and `*-._` are kept, a space becomes `+`, and
/// every other byte is percent-encoded.
///
/// # Examples
///
/// ```
/// use std::url::form_urlencoded::byte_serialize;
///
/// assert_eq(
///     byte_serialize("foo bar?=é".as_bytes()).to_string(),
///     "foo+bar%3F%3D%C3%A9",
/// );
/// assert_eq(
///     byte_serialize(b"safe-chars_*.").to_string(),
///     "safe-chars_*.",
/// );
/// ```
pub fn byte_serialize(input: &[u8]) -> ByteSerialize {
    ByteSerialize { bytes: input }
}

impl Display for ByteSerialize {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        let mut s = String::new();
        append_encoded(&mut s, self.bytes);
        f.write_str(s.as_str())
    }
}

impl Iterator for ByteSerialize {
    type Item = &str;
    fn next(&mut self) -> Option<&str> {
        if self.bytes.len() == 0 {
            return None;
        }
        let set = form_set();
        let b = self.bytes[0];
        if b == b' ' {
            self.bytes = &self.bytes[1..];
            return Some("+");
        }
        if set.should_percent_encode(b) {
            self.bytes = &self.bytes[1..];
            return Some(percent_encoding::percent_encode_byte(b));
        }
        let mut i = 1;
        while i < self.bytes.len()
            && self.bytes[i] != b' '
            && !set.should_percent_encode(self.bytes[i])
        {
            i += 1;
        }
        let run = &self.bytes[0..i];
        self.bytes = &self.bytes[i..];
        Some(unsafe { crate::str::from_utf8_unchecked(run) })
    }
}

/// A builder of an `application/x-www-form-urlencoded` string.
///
/// A `Serializer` appends encoded name/value pairs, separated by `&`, to a
/// `String` ([`Serializer::new`], [`Serializer::for_suffix`]) or to the
/// query of a URL ([`Url::query_pairs_mut`], which updates the URL with
/// each call). Its methods return `&mut Serializer`, so calls can be
/// chained; [`finish`](Serializer::finish) returns the result.
///
/// # Examples
///
/// ```
/// use std::url::form_urlencoded::Serializer;
///
/// let body = Serializer::new(String::new())
///     .append_pair("name", "Ann Lee")
///     .append_pair("note", "1+1=2")
///     .append_key_only("subscribe")
///     .finish();
/// assert_eq(body, "name=Ann+Lee&note=1%2B1%3D2&subscribe");
/// ```
pub struct Serializer {
    s: String,
    start: usize,
    url: Option<&mut Url>,
}

impl Serializer {
    /// Creates a serializer that appends pairs to `target`.
    ///
    /// What `target` holds is kept before the pairs. Note that unlike the
    /// form_urlencoded crate, no `&` is written between it and the first
    /// pair, and [`clear`](Serializer::clear) keeps it; to continue a string
    /// that already has pairs, use [`for_suffix`](Serializer::for_suffix).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::form_urlencoded::Serializer;
    ///
    /// let s = Serializer::new(String::new())
    ///     .append_pair("a", "1")
    ///     .append_pair("b", "2")
    ///     .finish();
    /// assert_eq(s, "a=1&b=2");
    /// ```
    pub fn new(target: String) -> Serializer {
        let n = target.len();
        Serializer {
            s: target,
            start: n,
            url: None,
        }
    }

    /// Creates a serializer for the part of `target` from byte `start`.
    ///
    /// What is before `start` is kept as it is; what is from `start` on is
    /// taken as pairs already serialized, so a `&` is written before the
    /// next pair if there are any.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::form_urlencoded::Serializer;
    ///
    /// let s = Serializer::for_suffix("/search?q=x".to_string(), 8)
    ///     .append_pair("page", "2")
    ///     .finish();
    /// assert_eq(s, "/search?q=x&page=2");
    /// ```
    pub fn for_suffix(target: String, start: usize) -> Serializer {
        Serializer {
            s: target,
            start,
            url: None,
        }
    }

    pub(crate) fn for_url(query: String, url: &mut Url) -> Serializer {
        Serializer {
            s: query,
            start: 0,
            url: Some(url),
        }
    }

    /// Removes the pairs (everything from the start position).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let mut u = Url::parse("https://example.com/?a=1&b=2").unwrap();
    /// u.query_pairs_mut().clear().append_pair("c", "3");
    /// assert_eq(u.query(), Some("c=3"));
    /// ```
    pub fn clear(&mut self) -> &mut Serializer {
        self.s.truncate(self.start);
        self.update();
        self
    }

    /// Appends a name/value pair, both encoded.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::form_urlencoded::Serializer;
    ///
    /// let s = Serializer::new(String::new())
    ///     .append_pair("q", "rust & navi")
    ///     .finish();
    /// assert_eq(s, "q=rust+%26+navi");
    /// ```
    pub fn append_pair(&mut self, name: &str, value: &str) -> &mut Serializer {
        self.separator();
        append_encoded(&mut self.s, name.as_bytes());
        self.s.push('=');
        append_encoded(&mut self.s, value.as_bytes());
        self.update();
        self
    }

    /// Appends a name without a value (and without `=`).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::form_urlencoded::Serializer;
    ///
    /// let s = Serializer::new(String::new())
    ///     .append_pair("a", "1")
    ///     .append_key_only("flag")
    ///     .finish();
    /// assert_eq(s, "a=1&flag");
    /// ```
    pub fn append_key_only(&mut self, name: &str) -> &mut Serializer {
        self.separator();
        append_encoded(&mut self.s, name.as_bytes());
        self.update();
        self
    }

    /// Appends the name/value pairs of an iterator.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::form_urlencoded::Serializer;
    ///
    /// let s = Serializer::new(String::new())
    ///     .extend_pairs([("x", "1"), ("y", "a b")])
    ///     .finish();
    /// assert_eq(s, "x=1&y=a+b");
    /// ```
    pub fn extend_pairs<I, K, V>(&mut self, iter: I) -> &mut Serializer
    where
        I: IntoIterator<Item = (K, V)>,
        K: AsRef<str>,
        V: AsRef<str>,
    {
        for (k, v) in iter {
            self.separator();
            append_encoded(&mut self.s, k.as_ref().as_bytes());
            self.s.push('=');
            append_encoded(&mut self.s, v.as_ref().as_bytes());
        }
        self.update();
        self
    }

    /// Returns the serialized string (for a serializer of a URL's query,
    /// the query).
    ///
    /// The serializer can still be used afterwards (the crate's `finish`
    /// may only be called once).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::url::Url;
    ///
    /// let mut u = Url::parse("https://example.com/?a=1").unwrap();
    /// let q = u.query_pairs_mut().append_pair("b", "2").finish();
    /// assert_eq(q, "a=1&b=2");
    /// ```
    pub fn finish(&mut self) -> String {
        self.s.clone()
    }

    fn separator(&mut self) {
        if self.s.len() > self.start {
            self.s.push('&');
        }
    }

    fn update(&mut self) {
        if let Some(u) = self.url {
            u.set_query_raw(self.s.clone());
        }
    }
}
