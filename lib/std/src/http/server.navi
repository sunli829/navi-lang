// The server (as Go's http.Server): a green thread per connection,
// requests on a connection one after another (keep-alive).

use crate::{
    http::{
        Body, HeaderMap, Method, Request, Response, StatusCode, Version, h2,
        wire::{self, NetStream},
    },
    io::{self, BufReader, Read, Write},
    net::{SocketAddr, TcpListener, TcpStream, ToSocketAddrs},
    sync::atomic::{AtomicBool, Ordering},
    time::Duration,
    tls::{Identity, TlsAcceptor},
    url::Url,
};

/// An HTTP server: listens for connections and answers each request with
/// a handler.
///
/// [`Server::bind`] makes a server listening on an address; the methods
/// that configure it ([`Server::read_timeout`], [`Server::tls`], ...)
/// return a changed copy, and [`Server::serve`] accepts connections and
/// answers their requests until [`Server::close`] is called. Clones of a
/// server share its listener, so one clone can serve on a thread while
/// another closes it.
///
/// The handler is a function `fn(&mut Request) -> Response` (a
/// [`Router`](crate::http::Router)'s handle method passed as `|req|
/// router.handle(req)`, for one). Each connection runs on a green thread of its
/// own, which calls the handler for each request in turn (HTTP/1.1 keep-alive),
/// or for each stream at once (HTTP/2). A panic in a handler ends the program
/// (Go's server recovers it and only closes the connection).
///
/// A request body the handler did not read is read and dropped (up to 256
/// KiB, as Go's server does) so that the connection can take the next
/// request. A response without a `Content-Type` that has a body gets
/// `text/plain; charset=utf-8`; one whose body has an unknown length is
/// sent chunked.
///
/// # Examples
///
/// A server on a free port, answering on a thread of its own:
///
/// ```
/// use std::http::{Client, Request, Response, Server, StatusCode};
///
/// let server = Server::bind("127.0.0.1:0").unwrap();
/// let addr = server.local_addr();
/// let srv = server.clone();
/// let handle = std::thread::spawn(|| {
///     srv.serve(|req: &mut Request| -> Response {
///         if req.path() == "/" {
///             Response::from_string("home")
///         } else {
///             Response::error(StatusCode::NOT_FOUND, "no such page")
///         }
///     })
/// });
///
/// let client = Client::new();
/// let resp = client.get(`http://${addr}/`.to_string()).send().unwrap();
/// assert_eq(resp.text().unwrap(), "home");
/// let resp = client
///     .get(`http://${addr}/other`.to_string())
///     .send()
///     .unwrap();
/// assert_eq(resp.status(), StatusCode::NOT_FOUND);
/// assert_eq(resp.text().unwrap(), "no such page\n");
///
/// server.close();
/// handle.join().unwrap().unwrap();
/// ```
#[derive(Clone)]
pub struct Server {
    listener: TcpListener,
    addr: SocketAddr,
    closed: &AtomicBool,
    read_timeout: Option<Duration>,
    write_timeout: Option<Duration>,
    idle_timeout: Option<Duration>,
    max_header_bytes: usize,
    tls: Option<TlsAcceptor>,
    protocols: Protocols,
}

/// The set of protocols a [`Server`] speaks (Go's `http.Protocols`).
///
/// There are three: HTTP/1.1 (and 1.0), HTTP/2 over TLS (chosen by ALPN
/// in the TLS handshake), and HTTP/2 without TLS ("unencrypted", spoken to
/// clients that start with the HTTP/2 preface: prior knowledge, as
/// RFC 9113 dropped `Upgrade: h2c`). `Protocols::default()`, what a server
/// speaks unless told otherwise, has the first two; `Protocols::new()`
/// has none.
///
/// # Examples
///
/// ```
/// use std::http::{Protocols, Server};
///
/// // HTTP/1.1, and HTTP/2 without TLS too.
/// let mut p = Protocols::default();
/// p.set_unencrypted_http2(true);
/// assert(p.http1() && p.http2() && p.unencrypted_http2());
///
/// let server = Server::bind("127.0.0.1:0").unwrap().protocols(p);
/// ```
#[derive(Clone, PartialEq, Eq)]
pub struct Protocols {
    bits: u8,
}

impl Protocols {
    /// Creates an empty set: a server with it speaks nothing until some
    /// are set.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Protocols;
    ///
    /// let mut p = Protocols::new();
    /// assert(!p.http1());
    /// p.set_http1(true);
    /// assert(p.http1());
    /// ```
    pub fn new() -> Protocols {
        Protocols { bits: 0 }
    }

    /// Returns `true` if the set has HTTP/1.1.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Protocols;
    ///
    /// assert(Protocols::default().http1());
    /// assert(!Protocols::new().http1());
    /// ```
    pub fn http1(&self) -> bool {
        self.bits & 1 != 0
    }

    /// Returns `true` if the set has HTTP/2 over TLS.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Protocols;
    ///
    /// assert(Protocols::default().http2());
    /// ```
    pub fn http2(&self) -> bool {
        self.bits & 2 != 0
    }

    /// Returns `true` if the set has HTTP/2 without TLS.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Protocols;
    ///
    /// assert(!Protocols::default().unencrypted_http2());
    /// ```
    pub fn unencrypted_http2(&self) -> bool {
        self.bits & 4 != 0
    }

    /// Adds HTTP/1.1 to the set (`true`) or removes it (`false`).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Protocols;
    ///
    /// // HTTP/2 only (over TLS).
    /// let mut p = Protocols::default();
    /// p.set_http1(false);
    /// assert(!p.http1() && p.http2());
    /// ```
    pub fn set_http1(&mut self, on: bool) {
        self.set(1, on);
    }

    /// Adds HTTP/2 over TLS to the set (`true`) or removes it (`false`).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Protocols;
    ///
    /// let mut p = Protocols::default();
    /// p.set_http2(false);
    /// assert(!p.http2());
    /// ```
    pub fn set_http2(&mut self, on: bool) {
        self.set(2, on);
    }

    /// Adds HTTP/2 without TLS to the set (`true`) or removes it
    /// (`false`).
    ///
    /// Clients reach it by prior knowledge (for a navi
    /// [`Client`](crate::http::Client):
    /// [`ClientBuilder::http2_prior_knowledge`](crate::http::ClientBuilder::http2_prior_knowledge)).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Protocols;
    ///
    /// let mut p = Protocols::new();
    /// p.set_unencrypted_http2(true);
    /// assert(p.unencrypted_http2() && !p.http1());
    /// ```
    pub fn set_unencrypted_http2(&mut self, on: bool) {
        self.set(4, on);
    }

    fn set(&mut self, bit: u8, on: bool) {
        if on {
            self.bits |= bit;
        } else {
            self.bits &= !bit;
        }
    }
}

impl Default for Protocols {
    /// HTTP/1.1 and HTTP/2 (over TLS).
    fn default() -> Protocols {
        Protocols { bits: 3 }
    }
}

impl crate::fmt::Debug for Protocols {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        let mut v: Vec<&str> = Vec::new();
        if self.http1() {
            v.push("HTTP1");
        }
        if self.http2() {
            v.push("HTTP2");
        }
        if self.unencrypted_http2() {
            v.push("UnencryptedHTTP2");
        }
        f.write_fmt(`{${v.join(", ")}}`)
    }
}

/// Listens on `addr` and answers every request with `handler` (as Go's
/// `http.ListenAndServe`).
///
/// This is `Server::bind(addr)?.serve(handler)`: it does not return
/// unless binding fails. Use a [`Server`] to configure timeouts, learn the
/// port picked for port 0, or stop serving.
///
/// # Errors
///
/// Returns an error if the address cannot be bound (it is in use, or not
/// a local address).
///
/// # Examples
///
/// ```no_run
/// use std::http::{self, Response, Router};
///
/// let mut router = Router::new();
/// router.route("GET /", |_req| Response::from_string("hello"));
/// http::serve("127.0.0.1:8080", |req| router.handle(req)).unwrap();
/// ```
pub fn serve<A: ToSocketAddrs>(addr: A, handler: fn(&mut Request) -> Response) -> io::Result<()> {
    Server::bind(addr)?.serve(handler)
}

/// Listens on `addr` and answers every request over https with `handler`
/// (as Go's `http.ListenAndServeTLS`).
///
/// `cert_file` is a PEM file with the server's certificate chain (its own
/// certificate first), `key_file` one with its private key (PKCS#8,
/// PKCS#1 or SEC 1). Clients that offer HTTP/2 get it.
///
/// # Errors
///
/// Returns an error if a file cannot be read or parsed, or if the address
/// cannot be bound.
///
/// # Examples
///
/// ```no_run
/// use std::http::{self, Response};
///
/// http::serve_tls("0.0.0.0:8443", "cert.pem", "key.pem", |_req| {
///     Response::from_string("hello over TLS")
/// })
/// .unwrap();
/// ```
pub fn serve_tls<A: ToSocketAddrs>(
    addr: A,
    cert_file: &str,
    key_file: &str,
    handler: fn(&mut Request) -> Response,
) -> io::Result<()> {
    let id = Identity::from_pkcs8(
        crate::fs::read(cert_file)?.as_slice(),
        crate::fs::read(key_file)?.as_slice(),
    )?;
    Server::bind(addr)?
        .tls(TlsAcceptor::new(id)?)
        .serve(handler)
}

impl Server {
    /// Creates a server listening on `addr`.
    ///
    /// The server listens from now on, but answers nothing until
    /// [`Server::serve`] is called. Binding port 0 picks a free port;
    /// [`Server::local_addr`] tells which.
    ///
    /// The server has no read or write timeouts, a 120-second idle
    /// timeout, a 1 MiB limit on a request's headers, and speaks
    /// [`Protocols::default`].
    ///
    /// # Errors
    ///
    /// Returns an error if the address cannot be resolved or bound.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Server;
    ///
    /// let server = Server::bind("127.0.0.1:0").unwrap();
    /// assert_ne(server.local_addr().port(), 0);
    /// ```
    pub fn bind<A: ToSocketAddrs>(addr: A) -> io::Result<Server> {
        let l = TcpListener::bind(addr)?;
        let a = l.local_addr()?;
        Ok(Server {
            listener: l,
            addr: a,
            closed: &AtomicBool::new(false),
            read_timeout: None,
            write_timeout: None,
            idle_timeout: Some(Duration::from_secs(120)),
            max_header_bytes: 1 << 20,
            tls: None,
            protocols: Protocols::default(),
        })
    }

    /// Returns the address the server listens on.
    ///
    /// After binding port 0, this has the port that was picked.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Server;
    ///
    /// let server = Server::bind("127.0.0.1:0").unwrap();
    /// let addr = server.local_addr();
    /// assert_eq(addr.ip().to_string(), "127.0.0.1");
    /// let base = `http://${addr}`.to_string();
    /// ```
    pub fn local_addr(&self) -> SocketAddr {
        self.addr.clone()
    }

    /// Returns a copy of the server with the timeout for reading a
    /// request's head (`None`, the default: no timeout).
    ///
    /// It also bounds the TLS handshake of an https connection. Reading
    /// the body is up to the handler.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::{http::Server, time::Duration};
    ///
    /// let server = Server::bind("127.0.0.1:0")
    ///     .unwrap()
    ///     .read_timeout(Some(Duration::from_secs(10)))
    ///     .write_timeout(Some(Duration::from_secs(10)));
    /// ```
    pub fn read_timeout(&self, d: Option<Duration>) -> Server {
        let mut s = self.clone();
        s.read_timeout = d;
        s
    }

    /// Returns a copy of the server with the timeout for each write of a
    /// response (`None`, the default: no timeout).
    pub fn write_timeout(&self, d: Option<Duration>) -> Server {
        let mut s = self.clone();
        s.write_timeout = d;
        s
    }

    /// Returns a copy of the server with the time a kept-alive connection
    /// waits for its next request before it is closed (120 seconds by
    /// default; `None`: forever).
    pub fn idle_timeout(&self, d: Option<Duration>) -> Server {
        let mut s = self.clone();
        s.idle_timeout = d;
        s
    }

    /// Returns a copy of the server speaking the protocols
    /// ([`Protocols::default`] by default).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::{Protocols, Server};
    ///
    /// let mut p = Protocols::default();
    /// p.set_unencrypted_http2(true);
    /// let server = Server::bind("127.0.0.1:0").unwrap().protocols(p);
    /// ```
    pub fn protocols(&self, p: Protocols) -> Server {
        let mut s = self.clone();
        s.protocols = p;
        s
    }

    /// Returns a copy of the server that speaks https, with the TLS
    /// handshake of each connection done by `acceptor`.
    ///
    /// The handshake runs on the connection's thread, within the
    /// [`Server::read_timeout`]. An acceptor without ALPN protocols of its
    /// own offers `h2` and `http/1.1` (those of the server's
    /// [`Protocols`]).
    ///
    /// # Examples
    ///
    /// ```no_run
    /// use std::{
    ///     http::{Response, Server},
    ///     tls::{Identity, TlsAcceptor},
    /// };
    ///
    /// let cert = std::fs::read("cert.pem").unwrap();
    /// let key = std::fs::read("key.pem").unwrap();
    /// let identity = Identity::from_pkcs8(cert.as_slice(), key.as_slice()).unwrap();
    /// let server = Server::bind("0.0.0.0:8443")
    ///     .unwrap()
    ///     .tls(TlsAcceptor::new(identity).unwrap());
    /// server
    ///     .serve(|_req| Response::from_string("hello over TLS"))
    ///     .unwrap();
    /// ```
    pub fn tls(&self, acceptor: TlsAcceptor) -> Server {
        let mut s = self.clone();
        s.tls = Some(acceptor);
        s
    }

    /// Returns a copy of the server with the most bytes a request's head
    /// may have (its request line, or its headers; 1 MiB by default).
    ///
    /// A longer request line or longer headers are answered with
    /// `431 Request Header Fields Too Large` and the connection is closed.
    pub fn max_header_bytes(&self, n: usize) -> Server {
        let mut s = self.clone();
        s.max_header_bytes = n;
        s
    }

    /// Accepts connections and answers each of their requests with
    /// `handler`, until [`Server::close`] is called.
    ///
    /// Each connection runs on a thread of its own, which calls `handler`
    /// for its requests. This function blocks: to do something else while
    /// serving, call it on another thread, as below. A panic in the handler
    /// ends the program.
    ///
    /// # Errors
    ///
    /// None for now: it returns `Ok(())` once the server is closed (a
    /// failed accept is tried again).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::{Client, Response, Server};
    ///
    /// let server = Server::bind("127.0.0.1:0").unwrap();
    /// let addr = server.local_addr();
    /// let srv = server.clone();
    /// let handle = std::thread::spawn(|| srv.serve(|req| Response::from_string(req.uri())));
    ///
    /// let resp = Client::new()
    ///     .get(`http://${addr}/ping`.to_string())
    ///     .send()
    ///     .unwrap();
    /// assert_eq(resp.text().unwrap(), "/ping");
    ///
    /// server.close();
    /// assert(handle.join().unwrap().is_ok());
    /// ```
    pub fn serve(&self, handler: fn(&mut Request) -> Response) -> io::Result<()> {
        let mut me0 = self.clone();
        if let Some(a) = &self.tls {
            let mut alpn: Vec<&str> = Vec::new();
            if self.protocols.http2() {
                alpn.push("h2");
            }
            if self.protocols.http1() {
                alpn.push("http/1.1");
            }
            me0.tls = Some(a.with_default_alpn(alpn.as_slice()));
        }
        loop {
            match self.listener.accept() {
                Ok((stream, remote)) => {
                    let me = me0.clone();
                    crate::thread::spawn(|| me.conn(stream, remote, handler));
                }
                Err(e) => {
                    if self.closed.load(Ordering::SeqCst) {
                        return Ok(());
                    }
                    // Out of descriptors and the like: try again a bit later.
                    crate::thread::sleep(Duration::from_millis(5));
                    let _ = e;
                }
            }
        }
    }

    /// Stops the server: it accepts no more connections, and
    /// [`Server::serve`] returns.
    ///
    /// Connections already open are not closed: each finishes the request
    /// it is handling and the requests that follow on it, until it is idle
    /// for the idle timeout or the client closes it.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::{Response, Server};
    ///
    /// let server = Server::bind("127.0.0.1:0").unwrap();
    /// let srv = server.clone();
    /// let handle = std::thread::spawn(|| srv.serve(|_req| Response::from_string("hi")));
    /// server.close();
    /// handle.join().unwrap().unwrap();
    /// ```
    pub fn close(&self) {
        self.closed.store(true, Ordering::SeqCst);
        self.listener.close();
    }

    fn conn(&self, stream: TcpStream, remote: SocketAddr, handler: fn(&mut Request) -> Response) {
        let _ = stream.set_nodelay(true);
        let net = match &self.tls {
            None => NetStream::plain(stream.clone()),
            Some(a) => {
                let _ = stream.set_read_timeout(self.read_timeout);
                let _ = stream.set_write_timeout(self.read_timeout);
                match a.accept(stream.clone()) {
                    Ok(t) => NetStream::tls(t),
                    Err(_) => {
                        stream.close();
                        return;
                    }
                }
            }
        };
        let scheme = if self.tls.is_some() { "https" } else { "http" };
        let r = &mut BufReader::new(net.clone());
        let h2cfg = &h2::server::Config {
            max_header_bytes: self.max_header_bytes,
            idle_timeout: self.idle_timeout,
            scheme,
            addr: self.addr.to_string(),
        };
        if self.tls.is_some() {
            let is_h2 = match net.alpn() {
                Some(p) => p.as_slice() == b"h2",
                None => false,
            };
            if is_h2 && self.protocols.http2() {
                h2::server::serve(net, r, false, h2cfg, remote, handler);
                return;
            }
            if !self.protocols.http1() {
                net.close();
                return;
            }
        }
        let mut w = net.clone();
        let mut first = true;
        loop {
            let _ = stream.set_read_timeout(if first {
                self.read_timeout
            } else {
                self.idle_timeout
            });
            let line = match wire::read_line(r, self.max_header_bytes) {
                Ok(Some(l)) => l,
                Ok(None) => break,
                Err(e) => {
                    if e.kind() == io::ErrorKind::InvalidData {
                        reply_error(
                            &mut w,
                            StatusCode::REQUEST_HEADER_FIELDS_TOO_LARGE,
                            "request line too long",
                        );
                    }
                    break;
                }
            };
            // HTTP/2 by prior knowledge: its preface's first line.
            if first
                && self.tls.is_none()
                && line.as_str() == "PRI * HTTP/2.0"
                && self.protocols.unencrypted_http2()
            {
                let mut rest = [0u8; 8];
                if r.read_exact(&mut rest).is_ok() && &rest[..] == b"\r\nSM\r\n\r\n" {
                    h2::server::serve(net, r, true, h2cfg, remote, handler);
                    return;
                }
                break;
            }
            if first && !self.protocols.http1() {
                break;
            }
            first = false;
            // Empty lines before a request are ignored (RFC 9112 2.2).
            if line.len() == 0 {
                continue;
            }
            let _ = stream.set_read_timeout(self.read_timeout);
            let (method, target, version) = match parse_request_line(line.as_str()) {
                Ok(x) => x,
                Err(code) => {
                    reply_error(
                        &mut w,
                        code,
                        if code == StatusCode::HTTP_VERSION_NOT_SUPPORTED {
                            "unsupported HTTP version"
                        } else {
                            "malformed request line"
                        },
                    );
                    break;
                }
            };
            let headers = match wire::read_headers(r, self.max_header_bytes) {
                Ok(h) => h,
                Err(e) => {
                    let too_large = e.to_string().contains("too large");
                    reply_error(
                        &mut w,
                        if too_large {
                            StatusCode::REQUEST_HEADER_FIELDS_TOO_LARGE
                        } else {
                            StatusCode::BAD_REQUEST
                        },
                        e.to_string().as_str(),
                    );
                    break;
                }
            };
            let host = match headers.get("host") {
                Some(h) => h.to_string(),
                None => {
                    if version == Version::HTTP_11 {
                        reply_error(
                            &mut w,
                            StatusCode::BAD_REQUEST,
                            "missing required Host header",
                        );
                        break;
                    }
                    self.addr.to_string()
                }
            };
            let (mode, len) = match wire::framing(&headers) {
                Ok((wire::TO_CLOSE, _)) => (wire::LEN, 0u64),
                Ok(f) => f,
                Err(e) => {
                    reply_error(
                        &mut w,
                        if e.to_string().contains("coding") {
                            StatusCode::NOT_IMPLEMENTED
                        } else {
                            StatusCode::BAD_REQUEST
                        },
                        e.to_string().as_str(),
                    );
                    break;
                }
            };
            let url = if target.starts_with("/") {
                Url::parse(`${scheme}://${host}${target}`.to_string().as_str())
            } else if target == "*" {
                Url::parse(`${scheme}://${host}/`.to_string().as_str())
            } else {
                Url::parse(target.as_str())
            };
            let url = match url {
                Ok(u) => u,
                Err(_) => {
                    reply_error(&mut w, StatusCode::BAD_REQUEST, "malformed request target");
                    break;
                }
            };
            let inc = wire::incoming(r, mode, len);
            if headers.has_token("expect", "100-continue")
                && !inc.done
                && version == Version::HTTP_11
            {
                if w.write_all(b"HTTP/1.1 100 Continue\r\n\r\n").is_err() {
                    break;
                }
            }
            let mut keep = if version == Version::HTTP_11 {
                !headers.has_token("connection", "close")
            } else {
                headers.has_token("connection", "keep-alive")
            };
            let is_head = method == Method::HEAD;
            let mut req = Request::new(method, url);
            req.target = target;
            req.version = version;
            req.headers = headers;
            req.body = Body::from_reader(inc, if mode == wire::LEN { Some(len) } else { None });
            req.remote = Some(remote.clone());
            let mut resp = handler(&mut req);
            // What the handler did not read (when short) so that the next
            // request can be read.
            if !inc.done && !inc.drain(256 * 1024) {
                keep = false;
            }
            if resp.headers.has_token("connection", "close") {
                keep = false;
            }
            let _ = stream.set_write_timeout(self.write_timeout);
            if write_response(&mut w, &mut resp, version, is_head, &mut keep).is_err() {
                break;
            }
            if !keep {
                break;
            }
        }
        net.close();
    }
}

// "GET /path HTTP/1.1" -> (method, target, version), or the status to
// answer with.
fn parse_request_line(line: &str) -> Result<(Method, String, Version), StatusCode> {
    let mut parts = line.split(' ');
    let m = parts.next().unwrap_or("");
    let t = parts.next().unwrap_or("");
    let v = parts.next().unwrap_or("");
    if parts.next().is_some() || t.len() == 0 {
        return Err(StatusCode::BAD_REQUEST);
    }
    let method = match Method::from_bytes(m.as_bytes()) {
        Ok(x) => x,
        Err(_) => return Err(StatusCode::BAD_REQUEST),
    };
    let version = match v {
        "HTTP/1.1" => Version::HTTP_11,
        "HTTP/1.0" => Version::HTTP_10,
        _ => {
            return Err(if v.starts_with("HTTP/") {
                StatusCode::HTTP_VERSION_NOT_SUPPORTED
            } else {
                StatusCode::BAD_REQUEST
            });
        }
    };
    Ok((method, t.to_string(), version))
}

// Answers a request that could not be read, and the connection closes.
fn reply_error(w: &mut NetStream, code: StatusCode, msg: &str) {
    let reason = code.canonical_reason().unwrap_or("");
    let s = `HTTP/1.1 ${code.as_u16()} ${reason}\r\nContent-Type: text/plain; charset=utf-8\r\nConnection: close\r\nContent-Length: ${msg.len() + 1}\r\n\r\n${msg}\n`.to_string();
    let _ = w.write_all(s.as_bytes());
}

fn write_response(
    w: &mut NetStream,
    resp: &mut Response,
    version: Version,
    is_head: bool,
    keep: &mut bool,
) -> io::Result<()> {
    let code = resp.status.as_u16();
    let mut h = String::with_capacity(256);
    h.push_str(
        `HTTP/1.1 ${code} ${resp.status.canonical_reason().unwrap_or("")}\r\n`
            .to_string()
            .as_str(),
    );
    if !resp.headers.contains_key("date") {
        h.push_str(`Date: ${wire::now_date()}\r\n`.to_string().as_str());
    }
    let no_body = code == 204 || code == 304 || (code >= 100 && code < 200);
    let mut chunked = false;
    if !no_body
        && !resp.headers.contains_key("content-length")
        && !resp.headers.contains_key("transfer-encoding")
    {
        match resp.body.len() {
            Some(n) => h.push_str(`Content-Length: ${n}\r\n`.to_string().as_str()),
            None => {
                if version == Version::HTTP_11 {
                    if !is_head {
                        h.push_str("Transfer-Encoding: chunked\r\n");
                    }
                    chunked = true;
                } else {
                    *keep = false;
                }
            }
        }
    }
    if resp.headers.contains_key("transfer-encoding") {
        chunked = true;
    }
    if resp.body.len().is_some()
        && !resp.body.len().is_some_and(|n| n == 0)
        && !resp.headers.contains_key("content-type")
    {
        h.push_str("Content-Type: text/plain; charset=utf-8\r\n");
    }
    wire::put_headers(&mut h, &resp.headers);
    if !*keep && !resp.headers.contains_key("connection") {
        h.push_str("Connection: close\r\n");
    } else if *keep && version == Version::HTTP_10 {
        h.push_str("Connection: keep-alive\r\n");
    }
    h.push_str("\r\n");
    if is_head || no_body {
        return w.write_all(h.as_bytes());
    }
    match resp.body.as_bytes() {
        Some(b) if b.len() <= 16384 && !chunked => {
            let mut all: Vec<u8> = Vec::with_capacity(h.len() + b.len());
            all.extend_from_slice(h.as_bytes());
            all.extend_from_slice(b);
            w.write_all(all.as_slice())
        }
        _ => {
            w.write_all(h.as_bytes())?;
            wire::write_body(w, &mut resp.body, chunked)
        }
    }
}
