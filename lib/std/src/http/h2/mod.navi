// HTTP/2 (RFC 9113) for std::http's server and client, as Go's net/http
// bundles it: frames, and a connection's state shared by its reader, its
// writer and the threads of its streams (docs/http2.md).
//
// A connection has a reader G (frames in: the state under mu, waiters
// woken by cond), a writer G (frames out, in the order queued; nobody else
// writes, so the reader never waits on the peer), and the streams' threads
// (handlers, requests) that queue HEADERS and DATA within the windows.

pub(crate) mod server;
pub(crate) mod client;

use crate::collections::HashMap;
use crate::io::{self, Read, Write, BufReader};
use crate::sync::{Mutex, Condvar};
use crate::sync::mpmc::{channel, Sender, Receiver};
use crate::time::{Duration, Instant};
use crate::http::hpack::{Decoder, Encoder, HeaderField};
use crate::http::wire::NetStream;

pub(crate) const PREFACE: &str = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n";

// Frame types.
pub(crate) const DATA: u8 = 0;
pub(crate) const HEADERS: u8 = 1;
pub(crate) const PRIORITY: u8 = 2;
pub(crate) const RST_STREAM: u8 = 3;
pub(crate) const SETTINGS: u8 = 4;
pub(crate) const PUSH_PROMISE: u8 = 5;
pub(crate) const PING: u8 = 6;
pub(crate) const GOAWAY: u8 = 7;
pub(crate) const WINDOW_UPDATE: u8 = 8;
pub(crate) const CONTINUATION: u8 = 9;

// Flags.
pub(crate) const END_STREAM: u8 = 1;
pub(crate) const ACK: u8 = 1;
pub(crate) const END_HEADERS: u8 = 4;
pub(crate) const PADDED: u8 = 8;
pub(crate) const PRIORITY_FLAG: u8 = 32;

// Settings.
pub(crate) const HEADER_TABLE_SIZE: u16 = 1;
pub(crate) const ENABLE_PUSH: u16 = 2;
pub(crate) const MAX_CONCURRENT_STREAMS: u16 = 3;
pub(crate) const INITIAL_WINDOW_SIZE: u16 = 4;
pub(crate) const MAX_FRAME_SIZE: u16 = 5;
pub(crate) const MAX_HEADER_LIST_SIZE: u16 = 6;

// Error codes.
pub(crate) const NO_ERROR: u32 = 0;
pub(crate) const PROTOCOL_ERROR: u32 = 1;
pub(crate) const INTERNAL_ERROR: u32 = 2;
pub(crate) const FLOW_CONTROL_ERROR: u32 = 3;
pub(crate) const STREAM_CLOSED: u32 = 5;
pub(crate) const FRAME_SIZE_ERROR: u32 = 6;
pub(crate) const REFUSED_STREAM: u32 = 7;
pub(crate) const CANCEL: u32 = 8;
pub(crate) const COMPRESSION_ERROR: u32 = 9;
pub(crate) const ENHANCE_YOUR_CALM: u32 = 11;

pub(crate) fn code_name(code: u32) -> &str {
    match code {
        0 => "NO_ERROR",
        1 => "PROTOCOL_ERROR",
        2 => "INTERNAL_ERROR",
        3 => "FLOW_CONTROL_ERROR",
        4 => "SETTINGS_TIMEOUT",
        5 => "STREAM_CLOSED",
        6 => "FRAME_SIZE_ERROR",
        7 => "REFUSED_STREAM",
        8 => "CANCEL",
        9 => "COMPRESSION_ERROR",
        10 => "CONNECT_ERROR",
        11 => "ENHANCE_YOUR_CALM",
        12 => "INADEQUATE_SECURITY",
        13 => "HTTP_1_1_REQUIRED",
        _ => "unknown error code",
    }
}

const DEFAULT_WINDOW: i64 = 65535;
const MAX_WINDOW: i64 = 2147483647;
const MIN_FRAME: usize = 16384;

// What went wrong: the connection's (GOAWAY with the code), a stream's
// (RST_STREAM), or reading the connection.
pub(crate) enum H2Error {
    Conn(u32, String),
    Stream(u32, u32),
    Io(io::Error),
}

fn conn_err(code: u32, msg: &str) -> H2Error { H2Error::Conn(code, msg.to_string()) }

pub(crate) fn timed_out() -> io::Error { io::Error::new(io::ErrorKind::TimedOut, "http2: timed out") }

pub(crate) struct Frame {
    pub kind: u8,
    pub flags: u8,
    pub stream: u32,
    // (Without padding and HEADERS' priority fields.)
    pub payload: Vec<u8>,
    // The payload's length as sent: what DATA counts against windows.
    pub flow: usize,
}

impl Frame {
    pub fn has(&self, flag: u8) -> bool { self.flags & flag != 0 }
}

fn be32(b: &[u8]) -> u32 { ((b[0] as u32) << 24) | ((b[1] as u32) << 16) | ((b[2] as u32) << 8) | (b[3] as u32) }

fn put32(out: &mut Vec<u8>, v: u32) {
    out.push((v >> 24) as u8);
    out.push((v >> 16) as u8);
    out.push((v >> 8) as u8);
    out.push(v as u8);
}

/// Appends a frame (header and payload) to out.
pub(crate) fn put_frame(out: &mut Vec<u8>, kind: u8, flags: u8, stream: u32, payload: &[u8]) {
    let n = payload.len();
    out.push((n >> 16) as u8);
    out.push((n >> 8) as u8);
    out.push(n as u8);
    out.push(kind);
    out.push(flags);
    put32(out, stream & 0x7fffffff);
    out.extend_from_slice(payload);
}

pub(crate) fn frame(kind: u8, flags: u8, stream: u32, payload: &[u8]) -> Vec<u8> {
    let mut v: Vec<u8> = Vec::with_capacity(9 + payload.len());
    put_frame(&mut v, kind, flags, stream, payload);
    v
}

pub(crate) fn settings_frame(s: &[(u16, u32)]) -> Vec<u8> {
    let mut p: Vec<u8> = Vec::new();
    for (id, v) in s.iter() {
        p.push((*id >> 8) as u8);
        p.push(*id as u8);
        put32(&mut p, *v);
    }
    frame(SETTINGS, 0, 0, p.as_slice())
}

fn u32_payload(v: u32) -> Vec<u8> {
    let mut p: Vec<u8> = Vec::new();
    put32(&mut p, v);
    p
}

// Reads a frame of at most max bytes, checks what RFC 9113 6 says of its
// length, stream and flags, and takes off padding and priority fields.
fn read_frame(r: &mut BufReader<NetStream>, max: usize) -> Result<Frame, H2Error> {
    let mut h = [0u8; 9];
    if let Err(e) = r.read_exact(&mut h) { return Err(H2Error::Io(e)); }
    let len = ((h[0] as usize) << 16) | ((h[1] as usize) << 8) | (h[2] as usize);
    if len > max { return Err(conn_err(FRAME_SIZE_ERROR, "frame too large")); }
    let mut f = Frame { kind: h[3], flags: h[4], stream: be32(&h[5..9]) & 0x7fffffff, payload: Vec::new(), flow: len };
    f.payload.resize(len, 0);
    if let Err(e) = r.read_exact(f.payload.as_mut_slice()) { return Err(H2Error::Io(e)); }
    let on_stream = f.kind == DATA || f.kind == HEADERS || f.kind == PRIORITY || f.kind == RST_STREAM || f.kind == PUSH_PROMISE || f.kind == CONTINUATION;
    let on_conn = f.kind == SETTINGS || f.kind == PING || f.kind == GOAWAY;
    if on_stream && f.stream == 0 { return Err(conn_err(PROTOCOL_ERROR, "frame on stream 0")); }
    if on_conn && f.stream != 0 { return Err(conn_err(PROTOCOL_ERROR, "frame of the connection on a stream")); }
    match f.kind {
        DATA | HEADERS | PUSH_PROMISE => {
            if f.has(PADDED) {
                if len == 0 { return Err(conn_err(FRAME_SIZE_ERROR, "padded frame without its pad length")); }
                let pad = f.payload[0] as usize;
                if pad >= len { return Err(conn_err(PROTOCOL_ERROR, "padding longer than the frame")); }
                f.payload = f.payload[1..len - pad].to_vec();
            }
            if f.kind == HEADERS && f.has(PRIORITY_FLAG) {
                if f.payload.len() < 5 { return Err(conn_err(FRAME_SIZE_ERROR, "HEADERS too short for its priority")); }
                if be32(f.payload.as_slice()) & 0x7fffffff == f.stream { return Err(H2Error::Stream(f.stream, PROTOCOL_ERROR)); }
                f.payload = f.payload[5..].to_vec();
            }
        }
        PRIORITY => {
            if len != 5 { return Err(H2Error::Stream(f.stream, FRAME_SIZE_ERROR)); }
        }
        RST_STREAM => {
            if len != 4 { return Err(conn_err(FRAME_SIZE_ERROR, "RST_STREAM not 4 bytes")); }
        }
        SETTINGS => {
            if f.has(ACK) && len != 0 { return Err(conn_err(FRAME_SIZE_ERROR, "SETTINGS ack with a payload")); }
            if len % 6 != 0 { return Err(conn_err(FRAME_SIZE_ERROR, "SETTINGS not a multiple of 6 bytes")); }
        }
        PING => {
            if len != 8 { return Err(conn_err(FRAME_SIZE_ERROR, "PING not 8 bytes")); }
        }
        GOAWAY => {
            if len < 8 { return Err(conn_err(FRAME_SIZE_ERROR, "GOAWAY too short")); }
        }
        WINDOW_UPDATE => {
            if len != 4 { return Err(conn_err(FRAME_SIZE_ERROR, "WINDOW_UPDATE not 4 bytes")); }
        }
        _ => {}
    }
    Ok(f)
}

/// A stream's state, under its connection's mu.
pub(crate) struct Stream {
    pub id: u32,
    // Received data not read yet, and whether END_STREAM came.
    buf: Vec<u8>,
    pos: usize,
    pub recv_end: bool,
    // What the peer may still send, and what was read and not yet given
    // back by WINDOW_UPDATE.
    recv_window: i64,
    recv_unacked: i64,
    // Content-Length of what is received, and the bytes so far.
    pub want_len: Option<u64>,
    got_len: u64,
    // What this side may still send; whether END_STREAM went.
    send_window: i64,
    pub sent_end: bool,
    // RST_STREAM sent or received: its code.
    pub reset: Option<u32>,
    // (Client) the response's head when it comes (1xx heads skipped).
    pub head: Option<Vec<HeaderField>>,
    // (Client) when waiting on the stream ends (the request's timeout).
    pub deadline: Option<Instant>,
}

/// A connection's state (one per connection, shared).
pub(crate) struct Core {
    pub net: NetStream,
    pub mu: Mutex<u8>,
    pub cond: Condvar,
    pub streams: HashMap<u32, &mut Stream>,
    // Frames to write, in order.
    tx: Sender<Vec<u8>>,
    // (Under hmu: the encoder's table follows the order header blocks are
    // queued in.)
    hmu: Mutex<u8>,
    enc: Encoder,
    pub dec: Decoder,
    // Connection windows: what this side may send, what the peer may.
    send_window: i64,
    recv_window: i64,
    recv_unacked: i64,
    // This side's settings: a stream's receive window, the connection's,
    // the largest frame read.
    my_stream_window: i64,
    my_conn_window: i64,
    pub my_max_frame: usize,
    pub max_header_bytes: usize,
    // The peer's settings.
    peer_stream_window: i64,
    pub peer_max_frame: usize,
    pub peer_max_streams: u32,
    pub peer_max_header_list: usize,
    // Why the connection is gone (None: it is not).
    pub dead: Option<String>,
    // A GOAWAY received: the last stream the peer will answer.
    pub goaway: Option<u32>,
    pub goaway_sent: bool,
    // The highest stream id the peer opened (server) or this side did.
    pub last_id: u32,
    // When the last stream ended (for the idle timeout).
    idle_since: Instant,
    pub server: bool,
}

pub(crate) struct Settings {
    pub stream_window: u32,
    pub conn_window: u32,
    pub max_streams: u32,
    pub max_header_bytes: usize,
}

impl Core {
    // The state of a connection on net, its writer started and this
    // side's preface (client) and settings queued.
    pub fn new(net: NetStream, server: bool, s: &Settings) -> &mut Core {
        let (tx, rx) = channel::<Vec<u8>>();
        let mut dec = Decoder::new(4096);
        dec.set_max_string_length(s.max_header_bytes);
        let c = &mut Core {
            net: net.clone(), mu: Mutex::new(0), cond: Condvar::new(), streams: HashMap::new(), tx, hmu: Mutex::new(0), enc: Encoder::new(), dec,
            send_window: DEFAULT_WINDOW, recv_window: s.conn_window as i64, recv_unacked: 0,
            my_stream_window: s.stream_window as i64, my_conn_window: s.conn_window as i64, my_max_frame: MIN_FRAME, max_header_bytes: s.max_header_bytes,
            peer_stream_window: DEFAULT_WINDOW, peer_max_frame: MIN_FRAME, peer_max_streams: 4294967295, peer_max_header_list: 0,
            dead: None, goaway: None, goaway_sent: false, last_id: 0, idle_since: Instant::now(), server,
        };
        let me = c;
        crate::thread::spawn(|| writer(me, rx, net));
        let mut first: Vec<u8> = Vec::new();
        if !server { first.extend_from_slice(PREFACE.as_bytes()); }
        let mut set: Vec<(u16, u32)> = Vec::new();
        if !server { set.push((ENABLE_PUSH, 0)); }
        if server { set.push((MAX_CONCURRENT_STREAMS, s.max_streams)); }
        set.push((INITIAL_WINDOW_SIZE, s.stream_window));
        set.push((MAX_HEADER_LIST_SIZE, s.max_header_bytes as u32));
        first.extend_from_slice(settings_frame(set.as_slice()).as_slice());
        if s.conn_window as i64 > DEFAULT_WINDOW {
            first.extend_from_slice(frame(WINDOW_UPDATE, 0, 0, u32_payload(s.conn_window - DEFAULT_WINDOW as u32).as_slice()).as_slice());
        }
        c.send(first);
        c
    }

    // Queues bytes for the writer.
    pub fn send(&self, b: Vec<u8>) { let _ = self.tx.send(b); }

    pub fn new_stream(&mut self, id: u32) -> &mut Stream {
        let st = &mut Stream { id, buf: Vec::new(), pos: 0, recv_end: false, recv_window: self.my_stream_window, recv_unacked: 0, want_len: None, got_len: 0,
            send_window: self.peer_stream_window, sent_end: false, reset: None, head: None, deadline: None };
        self.streams.insert(id, st);
        st
    }

    // (Under mu.) The stream leaves the table once both sides ended or it
    // was reset; data it holds unread goes back to the connection's window.
    fn retire(&mut self, st: &mut Stream) {
        if !(st.reset.is_some() || (st.sent_end && st.recv_end)) { return; }
        if self.streams.remove(&st.id).is_none() { return; }
        if st.reset.is_some() && st.buf.len() > st.pos {
            self.give_back_conn((st.buf.len() - st.pos) as i64);
            st.buf = Vec::new();
            st.pos = 0;
        }
        if self.streams.len() == 0 { self.idle_since = Instant::now(); }
    }

    // (Under mu.) Waits to be woken; false when st's deadline passed
    // instead (st is then reset, CANCEL).
    pub fn wait(&mut self, st: &mut Stream) -> bool {
        match st.deadline {
            None => {
                self.cond.wait(&self.mu);
                true
            }
            Some(d) => {
                let now = Instant::now();
                if now >= d {
                    self.reset_locked(st, CANCEL, true);
                    return false;
                }
                let _ = self.cond.wait_timeout(&self.mu, d.duration_since(now));
                true
            }
        }
    }

    // (Client) Opens a stream with a header block: its id the next and its
    // HEADERS queued in the same step, so ids go out in order. Err why the
    // connection takes no new stream.
    pub fn open_stream(&mut self, fields: &[HeaderField], end_stream: bool, deadline: Option<Instant>) -> Result<&mut Stream, String> {
        self.hmu.lock();
        self.mu.lock();
        if let Some(why) = self.refuses() {
            self.mu.unlock();
            self.hmu.unlock();
            return Err(why);
        }
        let id = if self.last_id == 0 { 1 } else { self.last_id + 2 };
        self.last_id = id;
        let st = self.new_stream(id);
        st.deadline = deadline;
        if end_stream { st.sent_end = true; }
        self.mu.unlock();
        self.write_headers_locked(id, fields, end_stream);
        self.hmu.unlock();
        Ok(st)
    }

    // (Under mu.) Why a new stream may not be opened (None: it may).
    pub fn refuses(&self) -> Option<String> {
        if let Some(d) = &self.dead { return Some(d.clone()); }
        if self.goaway.is_some() || self.goaway_sent { return Some("connection going away".to_string()); }
        if self.streams.len() as u32 >= self.peer_max_streams { return Some("too many streams".to_string()); }
        if self.last_id >= 2147483645 { return Some("stream ids used up".to_string()); }
        None
    }

    // (Under mu.) END_STREAM sent on st (with HEADERS).
    pub fn sent_end_locked(&mut self, st: &mut Stream) {
        st.sent_end = true;
        self.retire(st);
    }

    // (Under mu.) END_STREAM received on st (with trailers); whether the
    // data matched its Content-Length.
    pub fn recv_end_locked(&mut self, st: &mut Stream) -> bool {
        st.recv_end = true;
        let ok = match st.want_len { Some(n) => n == st.got_len, None => true };
        self.retire(st);
        self.cond.notify_all();
        ok
    }

    // (Under mu.) Resets st with code: RST_STREAM sent unless it came from
    // the peer.
    pub fn reset_locked(&mut self, st: &mut Stream, code: u32, send: bool) {
        if st.reset.is_some() { return; }
        st.reset = Some(code);
        if send { self.send(frame(RST_STREAM, 0, st.id, u32_payload(code).as_slice())); }
        self.retire(st);
        self.cond.notify_all();
    }

    pub fn reset(&mut self, st: &mut Stream, code: u32) {
        self.mu.lock();
        self.reset_locked(st, code, true);
        self.mu.unlock();
    }

    // (Under mu.) Ends the connection: everyone waiting is woken.
    pub fn fail_locked(&mut self, why: &str) {
        if self.dead.is_none() { self.dead = Some(why.to_string()); }
        self.cond.notify_all();
    }

    // Ends the connection with GOAWAY (code), then closes it once the
    // writer has written what was queued.
    pub fn goaway(&mut self, code: u32, msg: &str) {
        self.mu.lock();
        if !self.goaway_sent {
            self.goaway_sent = true;
            let mut p = u32_payload(if self.server { self.last_id } else { 0 });
            put32(&mut p, code);
            p.extend_from_slice(msg.as_bytes());
            self.send(frame(GOAWAY, 0, 0, p.as_slice()));
        }
        self.mu.unlock();
    }

    // Stops the writer after what is queued, and so the connection.
    pub fn close(&mut self) {
        self.mu.lock();
        self.fail_locked("connection closed");
        self.mu.unlock();
        self.tx.close();
    }

    // Queues a header block for stream id: HEADERS, then CONTINUATION
    // frames, at most the peer's frame size each; all queued together.
    pub fn write_headers(&mut self, id: u32, fields: &[HeaderField], end_stream: bool) {
        self.hmu.lock();
        self.write_headers_locked(id, fields, end_stream);
        self.hmu.unlock();
    }

    fn write_headers_locked(&mut self, id: u32, fields: &[HeaderField], end_stream: bool) {
        let mut block: Vec<u8> = Vec::new();
        for f in fields.iter() { self.enc.write_field(&mut block, f); }
        let mut out: Vec<u8> = Vec::with_capacity(block.len() + 32);
        let max = self.peer_max_frame;
        let mut at = 0;
        let mut first = true;
        loop {
            let end = crate::cmp::min(block.len(), at + max);
            let mut flags = if end == block.len() { END_HEADERS } else { 0 };
            if first && end_stream { flags |= END_STREAM; }
            put_frame(&mut out, if first { HEADERS } else { CONTINUATION }, flags, id, &block[at..end]);
            first = false;
            at = end;
            if at == block.len() { break; }
        }
        self.send(out);
    }

    // Sends data on st within its window and the connection's, waiting
    // for room; END_STREAM with the last (an empty DATA if there is none).
    pub fn write_data(&mut self, st: &mut Stream, data: &[u8], end: bool) -> io::Result<()> {
        if data.len() == 0 && !end { return Ok(()); }
        let mut at = 0;
        loop {
            self.mu.lock();
            let mut n = 0;
            loop {
                if let Some(e) = self.stream_error(st) {
                    self.mu.unlock();
                    return Err(e);
                }
                if at == data.len() { break; }
                let w = if st.send_window < self.send_window { st.send_window } else { self.send_window };
                if w > 0 {
                    n = crate::cmp::min(crate::cmp::min(data.len() - at, w as usize), self.peer_max_frame);
                    st.send_window -= n as i64;
                    self.send_window -= n as i64;
                    break;
                }
                if !self.wait(st) {
                    self.mu.unlock();
                    return Err(timed_out());
                }
            }
            let last = end && at + n == data.len();
            self.send(frame(DATA, if last { END_STREAM } else { 0 }, st.id, &data[at..at + n]));
            at += n;
            if last {
                st.sent_end = true;
                self.retire(st);
            }
            self.mu.unlock();
            if at == data.len() { return Ok(()); }
        }
    }

    // Ends st's sending side: an empty DATA with END_STREAM.
    pub fn end_stream(&mut self, st: &mut Stream) -> io::Result<()> { self.write_data(st, &[], true) }

    // (Under mu.) Why st can be used no more: the connection gone, or the
    // stream reset.
    fn stream_error(&self, st: &Stream) -> Option<io::Error> {
        if let Some(d) = &self.dead { return Some(io::Error::new(io::ErrorKind::ConnectionAborted, `http2: ${d}`.to_string().as_str())); }
        match st.reset {
            Some(c) => Some(io::Error::new(io::ErrorKind::ConnectionReset, `http2: stream reset (${code_name(c)})`.to_string().as_str())),
            None => None,
        }
    }

    // Reads st's received data, waiting for some; the bytes read go back
    // to the peer's windows (by WINDOW_UPDATE once half a window is read,
    // as Go's).
    pub fn read_body(&mut self, st: &mut Stream, buf: &mut [u8]) -> io::Result<usize> {
        if buf.len() == 0 { return Ok(0); }
        self.mu.lock();
        loop {
            if st.pos < st.buf.len() { break; }
            if st.recv_end {
                self.mu.unlock();
                return Ok(0);
            }
            if let Some(e) = self.stream_error(st) {
                self.mu.unlock();
                return Err(e);
            }
            if !self.wait(st) {
                self.mu.unlock();
                return Err(timed_out());
            }
        }
        let n = crate::cmp::min(buf.len(), st.buf.len() - st.pos);
        buf[..n].copy_from_slice(&st.buf[st.pos..st.pos + n]);
        st.pos += n;
        if st.pos == st.buf.len() {
            st.buf.clear();
            st.pos = 0;
        }
        if !st.recv_end && st.reset.is_none() {
            st.recv_unacked += n as i64;
            if st.recv_unacked >= self.my_stream_window / 2 {
                self.send(frame(WINDOW_UPDATE, 0, st.id, u32_payload(st.recv_unacked as u32).as_slice()));
                st.recv_window += st.recv_unacked;
                st.recv_unacked = 0;
            }
        }
        self.give_back_conn(n as i64);
        self.mu.unlock();
        Ok(n)
    }

    // (Under mu.) n bytes of the connection's window read (or dropped).
    fn give_back_conn(&mut self, n: i64) {
        self.recv_unacked += n;
        if self.recv_unacked >= self.my_conn_window / 2 && self.dead.is_none() {
            self.send(frame(WINDOW_UPDATE, 0, 0, u32_payload(self.recv_unacked as u32).as_slice()));
            self.recv_window += self.recv_unacked;
            self.recv_unacked = 0;
        }
    }

    // Reads frames until the connection ends; on_headers takes each whole
    // header block (stream id, fields, END_STREAM), on_push PUSH_PROMISE
    // (a client's error). Returns why it ended.
    pub fn read_loop(&mut self, r: &mut BufReader<NetStream>, on_headers: fn(u32, Vec<HeaderField>, bool) -> Result<(), H2Error>) -> String {
        let mut first = true;
        loop {
            let res = match read_frame(r, self.my_max_frame) {
                Ok(f) => {
                    if first && f.kind != SETTINGS {
                        Err(conn_err(PROTOCOL_ERROR, "first frame not SETTINGS"))
                    } else {
                        first = false;
                        self.handle(r, f, on_headers)
                    }
                }
                Err(e) => Err(e),
            };
            match res {
                Ok(()) => {}
                Err(H2Error::Stream(id, code)) => {
                    self.mu.lock();
                    let st = match self.streams.get(&id) { Some(s) => Some(*s), None => None };
                    match st {
                        Some(s) => self.reset_locked(s, code, true),
                        None => self.send(frame(RST_STREAM, 0, id, u32_payload(code).as_slice())),
                    }
                    self.mu.unlock();
                }
                Err(H2Error::Conn(code, msg)) => {
                    self.goaway(code, msg.as_str());
                    let why = `${code_name(code)}: ${msg}`.to_string();
                    self.mu.lock();
                    self.fail_locked(why.as_str());
                    self.mu.unlock();
                    // What the peer sent is read (and dropped) for a while
                    // before the connection closes, as Go's goAwayTimeout:
                    // closed with bytes unread, the connection is reset and
                    // the peer may lose the GOAWAY (Windows drops what it
                    // had received).
                    drain(r, Duration::from_secs(1));
                    self.tx.close();
                    return why;
                }
                Err(H2Error::Io(e)) => {
                    self.mu.lock();
                    let why = match &self.dead { Some(d) => d.clone(), None => e.to_string() };
                    self.fail_locked(why.as_str());
                    self.mu.unlock();
                    self.tx.close();
                    return why;
                }
            }
        }
    }

    fn handle(&mut self, r: &mut BufReader<NetStream>, f: Frame, on_headers: fn(u32, Vec<HeaderField>, bool) -> Result<(), H2Error>) -> Result<(), H2Error> {
        match f.kind {
            DATA => self.on_data(f),
            HEADERS => {
                let id = f.stream;
                let end = f.has(END_STREAM);
                let mut block = f.payload;
                let mut done = f.has(END_HEADERS);
                // (A block may be well over the header list's limit
                // compressed; a little over the limit is let through for
                // the 431 the limit makes.)
                let cap = 2 * self.max_header_bytes + 65536;
                while !done {
                    let c = read_frame(r, self.my_max_frame)?;
                    if c.kind != CONTINUATION || c.stream != id { return Err(conn_err(PROTOCOL_ERROR, "header block not continued by CONTINUATION")); }
                    block.extend_from_slice(c.payload.as_slice());
                    if block.len() > cap { return Err(conn_err(ENHANCE_YOUR_CALM, "header block too large")); }
                    done = c.has(END_HEADERS);
                }
                let fields = match self.dec.decode_full(block.as_slice()) {
                    Ok(v) => v,
                    Err(e) => return Err(conn_err(COMPRESSION_ERROR, e.to_string().as_str())),
                };
                on_headers(id, fields, end)
            }
            PRIORITY => Ok(()),
            RST_STREAM => {
                self.mu.lock();
                if !self.known(f.stream) {
                    self.mu.unlock();
                    return Err(conn_err(PROTOCOL_ERROR, "RST_STREAM on an idle stream"));
                }
                if let Some(s) = self.streams.get(&f.stream) {
                    let st = *s;
                    self.reset_locked(st, be32(f.payload.as_slice()), false);
                }
                self.mu.unlock();
                Ok(())
            }
            SETTINGS => self.on_settings(f),
            PUSH_PROMISE => Err(conn_err(PROTOCOL_ERROR, "PUSH_PROMISE (push is off)")),
            PING => {
                if !f.has(ACK) { self.send(frame(PING, ACK, 0, f.payload.as_slice())); }
                Ok(())
            }
            GOAWAY => {
                let last = be32(f.payload.as_slice()) & 0x7fffffff;
                self.mu.lock();
                self.goaway = Some(last);
                // (Client) streams it will not answer: refused, so a
                // request may go again on another connection.
                let mut refused: Vec<&mut Stream> = Vec::new();
                for (id, s) in self.streams.iter() {
                    if !self.server && *id > last { refused.push(*s); }
                }
                for s in refused.iter() { self.reset_locked(*s, REFUSED_STREAM, false); }
                self.cond.notify_all();
                self.mu.unlock();
                Ok(())
            }
            WINDOW_UPDATE => {
                let inc = (be32(f.payload.as_slice()) & 0x7fffffff) as i64;
                self.mu.lock();
                let r = self.on_window_update(f.stream, inc);
                self.cond.notify_all();
                self.mu.unlock();
                r
            }
            CONTINUATION => Err(conn_err(PROTOCOL_ERROR, "CONTINUATION without HEADERS")),
            // (Unknown types are ignored.)
            _ => Ok(()),
        }
    }

    // (Under mu.) Whether stream id was ever opened (else it is idle):
    // only clients open streams (odd ids), push being off.
    pub fn known(&self, id: u32) -> bool { id % 2 == 1 && id <= self.last_id }

    fn on_window_update(&mut self, id: u32, inc: i64) -> Result<(), H2Error> {
        if id == 0 {
            if inc == 0 { return Err(conn_err(PROTOCOL_ERROR, "WINDOW_UPDATE of 0")); }
            if self.send_window + inc > MAX_WINDOW { return Err(conn_err(FLOW_CONTROL_ERROR, "connection window past 2^31-1")); }
            self.send_window += inc;
            return Ok(());
        }
        if !self.known(id) { return Err(conn_err(PROTOCOL_ERROR, "WINDOW_UPDATE on an idle stream")); }
        let st = match self.streams.get(&id) { Some(s) => *s, None => return Ok(()) };
        if inc == 0 { return Err(H2Error::Stream(id, PROTOCOL_ERROR)); }
        if st.send_window + inc > MAX_WINDOW { return Err(H2Error::Stream(id, FLOW_CONTROL_ERROR)); }
        st.send_window += inc;
        Ok(())
    }

    fn on_settings(&mut self, f: Frame) -> Result<(), H2Error> {
        if f.has(ACK) { return Ok(()); }
        let p = f.payload.as_slice();
        let mut k = 0;
        let mut table: Option<usize> = None;
        self.mu.lock();
        while k < p.len() {
            let id = ((p[k] as u16) << 8) | p[k + 1] as u16;
            let v = be32(&p[k + 2..k + 6]);
            k += 6;
            match id {
                HEADER_TABLE_SIZE => table = Some(crate::cmp::min(v as usize, 4096)),
                ENABLE_PUSH => {
                    if v > 1 || (v == 1 && !self.server) {
                        self.mu.unlock();
                        return Err(conn_err(PROTOCOL_ERROR, "bad SETTINGS_ENABLE_PUSH"));
                    }
                }
                MAX_CONCURRENT_STREAMS => self.peer_max_streams = v,
                INITIAL_WINDOW_SIZE => {
                    if v as i64 > MAX_WINDOW {
                        self.mu.unlock();
                        return Err(conn_err(FLOW_CONTROL_ERROR, "SETTINGS_INITIAL_WINDOW_SIZE past 2^31-1"));
                    }
                    // (Every open stream's window moves by the change, RFC
                    // 9113 6.9.2.)
                    let d = v as i64 - self.peer_stream_window;
                    self.peer_stream_window = v as i64;
                    for (_, s) in self.streams.iter() {
                        let st = *s;
                        st.send_window += d;
                    }
                }
                MAX_FRAME_SIZE => {
                    if v < 16384 || v > 16777215 {
                        self.mu.unlock();
                        return Err(conn_err(PROTOCOL_ERROR, "bad SETTINGS_MAX_FRAME_SIZE"));
                    }
                    self.peer_max_frame = v as usize;
                }
                MAX_HEADER_LIST_SIZE => self.peer_max_header_list = v as usize,
                _ => {}
            }
        }
        self.cond.notify_all();
        self.mu.unlock();
        // (hmu before mu where both are held: not under mu.)
        if let Some(n) = table {
            self.hmu.lock();
            self.enc.set_max_dynamic_table_size_limit(n);
            self.hmu.unlock();
        }
        self.send(frame(SETTINGS, ACK, 0, &[]));
        Ok(())
    }

    fn on_data(&mut self, f: Frame) -> Result<(), H2Error> {
        self.mu.lock();
        let flow = f.flow as i64;
        if flow > self.recv_window {
            self.mu.unlock();
            return Err(conn_err(FLOW_CONTROL_ERROR, "DATA past the connection's window"));
        }
        self.recv_window -= flow;
        if !self.known(f.stream) {
            self.mu.unlock();
            return Err(conn_err(PROTOCOL_ERROR, "DATA on an idle stream"));
        }
        let st = match self.streams.get(&f.stream) {
            Some(s) => *s,
            None => {
                // A closed stream: its bytes go back at once.
                self.give_back_conn(flow);
                self.mu.unlock();
                return Err(H2Error::Stream(f.stream, STREAM_CLOSED));
            }
        };
        if st.recv_end {
            self.give_back_conn(flow);
            self.mu.unlock();
            return Err(H2Error::Stream(f.stream, STREAM_CLOSED));
        }
        if flow > st.recv_window {
            self.give_back_conn(flow);
            self.mu.unlock();
            return Err(H2Error::Stream(f.stream, FLOW_CONTROL_ERROR));
        }
        st.recv_window -= flow;
        // (Padding is read at once.)
        let pad = flow - f.payload.len() as i64;
        if pad > 0 {
            st.recv_unacked += pad;
            self.give_back_conn(pad);
        }
        st.got_len += f.payload.len() as u64;
        let end = f.has(END_STREAM);
        let bad_len = match st.want_len { Some(n) => st.got_len > n || (end && st.got_len != n), None => false };
        if bad_len {
            self.give_back_conn(f.payload.len() as i64);
            self.mu.unlock();
            return Err(H2Error::Stream(f.stream, PROTOCOL_ERROR));
        }
        if st.reset.is_some() {
            self.give_back_conn(f.payload.len() as i64);
        } else {
            st.buf.extend_from_slice(f.payload.as_slice());
        }
        if end {
            st.recv_end = true;
            self.retire(st);
        }
        self.cond.notify_all();
        self.mu.unlock();
        Ok(())
    }

    // Closes the connection once it has had no stream for d (checked by a
    // thread of its own until the connection ends).
    pub fn idle_timeout(&mut self, d: Duration) {
        let me = self;
        crate::thread::spawn(|| {
            loop {
                crate::thread::sleep(d / 2);
                me.mu.lock();
                if me.dead.is_some() {
                    me.mu.unlock();
                    return;
                }
                let idle = me.streams.len() == 0 && me.idle_since.elapsed() >= d;
                me.mu.unlock();
                if idle {
                    me.goaway(NO_ERROR, "idle");
                    me.close();
                    return;
                }
            }
        });
    }
}

// Reads and drops what comes on r for at most d (or until the peer
// closes).
fn drain(r: &mut BufReader<NetStream>, d: Duration) {
    let end = Instant::now() + d;
    let mut buf: Vec<u8> = Vec::new();
    buf.resize(16384, 0);
    loop {
        let now = Instant::now();
        if now >= end { return; }
        let _ = r.get_ref().set_read_timeout(Some(end.duration_since(now)));
        match r.read(buf.as_mut_slice()) {
            Ok(0) => return,
            Ok(_) => {}
            Err(_) => return,
        }
    }
}

// The writer: queued frames in order, several to a write when there are
// several; the connection closes when the queue does (or a write fails).
fn writer(c: &mut Core, rx: Receiver<Vec<u8>>, net: NetStream) {
    let mut w = net.clone();
    loop {
        let mut b = match rx.recv() {
            Ok(b) => b,
            Err(_) => break,
        };
        while b.len() < 65536 {
            match rx.try_recv() {
                Ok(more) => b.extend_from_slice(more.as_slice()),
                Err(_) => break,
            }
        }
        if let Err(e) = w.write_all(b.as_slice()) {
            c.mu.lock();
            c.fail_locked(e.to_string().as_str());
            c.mu.unlock();
            break;
        }
    }
    net.close();
}

/// A stream's received data as a reader (a request body on the server, a
/// response body on the client).
pub(crate) struct BodyReader {
    c: &mut Core,
    st: &mut Stream,
}

impl BodyReader {
    pub fn new(c: &mut Core, st: &mut Stream) -> &mut BodyReader { &mut BodyReader { c, st } }
}

impl Read for BodyReader {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> { self.c.read_body(self.st, buf) }
}

// Header names that HTTP/2 does not carry (RFC 9113 8.2.2).
pub(crate) fn connection_specific(name: &str) -> bool {
    match name {
        "connection" | "keep-alive" | "proxy-connection" | "transfer-encoding" | "upgrade" => true,
        _ => false,
    }
}

// Whether a received field is well formed for HTTP/2: a lowercase token
// name (pseudo-headers aside), a value without NUL, CR or LF.
pub(crate) fn valid_field(f: &HeaderField) -> bool {
    let n = f.name.as_bytes();
    let start = if n.len() > 0 && n[0] == b':' { 1 } else { 0 };
    if n.len() == start { return false; }
    for c in n[start..].iter() {
        if *c >= b'A' && *c <= b'Z' { return false; }
        if !crate::http::is_token(*c) { return false; }
    }
    for c in f.value.as_bytes().iter() {
        if *c == 0 || *c == b'\r' || *c == b'\n' { return false; }
    }
    true
}
