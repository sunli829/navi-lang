// An HTTP/2 client connection (as Go's http2 ClientConn): requests as
// streams on it, from any thread, at once.

use crate::io::{self, Read, BufReader};
use crate::time::{Duration, Instant};
use crate::url::Url;
use crate::http::{Body, HeaderMap, Method, Request, Response, StatusCode, Version};
use crate::http::hpack::HeaderField;
use crate::http::wire::NetStream;
use crate::http::h2::{self, Core, Stream, BodyReader, H2Error, Settings};

// A response's receive windows: a stream's (Go's transport: 4 MiB) and
// the connection's (1 GiB as Go's, so streams wait only on their own).
const STREAM_WINDOW: u32 = 4194304;
const CONN_WINDOW: u32 = 1073741824;
// How long a connection without streams stays open (Go's
// DefaultTransport.IdleConnTimeout).
const IDLE: u64 = 90;

pub(crate) struct ClientConn {
    pub key: String,
    c: &mut Core,
}

/// A connection's HTTP/2 side: the preface and settings sent, its reader
/// started.
pub(crate) fn start(net: NetStream, key: &str) -> &mut ClientConn {
    let c = Core::new(net.clone(), false, &Settings { stream_window: STREAM_WINDOW, conn_window: CONN_WINDOW, max_streams: 0, max_header_bytes: 1 << 20 });
    let cc = &mut ClientConn { key: key.to_string(), c };
    let _ = net.set_read_timeout(None);
    let _ = net.set_write_timeout(None);
    c.idle_timeout(Duration::from_secs(IDLE));
    let r = &mut BufReader::with_capacity(65536, net);
    crate::thread::spawn(|| { c.read_loop(r, |id: u32, fields: Vec<HeaderField>, end: bool| -> Result<(), H2Error> { on_headers(c, id, fields, end) }); });
    cc
}

// A response's head (or its trailers) on stream id.
fn on_headers(c: &mut Core, id: u32, fields: Vec<HeaderField>, end: bool) -> Result<(), H2Error> {
    c.mu.lock();
    let st = match c.streams.get(&id) {
        Some(s) => *s,
        None => {
            let known = c.known(id);
            c.mu.unlock();
            if known { return Err(H2Error::Stream(id, h2::STREAM_CLOSED)); }
            return Err(H2Error::Conn(h2::PROTOCOL_ERROR, "HEADERS on a stream not opened".to_string()));
        }
    };
    if st.head.is_some() {
        // Trailers (dropped): they end the stream.
        if !end {
            c.mu.unlock();
            return Err(H2Error::Stream(id, h2::PROTOCOL_ERROR));
        }
        let ok = c.recv_end_locked(st);
        c.mu.unlock();
        if !ok { return Err(H2Error::Stream(id, h2::PROTOCOL_ERROR)); }
        return Ok(());
    }
    let mut status: Option<u16> = None;
    let mut regular = false;
    let mut want: Option<u64> = None;
    for f in fields.iter() {
        let bad = !h2::valid_field(f) || (f.is_pseudo() && (regular || f.name.as_str() != ":status" || status.is_some())) || h2::connection_specific(f.name.as_str());
        if bad {
            c.mu.unlock();
            return Err(H2Error::Stream(id, h2::PROTOCOL_ERROR));
        }
        if f.is_pseudo() {
            status = match f.value.parse::<u16>() { Ok(n) => Some(n), Err(_) => None };
            if status.is_none() {
                c.mu.unlock();
                return Err(H2Error::Stream(id, h2::PROTOCOL_ERROR));
            }
        } else {
            regular = true;
            if f.name.as_str() == "content-length" {
                want = match f.value.trim().parse::<u64>() { Ok(n) => Some(n), Err(_) => None };
                if want.is_none() {
                    c.mu.unlock();
                    return Err(H2Error::Stream(id, h2::PROTOCOL_ERROR));
                }
            }
        }
    }
    let code = match status {
        Some(n) => n,
        None => {
            c.mu.unlock();
            return Err(H2Error::Stream(id, h2::PROTOCOL_ERROR));
        }
    };
    if code >= 100 && code < 200 {
        // (1xx: another head follows.)
        c.mu.unlock();
        if end { return Err(H2Error::Stream(id, h2::PROTOCOL_ERROR)); }
        return Ok(());
    }
    st.head = Some(fields);
    st.want_len = want;
    if end {
        let ok = c.recv_end_locked(st);
        c.mu.unlock();
        if !ok { return Err(H2Error::Stream(id, h2::PROTOCOL_ERROR)); }
        return Ok(());
    }
    c.cond.notify_all();
    c.mu.unlock();
    Ok(())
}

// Why a round trip failed: refused (the request may go again on another
// connection), or another error.
pub(crate) enum TripError {
    Refused(String),
    Io(io::Error),
}

impl ClientConn {
    /// Whether it may take another request.
    pub fn usable(&self) -> bool {
        self.c.mu.lock();
        let ok = self.c.refuses().is_none();
        self.c.mu.unlock();
        ok
    }

    /// Whether it is closed for good.
    pub fn dead(&self) -> bool {
        self.c.mu.lock();
        let d = self.c.dead.is_some();
        self.c.mu.unlock();
        d
    }

    /// Sends req (its head made from fields: the defaults and the
    /// request's) and returns the response once its head comes.
    pub fn round_trip(&mut self, req: &mut Request, url: &Url, defaults: &HeaderMap, deadline: Option<Instant>) -> Result<Response, TripError> {
        let c = self.c;
        let authority = match req.headers.get("host") {
            Some(h) => h.to_string(),
            None => authority_of(url),
        };
        let mut fields: Vec<HeaderField> = Vec::new();
        fields.push(HeaderField::new(":method", req.method.as_str()));
        fields.push(HeaderField::new(":scheme", url.scheme()));
        fields.push(HeaderField::new(":authority", authority.as_str()));
        if req.method != Method::CONNECT { fields.push(HeaderField::new(":path", req.target.as_str())); }
        for (k, v) in defaults.iter() {
            if !req.headers.contains_key(k.as_str()) { push_field(&mut fields, k.as_str(), v.as_str()); }
        }
        for (k, v) in req.headers.iter() { push_field(&mut fields, k.as_str(), v.as_str()); }
        let body_len = req.body.len();
        if !req.headers.contains_key("content-length") {
            if let Some(n) = body_len {
                if n > 0 || !(req.method == Method::GET || req.method == Method::HEAD) { fields.push(HeaderField::new("content-length", n.to_string().as_str())); }
            }
        }
        let no_body = body_len.is_some_and(|n| n == 0);
        let st = match c.open_stream(fields.as_slice(), no_body, deadline) {
            Ok(s) => s,
            Err(why) => return Err(TripError::Refused(why)),
        };
        if !no_body {
            let r = match req.body.as_bytes() {
                Some(b) => c.write_data(st, b, true),
                None => send_body(c, st, &mut req.body),
            };
            if let Err(e) = r {
                // (Refused: the server never saw it.)
                if refused(c, st) { return Err(TripError::Refused(e.to_string())); }
                c.reset(st, h2::CANCEL);
                return Err(TripError::Io(e));
            }
        }
        // The head.
        c.mu.lock();
        loop {
            if st.head.is_some() { break; }
            if st.reset.is_some() || c.dead.is_some() {
                let r = st.reset;
                let why = match &c.dead { Some(d) => d.clone(), None => "".to_string() };
                c.mu.unlock();
                if r == Some(h2::REFUSED_STREAM) { return Err(TripError::Refused("stream refused".to_string())); }
                let msg = match r {
                    Some(code) => `http2: stream reset by the server (${h2::code_name(code)})`.to_string(),
                    None => `http2: ${why}`.to_string(),
                };
                return Err(TripError::Io(io::Error::new(io::ErrorKind::ConnectionReset, msg.as_str())));
            }
            if !c.wait(st) {
                c.mu.unlock();
                return Err(TripError::Io(h2::timed_out()));
            }
        }
        let head = st.head.clone().unwrap();
        let want = st.want_len;
        let ended = st.recv_end;
        c.mu.unlock();
        let mut code = 200;
        let mut headers = HeaderMap::new();
        for f in head.iter() {
            if f.name.as_str() == ":status" { code = f.value.parse::<u16>().unwrap_or(200); } else { headers.append(f.name.as_str(), f.value.as_str()); }
        }
        let mut resp = Response::new(StatusCode(code));
        resp.version = Version::HTTP_2;
        resp.headers = headers;
        // (Ended already: what came is in the stream's buffer.)
        let empty = req.method == Method::HEAD || code == 204 || code == 304 || (ended && want == Some(0));
        resp.body = if empty { Body::from(Vec::new()) } else { Body::from_reader(BodyReader::new(c, st), want) };
        if req.method == Method::HEAD { resp.body.len = want; }
        resp.url = Some(url.clone());
        Ok(resp)
    }
}

fn refused(c: &mut Core, st: &mut Stream) -> bool {
    c.mu.lock();
    let r = st.reset == Some(h2::REFUSED_STREAM);
    c.mu.unlock();
    r
}

// (Fields HTTP/2 does not carry are left out; the host is :authority.)
fn push_field(fields: &mut Vec<HeaderField>, k: &str, v: &str) {
    if h2::connection_specific(k) || k == "host" { return; }
    if k == "te" && v != "trailers" { return; }
    fields.push(HeaderField::new(k, v));
}

fn authority_of(url: &Url) -> String {
    let host = match url.host() {
        Some(crate::url::Host::Ipv6(a)) => `[${a}]`.to_string(),
        Some(crate::url::Host::Ipv4(a)) => a.to_string(),
        Some(crate::url::Host::Domain(d)) => d,
        None => String::new(),
    };
    match url.port() {
        Some(p) => `${host}:${p}`.to_string(),
        None => host,
    }
}

fn send_body(c: &mut Core, st: &mut Stream, body: &mut Body) -> io::Result<()> {
    let mut buf: Vec<u8> = Vec::new();
    buf.resize(16384, 0);
    loop {
        let n = body.read(buf.as_mut_slice())?;
        if n == 0 { return c.end_stream(st); }
        c.write_data(st, &buf[..n], false)?;
    }
}
