// The client (as reqwest::blocking): connections are kept and reused per
// host once a response's body has been read to the end. Over https it
// speaks HTTP/2 when the server chooses it by ALPN (as Go's and reqwest's):
// one connection per host then carries every request at once.

use crate::{
    http::{
        Body, Error, ErrorKind, HeaderMap, Method, Request, Response, StatusCode, Version,
        h2::client::{self as h2c, ClientConn, TripError},
        wire::{self, NetStream},
    },
    io::{self, BufReader, Read, Write},
    net::{TcpStream, ToSocketAddrs},
    sync::Mutex,
    time::{Duration, Instant},
    tls::{Certificate, TlsConnector},
    url::Url,
};

/// A value that can be converted to a [`Url`]: `&str`, `String`, `Url`
/// or `&Url`.
///
/// The methods of [`Client`] that take a URL take any of these.
pub trait IntoUrl {
    /// Converts the value to a `Url`.
    ///
    /// # Errors
    ///
    /// Returns an error of kind [`ErrorKind::Builder`] if the string is
    /// not a valid absolute URL.
    fn into_url(&self) -> Result<Url, Error>;
}

impl IntoUrl for &str {
    fn into_url(&self) -> Result<Url, Error> {
        Ok(Url::parse(*self)?)
    }
}

impl IntoUrl for String {
    fn into_url(&self) -> Result<Url, Error> {
        Ok(Url::parse(self.as_str())?)
    }
}

impl IntoUrl for Url {
    fn into_url(&self) -> Result<Url, Error> {
        Ok(self.clone())
    }
}

impl IntoUrl for &Url {
    fn into_url(&self) -> Result<Url, Error> {
        Ok((*self).clone())
    }
}

/// Sends a `GET` request to `url` with a new [`Client`].
///
/// This is a shortcut for `Client::new().get(url).send()`. A program that
/// sends several requests should make one [`Client`] and reuse it: it
/// keeps its connections open between requests, and this function makes
/// a new one each time.
///
/// # Errors
///
/// Returns an error if `url` is not a valid `http` or `https` URL, or if
/// connecting, sending the request or reading the response's head fails.
/// A response with an error status is not an error (see
/// [`Response::error_for_status`]).
///
/// # Examples
///
/// ```no_run
/// # fn main() -> Result<(), std::http::Error> {
/// let body = std::http::get("https://www.rust-lang.org")?.text()?;
/// println(`body = ${body}`);
/// # Ok(())
/// # }
/// ```
pub fn get<U: IntoUrl>(url: U) -> Result<Response, Error> {
    Client::new().get(url).send()
}

/// Sends a `POST` request with the body to `url` with a new [`Client`].
///
/// This is a shortcut for `Client::new().post(url).body(body).send()`; no
/// `Content-Type` is set.
///
/// # Errors
///
/// Returns an error if `url` is not a valid `http` or `https` URL, or if
/// connecting, sending the request or reading the response's head fails.
///
/// # Examples
///
/// ```no_run
/// # fn main() -> Result<(), std::http::Error> {
/// let resp = std::http::post("https://httpbin.org/post", "the body")?;
/// println(`status: ${resp.status()}`);
/// # Ok(())
/// # }
/// ```
pub fn post<U: IntoUrl, B: Into<Body>>(url: U, body: B) -> Result<Response, Error> {
    Client::new().post(url).body(body).send()
}

// An idle connection.
#[derive(Clone)]
struct Conn {
    key: String,
    stream: NetStream,
    r: &mut BufReader<NetStream>,
}

/// An HTTP client, to send requests with.
///
/// A client keeps the connections it opened and reuses them for later
/// requests to the same host (a connection goes back to the pool once a
/// response's body has been read to the end; a response whose body is not
/// read keeps its connection, and the next request opens a new one).
/// Over https it speaks HTTP/2 when the server chooses it, and then sends
/// all its requests to that host on one connection. Clones of a client
/// share its connections, so a client is cheap to clone and to share
/// between threads.
///
/// `Client::new()` makes a client with the default settings;
/// [`Client::builder`] configures one. Its methods [`Client::get`],
/// [`Client::post`], ... start a [`RequestBuilder`], which sets the
/// request's headers and body and sends it.
///
/// This is reqwest's `blocking::Client`; it has no proxy support, cookie
/// store or response decompression.
///
/// # Examples
///
/// ```
/// use std::http::{Client, Response, Server};
///
/// # let server = Server::bind("127.0.0.1:0").unwrap();
/// # let addr = server.local_addr();
/// # let srv = server.clone();
/// # let handle = std::thread::spawn(|| {
/// #     srv.serve(|req| Response::from_string(`${req.method()} ${req.uri()}`.to_string()))
/// # });
/// // A server is listening at `addr`.
/// let client = Client::new();
/// let base = `http://${addr}`.to_string();
///
/// let resp = client
///     .get(`${base}/items`.to_string())
///     .query(&[("page", "2")])
///     .send()
///     .unwrap();
/// assert(resp.status().is_success());
/// assert_eq(resp.text().unwrap(), "GET /items?page=2");
///
/// let resp = client
///     .post(`${base}/items`.to_string())
///     .body("new item")
///     .send()
///     .unwrap();
/// assert_eq(resp.text().unwrap(), "POST /items");
/// # server.close();
/// # handle.join().unwrap().unwrap();
/// ```
#[derive(Clone)]
pub struct Client {
    timeout: Option<Duration>,
    connect_timeout: Option<Duration>,
    max_redirects: usize,
    user_agent: String,
    headers: HeaderMap,
    pool_max_idle: usize,
    pool: &Mutex<Vec<Conn>>,
    tls_roots: Vec<Certificate>,
    tls_built_in_roots: bool,
    tls_invalid_certs: bool,
    tls_invalid_hostnames: bool,
    // HTTP/2 connections (shared by clones): each takes many requests.
    h2: &Mutex<Vec<&mut ClientConn>>,
    http1_only: bool,
    h2_prior: bool,
}

/// A builder to configure a [`Client`], made by [`Client::builder`].
///
/// Each method returns a changed copy of the builder, so the calls chain;
/// [`ClientBuilder::build`] makes the client.
///
/// # Examples
///
/// ```
/// use std::{
///     http::{Client, HeaderMap},
///     time::Duration,
/// };
///
/// let mut headers = HeaderMap::new();
/// headers.insert("X-Api-Key", "secret");
///
/// let client = Client::builder()
///     .timeout(Duration::from_secs(10))
///     .user_agent("my-app/1.0")
///     .default_headers(headers)
///     .max_redirects(3)
///     .build()
///     .unwrap();
/// ```
#[derive(Clone)]
pub struct ClientBuilder {
    c: Client,
}

impl ClientBuilder {
    /// Sets the timeout of each connect, read and write of a request.
    ///
    /// There is no timeout by default. Unlike reqwest's, where this is the
    /// time the whole request may take, here it applies to each step on
    /// its own: a response whose bytes keep coming does not time out. A
    /// request's own [`RequestBuilder::timeout`] takes its place.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::{http::Client, time::Duration};
    ///
    /// let client = Client::builder()
    ///     .timeout(Duration::from_secs(30))
    ///     .build()
    ///     .unwrap();
    /// ```
    pub fn timeout(&self, d: Duration) -> ClientBuilder {
        let mut b = self.clone();
        b.c.timeout = Some(d);
        b
    }

    /// Sets the timeout for connecting to a server.
    ///
    /// Without one, connecting has the timeout of
    /// [`ClientBuilder::timeout`], if set, and none otherwise.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::{http::Client, time::Duration};
    ///
    /// let client = Client::builder()
    ///     .connect_timeout(Duration::from_secs(5))
    ///     .build()
    ///     .unwrap();
    /// ```
    pub fn connect_timeout(&self, d: Duration) -> ClientBuilder {
        let mut b = self.clone();
        b.c.connect_timeout = Some(d);
        b
    }

    /// Sets how many redirects a request follows (10 by default).
    ///
    /// With 0, redirects are not followed: the 3xx response is returned.
    /// A request that would follow more than `n` fails with an error of
    /// kind [`ErrorKind::Redirect`].
    ///
    /// The client follows 301, 302, 303, 307 and 308 responses with a
    /// `Location` header. After 301, 302 and 303 it sends a `GET` without
    /// a body (a `HEAD` stays a `HEAD`); after 307 and 308 the same method
    /// and body (a body made with [`Body::from_reader`] cannot be sent
    /// again: the 3xx response is returned). `Authorization` and `Cookie`
    /// headers are not sent to another host.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Client;
    ///
    /// // A client that returns redirects instead of following them.
    /// let client = Client::builder().max_redirects(0).build().unwrap();
    /// ```
    pub fn max_redirects(&self, n: usize) -> ClientBuilder {
        let mut b = self.clone();
        b.c.max_redirects = n;
        b
    }

    /// Sets the `User-Agent` header sent with each request
    /// (`navi-http/1.0` by default; an empty string sends none).
    ///
    /// A `User-Agent` in the default headers or in the request takes its
    /// place.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Client;
    ///
    /// let client = Client::builder()
    ///     .user_agent("my-crawler/0.1")
    ///     .build()
    ///     .unwrap();
    /// ```
    pub fn user_agent(&self, ua: &str) -> ClientBuilder {
        let mut b = self.clone();
        b.c.user_agent = ua.to_string();
        b
    }

    /// Sets headers sent with every request.
    ///
    /// A header the request sets itself is sent instead of the default
    /// one of the same name.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::{Client, HeaderMap};
    ///
    /// let mut headers = HeaderMap::new();
    /// headers.insert("Accept", "application/json");
    /// let client = Client::builder().default_headers(headers).build().unwrap();
    /// ```
    pub fn default_headers(&self, h: HeaderMap) -> ClientBuilder {
        let mut b = self.clone();
        b.c.headers = h;
        b
    }

    /// Sets how many idle HTTP/1.1 connections the client keeps open for
    /// reuse (32 by default; 0 keeps none).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Client;
    ///
    /// // A new connection for each request.
    /// let client = Client::builder().pool_max_idle(0).build().unwrap();
    /// ```
    pub fn pool_max_idle(&self, n: usize) -> ClientBuilder {
        let mut b = self.clone();
        b.c.pool_max_idle = n;
        b
    }

    /// Adds a root certificate to trust for https, besides the system's.
    ///
    /// This lets a client talk to a server whose certificate is signed by
    /// a private certificate authority.
    ///
    /// # Examples
    ///
    /// ```no_run
    /// use std::http::{Certificate, Client};
    ///
    /// let pem = std::fs::read("my-ca.pem").unwrap();
    /// let cert = Certificate::from_pem(pem.as_slice()).unwrap();
    /// let client = Client::builder()
    ///     .add_root_certificate(cert)
    ///     .build()
    ///     .unwrap();
    /// ```
    pub fn add_root_certificate(&self, cert: Certificate) -> ClientBuilder {
        let mut b = self.clone();
        b.c.tls_roots.push(cert);
        b
    }

    /// Sets whether https trusts the system's root certificates (`true`
    /// by default).
    ///
    /// With `false`, only the certificates added with
    /// [`ClientBuilder::add_root_certificate`] are trusted.
    pub fn tls_built_in_root_certs(&self, on: bool) -> ClientBuilder {
        let mut b = self.clone();
        b.c.tls_built_in_roots = on;
        b
    }

    /// Sets whether https accepts any server certificate (`false` by
    /// default).
    ///
    /// # Warning
    ///
    /// With `true`, the server's certificate is not checked at all: anyone
    /// in the middle can read and change the traffic. Use it only for
    /// tests.
    pub fn danger_accept_invalid_certs(&self, accept: bool) -> ClientBuilder {
        let mut b = self.clone();
        b.c.tls_invalid_certs = accept;
        b
    }

    /// Sets whether https accepts a server certificate made for another
    /// host name (`false` by default).
    ///
    /// # Warning
    ///
    /// With `true`, any server with a trusted certificate can pretend to
    /// be the one asked for.
    pub fn danger_accept_invalid_hostnames(&self, accept: bool) -> ClientBuilder {
        let mut b = self.clone();
        b.c.tls_invalid_hostnames = accept;
        b
    }

    /// Makes the client speak only HTTP/1.1: it does not offer HTTP/2 to
    /// https servers.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Client;
    ///
    /// let client = Client::builder().http1_only().build().unwrap();
    /// ```
    pub fn http1_only(&self) -> ClientBuilder {
        let mut b = self.clone();
        b.c.http1_only = true;
        b
    }

    /// Makes the client speak HTTP/2 to `http://` servers too, from the
    /// first byte ("prior knowledge", RFC 9113 section 3.3).
    ///
    /// The server must speak HTTP/2 without TLS (for a navi
    /// [`Server`](crate::http::Server):
    /// [`Protocols::set_unencrypted_http2`](crate::http::Protocols::set_unencrypted_http2)).
    /// Over https, HTTP/2 is chosen by ALPN without this.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::{Client, Protocols, Response, Server, Version};
    ///
    /// let mut protocols = Protocols::new();
    /// protocols.set_unencrypted_http2(true);
    /// let server = Server::bind("127.0.0.1:0").unwrap().protocols(protocols);
    /// let addr = server.local_addr();
    /// let srv = server.clone();
    /// let handle = std::thread::spawn(|| {
    ///     srv.serve(|req| Response::from_string(`${req.version():?}`.to_string()))
    /// });
    ///
    /// let client = Client::builder().http2_prior_knowledge().build().unwrap();
    /// let resp = client.get(`http://${addr}/`.to_string()).send().unwrap();
    /// assert_eq(resp.version(), Version::HTTP_2);
    /// assert_eq(resp.text().unwrap(), "HTTP/2.0");
    ///
    /// server.close();
    /// handle.join().unwrap().unwrap();
    /// ```
    pub fn http2_prior_knowledge(&self) -> ClientBuilder {
        let mut b = self.clone();
        b.c.h2_prior = true;
        b
    }

    /// Makes the [`Client`].
    ///
    /// # Errors
    ///
    /// None for now: the result is always `Ok` (it is a `Result` as
    /// reqwest's is).
    pub fn build(&self) -> Result<Client, Error> {
        Ok(self.c.clone())
    }
}

impl Default for Client {
    fn default() -> Client {
        Client::new()
    }
}

impl Client {
    /// Creates a client with the default settings.
    ///
    /// It has no timeouts, follows up to 10 redirects, sends
    /// `User-Agent: navi-http/1.0` and trusts the system's root
    /// certificates. Use [`Client::builder`] to change these.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Client;
    ///
    /// let client = Client::new();
    /// ```
    pub fn new() -> Client {
        Client {
            timeout: None,
            connect_timeout: None,
            max_redirects: 10,
            user_agent: "navi-http/1.0".to_string(),
            headers: HeaderMap::new(),
            pool_max_idle: 32,
            pool: &Mutex::new(Vec::new()),
            tls_roots: Vec::new(),
            tls_built_in_roots: true,
            tls_invalid_certs: false,
            tls_invalid_hostnames: false,
            h2: &Mutex::new(Vec::new()),
            http1_only: false,
            h2_prior: false,
        }
    }

    /// Returns a [`ClientBuilder`], to configure a client.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::{http::Client, time::Duration};
    ///
    /// let client = Client::builder()
    ///     .timeout(Duration::from_secs(5))
    ///     .build()
    ///     .unwrap();
    /// ```
    pub fn builder() -> ClientBuilder {
        ClientBuilder { c: Client::new() }
    }

    /// Starts a `GET` request to `url`.
    ///
    /// Nothing is sent until [`RequestBuilder::send`]. An invalid URL is
    /// reported by `send` (or [`RequestBuilder::build`]).
    ///
    /// # Examples
    ///
    /// ```no_run
    /// use std::http::Client;
    ///
    /// let resp = Client::new()
    ///     .get("https://www.rust-lang.org")
    ///     .send()
    ///     .unwrap();
    /// println(`status: ${resp.status()}`);
    /// ```
    pub fn get<U: IntoUrl>(&self, url: U) -> RequestBuilder {
        self.request(Method::GET, url)
    }

    /// Starts a `POST` request to `url`.
    ///
    /// # Examples
    ///
    /// ```no_run
    /// use std::http::Client;
    ///
    /// let resp = Client::new()
    ///     .post("https://httpbin.org/post")
    ///     .header("Content-Type", "application/json")
    ///     .body(r#"{"a": 1}"#)
    ///     .send()
    ///     .unwrap();
    /// ```
    pub fn post<U: IntoUrl>(&self, url: U) -> RequestBuilder {
        self.request(Method::POST, url)
    }

    /// Starts a `PUT` request to `url`.
    pub fn put<U: IntoUrl>(&self, url: U) -> RequestBuilder {
        self.request(Method::PUT, url)
    }

    /// Starts a `PATCH` request to `url`.
    pub fn patch<U: IntoUrl>(&self, url: U) -> RequestBuilder {
        self.request(Method::PATCH, url)
    }

    /// Starts a `DELETE` request to `url`.
    pub fn delete<U: IntoUrl>(&self, url: U) -> RequestBuilder {
        self.request(Method::DELETE, url)
    }

    /// Starts a `HEAD` request to `url`.
    ///
    /// The response has the headers a `GET` would have, and no body.
    pub fn head<U: IntoUrl>(&self, url: U) -> RequestBuilder {
        self.request(Method::HEAD, url)
    }

    /// Starts a request with the method to `url`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::{Client, Method};
    ///
    /// let req = Client::new()
    ///     .request(Method::OPTIONS, "http://example.com/")
    ///     .build()
    ///     .unwrap();
    /// assert_eq(*req.method(), Method::OPTIONS);
    /// ```
    pub fn request<U: IntoUrl>(&self, method: Method, url: U) -> RequestBuilder {
        match url.into_url() {
            Ok(u) => RequestBuilder {
                client: self.clone(),
                req: Request::new(method, u),
                err: None,
                timeout: None,
            },
            Err(e) => RequestBuilder {
                client: self.clone(),
                req: Request::new(method, Url::parse("http://invalid/").unwrap()),
                err: Some(e),
                timeout: None,
            },
        }
    }

    /// Sends a request and returns the response, following redirects (see
    /// [`ClientBuilder::max_redirects`]).
    ///
    /// The function returns once the response's head has arrived; its
    /// body is read from the connection as the response is read.
    ///
    /// # Errors
    ///
    /// Returns an error if the URL's scheme is not `http` or `https`, if
    /// connecting, sending the request or reading the response's head fails
    /// or times out, or if there are too many redirects. A response with
    /// an error status is not an error (see [`Response::error_for_status`]).
    ///
    /// # Examples
    ///
    /// ```no_run
    /// use std::{
    ///     http::{Client, Method, Request},
    ///     url::Url,
    /// };
    ///
    /// let req = Request::new(
    ///     Method::GET,
    ///     Url::parse("https://www.rust-lang.org").unwrap(),
    /// );
    /// let resp = Client::new().execute(req).unwrap();
    /// ```
    pub fn execute(&self, req: Request) -> Result<Response, Error> {
        self.execute_timeout(req, self.timeout)
    }

    fn execute_timeout(&self, req: Request, timeout: Option<Duration>) -> Result<Response, Error> {
        let mut req = req;
        let mut redirects = 0;
        loop {
            let resp = self.send_once(&mut req, timeout)?;
            let code = resp.status.as_u16();
            let location = resp.headers.get("location");
            if !(code == 301 || code == 302 || code == 303 || code == 307 || code == 308)
                || location.is_none()
                || self.max_redirects == 0
            {
                return Ok(resp);
            }
            let next = match req.url.join(location.unwrap()) {
                Ok(u) => u,
                Err(_) => return Ok(resp),
            };
            if redirects == self.max_redirects {
                let mut e = Error::new(ErrorKind::Redirect, "too many redirects");
                e.url = Some(next);
                return Err(e);
            }
            redirects += 1;
            let keep_body = code == 307 || code == 308;
            if keep_body && req.body.as_bytes().is_none() {
                return Ok(resp);
            }
            // Frees the connection when the body is short.
            let mut r = resp;
            if r.content_length().unwrap_or(1 << 20) < 65536 {
                let _ = r.clone().bytes();
            }
            if !keep_body {
                if req.method != Method::HEAD {
                    req.method = Method::GET;
                }
                req.body = Body::empty();
                req.headers.remove("content-length");
                req.headers.remove("content-type");
                req.headers.remove("transfer-encoding");
            } else {
                // Sends the same bytes again.
                let b = req.body.as_bytes().unwrap().to_vec();
                req.body = Body::from(b);
            }
            if next.host_str() != req.url.host_str()
                || next.port_or_known_default() != req.url.port_or_known_default()
            {
                req.headers.remove("authorization");
                req.headers.remove("cookie");
            }
            req.target = wire::target_of(&next);
            req.url = next;
        }
    }

    // One request and its response's head.
    fn send_once(&self, req: &mut Request, timeout: Option<Duration>) -> Result<Response, Error> {
        let url = req.url.clone();
        let https = url.scheme() == "https";
        if url.scheme() != "http" && !https {
            let mut e = Error::new(
                ErrorKind::Builder,
                `unsupported URL scheme ${url.scheme()}`.to_string(),
            );
            e.url = Some(url);
            return Err(e);
        }
        let host = match url.host_str() {
            Some(h) => h.to_string(),
            None => return Err(Error::new(ErrorKind::Builder, "URL without a host")),
        };
        let port = url
            .port_or_known_default()
            .unwrap_or(if https { 443 } else { 80 });
        // (Pooled by scheme too: http and https to one port differ.)
        let key = `${url.scheme()}://${host}:${port}`.to_string();
        let h2_ok = (https && !self.http1_only) || (!https && self.h2_prior);
        let deadline = match timeout {
            Some(d) => Some(Instant::now() + d),
            None => None,
        };
        // An HTTP/2 connection to the host: the request on it. (Refused, as
        // when the server is going away: again on a new connection.)
        let resendable = req.body.as_bytes().is_some();
        if h2_ok {
            if let Some(cc) = self.find_h2(key.as_str()) {
                match self.h2_trip(cc, req, &url, deadline) {
                    Ok(r) => return Ok(r),
                    Err(Some(e)) => return Err(e),
                    Err(None) => {
                        if !resendable {
                            return Err(Error::new(ErrorKind::Connect, "http2: stream refused"));
                        }
                    }
                }
            }
        }
        let head = self.request_head(req, url.port().is_some(), host.as_str(), port);
        // A pooled connection may have been closed by the server: then the
        // request is sent again on a new one (if its body can be).
        let mut attempt = 0;
        loop {
            let (mut conn, reused) = match self.take_idle(key.as_str()) {
                Some(c) => (c, true),
                None => (
                    self.connect(key.as_str(), url.host(), port, timeout, &url)?,
                    false,
                ),
            };
            let is_h2 = h2_ok
                && (!https
                    || match conn.stream.alpn() {
                        Some(p) => p.as_slice() == b"h2",
                        None => false,
                    });
            if is_h2 {
                let cc = h2c::start(conn.stream.clone(), key.as_str());
                self.h2.lock().push(cc);
                self.h2.unlock();
                return match self.h2_trip(cc, req, &url, deadline) {
                    Ok(r) => Ok(r),
                    Err(Some(e)) => Err(e),
                    Err(None) => Err(Error::new(ErrorKind::Connect, "http2: stream refused")),
                };
            }
            let mut stream = conn.stream.clone();
            let _ = stream.set_read_timeout(timeout);
            let _ = stream.set_write_timeout(timeout);
            let r = self.round_trip(&mut conn, req, head.as_str(), &url);
            match r {
                Ok(resp) => return Ok(resp),
                Err(e) => {
                    stream.close();
                    attempt += 1;
                    if !reused
                        || attempt > 1
                        || req.body.as_bytes().is_none()
                        || e.kind == ErrorKind::Timeout
                    {
                        return Err(e);
                    }
                }
            }
        }
    }

    // An HTTP/2 connection to key that takes another request (the closed
    // ones dropped).
    fn find_h2(&self, key: &str) -> Option<&mut ClientConn> {
        let v = self.h2.lock();
        v.retain(|c: &&mut ClientConn| -> bool { !c.dead() });
        let mut found: Option<&mut ClientConn> = None;
        for c in v.iter() {
            if c.key.as_str() == key && c.usable() {
                found = Some(*c);
                break;
            }
        }
        self.h2.unlock();
        found
    }

    // req on an HTTP/2 connection: Err(None) if it was refused (sent
    // nowhere: it may go again).
    fn h2_trip(
        &self,
        cc: &mut ClientConn,
        req: &mut Request,
        url: &Url,
        deadline: Option<Instant>,
    ) -> Result<Response, Option<Error>> {
        let mut defaults = HeaderMap::new();
        if !req.headers.contains_key("user-agent")
            && !self.headers.contains_key("user-agent")
            && self.user_agent.len() > 0
        {
            defaults.append("user-agent", self.user_agent.as_str());
        }
        if !req.headers.contains_key("accept") && !self.headers.contains_key("accept") {
            defaults.append("accept", "*/*");
        }
        for (k, v) in self.headers.iter() {
            defaults.append(k.as_str(), v.as_str());
        }
        match cc.round_trip(req, url, &defaults, deadline) {
            Ok(r) => Ok(r),
            Err(TripError::Refused(_)) => Err(None),
            Err(TripError::Io(e)) => {
                let mut x = if e.kind() == io::ErrorKind::TimedOut {
                    Error::new(ErrorKind::Timeout, "request timed out")
                } else {
                    Error::from(e)
                };
                x.url = Some(url.clone());
                Err(Some(x))
            }
        }
    }

    fn request_head(&self, req: &Request, explicit_port: bool, host: &str, port: u16) -> String {
        let mut h = String::with_capacity(256);
        h.push_str(req.method.as_str());
        h.push(' ');
        h.push_str(req.target.as_str());
        h.push_str(" HTTP/1.1\r\n");
        if !req.headers.contains_key("host") {
            h.push_str("Host: ");
            h.push_str(host);
            if explicit_port {
                h.push_str(`:${port}`.to_string().as_str());
            }
            h.push_str("\r\n");
        }
        if !req.headers.contains_key("user-agent")
            && !self.headers.contains_key("user-agent")
            && self.user_agent.len() > 0
        {
            h.push_str(`User-Agent: ${self.user_agent}\r\n`.to_string().as_str());
        }
        if !req.headers.contains_key("accept") && !self.headers.contains_key("accept") {
            h.push_str("Accept: */*\r\n");
        }
        let mut defaults = HeaderMap::new();
        for (k, v) in self.headers.iter() {
            if !req.headers.contains_key(k.as_str()) {
                defaults.append(k.as_str(), v.as_str());
            }
        }
        wire::put_headers(&mut h, &defaults);
        wire::put_headers(&mut h, &req.headers);
        if !req.headers.contains_key("content-length")
            && !req.headers.contains_key("transfer-encoding")
        {
            match req.body.len() {
                Some(n) => {
                    if n > 0 || !(req.method == Method::GET || req.method == Method::HEAD) {
                        h.push_str(`Content-Length: ${n}\r\n`.to_string().as_str());
                    }
                }
                None => h.push_str("Transfer-Encoding: chunked\r\n"),
            }
        }
        h.push_str("\r\n");
        h
    }

    fn take_idle(&self, key: &str) -> Option<Conn> {
        let v = self.pool.lock();
        let mut found: Option<Conn> = None;
        let mut i = v.len();
        while i > 0 {
            i -= 1;
            if v[i].key == key {
                found = Some(v.remove(i));
                break;
            }
        }
        self.pool.unlock();
        found
    }

    fn put_idle(&self, c: Conn) {
        let v = self.pool.lock();
        if v.len() < self.pool_max_idle {
            v.push(c);
            self.pool.unlock();
        } else {
            self.pool.unlock();
            c.stream.close();
        }
    }

    fn connect(
        &self,
        key: &str,
        host: Option<crate::url::Host>,
        port: u16,
        timeout: Option<Duration>,
        url: &Url,
    ) -> Result<Conn, Error> {
        let addrs = match host {
            Some(crate::url::Host::Domain(d)) => (d.as_str(), port).to_socket_addrs(),
            Some(crate::url::Host::Ipv4(a)) => {
                crate::net::SocketAddr::new(crate::net::IpAddr::V4(a), port).to_socket_addrs()
            }
            Some(crate::url::Host::Ipv6(a)) => {
                crate::net::SocketAddr::new(crate::net::IpAddr::V6(a), port).to_socket_addrs()
            }
            None => return Err(Error::new(ErrorKind::Builder, "URL without a host")),
        };
        let addrs = match addrs {
            Ok(a) => a,
            Err(e) => {
                let mut x = Error::new(
                    ErrorKind::Connect,
                    `cannot resolve ${key}: ${e}`.to_string(),
                );
                x.url = Some(url.clone());
                return Err(x);
            }
        };
        let ct = match self.connect_timeout {
            Some(d) => Some(d),
            None => timeout,
        };
        let mut last: Option<io::Error> = None;
        for a in addrs {
            let r = match ct {
                Some(d) => TcpStream::connect_timeout(&a, d),
                None => TcpStream::connect(a.clone()),
            };
            match r {
                Ok(s) => {
                    let _ = s.set_nodelay(true);
                    let stream = if url.scheme() == "https" {
                        self.tls_handshake(s, url, timeout)?
                    } else {
                        NetStream::plain(s)
                    };
                    return Ok(Conn {
                        key: key.to_string(),
                        stream: stream.clone(),
                        r: &mut BufReader::new(stream),
                    });
                }
                Err(e) => last = Some(e),
            }
        }
        let msg = match last {
            Some(e) => {
                if e.kind() == io::ErrorKind::TimedOut {
                    let mut x = Error::new(
                        ErrorKind::Timeout,
                        `connect to ${key} timed out`.to_string(),
                    );
                    x.url = Some(url.clone());
                    return Err(x);
                }
                `cannot connect to ${key}: ${e}`.to_string()
            }
            None => `no addresses for ${key}`.to_string(),
        };
        let mut x = Error::new(ErrorKind::Connect, msg);
        x.url = Some(url.clone());
        Err(x)
    }

    // The TLS handshake over s for url's host.
    fn tls_handshake(
        &self,
        s: TcpStream,
        url: &Url,
        timeout: Option<Duration>,
    ) -> Result<NetStream, Error> {
        let mut b = TlsConnector::builder();
        for c in self.tls_roots.iter() {
            b.add_root_certificate(c.clone());
        }
        b.disable_built_in_roots(!self.tls_built_in_roots);
        b.danger_accept_invalid_certs(self.tls_invalid_certs);
        b.danger_accept_invalid_hostnames(self.tls_invalid_hostnames);
        if self.http1_only {
            b.request_alpns(&["http/1.1"]);
        } else {
            b.request_alpns(&["h2", "http/1.1"]);
        }
        let fail = |msg: String| -> Error {
            let mut x = Error::new(ErrorKind::Connect, msg);
            x.url = Some(url.clone());
            x
        };
        let c = match b.build() {
            Ok(c) => c,
            Err(e) => return Err(fail(e.to_string())),
        };
        let host = match url.host() {
            Some(crate::url::Host::Domain(d)) => d,
            Some(crate::url::Host::Ipv4(a)) => a.to_string(),
            Some(crate::url::Host::Ipv6(a)) => a.to_string(),
            None => String::new(),
        };
        let _ = s.set_read_timeout(timeout);
        let _ = s.set_write_timeout(timeout);
        match c.connect(host.as_str(), s.clone()) {
            Ok(t) => Ok(NetStream::tls(t)),
            Err(e) => {
                s.close();
                Err(fail(e.to_string()))
            }
        }
    }

    fn round_trip(
        &self,
        conn: &mut Conn,
        req: &mut Request,
        head: &str,
        url: &Url,
    ) -> Result<Response, Error> {
        let mut w = conn.stream.clone();
        let with_err_url = |e: Error| -> Error {
            let mut x = e;
            x.url = Some(url.clone());
            x
        };
        let chunked = req.body.len().is_none() && !req.headers.contains_key("content-length");
        // The head and a short body in one write.
        match req.body.as_bytes() {
            Some(b) if b.len() <= 16384 && !chunked => {
                let mut all: Vec<u8> = Vec::with_capacity(head.len() + b.len());
                all.extend_from_slice(head.as_bytes());
                all.extend_from_slice(b);
                if let Err(e) = w.write_all(all.as_slice()) {
                    return Err(with_err_url(Error::from(e)));
                }
            }
            _ => {
                if let Err(e) = w.write_all(head.as_bytes()) {
                    return Err(with_err_url(Error::from(e)));
                }
                if let Err(e) = wire::write_body(&mut w, &mut req.body, chunked) {
                    return Err(with_err_url(Error::from(e)));
                }
            }
        }
        // The status line, skipping 1xx responses.
        let (version, code, headers) = loop {
            let line = match wire::read_line(conn.r, 65536) {
                Ok(Some(l)) => l,
                Ok(None) => {
                    return Err(with_err_url(Error::new(
                        ErrorKind::Connect,
                        "connection closed before the response",
                    )));
                }
                Err(e) => return Err(with_err_url(Error::from(e))),
            };
            let (v, c) = match parse_status_line(line.as_str()) {
                Some(x) => x,
                None => {
                    return Err(with_err_url(Error::new(
                        ErrorKind::Protocol,
                        `malformed status line ${line:?}`.to_string(),
                    )));
                }
            };
            let h = match wire::read_headers(conn.r, 1 << 20) {
                Ok(h) => h,
                Err(e) => return Err(with_err_url(Error::new(ErrorKind::Protocol, e.to_string()))),
            };
            if c >= 100 && c < 200 && c != 101 {
                continue;
            }
            break (v, c, h);
        };
        let no_body =
            req.method == Method::HEAD || code == 204 || code == 304 || (code >= 100 && code < 200);
        let (mode, len) = if no_body {
            (wire::LEN, 0u64)
        } else {
            match wire::framing(&headers) {
                Ok(f) => f,
                Err(e) => return Err(with_err_url(Error::new(ErrorKind::Protocol, e.to_string()))),
            }
        };
        let keep = mode != wire::TO_CLOSE
            && !headers.has_token("connection", "close")
            && !req.headers.has_token("connection", "close")
            && (version == Version::HTTP_11 || headers.has_token("connection", "keep-alive"));
        let inc = wire::incoming(conn.r, mode, len);
        let me = self.clone();
        let c = (*conn).clone();
        if keep {
            inc.set_on_done(|| me.put_idle(c));
        }
        let body_len = if mode == wire::LEN { Some(len) } else { None };
        let mut resp = Response::new(StatusCode(code));
        resp.version = version;
        resp.headers = headers;
        resp.body = Body::from_reader(inc, body_len);
        resp.url = Some(url.clone());
        Ok(resp)
    }
}

// "HTTP/1.1 200 OK" -> (version, code).
fn parse_status_line(line: &str) -> Option<(Version, u16)> {
    let version = if line.starts_with("HTTP/1.1 ") {
        Version::HTTP_11
    } else if line.starts_with("HTTP/1.0 ") {
        Version::HTTP_10
    } else {
        return None;
    };
    let rest = &line[9..];
    if rest.len() < 3 {
        return None;
    }
    let code = match rest[0..3].parse::<u16>() {
        Ok(c) => c,
        Err(_) => return None,
    };
    if code < 100 || (rest.len() > 3 && rest.as_bytes()[3] != b' ') {
        return None;
    }
    Some((version, code))
}

/// A request being built, made by [`Client::get`], [`Client::post`],
/// [`Client::request`] and the like.
///
/// Each method returns a changed copy of the builder, so the calls chain;
/// [`RequestBuilder::send`] sends the request with the client that made
/// the builder, and [`RequestBuilder::build`] returns it as a
/// [`Request`] instead.
///
/// # Examples
///
/// ```
/// use std::http::Client;
///
/// let req = Client::new()
///     .post("http://example.com/api")
///     .query(&[("v", "2")])
///     .header("Accept", "application/json")
///     .bearer_auth("token123")
///     .body("payload")
///     .build()
///     .unwrap();
/// assert_eq(req.uri(), "/api?v=2");
/// assert_eq(req.header("authorization"), Some("Bearer token123"));
/// assert_eq(req.body().len(), Some(7));
/// ```
#[derive(Clone)]
pub struct RequestBuilder {
    client: Client,
    req: Request,
    err: Option<Error>,
    timeout: Option<Duration>,
}

impl RequestBuilder {
    /// Adds a value to the header `name` of the request (after any it
    /// has).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Client;
    ///
    /// let req = Client::new()
    ///     .get("http://example.com/")
    ///     .header("Accept", "text/html")
    ///     .header("Accept", "text/plain")
    ///     .build()
    ///     .unwrap();
    /// assert_eq(
    ///     req.headers().get_all("accept"),
    ///     Vec::from(["text/html", "text/plain"]),
    /// );
    /// ```
    pub fn header(&self, name: &str, value: &str) -> RequestBuilder {
        let mut b = self.clone();
        b.req.headers.append(name, value);
        b
    }

    /// Adds all the values of `h` to the request's headers.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::{Client, HeaderMap};
    ///
    /// let mut h = HeaderMap::new();
    /// h.insert("X-Trace", "1");
    /// h.insert("X-Debug", "on");
    /// let req = Client::new()
    ///     .get("http://example.com/")
    ///     .headers(h)
    ///     .build()
    ///     .unwrap();
    /// assert_eq(req.header("x-debug"), Some("on"));
    /// ```
    pub fn headers(&self, h: HeaderMap) -> RequestBuilder {
        let mut b = self.clone();
        for (k, v) in h.iter() {
            b.req.headers.append(k.as_str(), v.as_str());
        }
        b
    }

    /// Appends the name-value pairs to the query of the request's URL,
    /// percent-encoding them.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Client;
    ///
    /// let req = Client::new()
    ///     .get("http://example.com/search?lang=en")
    ///     .query(&[("q", "navi lang"), ("page", "2")])
    ///     .build()
    ///     .unwrap();
    /// assert_eq(req.uri(), "/search?lang=en&q=navi+lang&page=2");
    /// ```
    pub fn query(&self, pairs: &[(&str, &str)]) -> RequestBuilder {
        let mut b = self.clone();
        {
            let mut q = b.req.url.query_pairs_mut();
            for (k, v) in pairs.iter() {
                q.append_pair(*k, *v);
            }
        }
        b.req.target = wire::target_of(&b.req.url);
        b
    }

    /// Adds an `Authorization` header for HTTP basic authentication with
    /// the user name and password.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Client;
    ///
    /// let req = Client::new()
    ///     .get("http://example.com/")
    ///     .basic_auth("aladdin", Some("opensesame"))
    ///     .build()
    ///     .unwrap();
    /// assert_eq(
    ///     req.header("authorization"),
    ///     Some("Basic YWxhZGRpbjpvcGVuc2VzYW1l"),
    /// );
    /// ```
    pub fn basic_auth(&self, user: &str, password: Option<&str>) -> RequestBuilder {
        let cred = match password {
            Some(p) => `${user}:${p}`.to_string(),
            None => `${user}:`.to_string(),
        };
        self.header(
            "Authorization",
            `Basic ${base64(cred.as_bytes())}`.to_string().as_str(),
        )
    }

    /// Adds an `Authorization` header with the bearer token.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Client;
    ///
    /// let req = Client::new()
    ///     .get("http://example.com/")
    ///     .bearer_auth("abc")
    ///     .build()
    ///     .unwrap();
    /// assert_eq(req.header("authorization"), Some("Bearer abc"));
    /// ```
    pub fn bearer_auth(&self, token: &str) -> RequestBuilder {
        self.header("Authorization", `Bearer ${token}`.to_string().as_str())
    }

    /// Sets the request's body.
    ///
    /// No `Content-Type` is set. A body of known length is sent with a
    /// `Content-Length`; a [`Body::from_reader`] of unknown length is sent
    /// chunked (over HTTP/1.1).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Client;
    ///
    /// let req = Client::new()
    ///     .put("http://example.com/file.txt")
    ///     .body("contents")
    ///     .build()
    ///     .unwrap();
    /// assert_eq(req.body().as_bytes(), Some(b"contents"));
    /// ```
    pub fn body<B: Into<Body>>(&self, body: B) -> RequestBuilder {
        let mut b = self.clone();
        b.req.body = body.into();
        b
    }

    /// Sets the request's body to the pairs, encoded as an HTML form, and
    /// its `Content-Type` to `application/x-www-form-urlencoded`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::Client;
    ///
    /// let req = Client::new()
    ///     .post("http://example.com/login")
    ///     .form(&[("user", "navi"), ("note", "a&b c")])
    ///     .build()
    ///     .unwrap();
    /// assert_eq(
    ///     req.header("content-type"),
    ///     Some("application/x-www-form-urlencoded"),
    /// );
    /// assert_eq(req.body().as_bytes(), Some(b"user=navi&note=a%26b+c"));
    /// ```
    pub fn form(&self, pairs: &[(&str, &str)]) -> RequestBuilder {
        let mut s = crate::url::form_urlencoded::Serializer::new(String::new());
        for (k, v) in pairs.iter() {
            s.append_pair(*k, *v);
        }
        let mut b = self.body(s.finish());
        b.req
            .headers
            .insert("Content-Type", "application/x-www-form-urlencoded");
        b
    }

    /// Sets the request's body to `x` serialized to JSON (with
    /// [`crate::json::to_string`]), and its `Content-Type` to
    /// `application/json` unless the request already has one.
    ///
    /// If `x` cannot be serialized, [`RequestBuilder::send`] returns an
    /// error of kind [`ErrorKind::Builder`].
    ///
    /// # Examples
    ///
    /// ```
    /// use std::{http::Client, serde::Serialize};
    ///
    /// #[derive(Serialize)]
    /// struct NewUser {
    ///     name: String,
    /// }
    ///
    /// let mut req = Client::new()
    ///     .post("http://example.com/users")
    ///     .json(&NewUser {
    ///         name: "navi".to_string(),
    ///     })
    ///     .build()
    ///     .unwrap();
    /// assert_eq(req.header("content-type"), Some("application/json"));
    /// assert_eq(req.text().unwrap(), r#"{"name":"navi"}"#);
    /// ```
    pub fn json<T: crate::serde::Serialize>(&self, x: &T) -> RequestBuilder {
        let mut b = self.clone();
        match crate::json::to_string(x) {
            Ok(s) => {
                b.req.body = Body::from(s);
                if !b.req.headers.contains_key("content-type") {
                    b.req.headers.insert("Content-Type", "application/json");
                }
            }
            Err(e) => b.err = Some(Error::new(ErrorKind::Builder, e.to_string())),
        }
        b
    }

    /// Sets the timeout of each connect, read and write of this request,
    /// in place of the client's ([`ClientBuilder::timeout`]).
    ///
    /// # Examples
    ///
    /// ```no_run
    /// use std::{http::Client, time::Duration};
    ///
    /// let resp = Client::new()
    ///     .get("https://www.rust-lang.org")
    ///     .timeout(Duration::from_secs(3))
    ///     .send();
    /// ```
    pub fn timeout(&self, d: Duration) -> RequestBuilder {
        let mut b = self.clone();
        b.timeout = Some(d);
        b
    }

    /// Sets the HTTP version of the request.
    ///
    /// The version is only recorded in the [`Request`]: which version is
    /// spoken is decided by the client's settings and the server
    /// (HTTP/1.1, or HTTP/2 when it is negotiated).
    pub fn version(&self, v: Version) -> RequestBuilder {
        let mut b = self.clone();
        b.req.version = v;
        b
    }

    /// Returns the request that was built, without sending it.
    ///
    /// # Errors
    ///
    /// Returns an error of kind [`ErrorKind::Builder`] if the URL was not
    /// valid or the JSON body could not be serialized.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::http::{Client, Method};
    ///
    /// let req = Client::new()
    ///     .delete("http://example.com/items/3")
    ///     .build()
    ///     .unwrap();
    /// assert_eq(*req.method(), Method::DELETE);
    /// assert_eq(req.uri(), "/items/3");
    ///
    /// assert(
    ///     Client::new()
    ///         .get("no scheme")
    ///         .build()
    ///         .unwrap_err()
    ///         .is_builder(),
    /// );
    /// ```
    pub fn build(&self) -> Result<Request, Error> {
        match &self.err {
            Some(e) => Err(e.clone()),
            None => Ok(self.req.clone()),
        }
    }

    /// Sends the request with the client and returns the response.
    ///
    /// This is [`Client::execute`] with the built request, and this
    /// builder's timeout if it has one. It returns once the response's
    /// head has arrived; the body is read with [`Response::text`] and the
    /// like.
    ///
    /// # Errors
    ///
    /// Returns an error if the request could not be built
    /// ([`RequestBuilder::build`]), or if sending it fails as described
    /// for [`Client::execute`].
    ///
    /// # Examples
    ///
    /// ```no_run
    /// # fn main() -> Result<(), std::http::Error> {
    /// use std::http::Client;
    ///
    /// let resp = Client::new().get("https://www.rust-lang.org").send()?;
    /// assert(resp.status().is_success());
    /// let html = resp.text()?;
    /// # Ok(())
    /// # }
    /// ```
    pub fn send(&self) -> Result<Response, Error> {
        let req = self.build()?;
        let t = match self.timeout {
            Some(d) => Some(d),
            None => self.client.timeout,
        };
        self.client.execute_timeout(req, t)
    }
}

fn base64(b: &[u8]) -> String {
    let t = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/".as_bytes();
    let mut s = String::with_capacity((b.len() + 2) / 3 * 4);
    let mut i = 0;
    while i < b.len() {
        let n = b.len() - i;
        let x = (b[i] as u32) << 16
            | (if n > 1 { b[i + 1] as u32 } else { 0 }) << 8
            | (if n > 2 { b[i + 2] as u32 } else { 0 });
        s.push(t[(x >> 18 & 63) as usize] as char);
        s.push(t[(x >> 12 & 63) as usize] as char);
        s.push(if n > 1 {
            t[(x >> 6 & 63) as usize] as char
        } else {
            '='
        });
        s.push(if n > 2 {
            t[(x & 63) as usize] as char
        } else {
            '='
        });
        i += 3;
    }
    s
}
