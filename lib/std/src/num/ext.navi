    }
    pub fn checked_shl(self, rhs: u32) -> Option<i8> { if rhs < 8 { Some(self << rhs) } else { None } }
    pub fn checked_shr(self, rhs: u32) -> Option<i8> { if rhs < 8 { Some(self >> rhs) } else { None } }
    pub fn wrapping_shl(self, rhs: u32) -> i8 { self << (rhs % 8) }
    pub fn wrapping_shr(self, rhs: u32) -> i8 { self >> (rhs % 8) }
    pub fn overflowing_shl(self, rhs: u32) -> (i8, bool) { (self.wrapping_shl(rhs), rhs >= 8) }
    pub fn overflowing_shr(self, rhs: u32) -> (i8, bool) { (self.wrapping_shr(rhs), rhs >= 8) }
