    }
    pub fn rotate_right(self, n: u32) -> i128 {
        let k = n % 128;
        if k == 0 { return self; }
        self.rotate_left(128 - k)
    }
    pub fn to_le_bytes(self) -> [u8; 16] {
        let mut out = [0u8; 16];
        let lo = (self as u128) as u64;
        let hi = ((self as u128) >> 64) as u64;
        let mut i = 0;
        while i < 8 {
            out[i] = ((lo >> (8 * i as u32)) & 255) as u8;
            out[i + 8] = ((hi >> (8 * i as u32)) & 255) as u8;
            i += 1;
        }
        out
    }
    pub fn from_le_bytes(bytes: [u8; 16]) -> i128 {
        let mut lo: u64 = 0;
        let mut hi: u64 = 0;
        let mut i = 8;
        while i > 0 {
            i -= 1;
            lo = (lo << 8) | bytes[i] as u64;
            hi = (hi << 8) | bytes[i + 8] as u64;
        }
        i128_of(((hi as u128) << 64) | lo as u128)
    }
    pub fn swap_bytes(self) -> i128 {
        let lo = (self as u128) as u64;
        let hi = ((self as u128) >> 64) as u64;
        i128_of(((lo.swap_bytes() as u128) << 64) | hi.swap_bytes() as u128)
    }
    pub fn from_str_radix(src: &str, radix: u32) -> Result<i128, ParseIntError> {
        match parse_radix128(src, radix, true) {
            Some((neg, mag)) => {
                let max = i128::MAX as u128;
                if neg {
                    if mag > max + 1 { return Err(ParseIntError); }
                    Ok(i128_of(0u128.wrapping_sub(mag)))
                } else {
                    if mag > max { return Err(ParseIntError); }
                    Ok(i128_of(mag))
                }
            }
            None => Err(ParseIntError),
        }
    }

    pub fn wrapping_abs(self) -> i128 { if self < 0 { self.wrapping_neg() } else { self } }
    pub fn unsigned_abs(self) -> u128 { if self < 0 { (self as u128).wrapping_neg() } else { self as u128 } }
}

impl f64 {
    pub fn is_sign_positive(self) -> bool { !self.is_sign_negative() }
    pub fn is_normal(self) -> bool { self.classify() == FpCategory::Normal }
    pub fn is_subnormal(self) -> bool { self.classify() == FpCategory::Subnormal }
    pub fn classify(self) -> FpCategory {
        let bits = self.to_bits();
        let exp = bits & 0x7ff0000000000000;
        let man = bits & 0x000fffffffffffff;
        if exp == 0 {
            if man == 0 { FpCategory::Zero } else { FpCategory::Subnormal }
        } else if exp == 0x7ff0000000000000 {
            if man == 0 { FpCategory::Infinite } else { FpCategory::Nan }
        } else {
            FpCategory::Normal
        }
    }
    pub fn fract(self) -> f64 { self - self.trunc() }
    pub fn signum(self) -> f64 { if self.is_nan() { f64::NAN } else { (1.0 as f64).copysign(self) } }
    pub fn copysign(self, sign: f64) -> f64 { f64::from_bits((self.to_bits() & !0x8000000000000000) | (sign.to_bits() & 0x8000000000000000)) }
    pub fn recip(self) -> f64 { 1.0 / self }
    pub fn to_degrees(self) -> f64 { self * (180.0 / crate::f64::consts::PI) }
    pub fn to_radians(self) -> f64 { self * (crate::f64::consts::PI / 180.0) }
    #[track_caller]
    pub fn clamp(self, min: f64, max: f64) -> f64 {
        if !(min <= max) { panic(`min > max, or either was NaN. min = ${min:?}, max = ${max:?}`); }
        let mut x = self;
        if x < min { x = min; }
        if x > max { x = max; }
        x
    }
    /// The IEEE 754 totalOrder of self and other (-NaN < -inf < ... <
    /// -0 < +0 < ... < inf < NaN).
    pub fn total_cmp(&self, other: &f64) -> crate::cmp::Ordering {
        let mut a = self.to_bits() as i64;
        let mut b = other.to_bits() as i64;
        a = a ^ ((((a >> (64 - 1)) as u64) >> 1) as i64);
        b = b ^ ((((b >> (64 - 1)) as u64) >> 1) as i64);
        a.cmp(&b)
    }
    pub fn mul_add(self, a: f64, b: f64) -> f64 { unsafe { c_fma(self as f64, a as f64, b as f64) as f64 } }
    pub fn div_euclid(self, rhs: f64) -> f64 {
        let q = (self / rhs).trunc();
        if self % rhs < 0.0 { if rhs > 0.0 { q - 1.0 } else { q + 1.0 } } else { q }
    }
    pub fn rem_euclid(self, rhs: f64) -> f64 {
        let r = self % rhs;
        if r < 0.0 { r + rhs.abs() } else { r }
    }
    pub fn powf(self, n: f64) -> f64 { unsafe { c_pow(self as f64, n as f64) as f64 } }
    pub fn exp(self) -> f64 { unsafe { c_exp(self as f64) as f64 } }
    pub fn exp2(self) -> f64 { unsafe { c_exp2(self as f64) as f64 } }
    pub fn exp_m1(self) -> f64 { unsafe { c_expm1(self as f64) as f64 } }
    pub fn ln(self) -> f64 { unsafe { c_log(self as f64) as f64 } }
    pub fn ln_1p(self) -> f64 { unsafe { c_log1p(self as f64) as f64 } }
    pub fn log(self, base: f64) -> f64 { self.ln() / base.ln() }
    pub fn log2(self) -> f64 { unsafe { c_log2(self as f64) as f64 } }
    pub fn log10(self) -> f64 { unsafe { c_log10(self as f64) as f64 } }
    pub fn cbrt(self) -> f64 { unsafe { c_cbrt(self as f64) as f64 } }
    pub fn hypot(self, other: f64) -> f64 { unsafe { c_hypot(self as f64, other as f64) as f64 } }
    pub fn sin(self) -> f64 { unsafe { c_sin(self as f64) as f64 } }
    pub fn cos(self) -> f64 { unsafe { c_cos(self as f64) as f64 } }
    pub fn tan(self) -> f64 { unsafe { c_tan(self as f64) as f64 } }
    pub fn asin(self) -> f64 { unsafe { c_asin(self as f64) as f64 } }
    pub fn acos(self) -> f64 { unsafe { c_acos(self as f64) as f64 } }
    pub fn atan(self) -> f64 { unsafe { c_atan(self as f64) as f64 } }
    pub fn atan2(self, other: f64) -> f64 { unsafe { c_atan2(self as f64, other as f64) as f64 } }
    pub fn sin_cos(self) -> (f64, f64) { (self.sin(), self.cos()) }
    pub fn sinh(self) -> f64 { unsafe { c_sinh(self as f64) as f64 } }
    pub fn cosh(self) -> f64 { unsafe { c_cosh(self as f64) as f64 } }
    pub fn tanh(self) -> f64 { unsafe { c_tanh(self as f64) as f64 } }
    pub fn asinh(self) -> f64 { unsafe { c_asinh(self as f64) as f64 } }
    pub fn acosh(self) -> f64 { unsafe { c_acosh(self as f64) as f64 } }
    pub fn atanh(self) -> f64 { unsafe { c_atanh(self as f64) as f64 } }
    /// Rounds half-way cases to the even integer.
    pub fn round_ties_even(self) -> f64 { unsafe { c_rint(self as f64) as f64 } }
    pub fn to_le_bytes(self) -> [u8; 8] { self.to_bits().to_le_bytes() }
    pub fn to_be_bytes(self) -> [u8; 8] { self.to_bits().to_be_bytes() }
    pub fn to_ne_bytes(self) -> [u8; 8] { self.to_bits().to_ne_bytes() }
    pub fn from_le_bytes(bytes: [u8; 8]) -> f64 { f64::from_bits(u64::from_le_bytes(bytes)) }
    pub fn from_be_bytes(bytes: [u8; 8]) -> f64 { f64::from_bits(u64::from_be_bytes(bytes)) }
    pub fn from_ne_bytes(bytes: [u8; 8]) -> f64 { f64::from_bits(u64::from_ne_bytes(bytes)) }

    pub const RADIX: u32 = 2;
    pub const MANTISSA_DIGITS: u32 = 53;
    pub const DIGITS: u32 = 15;
    pub const MIN_POSITIVE: f64 = 2.2250738585072014e-308;
    pub const MIN_EXP: i32 = -1021;
    pub const MAX_EXP: i32 = 1024;
    pub const MIN_10_EXP: i32 = -307;
    pub const MAX_10_EXP: i32 = 308;
}

impl f32 {
    pub fn is_sign_positive(self) -> bool { !self.is_sign_negative() }
    pub fn is_normal(self) -> bool { self.classify() == FpCategory::Normal }
    pub fn is_subnormal(self) -> bool { self.classify() == FpCategory::Subnormal }
    pub fn classify(self) -> FpCategory {
        let bits = self.to_bits();
        let exp = bits & 0x7f800000;
        let man = bits & 0x007fffff;
        if exp == 0 {
            if man == 0 { FpCategory::Zero } else { FpCategory::Subnormal }
        } else if exp == 0x7f800000 {
            if man == 0 { FpCategory::Infinite } else { FpCategory::Nan }
        } else {
            FpCategory::Normal
        }
    }
    pub fn fract(self) -> f32 { self - self.trunc() }
    pub fn signum(self) -> f32 { if self.is_nan() { f32::NAN } else { (1.0 as f32).copysign(self) } }
    pub fn copysign(self, sign: f32) -> f32 { f32::from_bits((self.to_bits() & !0x80000000) | (sign.to_bits() & 0x80000000)) }
    pub fn recip(self) -> f32 { 1.0 / self }
    pub fn to_degrees(self) -> f32 { self * (180.0 / crate::f32::consts::PI) }
    pub fn to_radians(self) -> f32 { self * (crate::f32::consts::PI / 180.0) }
    #[track_caller]
    pub fn clamp(self, min: f32, max: f32) -> f32 {
        if !(min <= max) { panic(`min > max, or either was NaN. min = ${min:?}, max = ${max:?}`); }
        let mut x = self;
        if x < min { x = min; }
        if x > max { x = max; }
        x
    }
    /// The IEEE 754 totalOrder of self and other (-NaN < -inf < ... <
    /// -0 < +0 < ... < inf < NaN).
    pub fn total_cmp(&self, other: &f32) -> crate::cmp::Ordering {
        let mut a = self.to_bits() as i32;
        let mut b = other.to_bits() as i32;
        a = a ^ ((((a >> (32 - 1)) as u32) >> 1) as i32);
        b = b ^ ((((b >> (32 - 1)) as u32) >> 1) as i32);
        a.cmp(&b)
    }
    pub fn mul_add(self, a: f32, b: f32) -> f32 { unsafe { c_fma(self as f64, a as f64, b as f64) as f32 } }
    pub fn div_euclid(self, rhs: f32) -> f32 {
        let q = (self / rhs).trunc();
        if self % rhs < 0.0 { if rhs > 0.0 { q - 1.0 } else { q + 1.0 } } else { q }
    }
    pub fn rem_euclid(self, rhs: f32) -> f32 {
        let r = self % rhs;
        if r < 0.0 { r + rhs.abs() } else { r }
    }
    pub fn powf(self, n: f32) -> f32 { unsafe { c_pow(self as f64, n as f64) as f32 } }
    pub fn exp(self) -> f32 { unsafe { c_exp(self as f64) as f32 } }
    pub fn exp2(self) -> f32 { unsafe { c_exp2(self as f64) as f32 } }
    pub fn exp_m1(self) -> f32 { unsafe { c_expm1(self as f64) as f32 } }
    pub fn ln(self) -> f32 { unsafe { c_log(self as f64) as f32 } }
    pub fn ln_1p(self) -> f32 { unsafe { c_log1p(self as f64) as f32 } }
    pub fn log(self, base: f32) -> f32 { self.ln() / base.ln() }
    pub fn log2(self) -> f32 { unsafe { c_log2(self as f64) as f32 } }
    pub fn log10(self) -> f32 { unsafe { c_log10(self as f64) as f32 } }
    pub fn cbrt(self) -> f32 { unsafe { c_cbrt(self as f64) as f32 } }
    pub fn hypot(self, other: f32) -> f32 { unsafe { c_hypot(self as f64, other as f64) as f32 } }
    pub fn sin(self) -> f32 { unsafe { c_sin(self as f64) as f32 } }
    pub fn cos(self) -> f32 { unsafe { c_cos(self as f64) as f32 } }
    pub fn tan(self) -> f32 { unsafe { c_tan(self as f64) as f32 } }
    pub fn asin(self) -> f32 { unsafe { c_asin(self as f64) as f32 } }
    pub fn acos(self) -> f32 { unsafe { c_acos(self as f64) as f32 } }
    pub fn atan(self) -> f32 { unsafe { c_atan(self as f64) as f32 } }
    pub fn atan2(self, other: f32) -> f32 { unsafe { c_atan2(self as f64, other as f64) as f32 } }
    pub fn sin_cos(self) -> (f32, f32) { (self.sin(), self.cos()) }
    pub fn sinh(self) -> f32 { unsafe { c_sinh(self as f64) as f32 } }
    pub fn cosh(self) -> f32 { unsafe { c_cosh(self as f64) as f32 } }
    pub fn tanh(self) -> f32 { unsafe { c_tanh(self as f64) as f32 } }
    pub fn asinh(self) -> f32 { unsafe { c_asinh(self as f64) as f32 } }
    pub fn acosh(self) -> f32 { unsafe { c_acosh(self as f64) as f32 } }
    pub fn atanh(self) -> f32 { unsafe { c_atanh(self as f64) as f32 } }
    /// Rounds half-way cases to the even integer.
    pub fn round_ties_even(self) -> f32 { unsafe { c_rint(self as f64) as f32 } }
    pub fn to_le_bytes(self) -> [u8; 4] { self.to_bits().to_le_bytes() }
    pub fn to_be_bytes(self) -> [u8; 4] { self.to_bits().to_be_bytes() }
    pub fn to_ne_bytes(self) -> [u8; 4] { self.to_bits().to_ne_bytes() }
    pub fn from_le_bytes(bytes: [u8; 4]) -> f32 { f32::from_bits(u32::from_le_bytes(bytes)) }
    pub fn from_be_bytes(bytes: [u8; 4]) -> f32 { f32::from_bits(u32::from_be_bytes(bytes)) }
    pub fn from_ne_bytes(bytes: [u8; 4]) -> f32 { f32::from_bits(u32::from_ne_bytes(bytes)) }

    pub const RADIX: u32 = 2;
    pub const MANTISSA_DIGITS: u32 = 24;
    pub const DIGITS: u32 = 6;
    pub const MAX: f32 = 3.40282347e38;
    pub const MIN: f32 = -3.40282347e38;
    pub const EPSILON: f32 = 1.19209290e-7;
    pub const MIN_POSITIVE: f32 = 1.17549435e-38;
    pub const MIN_EXP: i32 = -125;
    pub const MAX_EXP: i32 = 128;
    pub const MIN_10_EXP: i32 = -37;
    pub const MAX_10_EXP: i32 = 38;

    pub fn is_infinite(self) -> bool { self == f32::INFINITY || self == f32::NEG_INFINITY }
    pub fn is_finite(self) -> bool { !self.is_nan() && !self.is_infinite() }
    pub fn is_sign_negative(self) -> bool { self.to_bits() >> 31 == 1 }
    pub fn ceil(self) -> f32 { (self as f64).ceil() as f32 }
    pub fn trunc(self) -> f32 { (self as f64).trunc() as f32 }
    pub fn round(self) -> f32 { (self as f64).round() as f32 }
    pub fn powi(self, n: i32) -> f32 { (self as f64).powi(n) as f32 }
    pub fn max(self, other: f32) -> f32 { if self.is_nan() || other > self { other } else { self } }
    pub fn min(self, other: f32) -> f32 { if self.is_nan() || other < self { other } else { self } }
}

// Conversions between the integer types (Rust has them in core::convert::num).
impl From<i8> for i16 { fn from(value: i8) -> i16 { value as i16 } }
impl TryFrom<i8> for i16 { type Error = Infallible; fn try_from(value: i8) -> Result<i16, Infallible> { Ok(value as i16) } }
impl From<i8> for i32 { fn from(value: i8) -> i32 { value as i32 } }
impl TryFrom<i8> for i32 { type Error = Infallible; fn try_from(value: i8) -> Result<i32, Infallible> { Ok(value as i32) } }
impl From<i8> for i64 { fn from(value: i8) -> i64 { value as i64 } }
impl TryFrom<i8> for i64 { type Error = Infallible; fn try_from(value: i8) -> Result<i64, Infallible> { Ok(value as i64) } }
