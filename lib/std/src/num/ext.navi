/// Parses an optionally signed integer in the given radix: the sign and
/// the magnitude (None on bad digits or u128 overflow).
fn parse_radix128(s: &str, radix: u32, signed: bool) -> Option<(bool, u128)> {
    let b = s.as_bytes();
    if b.len() == 0 {
        return None;
    }
    let mut i = 0;
    let mut neg = false;
    if b[0] == b'-' || b[0] == b'+' {
        neg = b[0] == b'-';
        if neg && !signed {
            return None;
        }
        i = 1;
        if b.len() == 1 {
            return None;
        }
    }
    let r = radix as u128;
    let mut v: u128 = 0;
    while i < b.len() {
        let d = match (b[i] as char).to_digit(radix) {
            Some(d) => d as u128,
            None => return None,
        };
        v = v.checked_mul(r)?.checked_add(d)?;
        i += 1;
    }
    Some((neg, v))
}

fn i128_of(x: u128) -> i128 {
    x as i128
}

impl FromStr for i128 {
    type Err = ParseIntError;
    fn from_str(s: &str) -> Result<i128, ParseIntError> {
        i128::from_str_radix(s, 10)
    }
}

impl FromStr for u128 {
    type Err = ParseIntError;
    fn from_str(s: &str) -> Result<u128, ParseIntError> {
        u128::from_str_radix(s, 10)
    }
}

impl i8 {
    /// Checked negation. Computes `-self`, returning `None` if `self == MIN`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i8.checked_neg(), Some(-5));
    /// assert_eq(i8::MIN.checked_neg(), None);
    /// ```
    #[inline]
    pub fn checked_neg(self) -> Option<i8> {
        let (r, o) = self.overflowing_neg();
        if o { None } else { Some(r) }
    }

    /// Checked exponentiation. Computes `self.pow(exp)`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(8i8.checked_pow(2), Some(64));
    /// assert_eq(i8::MAX.checked_pow(2), None);
    /// ```
    pub fn checked_pow(self, exp: u32) -> Option<i8> {
        if exp == 0 {
            return Some(1);
        }
        let mut base = self;
        let mut acc: i8 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc.checked_mul(base)?;
                if e == 1 {
                    return Some(acc);
                }
            }
            e = e / 2;
            base = base.checked_mul(base)?;
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// Returns a tuple of the exponentiation along with a bool indicating
    /// whether an overflow happened.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3i8.overflowing_pow(4), (81, false));
    /// assert_eq(i8::MAX.overflowing_pow(2), (1, true));
    /// ```
    pub fn overflowing_pow(self, exp: u32) -> (i8, bool) {
        if exp == 0 {
            return (1, false);
        }
        let mut base = self;
        let mut acc: i8 = 1;
        let mut e = exp;
        let mut over = false;
        loop {
            if e & 1 == 1 {
                let (r, o) = acc.overflowing_mul(base);
                acc = r;
                over = over || o;
                if e == 1 {
                    return (acc, over);
                }
            }
            e = e / 2;
            let (b, o) = base.overflowing_mul(base);
            base = b;
            over = over || o;
        }
    }

    /// Saturating integer exponentiation. Computes `self.pow(exp)`, saturating
    /// at the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-4i8).saturating_pow(3), -64);
    /// assert_eq(i8::MIN.saturating_pow(2), i8::MAX);
    /// assert_eq(i8::MIN.saturating_pow(3), i8::MIN);
    /// ```
    #[inline]
    pub fn saturating_pow(self, exp: u32) -> i8 {
        match self.checked_pow(exp) {
            Some(r) => r,
            None => {
                if self < 0 && exp % 2 == 1 {
                    i8::MIN
                } else {
                    i8::MAX
                }
            }
        }
    }

    /// Checked shift left. Computes `self << rhs`, returning `None` if `rhs` is
    /// larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1i8.checked_shl(4), Some(0x10));
    /// assert_eq(0x1i8.checked_shl(8), None);
    /// assert_eq(0x10i8.checked_shl(7), Some(0));
    /// ```
    #[inline]
    pub fn checked_shl(self, rhs: u32) -> Option<i8> {
        if rhs < 8 { Some(self << rhs) } else { None }
    }

    /// Checked shift right. Computes `self >> rhs`, returning `None` if `rhs`
    /// is larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10i8.checked_shr(4), Some(0x1));
    /// assert_eq(0x10i8.checked_shr(8), None);
    /// ```
    #[inline]
    pub fn checked_shr(self, rhs: u32) -> Option<i8> {
        if rhs < 8 { Some(self >> rhs) } else { None }
    }

    /// Panic-free bitwise shift-left; yields `self << mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-left; the RHS of a wrapping
    /// shift-left is restricted to the range of the type, rather than the bits
    /// shifted out of the LHS being returned to the other end. The primitive
    /// integer types all implement a `rotate_left` function, which may be what
    /// you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-1i8).wrapping_shl(7), -128);
    /// assert_eq((-1i8).wrapping_shl(128), -1);
    /// ```
    #[inline]
    pub fn wrapping_shl(self, rhs: u32) -> i8 {
        self << (rhs % 8)
    }

    /// Panic-free bitwise shift-right; yields `self >> mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-right; the RHS of a
    /// wrapping shift-right is restricted to the range of the type, rather than
    /// the bits shifted out of the LHS being returned to the other end. The
    /// primitive integer types all implement a `rotate_right` function, which
    /// may be what you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-128i8).wrapping_shr(7), -1);
    /// assert_eq((-128i8).wrapping_shr(128), -128);
    /// ```
    #[inline]
    pub fn wrapping_shr(self, rhs: u32) -> i8 {
        self >> (rhs % 8)
    }

    /// Shifts self left by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1i8.overflowing_shl(4), (0x10, false));
    /// assert_eq(0x1i8.overflowing_shl(12), (0x10, true));
    /// assert_eq(0x10i8.overflowing_shl(7), (0, false));
    /// ```
    #[inline]
    pub fn overflowing_shl(self, rhs: u32) -> (i8, bool) {
        (self.wrapping_shl(rhs), rhs >= 8)
    }

    /// Shifts self right by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10i8.overflowing_shr(4), (0x1, false));
    /// assert_eq(0x10i8.overflowing_shr(12), (0x1, true));
    /// ```
    #[inline]
    pub fn overflowing_shr(self, rhs: u32) -> (i8, bool) {
        (self.wrapping_shr(rhs), rhs >= 8)
    }

    /// Wrapping (modular) division. Computes `self / rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// The only case where such wrapping can occur is when one divides `MIN /
    /// -1` on a signed type (where `MIN` is the negative minimal value for the
    /// type); this is equivalent to `-MIN`, a positive value that is too large
    /// to represent in the type. In such a case, this function returns `MIN`
    /// itself.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i8.wrapping_div(10), 10);
    /// assert_eq(i8::MIN.wrapping_div(-1), i8::MIN);
    /// ```
    #[inline]
    pub fn wrapping_div(self, rhs: i8) -> i8 {
        if self == i8::MIN && rhs == -1 {
            self
        } else {
            self / rhs
        }
    }

    /// Wrapping (modular) remainder. Computes `self % rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// Such wrap-around never actually occurs mathematically; implementation
    /// artifacts make `x % y` invalid for `MIN / -1` on a signed type (where
    /// `MIN` is the negative minimal value). In such a case, this function
    /// returns `0`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i8.wrapping_rem(10), 0);
    /// assert_eq(i8::MIN.wrapping_rem(-1), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem(self, rhs: i8) -> i8 {
        if self == i8::MIN && rhs == -1 {
            0
        } else {
            self % rhs
        }
    }

    /// Calculates the divisor when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the divisor along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would occur then self
    /// is returned.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i8.overflowing_div(2), (2, false));
    /// assert_eq(i8::MIN.overflowing_div(-1), (i8::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_div(self, rhs: i8) -> (i8, bool) {
        if self == i8::MIN && rhs == -1 {
            (self, true)
        } else {
            (self / rhs, false)
        }
    }

    /// Calculates the remainder when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the remainder along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would occur then 0 is
    /// returned.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i8.overflowing_rem(2), (1, false));
    /// assert_eq(i8::MIN.overflowing_rem(-1), (0, true));
    /// ```
    #[inline]
    pub fn overflowing_rem(self, rhs: i8) -> (i8, bool) {
        if self == i8::MIN && rhs == -1 {
            (0, true)
        } else {
            (self % rhs, false)
        }
    }

    /// Saturating integer division. Computes `self / rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i8.saturating_div(2), 2);
    /// assert_eq(i8::MAX.saturating_div(-1), i8::MIN + 1);
    /// assert_eq(i8::MIN.saturating_div(-1), i8::MAX);
    /// ```
    #[inline]
    pub fn saturating_div(self, rhs: i8) -> i8 {
        if self == i8::MIN && rhs == -1 {
            i8::MAX
        } else {
            self / rhs
        }
    }

    /// Checked Euclidean division. Computes `self.div_euclid(rhs)`, returning
    /// `None` if `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i8::MIN + 1).checked_div_euclid(-1), Some(i8::MAX));
    /// assert_eq(i8::MIN.checked_div_euclid(-1), None);
    /// assert_eq(1i8.checked_div_euclid(0), None);
    /// ```
    #[inline]
    pub fn checked_div_euclid(self, rhs: i8) -> Option<i8> {
        if rhs == 0 || self == i8::MIN && rhs == -1 {
            None
        } else {
            Some(self.div_euclid(rhs))
        }
    }

    /// Checked Euclidean remainder. Computes `self.rem_euclid(rhs)`, returning
    /// `None` if `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i8.checked_rem_euclid(2), Some(1));
    /// assert_eq(5i8.checked_rem_euclid(0), None);
    /// assert_eq(i8::MIN.checked_rem_euclid(-1), None);
    /// ```
    #[inline]
    pub fn checked_rem_euclid(self, rhs: i8) -> Option<i8> {
        if rhs == 0 || self == i8::MIN && rhs == -1 {
            None
        } else {
            Some(self.rem_euclid(rhs))
        }
    }

    /// Wrapping Euclidean division. Computes `self.div_euclid(rhs)`, wrapping
    /// around at the boundary of the type.
    ///
    /// Wrapping will only occur in `MIN / -1` on a signed type (where `MIN` is
    /// the negative minimal value for the type). This is equivalent to `-MIN`,
    /// a positive value that is too large to represent in the type. In this
    /// case, this method returns `MIN` itself.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i8.wrapping_div_euclid(10), 10);
    /// assert_eq(i8::MIN.wrapping_div_euclid(-1), i8::MIN);
    /// ```
    #[inline]
    pub fn wrapping_div_euclid(self, rhs: i8) -> i8 {
        if self == i8::MIN && rhs == -1 {
            self
        } else {
            self.div_euclid(rhs)
        }
    }

    /// Wrapping Euclidean remainder. Computes `self.rem_euclid(rhs)`, wrapping
    /// around at the boundary of the type.
    ///
    /// Wrapping will only occur in `MIN % -1` on a signed type (where `MIN` is
    /// the negative minimal value for the type). In this case, this method
    /// returns 0.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i8.wrapping_rem_euclid(10), 0);
    /// assert_eq(i8::MIN.wrapping_rem_euclid(-1), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem_euclid(self, rhs: i8) -> i8 {
        if self == i8::MIN && rhs == -1 {
            0
        } else {
            self.rem_euclid(rhs)
        }
    }

    /// Reverses the order of bits in the integer. The least significant bit
    /// becomes the most significant bit, second least-significant bit becomes
    /// second most-significant bit, etc.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x12i8;
    /// let m = n.reverse_bits();
    ///
    /// assert_eq(m, 0x48);
    /// assert_eq(0i8.reverse_bits(), 0);
    /// ```
    #[inline]
    pub fn reverse_bits(self) -> i8 {
        let v = self as u8;
        let mut r: u8 = 0;
        let mut i = 0u32;
        while i < 8 {
            r = (r << 1) | ((v >> i) & 1);
            i += 1;
        }
        r as i8
    }

    /// Converts `self` to big endian from the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai8;
    ///
    /// assert_eq(n.to_be(), n.swap_bytes());
    /// ```
    #[inline]
    pub fn to_be(self) -> i8 {
        self.swap_bytes()
    }

    /// Converts `self` to little endian from the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai8;
    ///
    /// assert_eq(n.to_le(), n);
    /// ```
    #[inline]
    pub fn to_le(self) -> i8 {
        self
    }

    /// Converts an integer from big endian to the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai8;
    ///
    /// assert_eq(i8::from_be(n), n.swap_bytes());
    /// ```
    #[inline]
    pub fn from_be(x: i8) -> i8 {
        x.swap_bytes()
    }

    /// Converts an integer from little endian to the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai8;
    ///
    /// assert_eq(i8::from_le(n), n);
    /// ```
    #[inline]
    pub fn from_le(x: i8) -> i8 {
        x
    }

    /// Returns the memory representation of this integer as a byte array in
    /// big-endian (network) byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x12i8.to_be_bytes();
    /// assert_eq(bytes, [0x12]);
    /// ```
    #[inline]
    pub fn to_be_bytes(self) -> [u8; 1] {
        self.swap_bytes().to_le_bytes()
    }

    /// Creates an integer value from its representation as a byte array in big
    /// endian.
    ///
    /// # Examples
    ///
    /// The example is not run: this method of the 8-bit types panics today
    /// ("attempt to shift with overflow"), a known bug.
    ///
    /// ```ignore
    /// let value = i8::from_be_bytes([0x12]);
    /// assert_eq(value, 0x12);
    /// ```
    #[inline]
    pub fn from_be_bytes(bytes: [u8; 1]) -> i8 {
        i8::from_le_bytes(bytes).swap_bytes()
    }

    /// Returns the memory representation of this integer as a byte array in
    /// native byte order.
    ///
    /// As the target platform's native endianness is used, portable code should
    /// use `to_be_bytes` or `to_le_bytes`, as appropriate, instead. (navi's
    /// targets are all little endian, so this is `to_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x12i8.to_ne_bytes();
    /// assert_eq(bytes, [0x12]);
    /// ```
    #[inline]
    pub fn to_ne_bytes(self) -> [u8; 1] {
        self.to_le_bytes()
    }

    /// Creates an integer value from its memory representation as a byte array
    /// in native endianness.
    ///
    /// As the target platform's native endianness is used, portable code likely
    /// wants to use `from_be_bytes` or `from_le_bytes`, as appropriate instead.
    /// (navi's targets are all little endian, so this is `from_le_bytes`.)
    ///
    /// # Examples
    ///
    /// The example is not run: this method of the 8-bit types panics today
    /// ("attempt to shift with overflow"), a known bug.
    ///
    /// ```ignore
    /// let value = i8::from_ne_bytes([0x12]);
    /// assert_eq(value, 0x12);
    /// ```
    #[inline]
    pub fn from_ne_bytes(bytes: [u8; 1]) -> i8 {
        i8::from_le_bytes(bytes)
    }

    /// Returns the number of leading ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-1i8).leading_ones(), 8);
    /// assert_eq(i8::MIN.leading_ones(), 1);
    /// assert_eq(1i8.leading_ones(), 0);
    /// ```
    #[inline]
    pub fn leading_ones(self) -> u32 {
        (!self).leading_zeros()
    }

    /// Returns the number of trailing ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3i8.trailing_ones(), 2);
    /// assert_eq((-1i8).trailing_ones(), 8);
    /// assert_eq(i8::MIN.trailing_ones(), 0);
    /// ```
    #[inline]
    pub fn trailing_ones(self) -> u32 {
        (!self).trailing_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is less than or equal to zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2i8.ilog2(), 1);
    /// assert_eq(i8::MAX.ilog2(), 6);
    /// ```
    #[track_caller]
    pub fn ilog2(self) -> u32 {
        if self <= 0 {
            panic("argument of integer logarithm must be positive");
        }
        8 - 1 - self.leading_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is negative or zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2i8.checked_ilog2(), Some(1));
    /// assert_eq(0i8.checked_ilog2(), None);
    /// ```
    #[inline]
    pub fn checked_ilog2(self) -> Option<u32> {
        if self <= 0 {
            None
        } else {
            Some(8 - 1 - self.leading_zeros())
        }
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is less than or equal to zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i8.ilog10(), 1);
    /// assert_eq(99i8.ilog10(), 1);
    /// assert_eq(i8::MAX.ilog10(), 2);
    /// ```
    #[track_caller]
    pub fn ilog10(self) -> u32 {
        if self <= 0 {
            panic("argument of integer logarithm must be positive");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= 10 {
            v = v / 10;
            n += 1;
        }
        n
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is negative or zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i8.checked_ilog10(), Some(1));
    /// assert_eq(0i8.checked_ilog10(), None);
    /// ```
    #[inline]
    pub fn checked_ilog10(self) -> Option<u32> {
        if self <= 0 { None } else { Some(self.ilog10()) }
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `ilog2` can produce results more efficiently for base 2, and `ilog10`
    /// can produce results more efficiently for base 10.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is less than or equal to zero, or if
    /// `base` is less than 2.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i8.ilog(5), 1);
    /// assert_eq(100i8.ilog(3), 4);
    /// ```
    #[track_caller]
    pub fn ilog(self, base: i8) -> u32 {
        if self <= 0 {
            panic("argument of integer logarithm must be positive");
        }
        if base < 2 {
            panic("base of integer logarithm must be at least 2");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= base {
            v = v / base;
            n += 1;
        }
        n
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// Returns `None` if the number is negative or zero, or if the base is not
    /// at least 2.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `checked_ilog2` can produce results more efficiently for base 2, and
    /// `checked_ilog10` can produce results more efficiently for base 10.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i8.checked_ilog(5), Some(1));
    /// assert_eq(0i8.checked_ilog(5), None);
    /// assert_eq(5i8.checked_ilog(1), None);
    /// ```
    #[inline]
    pub fn checked_ilog(self, base: i8) -> Option<u32> {
        if self <= 0 || base < 2 {
            None
        } else {
            Some(self.ilog(base))
        }
    }

    /// Returns the square root of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is negative.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i8.isqrt(), 3);
    /// assert_eq(i8::MAX.isqrt(), 11);
    /// ```
    #[track_caller]
    pub fn isqrt(self) -> i8 {
        if self < 0 {
            panic("argument of integer square root cannot be negative");
        }
        if self < 2 {
            return self;
        }
        let mut x = (self as f64).sqrt() as i8;
        while x > self / x {
            x -= 1;
        }
        while x + 1 <= self / (x + 1) {
            x += 1;
        }
        x
    }

    /// Negates self, overflowing if this is equal to the minimum value.
    ///
    /// Returns a tuple of the negated version of self along with a boolean
    /// indicating whether an overflow happened. If `self` is the minimum value
    /// (`i8::MIN`), then the minimum value will be returned again and `true`
    /// will be returned for an overflow happening.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2i8.overflowing_neg(), (-2, false));
    /// assert_eq(i8::MIN.overflowing_neg(), (i8::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_neg(self) -> (i8, bool) {
        if self == i8::MIN {
            (self, true)
        } else {
            (-self, false)
        }
    }

    /// Checked absolute value. Computes `self.abs()`, returning `None` if `self
    /// == MIN`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-5i8).checked_abs(), Some(5));
    /// assert_eq(i8::MIN.checked_abs(), None);
    /// ```
    #[inline]
    pub fn checked_abs(self) -> Option<i8> {
        if self == i8::MIN {
            None
        } else {
            Some(self.abs())
        }
    }

    /// Computes the absolute value of `self`.
    ///
    /// Returns a tuple of the absolute version of self along with a boolean
    /// indicating whether an overflow happened. If self is the minimum value
    /// (`i8::MIN`), then the minimum value will be returned again and true will
    /// be returned for an overflow happening.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i8.overflowing_abs(), (10, false));
    /// assert_eq((-10i8).overflowing_abs(), (10, false));
    /// assert_eq(i8::MIN.overflowing_abs(), (i8::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_abs(self) -> (i8, bool) {
        (self.wrapping_abs(), self == i8::MIN)
    }

    /// Saturating absolute value. Computes `self.abs()`, returning `MAX` if
    /// `self == MIN` instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i8.saturating_abs(), 100);
    /// assert_eq((-100i8).saturating_abs(), 100);
    /// assert_eq(i8::MIN.saturating_abs(), i8::MAX);
    /// assert_eq((i8::MIN + 1).saturating_abs(), i8::MAX);
    /// ```
    #[inline]
    pub fn saturating_abs(self) -> i8 {
        if self == i8::MIN { i8::MAX } else { self.abs() }
    }

    /// Saturating integer negation. Computes `-self`, returning `MAX` if `self
    /// == MIN` instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i8.saturating_neg(), -100);
    /// assert_eq((-100i8).saturating_neg(), 100);
    /// assert_eq(i8::MIN.saturating_neg(), i8::MAX);
    /// assert_eq(i8::MAX.saturating_neg(), i8::MIN + 1);
    /// ```
    #[inline]
    pub fn saturating_neg(self) -> i8 {
        if self == i8::MIN { i8::MAX } else { -self }
    }

    /// Computes the absolute difference between `self` and `other`.
    ///
    /// This function always returns the correct answer without overflow or
    /// panics by returning an unsigned integer.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i8.abs_diff(80), 20u8);
    /// assert_eq(100i8.abs_diff(110), 10u8);
    /// assert_eq((-100i8).abs_diff(80), 180u8);
    /// assert_eq((-100i8).abs_diff(-120), 20u8);
    /// assert_eq(i8::MIN.abs_diff(i8::MAX), u8::MAX);
    /// ```
    #[inline]
    pub fn abs_diff(self, other: i8) -> u8 {
        if self < other {
            (other as u8).wrapping_sub(self as u8)
        } else {
            (self as u8).wrapping_sub(other as u8)
        }
    }

    /// Calculates the quotient of Euclidean division of `self` by `rhs`.
    ///
    /// This computes the integer `q` such that `self = q * rhs + r`, with `r =
    /// self.rem_euclid(rhs)` and `0 <= r < abs(rhs)`.
    ///
    /// In other words, the result is `self / rhs` rounded to the integer `q`
    /// such that `self >= q * rhs`. If `self > 0`, this is equal to rounding
    /// towards zero (what `/` does); if `self < 0`, this is equal to rounding
    /// away from zero (towards +/- infinity). If `rhs > 0`, this is equal to
    /// rounding towards -infinity; if `rhs < 0`, this is equal to rounding
    /// towards +infinity.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero or if `self` is `MIN` and
    /// `rhs` is -1.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = 7i8;
    /// let b = 4;
    ///
    /// assert_eq(a.div_euclid(b), 1); // 7 >= 4 * 1
    /// assert_eq(a.div_euclid(-b), -1); // 7 >= -4 * -1
    /// assert_eq((-a).div_euclid(b), -2); // -7 >= 4 * -2
    /// assert_eq((-a).div_euclid(-b), 2); // -7 >= -4 * 2
    /// ```
    #[track_caller]
    pub fn div_euclid(self, rhs: i8) -> i8 {
        let q = self / rhs;
        if self % rhs < 0 {
            if rhs > 0 { q - 1 } else { q + 1 }
        } else {
            q
        }
    }

    /// Calculates the least nonnegative remainder of `self (mod rhs)`.
    ///
    /// This is done as if by the Euclidean division algorithm -- given `r =
    /// self.rem_euclid(rhs)`, the result satisfies `self = rhs *
    /// self.div_euclid(rhs) + r` and `0 <= r < abs(rhs)`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero or if `self` is `MIN` and
    /// `rhs` is -1.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = 7i8;
    /// let b = 4;
    ///
    /// assert_eq(a.rem_euclid(b), 3);
    /// assert_eq((-a).rem_euclid(b), 1);
    /// assert_eq(a.rem_euclid(-b), 3);
    /// assert_eq((-a).rem_euclid(-b), 1);
    /// ```
    #[track_caller]
    pub fn rem_euclid(self, rhs: i8) -> i8 {
        let r = self % rhs;
        if r < 0 {
            r.wrapping_add(rhs.wrapping_abs())
        } else {
            r
        }
    }

    /// Returns the square root of the number, rounded down.
    ///
    /// Returns `None` if `self` is negative.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i8.checked_isqrt(), Some(3));
    /// assert_eq((-1i8).checked_isqrt(), None);
    /// ```
    #[inline]
    pub fn checked_isqrt(self) -> Option<i8> {
        if self < 0 { None } else { Some(self.isqrt()) }
    }

    /// Reverses the byte order of the integer.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x12i8;
    /// let m = n.swap_bytes();
    ///
    /// assert_eq(m, 0x12);
    /// ```
    #[inline]
    pub fn swap_bytes(self) -> i8 {
        self
    }
}

impl i16 {
    /// Checked negation. Computes `-self`, returning `None` if `self == MIN`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i16.checked_neg(), Some(-5));
    /// assert_eq(i16::MIN.checked_neg(), None);
    /// ```
    #[inline]
    pub fn checked_neg(self) -> Option<i16> {
        let (r, o) = self.overflowing_neg();
        if o { None } else { Some(r) }
    }

    /// Checked exponentiation. Computes `self.pow(exp)`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(8i16.checked_pow(2), Some(64));
    /// assert_eq(i16::MAX.checked_pow(2), None);
    /// ```
    pub fn checked_pow(self, exp: u32) -> Option<i16> {
        if exp == 0 {
            return Some(1);
        }
        let mut base = self;
        let mut acc: i16 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc.checked_mul(base)?;
                if e == 1 {
                    return Some(acc);
                }
            }
            e = e / 2;
            base = base.checked_mul(base)?;
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// Returns a tuple of the exponentiation along with a bool indicating
    /// whether an overflow happened.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3i16.overflowing_pow(4), (81, false));
    /// assert_eq(i16::MAX.overflowing_pow(2), (1, true));
    /// ```
    pub fn overflowing_pow(self, exp: u32) -> (i16, bool) {
        if exp == 0 {
            return (1, false);
        }
        let mut base = self;
        let mut acc: i16 = 1;
        let mut e = exp;
        let mut over = false;
        loop {
            if e & 1 == 1 {
                let (r, o) = acc.overflowing_mul(base);
                acc = r;
                over = over || o;
                if e == 1 {
                    return (acc, over);
                }
            }
            e = e / 2;
            let (b, o) = base.overflowing_mul(base);
            base = b;
            over = over || o;
        }
    }

    /// Saturating integer exponentiation. Computes `self.pow(exp)`, saturating
    /// at the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-4i16).saturating_pow(3), -64);
    /// assert_eq(i16::MIN.saturating_pow(2), i16::MAX);
    /// assert_eq(i16::MIN.saturating_pow(3), i16::MIN);
    /// ```
    #[inline]
    pub fn saturating_pow(self, exp: u32) -> i16 {
        match self.checked_pow(exp) {
            Some(r) => r,
            None => {
                if self < 0 && exp % 2 == 1 {
                    i16::MIN
                } else {
                    i16::MAX
                }
            }
        }
    }

    /// Checked shift left. Computes `self << rhs`, returning `None` if `rhs` is
    /// larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1i16.checked_shl(4), Some(0x10));
    /// assert_eq(0x1i16.checked_shl(16), None);
    /// assert_eq(0x10i16.checked_shl(15), Some(0));
    /// ```
    #[inline]
    pub fn checked_shl(self, rhs: u32) -> Option<i16> {
        if rhs < 16 { Some(self << rhs) } else { None }
    }

    /// Checked shift right. Computes `self >> rhs`, returning `None` if `rhs`
    /// is larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10i16.checked_shr(4), Some(0x1));
    /// assert_eq(0x10i16.checked_shr(16), None);
    /// ```
    #[inline]
    pub fn checked_shr(self, rhs: u32) -> Option<i16> {
        if rhs < 16 { Some(self >> rhs) } else { None }
    }

    /// Panic-free bitwise shift-left; yields `self << mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-left; the RHS of a wrapping
    /// shift-left is restricted to the range of the type, rather than the bits
    /// shifted out of the LHS being returned to the other end. The primitive
    /// integer types all implement a `rotate_left` function, which may be what
    /// you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-1i16).wrapping_shl(7), -128);
    /// assert_eq((-1i16).wrapping_shl(128), -1);
    /// ```
    #[inline]
    pub fn wrapping_shl(self, rhs: u32) -> i16 {
        self << (rhs % 16)
    }

    /// Panic-free bitwise shift-right; yields `self >> mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-right; the RHS of a
    /// wrapping shift-right is restricted to the range of the type, rather than
    /// the bits shifted out of the LHS being returned to the other end. The
    /// primitive integer types all implement a `rotate_right` function, which
    /// may be what you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-128i16).wrapping_shr(7), -1);
    /// assert_eq((-128i16).wrapping_shr(128), -128);
    /// ```
    #[inline]
    pub fn wrapping_shr(self, rhs: u32) -> i16 {
        self >> (rhs % 16)
    }

    /// Shifts self left by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1i16.overflowing_shl(4), (0x10, false));
    /// assert_eq(0x1i16.overflowing_shl(20), (0x10, true));
    /// assert_eq(0x10i16.overflowing_shl(15), (0, false));
    /// ```
    #[inline]
    pub fn overflowing_shl(self, rhs: u32) -> (i16, bool) {
        (self.wrapping_shl(rhs), rhs >= 16)
    }

    /// Shifts self right by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10i16.overflowing_shr(4), (0x1, false));
    /// assert_eq(0x10i16.overflowing_shr(20), (0x1, true));
    /// ```
    #[inline]
    pub fn overflowing_shr(self, rhs: u32) -> (i16, bool) {
        (self.wrapping_shr(rhs), rhs >= 16)
    }

    /// Wrapping (modular) division. Computes `self / rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// The only case where such wrapping can occur is when one divides `MIN /
    /// -1` on a signed type (where `MIN` is the negative minimal value for the
    /// type); this is equivalent to `-MIN`, a positive value that is too large
    /// to represent in the type. In such a case, this function returns `MIN`
    /// itself.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i16.wrapping_div(10), 10);
    /// assert_eq(i16::MIN.wrapping_div(-1), i16::MIN);
    /// ```
    #[inline]
    pub fn wrapping_div(self, rhs: i16) -> i16 {
        if self == i16::MIN && rhs == -1 {
            self
        } else {
            self / rhs
        }
    }

    /// Wrapping (modular) remainder. Computes `self % rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// Such wrap-around never actually occurs mathematically; implementation
    /// artifacts make `x % y` invalid for `MIN / -1` on a signed type (where
    /// `MIN` is the negative minimal value). In such a case, this function
    /// returns `0`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i16.wrapping_rem(10), 0);
    /// assert_eq(i16::MIN.wrapping_rem(-1), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem(self, rhs: i16) -> i16 {
        if self == i16::MIN && rhs == -1 {
            0
        } else {
            self % rhs
        }
    }

    /// Calculates the divisor when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the divisor along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would occur then self
    /// is returned.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i16.overflowing_div(2), (2, false));
    /// assert_eq(i16::MIN.overflowing_div(-1), (i16::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_div(self, rhs: i16) -> (i16, bool) {
        if self == i16::MIN && rhs == -1 {
            (self, true)
        } else {
            (self / rhs, false)
        }
    }

    /// Calculates the remainder when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the remainder along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would occur then 0 is
    /// returned.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i16.overflowing_rem(2), (1, false));
    /// assert_eq(i16::MIN.overflowing_rem(-1), (0, true));
    /// ```
    #[inline]
    pub fn overflowing_rem(self, rhs: i16) -> (i16, bool) {
        if self == i16::MIN && rhs == -1 {
            (0, true)
        } else {
            (self % rhs, false)
        }
    }

    /// Saturating integer division. Computes `self / rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i16.saturating_div(2), 2);
    /// assert_eq(i16::MAX.saturating_div(-1), i16::MIN + 1);
    /// assert_eq(i16::MIN.saturating_div(-1), i16::MAX);
    /// ```
    #[inline]
    pub fn saturating_div(self, rhs: i16) -> i16 {
        if self == i16::MIN && rhs == -1 {
            i16::MAX
        } else {
            self / rhs
        }
    }

    /// Checked Euclidean division. Computes `self.div_euclid(rhs)`, returning
    /// `None` if `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i16::MIN + 1).checked_div_euclid(-1), Some(i16::MAX));
    /// assert_eq(i16::MIN.checked_div_euclid(-1), None);
    /// assert_eq(1i16.checked_div_euclid(0), None);
    /// ```
    #[inline]
    pub fn checked_div_euclid(self, rhs: i16) -> Option<i16> {
        if rhs == 0 || self == i16::MIN && rhs == -1 {
            None
        } else {
            Some(self.div_euclid(rhs))
        }
    }

    /// Checked Euclidean remainder. Computes `self.rem_euclid(rhs)`, returning
    /// `None` if `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i16.checked_rem_euclid(2), Some(1));
    /// assert_eq(5i16.checked_rem_euclid(0), None);
    /// assert_eq(i16::MIN.checked_rem_euclid(-1), None);
    /// ```
    #[inline]
    pub fn checked_rem_euclid(self, rhs: i16) -> Option<i16> {
        if rhs == 0 || self == i16::MIN && rhs == -1 {
            None
        } else {
            Some(self.rem_euclid(rhs))
        }
    }

    /// Wrapping Euclidean division. Computes `self.div_euclid(rhs)`, wrapping
    /// around at the boundary of the type.
    ///
    /// Wrapping will only occur in `MIN / -1` on a signed type (where `MIN` is
    /// the negative minimal value for the type). This is equivalent to `-MIN`,
    /// a positive value that is too large to represent in the type. In this
    /// case, this method returns `MIN` itself.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i16.wrapping_div_euclid(10), 10);
    /// assert_eq(i16::MIN.wrapping_div_euclid(-1), i16::MIN);
    /// ```
    #[inline]
    pub fn wrapping_div_euclid(self, rhs: i16) -> i16 {
        if self == i16::MIN && rhs == -1 {
            self
        } else {
            self.div_euclid(rhs)
        }
    }

    /// Wrapping Euclidean remainder. Computes `self.rem_euclid(rhs)`, wrapping
    /// around at the boundary of the type.
    ///
    /// Wrapping will only occur in `MIN % -1` on a signed type (where `MIN` is
    /// the negative minimal value for the type). In this case, this method
    /// returns 0.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i16.wrapping_rem_euclid(10), 0);
    /// assert_eq(i16::MIN.wrapping_rem_euclid(-1), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem_euclid(self, rhs: i16) -> i16 {
        if self == i16::MIN && rhs == -1 {
            0
        } else {
            self.rem_euclid(rhs)
        }
    }

    /// Reverses the order of bits in the integer. The least significant bit
    /// becomes the most significant bit, second least-significant bit becomes
    /// second most-significant bit, etc.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1234i16;
    /// let m = n.reverse_bits();
    ///
    /// assert_eq(m, 0x2c48);
    /// assert_eq(0i16.reverse_bits(), 0);
    /// ```
    #[inline]
    pub fn reverse_bits(self) -> i16 {
        let v = self as u16;
        let mut r: u16 = 0;
        let mut i = 0u32;
        while i < 16 {
            r = (r << 1) | ((v >> i) & 1);
            i += 1;
        }
        r as i16
    }

    /// Converts `self` to big endian from the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai16;
    ///
    /// assert_eq(n.to_be(), n.swap_bytes());
    /// ```
    #[inline]
    pub fn to_be(self) -> i16 {
        self.swap_bytes()
    }

    /// Converts `self` to little endian from the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai16;
    ///
    /// assert_eq(n.to_le(), n);
    /// ```
    #[inline]
    pub fn to_le(self) -> i16 {
        self
    }

    /// Converts an integer from big endian to the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai16;
    ///
    /// assert_eq(i16::from_be(n), n.swap_bytes());
    /// ```
    #[inline]
    pub fn from_be(x: i16) -> i16 {
        x.swap_bytes()
    }

    /// Converts an integer from little endian to the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai16;
    ///
    /// assert_eq(i16::from_le(n), n);
    /// ```
    #[inline]
    pub fn from_le(x: i16) -> i16 {
        x
    }

    /// Returns the memory representation of this integer as a byte array in
    /// big-endian (network) byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x1234i16.to_be_bytes();
    /// assert_eq(bytes, [0x12, 0x34]);
    /// ```
    #[inline]
    pub fn to_be_bytes(self) -> [u8; 2] {
        self.swap_bytes().to_le_bytes()
    }

    /// Creates an integer value from its representation as a byte array in big
    /// endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = i16::from_be_bytes([0x12, 0x34]);
    /// assert_eq(value, 0x1234);
    /// ```
    #[inline]
    pub fn from_be_bytes(bytes: [u8; 2]) -> i16 {
        i16::from_le_bytes(bytes).swap_bytes()
    }

    /// Returns the memory representation of this integer as a byte array in
    /// native byte order.
    ///
    /// As the target platform's native endianness is used, portable code should
    /// use `to_be_bytes` or `to_le_bytes`, as appropriate, instead. (navi's
    /// targets are all little endian, so this is `to_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x1234i16.to_ne_bytes();
    /// assert_eq(bytes, [0x34, 0x12]);
    /// ```
    #[inline]
    pub fn to_ne_bytes(self) -> [u8; 2] {
        self.to_le_bytes()
    }

    /// Creates an integer value from its memory representation as a byte array
    /// in native endianness.
    ///
    /// As the target platform's native endianness is used, portable code likely
    /// wants to use `from_be_bytes` or `from_le_bytes`, as appropriate instead.
    /// (navi's targets are all little endian, so this is `from_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let value = i16::from_ne_bytes([0x34, 0x12]);
    /// assert_eq(value, 0x1234);
    /// ```
    #[inline]
    pub fn from_ne_bytes(bytes: [u8; 2]) -> i16 {
        i16::from_le_bytes(bytes)
    }

    /// Returns the number of leading ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-1i16).leading_ones(), 16);
    /// assert_eq(i16::MIN.leading_ones(), 1);
    /// assert_eq(1i16.leading_ones(), 0);
    /// ```
    #[inline]
    pub fn leading_ones(self) -> u32 {
        (!self).leading_zeros()
    }

    /// Returns the number of trailing ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3i16.trailing_ones(), 2);
    /// assert_eq((-1i16).trailing_ones(), 16);
    /// assert_eq(i16::MIN.trailing_ones(), 0);
    /// ```
    #[inline]
    pub fn trailing_ones(self) -> u32 {
        (!self).trailing_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is less than or equal to zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2i16.ilog2(), 1);
    /// assert_eq(i16::MAX.ilog2(), 14);
    /// ```
    #[track_caller]
    pub fn ilog2(self) -> u32 {
        if self <= 0 {
            panic("argument of integer logarithm must be positive");
        }
        16 - 1 - self.leading_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is negative or zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2i16.checked_ilog2(), Some(1));
    /// assert_eq(0i16.checked_ilog2(), None);
    /// ```
    #[inline]
    pub fn checked_ilog2(self) -> Option<u32> {
        if self <= 0 {
            None
        } else {
            Some(16 - 1 - self.leading_zeros())
        }
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is less than or equal to zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i16.ilog10(), 1);
    /// assert_eq(99i16.ilog10(), 1);
    /// assert_eq(i16::MAX.ilog10(), 4);
    /// ```
    #[track_caller]
    pub fn ilog10(self) -> u32 {
        if self <= 0 {
            panic("argument of integer logarithm must be positive");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= 10 {
            v = v / 10;
            n += 1;
        }
        n
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is negative or zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i16.checked_ilog10(), Some(1));
    /// assert_eq(0i16.checked_ilog10(), None);
    /// ```
    #[inline]
    pub fn checked_ilog10(self) -> Option<u32> {
        if self <= 0 { None } else { Some(self.ilog10()) }
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `ilog2` can produce results more efficiently for base 2, and `ilog10`
    /// can produce results more efficiently for base 10.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is less than or equal to zero, or if
    /// `base` is less than 2.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i16.ilog(5), 1);
    /// assert_eq(100i16.ilog(3), 4);
    /// ```
    #[track_caller]
    pub fn ilog(self, base: i16) -> u32 {
        if self <= 0 {
            panic("argument of integer logarithm must be positive");
        }
        if base < 2 {
            panic("base of integer logarithm must be at least 2");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= base {
            v = v / base;
            n += 1;
        }
        n
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// Returns `None` if the number is negative or zero, or if the base is not
    /// at least 2.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `checked_ilog2` can produce results more efficiently for base 2, and
    /// `checked_ilog10` can produce results more efficiently for base 10.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i16.checked_ilog(5), Some(1));
    /// assert_eq(0i16.checked_ilog(5), None);
    /// assert_eq(5i16.checked_ilog(1), None);
    /// ```
    #[inline]
    pub fn checked_ilog(self, base: i16) -> Option<u32> {
        if self <= 0 || base < 2 {
            None
        } else {
            Some(self.ilog(base))
        }
    }

    /// Returns the square root of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is negative.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i16.isqrt(), 3);
    /// assert_eq(i16::MAX.isqrt(), 181);
    /// ```
    #[track_caller]
    pub fn isqrt(self) -> i16 {
        if self < 0 {
            panic("argument of integer square root cannot be negative");
        }
        if self < 2 {
            return self;
        }
        let mut x = (self as f64).sqrt() as i16;
        while x > self / x {
            x -= 1;
        }
        while x + 1 <= self / (x + 1) {
            x += 1;
        }
        x
    }

    /// Negates self, overflowing if this is equal to the minimum value.
    ///
    /// Returns a tuple of the negated version of self along with a boolean
    /// indicating whether an overflow happened. If `self` is the minimum value
    /// (`i16::MIN`), then the minimum value will be returned again and `true`
    /// will be returned for an overflow happening.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2i16.overflowing_neg(), (-2, false));
    /// assert_eq(i16::MIN.overflowing_neg(), (i16::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_neg(self) -> (i16, bool) {
        if self == i16::MIN {
            (self, true)
        } else {
            (-self, false)
        }
    }

    /// Checked absolute value. Computes `self.abs()`, returning `None` if `self
    /// == MIN`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-5i16).checked_abs(), Some(5));
    /// assert_eq(i16::MIN.checked_abs(), None);
    /// ```
    #[inline]
    pub fn checked_abs(self) -> Option<i16> {
        if self == i16::MIN {
            None
        } else {
            Some(self.abs())
        }
    }

    /// Computes the absolute value of `self`.
    ///
    /// Returns a tuple of the absolute version of self along with a boolean
    /// indicating whether an overflow happened. If self is the minimum value
    /// (`i16::MIN`), then the minimum value will be returned again and true
    /// will be returned for an overflow happening.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i16.overflowing_abs(), (10, false));
    /// assert_eq((-10i16).overflowing_abs(), (10, false));
    /// assert_eq(i16::MIN.overflowing_abs(), (i16::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_abs(self) -> (i16, bool) {
        (self.wrapping_abs(), self == i16::MIN)
    }

    /// Saturating absolute value. Computes `self.abs()`, returning `MAX` if
    /// `self == MIN` instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i16.saturating_abs(), 100);
    /// assert_eq((-100i16).saturating_abs(), 100);
    /// assert_eq(i16::MIN.saturating_abs(), i16::MAX);
    /// assert_eq((i16::MIN + 1).saturating_abs(), i16::MAX);
    /// ```
    #[inline]
    pub fn saturating_abs(self) -> i16 {
        if self == i16::MIN {
            i16::MAX
        } else {
            self.abs()
        }
    }

    /// Saturating integer negation. Computes `-self`, returning `MAX` if `self
    /// == MIN` instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i16.saturating_neg(), -100);
    /// assert_eq((-100i16).saturating_neg(), 100);
    /// assert_eq(i16::MIN.saturating_neg(), i16::MAX);
    /// assert_eq(i16::MAX.saturating_neg(), i16::MIN + 1);
    /// ```
    #[inline]
    pub fn saturating_neg(self) -> i16 {
        if self == i16::MIN { i16::MAX } else { -self }
    }

    /// Computes the absolute difference between `self` and `other`.
    ///
    /// This function always returns the correct answer without overflow or
    /// panics by returning an unsigned integer.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i16.abs_diff(80), 20u16);
    /// assert_eq(100i16.abs_diff(110), 10u16);
    /// assert_eq((-100i16).abs_diff(80), 180u16);
    /// assert_eq((-100i16).abs_diff(-120), 20u16);
    /// assert_eq(i16::MIN.abs_diff(i16::MAX), u16::MAX);
    /// ```
    #[inline]
    pub fn abs_diff(self, other: i16) -> u16 {
        if self < other {
            (other as u16).wrapping_sub(self as u16)
        } else {
            (self as u16).wrapping_sub(other as u16)
        }
    }

    /// Calculates the quotient of Euclidean division of `self` by `rhs`.
    ///
    /// This computes the integer `q` such that `self = q * rhs + r`, with `r =
    /// self.rem_euclid(rhs)` and `0 <= r < abs(rhs)`.
    ///
    /// In other words, the result is `self / rhs` rounded to the integer `q`
    /// such that `self >= q * rhs`. If `self > 0`, this is equal to rounding
    /// towards zero (what `/` does); if `self < 0`, this is equal to rounding
    /// away from zero (towards +/- infinity). If `rhs > 0`, this is equal to
    /// rounding towards -infinity; if `rhs < 0`, this is equal to rounding
    /// towards +infinity.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero or if `self` is `MIN` and
    /// `rhs` is -1.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = 7i16;
    /// let b = 4;
    ///
    /// assert_eq(a.div_euclid(b), 1); // 7 >= 4 * 1
    /// assert_eq(a.div_euclid(-b), -1); // 7 >= -4 * -1
    /// assert_eq((-a).div_euclid(b), -2); // -7 >= 4 * -2
    /// assert_eq((-a).div_euclid(-b), 2); // -7 >= -4 * 2
    /// ```
    #[track_caller]
    pub fn div_euclid(self, rhs: i16) -> i16 {
        let q = self / rhs;
        if self % rhs < 0 {
            if rhs > 0 { q - 1 } else { q + 1 }
        } else {
            q
        }
    }

    /// Calculates the least nonnegative remainder of `self (mod rhs)`.
    ///
    /// This is done as if by the Euclidean division algorithm -- given `r =
    /// self.rem_euclid(rhs)`, the result satisfies `self = rhs *
    /// self.div_euclid(rhs) + r` and `0 <= r < abs(rhs)`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero or if `self` is `MIN` and
    /// `rhs` is -1.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = 7i16;
    /// let b = 4;
    ///
    /// assert_eq(a.rem_euclid(b), 3);
    /// assert_eq((-a).rem_euclid(b), 1);
    /// assert_eq(a.rem_euclid(-b), 3);
    /// assert_eq((-a).rem_euclid(-b), 1);
    /// ```
    #[track_caller]
    pub fn rem_euclid(self, rhs: i16) -> i16 {
        let r = self % rhs;
        if r < 0 {
            r.wrapping_add(rhs.wrapping_abs())
        } else {
            r
        }
    }

    /// Returns the square root of the number, rounded down.
    ///
    /// Returns `None` if `self` is negative.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i16.checked_isqrt(), Some(3));
    /// assert_eq((-1i16).checked_isqrt(), None);
    /// ```
    #[inline]
    pub fn checked_isqrt(self) -> Option<i16> {
        if self < 0 { None } else { Some(self.isqrt()) }
    }

    /// Reverses the byte order of the integer.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1234i16;
    /// let m = n.swap_bytes();
    ///
    /// assert_eq(m, 0x3412);
    /// ```
    #[inline]
    pub fn swap_bytes(self) -> i16 {
        let v = self as u16;
        let mut r: u16 = 0;
        let mut i = 0u32;
        while i < 2 {
            r = (r << 8) | ((v >> (8 * i)) & 255);
            i += 1;
        }
        r as i16
    }
}

impl i32 {
    /// Checked negation. Computes `-self`, returning `None` if `self == MIN`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i32.checked_neg(), Some(-5));
    /// assert_eq(i32::MIN.checked_neg(), None);
    /// ```
    #[inline]
    pub fn checked_neg(self) -> Option<i32> {
        let (r, o) = self.overflowing_neg();
        if o { None } else { Some(r) }
    }

    /// Checked exponentiation. Computes `self.pow(exp)`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(8i32.checked_pow(2), Some(64));
    /// assert_eq(i32::MAX.checked_pow(2), None);
    /// ```
    pub fn checked_pow(self, exp: u32) -> Option<i32> {
        if exp == 0 {
            return Some(1);
        }
        let mut base = self;
        let mut acc: i32 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc.checked_mul(base)?;
                if e == 1 {
                    return Some(acc);
                }
            }
            e = e / 2;
            base = base.checked_mul(base)?;
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// Returns a tuple of the exponentiation along with a bool indicating
    /// whether an overflow happened.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3i32.overflowing_pow(4), (81, false));
    /// assert_eq(i32::MAX.overflowing_pow(2), (1, true));
    /// ```
    pub fn overflowing_pow(self, exp: u32) -> (i32, bool) {
        if exp == 0 {
            return (1, false);
        }
        let mut base = self;
        let mut acc: i32 = 1;
        let mut e = exp;
        let mut over = false;
        loop {
            if e & 1 == 1 {
                let (r, o) = acc.overflowing_mul(base);
                acc = r;
                over = over || o;
                if e == 1 {
                    return (acc, over);
                }
            }
            e = e / 2;
            let (b, o) = base.overflowing_mul(base);
            base = b;
            over = over || o;
        }
    }

    /// Saturating integer exponentiation. Computes `self.pow(exp)`, saturating
    /// at the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-4i32).saturating_pow(3), -64);
    /// assert_eq(i32::MIN.saturating_pow(2), i32::MAX);
    /// assert_eq(i32::MIN.saturating_pow(3), i32::MIN);
    /// ```
    #[inline]
    pub fn saturating_pow(self, exp: u32) -> i32 {
        match self.checked_pow(exp) {
            Some(r) => r,
            None => {
                if self < 0 && exp % 2 == 1 {
                    i32::MIN
                } else {
                    i32::MAX
                }
            }
        }
    }

    /// Checked shift left. Computes `self << rhs`, returning `None` if `rhs` is
    /// larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1i32.checked_shl(4), Some(0x10));
    /// assert_eq(0x1i32.checked_shl(32), None);
    /// assert_eq(0x10i32.checked_shl(31), Some(0));
    /// ```
    #[inline]
    pub fn checked_shl(self, rhs: u32) -> Option<i32> {
        if rhs < 32 { Some(self << rhs) } else { None }
    }

    /// Checked shift right. Computes `self >> rhs`, returning `None` if `rhs`
    /// is larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10i32.checked_shr(4), Some(0x1));
    /// assert_eq(0x10i32.checked_shr(32), None);
    /// ```
    #[inline]
    pub fn checked_shr(self, rhs: u32) -> Option<i32> {
        if rhs < 32 { Some(self >> rhs) } else { None }
    }

    /// Panic-free bitwise shift-left; yields `self << mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-left; the RHS of a wrapping
    /// shift-left is restricted to the range of the type, rather than the bits
    /// shifted out of the LHS being returned to the other end. The primitive
    /// integer types all implement a `rotate_left` function, which may be what
    /// you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-1i32).wrapping_shl(7), -128);
    /// assert_eq((-1i32).wrapping_shl(128), -1);
    /// ```
    #[inline]
    pub fn wrapping_shl(self, rhs: u32) -> i32 {
        self << (rhs % 32)
    }

    /// Panic-free bitwise shift-right; yields `self >> mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-right; the RHS of a
    /// wrapping shift-right is restricted to the range of the type, rather than
    /// the bits shifted out of the LHS being returned to the other end. The
    /// primitive integer types all implement a `rotate_right` function, which
    /// may be what you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-128i32).wrapping_shr(7), -1);
    /// assert_eq((-128i32).wrapping_shr(128), -128);
    /// ```
    #[inline]
    pub fn wrapping_shr(self, rhs: u32) -> i32 {
        self >> (rhs % 32)
    }

    /// Shifts self left by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1i32.overflowing_shl(4), (0x10, false));
    /// assert_eq(0x1i32.overflowing_shl(36), (0x10, true));
    /// assert_eq(0x10i32.overflowing_shl(31), (0, false));
    /// ```
    #[inline]
    pub fn overflowing_shl(self, rhs: u32) -> (i32, bool) {
        (self.wrapping_shl(rhs), rhs >= 32)
    }

    /// Shifts self right by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10i32.overflowing_shr(4), (0x1, false));
    /// assert_eq(0x10i32.overflowing_shr(36), (0x1, true));
    /// ```
    #[inline]
    pub fn overflowing_shr(self, rhs: u32) -> (i32, bool) {
        (self.wrapping_shr(rhs), rhs >= 32)
    }

    /// Wrapping (modular) division. Computes `self / rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// The only case where such wrapping can occur is when one divides `MIN /
    /// -1` on a signed type (where `MIN` is the negative minimal value for the
    /// type); this is equivalent to `-MIN`, a positive value that is too large
    /// to represent in the type. In such a case, this function returns `MIN`
    /// itself.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i32.wrapping_div(10), 10);
    /// assert_eq(i32::MIN.wrapping_div(-1), i32::MIN);
    /// ```
    #[inline]
    pub fn wrapping_div(self, rhs: i32) -> i32 {
        if self == i32::MIN && rhs == -1 {
            self
        } else {
            self / rhs
        }
    }

    /// Wrapping (modular) remainder. Computes `self % rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// Such wrap-around never actually occurs mathematically; implementation
    /// artifacts make `x % y` invalid for `MIN / -1` on a signed type (where
    /// `MIN` is the negative minimal value). In such a case, this function
    /// returns `0`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i32.wrapping_rem(10), 0);
    /// assert_eq(i32::MIN.wrapping_rem(-1), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem(self, rhs: i32) -> i32 {
        if self == i32::MIN && rhs == -1 {
            0
        } else {
            self % rhs
        }
    }

    /// Calculates the divisor when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the divisor along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would occur then self
    /// is returned.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i32.overflowing_div(2), (2, false));
    /// assert_eq(i32::MIN.overflowing_div(-1), (i32::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_div(self, rhs: i32) -> (i32, bool) {
        if self == i32::MIN && rhs == -1 {
            (self, true)
        } else {
            (self / rhs, false)
        }
    }

    /// Calculates the remainder when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the remainder along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would occur then 0 is
    /// returned.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i32.overflowing_rem(2), (1, false));
    /// assert_eq(i32::MIN.overflowing_rem(-1), (0, true));
    /// ```
    #[inline]
    pub fn overflowing_rem(self, rhs: i32) -> (i32, bool) {
        if self == i32::MIN && rhs == -1 {
            (0, true)
        } else {
            (self % rhs, false)
        }
    }

    /// Saturating integer division. Computes `self / rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i32.saturating_div(2), 2);
    /// assert_eq(i32::MAX.saturating_div(-1), i32::MIN + 1);
    /// assert_eq(i32::MIN.saturating_div(-1), i32::MAX);
    /// ```
    #[inline]
    pub fn saturating_div(self, rhs: i32) -> i32 {
        if self == i32::MIN && rhs == -1 {
            i32::MAX
        } else {
            self / rhs
        }
    }

    /// Checked Euclidean division. Computes `self.div_euclid(rhs)`, returning
    /// `None` if `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i32::MIN + 1).checked_div_euclid(-1), Some(i32::MAX));
    /// assert_eq(i32::MIN.checked_div_euclid(-1), None);
    /// assert_eq(1i32.checked_div_euclid(0), None);
    /// ```
    #[inline]
    pub fn checked_div_euclid(self, rhs: i32) -> Option<i32> {
        if rhs == 0 || self == i32::MIN && rhs == -1 {
            None
        } else {
            Some(self.div_euclid(rhs))
        }
    }

    /// Checked Euclidean remainder. Computes `self.rem_euclid(rhs)`, returning
    /// `None` if `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i32.checked_rem_euclid(2), Some(1));
    /// assert_eq(5i32.checked_rem_euclid(0), None);
    /// assert_eq(i32::MIN.checked_rem_euclid(-1), None);
    /// ```
    #[inline]
    pub fn checked_rem_euclid(self, rhs: i32) -> Option<i32> {
        if rhs == 0 || self == i32::MIN && rhs == -1 {
            None
        } else {
            Some(self.rem_euclid(rhs))
        }
    }

    /// Wrapping Euclidean division. Computes `self.div_euclid(rhs)`, wrapping
    /// around at the boundary of the type.
    ///
    /// Wrapping will only occur in `MIN / -1` on a signed type (where `MIN` is
    /// the negative minimal value for the type). This is equivalent to `-MIN`,
    /// a positive value that is too large to represent in the type. In this
    /// case, this method returns `MIN` itself.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i32.wrapping_div_euclid(10), 10);
    /// assert_eq(i32::MIN.wrapping_div_euclid(-1), i32::MIN);
    /// ```
    #[inline]
    pub fn wrapping_div_euclid(self, rhs: i32) -> i32 {
        if self == i32::MIN && rhs == -1 {
            self
        } else {
            self.div_euclid(rhs)
        }
    }

    /// Wrapping Euclidean remainder. Computes `self.rem_euclid(rhs)`, wrapping
    /// around at the boundary of the type.
    ///
    /// Wrapping will only occur in `MIN % -1` on a signed type (where `MIN` is
    /// the negative minimal value for the type). In this case, this method
    /// returns 0.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i32.wrapping_rem_euclid(10), 0);
    /// assert_eq(i32::MIN.wrapping_rem_euclid(-1), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem_euclid(self, rhs: i32) -> i32 {
        if self == i32::MIN && rhs == -1 {
            0
        } else {
            self.rem_euclid(rhs)
        }
    }

    /// Reverses the order of bits in the integer. The least significant bit
    /// becomes the most significant bit, second least-significant bit becomes
    /// second most-significant bit, etc.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x12345678i32;
    /// let m = n.reverse_bits();
    ///
    /// assert_eq(m, 0x1e6a2c48);
    /// assert_eq(0i32.reverse_bits(), 0);
    /// ```
    #[inline]
    pub fn reverse_bits(self) -> i32 {
        let v = self as u32;
        let mut r: u32 = 0;
        let mut i = 0u32;
        while i < 32 {
            r = (r << 1) | ((v >> i) & 1);
            i += 1;
        }
        r as i32
    }

    /// Converts `self` to big endian from the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai32;
    ///
    /// assert_eq(n.to_be(), n.swap_bytes());
    /// ```
    #[inline]
    pub fn to_be(self) -> i32 {
        self.swap_bytes()
    }

    /// Converts `self` to little endian from the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai32;
    ///
    /// assert_eq(n.to_le(), n);
    /// ```
    #[inline]
    pub fn to_le(self) -> i32 {
        self
    }

    /// Converts an integer from big endian to the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai32;
    ///
    /// assert_eq(i32::from_be(n), n.swap_bytes());
    /// ```
    #[inline]
    pub fn from_be(x: i32) -> i32 {
        x.swap_bytes()
    }

    /// Converts an integer from little endian to the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai32;
    ///
    /// assert_eq(i32::from_le(n), n);
    /// ```
    #[inline]
    pub fn from_le(x: i32) -> i32 {
        x
    }

    /// Returns the memory representation of this integer as a byte array in
    /// big-endian (network) byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x12345678i32.to_be_bytes();
    /// assert_eq(bytes, [0x12, 0x34, 0x56, 0x78]);
    /// ```
    #[inline]
    pub fn to_be_bytes(self) -> [u8; 4] {
        self.swap_bytes().to_le_bytes()
    }

    /// Creates an integer value from its representation as a byte array in big
    /// endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = i32::from_be_bytes([0x12, 0x34, 0x56, 0x78]);
    /// assert_eq(value, 0x12345678);
    /// ```
    #[inline]
    pub fn from_be_bytes(bytes: [u8; 4]) -> i32 {
        i32::from_le_bytes(bytes).swap_bytes()
    }

    /// Returns the memory representation of this integer as a byte array in
    /// native byte order.
    ///
    /// As the target platform's native endianness is used, portable code should
    /// use `to_be_bytes` or `to_le_bytes`, as appropriate, instead. (navi's
    /// targets are all little endian, so this is `to_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x12345678i32.to_ne_bytes();
    /// assert_eq(bytes, [0x78, 0x56, 0x34, 0x12]);
    /// ```
    #[inline]
    pub fn to_ne_bytes(self) -> [u8; 4] {
        self.to_le_bytes()
    }

    /// Creates an integer value from its memory representation as a byte array
    /// in native endianness.
    ///
    /// As the target platform's native endianness is used, portable code likely
    /// wants to use `from_be_bytes` or `from_le_bytes`, as appropriate instead.
    /// (navi's targets are all little endian, so this is `from_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let value = i32::from_ne_bytes([0x78, 0x56, 0x34, 0x12]);
    /// assert_eq(value, 0x12345678);
    /// ```
    #[inline]
    pub fn from_ne_bytes(bytes: [u8; 4]) -> i32 {
        i32::from_le_bytes(bytes)
    }

    /// Returns the number of leading ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-1i32).leading_ones(), 32);
    /// assert_eq(i32::MIN.leading_ones(), 1);
    /// assert_eq(1i32.leading_ones(), 0);
    /// ```
    #[inline]
    pub fn leading_ones(self) -> u32 {
        (!self).leading_zeros()
    }

    /// Returns the number of trailing ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3i32.trailing_ones(), 2);
    /// assert_eq((-1i32).trailing_ones(), 32);
    /// assert_eq(i32::MIN.trailing_ones(), 0);
    /// ```
    #[inline]
    pub fn trailing_ones(self) -> u32 {
        (!self).trailing_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is less than or equal to zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2i32.ilog2(), 1);
    /// assert_eq(i32::MAX.ilog2(), 30);
    /// ```
    #[track_caller]
    pub fn ilog2(self) -> u32 {
        if self <= 0 {
            panic("argument of integer logarithm must be positive");
        }
        32 - 1 - self.leading_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is negative or zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2i32.checked_ilog2(), Some(1));
    /// assert_eq(0i32.checked_ilog2(), None);
    /// ```
    #[inline]
    pub fn checked_ilog2(self) -> Option<u32> {
        if self <= 0 {
            None
        } else {
            Some(32 - 1 - self.leading_zeros())
        }
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is less than or equal to zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i32.ilog10(), 1);
    /// assert_eq(99i32.ilog10(), 1);
    /// assert_eq(i32::MAX.ilog10(), 9);
    /// ```
    #[track_caller]
    pub fn ilog10(self) -> u32 {
        if self <= 0 {
            panic("argument of integer logarithm must be positive");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= 10 {
            v = v / 10;
            n += 1;
        }
        n
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is negative or zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i32.checked_ilog10(), Some(1));
    /// assert_eq(0i32.checked_ilog10(), None);
    /// ```
    #[inline]
    pub fn checked_ilog10(self) -> Option<u32> {
        if self <= 0 { None } else { Some(self.ilog10()) }
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `ilog2` can produce results more efficiently for base 2, and `ilog10`
    /// can produce results more efficiently for base 10.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is less than or equal to zero, or if
    /// `base` is less than 2.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i32.ilog(5), 1);
    /// assert_eq(100i32.ilog(3), 4);
    /// ```
    #[track_caller]
    pub fn ilog(self, base: i32) -> u32 {
        if self <= 0 {
            panic("argument of integer logarithm must be positive");
        }
        if base < 2 {
            panic("base of integer logarithm must be at least 2");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= base {
            v = v / base;
            n += 1;
        }
        n
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// Returns `None` if the number is negative or zero, or if the base is not
    /// at least 2.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `checked_ilog2` can produce results more efficiently for base 2, and
    /// `checked_ilog10` can produce results more efficiently for base 10.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i32.checked_ilog(5), Some(1));
    /// assert_eq(0i32.checked_ilog(5), None);
    /// assert_eq(5i32.checked_ilog(1), None);
    /// ```
    #[inline]
    pub fn checked_ilog(self, base: i32) -> Option<u32> {
        if self <= 0 || base < 2 {
            None
        } else {
            Some(self.ilog(base))
        }
    }

    /// Returns the square root of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is negative.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i32.isqrt(), 3);
    /// assert_eq(i32::MAX.isqrt(), 46340);
    /// ```
    #[track_caller]
    pub fn isqrt(self) -> i32 {
        if self < 0 {
            panic("argument of integer square root cannot be negative");
        }
        if self < 2 {
            return self;
        }
        let mut x = (self as f64).sqrt() as i32;
        while x > self / x {
            x -= 1;
        }
        while x + 1 <= self / (x + 1) {
            x += 1;
        }
        x
    }

    /// Negates self, overflowing if this is equal to the minimum value.
    ///
    /// Returns a tuple of the negated version of self along with a boolean
    /// indicating whether an overflow happened. If `self` is the minimum value
    /// (`i32::MIN`), then the minimum value will be returned again and `true`
    /// will be returned for an overflow happening.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2i32.overflowing_neg(), (-2, false));
    /// assert_eq(i32::MIN.overflowing_neg(), (i32::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_neg(self) -> (i32, bool) {
        if self == i32::MIN {
            (self, true)
        } else {
            (-self, false)
        }
    }

    /// Checked absolute value. Computes `self.abs()`, returning `None` if `self
    /// == MIN`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-5i32).checked_abs(), Some(5));
    /// assert_eq(i32::MIN.checked_abs(), None);
    /// ```
    #[inline]
    pub fn checked_abs(self) -> Option<i32> {
        if self == i32::MIN {
            None
        } else {
            Some(self.abs())
        }
    }

    /// Computes the absolute value of `self`.
    ///
    /// Returns a tuple of the absolute version of self along with a boolean
    /// indicating whether an overflow happened. If self is the minimum value
    /// (`i32::MIN`), then the minimum value will be returned again and true
    /// will be returned for an overflow happening.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i32.overflowing_abs(), (10, false));
    /// assert_eq((-10i32).overflowing_abs(), (10, false));
    /// assert_eq(i32::MIN.overflowing_abs(), (i32::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_abs(self) -> (i32, bool) {
        (self.wrapping_abs(), self == i32::MIN)
    }

    /// Saturating absolute value. Computes `self.abs()`, returning `MAX` if
    /// `self == MIN` instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i32.saturating_abs(), 100);
    /// assert_eq((-100i32).saturating_abs(), 100);
    /// assert_eq(i32::MIN.saturating_abs(), i32::MAX);
    /// assert_eq((i32::MIN + 1).saturating_abs(), i32::MAX);
    /// ```
    #[inline]
    pub fn saturating_abs(self) -> i32 {
        if self == i32::MIN {
            i32::MAX
        } else {
            self.abs()
        }
    }

    /// Saturating integer negation. Computes `-self`, returning `MAX` if `self
    /// == MIN` instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i32.saturating_neg(), -100);
    /// assert_eq((-100i32).saturating_neg(), 100);
    /// assert_eq(i32::MIN.saturating_neg(), i32::MAX);
    /// assert_eq(i32::MAX.saturating_neg(), i32::MIN + 1);
    /// ```
    #[inline]
    pub fn saturating_neg(self) -> i32 {
        if self == i32::MIN { i32::MAX } else { -self }
    }

    /// Computes the absolute difference between `self` and `other`.
    ///
    /// This function always returns the correct answer without overflow or
    /// panics by returning an unsigned integer.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i32.abs_diff(80), 20u32);
    /// assert_eq(100i32.abs_diff(110), 10u32);
    /// assert_eq((-100i32).abs_diff(80), 180u32);
    /// assert_eq((-100i32).abs_diff(-120), 20u32);
    /// assert_eq(i32::MIN.abs_diff(i32::MAX), u32::MAX);
    /// ```
    #[inline]
    pub fn abs_diff(self, other: i32) -> u32 {
        if self < other {
            (other as u32).wrapping_sub(self as u32)
        } else {
            (self as u32).wrapping_sub(other as u32)
        }
    }

    /// Calculates the quotient of Euclidean division of `self` by `rhs`.
    ///
    /// This computes the integer `q` such that `self = q * rhs + r`, with `r =
    /// self.rem_euclid(rhs)` and `0 <= r < abs(rhs)`.
    ///
    /// In other words, the result is `self / rhs` rounded to the integer `q`
    /// such that `self >= q * rhs`. If `self > 0`, this is equal to rounding
    /// towards zero (what `/` does); if `self < 0`, this is equal to rounding
    /// away from zero (towards +/- infinity). If `rhs > 0`, this is equal to
    /// rounding towards -infinity; if `rhs < 0`, this is equal to rounding
    /// towards +infinity.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero or if `self` is `MIN` and
    /// `rhs` is -1.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = 7i32;
    /// let b = 4;
    ///
    /// assert_eq(a.div_euclid(b), 1); // 7 >= 4 * 1
    /// assert_eq(a.div_euclid(-b), -1); // 7 >= -4 * -1
    /// assert_eq((-a).div_euclid(b), -2); // -7 >= 4 * -2
    /// assert_eq((-a).div_euclid(-b), 2); // -7 >= -4 * 2
    /// ```
    #[track_caller]
    pub fn div_euclid(self, rhs: i32) -> i32 {
        let q = self / rhs;
        if self % rhs < 0 {
            if rhs > 0 { q - 1 } else { q + 1 }
        } else {
            q
        }
    }

    /// Calculates the least nonnegative remainder of `self (mod rhs)`.
    ///
    /// This is done as if by the Euclidean division algorithm -- given `r =
    /// self.rem_euclid(rhs)`, the result satisfies `self = rhs *
    /// self.div_euclid(rhs) + r` and `0 <= r < abs(rhs)`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero or if `self` is `MIN` and
    /// `rhs` is -1.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = 7i32;
    /// let b = 4;
    ///
    /// assert_eq(a.rem_euclid(b), 3);
    /// assert_eq((-a).rem_euclid(b), 1);
    /// assert_eq(a.rem_euclid(-b), 3);
    /// assert_eq((-a).rem_euclid(-b), 1);
    /// ```
    #[track_caller]
    pub fn rem_euclid(self, rhs: i32) -> i32 {
        let r = self % rhs;
        if r < 0 {
            r.wrapping_add(rhs.wrapping_abs())
        } else {
            r
        }
    }

    /// Returns the square root of the number, rounded down.
    ///
    /// Returns `None` if `self` is negative.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i32.checked_isqrt(), Some(3));
    /// assert_eq((-1i32).checked_isqrt(), None);
    /// ```
    #[inline]
    pub fn checked_isqrt(self) -> Option<i32> {
        if self < 0 { None } else { Some(self.isqrt()) }
    }

    /// Reverses the byte order of the integer.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x12345678i32;
    /// let m = n.swap_bytes();
    ///
    /// assert_eq(m, 0x78563412);
    /// ```
    #[inline]
    pub fn swap_bytes(self) -> i32 {
        let v = self as u32;
        let mut r: u32 = 0;
        let mut i = 0u32;
        while i < 4 {
            r = (r << 8) | ((v >> (8 * i)) & 255);
            i += 1;
        }
        r as i32
    }
}

impl i64 {
    /// Checked negation. Computes `-self`, returning `None` if `self == MIN`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i64.checked_neg(), Some(-5));
    /// assert_eq(i64::MIN.checked_neg(), None);
    /// ```
    #[inline]
    pub fn checked_neg(self) -> Option<i64> {
        let (r, o) = self.overflowing_neg();
        if o { None } else { Some(r) }
    }

    /// Checked exponentiation. Computes `self.pow(exp)`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(8i64.checked_pow(2), Some(64));
    /// assert_eq(i64::MAX.checked_pow(2), None);
    /// ```
    pub fn checked_pow(self, exp: u32) -> Option<i64> {
        if exp == 0 {
            return Some(1);
        }
        let mut base = self;
        let mut acc: i64 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc.checked_mul(base)?;
                if e == 1 {
                    return Some(acc);
                }
            }
            e = e / 2;
            base = base.checked_mul(base)?;
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// Returns a tuple of the exponentiation along with a bool indicating
    /// whether an overflow happened.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3i64.overflowing_pow(4), (81, false));
    /// assert_eq(i64::MAX.overflowing_pow(2), (1, true));
    /// ```
    pub fn overflowing_pow(self, exp: u32) -> (i64, bool) {
        if exp == 0 {
            return (1, false);
        }
        let mut base = self;
        let mut acc: i64 = 1;
        let mut e = exp;
        let mut over = false;
        loop {
            if e & 1 == 1 {
                let (r, o) = acc.overflowing_mul(base);
                acc = r;
                over = over || o;
                if e == 1 {
                    return (acc, over);
                }
            }
            e = e / 2;
            let (b, o) = base.overflowing_mul(base);
            base = b;
            over = over || o;
        }
    }

    /// Saturating integer exponentiation. Computes `self.pow(exp)`, saturating
    /// at the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-4i64).saturating_pow(3), -64);
    /// assert_eq(i64::MIN.saturating_pow(2), i64::MAX);
    /// assert_eq(i64::MIN.saturating_pow(3), i64::MIN);
    /// ```
    #[inline]
    pub fn saturating_pow(self, exp: u32) -> i64 {
        match self.checked_pow(exp) {
            Some(r) => r,
            None => {
                if self < 0 && exp % 2 == 1 {
                    i64::MIN
                } else {
                    i64::MAX
                }
            }
        }
    }

    /// Checked shift left. Computes `self << rhs`, returning `None` if `rhs` is
    /// larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1i64.checked_shl(4), Some(0x10));
    /// assert_eq(0x1i64.checked_shl(64), None);
    /// assert_eq(0x10i64.checked_shl(63), Some(0));
    /// ```
    #[inline]
    pub fn checked_shl(self, rhs: u32) -> Option<i64> {
        if rhs < 64 { Some(self << rhs) } else { None }
    }

    /// Checked shift right. Computes `self >> rhs`, returning `None` if `rhs`
    /// is larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10i64.checked_shr(4), Some(0x1));
    /// assert_eq(0x10i64.checked_shr(64), None);
    /// ```
    #[inline]
    pub fn checked_shr(self, rhs: u32) -> Option<i64> {
        if rhs < 64 { Some(self >> rhs) } else { None }
    }

    /// Panic-free bitwise shift-left; yields `self << mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-left; the RHS of a wrapping
    /// shift-left is restricted to the range of the type, rather than the bits
    /// shifted out of the LHS being returned to the other end. The primitive
    /// integer types all implement a `rotate_left` function, which may be what
    /// you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-1i64).wrapping_shl(7), -128);
    /// assert_eq((-1i64).wrapping_shl(128), -1);
    /// ```
    #[inline]
    pub fn wrapping_shl(self, rhs: u32) -> i64 {
        self << (rhs % 64)
    }

    /// Panic-free bitwise shift-right; yields `self >> mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-right; the RHS of a
    /// wrapping shift-right is restricted to the range of the type, rather than
    /// the bits shifted out of the LHS being returned to the other end. The
    /// primitive integer types all implement a `rotate_right` function, which
    /// may be what you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-128i64).wrapping_shr(7), -1);
    /// assert_eq((-128i64).wrapping_shr(128), -128);
    /// ```
    #[inline]
    pub fn wrapping_shr(self, rhs: u32) -> i64 {
        self >> (rhs % 64)
    }

    /// Shifts self left by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1i64.overflowing_shl(4), (0x10, false));
    /// assert_eq(0x1i64.overflowing_shl(68), (0x10, true));
    /// assert_eq(0x10i64.overflowing_shl(63), (0, false));
    /// ```
    #[inline]
    pub fn overflowing_shl(self, rhs: u32) -> (i64, bool) {
        (self.wrapping_shl(rhs), rhs >= 64)
    }

    /// Shifts self right by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10i64.overflowing_shr(4), (0x1, false));
    /// assert_eq(0x10i64.overflowing_shr(68), (0x1, true));
    /// ```
    #[inline]
    pub fn overflowing_shr(self, rhs: u32) -> (i64, bool) {
        (self.wrapping_shr(rhs), rhs >= 64)
    }

    /// Wrapping (modular) division. Computes `self / rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// The only case where such wrapping can occur is when one divides `MIN /
    /// -1` on a signed type (where `MIN` is the negative minimal value for the
    /// type); this is equivalent to `-MIN`, a positive value that is too large
    /// to represent in the type. In such a case, this function returns `MIN`
    /// itself.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i64.wrapping_div(10), 10);
    /// assert_eq(i64::MIN.wrapping_div(-1), i64::MIN);
    /// ```
    #[inline]
    pub fn wrapping_div(self, rhs: i64) -> i64 {
        if self == i64::MIN && rhs == -1 {
            self
        } else {
            self / rhs
        }
    }

    /// Wrapping (modular) remainder. Computes `self % rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// Such wrap-around never actually occurs mathematically; implementation
    /// artifacts make `x % y` invalid for `MIN / -1` on a signed type (where
    /// `MIN` is the negative minimal value). In such a case, this function
    /// returns `0`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i64.wrapping_rem(10), 0);
    /// assert_eq(i64::MIN.wrapping_rem(-1), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem(self, rhs: i64) -> i64 {
        if self == i64::MIN && rhs == -1 {
            0
        } else {
            self % rhs
        }
    }

    /// Calculates the divisor when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the divisor along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would occur then self
    /// is returned.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i64.overflowing_div(2), (2, false));
    /// assert_eq(i64::MIN.overflowing_div(-1), (i64::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_div(self, rhs: i64) -> (i64, bool) {
        if self == i64::MIN && rhs == -1 {
            (self, true)
        } else {
            (self / rhs, false)
        }
    }

    /// Calculates the remainder when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the remainder along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would occur then 0 is
    /// returned.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i64.overflowing_rem(2), (1, false));
    /// assert_eq(i64::MIN.overflowing_rem(-1), (0, true));
    /// ```
    #[inline]
    pub fn overflowing_rem(self, rhs: i64) -> (i64, bool) {
        if self == i64::MIN && rhs == -1 {
            (0, true)
        } else {
            (self % rhs, false)
        }
    }

    /// Saturating integer division. Computes `self / rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i64.saturating_div(2), 2);
    /// assert_eq(i64::MAX.saturating_div(-1), i64::MIN + 1);
    /// assert_eq(i64::MIN.saturating_div(-1), i64::MAX);
    /// ```
    #[inline]
    pub fn saturating_div(self, rhs: i64) -> i64 {
        if self == i64::MIN && rhs == -1 {
            i64::MAX
        } else {
            self / rhs
        }
    }

    /// Checked Euclidean division. Computes `self.div_euclid(rhs)`, returning
    /// `None` if `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i64::MIN + 1).checked_div_euclid(-1), Some(i64::MAX));
    /// assert_eq(i64::MIN.checked_div_euclid(-1), None);
    /// assert_eq(1i64.checked_div_euclid(0), None);
    /// ```
    #[inline]
    pub fn checked_div_euclid(self, rhs: i64) -> Option<i64> {
        if rhs == 0 || self == i64::MIN && rhs == -1 {
            None
        } else {
            Some(self.div_euclid(rhs))
        }
    }

    /// Checked Euclidean remainder. Computes `self.rem_euclid(rhs)`, returning
    /// `None` if `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i64.checked_rem_euclid(2), Some(1));
    /// assert_eq(5i64.checked_rem_euclid(0), None);
    /// assert_eq(i64::MIN.checked_rem_euclid(-1), None);
    /// ```
    #[inline]
    pub fn checked_rem_euclid(self, rhs: i64) -> Option<i64> {
        if rhs == 0 || self == i64::MIN && rhs == -1 {
            None
        } else {
            Some(self.rem_euclid(rhs))
        }
    }

    /// Wrapping Euclidean division. Computes `self.div_euclid(rhs)`, wrapping
    /// around at the boundary of the type.
    ///
    /// Wrapping will only occur in `MIN / -1` on a signed type (where `MIN` is
    /// the negative minimal value for the type). This is equivalent to `-MIN`,
    /// a positive value that is too large to represent in the type. In this
    /// case, this method returns `MIN` itself.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i64.wrapping_div_euclid(10), 10);
    /// assert_eq(i64::MIN.wrapping_div_euclid(-1), i64::MIN);
    /// ```
    #[inline]
    pub fn wrapping_div_euclid(self, rhs: i64) -> i64 {
        if self == i64::MIN && rhs == -1 {
            self
        } else {
            self.div_euclid(rhs)
        }
    }

    /// Wrapping Euclidean remainder. Computes `self.rem_euclid(rhs)`, wrapping
    /// around at the boundary of the type.
    ///
    /// Wrapping will only occur in `MIN % -1` on a signed type (where `MIN` is
    /// the negative minimal value for the type). In this case, this method
    /// returns 0.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i64.wrapping_rem_euclid(10), 0);
    /// assert_eq(i64::MIN.wrapping_rem_euclid(-1), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem_euclid(self, rhs: i64) -> i64 {
        if self == i64::MIN && rhs == -1 {
            0
        } else {
            self.rem_euclid(rhs)
        }
    }

    /// Reverses the order of bits in the integer. The least significant bit
    /// becomes the most significant bit, second least-significant bit becomes
    /// second most-significant bit, etc.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1234567890123456i64;
    /// let m = n.reverse_bits();
    ///
    /// assert_eq(m, 0x6a2c48091e6a2c48);
    /// assert_eq(0i64.reverse_bits(), 0);
    /// ```
    #[inline]
    pub fn reverse_bits(self) -> i64 {
        let v = self as u64;
        let mut r: u64 = 0;
        let mut i = 0u32;
        while i < 64 {
            r = (r << 1) | ((v >> i) & 1);
            i += 1;
        }
        r as i64
    }

    /// Converts `self` to big endian from the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai64;
    ///
    /// assert_eq(n.to_be(), n.swap_bytes());
    /// ```
    #[inline]
    pub fn to_be(self) -> i64 {
        self.swap_bytes()
    }

    /// Converts `self` to little endian from the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai64;
    ///
    /// assert_eq(n.to_le(), n);
    /// ```
    #[inline]
    pub fn to_le(self) -> i64 {
        self
    }

    /// Converts an integer from big endian to the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai64;
    ///
    /// assert_eq(i64::from_be(n), n.swap_bytes());
    /// ```
    #[inline]
    pub fn from_be(x: i64) -> i64 {
        x.swap_bytes()
    }

    /// Converts an integer from little endian to the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai64;
    ///
    /// assert_eq(i64::from_le(n), n);
    /// ```
    #[inline]
    pub fn from_le(x: i64) -> i64 {
        x
    }

    /// Returns the memory representation of this integer as a byte array in
    /// big-endian (network) byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x1234567890123456i64.to_be_bytes();
    /// assert_eq(bytes, [0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56]);
    /// ```
    #[inline]
    pub fn to_be_bytes(self) -> [u8; 8] {
        self.swap_bytes().to_le_bytes()
    }

    /// Creates an integer value from its representation as a byte array in big
    /// endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = i64::from_be_bytes([0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56]);
    /// assert_eq(value, 0x1234567890123456);
    /// ```
    #[inline]
    pub fn from_be_bytes(bytes: [u8; 8]) -> i64 {
        i64::from_le_bytes(bytes).swap_bytes()
    }

    /// Returns the memory representation of this integer as a byte array in
    /// native byte order.
    ///
    /// As the target platform's native endianness is used, portable code should
    /// use `to_be_bytes` or `to_le_bytes`, as appropriate, instead. (navi's
    /// targets are all little endian, so this is `to_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x1234567890123456i64.to_ne_bytes();
    /// assert_eq(bytes, [0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12]);
    /// ```
    #[inline]
    pub fn to_ne_bytes(self) -> [u8; 8] {
        self.to_le_bytes()
    }

    /// Creates an integer value from its memory representation as a byte array
    /// in native endianness.
    ///
    /// As the target platform's native endianness is used, portable code likely
    /// wants to use `from_be_bytes` or `from_le_bytes`, as appropriate instead.
    /// (navi's targets are all little endian, so this is `from_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let value = i64::from_ne_bytes([0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12]);
    /// assert_eq(value, 0x1234567890123456);
    /// ```
    #[inline]
    pub fn from_ne_bytes(bytes: [u8; 8]) -> i64 {
        i64::from_le_bytes(bytes)
    }

    /// Returns the number of leading ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-1i64).leading_ones(), 64);
    /// assert_eq(i64::MIN.leading_ones(), 1);
    /// assert_eq(1i64.leading_ones(), 0);
    /// ```
    #[inline]
    pub fn leading_ones(self) -> u32 {
        (!self).leading_zeros()
    }

    /// Returns the number of trailing ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3i64.trailing_ones(), 2);
    /// assert_eq((-1i64).trailing_ones(), 64);
    /// assert_eq(i64::MIN.trailing_ones(), 0);
    /// ```
    #[inline]
    pub fn trailing_ones(self) -> u32 {
        (!self).trailing_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is less than or equal to zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2i64.ilog2(), 1);
    /// assert_eq(i64::MAX.ilog2(), 62);
    /// ```
    #[track_caller]
    pub fn ilog2(self) -> u32 {
        if self <= 0 {
            panic("argument of integer logarithm must be positive");
        }
        64 - 1 - self.leading_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is negative or zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2i64.checked_ilog2(), Some(1));
    /// assert_eq(0i64.checked_ilog2(), None);
    /// ```
    #[inline]
    pub fn checked_ilog2(self) -> Option<u32> {
        if self <= 0 {
            None
        } else {
            Some(64 - 1 - self.leading_zeros())
        }
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is less than or equal to zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i64.ilog10(), 1);
    /// assert_eq(99i64.ilog10(), 1);
    /// assert_eq(i64::MAX.ilog10(), 18);
    /// ```
    #[track_caller]
    pub fn ilog10(self) -> u32 {
        if self <= 0 {
            panic("argument of integer logarithm must be positive");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= 10 {
            v = v / 10;
            n += 1;
        }
        n
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is negative or zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i64.checked_ilog10(), Some(1));
    /// assert_eq(0i64.checked_ilog10(), None);
    /// ```
    #[inline]
    pub fn checked_ilog10(self) -> Option<u32> {
        if self <= 0 { None } else { Some(self.ilog10()) }
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `ilog2` can produce results more efficiently for base 2, and `ilog10`
    /// can produce results more efficiently for base 10.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is less than or equal to zero, or if
    /// `base` is less than 2.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i64.ilog(5), 1);
    /// assert_eq(100i64.ilog(3), 4);
    /// ```
    #[track_caller]
    pub fn ilog(self, base: i64) -> u32 {
        if self <= 0 {
            panic("argument of integer logarithm must be positive");
        }
        if base < 2 {
            panic("base of integer logarithm must be at least 2");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= base {
            v = v / base;
            n += 1;
        }
        n
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// Returns `None` if the number is negative or zero, or if the base is not
    /// at least 2.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `checked_ilog2` can produce results more efficiently for base 2, and
    /// `checked_ilog10` can produce results more efficiently for base 10.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i64.checked_ilog(5), Some(1));
    /// assert_eq(0i64.checked_ilog(5), None);
    /// assert_eq(5i64.checked_ilog(1), None);
    /// ```
    #[inline]
    pub fn checked_ilog(self, base: i64) -> Option<u32> {
        if self <= 0 || base < 2 {
            None
        } else {
            Some(self.ilog(base))
        }
    }

    /// Returns the square root of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is negative.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i64.isqrt(), 3);
    /// assert_eq(i64::MAX.isqrt(), 3037000499);
    /// ```
    #[track_caller]
    pub fn isqrt(self) -> i64 {
        if self < 0 {
            panic("argument of integer square root cannot be negative");
        }
        if self < 2 {
            return self;
        }
        let mut x = (self as f64).sqrt() as i64;
        while x > self / x {
            x -= 1;
        }
        while x + 1 <= self / (x + 1) {
            x += 1;
        }
        x
    }

    /// Negates self, overflowing if this is equal to the minimum value.
    ///
    /// Returns a tuple of the negated version of self along with a boolean
    /// indicating whether an overflow happened. If `self` is the minimum value
    /// (`i64::MIN`), then the minimum value will be returned again and `true`
    /// will be returned for an overflow happening.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2i64.overflowing_neg(), (-2, false));
    /// assert_eq(i64::MIN.overflowing_neg(), (i64::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_neg(self) -> (i64, bool) {
        if self == i64::MIN {
            (self, true)
        } else {
            (-self, false)
        }
    }

    /// Checked absolute value. Computes `self.abs()`, returning `None` if `self
    /// == MIN`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-5i64).checked_abs(), Some(5));
    /// assert_eq(i64::MIN.checked_abs(), None);
    /// ```
    #[inline]
    pub fn checked_abs(self) -> Option<i64> {
        if self == i64::MIN {
            None
        } else {
            Some(self.abs())
        }
    }

    /// Computes the absolute value of `self`.
    ///
    /// Returns a tuple of the absolute version of self along with a boolean
    /// indicating whether an overflow happened. If self is the minimum value
    /// (`i64::MIN`), then the minimum value will be returned again and true
    /// will be returned for an overflow happening.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i64.overflowing_abs(), (10, false));
    /// assert_eq((-10i64).overflowing_abs(), (10, false));
    /// assert_eq(i64::MIN.overflowing_abs(), (i64::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_abs(self) -> (i64, bool) {
        (self.wrapping_abs(), self == i64::MIN)
    }

    /// Saturating absolute value. Computes `self.abs()`, returning `MAX` if
    /// `self == MIN` instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i64.saturating_abs(), 100);
    /// assert_eq((-100i64).saturating_abs(), 100);
    /// assert_eq(i64::MIN.saturating_abs(), i64::MAX);
    /// assert_eq((i64::MIN + 1).saturating_abs(), i64::MAX);
    /// ```
    #[inline]
    pub fn saturating_abs(self) -> i64 {
        if self == i64::MIN {
            i64::MAX
        } else {
            self.abs()
        }
    }

    /// Saturating integer negation. Computes `-self`, returning `MAX` if `self
    /// == MIN` instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i64.saturating_neg(), -100);
    /// assert_eq((-100i64).saturating_neg(), 100);
    /// assert_eq(i64::MIN.saturating_neg(), i64::MAX);
    /// assert_eq(i64::MAX.saturating_neg(), i64::MIN + 1);
    /// ```
    #[inline]
    pub fn saturating_neg(self) -> i64 {
        if self == i64::MIN { i64::MAX } else { -self }
    }

    /// Computes the absolute difference between `self` and `other`.
    ///
    /// This function always returns the correct answer without overflow or
    /// panics by returning an unsigned integer.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i64.abs_diff(80), 20u64);
    /// assert_eq(100i64.abs_diff(110), 10u64);
    /// assert_eq((-100i64).abs_diff(80), 180u64);
    /// assert_eq((-100i64).abs_diff(-120), 20u64);
    /// assert_eq(i64::MIN.abs_diff(i64::MAX), u64::MAX);
    /// ```
    #[inline]
    pub fn abs_diff(self, other: i64) -> u64 {
        if self < other {
            (other as u64).wrapping_sub(self as u64)
        } else {
            (self as u64).wrapping_sub(other as u64)
        }
    }

    /// Calculates the quotient of Euclidean division of `self` by `rhs`.
    ///
    /// This computes the integer `q` such that `self = q * rhs + r`, with `r =
    /// self.rem_euclid(rhs)` and `0 <= r < abs(rhs)`.
    ///
    /// In other words, the result is `self / rhs` rounded to the integer `q`
    /// such that `self >= q * rhs`. If `self > 0`, this is equal to rounding
    /// towards zero (what `/` does); if `self < 0`, this is equal to rounding
    /// away from zero (towards +/- infinity). If `rhs > 0`, this is equal to
    /// rounding towards -infinity; if `rhs < 0`, this is equal to rounding
    /// towards +infinity.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero or if `self` is `MIN` and
    /// `rhs` is -1.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = 7i64;
    /// let b = 4;
    ///
    /// assert_eq(a.div_euclid(b), 1); // 7 >= 4 * 1
    /// assert_eq(a.div_euclid(-b), -1); // 7 >= -4 * -1
    /// assert_eq((-a).div_euclid(b), -2); // -7 >= 4 * -2
    /// assert_eq((-a).div_euclid(-b), 2); // -7 >= -4 * 2
    /// ```
    #[track_caller]
    pub fn div_euclid(self, rhs: i64) -> i64 {
        let q = self / rhs;
        if self % rhs < 0 {
            if rhs > 0 { q - 1 } else { q + 1 }
        } else {
            q
        }
    }

    /// Calculates the least nonnegative remainder of `self (mod rhs)`.
    ///
    /// This is done as if by the Euclidean division algorithm -- given `r =
    /// self.rem_euclid(rhs)`, the result satisfies `self = rhs *
    /// self.div_euclid(rhs) + r` and `0 <= r < abs(rhs)`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero or if `self` is `MIN` and
    /// `rhs` is -1.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = 7i64;
    /// let b = 4;
    ///
    /// assert_eq(a.rem_euclid(b), 3);
    /// assert_eq((-a).rem_euclid(b), 1);
    /// assert_eq(a.rem_euclid(-b), 3);
    /// assert_eq((-a).rem_euclid(-b), 1);
    /// ```
    #[track_caller]
    pub fn rem_euclid(self, rhs: i64) -> i64 {
        let r = self % rhs;
        if r < 0 {
            r.wrapping_add(rhs.wrapping_abs())
        } else {
            r
        }
    }

    /// Returns the square root of the number, rounded down.
    ///
    /// Returns `None` if `self` is negative.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i64.checked_isqrt(), Some(3));
    /// assert_eq((-1i64).checked_isqrt(), None);
    /// ```
    #[inline]
    pub fn checked_isqrt(self) -> Option<i64> {
        if self < 0 { None } else { Some(self.isqrt()) }
    }

    /// Reverses the byte order of the integer.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1234567890123456i64;
    /// let m = n.swap_bytes();
    ///
    /// assert_eq(m, 0x5634129078563412);
    /// ```
    #[inline]
    pub fn swap_bytes(self) -> i64 {
        let v = self as u64;
        let mut r: u64 = 0;
        let mut i = 0u32;
        while i < 8 {
            r = (r << 8) | ((v >> (8 * i)) & 255);
            i += 1;
        }
        r as i64
    }
}

impl isize {
    /// Checked negation. Computes `-self`, returning `None` if `self == MIN`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5isize.checked_neg(), Some(-5));
    /// assert_eq(isize::MIN.checked_neg(), None);
    /// ```
    #[inline]
    pub fn checked_neg(self) -> Option<isize> {
        let (r, o) = self.overflowing_neg();
        if o { None } else { Some(r) }
    }

    /// Checked exponentiation. Computes `self.pow(exp)`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(8isize.checked_pow(2), Some(64));
    /// assert_eq(isize::MAX.checked_pow(2), None);
    /// ```
    pub fn checked_pow(self, exp: u32) -> Option<isize> {
        if exp == 0 {
            return Some(1);
        }
        let mut base = self;
        let mut acc: isize = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc.checked_mul(base)?;
                if e == 1 {
                    return Some(acc);
                }
            }
            e = e / 2;
            base = base.checked_mul(base)?;
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// Returns a tuple of the exponentiation along with a bool indicating
    /// whether an overflow happened.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3isize.overflowing_pow(4), (81, false));
    /// assert_eq(isize::MAX.overflowing_pow(2), (1, true));
    /// ```
    pub fn overflowing_pow(self, exp: u32) -> (isize, bool) {
        if exp == 0 {
            return (1, false);
        }
        let mut base = self;
        let mut acc: isize = 1;
        let mut e = exp;
        let mut over = false;
        loop {
            if e & 1 == 1 {
                let (r, o) = acc.overflowing_mul(base);
                acc = r;
                over = over || o;
                if e == 1 {
                    return (acc, over);
                }
            }
            e = e / 2;
            let (b, o) = base.overflowing_mul(base);
            base = b;
            over = over || o;
        }
    }

    /// Saturating integer exponentiation. Computes `self.pow(exp)`, saturating
    /// at the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-4isize).saturating_pow(3), -64);
    /// assert_eq(isize::MIN.saturating_pow(2), isize::MAX);
    /// assert_eq(isize::MIN.saturating_pow(3), isize::MIN);
    /// ```
    #[inline]
    pub fn saturating_pow(self, exp: u32) -> isize {
        match self.checked_pow(exp) {
            Some(r) => r,
            None => {
                if self < 0 && exp % 2 == 1 {
                    isize::MIN
                } else {
                    isize::MAX
                }
            }
        }
    }

    /// Checked shift left. Computes `self << rhs`, returning `None` if `rhs` is
    /// larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((0x1 as isize).checked_shl(4), Some(0x10));
    /// assert_eq((0x1 as isize).checked_shl(64), None);
    /// assert_eq((0x10 as isize).checked_shl(63), Some(0));
    /// ```
    #[inline]
    pub fn checked_shl(self, rhs: u32) -> Option<isize> {
        if rhs < 64 { Some(self << rhs) } else { None }
    }

    /// Checked shift right. Computes `self >> rhs`, returning `None` if `rhs`
    /// is larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((0x10 as isize).checked_shr(4), Some(0x1));
    /// assert_eq((0x10 as isize).checked_shr(64), None);
    /// ```
    #[inline]
    pub fn checked_shr(self, rhs: u32) -> Option<isize> {
        if rhs < 64 { Some(self >> rhs) } else { None }
    }

    /// Panic-free bitwise shift-left; yields `self << mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-left; the RHS of a wrapping
    /// shift-left is restricted to the range of the type, rather than the bits
    /// shifted out of the LHS being returned to the other end. The primitive
    /// integer types all implement a `rotate_left` function, which may be what
    /// you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-1isize).wrapping_shl(7), -128);
    /// assert_eq((-1isize).wrapping_shl(128), -1);
    /// ```
    #[inline]
    pub fn wrapping_shl(self, rhs: u32) -> isize {
        self << (rhs % 64)
    }

    /// Panic-free bitwise shift-right; yields `self >> mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-right; the RHS of a
    /// wrapping shift-right is restricted to the range of the type, rather than
    /// the bits shifted out of the LHS being returned to the other end. The
    /// primitive integer types all implement a `rotate_right` function, which
    /// may be what you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-128isize).wrapping_shr(7), -1);
    /// assert_eq((-128isize).wrapping_shr(128), -128);
    /// ```
    #[inline]
    pub fn wrapping_shr(self, rhs: u32) -> isize {
        self >> (rhs % 64)
    }

    /// Shifts self left by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((0x1 as isize).overflowing_shl(4), (0x10, false));
    /// assert_eq((0x1 as isize).overflowing_shl(68), (0x10, true));
    /// assert_eq((0x10 as isize).overflowing_shl(63), (0, false));
    /// ```
    #[inline]
    pub fn overflowing_shl(self, rhs: u32) -> (isize, bool) {
        (self.wrapping_shl(rhs), rhs >= 64)
    }

    /// Shifts self right by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((0x10 as isize).overflowing_shr(4), (0x1, false));
    /// assert_eq((0x10 as isize).overflowing_shr(68), (0x1, true));
    /// ```
    #[inline]
    pub fn overflowing_shr(self, rhs: u32) -> (isize, bool) {
        (self.wrapping_shr(rhs), rhs >= 64)
    }

    /// Wrapping (modular) division. Computes `self / rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// The only case where such wrapping can occur is when one divides `MIN /
    /// -1` on a signed type (where `MIN` is the negative minimal value for the
    /// type); this is equivalent to `-MIN`, a positive value that is too large
    /// to represent in the type. In such a case, this function returns `MIN`
    /// itself.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100isize.wrapping_div(10), 10);
    /// assert_eq(isize::MIN.wrapping_div(-1), isize::MIN);
    /// ```
    #[inline]
    pub fn wrapping_div(self, rhs: isize) -> isize {
        if self == isize::MIN && rhs == -1 {
            self
        } else {
            self / rhs
        }
    }

    /// Wrapping (modular) remainder. Computes `self % rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// Such wrap-around never actually occurs mathematically; implementation
    /// artifacts make `x % y` invalid for `MIN / -1` on a signed type (where
    /// `MIN` is the negative minimal value). In such a case, this function
    /// returns `0`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100isize.wrapping_rem(10), 0);
    /// assert_eq(isize::MIN.wrapping_rem(-1), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem(self, rhs: isize) -> isize {
        if self == isize::MIN && rhs == -1 {
            0
        } else {
            self % rhs
        }
    }

    /// Calculates the divisor when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the divisor along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would occur then self
    /// is returned.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5isize.overflowing_div(2), (2, false));
    /// assert_eq(isize::MIN.overflowing_div(-1), (isize::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_div(self, rhs: isize) -> (isize, bool) {
        if self == isize::MIN && rhs == -1 {
            (self, true)
        } else {
            (self / rhs, false)
        }
    }

    /// Calculates the remainder when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the remainder along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would occur then 0 is
    /// returned.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5isize.overflowing_rem(2), (1, false));
    /// assert_eq(isize::MIN.overflowing_rem(-1), (0, true));
    /// ```
    #[inline]
    pub fn overflowing_rem(self, rhs: isize) -> (isize, bool) {
        if self == isize::MIN && rhs == -1 {
            (0, true)
        } else {
            (self % rhs, false)
        }
    }

    /// Saturating integer division. Computes `self / rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5isize.saturating_div(2), 2);
    /// assert_eq(isize::MAX.saturating_div(-1), isize::MIN + 1);
    /// assert_eq(isize::MIN.saturating_div(-1), isize::MAX);
    /// ```
    #[inline]
    pub fn saturating_div(self, rhs: isize) -> isize {
        if self == isize::MIN && rhs == -1 {
            isize::MAX
        } else {
            self / rhs
        }
    }

    /// Checked Euclidean division. Computes `self.div_euclid(rhs)`, returning
    /// `None` if `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((isize::MIN + 1).checked_div_euclid(-1), Some(isize::MAX));
    /// assert_eq(isize::MIN.checked_div_euclid(-1), None);
    /// assert_eq(1isize.checked_div_euclid(0), None);
    /// ```
    #[inline]
    pub fn checked_div_euclid(self, rhs: isize) -> Option<isize> {
        if rhs == 0 || self == isize::MIN && rhs == -1 {
            None
        } else {
            Some(self.div_euclid(rhs))
        }
    }

    /// Checked Euclidean remainder. Computes `self.rem_euclid(rhs)`, returning
    /// `None` if `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5isize.checked_rem_euclid(2), Some(1));
    /// assert_eq(5isize.checked_rem_euclid(0), None);
    /// assert_eq(isize::MIN.checked_rem_euclid(-1), None);
    /// ```
    #[inline]
    pub fn checked_rem_euclid(self, rhs: isize) -> Option<isize> {
        if rhs == 0 || self == isize::MIN && rhs == -1 {
            None
        } else {
            Some(self.rem_euclid(rhs))
        }
    }

    /// Wrapping Euclidean division. Computes `self.div_euclid(rhs)`, wrapping
    /// around at the boundary of the type.
    ///
    /// Wrapping will only occur in `MIN / -1` on a signed type (where `MIN` is
    /// the negative minimal value for the type). This is equivalent to `-MIN`,
    /// a positive value that is too large to represent in the type. In this
    /// case, this method returns `MIN` itself.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100isize.wrapping_div_euclid(10), 10);
    /// assert_eq(isize::MIN.wrapping_div_euclid(-1), isize::MIN);
    /// ```
    #[inline]
    pub fn wrapping_div_euclid(self, rhs: isize) -> isize {
        if self == isize::MIN && rhs == -1 {
            self
        } else {
            self.div_euclid(rhs)
        }
    }

    /// Wrapping Euclidean remainder. Computes `self.rem_euclid(rhs)`, wrapping
    /// around at the boundary of the type.
    ///
    /// Wrapping will only occur in `MIN % -1` on a signed type (where `MIN` is
    /// the negative minimal value for the type). In this case, this method
    /// returns 0.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100isize.wrapping_rem_euclid(10), 0);
    /// assert_eq(isize::MIN.wrapping_rem_euclid(-1), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem_euclid(self, rhs: isize) -> isize {
        if self == isize::MIN && rhs == -1 {
            0
        } else {
            self.rem_euclid(rhs)
        }
    }

    /// Reverses the order of bits in the integer. The least significant bit
    /// becomes the most significant bit, second least-significant bit becomes
    /// second most-significant bit, etc.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = (0x1234567890123456i64 as isize);
    /// let m = n.reverse_bits();
    ///
    /// assert_eq(m, 0x6a2c48091e6a2c48);
    /// assert_eq(0isize.reverse_bits(), 0);
    /// ```
    #[inline]
    pub fn reverse_bits(self) -> isize {
        let v = self as usize;
        let mut r: usize = 0;
        let mut i = 0u32;
        while i < 64 {
            r = (r << 1) | ((v >> i) & 1);
            i += 1;
        }
        r as isize
    }

    /// Converts `self` to big endian from the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = (0x1A as isize);
    ///
    /// assert_eq(n.to_be(), n.swap_bytes());
    /// ```
    #[inline]
    pub fn to_be(self) -> isize {
        self.swap_bytes()
    }

    /// Converts `self` to little endian from the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = (0x1A as isize);
    ///
    /// assert_eq(n.to_le(), n);
    /// ```
    #[inline]
    pub fn to_le(self) -> isize {
        self
    }

    /// Converts an integer from big endian to the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = (0x1A as isize);
    ///
    /// assert_eq(isize::from_be(n), n.swap_bytes());
    /// ```
    #[inline]
    pub fn from_be(x: isize) -> isize {
        x.swap_bytes()
    }

    /// Converts an integer from little endian to the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = (0x1A as isize);
    ///
    /// assert_eq(isize::from_le(n), n);
    /// ```
    #[inline]
    pub fn from_le(x: isize) -> isize {
        x
    }

    /// Returns the memory representation of this integer as a byte array in
    /// big-endian (network) byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = (0x1234567890123456i64 as isize).to_be_bytes();
    /// assert_eq(bytes, [0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56]);
    /// ```
    #[inline]
    pub fn to_be_bytes(self) -> [u8; 8] {
        self.swap_bytes().to_le_bytes()
    }

    /// Creates an integer value from its representation as a byte array in big
    /// endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = isize::from_be_bytes([0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56]);
    /// assert_eq(value, 0x1234567890123456);
    /// ```
    #[inline]
    pub fn from_be_bytes(bytes: [u8; 8]) -> isize {
        isize::from_le_bytes(bytes).swap_bytes()
    }

    /// Returns the memory representation of this integer as a byte array in
    /// native byte order.
    ///
    /// As the target platform's native endianness is used, portable code should
    /// use `to_be_bytes` or `to_le_bytes`, as appropriate, instead. (navi's
    /// targets are all little endian, so this is `to_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = (0x1234567890123456i64 as isize).to_ne_bytes();
    /// assert_eq(bytes, [0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12]);
    /// ```
    #[inline]
    pub fn to_ne_bytes(self) -> [u8; 8] {
        self.to_le_bytes()
    }

    /// Creates an integer value from its memory representation as a byte array
    /// in native endianness.
    ///
    /// As the target platform's native endianness is used, portable code likely
    /// wants to use `from_be_bytes` or `from_le_bytes`, as appropriate instead.
    /// (navi's targets are all little endian, so this is `from_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let value = isize::from_ne_bytes([0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12]);
    /// assert_eq(value, 0x1234567890123456);
    /// ```
    #[inline]
    pub fn from_ne_bytes(bytes: [u8; 8]) -> isize {
        isize::from_le_bytes(bytes)
    }

    /// Returns the number of leading ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-1isize).leading_ones(), 64);
    /// assert_eq(isize::MIN.leading_ones(), 1);
    /// assert_eq(1isize.leading_ones(), 0);
    /// ```
    #[inline]
    pub fn leading_ones(self) -> u32 {
        (!self).leading_zeros()
    }

    /// Returns the number of trailing ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3isize.trailing_ones(), 2);
    /// assert_eq((-1isize).trailing_ones(), 64);
    /// assert_eq(isize::MIN.trailing_ones(), 0);
    /// ```
    #[inline]
    pub fn trailing_ones(self) -> u32 {
        (!self).trailing_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is less than or equal to zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2isize.ilog2(), 1);
    /// assert_eq(isize::MAX.ilog2(), 62);
    /// ```
    #[track_caller]
    pub fn ilog2(self) -> u32 {
        if self <= 0 {
            panic("argument of integer logarithm must be positive");
        }
        64 - 1 - self.leading_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is negative or zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2isize.checked_ilog2(), Some(1));
    /// assert_eq(0isize.checked_ilog2(), None);
    /// ```
    #[inline]
    pub fn checked_ilog2(self) -> Option<u32> {
        if self <= 0 {
            None
        } else {
            Some(64 - 1 - self.leading_zeros())
        }
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is less than or equal to zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10isize.ilog10(), 1);
    /// assert_eq(99isize.ilog10(), 1);
    /// assert_eq(isize::MAX.ilog10(), 18);
    /// ```
    #[track_caller]
    pub fn ilog10(self) -> u32 {
        if self <= 0 {
            panic("argument of integer logarithm must be positive");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= 10 {
            v = v / 10;
            n += 1;
        }
        n
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is negative or zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10isize.checked_ilog10(), Some(1));
    /// assert_eq(0isize.checked_ilog10(), None);
    /// ```
    #[inline]
    pub fn checked_ilog10(self) -> Option<u32> {
        if self <= 0 { None } else { Some(self.ilog10()) }
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `ilog2` can produce results more efficiently for base 2, and `ilog10`
    /// can produce results more efficiently for base 10.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is less than or equal to zero, or if
    /// `base` is less than 2.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5isize.ilog(5), 1);
    /// assert_eq(100isize.ilog(3), 4);
    /// ```
    #[track_caller]
    pub fn ilog(self, base: isize) -> u32 {
        if self <= 0 {
            panic("argument of integer logarithm must be positive");
        }
        if base < 2 {
            panic("base of integer logarithm must be at least 2");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= base {
            v = v / base;
            n += 1;
        }
        n
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// Returns `None` if the number is negative or zero, or if the base is not
    /// at least 2.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `checked_ilog2` can produce results more efficiently for base 2, and
    /// `checked_ilog10` can produce results more efficiently for base 10.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5isize.checked_ilog(5), Some(1));
    /// assert_eq(0isize.checked_ilog(5), None);
    /// assert_eq(5isize.checked_ilog(1), None);
    /// ```
    #[inline]
    pub fn checked_ilog(self, base: isize) -> Option<u32> {
        if self <= 0 || base < 2 {
            None
        } else {
            Some(self.ilog(base))
        }
    }

    /// Returns the square root of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is negative.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10isize.isqrt(), 3);
    /// assert_eq(isize::MAX.isqrt(), 3037000499);
    /// ```
    #[track_caller]
    pub fn isqrt(self) -> isize {
        if self < 0 {
            panic("argument of integer square root cannot be negative");
        }
        if self < 2 {
            return self;
        }
        let mut x = (self as f64).sqrt() as isize;
        while x > self / x {
            x -= 1;
        }
        while x + 1 <= self / (x + 1) {
            x += 1;
        }
        x
    }

    /// Negates self, overflowing if this is equal to the minimum value.
    ///
    /// Returns a tuple of the negated version of self along with a boolean
    /// indicating whether an overflow happened. If `self` is the minimum value
    /// (`isize::MIN`), then the minimum value will be returned again and `true`
    /// will be returned for an overflow happening.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2isize.overflowing_neg(), (-2, false));
    /// assert_eq(isize::MIN.overflowing_neg(), (isize::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_neg(self) -> (isize, bool) {
        if self == isize::MIN {
            (self, true)
        } else {
            (-self, false)
        }
    }

    /// Checked absolute value. Computes `self.abs()`, returning `None` if `self
    /// == MIN`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-5isize).checked_abs(), Some(5));
    /// assert_eq(isize::MIN.checked_abs(), None);
    /// ```
    #[inline]
    pub fn checked_abs(self) -> Option<isize> {
        if self == isize::MIN {
            None
        } else {
            Some(self.abs())
        }
    }

    /// Computes the absolute value of `self`.
    ///
    /// Returns a tuple of the absolute version of self along with a boolean
    /// indicating whether an overflow happened. If self is the minimum value
    /// (`isize::MIN`), then the minimum value will be returned again and true
    /// will be returned for an overflow happening.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10isize.overflowing_abs(), (10, false));
    /// assert_eq((-10isize).overflowing_abs(), (10, false));
    /// assert_eq(isize::MIN.overflowing_abs(), (isize::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_abs(self) -> (isize, bool) {
        (self.wrapping_abs(), self == isize::MIN)
    }

    /// Saturating absolute value. Computes `self.abs()`, returning `MAX` if
    /// `self == MIN` instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100isize.saturating_abs(), 100);
    /// assert_eq((-100isize).saturating_abs(), 100);
    /// assert_eq(isize::MIN.saturating_abs(), isize::MAX);
    /// assert_eq((isize::MIN + 1).saturating_abs(), isize::MAX);
    /// ```
    #[inline]
    pub fn saturating_abs(self) -> isize {
        if self == isize::MIN {
            isize::MAX
        } else {
            self.abs()
        }
    }

    /// Saturating integer negation. Computes `-self`, returning `MAX` if `self
    /// == MIN` instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100isize.saturating_neg(), -100);
    /// assert_eq((-100isize).saturating_neg(), 100);
    /// assert_eq(isize::MIN.saturating_neg(), isize::MAX);
    /// assert_eq(isize::MAX.saturating_neg(), isize::MIN + 1);
    /// ```
    #[inline]
    pub fn saturating_neg(self) -> isize {
        if self == isize::MIN {
            isize::MAX
        } else {
            -self
        }
    }

    /// Computes the absolute difference between `self` and `other`.
    ///
    /// This function always returns the correct answer without overflow or
    /// panics by returning an unsigned integer.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100isize.abs_diff(80), 20usize);
    /// assert_eq(100isize.abs_diff(110), 10usize);
    /// assert_eq((-100isize).abs_diff(80), 180usize);
    /// assert_eq((-100isize).abs_diff(-120), 20usize);
    /// assert_eq(isize::MIN.abs_diff(isize::MAX), usize::MAX);
    /// ```
    #[inline]
    pub fn abs_diff(self, other: isize) -> usize {
        if self < other {
            (other as usize).wrapping_sub(self as usize)
        } else {
            (self as usize).wrapping_sub(other as usize)
        }
    }

    /// Calculates the quotient of Euclidean division of `self` by `rhs`.
    ///
    /// This computes the integer `q` such that `self = q * rhs + r`, with `r =
    /// self.rem_euclid(rhs)` and `0 <= r < abs(rhs)`.
    ///
    /// In other words, the result is `self / rhs` rounded to the integer `q`
    /// such that `self >= q * rhs`. If `self > 0`, this is equal to rounding
    /// towards zero (what `/` does); if `self < 0`, this is equal to rounding
    /// away from zero (towards +/- infinity). If `rhs > 0`, this is equal to
    /// rounding towards -infinity; if `rhs < 0`, this is equal to rounding
    /// towards +infinity.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero or if `self` is `MIN` and
    /// `rhs` is -1.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = 7isize;
    /// let b = 4;
    ///
    /// assert_eq(a.div_euclid(b), 1); // 7 >= 4 * 1
    /// assert_eq(a.div_euclid(-b), -1); // 7 >= -4 * -1
    /// assert_eq((-a).div_euclid(b), -2); // -7 >= 4 * -2
    /// assert_eq((-a).div_euclid(-b), 2); // -7 >= -4 * 2
    /// ```
    #[track_caller]
    pub fn div_euclid(self, rhs: isize) -> isize {
        let q = self / rhs;
        if self % rhs < 0 {
            if rhs > 0 { q - 1 } else { q + 1 }
        } else {
            q
        }
    }

    /// Calculates the least nonnegative remainder of `self (mod rhs)`.
    ///
    /// This is done as if by the Euclidean division algorithm -- given `r =
    /// self.rem_euclid(rhs)`, the result satisfies `self = rhs *
    /// self.div_euclid(rhs) + r` and `0 <= r < abs(rhs)`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero or if `self` is `MIN` and
    /// `rhs` is -1.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = 7isize;
    /// let b = 4;
    ///
    /// assert_eq(a.rem_euclid(b), 3);
    /// assert_eq((-a).rem_euclid(b), 1);
    /// assert_eq(a.rem_euclid(-b), 3);
    /// assert_eq((-a).rem_euclid(-b), 1);
    /// ```
    #[track_caller]
    pub fn rem_euclid(self, rhs: isize) -> isize {
        let r = self % rhs;
        if r < 0 {
            r.wrapping_add(rhs.wrapping_abs())
        } else {
            r
        }
    }

    /// Returns the square root of the number, rounded down.
    ///
    /// Returns `None` if `self` is negative.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10isize.checked_isqrt(), Some(3));
    /// assert_eq((-1isize).checked_isqrt(), None);
    /// ```
    #[inline]
    pub fn checked_isqrt(self) -> Option<isize> {
        if self < 0 { None } else { Some(self.isqrt()) }
    }

    /// Reverses the byte order of the integer.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = (0x1234567890123456i64 as isize);
    /// let m = n.swap_bytes();
    ///
    /// assert_eq(m, 0x5634129078563412);
    /// ```
    #[inline]
    pub fn swap_bytes(self) -> isize {
        let v = self as usize;
        let mut r: usize = 0;
        let mut i = 0u32;
        while i < 8 {
            r = (r << 8) | ((v >> (8 * i)) & 255);
            i += 1;
        }
        r as isize
    }
}

impl u8 {
    /// Checked negation. Computes `-self`, returning `None` unless `self == 0`.
    ///
    /// Note that negating any positive integer will overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u8.checked_neg(), Some(0));
    /// assert_eq(1u8.checked_neg(), None);
    /// ```
    #[inline]
    pub fn checked_neg(self) -> Option<u8> {
        let (r, o) = self.overflowing_neg();
        if o { None } else { Some(r) }
    }

    /// Checked exponentiation. Computes `self.pow(exp)`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(8u8.checked_pow(2), Some(64));
    /// assert_eq(u8::MAX.checked_pow(2), None);
    /// ```
    pub fn checked_pow(self, exp: u32) -> Option<u8> {
        if exp == 0 {
            return Some(1);
        }
        let mut base = self;
        let mut acc: u8 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc.checked_mul(base)?;
                if e == 1 {
                    return Some(acc);
                }
            }
            e = e / 2;
            base = base.checked_mul(base)?;
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// Returns a tuple of the exponentiation along with a bool indicating
    /// whether an overflow happened.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3u8.overflowing_pow(4), (81, false));
    /// assert_eq(u8::MAX.overflowing_pow(2), (1, true));
    /// ```
    pub fn overflowing_pow(self, exp: u32) -> (u8, bool) {
        if exp == 0 {
            return (1, false);
        }
        let mut base = self;
        let mut acc: u8 = 1;
        let mut e = exp;
        let mut over = false;
        loop {
            if e & 1 == 1 {
                let (r, o) = acc.overflowing_mul(base);
                acc = r;
                over = over || o;
                if e == 1 {
                    return (acc, over);
                }
            }
            e = e / 2;
            let (b, o) = base.overflowing_mul(base);
            base = b;
            over = over || o;
        }
    }

    /// Saturating integer exponentiation. Computes `self.pow(exp)`, saturating
    /// at the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(4u8.saturating_pow(3), 64);
    /// assert_eq(u8::MAX.saturating_pow(2), u8::MAX);
    /// ```
    #[inline]
    pub fn saturating_pow(self, exp: u32) -> u8 {
        match self.checked_pow(exp) {
            Some(r) => r,
            None => {
                if false {
                    u8::MIN
                } else {
                    u8::MAX
                }
            }
        }
    }

    /// Checked shift left. Computes `self << rhs`, returning `None` if `rhs` is
    /// larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1u8.checked_shl(4), Some(0x10));
    /// assert_eq(0x1u8.checked_shl(8), None);
    /// assert_eq(0x10u8.checked_shl(7), Some(0));
    /// ```
    #[inline]
    pub fn checked_shl(self, rhs: u32) -> Option<u8> {
        if rhs < 8 { Some(self << rhs) } else { None }
    }

    /// Checked shift right. Computes `self >> rhs`, returning `None` if `rhs`
    /// is larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10u8.checked_shr(4), Some(0x1));
    /// assert_eq(0x10u8.checked_shr(8), None);
    /// ```
    #[inline]
    pub fn checked_shr(self, rhs: u32) -> Option<u8> {
        if rhs < 8 { Some(self >> rhs) } else { None }
    }

    /// Panic-free bitwise shift-left; yields `self << mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-left; the RHS of a wrapping
    /// shift-left is restricted to the range of the type, rather than the bits
    /// shifted out of the LHS being returned to the other end. The primitive
    /// integer types all implement a `rotate_left` function, which may be what
    /// you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(1u8.wrapping_shl(7), 128);
    /// assert_eq(1u8.wrapping_shl(128), 1);
    /// ```
    #[inline]
    pub fn wrapping_shl(self, rhs: u32) -> u8 {
        self << (rhs % 8)
    }

    /// Panic-free bitwise shift-right; yields `self >> mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-right; the RHS of a
    /// wrapping shift-right is restricted to the range of the type, rather than
    /// the bits shifted out of the LHS being returned to the other end. The
    /// primitive integer types all implement a `rotate_right` function, which
    /// may be what you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(128u8.wrapping_shr(7), 1);
    /// assert_eq(128u8.wrapping_shr(128), 128);
    /// ```
    #[inline]
    pub fn wrapping_shr(self, rhs: u32) -> u8 {
        self >> (rhs % 8)
    }

    /// Shifts self left by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1u8.overflowing_shl(4), (0x10, false));
    /// assert_eq(0x1u8.overflowing_shl(12), (0x10, true));
    /// assert_eq(0x10u8.overflowing_shl(7), (0, false));
    /// ```
    #[inline]
    pub fn overflowing_shl(self, rhs: u32) -> (u8, bool) {
        (self.wrapping_shl(rhs), rhs >= 8)
    }

    /// Shifts self right by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10u8.overflowing_shr(4), (0x1, false));
    /// assert_eq(0x10u8.overflowing_shr(12), (0x1, true));
    /// ```
    #[inline]
    pub fn overflowing_shr(self, rhs: u32) -> (u8, bool) {
        (self.wrapping_shr(rhs), rhs >= 8)
    }

    /// Wrapping (modular) division. Computes `self / rhs`.
    ///
    /// Wrapped division on unsigned types is just normal division. There's no
    /// way wrapping could ever happen. This function exists so that all
    /// operations are accounted for in the wrapping operations.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u8.wrapping_div(10), 10);
    /// ```
    #[inline]
    pub fn wrapping_div(self, rhs: u8) -> u8 {
        if false { self } else { self / rhs }
    }

    /// Wrapping (modular) remainder. Computes `self % rhs`.
    ///
    /// Wrapped remainder calculation on unsigned types is just the regular
    /// remainder calculation. There's no way wrapping could ever happen. This
    /// function exists so that all operations are accounted for in the wrapping
    /// operations.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u8.wrapping_rem(10), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem(self, rhs: u8) -> u8 {
        if false { 0 } else { self % rhs }
    }

    /// Calculates the divisor when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the divisor along with a boolean indicating whether
    /// an arithmetic overflow would occur. Note that for unsigned integers
    /// overflow never occurs, so the second value is always `false`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u8.overflowing_div(2), (2, false));
    /// ```
    #[inline]
    pub fn overflowing_div(self, rhs: u8) -> (u8, bool) {
        if false {
            (self, true)
        } else {
            (self / rhs, false)
        }
    }

    /// Calculates the remainder when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the remainder along with a boolean indicating whether
    /// an arithmetic overflow would occur. Note that for unsigned integers
    /// overflow never occurs, so the second value is always `false`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u8.overflowing_rem(2), (1, false));
    /// ```
    #[inline]
    pub fn overflowing_rem(self, rhs: u8) -> (u8, bool) {
        if false {
            (0, true)
        } else {
            (self % rhs, false)
        }
    }

    /// Saturating integer division. Computes `self / rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u8.saturating_div(2), 2);
    /// ```
    #[inline]
    pub fn saturating_div(self, rhs: u8) -> u8 {
        if false { u8::MAX } else { self / rhs }
    }

    /// Checked Euclidean division. Computes `self.div_euclid(rhs)`, returning
    /// `None` if `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(128u8.checked_div_euclid(2), Some(64));
    /// assert_eq(1u8.checked_div_euclid(0), None);
    /// ```
    #[inline]
    pub fn checked_div_euclid(self, rhs: u8) -> Option<u8> {
        if rhs == 0 || false {
            None
        } else {
            Some(self.div_euclid(rhs))
        }
    }

    /// Checked Euclidean modulo. Computes `self.rem_euclid(rhs)`, returning
    /// `None` if `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u8.checked_rem_euclid(2), Some(1));
    /// assert_eq(5u8.checked_rem_euclid(0), None);
    /// ```
    #[inline]
    pub fn checked_rem_euclid(self, rhs: u8) -> Option<u8> {
        if rhs == 0 || false {
            None
        } else {
            Some(self.rem_euclid(rhs))
        }
    }

    /// Wrapping Euclidean division. Computes `self.div_euclid(rhs)`.
    ///
    /// Wrapped division on unsigned types is just normal division. There's no
    /// way wrapping could ever happen. This function exists so that all
    /// operations are accounted for in the wrapping operations. Since, for the
    /// positive integers, all common definitions of division are equal, this is
    /// exactly equal to `self.wrapping_div(rhs)`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u8.wrapping_div_euclid(10), 10);
    /// ```
    #[inline]
    pub fn wrapping_div_euclid(self, rhs: u8) -> u8 {
        if false { self } else { self.div_euclid(rhs) }
    }

    /// Wrapping Euclidean modulo. Computes `self.rem_euclid(rhs)`.
    ///
    /// Wrapped modulo calculation on unsigned types is just the regular
    /// remainder calculation. There's no way wrapping could ever happen. This
    /// function exists so that all operations are accounted for in the wrapping
    /// operations. Since, for the positive integers, all common definitions of
    /// division are equal, this is exactly equal to `self.wrapping_rem(rhs)`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u8.wrapping_rem_euclid(10), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem_euclid(self, rhs: u8) -> u8 {
        if false { 0 } else { self.rem_euclid(rhs) }
    }

    /// Reverses the order of bits in the integer. The least significant bit
    /// becomes the most significant bit, second least-significant bit becomes
    /// second most-significant bit, etc.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x12u8;
    /// let m = n.reverse_bits();
    ///
    /// assert_eq(m, 0x48);
    /// assert_eq(0u8.reverse_bits(), 0);
    /// ```
    #[inline]
    pub fn reverse_bits(self) -> u8 {
        let v = self;
        let mut r: u8 = 0;
        let mut i = 0u32;
        while i < 8 {
            r = (r << 1) | ((v >> i) & 1);
            i += 1;
        }
        r
    }

    /// Converts `self` to big endian from the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au8;
    ///
    /// assert_eq(n.to_be(), n.swap_bytes());
    /// ```
    #[inline]
    pub fn to_be(self) -> u8 {
        self.swap_bytes()
    }

    /// Converts `self` to little endian from the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au8;
    ///
    /// assert_eq(n.to_le(), n);
    /// ```
    #[inline]
    pub fn to_le(self) -> u8 {
        self
    }

    /// Converts an integer from big endian to the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au8;
    ///
    /// assert_eq(u8::from_be(n), n.swap_bytes());
    /// ```
    #[inline]
    pub fn from_be(x: u8) -> u8 {
        x.swap_bytes()
    }

    /// Converts an integer from little endian to the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au8;
    ///
    /// assert_eq(u8::from_le(n), n);
    /// ```
    #[inline]
    pub fn from_le(x: u8) -> u8 {
        x
    }

    /// Returns the memory representation of this integer as a byte array in
    /// big-endian (network) byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x12u8.to_be_bytes();
    /// assert_eq(bytes, [0x12]);
    /// ```
    #[inline]
    pub fn to_be_bytes(self) -> [u8; 1] {
        self.swap_bytes().to_le_bytes()
    }

    /// Creates an integer value from its representation as a byte array in big
    /// endian.
    ///
    /// # Examples
    ///
    /// The example is not run: this method of the 8-bit types panics today
    /// ("attempt to shift with overflow"), a known bug.
    ///
    /// ```ignore
    /// let value = u8::from_be_bytes([0x12]);
    /// assert_eq(value, 0x12);
    /// ```
    #[inline]
    pub fn from_be_bytes(bytes: [u8; 1]) -> u8 {
        u8::from_le_bytes(bytes).swap_bytes()
    }

    /// Returns the memory representation of this integer as a byte array in
    /// native byte order.
    ///
    /// As the target platform's native endianness is used, portable code should
    /// use `to_be_bytes` or `to_le_bytes`, as appropriate, instead. (navi's
    /// targets are all little endian, so this is `to_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x12u8.to_ne_bytes();
    /// assert_eq(bytes, [0x12]);
    /// ```
    #[inline]
    pub fn to_ne_bytes(self) -> [u8; 1] {
        self.to_le_bytes()
    }

    /// Creates an integer value from its memory representation as a byte array
    /// in native endianness.
    ///
    /// As the target platform's native endianness is used, portable code likely
    /// wants to use `from_be_bytes` or `from_le_bytes`, as appropriate instead.
    /// (navi's targets are all little endian, so this is `from_le_bytes`.)
    ///
    /// # Examples
    ///
    /// The example is not run: this method of the 8-bit types panics today
    /// ("attempt to shift with overflow"), a known bug.
    ///
    /// ```ignore
    /// let value = u8::from_ne_bytes([0x12]);
    /// assert_eq(value, 0x12);
    /// ```
    #[inline]
    pub fn from_ne_bytes(bytes: [u8; 1]) -> u8 {
        u8::from_le_bytes(bytes)
    }

    /// Returns the number of leading ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = !(u8::MAX >> 2);
    /// assert_eq(n.leading_ones(), 2);
    ///
    /// assert_eq(0u8.leading_ones(), 0);
    /// assert_eq(u8::MAX.leading_ones(), 8);
    /// ```
    #[inline]
    pub fn leading_ones(self) -> u32 {
        (!self).leading_zeros()
    }

    /// Returns the number of trailing ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b1010111u8;
    /// assert_eq(n.trailing_ones(), 3);
    ///
    /// assert_eq(0u8.trailing_ones(), 0);
    /// assert_eq(u8::MAX.trailing_ones(), 8);
    /// ```
    #[inline]
    pub fn trailing_ones(self) -> u32 {
        (!self).trailing_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u8.ilog2(), 1);
    /// assert_eq(u8::MAX.ilog2(), 7);
    /// ```
    #[track_caller]
    pub fn ilog2(self) -> u32 {
        if self == 0 {
            panic("argument of integer logarithm must be positive");
        }
        8 - 1 - self.leading_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u8.checked_ilog2(), Some(1));
    /// assert_eq(0u8.checked_ilog2(), None);
    /// ```
    #[inline]
    pub fn checked_ilog2(self) -> Option<u32> {
        if self == 0 {
            None
        } else {
            Some(8 - 1 - self.leading_zeros())
        }
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u8.ilog10(), 1);
    /// assert_eq(99u8.ilog10(), 1);
    /// assert_eq(u8::MAX.ilog10(), 2);
    /// ```
    #[track_caller]
    pub fn ilog10(self) -> u32 {
        if self == 0 {
            panic("argument of integer logarithm must be positive");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= 10 {
            v = v / 10;
            n += 1;
        }
        n
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u8.checked_ilog10(), Some(1));
    /// assert_eq(0u8.checked_ilog10(), None);
    /// ```
    #[inline]
    pub fn checked_ilog10(self) -> Option<u32> {
        if self == 0 { None } else { Some(self.ilog10()) }
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `ilog2` can produce results more efficiently for base 2, and `ilog10`
    /// can produce results more efficiently for base 10.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is zero, or if `base` is less than 2.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u8.ilog(5), 1);
    /// assert_eq(100u8.ilog(3), 4);
    /// ```
    #[track_caller]
    pub fn ilog(self, base: u8) -> u32 {
        if self == 0 {
            panic("argument of integer logarithm must be positive");
        }
        if base < 2 {
            panic("base of integer logarithm must be at least 2");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= base {
            v = v / base;
            n += 1;
        }
        n
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// Returns `None` if the number is zero, or if the base is not at least 2.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `checked_ilog2` can produce results more efficiently for base 2, and
    /// `checked_ilog10` can produce results more efficiently for base 10.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u8.checked_ilog(5), Some(1));
    /// assert_eq(0u8.checked_ilog(5), None);
    /// assert_eq(5u8.checked_ilog(1), None);
    /// ```
    #[inline]
    pub fn checked_ilog(self, base: u8) -> Option<u32> {
        if self == 0 || base < 2 {
            None
        } else {
            Some(self.ilog(base))
        }
    }

    /// Returns the square root of the number, rounded down.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u8.isqrt(), 3);
    /// assert_eq(u8::MAX.isqrt(), 15);
    /// ```
    #[track_caller]
    pub fn isqrt(self) -> u8 {
        if self < 2 {
            return self;
        }
        let mut x = (self as f64).sqrt() as u8;
        while x > self / x {
            x -= 1;
        }
        while x + 1 <= self / (x + 1) {
            x += 1;
        }
        x
    }

    /// Negates self in a wrapping fashion.
    ///
    /// Returns `!self + 1` using wrapping operations to return the value that
    /// represents the negation of this unsigned value. Note that for positive
    /// unsigned values overflow always occurs, but negating 0 does not
    /// overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u8.overflowing_neg(), (0, false));
    /// assert_eq(2u8.overflowing_neg(), (u8::MAX - 1, true));
    /// ```
    #[inline]
    pub fn overflowing_neg(self) -> (u8, bool) {
        (self.wrapping_neg(), self != 0)
    }

    /// Performs Euclidean division.
    ///
    /// Since, for the positive integers, all common definitions of division are
    /// equal, this is exactly equal to `self / rhs`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(7u8.div_euclid(4), 1);
    /// ```
    #[track_caller]
    pub fn div_euclid(self, rhs: u8) -> u8 {
        self / rhs
    }

    /// Calculates the least remainder of `self (mod rhs)`.
    ///
    /// Since, for the positive integers, all common definitions of division are
    /// equal, this is exactly equal to `self % rhs`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(7u8.rem_euclid(4), 3);
    /// ```
    #[track_caller]
    pub fn rem_euclid(self, rhs: u8) -> u8 {
        self % rhs
    }

    /// Returns the smallest power of two greater than or equal to `self`. If
    /// the next power of two is greater than the type's maximum value, `None`
    /// is returned, otherwise the power of two is wrapped in `Some`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u8.checked_next_power_of_two(), Some(2));
    /// assert_eq(3u8.checked_next_power_of_two(), Some(4));
    /// assert_eq(u8::MAX.checked_next_power_of_two(), None);
    /// ```
    #[inline]
    pub fn checked_next_power_of_two(self) -> Option<u8> {
        if self <= 1 {
            return Some(1);
        }
        let p = 8 - (self - 1).leading_zeros();
        if p >= 8 { None } else { Some((1 as u8) << p) }
    }

    /// Calculates the quotient of `self` and `rhs`, rounding the result towards
    /// positive infinity.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(7u8.div_ceil(4), 2);
    /// assert_eq(8u8.div_ceil(4), 2);
    /// ```
    #[track_caller]
    pub fn div_ceil(self, rhs: u8) -> u8 {
        let q = self / rhs;
        if self % rhs > 0 { q + 1 } else { q }
    }

    /// Calculates the smallest value greater than or equal to `self` that is a
    /// multiple of `rhs`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero, or if the result overflows
    /// (navi checks integer overflow in every build; Rust only in debug
    /// builds).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(16u8.next_multiple_of(8), 16);
    /// assert_eq(23u8.next_multiple_of(8), 24);
    /// ```
    #[track_caller]
    pub fn next_multiple_of(self, rhs: u8) -> u8 {
        let r = self % rhs;
        if r == 0 { self } else { self + (rhs - r) }
    }

    /// Calculates the smallest value greater than or equal to `self` that is a
    /// multiple of `rhs`. Returns `None` if `rhs` is zero or the operation
    /// would result in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(16u8.checked_next_multiple_of(8), Some(16));
    /// assert_eq(23u8.checked_next_multiple_of(8), Some(24));
    /// assert_eq(1u8.checked_next_multiple_of(0), None);
    /// assert_eq(u8::MAX.checked_next_multiple_of(2), None);
    /// ```
    #[inline]
    pub fn checked_next_multiple_of(self, rhs: u8) -> Option<u8> {
        if rhs == 0 {
            return None;
        }
        let r = self % rhs;
        if r == 0 {
            Some(self)
        } else {
            self.checked_add(rhs - r)
        }
    }

    /// Returns `true` if `self` is an integer multiple of `rhs`, and false
    /// otherwise.
    ///
    /// This function is equivalent to `self % rhs == 0`, except that it will
    /// not panic for `rhs == 0`. Instead, `0.is_multiple_of(0) == true`, and
    /// for any non-zero `n`, `n.is_multiple_of(0) == false`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(6u8.is_multiple_of(2));
    /// assert(!5u8.is_multiple_of(2));
    ///
    /// assert(0u8.is_multiple_of(0));
    /// assert(!6u8.is_multiple_of(0));
    /// ```
    #[inline]
    pub fn is_multiple_of(self, rhs: u8) -> bool {
        if rhs == 0 { self == 0 } else { self % rhs == 0 }
    }

    /// Reverses the byte order of the integer.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x12u8;
    /// let m = n.swap_bytes();
    ///
    /// assert_eq(m, 0x12);
    /// ```
    #[inline]
    pub fn swap_bytes(self) -> u8 {
        self
    }
}

impl u16 {
    /// Checked negation. Computes `-self`, returning `None` unless `self == 0`.
    ///
    /// Note that negating any positive integer will overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u16.checked_neg(), Some(0));
    /// assert_eq(1u16.checked_neg(), None);
    /// ```
    #[inline]
    pub fn checked_neg(self) -> Option<u16> {
        let (r, o) = self.overflowing_neg();
        if o { None } else { Some(r) }
    }

    /// Checked exponentiation. Computes `self.pow(exp)`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(8u16.checked_pow(2), Some(64));
    /// assert_eq(u16::MAX.checked_pow(2), None);
    /// ```
    pub fn checked_pow(self, exp: u32) -> Option<u16> {
        if exp == 0 {
            return Some(1);
        }
        let mut base = self;
        let mut acc: u16 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc.checked_mul(base)?;
                if e == 1 {
                    return Some(acc);
                }
            }
            e = e / 2;
            base = base.checked_mul(base)?;
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// Returns a tuple of the exponentiation along with a bool indicating
    /// whether an overflow happened.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3u16.overflowing_pow(4), (81, false));
    /// assert_eq(u16::MAX.overflowing_pow(2), (1, true));
    /// ```
    pub fn overflowing_pow(self, exp: u32) -> (u16, bool) {
        if exp == 0 {
            return (1, false);
        }
        let mut base = self;
        let mut acc: u16 = 1;
        let mut e = exp;
        let mut over = false;
        loop {
            if e & 1 == 1 {
                let (r, o) = acc.overflowing_mul(base);
                acc = r;
                over = over || o;
                if e == 1 {
                    return (acc, over);
                }
            }
            e = e / 2;
            let (b, o) = base.overflowing_mul(base);
            base = b;
            over = over || o;
        }
    }

    /// Saturating integer exponentiation. Computes `self.pow(exp)`, saturating
    /// at the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(4u16.saturating_pow(3), 64);
    /// assert_eq(u16::MAX.saturating_pow(2), u16::MAX);
    /// ```
    #[inline]
    pub fn saturating_pow(self, exp: u32) -> u16 {
        match self.checked_pow(exp) {
            Some(r) => r,
            None => {
                if false {
                    u16::MIN
                } else {
                    u16::MAX
                }
            }
        }
    }

    /// Checked shift left. Computes `self << rhs`, returning `None` if `rhs` is
    /// larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1u16.checked_shl(4), Some(0x10));
    /// assert_eq(0x1u16.checked_shl(16), None);
    /// assert_eq(0x10u16.checked_shl(15), Some(0));
    /// ```
    #[inline]
    pub fn checked_shl(self, rhs: u32) -> Option<u16> {
        if rhs < 16 { Some(self << rhs) } else { None }
    }

    /// Checked shift right. Computes `self >> rhs`, returning `None` if `rhs`
    /// is larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10u16.checked_shr(4), Some(0x1));
    /// assert_eq(0x10u16.checked_shr(16), None);
    /// ```
    #[inline]
    pub fn checked_shr(self, rhs: u32) -> Option<u16> {
        if rhs < 16 { Some(self >> rhs) } else { None }
    }

    /// Panic-free bitwise shift-left; yields `self << mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-left; the RHS of a wrapping
    /// shift-left is restricted to the range of the type, rather than the bits
    /// shifted out of the LHS being returned to the other end. The primitive
    /// integer types all implement a `rotate_left` function, which may be what
    /// you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(1u16.wrapping_shl(7), 128);
    /// assert_eq(1u16.wrapping_shl(128), 1);
    /// ```
    #[inline]
    pub fn wrapping_shl(self, rhs: u32) -> u16 {
        self << (rhs % 16)
    }

    /// Panic-free bitwise shift-right; yields `self >> mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-right; the RHS of a
    /// wrapping shift-right is restricted to the range of the type, rather than
    /// the bits shifted out of the LHS being returned to the other end. The
    /// primitive integer types all implement a `rotate_right` function, which
    /// may be what you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(128u16.wrapping_shr(7), 1);
    /// assert_eq(128u16.wrapping_shr(128), 128);
    /// ```
    #[inline]
    pub fn wrapping_shr(self, rhs: u32) -> u16 {
        self >> (rhs % 16)
    }

    /// Shifts self left by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1u16.overflowing_shl(4), (0x10, false));
    /// assert_eq(0x1u16.overflowing_shl(20), (0x10, true));
    /// assert_eq(0x10u16.overflowing_shl(15), (0, false));
    /// ```
    #[inline]
    pub fn overflowing_shl(self, rhs: u32) -> (u16, bool) {
        (self.wrapping_shl(rhs), rhs >= 16)
    }

    /// Shifts self right by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10u16.overflowing_shr(4), (0x1, false));
    /// assert_eq(0x10u16.overflowing_shr(20), (0x1, true));
    /// ```
    #[inline]
    pub fn overflowing_shr(self, rhs: u32) -> (u16, bool) {
        (self.wrapping_shr(rhs), rhs >= 16)
    }

    /// Wrapping (modular) division. Computes `self / rhs`.
    ///
    /// Wrapped division on unsigned types is just normal division. There's no
    /// way wrapping could ever happen. This function exists so that all
    /// operations are accounted for in the wrapping operations.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u16.wrapping_div(10), 10);
    /// ```
    #[inline]
    pub fn wrapping_div(self, rhs: u16) -> u16 {
        if false { self } else { self / rhs }
    }

    /// Wrapping (modular) remainder. Computes `self % rhs`.
    ///
    /// Wrapped remainder calculation on unsigned types is just the regular
    /// remainder calculation. There's no way wrapping could ever happen. This
    /// function exists so that all operations are accounted for in the wrapping
    /// operations.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u16.wrapping_rem(10), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem(self, rhs: u16) -> u16 {
        if false { 0 } else { self % rhs }
    }

    /// Calculates the divisor when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the divisor along with a boolean indicating whether
    /// an arithmetic overflow would occur. Note that for unsigned integers
    /// overflow never occurs, so the second value is always `false`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u16.overflowing_div(2), (2, false));
    /// ```
    #[inline]
    pub fn overflowing_div(self, rhs: u16) -> (u16, bool) {
        if false {
            (self, true)
        } else {
            (self / rhs, false)
        }
    }

    /// Calculates the remainder when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the remainder along with a boolean indicating whether
    /// an arithmetic overflow would occur. Note that for unsigned integers
    /// overflow never occurs, so the second value is always `false`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u16.overflowing_rem(2), (1, false));
    /// ```
    #[inline]
    pub fn overflowing_rem(self, rhs: u16) -> (u16, bool) {
        if false {
            (0, true)
        } else {
            (self % rhs, false)
        }
    }

    /// Saturating integer division. Computes `self / rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u16.saturating_div(2), 2);
    /// ```
    #[inline]
    pub fn saturating_div(self, rhs: u16) -> u16 {
        if false { u16::MAX } else { self / rhs }
    }

    /// Checked Euclidean division. Computes `self.div_euclid(rhs)`, returning
    /// `None` if `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(128u16.checked_div_euclid(2), Some(64));
    /// assert_eq(1u16.checked_div_euclid(0), None);
    /// ```
    #[inline]
    pub fn checked_div_euclid(self, rhs: u16) -> Option<u16> {
        if rhs == 0 || false {
            None
        } else {
            Some(self.div_euclid(rhs))
        }
    }

    /// Checked Euclidean modulo. Computes `self.rem_euclid(rhs)`, returning
    /// `None` if `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u16.checked_rem_euclid(2), Some(1));
    /// assert_eq(5u16.checked_rem_euclid(0), None);
    /// ```
    #[inline]
    pub fn checked_rem_euclid(self, rhs: u16) -> Option<u16> {
        if rhs == 0 || false {
            None
        } else {
            Some(self.rem_euclid(rhs))
        }
    }

    /// Wrapping Euclidean division. Computes `self.div_euclid(rhs)`.
    ///
    /// Wrapped division on unsigned types is just normal division. There's no
    /// way wrapping could ever happen. This function exists so that all
    /// operations are accounted for in the wrapping operations. Since, for the
    /// positive integers, all common definitions of division are equal, this is
    /// exactly equal to `self.wrapping_div(rhs)`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u16.wrapping_div_euclid(10), 10);
    /// ```
    #[inline]
    pub fn wrapping_div_euclid(self, rhs: u16) -> u16 {
        if false { self } else { self.div_euclid(rhs) }
    }

    /// Wrapping Euclidean modulo. Computes `self.rem_euclid(rhs)`.
    ///
    /// Wrapped modulo calculation on unsigned types is just the regular
    /// remainder calculation. There's no way wrapping could ever happen. This
    /// function exists so that all operations are accounted for in the wrapping
    /// operations. Since, for the positive integers, all common definitions of
    /// division are equal, this is exactly equal to `self.wrapping_rem(rhs)`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u16.wrapping_rem_euclid(10), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem_euclid(self, rhs: u16) -> u16 {
        if false { 0 } else { self.rem_euclid(rhs) }
    }

    /// Reverses the order of bits in the integer. The least significant bit
    /// becomes the most significant bit, second least-significant bit becomes
    /// second most-significant bit, etc.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1234u16;
    /// let m = n.reverse_bits();
    ///
    /// assert_eq(m, 0x2c48);
    /// assert_eq(0u16.reverse_bits(), 0);
    /// ```
    #[inline]
    pub fn reverse_bits(self) -> u16 {
        let v = self;
        let mut r: u16 = 0;
        let mut i = 0u32;
        while i < 16 {
            r = (r << 1) | ((v >> i) & 1);
            i += 1;
        }
        r
    }

    /// Converts `self` to big endian from the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au16;
    ///
    /// assert_eq(n.to_be(), n.swap_bytes());
    /// ```
    #[inline]
    pub fn to_be(self) -> u16 {
        self.swap_bytes()
    }

    /// Converts `self` to little endian from the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au16;
    ///
    /// assert_eq(n.to_le(), n);
    /// ```
    #[inline]
    pub fn to_le(self) -> u16 {
        self
    }

    /// Converts an integer from big endian to the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au16;
    ///
    /// assert_eq(u16::from_be(n), n.swap_bytes());
    /// ```
    #[inline]
    pub fn from_be(x: u16) -> u16 {
        x.swap_bytes()
    }

    /// Converts an integer from little endian to the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au16;
    ///
    /// assert_eq(u16::from_le(n), n);
    /// ```
    #[inline]
    pub fn from_le(x: u16) -> u16 {
        x
    }

    /// Returns the memory representation of this integer as a byte array in
    /// big-endian (network) byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x1234u16.to_be_bytes();
    /// assert_eq(bytes, [0x12, 0x34]);
    /// ```
    #[inline]
    pub fn to_be_bytes(self) -> [u8; 2] {
        self.swap_bytes().to_le_bytes()
    }

    /// Creates an integer value from its representation as a byte array in big
    /// endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = u16::from_be_bytes([0x12, 0x34]);
    /// assert_eq(value, 0x1234);
    /// ```
    #[inline]
    pub fn from_be_bytes(bytes: [u8; 2]) -> u16 {
        u16::from_le_bytes(bytes).swap_bytes()
    }

    /// Returns the memory representation of this integer as a byte array in
    /// native byte order.
    ///
    /// As the target platform's native endianness is used, portable code should
    /// use `to_be_bytes` or `to_le_bytes`, as appropriate, instead. (navi's
    /// targets are all little endian, so this is `to_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x1234u16.to_ne_bytes();
    /// assert_eq(bytes, [0x34, 0x12]);
    /// ```
    #[inline]
    pub fn to_ne_bytes(self) -> [u8; 2] {
        self.to_le_bytes()
    }

    /// Creates an integer value from its memory representation as a byte array
    /// in native endianness.
    ///
    /// As the target platform's native endianness is used, portable code likely
    /// wants to use `from_be_bytes` or `from_le_bytes`, as appropriate instead.
    /// (navi's targets are all little endian, so this is `from_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let value = u16::from_ne_bytes([0x34, 0x12]);
    /// assert_eq(value, 0x1234);
    /// ```
    #[inline]
    pub fn from_ne_bytes(bytes: [u8; 2]) -> u16 {
        u16::from_le_bytes(bytes)
    }

    /// Returns the number of leading ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = !(u16::MAX >> 2);
    /// assert_eq(n.leading_ones(), 2);
    ///
    /// assert_eq(0u16.leading_ones(), 0);
    /// assert_eq(u16::MAX.leading_ones(), 16);
    /// ```
    #[inline]
    pub fn leading_ones(self) -> u32 {
        (!self).leading_zeros()
    }

    /// Returns the number of trailing ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b1010111u16;
    /// assert_eq(n.trailing_ones(), 3);
    ///
    /// assert_eq(0u16.trailing_ones(), 0);
    /// assert_eq(u16::MAX.trailing_ones(), 16);
    /// ```
    #[inline]
    pub fn trailing_ones(self) -> u32 {
        (!self).trailing_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u16.ilog2(), 1);
    /// assert_eq(u16::MAX.ilog2(), 15);
    /// ```
    #[track_caller]
    pub fn ilog2(self) -> u32 {
        if self == 0 {
            panic("argument of integer logarithm must be positive");
        }
        16 - 1 - self.leading_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u16.checked_ilog2(), Some(1));
    /// assert_eq(0u16.checked_ilog2(), None);
    /// ```
    #[inline]
    pub fn checked_ilog2(self) -> Option<u32> {
        if self == 0 {
            None
        } else {
            Some(16 - 1 - self.leading_zeros())
        }
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u16.ilog10(), 1);
    /// assert_eq(99u16.ilog10(), 1);
    /// assert_eq(u16::MAX.ilog10(), 4);
    /// ```
    #[track_caller]
    pub fn ilog10(self) -> u32 {
        if self == 0 {
            panic("argument of integer logarithm must be positive");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= 10 {
            v = v / 10;
            n += 1;
        }
        n
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u16.checked_ilog10(), Some(1));
    /// assert_eq(0u16.checked_ilog10(), None);
    /// ```
    #[inline]
    pub fn checked_ilog10(self) -> Option<u32> {
        if self == 0 { None } else { Some(self.ilog10()) }
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `ilog2` can produce results more efficiently for base 2, and `ilog10`
    /// can produce results more efficiently for base 10.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is zero, or if `base` is less than 2.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u16.ilog(5), 1);
    /// assert_eq(100u16.ilog(3), 4);
    /// ```
    #[track_caller]
    pub fn ilog(self, base: u16) -> u32 {
        if self == 0 {
            panic("argument of integer logarithm must be positive");
        }
        if base < 2 {
            panic("base of integer logarithm must be at least 2");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= base {
            v = v / base;
            n += 1;
        }
        n
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// Returns `None` if the number is zero, or if the base is not at least 2.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `checked_ilog2` can produce results more efficiently for base 2, and
    /// `checked_ilog10` can produce results more efficiently for base 10.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u16.checked_ilog(5), Some(1));
    /// assert_eq(0u16.checked_ilog(5), None);
    /// assert_eq(5u16.checked_ilog(1), None);
    /// ```
    #[inline]
    pub fn checked_ilog(self, base: u16) -> Option<u32> {
        if self == 0 || base < 2 {
            None
        } else {
            Some(self.ilog(base))
        }
    }

    /// Returns the square root of the number, rounded down.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u16.isqrt(), 3);
    /// assert_eq(u16::MAX.isqrt(), 255);
    /// ```
    #[track_caller]
    pub fn isqrt(self) -> u16 {
        if self < 2 {
            return self;
        }
        let mut x = (self as f64).sqrt() as u16;
        while x > self / x {
            x -= 1;
        }
        while x + 1 <= self / (x + 1) {
            x += 1;
        }
        x
    }

    /// Negates self in a wrapping fashion.
    ///
    /// Returns `!self + 1` using wrapping operations to return the value that
    /// represents the negation of this unsigned value. Note that for positive
    /// unsigned values overflow always occurs, but negating 0 does not
    /// overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u16.overflowing_neg(), (0, false));
    /// assert_eq(2u16.overflowing_neg(), (u16::MAX - 1, true));
    /// ```
    #[inline]
    pub fn overflowing_neg(self) -> (u16, bool) {
        (self.wrapping_neg(), self != 0)
    }

    /// Performs Euclidean division.
    ///
    /// Since, for the positive integers, all common definitions of division are
    /// equal, this is exactly equal to `self / rhs`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(7u16.div_euclid(4), 1);
    /// ```
    #[track_caller]
    pub fn div_euclid(self, rhs: u16) -> u16 {
        self / rhs
    }

    /// Calculates the least remainder of `self (mod rhs)`.
    ///
    /// Since, for the positive integers, all common definitions of division are
    /// equal, this is exactly equal to `self % rhs`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(7u16.rem_euclid(4), 3);
    /// ```
    #[track_caller]
    pub fn rem_euclid(self, rhs: u16) -> u16 {
        self % rhs
    }

    /// Returns the smallest power of two greater than or equal to `self`. If
    /// the next power of two is greater than the type's maximum value, `None`
    /// is returned, otherwise the power of two is wrapped in `Some`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u16.checked_next_power_of_two(), Some(2));
    /// assert_eq(3u16.checked_next_power_of_two(), Some(4));
    /// assert_eq(u16::MAX.checked_next_power_of_two(), None);
    /// ```
    #[inline]
    pub fn checked_next_power_of_two(self) -> Option<u16> {
        if self <= 1 {
            return Some(1);
        }
        let p = 16 - (self - 1).leading_zeros();
        if p >= 16 { None } else { Some((1 as u16) << p) }
    }

    /// Calculates the quotient of `self` and `rhs`, rounding the result towards
    /// positive infinity.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(7u16.div_ceil(4), 2);
    /// assert_eq(8u16.div_ceil(4), 2);
    /// ```
    #[track_caller]
    pub fn div_ceil(self, rhs: u16) -> u16 {
        let q = self / rhs;
        if self % rhs > 0 { q + 1 } else { q }
    }

    /// Calculates the smallest value greater than or equal to `self` that is a
    /// multiple of `rhs`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero, or if the result overflows
    /// (navi checks integer overflow in every build; Rust only in debug
    /// builds).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(16u16.next_multiple_of(8), 16);
    /// assert_eq(23u16.next_multiple_of(8), 24);
    /// ```
    #[track_caller]
    pub fn next_multiple_of(self, rhs: u16) -> u16 {
        let r = self % rhs;
        if r == 0 { self } else { self + (rhs - r) }
    }

    /// Calculates the smallest value greater than or equal to `self` that is a
    /// multiple of `rhs`. Returns `None` if `rhs` is zero or the operation
    /// would result in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(16u16.checked_next_multiple_of(8), Some(16));
    /// assert_eq(23u16.checked_next_multiple_of(8), Some(24));
    /// assert_eq(1u16.checked_next_multiple_of(0), None);
    /// assert_eq(u16::MAX.checked_next_multiple_of(2), None);
    /// ```
    #[inline]
    pub fn checked_next_multiple_of(self, rhs: u16) -> Option<u16> {
        if rhs == 0 {
            return None;
        }
        let r = self % rhs;
        if r == 0 {
            Some(self)
        } else {
            self.checked_add(rhs - r)
        }
    }

    /// Returns `true` if `self` is an integer multiple of `rhs`, and false
    /// otherwise.
    ///
    /// This function is equivalent to `self % rhs == 0`, except that it will
    /// not panic for `rhs == 0`. Instead, `0.is_multiple_of(0) == true`, and
    /// for any non-zero `n`, `n.is_multiple_of(0) == false`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(6u16.is_multiple_of(2));
    /// assert(!5u16.is_multiple_of(2));
    ///
    /// assert(0u16.is_multiple_of(0));
    /// assert(!6u16.is_multiple_of(0));
    /// ```
    #[inline]
    pub fn is_multiple_of(self, rhs: u16) -> bool {
        if rhs == 0 { self == 0 } else { self % rhs == 0 }
    }

    /// Reverses the byte order of the integer.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1234u16;
    /// let m = n.swap_bytes();
    ///
    /// assert_eq(m, 0x3412);
    /// ```
    #[inline]
    pub fn swap_bytes(self) -> u16 {
        let v = self as u16;
        let mut r: u16 = 0;
        let mut i = 0u32;
        while i < 2 {
            r = (r << 8) | ((v >> (8 * i)) & 255);
            i += 1;
        }
        r as u16
    }
}

impl u32 {
    /// Checked negation. Computes `-self`, returning `None` unless `self == 0`.
    ///
    /// Note that negating any positive integer will overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u32.checked_neg(), Some(0));
    /// assert_eq(1u32.checked_neg(), None);
    /// ```
    #[inline]
    pub fn checked_neg(self) -> Option<u32> {
        let (r, o) = self.overflowing_neg();
        if o { None } else { Some(r) }
    }

    /// Checked exponentiation. Computes `self.pow(exp)`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(8u32.checked_pow(2), Some(64));
    /// assert_eq(u32::MAX.checked_pow(2), None);
    /// ```
    pub fn checked_pow(self, exp: u32) -> Option<u32> {
        if exp == 0 {
            return Some(1);
        }
        let mut base = self;
        let mut acc: u32 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc.checked_mul(base)?;
                if e == 1 {
                    return Some(acc);
                }
            }
            e = e / 2;
            base = base.checked_mul(base)?;
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// Returns a tuple of the exponentiation along with a bool indicating
    /// whether an overflow happened.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3u32.overflowing_pow(4), (81, false));
    /// assert_eq(u32::MAX.overflowing_pow(2), (1, true));
    /// ```
    pub fn overflowing_pow(self, exp: u32) -> (u32, bool) {
        if exp == 0 {
            return (1, false);
        }
        let mut base = self;
        let mut acc: u32 = 1;
        let mut e = exp;
        let mut over = false;
        loop {
            if e & 1 == 1 {
                let (r, o) = acc.overflowing_mul(base);
                acc = r;
                over = over || o;
                if e == 1 {
                    return (acc, over);
                }
            }
            e = e / 2;
            let (b, o) = base.overflowing_mul(base);
            base = b;
            over = over || o;
        }
    }

    /// Saturating integer exponentiation. Computes `self.pow(exp)`, saturating
    /// at the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(4u32.saturating_pow(3), 64);
    /// assert_eq(u32::MAX.saturating_pow(2), u32::MAX);
    /// ```
    #[inline]
    pub fn saturating_pow(self, exp: u32) -> u32 {
        match self.checked_pow(exp) {
            Some(r) => r,
            None => {
                if false {
                    u32::MIN
                } else {
                    u32::MAX
                }
            }
        }
    }

    /// Checked shift left. Computes `self << rhs`, returning `None` if `rhs` is
    /// larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1u32.checked_shl(4), Some(0x10));
    /// assert_eq(0x1u32.checked_shl(32), None);
    /// assert_eq(0x10u32.checked_shl(31), Some(0));
    /// ```
    #[inline]
    pub fn checked_shl(self, rhs: u32) -> Option<u32> {
        if rhs < 32 { Some(self << rhs) } else { None }
    }

    /// Checked shift right. Computes `self >> rhs`, returning `None` if `rhs`
    /// is larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10u32.checked_shr(4), Some(0x1));
    /// assert_eq(0x10u32.checked_shr(32), None);
    /// ```
    #[inline]
    pub fn checked_shr(self, rhs: u32) -> Option<u32> {
        if rhs < 32 { Some(self >> rhs) } else { None }
    }

    /// Panic-free bitwise shift-left; yields `self << mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-left; the RHS of a wrapping
    /// shift-left is restricted to the range of the type, rather than the bits
    /// shifted out of the LHS being returned to the other end. The primitive
    /// integer types all implement a `rotate_left` function, which may be what
    /// you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(1u32.wrapping_shl(7), 128);
    /// assert_eq(1u32.wrapping_shl(128), 1);
    /// ```
    #[inline]
    pub fn wrapping_shl(self, rhs: u32) -> u32 {
        self << (rhs % 32)
    }

    /// Panic-free bitwise shift-right; yields `self >> mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-right; the RHS of a
    /// wrapping shift-right is restricted to the range of the type, rather than
    /// the bits shifted out of the LHS being returned to the other end. The
    /// primitive integer types all implement a `rotate_right` function, which
    /// may be what you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(128u32.wrapping_shr(7), 1);
    /// assert_eq(128u32.wrapping_shr(128), 128);
    /// ```
    #[inline]
    pub fn wrapping_shr(self, rhs: u32) -> u32 {
        self >> (rhs % 32)
    }

    /// Shifts self left by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1u32.overflowing_shl(4), (0x10, false));
    /// assert_eq(0x1u32.overflowing_shl(36), (0x10, true));
    /// assert_eq(0x10u32.overflowing_shl(31), (0, false));
    /// ```
    #[inline]
    pub fn overflowing_shl(self, rhs: u32) -> (u32, bool) {
        (self.wrapping_shl(rhs), rhs >= 32)
    }

    /// Shifts self right by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10u32.overflowing_shr(4), (0x1, false));
    /// assert_eq(0x10u32.overflowing_shr(36), (0x1, true));
    /// ```
    #[inline]
    pub fn overflowing_shr(self, rhs: u32) -> (u32, bool) {
        (self.wrapping_shr(rhs), rhs >= 32)
    }

    /// Wrapping (modular) division. Computes `self / rhs`.
    ///
    /// Wrapped division on unsigned types is just normal division. There's no
    /// way wrapping could ever happen. This function exists so that all
    /// operations are accounted for in the wrapping operations.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u32.wrapping_div(10), 10);
    /// ```
    #[inline]
    pub fn wrapping_div(self, rhs: u32) -> u32 {
        if false { self } else { self / rhs }
    }

    /// Wrapping (modular) remainder. Computes `self % rhs`.
    ///
    /// Wrapped remainder calculation on unsigned types is just the regular
    /// remainder calculation. There's no way wrapping could ever happen. This
    /// function exists so that all operations are accounted for in the wrapping
    /// operations.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u32.wrapping_rem(10), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem(self, rhs: u32) -> u32 {
        if false { 0 } else { self % rhs }
    }

    /// Calculates the divisor when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the divisor along with a boolean indicating whether
    /// an arithmetic overflow would occur. Note that for unsigned integers
    /// overflow never occurs, so the second value is always `false`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u32.overflowing_div(2), (2, false));
    /// ```
    #[inline]
    pub fn overflowing_div(self, rhs: u32) -> (u32, bool) {
        if false {
            (self, true)
        } else {
            (self / rhs, false)
        }
    }

    /// Calculates the remainder when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the remainder along with a boolean indicating whether
    /// an arithmetic overflow would occur. Note that for unsigned integers
    /// overflow never occurs, so the second value is always `false`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u32.overflowing_rem(2), (1, false));
    /// ```
    #[inline]
    pub fn overflowing_rem(self, rhs: u32) -> (u32, bool) {
        if false {
            (0, true)
        } else {
            (self % rhs, false)
        }
    }

    /// Saturating integer division. Computes `self / rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u32.saturating_div(2), 2);
    /// ```
    #[inline]
    pub fn saturating_div(self, rhs: u32) -> u32 {
        if false { u32::MAX } else { self / rhs }
    }

    /// Checked Euclidean division. Computes `self.div_euclid(rhs)`, returning
    /// `None` if `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(128u32.checked_div_euclid(2), Some(64));
    /// assert_eq(1u32.checked_div_euclid(0), None);
    /// ```
    #[inline]
    pub fn checked_div_euclid(self, rhs: u32) -> Option<u32> {
        if rhs == 0 || false {
            None
        } else {
            Some(self.div_euclid(rhs))
        }
    }

    /// Checked Euclidean modulo. Computes `self.rem_euclid(rhs)`, returning
    /// `None` if `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u32.checked_rem_euclid(2), Some(1));
    /// assert_eq(5u32.checked_rem_euclid(0), None);
    /// ```
    #[inline]
    pub fn checked_rem_euclid(self, rhs: u32) -> Option<u32> {
        if rhs == 0 || false {
            None
        } else {
            Some(self.rem_euclid(rhs))
        }
    }

    /// Wrapping Euclidean division. Computes `self.div_euclid(rhs)`.
    ///
    /// Wrapped division on unsigned types is just normal division. There's no
    /// way wrapping could ever happen. This function exists so that all
    /// operations are accounted for in the wrapping operations. Since, for the
    /// positive integers, all common definitions of division are equal, this is
    /// exactly equal to `self.wrapping_div(rhs)`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u32.wrapping_div_euclid(10), 10);
    /// ```
    #[inline]
    pub fn wrapping_div_euclid(self, rhs: u32) -> u32 {
        if false { self } else { self.div_euclid(rhs) }
    }

    /// Wrapping Euclidean modulo. Computes `self.rem_euclid(rhs)`.
    ///
    /// Wrapped modulo calculation on unsigned types is just the regular
    /// remainder calculation. There's no way wrapping could ever happen. This
    /// function exists so that all operations are accounted for in the wrapping
    /// operations. Since, for the positive integers, all common definitions of
    /// division are equal, this is exactly equal to `self.wrapping_rem(rhs)`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u32.wrapping_rem_euclid(10), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem_euclid(self, rhs: u32) -> u32 {
        if false { 0 } else { self.rem_euclid(rhs) }
    }

    /// Reverses the order of bits in the integer. The least significant bit
    /// becomes the most significant bit, second least-significant bit becomes
    /// second most-significant bit, etc.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x12345678u32;
    /// let m = n.reverse_bits();
    ///
    /// assert_eq(m, 0x1e6a2c48);
    /// assert_eq(0u32.reverse_bits(), 0);
    /// ```
    #[inline]
    pub fn reverse_bits(self) -> u32 {
        let v = self;
        let mut r: u32 = 0;
        let mut i = 0u32;
        while i < 32 {
            r = (r << 1) | ((v >> i) & 1);
            i += 1;
        }
        r
    }

    /// Converts `self` to big endian from the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au32;
    ///
    /// assert_eq(n.to_be(), n.swap_bytes());
    /// ```
    #[inline]
    pub fn to_be(self) -> u32 {
        self.swap_bytes()
    }

    /// Converts `self` to little endian from the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au32;
    ///
    /// assert_eq(n.to_le(), n);
    /// ```
    #[inline]
    pub fn to_le(self) -> u32 {
        self
    }

    /// Converts an integer from big endian to the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au32;
    ///
    /// assert_eq(u32::from_be(n), n.swap_bytes());
    /// ```
    #[inline]
    pub fn from_be(x: u32) -> u32 {
        x.swap_bytes()
    }

    /// Converts an integer from little endian to the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au32;
    ///
    /// assert_eq(u32::from_le(n), n);
    /// ```
    #[inline]
    pub fn from_le(x: u32) -> u32 {
        x
    }

    /// Returns the memory representation of this integer as a byte array in
    /// big-endian (network) byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x12345678u32.to_be_bytes();
    /// assert_eq(bytes, [0x12, 0x34, 0x56, 0x78]);
    /// ```
    #[inline]
    pub fn to_be_bytes(self) -> [u8; 4] {
        self.swap_bytes().to_le_bytes()
    }

    /// Creates an integer value from its representation as a byte array in big
    /// endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = u32::from_be_bytes([0x12, 0x34, 0x56, 0x78]);
    /// assert_eq(value, 0x12345678);
    /// ```
    #[inline]
    pub fn from_be_bytes(bytes: [u8; 4]) -> u32 {
        u32::from_le_bytes(bytes).swap_bytes()
    }

    /// Returns the memory representation of this integer as a byte array in
    /// native byte order.
    ///
    /// As the target platform's native endianness is used, portable code should
    /// use `to_be_bytes` or `to_le_bytes`, as appropriate, instead. (navi's
    /// targets are all little endian, so this is `to_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x12345678u32.to_ne_bytes();
    /// assert_eq(bytes, [0x78, 0x56, 0x34, 0x12]);
    /// ```
    #[inline]
    pub fn to_ne_bytes(self) -> [u8; 4] {
        self.to_le_bytes()
    }

    /// Creates an integer value from its memory representation as a byte array
    /// in native endianness.
    ///
    /// As the target platform's native endianness is used, portable code likely
    /// wants to use `from_be_bytes` or `from_le_bytes`, as appropriate instead.
    /// (navi's targets are all little endian, so this is `from_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let value = u32::from_ne_bytes([0x78, 0x56, 0x34, 0x12]);
    /// assert_eq(value, 0x12345678);
    /// ```
    #[inline]
    pub fn from_ne_bytes(bytes: [u8; 4]) -> u32 {
        u32::from_le_bytes(bytes)
    }

    /// Returns the number of leading ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = !(u32::MAX >> 2);
    /// assert_eq(n.leading_ones(), 2);
    ///
    /// assert_eq(0u32.leading_ones(), 0);
    /// assert_eq(u32::MAX.leading_ones(), 32);
    /// ```
    #[inline]
    pub fn leading_ones(self) -> u32 {
        (!self).leading_zeros()
    }

    /// Returns the number of trailing ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b1010111u32;
    /// assert_eq(n.trailing_ones(), 3);
    ///
    /// assert_eq(0u32.trailing_ones(), 0);
    /// assert_eq(u32::MAX.trailing_ones(), 32);
    /// ```
    #[inline]
    pub fn trailing_ones(self) -> u32 {
        (!self).trailing_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u32.ilog2(), 1);
    /// assert_eq(u32::MAX.ilog2(), 31);
    /// ```
    #[track_caller]
    pub fn ilog2(self) -> u32 {
        if self == 0 {
            panic("argument of integer logarithm must be positive");
        }
        32 - 1 - self.leading_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u32.checked_ilog2(), Some(1));
    /// assert_eq(0u32.checked_ilog2(), None);
    /// ```
    #[inline]
    pub fn checked_ilog2(self) -> Option<u32> {
        if self == 0 {
            None
        } else {
            Some(32 - 1 - self.leading_zeros())
        }
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u32.ilog10(), 1);
    /// assert_eq(99u32.ilog10(), 1);
    /// assert_eq(u32::MAX.ilog10(), 9);
    /// ```
    #[track_caller]
    pub fn ilog10(self) -> u32 {
        if self == 0 {
            panic("argument of integer logarithm must be positive");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= 10 {
            v = v / 10;
            n += 1;
        }
        n
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u32.checked_ilog10(), Some(1));
    /// assert_eq(0u32.checked_ilog10(), None);
    /// ```
    #[inline]
    pub fn checked_ilog10(self) -> Option<u32> {
        if self == 0 { None } else { Some(self.ilog10()) }
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `ilog2` can produce results more efficiently for base 2, and `ilog10`
    /// can produce results more efficiently for base 10.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is zero, or if `base` is less than 2.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u32.ilog(5), 1);
    /// assert_eq(100u32.ilog(3), 4);
    /// ```
    #[track_caller]
    pub fn ilog(self, base: u32) -> u32 {
        if self == 0 {
            panic("argument of integer logarithm must be positive");
        }
        if base < 2 {
            panic("base of integer logarithm must be at least 2");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= base {
            v = v / base;
            n += 1;
        }
        n
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// Returns `None` if the number is zero, or if the base is not at least 2.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `checked_ilog2` can produce results more efficiently for base 2, and
    /// `checked_ilog10` can produce results more efficiently for base 10.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u32.checked_ilog(5), Some(1));
    /// assert_eq(0u32.checked_ilog(5), None);
    /// assert_eq(5u32.checked_ilog(1), None);
    /// ```
    #[inline]
    pub fn checked_ilog(self, base: u32) -> Option<u32> {
        if self == 0 || base < 2 {
            None
        } else {
            Some(self.ilog(base))
        }
    }

    /// Returns the square root of the number, rounded down.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u32.isqrt(), 3);
    /// assert_eq(u32::MAX.isqrt(), 65535);
    /// ```
    #[track_caller]
    pub fn isqrt(self) -> u32 {
        if self < 2 {
            return self;
        }
        let mut x = (self as f64).sqrt() as u32;
        while x > self / x {
            x -= 1;
        }
        while x + 1 <= self / (x + 1) {
            x += 1;
        }
        x
    }

    /// Negates self in a wrapping fashion.
    ///
    /// Returns `!self + 1` using wrapping operations to return the value that
    /// represents the negation of this unsigned value. Note that for positive
    /// unsigned values overflow always occurs, but negating 0 does not
    /// overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u32.overflowing_neg(), (0, false));
    /// assert_eq(2u32.overflowing_neg(), (u32::MAX - 1, true));
    /// ```
    #[inline]
    pub fn overflowing_neg(self) -> (u32, bool) {
        (self.wrapping_neg(), self != 0)
    }

    /// Performs Euclidean division.
    ///
    /// Since, for the positive integers, all common definitions of division are
    /// equal, this is exactly equal to `self / rhs`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(7u32.div_euclid(4), 1);
    /// ```
    #[track_caller]
    pub fn div_euclid(self, rhs: u32) -> u32 {
        self / rhs
    }

    /// Calculates the least remainder of `self (mod rhs)`.
    ///
    /// Since, for the positive integers, all common definitions of division are
    /// equal, this is exactly equal to `self % rhs`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(7u32.rem_euclid(4), 3);
    /// ```
    #[track_caller]
    pub fn rem_euclid(self, rhs: u32) -> u32 {
        self % rhs
    }

    /// Returns the smallest power of two greater than or equal to `self`. If
    /// the next power of two is greater than the type's maximum value, `None`
    /// is returned, otherwise the power of two is wrapped in `Some`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u32.checked_next_power_of_two(), Some(2));
    /// assert_eq(3u32.checked_next_power_of_two(), Some(4));
    /// assert_eq(u32::MAX.checked_next_power_of_two(), None);
    /// ```
    #[inline]
    pub fn checked_next_power_of_two(self) -> Option<u32> {
        if self <= 1 {
            return Some(1);
        }
        let p = 32 - (self - 1).leading_zeros();
        if p >= 32 { None } else { Some((1 as u32) << p) }
    }

    /// Calculates the quotient of `self` and `rhs`, rounding the result towards
    /// positive infinity.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(7u32.div_ceil(4), 2);
    /// assert_eq(8u32.div_ceil(4), 2);
    /// ```
    #[track_caller]
    pub fn div_ceil(self, rhs: u32) -> u32 {
        let q = self / rhs;
        if self % rhs > 0 { q + 1 } else { q }
    }

    /// Calculates the smallest value greater than or equal to `self` that is a
    /// multiple of `rhs`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero, or if the result overflows
    /// (navi checks integer overflow in every build; Rust only in debug
    /// builds).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(16u32.next_multiple_of(8), 16);
    /// assert_eq(23u32.next_multiple_of(8), 24);
    /// ```
    #[track_caller]
    pub fn next_multiple_of(self, rhs: u32) -> u32 {
        let r = self % rhs;
        if r == 0 { self } else { self + (rhs - r) }
    }

    /// Calculates the smallest value greater than or equal to `self` that is a
    /// multiple of `rhs`. Returns `None` if `rhs` is zero or the operation
    /// would result in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(16u32.checked_next_multiple_of(8), Some(16));
    /// assert_eq(23u32.checked_next_multiple_of(8), Some(24));
    /// assert_eq(1u32.checked_next_multiple_of(0), None);
    /// assert_eq(u32::MAX.checked_next_multiple_of(2), None);
    /// ```
    #[inline]
    pub fn checked_next_multiple_of(self, rhs: u32) -> Option<u32> {
        if rhs == 0 {
            return None;
        }
        let r = self % rhs;
        if r == 0 {
            Some(self)
        } else {
            self.checked_add(rhs - r)
        }
    }

    /// Returns `true` if `self` is an integer multiple of `rhs`, and false
    /// otherwise.
    ///
    /// This function is equivalent to `self % rhs == 0`, except that it will
    /// not panic for `rhs == 0`. Instead, `0.is_multiple_of(0) == true`, and
    /// for any non-zero `n`, `n.is_multiple_of(0) == false`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(6u32.is_multiple_of(2));
    /// assert(!5u32.is_multiple_of(2));
    ///
    /// assert(0u32.is_multiple_of(0));
    /// assert(!6u32.is_multiple_of(0));
    /// ```
    #[inline]
    pub fn is_multiple_of(self, rhs: u32) -> bool {
        if rhs == 0 { self == 0 } else { self % rhs == 0 }
    }

    /// Reverses the byte order of the integer.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x12345678u32;
    /// let m = n.swap_bytes();
    ///
    /// assert_eq(m, 0x78563412);
    /// ```
    #[inline]
    pub fn swap_bytes(self) -> u32 {
        let v = self as u32;
        let mut r: u32 = 0;
        let mut i = 0u32;
        while i < 4 {
            r = (r << 8) | ((v >> (8 * i)) & 255);
            i += 1;
        }
        r as u32
    }
}

impl u64 {
    /// Checked negation. Computes `-self`, returning `None` unless `self == 0`.
    ///
    /// Note that negating any positive integer will overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u64.checked_neg(), Some(0));
    /// assert_eq(1u64.checked_neg(), None);
    /// ```
    #[inline]
    pub fn checked_neg(self) -> Option<u64> {
        let (r, o) = self.overflowing_neg();
        if o { None } else { Some(r) }
    }

    /// Checked exponentiation. Computes `self.pow(exp)`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(8u64.checked_pow(2), Some(64));
    /// assert_eq(u64::MAX.checked_pow(2), None);
    /// ```
    pub fn checked_pow(self, exp: u32) -> Option<u64> {
        if exp == 0 {
            return Some(1);
        }
        let mut base = self;
        let mut acc: u64 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc.checked_mul(base)?;
                if e == 1 {
                    return Some(acc);
                }
            }
            e = e / 2;
            base = base.checked_mul(base)?;
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// Returns a tuple of the exponentiation along with a bool indicating
    /// whether an overflow happened.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3u64.overflowing_pow(4), (81, false));
    /// assert_eq(u64::MAX.overflowing_pow(2), (1, true));
    /// ```
    pub fn overflowing_pow(self, exp: u32) -> (u64, bool) {
        if exp == 0 {
            return (1, false);
        }
        let mut base = self;
        let mut acc: u64 = 1;
        let mut e = exp;
        let mut over = false;
        loop {
            if e & 1 == 1 {
                let (r, o) = acc.overflowing_mul(base);
                acc = r;
                over = over || o;
                if e == 1 {
                    return (acc, over);
                }
            }
            e = e / 2;
            let (b, o) = base.overflowing_mul(base);
            base = b;
            over = over || o;
        }
    }

    /// Saturating integer exponentiation. Computes `self.pow(exp)`, saturating
    /// at the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(4u64.saturating_pow(3), 64);
    /// assert_eq(u64::MAX.saturating_pow(2), u64::MAX);
    /// ```
    #[inline]
    pub fn saturating_pow(self, exp: u32) -> u64 {
        match self.checked_pow(exp) {
            Some(r) => r,
            None => {
                if false {
                    u64::MIN
                } else {
                    u64::MAX
                }
            }
        }
    }

    /// Checked shift left. Computes `self << rhs`, returning `None` if `rhs` is
    /// larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1u64.checked_shl(4), Some(0x10));
    /// assert_eq(0x1u64.checked_shl(64), None);
    /// assert_eq(0x10u64.checked_shl(63), Some(0));
    /// ```
    #[inline]
    pub fn checked_shl(self, rhs: u32) -> Option<u64> {
        if rhs < 64 { Some(self << rhs) } else { None }
    }

    /// Checked shift right. Computes `self >> rhs`, returning `None` if `rhs`
    /// is larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10u64.checked_shr(4), Some(0x1));
    /// assert_eq(0x10u64.checked_shr(64), None);
    /// ```
    #[inline]
    pub fn checked_shr(self, rhs: u32) -> Option<u64> {
        if rhs < 64 { Some(self >> rhs) } else { None }
    }

    /// Panic-free bitwise shift-left; yields `self << mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-left; the RHS of a wrapping
    /// shift-left is restricted to the range of the type, rather than the bits
    /// shifted out of the LHS being returned to the other end. The primitive
    /// integer types all implement a `rotate_left` function, which may be what
    /// you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(1u64.wrapping_shl(7), 128);
    /// assert_eq(1u64.wrapping_shl(128), 1);
    /// ```
    #[inline]
    pub fn wrapping_shl(self, rhs: u32) -> u64 {
        self << (rhs % 64)
    }

    /// Panic-free bitwise shift-right; yields `self >> mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-right; the RHS of a
    /// wrapping shift-right is restricted to the range of the type, rather than
    /// the bits shifted out of the LHS being returned to the other end. The
    /// primitive integer types all implement a `rotate_right` function, which
    /// may be what you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(128u64.wrapping_shr(7), 1);
    /// assert_eq(128u64.wrapping_shr(128), 128);
    /// ```
    #[inline]
    pub fn wrapping_shr(self, rhs: u32) -> u64 {
        self >> (rhs % 64)
    }

    /// Shifts self left by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1u64.overflowing_shl(4), (0x10, false));
    /// assert_eq(0x1u64.overflowing_shl(68), (0x10, true));
    /// assert_eq(0x10u64.overflowing_shl(63), (0, false));
    /// ```
    #[inline]
    pub fn overflowing_shl(self, rhs: u32) -> (u64, bool) {
        (self.wrapping_shl(rhs), rhs >= 64)
    }

    /// Shifts self right by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10u64.overflowing_shr(4), (0x1, false));
    /// assert_eq(0x10u64.overflowing_shr(68), (0x1, true));
    /// ```
    #[inline]
    pub fn overflowing_shr(self, rhs: u32) -> (u64, bool) {
        (self.wrapping_shr(rhs), rhs >= 64)
    }

    /// Wrapping (modular) division. Computes `self / rhs`.
    ///
    /// Wrapped division on unsigned types is just normal division. There's no
    /// way wrapping could ever happen. This function exists so that all
    /// operations are accounted for in the wrapping operations.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u64.wrapping_div(10), 10);
    /// ```
    #[inline]
    pub fn wrapping_div(self, rhs: u64) -> u64 {
        if false { self } else { self / rhs }
    }

    /// Wrapping (modular) remainder. Computes `self % rhs`.
    ///
    /// Wrapped remainder calculation on unsigned types is just the regular
    /// remainder calculation. There's no way wrapping could ever happen. This
    /// function exists so that all operations are accounted for in the wrapping
    /// operations.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u64.wrapping_rem(10), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem(self, rhs: u64) -> u64 {
        if false { 0 } else { self % rhs }
    }

    /// Calculates the divisor when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the divisor along with a boolean indicating whether
    /// an arithmetic overflow would occur. Note that for unsigned integers
    /// overflow never occurs, so the second value is always `false`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u64.overflowing_div(2), (2, false));
    /// ```
    #[inline]
    pub fn overflowing_div(self, rhs: u64) -> (u64, bool) {
        if false {
            (self, true)
        } else {
            (self / rhs, false)
        }
    }

    /// Calculates the remainder when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the remainder along with a boolean indicating whether
    /// an arithmetic overflow would occur. Note that for unsigned integers
    /// overflow never occurs, so the second value is always `false`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u64.overflowing_rem(2), (1, false));
    /// ```
    #[inline]
    pub fn overflowing_rem(self, rhs: u64) -> (u64, bool) {
        if false {
            (0, true)
        } else {
            (self % rhs, false)
        }
    }

    /// Saturating integer division. Computes `self / rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u64.saturating_div(2), 2);
    /// ```
    #[inline]
    pub fn saturating_div(self, rhs: u64) -> u64 {
        if false { u64::MAX } else { self / rhs }
    }

    /// Checked Euclidean division. Computes `self.div_euclid(rhs)`, returning
    /// `None` if `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(128u64.checked_div_euclid(2), Some(64));
    /// assert_eq(1u64.checked_div_euclid(0), None);
    /// ```
    #[inline]
    pub fn checked_div_euclid(self, rhs: u64) -> Option<u64> {
        if rhs == 0 || false {
            None
        } else {
            Some(self.div_euclid(rhs))
        }
    }

    /// Checked Euclidean modulo. Computes `self.rem_euclid(rhs)`, returning
    /// `None` if `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u64.checked_rem_euclid(2), Some(1));
    /// assert_eq(5u64.checked_rem_euclid(0), None);
    /// ```
    #[inline]
    pub fn checked_rem_euclid(self, rhs: u64) -> Option<u64> {
        if rhs == 0 || false {
            None
        } else {
            Some(self.rem_euclid(rhs))
        }
    }

    /// Wrapping Euclidean division. Computes `self.div_euclid(rhs)`.
    ///
    /// Wrapped division on unsigned types is just normal division. There's no
    /// way wrapping could ever happen. This function exists so that all
    /// operations are accounted for in the wrapping operations. Since, for the
    /// positive integers, all common definitions of division are equal, this is
    /// exactly equal to `self.wrapping_div(rhs)`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u64.wrapping_div_euclid(10), 10);
    /// ```
    #[inline]
    pub fn wrapping_div_euclid(self, rhs: u64) -> u64 {
        if false { self } else { self.div_euclid(rhs) }
    }

    /// Wrapping Euclidean modulo. Computes `self.rem_euclid(rhs)`.
    ///
    /// Wrapped modulo calculation on unsigned types is just the regular
    /// remainder calculation. There's no way wrapping could ever happen. This
    /// function exists so that all operations are accounted for in the wrapping
    /// operations. Since, for the positive integers, all common definitions of
    /// division are equal, this is exactly equal to `self.wrapping_rem(rhs)`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u64.wrapping_rem_euclid(10), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem_euclid(self, rhs: u64) -> u64 {
        if false { 0 } else { self.rem_euclid(rhs) }
    }

    /// Reverses the order of bits in the integer. The least significant bit
    /// becomes the most significant bit, second least-significant bit becomes
    /// second most-significant bit, etc.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1234567890123456u64;
    /// let m = n.reverse_bits();
    ///
    /// assert_eq(m, 0x6a2c48091e6a2c48);
    /// assert_eq(0u64.reverse_bits(), 0);
    /// ```
    #[inline]
    pub fn reverse_bits(self) -> u64 {
        let v = self;
        let mut r: u64 = 0;
        let mut i = 0u32;
        while i < 64 {
            r = (r << 1) | ((v >> i) & 1);
            i += 1;
        }
        r
    }

    /// Converts `self` to big endian from the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au64;
    ///
    /// assert_eq(n.to_be(), n.swap_bytes());
    /// ```
    #[inline]
    pub fn to_be(self) -> u64 {
        self.swap_bytes()
    }

    /// Converts `self` to little endian from the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au64;
    ///
    /// assert_eq(n.to_le(), n);
    /// ```
    #[inline]
    pub fn to_le(self) -> u64 {
        self
    }

    /// Converts an integer from big endian to the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au64;
    ///
    /// assert_eq(u64::from_be(n), n.swap_bytes());
    /// ```
    #[inline]
    pub fn from_be(x: u64) -> u64 {
        x.swap_bytes()
    }

    /// Converts an integer from little endian to the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au64;
    ///
    /// assert_eq(u64::from_le(n), n);
    /// ```
    #[inline]
    pub fn from_le(x: u64) -> u64 {
        x
    }

    /// Returns the memory representation of this integer as a byte array in
    /// big-endian (network) byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x1234567890123456u64.to_be_bytes();
    /// assert_eq(bytes, [0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56]);
    /// ```
    #[inline]
    pub fn to_be_bytes(self) -> [u8; 8] {
        self.swap_bytes().to_le_bytes()
    }

    /// Creates an integer value from its representation as a byte array in big
    /// endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = u64::from_be_bytes([0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56]);
    /// assert_eq(value, 0x1234567890123456);
    /// ```
    #[inline]
    pub fn from_be_bytes(bytes: [u8; 8]) -> u64 {
        u64::from_le_bytes(bytes).swap_bytes()
    }

    /// Returns the memory representation of this integer as a byte array in
    /// native byte order.
    ///
    /// As the target platform's native endianness is used, portable code should
    /// use `to_be_bytes` or `to_le_bytes`, as appropriate, instead. (navi's
    /// targets are all little endian, so this is `to_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x1234567890123456u64.to_ne_bytes();
    /// assert_eq(bytes, [0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12]);
    /// ```
    #[inline]
    pub fn to_ne_bytes(self) -> [u8; 8] {
        self.to_le_bytes()
    }

    /// Creates an integer value from its memory representation as a byte array
    /// in native endianness.
    ///
    /// As the target platform's native endianness is used, portable code likely
    /// wants to use `from_be_bytes` or `from_le_bytes`, as appropriate instead.
    /// (navi's targets are all little endian, so this is `from_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let value = u64::from_ne_bytes([0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12]);
    /// assert_eq(value, 0x1234567890123456);
    /// ```
    #[inline]
    pub fn from_ne_bytes(bytes: [u8; 8]) -> u64 {
        u64::from_le_bytes(bytes)
    }

    /// Returns the number of leading ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = !(u64::MAX >> 2);
    /// assert_eq(n.leading_ones(), 2);
    ///
    /// assert_eq(0u64.leading_ones(), 0);
    /// assert_eq(u64::MAX.leading_ones(), 64);
    /// ```
    #[inline]
    pub fn leading_ones(self) -> u32 {
        (!self).leading_zeros()
    }

    /// Returns the number of trailing ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b1010111u64;
    /// assert_eq(n.trailing_ones(), 3);
    ///
    /// assert_eq(0u64.trailing_ones(), 0);
    /// assert_eq(u64::MAX.trailing_ones(), 64);
    /// ```
    #[inline]
    pub fn trailing_ones(self) -> u32 {
        (!self).trailing_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u64.ilog2(), 1);
    /// assert_eq(u64::MAX.ilog2(), 63);
    /// ```
    #[track_caller]
    pub fn ilog2(self) -> u32 {
        if self == 0 {
            panic("argument of integer logarithm must be positive");
        }
        64 - 1 - self.leading_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u64.checked_ilog2(), Some(1));
    /// assert_eq(0u64.checked_ilog2(), None);
    /// ```
    #[inline]
    pub fn checked_ilog2(self) -> Option<u32> {
        if self == 0 {
            None
        } else {
            Some(64 - 1 - self.leading_zeros())
        }
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u64.ilog10(), 1);
    /// assert_eq(99u64.ilog10(), 1);
    /// assert_eq(u64::MAX.ilog10(), 19);
    /// ```
    #[track_caller]
    pub fn ilog10(self) -> u32 {
        if self == 0 {
            panic("argument of integer logarithm must be positive");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= 10 {
            v = v / 10;
            n += 1;
        }
        n
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u64.checked_ilog10(), Some(1));
    /// assert_eq(0u64.checked_ilog10(), None);
    /// ```
    #[inline]
    pub fn checked_ilog10(self) -> Option<u32> {
        if self == 0 { None } else { Some(self.ilog10()) }
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `ilog2` can produce results more efficiently for base 2, and `ilog10`
    /// can produce results more efficiently for base 10.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is zero, or if `base` is less than 2.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u64.ilog(5), 1);
    /// assert_eq(100u64.ilog(3), 4);
    /// ```
    #[track_caller]
    pub fn ilog(self, base: u64) -> u32 {
        if self == 0 {
            panic("argument of integer logarithm must be positive");
        }
        if base < 2 {
            panic("base of integer logarithm must be at least 2");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= base {
            v = v / base;
            n += 1;
        }
        n
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// Returns `None` if the number is zero, or if the base is not at least 2.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `checked_ilog2` can produce results more efficiently for base 2, and
    /// `checked_ilog10` can produce results more efficiently for base 10.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u64.checked_ilog(5), Some(1));
    /// assert_eq(0u64.checked_ilog(5), None);
    /// assert_eq(5u64.checked_ilog(1), None);
    /// ```
    #[inline]
    pub fn checked_ilog(self, base: u64) -> Option<u32> {
        if self == 0 || base < 2 {
            None
        } else {
            Some(self.ilog(base))
        }
    }

    /// Returns the square root of the number, rounded down.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u64.isqrt(), 3);
    /// assert_eq(u64::MAX.isqrt(), 4294967295);
    /// ```
    #[track_caller]
    pub fn isqrt(self) -> u64 {
        if self < 2 {
            return self;
        }
        let mut x = (self as f64).sqrt() as u64;
        while x > self / x {
            x -= 1;
        }
        while x + 1 <= self / (x + 1) {
            x += 1;
        }
        x
    }

    /// Negates self in a wrapping fashion.
    ///
    /// Returns `!self + 1` using wrapping operations to return the value that
    /// represents the negation of this unsigned value. Note that for positive
    /// unsigned values overflow always occurs, but negating 0 does not
    /// overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u64.overflowing_neg(), (0, false));
    /// assert_eq(2u64.overflowing_neg(), (u64::MAX - 1, true));
    /// ```
    #[inline]
    pub fn overflowing_neg(self) -> (u64, bool) {
        (self.wrapping_neg(), self != 0)
    }

    /// Performs Euclidean division.
    ///
    /// Since, for the positive integers, all common definitions of division are
    /// equal, this is exactly equal to `self / rhs`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(7u64.div_euclid(4), 1);
    /// ```
    #[track_caller]
    pub fn div_euclid(self, rhs: u64) -> u64 {
        self / rhs
    }

    /// Calculates the least remainder of `self (mod rhs)`.
    ///
    /// Since, for the positive integers, all common definitions of division are
    /// equal, this is exactly equal to `self % rhs`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(7u64.rem_euclid(4), 3);
    /// ```
    #[track_caller]
    pub fn rem_euclid(self, rhs: u64) -> u64 {
        self % rhs
    }

    /// Returns the smallest power of two greater than or equal to `self`. If
    /// the next power of two is greater than the type's maximum value, `None`
    /// is returned, otherwise the power of two is wrapped in `Some`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u64.checked_next_power_of_two(), Some(2));
    /// assert_eq(3u64.checked_next_power_of_two(), Some(4));
    /// assert_eq(u64::MAX.checked_next_power_of_two(), None);
    /// ```
    #[inline]
    pub fn checked_next_power_of_two(self) -> Option<u64> {
        if self <= 1 {
            return Some(1);
        }
        let p = 64 - (self - 1).leading_zeros();
        if p >= 64 { None } else { Some((1 as u64) << p) }
    }

    /// Calculates the quotient of `self` and `rhs`, rounding the result towards
    /// positive infinity.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(7u64.div_ceil(4), 2);
    /// assert_eq(8u64.div_ceil(4), 2);
    /// ```
    #[track_caller]
    pub fn div_ceil(self, rhs: u64) -> u64 {
        let q = self / rhs;
        if self % rhs > 0 { q + 1 } else { q }
    }

    /// Calculates the smallest value greater than or equal to `self` that is a
    /// multiple of `rhs`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero, or if the result overflows
    /// (navi checks integer overflow in every build; Rust only in debug
    /// builds).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(16u64.next_multiple_of(8), 16);
    /// assert_eq(23u64.next_multiple_of(8), 24);
    /// ```
    #[track_caller]
    pub fn next_multiple_of(self, rhs: u64) -> u64 {
        let r = self % rhs;
        if r == 0 { self } else { self + (rhs - r) }
    }

    /// Calculates the smallest value greater than or equal to `self` that is a
    /// multiple of `rhs`. Returns `None` if `rhs` is zero or the operation
    /// would result in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(16u64.checked_next_multiple_of(8), Some(16));
    /// assert_eq(23u64.checked_next_multiple_of(8), Some(24));
    /// assert_eq(1u64.checked_next_multiple_of(0), None);
    /// assert_eq(u64::MAX.checked_next_multiple_of(2), None);
    /// ```
    #[inline]
    pub fn checked_next_multiple_of(self, rhs: u64) -> Option<u64> {
        if rhs == 0 {
            return None;
        }
        let r = self % rhs;
        if r == 0 {
            Some(self)
        } else {
            self.checked_add(rhs - r)
        }
    }

    /// Returns `true` if `self` is an integer multiple of `rhs`, and false
    /// otherwise.
    ///
    /// This function is equivalent to `self % rhs == 0`, except that it will
    /// not panic for `rhs == 0`. Instead, `0.is_multiple_of(0) == true`, and
    /// for any non-zero `n`, `n.is_multiple_of(0) == false`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(6u64.is_multiple_of(2));
    /// assert(!5u64.is_multiple_of(2));
    ///
    /// assert(0u64.is_multiple_of(0));
    /// assert(!6u64.is_multiple_of(0));
    /// ```
    #[inline]
    pub fn is_multiple_of(self, rhs: u64) -> bool {
        if rhs == 0 { self == 0 } else { self % rhs == 0 }
    }

    /// Reverses the byte order of the integer.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1234567890123456u64;
    /// let m = n.swap_bytes();
    ///
    /// assert_eq(m, 0x5634129078563412);
    /// ```
    #[inline]
    pub fn swap_bytes(self) -> u64 {
        let v = self as u64;
        let mut r: u64 = 0;
        let mut i = 0u32;
        while i < 8 {
            r = (r << 8) | ((v >> (8 * i)) & 255);
            i += 1;
        }
        r as u64
    }
}

impl usize {
    /// Checked negation. Computes `-self`, returning `None` unless `self == 0`.
    ///
    /// Note that negating any positive integer will overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0usize.checked_neg(), Some(0));
    /// assert_eq(1usize.checked_neg(), None);
    /// ```
    #[inline]
    pub fn checked_neg(self) -> Option<usize> {
        let (r, o) = self.overflowing_neg();
        if o { None } else { Some(r) }
    }

    /// Checked exponentiation. Computes `self.pow(exp)`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(8usize.checked_pow(2), Some(64));
    /// assert_eq(usize::MAX.checked_pow(2), None);
    /// ```
    pub fn checked_pow(self, exp: u32) -> Option<usize> {
        if exp == 0 {
            return Some(1);
        }
        let mut base = self;
        let mut acc: usize = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc.checked_mul(base)?;
                if e == 1 {
                    return Some(acc);
                }
            }
            e = e / 2;
            base = base.checked_mul(base)?;
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// Returns a tuple of the exponentiation along with a bool indicating
    /// whether an overflow happened.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3usize.overflowing_pow(4), (81, false));
    /// assert_eq(usize::MAX.overflowing_pow(2), (1, true));
    /// ```
    pub fn overflowing_pow(self, exp: u32) -> (usize, bool) {
        if exp == 0 {
            return (1, false);
        }
        let mut base = self;
        let mut acc: usize = 1;
        let mut e = exp;
        let mut over = false;
        loop {
            if e & 1 == 1 {
                let (r, o) = acc.overflowing_mul(base);
                acc = r;
                over = over || o;
                if e == 1 {
                    return (acc, over);
                }
            }
            e = e / 2;
            let (b, o) = base.overflowing_mul(base);
            base = b;
            over = over || o;
        }
    }

    /// Saturating integer exponentiation. Computes `self.pow(exp)`, saturating
    /// at the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(4usize.saturating_pow(3), 64);
    /// assert_eq(usize::MAX.saturating_pow(2), usize::MAX);
    /// ```
    #[inline]
    pub fn saturating_pow(self, exp: u32) -> usize {
        match self.checked_pow(exp) {
            Some(r) => r,
            None => {
                if false {
                    usize::MIN
                } else {
                    usize::MAX
                }
            }
        }
    }

    /// Checked shift left. Computes `self << rhs`, returning `None` if `rhs` is
    /// larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((0x1 as usize).checked_shl(4), Some(0x10));
    /// assert_eq((0x1 as usize).checked_shl(64), None);
    /// assert_eq((0x10 as usize).checked_shl(63), Some(0));
    /// ```
    #[inline]
    pub fn checked_shl(self, rhs: u32) -> Option<usize> {
        if rhs < 64 { Some(self << rhs) } else { None }
    }

    /// Checked shift right. Computes `self >> rhs`, returning `None` if `rhs`
    /// is larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((0x10 as usize).checked_shr(4), Some(0x1));
    /// assert_eq((0x10 as usize).checked_shr(64), None);
    /// ```
    #[inline]
    pub fn checked_shr(self, rhs: u32) -> Option<usize> {
        if rhs < 64 { Some(self >> rhs) } else { None }
    }

    /// Panic-free bitwise shift-left; yields `self << mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-left; the RHS of a wrapping
    /// shift-left is restricted to the range of the type, rather than the bits
    /// shifted out of the LHS being returned to the other end. The primitive
    /// integer types all implement a `rotate_left` function, which may be what
    /// you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(1usize.wrapping_shl(7), 128);
    /// assert_eq(1usize.wrapping_shl(128), 1);
    /// ```
    #[inline]
    pub fn wrapping_shl(self, rhs: u32) -> usize {
        self << (rhs % 64)
    }

    /// Panic-free bitwise shift-right; yields `self >> mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-right; the RHS of a
    /// wrapping shift-right is restricted to the range of the type, rather than
    /// the bits shifted out of the LHS being returned to the other end. The
    /// primitive integer types all implement a `rotate_right` function, which
    /// may be what you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(128usize.wrapping_shr(7), 1);
    /// assert_eq(128usize.wrapping_shr(128), 128);
    /// ```
    #[inline]
    pub fn wrapping_shr(self, rhs: u32) -> usize {
        self >> (rhs % 64)
    }

    /// Shifts self left by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((0x1 as usize).overflowing_shl(4), (0x10, false));
    /// assert_eq((0x1 as usize).overflowing_shl(68), (0x10, true));
    /// assert_eq((0x10 as usize).overflowing_shl(63), (0, false));
    /// ```
    #[inline]
    pub fn overflowing_shl(self, rhs: u32) -> (usize, bool) {
        (self.wrapping_shl(rhs), rhs >= 64)
    }

    /// Shifts self right by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((0x10 as usize).overflowing_shr(4), (0x1, false));
    /// assert_eq((0x10 as usize).overflowing_shr(68), (0x1, true));
    /// ```
    #[inline]
    pub fn overflowing_shr(self, rhs: u32) -> (usize, bool) {
        (self.wrapping_shr(rhs), rhs >= 64)
    }

    /// Wrapping (modular) division. Computes `self / rhs`.
    ///
    /// Wrapped division on unsigned types is just normal division. There's no
    /// way wrapping could ever happen. This function exists so that all
    /// operations are accounted for in the wrapping operations.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100usize.wrapping_div(10), 10);
    /// ```
    #[inline]
    pub fn wrapping_div(self, rhs: usize) -> usize {
        if false { self } else { self / rhs }
    }

    /// Wrapping (modular) remainder. Computes `self % rhs`.
    ///
    /// Wrapped remainder calculation on unsigned types is just the regular
    /// remainder calculation. There's no way wrapping could ever happen. This
    /// function exists so that all operations are accounted for in the wrapping
    /// operations.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100usize.wrapping_rem(10), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem(self, rhs: usize) -> usize {
        if false { 0 } else { self % rhs }
    }

    /// Calculates the divisor when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the divisor along with a boolean indicating whether
    /// an arithmetic overflow would occur. Note that for unsigned integers
    /// overflow never occurs, so the second value is always `false`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5usize.overflowing_div(2), (2, false));
    /// ```
    #[inline]
    pub fn overflowing_div(self, rhs: usize) -> (usize, bool) {
        if false {
            (self, true)
        } else {
            (self / rhs, false)
        }
    }

    /// Calculates the remainder when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the remainder along with a boolean indicating whether
    /// an arithmetic overflow would occur. Note that for unsigned integers
    /// overflow never occurs, so the second value is always `false`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5usize.overflowing_rem(2), (1, false));
    /// ```
    #[inline]
    pub fn overflowing_rem(self, rhs: usize) -> (usize, bool) {
        if false {
            (0, true)
        } else {
            (self % rhs, false)
        }
    }

    /// Saturating integer division. Computes `self / rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5usize.saturating_div(2), 2);
    /// ```
    #[inline]
    pub fn saturating_div(self, rhs: usize) -> usize {
        if false { usize::MAX } else { self / rhs }
    }

    /// Checked Euclidean division. Computes `self.div_euclid(rhs)`, returning
    /// `None` if `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(128usize.checked_div_euclid(2), Some(64));
    /// assert_eq(1usize.checked_div_euclid(0), None);
    /// ```
    #[inline]
    pub fn checked_div_euclid(self, rhs: usize) -> Option<usize> {
        if rhs == 0 || false {
            None
        } else {
            Some(self.div_euclid(rhs))
        }
    }

    /// Checked Euclidean modulo. Computes `self.rem_euclid(rhs)`, returning
    /// `None` if `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5usize.checked_rem_euclid(2), Some(1));
    /// assert_eq(5usize.checked_rem_euclid(0), None);
    /// ```
    #[inline]
    pub fn checked_rem_euclid(self, rhs: usize) -> Option<usize> {
        if rhs == 0 || false {
            None
        } else {
            Some(self.rem_euclid(rhs))
        }
    }

    /// Wrapping Euclidean division. Computes `self.div_euclid(rhs)`.
    ///
    /// Wrapped division on unsigned types is just normal division. There's no
    /// way wrapping could ever happen. This function exists so that all
    /// operations are accounted for in the wrapping operations. Since, for the
    /// positive integers, all common definitions of division are equal, this is
    /// exactly equal to `self.wrapping_div(rhs)`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100usize.wrapping_div_euclid(10), 10);
    /// ```
    #[inline]
    pub fn wrapping_div_euclid(self, rhs: usize) -> usize {
        if false { self } else { self.div_euclid(rhs) }
    }

    /// Wrapping Euclidean modulo. Computes `self.rem_euclid(rhs)`.
    ///
    /// Wrapped modulo calculation on unsigned types is just the regular
    /// remainder calculation. There's no way wrapping could ever happen. This
    /// function exists so that all operations are accounted for in the wrapping
    /// operations. Since, for the positive integers, all common definitions of
    /// division are equal, this is exactly equal to `self.wrapping_rem(rhs)`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100usize.wrapping_rem_euclid(10), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem_euclid(self, rhs: usize) -> usize {
        if false { 0 } else { self.rem_euclid(rhs) }
    }

    /// Reverses the order of bits in the integer. The least significant bit
    /// becomes the most significant bit, second least-significant bit becomes
    /// second most-significant bit, etc.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = (0x1234567890123456u64 as usize);
    /// let m = n.reverse_bits();
    ///
    /// assert_eq(m, 0x6a2c48091e6a2c48);
    /// assert_eq(0usize.reverse_bits(), 0);
    /// ```
    #[inline]
    pub fn reverse_bits(self) -> usize {
        let v = self;
        let mut r: usize = 0;
        let mut i = 0u32;
        while i < 64 {
            r = (r << 1) | ((v >> i) & 1);
            i += 1;
        }
        r
    }

    /// Converts `self` to big endian from the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = (0x1A as usize);
    ///
    /// assert_eq(n.to_be(), n.swap_bytes());
    /// ```
    #[inline]
    pub fn to_be(self) -> usize {
        self.swap_bytes()
    }

    /// Converts `self` to little endian from the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = (0x1A as usize);
    ///
    /// assert_eq(n.to_le(), n);
    /// ```
    #[inline]
    pub fn to_le(self) -> usize {
        self
    }

    /// Converts an integer from big endian to the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = (0x1A as usize);
    ///
    /// assert_eq(usize::from_be(n), n.swap_bytes());
    /// ```
    #[inline]
    pub fn from_be(x: usize) -> usize {
        x.swap_bytes()
    }

    /// Converts an integer from little endian to the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = (0x1A as usize);
    ///
    /// assert_eq(usize::from_le(n), n);
    /// ```
    #[inline]
    pub fn from_le(x: usize) -> usize {
        x
    }

    /// Returns the memory representation of this integer as a byte array in
    /// big-endian (network) byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = (0x1234567890123456u64 as usize).to_be_bytes();
    /// assert_eq(bytes, [0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56]);
    /// ```
    #[inline]
    pub fn to_be_bytes(self) -> [u8; 8] {
        self.swap_bytes().to_le_bytes()
    }

    /// Creates an integer value from its representation as a byte array in big
    /// endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = usize::from_be_bytes([0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56]);
    /// assert_eq(value, 0x1234567890123456);
    /// ```
    #[inline]
    pub fn from_be_bytes(bytes: [u8; 8]) -> usize {
        usize::from_le_bytes(bytes).swap_bytes()
    }

    /// Returns the memory representation of this integer as a byte array in
    /// native byte order.
    ///
    /// As the target platform's native endianness is used, portable code should
    /// use `to_be_bytes` or `to_le_bytes`, as appropriate, instead. (navi's
    /// targets are all little endian, so this is `to_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = (0x1234567890123456u64 as usize).to_ne_bytes();
    /// assert_eq(bytes, [0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12]);
    /// ```
    #[inline]
    pub fn to_ne_bytes(self) -> [u8; 8] {
        self.to_le_bytes()
    }

    /// Creates an integer value from its memory representation as a byte array
    /// in native endianness.
    ///
    /// As the target platform's native endianness is used, portable code likely
    /// wants to use `from_be_bytes` or `from_le_bytes`, as appropriate instead.
    /// (navi's targets are all little endian, so this is `from_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let value = usize::from_ne_bytes([0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12]);
    /// assert_eq(value, 0x1234567890123456);
    /// ```
    #[inline]
    pub fn from_ne_bytes(bytes: [u8; 8]) -> usize {
        usize::from_le_bytes(bytes)
    }

    /// Returns the number of leading ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = !(usize::MAX >> 2);
    /// assert_eq(n.leading_ones(), 2);
    ///
    /// assert_eq(0usize.leading_ones(), 0);
    /// assert_eq(usize::MAX.leading_ones(), 64);
    /// ```
    #[inline]
    pub fn leading_ones(self) -> u32 {
        (!self).leading_zeros()
    }

    /// Returns the number of trailing ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b1010111usize;
    /// assert_eq(n.trailing_ones(), 3);
    ///
    /// assert_eq(0usize.trailing_ones(), 0);
    /// assert_eq(usize::MAX.trailing_ones(), 64);
    /// ```
    #[inline]
    pub fn trailing_ones(self) -> u32 {
        (!self).trailing_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2usize.ilog2(), 1);
    /// assert_eq(usize::MAX.ilog2(), 63);
    /// ```
    #[track_caller]
    pub fn ilog2(self) -> u32 {
        if self == 0 {
            panic("argument of integer logarithm must be positive");
        }
        64 - 1 - self.leading_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2usize.checked_ilog2(), Some(1));
    /// assert_eq(0usize.checked_ilog2(), None);
    /// ```
    #[inline]
    pub fn checked_ilog2(self) -> Option<u32> {
        if self == 0 {
            None
        } else {
            Some(64 - 1 - self.leading_zeros())
        }
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10usize.ilog10(), 1);
    /// assert_eq(99usize.ilog10(), 1);
    /// assert_eq(usize::MAX.ilog10(), 19);
    /// ```
    #[track_caller]
    pub fn ilog10(self) -> u32 {
        if self == 0 {
            panic("argument of integer logarithm must be positive");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= 10 {
            v = v / 10;
            n += 1;
        }
        n
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10usize.checked_ilog10(), Some(1));
    /// assert_eq(0usize.checked_ilog10(), None);
    /// ```
    #[inline]
    pub fn checked_ilog10(self) -> Option<u32> {
        if self == 0 { None } else { Some(self.ilog10()) }
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `ilog2` can produce results more efficiently for base 2, and `ilog10`
    /// can produce results more efficiently for base 10.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is zero, or if `base` is less than 2.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5usize.ilog(5), 1);
    /// assert_eq(100usize.ilog(3), 4);
    /// ```
    #[track_caller]
    pub fn ilog(self, base: usize) -> u32 {
        if self == 0 {
            panic("argument of integer logarithm must be positive");
        }
        if base < 2 {
            panic("base of integer logarithm must be at least 2");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= base {
            v = v / base;
            n += 1;
        }
        n
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// Returns `None` if the number is zero, or if the base is not at least 2.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `checked_ilog2` can produce results more efficiently for base 2, and
    /// `checked_ilog10` can produce results more efficiently for base 10.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5usize.checked_ilog(5), Some(1));
    /// assert_eq(0usize.checked_ilog(5), None);
    /// assert_eq(5usize.checked_ilog(1), None);
    /// ```
    #[inline]
    pub fn checked_ilog(self, base: usize) -> Option<u32> {
        if self == 0 || base < 2 {
            None
        } else {
            Some(self.ilog(base))
        }
    }

    /// Returns the square root of the number, rounded down.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10usize.isqrt(), 3);
    /// assert_eq(usize::MAX.isqrt(), 4294967295);
    /// ```
    #[track_caller]
    pub fn isqrt(self) -> usize {
        if self < 2 {
            return self;
        }
        let mut x = (self as f64).sqrt() as usize;
        while x > self / x {
            x -= 1;
        }
        while x + 1 <= self / (x + 1) {
            x += 1;
        }
        x
    }

    /// Negates self in a wrapping fashion.
    ///
    /// Returns `!self + 1` using wrapping operations to return the value that
    /// represents the negation of this unsigned value. Note that for positive
    /// unsigned values overflow always occurs, but negating 0 does not
    /// overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0usize.overflowing_neg(), (0, false));
    /// assert_eq(2usize.overflowing_neg(), (usize::MAX - 1, true));
    /// ```
    #[inline]
    pub fn overflowing_neg(self) -> (usize, bool) {
        (self.wrapping_neg(), self != 0)
    }

    /// Performs Euclidean division.
    ///
    /// Since, for the positive integers, all common definitions of division are
    /// equal, this is exactly equal to `self / rhs`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(7usize.div_euclid(4), 1);
    /// ```
    #[track_caller]
    pub fn div_euclid(self, rhs: usize) -> usize {
        self / rhs
    }

    /// Calculates the least remainder of `self (mod rhs)`.
    ///
    /// Since, for the positive integers, all common definitions of division are
    /// equal, this is exactly equal to `self % rhs`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(7usize.rem_euclid(4), 3);
    /// ```
    #[track_caller]
    pub fn rem_euclid(self, rhs: usize) -> usize {
        self % rhs
    }

    /// Returns the smallest power of two greater than or equal to `self`. If
    /// the next power of two is greater than the type's maximum value, `None`
    /// is returned, otherwise the power of two is wrapped in `Some`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2usize.checked_next_power_of_two(), Some(2));
    /// assert_eq(3usize.checked_next_power_of_two(), Some(4));
    /// assert_eq(usize::MAX.checked_next_power_of_two(), None);
    /// ```
    #[inline]
    pub fn checked_next_power_of_two(self) -> Option<usize> {
        if self <= 1 {
            return Some(1);
        }
        let p = 64 - (self - 1).leading_zeros();
        if p >= 64 {
            None
        } else {
            Some((1 as usize) << p)
        }
    }

    /// Calculates the quotient of `self` and `rhs`, rounding the result towards
    /// positive infinity.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(7usize.div_ceil(4), 2);
    /// assert_eq(8usize.div_ceil(4), 2);
    /// ```
    #[track_caller]
    pub fn div_ceil(self, rhs: usize) -> usize {
        let q = self / rhs;
        if self % rhs > 0 { q + 1 } else { q }
    }

    /// Calculates the smallest value greater than or equal to `self` that is a
    /// multiple of `rhs`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero, or if the result overflows
    /// (navi checks integer overflow in every build; Rust only in debug
    /// builds).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(16usize.next_multiple_of(8), 16);
    /// assert_eq(23usize.next_multiple_of(8), 24);
    /// ```
    #[track_caller]
    pub fn next_multiple_of(self, rhs: usize) -> usize {
        let r = self % rhs;
        if r == 0 { self } else { self + (rhs - r) }
    }

    /// Calculates the smallest value greater than or equal to `self` that is a
    /// multiple of `rhs`. Returns `None` if `rhs` is zero or the operation
    /// would result in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(16usize.checked_next_multiple_of(8), Some(16));
    /// assert_eq(23usize.checked_next_multiple_of(8), Some(24));
    /// assert_eq(1usize.checked_next_multiple_of(0), None);
    /// assert_eq(usize::MAX.checked_next_multiple_of(2), None);
    /// ```
    #[inline]
    pub fn checked_next_multiple_of(self, rhs: usize) -> Option<usize> {
        if rhs == 0 {
            return None;
        }
        let r = self % rhs;
        if r == 0 {
            Some(self)
        } else {
            self.checked_add(rhs - r)
        }
    }

    /// Returns `true` if `self` is an integer multiple of `rhs`, and false
    /// otherwise.
    ///
    /// This function is equivalent to `self % rhs == 0`, except that it will
    /// not panic for `rhs == 0`. Instead, `0.is_multiple_of(0) == true`, and
    /// for any non-zero `n`, `n.is_multiple_of(0) == false`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(6usize.is_multiple_of(2));
    /// assert(!5usize.is_multiple_of(2));
    ///
    /// assert(0usize.is_multiple_of(0));
    /// assert(!6usize.is_multiple_of(0));
    /// ```
    #[inline]
    pub fn is_multiple_of(self, rhs: usize) -> bool {
        if rhs == 0 { self == 0 } else { self % rhs == 0 }
    }

    /// Reverses the byte order of the integer.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = (0x1234567890123456u64 as usize);
    /// let m = n.swap_bytes();
    ///
    /// assert_eq(m, 0x5634129078563412);
    /// ```
    #[inline]
    pub fn swap_bytes(self) -> usize {
        let v = self as usize;
        let mut r: usize = 0;
        let mut i = 0u32;
        while i < 8 {
            r = (r << 8) | ((v >> (8 * i)) & 255);
            i += 1;
        }
        r as usize
    }
}

impl u128 {
    /// Checked negation. Computes `-self`, returning `None` unless `self == 0`.
    ///
    /// Note that negating any positive integer will overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u128.checked_neg(), Some(0));
    /// assert_eq(1u128.checked_neg(), None);
    /// ```
    #[inline]
    pub fn checked_neg(self) -> Option<u128> {
        let (r, o) = self.overflowing_neg();
        if o { None } else { Some(r) }
    }

    /// Checked exponentiation. Computes `self.pow(exp)`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(8u128.checked_pow(2), Some(64));
    /// assert_eq(u128::MAX.checked_pow(2), None);
    /// ```
    pub fn checked_pow(self, exp: u32) -> Option<u128> {
        if exp == 0 {
            return Some(1);
        }
        let mut base = self;
        let mut acc: u128 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc.checked_mul(base)?;
                if e == 1 {
                    return Some(acc);
                }
            }
            e = e / 2;
            base = base.checked_mul(base)?;
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// Returns a tuple of the exponentiation along with a bool indicating
    /// whether an overflow happened.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3u128.overflowing_pow(4), (81, false));
    /// assert_eq(u128::MAX.overflowing_pow(2), (1, true));
    /// ```
    pub fn overflowing_pow(self, exp: u32) -> (u128, bool) {
        if exp == 0 {
            return (1, false);
        }
        let mut base = self;
        let mut acc: u128 = 1;
        let mut e = exp;
        let mut over = false;
        loop {
            if e & 1 == 1 {
                let (r, o) = acc.overflowing_mul(base);
                acc = r;
                over = over || o;
                if e == 1 {
                    return (acc, over);
                }
            }
            e = e / 2;
            let (b, o) = base.overflowing_mul(base);
            base = b;
            over = over || o;
        }
    }

    /// Saturating integer exponentiation. Computes `self.pow(exp)`, saturating
    /// at the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(4u128.saturating_pow(3), 64);
    /// assert_eq(u128::MAX.saturating_pow(2), u128::MAX);
    /// ```
    #[inline]
    pub fn saturating_pow(self, exp: u32) -> u128 {
        match self.checked_pow(exp) {
            Some(r) => r,
            None => {
                if false {
                    u128::MIN
                } else {
                    u128::MAX
                }
            }
        }
    }

    /// Checked shift left. Computes `self << rhs`, returning `None` if `rhs` is
    /// larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1u128.checked_shl(4), Some(0x10));
    /// assert_eq(0x1u128.checked_shl(128), None);
    /// assert_eq(0x10u128.checked_shl(127), Some(0));
    /// ```
    #[inline]
    pub fn checked_shl(self, rhs: u32) -> Option<u128> {
        if rhs < 128 { Some(self << rhs) } else { None }
    }

    /// Checked shift right. Computes `self >> rhs`, returning `None` if `rhs`
    /// is larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10u128.checked_shr(4), Some(0x1));
    /// assert_eq(0x10u128.checked_shr(128), None);
    /// ```
    #[inline]
    pub fn checked_shr(self, rhs: u32) -> Option<u128> {
        if rhs < 128 { Some(self >> rhs) } else { None }
    }

    /// Panic-free bitwise shift-left; yields `self << mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-left; the RHS of a wrapping
    /// shift-left is restricted to the range of the type, rather than the bits
    /// shifted out of the LHS being returned to the other end. The primitive
    /// integer types all implement a `rotate_left` function, which may be what
    /// you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(1u128.wrapping_shl(7), 128);
    /// assert_eq(1u128.wrapping_shl(128), 1);
    /// ```
    #[inline]
    pub fn wrapping_shl(self, rhs: u32) -> u128 {
        self << (rhs % 128)
    }

    /// Panic-free bitwise shift-right; yields `self >> mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-right; the RHS of a
    /// wrapping shift-right is restricted to the range of the type, rather than
    /// the bits shifted out of the LHS being returned to the other end. The
    /// primitive integer types all implement a `rotate_right` function, which
    /// may be what you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(128u128.wrapping_shr(7), 1);
    /// assert_eq(128u128.wrapping_shr(128), 128);
    /// ```
    #[inline]
    pub fn wrapping_shr(self, rhs: u32) -> u128 {
        self >> (rhs % 128)
    }

    /// Shifts self left by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1u128.overflowing_shl(4), (0x10, false));
    /// assert_eq(0x1u128.overflowing_shl(132), (0x10, true));
    /// assert_eq(0x10u128.overflowing_shl(127), (0, false));
    /// ```
    #[inline]
    pub fn overflowing_shl(self, rhs: u32) -> (u128, bool) {
        (self.wrapping_shl(rhs), rhs >= 128)
    }

    /// Shifts self right by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10u128.overflowing_shr(4), (0x1, false));
    /// assert_eq(0x10u128.overflowing_shr(132), (0x1, true));
    /// ```
    #[inline]
    pub fn overflowing_shr(self, rhs: u32) -> (u128, bool) {
        (self.wrapping_shr(rhs), rhs >= 128)
    }

    /// Wrapping (modular) division. Computes `self / rhs`.
    ///
    /// Wrapped division on unsigned types is just normal division. There's no
    /// way wrapping could ever happen. This function exists so that all
    /// operations are accounted for in the wrapping operations.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u128.wrapping_div(10), 10);
    /// ```
    #[inline]
    pub fn wrapping_div(self, rhs: u128) -> u128 {
        if false { self } else { self / rhs }
    }

    /// Wrapping (modular) remainder. Computes `self % rhs`.
    ///
    /// Wrapped remainder calculation on unsigned types is just the regular
    /// remainder calculation. There's no way wrapping could ever happen. This
    /// function exists so that all operations are accounted for in the wrapping
    /// operations.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u128.wrapping_rem(10), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem(self, rhs: u128) -> u128 {
        if false { 0 } else { self % rhs }
    }

    /// Calculates the divisor when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the divisor along with a boolean indicating whether
    /// an arithmetic overflow would occur. Note that for unsigned integers
    /// overflow never occurs, so the second value is always `false`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u128.overflowing_div(2), (2, false));
    /// ```
    #[inline]
    pub fn overflowing_div(self, rhs: u128) -> (u128, bool) {
        if false {
            (self, true)
        } else {
            (self / rhs, false)
        }
    }

    /// Calculates the remainder when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the remainder along with a boolean indicating whether
    /// an arithmetic overflow would occur. Note that for unsigned integers
    /// overflow never occurs, so the second value is always `false`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u128.overflowing_rem(2), (1, false));
    /// ```
    #[inline]
    pub fn overflowing_rem(self, rhs: u128) -> (u128, bool) {
        if false {
            (0, true)
        } else {
            (self % rhs, false)
        }
    }

    /// Saturating integer division. Computes `self / rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u128.saturating_div(2), 2);
    /// ```
    #[inline]
    pub fn saturating_div(self, rhs: u128) -> u128 {
        if false { u128::MAX } else { self / rhs }
    }

    /// Checked Euclidean division. Computes `self.div_euclid(rhs)`, returning
    /// `None` if `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(128u128.checked_div_euclid(2), Some(64));
    /// assert_eq(1u128.checked_div_euclid(0), None);
    /// ```
    #[inline]
    pub fn checked_div_euclid(self, rhs: u128) -> Option<u128> {
        if rhs == 0 || false {
            None
        } else {
            Some(self.div_euclid(rhs))
        }
    }

    /// Checked Euclidean modulo. Computes `self.rem_euclid(rhs)`, returning
    /// `None` if `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u128.checked_rem_euclid(2), Some(1));
    /// assert_eq(5u128.checked_rem_euclid(0), None);
    /// ```
    #[inline]
    pub fn checked_rem_euclid(self, rhs: u128) -> Option<u128> {
        if rhs == 0 || false {
            None
        } else {
            Some(self.rem_euclid(rhs))
        }
    }

    /// Wrapping Euclidean division. Computes `self.div_euclid(rhs)`.
    ///
    /// Wrapped division on unsigned types is just normal division. There's no
    /// way wrapping could ever happen. This function exists so that all
    /// operations are accounted for in the wrapping operations. Since, for the
    /// positive integers, all common definitions of division are equal, this is
    /// exactly equal to `self.wrapping_div(rhs)`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u128.wrapping_div_euclid(10), 10);
    /// ```
    #[inline]
    pub fn wrapping_div_euclid(self, rhs: u128) -> u128 {
        if false { self } else { self.div_euclid(rhs) }
    }

    /// Wrapping Euclidean modulo. Computes `self.rem_euclid(rhs)`.
    ///
    /// Wrapped modulo calculation on unsigned types is just the regular
    /// remainder calculation. There's no way wrapping could ever happen. This
    /// function exists so that all operations are accounted for in the wrapping
    /// operations. Since, for the positive integers, all common definitions of
    /// division are equal, this is exactly equal to `self.wrapping_rem(rhs)`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u128.wrapping_rem_euclid(10), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem_euclid(self, rhs: u128) -> u128 {
        if false { 0 } else { self.rem_euclid(rhs) }
    }

    /// Reverses the order of bits in the integer. The least significant bit
    /// becomes the most significant bit, second least-significant bit becomes
    /// second most-significant bit, etc.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = ((0x1234567890123456u128 << 64) | 0x7890123456789012);
    /// let m = n.reverse_bits();
    ///
    /// assert_eq(m, ((0x48091e6a2c48091eu128 << 64) | 0x6a2c48091e6a2c48));
    /// assert_eq(0u128.reverse_bits(), 0);
    /// ```
    #[inline]
    pub fn reverse_bits(self) -> u128 {
        let v = self;
        let mut r: u128 = 0;
        let mut i = 0u32;
        while i < 128 {
            r = (r << 1) | ((v >> i) & 1);
            i += 1;
        }
        r
    }

    /// Converts `self` to big endian from the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au128;
    ///
    /// assert_eq(n.to_be(), n.swap_bytes());
    /// ```
    #[inline]
    pub fn to_be(self) -> u128 {
        self.swap_bytes()
    }

    /// Converts `self` to little endian from the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au128;
    ///
    /// assert_eq(n.to_le(), n);
    /// ```
    #[inline]
    pub fn to_le(self) -> u128 {
        self
    }

    /// Converts an integer from big endian to the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au128;
    ///
    /// assert_eq(u128::from_be(n), n.swap_bytes());
    /// ```
    #[inline]
    pub fn from_be(x: u128) -> u128 {
        x.swap_bytes()
    }

    /// Converts an integer from little endian to the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Au128;
    ///
    /// assert_eq(u128::from_le(n), n);
    /// ```
    #[inline]
    pub fn from_le(x: u128) -> u128 {
        x
    }

    /// Returns the memory representation of this integer as a byte array in
    /// big-endian (network) byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = ((0x1234567890123456u128 << 64) | 0x7890123456789012).to_be_bytes();
    /// assert_eq(
    ///     bytes,
    ///     [
    ///         0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56, 0x78,
    ///         0x90, 0x12,
    ///     ],
    /// );
    /// ```
    #[inline]
    pub fn to_be_bytes(self) -> [u8; 16] {
        self.swap_bytes().to_le_bytes()
    }

    /// Creates an integer value from its representation as a byte array in big
    /// endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = u128::from_be_bytes([
    ///     0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56, 0x78, 0x90,
    ///     0x12,
    /// ]);
    /// assert_eq(value, ((0x1234567890123456u128 << 64) | 0x7890123456789012));
    /// ```
    #[inline]
    pub fn from_be_bytes(bytes: [u8; 16]) -> u128 {
        u128::from_le_bytes(bytes).swap_bytes()
    }

    /// Returns the memory representation of this integer as a byte array in
    /// native byte order.
    ///
    /// As the target platform's native endianness is used, portable code should
    /// use `to_be_bytes` or `to_le_bytes`, as appropriate, instead. (navi's
    /// targets are all little endian, so this is `to_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = ((0x1234567890123456u128 << 64) | 0x7890123456789012).to_ne_bytes();
    /// assert_eq(
    ///     bytes,
    ///     [
    ///         0x12, 0x90, 0x78, 0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12, 0x90, 0x78, 0x56,
    ///         0x34, 0x12,
    ///     ],
    /// );
    /// ```
    #[inline]
    pub fn to_ne_bytes(self) -> [u8; 16] {
        self.to_le_bytes()
    }

    /// Creates an integer value from its memory representation as a byte array
    /// in native endianness.
    ///
    /// As the target platform's native endianness is used, portable code likely
    /// wants to use `from_be_bytes` or `from_le_bytes`, as appropriate instead.
    /// (navi's targets are all little endian, so this is `from_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let value = u128::from_ne_bytes([
    ///     0x12, 0x90, 0x78, 0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34,
    ///     0x12,
    /// ]);
    /// assert_eq(value, ((0x1234567890123456u128 << 64) | 0x7890123456789012));
    /// ```
    #[inline]
    pub fn from_ne_bytes(bytes: [u8; 16]) -> u128 {
        u128::from_le_bytes(bytes)
    }

    /// Returns the number of leading ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = !(u128::MAX >> 2);
    /// assert_eq(n.leading_ones(), 2);
    ///
    /// assert_eq(0u128.leading_ones(), 0);
    /// assert_eq(u128::MAX.leading_ones(), 128);
    /// ```
    #[inline]
    pub fn leading_ones(self) -> u32 {
        (!self).leading_zeros()
    }

    /// Returns the number of trailing ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b1010111u128;
    /// assert_eq(n.trailing_ones(), 3);
    ///
    /// assert_eq(0u128.trailing_ones(), 0);
    /// assert_eq(u128::MAX.trailing_ones(), 128);
    /// ```
    #[inline]
    pub fn trailing_ones(self) -> u32 {
        (!self).trailing_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u128.ilog2(), 1);
    /// assert_eq(u128::MAX.ilog2(), 127);
    /// ```
    #[track_caller]
    pub fn ilog2(self) -> u32 {
        if self == 0 {
            panic("argument of integer logarithm must be positive");
        }
        128 - 1 - self.leading_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u128.checked_ilog2(), Some(1));
    /// assert_eq(0u128.checked_ilog2(), None);
    /// ```
    #[inline]
    pub fn checked_ilog2(self) -> Option<u32> {
        if self == 0 {
            None
        } else {
            Some(128 - 1 - self.leading_zeros())
        }
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u128.ilog10(), 1);
    /// assert_eq(99u128.ilog10(), 1);
    /// assert_eq(u128::MAX.ilog10(), 38);
    /// ```
    #[track_caller]
    pub fn ilog10(self) -> u32 {
        if self == 0 {
            panic("argument of integer logarithm must be positive");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= 10 {
            v = v / 10;
            n += 1;
        }
        n
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u128.checked_ilog10(), Some(1));
    /// assert_eq(0u128.checked_ilog10(), None);
    /// ```
    #[inline]
    pub fn checked_ilog10(self) -> Option<u32> {
        if self == 0 { None } else { Some(self.ilog10()) }
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `ilog2` can produce results more efficiently for base 2, and `ilog10`
    /// can produce results more efficiently for base 10.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is zero, or if `base` is less than 2.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u128.ilog(5), 1);
    /// assert_eq(100u128.ilog(3), 4);
    /// ```
    #[track_caller]
    pub fn ilog(self, base: u128) -> u32 {
        if self == 0 {
            panic("argument of integer logarithm must be positive");
        }
        if base < 2 {
            panic("base of integer logarithm must be at least 2");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= base {
            v = v / base;
            n += 1;
        }
        n
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// Returns `None` if the number is zero, or if the base is not at least 2.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `checked_ilog2` can produce results more efficiently for base 2, and
    /// `checked_ilog10` can produce results more efficiently for base 10.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u128.checked_ilog(5), Some(1));
    /// assert_eq(0u128.checked_ilog(5), None);
    /// assert_eq(5u128.checked_ilog(1), None);
    /// ```
    #[inline]
    pub fn checked_ilog(self, base: u128) -> Option<u32> {
        if self == 0 || base < 2 {
            None
        } else {
            Some(self.ilog(base))
        }
    }

    /// Returns the square root of the number, rounded down.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u128.isqrt(), 3);
    /// assert_eq(u128::MAX.isqrt(), 18446744073709551615);
    /// ```
    #[track_caller]
    pub fn isqrt(self) -> u128 {
        if self < 2 {
            return self;
        }
        let mut x = (self as f64).sqrt() as u128;
        while x > self / x {
            x -= 1;
        }
        while x + 1 <= self / (x + 1) {
            x += 1;
        }
        x
    }

    /// Negates self in a wrapping fashion.
    ///
    /// Returns `!self + 1` using wrapping operations to return the value that
    /// represents the negation of this unsigned value. Note that for positive
    /// unsigned values overflow always occurs, but negating 0 does not
    /// overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u128.overflowing_neg(), (0, false));
    /// assert_eq(2u128.overflowing_neg(), (u128::MAX - 1, true));
    /// ```
    #[inline]
    pub fn overflowing_neg(self) -> (u128, bool) {
        (self.wrapping_neg(), self != 0)
    }

    /// Performs Euclidean division.
    ///
    /// Since, for the positive integers, all common definitions of division are
    /// equal, this is exactly equal to `self / rhs`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(7u128.div_euclid(4), 1);
    /// ```
    #[track_caller]
    pub fn div_euclid(self, rhs: u128) -> u128 {
        self / rhs
    }

    /// Calculates the least remainder of `self (mod rhs)`.
    ///
    /// Since, for the positive integers, all common definitions of division are
    /// equal, this is exactly equal to `self % rhs`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(7u128.rem_euclid(4), 3);
    /// ```
    #[track_caller]
    pub fn rem_euclid(self, rhs: u128) -> u128 {
        self % rhs
    }

    /// Returns the smallest power of two greater than or equal to `self`. If
    /// the next power of two is greater than the type's maximum value, `None`
    /// is returned, otherwise the power of two is wrapped in `Some`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u128.checked_next_power_of_two(), Some(2));
    /// assert_eq(3u128.checked_next_power_of_two(), Some(4));
    /// assert_eq(u128::MAX.checked_next_power_of_two(), None);
    /// ```
    #[inline]
    pub fn checked_next_power_of_two(self) -> Option<u128> {
        if self <= 1 {
            return Some(1);
        }
        let p = 128 - (self - 1).leading_zeros();
        if p >= 128 {
            None
        } else {
            Some((1 as u128) << p)
        }
    }

    /// Calculates the quotient of `self` and `rhs`, rounding the result towards
    /// positive infinity.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(7u128.div_ceil(4), 2);
    /// assert_eq(8u128.div_ceil(4), 2);
    /// ```
    #[track_caller]
    pub fn div_ceil(self, rhs: u128) -> u128 {
        let q = self / rhs;
        if self % rhs > 0 { q + 1 } else { q }
    }

    /// Calculates the smallest value greater than or equal to `self` that is a
    /// multiple of `rhs`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero, or if the result overflows
    /// (navi checks integer overflow in every build; Rust only in debug
    /// builds).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(16u128.next_multiple_of(8), 16);
    /// assert_eq(23u128.next_multiple_of(8), 24);
    /// ```
    #[track_caller]
    pub fn next_multiple_of(self, rhs: u128) -> u128 {
        let r = self % rhs;
        if r == 0 { self } else { self + (rhs - r) }
    }

    /// Calculates the smallest value greater than or equal to `self` that is a
    /// multiple of `rhs`. Returns `None` if `rhs` is zero or the operation
    /// would result in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(16u128.checked_next_multiple_of(8), Some(16));
    /// assert_eq(23u128.checked_next_multiple_of(8), Some(24));
    /// assert_eq(1u128.checked_next_multiple_of(0), None);
    /// assert_eq(u128::MAX.checked_next_multiple_of(2), None);
    /// ```
    #[inline]
    pub fn checked_next_multiple_of(self, rhs: u128) -> Option<u128> {
        if rhs == 0 {
            return None;
        }
        let r = self % rhs;
        if r == 0 {
            Some(self)
        } else {
            self.checked_add(rhs - r)
        }
    }

    /// Returns `true` if `self` is an integer multiple of `rhs`, and false
    /// otherwise.
    ///
    /// This function is equivalent to `self % rhs == 0`, except that it will
    /// not panic for `rhs == 0`. Instead, `0.is_multiple_of(0) == true`, and
    /// for any non-zero `n`, `n.is_multiple_of(0) == false`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(6u128.is_multiple_of(2));
    /// assert(!5u128.is_multiple_of(2));
    ///
    /// assert(0u128.is_multiple_of(0));
    /// assert(!6u128.is_multiple_of(0));
    /// ```
    #[inline]
    pub fn is_multiple_of(self, rhs: u128) -> bool {
        if rhs == 0 { self == 0 } else { self % rhs == 0 }
    }

    /// Checked integer remainder. Computes `self % rhs`, returning `None` if
    /// `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u128.checked_rem(2), Some(1));
    /// assert_eq(5u128.checked_rem(0), None);
    /// ```
    #[inline]
    pub fn checked_rem(self, rhs: u128) -> Option<u128> {
        if rhs == 0 || false {
            None
        } else {
            Some(self % rhs)
        }
    }

    /// Saturating integer multiplication. Computes `self * rhs`, saturating at
    /// the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u128.saturating_mul(10), 20);
    /// assert_eq(u128::MAX.saturating_mul(10), u128::MAX);
    /// ```
    #[inline]
    pub fn saturating_mul(self, rhs: u128) -> u128 {
        match self.checked_mul(rhs) {
            Some(r) => r,
            None => {
                if false {
                    u128::MIN
                } else {
                    u128::MAX
                }
            }
        }
    }

    /// Wrapping (modular) exponentiation. Computes `self.pow(exp)`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3u128.wrapping_pow(4), 81);
    /// assert_eq(u128::MAX.wrapping_pow(2), 1);
    /// ```
    #[inline]
    pub fn wrapping_pow(self, exp: u32) -> u128 {
        self.overflowing_pow(exp).0
    }

    /// Returns the number of zeros in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u128.count_zeros(), 128);
    /// assert_eq(u128::MAX.count_zeros(), 0);
    /// ```
    #[inline]
    pub fn count_zeros(self) -> u32 {
        128 - self.count_ones()
    }

    /// Shifts the bits to the left by a specified amount, `n`, wrapping the
    /// truncated bits to the end of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `<<` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = ((0x13f4000000000000u128 << 64) | 0x4f76);
    /// let m = 0x4f7613f4;
    ///
    /// assert_eq(n.rotate_left(16), m);
    /// ```
    #[inline]
    pub fn rotate_left(self, n: u32) -> u128 {
        let v = self;
        let k = n % 128;
        if k == 0 {
            return self;
        }
        ((v << k) | (v >> (128 - k)))
    }

    /// Shifts the bits to the right by a specified amount, `n`, wrapping the
    /// truncated bits to the beginning of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `>>` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x4f7613f4u128;
    /// let m = ((0x13f4000000000000u128 << 64) | 0x4f76);
    ///
    /// assert_eq(n.rotate_right(16), m);
    /// ```
    #[inline]
    pub fn rotate_right(self, n: u32) -> u128 {
        let k = n % 128;
        if k == 0 {
            return self;
        }
        self.rotate_left(128 - k)
    }

    /// Returns the memory representation of this integer as a byte array in
    /// little-endian byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = ((0x1234567890123456u128 << 64) | 0x7890123456789012).to_le_bytes();
    /// assert_eq(
    ///     bytes,
    ///     [
    ///         0x12, 0x90, 0x78, 0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12, 0x90, 0x78, 0x56,
    ///         0x34, 0x12,
    ///     ],
    /// );
    /// ```
    pub fn to_le_bytes(self) -> [u8; 16] {
        let mut out = [0u8; 16];
        let lo = self as u64;
        let hi = (self >> 64) as u64;
        let mut i = 0;
        while i < 8 {
            out[i] = ((lo >> (8 * i as u32)) & 255) as u8;
            out[i + 8] = ((hi >> (8 * i as u32)) & 255) as u8;
            i += 1;
        }
        out
    }

    /// Creates an integer value from its representation as a byte array in
    /// little endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = u128::from_le_bytes([
    ///     0x12, 0x90, 0x78, 0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34,
    ///     0x12,
    /// ]);
    /// assert_eq(value, ((0x1234567890123456u128 << 64) | 0x7890123456789012));
    /// ```
    pub fn from_le_bytes(bytes: [u8; 16]) -> u128 {
        let mut lo: u64 = 0;
        let mut hi: u64 = 0;
        let mut i = 8;
        while i > 0 {
            i -= 1;
            lo = (lo << 8) | bytes[i] as u64;
            hi = (hi << 8) | bytes[i + 8] as u64;
        }
        (((hi as u128) << 64) | lo as u128)
    }

    /// Reverses the byte order of the integer.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = ((0x1234567890123456u128 << 64) | 0x7890123456789012);
    /// let m = n.swap_bytes();
    ///
    /// assert_eq(m, ((0x1290785634129078u128 << 64) | 0x5634129078563412));
    /// ```
    #[inline]
    pub fn swap_bytes(self) -> u128 {
        let lo = self as u64;
        let hi = (self >> 64) as u64;
        (((lo.swap_bytes() as u128) << 64) | hi.swap_bytes() as u128)
    }

    /// Parses an integer from a string slice with digits in the given base.
    ///
    /// The string is expected to be an optional `+` sign followed by only
    /// digits. Leading and trailing non-digit characters (including whitespace)
    /// represent an error. Underscores (which can appear in literals) also
    /// represent an error.
    ///
    /// Digits are a subset of these characters, depending on `radix`: `0-9`,
    /// `a-z`, `A-Z`.
    ///
    /// `radix` must be in the range from 2 to 36; unlike Rust, which panics
    /// otherwise, navi does not check it.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u128::from_str_radix("A", 16), Ok(10));
    /// assert_eq(u128::from_str_radix("+1111", 2), Ok(15));
    /// assert(u128::from_str_radix("12 ", 10).is_err());
    /// assert(u128::from_str_radix("340282366920938463463374607431768211456", 10).is_err());
    /// ```
    pub fn from_str_radix(src: &str, radix: u32) -> Result<u128, ParseIntError> {
        match parse_radix128(src, radix, false) {
            Some((neg, mag)) => {
                let max = u128::MAX;
                if neg {
                    if mag > max + 1 {
                        return Err(ParseIntError);
                    }
                    Ok((0u128.wrapping_sub(mag)))
                } else {
                    if mag > max {
                        return Err(ParseIntError);
                    }
                    Ok((mag))
                }
            }
            None => Err(ParseIntError),
        }
    }

    /// Wrapping (modular) negation. Computes `-self`, wrapping around at the
    /// boundary of the type.
    ///
    /// Since unsigned types do not have negative equivalents all applications
    /// of this function will wrap (except for `-0`). For values smaller than
    /// the corresponding signed type's maximum the result is the same as
    /// casting the corresponding signed value. Any larger values are equivalent
    /// to `MAX + 1 - (val - MAX - 1)` where `MAX` is the corresponding signed
    /// type's maximum.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u128.wrapping_neg(), 0);
    /// assert_eq(u128::MAX.wrapping_neg(), 1);
    /// assert_eq(13u128.wrapping_neg(), (!13) + 1);
    /// assert_eq(42u128.wrapping_neg(), !(42 - 1));
    /// ```
    #[inline]
    pub fn wrapping_neg(self) -> u128 {
        (0 as u128).wrapping_sub(self)
    }

    /// Returns the smallest power of two greater than or equal to `self`.
    ///
    /// When the return value overflows (that is, `self > (1 << 127)`), it is 0
    /// (the only situation in which this method can return 0); Rust panics
    /// there in debug builds.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u128.next_power_of_two(), 2);
    /// assert_eq(3u128.next_power_of_two(), 4);
    /// assert_eq(0u128.next_power_of_two(), 1);
    /// ```
    #[inline]
    pub fn next_power_of_two(self) -> u128 {
        match self.checked_next_power_of_two() {
            Some(p) => p,
            None => 0,
        }
    }

    /// Computes the absolute difference between `self` and `other`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u128.abs_diff(80), 20);
    /// assert_eq(100u128.abs_diff(110), 10);
    /// assert_eq(0u128.abs_diff(u128::MAX), u128::MAX);
    /// ```
    #[inline]
    pub fn abs_diff(self, other: u128) -> u128 {
        if self > other {
            self - other
        } else {
            other - self
        }
    }
}

impl i128 {
    /// Checked negation. Computes `-self`, returning `None` if `self == MIN`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i128.checked_neg(), Some(-5));
    /// assert_eq(i128::MIN.checked_neg(), None);
    /// ```
    #[inline]
    pub fn checked_neg(self) -> Option<i128> {
        let (r, o) = self.overflowing_neg();
        if o { None } else { Some(r) }
    }

    /// Checked exponentiation. Computes `self.pow(exp)`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(8i128.checked_pow(2), Some(64));
    /// assert_eq(i128::MAX.checked_pow(2), None);
    /// ```
    pub fn checked_pow(self, exp: u32) -> Option<i128> {
        if exp == 0 {
            return Some(1);
        }
        let mut base = self;
        let mut acc: i128 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc.checked_mul(base)?;
                if e == 1 {
                    return Some(acc);
                }
            }
            e = e / 2;
            base = base.checked_mul(base)?;
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// Returns a tuple of the exponentiation along with a bool indicating
    /// whether an overflow happened.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3i128.overflowing_pow(4), (81, false));
    /// assert_eq(i128::MAX.overflowing_pow(2), (1, true));
    /// ```
    pub fn overflowing_pow(self, exp: u32) -> (i128, bool) {
        if exp == 0 {
            return (1, false);
        }
        let mut base = self;
        let mut acc: i128 = 1;
        let mut e = exp;
        let mut over = false;
        loop {
            if e & 1 == 1 {
                let (r, o) = acc.overflowing_mul(base);
                acc = r;
                over = over || o;
                if e == 1 {
                    return (acc, over);
                }
            }
            e = e / 2;
            let (b, o) = base.overflowing_mul(base);
            base = b;
            over = over || o;
        }
    }

    /// Saturating integer exponentiation. Computes `self.pow(exp)`, saturating
    /// at the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-4i128).saturating_pow(3), -64);
    /// assert_eq(i128::MIN.saturating_pow(2), i128::MAX);
    /// assert_eq(i128::MIN.saturating_pow(3), i128::MIN);
    /// ```
    #[inline]
    pub fn saturating_pow(self, exp: u32) -> i128 {
        match self.checked_pow(exp) {
            Some(r) => r,
            None => {
                if self < 0 && exp % 2 == 1 {
                    i128::MIN
                } else {
                    i128::MAX
                }
            }
        }
    }

    /// Checked shift left. Computes `self << rhs`, returning `None` if `rhs` is
    /// larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1i128.checked_shl(4), Some(0x10));
    /// assert_eq(0x1i128.checked_shl(128), None);
    /// assert_eq(0x10i128.checked_shl(127), Some(0));
    /// ```
    #[inline]
    pub fn checked_shl(self, rhs: u32) -> Option<i128> {
        if rhs < 128 { Some(self << rhs) } else { None }
    }

    /// Checked shift right. Computes `self >> rhs`, returning `None` if `rhs`
    /// is larger than or equal to the number of bits in `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10i128.checked_shr(4), Some(0x1));
    /// assert_eq(0x10i128.checked_shr(128), None);
    /// ```
    #[inline]
    pub fn checked_shr(self, rhs: u32) -> Option<i128> {
        if rhs < 128 { Some(self >> rhs) } else { None }
    }

    /// Panic-free bitwise shift-left; yields `self << mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-left; the RHS of a wrapping
    /// shift-left is restricted to the range of the type, rather than the bits
    /// shifted out of the LHS being returned to the other end. The primitive
    /// integer types all implement a `rotate_left` function, which may be what
    /// you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-1i128).wrapping_shl(7), -128);
    /// assert_eq((-1i128).wrapping_shl(128), -1);
    /// ```
    #[inline]
    pub fn wrapping_shl(self, rhs: u32) -> i128 {
        self << (rhs % 128)
    }

    /// Panic-free bitwise shift-right; yields `self >> mask(rhs)`, where `mask`
    /// removes any high-order bits of `rhs` that would cause the shift to
    /// exceed the bitwidth of the type.
    ///
    /// Note that this is *not* the same as a rotate-right; the RHS of a
    /// wrapping shift-right is restricted to the range of the type, rather than
    /// the bits shifted out of the LHS being returned to the other end. The
    /// primitive integer types all implement a `rotate_right` function, which
    /// may be what you want instead.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-128i128).wrapping_shr(7), -1);
    /// assert_eq((-128i128).wrapping_shr(128), -128);
    /// ```
    #[inline]
    pub fn wrapping_shr(self, rhs: u32) -> i128 {
        self >> (rhs % 128)
    }

    /// Shifts self left by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x1i128.overflowing_shl(4), (0x10, false));
    /// assert_eq(0x1i128.overflowing_shl(132), (0x10, true));
    /// assert_eq(0x10i128.overflowing_shl(127), (0, false));
    /// ```
    #[inline]
    pub fn overflowing_shl(self, rhs: u32) -> (i128, bool) {
        (self.wrapping_shl(rhs), rhs >= 128)
    }

    /// Shifts self right by `rhs` bits.
    ///
    /// Returns a tuple of the shifted version of self along with a boolean
    /// indicating whether the shift value was larger than or equal to the
    /// number of bits. If the shift value is too large, then value is masked
    /// (N-1) where N is the number of bits, and this value is then used to
    /// perform the shift.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0x10i128.overflowing_shr(4), (0x1, false));
    /// assert_eq(0x10i128.overflowing_shr(132), (0x1, true));
    /// ```
    #[inline]
    pub fn overflowing_shr(self, rhs: u32) -> (i128, bool) {
        (self.wrapping_shr(rhs), rhs >= 128)
    }

    /// Wrapping (modular) division. Computes `self / rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// The only case where such wrapping can occur is when one divides `MIN /
    /// -1` on a signed type (where `MIN` is the negative minimal value for the
    /// type); this is equivalent to `-MIN`, a positive value that is too large
    /// to represent in the type. In such a case, this function returns `MIN`
    /// itself.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i128.wrapping_div(10), 10);
    /// assert_eq(i128::MIN.wrapping_div(-1), i128::MIN);
    /// ```
    #[inline]
    pub fn wrapping_div(self, rhs: i128) -> i128 {
        if self == i128::MIN && rhs == -1 {
            self
        } else {
            self / rhs
        }
    }

    /// Wrapping (modular) remainder. Computes `self % rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// Such wrap-around never actually occurs mathematically; implementation
    /// artifacts make `x % y` invalid for `MIN / -1` on a signed type (where
    /// `MIN` is the negative minimal value). In such a case, this function
    /// returns `0`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i128.wrapping_rem(10), 0);
    /// assert_eq(i128::MIN.wrapping_rem(-1), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem(self, rhs: i128) -> i128 {
        if self == i128::MIN && rhs == -1 {
            0
        } else {
            self % rhs
        }
    }

    /// Calculates the divisor when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the divisor along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would occur then self
    /// is returned.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i128.overflowing_div(2), (2, false));
    /// assert_eq(i128::MIN.overflowing_div(-1), (i128::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_div(self, rhs: i128) -> (i128, bool) {
        if self == i128::MIN && rhs == -1 {
            (self, true)
        } else {
            (self / rhs, false)
        }
    }

    /// Calculates the remainder when `self` is divided by `rhs`.
    ///
    /// Returns a tuple of the remainder along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would occur then 0 is
    /// returned.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i128.overflowing_rem(2), (1, false));
    /// assert_eq(i128::MIN.overflowing_rem(-1), (0, true));
    /// ```
    #[inline]
    pub fn overflowing_rem(self, rhs: i128) -> (i128, bool) {
        if self == i128::MIN && rhs == -1 {
            (0, true)
        } else {
            (self % rhs, false)
        }
    }

    /// Saturating integer division. Computes `self / rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i128.saturating_div(2), 2);
    /// assert_eq(i128::MAX.saturating_div(-1), i128::MIN + 1);
    /// assert_eq(i128::MIN.saturating_div(-1), i128::MAX);
    /// ```
    #[inline]
    pub fn saturating_div(self, rhs: i128) -> i128 {
        if self == i128::MIN && rhs == -1 {
            i128::MAX
        } else {
            self / rhs
        }
    }

    /// Checked Euclidean division. Computes `self.div_euclid(rhs)`, returning
    /// `None` if `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i128::MIN + 1).checked_div_euclid(-1), Some(i128::MAX));
    /// assert_eq(i128::MIN.checked_div_euclid(-1), None);
    /// assert_eq(1i128.checked_div_euclid(0), None);
    /// ```
    #[inline]
    pub fn checked_div_euclid(self, rhs: i128) -> Option<i128> {
        if rhs == 0 || self == i128::MIN && rhs == -1 {
            None
        } else {
            Some(self.div_euclid(rhs))
        }
    }

    /// Checked Euclidean remainder. Computes `self.rem_euclid(rhs)`, returning
    /// `None` if `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i128.checked_rem_euclid(2), Some(1));
    /// assert_eq(5i128.checked_rem_euclid(0), None);
    /// assert_eq(i128::MIN.checked_rem_euclid(-1), None);
    /// ```
    #[inline]
    pub fn checked_rem_euclid(self, rhs: i128) -> Option<i128> {
        if rhs == 0 || self == i128::MIN && rhs == -1 {
            None
        } else {
            Some(self.rem_euclid(rhs))
        }
    }

    /// Wrapping Euclidean division. Computes `self.div_euclid(rhs)`, wrapping
    /// around at the boundary of the type.
    ///
    /// Wrapping will only occur in `MIN / -1` on a signed type (where `MIN` is
    /// the negative minimal value for the type). This is equivalent to `-MIN`,
    /// a positive value that is too large to represent in the type. In this
    /// case, this method returns `MIN` itself.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i128.wrapping_div_euclid(10), 10);
    /// assert_eq(i128::MIN.wrapping_div_euclid(-1), i128::MIN);
    /// ```
    #[inline]
    pub fn wrapping_div_euclid(self, rhs: i128) -> i128 {
        if self == i128::MIN && rhs == -1 {
            self
        } else {
            self.div_euclid(rhs)
        }
    }

    /// Wrapping Euclidean remainder. Computes `self.rem_euclid(rhs)`, wrapping
    /// around at the boundary of the type.
    ///
    /// Wrapping will only occur in `MIN % -1` on a signed type (where `MIN` is
    /// the negative minimal value for the type). In this case, this method
    /// returns 0.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i128.wrapping_rem_euclid(10), 0);
    /// assert_eq(i128::MIN.wrapping_rem_euclid(-1), 0);
    /// ```
    #[inline]
    pub fn wrapping_rem_euclid(self, rhs: i128) -> i128 {
        if self == i128::MIN && rhs == -1 {
            0
        } else {
            self.rem_euclid(rhs)
        }
    }

    /// Reverses the order of bits in the integer. The least significant bit
    /// becomes the most significant bit, second least-significant bit becomes
    /// second most-significant bit, etc.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = ((0x1234567890123456i128 << 64) | 0x7890123456789012);
    /// let m = n.reverse_bits();
    ///
    /// assert_eq(m, ((0x48091e6a2c48091ei128 << 64) | 0x6a2c48091e6a2c48));
    /// assert_eq(0i128.reverse_bits(), 0);
    /// ```
    #[inline]
    pub fn reverse_bits(self) -> i128 {
        let v = self as u128;
        let mut r: u128 = 0;
        let mut i = 0u32;
        while i < 128 {
            r = (r << 1) | ((v >> i) & 1);
            i += 1;
        }
        r as i128
    }

    /// Converts `self` to big endian from the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai128;
    ///
    /// assert_eq(n.to_be(), n.swap_bytes());
    /// ```
    #[inline]
    pub fn to_be(self) -> i128 {
        self.swap_bytes()
    }

    /// Converts `self` to little endian from the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai128;
    ///
    /// assert_eq(n.to_le(), n);
    /// ```
    #[inline]
    pub fn to_le(self) -> i128 {
        self
    }

    /// Converts an integer from big endian to the target's endianness.
    ///
    /// On big endian this is a no-op. On little endian the bytes are swapped
    /// (navi's targets are all little endian).
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai128;
    ///
    /// assert_eq(i128::from_be(n), n.swap_bytes());
    /// ```
    #[inline]
    pub fn from_be(x: i128) -> i128 {
        x.swap_bytes()
    }

    /// Converts an integer from little endian to the target's endianness.
    ///
    /// On little endian this is a no-op (navi's targets are all little endian).
    /// On big endian the bytes are swapped.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x1Ai128;
    ///
    /// assert_eq(i128::from_le(n), n);
    /// ```
    #[inline]
    pub fn from_le(x: i128) -> i128 {
        x
    }

    /// Returns the memory representation of this integer as a byte array in
    /// big-endian (network) byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = ((0x1234567890123456i128 << 64) | 0x7890123456789012).to_be_bytes();
    /// assert_eq(
    ///     bytes,
    ///     [
    ///         0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56, 0x78,
    ///         0x90, 0x12,
    ///     ],
    /// );
    /// ```
    #[inline]
    pub fn to_be_bytes(self) -> [u8; 16] {
        self.swap_bytes().to_le_bytes()
    }

    /// Creates an integer value from its representation as a byte array in big
    /// endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = i128::from_be_bytes([
    ///     0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56, 0x78, 0x90,
    ///     0x12,
    /// ]);
    /// assert_eq(value, ((0x1234567890123456i128 << 64) | 0x7890123456789012));
    /// ```
    #[inline]
    pub fn from_be_bytes(bytes: [u8; 16]) -> i128 {
        i128::from_le_bytes(bytes).swap_bytes()
    }

    /// Returns the memory representation of this integer as a byte array in
    /// native byte order.
    ///
    /// As the target platform's native endianness is used, portable code should
    /// use `to_be_bytes` or `to_le_bytes`, as appropriate, instead. (navi's
    /// targets are all little endian, so this is `to_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = ((0x1234567890123456i128 << 64) | 0x7890123456789012).to_ne_bytes();
    /// assert_eq(
    ///     bytes,
    ///     [
    ///         0x12, 0x90, 0x78, 0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12, 0x90, 0x78, 0x56,
    ///         0x34, 0x12,
    ///     ],
    /// );
    /// ```
    #[inline]
    pub fn to_ne_bytes(self) -> [u8; 16] {
        self.to_le_bytes()
    }

    /// Creates an integer value from its memory representation as a byte array
    /// in native endianness.
    ///
    /// As the target platform's native endianness is used, portable code likely
    /// wants to use `from_be_bytes` or `from_le_bytes`, as appropriate instead.
    /// (navi's targets are all little endian, so this is `from_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let value = i128::from_ne_bytes([
    ///     0x12, 0x90, 0x78, 0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34,
    ///     0x12,
    /// ]);
    /// assert_eq(value, ((0x1234567890123456i128 << 64) | 0x7890123456789012));
    /// ```
    #[inline]
    pub fn from_ne_bytes(bytes: [u8; 16]) -> i128 {
        i128::from_le_bytes(bytes)
    }

    /// Returns the number of leading ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-1i128).leading_ones(), 128);
    /// assert_eq(i128::MIN.leading_ones(), 1);
    /// assert_eq(1i128.leading_ones(), 0);
    /// ```
    #[inline]
    pub fn leading_ones(self) -> u32 {
        (!self).leading_zeros()
    }

    /// Returns the number of trailing ones in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3i128.trailing_ones(), 2);
    /// assert_eq((-1i128).trailing_ones(), 128);
    /// assert_eq(i128::MIN.trailing_ones(), 0);
    /// ```
    #[inline]
    pub fn trailing_ones(self) -> u32 {
        (!self).trailing_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is less than or equal to zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2i128.ilog2(), 1);
    /// assert_eq(i128::MAX.ilog2(), 126);
    /// ```
    #[track_caller]
    pub fn ilog2(self) -> u32 {
        if self <= 0 {
            panic("argument of integer logarithm must be positive");
        }
        128 - 1 - self.leading_zeros()
    }

    /// Returns the base 2 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is negative or zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2i128.checked_ilog2(), Some(1));
    /// assert_eq(0i128.checked_ilog2(), None);
    /// ```
    #[inline]
    pub fn checked_ilog2(self) -> Option<u32> {
        if self <= 0 {
            None
        } else {
            Some(128 - 1 - self.leading_zeros())
        }
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is less than or equal to zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i128.ilog10(), 1);
    /// assert_eq(99i128.ilog10(), 1);
    /// assert_eq(i128::MAX.ilog10(), 38);
    /// ```
    #[track_caller]
    pub fn ilog10(self) -> u32 {
        if self <= 0 {
            panic("argument of integer logarithm must be positive");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= 10 {
            v = v / 10;
            n += 1;
        }
        n
    }

    /// Returns the base 10 logarithm of the number, rounded down.
    ///
    /// Returns `None` if the number is negative or zero.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i128.checked_ilog10(), Some(1));
    /// assert_eq(0i128.checked_ilog10(), None);
    /// ```
    #[inline]
    pub fn checked_ilog10(self) -> Option<u32> {
        if self <= 0 { None } else { Some(self.ilog10()) }
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `ilog2` can produce results more efficiently for base 2, and `ilog10`
    /// can produce results more efficiently for base 10.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is less than or equal to zero, or if
    /// `base` is less than 2.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i128.ilog(5), 1);
    /// assert_eq(100i128.ilog(3), 4);
    /// ```
    #[track_caller]
    pub fn ilog(self, base: i128) -> u32 {
        if self <= 0 {
            panic("argument of integer logarithm must be positive");
        }
        if base < 2 {
            panic("base of integer logarithm must be at least 2");
        }
        let mut n = 0u32;
        let mut v = self;
        while v >= base {
            v = v / base;
            n += 1;
        }
        n
    }

    /// Returns the logarithm of the number with respect to an arbitrary base,
    /// rounded down.
    ///
    /// Returns `None` if the number is negative or zero, or if the base is not
    /// at least 2.
    ///
    /// This method might not be optimized owing to implementation details;
    /// `checked_ilog2` can produce results more efficiently for base 2, and
    /// `checked_ilog10` can produce results more efficiently for base 10.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i128.checked_ilog(5), Some(1));
    /// assert_eq(0i128.checked_ilog(5), None);
    /// assert_eq(5i128.checked_ilog(1), None);
    /// ```
    #[inline]
    pub fn checked_ilog(self, base: i128) -> Option<u32> {
        if self <= 0 || base < 2 {
            None
        } else {
            Some(self.ilog(base))
        }
    }

    /// Returns the square root of the number, rounded down.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is negative.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i128.isqrt(), 3);
    /// assert_eq(i128::MAX.isqrt(), 13043817825332782212);
    /// ```
    #[track_caller]
    pub fn isqrt(self) -> i128 {
        if self < 0 {
            panic("argument of integer square root cannot be negative");
        }
        if self < 2 {
            return self;
        }
        let mut x = (self as f64).sqrt() as i128;
        while x > self / x {
            x -= 1;
        }
        while x + 1 <= self / (x + 1) {
            x += 1;
        }
        x
    }

    /// Negates self, overflowing if this is equal to the minimum value.
    ///
    /// Returns a tuple of the negated version of self along with a boolean
    /// indicating whether an overflow happened. If `self` is the minimum value
    /// (`i128::MIN`), then the minimum value will be returned again and `true`
    /// will be returned for an overflow happening.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2i128.overflowing_neg(), (-2, false));
    /// assert_eq(i128::MIN.overflowing_neg(), (i128::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_neg(self) -> (i128, bool) {
        if self == i128::MIN {
            (self, true)
        } else {
            (-self, false)
        }
    }

    /// Checked absolute value. Computes `self.abs()`, returning `None` if `self
    /// == MIN`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-5i128).checked_abs(), Some(5));
    /// assert_eq(i128::MIN.checked_abs(), None);
    /// ```
    #[inline]
    pub fn checked_abs(self) -> Option<i128> {
        if self == i128::MIN {
            None
        } else {
            Some(self.abs())
        }
    }

    /// Computes the absolute value of `self`.
    ///
    /// Returns a tuple of the absolute version of self along with a boolean
    /// indicating whether an overflow happened. If self is the minimum value
    /// (`i128::MIN`), then the minimum value will be returned again and true
    /// will be returned for an overflow happening.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i128.overflowing_abs(), (10, false));
    /// assert_eq((-10i128).overflowing_abs(), (10, false));
    /// assert_eq(i128::MIN.overflowing_abs(), (i128::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_abs(self) -> (i128, bool) {
        (self.wrapping_abs(), self == i128::MIN)
    }

    /// Saturating absolute value. Computes `self.abs()`, returning `MAX` if
    /// `self == MIN` instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i128.saturating_abs(), 100);
    /// assert_eq((-100i128).saturating_abs(), 100);
    /// assert_eq(i128::MIN.saturating_abs(), i128::MAX);
    /// assert_eq((i128::MIN + 1).saturating_abs(), i128::MAX);
    /// ```
    #[inline]
    pub fn saturating_abs(self) -> i128 {
        if self == i128::MIN {
            i128::MAX
        } else {
            self.abs()
        }
    }

    /// Saturating integer negation. Computes `-self`, returning `MAX` if `self
    /// == MIN` instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i128.saturating_neg(), -100);
    /// assert_eq((-100i128).saturating_neg(), 100);
    /// assert_eq(i128::MIN.saturating_neg(), i128::MAX);
    /// assert_eq(i128::MAX.saturating_neg(), i128::MIN + 1);
    /// ```
    #[inline]
    pub fn saturating_neg(self) -> i128 {
        if self == i128::MIN { i128::MAX } else { -self }
    }

    /// Computes the absolute difference between `self` and `other`.
    ///
    /// This function always returns the correct answer without overflow or
    /// panics by returning an unsigned integer.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i128.abs_diff(80), 20u128);
    /// assert_eq(100i128.abs_diff(110), 10u128);
    /// assert_eq((-100i128).abs_diff(80), 180u128);
    /// assert_eq((-100i128).abs_diff(-120), 20u128);
    /// assert_eq(i128::MIN.abs_diff(i128::MAX), u128::MAX);
    /// ```
    #[inline]
    pub fn abs_diff(self, other: i128) -> u128 {
        if self < other {
            (other as u128).wrapping_sub(self as u128)
        } else {
            (self as u128).wrapping_sub(other as u128)
        }
    }

    /// Calculates the quotient of Euclidean division of `self` by `rhs`.
    ///
    /// This computes the integer `q` such that `self = q * rhs + r`, with `r =
    /// self.rem_euclid(rhs)` and `0 <= r < abs(rhs)`.
    ///
    /// In other words, the result is `self / rhs` rounded to the integer `q`
    /// such that `self >= q * rhs`. If `self > 0`, this is equal to rounding
    /// towards zero (what `/` does); if `self < 0`, this is equal to rounding
    /// away from zero (towards +/- infinity). If `rhs > 0`, this is equal to
    /// rounding towards -infinity; if `rhs < 0`, this is equal to rounding
    /// towards +infinity.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero or if `self` is `MIN` and
    /// `rhs` is -1.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = 7i128;
    /// let b = 4;
    ///
    /// assert_eq(a.div_euclid(b), 1); // 7 >= 4 * 1
    /// assert_eq(a.div_euclid(-b), -1); // 7 >= -4 * -1
    /// assert_eq((-a).div_euclid(b), -2); // -7 >= 4 * -2
    /// assert_eq((-a).div_euclid(-b), 2); // -7 >= -4 * 2
    /// ```
    #[track_caller]
    pub fn div_euclid(self, rhs: i128) -> i128 {
        let q = self / rhs;
        if self % rhs < 0 {
            if rhs > 0 { q - 1 } else { q + 1 }
        } else {
            q
        }
    }

    /// Calculates the least nonnegative remainder of `self (mod rhs)`.
    ///
    /// This is done as if by the Euclidean division algorithm -- given `r =
    /// self.rem_euclid(rhs)`, the result satisfies `self = rhs *
    /// self.div_euclid(rhs) + r` and `0 <= r < abs(rhs)`.
    ///
    /// # Panics
    ///
    /// This function will panic if `rhs` is zero or if `self` is `MIN` and
    /// `rhs` is -1.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = 7i128;
    /// let b = 4;
    ///
    /// assert_eq(a.rem_euclid(b), 3);
    /// assert_eq((-a).rem_euclid(b), 1);
    /// assert_eq(a.rem_euclid(-b), 3);
    /// assert_eq((-a).rem_euclid(-b), 1);
    /// ```
    #[track_caller]
    pub fn rem_euclid(self, rhs: i128) -> i128 {
        let r = self % rhs;
        if r < 0 {
            r.wrapping_add(rhs.wrapping_abs())
        } else {
            r
        }
    }

    /// Returns the square root of the number, rounded down.
    ///
    /// Returns `None` if `self` is negative.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i128.checked_isqrt(), Some(3));
    /// assert_eq((-1i128).checked_isqrt(), None);
    /// ```
    #[inline]
    pub fn checked_isqrt(self) -> Option<i128> {
        if self < 0 { None } else { Some(self.isqrt()) }
    }

    /// Checked integer remainder. Computes `self % rhs`, returning `None` if
    /// `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i128.checked_rem(2), Some(1));
    /// assert_eq(5i128.checked_rem(0), None);
    /// assert_eq(i128::MIN.checked_rem(-1), None);
    /// ```
    #[inline]
    pub fn checked_rem(self, rhs: i128) -> Option<i128> {
        if rhs == 0 || self == i128::MIN && rhs == -1 {
            None
        } else {
            Some(self % rhs)
        }
    }

    /// Saturating integer multiplication. Computes `self * rhs`, saturating at
    /// the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i128.saturating_mul(12), 120);
    /// assert_eq(i128::MAX.saturating_mul(10), i128::MAX);
    /// assert_eq(i128::MIN.saturating_mul(10), i128::MIN);
    /// ```
    #[inline]
    pub fn saturating_mul(self, rhs: i128) -> i128 {
        match self.checked_mul(rhs) {
            Some(r) => r,
            None => {
                if (self < 0) != (rhs < 0) {
                    i128::MIN
                } else {
                    i128::MAX
                }
            }
        }
    }

    /// Wrapping (modular) exponentiation. Computes `self.pow(exp)`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3i128.wrapping_pow(4), 81);
    /// assert_eq(i128::MAX.wrapping_pow(2), 1);
    /// ```
    #[inline]
    pub fn wrapping_pow(self, exp: u32) -> i128 {
        self.overflowing_pow(exp).0
    }

    /// Returns the number of zeros in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i128::MAX.count_zeros(), 1);
    /// assert_eq((-1i128).count_zeros(), 0);
    /// ```
    #[inline]
    pub fn count_zeros(self) -> u32 {
        128 - self.count_ones()
    }

    /// Shifts the bits to the left by a specified amount, `n`, wrapping the
    /// truncated bits to the end of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `<<` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = ((0x13f4000000000000i128 << 64) | 0x4f76);
    /// let m = 0x4f7613f4;
    ///
    /// assert_eq(n.rotate_left(16), m);
    /// ```
    #[inline]
    pub fn rotate_left(self, n: u32) -> i128 {
        let v = (self as u128);
        let k = n % 128;
        if k == 0 {
            return self;
        }
        i128_of((v << k) | (v >> (128 - k)))
    }

    /// Shifts the bits to the right by a specified amount, `n`, wrapping the
    /// truncated bits to the beginning of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `>>` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x4f7613f4i128;
    /// let m = ((0x13f4000000000000i128 << 64) | 0x4f76);
    ///
    /// assert_eq(n.rotate_right(16), m);
    /// ```
    #[inline]
    pub fn rotate_right(self, n: u32) -> i128 {
        let k = n % 128;
        if k == 0 {
            return self;
        }
        self.rotate_left(128 - k)
    }

    /// Returns the memory representation of this integer as a byte array in
    /// little-endian byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = ((0x1234567890123456i128 << 64) | 0x7890123456789012).to_le_bytes();
    /// assert_eq(
    ///     bytes,
    ///     [
    ///         0x12, 0x90, 0x78, 0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12, 0x90, 0x78, 0x56,
    ///         0x34, 0x12,
    ///     ],
    /// );
    /// ```
    pub fn to_le_bytes(self) -> [u8; 16] {
        let mut out = [0u8; 16];
        let lo = (self as u128) as u64;
        let hi = ((self as u128) >> 64) as u64;
        let mut i = 0;
        while i < 8 {
            out[i] = ((lo >> (8 * i as u32)) & 255) as u8;
            out[i + 8] = ((hi >> (8 * i as u32)) & 255) as u8;
            i += 1;
        }
        out
    }

    /// Creates an integer value from its representation as a byte array in
    /// little endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = i128::from_le_bytes([
    ///     0x12, 0x90, 0x78, 0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34,
    ///     0x12,
    /// ]);
    /// assert_eq(value, ((0x1234567890123456i128 << 64) | 0x7890123456789012));
    /// ```
    pub fn from_le_bytes(bytes: [u8; 16]) -> i128 {
        let mut lo: u64 = 0;
        let mut hi: u64 = 0;
        let mut i = 8;
        while i > 0 {
            i -= 1;
            lo = (lo << 8) | bytes[i] as u64;
            hi = (hi << 8) | bytes[i + 8] as u64;
        }
        i128_of(((hi as u128) << 64) | lo as u128)
    }

    /// Reverses the byte order of the integer.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = ((0x1234567890123456i128 << 64) | 0x7890123456789012);
    /// let m = n.swap_bytes();
    ///
    /// assert_eq(m, ((0x1290785634129078i128 << 64) | 0x5634129078563412));
    /// ```
    #[inline]
    pub fn swap_bytes(self) -> i128 {
        let lo = (self as u128) as u64;
        let hi = ((self as u128) >> 64) as u64;
        i128_of(((lo.swap_bytes() as u128) << 64) | hi.swap_bytes() as u128)
    }

    /// Parses an integer from a string slice with digits in the given base.
    ///
    /// The string is expected to be an optional `+` or `-` sign followed by
    /// only digits. Leading and trailing non-digit characters (including
    /// whitespace) represent an error. Underscores (which can appear in
    /// literals) also represent an error.
    ///
    /// Digits are a subset of these characters, depending on `radix`: `0-9`,
    /// `a-z`, `A-Z`.
    ///
    /// `radix` must be in the range from 2 to 36; unlike Rust, which panics
    /// otherwise, navi does not check it.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i128::from_str_radix("A", 16), Ok(10));
    /// assert_eq(i128::from_str_radix("-1111", 2), Ok(-15));
    /// assert(i128::from_str_radix("12 ", 10).is_err());
    /// assert(i128::from_str_radix("170141183460469231731687303715884105728", 10).is_err());
    /// ```
    pub fn from_str_radix(src: &str, radix: u32) -> Result<i128, ParseIntError> {
        match parse_radix128(src, radix, true) {
            Some((neg, mag)) => {
                let max = i128::MAX as u128;
                if neg {
                    if mag > max + 1 {
                        return Err(ParseIntError);
                    }
                    Ok(i128_of(0u128.wrapping_sub(mag)))
                } else {
                    if mag > max {
                        return Err(ParseIntError);
                    }
                    Ok(i128_of(mag))
                }
            }
            None => Err(ParseIntError),
        }
    }

    /// Wrapping (modular) absolute value. Computes `self.abs()`, wrapping
    /// around at the boundary of the type.
    ///
    /// The only case where such wrapping can occur is when one takes the
    /// absolute value of the negative minimal value for the type; this is a
    /// positive value that is too large to represent in the type. In such a
    /// case, this function returns `MIN` itself.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i128.wrapping_abs(), 100);
    /// assert_eq((-100i128).wrapping_abs(), 100);
    /// assert_eq(i128::MIN.wrapping_abs(), i128::MIN);
    /// assert_eq(i128::MIN.wrapping_abs() as u128, i128::MAX as u128 + 1);
    /// ```
    #[inline]
    pub fn wrapping_abs(self) -> i128 {
        if self < 0 { self.wrapping_neg() } else { self }
    }

    /// Computes the absolute value of `self` without any wrapping or panicking.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i128.unsigned_abs(), 100u128);
    /// assert_eq((-100i128).unsigned_abs(), 100u128);
    /// assert_eq(i128::MIN.unsigned_abs(), i128::MAX as u128 + 1);
    /// ```
    #[inline]
    pub fn unsigned_abs(self) -> u128 {
        if self < 0 {
            (self as u128).wrapping_neg()
        } else {
            self as u128
        }
    }
}

impl f64 {
    /// Returns `true` if `self` has a positive sign, including `+0.0`, NaNs
    /// with positive sign bit and positive infinity.
    ///
    /// Note that IEEE 754 doesn't assign any meaning to the sign bit in case of
    /// a NaN, and the sign of a NaN that arithmetic produces is not specified.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 7.0f64;
    /// let g = -7.0f64;
    ///
    /// assert(f.is_sign_positive());
    /// assert(!g.is_sign_positive());
    /// assert(0.0f64.is_sign_positive());
    /// ```
    #[inline]
    pub fn is_sign_positive(self) -> bool {
        !self.is_sign_negative()
    }

    /// Returns `true` if the number is neither zero, infinite, [subnormal], or
    /// NaN.
    ///
    /// [subnormal]: https://en.wikipedia.org/wiki/Denormal_number
    ///
    /// # Examples
    ///
    /// ```
    /// let min = f64::MIN_POSITIVE; // 2.2250738585072014e-308f64
    /// let max = f64::MAX;
    /// let lower_than_min = 1.0e-308f64;
    /// let zero = 0.0f64;
    ///
    /// assert(min.is_normal());
    /// assert(max.is_normal());
    ///
    /// assert(!zero.is_normal());
    /// assert(!f64::NAN.is_normal());
    /// assert(!f64::INFINITY.is_normal());
    /// // Values between `0` and `min` are subnormal.
    /// assert(!lower_than_min.is_normal());
    /// ```
    #[inline]
    pub fn is_normal(self) -> bool {
        self.classify() == FpCategory::Normal
    }

    /// Returns `true` if the number is [subnormal].
    ///
    /// [subnormal]: https://en.wikipedia.org/wiki/Denormal_number
    ///
    /// # Examples
    ///
    /// ```
    /// let min = f64::MIN_POSITIVE; // 2.2250738585072014e-308f64
    /// let max = f64::MAX;
    /// let lower_than_min = 1.0e-308f64;
    /// let zero = 0.0f64;
    ///
    /// assert(!min.is_subnormal());
    /// assert(!max.is_subnormal());
    ///
    /// assert(!zero.is_subnormal());
    /// assert(!f64::NAN.is_subnormal());
    /// assert(!f64::INFINITY.is_subnormal());
    /// // Values between `0` and `min` are subnormal.
    /// assert(lower_than_min.is_subnormal());
    /// ```
    #[inline]
    pub fn is_subnormal(self) -> bool {
        self.classify() == FpCategory::Subnormal
    }

    /// Returns the floating point category of the number. If only one property
    /// is going to be tested, it is generally faster to use the specific
    /// predicate instead.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::num::FpCategory;
    ///
    /// let num = 12.4f64;
    /// let inf = f64::INFINITY;
    ///
    /// assert_eq(num.classify(), FpCategory::Normal);
    /// assert_eq(inf.classify(), FpCategory::Infinite);
    /// assert_eq(0.0f64.classify(), FpCategory::Zero);
    /// assert_eq(f64::NAN.classify(), FpCategory::Nan);
    /// assert_eq((f64::MIN_POSITIVE / 2.0).classify(), FpCategory::Subnormal);
    /// ```
    pub fn classify(self) -> FpCategory {
        let bits = self.to_bits();
        let exp = bits & 0x7ff0000000000000;
        let man = bits & 0x000fffffffffffff;
        if exp == 0 {
            if man == 0 {
                FpCategory::Zero
            } else {
                FpCategory::Subnormal
            }
        } else if exp == 0x7ff0000000000000 {
            if man == 0 {
                FpCategory::Infinite
            } else {
                FpCategory::Nan
            }
        } else {
            FpCategory::Normal
        }
    }

    /// Returns the fractional part of `self`.
    ///
    /// This function always returns the precise result.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 3.6f64;
    /// let y = -3.6f64;
    /// let abs_difference_x = (x.fract() - 0.6).abs();
    /// let abs_difference_y = (y.fract() - (-0.6)).abs();
    ///
    /// assert(abs_difference_x <= 1e-10);
    /// assert(abs_difference_y <= 1e-10);
    /// ```
    #[inline]
    pub fn fract(self) -> f64 {
        self - self.trunc()
    }

    /// Returns a number that represents the sign of `self`.
    ///
    /// - `1.0` if the number is positive, `+0.0` or `INFINITY`
    /// - `-1.0` if the number is negative, `-0.0` or `NEG_INFINITY`
    /// - NaN if the number is NaN
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 3.5f64;
    ///
    /// assert_eq(f.signum(), 1.0);
    /// assert_eq(f64::NEG_INFINITY.signum(), -1.0);
    ///
    /// assert(f64::NAN.signum().is_nan());
    /// ```
    #[inline]
    pub fn signum(self) -> f64 {
        if self.is_nan() {
            f64::NAN
        } else {
            (1.0 as f64).copysign(self)
        }
    }

    /// Returns a number composed of the magnitude of `self` and the sign of
    /// `sign`.
    ///
    /// Equal to `self` if the sign of `self` and `sign` are the same, otherwise
    /// equal to `-self`. If `self` is a NaN, then a NaN with the same payload
    /// as `self` and the sign bit of `sign` is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 3.5f64;
    ///
    /// assert_eq(f.copysign(0.42), 3.5);
    /// assert_eq(f.copysign(-0.42), -3.5);
    /// assert_eq((-f).copysign(0.42), 3.5);
    /// assert_eq((-f).copysign(-0.42), -3.5);
    ///
    /// assert(f64::NAN.copysign(1.0).is_nan());
    /// ```
    #[inline]
    pub fn copysign(self, sign: f64) -> f64 {
        f64::from_bits(
            (self.to_bits() & !0x8000000000000000) | (sign.to_bits() & 0x8000000000000000),
        )
    }

    /// Takes the reciprocal (inverse) of a number, `1/x`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2.0f64;
    /// let abs_difference = (x.recip() - (1.0 / x)).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn recip(self) -> f64 {
        1.0 / self
    }

    /// Converts radians to degrees.
    ///
    /// # Examples
    ///
    /// ```
    /// let angle = std::f64::consts::PI;
    ///
    /// let abs_difference = (angle.to_degrees() - 180.0).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn to_degrees(self) -> f64 {
        self * (180.0 / crate::f64::consts::PI)
    }

    /// Converts degrees to radians.
    ///
    /// # Examples
    ///
    /// ```
    /// let angle = 180.0f64;
    ///
    /// let abs_difference = (angle.to_radians() - std::f64::consts::PI).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn to_radians(self) -> f64 {
        self * (crate::f64::consts::PI / 180.0)
    }

    /// Restrict a value to a certain interval unless it is NaN.
    ///
    /// Returns `max` if `self` is greater than `max`, and `min` if `self` is
    /// less than `min`. Otherwise this returns `self`. Note that this function
    /// returns NaN if the initial value was NaN as well.
    ///
    /// # Panics
    ///
    /// Panics if `min > max`, `min` is NaN, or `max` is NaN.
    ///
    /// # Examples
    ///
    /// ```
    /// assert((-3.0f64).clamp(-2.0, 1.0) == -2.0);
    /// assert(0.0f64.clamp(-2.0, 1.0) == 0.0);
    /// assert(2.0f64.clamp(-2.0, 1.0) == 1.0);
    /// assert(f64::NAN.clamp(-2.0, 1.0).is_nan());
    /// ```
    #[track_caller]
    pub fn clamp(self, min: f64, max: f64) -> f64 {
        if !(min <= max) {
            panic(`min > max, or either was NaN. min = ${min:?}, max = ${max:?}`);
        }
        let mut x = self;
        if x < min {
            x = min;
        }
        if x > max {
            x = max;
        }
        x
    }

    /// Returns the ordering between `self` and `other`.
    ///
    /// Unlike the standard partial comparison between floating point numbers,
    /// this comparison always produces an ordering in accordance to the
    /// `totalOrder` predicate as defined in the IEEE 754 (2008 revision)
    /// floating point standard. The values are ordered in the following
    /// sequence:
    ///
    /// - negative quiet NaN
    /// - negative signaling NaN
    /// - negative infinity
    /// - negative numbers
    /// - negative subnormal numbers
    /// - negative zero
    /// - positive zero
    /// - positive subnormal numbers
    /// - positive numbers
    /// - positive infinity
    /// - positive signaling NaN
    /// - positive quiet NaN.
    ///
    /// The ordering established by this function does not always agree with the
    /// `PartialOrd` and `PartialEq` implementations of `f64`. In particular,
    /// they regard negative and positive zero as equal, while `total_cmp`
    /// doesn't.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::cmp::Ordering;
    ///
    /// assert_eq((-0.0f64).total_cmp(&0.0), Ordering::Less);
    /// assert_eq(1.0f64.total_cmp(&1.0), Ordering::Equal);
    /// assert_eq(f64::NAN.total_cmp(&f64::INFINITY), Ordering::Greater);
    /// assert_eq((-f64::NAN).total_cmp(&f64::NEG_INFINITY), Ordering::Less);
    /// ```
    #[inline]
    pub fn total_cmp(&self, other: &f64) -> crate::cmp::Ordering {
        let mut a = self.to_bits() as i64;
        let mut b = other.to_bits() as i64;
        a = a ^ ((((a >> (64 - 1)) as u64) >> 1) as i64);
        b = b ^ ((((b >> (64 - 1)) as u64) >> 1) as i64);
        a.cmp(&b)
    }

    /// Fused multiply-add. Computes `(self * a) + b` with only one rounding
    /// error, yielding a more accurate result than an unfused multiply-add.
    ///
    /// # Examples
    ///
    /// ```
    /// let m = 10.0f64;
    /// let x = 4.0f64;
    /// let b = 60.0f64;
    ///
    /// assert_eq(m.mul_add(x, b), 100.0);
    /// assert_eq(m * x + b, 100.0);
    /// ```
    #[inline]
    pub fn mul_add(self, a: f64, b: f64) -> f64 {
        unsafe { c_fma(self as f64, a as f64, b as f64) as f64 }
    }

    /// Calculates Euclidean division, the matching method for `rem_euclid`.
    ///
    /// This computes the integer `n` such that `self = n * rhs +
    /// self.rem_euclid(rhs)`. In other words, the result is `self / rhs`
    /// rounded to the integer `n` such that `self >= n * rhs`.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = 7.0f64;
    /// let b = 4.0;
    /// assert_eq(a.div_euclid(b), 1.0); // 7.0 > 4.0 * 1.0
    /// assert_eq((-a).div_euclid(b), -2.0); // -7.0 >= 4.0 * -2.0
    /// assert_eq(a.div_euclid(-b), -1.0); // 7.0 >= -4.0 * -1.0
    /// assert_eq((-a).div_euclid(-b), 2.0); // -7.0 >= -4.0 * 2.0
    /// ```
    #[inline]
    pub fn div_euclid(self, rhs: f64) -> f64 {
        let q = (self / rhs).trunc();
        if self % rhs < 0.0 {
            if rhs > 0.0 { q - 1.0 } else { q + 1.0 }
        } else {
            q
        }
    }

    /// Calculates the least nonnegative remainder of `self (mod rhs)`.
    ///
    /// In particular, the return value `r` satisfies `0.0 <= r < rhs.abs()` in
    /// most cases. However, due to a floating point round-off error it can
    /// result in `r == rhs.abs()`, violating the mathematical definition, if
    /// `self` is much smaller than `rhs.abs()` in magnitude and `self < 0.0`.
    /// This result is not an element of the function's codomain, but it is the
    /// closest floating point number in the real numbers and thus fulfills the
    /// property `self == self.div_euclid(rhs) * rhs + self.rem_euclid(rhs)`
    /// approximately.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = 7.0f64;
    /// let b = 4.0;
    /// assert_eq(a.rem_euclid(b), 3.0);
    /// assert_eq((-a).rem_euclid(b), 1.0);
    /// assert_eq(a.rem_euclid(-b), 3.0);
    /// assert_eq((-a).rem_euclid(-b), 1.0);
    /// // limitation due to round-off error
    /// assert((-f64::EPSILON).rem_euclid(3.0) != 0.0);
    /// ```
    #[inline]
    pub fn rem_euclid(self, rhs: f64) -> f64 {
        let r = self % rhs;
        if r < 0.0 { r + rhs.abs() } else { r }
    }

    /// Raises a number to a floating point power.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2.0f64;
    /// let abs_difference = (x.powf(2.0) - (x * x)).abs();
    ///
    /// assert(abs_difference <= f64::EPSILON);
    /// assert_eq(1.0f64.powf(f64::NAN), 1.0);
    /// ```
    #[inline]
    pub fn powf(self, n: f64) -> f64 {
        unsafe { c_pow(self as f64, n as f64) as f64 }
    }

    /// Returns `e^(self)`, (the exponential function).
    ///
    /// # Examples
    ///
    /// ```
    /// let one = 1.0f64;
    /// // e^1
    /// let e = one.exp();
    ///
    /// // ln(e) - 1 == 0
    /// let abs_difference = (e.ln() - 1.0).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn exp(self) -> f64 {
        unsafe { c_exp(self as f64) as f64 }
    }

    /// Returns `2^(self)`.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 2.0f64;
    ///
    /// // 2^2 - 4 == 0
    /// let abs_difference = (f.exp2() - 4.0).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn exp2(self) -> f64 {
        unsafe { c_exp2(self as f64) as f64 }
    }

    /// Returns `e^(self) - 1` in a way that is accurate even if the number is
    /// close to zero.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 1e-16f64;
    ///
    /// // for very small x, e^x is approximately 1 + x + x^2 / 2
    /// let approx = x + x * x / 2.0;
    /// let abs_difference = (x.exp_m1() - approx).abs();
    ///
    /// assert(abs_difference < 1e-20);
    /// ```
    #[inline]
    pub fn exp_m1(self) -> f64 {
        unsafe { c_expm1(self as f64) as f64 }
    }

    /// Returns the natural logarithm of the number.
    ///
    /// This returns NaN when the number is negative, and negative infinity when
    /// number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// let one = 1.0f64;
    /// // e^1
    /// let e = one.exp();
    ///
    /// // ln(e) - 1 == 0
    /// let abs_difference = (e.ln() - 1.0).abs();
    ///
    /// assert(abs_difference < 1e-10);
    ///
    /// assert_eq(0.0f64.ln(), f64::NEG_INFINITY);
    /// assert((-1.0f64).ln().is_nan());
    /// ```
    #[inline]
    pub fn ln(self) -> f64 {
        unsafe { c_log(self as f64) as f64 }
    }

    /// Returns `ln(1+n)` (natural logarithm) more accurately than if the
    /// operations were performed separately.
    ///
    /// This returns NaN when `n < -1.0`, and negative infinity when `n ==
    /// -1.0`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 1e-16f64;
    ///
    /// // for very small x, ln(1 + x) is approximately x - x^2 / 2
    /// let approx = x - x * x / 2.0;
    /// let abs_difference = (x.ln_1p() - approx).abs();
    ///
    /// assert(abs_difference < 1e-20);
    /// ```
    #[inline]
    pub fn ln_1p(self) -> f64 {
        unsafe { c_log1p(self as f64) as f64 }
    }

    /// Returns the logarithm of the number with respect to an arbitrary base.
    ///
    /// The result might not be correctly rounded owing to implementation
    /// details; `self.log2()` can produce more accurate results for base 2, and
    /// `self.log10()` can produce more accurate results for base 10.
    ///
    /// This returns NaN when the number is negative, and negative infinity when
    /// number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// let five = 5.0f64;
    ///
    /// // log5(5) - 1 == 0
    /// let abs_difference = (five.log(5.0) - 1.0).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn log(self, base: f64) -> f64 {
        self.ln() / base.ln()
    }

    /// Returns the base 2 logarithm of the number.
    ///
    /// This returns NaN when the number is negative, and negative infinity when
    /// number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// let two = 2.0f64;
    ///
    /// // log2(2) - 1 == 0
    /// let abs_difference = (two.log2() - 1.0).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn log2(self) -> f64 {
        unsafe { c_log2(self as f64) as f64 }
    }

    /// Returns the base 10 logarithm of the number.
    ///
    /// This returns NaN when the number is negative, and negative infinity when
    /// number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// let ten = 10.0f64;
    ///
    /// // log10(10) - 1 == 0
    /// let abs_difference = (ten.log10() - 1.0).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn log10(self) -> f64 {
        unsafe { c_log10(self as f64) as f64 }
    }

    /// Returns the cube root of a number.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 8.0f64;
    ///
    /// // x^(1/3) - 2 == 0
    /// let abs_difference = (x.cbrt() - 2.0).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn cbrt(self) -> f64 {
        cbrt64(self)
    }

    /// Compute the distance between the origin and a point (`x`, `y`) on the
    /// Euclidean plane. Equivalently, compute the length of the hypotenuse of a
    /// right-angle triangle with other sides having length `x.abs()` and
    /// `y.abs()`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2.0f64;
    /// let y = 3.0f64;
    ///
    /// // sqrt(x^2 + y^2)
    /// let abs_difference = (x.hypot(y) - (x.powi(2) + y.powi(2)).sqrt()).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn hypot(self, other: f64) -> f64 {
        unsafe { c_hypot(self as f64, other as f64) as f64 }
    }

    /// Computes the sine of a number (in radians).
    ///
    /// # Examples
    ///
    /// ```
    /// let x = std::f64::consts::FRAC_PI_2;
    ///
    /// let abs_difference = (x.sin() - 1.0).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn sin(self) -> f64 {
        unsafe { c_sin(self as f64) as f64 }
    }

    /// Computes the cosine of a number (in radians).
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2.0 * std::f64::consts::PI;
    ///
    /// let abs_difference = (x.cos() - 1.0).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn cos(self) -> f64 {
        unsafe { c_cos(self as f64) as f64 }
    }

    /// Computes the tangent of a number (in radians).
    ///
    /// # Examples
    ///
    /// ```
    /// let x = std::f64::consts::FRAC_PI_4;
    /// let abs_difference = (x.tan() - 1.0).abs();
    ///
    /// assert(abs_difference < 1e-14);
    /// ```
    #[inline]
    pub fn tan(self) -> f64 {
        unsafe { c_tan(self as f64) as f64 }
    }

    /// Computes the arcsine of a number. Return value is in radians in the
    /// range [-pi/2, pi/2] or NaN if the number is outside the range [-1, 1].
    ///
    /// # Examples
    ///
    /// ```
    /// let f = std::f64::consts::FRAC_PI_2;
    ///
    /// // asin(sin(pi/2))
    /// let abs_difference = (f.sin().asin() - std::f64::consts::FRAC_PI_2).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn asin(self) -> f64 {
        unsafe { c_asin(self as f64) as f64 }
    }

    /// Computes the arccosine of a number. Return value is in radians in the
    /// range [0, pi] or NaN if the number is outside the range [-1, 1].
    ///
    /// # Examples
    ///
    /// ```
    /// let f = std::f64::consts::FRAC_PI_4;
    ///
    /// // acos(cos(pi/4))
    /// let abs_difference = (f.cos().acos() - std::f64::consts::FRAC_PI_4).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn acos(self) -> f64 {
        unsafe { c_acos(self as f64) as f64 }
    }

    /// Computes the arctangent of a number. Return value is in radians in the
    /// range [-pi/2, pi/2].
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 1.0f64;
    ///
    /// // atan(tan(1))
    /// let abs_difference = (f.tan().atan() - 1.0).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn atan(self) -> f64 {
        unsafe { c_atan(self as f64) as f64 }
    }

    /// Computes the four quadrant arctangent of `self` (`y`) and `other` (`x`)
    /// in radians.
    ///
    /// - `x = 0`, `y = 0`: `0`
    /// - `x >= 0`: `arctan(y/x)` -> `[-pi/2, pi/2]`
    /// - `y >= 0`: `arctan(y/x) + pi` -> `(pi/2, pi]`
    /// - `y < 0`: `arctan(y/x) - pi` -> `(-pi, -pi/2)`
    ///
    /// # Examples
    ///
    /// ```
    /// // Positive angles measured counter-clockwise
    /// // from positive x axis
    /// // -pi/4 radians (45 deg clockwise)
    /// let x1 = 3.0f64;
    /// let y1 = -3.0f64;
    ///
    /// // 3pi/4 radians (135 deg counter-clockwise)
    /// let x2 = -3.0f64;
    /// let y2 = 3.0f64;
    ///
    /// let abs_difference_1 = (y1.atan2(x1) - (-std::f64::consts::FRAC_PI_4)).abs();
    /// let abs_difference_2 = (y2.atan2(x2) - (3.0 * std::f64::consts::FRAC_PI_4)).abs();
    ///
    /// assert(abs_difference_1 < 1e-10);
    /// assert(abs_difference_2 < 1e-10);
    /// ```
    #[inline]
    pub fn atan2(self, other: f64) -> f64 {
        unsafe { c_atan2(self as f64, other as f64) as f64 }
    }

    /// Simultaneously computes the sine and cosine of the number, `x`. Returns
    /// `(sin(x), cos(x))`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = std::f64::consts::FRAC_PI_4;
    /// let f = x.sin_cos();
    ///
    /// let abs_difference_0 = (f.0 - x.sin()).abs();
    /// let abs_difference_1 = (f.1 - x.cos()).abs();
    ///
    /// assert(abs_difference_0 < 1e-10);
    /// assert(abs_difference_1 < 1e-10);
    /// ```
    #[inline]
    pub fn sin_cos(self) -> (f64, f64) {
        (self.sin(), self.cos())
    }

    /// Hyperbolic sine function.
    ///
    /// # Examples
    ///
    /// ```
    /// let e = std::f64::consts::E;
    /// let x = 1.0f64;
    ///
    /// let f = x.sinh();
    /// // Solving sinh() at 1 gives `(e^2-1)/(2e)`
    /// let g = ((e * e) - 1.0) / (2.0 * e);
    /// let abs_difference = (f - g).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn sinh(self) -> f64 {
        unsafe { c_sinh(self as f64) as f64 }
    }

    /// Hyperbolic cosine function.
    ///
    /// # Examples
    ///
    /// ```
    /// let e = std::f64::consts::E;
    /// let x = 1.0f64;
    /// let f = x.cosh();
    /// // Solving cosh() at 1 gives this result
    /// let g = ((e * e) + 1.0) / (2.0 * e);
    /// let abs_difference = (f - g).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn cosh(self) -> f64 {
        unsafe { c_cosh(self as f64) as f64 }
    }

    /// Hyperbolic tangent function.
    ///
    /// # Examples
    ///
    /// ```
    /// let e = std::f64::consts::E;
    /// let x = 1.0f64;
    ///
    /// let f = x.tanh();
    /// // Solving tanh() at 1 gives `(1 - e^(-2))/(1 + e^(-2))`
    /// let g = (1.0 - e.powi(-2)) / (1.0 + e.powi(-2));
    /// let abs_difference = (f - g).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn tanh(self) -> f64 {
        unsafe { c_tanh(self as f64) as f64 }
    }

    /// Inverse hyperbolic sine function.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 1.0f64;
    /// let f = x.sinh().asinh();
    ///
    /// let abs_difference = (f - x).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn asinh(self) -> f64 {
        unsafe { c_asinh(self as f64) as f64 }
    }

    /// Inverse hyperbolic cosine function.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 1.0f64;
    /// let f = x.cosh().acosh();
    ///
    /// let abs_difference = (f - x).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn acosh(self) -> f64 {
        unsafe { c_acosh(self as f64) as f64 }
    }

    /// Inverse hyperbolic tangent function.
    ///
    /// # Examples
    ///
    /// ```
    /// let e = std::f64::consts::E;
    /// let f = e.tanh().atanh();
    ///
    /// let abs_difference = (f - e).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn atanh(self) -> f64 {
        unsafe { c_atanh(self as f64) as f64 }
    }

    /// Returns the nearest integer to a number. Rounds half-way cases to the
    /// number with an even least significant digit.
    ///
    /// This function always returns the precise result.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 3.3f64;
    /// let g = -3.3f64;
    /// let h = 3.5f64;
    /// let i = 4.5f64;
    ///
    /// assert_eq(f.round_ties_even(), 3.0);
    /// assert_eq(g.round_ties_even(), -3.0);
    /// assert_eq(h.round_ties_even(), 4.0);
    /// assert_eq(i.round_ties_even(), 4.0);
    /// ```
    #[inline]
    pub fn round_ties_even(self) -> f64 {
        unsafe { c_rint(self as f64) as f64 }
    }

    /// Returns the memory representation of this floating point number as a
    /// byte array in little-endian byte order.
    ///
    /// See `to_bits` for some discussion of the portability of this operation
    /// (there are almost no issues).
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 12.5f64.to_le_bytes();
    /// assert_eq(bytes, [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x29, 0x40]);
    /// ```
    #[inline]
    pub fn to_le_bytes(self) -> [u8; 8] {
        self.to_bits().to_le_bytes()
    }

    /// Returns the memory representation of this floating point number as a
    /// byte array in big-endian (network) byte order.
    ///
    /// See `to_bits` for some discussion of the portability of this operation
    /// (there are almost no issues).
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 12.5f64.to_be_bytes();
    /// assert_eq(bytes, [0x40, 0x29, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]);
    /// ```
    #[inline]
    pub fn to_be_bytes(self) -> [u8; 8] {
        self.to_bits().to_be_bytes()
    }

    /// Returns the memory representation of this floating point number as a
    /// byte array in native byte order.
    ///
    /// See `to_bits` for some discussion of the portability of this operation
    /// (there are almost no issues).
    ///
    /// As the target platform's native endianness is used, portable code should
    /// use `to_be_bytes` or `to_le_bytes`, as appropriate, instead. (navi's
    /// targets are all little endian, so this is `to_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 12.5f64.to_ne_bytes();
    /// assert_eq(bytes, [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x29, 0x40]);
    /// ```
    #[inline]
    pub fn to_ne_bytes(self) -> [u8; 8] {
        self.to_bits().to_ne_bytes()
    }

    /// Creates a floating point value from its representation as a byte array
    /// in little endian.
    ///
    /// See `from_bits` for some discussion of the portability of this operation
    /// (there are almost no issues).
    ///
    /// # Examples
    ///
    /// ```
    /// let value = f64::from_le_bytes([0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x29, 0x40]);
    /// assert_eq(value, 12.5);
    /// ```
    #[inline]
    pub fn from_le_bytes(bytes: [u8; 8]) -> f64 {
        f64::from_bits(u64::from_le_bytes(bytes))
    }

    /// Creates a floating point value from its representation as a byte array
    /// in big endian.
    ///
    /// See `from_bits` for some discussion of the portability of this operation
    /// (there are almost no issues).
    ///
    /// # Examples
    ///
    /// ```
    /// let value = f64::from_be_bytes([0x40, 0x29, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00]);
    /// assert_eq(value, 12.5);
    /// ```
    #[inline]
    pub fn from_be_bytes(bytes: [u8; 8]) -> f64 {
        f64::from_bits(u64::from_be_bytes(bytes))
    }

    /// Creates a floating point value from its representation as a byte array
    /// in native endian.
    ///
    /// See `from_bits` for some discussion of the portability of this operation
    /// (there are almost no issues).
    ///
    /// As the target platform's native endianness is used, portable code likely
    /// wants to use `from_be_bytes` or `from_le_bytes`, as appropriate instead.
    /// (navi's targets are all little endian, so this is `from_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let value = f64::from_ne_bytes([0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x29, 0x40]);
    /// assert_eq(value, 12.5);
    /// ```
    #[inline]
    pub fn from_ne_bytes(bytes: [u8; 8]) -> f64 {
        f64::from_bits(u64::from_ne_bytes(bytes))
    }

    /// The radix or base of the internal representation of `f64`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f64::RADIX, 2);
    /// ```
    pub const RADIX: u32 = 2;

    /// Number of significant digits in base 2.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f64::MANTISSA_DIGITS, 53);
    /// ```
    pub const MANTISSA_DIGITS: u32 = 53;

    /// Approximate number of significant digits in base 10.
    ///
    /// This is the maximum *x* such that any decimal number with *x*
    /// significant digits can be converted to `f64` and back without loss.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f64::DIGITS, 15);
    /// ```
    pub const DIGITS: u32 = 15;

    /// Smallest positive normal `f64` value.
    ///
    /// Equal to 2^(MIN_EXP − 1).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f64::MIN_POSITIVE, 2.2250738585072014e-308);
    /// assert(f64::MIN_POSITIVE.is_normal());
    /// assert((f64::MIN_POSITIVE / 2.0).is_subnormal());
    /// ```
    pub const MIN_POSITIVE: f64 = 2.2250738585072014e-308;

    /// One greater than the minimum possible *normal* power of 2 exponent for a
    /// significand bounded by 1 ≤ x < 2 (i.e. the IEEE definition).
    ///
    /// This corresponds to the exact minimum possible *normal* power of 2
    /// exponent for a significand bounded by 0.5 ≤ x < 1 (i.e. the C
    /// definition). In other words, all normal numbers representable by this
    /// type are greater than or equal to 0.5 × 2^MIN_EXP.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f64::MIN_EXP, -1021);
    /// assert_eq(f64::MIN_POSITIVE, 0.5 * 2.0f64.powi(f64::MIN_EXP));
    /// ```
    pub const MIN_EXP: i32 = -1021;

    /// One greater than the maximum possible power of 2 exponent for a
    /// significand bounded by 1 ≤ x < 2 (i.e. the IEEE definition).
    ///
    /// This corresponds to the exact maximum possible power of 2 exponent for a
    /// significand bounded by 0.5 ≤ x < 1 (i.e. the C definition). In other
    /// words, all numbers representable by this type are strictly less than
    /// 2^MAX_EXP.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f64::MAX_EXP, 1024);
    /// assert(2.0f64.powi(f64::MAX_EXP) == f64::INFINITY);
    /// ```
    pub const MAX_EXP: i32 = 1024;

    /// Minimum *x* for which 10^*x* is normal.
    ///
    /// Equal to ceil(log₁₀ `MIN_POSITIVE`).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f64::MIN_10_EXP, -307);
    /// assert(10.0f64.powi(f64::MIN_10_EXP).is_normal());
    /// ```
    pub const MIN_10_EXP: i32 = -307;

    /// Maximum *x* for which 10^*x* is normal.
    ///
    /// Equal to floor(log₁₀ `MAX`).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f64::MAX_10_EXP, 308);
    /// assert(10.0f64.powi(f64::MAX_10_EXP).is_normal());
    /// ```
    pub const MAX_10_EXP: i32 = 308;
}

impl f32 {
    /// Returns `true` if `self` has a positive sign, including `+0.0`, NaNs
    /// with positive sign bit and positive infinity.
    ///
    /// Note that IEEE 754 doesn't assign any meaning to the sign bit in case of
    /// a NaN, and the sign of a NaN that arithmetic produces is not specified.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 7.0f32;
    /// let g = -7.0f32;
    ///
    /// assert(f.is_sign_positive());
    /// assert(!g.is_sign_positive());
    /// assert(0.0f32.is_sign_positive());
    /// ```
    #[inline]
    pub fn is_sign_positive(self) -> bool {
        !self.is_sign_negative()
    }

    /// Returns `true` if the number is neither zero, infinite, [subnormal], or
    /// NaN.
    ///
    /// [subnormal]: https://en.wikipedia.org/wiki/Denormal_number
    ///
    /// # Examples
    ///
    /// ```
    /// let min = f32::MIN_POSITIVE; // 1.17549435e-38f32
    /// let max = f32::MAX;
    /// let lower_than_min = 1.0e-40f32;
    /// let zero = 0.0f32;
    ///
    /// assert(min.is_normal());
    /// assert(max.is_normal());
    ///
    /// assert(!zero.is_normal());
    /// assert(!f32::NAN.is_normal());
    /// assert(!f32::INFINITY.is_normal());
    /// // Values between `0` and `min` are subnormal.
    /// assert(!lower_than_min.is_normal());
    /// ```
    #[inline]
    pub fn is_normal(self) -> bool {
        self.classify() == FpCategory::Normal
    }

    /// Returns `true` if the number is [subnormal].
    ///
    /// [subnormal]: https://en.wikipedia.org/wiki/Denormal_number
    ///
    /// # Examples
    ///
    /// ```
    /// let min = f32::MIN_POSITIVE; // 1.17549435e-38f32
    /// let max = f32::MAX;
    /// let lower_than_min = 1.0e-40f32;
    /// let zero = 0.0f32;
    ///
    /// assert(!min.is_subnormal());
    /// assert(!max.is_subnormal());
    ///
    /// assert(!zero.is_subnormal());
    /// assert(!f32::NAN.is_subnormal());
    /// assert(!f32::INFINITY.is_subnormal());
    /// // Values between `0` and `min` are subnormal.
    /// assert(lower_than_min.is_subnormal());
    /// ```
    #[inline]
    pub fn is_subnormal(self) -> bool {
        self.classify() == FpCategory::Subnormal
    }

    /// Returns the floating point category of the number. If only one property
    /// is going to be tested, it is generally faster to use the specific
    /// predicate instead.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::num::FpCategory;
    ///
    /// let num = 12.4f32;
    /// let inf = f32::INFINITY;
    ///
    /// assert_eq(num.classify(), FpCategory::Normal);
    /// assert_eq(inf.classify(), FpCategory::Infinite);
    /// assert_eq(0.0f32.classify(), FpCategory::Zero);
    /// assert_eq(f32::NAN.classify(), FpCategory::Nan);
    /// assert_eq((f32::MIN_POSITIVE / 2.0).classify(), FpCategory::Subnormal);
    /// ```
    pub fn classify(self) -> FpCategory {
        let bits = self.to_bits();
        let exp = bits & 0x7f800000;
        let man = bits & 0x007fffff;
        if exp == 0 {
            if man == 0 {
                FpCategory::Zero
            } else {
                FpCategory::Subnormal
            }
        } else if exp == 0x7f800000 {
            if man == 0 {
                FpCategory::Infinite
            } else {
                FpCategory::Nan
            }
        } else {
            FpCategory::Normal
        }
    }

    /// Returns the fractional part of `self`.
    ///
    /// This function always returns the precise result.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 3.6f32;
    /// let y = -3.6f32;
    /// let abs_difference_x = (x.fract() - 0.6).abs();
    /// let abs_difference_y = (y.fract() - (-0.6)).abs();
    ///
    /// assert(abs_difference_x <= f32::EPSILON);
    /// assert(abs_difference_y <= f32::EPSILON);
    /// ```
    #[inline]
    pub fn fract(self) -> f32 {
        self - self.trunc()
    }

    /// Returns a number that represents the sign of `self`.
    ///
    /// - `1.0` if the number is positive, `+0.0` or `INFINITY`
    /// - `-1.0` if the number is negative, `-0.0` or `NEG_INFINITY`
    /// - NaN if the number is NaN
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 3.5f32;
    ///
    /// assert_eq(f.signum(), 1.0);
    /// assert_eq(f32::NEG_INFINITY.signum(), -1.0);
    ///
    /// assert(f32::NAN.signum().is_nan());
    /// ```
    #[inline]
    pub fn signum(self) -> f32 {
        if self.is_nan() {
            f32::NAN
        } else {
            (1.0 as f32).copysign(self)
        }
    }

    /// Returns a number composed of the magnitude of `self` and the sign of
    /// `sign`.
    ///
    /// Equal to `self` if the sign of `self` and `sign` are the same, otherwise
    /// equal to `-self`. If `self` is a NaN, then a NaN with the same payload
    /// as `self` and the sign bit of `sign` is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 3.5f32;
    ///
    /// assert_eq(f.copysign(0.42), 3.5);
    /// assert_eq(f.copysign(-0.42), -3.5);
    /// assert_eq((-f).copysign(0.42), 3.5);
    /// assert_eq((-f).copysign(-0.42), -3.5);
    ///
    /// assert(f32::NAN.copysign(1.0).is_nan());
    /// ```
    #[inline]
    pub fn copysign(self, sign: f32) -> f32 {
        f32::from_bits((self.to_bits() & !0x80000000) | (sign.to_bits() & 0x80000000))
    }

    /// Takes the reciprocal (inverse) of a number, `1/x`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2.0f32;
    /// let abs_difference = (x.recip() - (1.0 / x)).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn recip(self) -> f32 {
        1.0 / self
    }

    /// Converts radians to degrees.
    ///
    /// # Examples
    ///
    /// ```
    /// let angle = std::f32::consts::PI;
    ///
    /// let abs_difference = (angle.to_degrees() - 180.0).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn to_degrees(self) -> f32 {
        self * (180.0 / crate::f32::consts::PI)
    }

    /// Converts degrees to radians.
    ///
    /// # Examples
    ///
    /// ```
    /// let angle = 180.0f32;
    ///
    /// let abs_difference = (angle.to_radians() - std::f32::consts::PI).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn to_radians(self) -> f32 {
        self * (crate::f32::consts::PI / 180.0)
    }

    /// Restrict a value to a certain interval unless it is NaN.
    ///
    /// Returns `max` if `self` is greater than `max`, and `min` if `self` is
    /// less than `min`. Otherwise this returns `self`. Note that this function
    /// returns NaN if the initial value was NaN as well.
    ///
    /// # Panics
    ///
    /// Panics if `min > max`, `min` is NaN, or `max` is NaN.
    ///
    /// # Examples
    ///
    /// ```
    /// assert((-3.0f32).clamp(-2.0, 1.0) == -2.0);
    /// assert(0.0f32.clamp(-2.0, 1.0) == 0.0);
    /// assert(2.0f32.clamp(-2.0, 1.0) == 1.0);
    /// assert(f32::NAN.clamp(-2.0, 1.0).is_nan());
    /// ```
    #[track_caller]
    pub fn clamp(self, min: f32, max: f32) -> f32 {
        if !(min <= max) {
            panic(`min > max, or either was NaN. min = ${min:?}, max = ${max:?}`);
        }
        let mut x = self;
        if x < min {
            x = min;
        }
        if x > max {
            x = max;
        }
        x
    }

    /// Returns the ordering between `self` and `other`.
    ///
    /// Unlike the standard partial comparison between floating point numbers,
    /// this comparison always produces an ordering in accordance to the
    /// `totalOrder` predicate as defined in the IEEE 754 (2008 revision)
    /// floating point standard. The values are ordered in the following
    /// sequence:
    ///
    /// - negative quiet NaN
    /// - negative signaling NaN
    /// - negative infinity
    /// - negative numbers
    /// - negative subnormal numbers
    /// - negative zero
    /// - positive zero
    /// - positive subnormal numbers
    /// - positive numbers
    /// - positive infinity
    /// - positive signaling NaN
    /// - positive quiet NaN.
    ///
    /// The ordering established by this function does not always agree with the
    /// `PartialOrd` and `PartialEq` implementations of `f32`. In particular,
    /// they regard negative and positive zero as equal, while `total_cmp`
    /// doesn't.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::cmp::Ordering;
    ///
    /// assert_eq((-0.0f32).total_cmp(&0.0), Ordering::Less);
    /// assert_eq(1.0f32.total_cmp(&1.0), Ordering::Equal);
    /// assert_eq(f32::NAN.total_cmp(&f32::INFINITY), Ordering::Greater);
    /// assert_eq((-f32::NAN).total_cmp(&f32::NEG_INFINITY), Ordering::Less);
    /// ```
    #[inline]
    pub fn total_cmp(&self, other: &f32) -> crate::cmp::Ordering {
        let mut a = self.to_bits() as i32;
        let mut b = other.to_bits() as i32;
        a = a ^ ((((a >> (32 - 1)) as u32) >> 1) as i32);
        b = b ^ ((((b >> (32 - 1)) as u32) >> 1) as i32);
        a.cmp(&b)
    }

    /// Fused multiply-add. Computes `(self * a) + b` with only one rounding
    /// error, yielding a more accurate result than an unfused multiply-add.
    /// navi computes it with `f64`'s and rounds the result to `f32`, which can
    /// round twice.
    ///
    /// # Examples
    ///
    /// ```
    /// let m = 10.0f32;
    /// let x = 4.0f32;
    /// let b = 60.0f32;
    ///
    /// assert_eq(m.mul_add(x, b), 100.0);
    /// assert_eq(m * x + b, 100.0);
    /// ```
    #[inline]
    pub fn mul_add(self, a: f32, b: f32) -> f32 {
        unsafe { c_fma(self as f64, a as f64, b as f64) as f32 }
    }

    /// Calculates Euclidean division, the matching method for `rem_euclid`.
    ///
    /// This computes the integer `n` such that `self = n * rhs +
    /// self.rem_euclid(rhs)`. In other words, the result is `self / rhs`
    /// rounded to the integer `n` such that `self >= n * rhs`.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = 7.0f32;
    /// let b = 4.0;
    /// assert_eq(a.div_euclid(b), 1.0); // 7.0 > 4.0 * 1.0
    /// assert_eq((-a).div_euclid(b), -2.0); // -7.0 >= 4.0 * -2.0
    /// assert_eq(a.div_euclid(-b), -1.0); // 7.0 >= -4.0 * -1.0
    /// assert_eq((-a).div_euclid(-b), 2.0); // -7.0 >= -4.0 * 2.0
    /// ```
    #[inline]
    pub fn div_euclid(self, rhs: f32) -> f32 {
        let q = (self / rhs).trunc();
        if self % rhs < 0.0 {
            if rhs > 0.0 { q - 1.0 } else { q + 1.0 }
        } else {
            q
        }
    }

    /// Calculates the least nonnegative remainder of `self (mod rhs)`.
    ///
    /// In particular, the return value `r` satisfies `0.0 <= r < rhs.abs()` in
    /// most cases. However, due to a floating point round-off error it can
    /// result in `r == rhs.abs()`, violating the mathematical definition, if
    /// `self` is much smaller than `rhs.abs()` in magnitude and `self < 0.0`.
    /// This result is not an element of the function's codomain, but it is the
    /// closest floating point number in the real numbers and thus fulfills the
    /// property `self == self.div_euclid(rhs) * rhs + self.rem_euclid(rhs)`
    /// approximately.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = 7.0f32;
    /// let b = 4.0;
    /// assert_eq(a.rem_euclid(b), 3.0);
    /// assert_eq((-a).rem_euclid(b), 1.0);
    /// assert_eq(a.rem_euclid(-b), 3.0);
    /// assert_eq((-a).rem_euclid(-b), 1.0);
    /// // limitation due to round-off error
    /// assert((-f32::EPSILON).rem_euclid(3.0) != 0.0);
    /// ```
    #[inline]
    pub fn rem_euclid(self, rhs: f32) -> f32 {
        let r = self % rhs;
        if r < 0.0 { r + rhs.abs() } else { r }
    }

    /// Raises a number to a floating point power. navi computes it in `f64` and
    /// rounds the result to `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2.0f32;
    /// let abs_difference = (x.powf(2.0) - (x * x)).abs();
    ///
    /// assert(abs_difference <= f32::EPSILON);
    /// assert_eq(1.0f32.powf(f32::NAN), 1.0);
    /// ```
    #[inline]
    pub fn powf(self, n: f32) -> f32 {
        unsafe { c_pow(self as f64, n as f64) as f32 }
    }

    /// Returns `e^(self)`, (the exponential function). navi computes it in
    /// `f64` and rounds the result to `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// let one = 1.0f32;
    /// // e^1
    /// let e = one.exp();
    ///
    /// // ln(e) - 1 == 0
    /// let abs_difference = (e.ln() - 1.0).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn exp(self) -> f32 {
        unsafe { c_exp(self as f64) as f32 }
    }

    /// Returns `2^(self)`. navi computes it in `f64` and rounds the result to
    /// `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 2.0f32;
    ///
    /// // 2^2 - 4 == 0
    /// let abs_difference = (f.exp2() - 4.0).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn exp2(self) -> f32 {
        unsafe { c_exp2(self as f64) as f32 }
    }

    /// Returns `e^(self) - 1` in a way that is accurate even if the number is
    /// close to zero. navi computes it in `f64` and rounds the result to `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 1e-8f32;
    ///
    /// // for very small x, e^x is approximately 1 + x + x^2 / 2
    /// let approx = x + x * x / 2.0;
    /// let abs_difference = (x.exp_m1() - approx).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn exp_m1(self) -> f32 {
        unsafe { c_expm1(self as f64) as f32 }
    }

    /// Returns the natural logarithm of the number. navi computes it in `f64`
    /// and rounds the result to `f32`.
    ///
    /// This returns NaN when the number is negative, and negative infinity when
    /// number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// let one = 1.0f32;
    /// // e^1
    /// let e = one.exp();
    ///
    /// // ln(e) - 1 == 0
    /// let abs_difference = (e.ln() - 1.0).abs();
    ///
    /// assert(abs_difference < 1e-6);
    ///
    /// assert_eq(0.0f32.ln(), f32::NEG_INFINITY);
    /// assert((-1.0f32).ln().is_nan());
    /// ```
    #[inline]
    pub fn ln(self) -> f32 {
        unsafe { c_log(self as f64) as f32 }
    }

    /// Returns `ln(1+n)` (natural logarithm) more accurately than if the
    /// operations were performed separately. navi computes it in `f64` and
    /// rounds the result to `f32`.
    ///
    /// This returns NaN when `n < -1.0`, and negative infinity when `n ==
    /// -1.0`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 1e-8f32;
    ///
    /// // for very small x, ln(1 + x) is approximately x - x^2 / 2
    /// let approx = x - x * x / 2.0;
    /// let abs_difference = (x.ln_1p() - approx).abs();
    ///
    /// assert(abs_difference < 1e-10);
    /// ```
    #[inline]
    pub fn ln_1p(self) -> f32 {
        unsafe { c_log1p(self as f64) as f32 }
    }

    /// Returns the logarithm of the number with respect to an arbitrary base.
    ///
    /// The result might not be correctly rounded owing to implementation
    /// details; `self.log2()` can produce more accurate results for base 2, and
    /// `self.log10()` can produce more accurate results for base 10.
    ///
    /// This returns NaN when the number is negative, and negative infinity when
    /// number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// let five = 5.0f32;
    ///
    /// // log5(5) - 1 == 0
    /// let abs_difference = (five.log(5.0) - 1.0).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn log(self, base: f32) -> f32 {
        self.ln() / base.ln()
    }

    /// Returns the base 2 logarithm of the number. navi computes it in `f64`
    /// and rounds the result to `f32`.
    ///
    /// This returns NaN when the number is negative, and negative infinity when
    /// number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// let two = 2.0f32;
    ///
    /// // log2(2) - 1 == 0
    /// let abs_difference = (two.log2() - 1.0).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn log2(self) -> f32 {
        unsafe { c_log2(self as f64) as f32 }
    }

    /// Returns the base 10 logarithm of the number. navi computes it in `f64`
    /// and rounds the result to `f32`.
    ///
    /// This returns NaN when the number is negative, and negative infinity when
    /// number is zero.
    ///
    /// # Examples
    ///
    /// ```
    /// let ten = 10.0f32;
    ///
    /// // log10(10) - 1 == 0
    /// let abs_difference = (ten.log10() - 1.0).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn log10(self) -> f32 {
        unsafe { c_log10(self as f64) as f32 }
    }

    /// Returns the cube root of a number. navi computes it in `f64` and rounds
    /// the result to `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 8.0f32;
    ///
    /// // x^(1/3) - 2 == 0
    /// let abs_difference = (x.cbrt() - 2.0).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn cbrt(self) -> f32 {
        cbrt64(self as f64) as f32
    }

    /// Compute the distance between the origin and a point (`x`, `y`) on the
    /// Euclidean plane. Equivalently, compute the length of the hypotenuse of a
    /// right-angle triangle with other sides having length `x.abs()` and
    /// `y.abs()`. navi computes it in `f64` and rounds the result to `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2.0f32;
    /// let y = 3.0f32;
    ///
    /// // sqrt(x^2 + y^2)
    /// let abs_difference = (x.hypot(y) - (x.powi(2) + y.powi(2)).sqrt()).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn hypot(self, other: f32) -> f32 {
        unsafe { c_hypot(self as f64, other as f64) as f32 }
    }

    /// Computes the sine of a number (in radians). navi computes it in `f64`
    /// and rounds the result to `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = std::f32::consts::FRAC_PI_2;
    ///
    /// let abs_difference = (x.sin() - 1.0).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn sin(self) -> f32 {
        unsafe { c_sin(self as f64) as f32 }
    }

    /// Computes the cosine of a number (in radians). navi computes it in `f64`
    /// and rounds the result to `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2.0 * std::f32::consts::PI;
    ///
    /// let abs_difference = (x.cos() - 1.0).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn cos(self) -> f32 {
        unsafe { c_cos(self as f64) as f32 }
    }

    /// Computes the tangent of a number (in radians). navi computes it in `f64`
    /// and rounds the result to `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = std::f32::consts::FRAC_PI_4;
    /// let abs_difference = (x.tan() - 1.0).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn tan(self) -> f32 {
        unsafe { c_tan(self as f64) as f32 }
    }

    /// Computes the arcsine of a number. Return value is in radians in the
    /// range [-pi/2, pi/2] or NaN if the number is outside the range [-1, 1].
    /// navi computes it in `f64` and rounds the result to `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = std::f32::consts::FRAC_PI_2;
    ///
    /// // asin(sin(pi/2))
    /// let abs_difference = (f.sin().asin() - std::f32::consts::FRAC_PI_2).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn asin(self) -> f32 {
        unsafe { c_asin(self as f64) as f32 }
    }

    /// Computes the arccosine of a number. Return value is in radians in the
    /// range [0, pi] or NaN if the number is outside the range [-1, 1]. navi
    /// computes it in `f64` and rounds the result to `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = std::f32::consts::FRAC_PI_4;
    ///
    /// // acos(cos(pi/4))
    /// let abs_difference = (f.cos().acos() - std::f32::consts::FRAC_PI_4).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn acos(self) -> f32 {
        unsafe { c_acos(self as f64) as f32 }
    }

    /// Computes the arctangent of a number. Return value is in radians in the
    /// range [-pi/2, pi/2]. navi computes it in `f64` and rounds the result to
    /// `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 1.0f32;
    ///
    /// // atan(tan(1))
    /// let abs_difference = (f.tan().atan() - 1.0).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn atan(self) -> f32 {
        unsafe { c_atan(self as f64) as f32 }
    }

    /// Computes the four quadrant arctangent of `self` (`y`) and `other` (`x`)
    /// in radians. navi computes it in `f64` and rounds the result to `f32`.
    ///
    /// - `x = 0`, `y = 0`: `0`
    /// - `x >= 0`: `arctan(y/x)` -> `[-pi/2, pi/2]`
    /// - `y >= 0`: `arctan(y/x) + pi` -> `(pi/2, pi]`
    /// - `y < 0`: `arctan(y/x) - pi` -> `(-pi, -pi/2)`
    ///
    /// # Examples
    ///
    /// ```
    /// // Positive angles measured counter-clockwise
    /// // from positive x axis
    /// // -pi/4 radians (45 deg clockwise)
    /// let x1 = 3.0f32;
    /// let y1 = -3.0f32;
    ///
    /// // 3pi/4 radians (135 deg counter-clockwise)
    /// let x2 = -3.0f32;
    /// let y2 = 3.0f32;
    ///
    /// let abs_difference_1 = (y1.atan2(x1) - (-std::f32::consts::FRAC_PI_4)).abs();
    /// let abs_difference_2 = (y2.atan2(x2) - (3.0 * std::f32::consts::FRAC_PI_4)).abs();
    ///
    /// assert(abs_difference_1 < 1e-6);
    /// assert(abs_difference_2 < 1e-6);
    /// ```
    #[inline]
    pub fn atan2(self, other: f32) -> f32 {
        unsafe { c_atan2(self as f64, other as f64) as f32 }
    }

    /// Simultaneously computes the sine and cosine of the number, `x`. Returns
    /// `(sin(x), cos(x))`. navi computes it in `f64` and rounds the result to
    /// `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = std::f32::consts::FRAC_PI_4;
    /// let f = x.sin_cos();
    ///
    /// let abs_difference_0 = (f.0 - x.sin()).abs();
    /// let abs_difference_1 = (f.1 - x.cos()).abs();
    ///
    /// assert(abs_difference_0 < 1e-6);
    /// assert(abs_difference_1 < 1e-6);
    /// ```
    #[inline]
    pub fn sin_cos(self) -> (f32, f32) {
        (self.sin(), self.cos())
    }

    /// Hyperbolic sine function. navi computes it in `f64` and rounds the
    /// result to `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// let e = std::f32::consts::E;
    /// let x = 1.0f32;
    ///
    /// let f = x.sinh();
    /// // Solving sinh() at 1 gives `(e^2-1)/(2e)`
    /// let g = ((e * e) - 1.0) / (2.0 * e);
    /// let abs_difference = (f - g).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn sinh(self) -> f32 {
        unsafe { c_sinh(self as f64) as f32 }
    }

    /// Hyperbolic cosine function. navi computes it in `f64` and rounds the
    /// result to `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// let e = std::f32::consts::E;
    /// let x = 1.0f32;
    /// let f = x.cosh();
    /// // Solving cosh() at 1 gives this result
    /// let g = ((e * e) + 1.0) / (2.0 * e);
    /// let abs_difference = (f - g).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn cosh(self) -> f32 {
        unsafe { c_cosh(self as f64) as f32 }
    }

    /// Hyperbolic tangent function. navi computes it in `f64` and rounds the
    /// result to `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// let e = std::f32::consts::E;
    /// let x = 1.0f32;
    ///
    /// let f = x.tanh();
    /// // Solving tanh() at 1 gives `(1 - e^(-2))/(1 + e^(-2))`
    /// let g = (1.0 - e.powi(-2)) / (1.0 + e.powi(-2));
    /// let abs_difference = (f - g).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn tanh(self) -> f32 {
        unsafe { c_tanh(self as f64) as f32 }
    }

    /// Inverse hyperbolic sine function. navi computes it in `f64` and rounds
    /// the result to `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 1.0f32;
    /// let f = x.sinh().asinh();
    ///
    /// let abs_difference = (f - x).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn asinh(self) -> f32 {
        unsafe { c_asinh(self as f64) as f32 }
    }

    /// Inverse hyperbolic cosine function. navi computes it in `f64` and rounds
    /// the result to `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 1.0f32;
    /// let f = x.cosh().acosh();
    ///
    /// let abs_difference = (f - x).abs();
    ///
    /// assert(abs_difference < 1e-6);
    /// ```
    #[inline]
    pub fn acosh(self) -> f32 {
        unsafe { c_acosh(self as f64) as f32 }
    }

    /// Inverse hyperbolic tangent function. navi computes it in `f64` and
    /// rounds the result to `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// let e = std::f32::consts::E;
    /// let f = e.tanh().atanh();
    ///
    /// let abs_difference = (f - e).abs();
    ///
    /// assert(abs_difference < 1e-5);
    /// ```
    #[inline]
    pub fn atanh(self) -> f32 {
        unsafe { c_atanh(self as f64) as f32 }
    }

    /// Returns the nearest integer to a number. Rounds half-way cases to the
    /// number with an even least significant digit.
    ///
    /// This function always returns the precise result.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 3.3f32;
    /// let g = -3.3f32;
    /// let h = 3.5f32;
    /// let i = 4.5f32;
    ///
    /// assert_eq(f.round_ties_even(), 3.0);
    /// assert_eq(g.round_ties_even(), -3.0);
    /// assert_eq(h.round_ties_even(), 4.0);
    /// assert_eq(i.round_ties_even(), 4.0);
    /// ```
    #[inline]
    pub fn round_ties_even(self) -> f32 {
        unsafe { c_rint(self as f64) as f32 }
    }

    /// Returns the memory representation of this floating point number as a
    /// byte array in little-endian byte order.
    ///
    /// See `to_bits` for some discussion of the portability of this operation
    /// (there are almost no issues).
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 12.5f32.to_le_bytes();
    /// assert_eq(bytes, [0x00, 0x00, 0x48, 0x41]);
    /// ```
    #[inline]
    pub fn to_le_bytes(self) -> [u8; 4] {
        self.to_bits().to_le_bytes()
    }

    /// Returns the memory representation of this floating point number as a
    /// byte array in big-endian (network) byte order.
    ///
    /// See `to_bits` for some discussion of the portability of this operation
    /// (there are almost no issues).
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 12.5f32.to_be_bytes();
    /// assert_eq(bytes, [0x41, 0x48, 0x00, 0x00]);
    /// ```
    #[inline]
    pub fn to_be_bytes(self) -> [u8; 4] {
        self.to_bits().to_be_bytes()
    }

    /// Returns the memory representation of this floating point number as a
    /// byte array in native byte order.
    ///
    /// See `to_bits` for some discussion of the portability of this operation
    /// (there are almost no issues).
    ///
    /// As the target platform's native endianness is used, portable code should
    /// use `to_be_bytes` or `to_le_bytes`, as appropriate, instead. (navi's
    /// targets are all little endian, so this is `to_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 12.5f32.to_ne_bytes();
    /// assert_eq(bytes, [0x00, 0x00, 0x48, 0x41]);
    /// ```
    #[inline]
    pub fn to_ne_bytes(self) -> [u8; 4] {
        self.to_bits().to_ne_bytes()
    }

    /// Creates a floating point value from its representation as a byte array
    /// in little endian.
    ///
    /// See `from_bits` for some discussion of the portability of this operation
    /// (there are almost no issues).
    ///
    /// # Examples
    ///
    /// ```
    /// let value = f32::from_le_bytes([0x00, 0x00, 0x48, 0x41]);
    /// assert_eq(value, 12.5);
    /// ```
    #[inline]
    pub fn from_le_bytes(bytes: [u8; 4]) -> f32 {
        f32::from_bits(u32::from_le_bytes(bytes))
    }

    /// Creates a floating point value from its representation as a byte array
    /// in big endian.
    ///
    /// See `from_bits` for some discussion of the portability of this operation
    /// (there are almost no issues).
    ///
    /// # Examples
    ///
    /// ```
    /// let value = f32::from_be_bytes([0x41, 0x48, 0x00, 0x00]);
    /// assert_eq(value, 12.5);
    /// ```
    #[inline]
    pub fn from_be_bytes(bytes: [u8; 4]) -> f32 {
        f32::from_bits(u32::from_be_bytes(bytes))
    }

    /// Creates a floating point value from its representation as a byte array
    /// in native endian.
    ///
    /// See `from_bits` for some discussion of the portability of this operation
    /// (there are almost no issues).
    ///
    /// As the target platform's native endianness is used, portable code likely
    /// wants to use `from_be_bytes` or `from_le_bytes`, as appropriate instead.
    /// (navi's targets are all little endian, so this is `from_le_bytes`.)
    ///
    /// # Examples
    ///
    /// ```
    /// let value = f32::from_ne_bytes([0x00, 0x00, 0x48, 0x41]);
    /// assert_eq(value, 12.5);
    /// ```
    #[inline]
    pub fn from_ne_bytes(bytes: [u8; 4]) -> f32 {
        f32::from_bits(u32::from_ne_bytes(bytes))
    }

    /// The radix or base of the internal representation of `f32`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f32::RADIX, 2);
    /// ```
    pub const RADIX: u32 = 2;

    /// Number of significant digits in base 2.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f32::MANTISSA_DIGITS, 24);
    /// ```
    pub const MANTISSA_DIGITS: u32 = 24;

    /// Approximate number of significant digits in base 10.
    ///
    /// This is the maximum *x* such that any decimal number with *x*
    /// significant digits can be converted to `f32` and back without loss.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f32::DIGITS, 6);
    /// ```
    pub const DIGITS: u32 = 6;

    /// Largest finite `f32` value.
    ///
    /// Equal to (1 − 2⁻²⁴) 2¹²⁸.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f32::MAX, 3.40282347e38);
    /// assert(f32::MAX * 2.0 == f32::INFINITY);
    /// ```
    pub const MAX: f32 = 3.40282347e38;

    /// Smallest finite `f32` value.
    ///
    /// Equal to −`MAX`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f32::MIN, -3.40282347e38);
    /// assert_eq(f32::MIN, -f32::MAX);
    /// ```
    pub const MIN: f32 = -3.40282347e38;

    /// [Machine epsilon] value for `f32`.
    ///
    /// This is the difference between `1.0` and the next larger representable
    /// number.
    ///
    /// Equal to 2^(1 − MANTISSA_DIGITS).
    ///
    /// [Machine epsilon]: https://en.wikipedia.org/wiki/Machine_epsilon
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f32::EPSILON, 2.0f32.powi(-23));
    /// assert(1.0 + f32::EPSILON > 1.0);
    /// assert_eq(1.0 + f32::EPSILON / 2.0, 1.0);
    /// ```
    pub const EPSILON: f32 = 1.19209290e-7;

    /// Smallest positive normal `f32` value.
    ///
    /// Equal to 2^(MIN_EXP − 1).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f32::MIN_POSITIVE, 1.17549435e-38);
    /// assert(f32::MIN_POSITIVE.is_normal());
    /// assert((f32::MIN_POSITIVE / 2.0).is_subnormal());
    /// ```
    pub const MIN_POSITIVE: f32 = 1.17549435e-38;

    /// One greater than the minimum possible *normal* power of 2 exponent for a
    /// significand bounded by 1 ≤ x < 2 (i.e. the IEEE definition).
    ///
    /// This corresponds to the exact minimum possible *normal* power of 2
    /// exponent for a significand bounded by 0.5 ≤ x < 1 (i.e. the C
    /// definition). In other words, all normal numbers representable by this
    /// type are greater than or equal to 0.5 × 2^MIN_EXP.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f32::MIN_EXP, -125);
    /// assert_eq(f32::MIN_POSITIVE, 0.5 * 2.0f32.powi(f32::MIN_EXP));
    /// ```
    pub const MIN_EXP: i32 = -125;

    /// One greater than the maximum possible power of 2 exponent for a
    /// significand bounded by 1 ≤ x < 2 (i.e. the IEEE definition).
    ///
    /// This corresponds to the exact maximum possible power of 2 exponent for a
    /// significand bounded by 0.5 ≤ x < 1 (i.e. the C definition). In other
    /// words, all numbers representable by this type are strictly less than
    /// 2^MAX_EXP.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f32::MAX_EXP, 128);
    /// assert(2.0f32.powi(f32::MAX_EXP) == f32::INFINITY);
    /// ```
    pub const MAX_EXP: i32 = 128;

    /// Minimum *x* for which 10^*x* is normal.
    ///
    /// Equal to ceil(log₁₀ `MIN_POSITIVE`).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f32::MIN_10_EXP, -37);
    /// assert(10.0f32.powi(f32::MIN_10_EXP).is_normal());
    /// ```
    pub const MIN_10_EXP: i32 = -37;

    /// Maximum *x* for which 10^*x* is normal.
    ///
    /// Equal to floor(log₁₀ `MAX`).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f32::MAX_10_EXP, 38);
    /// assert(10.0f32.powi(f32::MAX_10_EXP).is_normal());
    /// ```
    pub const MAX_10_EXP: i32 = 38;

    /// Returns `true` if this value is positive infinity or negative infinity,
    /// and `false` otherwise.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 7.0f32;
    /// let inf = f32::INFINITY;
    /// let neg_inf = f32::NEG_INFINITY;
    /// let nan = f32::NAN;
    ///
    /// assert(!f.is_infinite());
    /// assert(!nan.is_infinite());
    ///
    /// assert(inf.is_infinite());
    /// assert(neg_inf.is_infinite());
    /// ```
    #[inline]
    pub fn is_infinite(self) -> bool {
        self == f32::INFINITY || self == f32::NEG_INFINITY
    }

    /// Returns `true` if this number is neither infinite nor NaN.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 7.0f32;
    /// let inf = f32::INFINITY;
    /// let neg_inf = f32::NEG_INFINITY;
    /// let nan = f32::NAN;
    ///
    /// assert(f.is_finite());
    ///
    /// assert(!nan.is_finite());
    /// assert(!inf.is_finite());
    /// assert(!neg_inf.is_finite());
    /// ```
    #[inline]
    pub fn is_finite(self) -> bool {
        !self.is_nan() && !self.is_infinite()
    }

    /// Returns `true` if `self` has a negative sign, including `-0.0`, NaNs
    /// with negative sign bit and negative infinity.
    ///
    /// Note that IEEE 754 doesn't assign any meaning to the sign bit in case of
    /// a NaN, and the sign of a NaN that arithmetic produces is not specified.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 7.0f32;
    /// let g = -7.0f32;
    ///
    /// assert(!f.is_sign_negative());
    /// assert(g.is_sign_negative());
    /// assert((-0.0f32).is_sign_negative());
    /// ```
    #[inline]
    pub fn is_sign_negative(self) -> bool {
        self.to_bits() >> 31 == 1
    }

    /// Returns the smallest integer greater than or equal to `self`.
    ///
    /// This function always returns the precise result.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 3.01f32;
    /// let g = 4.0f32;
    ///
    /// assert_eq(f.ceil(), 4.0);
    /// assert_eq(g.ceil(), 4.0);
    /// ```
    #[inline]
    pub fn ceil(self) -> f32 {
        (self as f64).ceil() as f32
    }

    /// Returns the integer part of `self`. This means that non-integer numbers
    /// are always truncated towards zero.
    ///
    /// This function always returns the precise result.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 3.7f32;
    /// let g = 3.0f32;
    /// let h = -3.7f32;
    ///
    /// assert_eq(f.trunc(), 3.0);
    /// assert_eq(g.trunc(), 3.0);
    /// assert_eq(h.trunc(), -3.0);
    /// ```
    #[inline]
    pub fn trunc(self) -> f32 {
        (self as f64).trunc() as f32
    }

    /// Returns the nearest integer to `self`. If a value is half-way between
    /// two integers, round away from `0.0`.
    ///
    /// This function always returns the precise result.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 3.3f32;
    /// let g = -3.3f32;
    /// let h = -3.7f32;
    /// let i = 3.5f32;
    /// let j = 4.5f32;
    ///
    /// assert_eq(f.round(), 3.0);
    /// assert_eq(g.round(), -3.0);
    /// assert_eq(h.round(), -4.0);
    /// assert_eq(i.round(), 4.0);
    /// assert_eq(j.round(), 5.0);
    /// ```
    #[inline]
    pub fn round(self) -> f32 {
        (self as f64).round() as f32
    }

    /// Raises a number to an integer power.
    ///
    /// navi computes it by multiplying `self` `n.abs()` times (and taking the
    /// reciprocal for a negative `n`), so a large `n` takes long and the result
    /// can differ from Rust's in the last bits. The product is computed in
    /// `f64` and rounded to `f32`.
    ///
    /// # Panics
    ///
    /// This function panics if `n` is `i32::MIN` (Rust does not).
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2.0f32;
    /// let abs_difference = (x.powi(2) - (x * x)).abs();
    ///
    /// assert(abs_difference <= f32::EPSILON);
    /// assert_eq(x.powi(-2), 0.25);
    /// assert_eq(f32::NAN.powi(0), 1.0);
    /// ```
    #[inline]
    pub fn powi(self, n: i32) -> f32 {
        (self as f64).powi(n) as f32
    }

    /// Returns the maximum of the two numbers, ignoring NaN.
    ///
    /// If one of the arguments is NaN, then the other argument is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 1.0f32;
    /// let y = 2.0f32;
    ///
    /// assert_eq(x.max(y), y);
    /// assert_eq(x.max(f32::NAN), x);
    /// assert_eq(f32::NAN.max(y), y);
    /// ```
    #[inline]
    pub fn max(self, other: f32) -> f32 {
        if self.is_nan() || other > self {
            other
        } else {
            self
        }
    }

    /// Returns the minimum of the two numbers, ignoring NaN.
    ///
    /// If one of the arguments is NaN, then the other argument is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 1.0f32;
    /// let y = 2.0f32;
    ///
    /// assert_eq(x.min(y), x);
    /// assert_eq(x.min(f32::NAN), x);
    /// assert_eq(f32::NAN.min(y), y);
    /// ```
    #[inline]
    pub fn min(self, other: f32) -> f32 {
        if self.is_nan() || other < self {
            other
        } else {
            self
        }
    }
}

// Conversions between the integer types (Rust has them in core::convert::num).
impl From<i8> for i16 {
    fn from(value: i8) -> i16 {
        value as i16
    }
}

impl TryFrom<i8> for i16 {
    type Error = Infallible;
    fn try_from(value: i8) -> Result<i16, Infallible> {
        Ok(value as i16)
    }
}

impl From<i8> for i32 {
    fn from(value: i8) -> i32 {
        value as i32
    }
}

