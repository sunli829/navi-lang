impl i32 {
    pub fn checked_neg(self) -> Option<i32> { let (r, o) = self.overflowing_neg(); if o { None } else { Some(r) } }
    pub fn checked_pow(self, exp: u32) -> Option<i32> {
        if exp == 0 { return Some(1); }
        let mut base = self;
        let mut acc: i32 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc.checked_mul(base)?;
                if e == 1 { return Some(acc); }
            }
            e = e / 2;
            base = base.checked_mul(base)?;
        }
    }
    pub fn overflowing_pow(self, exp: u32) -> (i32, bool) {
        if exp == 0 { return (1, false); }
        let mut base = self;
        let mut acc: i32 = 1;
        let mut e = exp;
        let mut over = false;
        loop {
            if e & 1 == 1 {
                let (r, o) = acc.overflowing_mul(base);
                acc = r;
                over = over || o;
                if e == 1 { return (acc, over); }
            }
            e = e / 2;
            let (b, o) = base.overflowing_mul(base);
            base = b;
            over = over || o;
        }
    }
    pub fn saturating_pow(self, exp: u32) -> i32 {
        match self.checked_pow(exp) { Some(r) => r, None => if self < 0 && exp % 2 == 1 { i32::MIN } else { i32::MAX } }
    }
    pub fn checked_shl(self, rhs: u32) -> Option<i32> { if rhs < 32 { Some(self << rhs) } else { None } }
    pub fn checked_shr(self, rhs: u32) -> Option<i32> { if rhs < 32 { Some(self >> rhs) } else { None } }
    pub fn wrapping_shl(self, rhs: u32) -> i32 { self << (rhs % 32) }
    pub fn wrapping_shr(self, rhs: u32) -> i32 { self >> (rhs % 32) }
    pub fn overflowing_shl(self, rhs: u32) -> (i32, bool) { (self.wrapping_shl(rhs), rhs >= 32) }
    pub fn overflowing_shr(self, rhs: u32) -> (i32, bool) { (self.wrapping_shr(rhs), rhs >= 32) }
    pub fn wrapping_div(self, rhs: i32) -> i32 { if self == i32::MIN && rhs == -1 { self } else { self / rhs } }
    pub fn wrapping_rem(self, rhs: i32) -> i32 { if self == i32::MIN && rhs == -1 { 0 } else { self % rhs } }
    pub fn overflowing_div(self, rhs: i32) -> (i32, bool) { if self == i32::MIN && rhs == -1 { (self, true) } else { (self / rhs, false) } }
    pub fn overflowing_rem(self, rhs: i32) -> (i32, bool) { if self == i32::MIN && rhs == -1 { (0, true) } else { (self % rhs, false) } }
    pub fn saturating_div(self, rhs: i32) -> i32 { if self == i32::MIN && rhs == -1 { i32::MAX } else { self / rhs } }
    pub fn checked_div_euclid(self, rhs: i32) -> Option<i32> { if rhs == 0 || self == i32::MIN && rhs == -1 { None } else { Some(self.div_euclid(rhs)) } }
    pub fn checked_rem_euclid(self, rhs: i32) -> Option<i32> { if rhs == 0 || self == i32::MIN && rhs == -1 { None } else { Some(self.rem_euclid(rhs)) } }
    pub fn wrapping_div_euclid(self, rhs: i32) -> i32 { if self == i32::MIN && rhs == -1 { self } else { self.div_euclid(rhs) } }
    pub fn wrapping_rem_euclid(self, rhs: i32) -> i32 { if self == i32::MIN && rhs == -1 { 0 } else { self.rem_euclid(rhs) } }
    pub fn reverse_bits(self) -> i32 {
        let v = self as u32;
        let mut r: u32 = 0;
        let mut i = 0u32;
        while i < 32 { r = (r << 1) | ((v >> i) & 1); i += 1; }
        r as i32
    }
    pub fn to_be(self) -> i32 { self.swap_bytes() }
    pub fn to_le(self) -> i32 { self }
    pub fn from_be(x: i32) -> i32 { x.swap_bytes() }
    pub fn from_le(x: i32) -> i32 { x }
    pub fn to_be_bytes(self) -> [u8; 4] { self.swap_bytes().to_le_bytes() }
    pub fn from_be_bytes(bytes: [u8; 4]) -> i32 { i32::from_le_bytes(bytes).swap_bytes() }
    pub fn to_ne_bytes(self) -> [u8; 4] { self.to_le_bytes() }
    pub fn from_ne_bytes(bytes: [u8; 4]) -> i32 { i32::from_le_bytes(bytes) }
    pub fn leading_ones(self) -> u32 { (!self).leading_zeros() }
    pub fn trailing_ones(self) -> u32 { (!self).trailing_zeros() }
    #[track_caller]
    pub fn ilog2(self) -> u32 {
        if self <= 0 { panic("argument of integer logarithm must be positive"); }
