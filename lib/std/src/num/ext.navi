// The cube root, the same on every platform (as Go's math.Cbrt; libm's
// differ: glibc's cbrt(27) is 3.0000000000000004): musl's and FreeBSD's
// s_cbrt.c, less than 0.667 ulps off, exact for perfect cubes.
fn cbrt64(x: f64) -> f64 {
    let b1: u64 = 715094163;
    let b2: u64 = 696219795;
    let p0 = 1.87595182427177009643f64;
    let p1 = -1.88497979543377169875f64;
    let p2 = 1.621429720105354466140f64;
    let p3 = -0.758397934778766047437f64;
    let p4 = 0.145996192886612446982f64;
    let mut ui = x.to_bits();
    let mut hx = (ui >> 32) & 0x7fffffff;
    // NaN and the infinities are their own roots.
    if hx >= 0x7ff00000 {
        return x + x;
    }
    if hx < 0x00100000 {
        // Zero or subnormal: scaled by 2^54 first.
        ui = (x * 18014398509481984.0).to_bits();
        hx = (ui >> 32) & 0x7fffffff;
        if hx == 0 {
            return x;
        }
        hx = hx / 3 + b2;
    } else {
        hx = hx / 3 + b1;
    }
    ui = ui & (1u64 << 63);
    ui = ui | (hx << 32);
    let mut t = f64::from_bits(ui);
    // A polynomial approximation to 23 bits, rounded to 21 bits, then one
    // Newton step to 53 bits.
    let mut r = (t * t) * (t / x);
    t = t * ((p0 + r * (p1 + r * p2)) + ((r * r) * r) * (p3 + r * p4));
    ui = t.to_bits();
    ui = (ui + 0x80000000) & 0xffffffffc0000000;
    t = f64::from_bits(ui);
    let s = t * t;
    r = x / s;
    let w = t + t;
    r = (r - t) / (w + r);
    t + t * r
}
