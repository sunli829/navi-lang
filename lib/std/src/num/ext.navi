    }
}

impl TryFrom<i8> for u8 {
    type Error = TryFromIntError;
    fn try_from(value: i8) -> Result<u8, TryFromIntError> {
        if value < 0 || value as u64 > u8::MAX as u64 {
            Err(TryFromIntError(()))
        } else {
            Ok(value as u8)
        }
    }
}

