//! More inherent methods of the integer and float types, conversions
//! between them, and parsing of the 128-bit integers (Rust writes these
//! with macros; this was generated once, by a Go tool since removed).

use crate::{
    convert::{From, Infallible, TryFrom},
    option::Option::{self, None, Some},
    result::Result::{self, Err, Ok},
    str::{FromStr, ParseIntError},
};

/// The error type returned when a checked integral type conversion fails.
///
/// # Examples
///
/// ```
/// use std::convert::TryFrom;
///
/// let x = u8::try_from(300i32);
/// assert(x.is_err());
/// assert_eq(u8::try_from(200i32), Ok(200));
/// ```
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct TryFromIntError(());

impl crate::fmt::Display for TryFromIntError {
    fn fmt(&self, f: &mut crate::fmt::Formatter) -> crate::fmt::Result {
        f.pad("out of range integral type conversion attempted")
    }
}

/// A classification of floating point numbers.
///
/// This `enum` is used as the return type for `f32::classify` and
/// `f64::classify`. See their documentation for more.
///
/// # Examples
///
/// ```
/// use std::num::FpCategory;
///
/// let num = 12.4f32;
/// let inf = f32::INFINITY;
/// let zero = 0f32;
/// let sub = 1.1754942e-38f32;
/// let nan = f32::NAN;
///
/// assert_eq(num.classify(), FpCategory::Normal);
/// assert_eq(inf.classify(), FpCategory::Infinite);
/// assert_eq(zero.classify(), FpCategory::Zero);
/// assert_eq(sub.classify(), FpCategory::Subnormal);
/// assert_eq(nan.classify(), FpCategory::Nan);
/// ```
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum FpCategory {
    /// NaN (not a number): this value results from calculations like
    /// `(-1.0).sqrt()`.
    Nan,
    /// Positive or negative infinity, which often results from dividing a
    /// nonzero number by zero.
    Infinite,
    /// Positive or negative zero.
    Zero,
    /// “Subnormal” or “denormal” floating point representation (less precise,
    /// relative to their magnitude, than `Normal`).
    ///
    /// Subnormal numbers are larger in magnitude than `Zero` but smaller in
    /// magnitude than all `Normal` numbers.
    Subnormal,
    /// A regular floating point number, not any of the exceptional categories.
    Normal,
}

