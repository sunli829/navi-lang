//! Compiler intrinsics. Only std (including std::rt) may use them.

#[intrinsic]
pub fn size_of<T>() -> usize;
#[intrinsic]
pub fn align_of<T>() -> usize;
#[intrinsic]
pub fn abort() -> !;
/// The address of T's description (its name: std::any::type_name; its
/// address names the type: std::unique).
#[intrinsic]
pub fn type_desc<T>() -> *const u8;
/// The address of T's TypeInfo (std::derive::TypeInfo::of): a string's
/// pointer and length, the encoding std::derive decodes.
#[intrinsic]
pub fn type_info<T>() -> *const u8;
#[intrinsic]
pub fn caller_location() -> crate::panic::Location;
#[intrinsic]
pub fn wrapping_add<T>(a: T, b: T) -> T;
#[intrinsic]
pub fn wrapping_sub<T>(a: T, b: T) -> T;
#[intrinsic]
pub fn wrapping_mul<T>(a: T, b: T) -> T;
/// The high 64 bits of the 128-bit product of two u64s (umulh, mul).
#[intrinsic]
pub fn mul_hi(a: u64, b: u64) -> u64;
/// a + b + carry and the carry out (adds/adcs, add/adc; Go's bits.Add64).
#[intrinsic]
pub fn add_carry(a: u64, b: u64, carry: bool) -> (u64, bool);
/// a - b - borrow and the borrow out (subs/sbcs, sub/sbb; Go's bits.Sub64).
#[intrinsic]
pub fn sub_borrow(a: u64, b: u64, borrow: bool) -> (u64, bool);
