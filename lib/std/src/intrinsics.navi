//! Compiler intrinsics: functions the compiler implements itself.
//!
//! They are std's building blocks (std::rt uses them too); other code
//! should use the public wrappers, such as [`crate::mem::size_of`],
//! `u64::wrapping_add` or [`crate::panic::Location::caller`].

/// The size of `T` in bytes (what [`crate::mem::size_of`] returns).
#[intrinsic]
pub fn size_of<T>() -> usize;
/// The alignment of `T` in bytes (what [`crate::mem::align_of`] returns).
#[intrinsic]
pub fn align_of<T>() -> usize;
/// Ends the process at once, without unwinding or running deferred code
/// (as Rust's `std::process::abort`).
#[intrinsic]
pub fn abort() -> !;
/// The address of T's description (its name: std::any::type_name; its
/// address names the type: std::unique).
#[intrinsic]
pub fn type_desc<T>() -> *const u8;
/// The address of T's TypeInfo (std::derive::TypeInfo::of): a string's
/// pointer and length, the encoding std::derive decodes.
#[intrinsic]
pub fn type_info<T>() -> *const u8;
/// The source location of the call to the `#[track_caller]` function this
/// is used in (what [`crate::panic::Location::caller`] returns).
#[intrinsic]
pub fn caller_location() -> crate::panic::Location;
/// `a + b` for an integer type, wrapping around at the type's bounds
/// instead of panicking on overflow.
#[intrinsic]
pub fn wrapping_add<T>(a: T, b: T) -> T;
/// `a - b` for an integer type, wrapping around at the type's bounds
/// instead of panicking on overflow.
#[intrinsic]
pub fn wrapping_sub<T>(a: T, b: T) -> T;
/// `a * b` for an integer type, wrapping around at the type's bounds
/// instead of panicking on overflow.
#[intrinsic]
pub fn wrapping_mul<T>(a: T, b: T) -> T;
/// The high 64 bits of the 128-bit product of two u64s (umulh, mul).
#[intrinsic]
pub fn mul_hi(a: u64, b: u64) -> u64;
/// a + b + carry and the carry out (adds/adcs, add/adc; Go's bits.Add64).
#[intrinsic]
pub fn add_carry(a: u64, b: u64, carry: bool) -> (u64, bool);
/// a - b - borrow and the borrow out (subs/sbcs, sub/sbb; Go's bits.Sub64).
#[intrinsic]
pub fn sub_borrow(a: u64, b: u64, borrow: bool) -> (u64, bool);
