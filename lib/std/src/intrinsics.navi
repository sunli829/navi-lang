//! Compiler intrinsics. Only std (including std::rt) may use them.

#[intrinsic]
pub fn size_of<T>() -> usize;
#[intrinsic]
pub fn align_of<T>() -> usize;
#[intrinsic]
pub fn abort() -> !;
/// The address of T's description (std::reflect).
#[intrinsic]
pub fn type_desc<T>() -> *const u8;
#[intrinsic]
pub fn caller_location() -> crate::panic::Location;
#[intrinsic]
pub fn wrapping_add<T>(a: T, b: T) -> T;
#[intrinsic]
pub fn wrapping_sub<T>(a: T, b: T) -> T;
#[intrinsic]
pub fn wrapping_mul<T>(a: T, b: T) -> T;
