//! A growable UTF-8 string. String has reference semantics: copying it
//! shares the buffer; use clone() for an independent copy.

use crate::fmt;
use crate::ops::{Deref, DerefMut};

pub struct String {
    buf: &mut StringBuf,
}

struct StringBuf {
    bytes: crate::vec::Vec<u8>,
}

impl String {
    pub fn new() -> String { todo() }
    pub fn with_capacity(capacity: usize) -> String { todo() }
    pub fn from_utf8(bytes: crate::vec::Vec<u8>) -> Result<String, FromUtf8Error> { todo() }
    pub fn push(&mut self, c: char) { todo() }
    pub fn push_str(&mut self, s: &str) { todo() }
    pub fn pop(&mut self) -> Option<char> { todo() }
    pub fn as_str(&self) -> &str { todo() }
    pub fn len(&self) -> usize { todo() }
    pub fn is_empty(&self) -> bool { self.len() == 0 }
    pub fn clear(&mut self) { todo() }
    pub fn into_bytes(self) -> crate::vec::Vec<u8> { todo() }
}

#[derive(Debug)]
pub struct FromUtf8Error { bytes: crate::vec::Vec<u8> }

impl Deref for String {
    type Target = str;
    fn deref(&self) -> &str { self.as_str() }
}

impl DerefMut for String {
    fn deref_mut(&mut self) -> &mut str { todo() }
}

impl Clone for String {
    fn clone(&self) -> String { todo() }
}

impl Default for String {
    fn default() -> String { String::new() }
}

impl From<&str> for String {
    fn from(s: &str) -> String { let mut out = String::new(); out.push_str(s); out }
}

impl fmt::Display for String {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result { f.pad(self.as_str()) }
}

impl fmt::Debug for String {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result { todo() }
}

impl fmt::Write for String {
    fn write_str(&mut self, s: &str) -> fmt::Result { self.push_str(s); Ok(()) }
}

pub trait ToString {
    fn to_string(&self) -> String;
}

impl<T: fmt::Display> ToString for T {
    fn to_string(&self) -> String { `${self}` }
}
