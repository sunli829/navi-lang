//! A growable UTF-8 string. String has reference semantics (it shares the
//! buffer of its Vec<u8>): copying a String shares the text; use clone()
//! for an independent copy.

use crate::fmt;
use crate::hash::{Hash, Hasher};
use crate::ops::{Add, Deref, DerefMut};
use crate::vec::Vec;

pub struct String {
    vec: Vec<u8>,
}

impl String {
    pub fn new() -> String { String { vec: Vec::new() } }
    pub fn with_capacity(capacity: usize) -> String { String { vec: Vec::with_capacity(capacity) } }

    pub fn from_utf8(bytes: Vec<u8>) -> Result<String, FromUtf8Error> {
        if crate::str::utf8_valid(bytes.as_slice()) { Ok(String { vec: bytes }) } else { Err(FromUtf8Error { bytes }) }
    }

    /// Converts bytes, replacing invalid sequences with U+FFFD.
    pub fn from_utf8_lossy(bytes: &[u8]) -> String {
        if crate::str::utf8_valid(bytes) {
            let mut v = Vec::new();
            v.extend_from_slice(bytes);
            return String { vec: v };
        }
        let mut s = String::new();
        let mut i = 0;
        while i < bytes.len() {
            let n = crate::str::utf8_seq_len(bytes, i);
            if n == 0 {
                s.push('\u{FFFD}');
                i += 1;
            } else {
                let mut j = 0;
                while j < n { s.vec.push(bytes[i + j]); j += 1; }
                i += n;
            }
        }
        s
    }

    pub fn insert(&mut self, idx: usize, c: char) {
        let mut tmp = String::new();
        tmp.push(c);
        self.insert_str(idx, tmp.as_str());
    }

    pub fn insert_str(&mut self, idx: usize, s: &str) {
        let tail = self.as_str()[idx..].to_string();
        self.vec.truncate(idx);
        self.push_str(s);
        self.push_str(tail.as_str());
    }

    pub fn remove(&mut self, idx: usize) -> char {
        let c = self.as_str()[idx..].chars().next().unwrap();
        let tail = self.as_str()[idx + c.len_utf8()..].to_string();
        self.vec.truncate(idx);
        self.push_str(tail.as_str());
        c
    }

    pub fn truncate(&mut self, len: usize) { self.vec.truncate(len); }

    pub fn split_off(&mut self, at: usize) -> String {
        let tail = self.as_str()[at..].to_string();
        self.vec.truncate(at);
        tail
    }

    pub fn retain(&mut self, f: fn(char) -> bool) {
        let old = self.as_str().to_string();
        self.vec.clear();
        for c in old.chars() { if f(c) { self.push(c); } }
    }

    pub fn capacity(&self) -> usize { self.vec.capacity() }
    pub fn reserve(&mut self, n: usize) { self.vec.reserve(n); }


    pub fn push(&mut self, c: char) {
        let v = c as u32;
        if v < 0x80 {
            self.vec.push(v as u8);
        } else if v < 0x800 {
            self.vec.push((0xC0 | (v >> 6)) as u8);
            self.vec.push((0x80 | (v & 0x3F)) as u8);
        } else if v < 0x10000 {
            self.vec.push((0xE0 | (v >> 12)) as u8);
            self.vec.push((0x80 | ((v >> 6) & 0x3F)) as u8);
            self.vec.push((0x80 | (v & 0x3F)) as u8);
        } else {
            self.vec.push((0xF0 | (v >> 18)) as u8);
            self.vec.push((0x80 | ((v >> 12) & 0x3F)) as u8);
            self.vec.push((0x80 | ((v >> 6) & 0x3F)) as u8);
            self.vec.push((0x80 | (v & 0x3F)) as u8);
        }
    }

    pub fn push_str(&mut self, s: &str) { self.vec.extend_from_slice(s.as_bytes()); }

    pub fn pop(&mut self) -> Option<char> {
        let c = self.as_str().chars().last()?;
        let n = c.len_utf8();
        self.vec.truncate(self.vec.len() - n);
        Some(c)
    }

    pub fn as_str(&self) -> &str { crate::rt::str_from_raw(self.vec.as_ptr(), self.vec.len()) }
    pub fn as_bytes(&self) -> &[u8] { self.vec.as_slice() }
    pub fn len(&self) -> usize { self.vec.len() }
    pub fn is_empty(&self) -> bool { self.vec.len() == 0 }
    pub fn clear(&mut self) { self.vec.clear(); }
    pub fn into_bytes(self) -> Vec<u8> { self.vec }
}

#[derive(Debug)]
pub struct FromUtf8Error { bytes: Vec<u8> }

impl Deref for String {
    type Target = str;
    fn deref(&self) -> &str { self.as_str() }
}

impl DerefMut for String {
    fn deref_mut(&mut self) -> &mut str { todo() }
}

impl Clone for String {
    fn clone(&self) -> String { String::from(self.as_str()) }
}

impl PartialEq for String {
    fn eq(&self, other: &String) -> bool { self.as_str() == other.as_str() }
}

impl PartialEq<&str> for String {
    fn eq(&self, other: &&str) -> bool { self.as_str() == *other }
}

impl Eq for String {}

impl PartialOrd for String {
    fn partial_cmp(&self, other: &String) -> Option<crate::cmp::Ordering> { self.as_str().partial_cmp(other.as_str()) }
}

impl Ord for String {
    fn cmp(&self, other: &String) -> crate::cmp::Ordering { self.as_str().cmp(other.as_str()) }
}

impl Hash for String {
    fn hash<H: Hasher>(&self, state: &mut H) { self.as_str().hash(state) }
}

impl Default for String {
    fn default() -> String { String::new() }
}

impl From<char> for String {
    fn from(c: char) -> String { let mut s = String::new(); s.push(c); s }
}

impl From<&String> for String {
    fn from(s: &String) -> String { s.clone() }
}

impl crate::ops::AddAssign<&str> for String {
    fn add_assign(&mut self, other: &str) { self.push_str(other); }
}

impl PartialEq<str> for String {
    fn eq(&self, other: &str) -> bool { self.as_str() == other }
}

impl PartialEq<String> for &str {
    fn eq(&self, other: &String) -> bool { *self == other.as_str() }
}

impl FromIterator<char> for String {
    fn from_iter<I: IntoIterator<Item = char>>(iter: I) -> String {
        let mut s = String::new();
        for c in iter { s.push(c); }
        s
    }
}

impl FromIterator<&str> for String {
    fn from_iter<I: IntoIterator<Item = &str>>(iter: I) -> String {
        let mut s = String::new();
        for p in iter { s.push_str(p); }
        s
    }
}

impl FromIterator<String> for String {
    fn from_iter<I: IntoIterator<Item = String>>(iter: I) -> String {
        let mut s = String::new();
        for p in iter { s.push_str(p.as_str()); }
        s
    }
}

impl Extend<char> for String {
    fn extend<I: IntoIterator<Item = char>>(&mut self, iter: I) { for c in iter { self.push(c); } }
}

impl Extend<&str> for String {
    fn extend<I: IntoIterator<Item = &str>>(&mut self, iter: I) { for p in iter { self.push_str(p); } }
}

impl From<&str> for String {
    fn from(s: &str) -> String { let mut out = String::new(); out.push_str(s); out }
}

impl Add<&str> for String {
    type Output = String;
    fn add(self, s: &str) -> String { let mut out = self.clone(); out.push_str(s); out }
}

impl fmt::Display for String {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result { f.pad(self.as_str()) }
}

impl fmt::Debug for String {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result { fmt::Debug::fmt(self.as_str(), f) }
}

impl fmt::Write for String {
    fn write_str(&mut self, s: &str) -> fmt::Result { self.push_str(s); Ok(()) }
}

pub trait ToString {
    fn to_string(&self) -> String;
}

impl<T: fmt::Display> ToString for T {
    fn to_string(&self) -> String { `${self}` }
}
