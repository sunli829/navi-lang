//! A UTF-8–encoded, growable string.
//!
//! This module contains the [`String`] type, the [`ToString`] trait for
//! converting to strings, and the error and iterator types of `String`'s
//! methods.
//!
//! `String` has reference semantics (it shares the buffer of its
//! `Vec<u8>`): copying a `String` shares the text; use `clone()` for an
//! independent copy.
//!
//! # Examples
//!
//! There are multiple ways to create a new [`String`] from a string
//! literal:
//!
//! ```
//! let s = "Hello".to_string();
//! let s = String::from("world");
//! let s: String = "also this".into();
//! ```
//!
//! You can create a new [`String`] from an existing one by concatenating
//! with `+`, or with a template string:
//!
//! ```
//! let s = "Hello".to_string();
//! let message = s + " world!";
//! assert_eq(message, "Hello world!");
//!
//! let name = "Ferris";
//! let greeting = `Hello, ${name}!`.to_string();
//! assert_eq(greeting, "Hello, Ferris!");
//! ```
//!
//! If you have a vector of valid UTF-8 bytes, you can make a [`String`]
//! out of it. You can do the reverse too.
//!
//! ```
//! let sparkle_heart = Vec::from([240u8, 159, 146, 150]);
//! let sparkle_heart = String::from_utf8(sparkle_heart).unwrap();
//! assert_eq("💖", sparkle_heart);
//!
//! let bytes = sparkle_heart.into_bytes();
//! assert_eq(bytes, [240u8, 159, 146, 150]);
//! ```

use crate::{
    fmt,
    hash::{Hash, Hasher},
    ops::{Add, Deref, DerefMut},
    vec::Vec,
};

/// A UTF-8–encoded, growable string.
///
/// `String` is the string type that owns its text, as opposed to the
/// string slice `&str`, which views text kept elsewhere. A `String`
/// dereferences to a `&str`, so all of `str`'s methods (`str::len`,
/// `str::find`, `str::split` ...) can be called on a `String`, and
/// `&s` or [`String::as_str`] can be passed where a `&str` is expected.
///
/// Unlike Rust's, a `String` is a handle: assigning or passing it shares
/// the text (as with a [`Vec`]), so a change made through one copy is seen
/// through the other. Use `clone()` to get an independent copy.
///
/// # UTF-8
///
/// A `String` is always valid UTF-8. Indexing it by an integer is not
/// possible: a `char` may take up to four bytes, so the byte at an index is
/// not necessarily a character. Iterate with `str::chars` or
/// `str::char_indices`, or slice it with a byte range (`&s[1..3]`).
///
/// # Examples
///
/// ```
/// let mut hello = String::from("Hello, ");
/// hello.push('w');
/// hello.push_str("orld!");
/// assert_eq(hello, "Hello, world!");
///
/// // copies share the text; clone() does not
/// let shared = hello;
/// let mut copy = hello.clone();
/// hello.push('!');
/// copy.clear();
/// assert_eq(shared, "Hello, world!!");
/// assert(copy.is_empty());
/// ```
pub struct String {
    vec: Vec<u8>,
}

impl String {
    /// Converts the `String` to a new, independent `String` with the same
    /// text.
    ///
    /// The same as [`ToString::to_string`] (or [`Clone::clone`]), without
    /// the formatting machinery.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = String::from("abc");
    /// let mut b = a.to_string();
    /// b.push('d');
    /// assert_eq(a, "abc");
    /// assert_eq(b, "abcd");
    /// ```
    #[inline]
    pub fn to_string(&self) -> String {
        String::from(self.as_str())
    }

    /// Creates a new empty `String`.
    ///
    /// Given that the `String` is empty, this will not allocate any initial
    /// buffer. If you know how much text you will add, consider
    /// [`String::with_capacity`].
    ///
    /// # Examples
    ///
    /// ```
    /// let s = String::new();
    /// assert(s.is_empty());
    /// assert_eq(s, "");
    /// ```
    #[inline]
    pub fn new() -> String {
        String { vec: Vec::new() }
    }

    /// Creates a new empty `String` with at least the specified capacity
    /// (in bytes).
    ///
    /// The string can hold `capacity` bytes without reallocating.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut s = String::with_capacity(10);
    /// assert_eq(s.len(), 0);
    /// assert(s.capacity() >= 10);
    ///
    /// // these are all done without reallocating...
    /// let cap = s.capacity();
    /// for _ in 0..10 {
    ///     s.push('a');
    /// }
    /// assert_eq(s.capacity(), cap);
    /// ```
    #[inline]
    pub fn with_capacity(capacity: usize) -> String {
        String {
            vec: Vec::with_capacity(capacity),
        }
    }

    /// Converts a vector of bytes to a `String`.
    ///
    /// The bytes are not copied: the `String` shares the vector's buffer
    /// (see [`String::into_bytes`] for the reverse). If you need a `&str`
    /// instead of a `String`, consider [`crate::str::from_utf8`]; to replace
    /// invalid bytes instead of failing, [`String::from_utf8_lossy`].
    ///
    /// # Errors
    ///
    /// Returns [`FromUtf8Error`] if the bytes are not valid UTF-8; it holds
    /// the bytes, which [`FromUtf8Error::into_bytes`] gives back.
    ///
    /// # Examples
    ///
    /// ```
    /// let sparkle_heart = Vec::from([240u8, 159, 146, 150]);
    /// let sparkle_heart = String::from_utf8(sparkle_heart).unwrap();
    /// assert_eq("💖", sparkle_heart);
    ///
    /// // some invalid bytes
    /// let bytes = Vec::from([0u8, 159, 146, 150]);
    /// assert(String::from_utf8(bytes).is_err());
    /// ```
    pub fn from_utf8(bytes: Vec<u8>) -> Result<String, FromUtf8Error> {
        if crate::str::utf8_valid(bytes.as_slice()) {
            Ok(String { vec: bytes })
        } else {
            Err(FromUtf8Error { bytes })
        }
    }

    /// Converts a slice of bytes to a string, replacing invalid UTF-8 with
    /// the replacement character U+FFFD (�).
    ///
    /// The bytes are always copied. Unlike Rust's, which returns a
    /// `Cow<str>`, this returns a new `String`, and each invalid byte (not
    /// each maximal invalid sequence) becomes one U+FFFD.
    ///
    /// # Examples
    ///
    /// ```
    /// let sparkle_heart = [240u8, 159, 146, 150];
    /// assert_eq(String::from_utf8_lossy(&sparkle_heart), "💖");
    ///
    /// let input = b"Hello \xF0\x90\x80World";
    /// assert_eq(
    ///     String::from_utf8_lossy(input),
    ///     "Hello \u{FFFD}\u{FFFD}\u{FFFD}World",
    /// );
    /// ```
    pub fn from_utf8_lossy(bytes: &[u8]) -> String {
        if crate::str::utf8_valid(bytes) {
            let mut v = Vec::new();
            v.extend_from_slice(bytes);
            return String { vec: v };
        }
        let mut s = String::new();
        let mut i = 0;
        while i < bytes.len() {
            let n = crate::str::utf8_seq_len(bytes, i);
            if n == 0 {
                s.push('\u{FFFD}');
                i += 1;
            } else {
                let mut j = 0;
                while j < n {
                    s.vec.push(bytes[i + j]);
                    j += 1;
                }
                i += n;
            }
        }
        s
    }

    /// Inserts a character into this `String` at a byte position.
    ///
    /// This is an *O*(*n*) operation as it requires copying every byte
    /// after the position.
    ///
    /// # Panics
    ///
    /// Panics if `idx` is larger than the `String`'s length. Unlike Rust,
    /// `idx` is not checked to be on a `char` boundary.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut s = String::with_capacity(3);
    /// s.insert(0, 'f');
    /// s.insert(1, 'o');
    /// s.insert(2, 'o');
    /// assert_eq(s, "foo");
    /// s.insert(0, '¡');
    /// assert_eq(s, "¡foo");
    /// ```
    pub fn insert(&mut self, idx: usize, c: char) {
        let mut tmp = String::new();
        tmp.push(c);
        self.insert_str(idx, tmp.as_str());
    }

    /// Inserts a string slice into this `String` at a byte position.
    ///
    /// This is an *O*(*n*) operation as it requires copying every byte
    /// after the position.
    ///
    /// # Panics
    ///
    /// Panics if `idx` is larger than the `String`'s length. Unlike Rust,
    /// `idx` is not checked to be on a `char` boundary.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut s = String::from("bar");
    /// s.insert_str(0, "foo");
    /// assert_eq(s, "foobar");
    /// ```
    pub fn insert_str(&mut self, idx: usize, s: &str) {
        let tail = self.as_str()[idx..].to_string();
        self.vec.truncate(idx);
        self.push_str(s);
        self.push_str(tail.as_str());
    }

    /// Removes a `char` from this `String` at a byte position and returns
    /// it.
    ///
    /// This is an *O*(*n*) operation, as it requires copying every byte
    /// after the removed character.
    ///
    /// # Panics
    ///
    /// Panics if `idx` is larger than or equal to the `String`'s length.
    /// `idx` should be on a `char` boundary (unlike Rust, this is not
    /// checked).
    ///
    /// # Examples
    ///
    /// ```
    /// let mut s = String::from("ábc");
    /// assert_eq(s.remove(0), 'á');
    /// assert_eq(s.remove(1), 'c');
    /// assert_eq(s.remove(0), 'b');
    /// assert(s.is_empty());
    /// ```
    pub fn remove(&mut self, idx: usize) -> char {
        let c = self.as_str()[idx..].chars().next().unwrap();
        let tail = self.as_str()[idx + c.len_utf8()..].to_string();
        self.vec.truncate(idx);
        self.push_str(tail.as_str());
        c
    }

    /// Shortens this `String` to the specified length in bytes.
    ///
    /// If `new_len` is greater than or equal to the string's current
    /// length, this has no effect. It has no effect on the capacity.
    ///
    /// `new_len` should be on a `char` boundary: unlike Rust, navi does
    /// not check it (cutting a character in two leaves invalid UTF-8).
    ///
    /// # Examples
    ///
    /// ```
    /// let mut s = String::from("hello");
    /// s.truncate(2);
    /// assert_eq(s, "he");
    /// s.truncate(10);
    /// assert_eq(s, "he");
    /// ```
    #[inline]
    pub fn truncate(&mut self, len: usize) {
        self.vec.truncate(len);
    }

    /// Splits the string into two at the given byte index.
    ///
    /// Returns a newly allocated `String` with the bytes `[at, len)`;
    /// `self` is left with the bytes `[0, at)`. Its capacity is unchanged.
    ///
    /// # Panics
    ///
    /// Panics if `at` is beyond the last byte of the string. Unlike Rust,
    /// `at` is not checked to be on a `char` boundary.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut hello = String::from("Hello, World!");
    /// let world = hello.split_off(7);
    /// assert_eq(hello, "Hello, ");
    /// assert_eq(world, "World!");
    /// ```
    pub fn split_off(&mut self, at: usize) -> String {
        let tail = self.as_str()[at..].to_string();
        self.vec.truncate(at);
        tail
    }

    /// Retains only the characters specified by the predicate.
    ///
    /// In other words, removes all characters `c` such that `f(c)` returns
    /// `false`. The characters left are kept in their order.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut s = String::from("f_o_ob_ar");
    /// s.retain(|c| c != '_');
    /// assert_eq(s, "foobar");
    ///
    /// let mut t = String::from("a1b2c3");
    /// t.retain(|c| c.is_alphabetic());
    /// assert_eq(t, "abc");
    /// ```
    pub fn retain(&mut self, f: fn(char) -> bool) {
        let old = self.as_str().to_string();
        self.vec.clear();
        for c in old.chars() {
            if f(c) {
                self.push(c);
            }
        }
    }

    /// Returns this `String`'s capacity, in bytes.
    ///
    /// # Examples
    ///
    /// ```
    /// let s = String::with_capacity(10);
    /// assert(s.capacity() >= 10);
    /// ```
    #[inline]
    pub fn capacity(&self) -> usize {
        self.vec.capacity()
    }

    /// Reserves capacity for at least `additional` bytes more than the
    /// current length.
    ///
    /// The allocator may reserve more space to speculatively avoid frequent
    /// allocations. After calling `reserve`, capacity will be greater than
    /// or equal to `self.len() + additional`. Does nothing if capacity is
    /// already sufficient.
    ///
    /// # Panics
    ///
    /// Panics if the new capacity overflows `usize`.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut s = String::new();
    /// s.reserve(10);
    /// assert(s.capacity() >= 10);
    ///
    /// let cap = s.capacity();
    /// s.push_str("0123456789");
    /// assert_eq(s.capacity(), cap); // no reallocation
    /// ```
    #[inline]
    pub fn reserve(&mut self, n: usize) {
        self.vec.reserve(n);
    }

    /// Appends the given `char` to the end of this `String`.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut s = String::from("abc");
    /// s.push('1');
    /// s.push('2');
    /// s.push('€');
    /// assert_eq(s, "abc12€");
    /// assert_eq(s.len(), 8);
    /// ```
    pub fn push(&mut self, c: char) {
        let v = c as u32;
        if v < 0x80 {
            self.vec.push(v as u8);
        } else if v < 0x800 {
            self.vec.push((0xC0 | (v >> 6)) as u8);
            self.vec.push((0x80 | (v & 0x3F)) as u8);
        } else if v < 0x10000 {
            self.vec.push((0xE0 | (v >> 12)) as u8);
            self.vec.push((0x80 | ((v >> 6) & 0x3F)) as u8);
            self.vec.push((0x80 | (v & 0x3F)) as u8);
        } else {
            self.vec.push((0xF0 | (v >> 18)) as u8);
            self.vec.push((0x80 | ((v >> 12) & 0x3F)) as u8);
            self.vec.push((0x80 | ((v >> 6) & 0x3F)) as u8);
            self.vec.push((0x80 | (v & 0x3F)) as u8);
        }
    }

    /// Appends a given string slice onto the end of this `String`.
    ///
    /// `s += "text"` does the same.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut s = String::from("foo");
    /// s.push_str("bar");
    /// assert_eq(s, "foobar");
    ///
    /// s += "baz";
    /// assert_eq(s, "foobarbaz");
    /// ```
    #[inline]
    pub fn push_str(&mut self, s: &str) {
        self.vec.extend_from_slice(s.as_bytes());
    }

    /// Removes the last character from the string buffer and returns it.
    ///
    /// Returns [`None`] if this `String` is empty.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut s = String::from("abč");
    /// assert_eq(s.pop(), Some('č'));
    /// assert_eq(s.pop(), Some('b'));
    /// assert_eq(s.pop(), Some('a'));
    /// assert_eq(s.pop(), None);
    /// ```
    pub fn pop(&mut self) -> Option<char> {
        let c = self.as_str().chars().next_back()?;
        let n = c.len_utf8();
        self.vec.truncate(self.vec.len() - n);
        Some(c)
    }

    /// Extracts a string slice containing the entire `String`.
    ///
    /// The slice views the `String`'s buffer: it is not a copy, and it sees
    /// changes made in place (until the `String` reallocates).
    ///
    /// # Examples
    ///
    /// ```
    /// let s = String::from("foo");
    /// let slice: &str = s.as_str();
    /// assert_eq(slice, "foo");
    /// assert(slice.starts_with('f'));
    /// ```
    #[inline]
    pub fn as_str(&self) -> &str {
        crate::rt::str_from_raw(self.vec.as_ptr(), self.vec.len())
    }

    /// Returns a byte slice of this `String`'s contents.
    ///
    /// The inverse of this method is [`crate::str::from_utf8`].
    ///
    /// # Examples
    ///
    /// ```
    /// let s = String::from("hello");
    /// assert_eq(s.as_bytes(), b"hello");
    /// assert_eq(s.as_bytes(), &[104u8, 101, 108, 108, 111][..]);
    /// ```
    #[inline]
    pub fn as_bytes(&self) -> &[u8] {
        self.vec.as_slice()
    }

    /// Returns the length of this `String`, in bytes, not `char`s or
    /// graphemes.
    ///
    /// # Examples
    ///
    /// ```
    /// let a = String::from("foo");
    /// assert_eq(a.len(), 3);
    ///
    /// let fancy_f = String::from("ƒoo");
    /// assert_eq(fancy_f.len(), 4);
    /// assert_eq(fancy_f.chars().count(), 3);
    /// ```
    #[inline]
    pub fn len(&self) -> usize {
        self.vec.len()
    }

    /// Returns `true` if this `String` has a length of zero, and `false`
    /// otherwise.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut v = String::new();
    /// assert(v.is_empty());
    ///
    /// v.push('a');
    /// assert(!v.is_empty());
    /// ```
    #[inline]
    pub fn is_empty(&self) -> bool {
        self.vec.len() == 0
    }

    /// Truncates this `String`, removing all contents.
    ///
    /// The `String` then has a length of zero, but its capacity is
    /// unchanged.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut s = String::from("foo");
    /// s.clear();
    /// assert(s.is_empty());
    /// assert_eq(s.len(), 0);
    /// assert(s.capacity() >= 3);
    /// ```
    #[inline]
    pub fn clear(&mut self) {
        self.vec.clear();
    }

    /// Converts a `String` into a byte vector.
    ///
    /// The vector shares the `String`'s buffer: nothing is copied.
    ///
    /// # Examples
    ///
    /// ```
    /// let s = String::from("hello");
    /// let bytes = s.into_bytes();
    /// assert_eq(bytes, [104u8, 101, 108, 108, 111]);
    /// ```
    #[inline]
    pub fn into_bytes(self) -> Vec<u8> {
        self.vec
    }
}

/// A possible error value when converting a `String` from a UTF-8 byte
/// vector.
///
/// This is the error of [`String::from_utf8`]. It keeps the bytes given,
/// which [`FromUtf8Error::into_bytes`] returns. Unlike Rust's, it has no
/// `utf8_error` (navi's [`crate::str::Utf8Error`] carries no position).
/// It displays as "invalid utf-8 sequence".
///
/// # Examples
///
/// ```
/// // some invalid bytes, in a vector
/// let bytes = Vec::from([0u8, 159]);
/// let value = String::from_utf8(bytes);
/// assert(value.is_err());
/// let err = value.unwrap_err();
/// assert_eq(err.into_bytes(), [0u8, 159]);
/// ```
#[derive(Debug)]
pub struct FromUtf8Error {
    bytes: Vec<u8>,
}

impl Deref for String {
    type Target = str;
    fn deref(&self) -> &str {
        self.as_str()
    }
}

impl DerefMut for String {
    fn deref_mut(&mut self) -> &mut str {
        self.as_mut_str()
    }
}

impl Clone for String {
    fn clone(&self) -> String {
        String::from(self.as_str())
    }
}

impl PartialEq for String {
    fn eq(&self, other: &String) -> bool {
        self.as_str() == other.as_str()
    }
}

impl PartialEq<&str> for String {
    fn eq(&self, other: &&str) -> bool {
        self.as_str() == *other
    }
}

impl Eq for String {}

impl PartialOrd for String {
    fn partial_cmp(&self, other: &String) -> Option<crate::cmp::Ordering> {
        self.as_str().partial_cmp(other.as_str())
    }
}

impl Ord for String {
    fn cmp(&self, other: &String) -> crate::cmp::Ordering {
        self.as_str().cmp(other.as_str())
    }
}

impl Hash for String {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.as_str().hash(state)
    }
}

impl Default for String {
    fn default() -> String {
        String::new()
    }
}

impl From<char> for String {
    fn from(c: char) -> String {
        let mut s = String::new();
        s.push(c);
        s
    }
}

impl From<&String> for String {
    fn from(s: &String) -> String {
        s.clone()
    }
}

impl crate::ops::AddAssign<&str> for String {
    fn add_assign(&mut self, other: &str) {
        self.push_str(other);
    }
}

impl PartialEq<str> for String {
    fn eq(&self, other: &str) -> bool {
        self.as_str() == other
    }
}

impl PartialEq<String> for &str {
    fn eq(&self, other: &String) -> bool {
        *self == other.as_str()
    }
}

impl FromIterator<char> for String {
    fn from_iter<I: IntoIterator<Item = char>>(iter: I) -> String {
        let mut s = String::new();
        for c in iter {
            s.push(c);
        }
        s
    }
}

impl FromIterator<&str> for String {
    fn from_iter<I: IntoIterator<Item = &str>>(iter: I) -> String {
        let mut s = String::new();
        for p in iter {
            s.push_str(p);
        }
        s
    }
}

impl FromIterator<String> for String {
    fn from_iter<I: IntoIterator<Item = String>>(iter: I) -> String {
        let mut s = String::new();
        for p in iter {
            s.push_str(p.as_str());
        }
        s
    }
}

impl Extend<char> for String {
    fn extend<I: IntoIterator<Item = char>>(&mut self, iter: I) {
        for c in iter {
            self.push(c);
        }
    }
}

impl Extend<&str> for String {
    fn extend<I: IntoIterator<Item = &str>>(&mut self, iter: I) {
        for p in iter {
            self.push_str(p);
        }
    }
}

impl From<&str> for String {
    fn from(s: &str) -> String {
        let mut out = String::new();
        out.push_str(s);
        out
    }
}

impl Add<&str> for String {
    type Output = String;
    fn add(self, s: &str) -> String {
        let mut out = self.clone();
        out.push_str(s);
        out
    }
}

impl fmt::Display for String {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        f.pad(self.as_str())
    }
}

impl fmt::Debug for String {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        fmt::Debug::fmt(self.as_str(), f)
    }
}

impl fmt::Write for String {
    fn write_str(&mut self, s: &str) -> fmt::Result {
        self.push_str(s);
        Ok(())
    }
}

/// A trait for converting a value to a `String`.
///
/// This trait is automatically implemented for any type which implements
/// the [`fmt::Display`] trait. As such, `ToString` shouldn't be implemented
/// directly: [`fmt::Display`] should be implemented instead, and you get
/// the `ToString` implementation for free.
///
/// # Examples
///
/// ```
/// use std::fmt;
///
/// struct Celsius(f64);
///
/// impl fmt::Display for Celsius {
///     fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
///         f.write_str(`${self.0}°C`.to_string().as_str())
///     }
/// }
///
/// assert_eq(Celsius(21.5).to_string(), "21.5°C");
/// assert_eq(5.to_string(), "5");
/// assert_eq('x'.to_string(), "x");
/// ```
pub trait ToString {
    /// Converts the given value to a `String`.
    ///
    /// # Examples
    ///
    /// ```
    /// let i = 5;
    /// let five = String::from("5");
    /// assert_eq(five, i.to_string());
    /// ```
    fn to_string(&self) -> String;
}

impl<T: fmt::Display> ToString for T {
    fn to_string(&self) -> String {
        `${self}`.to_string()
    }
}

// ---------------------------------------------------------------------------

#[track_caller]
fn check_boundary(s: &str, i: usize) {
    if !s.is_char_boundary(i) {
        panic(`byte index ${i} is not a char boundary`);
    }
}

impl String {
    /// Converts a vector of bytes to a `String` without checking that the
    /// string contains valid UTF-8.
    ///
    /// See the safe version, [`String::from_utf8`], for more details. The
    /// `String` shares the vector's buffer.
    ///
    /// # Safety
    ///
    /// The bytes must be valid UTF-8. The methods of `String` and `str`
    /// assume it, and may panic or give garbage otherwise.
    ///
    /// # Examples
    ///
    /// ```
    /// let sparkle_heart = Vec::from([240u8, 159, 146, 150]);
    /// let sparkle_heart = unsafe { String::from_utf8_unchecked(sparkle_heart) };
    /// assert_eq(sparkle_heart, "💖");
    /// ```
    #[inline]
    pub unsafe fn from_utf8_unchecked(bytes: Vec<u8>) -> String {
        String { vec: bytes }
    }

    /// Decodes a UTF-16–encoded slice `v` into a `String`.
    ///
    /// # Errors
    ///
    /// Returns [`FromUtf16Error`] if `v` contains an unpaired surrogate.
    ///
    /// # Examples
    ///
    /// ```
    /// // 𝄞music
    /// let v = [0xD834u16, 0xDD1E, 0x006d, 0x0075, 0x0073, 0x0069, 0x0063];
    /// assert_eq(String::from_utf16(&v).unwrap(), "𝄞music");
    ///
    /// // 𝄞mu<invalid>ic
    /// let v = [0xD834u16, 0xDD1E, 0x006d, 0x0075, 0xD800, 0x0069, 0x0063];
    /// assert(String::from_utf16(&v).is_err());
    /// ```
    pub fn from_utf16(v: &[u16]) -> Result<String, FromUtf16Error> {
        let mut s = String::with_capacity(v.len());
        let mut i = 0;
        while i < v.len() {
            let u = v[i] as u32;
            if u < 0xD800 || u > 0xDFFF {
                s.push(char::from_u32(u).unwrap());
                i += 1;
            } else if u <= 0xDBFF
                && i + 1 < v.len()
                && (v[i + 1] as u32) >= 0xDC00
                && (v[i + 1] as u32) <= 0xDFFF
            {
                s.push(
                    char::from_u32(0x10000 + ((u - 0xD800) << 10) + (v[i + 1] as u32 - 0xDC00))
                        .unwrap(),
                );
                i += 2;
            } else {
                return Err(FromUtf16Error);
            }
        }
        Ok(s)
    }

    /// Decodes a UTF-16–encoded slice `v` into a `String`, replacing
    /// unpaired surrogates with the replacement character U+FFFD (�).
    ///
    /// # Examples
    ///
    /// ```
    /// // 𝄞mus<invalid>ic<invalid>
    /// let v = [
    ///     0xD834u16, 0xDD1E, 0x006d, 0x0075, 0x0073, 0xDD1E, 0x0069, 0x0063, 0xD834,
    /// ];
    /// assert_eq(String::from_utf16_lossy(&v), "𝄞mus\u{FFFD}ic\u{FFFD}");
    /// ```
    pub fn from_utf16_lossy(v: &[u16]) -> String {
        let mut s = String::with_capacity(v.len());
        let mut i = 0;
        while i < v.len() {
            let u = v[i] as u32;
            if u < 0xD800 || u > 0xDFFF {
                s.push(char::from_u32(u).unwrap());
                i += 1;
            } else if u <= 0xDBFF
                && i + 1 < v.len()
                && (v[i + 1] as u32) >= 0xDC00
                && (v[i + 1] as u32) <= 0xDFFF
            {
                s.push(
                    char::from_u32(0x10000 + ((u - 0xD800) << 10) + (v[i + 1] as u32 - 0xDC00))
                        .unwrap(),
                );
                i += 2;
            } else {
                s.push('\u{FFFD}');
                i += 1;
            }
        }
        s
    }

    /// Returns a mutable reference to the contents of this `String`, as
    /// the byte vector it is made of.
    ///
    /// # Safety
    ///
    /// The returned vector can be changed to hold bytes that are not valid
    /// UTF-8. If the `String` is used afterwards, its contents must be
    /// valid UTF-8 again: the methods of `String` and `str` assume it.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut s = String::from("hello");
    /// unsafe {
    ///     let vec = s.as_mut_vec();
    ///     assert_eq(*vec, [104u8, 101, 108, 108, 111]);
    ///     vec.reverse();
    /// }
    /// assert_eq(s, "olleh");
    /// ```
    #[inline]
    pub unsafe fn as_mut_vec(&mut self) -> &mut Vec<u8> {
        &mut self.vec
    }

    /// Converts a `String` into a mutable string slice.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut s = String::from("foobar");
    /// let s_mut_str: &mut str = s.as_mut_str();
    /// assert_eq(s_mut_str.len(), 6);
    /// assert(s_mut_str.starts_with("foo"));
    /// ```
    pub fn as_mut_str(&mut self) -> &mut str {
        let s = self.as_str();
        unsafe { *(&s as *const &str as *const &mut str) }
    }

    /// Reserves the minimum capacity for at least `additional` bytes more
    /// than the current length.
    ///
    /// Unlike [`String::reserve`], this will not deliberately
    /// over-allocate to speculatively avoid frequent allocations. After
    /// calling `reserve_exact`, capacity will be greater than or equal to
    /// `self.len() + additional`. Does nothing if the capacity is already
    /// sufficient.
    ///
    /// # Panics
    ///
    /// Panics if the new capacity overflows `usize`.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut s = String::new();
    /// s.reserve_exact(10);
    /// assert(s.capacity() >= 10);
    /// ```
    #[inline]
    pub fn reserve_exact(&mut self, additional: usize) {
        self.vec.reserve_exact(additional);
    }

    /// Shrinks the capacity of this `String` to match its length (or close
    /// to it).
    ///
    /// # Examples
    ///
    /// ```
    /// let mut s = String::from("foo");
    /// s.reserve(100);
    /// assert(s.capacity() >= 100);
    /// s.shrink_to_fit();
    /// assert(s.capacity() >= 3);
    /// assert(s.capacity() < 100);
    /// assert_eq(s, "foo");
    /// ```
    #[inline]
    pub fn shrink_to_fit(&mut self) {
        self.vec.shrink_to_fit();
    }

    /// Shrinks the capacity of this `String` with a lower bound.
    ///
    /// The capacity will remain at least as large as both the length and
    /// the supplied value. If the current capacity is less than the lower
    /// limit, this is a no-op.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut s = String::from("foo");
    /// s.reserve(100);
    /// assert(s.capacity() >= 100);
    ///
    /// s.shrink_to(10);
    /// assert(s.capacity() >= 10);
    /// s.shrink_to(0);
    /// assert(s.capacity() >= 3);
    /// ```
    #[inline]
    pub fn shrink_to(&mut self, min_capacity: usize) {
        self.vec.shrink_to(min_capacity);
    }

    /// Removes the specified range from the string and returns the
    /// removed characters as an iterator.
    ///
    /// Unlike Rust's lazy `Drain`, the text is removed right away (as with
    /// `Vec::drain` in navi): the returned [`Drain`] iterates over a copy
    /// of the removed text, and the string is changed whether or not the
    /// iterator is used.
    ///
    /// # Panics
    ///
    /// Panics if the start or end of the range is not on a `char`
    /// boundary, or if the range is out of bounds.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut s = String::from("α is alpha, β is beta");
    /// let beta_offset = s.find('β').unwrap();
    ///
    /// // Remove the range up until the β from the string
    /// let t: String = s.drain(..beta_offset).collect();
    /// assert_eq(t, "α is alpha, ");
    /// assert_eq(s, "β is beta");
    ///
    /// // A full range clears the string
    /// s.drain(..);
    /// assert_eq(s, "");
    /// ```
    pub fn drain<R: crate::ops::RangeBounds<usize>>(&mut self, range: R) -> Drain {
        let (start, end) = crate::vec::range_of(&range, self.len());
        check_boundary(self.as_str(), start);
        check_boundary(self.as_str(), end);
        let removed = String::from(&self.as_str()[start..end]);
        self.vec.drain(start..end);
        Drain {
            it: removed.as_str().chars(),
        }
    }

    /// Removes the specified range in the string, and replaces it with the
    /// given string. The given string doesn't need to be the same length as
    /// the range.
    ///
    /// # Panics
    ///
    /// Panics if the start or end of the range is not on a `char` boundary,
    /// or if the range is out of bounds.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut s = String::from("α is alpha, β is beta");
    /// let beta_offset = s.find('β').unwrap();
    ///
    /// // Replace the range up until the β from the string
    /// s.replace_range(..beta_offset, "Α is capital alpha; ");
    /// assert_eq(s, "Α is capital alpha; β is beta");
    /// ```
    pub fn replace_range<R: crate::ops::RangeBounds<usize>>(
        &mut self,
        range: R,
        replace_with: &str,
    ) {
        let (start, end) = crate::vec::range_of(&range, self.len());
        check_boundary(self.as_str(), start);
        check_boundary(self.as_str(), end);
        let tail = String::from(&self.as_str()[end..]);
        self.vec.truncate(start);
        self.push_str(replace_with);
        self.push_str(tail.as_str());
    }

    /// Copies the bytes in the `src` range to the end of the string.
    ///
    /// # Panics
    ///
    /// Panics if the start or end of the range is not on a `char` boundary,
    /// or if the range is out of bounds.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut string = String::from("abcde");
    ///
    /// string.extend_from_within(2..);
    /// assert_eq(string, "abcdecde");
    ///
    /// string.extend_from_within(..2);
    /// assert_eq(string, "abcdecdeab");
    ///
    /// string.extend_from_within(4..8);
    /// assert_eq(string, "abcdecdeabecde");
    /// ```
    pub fn extend_from_within<R: crate::ops::RangeBounds<usize>>(&mut self, src: R) {
        let (start, end) = crate::vec::range_of(&src, self.len());
        check_boundary(self.as_str(), start);
        check_boundary(self.as_str(), end);
        self.vec.extend_from_within(start..end);
    }
}

/// A possible error value when converting a `String` from a UTF-16 slice
/// with [`String::from_utf16`]: the input has an unpaired surrogate.
///
/// # Examples
///
/// ```
/// // 𝄞mu<invalid>ic
/// let v = [0xD834u16, 0xDD1E, 0x006d, 0x0075, 0xD800, 0x0069, 0x0063];
/// let e = String::from_utf16(&v).unwrap_err();
/// assert_eq(e.to_string(), "invalid utf-16: lone surrogate found");
/// ```
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct FromUtf16Error;

impl fmt::Display for FromUtf16Error {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        f.pad("invalid utf-16: lone surrogate found")
    }
}

impl FromUtf8Error {
    /// Returns a slice of the bytes that were attempted to convert to a
    /// `String`.
    ///
    /// # Examples
    ///
    /// ```
    /// // some invalid bytes, in a vector
    /// let bytes = Vec::from([0u8, 159]);
    /// let value = String::from_utf8(bytes);
    /// assert_eq(value.unwrap_err().as_bytes(), &[0u8, 159][..]);
    /// ```
    #[inline]
    pub fn as_bytes(&self) -> &[u8] {
        self.bytes.as_slice()
    }

    /// Returns the bytes that were attempted to convert to a `String`.
    ///
    /// # Examples
    ///
    /// ```
    /// // some invalid bytes, in a vector
    /// let bytes = Vec::from([0u8, 159]);
    /// let value = String::from_utf8(bytes);
    /// assert_eq(value.unwrap_err().into_bytes(), [0u8, 159]);
    /// ```
    #[inline]
    pub fn into_bytes(self) -> Vec<u8> {
        self.bytes
    }
}

impl fmt::Display for FromUtf8Error {
    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
        f.pad("invalid utf-8 sequence")
    }
}

/// An iterator over the characters removed by [`String::drain`].
///
/// The text has already been removed from the string when the iterator is
/// made (unlike Rust's, which removes it when dropped); the iterator goes
/// over a copy of it.
///
/// # Examples
///
/// ```
/// let mut s = String::from("hello world");
/// let mut d = s.drain(..5);
/// assert_eq(s, " world");
/// assert_eq(d.next(), Some('h'));
/// assert_eq(d.next_back(), Some('o'));
/// assert_eq(d.as_str(), "ell");
/// ```
pub struct Drain {
    it: crate::str::Chars,
}

impl Drain {
    /// Returns the remaining (not yet yielded) text of this iterator as a
    /// string slice.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut s = String::from("abc");
    /// let mut drain = s.drain(..);
    /// assert_eq(drain.as_str(), "abc");
    /// let _ = drain.next().unwrap();
    /// assert_eq(drain.as_str(), "bc");
    /// ```
    #[inline]
    pub fn as_str(&self) -> &str {
        self.it.as_str()
    }
}

impl Iterator for Drain {
    type Item = char;
    fn next(&mut self) -> Option<char> {
        self.it.next()
    }
}

impl DoubleEndedIterator for Drain {
    fn next_back(&mut self) -> Option<char> {
        self.it.next_back()
    }
}

impl Extend<String> for String {
    fn extend<I: IntoIterator<Item = String>>(&mut self, iter: I) {
        for p in iter {
            self.push_str(p.as_str());
        }
    }
}

impl Extend<&char> for String {
    fn extend<I: IntoIterator<Item = &char>>(&mut self, iter: I) {
        for c in iter {
            self.push(*c);
        }
    }
}

impl FromIterator<&char> for String {
    fn from_iter<I: IntoIterator<Item = &char>>(iter: I) -> String {
        let mut s = String::new();
        for c in iter {
            s.push(*c);
        }
        s
    }
}

impl crate::str::FromStr for String {
    type Err = crate::convert::Infallible;
    fn from_str(s: &str) -> Result<String, crate::convert::Infallible> {
        Ok(String::from(s))
    }
}

impl From<&mut str> for String {
    fn from(s: &mut str) -> String {
        let mut out = String::new();
        out.push_str(s);
        out
    }
}

impl PartialOrd<&str> for String {
    fn partial_cmp(&self, other: &&str) -> Option<crate::cmp::Ordering> {
        self.as_str().partial_cmp(*other)
    }
}
