//! Paths as strings. navi has no OsStr: paths are UTF-8 and the accessors
//! that return &OsStr in Rust return &str (see spec/std-diff.md).

use crate::string::String;
use crate::fmt::{self, Display, Debug, Formatter};
use crate::convert::AsRef;
use crate::ops::Deref;
use crate::option::Option::{self, None, Some};

/// A borrowed path.
#[derive(Clone, PartialEq, Eq, Hash)]
pub struct Path { inner: &str }

/// An owned path.
#[derive(Clone, PartialEq, Eq, Hash, Default)]
pub struct PathBuf { inner: String }

#[cfg(target_os = "windows")]
pub const MAIN_SEPARATOR: char = '\\';
#[cfg(not(target_os = "windows"))]
pub const MAIN_SEPARATOR: char = '/';

fn is_sep(c: u8) -> bool { c == b'/' || (MAIN_SEPARATOR == '\\' && c == b'\\') }

impl Path {
    pub fn new(s: &str) -> &Path { &Path { inner: s } }

    pub fn to_str(&self) -> Option<&str> { Some(self.inner) }
    pub fn as_str(&self) -> &str { self.inner }
    pub fn to_path_buf(&self) -> PathBuf { PathBuf { inner: self.inner.to_string() } }
    pub fn display(&self) -> Display_ { Display_ { s: self.inner } }

    pub fn is_absolute(&self) -> bool {
        let b = self.inner.as_bytes();
        b.len() > 0 && is_sep(b[0]) || b.len() > 2 && b[1] == b':' && is_sep(b[2])
    }

    pub fn join<P: AsRef<Path>>(&self, p: P) -> PathBuf {
        let mut out = self.to_path_buf();
        out.push(p);
        out
    }

    pub fn parent(&self) -> Option<&Path> {
        let b = self.inner.as_bytes();
        let mut end = b.len();
        while end > 1 && is_sep(b[end - 1]) { end -= 1; }
        if end == 0 { return None; }
        let mut i = end;
        while i > 0 && !is_sep(b[i - 1]) { i -= 1; }
        if i == 0 {
            return if end > 0 { Some(Path::new("")) } else { None };
        }
        let mut j = i;
        while j > 1 && is_sep(b[j - 1]) { j -= 1; }
        if j == end { return None; }
        Some(Path::new(&self.inner[0..j]))
    }

    pub fn file_name(&self) -> Option<&str> {
        let b = self.inner.as_bytes();
        let mut end = b.len();
        while end > 0 && is_sep(b[end - 1]) { end -= 1; }
        let mut i = end;
        while i > 0 && !is_sep(b[i - 1]) { i -= 1; }
        let name = &self.inner[i..end];
        if name.len() == 0 || name == ".." { None } else { Some(name) }
    }

    pub fn file_stem(&self) -> Option<&str> {
        let name = self.file_name()?;
        match name.rfind('.') { Some(0) | None => Some(name), Some(i) => Some(&name[0..i]) }
    }

    pub fn extension(&self) -> Option<&str> {
        let name = self.file_name()?;
        match name.rfind('.') { Some(0) | None => None, Some(i) => Some(&name[i + 1..name.len()]) }
    }

    pub fn with_extension(&self, ext: &str) -> PathBuf {
        let mut out = self.to_path_buf();
        out.set_extension(ext);
        out
    }

    pub fn starts_with<P: AsRef<Path>>(&self, base: P) -> bool {
        let b: &Path = base.as_ref();
        self.inner.starts_with(b.inner)
    }

    pub fn exists(&self) -> bool { crate::rt::fs_kind(self.inner) != 0 }
    pub fn is_file(&self) -> bool { crate::rt::fs_kind(self.inner) == 1 }
    pub fn is_dir(&self) -> bool { crate::rt::fs_kind(self.inner) == 2 }
}

impl PathBuf {
    pub fn new() -> PathBuf { PathBuf { inner: String::new() } }
    pub fn as_path(&self) -> &Path { Path::new(self.inner.as_str()) }

    pub fn push<P: AsRef<Path>>(&mut self, p: P) {
        let q = p.as_ref();
        if q.is_absolute() {
            self.inner = q.inner.to_string();
            return;
        }
        let b = self.inner.as_bytes();
        if b.len() > 0 && !is_sep(b[b.len() - 1]) { self.inner.push(MAIN_SEPARATOR); }
        self.inner.push_str(q.inner);
    }

    pub fn pop(&mut self) -> bool {
        match self.as_path().parent() {
            Some(p) => { self.inner = p.inner.to_string(); true }
            None => false,
        }
    }

    pub fn set_extension(&mut self, ext: &str) {
        let stem_end = match self.as_path().file_name() {
            Some(name) => {
                let start = self.inner.len() - name.len();
                match name.rfind('.') { Some(0) | None => self.inner.len(), Some(i) => start + i }
            }
            None => return,
        };
        let mut s = self.inner[0..stem_end].to_string();
        if ext.len() > 0 {
            s.push('.');
            s.push_str(ext);
        }
        self.inner = s;
    }

    pub fn into_string(self) -> String { self.inner }
}

impl Deref for PathBuf {
    type Target = Path;
    fn deref(&self) -> &Path { self.as_path() }
}

impl From<String> for PathBuf { fn from(s: String) -> PathBuf { PathBuf { inner: s } } }
impl From<&str> for PathBuf { fn from(s: &str) -> PathBuf { PathBuf { inner: s.to_string() } } }

impl AsRef<Path> for Path { fn as_ref(&self) -> &Path { self } }
impl AsRef<Path> for PathBuf { fn as_ref(&self) -> &Path { self.as_path() } }
impl AsRef<Path> for str { fn as_ref(&self) -> &Path { Path::new(self) } }
impl AsRef<Path> for &str { fn as_ref(&self) -> &Path { Path::new(*self) } }
impl AsRef<Path> for String { fn as_ref(&self) -> &Path { Path::new(self.as_str()) } }
impl AsRef<Path> for &Path { fn as_ref(&self) -> &Path { *self } }
impl AsRef<Path> for &PathBuf { fn as_ref(&self) -> &Path { self.as_path() } }

/// Displays a path (Path::display).
pub struct Display_ { s: &str }
impl Display for Display_ {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { f.pad(self.s) }
}

impl Debug for Path {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { Debug::fmt(&self.inner, f) }
}
impl Debug for PathBuf {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result { Debug::fmt(&self.inner, f) }
}
