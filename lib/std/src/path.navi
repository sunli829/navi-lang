//! Cross-platform path manipulation.
//!
//! This module provides two types, [`PathBuf`] and [`Path`] (akin to [`String`]
//! and [`str`]), for working with paths abstractly. These types are thin
//! wrappers around strings, but they provide path-specific operations:
//! [`Path::join`], [`Path::parent`], [`Path::file_name`], [`Path::extension`],
//! and queries of the filesystem such as [`Path::exists`] and [`Path::is_dir`].
//!
//! navi has no `OsStr`: paths are UTF-8 strings, and the accessors that return
//! `&OsStr` in Rust return `&str` (see spec/std-diff.md). [`Path`] is an
//! ordinary struct holding a `&str` (Rust's is an unsized type), and
//! [`PathBuf`] owns a [`String`]. There is no `Components` iterator; the
//! methods work on the string, splitting at the separators (`/`, and also `\`
//! on Windows).
//!
//! # Examples
//!
//! Path manipulation includes both parsing components from slices and building
//! new owned paths.
//!
//! ```
//! use std::path::{Path, PathBuf};
//!
//! let path = Path::new("/tmp/foo/bar.txt");
//! assert_eq(path.file_name(), Some("bar.txt"));
//! assert_eq(path.extension(), Some("txt"));
//! assert_eq(path.parent().unwrap().as_str(), "/tmp/foo");
//!
//! let mut buf = PathBuf::from("/");
//! buf.push("etc");
//! buf.push("passwd");
//! assert_eq(buf.as_str(), "/etc/passwd");
//! ```

use crate::{
    convert::AsRef,
    fmt::{self, Debug, Display, Formatter},
    hash::{Hash, Hasher},
    ops::Deref,
    option::Option::{self, None, Some},
    string::String,
    vec::Vec,
};

/// A slice of a path (akin to [`str`]).
///
/// This type supports a number of operations for inspecting a path, including
/// breaking the path into its parent and file name, extracting the file name
/// and extension, determining whether the path is absolute, and so on, and
/// querying the filesystem through it.
///
/// Unlike Rust's unsized `Path`, navi's is a plain struct holding a `&str`, and
/// it is usually handled as `&Path` (what [`Path::new`] returns). Paths are
/// UTF-8 (there is no `OsStr`), so [`Path::as_str`] always succeeds. The owned
/// counterpart is [`PathBuf`]; functions taking paths take `P: AsRef<Path>`,
/// which `&str`, [`String`], `&Path` and [`PathBuf`] implement.
///
/// # Examples
///
/// ```
/// use std::path::Path;
///
/// let path = Path::new("./foo/bar.txt");
///
/// let parent = path.parent();
/// assert_eq(parent.unwrap().as_str(), "./foo");
///
/// let file_stem = path.file_stem();
/// assert_eq(file_stem, Some("bar"));
///
/// let extension = path.extension();
/// assert_eq(extension, Some("txt"));
/// ```
#[derive(Clone)]
pub struct Path {
    inner: &str,
}

/// An owned, mutable path (akin to [`String`]).
///
/// This type provides methods like [`PathBuf::push`] and
/// [`PathBuf::set_extension`] that mutate the path in place. It also implements
/// `Deref` to [`Path`], meaning that all methods on [`Path`] slices are
/// available on `PathBuf` values as well.
///
/// navi's `PathBuf` owns a UTF-8 [`String`] (there is no `OsString`);
/// [`PathBuf::into_string`] takes it out.
///
/// # Examples
///
/// You can use [`PathBuf::push`] to build up a `PathBuf` from components:
///
/// ```ignore-windows
/// use std::path::PathBuf;
///
/// let mut path = PathBuf::new();
/// path.push("/");
/// path.push("feel");
/// path.push("the");
/// path.set_extension("force");
/// assert_eq(path.as_str(), "/feel/the.force");
/// ```
///
/// However, [`Path::join`] is usually better (it builds a new `PathBuf`), and a
/// `PathBuf` can be made directly from a string:
///
/// ```
/// use std::path::{Path, PathBuf};
///
/// let path = Path::new("/").join("feel").join("the.force");
/// assert_eq(path, PathBuf::from("/feel/the.force"));
/// ```
#[derive(Clone, Default)]
pub struct PathBuf {
    inner: String,
}

/// The primary separator of path components for the current platform.
///
/// For example, `/` on Unix and `\` on Windows. On Windows, `/` also separates
/// components.
#[cfg(target_os = "windows")]
pub const MAIN_SEPARATOR: char = '\\';
/// The primary separator of path components for the current platform.
///
/// For example, `/` on Unix and `\` on Windows. On Windows, `/` also separates
/// components.
///
/// # Examples
///
/// ```ignore-windows
/// use std::path::MAIN_SEPARATOR;
///
/// let path = `usr${MAIN_SEPARATOR}lib`.to_string();
/// # assert_eq(path, "usr/lib");
/// ```
#[cfg(not(target_os = "windows"))]
pub const MAIN_SEPARATOR: char = '/';

fn is_sep(c: u8) -> bool {
    c == b'/' || (MAIN_SEPARATOR == '\\' && c == b'\\')
}

impl Path {
    /// Wraps a string slice as a `Path` slice.
    ///
    /// This is a cost-free conversion.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::Path;
    ///
    /// let path = Path::new("foo.txt");
    /// assert_eq(path.as_str(), "foo.txt");
    ///
    /// // Strings work too.
    /// let string = String::from("foo.txt");
    /// let from_string = Path::new(string.as_str());
    /// assert_eq(from_string, path);
    /// ```
    pub fn new(s: &str) -> &Path {
        &Path { inner: s }
    }

    /// Yields a `&str` slice if the `Path` is valid unicode.
    ///
    /// navi's paths are always UTF-8, so this always returns `Some`;
    /// [`Path::as_str`] gives the slice directly.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::Path;
    ///
    /// let path = Path::new("foo.txt");
    /// assert_eq(path.to_str(), Some("foo.txt"));
    /// ```
    pub fn to_str(&self) -> Option<&str> {
        Some(self.inner)
    }

    /// Returns the path as a string slice.
    ///
    /// navi's paths are UTF-8 strings, so unlike Rust (where `to_str` may fail)
    /// this is always possible.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::Path;
    ///
    /// assert_eq(Path::new("/tmp/foo.txt").as_str(), "/tmp/foo.txt");
    /// ```
    pub fn as_str(&self) -> &str {
        self.inner
    }

    /// Converts a `Path` to an owned [`PathBuf`].
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::{Path, PathBuf};
    ///
    /// let path_buf = Path::new("foo.txt").to_path_buf();
    /// assert_eq(path_buf, PathBuf::from("foo.txt"));
    /// ```
    pub fn to_path_buf(&self) -> PathBuf {
        PathBuf {
            inner: self.inner.to_string(),
        }
    }

    /// Returns an object that implements [`Display`] for printing paths.
    ///
    /// navi's paths are UTF-8, so the path is displayed as it is (no lossy
    /// conversion is needed). The object pads like a string (width and
    /// alignment are honored).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::Path;
    ///
    /// let path = Path::new("/tmp/foo.rs");
    /// let s = `${path.display()}`.to_string();
    /// assert_eq(s, "/tmp/foo.rs");
    /// ```
    pub fn display(&self) -> Display_ {
        Display_ { s: self.inner }
    }

    /// Returns `true` if the `Path` is absolute, i.e., if it is independent of
    /// the current directory.
    ///
    /// A path is absolute if it starts with a separator (`/`; on Windows also
    /// `\`), or with a drive letter followed by a separator, such as `C:\` or
    /// `c:/`. navi checks both forms on every platform, and on Windows a path
    /// starting with a separator but without a drive (as `\windows`) counts as
    /// absolute, where Rust's would not.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::Path;
    ///
    /// assert(Path::new("/etc/passwd").is_absolute());
    /// assert(!Path::new("foo.txt").is_absolute());
    /// assert(!Path::new("./foo").is_absolute());
    /// ```
    pub fn is_absolute(&self) -> bool {
        let b = self.inner.as_bytes();
        b.len() > 0 && is_sep(b[0]) || b.len() > 2 && b[1] == b':' && is_sep(b[2])
    }

    /// Creates an owned [`PathBuf`] with `path` adjoined to `self`.
    ///
    /// If `path` is absolute, it replaces the current path. See
    /// [`PathBuf::push`] for more details on what it means to adjoin a path.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::{Path, PathBuf};
    ///
    /// assert_eq(
    ///     Path::new("/etc").join("passwd"),
    ///     PathBuf::from("/etc/passwd"),
    /// );
    /// assert_eq(Path::new("/etc").join("/bin/sh"), PathBuf::from("/bin/sh"));
    /// ```
    pub fn join<P: AsRef<Path>>(&self, p: P) -> PathBuf {
        let mut out = self.to_path_buf();
        out.push(p);
        out
    }

    /// Returns the `Path` without its final component, if there is one.
    ///
    /// This means it returns `Some("")` for relative paths with one component.
    /// Returns `None` if the path terminates in a root or is empty. Trailing
    /// separators are ignored.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::Path;
    ///
    /// let path = Path::new("/foo/bar");
    /// let parent = path.parent().unwrap();
    /// assert_eq(parent.as_str(), "/foo");
    ///
    /// let grand_parent = parent.parent().unwrap();
    /// assert_eq(grand_parent.as_str(), "/");
    /// assert(grand_parent.parent().is_none());
    ///
    /// let relative_path = Path::new("foo/bar/");
    /// let parent = relative_path.parent().unwrap();
    /// assert_eq(parent.as_str(), "foo");
    /// let grand_parent = parent.parent().unwrap();
    /// assert_eq(grand_parent.as_str(), "");
    /// assert(grand_parent.parent().is_none());
    /// ```
    pub fn parent(&self) -> Option<&Path> {
        let b = self.inner.as_bytes();
        let mut end = b.len();
        while end > 1 && is_sep(b[end - 1]) {
            end -= 1;
        }
        if end == 0 {
            return None;
        }
        let mut i = end;
        while i > 0 && !is_sep(b[i - 1]) {
            i -= 1;
        }
        if i == 0 {
            return if end > 0 { Some(Path::new("")) } else { None };
        }
        let mut j = i;
        while j > 1 && is_sep(b[j - 1]) {
            j -= 1;
        }
        if j == end {
            return None;
        }
        Some(Path::new(&self.inner[0..j]))
    }

    /// Returns the final component of the `Path`, if there is one.
    ///
    /// If the path is a normal file, this is the file name. If it's the path of
    /// a directory, this is the directory name. Trailing separators are
    /// ignored.
    ///
    /// Returns `None` if the path terminates in `..` or is a root or empty.
    /// navi returns `Option<&str>` where Rust returns `Option<&OsStr>`. Unlike
    /// Rust, which normalizes a trailing `.` component away, navi returns it:
    /// `Path::new("foo/.").file_name()` is `Some(".")` (Rust: `Some("foo")`).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::Path;
    ///
    /// assert_eq(Some("bin"), Path::new("/usr/bin/").file_name());
    /// assert_eq(Some("foo.txt"), Path::new("tmp/foo.txt").file_name());
    /// assert_eq(Path::new("foo.txt/..").file_name(), None);
    /// assert_eq(Path::new("/").file_name(), None);
    /// ```
    pub fn file_name(&self) -> Option<&str> {
        let b = self.inner.as_bytes();
        let mut end = b.len();
        while end > 0 && is_sep(b[end - 1]) {
            end -= 1;
        }
        let mut i = end;
        while i > 0 && !is_sep(b[i - 1]) {
            i -= 1;
        }
        let name = &self.inner[i..end];
        if name.len() == 0 || name == ".." {
            None
        } else {
            Some(name)
        }
    }

    /// Extracts the stem (non-extension) portion of [`Path::file_name`].
    ///
    /// The stem is:
    ///
    /// * `None`, if there is no file name;
    /// * The entire file name if there is no embedded `.`;
    /// * The entire file name if the file name begins with `.` and has no other
    ///   `.`s within;
    /// * Otherwise, the portion of the file name before the final `.`
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::Path;
    ///
    /// assert_eq(Some("foo"), Path::new("foo.rs").file_stem());
    /// assert_eq(Some("foo.tar"), Path::new("foo.tar.gz").file_stem());
    /// assert_eq(Some(".bashrc"), Path::new(".bashrc").file_stem());
    /// ```
    pub fn file_stem(&self) -> Option<&str> {
        let name = self.file_name()?;
        match name.rfind('.') {
            Some(0) | None => Some(name),
            Some(i) => Some(&name[0..i]),
        }
    }

    /// Extracts the extension (without the leading dot) of [`Path::file_name`],
    /// if possible.
    ///
    /// The extension is:
    ///
    /// * `None`, if there is no file name;
    /// * `None`, if there is no embedded `.`;
    /// * `None`, if the file name begins with `.` and has no other `.`s within;
    /// * Otherwise, the portion of the file name after the final `.`
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::Path;
    ///
    /// assert_eq(Some("rs"), Path::new("foo.rs").extension());
    /// assert_eq(Some("gz"), Path::new("foo.tar.gz").extension());
    /// assert_eq(Path::new("foo").extension(), None);
    /// assert_eq(Path::new(".bashrc").extension(), None);
    /// ```
    pub fn extension(&self) -> Option<&str> {
        let name = self.file_name()?;
        match name.rfind('.') {
            Some(0) | None => None,
            Some(i) => Some(&name[i + 1..name.len()]),
        }
    }

    /// Creates an owned [`PathBuf`] like `self` but with the given extension.
    ///
    /// See [`PathBuf::set_extension`] for more details.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::{Path, PathBuf};
    ///
    /// let path = Path::new("foo.rs");
    /// assert_eq(path.with_extension("txt"), PathBuf::from("foo.txt"));
    /// assert_eq(path.with_extension(""), PathBuf::from("foo"));
    ///
    /// let path = Path::new("foo.tar.gz");
    /// assert_eq(path.with_extension("xz"), PathBuf::from("foo.tar.xz"));
    /// ```
    pub fn with_extension(&self, ext: &str) -> PathBuf {
        let mut out = self.to_path_buf();
        out.set_extension(ext);
        out
    }

    /// Determines whether `base` is a prefix of `self`.
    ///
    /// Unlike Rust, which compares whole components, navi compares the strings:
    /// a prefix that ends inside a component also matches
    /// (`Path::new("/etc/passwd").starts_with("/e")` is `true`, where Rust says
    /// `false`), and nothing is normalized
    /// (`Path::new("a//b").starts_with("a/b")` is `false`, where Rust says
    /// `true`). Pass whole components to get the same results as Rust.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::Path;
    ///
    /// let path = Path::new("/etc/passwd");
    /// assert(path.starts_with("/etc"));
    /// assert(path.starts_with("/etc/"));
    /// assert(path.starts_with("/etc/passwd"));
    /// assert(!path.starts_with("/usr"));
    /// ```
    pub fn starts_with<P: AsRef<Path>>(&self, base: P) -> bool {
        let b: &Path = base.as_ref();
        self.inner.starts_with(b.inner)
    }
}

// navi: through fs::metadata (symbolic links followed).
impl Path {
    /// Returns `true` if the path points at an existing entity.
    ///
    /// This function will traverse symbolic links to query information about
    /// the destination file. If you cannot access the metadata of the file,
    /// e.g. because of a permission error or broken symbolic links, this will
    /// return `false`; use [`Path::try_exists`] to tell those apart.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::Path;
    ///
    /// assert(!Path::new("does_not_exist.txt").exists());
    /// assert(std::env::temp_dir().exists());
    /// ```
    pub fn exists(&self) -> bool {
        crate::fs::metadata(self).is_ok()
    }

    /// Returns `true` if the path exists on disk and is pointing at a regular
    /// file.
    ///
    /// This function will traverse symbolic links to query information about
    /// the destination file. If you cannot access the metadata of the file,
    /// e.g. because of a permission error or broken symbolic links, this will
    /// return `false`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let path = std::env::temp_dir().join("navi-doc-path-is-file.txt");
    ///     fs::write(&path, "x")?;
    ///     assert(path.is_file());
    ///     assert(!std::env::temp_dir().is_file());
    ///     fs::remove_file(&path)?;
    ///     Ok(())
    /// }
    /// ```
    pub fn is_file(&self) -> bool {
        match crate::fs::metadata(self) {
            Ok(m) => m.is_file(),
            Err(_) => false,
        }
    }

    /// Returns `true` if the path exists on disk and is pointing at a
    /// directory.
    ///
    /// This function will traverse symbolic links to query information about
    /// the destination file. If you cannot access the metadata of the file,
    /// e.g. because of a permission error or broken symbolic links, this will
    /// return `false`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::Path;
    ///
    /// assert(std::env::temp_dir().is_dir());
    /// assert(!Path::new("does_not_exist").is_dir());
    /// ```
    pub fn is_dir(&self) -> bool {
        match crate::fs::metadata(self) {
            Ok(m) => m.is_dir(),
            Err(_) => false,
        }
    }

    /// Returns `true` if the path exists on disk and is pointing at a symbolic
    /// link.
    ///
    /// This function will not traverse symbolic links. In case of a broken
    /// symbolic link this will also return `true`. If you cannot access the
    /// directory containing the file, e.g. because of a permission error, this
    /// will return `false`.
    ///
    /// # Examples
    ///
    /// ```ignore-windows
    /// use std::fs;
    /// use std::os::unix::fs::symlink;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let link = std::env::temp_dir().join("navi-doc-path-is-symlink");
    ///     let _ = fs::remove_file(&link);
    ///     symlink("does_not_exist", &link)?;
    ///     assert(link.is_symlink());
    ///     assert(!link.exists());
    ///     fs::remove_file(&link)?;
    ///     Ok(())
    /// }
    /// ```
    pub fn is_symlink(&self) -> bool {
        match crate::fs::symlink_metadata(self) {
            Ok(m) => m.is_symlink(),
            Err(_) => false,
        }
    }

    /// Returns `Ok(true)` if the path points at an existing entity.
    ///
    /// This function will traverse symbolic links to query information about
    /// the destination file. In case of broken symbolic links this will return
    /// `Ok(false)`. It is [`crate::fs::exists`].
    ///
    /// As opposed to [`Path::exists`], this method doesn't just return `false`
    /// on errors: it returns `Ok(false)` only when the path is not found.
    ///
    /// # Errors
    ///
    /// Returns an error if the existence of the path can neither be confirmed
    /// nor denied, for example because of a permission error.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::Path;
    ///
    /// assert(!Path::new("does_not_exist.txt").try_exists().unwrap());
    /// assert(std::env::temp_dir().try_exists().unwrap());
    /// ```
    pub fn try_exists(&self) -> crate::io::Result<bool> {
        crate::fs::exists(self)
    }

    /// Queries the file system to get information about a file, directory, etc.
    ///
    /// This function will traverse symbolic links to query information about
    /// the destination file. This is an alias to [`crate::fs::metadata`].
    ///
    /// # Errors
    ///
    /// As [`crate::fs::metadata`].
    ///
    /// # Examples
    ///
    /// ```
    /// fn main() -> std::io::Result<()> {
    ///     let metadata = std::env::temp_dir().metadata()?;
    ///     assert(metadata.is_dir());
    ///     Ok(())
    /// }
    /// ```
    pub fn metadata(&self) -> crate::io::Result<crate::fs::Metadata> {
        crate::fs::metadata(self)
    }

    /// Queries the metadata about a file without following symlinks.
    ///
    /// This is an alias to [`crate::fs::symlink_metadata`].
    ///
    /// # Errors
    ///
    /// As [`crate::fs::symlink_metadata`].
    ///
    /// # Examples
    ///
    /// ```ignore-windows
    /// use std::fs;
    /// use std::os::unix::fs::symlink;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let link = std::env::temp_dir().join("navi-doc-path-symlink-metadata");
    ///     let _ = fs::remove_file(&link);
    ///     symlink("/", &link)?;
    ///     assert(link.symlink_metadata()?.is_symlink());
    ///     fs::remove_file(&link)?;
    ///     Ok(())
    /// }
    /// ```
    pub fn symlink_metadata(&self) -> crate::io::Result<crate::fs::Metadata> {
        crate::fs::symlink_metadata(self)
    }

    /// Returns an iterator over the entries within a directory.
    ///
    /// The iterator will yield instances of `io::Result<fs::DirEntry>`. This is
    /// an alias to [`crate::fs::read_dir`]: in navi all the entries are read by
    /// this call.
    ///
    /// # Errors
    ///
    /// As [`crate::fs::read_dir`].
    ///
    /// # Examples
    ///
    /// ```
    /// use std::fs;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let dir = std::env::temp_dir().join("navi-doc-path-read-dir");
    ///     let _ = fs::remove_dir_all(&dir);
    ///     fs::create_dir(&dir)?;
    ///     fs::write(dir.join("one"), "")?;
    ///     let mut count = 0;
    ///     for entry in dir.read_dir()? {
    ///         assert_eq(entry?.file_name(), "one");
    ///         count += 1;
    ///     }
    ///     assert_eq(count, 1);
    ///     fs::remove_dir_all(&dir)?;
    ///     Ok(())
    /// }
    /// ```
    pub fn read_dir(&self) -> crate::io::Result<crate::fs::ReadDir> {
        crate::fs::read_dir(self)
    }

    /// Returns the canonical, absolute form of the path with all intermediate
    /// components normalized and symbolic links resolved.
    ///
    /// This is an alias to [`crate::fs::canonicalize`].
    ///
    /// # Errors
    ///
    /// As [`crate::fs::canonicalize`]; in particular the path must exist.
    ///
    /// # Examples
    ///
    /// ```ignore-windows
    /// use std::path::Path;
    ///
    /// let path = Path::new("/tmp/../tmp/./");
    /// let canonical = path.canonicalize().unwrap();
    /// assert(canonical.is_absolute());
    /// assert(!canonical.as_str().contains(".."));
    /// ```
    pub fn canonicalize(&self) -> crate::io::Result<PathBuf> {
        crate::fs::canonicalize(self)
    }

    /// Reads a symbolic link, returning the file that the link points to.
    ///
    /// This is an alias to [`crate::fs::read_link`].
    ///
    /// # Errors
    ///
    /// As [`crate::fs::read_link`].
    ///
    /// # Examples
    ///
    /// ```ignore-windows
    /// use std::fs;
    /// use std::os::unix::fs::symlink;
    ///
    /// fn main() -> std::io::Result<()> {
    ///     let link = std::env::temp_dir().join("navi-doc-path-read-link");
    ///     let _ = fs::remove_file(&link);
    ///     symlink("foo/bar.txt", &link)?;
    ///     assert_eq(link.read_link()?.as_str(), "foo/bar.txt");
    ///     fs::remove_file(&link)?;
    ///     Ok(())
    /// }
    /// ```
    pub fn read_link(&self) -> crate::io::Result<PathBuf> {
        crate::fs::read_link(self)
    }
}

impl PathBuf {
    /// Allocates an empty `PathBuf`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::PathBuf;
    ///
    /// let path = PathBuf::new();
    /// assert_eq(path.as_str(), "");
    /// ```
    pub fn new() -> PathBuf {
        PathBuf {
            inner: String::new(),
        }
    }

    /// Coerces to a [`Path`] slice.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::{Path, PathBuf};
    ///
    /// let p = PathBuf::from("/test");
    /// assert_eq(Path::new("/test"), p.as_path());
    /// ```
    pub fn as_path(&self) -> &Path {
        Path::new(self.inner.as_str())
    }

    /// Extends `self` with `path`.
    ///
    /// If `path` is absolute, it replaces the current path. Otherwise `path` is
    /// appended, with a separator ([`MAIN_SEPARATOR`]) in between unless `self`
    /// is empty or already ends with one.
    ///
    /// # Examples
    ///
    /// Pushing a relative path extends the existing path:
    ///
    /// ```
    /// use std::path::PathBuf;
    ///
    /// let mut path = PathBuf::from("/tmp");
    /// path.push("file.bk");
    /// assert_eq(path, PathBuf::from("/tmp/file.bk"));
    /// ```
    ///
    /// Pushing an absolute path replaces the existing path:
    ///
    /// ```
    /// use std::path::PathBuf;
    ///
    /// let mut path = PathBuf::from("/tmp");
    /// path.push("/etc");
    /// assert_eq(path, PathBuf::from("/etc"));
    /// ```
    pub fn push<P: AsRef<Path>>(&mut self, p: P) {
        let q = p.as_ref();
        if q.is_absolute() {
            self.inner = q.inner.to_string();
            return;
        }
        let b = self.inner.as_bytes();
        if b.len() > 0 && !is_sep(b[b.len() - 1]) {
            self.inner.push(MAIN_SEPARATOR);
        }
        self.inner.push_str(q.inner);
    }

    /// Truncates `self` to [`Path::parent`].
    ///
    /// Returns `false` and does nothing if `self.parent()` is `None`.
    /// Otherwise, returns `true`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::{Path, PathBuf};
    ///
    /// let mut p = PathBuf::from("/spirited/away.rs");
    ///
    /// p.pop();
    /// assert_eq(Path::new("/spirited"), p.as_path());
    /// p.pop();
    /// assert_eq(Path::new("/"), p.as_path());
    /// assert(!p.pop());
    /// ```
    pub fn pop(&mut self) -> bool {
        match self.as_path().parent() {
            Some(p) => {
                self.inner = p.inner.to_string();
                true
            }
            None => false,
        }
    }

    /// Updates [`Path::extension`] to `Some(extension)` or to `None` if
    /// `extension` is empty.
    ///
    /// If [`Path::file_name`] is `None`, this does nothing. Otherwise the
    /// extension is replaced (or added, if there is none); with an empty
    /// `extension`, the current one is removed along with its dot. Unlike
    /// Rust's, which returns whether the extension was updated, navi's returns
    /// nothing.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::{Path, PathBuf};
    ///
    /// let mut p = PathBuf::from("/feel/the");
    ///
    /// p.set_extension("force");
    /// assert_eq(Path::new("/feel/the.force"), p.as_path());
    ///
    /// p.set_extension("dark.side");
    /// assert_eq(Path::new("/feel/the.dark.side"), p.as_path());
    ///
    /// p.set_extension("cookie");
    /// assert_eq(Path::new("/feel/the.dark.cookie"), p.as_path());
    ///
    /// p.set_extension("");
    /// assert_eq(Path::new("/feel/the.dark"), p.as_path());
    /// ```
    pub fn set_extension(&mut self, ext: &str) {
        let stem_end = match self.as_path().file_name() {
            Some(name) => {
                let start = self.inner.len() - name.len();
                match name.rfind('.') {
                    Some(0) | None => self.inner.len(),
                    Some(i) => start + i,
                }
            }
            None => return,
        };
        let mut s = self.inner[0..stem_end].to_string();
        if ext.len() > 0 {
            s.push('.');
            s.push_str(ext);
        }
        self.inner = s;
    }

    /// Consumes the `PathBuf`, yielding its internal [`String`] storage.
    ///
    /// This is navi's counterpart of Rust's `into_os_string` (there is no
    /// `OsString`).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::path::PathBuf;
    ///
    /// let p = PathBuf::from("/the/head");
    /// let s: String = p.into_string();
    /// assert_eq(s, "/the/head");
    /// ```
    pub fn into_string(self) -> String {
        self.inner
    }
}

impl Deref for PathBuf {
    type Target = Path;
    fn deref(&self) -> &Path {
        self.as_path()
    }
}

impl From<String> for PathBuf {
    fn from(s: String) -> PathBuf {
        PathBuf { inner: s }
    }
}

impl From<&str> for PathBuf {
    fn from(s: &str) -> PathBuf {
        PathBuf {
            inner: s.to_string(),
        }
    }
}

impl AsRef<Path> for Path {
    fn as_ref(&self) -> &Path {
        self
    }
}

impl AsRef<Path> for PathBuf {
    fn as_ref(&self) -> &Path {
        self.as_path()
    }
}

impl AsRef<Path> for str {
    fn as_ref(&self) -> &Path {
        Path::new(self)
    }
}

impl AsRef<Path> for String {
    fn as_ref(&self) -> &Path {
        Path::new(self.as_str())
    }
}

/// Helper struct for safely printing paths with `${}` formatting, returned by
/// [`Path::display`].
///
/// It implements [`Display`]. Rust calls this type `std::path::Display`; navi
/// names it `Display_` (it would clash with the [`Display`] trait in this
/// module).
///
/// # Examples
///
/// ```
/// use std::path::Path;
///
/// let path = Path::new("/tmp/foo.rs");
/// assert_eq(`[${path.display():>12}]`.to_string(), "[ /tmp/foo.rs]");
/// ```
pub struct Display_ {
    s: &str,
}

impl Display for Display_ {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.pad(self.s)
    }
}

// Whether a path starts at the root, and its components: separators
// repeated or at the end and . (but at the start) do not count (as Rust's
// Path::components, which Path's == and hash compare).
fn components_of(s: &str) -> (bool, Vec<&str>) {
    let b = s.as_bytes();
    let root = b.len() > 0 && is_sep(b[0]);
    let mut out = Vec::new();
    let mut i = 0;
    while i < b.len() {
        while i < b.len() && is_sep(b[i]) {
            i += 1;
        }
        let start = i;
        while i < b.len() && !is_sep(b[i]) {
            i += 1;
        }
        if i > start && (start == 0 || &s[start..i] != ".") {
            out.push(&s[start..i]);
        }
    }
    (root, out)
}

/// Paths are equal when their components are: `a//b/` is `a/b`, and on
/// Windows `a\b` is `a/b`.
///
/// # Examples
///
/// ```
/// use std::path::Path;
///
/// assert_eq(Path::new("/tmp//foo/"), Path::new("/tmp/foo"));
/// assert_eq(Path::new("a/./b"), Path::new("a/b"));
/// assert_ne(Path::new("./a"), Path::new("a"));
/// ```
impl PartialEq for Path {
    fn eq(&self, other: &Path) -> bool {
        let (r1, c1) = components_of(self.inner);
        let (r2, c2) = components_of(other.inner);
        r1 == r2 && c1 == c2
    }
}

impl Eq for Path {}

impl Hash for Path {
    fn hash<H: Hasher>(&self, state: &mut H) {
        let (root, cs) = components_of(self.inner);
        root.hash(state);
        for c in cs.iter() {
            c.hash(state);
        }
    }
}

impl PartialEq for PathBuf {
    fn eq(&self, other: &PathBuf) -> bool {
        Path::new(self.inner.as_str()) == Path::new(other.inner.as_str())
    }
}

impl Eq for PathBuf {}

impl Hash for PathBuf {
    fn hash<H: Hasher>(&self, state: &mut H) {
        Path::new(self.inner.as_str()).hash(state)
    }
}

impl Debug for Path {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        Debug::fmt(&self.inner, f)
    }
}

impl Debug for PathBuf {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        Debug::fmt(&self.inner, f)
    }
}
