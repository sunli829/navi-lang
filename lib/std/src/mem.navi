//! Basic functions for dealing with memory.
//!
//! This module has functions for querying the size and alignment of types
//! and for swapping and replacing values. There is no `mem::drop` or
//! `mem::forget`: navi has no destructors, and memory is reclaimed by the
//! garbage collector (see spec/std-diff.md).

/// Returns the size of a type in bytes.
///
/// This is the number of bytes a value of the type takes in a variable, an
/// array element or a field. Collections such as [`Vec`] and [`String`]
/// are handles to a heap object, so their size is that of a pointer
/// whatever they hold.
///
/// # Examples
///
/// ```
/// use std::mem;
///
/// assert_eq(mem::size_of::<u8>(), 1);
/// assert_eq(mem::size_of::<i32>(), 4);
/// assert_eq(mem::size_of::<[u8; 3]>(), 3);
/// assert_eq(mem::size_of::<&i32>(), mem::size_of::<usize>());
/// // A None reference is a null pointer: no extra space.
/// assert_eq(mem::size_of::<Option<&i32>>(), mem::size_of::<&i32>());
/// ```
pub fn size_of<T>() -> usize {
    crate::intrinsics::size_of::<T>()
}

/// Returns the alignment of a type in bytes.
///
/// Every reference to a value of type `T` must be a multiple of this
/// number.
///
/// # Examples
///
/// ```
/// use std::mem;
///
/// assert_eq(mem::align_of::<u8>(), 1);
/// assert_eq(mem::align_of::<i32>(), 4);
/// assert_eq(mem::align_of::<u64>(), 8);
/// ```
pub fn align_of<T>() -> usize {
    crate::intrinsics::align_of::<T>()
}

/// Swaps the values at two mutable locations.
///
/// # Examples
///
/// ```
/// use std::mem;
///
/// let mut x = 5;
/// let mut y = 42;
/// mem::swap(&mut x, &mut y);
/// assert_eq(x, 42);
/// assert_eq(y, 5);
/// ```
pub fn swap<T>(a: &mut T, b: &mut T) {
    let t = *a;
    *a = *b;
    *b = t;
}

/// Puts `src` into `*dest`, returning the previous value of `*dest`.
///
/// # Examples
///
/// ```
/// use std::mem;
///
/// let mut v = Vec::from([1, 2]);
/// let old = mem::replace(&mut v, Vec::from([3, 4, 5]));
/// assert_eq(old, [1, 2]);
/// assert_eq(v, [3, 4, 5]);
/// ```
pub fn replace<T>(dest: &mut T, src: T) -> T {
    let old = *dest;
    *dest = src;
    old
}

/// Replaces `*dest` with the default value of `T`, returning the previous
/// value.
///
/// # Examples
///
/// ```
/// use std::mem;
///
/// let mut v = Vec::from([1, 2]);
/// let old = mem::take(&mut v);
/// assert_eq(old, [1, 2]);
/// assert(v.is_empty());
/// ```
pub fn take<T: Default>(dest: &mut T) -> T {
    replace(dest, T::default())
}
