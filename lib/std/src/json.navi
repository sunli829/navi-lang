//! JSON serialization and deserialization, as the serde_json crate.
//!
//! Values of types that implement [`Serialize`](crate::serde::Serialize)
//! and [`Deserialize`](crate::serde::Deserialize) (usually through
//! `#[derive(Serialize, Deserialize)]`) are written with [`to_string`] or
//! [`to_string_pretty`] and read with [`from_str`]. [`Value`] holds any
//! JSON when its shape is not known in advance.
//!
//! The types map to JSON as in serde's data model:
//!
//! - `bool`, integers and floats are JSON booleans and numbers (NaN and the
//!   infinities are written as `null`); `char`, `String` and `&str` are
//!   strings.
//! - Structs are objects (unknown fields are skipped, a missing one is an
//!   error unless it is an `Option` or `#[serde(default)]`); tuple structs,
//!   tuples, arrays and `Vec`s are arrays; a one-field tuple struct is its
//!   field; `()` and unit structs are `null`.
//! - `Option` is `null` or its value; other enums are `"Variant"` (no
//!   fields) or `{"Variant": payload}`, the payload being the field, an
//!   array of the fields, or an object of them.
//! - Maps with string or integer keys are objects.
//!
//! # Examples
//!
//! ```
//! use std::json;
//! use std::serde::{Deserialize, Serialize};
//!
//! #[derive(Serialize, Deserialize, Debug, PartialEq)]
//! struct Point {
//!     x: i32,
//!     y: f64,
//! }
//!
//! let p = Point { x: 1, y: 2.5 };
//! let s = json::to_string(&p).unwrap();
//! assert_eq(s, "{\"x\":1,\"y\":2.5}");
//!
//! let q: Point = json::from_str(s.as_str()).unwrap();
//! assert_eq(q, p);
//! ```

use crate::collections::BTreeMap;
use crate::fmt::{self, Debug, Display, Formatter};
use crate::serde::de::{
    self, Deserialize, Deserializer, EnumAccess, MapAccess, SeqAccess, Unexpected, VariantAccess,
    Visitor,
};
use crate::serde::ser::{
    self, Serialize, SerializeMap, SerializeSeq, SerializeStruct, SerializeStructVariant,
    SerializeTuple, SerializeTupleStruct, SerializeTupleVariant, Serializer,
};

/// An error writing or reading JSON.
///
/// It is returned by [`to_string`], [`to_string_pretty`] and [`from_str`]
/// when a value cannot be written (a map key that is not a string or an
/// integer, a custom error of a `Serialize` impl) or the text is not valid
/// JSON or does not fit the type being read. Its message starts with
/// `json: `; when reading, the byte offset in the input where the error was
/// found follows it.
///
/// # Examples
///
/// ```
/// use std::json;
///
/// let e = json::from_str::<Vec<i32>>("[1, 2").unwrap_err();
/// assert_eq(e.to_string(), "json: expected ']' at offset 5");
///
/// let e = json::from_str::<u8>("300").unwrap_err();
/// assert_eq(e.to_string(), "json: invalid value: integer `300`, expected u8 at offset 3");
/// ```
#[derive(Clone)]
pub struct Error {
    msg: String,
    pos: usize,
}

impl Display for Error {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        if self.pos == usize::MAX {
            f.write_str(self.msg.as_str())
        } else {
            f.write_fmt(`${self.msg} at offset ${self.pos}`)
        }
    }
}

impl Debug for Error {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        Display::fmt(self, f)
    }
}

impl ser::Error for Error {
    fn custom<T: Display>(msg: T) -> Error {
        Error {
            msg: `json: ${msg}`.to_string(),
            pos: usize::MAX,
        }
    }
}

impl de::Error for Error {
    fn custom<T: Display>(msg: T) -> Error {
        Error {
            msg: `json: ${msg}`.to_string(),
            pos: usize::MAX,
        }
    }
}

/// Serializes a value as a compact JSON string.
///
/// Struct fields are written in declaration order, with no whitespace
/// between tokens; see [`to_string_pretty`] for indented output.
///
/// # Errors
///
/// Fails if `x`'s `Serialize` implementation fails, or if `x` contains a map
/// whose keys are not strings, chars or integers.
///
/// # Examples
///
/// ```
/// use std::json;
/// use std::serde::Serialize;
///
/// #[derive(Serialize)]
/// struct User {
///     name: String,
///     age: u32,
///     tags: Vec<String>,
/// }
///
/// let u = User { name: "Ann".to_string(), age: 30, tags: Vec::from(["admin".to_string()]) };
/// assert_eq(json::to_string(&u).unwrap(), "{\"name\":\"Ann\",\"age\":30,\"tags\":[\"admin\"]}");
///
/// assert_eq(json::to_string(&Some(1.5)).unwrap(), "1.5");
/// assert_eq(json::to_string(&(1, "a", true)).unwrap(), "[1,\"a\",true]");
/// ```
pub fn to_string<T: Serialize>(x: &T) -> Result<String, Error> {
    let w = &mut Writer {
        out: String::new(),
        indent: -1,
        depth: 0,
    };
    x.serialize(w)?;
    Ok(w.out)
}

/// Serializes a value as a pretty-printed JSON string.
///
/// Each array element and object member is on a line of its own, indented
/// by two spaces per level, and object keys are followed by `": "`. Empty
/// arrays and objects are written as `[]` and `{}`.
///
/// # Errors
///
/// Fails in the same cases as [`to_string`].
///
/// # Examples
///
/// ```
/// use std::json;
/// use std::serde::Serialize;
///
/// #[derive(Serialize)]
/// struct Point {
///     x: i32,
///     y: i32,
/// }
///
/// let s = json::to_string_pretty(&Point { x: 1, y: 2 }).unwrap();
/// assert_eq(s, "{\n  \"x\": 1,\n  \"y\": 2\n}");
/// ```
pub fn to_string_pretty<T: Serialize>(x: &T) -> Result<String, Error> {
    let w = &mut Writer {
        out: String::new(),
        indent: 2,
        depth: 0,
    };
    x.serialize(w)?;
    Ok(w.out)
}

/// Deserializes a value of type `T` from a string of JSON text.
///
/// Whitespace is allowed around the value; anything else after it is an
/// error. Unknown fields of a struct are skipped (unless the struct has
/// `#[serde(deny_unknown_fields)]`), and a missing field is an error unless
/// its type is an `Option` or it has `#[serde(default)]`.
///
/// # Errors
///
/// Fails if `s` is not valid JSON, if it does not match the shape of `T`
/// (a string where a number is expected, a missing field, an integer out
/// of range...), or if there are trailing characters after the value. The
/// error's message ends with the byte offset where reading stopped.
///
/// # Examples
///
/// ```
/// use std::json;
/// use std::serde::Deserialize;
///
/// #[derive(Deserialize, Debug, PartialEq)]
/// struct Point {
///     x: i32,
///     y: i32,
///     label: Option<String>,
/// }
///
/// let p: Point = json::from_str(" { \"y\": 2, \"x\": 1, \"extra\": [true] } ").unwrap();
/// assert_eq(p, Point { x: 1, y: 2, label: None });
///
/// let v: Vec<f64> = json::from_str("[1, 2.5, -3e2]").unwrap();
/// assert_eq(v, Vec::from([1.0, 2.5, -300.0]));
///
/// assert(json::from_str::<Point>("{\"x\": 1}").is_err());
/// assert(json::from_str::<i32>("1 2").is_err());
/// ```
pub fn from_str<T: Deserialize>(s: &str) -> Result<T, Error> {
    let r = &mut Reader {
        b: s.as_bytes(),
        i: 0,
    };
    let v = match T::deserialize(r) {
        Ok(v) => v,
        // (An error of a Visitor's has no offset: where the reading was.)
        Err(e) => {
            return Err(if e.pos == usize::MAX {
                Error {
                    msg: e.msg,
                    pos: r.i,
                }
            } else {
                e
            });
        }
    };
    r.ws();
    if r.i < r.b.len() {
        return r.fail("trailing characters");
    }
    Ok(v)
}

// --- Writing -----------------------------------------------------------------

/// The JSON [`Serializer`](crate::serde::Serializer) behind [`to_string`]
/// and [`to_string_pretty`].
///
/// `&mut Writer` implements `Serializer`; it cannot be created outside this
/// module, so use those functions to write JSON.
pub struct Writer {
    out: String,
    /// Spaces per level, or -1: compact.
    indent: i64,
    depth: i64,
}

impl Writer {
    fn newline(&mut self) {
        if self.indent < 0 {
            return;
        }
        self.out.push('\n');
        let mut i = 0;
        while i < self.indent * self.depth {
            self.out.push(' ');
            i += 1;
        }
    }

    fn string(&mut self, s: &str) {
        self.out.push('"');
        for c in s.chars() {
            match c {
                '"' => self.out.push_str("\\\""),
                '\\' => self.out.push_str("\\\\"),
                '\n' => self.out.push_str("\\n"),
                '\r' => self.out.push_str("\\r"),
                '\t' => self.out.push_str("\\t"),
                _ => {
                    if (c as u32) < 0x20 {
                        self.out
                            .push_str(`\\u${hex4(c as u32)}`.to_string().as_str());
                    } else {
                        self.out.push(c);
                    }
                }
            }
        }
        self.out.push('"');
    }

    fn open(&mut self, c: char) {
        self.out.push(c);
        self.depth += 1;
    }

    fn item(&mut self, first: bool) {
        if !first {
            self.out.push(',');
        }
        self.newline();
    }

    fn close(&mut self, c: char, empty: bool) {
        self.depth -= 1;
        if !empty {
            self.newline();
        }
        self.out.push(c);
    }

    fn key(&mut self, k: &str) {
        self.string(k);
        self.out.push(':');
        if self.indent >= 0 {
            self.out.push(' ');
        }
    }

    // {"variant": (the content follows)
    fn variant_open(&mut self, variant: &str) {
        self.open('{');
        self.item(true);
        self.key(variant);
    }
}

/// An array or object being written by a [`Writer`].
///
/// It implements `SerializeSeq`, `SerializeMap`, `SerializeStruct` and the
/// other compound serializers of [`crate::serde::ser`]; `end` writes the
/// closing `]` or `}` (for an enum variant's content, also the `}` of the
/// `{"Variant": ...}` around it).
pub struct Compound {
    w: &mut Writer,
    first: bool,
    close: char,
    variant: bool,
}

fn compound(w: &mut Writer, open: char, variant: bool) -> Compound {
    w.open(open);
    Compound {
        w,
        first: true,
        close: if open == '[' { ']' } else { '}' },
        variant,
    }
}

impl Compound {
    fn element<T: Serialize>(&mut self, value: &T) -> Result<(), Error> {
        self.w.item(self.first);
        self.first = false;
        value.serialize(&mut *self.w)
    }

    fn field<T: Serialize>(&mut self, key: &str, value: &T) -> Result<(), Error> {
        self.w.item(self.first);
        self.first = false;
        self.w.key(key);
        value.serialize(&mut *self.w)
    }

    fn finish(self) -> Result<(), Error> {
        self.w.close(self.close, self.first);
        if self.variant {
            self.w.close('}', false);
        }
        Ok(())
    }
}

impl Serializer for &mut Writer {
    type Ok = ();
    type Error = Error;
    type SerializeSeq = Compound;
    type SerializeTuple = Compound;
    type SerializeTupleStruct = Compound;
    type SerializeTupleVariant = Compound;
    type SerializeMap = Compound;
    type SerializeStruct = Compound;
    type SerializeStructVariant = Compound;

    fn serialize_bool(self, v: bool) -> Result<(), Error> {
        self.out.push_str(if v { "true" } else { "false" });
        Ok(())
    }

    fn serialize_i64(self, v: i64) -> Result<(), Error> {
        self.out.push_str(`${v}`.to_string().as_str());
        Ok(())
    }

    fn serialize_u64(self, v: u64) -> Result<(), Error> {
        self.out.push_str(`${v}`.to_string().as_str());
        Ok(())
    }

    fn serialize_f64(self, v: f64) -> Result<(), Error> {
        if v.is_nan() || v.is_infinite() {
            self.out.push_str("null");
        } else {
            self.out.push_str(`${v}`.to_string().as_str());
        }
        Ok(())
    }

    fn serialize_str(self, v: &str) -> Result<(), Error> {
        self.string(v);
        Ok(())
    }

    fn serialize_bytes(self, v: &[u8]) -> Result<(), Error> {
        let mut c = compound(self, '[', false);
        for b in v.iter() {
            c.element(b)?;
        }
        c.finish()
    }

    fn serialize_none(self) -> Result<(), Error> {
        self.serialize_unit()
    }

    fn serialize_some<T: Serialize>(self, value: &T) -> Result<(), Error> {
        value.serialize(self)
    }

    fn serialize_unit(self) -> Result<(), Error> {
        self.out.push_str("null");
        Ok(())
    }

    fn serialize_unit_struct(self, name: &str) -> Result<(), Error> {
        self.serialize_unit()
    }

    fn serialize_unit_variant(
        self,
        name: &str,
        variant_index: u32,
        variant: &str,
    ) -> Result<(), Error> {
        self.serialize_str(variant)
    }

    fn serialize_newtype_struct<T: Serialize>(self, name: &str, value: &T) -> Result<(), Error> {
        value.serialize(self)
    }

    fn serialize_newtype_variant<T: Serialize>(
        self,
        name: &str,
        variant_index: u32,
        variant: &str,
        value: &T,
    ) -> Result<(), Error> {
        self.variant_open(variant);
        value.serialize(&mut *self)?;
        self.close('}', false);
        Ok(())
    }

    fn serialize_seq(self, len: Option<usize>) -> Result<Compound, Error> {
        Ok(compound(self, '[', false))
    }

    fn serialize_tuple(self, len: usize) -> Result<Compound, Error> {
        Ok(compound(self, '[', false))
    }

    fn serialize_tuple_struct(self, name: &str, len: usize) -> Result<Compound, Error> {
        Ok(compound(self, '[', false))
    }

    fn serialize_tuple_variant(
        self,
        name: &str,
        variant_index: u32,
        variant: &str,
        len: usize,
    ) -> Result<Compound, Error> {
        self.variant_open(variant);
        Ok(compound(self, '[', true))
    }

    fn serialize_map(self, len: Option<usize>) -> Result<Compound, Error> {
        Ok(compound(self, '{', false))
    }

    fn serialize_struct(self, name: &str, len: usize) -> Result<Compound, Error> {
        Ok(compound(self, '{', false))
    }

    fn serialize_struct_variant(
        self,
        name: &str,
        variant_index: u32,
        variant: &str,
        len: usize,
    ) -> Result<Compound, Error> {
        self.variant_open(variant);
        Ok(compound(self, '{', true))
    }
}

impl SerializeSeq for Compound {
    type Ok = ();
    type Error = Error;
    fn serialize_element<T: Serialize>(&mut self, value: &T) -> Result<(), Error> {
        self.element(value)
    }

    fn end(self) -> Result<(), Error> {
        self.finish()
    }
}

impl SerializeTuple for Compound {
    type Ok = ();
    type Error = Error;
    fn serialize_element<T: Serialize>(&mut self, value: &T) -> Result<(), Error> {
        self.element(value)
    }

    fn end(self) -> Result<(), Error> {
        self.finish()
    }
}

impl SerializeTupleStruct for Compound {
    type Ok = ();
    type Error = Error;
    fn serialize_field<T: Serialize>(&mut self, value: &T) -> Result<(), Error> {
        self.element(value)
    }

    fn end(self) -> Result<(), Error> {
        self.finish()
    }
}

impl SerializeTupleVariant for Compound {
    type Ok = ();
    type Error = Error;
    fn serialize_field<T: Serialize>(&mut self, value: &T) -> Result<(), Error> {
        self.element(value)
    }

    fn end(self) -> Result<(), Error> {
        self.finish()
    }
}

impl SerializeMap for Compound {
    type Ok = ();
    type Error = Error;
    fn serialize_key<T: Serialize>(&mut self, key: &T) -> Result<(), Error> {
        self.w.item(self.first);
        self.first = false;
        key.serialize(KeyWriter { w: self.w })?;
        self.w.out.push(':');
        if self.w.indent >= 0 {
            self.w.out.push(' ');
        }
        Ok(())
    }

    fn serialize_value<T: Serialize>(&mut self, value: &T) -> Result<(), Error> {
        value.serialize(&mut *self.w)
    }

    fn end(self) -> Result<(), Error> {
        self.finish()
    }
}

impl SerializeStruct for Compound {
    type Ok = ();
    type Error = Error;
    fn serialize_field<T: Serialize>(&mut self, key: &str, value: &T) -> Result<(), Error> {
        self.field(key, value)
    }

    fn end(self) -> Result<(), Error> {
        self.finish()
    }
}

impl SerializeStructVariant for Compound {
    type Ok = ();
    type Error = Error;
    fn serialize_field<T: Serialize>(&mut self, key: &str, value: &T) -> Result<(), Error> {
        self.field(key, value)
    }

    fn end(self) -> Result<(), Error> {
        self.finish()
    }
}

// A map's key: a string, an integer, a bool or a char (written as a string).
struct KeyWriter {
    w: &mut Writer,
}

fn key_error() -> Error {
    Error {
        msg: "json: a map key must be a string, a number, a bool or a char".to_string(),
        pos: usize::MAX,
    }
}

impl Serializer for KeyWriter {
    type Ok = ();
    type Error = Error;
    type SerializeSeq = Compound;
    type SerializeTuple = Compound;
    type SerializeTupleStruct = Compound;
    type SerializeTupleVariant = Compound;
    type SerializeMap = Compound;
    type SerializeStruct = Compound;
    type SerializeStructVariant = Compound;

    fn serialize_bool(self, v: bool) -> Result<(), Error> {
        self.serialize_str(if v { "true" } else { "false" })
    }

    fn serialize_i64(self, v: i64) -> Result<(), Error> {
        self.serialize_str(`${v}`.to_string().as_str())
    }

    fn serialize_u64(self, v: u64) -> Result<(), Error> {
        self.serialize_str(`${v}`.to_string().as_str())
    }

    fn serialize_f64(self, v: f64) -> Result<(), Error> {
        Err(key_error())
    }

    fn serialize_str(self, v: &str) -> Result<(), Error> {
        self.w.string(v);
        Ok(())
    }

    fn serialize_bytes(self, v: &[u8]) -> Result<(), Error> {
        Err(key_error())
    }

    fn serialize_none(self) -> Result<(), Error> {
        Err(key_error())
    }

    fn serialize_some<T: Serialize>(self, value: &T) -> Result<(), Error> {
        value.serialize(self)
    }

    fn serialize_unit(self) -> Result<(), Error> {
        Err(key_error())
    }

    fn serialize_unit_struct(self, name: &str) -> Result<(), Error> {
        Err(key_error())
    }

    fn serialize_unit_variant(
        self,
        name: &str,
        variant_index: u32,
        variant: &str,
    ) -> Result<(), Error> {
        self.serialize_str(variant)
    }

    fn serialize_newtype_struct<T: Serialize>(self, name: &str, value: &T) -> Result<(), Error> {
        value.serialize(self)
    }

    fn serialize_newtype_variant<T: Serialize>(
        self,
        name: &str,
        variant_index: u32,
        variant: &str,
        value: &T,
    ) -> Result<(), Error> {
        Err(key_error())
    }

    fn serialize_seq(self, len: Option<usize>) -> Result<Compound, Error> {
        Err(key_error())
    }

    fn serialize_tuple(self, len: usize) -> Result<Compound, Error> {
        Err(key_error())
    }

    fn serialize_tuple_struct(self, name: &str, len: usize) -> Result<Compound, Error> {
        Err(key_error())
    }

    fn serialize_tuple_variant(
        self,
        name: &str,
        variant_index: u32,
        variant: &str,
        len: usize,
    ) -> Result<Compound, Error> {
        Err(key_error())
    }

    fn serialize_map(self, len: Option<usize>) -> Result<Compound, Error> {
        Err(key_error())
    }

    fn serialize_struct(self, name: &str, len: usize) -> Result<Compound, Error> {
        Err(key_error())
    }

    fn serialize_struct_variant(
        self,
        name: &str,
        variant_index: u32,
        variant: &str,
        len: usize,
    ) -> Result<Compound, Error> {
        Err(key_error())
    }
}

fn hex4(n: u32) -> String {
    let digits = "0123456789abcdef".as_bytes();
    let mut s = String::new();
    let mut sh = 12;
    loop {
        s.push(digits[((n >> sh) & 15) as usize] as char);
        if sh == 0 {
            break;
        }
        sh -= 4;
    }
    s
}

// --- Reading -----------------------------------------------------------------

/// The JSON [`Deserializer`](crate::serde::Deserializer) behind
/// [`from_str`].
///
/// `&mut Reader` implements `Deserializer`; it cannot be created outside
/// this module, so use [`from_str`] to read JSON.
pub struct Reader {
    b: &[u8],
    i: usize,
}

impl Reader {
    fn fail<T>(&self, msg: &str) -> Result<T, Error> {
        Err(self.error(msg))
    }

    fn error(&self, msg: &str) -> Error {
        Error {
            msg: `json: ${msg}`.to_string(),
            pos: self.i,
        }
    }

    fn ws(&mut self) {
        while self.i < self.b.len() {
            let c = self.b[self.i];
            if c != b' ' && c != b'\n' && c != b'\r' && c != b'\t' {
                return;
            }
            self.i += 1;
        }
    }

    fn peek(&mut self) -> u8 {
        self.ws();
        if self.i < self.b.len() {
            self.b[self.i]
        } else {
            0
        }
    }

    fn expect(&mut self, c: u8) -> Result<(), Error> {
        if self.peek() != c {
            return self.fail(`expected '${c as char}'`.to_string().as_str());
        }
        self.i += 1;
        Ok(())
    }

    // The , between elements (close: what ends them).
    fn separator(&mut self, close: u8) -> Result<(), Error> {
        let c = self.peek();
        if c == b',' {
            self.i += 1;
            return Ok(());
        }
        if c == 0 {
            return self.fail(`expected '${close as char}'`.to_string().as_str());
        }
        self.fail(`expected ',' or '${close as char}'`.to_string().as_str())
    }

    fn word(&mut self, w: &str) -> bool {
        self.ws();
        let wb = w.as_bytes();
        if self.i + wb.len() > self.b.len() {
            return false;
        }
        let mut j = 0;
        while j < wb.len() {
            if self.b[self.i + j] != wb[j] {
                return false;
            }
            j += 1;
        }
        self.i += wb.len();
        true
    }

    fn string(&mut self) -> Result<String, Error> {
        self.expect(b'"')?;
        let mut out: Vec<u8> = Vec::new();
        loop {
            if self.i >= self.b.len() {
                return self.fail("unterminated string");
            }
            let c = self.b[self.i];
            self.i += 1;
            if c == b'"' {
                break;
            }
            if c != b'\\' {
                out.push(c);
                continue;
            }
            if self.i >= self.b.len() {
                return self.fail("unterminated string");
            }
            let e = self.b[self.i];
            self.i += 1;
            match e {
                b'"' => out.push(b'"'),
                b'\\' => out.push(b'\\'),
                b'/' => out.push(b'/'),
                b'b' => out.push(8),
                b'f' => out.push(12),
                b'n' => out.push(b'\n'),
                b'r' => out.push(b'\r'),
                b't' => out.push(b'\t'),
                b'u' => {
                    let mut cp = self.hex()?;
                    // A surrogate pair.
                    if cp >= 0xD800
                        && cp < 0xDC00
                        && self.i + 1 < self.b.len()
                        && self.b[self.i] == b'\\'
                        && self.b[self.i + 1] == b'u'
                    {
                        self.i += 2;
                        let lo = self.hex()?;
                        cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
                    }
                    let ch = match char::from_u32(cp) {
                        Some(x) => x,
                        None => return self.fail("invalid \\u escape"),
                    };
                    let mut s = String::new();
                    s.push(ch);
                    out.extend_from_slice(s.as_bytes());
                }
                _ => return self.fail("invalid escape"),
            }
        }
        match String::from_utf8(out) {
            Ok(s) => Ok(s),
            Err(_) => self.fail("invalid UTF-8"),
        }
    }

    fn hex(&mut self) -> Result<u32, Error> {
        if self.i + 4 > self.b.len() {
            return self.fail("short \\u escape");
        }
        let mut v = 0u32;
        let mut j = 0;
        while j < 4 {
            let c = self.b[self.i + j];
            let d = if c >= b'0' && c <= b'9' {
                c - b'0'
            } else if c >= b'a' && c <= b'f' {
                c - b'a' + 10
            } else if c >= b'A' && c <= b'F' {
                c - b'A' + 10
            } else {
                return self.fail("invalid \\u escape");
            };
            v = v * 16 + d as u32;
            j += 1;
        }
        self.i += 4;
        Ok(v)
    }

    // A number's text.
    fn number(&mut self) -> Result<&str, Error> {
        self.ws();
        let start = self.i;
        while self.i < self.b.len() {
            let c = self.b[self.i];
            if c >= b'0' && c <= b'9'
                || c == b'-'
                || c == b'+'
                || c == b'.'
                || c == b'e'
                || c == b'E'
            {
                self.i += 1;
            } else {
                break;
            }
        }
        if self.i == start {
            return self.fail("expected a value");
        }
        Ok(crate::rt::str_from_raw(
            crate::rt::ptr_offset(crate::rt::slice_ptr(self.b), start),
            self.i - start,
        ))
    }

    // A number to the visitor: an integer if it has no fraction or
    // exponent (u64, else i64, else a float), else a float.
    fn visit_number<V: Visitor>(&mut self, v: V) -> Result<V::Value, Error> {
        let start = self.i;
        let t = self.number()?;
        if !t.contains('.') && !t.contains('e') && !t.contains('E') {
            if let Ok(n) = t.parse::<u64>() {
                return v.visit_u64(n);
            }
            if let Ok(n) = t.parse::<i64>() {
                return v.visit_i64(n);
            }
        }
        match t.parse::<f64>() {
            Ok(x) => v.visit_f64(x),
            Err(_) => Err(Error {
                msg: `json: invalid number ${t}`.to_string(),
                pos: start,
            }),
        }
    }

    // Skips a value of any type.
    fn skip(&mut self) -> Result<(), Error> {
        let c = self.peek();
        if c == b'"' {
            self.string()?;
        } else if c == b'{' || c == b'[' {
            let close = if c == b'{' { b'}' } else { b']' };
            self.i += 1;
            if self.peek() == close {
                self.i += 1;
                return Ok(());
            }
            loop {
                if c == b'{' {
                    self.string()?;
                    self.expect(b':')?;
                }
                self.skip()?;
                if self.peek() == b',' {
                    self.i += 1;
                    continue;
                }
                self.expect(close)?;
                return Ok(());
            }
        } else if self.word("true") || self.word("false") || self.word("null") {
        } else {
            self.number()?;
        }
        Ok(())
    }

    // [ ... ] to the visitor (which must take all of it).
    fn seq<V: Visitor>(&mut self, v: V) -> Result<V::Value, Error> {
        self.expect(b'[')?;
        let st = &mut SeqState {
            first: true,
            done: false,
        };
        let out = v.visit_seq(Seq { r: self, st })?;
        if !st.done {
            if self.peek() != b']' {
                return self.fail("expected ']' (more elements than expected)");
            }
            self.i += 1;
        }
        Ok(out)
    }

    // { ... } to the visitor.
    fn map<V: Visitor>(&mut self, v: V) -> Result<V::Value, Error> {
        self.expect(b'{')?;
        let st = &mut SeqState {
            first: true,
            done: false,
        };
        let out = v.visit_map(Map { r: self, st })?;
        if !st.done {
            // (The visitor stopped early: the rest is skipped.)
            loop {
                let c = self.peek();
                if c == b'}' {
                    break;
                }
                if !st.first {
                    self.expect(b',')?;
                }
                st.first = false;
                self.string()?;
                self.expect(b':')?;
                self.skip()?;
            }
            self.i += 1;
        }
        Ok(out)
    }
}

impl Deserializer for &mut Reader {
    type Error = Error;

    fn deserialize_any<V: Visitor>(self, v: V) -> Result<V::Value, Error> {
        let c = self.peek();
        if c == b'n' {
            if !self.word("null") {
                return self.fail("expected a value");
            }
            return v.visit_unit();
        }
        if c == b't' || c == b'f' {
            if self.word("true") {
                return v.visit_bool(true);
            }
            if self.word("false") {
                return v.visit_bool(false);
            }
            return self.fail("expected a value");
        }
        if c == b'"' {
            let s = self.string()?;
            return v.visit_string(s);
        }
        if c == b'[' {
            return self.seq(v);
        }
        if c == b'{' {
            return self.map(v);
        }
        if c == 0 {
            return self.fail("unexpected end of input");
        }
        self.visit_number(v)
    }

    fn deserialize_option<V: Visitor>(self, v: V) -> Result<V::Value, Error> {
        if self.peek() == b'n' && self.word("null") {
            return v.visit_none();
        }
        v.visit_some(self)
    }

    fn deserialize_unit<V: Visitor>(self, v: V) -> Result<V::Value, Error> {
        if self.peek() == b'n' && self.word("null") {
            return v.visit_unit();
        }
        self.deserialize_any(v)
    }

    fn deserialize_newtype_struct<V: Visitor>(self, name: &str, v: V) -> Result<V::Value, Error> {
        v.visit_newtype_struct(self)
    }

    fn deserialize_enum<V: Visitor>(
        self,
        name: &str,
        variants: &[&str],
        v: V,
    ) -> Result<V::Value, Error> {
        let c = self.peek();
        if c == b'"' {
            let s = self.string()?;
            return v.visit_enum(UnitVariant { name: s });
        }
        if c == b'{' {
            self.i += 1;
            let out = v.visit_enum(Variant { r: self })?;
            self.expect(b'}')?;
            return Ok(out);
        }
        self.fail("expected a string or an object (an enum)")
    }

    fn deserialize_ignored_any<V: Visitor>(self, v: V) -> Result<V::Value, Error> {
        self.skip()?;
        v.visit_unit()
    }
}

struct SeqState {
    first: bool,
    done: bool,
}

// The elements of [ ... ].
struct Seq {
    r: &mut Reader,
    st: &mut SeqState,
}

impl SeqAccess for Seq {
    type Error = Error;
    fn next_element<T: Deserialize>(&mut self) -> Result<Option<T>, Error> {
        if self.st.done {
            return Ok(None);
        }
        if self.r.peek() == b']' {
            self.r.i += 1;
            self.st.done = true;
            return Ok(None);
        }
        if !self.st.first {
            self.r.separator(b']')?;
        }
        self.st.first = false;
        Ok(Some(T::deserialize(&mut *self.r)?))
    }
}

// The entries of { ... }.
struct Map {
    r: &mut Reader,
    st: &mut SeqState,
}

impl MapAccess for Map {
    type Error = Error;
    fn next_key<K: Deserialize>(&mut self) -> Result<Option<K>, Error> {
        if self.st.done {
            return Ok(None);
        }
        if self.r.peek() == b'}' {
            self.r.i += 1;
            self.st.done = true;
            return Ok(None);
        }
        if !self.st.first {
            self.r.separator(b'}')?;
        }
        self.st.first = false;
        let k = K::deserialize(KeyReader { r: self.r })?;
        self.r.expect(b':')?;
        Ok(Some(k))
    }

    fn next_value<V: Deserialize>(&mut self) -> Result<V, Error> {
        V::deserialize(&mut *self.r)
    }
}

// A map's key: a string, given as a string, or parsed as the number, bool
// or char the key's type asks for.
struct KeyReader {
    r: &mut Reader,
}

impl KeyReader {
    fn number<V: Visitor>(self, v: V) -> Result<V::Value, Error> {
        let at = self.r.i;
        let s = self.r.string()?;
        let inner = &mut Reader {
            b: s.as_bytes(),
            i: 0,
        };
        match inner.visit_number(v) {
            Ok(x) => Ok(x),
            Err(e) => Err(Error {
                msg: e.msg,
                pos: at,
            }),
        }
    }
}

impl Deserializer for KeyReader {
    type Error = Error;
    fn deserialize_any<V: Visitor>(self, v: V) -> Result<V::Value, Error> {
        let s = self.r.string()?;
        v.visit_string(s)
    }

    fn deserialize_i8<V: Visitor>(self, v: V) -> Result<V::Value, Error> {
        self.number(v)
    }

    fn deserialize_i16<V: Visitor>(self, v: V) -> Result<V::Value, Error> {
        self.number(v)
    }

    fn deserialize_i32<V: Visitor>(self, v: V) -> Result<V::Value, Error> {
        self.number(v)
    }

    fn deserialize_i64<V: Visitor>(self, v: V) -> Result<V::Value, Error> {
        self.number(v)
    }

    fn deserialize_u8<V: Visitor>(self, v: V) -> Result<V::Value, Error> {
        self.number(v)
    }

    fn deserialize_u16<V: Visitor>(self, v: V) -> Result<V::Value, Error> {
        self.number(v)
    }

    fn deserialize_u32<V: Visitor>(self, v: V) -> Result<V::Value, Error> {
        self.number(v)
    }

    fn deserialize_u64<V: Visitor>(self, v: V) -> Result<V::Value, Error> {
        self.number(v)
    }

    fn deserialize_f32<V: Visitor>(self, v: V) -> Result<V::Value, Error> {
        self.number(v)
    }

    fn deserialize_f64<V: Visitor>(self, v: V) -> Result<V::Value, Error> {
        self.number(v)
    }

    fn deserialize_bool<V: Visitor>(self, v: V) -> Result<V::Value, Error> {
        let s = self.r.string()?;
        if s == "true" {
            return v.visit_bool(true);
        }
        if s == "false" {
            return v.visit_bool(false);
        }
        v.visit_string(s)
    }

    fn deserialize_option<V: Visitor>(self, v: V) -> Result<V::Value, Error> {
        v.visit_some(self)
    }

    fn deserialize_newtype_struct<V: Visitor>(self, name: &str, v: V) -> Result<V::Value, Error> {
        v.visit_newtype_struct(self)
    }

    fn deserialize_enum<V: Visitor>(
        self,
        name: &str,
        variants: &[&str],
        v: V,
    ) -> Result<V::Value, Error> {
        let s = self.r.string()?;
        v.visit_enum(UnitVariant { name: s })
    }
}

// An enum written "Variant": only a unit variant.
struct UnitVariant {
    name: String,
}

impl EnumAccess for UnitVariant {
    type Error = Error;
    type Variant = UnitOnly;
    fn variant<V: Deserialize>(self) -> Result<(V, UnitOnly), Error> {
        let v = V::deserialize(Name { s: self.name })?;
        Ok((v, UnitOnly))
    }
}

struct UnitOnly;

fn wants(what: &str) -> Error {
    Error {
        msg: `json: invalid type: unit variant, expected ${what}`.to_string(),
        pos: usize::MAX,
    }
}

impl VariantAccess for UnitOnly {
    type Error = Error;
    fn unit_variant(self) -> Result<(), Error> {
        Ok(())
    }

    fn newtype_variant<T: Deserialize>(self) -> Result<T, Error> {
        Err(wants("newtype variant"))
    }

    fn tuple_variant<V: Visitor>(self, len: usize, v: V) -> Result<V::Value, Error> {
        Err(wants("tuple variant"))
    }

    fn struct_variant<V: Visitor>(self, fields: &[&str], v: V) -> Result<V::Value, Error> {
        Err(wants("struct variant"))
    }
}

// A variant's name, as an identifier.
struct Name {
    s: String,
}

impl Deserializer for Name {
    type Error = Error;
    fn deserialize_any<V: Visitor>(self, v: V) -> Result<V::Value, Error> {
        v.visit_string(self.s)
    }
}

// An enum written {"Variant": content}: the reader is after the {.
struct Variant {
    r: &mut Reader,
}

impl EnumAccess for Variant {
    type Error = Error;
    type Variant = Variant;
    fn variant<V: Deserialize>(self) -> Result<(V, Variant), Error> {
        let s = self.r.string()?;
        self.r.expect(b':')?;
        let v = V::deserialize(Name { s })?;
        Ok((v, self))
    }
}

impl VariantAccess for Variant {
    type Error = Error;
    fn unit_variant(self) -> Result<(), Error> {
        if self.r.peek() == b'n' && self.r.word("null") {
            return Ok(());
        }
        self.r.fail("expected null (a unit variant)")
    }

    fn newtype_variant<T: Deserialize>(self) -> Result<T, Error> {
        T::deserialize(self.r)
    }

    fn tuple_variant<V: Visitor>(self, len: usize, v: V) -> Result<V::Value, Error> {
        self.r.seq(v)
    }

    fn struct_variant<V: Visitor>(self, fields: &[&str], v: V) -> Result<V::Value, Error> {
        if self.r.peek() == b'[' {
            return self.r.seq(v);
        }
        self.r.map(v)
    }
}

// --- Any JSON ----------------------------------------------------------------

/// Any valid JSON value, as serde_json's `Value`.
///
/// Read JSON into a `Value` with [`from_str`] when its shape is not known in
/// advance, and inspect it with [`get`](Value::get) and the `as_*` and
/// `is_*` methods. A `Value` implements `Serialize` and `Display` (which
/// writes it as compact JSON), so it can also be built by hand and
/// written. Object members are kept in a `BTreeMap`, so they are written
/// sorted by key.
///
/// # Examples
///
/// ```
/// use std::json::{self, Value};
///
/// let v: Value = json::from_str("{\"name\": \"Ann\", \"age\": 30, \"tags\": [\"a\", \"b\"]}").unwrap();
/// assert_eq(v.get("name").unwrap().as_str(), Some("Ann"));
/// assert_eq(v.get("age").unwrap().as_i64(), Some(30));
/// assert_eq(v.get("tags").unwrap().as_array().unwrap().len(), 2);
/// assert(v.get("missing").is_none());
///
/// // Display writes compact JSON, with the keys sorted.
/// assert_eq(v.to_string(), "{\"age\":30,\"name\":\"Ann\",\"tags\":[\"a\",\"b\"]}");
/// ```
#[derive(Clone, Debug, PartialEq)]
pub enum Value {
    /// The JSON `null`.
    Null,
    /// A JSON boolean.
    Bool(bool),
    /// A JSON number.
    Number(Number),
    /// A JSON string.
    String(String),
    /// A JSON array.
    Array(Vec<Value>),
    /// A JSON object, its members sorted by key.
    Object(BTreeMap<String, Value>),
}

/// A JSON number: an integer when the text is one, else a float.
///
/// Numbers read from JSON text without a fraction or exponent that fit in a
/// `u64` or `i64` are [`PosInt`](Number::PosInt) or
/// [`NegInt`](Number::NegInt); the others are [`Float`](Number::Float).
///
/// # Examples
///
/// ```
/// use std::json::{self, Number, Value};
///
/// let v: Vec<Value> = json::from_str("[7, -7, 0.5]").unwrap();
/// assert_eq(v[0], Value::Number(Number::PosInt(7)));
/// assert_eq(v[1], Value::Number(Number::NegInt(-7)));
/// assert_eq(v[2], Value::Number(Number::Float(0.5)));
/// ```
#[derive(Clone, Debug, PartialEq)]
pub enum Number {
    /// A non-negative integer.
    PosInt(u64),
    /// A negative integer.
    NegInt(i64),
    /// A floating-point number.
    Float(f64),
}

impl Number {
    /// Returns the number as an `i64` if it is an integer that fits in one.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json::Number;
    ///
    /// assert_eq(Number::PosInt(64).as_i64(), Some(64));
    /// assert_eq(Number::NegInt(-1).as_i64(), Some(-1));
    /// assert_eq(Number::PosInt(u64::MAX).as_i64(), None);
    /// assert_eq(Number::Float(1.0).as_i64(), None);
    /// ```
    pub fn as_i64(&self) -> Option<i64> {
        match self {
            Number::PosInt(n) => {
                if *n <= i64::MAX as u64 {
                    Some(*n as i64)
                } else {
                    None
                }
            }
            Number::NegInt(n) => Some(*n),
            Number::Float(_) => None,
        }
    }

    /// Returns the number as a `u64` if it is a non-negative integer.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json::Number;
    ///
    /// assert_eq(Number::PosInt(64).as_u64(), Some(64));
    /// assert_eq(Number::NegInt(-1).as_u64(), None);
    /// assert_eq(Number::Float(1.0).as_u64(), None);
    /// ```
    pub fn as_u64(&self) -> Option<u64> {
        match self {
            Number::PosInt(n) => Some(*n),
            _ => None,
        }
    }

    /// Returns the number as an `f64` (an integer converted, possibly
    /// losing precision).
    ///
    /// Unlike serde_json's `Number::as_f64`, this always returns a value, not
    /// an `Option`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json::Number;
    ///
    /// assert_eq(Number::PosInt(2).as_f64(), 2.0);
    /// assert_eq(Number::NegInt(-3).as_f64(), -3.0);
    /// assert_eq(Number::Float(0.5).as_f64(), 0.5);
    /// ```
    pub fn as_f64(&self) -> f64 {
        match self {
            Number::PosInt(n) => *n as f64,
            Number::NegInt(n) => *n as f64,
            Number::Float(x) => *x,
        }
    }
}

impl Value {
    /// Returns `true` if the value is `null`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json::{self, Value};
    ///
    /// let v: Value = json::from_str("{\"a\": null, \"b\": false}").unwrap();
    /// assert(v.get("a").unwrap().is_null());
    /// assert(!v.get("b").unwrap().is_null());
    /// ```
    pub fn is_null(&self) -> bool {
        match self {
            Value::Null => true,
            _ => false,
        }
    }

    /// Returns the boolean if the value is one.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json::Value;
    ///
    /// assert_eq(Value::Bool(true).as_bool(), Some(true));
    /// assert_eq(Value::Null.as_bool(), None);
    /// ```
    pub fn as_bool(&self) -> Option<bool> {
        match self {
            Value::Bool(b) => Some(*b),
            _ => None,
        }
    }

    /// Returns the number as an `i64` if the value is an integer that fits
    /// in one.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json::{self, Value};
    ///
    /// let v: Value = json::from_str("[-5, 1.5, \"7\"]").unwrap();
    /// let a = v.as_array().unwrap();
    /// assert_eq(a[0].as_i64(), Some(-5));
    /// assert_eq(a[1].as_i64(), None);
    /// assert_eq(a[2].as_i64(), None);
    /// ```
    pub fn as_i64(&self) -> Option<i64> {
        match self {
            Value::Number(n) => n.as_i64(),
            _ => None,
        }
    }

    /// Returns the number as a `u64` if the value is a non-negative
    /// integer.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json::{self, Value};
    ///
    /// let v: Value = json::from_str("[18446744073709551615, -1]").unwrap();
    /// let a = v.as_array().unwrap();
    /// assert_eq(a[0].as_u64(), Some(u64::MAX));
    /// assert_eq(a[1].as_u64(), None);
    /// ```
    pub fn as_u64(&self) -> Option<u64> {
        match self {
            Value::Number(n) => n.as_u64(),
            _ => None,
        }
    }

    /// Returns the number as an `f64` if the value is a number (integers
    /// are converted).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json::{self, Value};
    ///
    /// let v: Value = json::from_str("[2, 0.25, null]").unwrap();
    /// let a = v.as_array().unwrap();
    /// assert_eq(a[0].as_f64(), Some(2.0));
    /// assert_eq(a[1].as_f64(), Some(0.25));
    /// assert_eq(a[2].as_f64(), None);
    /// ```
    pub fn as_f64(&self) -> Option<f64> {
        match self {
            Value::Number(n) => Some(n.as_f64()),
            _ => None,
        }
    }

    /// Returns the string if the value is one.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json::{self, Value};
    ///
    /// let v: Value = json::from_str("{\"s\": \"hi\", \"n\": 1}").unwrap();
    /// assert_eq(v.get("s").unwrap().as_str(), Some("hi"));
    /// assert_eq(v.get("n").unwrap().as_str(), None);
    /// ```
    pub fn as_str(&self) -> Option<&str> {
        match self {
            Value::String(s) => Some(s.as_str()),
            _ => None,
        }
    }

    /// Returns the elements if the value is an array.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json::{self, Value};
    ///
    /// let v: Value = json::from_str("[1, \"two\", [3]]").unwrap();
    /// let a = v.as_array().unwrap();
    /// assert_eq(a.len(), 3);
    /// assert_eq(a[1].as_str(), Some("two"));
    /// assert(Value::Null.as_array().is_none());
    /// ```
    pub fn as_array(&self) -> Option<&Vec<Value>> {
        match self {
            Value::Array(a) => Some(a),
            _ => None,
        }
    }

    /// Returns the members if the value is an object.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json::{self, Value};
    ///
    /// let v: Value = json::from_str("{\"b\": 2, \"a\": 1}").unwrap();
    /// let o = v.as_object().unwrap();
    /// assert_eq(o.len(), 2);
    /// assert_eq(o.get(&"a".to_string()).unwrap().as_i64(), Some(1));
    /// ```
    pub fn as_object(&self) -> Option<&BTreeMap<String, Value>> {
        match self {
            Value::Object(o) => Some(o),
            _ => None,
        }
    }

    /// Returns the member `key` of an object.
    ///
    /// Returns `None` if the value is not an object or has no such member.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::json::{self, Value};
    ///
    /// let v: Value = json::from_str("{\"user\": {\"id\": 7}}").unwrap();
    /// assert_eq(v.get("user").unwrap().get("id").unwrap().as_u64(), Some(7));
    /// assert(v.get("id").is_none());
    /// assert(Value::Bool(true).get("user").is_none());
    /// ```
    pub fn get(&self, key: &str) -> Option<&Value> {
        match self {
            Value::Object(o) => o.get(&key.to_string()),
            _ => None,
        }
    }
}

impl Display for Value {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        match to_string(self) {
            Ok(s) => f.write_str(s.as_str()),
            Err(_) => Err(fmt::Error),
        }
    }
}

impl Serialize for Number {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        match self {
            Number::PosInt(n) => s.serialize_u64(*n),
            Number::NegInt(n) => s.serialize_i64(*n),
            Number::Float(x) => s.serialize_f64(*x),
        }
    }
}

impl Serialize for Value {
    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
        match self {
            Value::Null => s.serialize_unit(),
            Value::Bool(b) => s.serialize_bool(*b),
            Value::Number(n) => n.serialize(s),
            Value::String(x) => s.serialize_str(x.as_str()),
            Value::Array(a) => a.serialize(s),
            Value::Object(o) => o.serialize(s),
        }
    }
}

struct ValueVisitor;

impl Visitor for ValueVisitor {
    type Value = Value;
    fn expecting(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("any JSON value")
    }

    fn visit_bool<E: de::Error>(self, v: bool) -> Result<Value, E> {
        Ok(Value::Bool(v))
    }

    fn visit_i64<E: de::Error>(self, v: i64) -> Result<Value, E> {
        Ok(Value::Number(if v < 0 {
            Number::NegInt(v)
        } else {
            Number::PosInt(v as u64)
        }))
    }

    fn visit_u64<E: de::Error>(self, v: u64) -> Result<Value, E> {
        Ok(Value::Number(Number::PosInt(v)))
    }

    fn visit_f64<E: de::Error>(self, v: f64) -> Result<Value, E> {
        Ok(Value::Number(Number::Float(v)))
    }

    fn visit_str<E: de::Error>(self, v: &str) -> Result<Value, E> {
        Ok(Value::String(v.to_string()))
    }

    fn visit_string<E: de::Error>(self, v: String) -> Result<Value, E> {
        Ok(Value::String(v))
    }

    fn visit_none<E: de::Error>(self) -> Result<Value, E> {
        Ok(Value::Null)
    }

    fn visit_unit<E: de::Error>(self) -> Result<Value, E> {
        Ok(Value::Null)
    }

    fn visit_some<D: Deserializer>(self, d: D) -> Result<Value, D::Error> {
        Value::deserialize(d)
    }

    fn visit_seq<A: SeqAccess>(self, seq: A) -> Result<Value, A::Error> {
        let mut s = seq;
        let mut out = Vec::new();
        while let Some(x) = s.next_element::<Value>()? {
            out.push(x);
        }
        Ok(Value::Array(out))
    }

    fn visit_map<A: MapAccess>(self, map: A) -> Result<Value, A::Error> {
        let mut m = map;
        let mut out = BTreeMap::new();
        while let Some((k, v)) = m.next_entry::<String, Value>()? {
            out.insert(k, v);
        }
        Ok(Value::Object(out))
    }
}

impl Deserialize for Value {
    fn deserialize<D: Deserializer>(d: D) -> Result<Value, D::Error> {
        d.deserialize_any(ValueVisitor)
    }
}
