//! Time zones, as `chrono::offset`: the [`TimeZone`](crate::chrono::TimeZone)
//! trait, [`Utc`](crate::chrono::Utc),
//! [`FixedOffset`](crate::chrono::FixedOffset) and
//! [`Local`](crate::chrono::Local) (the system's zone), and
//! [`LocalResult`](crate::chrono::LocalResult).
//!
//! # Examples
//!
//! ```
//! use std::chrono::{FixedOffset, TimeZone, Utc};
//!
//! let t = Utc.with_ymd_and_hms(2024, 5, 6, 7, 8, 9).unwrap();
//! let ist = FixedOffset::east_opt(5 * 3600 + 1800).unwrap();
//! assert_eq(
//!     t.with_timezone(&ist).to_rfc3339(),
//!     "2024-05-06T12:38:09+05:30",
//! );
//! ```

use crate::{
    chrono::{
        DateTime, NaiveDate, NaiveDateTime, TimeDelta,
        format::{self, ParseError},
    },
    fmt::{self, Debug, Display, Formatter},
    str::FromStr,
};

/// What a local date and time is in a time zone: one instant, two (in
/// the hour repeated when clocks go back) or none (skipped when they go
/// forward, or out of range).
///
/// # Examples
///
/// ```
/// use std::chrono::{LocalResult, TimeZone, Utc};
///
/// assert(
///     Utc.with_ymd_and_hms(2024, 2, 29, 0, 0, 0)
///         .single()
///         .is_some(),
/// );
/// assert_eq(
///     Utc.with_ymd_and_hms(2023, 2, 29, 0, 0, 0),
///     LocalResult::None,
/// );
/// ```
#[derive(Clone, PartialEq, Eq, Debug)]
pub enum LocalResult<T> {
    /// The local time is one instant.
    Single(T),
    /// The local time is two instants (the earlier first).
    Ambiguous(T, T),
    /// The local time is no instant.
    None,
}

/// The name of [`LocalResult`] in newer chrono.
pub type MappedLocalResult<T> = LocalResult<T>;

impl<T> LocalResult<T> {
    /// Returns the result if there is exactly one.
    pub fn single(self) -> Option<T> {
        match self {
            LocalResult::Single(t) => Some(t),
            _ => None,
        }
    }

    /// Returns the single result, or the earlier of two.
    pub fn earliest(self) -> Option<T> {
        match self {
            LocalResult::Single(t) => Some(t),
            LocalResult::Ambiguous(t, _) => Some(t),
            LocalResult::None => None,
        }
    }

    /// Returns the single result, or the later of two.
    pub fn latest(self) -> Option<T> {
        match self {
            LocalResult::Single(t) => Some(t),
            LocalResult::Ambiguous(_, t) => Some(t),
            LocalResult::None => None,
        }
    }

    /// Applies `f` to the results.
    pub fn map<U>(self, f: fn(T) -> U) -> LocalResult<U> {
        match self {
            LocalResult::Single(t) => LocalResult::Single(f(t)),
            LocalResult::Ambiguous(a, b) => LocalResult::Ambiguous(f(a), f(b)),
            LocalResult::None => LocalResult::None,
        }
    }

    /// Returns the single result.
    ///
    /// # Panics
    ///
    /// If there is none, or two.
    pub fn unwrap(self) -> T {
        match self {
            LocalResult::Single(t) => t,
            LocalResult::Ambiguous(_, _) => panic("Ambiguous local time"),
            LocalResult::None => panic("No such local time"),
        }
    }
}

/// An offset from UTC at some instant: what a [`TimeZone`] gives.
pub trait Offset: Clone + Debug {
    /// Returns the offset as a [`FixedOffset`].
    fn fix(&self) -> FixedOffset;
}

/// A time zone: how UTC and local dates and times map to each other.
///
/// The provided methods make [`DateTime`]s in the zone.
///
/// # Examples
///
/// ```
/// use std::chrono::{FixedOffset, TimeZone};
///
/// let tz = FixedOffset::west_opt(4 * 3600).unwrap();
/// let t = tz.with_ymd_and_hms(2024, 1, 2, 3, 4, 5).unwrap();
/// assert_eq(t.to_rfc3339(), "2024-01-02T03:04:05-04:00");
/// assert_eq(
///     tz.timestamp_opt(0, 0).unwrap().to_rfc3339(),
///     "1969-12-31T20:00:00-04:00",
/// );
/// ```
pub trait TimeZone: Clone {
    /// The type of the zone's offsets.
    type Offset: Offset + Display;

    /// The zone of an offset (for DateTime::timezone).
    fn from_offset(offset: &Self::Offset) -> Self;

    /// Returns the zone's offsets at the local date and time `local`.
    fn offset_from_local_datetime(&self, local: &NaiveDateTime) -> LocalResult<Self::Offset>;
    /// Returns the zone's offset at the UTC date and time `utc`.
    fn offset_from_utc_datetime(&self, utc: &NaiveDateTime) -> Self::Offset;

    /// Returns the zone's offsets at local midnight of `local`.
    fn offset_from_local_date(&self, local: &NaiveDate) -> LocalResult<Self::Offset> {
        self.offset_from_local_datetime(&local.and_hms_opt(0, 0, 0).unwrap())
    }

    /// Returns the zone's offset at UTC midnight of `utc`.
    fn offset_from_utc_date(&self, utc: &NaiveDate) -> Self::Offset {
        self.offset_from_utc_datetime(&utc.and_hms_opt(0, 0, 0).unwrap())
    }

    /// Makes the local date and time `year-month-day hour:min:sec` in this
    /// zone: [`LocalResult::None`] if it is invalid or does not exist.
    fn with_ymd_and_hms(
        &self,
        year: i32,
        month: u32,
        day: u32,
        hour: u32,
        min: u32,
        sec: u32,
    ) -> LocalResult<DateTime<Self>> {
        match NaiveDate::from_ymd_opt(year, month, day) {
            Some(d) => match d.and_hms_opt(hour, min, sec) {
                Some(dt) => self.from_local_datetime(&dt),
                None => LocalResult::None,
            },
            None => LocalResult::None,
        }
    }

    /// Makes the instant `secs` seconds and `nsecs` nanoseconds after
    /// 1970-01-01 00:00:00 UTC, in this zone ([`LocalResult::None`] if out
    /// of range).
    fn timestamp_opt(&self, secs: i64, nsecs: u32) -> LocalResult<DateTime<Self>> {
        match NaiveDateTime::from_unix(secs, nsecs) {
            Some(utc) => LocalResult::Single(self.from_utc_datetime(&utc)),
            None => LocalResult::None,
        }
    }

    /// Makes the instant `millis` milliseconds after the Unix epoch, in
    /// this zone.
    fn timestamp_millis_opt(&self, millis: i64) -> LocalResult<DateTime<Self>> {
        self.timestamp_opt(
            millis.div_euclid(1000),
            (millis.rem_euclid(1000) * 1_000_000) as u32,
        )
    }

    /// Makes the instant `nanos` nanoseconds after the Unix epoch, in this
    /// zone.
    fn timestamp_nanos(&self, nanos: i64) -> DateTime<Self> {
        self.timestamp_opt(
            nanos.div_euclid(1_000_000_000),
            nanos.rem_euclid(1_000_000_000) as u32,
        )
        .unwrap()
    }

    /// Makes the instant `micros` microseconds after the Unix epoch, in
    /// this zone.
    fn timestamp_micros(&self, micros: i64) -> LocalResult<DateTime<Self>> {
        self.timestamp_opt(
            micros.div_euclid(1_000_000),
            (micros.rem_euclid(1_000_000) * 1000) as u32,
        )
    }

    /// Returns the instant `utc` (a UTC date and time) in this zone.
    fn from_utc_datetime(&self, utc: &NaiveDateTime) -> DateTime<Self> {
        let off = self.offset_from_utc_datetime(utc);
        DateTime::from_naive_utc_and_offset(*utc, off)
    }

    /// Returns the instants the local date and time `local` is in this
    /// zone.
    fn from_local_datetime(&self, local: &NaiveDateTime) -> LocalResult<DateTime<Self>> {
        match self.offset_from_local_datetime(local) {
            LocalResult::Single(o) => match to_utc(local, &o) {
                Some(u) => LocalResult::Single(DateTime::from_naive_utc_and_offset(u, o)),
                None => LocalResult::None,
            },
            LocalResult::Ambiguous(a, b) => match (to_utc(local, &a), to_utc(local, &b)) {
                (Some(ua), Some(ub)) => LocalResult::Ambiguous(
                    DateTime::from_naive_utc_and_offset(ua, a),
                    DateTime::from_naive_utc_and_offset(ub, b),
                ),
                _ => LocalResult::None,
            },
            LocalResult::None => LocalResult::None,
        }
    }

    /// Parses `s` with a format string into a date and time of this zone.
    ///
    /// # Errors
    ///
    /// A [`ParseError`] if `s` does not match `fmt` or is not a valid date
    /// and time.
    fn datetime_from_str(&self, s: &str, fmt: &str) -> Result<DateTime<Self>, ParseError> {
        let p = format::parse(s, fmt)?;
        p.to_datetime_with_timezone(self)
    }
}

fn to_utc<O: Offset>(local: &NaiveDateTime, o: &O) -> Option<NaiveDateTime> {
    local.checked_sub_signed(TimeDelta::seconds(o.fix().local_minus_utc() as i64))
}

// --- Utc ---------------------------------------------------------------------

/// The UTC time zone.
///
/// # Examples
///
/// ```
/// use std::chrono::{DateTime, TimeZone, Utc};
///
/// let t: DateTime<Utc> = Utc.timestamp_opt(1_000_000_000, 0).unwrap();
/// assert_eq(t.to_string(), "2001-09-09 01:46:40 UTC");
/// let now = Utc::now();
/// assert(now > t);
/// ```
#[derive(Clone, PartialEq, Eq, Hash)]
pub struct Utc;

impl Utc {
    /// Returns the current instant (the system clock).
    pub fn now() -> DateTime<Utc> {
        let (secs, nanos) = now_unix();
        Utc.timestamp_opt(secs, nanos).unwrap()
    }

    /// Returns the current date in UTC.
    pub fn today() -> NaiveDate {
        Utc::now().date_naive()
    }
}

pub(crate) fn now_unix() -> (i64, u32) {
    match crate::time::SystemTime::now().duration_since(crate::time::UNIX_EPOCH) {
        Ok(d) => (d.as_secs() as i64, d.subsec_nanos()),
        Err(e) => {
            let d = e.duration();
            let ns = d.subsec_nanos();
            if ns == 0 {
                (-(d.as_secs() as i64), 0)
            } else {
                (-(d.as_secs() as i64) - 1, 1_000_000_000 - ns)
            }
        }
    }
}

impl TimeZone for Utc {
    type Offset = Utc;
    fn from_offset(_o: &Utc) -> Utc {
        Utc
    }

    fn offset_from_local_datetime(&self, _local: &NaiveDateTime) -> LocalResult<Utc> {
        LocalResult::Single(Utc)
    }

    fn offset_from_utc_datetime(&self, _utc: &NaiveDateTime) -> Utc {
        Utc
    }
}

impl Offset for Utc {
    fn fix(&self) -> FixedOffset {
        FixedOffset { local_minus_utc: 0 }
    }
}

impl Debug for Utc {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("Z")
    }
}

impl Display for Utc {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("UTC")
    }
}

impl Default for Utc {
    fn default() -> Utc {
        Utc
    }
}

// --- FixedOffset -------------------------------------------------------------

/// A time zone a fixed number of seconds east of UTC (less than a day
/// either way).
///
/// It displays (and parses with `str::parse`) as `+09:00`.
///
/// # Examples
///
/// ```
/// use std::chrono::{FixedOffset, TimeZone};
///
/// let tokyo = FixedOffset::east_opt(9 * 3600).unwrap();
/// assert_eq(tokyo.to_string(), "+09:00");
/// assert_eq("+09:00".parse::<FixedOffset>(), Ok(tokyo.clone()));
/// let t = tokyo.with_ymd_and_hms(2024, 5, 6, 7, 8, 9).unwrap();
/// assert_eq(t.to_rfc3339(), "2024-05-06T07:08:09+09:00");
/// assert(FixedOffset::east_opt(86_400).is_none());
/// ```
#[derive(Clone, PartialEq, Eq, Hash)]
pub struct FixedOffset {
    local_minus_utc: i32,
}

impl FixedOffset {
    /// Makes the zone `secs` seconds east of UTC (UTC+...), or `None`
    /// unless `-86400 < secs < 86400`.
    pub fn east_opt(secs: i32) -> Option<FixedOffset> {
        if secs > -86400 && secs < 86400 {
            Some(FixedOffset {
                local_minus_utc: secs,
            })
        } else {
            None
        }
    }

    /// Makes the zone `secs` seconds west of UTC (UTC-...), or `None`
    /// unless `-86400 < secs < 86400`.
    pub fn west_opt(secs: i32) -> Option<FixedOffset> {
        if secs > -86400 && secs < 86400 {
            Some(FixedOffset {
                local_minus_utc: -secs,
            })
        } else {
            None
        }
    }

    /// Returns the offset in seconds: local time minus UTC.
    pub fn local_minus_utc(&self) -> i32 {
        self.local_minus_utc
    }

    /// Returns the offset in seconds the other way: UTC minus local time.
    pub fn utc_minus_local(&self) -> i32 {
        -self.local_minus_utc
    }
}

impl TimeZone for FixedOffset {
    type Offset = FixedOffset;
    fn from_offset(o: &FixedOffset) -> FixedOffset {
        *o
    }

    fn offset_from_local_datetime(&self, _local: &NaiveDateTime) -> LocalResult<FixedOffset> {
        LocalResult::Single(*self)
    }

    fn offset_from_utc_datetime(&self, _utc: &NaiveDateTime) -> FixedOffset {
        *self
    }
}

impl Offset for FixedOffset {
    fn fix(&self) -> FixedOffset {
        *self
    }
}

/// "+09:00" ("+09:00:30" with seconds).
impl Debug for FixedOffset {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        let off = self.local_minus_utc;
        let (sign, a) = if off < 0 { ('-', -off) } else { ('+', off) };
        let sec = a % 60;
        let min = a / 60 % 60;
        let hour = a / 3600;
        if sec == 0 {
            f.write_fmt(`${sign}${hour:02}:${min:02}`)
        } else {
            f.write_fmt(`${sign}${hour:02}:${min:02}:${sec:02}`)
        }
    }
}

impl Display for FixedOffset {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        Debug::fmt(self, f)
    }
}

/// "+09:00", "-0530", "+09" (as %z with optional colon and minutes).
impl FromStr for FixedOffset {
    type Err = ParseError;
    fn from_str(s: &str) -> Result<FixedOffset, ParseError> {
        let p = format::parse(s, "%#z")?;
        match p.offset() {
            Some(o) => Ok(FixedOffset { local_minus_utc: o }),
            None => Err(format::not_enough()),
        }
    }
}

// --- Local -------------------------------------------------------------------

/// The system's time zone (the `TZ` environment variable or the system
/// setting, through the C library's `localtime`).
///
/// # Examples
///
/// ```
/// use std::chrono::{DateTime, Local};
///
/// let now: DateTime<Local> = Local::now();
/// // The same instant as UTC, whatever the zone.
/// assert_eq(now.to_utc(), now);
/// ```
#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub struct Local;

impl Local {
    /// Returns the current instant in the system's zone.
    pub fn now() -> DateTime<Local> {
        let (secs, nanos) = now_unix();
        Local.timestamp_opt(secs, nanos).unwrap()
    }

    /// Returns the current local date.
    pub fn today() -> NaiveDate {
        Local::now().date_naive()
    }
}

impl Default for Local {
    fn default() -> Local {
        Local
    }
}

impl TimeZone for Local {
    type Offset = FixedOffset;
    fn from_offset(_o: &FixedOffset) -> Local {
        Local
    }

    fn offset_from_utc_datetime(&self, utc: &NaiveDateTime) -> FixedOffset {
        FixedOffset {
            local_minus_utc: local_offset_at(utc.unix_secs()),
        }
    }

    // The offsets o with local - o mapping back to o: the offsets in
    // effect a day around local, tried.
    fn offset_from_local_datetime(&self, local: &NaiveDateTime) -> LocalResult<FixedOffset> {
        let l = local.unix_secs();
        let a = local_offset_at(l - 86400);
        let b = local_offset_at(l + 86400);
        let fits_a = local_offset_at(l - a as i64) == a;
        let fits_b = local_offset_at(l - b as i64) == b;
        if a == b {
            if fits_a {
                return LocalResult::Single(FixedOffset { local_minus_utc: a });
            }
            // A change within the day: the offset at the guessed instant.
            let c = local_offset_at(l - a as i64);
            if local_offset_at(l - c as i64) == c {
                return LocalResult::Single(FixedOffset { local_minus_utc: c });
            }
            return LocalResult::None;
        }
        if fits_a && fits_b {
            // The earlier instant is the one with the larger offset.
            let (x, y) = if a > b { (a, b) } else { (b, a) };
            return LocalResult::Ambiguous(
                FixedOffset { local_minus_utc: x },
                FixedOffset { local_minus_utc: y },
            );
        }
        if fits_a {
            return LocalResult::Single(FixedOffset { local_minus_utc: a });
        }
        if fits_b {
            return LocalResult::Single(FixedOffset { local_minus_utc: b });
        }
        LocalResult::None
    }
}

#[cfg(not(any(target_os = "windows", target_os = "js")))]
#[nonblocking]
extern "C" {
    fn localtime_r(t: *const i64, tm: *mut u8) -> *mut u8;
}

// js-wasm32: the browser's (Date's getTimezoneOffset, in minutes west).
#[cfg(target_os = "js")]
#[link(wasm_import_module = "navi")]
#[nonblocking]
extern "C" {
    fn tz_offset(secs: f64) -> f64;
}

#[cfg(target_os = "js")]
fn local_offset_at(secs: i64) -> i32 {
    unsafe { tz_offset(secs as f64) as i32 }
}

// struct tm: nine ints, then (macOS, Linux, Android) long tm_gmtoff.
#[cfg(not(any(target_os = "windows", target_os = "js")))]
fn local_offset_at(secs: i64) -> i32 {
    let mut tm = [0u64; 8];
    let t = secs;
    let r = unsafe { localtime_r(&t as *const i64, &mut tm as *mut [u64; 8] as *mut u8) };
    if r as usize == 0 {
        return 0;
    }
    tm[5] as i64 as i32
}

#[cfg(target_os = "windows")]
#[nonblocking]
extern "C" {
    fn _localtime64_s(tm: *mut u8, t: *const i64) -> i32;
    fn _mkgmtime64(tm: *mut u8) -> i64;
}

// Windows' struct tm has no tm_gmtoff: the local fields read as UTC.
#[cfg(target_os = "windows")]
fn local_offset_at(secs: i64) -> i32 {
    let mut tm = [0u32; 9];
    let t = secs;
    if unsafe { _localtime64_s(&mut tm as *mut [u32; 9] as *mut u8, &t as *const i64) } != 0 {
        return 0;
    }
    let local = unsafe { _mkgmtime64(&mut tm as *mut [u32; 9] as *mut u8) };
    if local == -1 {
        0
    } else {
        (local - secs) as i32
    }
}
