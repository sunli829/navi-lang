//! Dates and times with time zones, and strftime formatting and parsing
//! (as Go's time formatting, with the API of Rust's chrono crate).
//!
//!     let now = Utc::now();
//!     let t = Utc.with_ymd_and_hms(2024, 5, 6, 7, 8, 9).unwrap();
//!     t.to_rfc3339()                                // "2024-05-06T07:08:09+00:00"
//!     t.format("%Y-%m-%d %H:%M").to_string()        // "2024-05-06 07:08"
//!     let d = DateTime::parse_from_rfc3339("2024-05-06T07:08:09+09:00").unwrap();
//!     let n = NaiveDate::parse_from_str("06/05/2024", "%d/%m/%Y").unwrap();
//!     let tokyo = FixedOffset::east_opt(9 * 3600).unwrap();
//!     t.with_timezone(&tokyo).hour()                // 16
//!     (t + TimeDelta::days(1)).weekday()            // Weekday::Tue
//!
//! Dates are proleptic Gregorian, from -262143 to +262142. Local is the
//! system's zone (through the C library's localtime).

pub mod format;
pub mod naive;
pub mod offset;
mod delta;
mod datetime;

pub use delta::{TimeDelta, Duration, OutOfRangeError};
pub use naive::{NaiveDate, NaiveTime, NaiveDateTime, NaiveWeek, IsoWeek, Weekday, Month, Days, Months, Datelike, Timelike, ParseWeekdayError, ParseMonthError};
pub use offset::{TimeZone, Offset, Utc, FixedOffset, Local, LocalResult, MappedLocalResult};
pub use datetime::{DateTime, SecondsFormat, UNIX_EPOCH};
pub use format::{ParseError, ParseErrorKind, ParseResult, DelayedFormat};

/// The commonly used items (use std::chrono::prelude::*).
pub mod prelude {
    pub use crate::chrono::{DateTime, NaiveDate, NaiveTime, NaiveDateTime, TimeDelta, Duration, Weekday, Month, Days, Months, IsoWeek};
    pub use crate::chrono::{Datelike, Timelike, TimeZone, Offset, Utc, FixedOffset, Local, SecondsFormat};
}
