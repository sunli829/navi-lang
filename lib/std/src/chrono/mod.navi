//! Dates and times, with time zones, and strftime-like formatting and
//! parsing, with the API of Rust's `chrono` crate (0.4).
//!
//! - [`DateTime<Tz>`](crate::chrono::DateTime): an instant in a time zone
//!   ([`Utc`](crate::chrono::Utc), [`FixedOffset`](crate::chrono::FixedOffset),
//!   [`Local`](crate::chrono::Local));
//! - [`NaiveDate`](crate::chrono::NaiveDate),
//!   [`NaiveTime`](crate::chrono::NaiveTime),
//!   [`NaiveDateTime`](crate::chrono::NaiveDateTime): dates and times
//!   without a zone (the [`naive`](crate::chrono::naive) module);
//! - [`TimeDelta`](crate::chrono::TimeDelta): a signed duration;
//! - [`format`](crate::chrono::format): the format specifiers and parsing.
//!
//! Dates are proleptic Gregorian, from -262143 to +262142. `Local` is the
//! system's zone (through the C library's `localtime`). The results of
//! formatting, parsing and arithmetic are chrono 0.4's.
//!
//! # Examples
//!
//! ```
//! use std::chrono::prelude::*;
//!
//! let t = Utc.with_ymd_and_hms(2024, 5, 6, 7, 8, 9).unwrap();
//! assert_eq(t.to_rfc3339(), "2024-05-06T07:08:09+00:00");
//! assert_eq(t.format("%Y-%m-%d %H:%M").to_string(), "2024-05-06 07:08");
//! assert_eq(t.timestamp(), 1714979289);
//!
//! let tokyo = FixedOffset::east_opt(9 * 3600).unwrap();
//! assert_eq(t.with_timezone(&tokyo).hour(), 16);
//! assert_eq((t + TimeDelta::days(1)).weekday(), Weekday::Tue);
//!
//! let d = DateTime::parse_from_rfc3339("2024-05-06T16:08:09+09:00").unwrap();
//! assert_eq(d, t); // the same instant
//! let n = NaiveDate::parse_from_str("06/05/2024", "%d/%m/%Y").unwrap();
//! assert_eq(n, t.date_naive());
//!
//! let now = Utc::now(); // the current time
//! ```

mod datetime;
mod delta;
pub mod format;
pub mod naive;
pub mod offset;

pub use datetime::{DateTime, SecondsFormat, UNIX_EPOCH};
pub use delta::{Duration, OutOfRangeError, TimeDelta};
pub use format::{DelayedFormat, ParseError, ParseErrorKind, ParseResult};
pub use naive::{
    Datelike, Days, IsoWeek, Month, Months, NaiveDate, NaiveDateTime, NaiveTime, NaiveWeek,
    ParseMonthError, ParseWeekdayError, Timelike, Weekday,
};
pub use offset::{FixedOffset, Local, LocalResult, MappedLocalResult, Offset, TimeZone, Utc};

/// The commonly used types and traits, for `use std::chrono::prelude::*;`.
pub mod prelude {
    pub use crate::chrono::{
        DateTime, Days, Duration, IsoWeek, Month, Months, NaiveDate, NaiveDateTime, NaiveTime,
        TimeDelta, Weekday,
    };
    pub use crate::chrono::{
        Datelike, FixedOffset, Local, Offset, SecondsFormat, TimeZone, Timelike, Utc,
    };
}
