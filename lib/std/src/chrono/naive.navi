//! Date and time types unconcerned with time zones.
//!
//! [`NaiveDate`] is a date in the proleptic Gregorian calendar, [`NaiveTime`]
//! a time of day and [`NaiveDateTime`] the two together. They are the building
//! blocks of the zone-aware [`DateTime`](crate::chrono::DateTime), but are
//! also handy on their own for simple date and time handling, when the time
//! zone does not matter or is kept elsewhere.
//!
//! The module also has [`Weekday`], [`Month`], [`IsoWeek`], the calendar
//! spans [`Days`] and [`Months`], and the [`Datelike`] and [`Timelike`]
//! traits, which give the date and time parts of any of these types (and of
//! `DateTime`). Everything here is re-exported from [`crate::chrono`].
//!
//! # Examples
//!
//! ```
//! use std::chrono::{Datelike, Days, NaiveDate, NaiveDateTime, Timelike, Weekday};
//!
//! let d = NaiveDate::from_ymd_opt(2015, 3, 14).unwrap();
//! assert_eq(d.weekday(), Weekday::Sat);
//! assert_eq(d.ordinal(), 73);
//! assert_eq(d + Days::new(30), NaiveDate::from_ymd_opt(2015, 4, 13).unwrap());
//!
//! let dt = d.and_hms_opt(15, 9, 26).unwrap();
//! assert_eq(dt.hour(), 15);
//! assert_eq(dt.format("%Y-%m-%d %H:%M:%S").to_string(), "2015-03-14 15:09:26");
//! assert_eq(
//!     NaiveDateTime::parse_from_str("2015-03-14 15:09:26", "%Y-%m-%d %H:%M:%S"),
//!     Ok(dt),
//! );
//! ```

use crate::chrono::TimeDelta;
use crate::chrono::format::{self, DelayedFormat, ParseError, ParseResult, Parsed};
use crate::cmp::Ordering;
use crate::fmt::{self, Debug, Display, Formatter};
use crate::ops::{Add, Sub};
use crate::str::FromStr;

// --- Calendar arithmetic (H. Hinnant's days_from_civil) -----------------------------

/// Days since 1970-01-01 of y-m-d.
pub(crate) fn days_from_civil(y: i64, m: u32, d: u32) -> i64 {
    let y = if m <= 2 { y - 1 } else { y };
    let era = y.div_euclid(400);
    let yoe = y - era * 400;
    let mp = if m > 2 { m - 3 } else { m + 9 } as i64;
    let doy = (153 * mp + 2) / 5 + d as i64 - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

/// The y-m-d of days since 1970-01-01.
pub(crate) fn civil_from_days(z0: i64) -> (i64, u32, u32) {
    let z = z0 + 719468;
    let era = z.div_euclid(146097);
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = (doy - (153 * mp + 2) / 5 + 1) as u32;
    let m = if mp < 10 { mp + 3 } else { mp - 9 } as u32;
    let y = yoe + era * 400 + if m <= 2 { 1 } else { 0 };
    (y, m, d)
}

pub(crate) fn is_leap(y: i64) -> bool {
    y.rem_euclid(4) == 0 && (y.rem_euclid(100) != 0 || y.rem_euclid(400) == 0)
}

pub(crate) fn days_in_month(y: i64, m: u32) -> u32 {
    match m {
        1 | 3 | 5 | 7 | 8 | 10 | 12 => 31,
        4 | 6 | 9 | 11 => 30,
        _ => {
            if is_leap(y) {
                29
            } else {
                28
            }
        }
    }
}

// The supported years, as chrono's.
const MIN_YEAR: i64 = -262143;
const MAX_YEAR: i64 = 262142;

// --- Weekday and Month ---------------------------------------------------------------

/// A day of the week.
///
/// Which day comes first in a week depends on the context, so `Weekday`
/// implements neither `PartialOrd` nor `Ord`: use the `*_from_monday` or
/// `*_from_sunday` methods to number the days.
///
/// It displays as its three-letter English abbreviation (`Mon`), and parses
/// (with `str::parse`) from the full English name or its first three
/// letters, ignoring ASCII case; a failed parse gives a
/// [`ParseWeekdayError`].
///
/// # Examples
///
/// ```
/// use std::chrono::{Datelike, NaiveDate, Weekday};
///
/// let d = NaiveDate::from_ymd_opt(2015, 3, 14).unwrap();
/// assert_eq(d.weekday(), Weekday::Sat);
/// assert_eq(Weekday::Sat.succ(), Weekday::Sun);
/// assert_eq(Weekday::Sat.number_from_monday(), 6);
/// assert_eq(Weekday::Sat.to_string(), "Sat");
/// assert_eq("saturday".parse::<Weekday>(), Ok(Weekday::Sat));
/// assert_eq("Sa".parse::<Weekday>().is_err(), true);
/// ```
#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub enum Weekday {
    /// Monday.
    Mon,
    /// Tuesday.
    Tue,
    /// Wednesday.
    Wed,
    /// Thursday.
    Thu,
    /// Friday.
    Fri,
    /// Saturday.
    Sat,
    /// Sunday.
    Sun,
}

const WEEKDAYS: [Weekday; 7] = [
    Weekday::Mon,
    Weekday::Tue,
    Weekday::Wed,
    Weekday::Thu,
    Weekday::Fri,
    Weekday::Sat,
    Weekday::Sun,
];
const WEEKDAY_NAMES: [&str; 7] = [
    "Monday",
    "Tuesday",
    "Wednesday",
    "Thursday",
    "Friday",
    "Saturday",
    "Sunday",
];

impl Weekday {
    /// The next day in the week.
    ///
    /// | `w`        | `Mon` | `Tue` | `Wed` | `Thu` | `Fri` | `Sat` | `Sun` |
    /// | ---------- | ----- | ----- | ----- | ----- | ----- | ----- | ----- |
    /// | `w.succ()` | `Tue` | `Wed` | `Thu` | `Fri` | `Sat` | `Sun` | `Mon` |
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::Weekday;
    ///
    /// assert_eq(Weekday::Mon.succ(), Weekday::Tue);
    /// assert_eq(Weekday::Sun.succ(), Weekday::Mon);
    /// ```
    pub fn succ(&self) -> Weekday {
        WEEKDAYS[(self.num_days_from_monday() as usize + 1) % 7]
    }

    /// The previous day in the week.
    ///
    /// | `w`        | `Mon` | `Tue` | `Wed` | `Thu` | `Fri` | `Sat` | `Sun` |
    /// | ---------- | ----- | ----- | ----- | ----- | ----- | ----- | ----- |
    /// | `w.pred()` | `Sun` | `Mon` | `Tue` | `Wed` | `Thu` | `Fri` | `Sat` |
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::Weekday;
    ///
    /// assert_eq(Weekday::Tue.pred(), Weekday::Mon);
    /// assert_eq(Weekday::Mon.pred(), Weekday::Sun);
    /// ```
    pub fn pred(&self) -> Weekday {
        WEEKDAYS[(self.num_days_from_monday() as usize + 6) % 7]
    }

    /// Returns the day-of-week number starting from Monday = 1 (the ISO 8601
    /// weekday number).
    ///
    /// | `w`                      | `Mon` | `Tue` | `Wed` | `Thu` | `Fri` | `Sat` | `Sun` |
    /// | ------------------------ | ----- | ----- | ----- | ----- | ----- | ----- | ----- |
    /// | `w.number_from_monday()` | 1     | 2     | 3     | 4     | 5     | 6     | 7     |
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::Weekday;
    ///
    /// assert_eq(Weekday::Mon.number_from_monday(), 1);
    /// assert_eq(Weekday::Sun.number_from_monday(), 7);
    /// ```
    pub fn number_from_monday(&self) -> u32 {
        self.num_days_from_monday() + 1
    }

    /// Returns the day-of-week number starting from Sunday = 1.
    ///
    /// | `w`                      | `Mon` | `Tue` | `Wed` | `Thu` | `Fri` | `Sat` | `Sun` |
    /// | ------------------------ | ----- | ----- | ----- | ----- | ----- | ----- | ----- |
    /// | `w.number_from_sunday()` | 2     | 3     | 4     | 5     | 6     | 7     | 1     |
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::Weekday;
    ///
    /// assert_eq(Weekday::Sun.number_from_sunday(), 1);
    /// assert_eq(Weekday::Sat.number_from_sunday(), 7);
    /// ```
    pub fn number_from_sunday(&self) -> u32 {
        self.num_days_from_sunday() + 1
    }

    /// Returns the day-of-week number starting from Monday = 0.
    ///
    /// | `w`                        | `Mon` | `Tue` | `Wed` | `Thu` | `Fri` | `Sat` | `Sun` |
    /// | -------------------------- | ----- | ----- | ----- | ----- | ----- | ----- | ----- |
    /// | `w.num_days_from_monday()` | 0     | 1     | 2     | 3     | 4     | 5     | 6     |
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::Weekday;
    ///
    /// assert_eq(Weekday::Mon.num_days_from_monday(), 0);
    /// assert_eq(Weekday::Sun.num_days_from_monday(), 6);
    /// ```
    pub fn num_days_from_monday(&self) -> u32 {
        match self {
            Weekday::Mon => 0,
            Weekday::Tue => 1,
            Weekday::Wed => 2,
            Weekday::Thu => 3,
            Weekday::Fri => 4,
            Weekday::Sat => 5,
            Weekday::Sun => 6,
        }
    }

    /// Returns the day-of-week number starting from Sunday = 0.
    ///
    /// | `w`                        | `Mon` | `Tue` | `Wed` | `Thu` | `Fri` | `Sat` | `Sun` |
    /// | -------------------------- | ----- | ----- | ----- | ----- | ----- | ----- | ----- |
    /// | `w.num_days_from_sunday()` | 1     | 2     | 3     | 4     | 5     | 6     | 0     |
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::Weekday;
    ///
    /// assert_eq(Weekday::Sun.num_days_from_sunday(), 0);
    /// assert_eq(Weekday::Mon.num_days_from_sunday(), 1);
    /// ```
    pub fn num_days_from_sunday(&self) -> u32 {
        (self.num_days_from_monday() + 1) % 7
    }

    /// The number of days since the given day: how many days forward from
    /// `other` until `self` (0 to 6).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::Weekday;
    ///
    /// assert_eq(Weekday::Wed.days_since(Weekday::Mon), 2);
    /// assert_eq(Weekday::Mon.days_since(Weekday::Wed), 5);
    /// assert_eq(Weekday::Fri.days_since(Weekday::Fri), 0);
    /// ```
    pub fn days_since(&self, other: Weekday) -> u32 {
        (self.num_days_from_monday() + 7 - other.num_days_from_monday()) % 7
    }

    pub(crate) fn from_monday(n: u32) -> Weekday {
        WEEKDAYS[(n % 7) as usize]
    }

    pub(crate) fn name(&self) -> &str {
        WEEKDAY_NAMES[self.num_days_from_monday() as usize]
    }
}

impl Display for Weekday {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.pad(&self.name()[0..3])
    }
}

impl FromStr for Weekday {
    type Err = ParseWeekdayError;
    fn from_str(s: &str) -> Result<Weekday, ParseWeekdayError> {
        let l = s.to_ascii_lowercase();
        let mut i = 0;
        while i < 7 {
            let n = WEEKDAY_NAMES[i].to_ascii_lowercase();
            if l == n || l == &n[0..3] {
                return Ok(WEEKDAYS[i]);
            }
            i += 1;
        }
        Err(ParseWeekdayError {})
    }
}

/// The error from parsing a [`Weekday`] (with `str::parse`).
///
/// # Examples
///
/// ```
/// use std::chrono::{ParseWeekdayError, Weekday};
///
/// assert_eq("Funday".parse::<Weekday>(), Err(ParseWeekdayError {}));
/// ```
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct ParseWeekdayError {}

impl Display for ParseWeekdayError {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("ParseWeekdayError { _dummy: () }")
    }
}

/// A month of the year.
///
/// Months are ordered from January to December. A `Month` parses (with
/// `str::parse`) from the full English name or its first three letters,
/// ignoring ASCII case; a failed parse gives a [`ParseMonthError`]. The
/// [`Datelike::month`] of a date is a number; [`Month::try_from_u32`] turns
/// it into a `Month`.
///
/// # Examples
///
/// ```
/// use std::chrono::{Datelike, Month, NaiveDate};
///
/// let d = NaiveDate::from_ymd_opt(2015, 3, 14).unwrap();
/// let m = Month::try_from_u32(d.month()).unwrap();
/// assert_eq(m, Month::March);
/// assert_eq(m.name(), "March");
/// assert_eq(m.succ(), Month::April);
/// assert(Month::January < Month::December);
/// assert_eq("mar".parse::<Month>(), Ok(Month::March));
/// ```
#[derive(Clone, PartialEq, Eq, Hash, Debug, PartialOrd, Ord)]
pub enum Month {
    /// January.
    January,
    /// February.
    February,
    /// March.
    March,
    /// April.
    April,
    /// May.
    May,
    /// June.
    June,
    /// July.
    July,
    /// August.
    August,
    /// September.
    September,
    /// October.
    October,
    /// November.
    November,
    /// December.
    December,
}

const MONTHS: [Month; 12] = [
    Month::January,
    Month::February,
    Month::March,
    Month::April,
    Month::May,
    Month::June,
    Month::July,
    Month::August,
    Month::September,
    Month::October,
    Month::November,
    Month::December,
];
pub(crate) const MONTH_NAMES: [&str; 12] = [
    "January",
    "February",
    "March",
    "April",
    "May",
    "June",
    "July",
    "August",
    "September",
    "October",
    "November",
    "December",
];

impl Month {
    /// Returns the month-of-year number starting from January = 1.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::Month;
    ///
    /// assert_eq(Month::January.number_from_month(), 1);
    /// assert_eq(Month::December.number_from_month(), 12);
    /// ```
    pub fn number_from_month(&self) -> u32 {
        let mut i = 0;
        while i < 12 {
            if MONTHS[i] == *self {
                return i as u32 + 1;
            }
            i += 1;
        }
        0
    }

    /// The next month (January after December).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::Month;
    ///
    /// assert_eq(Month::March.succ(), Month::April);
    /// assert_eq(Month::December.succ(), Month::January);
    /// ```
    pub fn succ(&self) -> Month {
        MONTHS[(self.number_from_month() as usize) % 12]
    }

    /// The previous month (December before January).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::Month;
    ///
    /// assert_eq(Month::March.pred(), Month::February);
    /// assert_eq(Month::January.pred(), Month::December);
    /// ```
    pub fn pred(&self) -> Month {
        MONTHS[(self.number_from_month() as usize + 10) % 12]
    }

    /// The English name of the month.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::Month;
    ///
    /// assert_eq(Month::January.name(), "January");
    /// assert_eq(Month::September.name(), "September");
    /// ```
    pub fn name(&self) -> &str {
        MONTH_NAMES[self.number_from_month() as usize - 1]
    }

    /// The month numbered `n` (1 = January to 12 = December), or `None` if
    /// `n` is not in 1 to 12.
    ///
    /// This is chrono's `Month::try_from(u8)`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::Month;
    ///
    /// assert_eq(Month::try_from_u32(5), Some(Month::May));
    /// assert_eq(Month::try_from_u32(0), None);
    /// assert_eq(Month::try_from_u32(13), None);
    /// ```
    pub fn try_from_u32(n: u32) -> Option<Month> {
        if n >= 1 && n <= 12 {
            Some(MONTHS[n as usize - 1])
        } else {
            None
        }
    }

    /// The number of days in this month of `year` (28 to 31).
    ///
    /// February has 29 days in leap years of the proleptic Gregorian
    /// calendar. This always returns `Some` (chrono returns `None` for a
    /// year out of [`NaiveDate`]'s range).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::Month;
    ///
    /// assert_eq(Month::January.num_days(2015), Some(31));
    /// assert_eq(Month::April.num_days(2015), Some(30));
    /// assert_eq(Month::February.num_days(2024), Some(29));
    /// assert_eq(Month::February.num_days(1900), Some(28));
    /// assert_eq(Month::February.num_days(2000), Some(29));
    /// ```
    pub fn num_days(&self, year: i32) -> Option<u8> {
        Some(days_in_month(year as i64, self.number_from_month()) as u8)
    }
}

impl FromStr for Month {
    type Err = ParseMonthError;
    fn from_str(s: &str) -> Result<Month, ParseMonthError> {
        let l = s.to_ascii_lowercase();
        let mut i = 0;
        while i < 12 {
            let n = MONTH_NAMES[i].to_ascii_lowercase();
            if l == n || l == &n[0..3] {
                return Ok(MONTHS[i]);
            }
            i += 1;
        }
        Err(ParseMonthError {})
    }
}

/// The error from parsing a [`Month`] (with `str::parse`).
///
/// # Examples
///
/// ```
/// use std::chrono::{Month, ParseMonthError};
///
/// assert_eq("Smarch".parse::<Month>(), Err(ParseMonthError {}));
/// ```
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct ParseMonthError {}

impl Display for ParseMonthError {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("ParseMonthError { _dummy: () }")
    }
}

/// A number of calendar days, to add to or subtract from a date.
///
/// Unlike a [`TimeDelta`], which is a fixed number of seconds, `Days`
/// changes only the date: adding `Days::new(1)` to a date and time keeps
/// its time of day. Use it with [`NaiveDate::checked_add_days`],
/// [`NaiveDateTime::checked_add_days`] and the like, or with `+` and `-`
/// (which panic when the result is out of range).
///
/// # Examples
///
/// ```
/// use std::chrono::{Days, NaiveDate};
///
/// let d = NaiveDate::from_ymd_opt(2015, 3, 14).unwrap();
/// assert_eq(d + Days::new(30), NaiveDate::from_ymd_opt(2015, 4, 13).unwrap());
/// assert_eq(d - Days::new(14), NaiveDate::from_ymd_opt(2015, 2, 28).unwrap());
/// ```
#[derive(Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
pub struct Days(u64);

impl Days {
    /// Constructs a `Days` of `n` days.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Days, NaiveDate};
    ///
    /// let d = NaiveDate::from_ymd_opt(2024, 2, 28).unwrap();
    /// assert_eq(d.checked_add_days(Days::new(2)), NaiveDate::from_ymd_opt(2024, 3, 1));
    /// ```
    pub fn new(n: u64) -> Days {
        Days(n)
    }
}

/// A number of calendar months, to add to or subtract from a date.
///
/// Adding months keeps the day of the month, except when the resulting
/// month is shorter: then the day is clamped to its last day (January 31
/// plus one month is February 28 or 29). Use it with
/// [`NaiveDate::checked_add_months`],
/// [`NaiveDateTime::checked_add_months`] and the like, or with `+` and `-`
/// (which panic when the result is out of range).
///
/// # Examples
///
/// ```
/// use std::chrono::{Months, NaiveDate};
///
/// let d = NaiveDate::from_ymd_opt(2015, 1, 31).unwrap();
/// assert_eq(d + Months::new(1), NaiveDate::from_ymd_opt(2015, 2, 28).unwrap());
/// assert_eq(d + Months::new(14), NaiveDate::from_ymd_opt(2016, 3, 31).unwrap());
/// assert_eq(d - Months::new(2), NaiveDate::from_ymd_opt(2014, 11, 30).unwrap());
/// ```
#[derive(Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
pub struct Months(u32);

impl Months {
    /// Constructs a `Months` of `n` months.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Months, NaiveDate};
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 3, 14).unwrap();
    /// assert_eq(d.checked_add_months(Months::new(12)), NaiveDate::from_ymd_opt(2016, 3, 14));
    /// ```
    pub fn new(n: u32) -> Months {
        Months(n)
    }

    /// Returns the number of months.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::Months;
    ///
    /// assert_eq(Months::new(18).as_u32(), 18);
    /// ```
    pub fn as_u32(&self) -> u32 {
        self.0
    }
}

// --- Datelike and Timelike -----------------------------------------------------------

/// The common set of methods for date components.
///
/// It is implemented by [`NaiveDate`], [`NaiveDateTime`] and
/// [`DateTime`](crate::chrono::DateTime) (whose parts are those of its
/// local date). Import the trait to call its methods.
///
/// The `with_*` methods return a new value with one component changed, or
/// `None` when the result would not be a valid date (for a `DateTime`, also
/// when the local date and time does not map to a single instant in its
/// time zone).
///
/// # Examples
///
/// ```
/// use std::chrono::{Datelike, NaiveDate, Weekday};
///
/// let d = NaiveDate::from_ymd_opt(2015, 3, 14).unwrap();
/// assert_eq(d.year(), 2015);
/// assert_eq(d.month(), 3);
/// assert_eq(d.day(), 14);
/// assert_eq(d.ordinal(), 73);
/// assert_eq(d.weekday(), Weekday::Sat);
/// assert_eq(d.quarter(), 1);
/// assert_eq(d.with_day(31), NaiveDate::from_ymd_opt(2015, 3, 31));
/// assert_eq(d.with_month(2).unwrap().with_day(29), None);
/// ```
pub trait Datelike {
    /// Returns the year number in the calendar date (0 is 1 BCE, negative
    /// years are earlier ones).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// assert_eq(NaiveDate::from_ymd_opt(2015, 3, 14).unwrap().year(), 2015);
    /// assert_eq(NaiveDate::from_ymd_opt(-308, 3, 14).unwrap().year(), -308);
    /// ```
    fn year(&self) -> i32;

    /// Returns the month number starting from 1 (1 to 12).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// assert_eq(NaiveDate::from_ymd_opt(2015, 3, 14).unwrap().month(), 3);
    /// ```
    fn month(&self) -> u32;

    /// Returns the day of the month starting from 1 (1 to 31; the last day
    /// differs by month).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// assert_eq(NaiveDate::from_ymd_opt(2015, 3, 14).unwrap().day(), 14);
    /// ```
    fn day(&self) -> u32;

    /// Returns the day of the year starting from 1 (1 to 366; the last day
    /// differs by year).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// assert_eq(NaiveDate::from_ymd_opt(2015, 3, 14).unwrap().ordinal(), 73);
    /// assert_eq(NaiveDate::from_ymd_opt(2016, 12, 31).unwrap().ordinal(), 366);
    /// ```
    fn ordinal(&self) -> u32;

    /// Returns the day of the week.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate, Weekday};
    ///
    /// assert_eq(NaiveDate::from_ymd_opt(2015, 3, 14).unwrap().weekday(), Weekday::Sat);
    /// assert_eq(NaiveDate::from_ymd_opt(1970, 1, 1).unwrap().weekday(), Weekday::Thu);
    /// ```
    fn weekday(&self) -> Weekday;

    /// Returns the ISO 8601 week the date is in.
    ///
    /// Its year can differ from [`Self::year`] around January 1.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// let w = NaiveDate::from_ymd_opt(2015, 3, 14).unwrap().iso_week();
    /// assert_eq((w.year(), w.week()), (2015, 11));
    /// let w = NaiveDate::from_ymd_opt(2014, 12, 29).unwrap().iso_week();
    /// assert_eq((w.year(), w.week()), (2015, 1));
    /// ```
    fn iso_week(&self) -> IsoWeek;

    /// Makes a new value with the year number changed, keeping the month
    /// and day.
    ///
    /// Returns `None` when the resulting date does not exist (February 29
    /// in a year that is not a leap year) or the year is out of range.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 3, 14).unwrap();
    /// assert_eq(d.with_year(2016), NaiveDate::from_ymd_opt(2016, 3, 14));
    /// let leap = NaiveDate::from_ymd_opt(2016, 2, 29).unwrap();
    /// assert_eq(leap.with_year(2015), None);
    /// ```
    fn with_year(&self, year: i32) -> Option<Self>;

    /// Makes a new value with the month number (starting from 1) changed.
    ///
    /// Returns `None` when `month` is not in 1 to 12 or the resulting date
    /// does not exist (April 31). The day is not clamped: use
    /// [`Months`] for that.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 3, 31).unwrap();
    /// assert_eq(d.with_month(5), NaiveDate::from_ymd_opt(2015, 5, 31));
    /// assert_eq(d.with_month(4), None);
    /// assert_eq(d.with_month(13), None);
    /// ```
    fn with_month(&self, month: u32) -> Option<Self>;

    /// Makes a new value with the day of the month (starting from 1)
    /// changed.
    ///
    /// Returns `None` when the day does not exist in the month.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 2, 14).unwrap();
    /// assert_eq(d.with_day(28), NaiveDate::from_ymd_opt(2015, 2, 28));
    /// assert_eq(d.with_day(29), None);
    /// ```
    fn with_day(&self, day: u32) -> Option<Self>;

    /// Makes a new value with the day of the year (starting from 1)
    /// changed.
    ///
    /// Returns `None` when the day does not exist in the year (0, or 366
    /// in a year that is not a leap year).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 3, 14).unwrap();
    /// assert_eq(d.with_ordinal(60), NaiveDate::from_ymd_opt(2015, 3, 1));
    /// assert_eq(d.with_ordinal(366), None);
    /// ```
    fn with_ordinal(&self, ordinal: u32) -> Option<Self>;

    /// Returns the month number starting from 0 (0 to 11).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// assert_eq(NaiveDate::from_ymd_opt(2015, 3, 14).unwrap().month0(), 2);
    /// ```
    fn month0(&self) -> u32 {
        self.month() - 1
    }

    /// Returns the day of the month starting from 0 (0 to 30).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// assert_eq(NaiveDate::from_ymd_opt(2015, 3, 14).unwrap().day0(), 13);
    /// ```
    fn day0(&self) -> u32 {
        self.day() - 1
    }

    /// Returns the day of the year starting from 0 (0 to 365).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// assert_eq(NaiveDate::from_ymd_opt(2015, 3, 14).unwrap().ordinal0(), 72);
    /// ```
    fn ordinal0(&self) -> u32 {
        self.ordinal() - 1
    }

    /// Makes a new value with the month number (starting from 0) changed.
    ///
    /// Returns `None` as [`Self::with_month`] does.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 3, 14).unwrap();
    /// assert_eq(d.with_month0(0), NaiveDate::from_ymd_opt(2015, 1, 14));
    /// assert_eq(d.with_month0(12), None);
    /// ```
    fn with_month0(&self, month0: u32) -> Option<Self> {
        self.with_month(month0 + 1)
    }

    /// Makes a new value with the day of the month (starting from 0)
    /// changed.
    ///
    /// Returns `None` as [`Self::with_day`] does.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 3, 14).unwrap();
    /// assert_eq(d.with_day0(0), NaiveDate::from_ymd_opt(2015, 3, 1));
    /// ```
    fn with_day0(&self, day0: u32) -> Option<Self> {
        self.with_day(day0 + 1)
    }

    /// Makes a new value with the day of the year (starting from 0)
    /// changed.
    ///
    /// Returns `None` as [`Self::with_ordinal`] does.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 3, 14).unwrap();
    /// assert_eq(d.with_ordinal0(0), NaiveDate::from_ymd_opt(2015, 1, 1));
    /// ```
    fn with_ordinal0(&self, ordinal0: u32) -> Option<Self> {
        self.with_ordinal(ordinal0 + 1)
    }

    /// Returns the absolute year number starting from 1, with a flag that
    /// is `false` when the year is before the Common Era (BCE) and `true`
    /// otherwise (CE).
    ///
    /// Year 0 is 1 BCE, year -1 is 2 BCE and so on.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// assert_eq(NaiveDate::from_ymd_opt(2015, 3, 14).unwrap().year_ce(), (true, 2015));
    /// assert_eq(NaiveDate::from_ymd_opt(0, 3, 14).unwrap().year_ce(), (false, 1));
    /// assert_eq(NaiveDate::from_ymd_opt(-5, 3, 14).unwrap().year_ce(), (false, 6));
    /// ```
    fn year_ce(&self) -> (bool, u32) {
        let y = self.year();
        if y < 1 {
            (false, (1 - y) as u32)
        } else {
            (true, y as u32)
        }
    }

    /// Counts the days in the proleptic Gregorian calendar, with January 1,
    /// year 1 (CE) as day 1.
    ///
    /// Dates before it give 0 or negative numbers.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// assert_eq(NaiveDate::from_ymd_opt(1, 1, 1).unwrap().num_days_from_ce(), 1);
    /// assert_eq(NaiveDate::from_ymd_opt(1970, 1, 1).unwrap().num_days_from_ce(), 719163);
    /// assert_eq(NaiveDate::from_ymd_opt(2015, 3, 14).unwrap().num_days_from_ce(), 735671);
    /// assert_eq(NaiveDate::from_ymd_opt(0, 12, 31).unwrap().num_days_from_ce(), 0);
    /// ```
    fn num_days_from_ce(&self) -> i32 {
        let d = days_from_civil(self.year() as i64, self.month(), self.day());
        (d + 719163) as i32
    }

    /// Returns the quarter of the year starting from 1 (1 to 4): January to
    /// March is 1, October to December is 4.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// assert_eq(NaiveDate::from_ymd_opt(2015, 3, 14).unwrap().quarter(), 1);
    /// assert_eq(NaiveDate::from_ymd_opt(2015, 10, 1).unwrap().quarter(), 4);
    /// ```
    fn quarter(&self) -> u32 {
        (self.month() - 1) / 3 + 1
    }
}

/// The common set of methods for time components.
///
/// It is implemented by [`NaiveTime`], [`NaiveDateTime`] and
/// [`DateTime`](crate::chrono::DateTime) (whose parts are those of its
/// local time). Import the trait to call its methods.
///
/// The `with_*` methods return a new value with one component changed, or
/// `None` when the result would be invalid (for a `DateTime`, also when the
/// local date and time does not map to a single instant in its time zone).
///
/// # Examples
///
/// ```
/// use std::chrono::{NaiveTime, Timelike};
///
/// let t = NaiveTime::from_hms_nano_opt(23, 56, 4, 12_345_678).unwrap();
/// assert_eq(t.hour(), 23);
/// assert_eq(t.minute(), 56);
/// assert_eq(t.second(), 4);
/// assert_eq(t.nanosecond(), 12_345_678);
/// assert_eq(t.hour12(), (true, 11));
/// assert_eq(t.num_seconds_from_midnight(), 86164);
/// assert_eq(t.with_hour(0), NaiveTime::from_hms_nano_opt(0, 56, 4, 12_345_678));
/// assert_eq(t.with_minute(60), None);
/// ```
pub trait Timelike {
    /// Returns the hour number from 0 to 23.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveTime, Timelike};
    ///
    /// assert_eq(NaiveTime::from_hms_opt(23, 56, 4).unwrap().hour(), 23);
    /// ```
    fn hour(&self) -> u32;

    /// Returns the minute number from 0 to 59.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveTime, Timelike};
    ///
    /// assert_eq(NaiveTime::from_hms_opt(23, 56, 4).unwrap().minute(), 56);
    /// ```
    fn minute(&self) -> u32;

    /// Returns the second number from 0 to 59.
    ///
    /// A leap second is second 59 with a [`Self::nanosecond`] of
    /// 1,000,000,000 or more.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveTime, Timelike};
    ///
    /// assert_eq(NaiveTime::from_hms_opt(23, 56, 4).unwrap().second(), 4);
    /// let leap = NaiveTime::from_hms_milli_opt(23, 59, 59, 1_500).unwrap();
    /// assert_eq(leap.second(), 59);
    /// ```
    fn second(&self) -> u32;

    /// Returns the number of nanoseconds since the whole non-leap second.
    ///
    /// The range from 1,000,000,000 to 1,999,999,999 represents a leap
    /// second.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveTime, Timelike};
    ///
    /// let t = NaiveTime::from_hms_milli_opt(23, 56, 4, 12).unwrap();
    /// assert_eq(t.nanosecond(), 12_000_000);
    /// let leap = NaiveTime::from_hms_milli_opt(23, 59, 59, 1_500).unwrap();
    /// assert_eq(leap.nanosecond(), 1_500_000_000);
    /// ```
    fn nanosecond(&self) -> u32;

    /// Makes a new value with the hour number changed.
    ///
    /// Returns `None` when `hour` is 24 or more.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveTime, Timelike};
    ///
    /// let t = NaiveTime::from_hms_opt(23, 56, 4).unwrap();
    /// assert_eq(t.with_hour(7), NaiveTime::from_hms_opt(7, 56, 4));
    /// assert_eq(t.with_hour(24), None);
    /// ```
    fn with_hour(&self, hour: u32) -> Option<Self>;

    /// Makes a new value with the minute number changed.
    ///
    /// Returns `None` when `min` is 60 or more.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveTime, Timelike};
    ///
    /// let t = NaiveTime::from_hms_opt(23, 56, 4).unwrap();
    /// assert_eq(t.with_minute(45), NaiveTime::from_hms_opt(23, 45, 4));
    /// assert_eq(t.with_minute(60), None);
    /// ```
    fn with_minute(&self, min: u32) -> Option<Self>;

    /// Makes a new value with the second number changed.
    ///
    /// Returns `None` when `sec` is 60 or more (a leap second is made with
    /// [`Self::with_nanosecond`]).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveTime, Timelike};
    ///
    /// let t = NaiveTime::from_hms_opt(23, 56, 4).unwrap();
    /// assert_eq(t.with_second(17), NaiveTime::from_hms_opt(23, 56, 17));
    /// assert_eq(t.with_second(60), None);
    /// ```
    fn with_second(&self, sec: u32) -> Option<Self>;

    /// Makes a new value with the nanoseconds since the whole non-leap
    /// second changed.
    ///
    /// As with [`Self::nanosecond`], 1,000,000,000 to 1,999,999,999 makes a
    /// leap second, which is allowed only when the second is 59. Returns
    /// `None` when `nano` is 2,000,000,000 or more, or a leap second is
    /// asked for at another second.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveTime, Timelike};
    ///
    /// let t = NaiveTime::from_hms_opt(23, 56, 4).unwrap();
    /// assert_eq(t.with_nanosecond(333_333_333),
    ///           NaiveTime::from_hms_nano_opt(23, 56, 4, 333_333_333));
    /// assert_eq(t.with_nanosecond(1_333_333_333), None);
    /// let t59 = NaiveTime::from_hms_opt(23, 59, 59).unwrap();
    /// assert(t59.with_nanosecond(1_333_333_333).is_some());
    /// assert_eq(t59.with_nanosecond(2_000_000_000), None);
    /// ```
    fn with_nanosecond(&self, nano: u32) -> Option<Self>;

    /// Returns the hour number from 1 to 12 with a flag that is `false`
    /// for AM and `true` for PM.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveTime, Timelike};
    ///
    /// assert_eq(NaiveTime::from_hms_opt(0, 30, 0).unwrap().hour12(), (false, 12));
    /// assert_eq(NaiveTime::from_hms_opt(11, 30, 0).unwrap().hour12(), (false, 11));
    /// assert_eq(NaiveTime::from_hms_opt(12, 30, 0).unwrap().hour12(), (true, 12));
    /// assert_eq(NaiveTime::from_hms_opt(23, 30, 0).unwrap().hour12(), (true, 11));
    /// ```
    fn hour12(&self) -> (bool, u32) {
        let h = self.hour();
        let h12 = if h % 12 == 0 { 12 } else { h % 12 };
        (h >= 12, h12)
    }

    /// Returns the number of non-leap seconds past the last midnight (0 to
    /// 86,399).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveTime, Timelike};
    ///
    /// assert_eq(NaiveTime::from_hms_opt(1, 2, 3).unwrap().num_seconds_from_midnight(), 3723);
    /// assert_eq(NaiveTime::from_hms_nano_opt(23, 59, 59, 1_000_000_000)
    ///               .unwrap()
    ///               .num_seconds_from_midnight(), 86399);
    /// ```
    fn num_seconds_from_midnight(&self) -> u32 {
        self.hour() * 3600 + self.minute() * 60 + self.second()
    }
}

/// An ISO 8601 week: a year and a week number from 1 to 53.
///
/// ISO weeks start on Monday, and week 1 of a year is the week with the
/// year's first Thursday, so the first days of January can be in the last
/// week of the previous year and the last days of December in week 1 of
/// the next one. It is obtained with [`Datelike::iso_week`]; dates are made
/// from one with [`NaiveDate::from_isoywd_opt`].
///
/// Its `Debug` output is ISO 8601's `2015-W11` (with a sign and at least
/// four digits for years outside 0 to 9999). Weeks compare by year, then
/// week.
///
/// # Examples
///
/// ```
/// use std::chrono::{Datelike, NaiveDate};
///
/// let w = NaiveDate::from_ymd_opt(2015, 3, 14).unwrap().iso_week();
/// assert_eq(w.year(), 2015);
/// assert_eq(w.week(), 11);
/// assert_eq(`${w:?}`.to_string(), "2015-W11");
///
/// // January 1, 2021 is in the last week of 2020.
/// let w = NaiveDate::from_ymd_opt(2021, 1, 1).unwrap().iso_week();
/// assert_eq(`${w:?}`.to_string(), "2020-W53");
/// ```
#[derive(Clone, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub struct IsoWeek {
    year: i32,
    week: u32,
}

impl IsoWeek {
    /// Returns the year number of this ISO week.
    ///
    /// It may differ from the calendar year of the date it was taken from.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// let d = NaiveDate::from_ymd_opt(2014, 12, 29).unwrap();
    /// assert_eq(d.year(), 2014);
    /// assert_eq(d.iso_week().year(), 2015);
    /// ```
    pub fn year(&self) -> i32 {
        self.year
    }

    /// Returns the ISO week number starting from 1 (1 to 52 or 53,
    /// depending on the year).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// assert_eq(NaiveDate::from_ymd_opt(2015, 3, 14).unwrap().iso_week().week(), 11);
    /// assert_eq(NaiveDate::from_ymd_opt(2016, 1, 3).unwrap().iso_week().week(), 53);
    /// ```
    pub fn week(&self) -> u32 {
        self.week
    }

    /// Returns the ISO week number starting from 0 (0 to 51 or 52).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate};
    ///
    /// assert_eq(NaiveDate::from_ymd_opt(2015, 3, 14).unwrap().iso_week().week0(), 10);
    /// ```
    pub fn week0(&self) -> u32 {
        self.week - 1
    }
}

impl Debug for IsoWeek {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        if self.year >= 0 && self.year <= 9999 {
            f.write_fmt(`${self.year:04}-W${self.week:02}`)
        } else {
            f.write_fmt(`${sign_year(self.year)}-W${self.week:02}`)
        }
    }
}

fn sign_year(y: i32) -> String {
    let a = if y < 0 { -(y as i64) } else { y as i64 };
    let mut s = String::new();
    s.push(if y < 0 { '-' } else { '+' });
    let d = a.to_string();
    let mut k = d.len();
    while k < 4 {
        s.push('0');
        k += 1;
    }
    s.push_str(d.as_str());
    s
}

/// The ISO 8601 weeks of year y.
fn iso_weeks_in_year(y: i64) -> u32 {
    let jan1 = (days_from_civil(y, 1, 1) + 3).rem_euclid(7); // 0 = Monday
    if jan1 == 3 || (jan1 == 2 && is_leap(y)) {
        53
    } else {
        52
    }
}

// --- NaiveDate -----------------------------------------------------------------------

/// An ISO 8601 calendar date without a time zone.
///
/// It is a date of the proleptic Gregorian calendar (the Gregorian
/// calendar extended back before its introduction in 1582), from
/// -262144-01-01 ([`NaiveDate::MIN`]) to +262143-12-31
/// ([`NaiveDate::MAX`]), though the constructors from a year
/// ([`NaiveDate::from_ymd_opt`], [`NaiveDate::from_yo_opt`],
/// [`Datelike::with_year`]) take years from -262143 to 262142 only. Years
/// are astronomical: year 0 is 1 BCE, year -1 is 2 BCE and so on (see
/// [`Datelike::year_ce`]).
///
/// Its parts come from the [`Datelike`] trait. Dates compare in calendar
/// order. `Display` and `Debug` give ISO 8601's `2015-03-14` (years
/// outside 0 to 9999 with a sign and at least four digits, as
/// `-0005-03-01`), and `str::parse` reads that form back (after trimming
/// whitespace). `Default` is 1970-01-01.
///
/// Arithmetic: `date + TimeDelta` and `date - TimeDelta` move by the whole
/// days of a [`TimeDelta`]; `date + Days`, `date - Days`, `date + Months`
/// and `date - Months` move by calendar days or months; `date - date` is
/// the [`TimeDelta`] between them. The operators panic when the result is
/// out of range; the `checked_*` methods return `None` instead.
///
/// # Examples
///
/// ```
/// use std::chrono::{Datelike, Days, Months, NaiveDate, TimeDelta, Weekday};
///
/// let d = NaiveDate::from_ymd_opt(2015, 3, 14).unwrap();
/// assert_eq((d.year(), d.month(), d.day()), (2015, 3, 14));
/// assert_eq(d.weekday(), Weekday::Sat);
/// assert_eq(d.to_string(), "2015-03-14");
/// assert_eq("2015-03-14".parse::<NaiveDate>(), Ok(d));
///
/// assert_eq(d + Days::new(18), NaiveDate::from_ymd_opt(2015, 4, 1).unwrap());
/// assert_eq(d - Months::new(3), NaiveDate::from_ymd_opt(2014, 12, 14).unwrap());
/// assert_eq(d + TimeDelta::weeks(1), NaiveDate::from_ymd_opt(2015, 3, 21).unwrap());
/// let pi_day_2016 = NaiveDate::from_ymd_opt(2016, 3, 14).unwrap();
/// assert_eq(pi_day_2016 - d, TimeDelta::days(366));
/// assert(d < pi_day_2016);
/// ```
#[derive(Clone, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub struct NaiveDate {
    // Days since 1970-01-01.
    days: i32,
}

impl NaiveDate {
    /// The earliest date that can be represented, -262144-01-01.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::NaiveDate;
    ///
    /// assert_eq(NaiveDate::MIN.to_string(), "-262144-01-01");
    /// assert_eq(NaiveDate::MIN.pred_opt(), None);
    /// ```
    pub const MIN: NaiveDate = NaiveDate { days: -96465658 };

    /// The latest date that can be represented, +262143-12-31.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::NaiveDate;
    ///
    /// assert_eq(NaiveDate::MAX.to_string(), "+262143-12-31");
    /// assert_eq(NaiveDate::MAX.succ_opt(), None);
    /// ```
    pub const MAX: NaiveDate = NaiveDate { days: 95026601 };

    pub(crate) fn from_days(days: i64) -> Option<NaiveDate> {
        if days < NaiveDate::MIN.days as i64 || days > NaiveDate::MAX.days as i64 {
            return None;
        }
        Some(NaiveDate { days: days as i32 })
    }

    pub(crate) fn days(&self) -> i64 {
        self.days as i64
    }

    /// Makes a new `NaiveDate` from the calendar date (year, month and
    /// day).
    ///
    /// Returns `None` when the year is not in -262143 to 262142 or the
    /// month or day is invalid (including February 29 in a year that is not
    /// a leap year).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Datelike, NaiveDate, Weekday};
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 3, 14).unwrap();
    /// assert_eq(d.year(), 2015);
    /// assert_eq(d.month(), 3);
    /// assert_eq(d.day(), 14);
    /// assert_eq(d.ordinal(), 73); // day of year
    /// assert_eq(d.weekday(), Weekday::Sat);
    ///
    /// assert(NaiveDate::from_ymd_opt(2016, 2, 29).is_some());
    /// assert(NaiveDate::from_ymd_opt(2015, 2, 29).is_none());
    /// assert(NaiveDate::from_ymd_opt(2015, 13, 1).is_none());
    /// assert(NaiveDate::from_ymd_opt(2015, 4, 31).is_none());
    /// assert(NaiveDate::from_ymd_opt(-4, 2, 29).is_some()); // 5 BCE is a leap year
    /// assert(NaiveDate::from_ymd_opt(400000, 1, 1).is_none());
    /// ```
    pub fn from_ymd_opt(year: i32, month: u32, day: u32) -> Option<NaiveDate> {
        let y = year as i64;
        if y < MIN_YEAR
            || y > MAX_YEAR
            || month < 1
            || month > 12
            || day < 1
            || day > days_in_month(y, month)
        {
            return None;
        }
        NaiveDate::from_days(days_from_civil(y, month, day))
    }

    /// Makes a new `NaiveDate` from the ordinal date (year and day of the
    /// year, 1 = January 1).
    ///
    /// Returns `None` when the year is not in -262143 to 262142 or the day
    /// of the year is invalid (0, or 366 in a year that is not a leap year).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::NaiveDate;
    ///
    /// assert_eq(NaiveDate::from_yo_opt(2015, 73), NaiveDate::from_ymd_opt(2015, 3, 14));
    /// assert_eq(NaiveDate::from_yo_opt(2015, 365), NaiveDate::from_ymd_opt(2015, 12, 31));
    /// assert_eq(NaiveDate::from_yo_opt(2016, 366), NaiveDate::from_ymd_opt(2016, 12, 31));
    /// assert_eq(NaiveDate::from_yo_opt(2015, 366), None);
    /// assert_eq(NaiveDate::from_yo_opt(2015, 0), None);
    /// ```
    pub fn from_yo_opt(year: i32, ordinal: u32) -> Option<NaiveDate> {
        let y = year as i64;
        if y < MIN_YEAR
            || y > MAX_YEAR
            || ordinal < 1
            || ordinal > if is_leap(y) { 366 } else { 365 }
        {
            return None;
        }
        NaiveDate::from_days(days_from_civil(y, 1, 1) + ordinal as i64 - 1)
    }

    /// Makes a new `NaiveDate` from the ISO week date (ISO year, week
    /// number and day of the week).
    ///
    /// The resulting date may be in a different calendar year from the ISO
    /// year (see [`IsoWeek`]). Returns `None` when the week number is not
    /// in the ISO year (0, or 53 in a year with 52 weeks) or the date is out
    /// of range.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveDate, Weekday};
    ///
    /// let from_isoywd_opt = NaiveDate::from_isoywd_opt;
    /// let from_ymd = |y: i32, m: u32, d: u32| NaiveDate::from_ymd_opt(y, m, d).unwrap();
    ///
    /// assert_eq(from_isoywd_opt(2015, 11, Weekday::Sat), Some(from_ymd(2015, 3, 14)));
    /// assert_eq(from_isoywd_opt(2015, 0, Weekday::Sun), None);
    /// assert_eq(from_isoywd_opt(2015, 10, Weekday::Sun), Some(from_ymd(2015, 3, 8)));
    /// assert_eq(from_isoywd_opt(2015, 60, Weekday::Mon), None);
    /// assert_eq(from_isoywd_opt(400000, 10, Weekday::Fri), None);
    ///
    /// // The ISO year can begin in the previous calendar year and end in
    /// // the next one.
    /// assert_eq(from_isoywd_opt(2015, 1, Weekday::Mon), Some(from_ymd(2014, 12, 29)));
    /// assert_eq(from_isoywd_opt(2015, 53, Weekday::Sun), Some(from_ymd(2016, 1, 3)));
    /// assert_eq(from_isoywd_opt(2014, 53, Weekday::Mon), None); // 2014 has 52 weeks
    /// ```
    pub fn from_isoywd_opt(year: i32, week: u32, weekday: Weekday) -> Option<NaiveDate> {
        let y = year as i64;
        if week < 1 || week > iso_weeks_in_year(y) {
            return None;
        }
        let jan4 = days_from_civil(y, 1, 4);
        let monday = jan4 - (jan4 + 3).rem_euclid(7);
        NaiveDate::from_days(monday + 7 * (week as i64 - 1) + weekday.num_days_from_monday() as i64)
    }

    /// Makes a new `NaiveDate` from a day count in the proleptic Gregorian
    /// calendar, with January 1, year 1 (CE) as day 1.
    ///
    /// This is the inverse of [`Datelike::num_days_from_ce`]. Returns
    /// `None` when the date is out of range.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::NaiveDate;
    ///
    /// let from_ndays_opt = NaiveDate::from_num_days_from_ce_opt;
    /// let from_ymd = |y: i32, m: u32, d: u32| NaiveDate::from_ymd_opt(y, m, d).unwrap();
    ///
    /// assert_eq(from_ndays_opt(730_000), Some(from_ymd(1999, 9, 3)));
    /// assert_eq(from_ndays_opt(1), Some(from_ymd(1, 1, 1)));
    /// assert_eq(from_ndays_opt(0), Some(from_ymd(0, 12, 31)));
    /// assert_eq(from_ndays_opt(-1), Some(from_ymd(0, 12, 30)));
    /// assert_eq(from_ndays_opt(100_000_000), None);
    /// assert_eq(from_ndays_opt(-100_000_000), None);
    /// ```
    pub fn from_num_days_from_ce_opt(days: i32) -> Option<NaiveDate> {
        NaiveDate::from_days(days as i64 - 719163)
    }

    /// Makes a new `NaiveDate` for the `n`-th given day of the week of a
    /// month (`n` from 1).
    ///
    /// For instance the second Friday of March 2017 is
    /// `NaiveDate::from_weekday_of_month_opt(2017, 3, Weekday::Fri, 2)`.
    /// Returns `None` when `n` is 0, when the month has fewer than `n` such
    /// days (the fifth Monday of a month with four), or when the year or
    /// month is invalid.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveDate, Weekday};
    ///
    /// let d = NaiveDate::from_weekday_of_month_opt(2017, 3, Weekday::Fri, 2);
    /// assert_eq(d, NaiveDate::from_ymd_opt(2017, 3, 10));
    ///
    /// // Thanksgiving in the US: the fourth Thursday of November.
    /// let d = NaiveDate::from_weekday_of_month_opt(2024, 11, Weekday::Thu, 4);
    /// assert_eq(d, NaiveDate::from_ymd_opt(2024, 11, 28));
    ///
    /// assert_eq(NaiveDate::from_weekday_of_month_opt(2024, 11, Weekday::Thu, 5), None);
    /// assert_eq(NaiveDate::from_weekday_of_month_opt(2024, 11, Weekday::Thu, 0), None);
    /// ```
    pub fn from_weekday_of_month_opt(
        year: i32,
        month: u32,
        weekday: Weekday,
        n: u8,
    ) -> Option<NaiveDate> {
        if n == 0 {
            return None;
        }
        let first = NaiveDate::from_ymd_opt(year, month, 1)?;
        let skip = weekday.days_since(first.weekday());
        let day = 1 + skip + 7 * (n as u32 - 1);
        NaiveDate::from_ymd_opt(year, month, day)
    }

    /// Makes a new [`NaiveDateTime`] from this date and the given
    /// [`NaiveTime`].
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveDate, NaiveDateTime, NaiveTime};
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 6, 3).unwrap();
    /// let t = NaiveTime::from_hms_milli_opt(12, 34, 56, 789).unwrap();
    ///
    /// let dt: NaiveDateTime = d.and_time(t);
    /// assert_eq(dt.date(), d);
    /// assert_eq(dt.time(), t);
    /// ```
    pub fn and_time(&self, time: NaiveTime) -> NaiveDateTime {
        NaiveDateTime { date: *self, time }
    }

    /// Makes a new [`NaiveDateTime`] from this date and the given hour,
    /// minute and second.
    ///
    /// No leap second can be made here: use [`Self::and_hms_milli_opt`] and
    /// the like, with a subsecond part of 1 second or more, for that.
    /// Returns `None` when the hour, minute or second is invalid.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveDate, Timelike};
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 6, 3).unwrap();
    /// let dt = d.and_hms_opt(12, 34, 56).unwrap();
    /// assert_eq(dt.to_string(), "2015-06-03 12:34:56");
    /// assert_eq(dt.hour(), 12);
    /// assert(d.and_hms_opt(12, 34, 60).is_none());
    /// assert(d.and_hms_opt(12, 60, 56).is_none());
    /// assert(d.and_hms_opt(24, 34, 56).is_none());
    /// ```
    pub fn and_hms_opt(&self, hour: u32, min: u32, sec: u32) -> Option<NaiveDateTime> {
        Some(self.and_time(NaiveTime::from_hms_opt(hour, min, sec)?))
    }

    /// Makes a new [`NaiveDateTime`] from this date and the given hour,
    /// minute, second and millisecond.
    ///
    /// The millisecond may be 1,000 or more to make a leap second, but only
    /// when the second is 59. Returns `None` when the hour, minute, second
    /// or millisecond is invalid.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveDate, Timelike};
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 6, 3).unwrap();
    /// let dt = d.and_hms_milli_opt(12, 34, 56, 789).unwrap();
    /// assert_eq(dt.nanosecond(), 789_000_000);
    /// assert(d.and_hms_milli_opt(12, 34, 59, 1_789).is_some()); // leap second
    /// assert(d.and_hms_milli_opt(12, 34, 59, 2_789).is_none());
    /// assert(d.and_hms_milli_opt(12, 34, 58, 1_789).is_none());
    /// ```
    pub fn and_hms_milli_opt(
        &self,
        hour: u32,
        min: u32,
        sec: u32,
        milli: u32,
    ) -> Option<NaiveDateTime> {
        Some(self.and_time(NaiveTime::from_hms_milli_opt(hour, min, sec, milli)?))
    }

    /// Makes a new [`NaiveDateTime`] from this date and the given hour,
    /// minute, second and microsecond.
    ///
    /// The microsecond may be 1,000,000 or more to make a leap second, but
    /// only when the second is 59. Returns `None` when the hour, minute,
    /// second or microsecond is invalid.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveDate, Timelike};
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 6, 3).unwrap();
    /// let dt = d.and_hms_micro_opt(12, 34, 56, 789_012).unwrap();
    /// assert_eq(dt.nanosecond(), 789_012_000);
    /// assert(d.and_hms_micro_opt(12, 34, 59, 1_789_012).is_some()); // leap second
    /// assert(d.and_hms_micro_opt(12, 34, 59, 2_789_012).is_none());
    /// ```
    pub fn and_hms_micro_opt(
        &self,
        hour: u32,
        min: u32,
        sec: u32,
        micro: u32,
    ) -> Option<NaiveDateTime> {
        Some(self.and_time(NaiveTime::from_hms_micro_opt(hour, min, sec, micro)?))
    }

    /// Makes a new [`NaiveDateTime`] from this date and the given hour,
    /// minute, second and nanosecond.
    ///
    /// The nanosecond may be 1,000,000,000 or more to make a leap second,
    /// but only when the second is 59. Returns `None` when the hour, minute,
    /// second or nanosecond is invalid.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveDate, Timelike};
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 6, 3).unwrap();
    /// let dt = d.and_hms_nano_opt(12, 34, 56, 789_012_345).unwrap();
    /// assert_eq(dt.nanosecond(), 789_012_345);
    /// assert_eq(dt.to_string(), "2015-06-03 12:34:56.789012345");
    /// assert(d.and_hms_nano_opt(12, 34, 59, 1_789_012_345).is_some()); // leap second
    /// assert(d.and_hms_nano_opt(12, 34, 59, 2_789_012_345).is_none());
    /// ```
    pub fn and_hms_nano_opt(
        &self,
        hour: u32,
        min: u32,
        sec: u32,
        nano: u32,
    ) -> Option<NaiveDateTime> {
        Some(self.and_time(NaiveTime::from_hms_nano_opt(hour, min, sec, nano)?))
    }

    /// Makes a new `NaiveDate` for the next calendar date.
    ///
    /// Returns `None` when `self` is the last representable date,
    /// [`NaiveDate::MAX`].
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::NaiveDate;
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 6, 3).unwrap();
    /// assert_eq(d.succ_opt(), NaiveDate::from_ymd_opt(2015, 6, 4));
    /// let eoy = NaiveDate::from_ymd_opt(2015, 12, 31).unwrap();
    /// assert_eq(eoy.succ_opt(), NaiveDate::from_ymd_opt(2016, 1, 1));
    /// assert_eq(NaiveDate::MAX.succ_opt(), None);
    /// ```
    pub fn succ_opt(&self) -> Option<NaiveDate> {
        NaiveDate::from_days(self.days as i64 + 1)
    }

    /// Makes a new `NaiveDate` for the previous calendar date.
    ///
    /// Returns `None` when `self` is the first representable date,
    /// [`NaiveDate::MIN`].
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::NaiveDate;
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 6, 3).unwrap();
    /// assert_eq(d.pred_opt(), NaiveDate::from_ymd_opt(2015, 6, 2));
    /// let leap = NaiveDate::from_ymd_opt(2016, 3, 1).unwrap();
    /// assert_eq(leap.pred_opt(), NaiveDate::from_ymd_opt(2016, 2, 29));
    /// assert_eq(NaiveDate::MIN.pred_opt(), None);
    /// ```
    pub fn pred_opt(&self) -> Option<NaiveDate> {
        NaiveDate::from_days(self.days as i64 - 1)
    }

    /// Adds the number of whole days in the given [`TimeDelta`] to the
    /// date.
    ///
    /// The rest of the span (less than a day, rounded toward zero) is
    /// ignored. Returns `None` when the result would be out of range.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveDate, TimeDelta};
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 9, 5).unwrap();
    /// assert_eq(d.checked_add_signed(TimeDelta::days(40)), NaiveDate::from_ymd_opt(2015, 10, 15));
    /// assert_eq(d.checked_add_signed(TimeDelta::days(-40)), NaiveDate::from_ymd_opt(2015, 7, 27));
    /// assert_eq(d.checked_add_signed(TimeDelta::hours(47)), NaiveDate::from_ymd_opt(2015, 9, 6));
    /// assert_eq(d.checked_add_signed(TimeDelta::hours(-23)), Some(d));
    /// assert_eq(d.checked_add_signed(TimeDelta::days(1_000_000_000)), None);
    /// assert_eq(NaiveDate::MAX.checked_add_signed(TimeDelta::days(1)), None);
    /// ```
    pub fn checked_add_signed(&self, d: TimeDelta) -> Option<NaiveDate> {
        let days = d.num_days();
        NaiveDate::from_days((self.days as i64).checked_add(days)?)
    }

    /// Subtracts the number of whole days in the given [`TimeDelta`] from
    /// the date.
    ///
    /// The rest of the span (less than a day, rounded toward zero) is
    /// ignored. Returns `None` when the result would be out of range.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveDate, TimeDelta};
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 9, 5).unwrap();
    /// assert_eq(d.checked_sub_signed(TimeDelta::days(40)), NaiveDate::from_ymd_opt(2015, 7, 27));
    /// assert_eq(d.checked_sub_signed(TimeDelta::days(-40)), NaiveDate::from_ymd_opt(2015, 10, 15));
    /// assert_eq(d.checked_sub_signed(TimeDelta::hours(23)), Some(d));
    /// assert_eq(d.checked_sub_signed(TimeDelta::days(1_000_000_000)), None);
    /// assert_eq(NaiveDate::MIN.checked_sub_signed(TimeDelta::days(1)), None);
    /// ```
    pub fn checked_sub_signed(&self, d: TimeDelta) -> Option<NaiveDate> {
        let days = d.num_days();
        NaiveDate::from_days((self.days as i64).checked_sub(days)?)
    }

    /// Adds a number of calendar [`Days`] to the date.
    ///
    /// Returns `None` when the result would be out of range.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Days, NaiveDate};
    ///
    /// let d = NaiveDate::from_ymd_opt(2022, 2, 20).unwrap();
    /// assert_eq(d.checked_add_days(Days::new(9)), NaiveDate::from_ymd_opt(2022, 3, 1));
    /// let d = NaiveDate::from_ymd_opt(2022, 7, 31).unwrap();
    /// assert_eq(d.checked_add_days(Days::new(2)), NaiveDate::from_ymd_opt(2022, 8, 2));
    /// assert_eq(d.checked_add_days(Days::new(1_000_000_000_000)), None);
    /// ```
    pub fn checked_add_days(&self, days: Days) -> Option<NaiveDate> {
        if days.0 > i32::MAX as u64 {
            return None;
        }
        NaiveDate::from_days(self.days as i64 + days.0 as i64)
    }

    /// Subtracts a number of calendar [`Days`] from the date.
    ///
    /// Returns `None` when the result would be out of range.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Days, NaiveDate};
    ///
    /// let d = NaiveDate::from_ymd_opt(2022, 2, 20).unwrap();
    /// assert_eq(d.checked_sub_days(Days::new(6)), NaiveDate::from_ymd_opt(2022, 2, 14));
    /// assert_eq(d.checked_sub_days(Days::new(51)), NaiveDate::from_ymd_opt(2021, 12, 31));
    /// assert_eq(d.checked_sub_days(Days::new(1_000_000_000_000)), None);
    /// ```
    pub fn checked_sub_days(&self, days: Days) -> Option<NaiveDate> {
        if days.0 > i32::MAX as u64 {
            return None;
        }
        NaiveDate::from_days(self.days as i64 - days.0 as i64)
    }

    /// Adds a number of calendar [`Months`] to the date.
    ///
    /// The day of the month is kept, or clamped to the last day of the
    /// resulting month when that month is shorter. Returns `None` when the
    /// result would be out of range.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Months, NaiveDate};
    ///
    /// let d = NaiveDate::from_ymd_opt(2022, 2, 20).unwrap();
    /// assert_eq(d.checked_add_months(Months::new(6)), NaiveDate::from_ymd_opt(2022, 8, 20));
    /// let d = NaiveDate::from_ymd_opt(2022, 7, 31).unwrap();
    /// assert_eq(d.checked_add_months(Months::new(2)), NaiveDate::from_ymd_opt(2022, 9, 30));
    /// let d = NaiveDate::from_ymd_opt(2024, 1, 31).unwrap();
    /// assert_eq(d.checked_add_months(Months::new(1)), NaiveDate::from_ymd_opt(2024, 2, 29));
    /// assert_eq(NaiveDate::MAX.checked_add_months(Months::new(1)), None);
    /// ```
    pub fn checked_add_months(&self, months: Months) -> Option<NaiveDate> {
        self.add_months(months.0 as i64)
    }

    /// Subtracts a number of calendar [`Months`] from the date.
    ///
    /// The day of the month is kept, or clamped to the last day of the
    /// resulting month when that month is shorter. Returns `None` when the
    /// result would be out of range.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Months, NaiveDate};
    ///
    /// let d = NaiveDate::from_ymd_opt(2022, 2, 20).unwrap();
    /// assert_eq(d.checked_sub_months(Months::new(6)), NaiveDate::from_ymd_opt(2021, 8, 20));
    /// let d = NaiveDate::from_ymd_opt(2022, 5, 31).unwrap();
    /// assert_eq(d.checked_sub_months(Months::new(3)), NaiveDate::from_ymd_opt(2022, 2, 28));
    /// let d = NaiveDate::from_ymd_opt(2014, 1, 1).unwrap();
    /// assert_eq(d.checked_sub_months(Months::new(i32::MAX as u32 + 1)), None);
    /// ```
    pub fn checked_sub_months(&self, months: Months) -> Option<NaiveDate> {
        self.add_months(-(months.0 as i64))
    }

    pub(crate) fn add_months(&self, n: i64) -> Option<NaiveDate> {
        let (y, m, d) = civil_from_days(self.days as i64);
        let total = y * 12 + (m as i64 - 1) + n;
        let ny = total.div_euclid(12);
        let nm = (total.rem_euclid(12) + 1) as u32;
        if ny < MIN_YEAR || ny > MAX_YEAR {
            return None;
        }
        let nd = crate::cmp::min(d, days_in_month(ny, nm));
        NaiveDate::from_days(days_from_civil(ny, nm, nd))
    }

    /// Subtracts another `NaiveDate` from this date: the number of days from
    /// `rhs` to `self` as a [`TimeDelta`] of whole days.
    ///
    /// It is negative when `rhs` is later, and never overflows. `self - rhs`
    /// is the same.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveDate, TimeDelta};
    ///
    /// let from_ymd = |y: i32, m: u32, d: u32| NaiveDate::from_ymd_opt(y, m, d).unwrap();
    /// let since = NaiveDate::signed_duration_since;
    ///
    /// assert_eq(since(&from_ymd(2014, 1, 1), from_ymd(2014, 1, 1)), TimeDelta::zero());
    /// assert_eq(since(&from_ymd(2014, 1, 1), from_ymd(2013, 12, 31)), TimeDelta::days(1));
    /// assert_eq(since(&from_ymd(2014, 1, 1), from_ymd(2014, 1, 2)), TimeDelta::days(-1));
    /// assert_eq(since(&from_ymd(2014, 1, 1), from_ymd(2013, 9, 23)), TimeDelta::days(100));
    /// assert_eq(since(&from_ymd(2014, 1, 1), from_ymd(2013, 1, 1)), TimeDelta::days(365));
    /// assert_eq(since(&from_ymd(2014, 1, 1), from_ymd(2010, 1, 1)), TimeDelta::days(365 * 4 + 1));
    /// assert_eq(since(&from_ymd(2014, 1, 1), from_ymd(1614, 1, 1)), TimeDelta::days(365 * 400 + 97));
    /// ```
    pub fn signed_duration_since(&self, rhs: NaiveDate) -> TimeDelta {
        TimeDelta::days(self.days as i64 - rhs.days as i64)
    }

    /// Returns the number of whole years from `base` until `self` (an age).
    ///
    /// A year is complete on the same month and day as `base`; February 29
    /// is complete on March 1 in years that are not leap years. Returns
    /// `None` when `base` is later than `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::NaiveDate;
    ///
    /// let from_ymd = |y: i32, m: u32, d: u32| NaiveDate::from_ymd_opt(y, m, d).unwrap();
    ///
    /// let birthday = from_ymd(1990, 3, 15);
    /// assert_eq(from_ymd(2015, 3, 14).years_since(birthday), Some(24));
    /// assert_eq(from_ymd(2015, 3, 15).years_since(birthday), Some(25));
    /// assert_eq(from_ymd(2015, 2, 28).years_since(from_ymd(2012, 2, 29)), Some(2));
    /// assert_eq(from_ymd(2015, 3, 1).years_since(from_ymd(2012, 2, 29)), Some(3));
    /// assert_eq(from_ymd(1989, 1, 1).years_since(birthday), None);
    /// ```
    pub fn years_since(&self, base: NaiveDate) -> Option<u32> {
        let mut years = self.year() - base.year();
        if (self.month(), self.day()) < (base.month(), base.day()) {
            years -= 1;
        }
        if years >= 0 { Some(years as u32) } else { None }
    }

    /// Returns `true` if the year of this date is a leap year (of the
    /// proleptic Gregorian calendar: divisible by 4, but not by 100 unless
    /// also by 400).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::NaiveDate;
    ///
    /// assert(NaiveDate::from_ymd_opt(2000, 1, 1).unwrap().leap_year());
    /// assert(!NaiveDate::from_ymd_opt(2001, 1, 1).unwrap().leap_year());
    /// assert(NaiveDate::from_ymd_opt(2004, 1, 1).unwrap().leap_year());
    /// assert(!NaiveDate::from_ymd_opt(2100, 1, 1).unwrap().leap_year());
    /// ```
    pub fn leap_year(&self) -> bool {
        is_leap(self.year() as i64)
    }

    /// Returns an iterator over this date and every date after it, one day
    /// apart.
    ///
    /// It ends after [`NaiveDate::MAX`].
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::NaiveDate;
    ///
    /// let from_ymd = |y: i32, m: u32, d: u32| NaiveDate::from_ymd_opt(y, m, d).unwrap();
    ///
    /// let days: Vec<NaiveDate> = from_ymd(2016, 2, 27).iter_days().take(4).collect();
    /// assert_eq(days, Vec::from([
    ///     from_ymd(2016, 2, 27),
    ///     from_ymd(2016, 2, 28),
    ///     from_ymd(2016, 2, 29),
    ///     from_ymd(2016, 3, 1),
    /// ]));
    /// ```
    pub fn iter_days(&self) -> NaiveDateDaysIterator {
        NaiveDateDaysIterator { value: Some(*self) }
    }

    /// Returns an iterator over this date and the dates after it, one week
    /// apart.
    ///
    /// It ends at the last such date before [`NaiveDate::MAX`].
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::NaiveDate;
    ///
    /// let from_ymd = |y: i32, m: u32, d: u32| NaiveDate::from_ymd_opt(y, m, d).unwrap();
    ///
    /// let weeks: Vec<NaiveDate> = from_ymd(2016, 2, 27).iter_weeks().take(4).collect();
    /// assert_eq(weeks, Vec::from([
    ///     from_ymd(2016, 2, 27),
    ///     from_ymd(2016, 3, 5),
    ///     from_ymd(2016, 3, 12),
    ///     from_ymd(2016, 3, 19),
    /// ]));
    /// ```
    pub fn iter_weeks(&self) -> NaiveDateWeeksIterator {
        NaiveDateWeeksIterator { value: Some(*self) }
    }

    /// Returns the [`NaiveWeek`] this date is in, for weeks starting on
    /// `start`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveDate, Weekday};
    ///
    /// let d = NaiveDate::from_ymd_opt(2022, 5, 18).unwrap(); // a Wednesday
    /// let week = d.week(Weekday::Mon);
    /// assert_eq(week.first_day(), NaiveDate::from_ymd_opt(2022, 5, 16).unwrap());
    /// assert_eq(week.last_day(), NaiveDate::from_ymd_opt(2022, 5, 22).unwrap());
    ///
    /// let week = d.week(Weekday::Sun);
    /// assert_eq(week.first_day(), NaiveDate::from_ymd_opt(2022, 5, 15).unwrap());
    /// ```
    pub fn week(&self, start: Weekday) -> NaiveWeek {
        NaiveWeek { date: *self, start }
    }

    /// Formats the date with the given format string.
    ///
    /// The format string takes strftime-like specifiers (`%Y`, `%m`, `%d`,
    /// `%A` and so on; see [`crate::chrono::format`] for the list). Time
    /// specifiers have nothing to format in a date.
    ///
    /// This returns a [`DelayedFormat`], which formats only when it is
    /// displayed: use `to_string()` to get a `String`, or put it in a
    /// template string.
    ///
    /// Displaying the result fails with `fmt::Error` if the format string
    /// is invalid or asks for something a date does not have (an hour):
    /// chrono's `to_string` panics then, navi's gives an empty string.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::NaiveDate;
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 9, 5).unwrap();
    /// assert_eq(d.format("%Y-%m-%d").to_string(), "2015-09-05");
    /// assert_eq(d.format("%A, %-d %B, %C%y").to_string(), "Saturday, 5 September, 2015");
    /// assert_eq(`${d.format("%d/%m/%Y")}`.to_string(), "05/09/2015");
    /// assert_eq(d.format("%j %a %b").to_string(), "248 Sat Sep");
    /// ```
    pub fn format(&self, fmt: &str) -> DelayedFormat {
        DelayedFormat::new(Some(*self), None, None, fmt)
    }

    /// Parses a string with the given format string into a `NaiveDate`.
    ///
    /// The format string takes the specifiers of [`Self::format`] (see
    /// [`crate::chrono::format`]). The whole string must match; fields the
    /// format reads beyond the date (a time, an offset) are checked but not
    /// used. Use [`Self::parse_and_remainder`] to allow trailing text.
    ///
    /// # Errors
    ///
    /// Returns a [`ParseError`] whose [`kind`](ParseError::kind) is:
    ///
    /// - `Invalid`, `TooShort` or `TooLong` when the string does not match
    ///   the format (`TooLong` when text is left after it),
    /// - `OutOfRange` when a field is out of its range (month 13),
    /// - `Impossible` when the date does not exist (February 30) or the
    ///   fields contradict each other (a weekday that is not the date's),
    /// - `NotEnough` when the fields do not determine a date,
    /// - `BadFormat` when the format string is invalid.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveDate, ParseErrorKind};
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 9, 5).unwrap();
    /// assert_eq(NaiveDate::parse_from_str("2015-09-05", "%Y-%m-%d"), Ok(d));
    /// assert_eq(NaiveDate::parse_from_str("5sep2015", "%d%b%Y"), Ok(d));
    /// assert_eq(NaiveDate::parse_from_str("Sat, 5 Sep 2015", "%a, %d %b %Y"), Ok(d));
    /// assert_eq(NaiveDate::parse_from_str("2015-248", "%Y-%j"), Ok(d));
    ///
    /// // The time and offset are ignored (but must be valid).
    /// assert_eq(
    ///     NaiveDate::parse_from_str("2014-5-17T12:34:56+09:30", "%Y-%m-%dT%H:%M:%S%z").ok(),
    ///     NaiveDate::from_ymd_opt(2014, 5, 17),
    /// );
    ///
    /// let kind = |s: &str, f: &str| NaiveDate::parse_from_str(s, f).unwrap_err().kind();
    /// assert_eq(kind("2015-13-05", "%Y-%m-%d"), ParseErrorKind::OutOfRange);
    /// assert_eq(kind("2015-02-30", "%Y-%m-%d"), ParseErrorKind::OutOfRange);
    /// assert_eq(kind("Mon, 5 Sep 2015", "%a, %d %b %Y"), ParseErrorKind::Impossible);
    /// assert_eq(kind("2015-09", "%Y-%m"), ParseErrorKind::NotEnough);
    /// assert_eq(kind("2015-09-05 extra", "%Y-%m-%d"), ParseErrorKind::TooLong);
    /// assert_eq(kind("2015/09/05", "%Y-%m-%d"), ParseErrorKind::Invalid);
    /// ```
    pub fn parse_from_str(s: &str, fmt: &str) -> ParseResult<NaiveDate> {
        let p = format::parse(s, fmt)?;
        p.to_naive_date()
    }

    /// Parses a date from the start of a string with the given format
    /// string, and returns it with the rest of the string.
    ///
    /// It is [`Self::parse_from_str`] that allows trailing text after what
    /// the format matches.
    ///
    /// # Errors
    ///
    /// As [`Self::parse_from_str`], except that trailing text is not an
    /// error.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::NaiveDate;
    ///
    /// let (d, rest) = NaiveDate::parse_and_remainder("2015-02-18 trailing text", "%Y-%m-%d").unwrap();
    /// assert_eq(d, NaiveDate::from_ymd_opt(2015, 2, 18).unwrap());
    /// assert_eq(rest, " trailing text");
    /// ```
    pub fn parse_and_remainder(s: &str, fmt: &str) -> ParseResult<(NaiveDate, &str)> {
        let (p, rest) = format::parse_and_remainder(s, fmt)?;
        Ok((p.to_naive_date()?, rest))
    }

    fn ymd(&self) -> (i64, u32, u32) {
        civil_from_days(self.days as i64)
    }
}

impl Datelike for NaiveDate {
    fn year(&self) -> i32 {
        self.ymd().0 as i32
    }

    fn month(&self) -> u32 {
        self.ymd().1
    }

    fn day(&self) -> u32 {
        self.ymd().2
    }

    fn ordinal(&self) -> u32 {
        let (y, _, _) = self.ymd();
        (self.days as i64 - days_from_civil(y, 1, 1) + 1) as u32
    }

    fn weekday(&self) -> Weekday {
        Weekday::from_monday((self.days as i64 + 3).rem_euclid(7) as u32)
    }

    fn iso_week(&self) -> IsoWeek {
        let (y, _, _) = self.ymd();
        let wd = (self.days as i64 + 3).rem_euclid(7);
        let ord = self.ordinal() as i64;
        let w = (ord - wd - 1 + 10) / 7;
        if w < 1 {
            IsoWeek {
                year: (y - 1) as i32,
                week: iso_weeks_in_year(y - 1),
            }
        } else if w > iso_weeks_in_year(y) as i64 {
            IsoWeek {
                year: (y + 1) as i32,
                week: 1,
            }
        } else {
            IsoWeek {
                year: y as i32,
                week: w as u32,
            }
        }
    }

    fn with_year(&self, year: i32) -> Option<NaiveDate> {
        let (_, m, d) = self.ymd();
        NaiveDate::from_ymd_opt(year, m, d)
    }

    fn with_month(&self, month: u32) -> Option<NaiveDate> {
        let (y, _, d) = self.ymd();
        NaiveDate::from_ymd_opt(y as i32, month, d)
    }

    fn with_day(&self, day: u32) -> Option<NaiveDate> {
        let (y, m, _) = self.ymd();
        NaiveDate::from_ymd_opt(y as i32, m, day)
    }

    fn with_ordinal(&self, ordinal: u32) -> Option<NaiveDate> {
        NaiveDate::from_yo_opt(self.year(), ordinal)
    }
}

/// "2024-01-02" (years outside 0 to 9999 with a sign).
impl Debug for NaiveDate {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        let (y, m, d) = self.ymd();
        if y >= 0 && y <= 9999 {
            f.write_fmt(`${y:04}-${m:02}-${d:02}`)
        } else {
            f.write_fmt(`${sign_year(y as i32)}-${m:02}-${d:02}`)
        }
    }
}

impl Display for NaiveDate {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        Debug::fmt(self, f)
    }
}

impl FromStr for NaiveDate {
    type Err = ParseError;
    fn from_str(s: &str) -> ParseResult<NaiveDate> {
        NaiveDate::parse_from_str(s.trim(), "%Y-%m-%d")
    }
}

impl Default for NaiveDate {
    fn default() -> NaiveDate {
        NaiveDate { days: 0 }
    }
}

impl Add<TimeDelta> for NaiveDate {
    type Output = NaiveDate;
    fn add(self, d: TimeDelta) -> NaiveDate {
        self.checked_add_signed(d)
            .expect("`NaiveDate + TimeDelta` overflowed")
    }
}

impl Sub<TimeDelta> for NaiveDate {
    type Output = NaiveDate;
    fn sub(self, d: TimeDelta) -> NaiveDate {
        self.checked_sub_signed(d)
            .expect("`NaiveDate - TimeDelta` overflowed")
    }
}

impl Sub<NaiveDate> for NaiveDate {
    type Output = TimeDelta;
    fn sub(self, rhs: NaiveDate) -> TimeDelta {
        self.signed_duration_since(rhs)
    }
}

impl Add<Days> for NaiveDate {
    type Output = NaiveDate;
    fn add(self, d: Days) -> NaiveDate {
        self.checked_add_days(d)
            .expect("`NaiveDate + Days` out of range")
    }
}

impl Sub<Days> for NaiveDate {
    type Output = NaiveDate;
    fn sub(self, d: Days) -> NaiveDate {
        self.checked_sub_days(d)
            .expect("`NaiveDate - Days` out of range")
    }
}

impl Add<Months> for NaiveDate {
    type Output = NaiveDate;
    fn add(self, m: Months) -> NaiveDate {
        self.checked_add_months(m)
            .expect("`NaiveDate + Months` out of range")
    }
}

impl Sub<Months> for NaiveDate {
    type Output = NaiveDate;
    fn sub(self, m: Months) -> NaiveDate {
        self.checked_sub_months(m)
            .expect("`NaiveDate - Months` out of range")
    }
}

/// An iterator over a date and the dates after it, one day apart.
///
/// It is returned by [`NaiveDate::iter_days`].
///
/// # Examples
///
/// ```
/// use std::chrono::NaiveDate;
///
/// let d = NaiveDate::from_ymd_opt(2015, 12, 30).unwrap();
/// let mut it = d.iter_days();
/// assert_eq(it.next(), NaiveDate::from_ymd_opt(2015, 12, 30));
/// assert_eq(it.next(), NaiveDate::from_ymd_opt(2015, 12, 31));
/// assert_eq(it.next(), NaiveDate::from_ymd_opt(2016, 1, 1));
/// ```
#[derive(Clone)]
pub struct NaiveDateDaysIterator {
    value: Option<NaiveDate>,
}

impl Iterator for NaiveDateDaysIterator {
    type Item = NaiveDate;
    fn next(&mut self) -> Option<NaiveDate> {
        let cur = self.value?;
        self.value = cur.succ_opt();
        Some(cur)
    }
}

/// An iterator over a date and the dates after it, one week apart.
///
/// It is returned by [`NaiveDate::iter_weeks`].
///
/// # Examples
///
/// ```
/// use std::chrono::NaiveDate;
///
/// let d = NaiveDate::from_ymd_opt(2015, 12, 24).unwrap();
/// let mut it = d.iter_weeks();
/// assert_eq(it.next(), NaiveDate::from_ymd_opt(2015, 12, 24));
/// assert_eq(it.next(), NaiveDate::from_ymd_opt(2015, 12, 31));
/// assert_eq(it.next(), NaiveDate::from_ymd_opt(2016, 1, 7));
/// ```
#[derive(Clone)]
pub struct NaiveDateWeeksIterator {
    value: Option<NaiveDate>,
}

impl Iterator for NaiveDateWeeksIterator {
    type Item = NaiveDate;
    fn next(&mut self) -> Option<NaiveDate> {
        let cur = self.value?;
        self.value = NaiveDate::from_days(cur.days as i64 + 7);
        Some(cur)
    }
}

/// The week a date is in, for weeks starting on a given day.
///
/// It is returned by [`NaiveDate::week`]; its days are
/// [`first_day`](NaiveWeek::first_day) to
/// [`last_day`](NaiveWeek::last_day).
///
/// # Examples
///
/// ```
/// use std::chrono::{NaiveDate, Weekday};
///
/// let d = NaiveDate::from_ymd_opt(2015, 3, 14).unwrap(); // a Saturday
/// let week = d.week(Weekday::Mon);
/// assert_eq(week.first_day(), NaiveDate::from_ymd_opt(2015, 3, 9).unwrap());
/// assert_eq(week.last_day(), NaiveDate::from_ymd_opt(2015, 3, 15).unwrap());
/// ```
#[derive(Clone, PartialEq, Eq, Debug)]
pub struct NaiveWeek {
    date: NaiveDate,
    start: Weekday,
}

impl NaiveWeek {
    /// Returns the first day of the week (the day of the week it starts
    /// on, on or before the date).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveDate, Weekday};
    ///
    /// let d = NaiveDate::from_ymd_opt(2022, 5, 18).unwrap(); // a Wednesday
    /// assert_eq(d.week(Weekday::Mon).first_day(), NaiveDate::from_ymd_opt(2022, 5, 16).unwrap());
    /// assert_eq(d.week(Weekday::Wed).first_day(), d);
    /// assert_eq(d.week(Weekday::Thu).first_day(), NaiveDate::from_ymd_opt(2022, 5, 12).unwrap());
    /// ```
    pub fn first_day(&self) -> NaiveDate {
        let back = self.date.weekday().days_since(self.start);
        NaiveDate {
            days: self.date.days - back as i32,
        }
    }

    /// Returns the last day of the week (six days after
    /// [`Self::first_day`]).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveDate, Weekday};
    ///
    /// let d = NaiveDate::from_ymd_opt(2022, 5, 18).unwrap(); // a Wednesday
    /// assert_eq(d.week(Weekday::Mon).last_day(), NaiveDate::from_ymd_opt(2022, 5, 22).unwrap());
    /// assert_eq(d.week(Weekday::Thu).last_day(), d);
    /// ```
    pub fn last_day(&self) -> NaiveDate {
        NaiveDate {
            days: self.first_day().days + 6,
        }
    }
}

// --- NaiveTime -----------------------------------------------------------------------

/// A time of day without a time zone, to the nanosecond.
///
/// A leap second is represented as a nanosecond count of 1e9 and up during
/// second 59 (`23:59:60` is `23:59:59` with 1,000,000,000 nanoseconds), as
/// in chrono.
///
/// # Examples
///
/// ```
/// use std::chrono::{NaiveTime, TimeDelta, Timelike};
///
/// let t = NaiveTime::from_hms_opt(23, 56, 4).unwrap();
/// assert_eq(t.hour(), 23);
/// assert_eq(t.num_seconds_from_midnight(), 86164);
/// assert_eq(t + TimeDelta::minutes(5), NaiveTime::from_hms_opt(0, 1, 4).unwrap());
/// assert_eq(t.format("%H:%M:%S").to_string(), "23:56:04");
/// ```
#[derive(Clone, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub struct NaiveTime {
    secs: u32,
    frac: u32,
}

impl NaiveTime {
    /// Midnight, `00:00:00`: the smallest time.
    pub const MIN: NaiveTime = NaiveTime { secs: 0, frac: 0 };

    /// Makes a time from hour, minute and second, or `None` if one is
    /// out of range (hour 24 and up, minute or second 60 and up).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveTime, Timelike};
    ///
    /// let t = NaiveTime::from_hms_opt(23, 59, 59).unwrap();
    /// assert_eq((t.hour(), t.minute(), t.second()), (23, 59, 59));
    /// assert(NaiveTime::from_hms_opt(24, 0, 0).is_none());
    /// assert(NaiveTime::from_hms_opt(12, 60, 0).is_none());
    /// ```
    pub fn from_hms_opt(hour: u32, min: u32, sec: u32) -> Option<NaiveTime> {
        NaiveTime::from_hms_nano_opt(hour, min, sec, 0)
    }

    /// Makes a time from hour, minute, second and millisecond, or `None`
    /// if one is out of range.
    ///
    /// The millisecond may be 1000 to 1999 for a leap second (only when
    /// `sec` is 59).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveTime, Timelike};
    ///
    /// let t = NaiveTime::from_hms_milli_opt(23, 56, 4, 12).unwrap();
    /// assert_eq(t.nanosecond(), 12_000_000);
    /// assert(NaiveTime::from_hms_milli_opt(23, 59, 59, 1_000).is_some()); // leap second
    /// assert(NaiveTime::from_hms_milli_opt(23, 59, 59, 2_000).is_none());
    /// ```
    pub fn from_hms_milli_opt(hour: u32, min: u32, sec: u32, milli: u32) -> Option<NaiveTime> {
        if milli >= 2000 {
            return None;
        }
        NaiveTime::from_hms_nano_opt(hour, min, sec, milli * 1_000_000)
    }

    /// Makes a time from hour, minute, second and microsecond, or `None`
    /// if one is out of range.
    ///
    /// The microsecond may be 1,000,000 to 1,999,999 for a leap second
    /// (only when `sec` is 59).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveTime, Timelike};
    ///
    /// let t = NaiveTime::from_hms_micro_opt(23, 56, 4, 12_345).unwrap();
    /// assert_eq(t.nanosecond(), 12_345_000);
    /// assert(NaiveTime::from_hms_micro_opt(23, 56, 4, 2_000_000).is_none());
    /// ```
    pub fn from_hms_micro_opt(hour: u32, min: u32, sec: u32, micro: u32) -> Option<NaiveTime> {
        if micro >= 2_000_000 {
            return None;
        }
        NaiveTime::from_hms_nano_opt(hour, min, sec, micro * 1000)
    }

    /// Makes a time from hour, minute, second and nanosecond, or `None`
    /// if one is out of range.
    ///
    /// The nanosecond may be 1,000,000,000 to 1,999,999,999 for a leap
    /// second (only when `sec` is 59).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveTime, Timelike};
    ///
    /// let t = NaiveTime::from_hms_nano_opt(23, 56, 4, 12_345_678).unwrap();
    /// assert_eq(t.nanosecond(), 12_345_678);
    /// assert(NaiveTime::from_hms_nano_opt(23, 59, 59, 1_500_000_000).is_some());
    /// assert(NaiveTime::from_hms_nano_opt(23, 59, 58, 1_500_000_000).is_none());
    /// ```
    pub fn from_hms_nano_opt(hour: u32, min: u32, sec: u32, nano: u32) -> Option<NaiveTime> {
        if hour >= 24
            || min >= 60
            || sec >= 60
            || nano >= 2_000_000_000
            || (nano >= 1_000_000_000 && sec != 59)
        {
            return None;
        }
        Some(NaiveTime {
            secs: hour * 3600 + min * 60 + sec,
            frac: nano,
        })
    }

    /// Makes a time from the number of seconds since midnight and a
    /// nanosecond, or `None` if `secs` is 86400 or more or `nano` is out of
    /// range (1e9 and up only for a leap second, in second 59).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::NaiveTime;
    ///
    /// let t = NaiveTime::from_num_seconds_from_midnight_opt(3_661, 0).unwrap();
    /// assert_eq(t, NaiveTime::from_hms_opt(1, 1, 1).unwrap());
    /// assert(NaiveTime::from_num_seconds_from_midnight_opt(86_400, 0).is_none());
    /// ```
    pub fn from_num_seconds_from_midnight_opt(secs: u32, nano: u32) -> Option<NaiveTime> {
        if secs >= 86400 || nano >= 2_000_000_000 || (nano >= 1_000_000_000 && secs % 60 != 59) {
            return None;
        }
        Some(NaiveTime { secs, frac: nano })
    }

    /// Returns `self - rhs` as a [`TimeDelta`], which is negative if
    /// `rhs` is later.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveTime, TimeDelta};
    ///
    /// let a = NaiveTime::from_hms_opt(3, 5, 7).unwrap();
    /// let b = NaiveTime::from_hms_opt(2, 4, 6).unwrap();
    /// assert_eq(a.signed_duration_since(b), TimeDelta::seconds(3661));
    /// assert_eq(b.signed_duration_since(a), TimeDelta::seconds(-3661));
    /// ```
    pub fn signed_duration_since(&self, rhs: NaiveTime) -> TimeDelta {
        let a = self.secs as i64 * 1_000_000_000 + self.frac as i64;
        let b = rhs.secs as i64 * 1_000_000_000 + rhs.frac as i64;
        TimeDelta::nanoseconds(a - b)
    }

    /// Adds `d`, wrapping around the day, and returns the time with the
    /// number of seconds (a multiple of 86400) that wrapped past midnight.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveTime, TimeDelta};
    ///
    /// let t = NaiveTime::from_hms_opt(23, 0, 0).unwrap();
    /// assert_eq(t.overflowing_add_signed(TimeDelta::hours(2)), (NaiveTime::from_hms_opt(1, 0, 0).unwrap(), 86_400));
    /// assert_eq(t.overflowing_add_signed(TimeDelta::hours(-1)), (NaiveTime::from_hms_opt(22, 0, 0).unwrap(), 0));
    /// ```
    pub fn overflowing_add_signed(&self, d: TimeDelta) -> (NaiveTime, i64) {
        let (ds, dn) = d.parts();
        let frac = if self.frac >= 1_000_000_000 {
            self.frac - 1_000_000_000
        } else {
            self.frac
        };
        let leap = if self.frac >= 1_000_000_000 { 1 } else { 0 };
        let mut nanos = frac as i64 + dn as i64;
        let mut secs = self.secs as i64 + leap + ds + nanos.div_euclid(1_000_000_000);
        nanos = nanos.rem_euclid(1_000_000_000);
        let day = secs.div_euclid(86400);
        secs = secs.rem_euclid(86400);
        (
            NaiveTime {
                secs: secs as u32,
                frac: nanos as u32,
            },
            day * 86400,
        )
    }

    /// Subtracts `d`, wrapping around the day, and returns the time with
    /// the number of seconds (a multiple of 86400) that wrapped back past
    /// midnight.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveTime, TimeDelta};
    ///
    /// let t = NaiveTime::from_hms_opt(1, 0, 0).unwrap();
    /// assert_eq(t.overflowing_sub_signed(TimeDelta::hours(2)), (NaiveTime::from_hms_opt(23, 0, 0).unwrap(), 86_400));
    /// ```
    pub fn overflowing_sub_signed(&self, d: TimeDelta) -> (NaiveTime, i64) {
        let (t, s) = self.overflowing_add_signed(-d);
        (t, -s)
    }

    /// Formats the time with a strftime-like format string (see
    /// [`crate::chrono::format`]).
    ///
    /// The result displays the formatted text. An invalid format string, or
    /// a specifier for a field the value lacks, makes displaying it fail
    /// with `fmt::Error` (chrono's `to_string` panics then; navi's gives an
    /// empty string).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::NaiveTime;
    ///
    /// let t = NaiveTime::from_hms_milli_opt(23, 56, 4, 12).unwrap();
    /// assert_eq(t.format("%H:%M:%S").to_string(), "23:56:04");
    /// assert_eq(t.format("%H:%M:%S%.3f").to_string(), "23:56:04.012");
    /// assert_eq(t.format("%-I:%M %p").to_string(), "11:56 PM");
    /// ```
    pub fn format(&self, fmt: &str) -> DelayedFormat {
        DelayedFormat::new(None, Some(*self), None, fmt)
    }

    /// Parses a time from `s` with a strftime-like format string.
    ///
    /// # Errors
    ///
    /// A [`ParseError`] if `s` does not match `fmt` or does not give a
    /// valid time.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::NaiveTime;
    ///
    /// assert_eq(NaiveTime::parse_from_str("23:56:04", "%H:%M:%S"), Ok(NaiveTime::from_hms_opt(23, 56, 4).unwrap()));
    /// assert_eq(NaiveTime::parse_from_str("pm012345.6789", "%p%I%M%S%.f"),
    ///     Ok(NaiveTime::from_hms_micro_opt(13, 23, 45, 678_900).unwrap()));
    /// assert(NaiveTime::parse_from_str("25:00:00", "%H:%M:%S").is_err());
    /// ```
    pub fn parse_from_str(s: &str, fmt: &str) -> ParseResult<NaiveTime> {
        let p = format::parse(s, fmt)?;
        p.to_naive_time()
    }

    pub(crate) fn secs(&self) -> u32 {
        self.secs
    }

    pub(crate) fn frac(&self) -> u32 {
        self.frac
    }
}

impl Timelike for NaiveTime {
    fn hour(&self) -> u32 {
        self.secs / 3600
    }

    fn minute(&self) -> u32 {
        self.secs / 60 % 60
    }

    fn second(&self) -> u32 {
        self.secs % 60
    }

    fn nanosecond(&self) -> u32 {
        self.frac
    }

    fn with_hour(&self, hour: u32) -> Option<NaiveTime> {
        if hour >= 24 {
            return None;
        }
        Some(NaiveTime {
            secs: hour * 3600 + self.secs % 3600,
            frac: self.frac,
        })
    }

    fn with_minute(&self, min: u32) -> Option<NaiveTime> {
        if min >= 60 {
            return None;
        }
        Some(NaiveTime {
            secs: self.secs / 3600 * 3600 + min * 60 + self.secs % 60,
            frac: self.frac,
        })
    }

    fn with_second(&self, sec: u32) -> Option<NaiveTime> {
        if sec >= 60 {
            return None;
        }
        Some(NaiveTime {
            secs: self.secs / 60 * 60 + sec,
            frac: self.frac,
        })
    }

    fn with_nanosecond(&self, nano: u32) -> Option<NaiveTime> {
        if nano >= 2_000_000_000 || (nano >= 1_000_000_000 && self.secs % 60 != 59) {
            return None;
        }
        Some(NaiveTime {
            secs: self.secs,
            frac: nano,
        })
    }

    fn num_seconds_from_midnight(&self) -> u32 {
        self.secs
    }
}

/// "03:04:05", with .fff, .ffffff or .fffffffff as needed.
impl Debug for NaiveTime {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        let (sec, nano) = if self.frac >= 1_000_000_000 {
            (self.secs % 60 + 1, self.frac - 1_000_000_000)
        } else {
            (self.secs % 60, self.frac)
        };
        f.write_fmt(`${self.secs / 3600:02}:${self.secs / 60 % 60:02}:${sec:02}`)?;
        f.write_str(format::frac_auto(nano).as_str())
    }
}

impl Display for NaiveTime {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        Debug::fmt(self, f)
    }
}

impl FromStr for NaiveTime {
    type Err = ParseError;
    fn from_str(s: &str) -> ParseResult<NaiveTime> {
        NaiveTime::parse_from_str(s.trim(), "%H:%M:%S%.f")
    }
}

impl Default for NaiveTime {
    fn default() -> NaiveTime {
        NaiveTime::MIN
    }
}

impl Add<TimeDelta> for NaiveTime {
    type Output = NaiveTime;
    fn add(self, d: TimeDelta) -> NaiveTime {
        self.overflowing_add_signed(d).0
    }
}

impl Sub<TimeDelta> for NaiveTime {
    type Output = NaiveTime;
    fn sub(self, d: TimeDelta) -> NaiveTime {
        self.overflowing_sub_signed(d).0
    }
}

impl Sub<NaiveTime> for NaiveTime {
    type Output = TimeDelta;
    fn sub(self, rhs: NaiveTime) -> TimeDelta {
        self.signed_duration_since(rhs)
    }
}

// --- NaiveDateTime -------------------------------------------------------------------

/// A date and time without a time zone: a [`NaiveDate`] and a
/// [`NaiveTime`].
///
/// # Examples
///
/// ```
/// use std::chrono::{Datelike, NaiveDate, NaiveDateTime, TimeDelta, Timelike};
///
/// let dt: NaiveDateTime = NaiveDate::from_ymd_opt(2016, 7, 8).unwrap().and_hms_opt(9, 10, 11).unwrap();
/// assert_eq((dt.year(), dt.month(), dt.hour()), (2016, 7, 9));
/// assert_eq(dt + TimeDelta::days(1), NaiveDate::from_ymd_opt(2016, 7, 9).unwrap().and_hms_opt(9, 10, 11).unwrap());
/// assert_eq(dt.to_string(), "2016-07-08 09:10:11");
/// ```
#[derive(Clone, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub struct NaiveDateTime {
    date: NaiveDate,
    time: NaiveTime,
}

impl NaiveDateTime {
    /// The smallest date and time: [`NaiveDate::MIN`] at midnight.
    pub const MIN: NaiveDateTime = NaiveDateTime {
        date: NaiveDate::MIN,
        time: NaiveTime { secs: 0, frac: 0 },
    };
    /// The largest date and time: [`NaiveDate::MAX`] at
    /// `23:59:59.999999999`.
    pub const MAX: NaiveDateTime = NaiveDateTime {
        date: NaiveDate::MAX,
        time: NaiveTime {
            secs: 86399,
            frac: 999_999_999,
        },
    };
    /// The Unix epoch, `1970-01-01 00:00:00`.
    pub const UNIX_EPOCH: NaiveDateTime = NaiveDateTime {
        date: NaiveDate { days: 0 },
        time: NaiveTime { secs: 0, frac: 0 },
    };

    /// Makes a date and time from a date and a time.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveDate, NaiveDateTime, NaiveTime};
    ///
    /// let d = NaiveDate::from_ymd_opt(2015, 6, 3).unwrap();
    /// let t = NaiveTime::from_hms_opt(12, 34, 56).unwrap();
    /// let dt = NaiveDateTime::new(d, t);
    /// assert_eq(dt.date(), d);
    /// assert_eq(dt.time(), t);
    /// ```
    pub fn new(date: NaiveDate, time: NaiveTime) -> NaiveDateTime {
        NaiveDateTime { date, time }
    }

    /// Returns the date part.
    pub fn date(&self) -> NaiveDate {
        self.date
    }

    /// Returns the time part.
    pub fn time(&self) -> NaiveTime {
        self.time
    }

    /// Seconds since 1970-01-01 00:00:00 (as UTC).
    pub(crate) fn unix_secs(&self) -> i64 {
        self.date.days as i64 * 86400 + self.time.secs as i64
    }

    pub(crate) fn from_unix(secs: i64, nanos: u32) -> Option<NaiveDateTime> {
        let date = NaiveDate::from_days(secs.div_euclid(86400))?;
        let time =
            NaiveTime::from_num_seconds_from_midnight_opt(secs.rem_euclid(86400) as u32, nanos)?;
        Some(NaiveDateTime { date, time })
    }

    /// Adds `d`, or returns `None` if the result is out of range.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveDate, TimeDelta};
    ///
    /// let d = NaiveDate::from_ymd_opt(2016, 7, 8).unwrap();
    /// let dt = d.and_hms_opt(23, 0, 0).unwrap();
    /// assert_eq(dt.checked_add_signed(TimeDelta::hours(2)), d.succ_opt().unwrap().and_hms_opt(1, 0, 0));
    /// assert(dt.checked_add_signed(TimeDelta::days(1_000_000_000)).is_none());
    /// ```
    pub fn checked_add_signed(&self, d: TimeDelta) -> Option<NaiveDateTime> {
        let (t, days_secs) = self.time.overflowing_add_signed(d);
        let date = NaiveDate::from_days((self.date.days as i64).checked_add(days_secs / 86400)?)?;
        Some(NaiveDateTime { date, time: t })
    }

    /// Subtracts `d`, or returns `None` if the result is out of range.
    pub fn checked_sub_signed(&self, d: TimeDelta) -> Option<NaiveDateTime> {
        self.checked_add_signed(-d)
    }

    /// Adds a number of days, keeping the time, or returns `None` if the
    /// result is out of range.
    pub fn checked_add_days(&self, days: Days) -> Option<NaiveDateTime> {
        Some(NaiveDateTime {
            date: self.date.checked_add_days(days)?,
            time: self.time,
        })
    }

    /// Subtracts a number of days, keeping the time, or returns `None` if
    /// the result is out of range.
    pub fn checked_sub_days(&self, days: Days) -> Option<NaiveDateTime> {
        Some(NaiveDateTime {
            date: self.date.checked_sub_days(days)?,
            time: self.time,
        })
    }

    /// Adds a number of months, keeping the time, or returns `None` if the
    /// result is out of range.
    ///
    /// The day is clamped to the last day of the resulting month.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Months, NaiveDate};
    ///
    /// let dt = NaiveDate::from_ymd_opt(2014, 1, 31).unwrap().and_hms_opt(1, 0, 0).unwrap();
    /// assert_eq(dt.checked_add_months(Months::new(1)), NaiveDate::from_ymd_opt(2014, 2, 28).unwrap().and_hms_opt(1, 0, 0));
    /// ```
    pub fn checked_add_months(&self, m: Months) -> Option<NaiveDateTime> {
        Some(NaiveDateTime {
            date: self.date.checked_add_months(m)?,
            time: self.time,
        })
    }

    /// Subtracts a number of months, keeping the time, or returns `None`
    /// if the result is out of range.
    ///
    /// The day is clamped to the last day of the resulting month.
    pub fn checked_sub_months(&self, m: Months) -> Option<NaiveDateTime> {
        Some(NaiveDateTime {
            date: self.date.checked_sub_months(m)?,
            time: self.time,
        })
    }

    /// Returns `self - rhs` as a [`TimeDelta`], which is negative if
    /// `rhs` is later.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveDate, TimeDelta};
    ///
    /// let a = NaiveDate::from_ymd_opt(2016, 7, 8).unwrap().and_hms_opt(0, 0, 0).unwrap();
    /// let b = NaiveDate::from_ymd_opt(2016, 7, 7).unwrap().and_hms_opt(23, 0, 0).unwrap();
    /// assert_eq(a.signed_duration_since(b), TimeDelta::hours(1));
    /// ```
    pub fn signed_duration_since(&self, rhs: NaiveDateTime) -> TimeDelta {
        let days = TimeDelta::days(self.date.days as i64 - rhs.date.days as i64);
        days + self.time.signed_duration_since(rhs.time)
    }

    /// Returns this date and time read as UTC, as a
    /// [`DateTime<Utc>`](crate::chrono::DateTime).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::NaiveDate;
    ///
    /// let dt = NaiveDate::from_ymd_opt(2023, 1, 30).unwrap().and_hms_opt(19, 32, 33).unwrap();
    /// assert_eq(dt.and_utc().timestamp(), 1675107153);
    /// ```
    pub fn and_utc(&self) -> crate::chrono::DateTime<crate::chrono::Utc> {
        crate::chrono::DateTime::from_naive_utc_and_offset(*self, crate::chrono::Utc)
    }

    /// Returns this date and time read as local time in the time zone
    /// `tz`: a [`LocalResult`](crate::chrono::LocalResult) that may be
    /// ambiguous or not exist (around daylight saving time changes).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{FixedOffset, NaiveDate};
    ///
    /// let tz = FixedOffset::east_opt(5 * 3600).unwrap();
    /// let dt = NaiveDate::from_ymd_opt(2015, 9, 5).unwrap().and_hms_opt(23, 56, 4).unwrap();
    /// let local = dt.and_local_timezone(tz).unwrap();
    /// assert_eq(local.to_rfc3339(), "2015-09-05T23:56:04+05:00");
    /// ```
    pub fn and_local_timezone<Tz: crate::chrono::TimeZone>(
        &self,
        tz: Tz,
    ) -> crate::chrono::LocalResult<crate::chrono::DateTime<Tz>> {
        tz.from_local_datetime(self)
    }

    /// Formats the date and time with a strftime-like format string (see
    /// [`crate::chrono::format`]).
    ///
    /// The result displays the formatted text. An invalid format string, or
    /// a specifier for a field the value lacks, makes displaying it fail
    /// with `fmt::Error` (chrono's `to_string` panics then; navi's gives an
    /// empty string).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::NaiveDate;
    ///
    /// let dt = NaiveDate::from_ymd_opt(2015, 9, 5).unwrap().and_hms_opt(23, 56, 4).unwrap();
    /// assert_eq(dt.format("%Y-%m-%d %H:%M:%S").to_string(), "2015-09-05 23:56:04");
    /// assert_eq(dt.format("around %l %p on %b %-d").to_string(), "around 11 PM on Sep 5");
    /// ```
    pub fn format(&self, fmt: &str) -> DelayedFormat {
        DelayedFormat::new(Some(self.date), Some(self.time), None, fmt)
    }

    /// Parses a date and time from `s` with a strftime-like format string.
    ///
    /// # Errors
    ///
    /// A [`ParseError`] if `s` does not match `fmt`, has text left over, or
    /// does not give a valid date and time.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveDate, NaiveDateTime};
    ///
    /// let dt = NaiveDateTime::parse_from_str("2015-09-05 23:56:04", "%Y-%m-%d %H:%M:%S").unwrap();
    /// assert_eq(dt, NaiveDate::from_ymd_opt(2015, 9, 5).unwrap().and_hms_opt(23, 56, 4).unwrap());
    /// assert(NaiveDateTime::parse_from_str("2015-09-05", "%Y-%m-%d").is_err()); // no time
    /// ```
    pub fn parse_from_str(s: &str, fmt: &str) -> ParseResult<NaiveDateTime> {
        let p = format::parse(s, fmt)?;
        p.to_naive_datetime_with_offset(0)
    }

    /// Parses a date and time from the start of `s` with a strftime-like
    /// format string, returning it with the rest of `s`.
    ///
    /// # Errors
    ///
    /// A [`ParseError`] if the start of `s` does not match `fmt` or does
    /// not give a valid date and time.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{NaiveDate, NaiveDateTime};
    ///
    /// let (dt, rest) = NaiveDateTime::parse_and_remainder("2015-02-18 23:16:09 trailing text", "%Y-%m-%d %H:%M:%S").unwrap();
    /// assert_eq(dt, NaiveDate::from_ymd_opt(2015, 2, 18).unwrap().and_hms_opt(23, 16, 9).unwrap());
    /// assert_eq(rest, " trailing text");
    /// ```
    pub fn parse_and_remainder(s: &str, fmt: &str) -> ParseResult<(NaiveDateTime, &str)> {
        let (p, rest) = format::parse_and_remainder(s, fmt)?;
        Ok((p.to_naive_datetime_with_offset(0)?, rest))
    }
}

impl Datelike for NaiveDateTime {
    fn year(&self) -> i32 {
        self.date.year()
    }

    fn month(&self) -> u32 {
        self.date.month()
    }

    fn day(&self) -> u32 {
        self.date.day()
    }

    fn ordinal(&self) -> u32 {
        self.date.ordinal()
    }

    fn weekday(&self) -> Weekday {
        self.date.weekday()
    }

    fn iso_week(&self) -> IsoWeek {
        self.date.iso_week()
    }

    fn with_year(&self, year: i32) -> Option<NaiveDateTime> {
        Some(NaiveDateTime {
            date: self.date.with_year(year)?,
            time: self.time,
        })
    }

    fn with_month(&self, month: u32) -> Option<NaiveDateTime> {
        Some(NaiveDateTime {
            date: self.date.with_month(month)?,
            time: self.time,
        })
    }

    fn with_day(&self, day: u32) -> Option<NaiveDateTime> {
        Some(NaiveDateTime {
            date: self.date.with_day(day)?,
            time: self.time,
        })
    }

    fn with_ordinal(&self, ordinal: u32) -> Option<NaiveDateTime> {
        Some(NaiveDateTime {
            date: self.date.with_ordinal(ordinal)?,
            time: self.time,
        })
    }
}

impl Timelike for NaiveDateTime {
    fn hour(&self) -> u32 {
        self.time.hour()
    }

    fn minute(&self) -> u32 {
        self.time.minute()
    }

    fn second(&self) -> u32 {
        self.time.second()
    }

    fn nanosecond(&self) -> u32 {
        self.time.nanosecond()
    }

    fn with_hour(&self, hour: u32) -> Option<NaiveDateTime> {
        Some(NaiveDateTime {
            date: self.date,
            time: self.time.with_hour(hour)?,
        })
    }

    fn with_minute(&self, min: u32) -> Option<NaiveDateTime> {
        Some(NaiveDateTime {
            date: self.date,
            time: self.time.with_minute(min)?,
        })
    }

    fn with_second(&self, sec: u32) -> Option<NaiveDateTime> {
        Some(NaiveDateTime {
            date: self.date,
            time: self.time.with_second(sec)?,
        })
    }

    fn with_nanosecond(&self, nano: u32) -> Option<NaiveDateTime> {
        Some(NaiveDateTime {
            date: self.date,
            time: self.time.with_nanosecond(nano)?,
        })
    }
}

/// "2024-01-02T03:04:05".
impl Debug for NaiveDateTime {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        Debug::fmt(&self.date, f)?;
        f.write_str("T")?;
        Debug::fmt(&self.time, f)
    }
}

/// "2024-01-02 03:04:05".
impl Display for NaiveDateTime {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        Display::fmt(&self.date, f)?;
        f.write_str(" ")?;
        Display::fmt(&self.time, f)
    }
}

impl FromStr for NaiveDateTime {
    type Err = ParseError;
    fn from_str(s: &str) -> ParseResult<NaiveDateTime> {
        NaiveDateTime::parse_from_str(s.trim(), "%Y-%m-%dT%H:%M:%S%.f")
    }
}

impl Default for NaiveDateTime {
    fn default() -> NaiveDateTime {
        NaiveDateTime::UNIX_EPOCH
    }
}

impl Add<TimeDelta> for NaiveDateTime {
    type Output = NaiveDateTime;
    fn add(self, d: TimeDelta) -> NaiveDateTime {
        self.checked_add_signed(d)
            .expect("`NaiveDateTime + TimeDelta` overflowed")
    }
}

impl Sub<TimeDelta> for NaiveDateTime {
    type Output = NaiveDateTime;
    fn sub(self, d: TimeDelta) -> NaiveDateTime {
        self.checked_sub_signed(d)
            .expect("`NaiveDateTime - TimeDelta` overflowed")
    }
}

impl Sub<NaiveDateTime> for NaiveDateTime {
    type Output = TimeDelta;
    fn sub(self, rhs: NaiveDateTime) -> TimeDelta {
        self.signed_duration_since(rhs)
    }
}

impl Add<Days> for NaiveDateTime {
    type Output = NaiveDateTime;
    fn add(self, d: Days) -> NaiveDateTime {
        self.checked_add_days(d)
            .expect("`NaiveDateTime + Days` out of range")
    }
}

impl Add<Months> for NaiveDateTime {
    type Output = NaiveDateTime;
    fn add(self, m: Months) -> NaiveDateTime {
        self.checked_add_months(m)
            .expect("`NaiveDateTime + Months` out of range")
    }
}

impl Sub<Months> for NaiveDateTime {
    type Output = NaiveDateTime;
    fn sub(self, m: Months) -> NaiveDateTime {
        self.checked_sub_months(m)
            .expect("`NaiveDateTime - Months` out of range")
    }
}
