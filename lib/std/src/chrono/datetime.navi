//! `DateTime<Tz>`: an instant with the time zone it is shown in.

use crate::chrono::format::{self, DelayedFormat, ParseError, ParseResult};
use crate::chrono::offset::{FixedOffset, Local, LocalResult, Offset, TimeZone, Utc};
use crate::chrono::{
    Datelike, Days, IsoWeek, Months, NaiveDate, NaiveDateTime, NaiveTime, TimeDelta, Timelike,
    Weekday,
};
use crate::cmp::Ordering;
use crate::fmt::{self, Debug, Display, Formatter};
use crate::hash::{Hash, Hasher};
use crate::ops::{Add, Sub};
use crate::str::FromStr;

/// An instant (a UTC date and time) with a time zone's offset at it.
///
/// Comparisons and hashes use the instant only: the same instant in two
/// zones is equal. Arithmetic with [`TimeDelta`] works on the instant;
/// with [`Days`] and [`Months`] on the local date.
///
/// # Examples
///
/// ```
/// use std::chrono::{DateTime, FixedOffset, TimeDelta, TimeZone, Timelike, Utc};
///
/// let t: DateTime<Utc> = Utc.with_ymd_and_hms(2001, 9, 9, 1, 46, 40).unwrap();
/// assert_eq(t.timestamp(), 1_000_000_000);
/// assert_eq(t.to_string(), "2001-09-09 01:46:40 UTC");
///
/// let east = FixedOffset::east_opt(2 * 3600).unwrap();
/// let local = t.with_timezone(&east);
/// assert_eq(local.hour(), 3);
/// assert_eq(local, t);
/// assert_eq((t + TimeDelta::minutes(30)).minute(), 16);
/// ```
#[derive(Clone)]
pub struct DateTime<Tz: TimeZone> {
    utc: NaiveDateTime,
    offset: Tz::Offset,
}

/// How many digits of fractional seconds [`DateTime::to_rfc3339_opts`]
/// writes.
#[derive(Clone, PartialEq, Eq, Debug, Hash)]
pub enum SecondsFormat {
    /// Whole seconds, no fraction.
    Secs,
    /// Three digits (milliseconds).
    Millis,
    /// Six digits (microseconds).
    Micros,
    /// Nine digits (nanoseconds).
    Nanos,
    /// As many digits (0, 3, 6 or 9) as needed.
    AutoSi,
}

/// The Unix epoch, 1970-01-01 00:00:00 UTC.
pub const UNIX_EPOCH: DateTime<Utc> = DateTime {
    utc: NaiveDateTime::UNIX_EPOCH,
    offset: Utc,
};

impl<Tz: TimeZone> DateTime<Tz> {
    /// Makes the instant `utc` (a UTC date and time) with `offset`, which
    /// should be the zone's offset at that instant.
    pub fn from_naive_utc_and_offset(utc: NaiveDateTime, offset: Tz::Offset) -> DateTime<Tz> {
        DateTime { utc, offset }
    }

    fn local(&self) -> NaiveDateTime {
        // Out of range only at the very ends of the range.
        match self.utc.checked_add_signed(TimeDelta::seconds(
            self.offset.fix().local_minus_utc() as i64
        )) {
            Some(l) => l,
            None => self.utc,
        }
    }

    /// Returns the local date (in the date and time's zone).
    pub fn date_naive(&self) -> NaiveDate {
        self.local().date()
    }

    /// Returns the local time of day.
    pub fn time(&self) -> NaiveTime {
        self.local().time()
    }

    /// Returns the number of seconds since 1970-01-01 00:00:00 UTC
    /// (negative before).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{TimeZone, Utc};
    ///
    /// let t = Utc.timestamp_millis_opt(1_700_000_000_123).unwrap();
    /// assert_eq(t.timestamp(), 1_700_000_000);
    /// assert_eq(t.timestamp_millis(), 1_700_000_000_123);
    /// assert_eq(t.timestamp_micros(), 1_700_000_000_123_000);
    /// assert_eq(t.timestamp_subsec_millis(), 123);
    /// assert_eq(t.timestamp_subsec_nanos(), 123_000_000);
    /// ```
    pub fn timestamp(&self) -> i64 {
        self.utc.unix_secs()
    }

    /// Returns the number of milliseconds since the Unix epoch.
    pub fn timestamp_millis(&self) -> i64 {
        self.utc.unix_secs() * 1000 + (self.utc.time().frac() % 1_000_000_000 / 1_000_000) as i64
    }

    /// Returns the number of microseconds since the Unix epoch.
    pub fn timestamp_micros(&self) -> i64 {
        self.utc.unix_secs() * 1_000_000 + (self.utc.time().frac() % 1_000_000_000 / 1000) as i64
    }

    /// Returns the number of nanoseconds since the Unix epoch, or `None`
    /// if it does not fit an `i64` (outside 1677 to 2262).
    pub fn timestamp_nanos_opt(&self) -> Option<i64> {
        let s = self.utc.unix_secs().checked_mul(1_000_000_000)?;
        s.checked_add((self.utc.time().frac() % 1_000_000_000) as i64)
    }

    /// Returns the milliseconds past the last whole second.
    pub fn timestamp_subsec_millis(&self) -> u32 {
        self.utc.time().frac() / 1_000_000
    }

    /// Returns the microseconds past the last whole second.
    pub fn timestamp_subsec_micros(&self) -> u32 {
        self.utc.time().frac() / 1000
    }

    /// Returns the nanoseconds past the last whole second (1e9 and up
    /// during a leap second).
    pub fn timestamp_subsec_nanos(&self) -> u32 {
        self.utc.time().frac()
    }

    /// Returns the zone's offset at this instant.
    pub fn offset(&self) -> &Tz::Offset {
        &self.offset
    }

    /// Returns the time zone.
    pub fn timezone(&self) -> Tz {
        Tz::from_offset(&self.offset)
    }

    /// Returns the same instant in the zone `tz`.
    pub fn with_timezone<Tz2: TimeZone>(&self, tz: &Tz2) -> DateTime<Tz2> {
        tz.from_utc_datetime(&self.utc)
    }

    /// Returns the same instant with its offset as a [`FixedOffset`].
    pub fn fixed_offset(&self) -> DateTime<FixedOffset> {
        DateTime {
            utc: self.utc,
            offset: self.offset.fix(),
        }
    }

    /// Returns the same instant in UTC.
    pub fn to_utc(&self) -> DateTime<Utc> {
        DateTime {
            utc: self.utc,
            offset: Utc,
        }
    }

    /// Returns the date and time in UTC, without a zone.
    pub fn naive_utc(&self) -> NaiveDateTime {
        self.utc
    }

    /// Returns the local date and time, without a zone.
    pub fn naive_local(&self) -> NaiveDateTime {
        self.local()
    }

    /// Adds `d` to the instant, or returns `None` if the result is out of
    /// range.
    pub fn checked_add_signed(&self, d: TimeDelta) -> Option<DateTime<Tz>> {
        let utc = self.utc.checked_add_signed(d)?;
        Some(self.timezone().from_utc_datetime(&utc))
    }

    /// Subtracts `d` from the instant, or returns `None` if the result is
    /// out of range.
    pub fn checked_sub_signed(&self, d: TimeDelta) -> Option<DateTime<Tz>> {
        self.checked_add_signed(-d)
    }

    /// Returns the same local time some months later (the day clamped to
    /// the month's last), or `None` if it is out of range or does not
    /// exist in the zone.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{Months, TimeZone, Utc};
    ///
    /// let t = Utc.with_ymd_and_hms(2024, 1, 31, 12, 0, 0).unwrap();
    /// assert_eq(t.checked_add_months(Months::new(1)), Utc.with_ymd_and_hms(2024, 2, 29, 12, 0, 0).single());
    /// ```
    pub fn checked_add_months(&self, m: Months) -> Option<DateTime<Tz>> {
        self.map_local(self.local().checked_add_months(m)?)
    }

    /// Returns the same local time some months earlier (the day clamped to
    /// the month's last), or `None` if it is out of range or does not
    /// exist in the zone.
    pub fn checked_sub_months(&self, m: Months) -> Option<DateTime<Tz>> {
        self.map_local(self.local().checked_sub_months(m)?)
    }

    /// Returns the same local time some days later, or `None` if it is out
    /// of range or does not exist in the zone.
    pub fn checked_add_days(&self, d: Days) -> Option<DateTime<Tz>> {
        self.map_local(self.local().checked_add_days(d)?)
    }

    /// Returns the same local time some days earlier, or `None` if it is
    /// out of range or does not exist in the zone.
    pub fn checked_sub_days(&self, d: Days) -> Option<DateTime<Tz>> {
        self.map_local(self.local().checked_sub_days(d)?)
    }

    fn map_local(&self, l: NaiveDateTime) -> Option<DateTime<Tz>> {
        self.timezone().from_local_datetime(&l).single()
    }

    /// Returns `self - rhs` as a [`TimeDelta`] (negative if `rhs` is
    /// later); the zones do not matter.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{TimeDelta, TimeZone, Utc};
    ///
    /// let a = Utc.with_ymd_and_hms(2024, 1, 2, 0, 0, 0).unwrap();
    /// let b = Utc.with_ymd_and_hms(2024, 1, 1, 12, 0, 0).unwrap();
    /// assert_eq(a.signed_duration_since(&b), TimeDelta::hours(12));
    /// ```
    pub fn signed_duration_since<Tz2: TimeZone>(&self, rhs: &DateTime<Tz2>) -> TimeDelta {
        self.utc.signed_duration_since(rhs.utc)
    }

    /// Returns the whole years from `base` to `self` (comparing local
    /// dates and times), or `None` if `base` is later.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{TimeZone, Utc};
    ///
    /// let born = Utc.with_ymd_and_hms(1990, 6, 15, 0, 0, 0).unwrap();
    /// let now = Utc.with_ymd_and_hms(2024, 6, 14, 0, 0, 0).unwrap();
    /// assert_eq(now.years_since(born), Some(33));
    /// ```
    pub fn years_since(&self, base: DateTime<Tz>) -> Option<u32> {
        let a = self.local();
        let b = base.local();
        let mut years = a.year() - b.year();
        let ka = (a.month(), a.day(), a.time());
        let kb = (b.month(), b.day(), b.time());
        if ka < kb {
            years -= 1;
        }
        if years >= 0 { Some(years as u32) } else { None }
    }

    /// Returns the date and time in the RFC 2822 format, such as
    /// `"Tue, 1 Jul 2003 10:52:37 +0200"`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{TimeZone, Utc};
    ///
    /// let t = Utc.with_ymd_and_hms(2024, 5, 6, 7, 8, 9).unwrap();
    /// assert_eq(t.to_rfc2822(), "Mon, 6 May 2024 07:08:09 +0000");
    /// ```
    pub fn to_rfc2822(&self) -> String {
        let l = self.local();
        let off = format::offset_string(self.offset.fix().local_minus_utc(), false, false);
        `${l.weekday()}, ${l.day()} ${&crate::chrono::naive::MONTH_NAMES[l.month() as usize - 1][0..3]} ${l.year():04} ${l.hour():02}:${l.minute():02}:${l.second():02} ${off}`.to_string()
    }

    /// Returns the date and time in the RFC 3339 (ISO 8601) format, such
    /// as `"2018-01-26T18:30:09.453+00:00"`, with as many fraction digits
    /// as needed (0, 3, 6 or 9).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{FixedOffset, TimeZone};
    ///
    /// let tz = FixedOffset::east_opt(5 * 3600 + 1800).unwrap();
    /// let t = tz.with_ymd_and_hms(2024, 5, 6, 7, 8, 9).unwrap();
    /// assert_eq(t.to_rfc3339(), "2024-05-06T07:08:09+05:30");
    /// ```
    pub fn to_rfc3339(&self) -> String {
        self.to_rfc3339_opts(SecondsFormat::AutoSi, false)
    }

    /// Returns the date and time in the RFC 3339 format with the fraction
    /// digits `secform` says, and `Z` for a zero offset if `use_z`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{SecondsFormat, TimeZone, Utc};
    ///
    /// let t = Utc.timestamp_millis_opt(1_700_000_000_123).unwrap();
    /// assert_eq(t.to_rfc3339_opts(SecondsFormat::Millis, true), "2023-11-14T22:13:20.123Z");
    /// assert_eq(t.to_rfc3339_opts(SecondsFormat::Secs, false), "2023-11-14T22:13:20+00:00");
    /// ```
    pub fn to_rfc3339_opts(&self, secform: SecondsFormat, use_z: bool) -> String {
        let l = self.local();
        let mut s = String::new();
        let y = l.year();
        if y >= 0 && y <= 9999 {
            s.push_str(`${y:04}`.to_string().as_str());
        } else {
            s.push_str(`${y}`.to_string().as_str());
        }
        let nano = l.nanosecond() % 1_000_000_000;
        let sec = if l.nanosecond() >= 1_000_000_000 {
            60
        } else {
            l.second()
        };
        s.push_str(
            `-${l.month():02}-${l.day():02}T${l.hour():02}:${l.minute():02}:${sec:02}`
                .to_string()
                .as_str(),
        );
        match secform {
            SecondsFormat::Secs => {}
            SecondsFormat::Millis => s.push_str(`.${nano / 1_000_000:03}`.to_string().as_str()),
            SecondsFormat::Micros => s.push_str(`.${nano / 1000:06}`.to_string().as_str()),
            SecondsFormat::Nanos => s.push_str(`.${nano:09}`.to_string().as_str()),
            SecondsFormat::AutoSi => s.push_str(format::frac_auto(nano).as_str()),
        }
        let off = self.offset.fix().local_minus_utc();
        if use_z && off == 0 {
            s.push('Z');
        } else {
            s.push_str(format::offset_string(off, true, false).as_str());
        }
        s
    }

    /// Formats the date and time with strftime-like specifiers (see
    /// [`crate::chrono::format`]).
    ///
    /// The result displays the formatted text. An invalid format string, or
    /// a specifier for a field the value lacks, makes displaying it fail
    /// with `fmt::Error` (chrono's `to_string` panics then; navi's gives an
    /// empty string).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{TimeZone, Utc};
    ///
    /// let t = Utc.with_ymd_and_hms(2024, 5, 6, 7, 8, 9).unwrap();
    /// assert_eq(t.format("%a %b %e %T %Y").to_string(), "Mon May  6 07:08:09 2024");
    /// assert_eq(t.format("%Y-%m-%dT%H:%M:%S%:z").to_string(), "2024-05-06T07:08:09+00:00");
    /// ```
    pub fn format(&self, fmt: &str) -> DelayedFormat {
        let l = self.local();
        DelayedFormat::with_offset(
            l,
            self.offset.fix().local_minus_utc(),
            `${self.offset}`.to_string(),
            self.timestamp(),
            fmt,
        )
    }
}

impl DateTime<Utc> {
    /// The earliest `DateTime<Utc>`.
    pub const MIN_UTC: DateTime<Utc> = DateTime {
        utc: NaiveDateTime::MIN,
        offset: Utc,
    };
    /// The latest `DateTime<Utc>`.
    pub const MAX_UTC: DateTime<Utc> = DateTime {
        utc: NaiveDateTime::MAX,
        offset: Utc,
    };

    /// Makes the instant `secs` seconds and `nsecs` nanoseconds after the
    /// Unix epoch, or `None` if it is out of range (or `nsecs` is 2e9 or
    /// more).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::DateTime;
    ///
    /// let t = DateTime::from_timestamp(1_000_000_000, 0).unwrap();
    /// assert_eq(t.to_rfc3339(), "2001-09-09T01:46:40+00:00");
    /// assert(DateTime::from_timestamp(i64::MAX, 0).is_none());
    /// ```
    pub fn from_timestamp(secs: i64, nsecs: u32) -> Option<DateTime<Utc>> {
        let utc = NaiveDateTime::from_unix(secs, nsecs)?;
        Some(DateTime { utc, offset: Utc })
    }

    /// Makes the instant `millis` milliseconds after the Unix epoch, or
    /// `None` if it is out of range.
    pub fn from_timestamp_millis(millis: i64) -> Option<DateTime<Utc>> {
        DateTime::from_timestamp(
            millis.div_euclid(1000),
            (millis.rem_euclid(1000) * 1_000_000) as u32,
        )
    }

    /// Makes the instant `micros` microseconds after the Unix epoch, or
    /// `None` if it is out of range.
    pub fn from_timestamp_micros(micros: i64) -> Option<DateTime<Utc>> {
        DateTime::from_timestamp(
            micros.div_euclid(1_000_000),
            (micros.rem_euclid(1_000_000) * 1000) as u32,
        )
    }

    /// Makes the instant `nanos` nanoseconds after the Unix epoch (every
    /// `i64` is in range).
    pub fn from_timestamp_nanos(nanos: i64) -> DateTime<Utc> {
        DateTime::from_timestamp(
            nanos.div_euclid(1_000_000_000),
            nanos.rem_euclid(1_000_000_000) as u32,
        )
        .unwrap()
    }
}

impl DateTime<FixedOffset> {
    /// Parses an RFC 3339 date and time, such as
    /// `"2018-01-26T18:30:09.453+00:00"` (also `Z` for the offset, and a
    /// space or `t` for `T`).
    ///
    /// # Errors
    ///
    /// A [`ParseError`] if `s` is not RFC 3339 or not a valid date and
    /// time.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::{DateTime, Timelike};
    ///
    /// let t = DateTime::parse_from_rfc3339("1996-12-19T16:39:57-08:00").unwrap();
    /// assert_eq(t.hour(), 16);
    /// assert_eq(t.offset().local_minus_utc(), -8 * 3600);
    /// assert(DateTime::parse_from_rfc3339("1996-12-19 16:39").is_err());
    /// ```
    pub fn parse_from_rfc3339(s: &str) -> ParseResult<DateTime<FixedOffset>> {
        format::parse_rfc3339(s)
    }

    /// Parses an RFC 2822 date and time, such as
    /// `"Tue, 1 Jul 2003 10:52:37 +0200"` (also the `GMT`, `UT` and US zone
    /// names).
    ///
    /// # Errors
    ///
    /// A [`ParseError`] if `s` is not RFC 2822 or not a valid date and
    /// time.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::DateTime;
    ///
    /// let t = DateTime::parse_from_rfc2822("Tue, 1 Jul 2003 10:52:37 +0200").unwrap();
    /// assert_eq(t.to_rfc3339(), "2003-07-01T10:52:37+02:00");
    /// ```
    pub fn parse_from_rfc2822(s: &str) -> ParseResult<DateTime<FixedOffset>> {
        format::parse_rfc2822(s)
    }

    /// Parses a date and time with a format string that includes an offset
    /// (`%z` or the like).
    ///
    /// # Errors
    ///
    /// A [`ParseError`] if `s` does not match `fmt`, has no offset, or is
    /// not a valid date and time.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::chrono::DateTime;
    ///
    /// let t = DateTime::parse_from_str("2024-05-06 07:08:09 +0900", "%Y-%m-%d %H:%M:%S %z").unwrap();
    /// assert_eq(t.to_rfc3339(), "2024-05-06T07:08:09+09:00");
    /// ```
    pub fn parse_from_str(s: &str, fmt: &str) -> ParseResult<DateTime<FixedOffset>> {
        let p = format::parse(s, fmt)?;
        p.to_datetime()
    }

    /// Parses a date and time with an offset from the start of `s` with a
    /// format string, returning it with the rest of `s`.
    ///
    /// # Errors
    ///
    /// A [`ParseError`] if the start of `s` does not match `fmt` or is not a
    /// valid date and time.
    pub fn parse_and_remainder(s: &str, fmt: &str) -> ParseResult<(DateTime<FixedOffset>, &str)> {
        let (p, rest) = format::parse_and_remainder(s, fmt)?;
        Ok((p.to_datetime()?, rest))
    }
}

impl<Tz: TimeZone> Datelike for DateTime<Tz> {
    fn year(&self) -> i32 {
        self.local().year()
    }

    fn month(&self) -> u32 {
        self.local().month()
    }

    fn day(&self) -> u32 {
        self.local().day()
    }

    fn ordinal(&self) -> u32 {
        self.local().ordinal()
    }

    fn weekday(&self) -> Weekday {
        self.local().weekday()
    }

    fn iso_week(&self) -> IsoWeek {
        self.local().iso_week()
    }

    fn with_year(&self, year: i32) -> Option<DateTime<Tz>> {
        self.map_local(self.local().with_year(year)?)
    }

    fn with_month(&self, month: u32) -> Option<DateTime<Tz>> {
        self.map_local(self.local().with_month(month)?)
    }

    fn with_day(&self, day: u32) -> Option<DateTime<Tz>> {
        self.map_local(self.local().with_day(day)?)
    }

    fn with_ordinal(&self, ordinal: u32) -> Option<DateTime<Tz>> {
        self.map_local(self.local().with_ordinal(ordinal)?)
    }
}

impl<Tz: TimeZone> Timelike for DateTime<Tz> {
    fn hour(&self) -> u32 {
        self.local().hour()
    }

    fn minute(&self) -> u32 {
        self.local().minute()
    }

    fn second(&self) -> u32 {
        self.local().second()
    }

    fn nanosecond(&self) -> u32 {
        self.local().nanosecond()
    }

    fn with_hour(&self, hour: u32) -> Option<DateTime<Tz>> {
        self.map_local(self.local().with_hour(hour)?)
    }

    fn with_minute(&self, min: u32) -> Option<DateTime<Tz>> {
        self.map_local(self.local().with_minute(min)?)
    }

    fn with_second(&self, sec: u32) -> Option<DateTime<Tz>> {
        self.map_local(self.local().with_second(sec)?)
    }

    fn with_nanosecond(&self, nano: u32) -> Option<DateTime<Tz>> {
        self.map_local(self.local().with_nanosecond(nano)?)
    }
}

/// "2024-01-02T03:04:05Z", "2024-01-02T12:04:05+09:00".
impl<Tz: TimeZone> Debug for DateTime<Tz> {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        Debug::fmt(&self.local(), f)?;
        Debug::fmt(&self.offset, f)
    }
}

/// "2024-01-02 03:04:05 UTC", "2024-01-02 12:04:05 +09:00".
impl<Tz: TimeZone> Display for DateTime<Tz> {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        Display::fmt(&self.local(), f)?;
        f.write_str(" ")?;
        Display::fmt(&self.offset, f)
    }
}

impl<Tz: TimeZone, Tz2: TimeZone> PartialEq<DateTime<Tz2>> for DateTime<Tz> {
    fn eq(&self, other: &DateTime<Tz2>) -> bool {
        self.utc == other.utc
    }
}

impl<Tz: TimeZone> Eq for DateTime<Tz> {}

impl<Tz: TimeZone> PartialOrd for DateTime<Tz> {
    fn partial_cmp(&self, other: &DateTime<Tz>) -> Option<Ordering> {
        self.utc.partial_cmp(&other.utc)
    }
}

impl<Tz: TimeZone> Ord for DateTime<Tz> {
    fn cmp(&self, other: &DateTime<Tz>) -> Ordering {
        self.utc.cmp(&other.utc)
    }
}

impl<Tz: TimeZone> Hash for DateTime<Tz> {
    fn hash<H: Hasher>(&self, state: &mut H) {
        self.utc.hash(state);
    }
}

impl<Tz: TimeZone> Add<TimeDelta> for DateTime<Tz> {
    type Output = DateTime<Tz>;
    fn add(self, d: TimeDelta) -> DateTime<Tz> {
        self.checked_add_signed(d)
            .expect("`DateTime + TimeDelta` overflowed")
    }
}

impl<Tz: TimeZone> Sub<TimeDelta> for DateTime<Tz> {
    type Output = DateTime<Tz>;
    fn sub(self, d: TimeDelta) -> DateTime<Tz> {
        self.checked_sub_signed(d)
            .expect("`DateTime - TimeDelta` overflowed")
    }
}

impl<Tz: TimeZone> Sub<DateTime<Tz>> for DateTime<Tz> {
    type Output = TimeDelta;
    fn sub(self, rhs: DateTime<Tz>) -> TimeDelta {
        self.utc.signed_duration_since(rhs.utc)
    }
}

impl<Tz: TimeZone> Add<Months> for DateTime<Tz> {
    type Output = DateTime<Tz>;
    fn add(self, m: Months) -> DateTime<Tz> {
        self.checked_add_months(m)
            .expect("`DateTime + Months` out of range")
    }
}

impl<Tz: TimeZone> Sub<Months> for DateTime<Tz> {
    type Output = DateTime<Tz>;
    fn sub(self, m: Months) -> DateTime<Tz> {
        self.checked_sub_months(m)
            .expect("`DateTime - Months` out of range")
    }
}

impl<Tz: TimeZone> Add<Days> for DateTime<Tz> {
    type Output = DateTime<Tz>;
    fn add(self, d: Days) -> DateTime<Tz> {
        self.checked_add_days(d)
            .expect("`DateTime + Days` out of range")
    }
}

impl<Tz: TimeZone> Sub<Days> for DateTime<Tz> {
    type Output = DateTime<Tz>;
    fn sub(self, d: Days) -> DateTime<Tz> {
        self.checked_sub_days(d)
            .expect("`DateTime - Days` out of range")
    }
}

/// RFC 3339 and close variants ("2024-01-02T03:04:05Z", "2024-01-02 03:04:05
/// +09:00").
impl FromStr for DateTime<FixedOffset> {
    type Err = ParseError;
    fn from_str(s: &str) -> ParseResult<DateTime<FixedOffset>> {
        format::parse_rfc3339_relaxed(s)
    }
}

impl FromStr for DateTime<Utc> {
    type Err = ParseError;
    fn from_str(s: &str) -> ParseResult<DateTime<Utc>> {
        Ok(format::parse_rfc3339_relaxed(s)?.to_utc())
    }
}

impl FromStr for DateTime<Local> {
    type Err = ParseError;
    fn from_str(s: &str) -> ParseResult<DateTime<Local>> {
        Ok(format::parse_rfc3339_relaxed(s)?.with_timezone(&Local))
    }
}

impl From<crate::time::SystemTime> for DateTime<Utc> {
    fn from(t: crate::time::SystemTime) -> DateTime<Utc> {
        let (secs, nanos) = match t.duration_since(crate::time::UNIX_EPOCH) {
            Ok(d) => (d.as_secs() as i64, d.subsec_nanos()),
            Err(e) => {
                let d = e.duration();
                let ns = d.subsec_nanos();
                if ns == 0 {
                    (-(d.as_secs() as i64), 0)
                } else {
                    (-(d.as_secs() as i64) - 1, 1_000_000_000 - ns)
                }
            }
        };
        Utc.timestamp_opt(secs, nanos).unwrap()
    }
}

impl From<crate::time::SystemTime> for DateTime<Local> {
    fn from(t: crate::time::SystemTime) -> DateTime<Local> {
        DateTime::<Utc>::from(t).with_timezone(&Local)
    }
}

impl<Tz: TimeZone> From<DateTime<Tz>> for crate::time::SystemTime {
    fn from(dt: DateTime<Tz>) -> crate::time::SystemTime {
        let secs = dt.timestamp();
        let nanos = dt.timestamp_subsec_nanos() % 1_000_000_000;
        if secs >= 0 {
            crate::time::UNIX_EPOCH + crate::time::Duration::new(secs as u64, nanos)
        } else if nanos == 0 {
            crate::time::UNIX_EPOCH - crate::time::Duration::new((-secs) as u64, 0)
        } else {
            crate::time::UNIX_EPOCH
                - crate::time::Duration::new((-secs - 1) as u64, 1_000_000_000 - nanos)
        }
    }
}

impl From<DateTime<Utc>> for DateTime<FixedOffset> {
    fn from(d: DateTime<Utc>) -> DateTime<FixedOffset> {
        d.fixed_offset()
    }
}

impl From<DateTime<Local>> for DateTime<FixedOffset> {
    fn from(d: DateTime<Local>) -> DateTime<FixedOffset> {
        d.fixed_offset()
    }
}

impl From<DateTime<FixedOffset>> for DateTime<Utc> {
    fn from(d: DateTime<FixedOffset>) -> DateTime<Utc> {
        d.to_utc()
    }
}

impl Default for DateTime<Utc> {
    fn default() -> DateTime<Utc> {
        UNIX_EPOCH
    }
}
