//! TimeDelta (chrono's Duration): a signed span of seconds and nanoseconds.

use crate::cmp::Ordering;
use crate::fmt::{self, Debug, Display, Formatter};
use crate::ops::{Add, Div, Mul, Neg, Sub};

const NANOS_PER_SEC: i64 = 1_000_000_000;
// The largest span: i64::MAX milliseconds, as chrono's.
const MAX_SECS: i64 = 9_223_372_036_854_775;
const MAX_NANOS: i32 = 807_000_000;

/// A signed span of time with nanosecond precision (between about
/// ±292 million years).
#[derive(Clone, PartialEq, Eq, Hash, Default)]
pub struct TimeDelta {
    secs: i64,
    // 0..1e9, also for negative spans.
    nanos: i32,
}

/// The name of TimeDelta in chrono before 0.4.35.
pub type Duration = TimeDelta;

fn in_range(secs: i64, nanos: i32) -> bool {
    !(secs > MAX_SECS
        || (secs == MAX_SECS && nanos > MAX_NANOS)
        || secs < -MAX_SECS
        || (secs == -MAX_SECS && nanos < 1_000_000_000 - MAX_NANOS)
        || secs < -MAX_SECS - 1)
}

impl TimeDelta {
    pub const MIN: TimeDelta = TimeDelta {
        secs: -MAX_SECS - 1,
        nanos: 1_000_000_000 - MAX_NANOS,
    };
    pub const MAX: TimeDelta = TimeDelta {
        secs: MAX_SECS,
        nanos: MAX_NANOS,
    };

    /// secs + nanos (nanos below 1e9), if in range.
    pub fn new(secs: i64, nanos: u32) -> Option<TimeDelta> {
        if nanos >= 1_000_000_000 {
            return None;
        }
        let d = TimeDelta {
            secs,
            nanos: nanos as i32,
        };
        if d < TimeDelta::MIN || d > TimeDelta::MAX {
            None
        } else {
            Some(d)
        }
    }

    pub fn zero() -> TimeDelta {
        TimeDelta { secs: 0, nanos: 0 }
    }
    pub fn is_zero(&self) -> bool {
        self.secs == 0 && self.nanos == 0
    }

    pub fn try_weeks(weeks: i64) -> Option<TimeDelta> {
        match weeks.checked_mul(7 * 86400) {
            Some(s) => TimeDelta::try_seconds(s),
            None => None,
        }
    }
    pub fn try_days(days: i64) -> Option<TimeDelta> {
        match days.checked_mul(86400) {
            Some(s) => TimeDelta::try_seconds(s),
            None => None,
        }
    }
    pub fn try_hours(hours: i64) -> Option<TimeDelta> {
        match hours.checked_mul(3600) {
            Some(s) => TimeDelta::try_seconds(s),
            None => None,
        }
    }
    pub fn try_minutes(minutes: i64) -> Option<TimeDelta> {
        match minutes.checked_mul(60) {
            Some(s) => TimeDelta::try_seconds(s),
            None => None,
        }
    }
    pub fn try_seconds(seconds: i64) -> Option<TimeDelta> {
        TimeDelta::new(seconds, 0)
    }
    pub fn try_milliseconds(ms: i64) -> Option<TimeDelta> {
        let d = TimeDelta {
            secs: ms.div_euclid(1000),
            nanos: (ms.rem_euclid(1000) * 1_000_000) as i32,
        };
        if d < TimeDelta::MIN || d > TimeDelta::MAX {
            None
        } else {
            Some(d)
        }
    }

    pub fn weeks(weeks: i64) -> TimeDelta {
        TimeDelta::try_weeks(weeks).expect("TimeDelta::weeks out of bounds")
    }
    pub fn days(days: i64) -> TimeDelta {
        TimeDelta::try_days(days).expect("TimeDelta::days out of bounds")
    }
    pub fn hours(hours: i64) -> TimeDelta {
        TimeDelta::try_hours(hours).expect("TimeDelta::hours out of bounds")
    }
    pub fn minutes(minutes: i64) -> TimeDelta {
        TimeDelta::try_minutes(minutes).expect("TimeDelta::minutes out of bounds")
    }
    pub fn seconds(seconds: i64) -> TimeDelta {
        TimeDelta::try_seconds(seconds).expect("TimeDelta::seconds out of bounds")
    }
    pub fn milliseconds(ms: i64) -> TimeDelta {
        TimeDelta::try_milliseconds(ms).expect("TimeDelta::milliseconds out of bounds")
    }
    pub fn microseconds(us: i64) -> TimeDelta {
        TimeDelta {
            secs: us.div_euclid(1_000_000),
            nanos: (us.rem_euclid(1_000_000) * 1000) as i32,
        }
    }
    pub fn nanoseconds(ns: i64) -> TimeDelta {
        TimeDelta {
            secs: ns.div_euclid(NANOS_PER_SEC),
            nanos: ns.rem_euclid(NANOS_PER_SEC) as i32,
        }
    }

    pub fn num_weeks(&self) -> i64 {
        self.num_days() / 7
    }
    pub fn num_days(&self) -> i64 {
        self.num_seconds() / 86400
    }
    pub fn num_hours(&self) -> i64 {
        self.num_seconds() / 3600
    }
    pub fn num_minutes(&self) -> i64 {
        self.num_seconds() / 60
    }

    /// Whole seconds, rounded toward zero.
    pub fn num_seconds(&self) -> i64 {
        if self.secs < 0 && self.nanos > 0 {
            self.secs + 1
        } else {
            self.secs
        }
    }

    /// The nanoseconds beyond num_seconds (negative for negative spans).
    pub fn subsec_nanos(&self) -> i32 {
        if self.secs < 0 && self.nanos > 0 {
            self.nanos - 1_000_000_000
        } else {
            self.nanos
        }
    }

    pub fn num_milliseconds(&self) -> i64 {
        self.num_seconds() * 1000 + (self.subsec_nanos() / 1_000_000) as i64
    }

    pub fn num_microseconds(&self) -> Option<i64> {
        let s = self.num_seconds().checked_mul(1_000_000)?;
        s.checked_add((self.subsec_nanos() / 1000) as i64)
    }

    pub fn num_nanoseconds(&self) -> Option<i64> {
        let s = self.num_seconds().checked_mul(NANOS_PER_SEC)?;
        s.checked_add(self.subsec_nanos() as i64)
    }

    pub fn abs(&self) -> TimeDelta {
        if self.secs < 0 {
            -self.clone()
        } else {
            self.clone()
        }
    }

    pub fn checked_add(&self, rhs: &TimeDelta) -> Option<TimeDelta> {
        let mut secs = self.secs.checked_add(rhs.secs)?;
        let mut nanos = self.nanos + rhs.nanos;
        if nanos >= 1_000_000_000 {
            nanos -= 1_000_000_000;
            secs = secs.checked_add(1)?;
        }
        let d = TimeDelta { secs, nanos };
        if d < TimeDelta::MIN || d > TimeDelta::MAX {
            None
        } else {
            Some(d)
        }
    }

    pub fn checked_sub(&self, rhs: &TimeDelta) -> Option<TimeDelta> {
        let mut secs = self.secs.checked_sub(rhs.secs)?;
        let mut nanos = self.nanos - rhs.nanos;
        if nanos < 0 {
            nanos += 1_000_000_000;
            secs = secs.checked_sub(1)?;
        }
        let d = TimeDelta { secs, nanos };
        if d < TimeDelta::MIN || d > TimeDelta::MAX {
            None
        } else {
            Some(d)
        }
    }

    pub fn checked_mul(&self, rhs: i32) -> Option<TimeDelta> {
        // As nanoseconds in 128 bits.
        let total = (self.secs as i128) * 1_000_000_000 + self.nanos as i128;
        let p = total * rhs as i128;
        let secs = p.div_euclid(1_000_000_000);
        if secs > i64::MAX as i128 || secs < i64::MIN as i128 {
            return None;
        }
        let d = TimeDelta {
            secs: secs as i64,
            nanos: p.rem_euclid(1_000_000_000) as i32,
        };
        if d < TimeDelta::MIN || d > TimeDelta::MAX {
            None
        } else {
            Some(d)
        }
    }

    pub fn checked_div(&self, rhs: i32) -> Option<TimeDelta> {
        if rhs == 0 {
            return None;
        }
        let total = (self.secs as i128) * 1_000_000_000 + self.nanos as i128;
        let q = total / rhs as i128;
        Some(TimeDelta {
            secs: q.div_euclid(1_000_000_000) as i64,
            nanos: q.rem_euclid(1_000_000_000) as i32,
        })
    }

    /// As a std::time::Duration (Err for a negative span).
    pub fn to_std(&self) -> Result<crate::time::Duration, OutOfRangeError> {
        if self.secs < 0 {
            return Err(OutOfRangeError {});
        }
        Ok(crate::time::Duration::new(
            self.secs as u64,
            self.nanos as u32,
        ))
    }

    pub fn from_std(d: crate::time::Duration) -> Result<TimeDelta, OutOfRangeError> {
        if d.as_secs() > MAX_SECS as u64 {
            return Err(OutOfRangeError {});
        }
        match TimeDelta::new(d.as_secs() as i64, d.subsec_nanos()) {
            Some(x) => Ok(x),
            None => Err(OutOfRangeError {}),
        }
    }

    pub(crate) fn parts(&self) -> (i64, i32) {
        (self.secs, self.nanos)
    }
}

impl PartialOrd for TimeDelta {
    fn partial_cmp(&self, other: &TimeDelta) -> Option<Ordering> {
        Some(self.cmp(other))
    }
}

impl Ord for TimeDelta {
    fn cmp(&self, other: &TimeDelta) -> Ordering {
        match self.secs.cmp(&other.secs) {
            Ordering::Equal => self.nanos.cmp(&other.nanos),
            o => o,
        }
    }
}

impl Neg for TimeDelta {
    type Output = TimeDelta;
    fn neg(self) -> TimeDelta {
        if self.nanos == 0 {
            TimeDelta {
                secs: -self.secs,
                nanos: 0,
            }
        } else {
            TimeDelta {
                secs: -self.secs - 1,
                nanos: 1_000_000_000 - self.nanos,
            }
        }
    }
}

impl Add for TimeDelta {
    type Output = TimeDelta;
    fn add(self, rhs: TimeDelta) -> TimeDelta {
        self.checked_add(&rhs)
            .expect("`TimeDelta + TimeDelta` overflowed")
    }
}

impl Sub for TimeDelta {
    type Output = TimeDelta;
    fn sub(self, rhs: TimeDelta) -> TimeDelta {
        self.checked_sub(&rhs)
            .expect("`TimeDelta - TimeDelta` overflowed")
    }
}

impl Mul<i32> for TimeDelta {
    type Output = TimeDelta;
    fn mul(self, rhs: i32) -> TimeDelta {
        self.checked_mul(rhs).expect("`TimeDelta * i32` overflowed")
    }
}

impl Div<i32> for TimeDelta {
    type Output = TimeDelta;
    fn div(self, rhs: i32) -> TimeDelta {
        self.checked_div(rhs).expect("`i32` is zero")
    }
}

/// ISO 8601: "PT86400S", "-PT1.5S", "P0D".
impl Display for TimeDelta {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        let (abs, sign) = if self.secs < 0 {
            (-self.clone(), "-")
        } else {
            (self.clone(), "")
        };
        f.write_str(sign)?;
        f.write_str("P")?;
        if abs.secs == 0 && abs.nanos == 0 {
            return f.write_str("0D");
        }
        f.write_fmt(`T${abs.secs}`)?;
        if abs.nanos > 0 {
            let mut digits = 9;
            let mut frac = abs.nanos;
            while frac % 10 == 0 {
                frac /= 10;
                digits -= 1;
            }
            let s = frac.to_string();
            f.write_str(".")?;
            let mut k = s.len();
            while k < digits {
                f.write_str("0")?;
                k += 1;
            }
            f.write_str(s.as_str())?;
        }
        f.write_str("S")
    }
}

impl Debug for TimeDelta {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_fmt(`TimeDelta { secs: ${self.secs}, nanos: ${self.nanos} }`)
    }
}

/// TimeDelta::to_std of a negative span, or from_std of a too long one.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct OutOfRangeError {}

impl Display for OutOfRangeError {
    fn fmt(&self, f: &mut Formatter) -> fmt::Result {
        f.write_str("Source duration value is out of range for the target type")
    }
}
