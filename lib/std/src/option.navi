//! Optional values.

#[derive(Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
pub enum Option<T> {
    None,
    Some(T),
}

impl<T> Option<T> {
    pub fn is_some(&self) -> bool { match self { Some(_) => true, None => false } }
    pub fn is_none(&self) -> bool { !self.is_some() }
    pub fn as_ref(&self) -> Option<&T> { match self { Some(x) => Some(x), None => None } }
    pub fn as_mut(&mut self) -> Option<&mut T> { match self { Some(x) => Some(x), None => None } }
    #[track_caller]
    pub fn unwrap(self) -> T { match self { Some(x) => x, None => panic("called Option::unwrap() on a None value") } }
    #[track_caller]
    pub fn expect(self, msg: &str) -> T { match self { Some(x) => x, None => panic(msg) } }
    pub fn unwrap_or(self, default: T) -> T { match self { Some(x) => x, None => default } }
    pub fn unwrap_or_else(self, f: fn() -> T) -> T { match self { Some(x) => x, None => f() } }
    pub fn map<U>(self, f: fn(T) -> U) -> Option<U> { match self { Some(x) => Some(f(x)), None => None } }
    pub fn and_then<U>(self, f: fn(T) -> Option<U>) -> Option<U> { match self { Some(x) => f(x), None => None } }
    pub fn ok_or<E>(self, err: E) -> Result<T, E> { match self { Some(x) => Ok(x), None => Err(err) } }
    pub fn filter(self, pred: fn(&T) -> bool) -> Option<T> { match self { Some(x) => if pred(&x) { Some(x) } else { None }, None => None } }
    pub fn or(self, other: Option<T>) -> Option<T> { match self { Some(x) => Some(x), None => other } }
    pub fn take(&mut self) -> Option<T> { crate::mem::replace(self, None) }
}

impl<T: Clone> Option<&T> {
    pub fn cloned(self) -> Option<T> { match self { Some(x) => Some(x.clone()), None => None } }
}

impl<T: Default> Option<T> {
    pub fn unwrap_or_default(self) -> T { match self { Some(x) => x, None => T::default() } }
}

impl<T> Default for Option<T> {
    fn default() -> Option<T> { None }
}

/// The iterator of Option::into_iter (zero or one item).
pub struct IntoIter<T> { v: Option<T> }
impl<T> crate::iter::Iterator for IntoIter<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> { self.v.take() }
}

impl<T> crate::iter::IntoIterator for Option<T> {
    type Item = T;
    type IntoIter = IntoIter<T>;
    fn into_iter(self) -> IntoIter<T> { IntoIter { v: self } }
}

impl<T> Option<T> {
    pub fn map_or<U>(self, default: U, f: fn(T) -> U) -> U { match self { Some(v) => f(v), None => default } }
    pub fn map_or_else<U>(self, default: fn() -> U, f: fn(T) -> U) -> U { match self { Some(v) => f(v), None => default() } }
    pub fn ok_or_else<E>(self, err: fn() -> E) -> Result<T, E> { match self { Some(v) => Ok(v), None => Err(err()) } }
    pub fn and<U>(self, other: Option<U>) -> Option<U> { match self { Some(_) => other, None => None } }
    pub fn or_else(self, f: fn() -> Option<T>) -> Option<T> { match self { Some(v) => Some(v), None => f() } }
    pub fn xor(self, other: Option<T>) -> Option<T> {
        match (self, other) { (Some(a), None) => Some(a), (None, Some(b)) => Some(b), _ => None }
    }
    pub fn zip<U>(self, other: Option<U>) -> Option<(T, U)> {
        match (self, other) { (Some(a), Some(b)) => Some((a, b)), _ => None }
    }
    pub fn is_some_and(self, f: fn(T) -> bool) -> bool { match self { Some(v) => f(v), None => false } }
    pub fn is_none_or(self, f: fn(T) -> bool) -> bool { match self { Some(v) => f(v), None => true } }
    pub fn insert(&mut self, v: T) -> &mut T {
        *self = Some(v);
        match self { Some(x) => x, None => panic("unreachable") }
    }
    pub fn get_or_insert(&mut self, v: T) -> &mut T {
        if self.is_none() { *self = Some(v); }
        match self { Some(x) => x, None => panic("unreachable") }
    }
    pub fn get_or_insert_with(&mut self, f: fn() -> T) -> &mut T {
        if self.is_none() { *self = Some(f()); }
        match self { Some(x) => x, None => panic("unreachable") }
    }
    pub fn replace(&mut self, v: T) -> Option<T> { crate::mem::replace(self, Some(v)) }
    pub fn iter(&self) -> IntoIter<&T> { IntoIter { v: self.as_ref() } }
    #[track_caller]
    pub fn unwrap_unchecked(self) -> T { self.unwrap() }
}

impl<T> Option<Option<T>> {
    pub fn flatten(self) -> Option<T> { match self { Some(x) => x, None => None } }
}

impl<T> Option<&T> {
    pub fn copied(self) -> Option<T> { match self { Some(v) => Some(*v), None => None } }
}
