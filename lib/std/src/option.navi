//! Optional values.
//!
//! Type [`Option`] represents an optional value: every [`Option`] is either
//! [`Some`] and contains a value, or [`None`], and does not. Options are
//! commonly used for:
//!
//! * initial values;
//! * return values of functions that are not defined over their whole input
//!   range (partial functions), such as a lookup that may find nothing;
//! * optional struct fields;
//! * optional function arguments;
//! * nullable references: `Option<&T>` is the way to have a reference that
//!   may be absent (navi has no null; `None` is stored as a null pointer, so
//!   it costs no space).
//!
//! Options are commonly paired with pattern matching to query the presence
//! of a value and take action, always accounting for the [`None`] case.
//!
//! # Examples
//!
//! ```
//! fn divide(numerator: f64, denominator: f64) -> Option<f64> {
//!     if denominator == 0.0 {
//!         None
//!     } else {
//!         Some(numerator / denominator)
//!     }
//! }
//!
//! // The return value of the function is an option.
//! let result = divide(2.0, 3.0);
//!
//! // Pattern match to retrieve the value.
//! match result {
//!     // The division was valid.
//!     Some(x) => println(`Result: ${x}`),
//!     // The division was invalid.
//!     None => println("Cannot divide by 0"),
//! }
//! ```
//!
//! # The question mark operator, `?`
//!
//! In a function returning an [`Option`], `?` on an [`Option`] value returns
//! [`None`] early if it is [`None`], and otherwise gives the value inside:
//!
//! ```
//! fn add_last_numbers(stack: &mut Vec<i32>) -> Option<i32> {
//!     Some(stack.pop()? + stack.pop()?)
//! }
//!
//! let mut v = Vec::from([1, 2, 3]);
//! assert_eq(add_last_numbers(&mut v), Some(5));
//! assert_eq(add_last_numbers(&mut v), None);
//! ```
//!
//! # Method overview
//!
//! * Querying the variant: [`Option::is_some`], [`Option::is_none`],
//!   [`Option::is_some_and`], [`Option::is_none_or`].
//! * Extracting the value: [`Option::unwrap`], [`Option::expect`],
//!   [`Option::unwrap_or`], [`Option::unwrap_or_else`],
//!   [`Option::unwrap_or_default`].
//! * Transforming: [`Option::map`], [`Option::map_or`],
//!   [`Option::map_or_else`], [`Option::filter`], [`Option::and_then`],
//!   [`Option::flatten`], [`Option::zip`], [`Option::ok_or`].
//! * Combining: [`Option::and`], [`Option::or`], [`Option::or_else`],
//!   [`Option::xor`].
//! * Modifying in place: [`Option::take`], [`Option::replace`],
//!   [`Option::insert`], [`Option::get_or_insert`],
//!   [`Option::get_or_insert_with`].

/// The `Option` type: either `Some` value of type `T`, or `None`.
///
/// See [the module documentation](self) for more.
///
/// `None` compares less than any `Some`; two `Some` values compare by their
/// contents.
///
/// # Examples
///
/// ```
/// let mut x: Option<i32> = None;
/// assert(x.is_none());
/// x = Some(5);
/// assert_eq(x, Some(5));
/// assert(None < Some(0));
/// ```
#[derive(Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
pub enum Option<T> {
    /// No value.
    None,
    /// Some value of type `T`.
    Some(T),
}

impl<T> Option<T> {
    /// Returns `true` if the option is a [`Some`] value.
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Option<u32> = Some(2);
    /// assert_eq(x.is_some(), true);
    ///
    /// let x: Option<u32> = None;
    /// assert_eq(x.is_some(), false);
    /// ```
    #[inline]
    pub fn is_some(&self) -> bool {
        match self {
            Some(_) => true,
            None => false,
        }
    }
    /// Returns `true` if the option is a [`None`] value.
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Option<u32> = Some(2);
    /// assert_eq(x.is_none(), false);
    ///
    /// let x: Option<u32> = None;
    /// assert_eq(x.is_none(), true);
    /// ```
    #[inline]
    pub fn is_none(&self) -> bool {
        !self.is_some()
    }
    /// Converts from `&Option<T>` to `Option<&T>`.
    ///
    /// # Examples
    ///
    /// Calculates the length of an `Option<String>` as an `Option<usize>`
    /// without copying the `String`:
    ///
    /// ```
    /// let text: Option<String> = Some("Hello, world!".to_string());
    /// let text_length: Option<usize> = text.as_ref().map(|s: &String| -> usize { s.len() });
    /// assert_eq(text_length, Some(13));
    /// ```
    #[inline]
    pub fn as_ref(&self) -> Option<&T> {
        match self {
            Some(x) => Some(x),
            None => None,
        }
    }
    /// Converts from `&mut Option<T>` to `Option<&mut T>`.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut x = Some(2);
    /// match x.as_mut() {
    ///     Some(v) => *v = 42,
    ///     None => {}
    /// }
    /// assert_eq(x, Some(42));
    /// ```
    pub fn as_mut(&mut self) -> Option<&mut T> {
        match self {
            Some(x) => Some(x),
            None => None,
        }
    }
    /// Returns the contained [`Some`] value.
    ///
    /// Because this function may panic, its use is generally discouraged.
    /// Prefer pattern matching and handling the [`None`] case explicitly, or
    /// call [`Option::unwrap_or`], [`Option::unwrap_or_else`] or
    /// [`Option::unwrap_or_default`].
    ///
    /// # Panics
    ///
    /// Panics if the value is a [`None`], with the message "called
    /// Option::unwrap() on a None value".
    ///
    /// # Examples
    ///
    /// ```
    /// let x = Some("air");
    /// assert_eq(x.unwrap(), "air");
    /// ```
    ///
    /// ```should_panic
    /// let x: Option<&str> = None;
    /// assert_eq(x.unwrap(), "air"); // fails
    /// ```
    #[track_caller]
    #[inline]
    pub fn unwrap(self) -> T {
        match self {
            Some(x) => x,
            None => panic("called Option::unwrap() on a None value"),
        }
    }
    /// Returns the contained [`Some`] value.
    ///
    /// # Panics
    ///
    /// Panics if the value is a [`None`], with `msg` as the panic message.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = Some("value");
    /// assert_eq(x.expect("fruits are healthy"), "value");
    /// ```
    ///
    /// ```should_panic
    /// let x: Option<&str> = None;
    /// x.expect("fruits are healthy"); // panics with "fruits are healthy"
    /// ```
    #[track_caller]
    #[inline]
    pub fn expect(self, msg: &str) -> T {
        match self {
            Some(x) => x,
            None => panic(msg),
        }
    }
    /// Returns the contained [`Some`] value or a provided default.
    ///
    /// The default is evaluated before the call even when it is not used; to
    /// compute it only when needed, use [`Option::unwrap_or_else`].
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(Some("car").unwrap_or("bike"), "car");
    /// assert_eq(None.unwrap_or("bike"), "bike");
    /// ```
    #[inline]
    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Some(x) => x,
            None => default,
        }
    }
    /// Returns the contained [`Some`] value or computes it from a closure.
    ///
    /// # Examples
    ///
    /// ```
    /// let k = 10;
    /// assert_eq(Some(4).unwrap_or_else(|| 2 * k), 4);
    /// assert_eq(None.unwrap_or_else(|| 2 * k), 20);
    /// ```
    pub fn unwrap_or_else(self, f: fn() -> T) -> T {
        match self {
            Some(x) => x,
            None => f(),
        }
    }
    /// Maps an `Option<T>` to `Option<U>` by applying a function to a contained
    /// value (if `Some`) or returns `None` (if `None`).
    ///
    /// # Examples
    ///
    /// ```
    /// let maybe_some_string = Some("Hello, World!".to_string());
    /// let maybe_some_len = maybe_some_string.map(|s: String| -> usize { s.len() });
    /// assert_eq(maybe_some_len, Some(13));
    ///
    /// let x: Option<&str> = None;
    /// assert_eq(x.map(|s: &str| -> usize { s.len() }), None);
    /// ```
    pub fn map<U>(self, f: fn(T) -> U) -> Option<U> {
        match self {
            Some(x) => Some(f(x)),
            None => None,
        }
    }
    /// Returns [`None`] if the option is [`None`], otherwise calls `f` with the
    /// wrapped value and returns the result.
    ///
    /// Some languages call this operation flatmap.
    ///
    /// # Examples
    ///
    /// ```
    /// fn sq_then_to_string(x: u32) -> Option<String> {
    ///     x.checked_mul(x).map(|sq: u32| -> String { sq.to_string() })
    /// }
    ///
    /// assert_eq(Some(2).and_then(sq_then_to_string), Some("4".to_string()));
    /// assert_eq(Some(1_000_000).and_then(sq_then_to_string), None); // overflowed!
    /// assert_eq(None.and_then(sq_then_to_string), None);
    /// ```
    ///
    /// Often used to chain fallible operations that may return [`None`]:
    ///
    /// ```
    /// let arr_2d = [["A0", "A1"], ["B0", "B1"]];
    ///
    /// let item_0_1 = arr_2d.get(0).and_then(|row: &[&str; 2]| -> Option<&&str> { row.get(1) });
    /// assert_eq(item_0_1, Some(&"A1"));
    ///
    /// let item_2_0 = arr_2d.get(2).and_then(|row: &[&str; 2]| -> Option<&&str> { row.get(0) });
    /// assert_eq(item_2_0, None);
    /// ```
    pub fn and_then<U>(self, f: fn(T) -> Option<U>) -> Option<U> {
        match self {
            Some(x) => f(x),
            None => None,
        }
    }
    /// Transforms the `Option<T>` into a [`Result<T, E>`](Result), mapping
    /// [`Some(v)`] to [`Ok(v)`] and [`None`] to [`Err(err)`].
    ///
    /// The error is evaluated before the call even when it is not used; to
    /// compute it only when needed, use [`Option::ok_or_else`].
    ///
    /// [`Some(v)`]: Some
    /// [`Ok(v)`]: Ok
    /// [`Err(err)`]: Err
    ///
    /// # Examples
    ///
    /// ```
    /// let x = Some("foo");
    /// assert_eq(x.ok_or(0), Ok("foo"));
    ///
    /// let x: Option<&str> = None;
    /// assert_eq(x.ok_or(0), Err(0));
    /// ```
    pub fn ok_or<E>(self, err: E) -> Result<T, E> {
        match self {
            Some(x) => Ok(x),
            None => Err(err),
        }
    }
    /// Returns [`None`] if the option is [`None`], otherwise calls `pred` with
    /// the wrapped value and returns:
    ///
    /// - [`Some(t)`] if `pred` returns `true` (where `t` is the wrapped value),
    ///   and
    /// - [`None`] if `pred` returns `false`.
    ///
    /// [`Some(t)`]: Some
    ///
    /// # Examples
    ///
    /// ```
    /// fn is_even(n: &i32) -> bool {
    ///     n % 2 == 0
    /// }
    ///
    /// assert_eq(None.filter(is_even), None);
    /// assert_eq(Some(3).filter(is_even), None);
    /// assert_eq(Some(4).filter(is_even), Some(4));
    /// ```
    pub fn filter(self, pred: fn(&T) -> bool) -> Option<T> {
        match self {
            Some(x) => {
                if pred(&x) {
                    Some(x)
                } else {
                    None
                }
            }
            None => None,
        }
    }
    /// Returns the option if it contains a value, otherwise returns `other`.
    ///
    /// `other` is evaluated before the call even when it is not used; to
    /// compute it only when needed, use [`Option::or_else`].
    ///
    /// # Examples
    ///
    /// ```
    /// let x = Some(2);
    /// let y = None;
    /// assert_eq(x.or(y), Some(2));
    ///
    /// let x = None;
    /// let y = Some(100);
    /// assert_eq(x.or(y), Some(100));
    ///
    /// let x = Some(2);
    /// let y = Some(100);
    /// assert_eq(x.or(y), Some(2));
    ///
    /// let x: Option<u32> = None;
    /// let y = None;
    /// assert_eq(x.or(y), None);
    /// ```
    pub fn or(self, other: Option<T>) -> Option<T> {
        match self {
            Some(x) => Some(x),
            None => other,
        }
    }
    /// Takes the value out of the option, leaving a [`None`] in its place.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut x = Some(2);
    /// let y = x.take();
    /// assert_eq(x, None);
    /// assert_eq(y, Some(2));
    ///
    /// let mut x: Option<u32> = None;
    /// let y = x.take();
    /// assert_eq(x, None);
    /// assert_eq(y, None);
    /// ```
    pub fn take(&mut self) -> Option<T> {
        crate::mem::replace(self, None)
    }
}

impl<T: Clone> Option<&T> {
    /// Maps an `Option<&T>` to an `Option<T>` by cloning the contents of the
    /// option.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 12;
    /// let opt_x = Some(&x);
    /// assert_eq(opt_x, Some(&12));
    /// let cloned = opt_x.cloned();
    /// assert_eq(cloned, Some(12));
    /// ```
    pub fn cloned(self) -> Option<T> {
        match self {
            Some(x) => Some(x.clone()),
            None => None,
        }
    }
}

impl<T: Default> Option<T> {
    /// Returns the contained [`Some`] value or the default value of `T`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Option<u32> = None;
    /// let y: Option<u32> = Some(12);
    ///
    /// assert_eq(x.unwrap_or_default(), 0);
    /// assert_eq(y.unwrap_or_default(), 12);
    /// ```
    pub fn unwrap_or_default(self) -> T {
        match self {
            Some(x) => x,
            None => T::default(),
        }
    }
}

impl<T> Default for Option<T> {
    fn default() -> Option<T> {
        None
    }
}

/// An iterator over the value in a [`Some`] variant of an [`Option`]: it
/// yields one item for `Some` and none for `None`.
///
/// It is made by [`Option::into_iter`], [`Option::iter`] (an
/// `IntoIter<&T>`) and [`Option::iter_mut`] (an `IntoIter<&mut T>`).
///
/// # Examples
///
/// ```
/// let x = Some(4);
/// let v: Vec<i32> = x.into_iter().collect();
/// assert_eq(v, [4]);
///
/// let x: Option<i32> = None;
/// assert_eq(x.into_iter().count(), 0);
/// ```
pub struct IntoIter<T> {
    v: Option<T>,
}
impl<T> crate::iter::Iterator for IntoIter<T> {
    type Item = T;
    fn next(&mut self) -> Option<T> {
        self.v.take()
    }
}

impl<T> crate::iter::IntoIterator for Option<T> {
    type Item = T;
    type IntoIter = IntoIter<T>;
    fn into_iter(self) -> IntoIter<T> {
        IntoIter { v: self }
    }
}

impl<T> Option<T> {
    /// Returns the provided default result (if none), or applies a function to
    /// the contained value (if any).
    ///
    /// The default is evaluated before the call even when it is not used; to
    /// compute it only when needed, use [`Option::map_or_else`].
    ///
    /// # Examples
    ///
    /// ```
    /// let x = Some("foo");
    /// assert_eq(x.map_or(42, |v: &str| -> usize { v.len() }), 3);
    ///
    /// let x: Option<&str> = None;
    /// assert_eq(x.map_or(42, |v: &str| -> usize { v.len() }), 42);
    /// ```
    pub fn map_or<U>(self, default: U, f: fn(T) -> U) -> U {
        match self {
            Some(v) => f(v),
            None => default,
        }
    }
    /// Computes a default function result (if none), or applies a different
    /// function to the contained value (if any).
    ///
    /// # Examples
    ///
    /// ```
    /// let k = 21;
    ///
    /// let x = Some("foo");
    /// assert_eq(x.map_or_else(|| 2 * k, |v: &str| -> usize { v.len() }), 3);
    ///
    /// let x: Option<&str> = None;
    /// assert_eq(x.map_or_else(|| 2 * k, |v: &str| -> usize { v.len() }), 42);
    /// ```
    pub fn map_or_else<U>(self, default: fn() -> U, f: fn(T) -> U) -> U {
        match self {
            Some(v) => f(v),
            None => default(),
        }
    }
    /// Transforms the `Option<T>` into a [`Result<T, E>`](Result), mapping
    /// `Some(v)` to `Ok(v)` and `None` to `Err(err())`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = Some("foo");
    /// assert_eq(x.ok_or_else(|| 0), Ok("foo"));
    ///
    /// let x: Option<&str> = None;
    /// assert_eq(x.ok_or_else(|| 0), Err(0));
    /// ```
    pub fn ok_or_else<E>(self, err: fn() -> E) -> Result<T, E> {
        match self {
            Some(v) => Ok(v),
            None => Err(err()),
        }
    }
    /// Returns [`None`] if the option is [`None`], otherwise returns `other`.
    ///
    /// `other` is evaluated before the call even when it is not used; to
    /// compute it only when needed, use [`Option::and_then`].
    ///
    /// # Examples
    ///
    /// ```
    /// let x = Some(2);
    /// let y: Option<&str> = None;
    /// assert_eq(x.and(y), None);
    ///
    /// let x: Option<u32> = None;
    /// let y = Some("foo");
    /// assert_eq(x.and(y), None);
    ///
    /// let x = Some(2);
    /// let y = Some("foo");
    /// assert_eq(x.and(y), Some("foo"));
    /// ```
    pub fn and<U>(self, other: Option<U>) -> Option<U> {
        match self {
            Some(_) => other,
            None => None,
        }
    }
    /// Returns the option if it contains a value, otherwise calls `f` and
    /// returns the result.
    ///
    /// # Examples
    ///
    /// ```
    /// fn nobody() -> Option<&str> { None }
    /// fn vikings() -> Option<&str> { Some("vikings") }
    ///
    /// assert_eq(Some("barbarians").or_else(vikings), Some("barbarians"));
    /// assert_eq(None.or_else(vikings), Some("vikings"));
    /// assert_eq(None.or_else(nobody), None);
    /// ```
    pub fn or_else(self, f: fn() -> Option<T>) -> Option<T> {
        match self {
            Some(v) => Some(v),
            None => f(),
        }
    }
    /// Returns [`Some`] if exactly one of `self`, `other` is [`Some`],
    /// otherwise returns [`None`].
    ///
    /// # Examples
    ///
    /// ```
    /// let x = Some(2);
    /// let y: Option<u32> = None;
    /// assert_eq(x.xor(y), Some(2));
    ///
    /// let x: Option<u32> = None;
    /// let y = Some(2);
    /// assert_eq(x.xor(y), Some(2));
    ///
    /// let x = Some(2);
    /// let y = Some(2);
    /// assert_eq(x.xor(y), None);
    /// ```
    pub fn xor(self, other: Option<T>) -> Option<T> {
        match (self, other) {
            (Some(a), None) => Some(a),
            (None, Some(b)) => Some(b),
            _ => None,
        }
    }
    /// Zips `self` with another `Option`.
    ///
    /// If `self` is `Some(s)` and `other` is `Some(o)`, this method returns
    /// `Some((s, o))`. Otherwise, `None` is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = Some(1);
    /// let y = Some("hi");
    /// let z: Option<u8> = None;
    ///
    /// assert_eq(x.zip(y), Some((1, "hi")));
    /// assert_eq(x.zip(z), None);
    /// ```
    pub fn zip<U>(self, other: Option<U>) -> Option<(T, U)> {
        match (self, other) {
            (Some(a), Some(b)) => Some((a, b)),
            _ => None,
        }
    }
    /// Returns `true` if the option is a [`Some`] and the value inside of it
    /// matches a predicate.
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Option<u32> = Some(2);
    /// assert_eq(x.is_some_and(|x| x > 1), true);
    ///
    /// let x: Option<u32> = Some(0);
    /// assert_eq(x.is_some_and(|x| x > 1), false);
    ///
    /// let x: Option<u32> = None;
    /// assert_eq(x.is_some_and(|x| x > 1), false);
    /// ```
    pub fn is_some_and(self, f: fn(T) -> bool) -> bool {
        match self {
            Some(v) => f(v),
            None => false,
        }
    }
    /// Returns `true` if the option is a [`None`] or the value inside of it
    /// matches a predicate.
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Option<u32> = Some(2);
    /// assert_eq(x.is_none_or(|x| x > 1), true);
    ///
    /// let x: Option<u32> = Some(0);
    /// assert_eq(x.is_none_or(|x| x > 1), false);
    ///
    /// let x: Option<u32> = None;
    /// assert_eq(x.is_none_or(|x| x > 1), true);
    /// ```
    pub fn is_none_or(self, f: fn(T) -> bool) -> bool {
        match self {
            Some(v) => f(v),
            None => true,
        }
    }
    /// Inserts `v` into the option, then returns a mutable reference to it.
    ///
    /// If the option already contains a value, the old value is replaced. See
    /// also [`Option::get_or_insert`], which doesn't update the value if the
    /// option already contains [`Some`].
    ///
    /// # Examples
    ///
    /// ```
    /// let mut opt = None;
    /// let val = opt.insert(1);
    /// assert_eq(*val, 1);
    /// assert_eq(opt.unwrap(), 1);
    /// let val = opt.insert(2);
    /// assert_eq(*val, 2);
    /// *val = 3;
    /// assert_eq(opt.unwrap(), 3);
    /// ```
    pub fn insert(&mut self, v: T) -> &mut T {
        *self = Some(v);
        match self {
            Some(x) => x,
            None => panic("unreachable"),
        }
    }
    /// Inserts `v` into the option if it is [`None`], then returns a mutable
    /// reference to the contained value.
    ///
    /// See also [`Option::insert`], which updates the value even if the option
    /// already contains [`Some`].
    ///
    /// # Examples
    ///
    /// ```
    /// let mut x = None;
    /// {
    ///     let y: &mut u32 = x.get_or_insert(5);
    ///     assert_eq(*y, 5);
    ///     *y = 7;
    /// }
    /// assert_eq(x, Some(7));
    /// assert_eq(*x.get_or_insert(9), 7);
    /// ```
    pub fn get_or_insert(&mut self, v: T) -> &mut T {
        if self.is_none() {
            *self = Some(v);
        }
        match self {
            Some(x) => x,
            None => panic("unreachable"),
        }
    }
    /// Inserts a value computed from `f` into the option if it is [`None`],
    /// then returns a mutable reference to the contained value.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut x = None;
    /// {
    ///     let y: &mut u32 = x.get_or_insert_with(|| 5);
    ///     assert_eq(*y, 5);
    ///     *y = 7;
    /// }
    /// assert_eq(x, Some(7));
    /// ```
    pub fn get_or_insert_with(&mut self, f: fn() -> T) -> &mut T {
        if self.is_none() {
            *self = Some(f());
        }
        match self {
            Some(x) => x,
            None => panic("unreachable"),
        }
    }
    /// Replaces the actual value in the option by the value given in parameter,
    /// returning the old value if present, leaving a [`Some`] in its place.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut x = Some(2);
    /// let old = x.replace(5);
    /// assert_eq(x, Some(5));
    /// assert_eq(old, Some(2));
    ///
    /// let mut x = None;
    /// let old = x.replace(3);
    /// assert_eq(x, Some(3));
    /// assert_eq(old, None);
    /// ```
    pub fn replace(&mut self, v: T) -> Option<T> {
        crate::mem::replace(self, Some(v))
    }
    /// Returns an iterator over the possibly contained value.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = Some(4);
    /// assert_eq(x.iter().next(), Some(&4));
    ///
    /// let x: Option<u32> = None;
    /// assert_eq(x.iter().next(), None);
    /// ```
    pub fn iter(&self) -> IntoIter<&T> {
        IntoIter { v: self.as_ref() }
    }
    /// Returns the contained [`Some`] value.
    ///
    /// In Rust this is an `unsafe` function that skips the check; navi has no
    /// undefined behavior here: it is safe, and the same as [`Option::unwrap`].
    ///
    /// # Panics
    ///
    /// Panics if the value is a [`None`].
    ///
    /// # Examples
    ///
    /// ```
    /// let x = Some("air");
    /// assert_eq(x.unwrap_unchecked(), "air");
    /// ```
    #[track_caller]
    pub fn unwrap_unchecked(self) -> T {
        self.unwrap()
    }
}

impl<T> Option<Option<T>> {
    /// Converts from `Option<Option<T>>` to `Option<T>`.
    ///
    /// Flattening only removes one level of nesting at a time.
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Option<Option<u32>> = Some(Some(6));
    /// assert_eq(Some(6), x.flatten());
    ///
    /// let x: Option<Option<u32>> = Some(None);
    /// assert_eq(None, x.flatten());
    ///
    /// let x: Option<Option<u32>> = None;
    /// assert_eq(None, x.flatten());
    ///
    /// let x: Option<Option<Option<u32>>> = Some(Some(Some(6)));
    /// assert_eq(Some(Some(6)), x.flatten());
    /// assert_eq(Some(6), x.flatten().flatten());
    /// ```
    pub fn flatten(self) -> Option<T> {
        match self {
            Some(x) => x,
            None => None,
        }
    }
}

impl<T> Option<&T> {
    /// Maps an `Option<&T>` to an `Option<T>` by copying the contents of the
    /// option (a shallow copy: see [`Option::cloned`] for a deep one).
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 12;
    /// let opt_x = Some(&x);
    /// assert_eq(opt_x, Some(&12));
    /// let copied = opt_x.copied();
    /// assert_eq(copied, Some(12));
    /// ```
    pub fn copied(self) -> Option<T> {
        match self {
            Some(v) => Some(*v),
            None => None,
        }
    }
}

// ---------------------------------------------------------------------------

impl<T> Option<T> {
    /// Returns a mutable iterator over the possibly contained value.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut x = Some(4);
    /// match x.iter_mut().next() {
    ///     Some(v) => *v = 42,
    ///     None => {}
    /// }
    /// assert_eq(x, Some(42));
    ///
    /// let mut x: Option<u32> = None;
    /// assert_eq(x.iter_mut().next(), None);
    /// ```
    pub fn iter_mut(&mut self) -> IntoIter<&mut T> {
        IntoIter { v: self.as_mut() }
    }

    /// Calls `f` with a reference to the contained value if [`Some`], and
    /// returns the option unchanged.
    ///
    /// # Examples
    ///
    /// ```
    /// let v = Vec::from([1, 2, 3, 4, 5]);
    ///
    /// // prints "got: 4"
    /// let x: Option<&i32> = v.get(3).inspect(|x: &&i32| println(`got: ${x}`));
    /// assert_eq(x, Some(&4));
    ///
    /// // prints nothing
    /// let x: Option<&i32> = v.get(5).inspect(|x: &&i32| println(`got: ${x}`));
    /// assert_eq(x, None);
    /// ```
    pub fn inspect(self, f: fn(&T)) -> Option<T> {
        if let Some(x) = &self {
            f(x);
        }
        self
    }

    /// Takes the value out of the option, but only if the predicate evaluates
    /// to `true` on a mutable reference to the value.
    ///
    /// In other words, replaces `self` with `None` if the predicate returns
    /// `true`. This method operates similar to [`Option::take`] but
    /// conditional.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut x = Some(42);
    ///
    /// let prev = x.take_if(|v: &mut i32| -> bool {
    ///     if *v == 42 {
    ///         *v += 1;
    ///         false
    ///     } else {
    ///         false
    ///     }
    /// });
    /// assert_eq(x, Some(43));
    /// assert_eq(prev, None);
    ///
    /// let prev = x.take_if(|v: &mut i32| -> bool { *v == 43 });
    /// assert_eq(x, None);
    /// assert_eq(prev, Some(43));
    /// ```
    pub fn take_if(&mut self, predicate: fn(&mut T) -> bool) -> Option<T> {
        let hit = match self {
            Some(x) => predicate(x),
            None => false,
        };
        if hit { self.take() } else { None }
    }

    /// Inserts the default value into the option if it is [`None`], then
    /// returns a mutable reference to the contained value.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut x: Option<u32> = None;
    /// {
    ///     let y: &mut u32 = x.get_or_insert_default();
    ///     assert_eq(*y, 0);
    ///     *y = 7;
    /// }
    /// assert_eq(x, Some(7));
    /// ```
    pub fn get_or_insert_default(&mut self) -> &mut T
    where
        T: Default,
    {
        if self.is_none() {
            *self = Some(T::default());
        }
        match self {
            Some(x) => x,
            None => panic("unreachable"),
        }
    }

    /// Converts from `Option<T>` (or `&Option<T>`) to `Option<&T::Target>`:
    /// the value as its [`Deref`](crate::ops::Deref) target (`Option<String>`
    /// to `Option<&str>`).
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Option<String> = Some("hey".to_string());
    /// assert_eq(x.as_deref(), Some("hey"));
    ///
    /// let x: Option<String> = None;
    /// assert_eq(x.as_deref(), None);
    /// ```
    pub fn as_deref<U>(&self) -> Option<&U>
    where
        T: crate::ops::Deref<Target = U>,
    {
        match self {
            Some(x) => Some(x.deref()),
            None => None,
        }
    }

    /// Converts from `Option<T>` (or `&mut Option<T>`) to
    /// `Option<&mut T::Target>`, through [`DerefMut`](crate::ops::DerefMut).
    ///
    /// # Examples
    ///
    /// ```
    /// let mut x: Option<Vec<i32>> = Some(Vec::from([1, 2, 3]));
    /// match x.as_deref_mut() {
    ///     Some(s) => s.reverse(),
    ///     None => {}
    /// }
    /// assert_eq(x, Some(Vec::from([3, 2, 1])));
    /// ```
    pub fn as_deref_mut<U>(&mut self) -> Option<&mut U>
    where
        T: crate::ops::DerefMut<Target = U>,
    {
        match self {
            Some(x) => Some(x.deref_mut()),
            None => None,
        }
    }

    /// Returns a slice of the contained value, if any. If this is `None`, an
    /// empty slice is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(Some(1234).as_slice(), [1234].as_slice());
    /// let x: Option<i32> = None;
    /// assert(x.as_slice().is_empty());
    /// ```
    pub fn as_slice(&self) -> &[T] {
        match self {
            Some(x) => crate::rt::slice_from_raw(x as *const T, 1),
            None => crate::rt::slice_from_raw(crate::ptr::null::<T>(), 0),
        }
    }
}

impl<T, E> Option<Result<T, E>> {
    /// Transposes an `Option` of a [`Result`] into a [`Result`] of an `Option`.
    ///
    /// `None` will be mapped to `Ok(None)`. `Some(Ok(_))` and `Some(Err(_))`
    /// will be mapped to `Ok(Some(_))` and `Err(_)`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<Option<i32>, String> = Ok(Some(5));
    /// let y: Option<Result<i32, String>> = Some(Ok(5));
    /// assert_eq(x, y.transpose());
    /// ```
    pub fn transpose(self) -> Result<Option<T>, E> {
        match self {
            Some(Ok(x)) => Ok(Some(x)),
            Some(Err(e)) => Err(e),
            None => Ok(None),
        }
    }
}

impl<T, U> Option<(T, U)> {
    /// Unzips an option containing a tuple into a tuple of options.
    ///
    /// If `self` is `Some((a, b))` this method returns `(Some(a), Some(b))`.
    /// Otherwise, `(None, None)` is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = Some((1, "hi"));
    /// let y: Option<(u8, u32)> = None;
    ///
    /// assert_eq(x.unzip(), (Some(1), Some("hi")));
    /// assert_eq(y.unzip(), (None, None));
    /// ```
    pub fn unzip(self) -> (Option<T>, Option<U>) {
        match self {
            Some((a, b)) => (Some(a), Some(b)),
            None => (None, None),
        }
    }
}

impl<T: Clone> Option<&mut T> {
    /// Maps an `Option<&mut T>` to an `Option<T>` by cloning the contents of
    /// the option.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut x = 12;
    /// let opt_x = Some(&mut x);
    /// assert_eq(opt_x.cloned(), Some(12));
    /// ```
    pub fn cloned(self) -> Option<T> {
        match self {
            Some(x) => Some((*x).clone()),
            None => None,
        }
    }
}

impl<T> Option<&mut T> {
    /// Maps an `Option<&mut T>` to an `Option<T>` by copying the contents of
    /// the option (a shallow copy).
    ///
    /// # Examples
    ///
    /// ```
    /// let mut x = 12;
    /// let opt_x = Some(&mut x);
    /// assert_eq(opt_x.copied(), Some(12));
    /// ```
    pub fn copied(self) -> Option<T> {
        match self {
            Some(v) => Some(*v),
            None => None,
        }
    }
}

impl<T> From<T> for Option<T> {
    fn from(v: T) -> Option<T> {
        Some(v)
    }
}

impl<T> crate::iter::DoubleEndedIterator for IntoIter<T> {
    fn next_back(&mut self) -> Option<T> {
        self.v.take()
    }
}
impl<T> crate::iter::ExactSizeIterator for IntoIter<T> {
    fn len(&self) -> usize {
        if self.v.is_some() { 1 } else { 0 }
    }
}
impl<T: Clone> Clone for IntoIter<T> {
    fn clone(&self) -> IntoIter<T> {
        IntoIter { v: self.v.clone() }
    }
}

impl<T> crate::iter::IntoIterator for &Option<T> {
    type Item = &T;
    type IntoIter = IntoIter<&T>;
    fn into_iter(self) -> IntoIter<&T> {
        self.iter()
    }
}

/// Yields the values of an iterator of Options until the first None,
/// which it records (collect into Option<V>).
struct OptionShunt<I, A> {
    iter: I,
    failed: &mut bool,
    marker: Option<&A>,
}
impl<A, I> Iterator for OptionShunt<I, A>
where
    I: Iterator<Item = Option<A>>,
{
    type Item = A;
    fn next(&mut self) -> Option<A> {
        if *self.failed {
            return None;
        }
        match self.iter.next() {
            Some(Some(x)) => Some(x),
            Some(None) => {
                *self.failed = true;
                None
            }
            None => None,
        }
    }
}

impl<A, V> FromIterator<Option<A>> for Option<V>
where
    V: FromIterator<A>,
{
    fn from_iter<I: IntoIterator<Item = Option<A>>>(iter: I) -> Option<V> {
        let mut failed = false;
        let v = V::from_iter(OptionShunt {
            iter: iter.into_iter(),
            failed: &mut failed,
            marker: None,
        });
        if failed { None } else { Some(v) }
    }
}
