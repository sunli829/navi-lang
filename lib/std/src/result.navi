//! Error handling with the Result type.

#[derive(Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    pub fn is_ok(&self) -> bool { match self { Ok(_) => true, Err(_) => false } }
    pub fn is_err(&self) -> bool { !self.is_ok() }
    pub fn ok(self) -> Option<T> { match self { Ok(x) => Some(x), Err(_) => None } }
    pub fn err(self) -> Option<E> { match self { Ok(_) => None, Err(e) => Some(e) } }
    pub fn map<U>(self, f: fn(T) -> U) -> Result<U, E> { match self { Ok(x) => Ok(f(x)), Err(e) => Err(e) } }
    pub fn map_err<F>(self, f: fn(E) -> F) -> Result<T, F> { match self { Ok(x) => Ok(x), Err(e) => Err(f(e)) } }
    pub fn and_then<U>(self, f: fn(T) -> Result<U, E>) -> Result<U, E> { match self { Ok(x) => f(x), Err(e) => Err(e) } }
    pub fn unwrap_or(self, default: T) -> T { match self { Ok(x) => x, Err(_) => default } }
}

impl<T, E: crate::fmt::Debug> Result<T, E> {
    #[track_caller]
    pub fn unwrap(self) -> T {
        match self { Ok(x) => x, Err(e) => panic(`called Result::unwrap() on an Err value: ${e:?}`) }
    }
    #[track_caller]
    pub fn expect(self, msg: &str) -> T {
        match self { Ok(x) => x, Err(e) => panic(`${msg}: ${e:?}`) }
    }
}

impl<T, E> Result<T, E> {
    pub fn unwrap_or_else(self, f: fn(E) -> T) -> T { match self { Ok(v) => v, Err(e) => f(e) } }
    pub fn map_or<U>(self, default: U, f: fn(T) -> U) -> U { match self { Ok(v) => f(v), Err(_) => default } }
    pub fn and<U>(self, other: Result<U, E>) -> Result<U, E> { match self { Ok(_) => other, Err(e) => Err(e) } }
    pub fn or_else<F>(self, f: fn(E) -> Result<T, F>) -> Result<T, F> { match self { Ok(v) => Ok(v), Err(e) => f(e) } }
    pub fn is_ok_and(self, f: fn(T) -> bool) -> bool { match self { Ok(v) => f(v), Err(_) => false } }
    pub fn is_err_and(self, f: fn(E) -> bool) -> bool { match self { Ok(_) => false, Err(e) => f(e) } }
    pub fn as_ref(&self) -> Result<&T, &E> { match self { Ok(v) => Ok(v), Err(e) => Err(e) } }
    pub fn as_mut(&mut self) -> Result<&mut T, &mut E> { match self { Ok(v) => Ok(v), Err(e) => Err(e) } }
    pub fn iter(&self) -> crate::option::IntoIter<&T> { match self { Ok(v) => Some(v).into_iter(), Err(_) => None.into_iter() } }
}

impl<T, E: crate::fmt::Debug> Result<T, E> {
    #[track_caller]
    pub fn unwrap_or_default(self) -> T where T: Default { match self { Ok(v) => v, Err(_) => T::default() } }
}

impl<T: crate::fmt::Debug, E> Result<T, E> {
    #[track_caller]
    pub fn unwrap_err(self) -> E {
        match self { Ok(v) => panic(`called \`Result::unwrap_err()\` on an \`Ok\` value: ${v:?}`), Err(e) => e }
    }
    #[track_caller]
    pub fn expect_err(self, msg: &str) -> E {
        match self { Ok(v) => panic(`${msg}: ${v:?}`), Err(e) => e }
    }
}
