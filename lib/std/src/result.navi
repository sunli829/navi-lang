//! Error handling with the Result type.

#[derive(Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    #[inline]
    pub fn is_ok(&self) -> bool {
        match self {
            Ok(_) => true,
            Err(_) => false,
        }
    }
    #[inline]
    pub fn is_err(&self) -> bool {
        !self.is_ok()
    }
    pub fn ok(self) -> Option<T> {
        match self {
            Ok(x) => Some(x),
            Err(_) => None,
        }
    }
    pub fn err(self) -> Option<E> {
        match self {
            Ok(_) => None,
            Err(e) => Some(e),
        }
    }
    pub fn map<U>(self, f: fn(T) -> U) -> Result<U, E> {
        match self {
            Ok(x) => Ok(f(x)),
            Err(e) => Err(e),
        }
    }
    pub fn map_err<F>(self, f: fn(E) -> F) -> Result<T, F> {
        match self {
            Ok(x) => Ok(x),
            Err(e) => Err(f(e)),
        }
    }
    pub fn and_then<U>(self, f: fn(T) -> Result<U, E>) -> Result<U, E> {
        match self {
            Ok(x) => f(x),
            Err(e) => Err(e),
        }
    }
    #[inline]
    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Ok(x) => x,
            Err(_) => default,
        }
    }
}

impl<T, E: crate::fmt::Debug> Result<T, E> {
    #[track_caller]
    #[inline]
    pub fn unwrap(self) -> T {
        match self {
            Ok(x) => x,
            Err(e) => panic(`called Result::unwrap() on an Err value: ${e:?}`),
        }
    }
    #[track_caller]
    #[inline]
    pub fn expect(self, msg: &str) -> T {
        match self {
            Ok(x) => x,
            Err(e) => panic(`${msg}: ${e:?}`),
        }
    }
}

impl<T, E> Result<T, E> {
    pub fn unwrap_or_else(self, f: fn(E) -> T) -> T {
        match self {
            Ok(v) => v,
            Err(e) => f(e),
        }
    }
    pub fn map_or<U>(self, default: U, f: fn(T) -> U) -> U {
        match self {
            Ok(v) => f(v),
            Err(_) => default,
        }
    }
    pub fn and<U>(self, other: Result<U, E>) -> Result<U, E> {
        match self {
            Ok(_) => other,
            Err(e) => Err(e),
        }
    }
    pub fn or_else<F>(self, f: fn(E) -> Result<T, F>) -> Result<T, F> {
        match self {
            Ok(v) => Ok(v),
            Err(e) => f(e),
        }
    }
    pub fn is_ok_and(self, f: fn(T) -> bool) -> bool {
        match self {
            Ok(v) => f(v),
            Err(_) => false,
        }
    }
    pub fn is_err_and(self, f: fn(E) -> bool) -> bool {
        match self {
            Ok(_) => false,
            Err(e) => f(e),
        }
    }
    #[inline]
    pub fn as_ref(&self) -> Result<&T, &E> {
        match self {
            Ok(v) => Ok(v),
            Err(e) => Err(e),
        }
    }
    pub fn as_mut(&mut self) -> Result<&mut T, &mut E> {
        match self {
            Ok(v) => Ok(v),
            Err(e) => Err(e),
        }
    }
    pub fn iter(&self) -> crate::option::IntoIter<&T> {
        match self {
            Ok(v) => Some(v).into_iter(),
            Err(_) => None.into_iter(),
        }
    }
}

impl<T, E: crate::fmt::Debug> Result<T, E> {
    #[track_caller]
    pub fn unwrap_or_default(self) -> T
    where
        T: Default,
    {
        match self {
            Ok(v) => v,
            Err(_) => T::default(),
        }
    }
}

impl<T: crate::fmt::Debug, E> Result<T, E> {
    #[track_caller]
    pub fn unwrap_err(self) -> E {
        match self {
            Ok(v) => panic(`called \`Result::unwrap_err()\` on an \`Ok\` value: ${v:?}`),
            Err(e) => e,
        }
    }
    #[track_caller]
    pub fn expect_err(self, msg: &str) -> E {
        match self {
            Ok(v) => panic(`${msg}: ${v:?}`),
            Err(e) => e,
        }
    }
}

// ---------------------------------------------------------------------------

impl<T, E> Result<T, E> {
    pub fn or<F>(self, res: Result<T, F>) -> Result<T, F> {
        match self {
            Ok(v) => Ok(v),
            Err(_) => res,
        }
    }
    pub fn map_or_else<U>(self, default: fn(E) -> U, f: fn(T) -> U) -> U {
        match self {
            Ok(v) => f(v),
            Err(e) => default(e),
        }
    }
    pub fn inspect(self, f: fn(&T)) -> Result<T, E> {
        if let Ok(v) = &self {
            f(v);
        }
        self
    }
    pub fn inspect_err(self, f: fn(&E)) -> Result<T, E> {
        if let Err(e) = &self {
            f(e);
        }
        self
    }
    pub fn iter_mut(&mut self) -> crate::option::IntoIter<&mut T> {
        match self {
            Ok(v) => Some(v).into_iter(),
            Err(_) => None.into_iter(),
        }
    }
    /// The value as its Deref target (Result<String, E> to Result<&str, &E>).
    pub fn as_deref<U>(&self) -> Result<&U, &E>
    where
        T: crate::ops::Deref<Target = U>,
    {
        match self {
            Ok(v) => Ok(v.deref()),
            Err(e) => Err(e),
        }
    }
    pub fn as_deref_mut<U>(&mut self) -> Result<&mut U, &mut E>
    where
        T: crate::ops::DerefMut<Target = U>,
    {
        match self {
            Ok(v) => Ok(v.deref_mut()),
            Err(e) => Err(e),
        }
    }
    #[track_caller]
    pub fn unwrap_unchecked(self) -> T {
        match self {
            Ok(v) => v,
            Err(_) => panic("called `Result::unwrap_unchecked()` on an `Err` value"),
        }
    }
    #[track_caller]
    pub fn unwrap_err_unchecked(self) -> E {
        match self {
            Ok(_) => panic("called `Result::unwrap_err_unchecked()` on an `Ok` value"),
            Err(e) => e,
        }
    }
}

impl<T, E> Result<Option<T>, E> {
    /// Result<Option<T>, E> to Option<Result<T, E>>.
    pub fn transpose(self) -> Option<Result<T, E>> {
        match self {
            Ok(Some(x)) => Some(Ok(x)),
            Ok(None) => None,
            Err(e) => Some(Err(e)),
        }
    }
}

impl<T, E> Result<Result<T, E>, E> {
    pub fn flatten(self) -> Result<T, E> {
        match self {
            Ok(r) => r,
            Err(e) => Err(e),
        }
    }
}

impl<T: Clone, E> Result<&T, E> {
    pub fn cloned(self) -> Result<T, E> {
        match self {
            Ok(v) => Ok(v.clone()),
            Err(e) => Err(e),
        }
    }
}

impl<T, E> Result<&T, E> {
    pub fn copied(self) -> Result<T, E> {
        match self {
            Ok(v) => Ok(*v),
            Err(e) => Err(e),
        }
    }
}

impl<T: Clone, E> Result<&mut T, E> {
    pub fn cloned(self) -> Result<T, E> {
        match self {
            Ok(v) => Ok((*v).clone()),
            Err(e) => Err(e),
        }
    }
}

impl<T, E> Result<&mut T, E> {
    pub fn copied(self) -> Result<T, E> {
        match self {
            Ok(v) => Ok(*v),
            Err(e) => Err(e),
        }
    }
}

impl<T, E> crate::iter::IntoIterator for Result<T, E> {
    type Item = T;
    type IntoIter = crate::option::IntoIter<T>;
    fn into_iter(self) -> crate::option::IntoIter<T> {
        self.ok().into_iter()
    }
}

impl<T, E> crate::iter::IntoIterator for &Result<T, E> {
    type Item = &T;
    type IntoIter = crate::option::IntoIter<&T>;
    fn into_iter(self) -> crate::option::IntoIter<&T> {
        self.iter()
    }
}

/// Yields the values of an iterator of Results until the first Err,
/// which it records (collect into Result<V, E>).
struct ResultShunt<I, A, E> {
    iter: I,
    err: &mut Option<E>,
    marker: Option<&A>,
}
impl<A, E, I> Iterator for ResultShunt<I, A, E>
where
    I: Iterator<Item = Result<A, E>>,
{
    type Item = A;
    fn next(&mut self) -> Option<A> {
        if self.err.is_some() {
            return None;
        }
        match self.iter.next() {
            Some(Ok(x)) => Some(x),
            Some(Err(e)) => {
                *self.err = Some(e);
                None
            }
            None => None,
        }
    }
}

impl<A, E, V> FromIterator<Result<A, E>> for Result<V, E>
where
    V: FromIterator<A>,
{
    fn from_iter<I: IntoIterator<Item = Result<A, E>>>(iter: I) -> Result<V, E> {
        let mut err: Option<E> = None;
        let v = V::from_iter(ResultShunt {
            iter: iter.into_iter(),
            err: &mut err,
            marker: None,
        });
        match err {
            Some(e) => Err(e),
            None => Ok(v),
        }
    }
}
