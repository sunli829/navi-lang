//! Error handling with the `Result` type.
//!
//! [`Result<T, E>`](Result) is the type used for returning and propagating
//! errors. It is an enum with the variants, [`Ok(T)`](Ok), representing
//! success and containing a value, and [`Err(E)`](Err), representing error
//! and containing an error value.
//!
//! Functions return [`Result`] whenever errors are expected and
//! recoverable. In the `std` crate, [`Result`] is most prominently used for
//! I/O and parsing.
//!
//! A simple function returning [`Result`] might be defined and used like so:
//!
//! ```
//! #[derive(Debug, PartialEq)]
//! enum Version {
//!     Version1,
//!     Version2,
//! }
//!
//! fn parse_version(header: &[u8]) -> Result<Version, &str> {
//!     match header.get(0) {
//!         None => Err("invalid header length"),
//!         Some(1) => Ok(Version::Version1),
//!         Some(2) => Ok(Version::Version2),
//!         Some(_) => Err("invalid version"),
//!     }
//! }
//!
//! let version = parse_version(&[1, 2, 3, 4]);
//! match version {
//!     Ok(v) => println(`working with version: ${v:?}`),
//!     Err(e) => println(`error parsing header: ${e:?}`),
//! }
//! assert_eq(parse_version(&[]), Err("invalid header length"));
//! ```
//!
//! # The question mark operator, `?`
//!
//! In a function returning a [`Result`], `?` on a [`Result`] value returns
//! early with the error if it is [`Err`] (converted with [`From`] to the
//! function's error type), and otherwise gives the [`Ok`] value:
//!
//! ```
//! use std::num::ParseIntError;
//!
//! fn sum_of(a: &str, b: &str) -> Result<i32, ParseIntError> {
//!     let a: i32 = a.parse()?;
//!     let b: i32 = b.parse()?;
//!     Ok(a + b)
//! }
//!
//! assert_eq(sum_of("1", "2"), Ok(3));
//! assert(sum_of("1", "x").is_err());
//! ```
//!
//! # Collecting
//!
//! An iterator of `Result<A, E>` can be collected into a `Result<V, E>`
//! (where `V` collects `A`s): the first error stops the collection and is
//! the result.
//!
//! ```
//! let v: Vec<Result<i32, String>> = Vec::from([Ok(1), Ok(2)]);
//! let ok: Result<Vec<i32>, String> = v.into_iter().collect();
//! assert_eq(ok, Ok(Vec::from([1, 2])));
//!
//! let v: Vec<Result<i32, String>> = Vec::from([Ok(1), Err("bad".to_string()), Ok(3)]);
//! let err: Result<Vec<i32>, String> = v.into_iter().collect();
//! assert_eq(err, Err("bad".to_string()));
//! ```

/// `Result` is a type that represents either success ([`Ok`]) or failure
/// ([`Err`]).
///
/// See the [module documentation](self) for details.
///
/// # Examples
///
/// ```
/// fn half(x: i32) -> Result<i32, String> {
///     if x % 2 == 0 {
///         Ok(x / 2)
///     } else {
///         Err(`${x} is odd`.to_string())
///     }
/// }
///
/// assert_eq(half(10), Ok(5));
/// assert_eq(half(3), Err("3 is odd".to_string()));
/// ```
#[derive(Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
pub enum Result<T, E> {
    /// Contains the success value.
    Ok(T),
    /// Contains the error value.
    Err(E),
}

impl<T, E> Result<T, E> {
    /// Returns `true` if the result is [`Ok`].
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<i32, &str> = Ok(-3);
    /// assert_eq(x.is_ok(), true);
    ///
    /// let x: Result<i32, &str> = Err("Some error message");
    /// assert_eq(x.is_ok(), false);
    /// ```
    #[inline]
    pub fn is_ok(&self) -> bool {
        match self {
            Ok(_) => true,
            Err(_) => false,
        }
    }

    /// Returns `true` if the result is [`Err`].
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<i32, &str> = Ok(-3);
    /// assert_eq(x.is_err(), false);
    ///
    /// let x: Result<i32, &str> = Err("Some error message");
    /// assert_eq(x.is_err(), true);
    /// ```
    #[inline]
    pub fn is_err(&self) -> bool {
        !self.is_ok()
    }

    /// Converts from `Result<T, E>` to [`Option<T>`](Option), discarding the
    /// error, if any.
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<u32, &str> = Ok(2);
    /// assert_eq(x.ok(), Some(2));
    ///
    /// let x: Result<u32, &str> = Err("Nothing here");
    /// assert_eq(x.ok(), None);
    /// ```
    pub fn ok(self) -> Option<T> {
        match self {
            Ok(x) => Some(x),
            Err(_) => None,
        }
    }

    /// Converts from `Result<T, E>` to [`Option<E>`](Option), discarding the
    /// success value, if any.
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<u32, &str> = Ok(2);
    /// assert_eq(x.err(), None);
    ///
    /// let x: Result<u32, &str> = Err("Nothing here");
    /// assert_eq(x.err(), Some("Nothing here"));
    /// ```
    pub fn err(self) -> Option<E> {
        match self {
            Ok(_) => None,
            Err(e) => Some(e),
        }
    }

    /// Maps a `Result<T, E>` to `Result<U, E>` by applying a function to a
    /// contained [`Ok`] value, leaving an [`Err`] value untouched.
    ///
    /// This function can be used to compose the results of two functions.
    ///
    /// # Examples
    ///
    /// ```
    /// let line = "1\n2\n3\n4\n";
    ///
    /// let mut doubled = Vec::new();
    /// for num in line.lines() {
    ///     match num.parse::<i32>().map(|i| i * 2) {
    ///         Ok(n) => doubled.push(n),
    ///         Err(_) => {}
    ///     }
    /// }
    /// assert_eq(doubled, [2, 4, 6, 8]);
    /// ```
    pub fn map<U>(self, f: fn(T) -> U) -> Result<U, E> {
        match self {
            Ok(x) => Ok(f(x)),
            Err(e) => Err(e),
        }
    }

    /// Maps a `Result<T, E>` to `Result<T, F>` by applying a function to a
    /// contained [`Err`] value, leaving an [`Ok`] value untouched.
    ///
    /// This function can be used to pass through a successful result while
    /// handling an error.
    ///
    /// # Examples
    ///
    /// ```
    /// fn stringify(x: u32) -> String { `error code: ${x}`.to_string() }
    ///
    /// let x: Result<u32, u32> = Ok(2);
    /// assert_eq(x.map_err(stringify), Ok(2));
    ///
    /// let x: Result<u32, u32> = Err(13);
    /// assert_eq(x.map_err(stringify), Err("error code: 13".to_string()));
    /// ```
    pub fn map_err<F>(self, f: fn(E) -> F) -> Result<T, F> {
        match self {
            Ok(x) => Ok(x),
            Err(e) => Err(f(e)),
        }
    }

    /// Calls `f` if the result is [`Ok`], otherwise returns the [`Err`] value
    /// of `self`.
    ///
    /// This function can be used for control flow based on `Result` values.
    ///
    /// # Examples
    ///
    /// ```
    /// fn sq_then_to_string(x: u32) -> Result<String, &str> {
    ///     x.checked_mul(x).map(|sq: u32| -> String { sq.to_string() }).ok_or("overflowed")
    /// }
    ///
    /// assert_eq(Ok(2).and_then(sq_then_to_string), Ok("4".to_string()));
    /// assert_eq(Ok(1_000_000).and_then(sq_then_to_string), Err("overflowed"));
    /// assert_eq(Err("not a number").and_then(sq_then_to_string), Err("not a number"));
    /// ```
    pub fn and_then<U>(self, f: fn(T) -> Result<U, E>) -> Result<U, E> {
        match self {
            Ok(x) => f(x),
            Err(e) => Err(e),
        }
    }

    /// Returns the contained [`Ok`] value or a provided default.
    ///
    /// The default is evaluated before the call even when it is not used; to
    /// compute it only when needed, use [`Result::unwrap_or_else`].
    ///
    /// # Examples
    ///
    /// ```
    /// let default = 2;
    /// let x: Result<u32, &str> = Ok(9);
    /// assert_eq(x.unwrap_or(default), 9);
    ///
    /// let x: Result<u32, &str> = Err("error");
    /// assert_eq(x.unwrap_or(default), default);
    /// ```
    #[inline]
    pub fn unwrap_or(self, default: T) -> T {
        match self {
            Ok(x) => x,
            Err(_) => default,
        }
    }
}

impl<T, E: crate::fmt::Debug> Result<T, E> {
    /// Returns the contained [`Ok`] value.
    ///
    /// Because this function may panic, its use is generally discouraged.
    /// Instead, prefer to use pattern matching or `?` and handle the [`Err`]
    /// case explicitly, or call [`Result::unwrap_or`],
    /// [`Result::unwrap_or_else`], or [`Result::unwrap_or_default`].
    ///
    /// # Panics
    ///
    /// Panics if the value is an [`Err`], with a panic message including the
    /// error's [`Debug`](crate::fmt::Debug) form: "called Result::unwrap() on
    /// an Err value: ...".
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<u32, &str> = Ok(2);
    /// assert_eq(x.unwrap(), 2);
    /// ```
    ///
    /// ```should_panic
    /// let x: Result<u32, &str> = Err("emergency failure");
    /// x.unwrap(); // panics with `called Result::unwrap() on an Err value: "emergency failure"`
    /// ```
    #[track_caller]
    #[inline]
    pub fn unwrap(self) -> T {
        match self {
            Ok(x) => x,
            Err(e) => panic(`called Result::unwrap() on an Err value: ${e:?}`),
        }
    }

    /// Returns the contained [`Ok`] value.
    ///
    /// # Panics
    ///
    /// Panics if the value is an [`Err`], with a panic message of `msg`, a
    /// colon, and the error's [`Debug`](crate::fmt::Debug) form.
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<u32, &str> = Ok(2);
    /// assert_eq(x.expect("Testing expect"), 2);
    /// ```
    ///
    /// ```should_panic
    /// let x: Result<u32, &str> = Err("emergency failure");
    /// x.expect("Testing expect"); // panics with `Testing expect: "emergency failure"`
    /// ```
    #[track_caller]
    #[inline]
    pub fn expect(self, msg: &str) -> T {
        match self {
            Ok(x) => x,
            Err(e) => panic(`${msg}: ${e:?}`),
        }
    }
}

impl<T, E> Result<T, E> {
    /// Returns the contained [`Ok`] value or computes it from the error with a
    /// closure.
    ///
    /// # Examples
    ///
    /// ```
    /// fn count(x: &str) -> usize { x.len() }
    ///
    /// assert_eq(Ok(2).unwrap_or_else(count), 2);
    /// assert_eq(Err("foo").unwrap_or_else(count), 3);
    /// ```
    pub fn unwrap_or_else(self, f: fn(E) -> T) -> T {
        match self {
            Ok(v) => v,
            Err(e) => f(e),
        }
    }

    /// Returns the provided default (if [`Err`]), or applies a function to the
    /// contained value (if [`Ok`]).
    ///
    /// The default is evaluated before the call even when it is not used; to
    /// compute it only when needed, use [`Result::map_or_else`].
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<&str, &str> = Ok("foo");
    /// assert_eq(x.map_or(42, |v: &str| -> usize { v.len() }), 3);
    ///
    /// let x: Result<&str, &str> = Err("bar");
    /// assert_eq(x.map_or(42, |v: &str| -> usize { v.len() }), 42);
    /// ```
    pub fn map_or<U>(self, default: U, f: fn(T) -> U) -> U {
        match self {
            Ok(v) => f(v),
            Err(_) => default,
        }
    }

    /// Returns `other` if the result is [`Ok`], otherwise returns the [`Err`]
    /// value of `self`.
    ///
    /// `other` is evaluated before the call even when it is not used; to
    /// compute it only when needed, use [`Result::and_then`].
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<u32, &str> = Ok(2);
    /// let y: Result<&str, &str> = Err("late error");
    /// assert_eq(x.and(y), Err("late error"));
    ///
    /// let x: Result<u32, &str> = Err("early error");
    /// let y: Result<&str, &str> = Ok("foo");
    /// assert_eq(x.and(y), Err("early error"));
    ///
    /// let x: Result<u32, &str> = Ok(2);
    /// let y: Result<&str, &str> = Ok("different result type");
    /// assert_eq(x.and(y), Ok("different result type"));
    /// ```
    pub fn and<U>(self, other: Result<U, E>) -> Result<U, E> {
        match self {
            Ok(_) => other,
            Err(e) => Err(e),
        }
    }

    /// Calls `f` if the result is [`Err`], otherwise returns the [`Ok`] value
    /// of `self`.
    ///
    /// This function can be used for control flow based on result values.
    ///
    /// # Examples
    ///
    /// ```
    /// fn sq(x: u32) -> Result<u32, u32> { Ok(x * x) }
    /// fn err(x: u32) -> Result<u32, u32> { Err(x) }
    ///
    /// assert_eq(Ok(2).or_else(sq).or_else(sq), Ok(2));
    /// assert_eq(Ok(2).or_else(err).or_else(sq), Ok(2));
    /// assert_eq(Err(3).or_else(sq).or_else(err), Ok(9));
    /// assert_eq(Err(3).or_else(err).or_else(err), Err(3));
    /// ```
    pub fn or_else<F>(self, f: fn(E) -> Result<T, F>) -> Result<T, F> {
        match self {
            Ok(v) => Ok(v),
            Err(e) => f(e),
        }
    }

    /// Returns `true` if the result is [`Ok`] and the value inside of it
    /// matches a predicate.
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<u32, &str> = Ok(2);
    /// assert_eq(x.is_ok_and(|x| x > 1), true);
    ///
    /// let x: Result<u32, &str> = Ok(0);
    /// assert_eq(x.is_ok_and(|x| x > 1), false);
    ///
    /// let x: Result<u32, &str> = Err("hey");
    /// assert_eq(x.is_ok_and(|x| x > 1), false);
    /// ```
    pub fn is_ok_and(self, f: fn(T) -> bool) -> bool {
        match self {
            Ok(v) => f(v),
            Err(_) => false,
        }
    }

    /// Returns `true` if the result is [`Err`] and the value inside of it
    /// matches a predicate.
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<u32, &str> = Err("not found");
    /// assert_eq(x.is_err_and(|e: &str| -> bool { e == "not found" }), true);
    ///
    /// let x: Result<u32, &str> = Err("permission denied");
    /// assert_eq(x.is_err_and(|e: &str| -> bool { e == "not found" }), false);
    ///
    /// let x: Result<u32, &str> = Ok(123);
    /// assert_eq(x.is_err_and(|e: &str| -> bool { e == "not found" }), false);
    /// ```
    pub fn is_err_and(self, f: fn(E) -> bool) -> bool {
        match self {
            Ok(_) => false,
            Err(e) => f(e),
        }
    }

    /// Converts from `&Result<T, E>` to `Result<&T, &E>`.
    ///
    /// Produces a new `Result`, containing a reference into the original,
    /// leaving the original in place.
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<u32, &str> = Ok(2);
    /// assert_eq(x.as_ref(), Ok(&2));
    ///
    /// let x: Result<u32, &str> = Err("Error");
    /// assert_eq(x.as_ref(), Err(&"Error"));
    /// ```
    #[inline]
    pub fn as_ref(&self) -> Result<&T, &E> {
        match self {
            Ok(v) => Ok(v),
            Err(e) => Err(e),
        }
    }

    /// Converts from `&mut Result<T, E>` to `Result<&mut T, &mut E>`.
    ///
    /// # Examples
    ///
    /// ```
    /// fn mutate(r: &mut Result<i32, i32>) {
    ///     match r.as_mut() {
    ///         Ok(v) => *v = 42,
    ///         Err(e) => *e = 0,
    ///     }
    /// }
    ///
    /// let mut x: Result<i32, i32> = Ok(2);
    /// mutate(&mut x);
    /// assert_eq(x.unwrap(), 42);
    ///
    /// let mut x: Result<i32, i32> = Err(13);
    /// mutate(&mut x);
    /// assert_eq(x.unwrap_err(), 0);
    /// ```
    pub fn as_mut(&mut self) -> Result<&mut T, &mut E> {
        match self {
            Ok(v) => Ok(v),
            Err(e) => Err(e),
        }
    }

    /// Returns an iterator over the possibly contained value.
    ///
    /// The iterator yields one value if the result is [`Ok`], otherwise none.
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<u32, &str> = Ok(7);
    /// assert_eq(x.iter().next(), Some(&7));
    ///
    /// let x: Result<u32, &str> = Err("nothing!");
    /// assert_eq(x.iter().next(), None);
    /// ```
    pub fn iter(&self) -> crate::option::IntoIter<&T> {
        match self {
            Ok(v) => Some(v).into_iter(),
            Err(_) => None.into_iter(),
        }
    }
}

impl<T, E: crate::fmt::Debug> Result<T, E> {
    /// Returns the contained [`Ok`] value or a default.
    ///
    /// If [`Ok`], returns the contained value, otherwise if [`Err`], returns
    /// the default value for that type. (Unlike Rust's, it needs the error
    /// type to implement [`Debug`](crate::fmt::Debug).)
    ///
    /// # Examples
    ///
    /// ```
    /// let good_year: Result<i32, std::num::ParseIntError> = "1909".parse();
    /// let bad_year: Result<i32, std::num::ParseIntError> = "190blarg".parse();
    ///
    /// assert_eq(good_year.unwrap_or_default(), 1909);
    /// assert_eq(bad_year.unwrap_or_default(), 0);
    /// ```
    #[track_caller]
    pub fn unwrap_or_default(self) -> T
    where
        T: Default,
    {
        match self {
            Ok(v) => v,
            Err(_) => T::default(),
        }
    }
}

impl<T: crate::fmt::Debug, E> Result<T, E> {
    /// Returns the contained [`Err`] value.
    ///
    /// # Panics
    ///
    /// Panics if the value is an [`Ok`], with a panic message including the
    /// [`Ok`] value's [`Debug`](crate::fmt::Debug) form.
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<u32, &str> = Err("emergency failure");
    /// assert_eq(x.unwrap_err(), "emergency failure");
    /// ```
    ///
    /// ```should_panic
    /// let x: Result<u32, &str> = Ok(2);
    /// x.unwrap_err(); // panics with `called `Result::unwrap_err()` on an `Ok` value: 2`
    /// ```
    #[track_caller]
    pub fn unwrap_err(self) -> E {
        match self {
            Ok(v) => panic(`called \`Result::unwrap_err()\` on an \`Ok\` value: ${v:?}`),
            Err(e) => e,
        }
    }

    /// Returns the contained [`Err`] value.
    ///
    /// # Panics
    ///
    /// Panics if the value is an [`Ok`], with a panic message of `msg`, a
    /// colon, and the [`Ok`] value's [`Debug`](crate::fmt::Debug) form.
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<u32, &str> = Err("failed");
    /// assert_eq(x.expect_err("Testing expect_err"), "failed");
    /// ```
    ///
    /// ```should_panic
    /// let x: Result<u32, &str> = Ok(10);
    /// x.expect_err("Testing expect_err"); // panics with `Testing expect_err: 10`
    /// ```
    #[track_caller]
    pub fn expect_err(self, msg: &str) -> E {
        match self {
            Ok(v) => panic(`${msg}: ${v:?}`),
            Err(e) => e,
        }
    }
}

// ---------------------------------------------------------------------------

impl<T, E> Result<T, E> {
    /// Returns `res` if the result is [`Err`], otherwise returns the [`Ok`]
    /// value of `self`.
    ///
    /// `res` is evaluated before the call even when it is not used; to compute
    /// it only when needed, use [`Result::or_else`].
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<u32, &str> = Ok(2);
    /// let y: Result<u32, &str> = Err("late error");
    /// assert_eq(x.or(y), Ok(2));
    ///
    /// let x: Result<u32, &str> = Err("early error");
    /// let y: Result<u32, &str> = Ok(2);
    /// assert_eq(x.or(y), Ok(2));
    ///
    /// let x: Result<u32, &str> = Err("not a 2");
    /// let y: Result<u32, &str> = Err("late error");
    /// assert_eq(x.or(y), Err("late error"));
    /// ```
    pub fn or<F>(self, res: Result<T, F>) -> Result<T, F> {
        match self {
            Ok(v) => Ok(v),
            Err(_) => res,
        }
    }

    /// Maps a `Result<T, E>` to `U` by applying fallback function `default` to
    /// a contained [`Err`] value, or function `f` to a contained [`Ok`] value.
    ///
    /// This function can be used to unpack a successful result while handling
    /// an error.
    ///
    /// # Examples
    ///
    /// ```
    /// let k = 21;
    ///
    /// let x: Result<&str, &str> = Ok("foo");
    /// assert_eq(x.map_or_else(|e: &str| -> usize { k * 2 }, |v: &str| -> usize { v.len() }), 3);
    ///
    /// let x: Result<&str, &str> = Err("bar");
    /// assert_eq(x.map_or_else(|e: &str| -> usize { k * 2 }, |v: &str| -> usize { v.len() }), 42);
    /// ```
    pub fn map_or_else<U>(self, default: fn(E) -> U, f: fn(T) -> U) -> U {
        match self {
            Ok(v) => f(v),
            Err(e) => default(e),
        }
    }

    /// Calls `f` with a reference to the contained value if [`Ok`], and
    /// returns the result unchanged.
    ///
    /// # Examples
    ///
    /// ```
    /// let x: u8 = "4"
    ///     .parse::<u8>()
    ///     .inspect(|x: &u8| println(`original: ${x}`))
    ///     .map(|x| x * x)
    ///     .expect("failed to parse number");
    /// assert_eq(x, 16);
    /// ```
    pub fn inspect(self, f: fn(&T)) -> Result<T, E> {
        if let Ok(v) = &self {
            f(v);
        }
        self
    }

    /// Calls `f` with a reference to the contained error if [`Err`], and
    /// returns the result unchanged.
    ///
    /// # Examples
    ///
    /// ```
    /// let r: Result<i32, String> = Err("no such file".to_string());
    /// let r = r.inspect_err(|e: &String| eprintln(`failed: ${e}`));
    /// assert(r.is_err());
    /// ```
    pub fn inspect_err(self, f: fn(&E)) -> Result<T, E> {
        if let Err(e) = &self {
            f(e);
        }
        self
    }

    /// Returns a mutable iterator over the possibly contained value.
    ///
    /// The iterator yields one value if the result is [`Ok`], otherwise none.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut x: Result<u32, &str> = Ok(7);
    /// match x.iter_mut().next() {
    ///     Some(v) => *v = 40,
    ///     None => {}
    /// }
    /// assert_eq(x, Ok(40));
    ///
    /// let mut x: Result<u32, &str> = Err("nothing!");
    /// assert_eq(x.iter_mut().next(), None);
    /// ```
    pub fn iter_mut(&mut self) -> crate::option::IntoIter<&mut T> {
        match self {
            Ok(v) => Some(v).into_iter(),
            Err(_) => None.into_iter(),
        }
    }

    /// Converts from `Result<T, E>` (or `&Result<T, E>`) to
    /// `Result<&T::Target, &E>`: the value as its
    /// [`Deref`](crate::ops::Deref) target (`Result<String, E>` to
    /// `Result<&str, &E>`).
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<String, u32> = Ok("hello".to_string());
    /// let y: Result<&str, &u32> = Ok("hello");
    /// assert_eq(x.as_deref(), y);
    ///
    /// let x: Result<String, u32> = Err(42);
    /// let y: Result<&str, &u32> = Err(&42);
    /// assert_eq(x.as_deref(), y);
    /// ```
    pub fn as_deref<U>(&self) -> Result<&U, &E>
    where
        T: crate::ops::Deref<Target = U>,
    {
        match self {
            Ok(v) => Ok(v.deref()),
            Err(e) => Err(e),
        }
    }

    /// Converts from `Result<T, E>` (or `&mut Result<T, E>`) to
    /// `Result<&mut T::Target, &mut E>`, through
    /// [`DerefMut`](crate::ops::DerefMut).
    ///
    /// # Examples
    ///
    /// ```
    /// let mut x: Result<Vec<i32>, u32> = Ok(Vec::from([3, 1, 2]));
    /// match x.as_deref_mut() {
    ///     Ok(s) => s.sort(),
    ///     Err(_) => {}
    /// }
    /// assert_eq(x, Ok(Vec::from([1, 2, 3])));
    /// ```
    pub fn as_deref_mut<U>(&mut self) -> Result<&mut U, &mut E>
    where
        T: crate::ops::DerefMut<Target = U>,
    {
        match self {
            Ok(v) => Ok(v.deref_mut()),
            Err(e) => Err(e),
        }
    }

    /// Returns the contained [`Ok`] value.
    ///
    /// In Rust this is an `unsafe` function that skips the check; in navi it
    /// is safe and checks.
    ///
    /// # Panics
    ///
    /// Panics if the value is an [`Err`].
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<u32, &str> = Ok(2);
    /// assert_eq(x.unwrap_unchecked(), 2);
    /// ```
    #[track_caller]
    pub fn unwrap_unchecked(self) -> T {
        match self {
            Ok(v) => v,
            Err(_) => panic("called `Result::unwrap_unchecked()` on an `Err` value"),
        }
    }

    /// Returns the contained [`Err`] value.
    ///
    /// In Rust this is an `unsafe` function that skips the check; in navi it
    /// is safe and checks.
    ///
    /// # Panics
    ///
    /// Panics if the value is an [`Ok`].
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<u32, &str> = Err("emergency failure");
    /// assert_eq(x.unwrap_err_unchecked(), "emergency failure");
    /// ```
    #[track_caller]
    pub fn unwrap_err_unchecked(self) -> E {
        match self {
            Ok(_) => panic("called `Result::unwrap_err_unchecked()` on an `Ok` value"),
            Err(e) => e,
        }
    }
}

impl<T, E> Result<Option<T>, E> {
    /// Transposes a `Result` of an `Option` into an `Option` of a `Result`.
    ///
    /// `Ok(None)` will be mapped to `None`. `Ok(Some(_))` and `Err(_)` will be
    /// mapped to `Some(Ok(_))` and `Some(Err(_))`.
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<Option<i32>, String> = Ok(Some(5));
    /// let y: Option<Result<i32, String>> = Some(Ok(5));
    /// assert_eq(x.transpose(), y);
    /// ```
    pub fn transpose(self) -> Option<Result<T, E>> {
        match self {
            Ok(Some(x)) => Some(Ok(x)),
            Ok(None) => None,
            Err(e) => Some(Err(e)),
        }
    }
}

impl<T, E> Result<Result<T, E>, E> {
    /// Converts from `Result<Result<T, E>, E>` to `Result<T, E>`.
    ///
    /// Flattening only removes one level of nesting at a time.
    ///
    /// # Examples
    ///
    /// ```
    /// let x: Result<Result<&str, u32>, u32> = Ok(Ok("hello"));
    /// assert_eq(Ok("hello"), x.flatten());
    ///
    /// let x: Result<Result<&str, u32>, u32> = Ok(Err(6));
    /// assert_eq(Err(6), x.flatten());
    ///
    /// let x: Result<Result<&str, u32>, u32> = Err(6);
    /// assert_eq(Err(6), x.flatten());
    /// ```
    pub fn flatten(self) -> Result<T, E> {
        match self {
            Ok(r) => r,
            Err(e) => Err(e),
        }
    }
}

impl<T: Clone, E> Result<&T, E> {
    /// Maps a `Result<&T, E>` to a `Result<T, E>` by cloning the contents of
    /// the `Ok` part.
    ///
    /// # Examples
    ///
    /// ```
    /// let val = 12;
    /// let x: Result<&i32, i32> = Ok(&val);
    /// assert_eq(x, Ok(&12));
    /// let cloned = x.cloned();
    /// assert_eq(cloned, Ok(12));
    /// ```
    pub fn cloned(self) -> Result<T, E> {
        match self {
            Ok(v) => Ok(v.clone()),
            Err(e) => Err(e),
        }
    }
}

impl<T, E> Result<&T, E> {
    /// Maps a `Result<&T, E>` to a `Result<T, E>` by copying the contents of
    /// the `Ok` part (a shallow copy: see [`Result::cloned`] for a deep one).
    ///
    /// # Examples
    ///
    /// ```
    /// let val = 12;
    /// let x: Result<&i32, i32> = Ok(&val);
    /// assert_eq(x, Ok(&12));
    /// let copied = x.copied();
    /// assert_eq(copied, Ok(12));
    /// ```
    pub fn copied(self) -> Result<T, E> {
        match self {
            Ok(v) => Ok(*v),
            Err(e) => Err(e),
        }
    }
}

impl<T: Clone, E> Result<&mut T, E> {
    /// Maps a `Result<&mut T, E>` to a `Result<T, E>` by cloning the contents
    /// of the `Ok` part.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut val = 12;
    /// let x: Result<&mut i32, i32> = Ok(&mut val);
    /// assert_eq(x.cloned(), Ok(12));
    /// ```
    pub fn cloned(self) -> Result<T, E> {
        match self {
            Ok(v) => Ok((*v).clone()),
            Err(e) => Err(e),
        }
    }
}

impl<T, E> Result<&mut T, E> {
    /// Maps a `Result<&mut T, E>` to a `Result<T, E>` by copying the contents
    /// of the `Ok` part (a shallow copy).
    ///
    /// # Examples
    ///
    /// ```
    /// let mut val = 12;
    /// let x: Result<&mut i32, i32> = Ok(&mut val);
    /// assert_eq(x.copied(), Ok(12));
    /// ```
    pub fn copied(self) -> Result<T, E> {
        match self {
            Ok(v) => Ok(*v),
            Err(e) => Err(e),
        }
    }
}

impl<T, E> crate::iter::IntoIterator for Result<T, E> {
    type Item = T;
    type IntoIter = crate::option::IntoIter<T>;
    fn into_iter(self) -> crate::option::IntoIter<T> {
        self.ok().into_iter()
    }
}

impl<T, E> crate::iter::IntoIterator for &Result<T, E> {
    type Item = &T;
    type IntoIter = crate::option::IntoIter<&T>;
    fn into_iter(self) -> crate::option::IntoIter<&T> {
        self.iter()
    }
}

/// Yields the values of an iterator of Results until the first Err,
/// which it records (collect into Result<V, E>).
struct ResultShunt<I, A, E> {
    iter: I,
    err: &mut Option<E>,
    marker: Option<&A>,
}

impl<A, E, I> Iterator for ResultShunt<I, A, E>
where
    I: Iterator<Item = Result<A, E>>,
{
    type Item = A;
    fn next(&mut self) -> Option<A> {
        if self.err.is_some() {
            return None;
        }
        match self.iter.next() {
            Some(Ok(x)) => Some(x),
            Some(Err(e)) => {
                *self.err = Some(e);
                None
            }
            None => None,
        }
    }
}

impl<A, E, V> FromIterator<Result<A, E>> for Result<V, E>
where
    V: FromIterator<A>,
{
    fn from_iter<I: IntoIterator<Item = Result<A, E>>>(iter: I) -> Result<V, E> {
        let mut err: Option<E> = None;
        let v = V::from_iter(ResultShunt {
            iter: iter.into_iter(),
            err: &mut err,
            marker: None,
        });
        match err {
            Some(e) => Err(e),
            None => Ok(v),
        }
    }
}
