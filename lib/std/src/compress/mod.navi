//! DEFLATE, zlib and gzip compression and decompression.
//!
//! This module covers what Go's `compress/flate`, `compress/zlib` and
//! `compress/gzip` packages do, with the API of Rust's [flate2] crate. Three
//! formats are supported, all built on the DEFLATE algorithm:
//!
//! * raw DEFLATE ([RFC 1951]): [`crate::compress::read::DeflateEncoder`],
//!   [`crate::compress::read::DeflateDecoder`] and the `write::` ones;
//! * zlib ([RFC 1950]): DEFLATE with a 2-byte header and an Adler-32
//!   checksum: [`crate::compress::read::ZlibEncoder`],
//!   [`crate::compress::read::ZlibDecoder`], ...;
//! * gzip ([RFC 1952]): DEFLATE with a header (file name, comment,
//!   modification time, ...) and a CRC-32 trailer:
//!   [`crate::compress::read::GzEncoder`],
//!   [`crate::compress::read::GzDecoder`],
//!   [`crate::compress::read::MultiGzDecoder`], [`crate::compress::GzBuilder`].
//!
//! Each encoder and decoder comes in two flavors:
//!
//! * [`crate::compress::read`]: wraps a [`crate::io::Read`] and is itself a
//!   reader; reading from it gives the compressed (encoders) or
//!   decompressed (decoders) form of what the inner reader gives;
//! * [`crate::compress::write`]: wraps a [`crate::io::Write`] and is itself
//!   a writer; what is written to it is compressed (encoders) or
//!   decompressed (decoders) into the inner writer.
//!
//! As in flate2, the types are also reachable per format
//! (`compress::gzip::read::GzDecoder`, `compress::zlib::write::ZlibEncoder`,
//! ...), and the decoders that read and the encoders that write are
//! re-exported at the top of this module.
//!
//! The implementation is navi's own (no zlib or miniz): the encoder is a
//! hash-chain LZ77 (with lazy matching from level 4 up) followed by dynamic
//! Huffman coding, giving compression ratios close to zlib's; the decoder
//! handles every block type. The output is compatible with zlib, Python's
//! `zlib`/`gzip` modules and the `gzip` command.
//!
//! # Differences from flate2
//!
//! * There is no `Drop`: a `write::` encoder or decoder must be ended with
//!   `finish()` (which returns the inner writer) or `try_finish()`;
//!   otherwise the end of the stream is never written.
//! * The `write::` decoders keep everything written to them and decompress
//!   it all at `finish`/`try_finish`.
//! * There are no `bufread::` types, no low-level `Compress`/`Decompress`,
//!   no `GzHeader::mtime_as_datetime` and no zlib preset dictionaries.
//!
//! # Examples
//!
//! A gzip round trip:
//!
//! ```
//! use std::compress::Compression;
//! use std::compress::read::GzDecoder;
//! use std::compress::write::GzEncoder;
//! use std::io::{Read, Write};
//!
//! fn main() -> std::io::Result<()> {
//!     let mut e = GzEncoder::new(Vec::new(), Compression::default());
//!     e.write_all(b"hello, hello, hello")?;
//!     // No Drop: finish writes the end of the stream and the trailer.
//!     let gz: Vec<u8> = e.finish()?;
//!     assert_eq(&gz[0..2], b"\x1f\x8b");
//!
//!     let mut d = GzDecoder::new(gz.as_slice());
//!     let mut s = String::new();
//!     d.read_to_string(&mut s)?;
//!     assert_eq(s, "hello, hello, hello");
//!     Ok(())
//! }
//! ```
//!
//! Decoding a zlib stream made by Python's `zlib.compress(b"Hello, world!")`:
//!
//! ```
//! use std::compress::read::ZlibDecoder;
//! use std::hex;
//! use std::io::Read;
//!
//! let z = hex::decode("789cf348cdc9c9d75128cf2fca49510400205e048a").unwrap();
//! let mut s = String::new();
//! ZlibDecoder::new(z.as_slice()).read_to_string(&mut s).unwrap();
//! assert_eq(s, "Hello, world!");
//! ```
//!
//! [flate2]: https://docs.rs/flate2
//! [RFC 1950]: https://www.rfc-editor.org/rfc/rfc1950
//! [RFC 1951]: https://www.rfc-editor.org/rfc/rfc1951
//! [RFC 1952]: https://www.rfc-editor.org/rfc/rfc1952

mod deflate_enc;
mod inflate;

use crate::fmt::{self, Debug, Formatter};
use crate::hash::adler32::Adler32;
use crate::hash::crc32;
use crate::io::{self, Read, Write};
use deflate_enc::Deflater;
use inflate::{Bits, Inflater};

/// When compressing data, the compression level can be specified by a value
/// in this struct.
///
/// The level is an integer from 0 to 9: 0 stores the data without
/// compressing it, 1 is the fastest, 9 compresses the most. The default
/// ([`Compression::default`]) is 6, as zlib's. Levels above 9 compress as 9.
///
/// # Examples
///
/// ```
/// use std::compress::Compression;
/// use std::compress::write::ZlibEncoder;
/// use std::io::Write;
///
/// let data = b"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
///
/// let mut stored = ZlibEncoder::new(Vec::new(), Compression::none());
/// stored.write_all(data).unwrap();
/// let stored = stored.finish().unwrap();
///
/// let mut best = ZlibEncoder::new(Vec::new(), Compression::best());
/// best.write_all(data).unwrap();
/// let best = best.finish().unwrap();
///
/// // Stored data is larger than the input; compressed data much smaller.
/// assert(stored.len() > data.len());
/// assert(best.len() < data.len() / 2);
/// ```
#[derive(Clone, PartialEq, Eq, Debug)]
pub struct Compression(u32);

impl Compression {
    /// Creates a new compression level from an integer, 0 to 9 (higher
    /// values compress as 9).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::Compression;
    ///
    /// assert_eq(Compression::new(9), Compression::best());
    /// assert_eq(Compression::new(5).level(), 5);
    /// ```
    pub fn new(level: u32) -> Compression {
        Compression(level)
    }
    /// No compression: the data is stored in DEFLATE's stored blocks
    /// (level 0).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::Compression;
    ///
    /// assert_eq(Compression::none().level(), 0);
    /// ```
    pub fn none() -> Compression {
        Compression(0)
    }
    /// Optimizes for speed (level 1).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::Compression;
    ///
    /// assert_eq(Compression::fast().level(), 1);
    /// ```
    pub fn fast() -> Compression {
        Compression(1)
    }
    /// Optimizes for size (level 9).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::Compression;
    ///
    /// assert_eq(Compression::best().level(), 9);
    /// ```
    pub fn best() -> Compression {
        Compression(9)
    }
    /// Returns the integer level of this compression setting.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::Compression;
    ///
    /// assert_eq(Compression::default().level(), 6);
    /// ```
    pub fn level(&self) -> u32 {
        self.0
    }
}

impl Default for Compression {
    fn default() -> Compression {
        Compression(6)
    }
}

const RAW: u8 = 0;
const ZLIB: u8 = 1;
const GZIP: u8 = 2;

// --- Encoding ------------------------------------------------------------------------

// An encoder of one of the formats: input in, compressed bytes out.
struct Enc {
    d: Deflater,
    fmt: u8,
    header: Vec<u8>,
    started: bool,
    crc: crc32::Hasher,
    adler: Adler32,
    finished: bool,
}

fn zlib_header(level: u32) -> Vec<u8> {
    let flg = if level <= 1 {
        0x01
    } else if level <= 5 {
        0x5e
    } else if level == 6 {
        0x9c
    } else {
        0xda
    };
    let mut v = Vec::new();
    v.push(0x78u8);
    v.push(flg as u8);
    v
}

impl Enc {
    fn new(fmt: u8, level: u32, header: Vec<u8>) -> Enc {
        let h = if fmt == ZLIB {
            zlib_header(level)
        } else {
            header
        };
        Enc {
            d: Deflater::new(level),
            fmt,
            header: h,
            started: false,
            crc: crc32::Hasher::new(),
            adler: Adler32::new(),
            finished: false,
        }
    }

    fn out(&mut self) -> Vec<u8> {
        let body = self.d.take();
        if self.started {
            return body;
        }
        self.started = true;
        let mut v = self.header.clone();
        v.extend_from_slice(body.as_slice());
        v
    }

    fn feed(&mut self, b: &[u8]) -> Vec<u8> {
        self.d.input(b);
        if self.fmt == GZIP {
            self.crc.update(b);
        }
        if self.fmt == ZLIB {
            self.adler.write_slice(b);
        }
        self.d.run(false);
        self.out()
    }

    fn sync(&mut self) -> Vec<u8> {
        self.d.run(false);
        self.d.sync();
        self.out()
    }

    fn finish(&mut self) -> Vec<u8> {
        if self.finished {
            return Vec::new();
        }
        self.finished = true;
        self.d.run(true);
        let mut v = self.out();
        if self.fmt == ZLIB {
            let a = self.adler.checksum();
            v.push((a >> 24) as u8);
            v.push((a >> 16) as u8);
            v.push((a >> 8) as u8);
            v.push(a as u8);
        } else if self.fmt == GZIP {
            let c = self.crc.clone().finalize();
            let n = self.d.total_in as u32;
            let mut k = 0;
            while k < 4 {
                v.push((c >> (8 * k)) as u8);
                k += 1;
            }
            k = 0;
            while k < 4 {
                v.push((n >> (8 * k)) as u8);
                k += 1;
            }
        }
        v
    }

    fn total_in(&self) -> u64 {
        self.d.total_in
    }
}

// A writer compressing into inner.
struct EncW<W: Write> {
    inner: W,
    e: Enc,
    total_out: u64,
}

impl<W: Write> EncW<W> {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        let out = self.e.feed(buf);
        self.total_out += out.len() as u64;
        self.inner.write_all(out.as_slice())?;
        Ok(buf.len())
    }

    fn flush(&mut self) -> io::Result<()> {
        let out = self.e.sync();
        self.total_out += out.len() as u64;
        self.inner.write_all(out.as_slice())?;
        self.inner.flush()
    }

    fn try_finish(&mut self) -> io::Result<()> {
        let out = self.e.finish();
        self.total_out += out.len() as u64;
        self.inner.write_all(out.as_slice())?;
        self.inner.flush()
    }
}

// A reader compressing what inner gives.
struct EncR<R: Read> {
    inner: R,
    e: Enc,
    out: Vec<u8>,
    pos: usize,
    eof: bool,
    total_out: u64,
}

impl<R: Read> EncR<R> {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        let mut chunk = [0u8; 32768];
        while self.pos == self.out.len() {
            if self.eof {
                return Ok(0);
            }
            let n = self.inner.read(&mut chunk)?;
            self.out = if n == 0 {
                self.eof = true;
                self.e.finish()
            } else {
                self.e.feed(&chunk[0..n])
            };
            self.pos = 0;
        }
        let n = crate::cmp::min(buf.len(), self.out.len() - self.pos);
        buf[0..n].copy_from_slice(&self.out[self.pos..self.pos + n]);
        self.pos += n;
        self.total_out += n as u64;
        Ok(n)
    }
}

// --- Decoding ------------------------------------------------------------------------

/// The header of a gzip member, as read by a gzip decoder.
///
/// The header carries optional metadata about the compressed data: the
/// original file name, a comment, an "extra" field, the modification time
/// and the operating system it was made on. Get it from
/// [`read::GzDecoder::header`] or [`read::MultiGzDecoder::header`] once the
/// decoder has started reading; build one for writing with [`GzBuilder`].
///
/// # Examples
///
/// Reading the header of a member made by Python's
/// `gzip.GzipFile(filename='hello.txt', mtime=1700000000)`:
///
/// ```
/// use std::compress::read::GzDecoder;
/// use std::hex;
/// use std::io::Read;
///
/// // The header: magic, method, flags (FNAME), mtime, XFL, OS, "hello.txt\0".
/// let mut gz = hex::decode("1f8b080800f1536502ff68656c6c6f2e74787400").unwrap();
/// // The DEFLATE data, then the CRC-32 and the length.
/// let body = hex::decode("f348cdc9c9d75128cf2fca49510400e6c6e6eb0d000000").unwrap();
/// gz.extend_from_slice(body.as_slice());
///
/// let mut d = GzDecoder::new(gz.as_slice());
/// let mut s = String::new();
/// d.read_to_string(&mut s).unwrap();
/// assert_eq(s, "Hello, world!");
///
/// let h = d.header().unwrap();
/// assert_eq(h.filename(), Some(&b"hello.txt"[..]));
/// assert_eq(h.comment(), None);
/// assert_eq(h.mtime(), 1700000000);
/// assert_eq(h.operating_system(), 255); // unknown
/// ```
#[derive(Clone, PartialEq, Eq, Debug, Default)]
pub struct GzHeader {
    extra: Option<Vec<u8>>,
    filename: Option<Vec<u8>>,
    comment: Option<Vec<u8>>,
    operating_system: u8,
    mtime: u32,
}

impl GzHeader {
    /// Returns the `filename` field of this gzip header, if present.
    ///
    /// The name is returned as bytes, without the terminating zero; RFC 1952
    /// says it is ISO 8859-1 (Latin-1) text.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::{Compression, GzBuilder};
    /// use std::compress::read::GzDecoder;
    /// use std::io::{Read, Write};
    ///
    /// let mut e = GzBuilder::new().filename("notes.txt").write(Vec::new(), Compression::default());
    /// e.write_all(b"text").unwrap();
    /// let gz = e.finish().unwrap();
    ///
    /// let mut d = GzDecoder::new(gz.as_slice());
    /// let mut out = Vec::new();
    /// d.read_to_end(&mut out).unwrap();
    /// assert_eq(d.header().unwrap().filename(), Some(&b"notes.txt"[..]));
    /// ```
    pub fn filename(&self) -> Option<&[u8]> {
        match &self.filename {
            Some(v) => Some(v.as_slice()),
            None => None,
        }
    }
    /// Returns the `extra` field of this gzip header, if present.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::{Compression, GzBuilder};
    /// use std::compress::read::GzDecoder;
    /// use std::io::{Read, Write};
    ///
    /// let mut e = GzBuilder::new().extra(b"AB\x02\x00hi").write(Vec::new(), Compression::fast());
    /// e.write_all(b"data").unwrap();
    /// let gz = e.finish().unwrap();
    ///
    /// let mut d = GzDecoder::new(gz.as_slice());
    /// let mut out = Vec::new();
    /// d.read_to_end(&mut out).unwrap();
    /// assert_eq(d.header().unwrap().extra(), Some(&b"AB\x02\x00hi"[..]));
    /// ```
    pub fn extra(&self) -> Option<&[u8]> {
        match &self.extra {
            Some(v) => Some(v.as_slice()),
            None => None,
        }
    }
    /// Returns the `comment` field of this gzip header, if present.
    ///
    /// The comment is returned as bytes, without the terminating zero.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::{Compression, GzBuilder};
    /// use std::compress::read::GzDecoder;
    /// use std::io::{Read, Write};
    ///
    /// let mut e = GzBuilder::new().comment("made by navi").write(Vec::new(), Compression::default());
    /// e.write_all(b"data").unwrap();
    /// let gz = e.finish().unwrap();
    ///
    /// let mut d = GzDecoder::new(gz.as_slice());
    /// let mut out = Vec::new();
    /// d.read_to_end(&mut out).unwrap();
    /// assert_eq(d.header().unwrap().comment(), Some(&b"made by navi"[..]));
    /// ```
    pub fn comment(&self) -> Option<&[u8]> {
        match &self.comment {
            Some(v) => Some(v.as_slice()),
            None => None,
        }
    }
    /// Returns the `operating_system` field of this gzip header.
    ///
    /// The values are those of RFC 1952 (0: FAT, 3: Unix, 7: Macintosh,
    /// 11: NTFS, 255: unknown, ...). [`GzBuilder`] writes 255 unless
    /// [`GzBuilder::operating_system`] sets it.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::{Compression, GzBuilder};
    /// use std::compress::read::GzDecoder;
    /// use std::io::{Read, Write};
    ///
    /// let mut e = GzBuilder::new().operating_system(3).write(Vec::new(), Compression::default());
    /// e.write_all(b"data").unwrap();
    /// let gz = e.finish().unwrap();
    ///
    /// let mut d = GzDecoder::new(gz.as_slice());
    /// let mut out = Vec::new();
    /// d.read_to_end(&mut out).unwrap();
    /// assert_eq(d.header().unwrap().operating_system(), 3);
    /// ```
    pub fn operating_system(&self) -> u8 {
        self.operating_system
    }
    /// Returns the `mtime` field of this gzip header: the modification time
    /// of the original file in seconds since the Unix epoch, or 0 if it is
    /// not known.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::{Compression, GzBuilder};
    /// use std::compress::read::GzDecoder;
    /// use std::io::{Read, Write};
    ///
    /// let mut e = GzBuilder::new().mtime(1234567890).write(Vec::new(), Compression::default());
    /// e.write_all(b"data").unwrap();
    /// let gz = e.finish().unwrap();
    ///
    /// let mut d = GzDecoder::new(gz.as_slice());
    /// let mut out = Vec::new();
    /// d.read_to_end(&mut out).unwrap();
    /// assert_eq(d.header().unwrap().mtime(), 1234567890);
    /// ```
    pub fn mtime(&self) -> u32 {
        self.mtime
    }
}

fn bad(msg: &str) -> io::Error {
    io::Error::new(io::ErrorKind::InvalidInput, msg)
}

const D_HEADER: u8 = 0;
const D_BODY: u8 = 1;
const D_DONE: u8 = 2;

// A decoder of one of the formats over a reader.
struct Dec<R: Read> {
    inf: Inflater<R>,
    fmt: u8,
    state: u8,
    multi: bool,
    crc: crc32::Hasher,
    adler: Adler32,
    size: u32,
    header: Option<GzHeader>,
    total_out: u64,
}

impl<R: Read> Dec<R> {
    fn new(inner: R, fmt: u8, multi: bool) -> Dec<R> {
        Dec {
            inf: Inflater::new(Bits::new(inner)),
            fmt,
            state: D_HEADER,
            multi,
            crc: crc32::Hasher::new(),
            adler: Adler32::new(),
            size: 0,
            header: None,
            total_out: 0,
        }
    }

    fn header_now(&mut self) -> io::Result<()> {
        let s = &mut self.inf.src;
        if self.fmt == ZLIB {
            let cmf = s.need_byte()?;
            let flg = s.need_byte()?;
            if cmf & 0x0f != 8 || (cmf as u32 * 256 + flg as u32) % 31 != 0 {
                return Err(bad("invalid zlib header"));
            }
            if flg & 0x20 != 0 {
                return Err(bad("zlib preset dictionaries are not supported"));
            }
        } else if self.fmt == GZIP {
            let mut h = [0u8; 10];
            let mut i = 0;
            while i < 10 {
                h[i] = s.need_byte()?;
                i += 1;
            }
            if h[0] != 0x1f || h[1] != 0x8b {
                return Err(bad("invalid gzip header"));
            }
            if h[2] != 8 {
                return Err(bad("unsupported gzip compression method"));
            }
            let flg = h[3];
            let mut gh = GzHeader::default();
            gh.mtime = h[4] as u32 | (h[5] as u32) << 8 | (h[6] as u32) << 16 | (h[7] as u32) << 24;
            gh.operating_system = h[9];
            if flg & 4 != 0 {
                let n = s.need_byte()? as usize | (s.need_byte()? as usize) << 8;
                let mut x = Vec::new();
                let mut k = 0;
                while k < n {
                    x.push(s.need_byte()?);
                    k += 1;
                }
                gh.extra = Some(x);
            }
            if flg & 8 != 0 {
                let mut x = Vec::new();
                loop {
                    let b = s.need_byte()?;
                    if b == 0 {
                        break;
                    }
                    x.push(b);
                }
                gh.filename = Some(x);
            }
            if flg & 16 != 0 {
                let mut x = Vec::new();
                loop {
                    let b = s.need_byte()?;
                    if b == 0 {
                        break;
                    }
                    x.push(b);
                }
                gh.comment = Some(x);
            }
            if flg & 2 != 0 {
                s.need_byte()?;
                s.need_byte()?;
            }
            self.header = Some(gh);
        }
        Ok(())
    }

    fn trailer(&mut self) -> io::Result<()> {
        self.inf.src.align();
        let s = &mut self.inf.src;
        if self.fmt == ZLIB {
            let mut a: u32 = 0;
            let mut k = 0;
            while k < 4 {
                a = a << 8 | s.need_byte()? as u32;
                k += 1;
            }
            if a != self.adler.checksum() {
                return Err(bad("corrupt zlib stream: checksum mismatch"));
            }
        } else if self.fmt == GZIP {
            let mut c: u32 = 0;
            let mut n: u32 = 0;
            let mut k = 0;
            while k < 4 {
                c |= (s.need_byte()? as u32) << (8 * k);
                k += 1;
            }
            k = 0;
            while k < 4 {
                n |= (s.need_byte()? as u32) << (8 * k);
                k += 1;
            }
            if c != self.crc.clone().finalize() {
                return Err(bad("corrupt gzip stream: CRC mismatch"));
            }
            if n != self.size {
                return Err(bad("corrupt gzip stream: length mismatch"));
            }
        }
        Ok(())
    }

    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        loop {
            if self.state == D_DONE || buf.len() == 0 {
                return Ok(0);
            }
            if self.state == D_HEADER {
                self.header_now()?;
                self.state = D_BODY;
            }
            let n = self.inf.read_some(buf)?;
            if n > 0 {
                if self.fmt == GZIP {
                    self.crc.update(&buf[0..n]);
                    self.size = self.size.wrapping_add(n as u32);
                }
                if self.fmt == ZLIB {
                    self.adler.write_slice(&buf[0..n]);
                }
                self.total_out += n as u64;
                return Ok(n);
            }
            self.trailer()?;
            if self.fmt == GZIP && self.multi && !self.inf.src.at_end()? {
                // The next member.
                self.inf.restart();
                self.crc = crc32::Hasher::new();
                self.size = 0;
                self.state = D_HEADER;
                continue;
            }
            self.state = D_DONE;
        }
    }
}

// A writer decompressing into inner: the input is kept until finish (the
// decoder pulls its input).
struct DecW<W: Write> {
    inner: W,
    fmt: u8,
    multi: bool,
    input: Vec<u8>,
    done: bool,
}

impl<W: Write> DecW<W> {
    fn try_finish(&mut self) -> io::Result<()> {
        if self.done {
            return Ok(());
        }
        self.done = true;
        let src: &[u8] = self.input.as_slice();
        let mut d = Dec::new(src, self.fmt, self.multi);
        let mut buf = [0u8; 32768];
        loop {
            let n = d.read(&mut buf)?;
            if n == 0 {
                break;
            }
            self.inner.write_all(&buf[0..n])?;
        }
        self.inner.flush()
    }
}

// --- The public types: one set per format --------------------------------------------

/// A builder structure to create a new gzip encoder with a custom header.
///
/// By default the header has no file name, comment or extra field, a
/// modification time of 0 (unknown) and an operating system of 255
/// (unknown). The setters return a new builder (the builder is cloned), so
/// they chain; [`GzBuilder::write`] and [`GzBuilder::read`] then make an
/// encoder that writes this header.
///
/// # Examples
///
/// ```
/// use std::compress::{Compression, GzBuilder};
/// use std::compress::read::GzDecoder;
/// use std::io::{Read, Write};
///
/// let mut e = GzBuilder::new()
///     .filename("hello_world.txt")
///     .comment("test file, please delete")
///     .mtime(1700000000)
///     .write(Vec::new(), Compression::default());
/// e.write_all(b"hello world").unwrap();
/// let gz = e.finish().unwrap();
///
/// let mut d = GzDecoder::new(gz.as_slice());
/// let mut s = String::new();
/// d.read_to_string(&mut s).unwrap();
/// assert_eq(s, "hello world");
/// let h = d.header().unwrap();
/// assert_eq(h.filename(), Some(&b"hello_world.txt"[..]));
/// assert_eq(h.comment(), Some(&b"test file, please delete"[..]));
/// assert_eq(h.mtime(), 1700000000);
/// ```
#[derive(Clone, Default)]
pub struct GzBuilder {
    h: GzHeader,
    has_os: bool,
}

impl GzBuilder {
    /// Creates a new blank builder with no header by default.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::{Compression, GzBuilder};
    /// use std::io::Write;
    ///
    /// let mut e = GzBuilder::new().write(Vec::new(), Compression::default());
    /// e.write_all(b"x").unwrap();
    /// let gz = e.finish().unwrap();
    /// // Magic, method 8 (DEFLATE), no flags, mtime 0, XFL 0, OS 255.
    /// assert_eq(&gz[0..10], b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x00\xff");
    /// ```
    pub fn new() -> GzBuilder {
        GzBuilder::default()
    }
    /// Configures the file name in the gzip header (written with a
    /// terminating zero; it should not contain one itself).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::{Compression, GzBuilder};
    /// use std::io::Write;
    ///
    /// let mut e = GzBuilder::new().filename("a.txt").write(Vec::new(), Compression::default());
    /// e.write_all(b"x").unwrap();
    /// let gz = e.finish().unwrap();
    /// assert_eq(gz[3], 0x08); // FNAME
    /// assert_eq(&gz[10..16], b"a.txt\x00");
    /// ```
    pub fn filename<S: Into<Vec<u8>>>(&self, name: S) -> GzBuilder {
        let mut b = self.clone();
        b.h.filename = Some(name.into());
        b
    }
    /// Configures the comment in the gzip header (written with a terminating
    /// zero; it should not contain one itself).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::{Compression, GzBuilder};
    /// use std::io::Write;
    ///
    /// let mut e = GzBuilder::new().comment("hi").write(Vec::new(), Compression::default());
    /// e.write_all(b"x").unwrap();
    /// let gz = e.finish().unwrap();
    /// assert_eq(gz[3], 0x10); // FCOMMENT
    /// assert_eq(&gz[10..13], b"hi\x00");
    /// ```
    pub fn comment<S: Into<Vec<u8>>>(&self, c: S) -> GzBuilder {
        let mut b = self.clone();
        b.h.comment = Some(c.into());
        b
    }
    /// Configures the `extra` field in the gzip header (at most 65535
    /// bytes; RFC 1952 makes it a list of subfields, each a 2-byte id, a
    /// 2-byte little-endian length and the data).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::{Compression, GzBuilder};
    /// use std::io::Write;
    ///
    /// let mut e = GzBuilder::new().extra(b"AB\x01\x00z").write(Vec::new(), Compression::default());
    /// e.write_all(b"x").unwrap();
    /// let gz = e.finish().unwrap();
    /// assert_eq(gz[3], 0x04); // FEXTRA
    /// // The length (little-endian), then the field.
    /// assert_eq(&gz[10..17], b"\x05\x00AB\x01\x00z");
    /// ```
    pub fn extra<S: Into<Vec<u8>>>(&self, x: S) -> GzBuilder {
        let mut b = self.clone();
        b.h.extra = Some(x.into());
        b
    }
    /// Configures the `mtime` field in the gzip header: the modification
    /// time in seconds since the Unix epoch (0, the default, means unknown).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::{Compression, GzBuilder};
    /// use std::io::Write;
    ///
    /// let mut e = GzBuilder::new().mtime(0x01020304).write(Vec::new(), Compression::default());
    /// e.write_all(b"x").unwrap();
    /// let gz = e.finish().unwrap();
    /// assert_eq(&gz[4..8], b"\x04\x03\x02\x01"); // little-endian
    /// ```
    pub fn mtime(&self, t: u32) -> GzBuilder {
        let mut b = self.clone();
        b.h.mtime = t;
        b
    }
    /// Configures the `operating_system` field in the gzip header (RFC 1952
    /// values: 0 FAT, 3 Unix, 7 Macintosh, 11 NTFS, 255 unknown, ...;
    /// 255 if not set).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::{Compression, GzBuilder};
    /// use std::io::Write;
    ///
    /// let mut e = GzBuilder::new().operating_system(3).write(Vec::new(), Compression::default());
    /// e.write_all(b"x").unwrap();
    /// let gz = e.finish().unwrap();
    /// assert_eq(gz[9], 3);
    /// ```
    pub fn operating_system(&self, os: u8) -> GzBuilder {
        let mut b = self.clone();
        b.h.operating_system = os;
        b.has_os = true;
        b
    }

    fn bytes(&self, level: u32) -> Vec<u8> {
        let mut v = Vec::new();
        let mut flg = 0u8;
        if self.h.extra.is_some() {
            flg |= 4;
        }
        if self.h.filename.is_some() {
            flg |= 8;
        }
        if self.h.comment.is_some() {
            flg |= 16;
        }
        v.extend_from_slice(&[0x1fu8, 0x8b, 8, flg]);
        let t = self.h.mtime;
        v.extend_from_slice(&[t as u8, (t >> 8) as u8, (t >> 16) as u8, (t >> 24) as u8]);
        v.push(if level >= 9 {
            2
        } else if level <= 1 {
            4
        } else {
            0
        });
        v.push(if self.has_os {
            self.h.operating_system
        } else {
            255
        });
        if let Some(x) = &self.h.extra {
            v.push(x.len() as u8);
            v.push((x.len() >> 8) as u8);
            v.extend_from_slice(x.as_slice());
        }
        if let Some(x) = &self.h.filename {
            v.extend_from_slice(x.as_slice());
            v.push(0);
        }
        if let Some(x) = &self.h.comment {
            v.extend_from_slice(x.as_slice());
            v.push(0);
        }
        v
    }

    /// Consumes this builder, creating a writer encoder in the process.
    ///
    /// The data written to the returned [`write::GzEncoder`] is compressed
    /// at `level` into a gzip member with this header, written to `w`. The
    /// XFL byte of the header is 2 for level 9 and 4 for levels 0 and 1, as
    /// zlib writes it.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::{Compression, GzBuilder};
    /// use std::compress::read::GzDecoder;
    /// use std::io::{Read, Write};
    ///
    /// let mut e = GzBuilder::new().filename("data.bin").write(Vec::new(), Compression::best());
    /// e.write_all(b"some data").unwrap();
    /// let gz = e.finish().unwrap();
    /// assert_eq(gz[8], 2); // XFL: maximum compression
    ///
    /// let mut out = Vec::new();
    /// GzDecoder::new(gz.as_slice()).read_to_end(&mut out).unwrap();
    /// assert_eq(out, b"some data");
    /// ```
    pub fn write<W: Write>(&self, w: W, level: Compression) -> write::GzEncoder<W> {
        write::GzEncoder {
            e: EncW {
                inner: w,
                e: Enc::new(GZIP, level.0, self.bytes(level.0)),
                total_out: 0,
            },
        }
    }

    /// Consumes this builder, creating a reader encoder in the process.
    ///
    /// Reading from the returned [`read::GzEncoder`] gives a gzip member with
    /// this header holding what `r` gives, compressed at `level`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::{Compression, GzBuilder};
    /// use std::compress::read::GzDecoder;
    /// use std::io::Read;
    ///
    /// let mut e = GzBuilder::new().comment("from a reader").read(&b"some data"[..], Compression::fast());
    /// let mut gz = Vec::new();
    /// e.read_to_end(&mut gz).unwrap();
    ///
    /// let mut d = GzDecoder::new(gz.as_slice());
    /// let mut s = String::new();
    /// d.read_to_string(&mut s).unwrap();
    /// assert_eq(s, "some data");
    /// assert_eq(d.header().unwrap().comment(), Some(&b"from a reader"[..]));
    /// ```
    pub fn read<R: Read>(&self, r: R, level: Compression) -> read::GzEncoder<R> {
        read::GzEncoder {
            e: EncR {
                inner: r,
                e: Enc::new(GZIP, level.0, self.bytes(level.0)),
                out: Vec::new(),
                pos: 0,
                eof: false,
                total_out: 0,
            },
        }
    }
}

/// Types which operate over [`Read`](crate::io::Read) streams, both encoders
/// and decoders for the various formats.
///
/// Each type wraps a reader and is a reader itself: an encoder gives the
/// compressed form of what its inner reader gives, a decoder the
/// decompressed form.
///
/// # Examples
///
/// ```
/// use std::compress::Compression;
/// use std::compress::read::{DeflateDecoder, DeflateEncoder};
/// use std::io::Read;
///
/// let text = "a reader in, a reader out; a reader in, a reader out";
/// let mut compressed = Vec::new();
/// DeflateEncoder::new(text.as_bytes(), Compression::default())
///     .read_to_end(&mut compressed)
///     .unwrap();
///
/// let mut s = String::new();
/// DeflateDecoder::new(compressed.as_slice()).read_to_string(&mut s).unwrap();
/// assert_eq(s, text);
/// ```
pub mod read {
    use crate::compress::{Compression, Dec, Enc, EncR, GZIP, GzBuilder, GzHeader, RAW, ZLIB};
    use crate::io::{self, Read};

    /// A DEFLATE encoder, or compressor.
    ///
    /// This structure implements a [`Read`](crate::io::Read) interface: it
    /// takes a stream of uncompressed data from the inner reader and gives
    /// the compressed data (raw DEFLATE, RFC 1951, with no header or
    /// checksum) when read from.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::Compression;
    /// use std::compress::read::{DeflateDecoder, DeflateEncoder};
    /// use std::io::Read;
    ///
    /// let mut e = DeflateEncoder::new(&b"Hello World"[..], Compression::fast());
    /// let mut compressed = Vec::new();
    /// e.read_to_end(&mut compressed).unwrap();
    ///
    /// let mut out = Vec::new();
    /// DeflateDecoder::new(compressed.as_slice()).read_to_end(&mut out).unwrap();
    /// assert_eq(out, b"Hello World");
    /// ```
    pub struct DeflateEncoder<R: Read> {
        e: EncR<R>,
    }
    /// A zlib encoder, or compressor.
    ///
    /// This structure implements a [`Read`](crate::io::Read) interface: it
    /// takes a stream of uncompressed data from the inner reader and gives a
    /// zlib stream (RFC 1950: a 2-byte header, the DEFLATE data and an
    /// Adler-32 checksum) when read from.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::Compression;
    /// use std::compress::read::{ZlibDecoder, ZlibEncoder};
    /// use std::io::Read;
    ///
    /// let mut e = ZlibEncoder::new(&b"Hello World"[..], Compression::default());
    /// let mut z = Vec::new();
    /// e.read_to_end(&mut z).unwrap();
    /// assert_eq(&z[0..2], b"\x78\x9c"); // the header zlib writes for level 6
    ///
    /// let mut s = String::new();
    /// ZlibDecoder::new(z.as_slice()).read_to_string(&mut s).unwrap();
    /// assert_eq(s, "Hello World");
    /// ```
    pub struct ZlibEncoder<R: Read> {
        e: EncR<R>,
    }
    /// A gzip encoder, or compressor.
    ///
    /// This structure implements a [`Read`](crate::io::Read) interface: it
    /// takes a stream of uncompressed data from the inner reader and gives a
    /// gzip member (RFC 1952) when read from. [`GzEncoder::new`] writes a
    /// default header; use [`crate::compress::GzBuilder::read`] for a custom
    /// one.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::Compression;
    /// use std::compress::read::{GzDecoder, GzEncoder};
    /// use std::io::Read;
    ///
    /// let mut e = GzEncoder::new(&b"Hello World"[..], Compression::default());
    /// let mut gz = Vec::new();
    /// e.read_to_end(&mut gz).unwrap();
    /// assert_eq(&gz[0..2], b"\x1f\x8b");
    ///
    /// let mut s = String::new();
    /// GzDecoder::new(gz.as_slice()).read_to_string(&mut s).unwrap();
    /// assert_eq(s, "Hello World");
    /// ```
    pub struct GzEncoder<R: Read> {
        pub(crate) e: EncR<R>,
    }

    fn enc<R: Read>(r: R, fmt: u8, level: Compression) -> EncR<R> {
        EncR {
            inner: r,
            e: Enc::new(fmt, level.level(), Vec::new()),
            out: Vec::new(),
            pos: 0,
            eof: false,
            total_out: 0,
        }
    }

    impl<R: Read> DeflateEncoder<R> {
        /// Creates a new encoder which will read uncompressed data from the
        /// given stream and emit the compressed stream at `level`.
        ///
        /// # Examples
        ///
        /// ```
        /// use std::compress::Compression;
        /// use std::compress::read::DeflateEncoder;
        /// use std::io::Read;
        ///
        /// let mut e = DeflateEncoder::new(&b"abc"[..], Compression::none());
        /// let mut out = Vec::new();
        /// e.read_to_end(&mut out).unwrap();
        /// // Level 0: one final stored block (header, length, ~length), then the data.
        /// assert_eq(out, b"\x01\x03\x00\xfc\xffabc");
        /// ```
        pub fn new(r: R, level: Compression) -> DeflateEncoder<R> {
            DeflateEncoder {
                e: enc(r, RAW, level),
            }
        }
        /// Acquires a reference to the underlying reader.
        ///
        /// # Examples
        ///
        /// ```
        /// use std::compress::Compression;
        /// use std::compress::read::DeflateEncoder;
        ///
        /// let e = DeflateEncoder::new(&b"abc"[..], Compression::default());
        /// // Nothing has been read yet.
        /// assert_eq(e.get_ref().len(), 3);
        /// ```
        pub fn get_ref(&self) -> &R {
            &self.e.inner
        }
        /// Acquires a mutable reference to the underlying reader.
        ///
        /// Note that mutation of the reader may corrupt the compressed
        /// stream: the data read from it directly is not compressed.
        pub fn get_mut(&mut self) -> &mut R {
            &mut self.e.inner
        }
        /// Consumes this encoder, returning the underlying reader.
        ///
        /// The encoder reads its input in chunks of up to 32 KiB, so the
        /// reader may be positioned past the data compressed so far.
        ///
        /// # Examples
        ///
        /// ```
        /// use std::compress::Compression;
        /// use std::compress::read::DeflateEncoder;
        /// use std::io::Read;
        ///
        /// let mut e = DeflateEncoder::new(&b"abc"[..], Compression::default());
        /// let mut out = Vec::new();
        /// e.read_to_end(&mut out).unwrap();
        /// let rest: &[u8] = e.into_inner();
        /// assert(rest.is_empty());
        /// ```
        pub fn into_inner(self) -> R {
            self.e.inner
        }
        /// Returns the number of bytes that have been read from the inner
        /// reader (and fed to the compressor) so far.
        ///
        /// # Examples
        ///
        /// ```
        /// use std::compress::Compression;
        /// use std::compress::read::DeflateEncoder;
        /// use std::io::Read;
        ///
        /// let mut e = DeflateEncoder::new(&b"Hello World"[..], Compression::default());
        /// let mut out = Vec::new();
        /// e.read_to_end(&mut out).unwrap();
        /// assert_eq(e.total_in(), 11);
        /// assert_eq(e.total_out(), out.len() as u64);
        /// ```
        pub fn total_in(&self) -> u64 {
            self.e.e.total_in()
        }
        /// Returns the number of compressed bytes that have been read from
        /// this encoder so far.
        ///
        /// See [`DeflateEncoder::total_in`] for an example.
        pub fn total_out(&self) -> u64 {
            self.e.total_out
        }
    }

    impl<R: Read> ZlibEncoder<R> {
        /// Creates a new encoder which will read uncompressed data from the
        /// given stream and emit a zlib stream compressed at `level`.
        ///
        /// # Examples
        ///
        /// ```
        /// use std::compress::Compression;
        /// use std::compress::read::ZlibEncoder;
        /// use std::io::Read;
        ///
        /// let mut e = ZlibEncoder::new(&b"abc"[..], Compression::best());
        /// let mut z = Vec::new();
        /// e.read_to_end(&mut z).unwrap();
        /// assert_eq(&z[0..2], b"\x78\xda"); // the header for levels 7 to 9
        /// // The trailer: the Adler-32 checksum of "abc", big-endian.
        /// assert_eq(&z[z.len() - 4..], b"\x02\x4d\x01\x27");
        /// ```
        pub fn new(r: R, level: Compression) -> ZlibEncoder<R> {
            ZlibEncoder {
                e: enc(r, ZLIB, level),
            }
        }
        /// Acquires a reference to the underlying reader.
        pub fn get_ref(&self) -> &R {
            &self.e.inner
        }
        /// Acquires a mutable reference to the underlying reader.
        ///
        /// Note that mutation of the reader may corrupt the compressed
        /// stream: the data read from it directly is not compressed.
        pub fn get_mut(&mut self) -> &mut R {
            &mut self.e.inner
        }
        /// Consumes this encoder, returning the underlying reader.
        ///
        /// The encoder reads its input in chunks of up to 32 KiB, so the
        /// reader may be positioned past the data compressed so far.
        pub fn into_inner(self) -> R {
            self.e.inner
        }
        /// Returns the number of bytes that have been read from the inner
        /// reader (and fed to the compressor) so far.
        ///
        /// # Examples
        ///
        /// ```
        /// use std::compress::Compression;
        /// use std::compress::read::ZlibEncoder;
        /// use std::io::Read;
        ///
        /// let mut e = ZlibEncoder::new(&b"Hello World"[..], Compression::default());
        /// let mut z = Vec::new();
        /// e.read_to_end(&mut z).unwrap();
        /// assert_eq(e.total_in(), 11);
        /// assert_eq(e.total_out(), z.len() as u64);
        /// ```
        pub fn total_in(&self) -> u64 {
            self.e.e.total_in()
        }
        /// Returns the number of compressed bytes (header and trailer
        /// included) that have been read from this encoder so far.
        ///
        /// See [`ZlibEncoder::total_in`] for an example.
        pub fn total_out(&self) -> u64 {
            self.e.total_out
        }
    }

    impl<R: Read> GzEncoder<R> {
        /// Creates a new encoder which will read uncompressed data from the
        /// given stream and emit a gzip member compressed at `level`, with a
        /// default header (no file name, mtime 0, operating system 255).
        ///
        /// # Examples
        ///
        /// ```
        /// use std::compress::Compression;
        /// use std::compress::read::GzEncoder;
        /// use std::io::Read;
        ///
        /// let mut e = GzEncoder::new(&b"abc"[..], Compression::default());
        /// let mut gz = Vec::new();
        /// e.read_to_end(&mut gz).unwrap();
        /// // The trailer: CRC-32 of "abc" (0x352441c2) and the length, little-endian.
        /// assert_eq(&gz[gz.len() - 8..], b"\xc2\x41\x24\x35\x03\x00\x00\x00");
        /// ```
        pub fn new(r: R, level: Compression) -> GzEncoder<R> {
            GzBuilder::new().read(r, level)
        }
        /// Acquires a reference to the underlying reader.
        pub fn get_ref(&self) -> &R {
            &self.e.inner
        }
        /// Acquires a mutable reference to the underlying reader.
        ///
        /// Note that mutation of the reader may corrupt the compressed
        /// stream: the data read from it directly is not compressed.
        pub fn get_mut(&mut self) -> &mut R {
            &mut self.e.inner
        }
        /// Consumes this encoder, returning the underlying reader.
        ///
        /// The encoder reads its input in chunks of up to 32 KiB, so the
        /// reader may be positioned past the data compressed so far.
        pub fn into_inner(self) -> R {
            self.e.inner
        }
    }

    impl<R: Read> Read for DeflateEncoder<R> {
        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
            self.e.read(buf)
        }
    }
    impl<R: Read> Read for ZlibEncoder<R> {
        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
            self.e.read(buf)
        }
    }
    impl<R: Read> Read for GzEncoder<R> {
        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
            self.e.read(buf)
        }
    }

    /// A DEFLATE decoder, or decompressor: it reads raw DEFLATE data
    /// (RFC 1951) from a reader and gives the decompressed bytes.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::read::DeflateDecoder;
    /// use std::io::Read;
    ///
    /// // Python: zlib.compressobj(9, zlib.DEFLATED, -15) on b"Hello, world!"
    /// let raw = b"\xf3\x48\xcd\xc9\xc9\xd7\x51\x28\xcf\x2f\xca\x49\x51\x04\x00";
    /// let mut d = DeflateDecoder::new(raw);
    /// let mut s = String::new();
    /// d.read_to_string(&mut s).unwrap();
    /// assert_eq(s, "Hello, world!");
    /// assert_eq(d.total_out(), 13);
    /// ```
    pub struct DeflateDecoder<R: Read> {
        d: Dec<R>,
    }
    /// A zlib decoder, or decompressor: it reads a zlib stream (RFC 1950)
    /// from a reader and gives the decompressed bytes, checking the
    /// Adler-32 at the end.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::Compression;
    /// use std::compress::read::ZlibDecoder;
    /// use std::compress::write::ZlibEncoder;
    /// use std::io::{Read, Write};
    ///
    /// let mut e = ZlibEncoder::new(Vec::new(), Compression::default());
    /// e.write_all(b"zlib data").unwrap();
    /// let z = e.finish().unwrap();
    ///
    /// let mut d = ZlibDecoder::new(z.as_slice());
    /// let mut out = Vec::new();
    /// d.read_to_end(&mut out).unwrap();
    /// assert_eq(out, b"zlib data");
    /// ```
    pub struct ZlibDecoder<R: Read> {
        d: Dec<R>,
    }
    /// A gzip decoder, or decompressor: it reads the first member of a
    /// gzip stream (RFC 1952) from a reader and gives its decompressed
    /// bytes, checking the CRC-32 and length at the end.
    ///
    /// Data after the first member is not read; use [`MultiGzDecoder`] for
    /// streams of several members (such as concatenated `.gz` files).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::read::GzDecoder;
    /// use std::io::Read;
    ///
    /// // Python: gzip.compress(b"Hello, world!", 9, mtime=0)
    /// let gz = b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff\xf3\x48\xcd\xc9\xc9\xd7\x51\x28\xcf\x2f\xca\x49\x51\x04\x00\xe6\xc6\xe6\xeb\x0d\x00\x00\x00";
    /// let mut d = GzDecoder::new(gz);
    /// let mut s = String::new();
    /// d.read_to_string(&mut s).unwrap();
    /// assert_eq(s, "Hello, world!");
    /// assert_eq(d.header().unwrap().mtime(), 0);
    /// ```
    pub struct GzDecoder<R: Read> {
        d: Dec<R>,
    }
    /// A gzip decoder that reads every member of a gzip stream, one after
    /// another, giving their decompressed bytes as one sequence.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::Compression;
    /// use std::compress::read::MultiGzDecoder;
    /// use std::compress::write::GzEncoder;
    /// use std::io::{Read, Write};
    ///
    /// let mut both = Vec::new();
    /// for part in ["Hello, ", "world!"].iter() {
    ///     let mut e = GzEncoder::new(Vec::new(), Compression::fast());
    ///     e.write_all(part.as_bytes()).unwrap();
    ///     both.extend_from_slice(e.finish().unwrap().as_slice());
    /// }
    /// let mut s = String::new();
    /// MultiGzDecoder::new(both.as_slice()).read_to_string(&mut s).unwrap();
    /// assert_eq(s, "Hello, world!");
    /// ```
    pub struct MultiGzDecoder<R: Read> {
        d: Dec<R>,
    }

    impl<R: Read> DeflateDecoder<R> {
        /// Creates a decoder that reads raw DEFLATE data from `r`.
        pub fn new(r: R) -> DeflateDecoder<R> {
            DeflateDecoder {
                d: Dec::new(r, RAW, false),
            }
        }
        /// Returns a reference to the underlying reader.
        pub fn get_ref(&self) -> &R {
            &self.d.inf.src.inner
        }
        /// Returns a mutable reference to the underlying reader.
        ///
        /// Reading from it directly may corrupt the decompressed stream.
        pub fn get_mut(&mut self) -> &mut R {
            &mut self.d.inf.src.inner
        }
        /// Returns the number of decompressed bytes given so far.
        pub fn total_out(&self) -> u64 {
            self.d.total_out
        }
    }

    impl<R: Read> ZlibDecoder<R> {
        /// Creates a decoder that reads a zlib stream from `r`.
        pub fn new(r: R) -> ZlibDecoder<R> {
            ZlibDecoder {
                d: Dec::new(r, ZLIB, false),
            }
        }
        /// Returns a reference to the underlying reader.
        pub fn get_ref(&self) -> &R {
            &self.d.inf.src.inner
        }
        /// Returns a mutable reference to the underlying reader.
        ///
        /// Reading from it directly may corrupt the decompressed stream.
        pub fn get_mut(&mut self) -> &mut R {
            &mut self.d.inf.src.inner
        }
        /// Returns the number of decompressed bytes given so far.
        pub fn total_out(&self) -> u64 {
            self.d.total_out
        }
    }

    impl<R: Read> GzDecoder<R> {
        /// Creates a decoder that reads the first gzip member from `r`.
        pub fn new(r: R) -> GzDecoder<R> {
            GzDecoder {
                d: Dec::new(r, GZIP, false),
            }
        }
        /// Returns the member's header, once it has been read (after the
        /// first read), or `None` before that or if it was not valid.
        pub fn header(&self) -> Option<&GzHeader> {
            match &self.d.header {
                Some(h) => Some(h),
                None => None,
            }
        }
        /// Returns a reference to the underlying reader.
        pub fn get_ref(&self) -> &R {
            &self.d.inf.src.inner
        }
        /// Returns a mutable reference to the underlying reader.
        ///
        /// Reading from it directly may corrupt the decompressed stream.
        pub fn get_mut(&mut self) -> &mut R {
            &mut self.d.inf.src.inner
        }
    }

    impl<R: Read> MultiGzDecoder<R> {
        /// Creates a decoder that reads every gzip member from `r`.
        pub fn new(r: R) -> MultiGzDecoder<R> {
            MultiGzDecoder {
                d: Dec::new(r, GZIP, true),
            }
        }
        /// Returns the header of the member being read, once it has been read
        /// (after the first read).
        pub fn header(&self) -> Option<&GzHeader> {
            match &self.d.header {
                Some(h) => Some(h),
                None => None,
            }
        }
        /// Returns a reference to the underlying reader.
        pub fn get_ref(&self) -> &R {
            &self.d.inf.src.inner
        }
        /// Returns a mutable reference to the underlying reader.
        ///
        /// Reading from it directly may corrupt the decompressed stream.
        pub fn get_mut(&mut self) -> &mut R {
            &mut self.d.inf.src.inner
        }
    }

    impl<R: Read> Read for DeflateDecoder<R> {
        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
            self.d.read(buf)
        }
    }
    impl<R: Read> Read for ZlibDecoder<R> {
        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
            self.d.read(buf)
        }
    }
    impl<R: Read> Read for GzDecoder<R> {
        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
            self.d.read(buf)
        }
    }
    impl<R: Read> Read for MultiGzDecoder<R> {
        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
            self.d.read(buf)
        }
    }
}

/// Encoders and decoders that write their output to a writer.
pub mod write {
    use crate::compress::{Compression, DecW, Enc, EncW, GZIP, GzBuilder, RAW, ZLIB};
    use crate::io::{self, Write};

    /// A DEFLATE encoder, or compressor: it compresses the bytes written
    /// to it into raw DEFLATE data (RFC 1951), which it writes to the
    /// underlying writer.
    ///
    /// navi has no `Drop`: call [`DeflateEncoder::finish`] (or
    /// [`DeflateEncoder::try_finish`]) to write the end of the stream.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::Compression;
    /// use std::compress::read::DeflateDecoder;
    /// use std::compress::write::DeflateEncoder;
    /// use std::io::{Read, Write};
    ///
    /// let mut e = DeflateEncoder::new(Vec::new(), Compression::default());
    /// e.write_all(b"foo bar baz foo bar baz").unwrap();
    /// assert_eq(e.total_in(), 23);
    /// let raw = e.finish().unwrap();
    ///
    /// let mut s = String::new();
    /// DeflateDecoder::new(raw.as_slice()).read_to_string(&mut s).unwrap();
    /// assert_eq(s, "foo bar baz foo bar baz");
    /// ```
    pub struct DeflateEncoder<W: Write> {
        e: EncW<W>,
    }
    /// A zlib encoder, or compressor: it compresses the bytes written to
    /// it into a zlib stream (RFC 1950), which it writes to the underlying
    /// writer.
    ///
    /// navi has no `Drop`: call [`ZlibEncoder::finish`] (or
    /// [`ZlibEncoder::try_finish`]) to write the end of the stream and the
    /// Adler-32.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::Compression;
    /// use std::compress::write::ZlibEncoder;
    /// use std::io::Write;
    ///
    /// let mut e = ZlibEncoder::new(Vec::new(), Compression::best());
    /// e.write_all(b"Hello, world!").unwrap();
    /// let z = e.finish().unwrap();
    /// assert_eq(z[0], 0x78); // the zlib header
    /// ```
    pub struct ZlibEncoder<W: Write> {
        e: EncW<W>,
    }
    /// A gzip encoder, or compressor: it compresses the bytes written to
    /// it into a gzip member (RFC 1952), which it writes to the underlying
    /// writer.
    ///
    /// The header is the default one (no name, no modification time);
    /// [`GzBuilder`](crate::compress::GzBuilder) sets its fields. navi has
    /// no `Drop`: call [`GzEncoder::finish`] (or [`GzEncoder::try_finish`])
    /// to write the end of the stream and the trailer.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::Compression;
    /// use std::compress::write::GzEncoder;
    /// use std::io::Write;
    ///
    /// let mut e = GzEncoder::new(Vec::new(), Compression::default());
    /// e.write_all(b"Hello, world!").unwrap();
    /// let gz = e.finish().unwrap();
    /// assert_eq(&gz[0..2], b"\x1f\x8b");
    /// ```
    pub struct GzEncoder<W: Write> {
        pub(crate) e: EncW<W>,
    }

    fn enc<W: Write>(w: W, fmt: u8, level: Compression) -> EncW<W> {
        EncW {
            inner: w,
            e: Enc::new(fmt, level.level(), Vec::new()),
            total_out: 0,
        }
    }

    impl<W: Write> DeflateEncoder<W> {
        /// Creates an encoder that writes raw DEFLATE data compressed at
        /// `level` to `w`.
        pub fn new(w: W, level: Compression) -> DeflateEncoder<W> {
            DeflateEncoder {
                e: enc(w, RAW, level),
            }
        }
        /// Writes the rest of the compressed data and the end of the
        /// stream to the underlying writer, keeping the encoder.
        ///
        /// Call it or [`Self::finish`]: navi has no `Drop` to do it.
        /// Nothing may be written after it.
        ///
        /// # Errors
        ///
        /// The underlying writer's errors.
        pub fn try_finish(&mut self) -> io::Result<()> {
            self.e.try_finish()
        }
        /// Writes the rest of the compressed data and the end of the
        /// stream, and returns the underlying writer.
        ///
        /// # Errors
        ///
        /// The underlying writer's errors.
        pub fn finish(mut self) -> io::Result<W> {
            self.e.try_finish()?;
            Ok(self.e.inner)
        }
        /// Returns a reference to the underlying writer.
        pub fn get_ref(&self) -> &W {
            &self.e.inner
        }
        /// Returns a mutable reference to the underlying writer.
        ///
        /// Writing to it directly may corrupt the compressed stream.
        pub fn get_mut(&mut self) -> &mut W {
            &mut self.e.inner
        }
        /// Returns the number of uncompressed bytes written to the encoder so
        /// far.
        pub fn total_in(&self) -> u64 {
            self.e.e.total_in()
        }
        /// Returns the number of compressed bytes written to the underlying
        /// writer so far.
        pub fn total_out(&self) -> u64 {
            self.e.total_out
        }
    }

    impl<W: Write> ZlibEncoder<W> {
        /// Creates an encoder that writes a zlib stream compressed at `level`
        /// to `w`.
        pub fn new(w: W, level: Compression) -> ZlibEncoder<W> {
            ZlibEncoder {
                e: enc(w, ZLIB, level),
            }
        }
        /// Writes the rest of the compressed data and the end of the stream
        /// (with the trailer) to the underlying writer, keeping the encoder.
        ///
        /// Call it or [`Self::finish`]: navi has no `Drop` to do it. Nothing
        /// may be written after it.
        ///
        /// # Errors
        ///
        /// The underlying writer's errors.
        pub fn try_finish(&mut self) -> io::Result<()> {
            self.e.try_finish()
        }
        /// Writes the rest of the compressed data and the end of the stream
        /// (with the trailer), and returns the underlying writer.
        ///
        /// # Errors
        ///
        /// The underlying writer's errors.
        pub fn finish(mut self) -> io::Result<W> {
            self.e.try_finish()?;
            Ok(self.e.inner)
        }
        /// Returns a reference to the underlying writer.
        pub fn get_ref(&self) -> &W {
            &self.e.inner
        }
        /// Returns a mutable reference to the underlying writer.
        ///
        /// Writing to it directly may corrupt the compressed stream.
        pub fn get_mut(&mut self) -> &mut W {
            &mut self.e.inner
        }
        /// Returns the number of uncompressed bytes written to the encoder so
        /// far.
        pub fn total_in(&self) -> u64 {
            self.e.e.total_in()
        }
        /// Returns the number of compressed bytes written to the underlying
        /// writer so far.
        pub fn total_out(&self) -> u64 {
            self.e.total_out
        }
    }

    impl<W: Write> GzEncoder<W> {
        /// Creates an encoder that writes a gzip member compressed at `level`,
        /// with a default header, to `w`.
        pub fn new(w: W, level: Compression) -> GzEncoder<W> {
            GzBuilder::new().write(w, level)
        }
        /// Writes the rest of the compressed data and the end of the stream
        /// (with the trailer) to the underlying writer, keeping the encoder.
        ///
        /// Call it or [`Self::finish`]: navi has no `Drop` to do it. Nothing
        /// may be written after it.
        ///
        /// # Errors
        ///
        /// The underlying writer's errors.
        pub fn try_finish(&mut self) -> io::Result<()> {
            self.e.try_finish()
        }
        /// Writes the rest of the compressed data and the end of the stream
        /// (with the trailer), and returns the underlying writer.
        ///
        /// # Errors
        ///
        /// The underlying writer's errors.
        pub fn finish(mut self) -> io::Result<W> {
            self.e.try_finish()?;
            Ok(self.e.inner)
        }
        /// Returns a reference to the underlying writer.
        pub fn get_ref(&self) -> &W {
            &self.e.inner
        }
        /// Returns a mutable reference to the underlying writer.
        ///
        /// Writing to it directly may corrupt the compressed stream.
        pub fn get_mut(&mut self) -> &mut W {
            &mut self.e.inner
        }
    }

    impl<W: Write> Write for DeflateEncoder<W> {
        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
            self.e.write(buf)
        }
        /// A sync flush: everything written so far can be decoded.
        fn flush(&mut self) -> io::Result<()> {
            self.e.flush()
        }
    }
    impl<W: Write> Write for ZlibEncoder<W> {
        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
            self.e.write(buf)
        }
        fn flush(&mut self) -> io::Result<()> {
            self.e.flush()
        }
    }
    impl<W: Write> Write for GzEncoder<W> {
        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
            self.e.write(buf)
        }
        fn flush(&mut self) -> io::Result<()> {
            self.e.flush()
        }
    }

    /// A DEFLATE decoder that decompresses the raw DEFLATE data (RFC 1951)
    /// written to it into the underlying writer.
    ///
    /// The compressed data is kept until [`DeflateDecoder::try_finish`]
    /// or [`DeflateDecoder::finish`], which decode it all (navi has no
    /// `Drop`: call one of them).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::write::DeflateDecoder;
    /// use std::io::Write;
    ///
    /// // Python: zlib.compressobj(9, zlib.DEFLATED, -15) on b"Hello, world!"
    /// let raw = b"\xf3\x48\xcd\xc9\xc9\xd7\x51\x28\xcf\x2f\xca\x49\x51\x04\x00";
    /// let mut d = DeflateDecoder::new(Vec::new());
    /// d.write_all(raw).unwrap();
    /// assert_eq(d.finish().unwrap(), b"Hello, world!");
    /// ```
    pub struct DeflateDecoder<W: Write> {
        d: DecW<W>,
    }
    /// A zlib decoder that decompresses the zlib stream (RFC 1950) written
    /// to it into the underlying writer.
    ///
    /// The compressed data is kept until [`ZlibDecoder::try_finish`] or
    /// [`ZlibDecoder::finish`], which decode it all (navi has no `Drop`:
    /// call one of them).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::write::ZlibDecoder;
    /// use std::hex;
    /// use std::io::Write;
    ///
    /// // Python: zlib.compress(b"Hello, world!")
    /// let z = hex::decode("789cf348cdc9c9d75128cf2fca49510400205e048a").unwrap();
    /// let mut d = ZlibDecoder::new(Vec::new());
    /// d.write_all(z.as_slice()).unwrap();
    /// assert_eq(d.finish().unwrap(), b"Hello, world!");
    /// ```
    pub struct ZlibDecoder<W: Write> {
        d: DecW<W>,
    }
    /// A gzip decoder that decompresses the gzip member (RFC 1952) written
    /// to it into the underlying writer.
    ///
    /// The compressed data is kept until [`GzDecoder::try_finish`] or
    /// [`GzDecoder::finish`], which decode it all (navi has no `Drop`:
    /// call one of them).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::compress::Compression;
    /// use std::compress::write::{GzDecoder, GzEncoder};
    /// use std::io::Write;
    ///
    /// let mut e = GzEncoder::new(Vec::new(), Compression::default());
    /// e.write_all(b"round trip").unwrap();
    /// let gz = e.finish().unwrap();
    ///
    /// let mut d = GzDecoder::new(Vec::new());
    /// d.write_all(gz.as_slice()).unwrap();
    /// assert_eq(d.finish().unwrap(), b"round trip");
    /// ```
    pub struct GzDecoder<W: Write> {
        d: DecW<W>,
    }
    /// A gzip decoder that decompresses every gzip member written to it,
    /// one after another, into the underlying writer.
    ///
    /// The compressed data is kept until [`MultiGzDecoder::try_finish`] or
    /// [`MultiGzDecoder::finish`], which decode it all (navi has no `Drop`:
    /// call one of them).
    pub struct MultiGzDecoder<W: Write> {
        d: DecW<W>,
    }

    fn dec<W: Write>(w: W, fmt: u8, multi: bool) -> DecW<W> {
        DecW {
            inner: w,
            fmt,
            multi,
            input: Vec::new(),
            done: false,
        }
    }

    impl<W: Write> DeflateDecoder<W> {
        /// Creates a decoder that writes the decompressed data to `w`.
        pub fn new(w: W) -> DeflateDecoder<W> {
            DeflateDecoder {
                d: dec(w, RAW, false),
            }
        }
        /// Decodes all the data written so far into the underlying writer,
        /// keeping the decoder.
        ///
        /// # Errors
        ///
        /// An [`io::ErrorKind::InvalidData`] error if the data is not a
        /// valid stream, and the underlying writer's errors.
        pub fn try_finish(&mut self) -> io::Result<()> {
            self.d.try_finish()
        }
        /// Decodes all the data written and returns the underlying writer.
        ///
        /// # Errors
        ///
        /// An [`io::ErrorKind::InvalidData`] error if the data is not a valid
        /// stream, and the underlying writer's errors.
        pub fn finish(mut self) -> io::Result<W> {
            self.d.try_finish()?;
            Ok(self.d.inner)
        }
        /// Returns a reference to the underlying writer.
        pub fn get_ref(&self) -> &W {
            &self.d.inner
        }
        /// Returns a mutable reference to the underlying writer.
        pub fn get_mut(&mut self) -> &mut W {
            &mut self.d.inner
        }
    }

    impl<W: Write> ZlibDecoder<W> {
        /// Creates a decoder that writes the decompressed data to `w`.
        pub fn new(w: W) -> ZlibDecoder<W> {
            ZlibDecoder {
                d: dec(w, ZLIB, false),
            }
        }
        /// Decodes all the data written so far into the underlying writer,
        /// keeping the decoder.
        ///
        /// # Errors
        ///
        /// An [`io::ErrorKind::InvalidData`] error if the data is not a valid
        /// stream, and the underlying writer's errors.
        pub fn try_finish(&mut self) -> io::Result<()> {
            self.d.try_finish()
        }
        /// Decodes all the data written and returns the underlying writer.
        ///
        /// # Errors
        ///
        /// An [`io::ErrorKind::InvalidData`] error if the data is not a valid
        /// stream, and the underlying writer's errors.
        pub fn finish(mut self) -> io::Result<W> {
            self.d.try_finish()?;
            Ok(self.d.inner)
        }
        /// Returns a reference to the underlying writer.
        pub fn get_ref(&self) -> &W {
            &self.d.inner
        }
        /// Returns a mutable reference to the underlying writer.
        pub fn get_mut(&mut self) -> &mut W {
            &mut self.d.inner
        }
    }

    impl<W: Write> GzDecoder<W> {
        /// Creates a decoder that writes the decompressed data to `w`.
        pub fn new(w: W) -> GzDecoder<W> {
            GzDecoder {
                d: dec(w, GZIP, false),
            }
        }
        /// Decodes all the data written so far into the underlying writer,
        /// keeping the decoder.
        ///
        /// # Errors
        ///
        /// An [`io::ErrorKind::InvalidData`] error if the data is not a valid
        /// stream, and the underlying writer's errors.
        pub fn try_finish(&mut self) -> io::Result<()> {
            self.d.try_finish()
        }
        /// Decodes all the data written and returns the underlying writer.
        ///
        /// # Errors
        ///
        /// An [`io::ErrorKind::InvalidData`] error if the data is not a valid
        /// stream, and the underlying writer's errors.
        pub fn finish(mut self) -> io::Result<W> {
            self.d.try_finish()?;
            Ok(self.d.inner)
        }
        /// Returns a reference to the underlying writer.
        pub fn get_ref(&self) -> &W {
            &self.d.inner
        }
        /// Returns a mutable reference to the underlying writer.
        pub fn get_mut(&mut self) -> &mut W {
            &mut self.d.inner
        }
    }

    impl<W: Write> MultiGzDecoder<W> {
        /// Creates a decoder that writes the decompressed data to `w`.
        pub fn new(w: W) -> MultiGzDecoder<W> {
            MultiGzDecoder {
                d: dec(w, GZIP, true),
            }
        }
        /// Decodes all the data written so far into the underlying writer,
        /// keeping the decoder.
        ///
        /// # Errors
        ///
        /// An [`io::ErrorKind::InvalidData`] error if the data is not a valid
        /// stream, and the underlying writer's errors.
        pub fn try_finish(&mut self) -> io::Result<()> {
            self.d.try_finish()
        }
        /// Decodes all the data written and returns the underlying writer.
        ///
        /// # Errors
        ///
        /// An [`io::ErrorKind::InvalidData`] error if the data is not a valid
        /// stream, and the underlying writer's errors.
        pub fn finish(mut self) -> io::Result<W> {
            self.d.try_finish()?;
            Ok(self.d.inner)
        }
        /// Returns a reference to the underlying writer.
        pub fn get_ref(&self) -> &W {
            &self.d.inner
        }
        /// Returns a mutable reference to the underlying writer.
        pub fn get_mut(&mut self) -> &mut W {
            &mut self.d.inner
        }
    }

    impl<W: Write> Write for DeflateDecoder<W> {
        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
            self.d.input.extend_from_slice(buf);
            Ok(buf.len())
        }
        fn flush(&mut self) -> io::Result<()> {
            Ok(())
        }
    }
    impl<W: Write> Write for ZlibDecoder<W> {
        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
            self.d.input.extend_from_slice(buf);
            Ok(buf.len())
        }
        fn flush(&mut self) -> io::Result<()> {
            Ok(())
        }
    }
    impl<W: Write> Write for GzDecoder<W> {
        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
            self.d.input.extend_from_slice(buf);
            Ok(buf.len())
        }
        fn flush(&mut self) -> io::Result<()> {
            Ok(())
        }
    }
    impl<W: Write> Write for MultiGzDecoder<W> {
        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
            self.d.input.extend_from_slice(buf);
            Ok(buf.len())
        }
        fn flush(&mut self) -> io::Result<()> {
            Ok(())
        }
    }
}

/// flate2's per-format paths: compress::gzip::read::GzDecoder and so on.
pub mod deflate {
    pub mod read {
        pub use crate::compress::read::{DeflateDecoder, DeflateEncoder};
    }
    pub mod write {
        pub use crate::compress::write::{DeflateDecoder, DeflateEncoder};
    }
}

pub mod zlib {
    pub mod read {
        pub use crate::compress::read::{ZlibDecoder, ZlibEncoder};
    }
    pub mod write {
        pub use crate::compress::write::{ZlibDecoder, ZlibEncoder};
    }
}

pub mod gzip {
    pub use crate::compress::{GzBuilder, GzHeader};
    pub mod read {
        pub use crate::compress::read::{GzDecoder, GzEncoder, MultiGzDecoder};
    }
    pub mod write {
        pub use crate::compress::write::{GzDecoder, GzEncoder, MultiGzDecoder};
    }
}

pub use read::{DeflateDecoder, GzDecoder, MultiGzDecoder, ZlibDecoder};
pub use write::{DeflateEncoder, GzEncoder, ZlibEncoder};
