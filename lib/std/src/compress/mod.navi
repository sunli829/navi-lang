//! DEFLATE, zlib and gzip (as Go's compress/flate, compress/zlib and
//! compress/gzip, with the API of Rust's flate2 crate): encoders and
//! decoders wrapping a reader (read::) or a writer (write::).
//!
//!     let mut e = GzEncoder::new(Vec::new(), Compression::default());
//!     e.write_all(b"hello")?;
//!     let gz: Vec<u8> = e.finish()?;          // no Drop: finish writes the trailer
//!
//!     let mut d = GzDecoder::new(gz.as_slice());
//!     let mut s = String::new();
//!     d.read_to_string(&mut s)?;

mod deflate_enc;
mod inflate;

use crate::fmt::{self, Debug, Formatter};
use crate::hash::adler32::Adler32;
use crate::hash::crc32;
use crate::io::{self, Read, Write};
use deflate_enc::Deflater;
use inflate::{Bits, Inflater};

/// A compression level, 0 (none) to 9 (best).
#[derive(Clone, PartialEq, Eq, Debug)]
pub struct Compression(u32);

impl Compression {
    pub fn new(level: u32) -> Compression {
        Compression(level)
    }
    pub fn none() -> Compression {
        Compression(0)
    }
    pub fn fast() -> Compression {
        Compression(1)
    }
    pub fn best() -> Compression {
        Compression(9)
    }
    pub fn level(&self) -> u32 {
        self.0
    }
}

impl Default for Compression {
    fn default() -> Compression {
        Compression(6)
    }
}

const RAW: u8 = 0;
const ZLIB: u8 = 1;
const GZIP: u8 = 2;

// --- Encoding ------------------------------------------------------------------------

// An encoder of one of the formats: input in, compressed bytes out.
struct Enc {
    d: Deflater,
    fmt: u8,
    header: Vec<u8>,
    started: bool,
    crc: crc32::Hasher,
    adler: Adler32,
    finished: bool,
}

fn zlib_header(level: u32) -> Vec<u8> {
    let flg = if level <= 1 {
        0x01
    } else if level <= 5 {
        0x5e
    } else if level == 6 {
        0x9c
    } else {
        0xda
    };
    let mut v = Vec::new();
    v.push(0x78u8);
    v.push(flg as u8);
    v
}

impl Enc {
    fn new(fmt: u8, level: u32, header: Vec<u8>) -> Enc {
        let h = if fmt == ZLIB {
            zlib_header(level)
        } else {
            header
        };
        Enc {
            d: Deflater::new(level),
            fmt,
            header: h,
            started: false,
            crc: crc32::Hasher::new(),
            adler: Adler32::new(),
            finished: false,
        }
    }

    fn out(&mut self) -> Vec<u8> {
        let body = self.d.take();
        if self.started {
            return body;
        }
        self.started = true;
        let mut v = self.header.clone();
        v.extend_from_slice(body.as_slice());
        v
    }

    fn feed(&mut self, b: &[u8]) -> Vec<u8> {
        self.d.input(b);
        if self.fmt == GZIP {
            self.crc.update(b);
        }
        if self.fmt == ZLIB {
            self.adler.write_slice(b);
        }
        self.d.run(false);
        self.out()
    }

    fn sync(&mut self) -> Vec<u8> {
        self.d.run(false);
        self.d.sync();
        self.out()
    }

    fn finish(&mut self) -> Vec<u8> {
        if self.finished {
            return Vec::new();
        }
        self.finished = true;
        self.d.run(true);
        let mut v = self.out();
        if self.fmt == ZLIB {
            let a = self.adler.checksum();
            v.push((a >> 24) as u8);
            v.push((a >> 16) as u8);
            v.push((a >> 8) as u8);
            v.push(a as u8);
        } else if self.fmt == GZIP {
            let c = self.crc.clone().finalize();
            let n = self.d.total_in as u32;
            let mut k = 0;
            while k < 4 {
                v.push((c >> (8 * k)) as u8);
                k += 1;
            }
            k = 0;
            while k < 4 {
                v.push((n >> (8 * k)) as u8);
                k += 1;
            }
        }
        v
    }

    fn total_in(&self) -> u64 {
        self.d.total_in
    }
}

// A writer compressing into inner.
struct EncW<W: Write> {
    inner: W,
    e: Enc,
    total_out: u64,
}

impl<W: Write> EncW<W> {
    fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
        let out = self.e.feed(buf);
        self.total_out += out.len() as u64;
        self.inner.write_all(out.as_slice())?;
        Ok(buf.len())
    }

    fn flush(&mut self) -> io::Result<()> {
        let out = self.e.sync();
        self.total_out += out.len() as u64;
        self.inner.write_all(out.as_slice())?;
        self.inner.flush()
    }

    fn try_finish(&mut self) -> io::Result<()> {
        let out = self.e.finish();
        self.total_out += out.len() as u64;
        self.inner.write_all(out.as_slice())?;
        self.inner.flush()
    }
}

// A reader compressing what inner gives.
struct EncR<R: Read> {
    inner: R,
    e: Enc,
    out: Vec<u8>,
    pos: usize,
    eof: bool,
    total_out: u64,
}

impl<R: Read> EncR<R> {
    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        let mut chunk = [0u8; 32768];
        while self.pos == self.out.len() {
            if self.eof {
                return Ok(0);
            }
            let n = self.inner.read(&mut chunk)?;
            self.out = if n == 0 {
                self.eof = true;
                self.e.finish()
            } else {
                self.e.feed(&chunk[0..n])
            };
            self.pos = 0;
        }
        let n = crate::cmp::min(buf.len(), self.out.len() - self.pos);
        buf[0..n].copy_from_slice(&self.out[self.pos..self.pos + n]);
        self.pos += n;
        self.total_out += n as u64;
        Ok(n)
    }
}

// --- Decoding ------------------------------------------------------------------------

/// The header of a gzip member.
#[derive(Clone, PartialEq, Eq, Debug, Default)]
pub struct GzHeader {
    extra: Option<Vec<u8>>,
    filename: Option<Vec<u8>>,
    comment: Option<Vec<u8>>,
    operating_system: u8,
    mtime: u32,
}

impl GzHeader {
    pub fn filename(&self) -> Option<&[u8]> {
        match &self.filename {
            Some(v) => Some(v.as_slice()),
            None => None,
        }
    }
    pub fn extra(&self) -> Option<&[u8]> {
        match &self.extra {
            Some(v) => Some(v.as_slice()),
            None => None,
        }
    }
    pub fn comment(&self) -> Option<&[u8]> {
        match &self.comment {
            Some(v) => Some(v.as_slice()),
            None => None,
        }
    }
    pub fn operating_system(&self) -> u8 {
        self.operating_system
    }
    /// Seconds since the epoch (0: unknown).
    pub fn mtime(&self) -> u32 {
        self.mtime
    }
}

fn bad(msg: &str) -> io::Error {
    io::Error::new(io::ErrorKind::InvalidInput, msg)
}

const D_HEADER: u8 = 0;
const D_BODY: u8 = 1;
const D_DONE: u8 = 2;

// A decoder of one of the formats over a reader.
struct Dec<R: Read> {
    inf: Inflater<R>,
    fmt: u8,
    state: u8,
    multi: bool,
    crc: crc32::Hasher,
    adler: Adler32,
    size: u32,
    header: Option<GzHeader>,
    total_out: u64,
}

impl<R: Read> Dec<R> {
    fn new(inner: R, fmt: u8, multi: bool) -> Dec<R> {
        Dec {
            inf: Inflater::new(Bits::new(inner)),
            fmt,
            state: D_HEADER,
            multi,
            crc: crc32::Hasher::new(),
            adler: Adler32::new(),
            size: 0,
            header: None,
            total_out: 0,
        }
    }

    fn header_now(&mut self) -> io::Result<()> {
        let s = &mut self.inf.src;
        if self.fmt == ZLIB {
            let cmf = s.need_byte()?;
            let flg = s.need_byte()?;
            if cmf & 0x0f != 8 || (cmf as u32 * 256 + flg as u32) % 31 != 0 {
                return Err(bad("invalid zlib header"));
            }
            if flg & 0x20 != 0 {
                return Err(bad("zlib preset dictionaries are not supported"));
            }
        } else if self.fmt == GZIP {
            let mut h = [0u8; 10];
            let mut i = 0;
            while i < 10 {
                h[i] = s.need_byte()?;
                i += 1;
            }
            if h[0] != 0x1f || h[1] != 0x8b {
                return Err(bad("invalid gzip header"));
            }
            if h[2] != 8 {
                return Err(bad("unsupported gzip compression method"));
            }
            let flg = h[3];
            let mut gh = GzHeader::default();
            gh.mtime = h[4] as u32 | (h[5] as u32) << 8 | (h[6] as u32) << 16 | (h[7] as u32) << 24;
            gh.operating_system = h[9];
            if flg & 4 != 0 {
                let n = s.need_byte()? as usize | (s.need_byte()? as usize) << 8;
                let mut x = Vec::new();
                let mut k = 0;
                while k < n {
                    x.push(s.need_byte()?);
                    k += 1;
                }
                gh.extra = Some(x);
            }
            if flg & 8 != 0 {
                let mut x = Vec::new();
                loop {
                    let b = s.need_byte()?;
                    if b == 0 {
                        break;
                    }
                    x.push(b);
                }
                gh.filename = Some(x);
            }
            if flg & 16 != 0 {
                let mut x = Vec::new();
                loop {
                    let b = s.need_byte()?;
                    if b == 0 {
                        break;
                    }
                    x.push(b);
                }
                gh.comment = Some(x);
            }
            if flg & 2 != 0 {
                s.need_byte()?;
                s.need_byte()?;
            }
            self.header = Some(gh);
        }
        Ok(())
    }

    fn trailer(&mut self) -> io::Result<()> {
        self.inf.src.align();
        let s = &mut self.inf.src;
        if self.fmt == ZLIB {
            let mut a: u32 = 0;
            let mut k = 0;
            while k < 4 {
                a = a << 8 | s.need_byte()? as u32;
                k += 1;
            }
            if a != self.adler.checksum() {
                return Err(bad("corrupt zlib stream: checksum mismatch"));
            }
        } else if self.fmt == GZIP {
            let mut c: u32 = 0;
            let mut n: u32 = 0;
            let mut k = 0;
            while k < 4 {
                c |= (s.need_byte()? as u32) << (8 * k);
                k += 1;
            }
            k = 0;
            while k < 4 {
                n |= (s.need_byte()? as u32) << (8 * k);
                k += 1;
            }
            if c != self.crc.clone().finalize() {
                return Err(bad("corrupt gzip stream: CRC mismatch"));
            }
            if n != self.size {
                return Err(bad("corrupt gzip stream: length mismatch"));
            }
        }
        Ok(())
    }

    fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
        loop {
            if self.state == D_DONE || buf.len() == 0 {
                return Ok(0);
            }
            if self.state == D_HEADER {
                self.header_now()?;
                self.state = D_BODY;
            }
            let n = self.inf.read_some(buf)?;
            if n > 0 {
                if self.fmt == GZIP {
                    self.crc.update(&buf[0..n]);
                    self.size = self.size.wrapping_add(n as u32);
                }
                if self.fmt == ZLIB {
                    self.adler.write_slice(&buf[0..n]);
                }
                self.total_out += n as u64;
                return Ok(n);
            }
            self.trailer()?;
            if self.fmt == GZIP && self.multi && !self.inf.src.at_end()? {
                // The next member.
                self.inf.restart();
                self.crc = crc32::Hasher::new();
                self.size = 0;
                self.state = D_HEADER;
                continue;
            }
            self.state = D_DONE;
        }
    }
}

// A writer decompressing into inner: the input is kept until finish (the
// decoder pulls its input).
struct DecW<W: Write> {
    inner: W,
    fmt: u8,
    multi: bool,
    input: Vec<u8>,
    done: bool,
}

impl<W: Write> DecW<W> {
    fn try_finish(&mut self) -> io::Result<()> {
        if self.done {
            return Ok(());
        }
        self.done = true;
        let src: &[u8] = self.input.as_slice();
        let mut d = Dec::new(src, self.fmt, self.multi);
        let mut buf = [0u8; 32768];
        loop {
            let n = d.read(&mut buf)?;
            if n == 0 {
                break;
            }
            self.inner.write_all(&buf[0..n])?;
        }
        self.inner.flush()
    }
}

// --- The public types: one set per format --------------------------------------------

/// Builds a gzip header (as flate2's GzBuilder).
#[derive(Clone, Default)]
pub struct GzBuilder {
    h: GzHeader,
    has_os: bool,
}

impl GzBuilder {
    pub fn new() -> GzBuilder {
        GzBuilder::default()
    }
    pub fn filename<S: Into<Vec<u8>>>(&self, name: S) -> GzBuilder {
        let mut b = self.clone();
        b.h.filename = Some(name.into());
        b
    }
    pub fn comment<S: Into<Vec<u8>>>(&self, c: S) -> GzBuilder {
        let mut b = self.clone();
        b.h.comment = Some(c.into());
        b
    }
    pub fn extra<S: Into<Vec<u8>>>(&self, x: S) -> GzBuilder {
        let mut b = self.clone();
        b.h.extra = Some(x.into());
        b
    }
    pub fn mtime(&self, t: u32) -> GzBuilder {
        let mut b = self.clone();
        b.h.mtime = t;
        b
    }
    pub fn operating_system(&self, os: u8) -> GzBuilder {
        let mut b = self.clone();
        b.h.operating_system = os;
        b.has_os = true;
        b
    }

    fn bytes(&self, level: u32) -> Vec<u8> {
        let mut v = Vec::new();
        let mut flg = 0u8;
        if self.h.extra.is_some() {
            flg |= 4;
        }
        if self.h.filename.is_some() {
            flg |= 8;
        }
        if self.h.comment.is_some() {
            flg |= 16;
        }
        v.extend_from_slice(&[0x1fu8, 0x8b, 8, flg]);
        let t = self.h.mtime;
        v.extend_from_slice(&[t as u8, (t >> 8) as u8, (t >> 16) as u8, (t >> 24) as u8]);
        v.push(if level >= 9 {
            2
        } else if level <= 1 {
            4
        } else {
            0
        });
        v.push(if self.has_os {
            self.h.operating_system
        } else {
            255
        });
        if let Some(x) = &self.h.extra {
            v.push(x.len() as u8);
            v.push((x.len() >> 8) as u8);
            v.extend_from_slice(x.as_slice());
        }
        if let Some(x) = &self.h.filename {
            v.extend_from_slice(x.as_slice());
            v.push(0);
        }
        if let Some(x) = &self.h.comment {
            v.extend_from_slice(x.as_slice());
            v.push(0);
        }
        v
    }

    /// A gzip writer with this header.
    pub fn write<W: Write>(&self, w: W, level: Compression) -> write::GzEncoder<W> {
        write::GzEncoder {
            e: EncW {
                inner: w,
                e: Enc::new(GZIP, level.0, self.bytes(level.0)),
                total_out: 0,
            },
        }
    }

    /// A gzip reader with this header.
    pub fn read<R: Read>(&self, r: R, level: Compression) -> read::GzEncoder<R> {
        read::GzEncoder {
            e: EncR {
                inner: r,
                e: Enc::new(GZIP, level.0, self.bytes(level.0)),
                out: Vec::new(),
                pos: 0,
                eof: false,
                total_out: 0,
            },
        }
    }
}

/// Encoders and decoders that read their input from a reader.
pub mod read {
    use crate::compress::{Compression, Dec, Enc, EncR, GZIP, GzBuilder, GzHeader, RAW, ZLIB};
    use crate::io::{self, Read};

    /// Compresses what a reader gives (raw DEFLATE).
    pub struct DeflateEncoder<R: Read> {
        e: EncR<R>,
    }
    /// Compresses into a zlib stream.
    pub struct ZlibEncoder<R: Read> {
        e: EncR<R>,
    }
    /// Compresses into a gzip member.
    pub struct GzEncoder<R: Read> {
        pub(crate) e: EncR<R>,
    }

    fn enc<R: Read>(r: R, fmt: u8, level: Compression) -> EncR<R> {
        EncR {
            inner: r,
            e: Enc::new(fmt, level.level(), Vec::new()),
            out: Vec::new(),
            pos: 0,
            eof: false,
            total_out: 0,
        }
    }

    impl<R: Read> DeflateEncoder<R> {
        pub fn new(r: R, level: Compression) -> DeflateEncoder<R> {
            DeflateEncoder {
                e: enc(r, RAW, level),
            }
        }
        pub fn get_ref(&self) -> &R {
            &self.e.inner
        }
        pub fn get_mut(&mut self) -> &mut R {
            &mut self.e.inner
        }
        pub fn into_inner(self) -> R {
            self.e.inner
        }
        pub fn total_in(&self) -> u64 {
            self.e.e.total_in()
        }
        pub fn total_out(&self) -> u64 {
            self.e.total_out
        }
    }

    impl<R: Read> ZlibEncoder<R> {
        pub fn new(r: R, level: Compression) -> ZlibEncoder<R> {
            ZlibEncoder {
                e: enc(r, ZLIB, level),
            }
        }
        pub fn get_ref(&self) -> &R {
            &self.e.inner
        }
        pub fn get_mut(&mut self) -> &mut R {
            &mut self.e.inner
        }
        pub fn into_inner(self) -> R {
            self.e.inner
        }
        pub fn total_in(&self) -> u64 {
            self.e.e.total_in()
        }
        pub fn total_out(&self) -> u64 {
            self.e.total_out
        }
    }

    impl<R: Read> GzEncoder<R> {
        pub fn new(r: R, level: Compression) -> GzEncoder<R> {
            GzBuilder::new().read(r, level)
        }
        pub fn get_ref(&self) -> &R {
            &self.e.inner
        }
        pub fn get_mut(&mut self) -> &mut R {
            &mut self.e.inner
        }
        pub fn into_inner(self) -> R {
            self.e.inner
        }
    }

    impl<R: Read> Read for DeflateEncoder<R> {
        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
            self.e.read(buf)
        }
    }
    impl<R: Read> Read for ZlibEncoder<R> {
        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
            self.e.read(buf)
        }
    }
    impl<R: Read> Read for GzEncoder<R> {
        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
            self.e.read(buf)
        }
    }

    /// Decompresses raw DEFLATE data from a reader.
    pub struct DeflateDecoder<R: Read> {
        d: Dec<R>,
    }
    /// Decompresses a zlib stream.
    pub struct ZlibDecoder<R: Read> {
        d: Dec<R>,
    }
    /// Decompresses the first gzip member.
    pub struct GzDecoder<R: Read> {
        d: Dec<R>,
    }
    /// Decompresses every gzip member, one after another.
    pub struct MultiGzDecoder<R: Read> {
        d: Dec<R>,
    }

    impl<R: Read> DeflateDecoder<R> {
        pub fn new(r: R) -> DeflateDecoder<R> {
            DeflateDecoder {
                d: Dec::new(r, RAW, false),
            }
        }
        pub fn get_ref(&self) -> &R {
            &self.d.inf.src.inner
        }
        pub fn get_mut(&mut self) -> &mut R {
            &mut self.d.inf.src.inner
        }
        pub fn total_out(&self) -> u64 {
            self.d.total_out
        }
    }

    impl<R: Read> ZlibDecoder<R> {
        pub fn new(r: R) -> ZlibDecoder<R> {
            ZlibDecoder {
                d: Dec::new(r, ZLIB, false),
            }
        }
        pub fn get_ref(&self) -> &R {
            &self.d.inf.src.inner
        }
        pub fn get_mut(&mut self) -> &mut R {
            &mut self.d.inf.src.inner
        }
        pub fn total_out(&self) -> u64 {
            self.d.total_out
        }
    }

    impl<R: Read> GzDecoder<R> {
        pub fn new(r: R) -> GzDecoder<R> {
            GzDecoder {
                d: Dec::new(r, GZIP, false),
            }
        }
        /// The member's header, once it has been read.
        pub fn header(&self) -> Option<&GzHeader> {
            match &self.d.header {
                Some(h) => Some(h),
                None => None,
            }
        }
        pub fn get_ref(&self) -> &R {
            &self.d.inf.src.inner
        }
        pub fn get_mut(&mut self) -> &mut R {
            &mut self.d.inf.src.inner
        }
    }

    impl<R: Read> MultiGzDecoder<R> {
        pub fn new(r: R) -> MultiGzDecoder<R> {
            MultiGzDecoder {
                d: Dec::new(r, GZIP, true),
            }
        }
        pub fn header(&self) -> Option<&GzHeader> {
            match &self.d.header {
                Some(h) => Some(h),
                None => None,
            }
        }
        pub fn get_ref(&self) -> &R {
            &self.d.inf.src.inner
        }
        pub fn get_mut(&mut self) -> &mut R {
            &mut self.d.inf.src.inner
        }
    }

    impl<R: Read> Read for DeflateDecoder<R> {
        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
            self.d.read(buf)
        }
    }
    impl<R: Read> Read for ZlibDecoder<R> {
        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
            self.d.read(buf)
        }
    }
    impl<R: Read> Read for GzDecoder<R> {
        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
            self.d.read(buf)
        }
    }
    impl<R: Read> Read for MultiGzDecoder<R> {
        fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
            self.d.read(buf)
        }
    }
}

/// Encoders and decoders that write their output to a writer.
pub mod write {
    use crate::compress::{Compression, DecW, Enc, EncW, GZIP, GzBuilder, RAW, ZLIB};
    use crate::io::{self, Write};

    /// Compresses what is written into raw DEFLATE data.
    pub struct DeflateEncoder<W: Write> {
        e: EncW<W>,
    }
    /// Compresses into a zlib stream.
    pub struct ZlibEncoder<W: Write> {
        e: EncW<W>,
    }
    /// Compresses into a gzip member.
    pub struct GzEncoder<W: Write> {
        pub(crate) e: EncW<W>,
    }

    fn enc<W: Write>(w: W, fmt: u8, level: Compression) -> EncW<W> {
        EncW {
            inner: w,
            e: Enc::new(fmt, level.level(), Vec::new()),
            total_out: 0,
        }
    }

    impl<W: Write> DeflateEncoder<W> {
        pub fn new(w: W, level: Compression) -> DeflateEncoder<W> {
            DeflateEncoder {
                e: enc(w, RAW, level),
            }
        }
        /// Writes the end of the stream (call it, or finish: there is no
        /// Drop).
        pub fn try_finish(&mut self) -> io::Result<()> {
            self.e.try_finish()
        }
        /// Ends the stream and returns the writer.
        pub fn finish(mut self) -> io::Result<W> {
            self.e.try_finish()?;
            Ok(self.e.inner)
        }
        pub fn get_ref(&self) -> &W {
            &self.e.inner
        }
        pub fn get_mut(&mut self) -> &mut W {
            &mut self.e.inner
        }
        pub fn total_in(&self) -> u64 {
            self.e.e.total_in()
        }
        pub fn total_out(&self) -> u64 {
            self.e.total_out
        }
    }

    impl<W: Write> ZlibEncoder<W> {
        pub fn new(w: W, level: Compression) -> ZlibEncoder<W> {
            ZlibEncoder {
                e: enc(w, ZLIB, level),
            }
        }
        pub fn try_finish(&mut self) -> io::Result<()> {
            self.e.try_finish()
        }
        pub fn finish(mut self) -> io::Result<W> {
            self.e.try_finish()?;
            Ok(self.e.inner)
        }
        pub fn get_ref(&self) -> &W {
            &self.e.inner
        }
        pub fn get_mut(&mut self) -> &mut W {
            &mut self.e.inner
        }
        pub fn total_in(&self) -> u64 {
            self.e.e.total_in()
        }
        pub fn total_out(&self) -> u64 {
            self.e.total_out
        }
    }

    impl<W: Write> GzEncoder<W> {
        pub fn new(w: W, level: Compression) -> GzEncoder<W> {
            GzBuilder::new().write(w, level)
        }
        pub fn try_finish(&mut self) -> io::Result<()> {
            self.e.try_finish()
        }
        pub fn finish(mut self) -> io::Result<W> {
            self.e.try_finish()?;
            Ok(self.e.inner)
        }
        pub fn get_ref(&self) -> &W {
            &self.e.inner
        }
        pub fn get_mut(&mut self) -> &mut W {
            &mut self.e.inner
        }
    }

    impl<W: Write> Write for DeflateEncoder<W> {
        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
            self.e.write(buf)
        }
        /// A sync flush: everything written so far can be decoded.
        fn flush(&mut self) -> io::Result<()> {
            self.e.flush()
        }
    }
    impl<W: Write> Write for ZlibEncoder<W> {
        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
            self.e.write(buf)
        }
        fn flush(&mut self) -> io::Result<()> {
            self.e.flush()
        }
    }
    impl<W: Write> Write for GzEncoder<W> {
        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
            self.e.write(buf)
        }
        fn flush(&mut self) -> io::Result<()> {
            self.e.flush()
        }
    }

    /// Decompresses what is written (raw DEFLATE) into a writer.
    pub struct DeflateDecoder<W: Write> {
        d: DecW<W>,
    }
    /// Decompresses a zlib stream.
    pub struct ZlibDecoder<W: Write> {
        d: DecW<W>,
    }
    /// Decompresses a gzip member.
    pub struct GzDecoder<W: Write> {
        d: DecW<W>,
    }
    /// Decompresses every gzip member.
    pub struct MultiGzDecoder<W: Write> {
        d: DecW<W>,
    }

    fn dec<W: Write>(w: W, fmt: u8, multi: bool) -> DecW<W> {
        DecW {
            inner: w,
            fmt,
            multi,
            input: Vec::new(),
            done: false,
        }
    }

    impl<W: Write> DeflateDecoder<W> {
        pub fn new(w: W) -> DeflateDecoder<W> {
            DeflateDecoder {
                d: dec(w, RAW, false),
            }
        }
        /// Decodes what was written into the writer.
        pub fn try_finish(&mut self) -> io::Result<()> {
            self.d.try_finish()
        }
        pub fn finish(mut self) -> io::Result<W> {
            self.d.try_finish()?;
            Ok(self.d.inner)
        }
        pub fn get_ref(&self) -> &W {
            &self.d.inner
        }
        pub fn get_mut(&mut self) -> &mut W {
            &mut self.d.inner
        }
    }

    impl<W: Write> ZlibDecoder<W> {
        pub fn new(w: W) -> ZlibDecoder<W> {
            ZlibDecoder {
                d: dec(w, ZLIB, false),
            }
        }
        pub fn try_finish(&mut self) -> io::Result<()> {
            self.d.try_finish()
        }
        pub fn finish(mut self) -> io::Result<W> {
            self.d.try_finish()?;
            Ok(self.d.inner)
        }
        pub fn get_ref(&self) -> &W {
            &self.d.inner
        }
        pub fn get_mut(&mut self) -> &mut W {
            &mut self.d.inner
        }
    }

    impl<W: Write> GzDecoder<W> {
        pub fn new(w: W) -> GzDecoder<W> {
            GzDecoder {
                d: dec(w, GZIP, false),
            }
        }
        pub fn try_finish(&mut self) -> io::Result<()> {
            self.d.try_finish()
        }
        pub fn finish(mut self) -> io::Result<W> {
            self.d.try_finish()?;
            Ok(self.d.inner)
        }
        pub fn get_ref(&self) -> &W {
            &self.d.inner
        }
        pub fn get_mut(&mut self) -> &mut W {
            &mut self.d.inner
        }
    }

    impl<W: Write> MultiGzDecoder<W> {
        pub fn new(w: W) -> MultiGzDecoder<W> {
            MultiGzDecoder {
                d: dec(w, GZIP, true),
            }
        }
        pub fn try_finish(&mut self) -> io::Result<()> {
            self.d.try_finish()
        }
        pub fn finish(mut self) -> io::Result<W> {
            self.d.try_finish()?;
            Ok(self.d.inner)
        }
        pub fn get_ref(&self) -> &W {
            &self.d.inner
        }
        pub fn get_mut(&mut self) -> &mut W {
            &mut self.d.inner
        }
    }

    impl<W: Write> Write for DeflateDecoder<W> {
        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
            self.d.input.extend_from_slice(buf);
            Ok(buf.len())
        }
        fn flush(&mut self) -> io::Result<()> {
            Ok(())
        }
    }
    impl<W: Write> Write for ZlibDecoder<W> {
        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
            self.d.input.extend_from_slice(buf);
            Ok(buf.len())
        }
        fn flush(&mut self) -> io::Result<()> {
            Ok(())
        }
    }
    impl<W: Write> Write for GzDecoder<W> {
        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
            self.d.input.extend_from_slice(buf);
            Ok(buf.len())
        }
        fn flush(&mut self) -> io::Result<()> {
            Ok(())
        }
    }
    impl<W: Write> Write for MultiGzDecoder<W> {
        fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
            self.d.input.extend_from_slice(buf);
            Ok(buf.len())
        }
        fn flush(&mut self) -> io::Result<()> {
            Ok(())
        }
    }
}

/// flate2's per-format paths: compress::gzip::read::GzDecoder and so on.
pub mod deflate {
    pub mod read {
        pub use crate::compress::read::{DeflateDecoder, DeflateEncoder};
    }
    pub mod write {
        pub use crate::compress::write::{DeflateDecoder, DeflateEncoder};
    }
}

pub mod zlib {
    pub mod read {
        pub use crate::compress::read::{ZlibDecoder, ZlibEncoder};
    }
    pub mod write {
        pub use crate::compress::write::{ZlibDecoder, ZlibEncoder};
    }
}

pub mod gzip {
    pub use crate::compress::{GzBuilder, GzHeader};
    pub mod read {
        pub use crate::compress::read::{GzDecoder, GzEncoder, MultiGzDecoder};
    }
    pub mod write {
        pub use crate::compress::write::{GzDecoder, GzEncoder, MultiGzDecoder};
    }
}

pub use read::{DeflateDecoder, GzDecoder, MultiGzDecoder, ZlibDecoder};
pub use write::{DeflateEncoder, GzEncoder, ZlibEncoder};
