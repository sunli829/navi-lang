//! Overloadable operators, ranges and Deref.
//!
//! Implementing the traits of this module lets a type be used with the
//! corresponding operators: `a + b` calls [`Add::add`], `a += b` calls
//! [`AddAssign::add_assign`], `-a` calls [`Neg::neg`], `a[i]` calls
//! [`Index::index`] (or [`IndexMut::index_mut`] when assigned to), and so
//! on. The numeric types implement the arithmetic and bitwise operators
//! with themselves; integer arithmetic panics on overflow.
//!
//! Comparison operators are in [`crate::cmp`] ([`PartialEq`] and
//! [`PartialOrd`]).
//!
//! The operator methods take `self` by value: navi has no move, so the
//! operands are copied (shallow copies; a collection inside is shared).
//!
//! This module also has the range types made by the `..` syntax
//! ([`Range`], [`RangeInclusive`], [`RangeFrom`], [`RangeTo`],
//! [`RangeToInclusive`], [`RangeFull`]), [`RangeBounds`] and [`Bound`], and
//! [`Deref`] and [`DerefMut`], which make `*x` and the automatic
//! dereferencing of method calls work.
//!
//! # Examples
//!
//! ```
//! use std::ops::{Add, Sub};
//!
//! #[derive(Debug, PartialEq)]
//! struct Point {
//!     x: i32,
//!     y: i32,
//! }
//!
//! impl Add for Point {
//!     type Output = Point;
//!
//!     fn add(self, other: Point) -> Point {
//!         Point {
//!             x: self.x + other.x,
//!             y: self.y + other.y,
//!         }
//!     }
//! }
//!
//! impl Sub for Point {
//!     type Output = Point;
//!
//!     fn sub(self, other: Point) -> Point {
//!         Point {
//!             x: self.x - other.x,
//!             y: self.y - other.y,
//!         }
//!     }
//! }
//!
//! assert_eq(
//!     Point { x: 1, y: 0 } + Point { x: 2, y: 3 },
//!     Point { x: 3, y: 3 },
//! );
//! assert_eq(
//!     Point { x: 1, y: 0 } - Point { x: 2, y: 3 },
//!     Point { x: -1, y: -3 },
//! );
//! ```

/// The addition operator `+`.
///
/// `Rhs` is the type of the right-hand side, `Self` by default.
///
/// # Examples
///
/// An addable point:
///
/// ```
/// use std::ops::Add;
///
/// #[derive(Debug, PartialEq)]
/// struct Point {
///     x: i32,
///     y: i32,
/// }
///
/// impl Add for Point {
///     type Output = Point;
///
///     fn add(self, other: Point) -> Point {
///         Point {
///             x: self.x + other.x,
///             y: self.y + other.y,
///         }
///     }
/// }
///
/// assert_eq(
///     Point { x: 1, y: 0 } + Point { x: 2, y: 3 },
///     Point { x: 3, y: 3 },
/// );
/// ```
///
/// Adding a different type, here a number to every coordinate:
///
/// ```
/// use std::ops::Add;
///
/// #[derive(Debug, PartialEq)]
/// struct Point {
///     x: i32,
///     y: i32,
/// }
///
/// impl Add<i32> for Point {
///     type Output = Point;
///
///     fn add(self, n: i32) -> Point {
///         Point {
///             x: self.x + n,
///             y: self.y + n,
///         }
///     }
/// }
///
/// assert_eq(Point { x: 1, y: 2 } + 10, Point { x: 11, y: 12 });
/// ```
pub trait Add<Rhs = Self> {
    /// The resulting type after applying the `+` operator.
    type Output;
    /// Performs the `+` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::Add;
    ///
    /// assert_eq(12.add(1), 13);
    /// ```
    fn add(self, rhs: Rhs) -> Self::Output;
}

/// The subtraction operator `-`.
///
/// `Rhs` is the type of the right-hand side, `Self` by default.
///
/// # Examples
///
/// ```
/// use std::ops::Sub;
///
/// #[derive(Debug, PartialEq)]
/// struct Point {
///     x: i32,
///     y: i32,
/// }
///
/// impl Sub for Point {
///     type Output = Point;
///
///     fn sub(self, other: Point) -> Point {
///         Point {
///             x: self.x - other.x,
///             y: self.y - other.y,
///         }
///     }
/// }
///
/// assert_eq(
///     Point { x: 3, y: 3 } - Point { x: 2, y: 3 },
///     Point { x: 1, y: 0 },
/// );
/// ```
pub trait Sub<Rhs = Self> {
    /// The resulting type after applying the `-` operator.
    type Output;
    /// Performs the `-` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::Sub;
    ///
    /// assert_eq(12.sub(1), 11);
    /// ```
    fn sub(self, rhs: Rhs) -> Self::Output;
}

/// The multiplication operator `*`.
///
/// `Rhs` is the type of the right-hand side, `Self` by default.
///
/// # Examples
///
/// Multiplying a vector by a scalar:
///
/// ```
/// use std::ops::Mul;
///
/// #[derive(Debug, PartialEq)]
/// struct Vector {
///     x: f64,
///     y: f64,
/// }
///
/// impl Mul<f64> for Vector {
///     type Output = Vector;
///
///     fn mul(self, k: f64) -> Vector {
///         Vector {
///             x: self.x * k,
///             y: self.y * k,
///         }
///     }
/// }
///
/// assert_eq(Vector { x: 1.0, y: 2.5 } * 2.0, Vector { x: 2.0, y: 5.0 });
/// ```
pub trait Mul<Rhs = Self> {
    /// The resulting type after applying the `*` operator.
    type Output;
    /// Performs the `*` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::Mul;
    ///
    /// assert_eq(12.mul(2), 24);
    /// ```
    fn mul(self, rhs: Rhs) -> Self::Output;
}

/// The division operator `/`.
///
/// `Rhs` is the type of the right-hand side, `Self` by default. Integer
/// division by zero panics.
///
/// # Examples
///
/// ```
/// use std::ops::Div;
///
/// // Rational numbers, without reducing.
/// #[derive(Debug, PartialEq)]
/// struct Rational {
///     num: i32,
///     den: i32,
/// }
///
/// impl Div for Rational {
///     type Output = Rational;
///
///     fn div(self, rhs: Rational) -> Rational {
///         if rhs.num == 0 {
///             panic("Cannot divide by zero-valued `Rational`!");
///         }
///         Rational {
///             num: self.num * rhs.den,
///             den: self.den * rhs.num,
///         }
///     }
/// }
///
/// let half = Rational { num: 1, den: 2 };
/// let quarter = Rational { num: 1, den: 4 };
/// assert_eq(half / quarter, Rational { num: 4, den: 2 });
/// ```
pub trait Div<Rhs = Self> {
    /// The resulting type after applying the `/` operator.
    type Output;
    /// Performs the `/` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::Div;
    ///
    /// assert_eq(12.div(2), 6);
    /// ```
    fn div(self, rhs: Rhs) -> Self::Output;
}

/// The remainder operator `%`.
///
/// `Rhs` is the type of the right-hand side, `Self` by default. For
/// integers the result has the sign of the dividend, and a remainder by
/// zero panics.
///
/// # Examples
///
/// ```
/// use std::ops::Rem;
///
/// // A clock hour, wrapping at 12.
/// #[derive(Debug, PartialEq)]
/// struct Hours(u32);
///
/// impl Rem<u32> for Hours {
///     type Output = Hours;
///
///     fn rem(self, modulus: u32) -> Hours {
///         Hours(self.0 % modulus)
///     }
/// }
///
/// assert_eq(Hours(27) % 12, Hours(3));
/// assert_eq(-7 % 3, -1);
/// ```
pub trait Rem<Rhs = Self> {
    /// The resulting type after applying the `%` operator.
    type Output;
    /// Performs the `%` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::Rem;
    ///
    /// assert_eq(12.rem(10), 2);
    /// ```
    fn rem(self, rhs: Rhs) -> Self::Output;
}

/// The unary negation operator `-`.
///
/// # Examples
///
/// ```
/// use std::ops::Neg;
///
/// #[derive(Debug, PartialEq)]
/// enum Sign {
///     Negative,
///     Zero,
///     Positive,
/// }
///
/// impl Neg for Sign {
///     type Output = Sign;
///
///     fn neg(self) -> Sign {
///         match self {
///             Sign::Negative => Sign::Positive,
///             Sign::Zero => Sign::Zero,
///             Sign::Positive => Sign::Negative,
///         }
///     }
/// }
///
/// assert_eq(-Sign::Positive, Sign::Negative);
/// assert_eq(-Sign::Negative, Sign::Positive);
/// assert_eq(-Sign::Zero, Sign::Zero);
/// ```
pub trait Neg {
    /// The resulting type after applying the `-` operator.
    type Output;
    /// Performs the unary `-` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::Neg;
    ///
    /// let x: i32 = 12;
    /// assert_eq(x.neg(), -12);
    /// ```
    fn neg(self) -> Self::Output;
}

/// The unary logical negation operator `!`.
///
/// For `bool` it is logical not; for integers, bitwise not.
///
/// # Examples
///
/// ```
/// use std::ops::Not;
///
/// #[derive(Debug, PartialEq)]
/// enum Answer {
///     Yes,
///     No,
/// }
///
/// impl Not for Answer {
///     type Output = Answer;
///
///     fn not(self) -> Answer {
///         match self {
///             Answer::Yes => Answer::No,
///             Answer::No => Answer::Yes,
///         }
///     }
/// }
///
/// assert_eq(!Answer::Yes, Answer::No);
/// assert_eq(!Answer::No, Answer::Yes);
/// assert_eq(!0u8, 255);
/// ```
pub trait Not {
    /// The resulting type after applying the `!` operator.
    type Output;
    /// Performs the unary `!` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::Not;
    ///
    /// assert_eq(true.not(), false);
    /// assert_eq(0b1010u8.not(), 0b11110101);
    /// ```
    fn not(self) -> Self::Output;
}

/// The bitwise AND operator `&`.
///
/// For `bool` it is logical and (without short-circuit: both sides are
/// evaluated, unlike `&&`).
///
/// # Examples
///
/// ```
/// use std::ops::BitAnd;
///
/// // A set of up to 8 flags.
/// #[derive(Debug, PartialEq)]
/// struct Flags(u8);
///
/// impl BitAnd for Flags {
///     type Output = Flags;
///
///     fn bitand(self, rhs: Flags) -> Flags {
///         Flags(self.0 & rhs.0)
///     }
/// }
///
/// assert_eq(Flags(0b1100) & Flags(0b1010), Flags(0b1000));
/// ```
pub trait BitAnd<Rhs = Self> {
    /// The resulting type after applying the `&` operator.
    type Output;
    /// Performs the `&` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::BitAnd;
    ///
    /// assert_eq(true.bitand(false), false);
    /// assert_eq(5u8.bitand(1), 1);
    /// ```
    fn bitand(self, rhs: Rhs) -> Self::Output;
}

/// The bitwise OR operator `|`.
///
/// For `bool` it is logical or (without short-circuit: both sides are
/// evaluated, unlike `||`).
///
/// # Examples
///
/// ```
/// use std::ops::BitOr;
///
/// #[derive(Debug, PartialEq)]
/// struct Flags(u8);
///
/// impl BitOr for Flags {
///     type Output = Flags;
///
///     fn bitor(self, rhs: Flags) -> Flags {
///         Flags(self.0 | rhs.0)
///     }
/// }
///
/// assert_eq(Flags(0b1100) | Flags(0b1010), Flags(0b1110));
/// ```
pub trait BitOr<Rhs = Self> {
    /// The resulting type after applying the `|` operator.
    type Output;
    /// Performs the `|` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::BitOr;
    ///
    /// assert_eq(false.bitor(true), true);
    /// assert_eq(5u8.bitor(2), 7);
    /// ```
    fn bitor(self, rhs: Rhs) -> Self::Output;
}

/// The bitwise XOR operator `^`.
///
/// # Examples
///
/// ```
/// use std::ops::BitXor;
///
/// #[derive(Debug, PartialEq)]
/// struct Flags(u8);
///
/// impl BitXor for Flags {
///     type Output = Flags;
///
///     fn bitxor(self, rhs: Flags) -> Flags {
///         Flags(self.0 ^ rhs.0)
///     }
/// }
///
/// assert_eq(Flags(0b1100) ^ Flags(0b1010), Flags(0b0110));
/// ```
pub trait BitXor<Rhs = Self> {
    /// The resulting type after applying the `^` operator.
    type Output;
    /// Performs the `^` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::BitXor;
    ///
    /// assert_eq(true.bitxor(true), false);
    /// assert_eq(5u8.bitxor(1), 4);
    /// ```
    fn bitxor(self, rhs: Rhs) -> Self::Output;
}

/// The left shift operator `<<`.
///
/// For integers, the shift amount can be any integer type; a shift by the
/// width of the type or more panics.
///
/// # Examples
///
/// ```
/// use std::ops::Shl;
///
/// #[derive(Debug, PartialEq)]
/// struct Bits(u32);
///
/// impl Shl<u32> for Bits {
///     type Output = Bits;
///
///     fn shl(self, n: u32) -> Bits {
///         Bits(self.0 << n)
///     }
/// }
///
/// assert_eq(Bits(1) << 4, Bits(16));
/// ```
pub trait Shl<Rhs = Self> {
    /// The resulting type after applying the `<<` operator.
    type Output;
    /// Performs the `<<` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::Shl;
    ///
    /// assert_eq(5u8.shl(1), 10);
    /// ```
    fn shl(self, rhs: Rhs) -> Self::Output;
}

/// The right shift operator `>>`.
///
/// For integers it is an arithmetic shift for signed types (the sign is
/// kept) and a logical shift for unsigned ones; a shift by the width of the
/// type or more panics.
///
/// # Examples
///
/// ```
/// use std::ops::Shr;
///
/// #[derive(Debug, PartialEq)]
/// struct Bits(u32);
///
/// impl Shr<u32> for Bits {
///     type Output = Bits;
///
///     fn shr(self, n: u32) -> Bits {
///         Bits(self.0 >> n)
///     }
/// }
///
/// assert_eq(Bits(16) >> 4, Bits(1));
/// assert_eq(-16 >> 2, -4);
/// ```
pub trait Shr<Rhs = Self> {
    /// The resulting type after applying the `>>` operator.
    type Output;
    /// Performs the `>>` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::Shr;
    ///
    /// assert_eq(5u8.shr(1), 2);
    /// ```
    fn shr(self, rhs: Rhs) -> Self::Output;
}

/// The addition assignment operator `+=`.
///
/// # Examples
///
/// ```
/// use std::ops::AddAssign;
///
/// #[derive(Debug, PartialEq)]
/// struct Point {
///     x: i32,
///     y: i32,
/// }
///
/// impl AddAssign for Point {
///     fn add_assign(&mut self, other: Point) {
///         self.x += other.x;
///         self.y += other.y;
///     }
/// }
///
/// let mut point = Point { x: 1, y: 0 };
/// point += Point { x: 2, y: 3 };
/// assert_eq(point, Point { x: 3, y: 3 });
/// ```
pub trait AddAssign<Rhs = Self> {
    /// Performs the `+=` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::AddAssign;
    ///
    /// let mut x: u32 = 12;
    /// x.add_assign(1);
    /// assert_eq(x, 13);
    /// ```
    fn add_assign(&mut self, rhs: Rhs);
}

/// The subtraction assignment operator `-=`.
///
/// # Examples
///
/// ```
/// use std::ops::SubAssign;
///
/// #[derive(Debug, PartialEq)]
/// struct Point {
///     x: i32,
///     y: i32,
/// }
///
/// impl SubAssign for Point {
///     fn sub_assign(&mut self, other: Point) {
///         self.x -= other.x;
///         self.y -= other.y;
///     }
/// }
///
/// let mut point = Point { x: 3, y: 3 };
/// point -= Point { x: 2, y: 3 };
/// assert_eq(point, Point { x: 1, y: 0 });
/// ```
pub trait SubAssign<Rhs = Self> {
    /// Performs the `-=` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::SubAssign;
    ///
    /// let mut x: u32 = 12;
    /// x.sub_assign(1);
    /// assert_eq(x, 11);
    /// ```
    fn sub_assign(&mut self, rhs: Rhs);
}

/// The multiplication assignment operator `*=`.
///
/// # Examples
///
/// ```
/// use std::ops::MulAssign;
///
/// #[derive(Debug, PartialEq)]
/// struct Frequency {
///     hertz: f64,
/// }
///
/// impl MulAssign<f64> for Frequency {
///     fn mul_assign(&mut self, rhs: f64) {
///         self.hertz *= rhs;
///     }
/// }
///
/// let mut frequency = Frequency { hertz: 50.0 };
/// frequency *= 4.0;
/// assert_eq(frequency, Frequency { hertz: 200.0 });
/// ```
pub trait MulAssign<Rhs = Self> {
    /// Performs the `*=` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::MulAssign;
    ///
    /// let mut x: u32 = 12;
    /// x.mul_assign(2);
    /// assert_eq(x, 24);
    /// ```
    fn mul_assign(&mut self, rhs: Rhs);
}

/// The division assignment operator `/=`.
///
/// # Examples
///
/// ```
/// use std::ops::DivAssign;
///
/// #[derive(Debug, PartialEq)]
/// struct Frequency {
///     hertz: f64,
/// }
///
/// impl DivAssign<f64> for Frequency {
///     fn div_assign(&mut self, rhs: f64) {
///         self.hertz /= rhs;
///     }
/// }
///
/// let mut frequency = Frequency { hertz: 200.0 };
/// frequency /= 4.0;
/// assert_eq(frequency, Frequency { hertz: 50.0 });
/// ```
pub trait DivAssign<Rhs = Self> {
    /// Performs the `/=` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::DivAssign;
    ///
    /// let mut x: u32 = 12;
    /// x.div_assign(2);
    /// assert_eq(x, 6);
    /// ```
    fn div_assign(&mut self, rhs: Rhs);
}

/// The remainder assignment operator `%=`.
///
/// # Examples
///
/// ```
/// use std::ops::RemAssign;
///
/// struct CookieJar {
///     cookies: u32,
/// }
///
/// impl RemAssign<u32> for CookieJar {
///     fn rem_assign(&mut self, piles: u32) {
///         self.cookies %= piles;
///     }
/// }
///
/// let mut jar = CookieJar { cookies: 31 };
/// // Share the cookies out in 3 equal piles; keep what is left.
/// jar %= 3;
/// assert_eq(jar.cookies, 1);
/// ```
pub trait RemAssign<Rhs = Self> {
    /// Performs the `%=` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::RemAssign;
    ///
    /// let mut x: u32 = 12;
    /// x.rem_assign(10);
    /// assert_eq(x, 2);
    /// ```
    fn rem_assign(&mut self, rhs: Rhs);
}

/// The bitwise AND assignment operator `&=`.
///
/// # Examples
///
/// ```
/// use std::ops::BitAndAssign;
///
/// #[derive(Debug, PartialEq)]
/// struct Flags(u8);
///
/// impl BitAndAssign for Flags {
///     fn bitand_assign(&mut self, rhs: Flags) {
///         self.0 &= rhs.0;
///     }
/// }
///
/// let mut f = Flags(0b1100);
/// f &= Flags(0b1010);
/// assert_eq(f, Flags(0b1000));
/// ```
pub trait BitAndAssign<Rhs = Self> {
    /// Performs the `&=` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::BitAndAssign;
    ///
    /// let mut x = true;
    /// x.bitand_assign(false);
    /// assert(!x);
    /// ```
    fn bitand_assign(&mut self, rhs: Rhs);
}

/// The bitwise OR assignment operator `|=`.
///
/// # Examples
///
/// ```
/// use std::ops::BitOrAssign;
///
/// #[derive(Debug, PartialEq)]
/// struct Flags(u8);
///
/// impl BitOrAssign for Flags {
///     fn bitor_assign(&mut self, rhs: Flags) {
///         self.0 |= rhs.0;
///     }
/// }
///
/// let mut f = Flags(0b1100);
/// f |= Flags(0b1010);
/// assert_eq(f, Flags(0b1110));
/// ```
pub trait BitOrAssign<Rhs = Self> {
    /// Performs the `|=` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::BitOrAssign;
    ///
    /// let mut x = 0b0101u8;
    /// x.bitor_assign(0b0010);
    /// assert_eq(x, 0b0111);
    /// ```
    fn bitor_assign(&mut self, rhs: Rhs);
}

/// The bitwise XOR assignment operator `^=`.
///
/// # Examples
///
/// ```
/// use std::ops::BitXorAssign;
///
/// #[derive(Debug, PartialEq)]
/// struct Flags(u8);
///
/// impl BitXorAssign for Flags {
///     fn bitxor_assign(&mut self, rhs: Flags) {
///         self.0 ^= rhs.0;
///     }
/// }
///
/// let mut f = Flags(0b1100);
/// f ^= Flags(0b1010);
/// assert_eq(f, Flags(0b0110));
/// ```
pub trait BitXorAssign<Rhs = Self> {
    /// Performs the `^=` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::BitXorAssign;
    ///
    /// let mut x = 0b0101u8;
    /// x.bitxor_assign(0b0110);
    /// assert_eq(x, 0b0011);
    /// ```
    fn bitxor_assign(&mut self, rhs: Rhs);
}

/// The left shift assignment operator `<<=`.
///
/// # Examples
///
/// ```
/// use std::ops::ShlAssign;
///
/// #[derive(Debug, PartialEq)]
/// struct Bits(u32);
///
/// impl ShlAssign<u32> for Bits {
///     fn shl_assign(&mut self, n: u32) {
///         self.0 <<= n;
///     }
/// }
///
/// let mut b = Bits(1);
/// b <<= 3;
/// assert_eq(b, Bits(8));
/// ```
pub trait ShlAssign<Rhs = Self> {
    /// Performs the `<<=` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::ShlAssign;
    ///
    /// let mut x: u8 = 5;
    /// x <<= 1; // x.shl_assign(1)
    /// assert_eq(x, 10);
    /// ```
    fn shl_assign(&mut self, rhs: Rhs);
}

/// The right shift assignment operator `>>=`.
///
/// # Examples
///
/// ```
/// use std::ops::ShrAssign;
///
/// #[derive(Debug, PartialEq)]
/// struct Bits(u32);
///
/// impl ShrAssign<u32> for Bits {
///     fn shr_assign(&mut self, n: u32) {
///         self.0 >>= n;
///     }
/// }
///
/// let mut b = Bits(8);
/// b >>= 3;
/// assert_eq(b, Bits(1));
/// ```
pub trait ShrAssign<Rhs = Self> {
    /// Performs the `>>=` operation.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::ShrAssign;
    ///
    /// let mut x: u8 = 5;
    /// x >>= 1; // x.shr_assign(1)
    /// assert_eq(x, 2);
    /// ```
    fn shr_assign(&mut self, rhs: Rhs);
}

/// Indexing operations (`container[index]`) in immutable contexts.
///
/// `container[index]` is `*container.index(index)`. When the indexed place
/// is assigned to or borrowed mutably, [`IndexMut`] is used instead.
/// [`Vec`] implements it for `usize`; slices and arrays are indexed by the
/// compiler.
///
/// # Examples
///
/// ```
/// use std::ops::Index;
///
/// enum Nucleotide {
///     A,
///     C,
///     G,
///     T,
/// }
///
/// struct NucleotideCount {
///     a: usize,
///     c: usize,
///     g: usize,
///     t: usize,
/// }
///
/// impl Index<Nucleotide> for NucleotideCount {
///     type Output = usize;
///
///     fn index(&self, nucleotide: Nucleotide) -> &usize {
///         match nucleotide {
///             Nucleotide::A => &self.a,
///             Nucleotide::C => &self.c,
///             Nucleotide::G => &self.g,
///             Nucleotide::T => &self.t,
///         }
///     }
/// }
///
/// let nucleotide_count = NucleotideCount {
///     a: 14,
///     c: 9,
///     g: 10,
///     t: 12,
/// };
/// assert_eq(nucleotide_count[Nucleotide::A], 14);
/// assert_eq(nucleotide_count[Nucleotide::C], 9);
/// assert_eq(nucleotide_count[Nucleotide::G], 10);
/// assert_eq(nucleotide_count[Nucleotide::T], 12);
/// ```
pub trait Index<Idx> {
    /// The returned type after indexing.
    type Output;
    /// Performs the indexing (`container[index]`) operation.
    ///
    /// # Panics
    ///
    /// May panic if the index is out of bounds.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::Index;
    ///
    /// let v = Vec::from([10, 20, 30]);
    /// assert_eq(*v.index(1), 20);
    /// assert_eq(v[1], 20);
    /// ```
    fn index(&self, index: Idx) -> &Self::Output;
}

/// Indexing operations (`container[index]`) in mutable contexts.
///
/// `container[index] = value` and `container[index].field += 1` call
/// [`index_mut`](Self::index_mut). The type must also implement [`Index`].
///
/// # Examples
///
/// ```
/// use std::ops::{Index, IndexMut};
///
/// #[derive(Debug)]
/// enum Side {
///     Left,
///     Right,
/// }
///
/// #[derive(Debug, PartialEq)]
/// enum Weight {
///     Kilogram(f32),
///     Pound(f32),
/// }
///
/// struct Balance {
///     left: Weight,
///     right: Weight,
/// }
///
/// impl Index<Side> for Balance {
///     type Output = Weight;
///
///     fn index(&self, index: Side) -> &Weight {
///         match index {
///             Side::Left => &self.left,
///             Side::Right => &self.right,
///         }
///     }
/// }
///
/// impl IndexMut<Side> for Balance {
///     fn index_mut(&mut self, index: Side) -> &mut Weight {
///         match index {
///             Side::Left => &mut self.left,
///             Side::Right => &mut self.right,
///         }
///     }
/// }
///
/// let mut balance = Balance {
///     right: Weight::Kilogram(2.5),
///     left: Weight::Pound(1.5),
/// };
/// assert_eq(balance[Side::Right], Weight::Kilogram(2.5));
/// balance[Side::Left] = Weight::Kilogram(3.0);
/// assert_eq(balance[Side::Left], Weight::Kilogram(3.0));
/// ```
pub trait IndexMut<Idx>: Index<Idx> {
    /// Performs the mutable indexing (`container[index]`) operation.
    ///
    /// # Panics
    ///
    /// May panic if the index is out of bounds.
    ///
    /// # Examples
    ///
    /// ```
    /// let mut v = Vec::from([10, 20, 30]);
    /// v[1] = 25;
    /// v[2] += 1;
    /// assert_eq(v, [10, 25, 31]);
    /// ```
    fn index_mut(&mut self, index: Idx) -> &mut Self::Output;
}

/// Used for immutable dereferencing operations, like `*v`.
///
/// Besides the explicit `*v`, the compiler dereferences implicitly
/// (deref coercion, as in Rust):
///
/// - a method call `v.method()` follows the `Deref` chain until it finds the
///   method, so a [`String`] has the methods of `str` and a [`Vec`] those of
///   slices;
/// - where a `&Target` is expected, a `&Self` can be passed (a `&String` for a
///   `&str`, a `&Vec<T>` for a `&[T]`).
///
/// Implement `Deref` for wrappers that should be used like the value they
/// wrap.
///
/// # Examples
///
/// ```
/// use std::ops::Deref;
///
/// struct Name {
///     value: String,
/// }
///
/// impl Deref for Name {
///     type Target = String;
///
///     fn deref(&self) -> &String {
///         &self.value
///     }
/// }
///
/// let x = Name {
///     value: "navi".to_string(),
/// };
/// assert_eq(*x, "navi");
/// assert_eq(x.len(), 4); // String::len through Deref
/// assert(x.starts_with("na")); // str::starts_with, through two Derefs
/// ```
pub trait Deref {
    /// The resulting type after dereferencing.
    type Target;
    /// Dereferences the value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::Deref;
    ///
    /// let s = "hello".to_string();
    /// let t: &str = s.deref();
    /// assert_eq(t, "hello");
    /// ```
    fn deref(&self) -> &Self::Target;
}

/// Used for mutable dereferencing operations, like in `*v = 1;`.
///
/// Besides the explicit `*v`, a method call that needs `&mut self`
/// follows the `DerefMut` chain until it finds the method (as in Rust).
/// The type must also implement [`Deref`].
///
/// # Examples
///
/// ```
/// use std::ops::{Deref, DerefMut};
///
/// struct Stack {
///     items: Vec<i32>,
/// }
///
/// impl Deref for Stack {
///     type Target = Vec<i32>;
///
///     fn deref(&self) -> &Vec<i32> {
///         &self.items
///     }
/// }
///
/// impl DerefMut for Stack {
///     fn deref_mut(&mut self) -> &mut Vec<i32> {
///         &mut self.items
///     }
/// }
///
/// let mut s = Stack { items: Vec::new() };
/// s.push(1); // Vec::push through DerefMut
/// s.push(2);
/// assert_eq(s.len(), 2);
/// *s = Vec::from([7]);
/// assert_eq(s.items, [7]);
/// ```
pub trait DerefMut: Deref {
    /// Mutably dereferences the value.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::DerefMut;
    ///
    /// let mut v = Vec::from([1, 2, 3]);
    /// let s: &mut [i32] = v.deref_mut();
    /// s[0] = 10;
    /// assert_eq(v, [10, 2, 3]);
    /// ```
    fn deref_mut(&mut self) -> &mut Self::Target;
}

/// A (half-open) range bounded inclusively below and exclusively above
/// (`start..end`).
///
/// The range `start..end` contains all values with `start <= x < end`. It
/// is empty if `start >= end`.
///
/// It is an [`Iterator`](crate::iter::Iterator) (and double-ended) over
/// integers and `char`s, and it slices strings, slices and vectors
/// (`&v[1..3]`). Unlike Rust, it has no `contains` or `is_empty` methods:
/// compare with the fields.
///
/// # Examples
///
/// ```
/// use std::ops::Range;
///
/// assert_eq(3..5, Range { start: 3, end: 5 });
/// assert_eq((3..6).sum::<i32>(), 3 + 4 + 5);
///
/// let arr = [0, 1, 2, 3, 4];
/// assert_eq(&arr[1..3], &[1, 2][..]);
///
/// let r = 1..4;
/// assert_eq(r.start, 1);
/// assert_eq(r.end, 4);
/// let v: Vec<i32> = r.rev().collect();
/// assert_eq(v, [3, 2, 1]);
/// ```
#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub struct Range<Idx> {
    /// The lower bound of the range (inclusive).
    pub start: Idx,
    /// The upper bound of the range (exclusive).
    pub end: Idx,
}

/// A range bounded inclusively below and above (`start..=end`).
///
/// The range `start..=end` contains all values with `start <= x <= end`.
/// It is empty if `start > end`.
///
/// It is an [`Iterator`](crate::iter::Iterator) (and double-ended) over
/// integers and `char`s, and it slices strings, slices and vectors. Unlike
/// Rust, its bounds are the public fields `start` and `end` (there are no
/// `new`, `start()`, `end()`, `contains` or `is_empty` methods). Iterating
/// up to the maximum of the type (`0u8..=255`) ends without overflowing.
///
/// # Examples
///
/// ```
/// use std::ops::RangeInclusive;
///
/// assert_eq(3..=5, RangeInclusive { start: 3, end: 5 });
/// assert_eq((3..=5).sum::<i32>(), 3 + 4 + 5);
///
/// let arr = [0, 1, 2, 3, 4];
/// assert_eq(&arr[1..=3], &[1, 2, 3][..]);
/// let chars: String = ('a'..='e').collect();
/// assert_eq(chars, "abcde");
/// ```
#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub struct RangeInclusive<Idx> {
    /// The lower bound of the range (inclusive).
    pub start: Idx,
    /// The upper bound of the range (inclusive).
    pub end: Idx,
}

/// A range only bounded inclusively below (`start..`).
///
/// The `RangeFrom` `start..` contains all values with `x >= start`. As an
/// [`Iterator`](crate::iter::Iterator) it counts up without end (and panics
/// when it overflows the type); combine it with
/// [`take`](crate::iter::Iterator::take) or
/// [`zip`](crate::iter::Iterator::zip). It also slices (`&v[2..]`).
///
/// # Examples
///
/// ```
/// use std::ops::RangeFrom;
///
/// assert_eq(2.., RangeFrom { start: 2 });
/// let v: Vec<i32> = (2..).take(3).collect();
/// assert_eq(v, [2, 3, 4]);
///
/// let arr = [0, 1, 2, 3, 4];
/// assert_eq(&arr[2..], &[2, 3, 4][..]);
/// ```
#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub struct RangeFrom<Idx> {
    /// The lower bound of the range (inclusive).
    pub start: Idx,
}

/// A range only bounded exclusively above (`..end`).
///
/// The `RangeTo` `..end` contains all values with `x < end`. It cannot be
/// iterated (it has no starting point); it is used to slice (`&v[..2]`).
///
/// # Examples
///
/// ```
/// use std::ops::RangeTo;
///
/// assert_eq(..5, RangeTo { end: 5 });
///
/// let arr = [0, 1, 2, 3, 4];
/// assert_eq(&arr[..3], &[0, 1, 2][..]);
/// assert_eq(&"hello"[..2], "he");
/// ```
#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub struct RangeTo<Idx> {
    /// The upper bound of the range (exclusive).
    pub end: Idx,
}

/// A range only bounded inclusively above (`..=end`).
///
/// The `RangeToInclusive` `..=end` contains all values with `x <= end`. It
/// cannot be iterated (it has no starting point); it is used to slice
/// (`&v[..=2]`).
///
/// # Examples
///
/// ```
/// use std::ops::RangeToInclusive;
///
/// assert_eq(..=5, RangeToInclusive { end: 5 });
///
/// let arr = [0, 1, 2, 3, 4];
/// assert_eq(&arr[..=2], &[0, 1, 2][..]);
/// ```
#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub struct RangeToInclusive<Idx> {
    /// The upper bound of the range (inclusive).
    pub end: Idx,
}

/// An unbounded range (`..`).
///
/// `RangeFull` is mainly used to slice everything: `&v[..]`.
///
/// # Examples
///
/// ```
/// use std::ops::RangeFull;
///
/// assert_eq(.., RangeFull);
///
/// let arr = [0, 1, 2, 3, 4];
/// assert_eq(&arr[..], &[0, 1, 2, 3, 4][..]);
/// ```
#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub struct RangeFull;

/// An endpoint of a range.
///
/// [`RangeBounds::start_bound`] and [`RangeBounds::end_bound`] return it,
/// and a pair `(Bound<T>, Bound<T>)` is itself a range, which can express
/// ranges the `..` syntax cannot (such as one excluding its start).
///
/// # Examples
///
/// ```
/// use std::ops::{Bound, RangeBounds};
///
/// assert_eq((1..5).start_bound(), Bound::Included(&1));
/// assert_eq((1..5).end_bound(), Bound::Excluded(&5));
/// assert_eq((1..).end_bound(), Bound::Unbounded);
///
/// // Elements after index 1, up to and including index 3.
/// let mut v = Vec::from([0, 1, 2, 3, 4]);
/// let d: Vec<i32> = v.drain((Bound::Excluded(1), Bound::Included(3))).collect();
/// assert_eq(d, [2, 3]);
/// assert_eq(v, [0, 1, 4]);
/// ```
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum Bound<T> {
    /// An inclusive bound.
    Included(T),
    /// An exclusive bound.
    Excluded(T),
    /// An infinite endpoint: the range has no bound in this direction.
    Unbounded,
}

/// Ranges over T (used by Vec::drain and friends).
///
/// It is implemented by all the range types (`..`, `a..`, `..b`, `a..b`,
/// `..=b`, `a..=b`) and by `(Bound<T>, Bound<T>)`. Methods that take a part
/// of a collection, such as [`Vec::drain`](crate::vec::Vec::drain) and
/// [`String::drain`](crate::string::String::drain), take any
/// `R: RangeBounds<usize>`. Unlike Rust, it has no `contains` method.
///
/// # Examples
///
/// A function taking any range of indexes, turning it into `start..end`:
///
/// ```
/// use std::ops::{Bound, Range, RangeBounds};
///
/// fn to_range<R: RangeBounds<usize>>(r: R, len: usize) -> Range<usize> {
///     let start = match r.start_bound() {
///         Bound::Included(s) => *s,
///         Bound::Excluded(s) => *s + 1,
///         Bound::Unbounded => 0,
///     };
///     let end = match r.end_bound() {
///         Bound::Included(e) => *e + 1,
///         Bound::Excluded(e) => *e,
///         Bound::Unbounded => len,
///     };
///     start..end
/// }
///
/// assert_eq(to_range(2..5, 10), 2..5);
/// assert_eq(to_range(2..=5, 10), 2..6);
/// assert_eq(to_range(..3, 10), 0..3);
/// assert_eq(to_range(4.., 10), 4..10);
/// assert_eq(to_range(.., 10), 0..10);
/// ```
pub trait RangeBounds<T> {
    /// Returns the start bound of the range.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::{Bound, RangeBounds};
    ///
    /// assert_eq((3..10).start_bound(), Bound::Included(&3));
    /// assert_eq((..10).start_bound(), Bound::Unbounded);
    /// ```
    fn start_bound(&self) -> Bound<&T>;
    /// Returns the end bound of the range.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::ops::{Bound, RangeBounds};
    ///
    /// assert_eq((3..10).end_bound(), Bound::Excluded(&10));
    /// assert_eq((3..=10).end_bound(), Bound::Included(&10));
    /// assert_eq((3..).end_bound(), Bound::Unbounded);
    /// ```
    fn end_bound(&self) -> Bound<&T>;
}

impl<T> RangeBounds<T> for Range<T> {
    fn start_bound(&self) -> Bound<&T> {
        Bound::Included(&self.start)
    }

    fn end_bound(&self) -> Bound<&T> {
        Bound::Excluded(&self.end)
    }
}

impl<T> RangeBounds<T> for RangeInclusive<T> {
    fn start_bound(&self) -> Bound<&T> {
        Bound::Included(&self.start)
    }

    fn end_bound(&self) -> Bound<&T> {
        Bound::Included(&self.end)
    }
}

impl<T> RangeBounds<T> for RangeFrom<T> {
    fn start_bound(&self) -> Bound<&T> {
        Bound::Included(&self.start)
    }

    fn end_bound(&self) -> Bound<&T> {
        Bound::Unbounded
    }
}

impl<T> RangeBounds<T> for RangeTo<T> {
    fn start_bound(&self) -> Bound<&T> {
        Bound::Unbounded
    }

    fn end_bound(&self) -> Bound<&T> {
        Bound::Excluded(&self.end)
    }
}

impl<T> RangeBounds<T> for RangeFull {
    fn start_bound(&self) -> Bound<&T> {
        Bound::Unbounded
    }

    fn end_bound(&self) -> Bound<&T> {
        Bound::Unbounded
    }
}

impl<T> RangeBounds<T> for RangeToInclusive<T> {
    fn start_bound(&self) -> Bound<&T> {
        Bound::Unbounded
    }

    fn end_bound(&self) -> Bound<&T> {
        Bound::Included(&self.end)
    }
}

impl<T> RangeBounds<T> for (Bound<T>, Bound<T>) {
    fn start_bound(&self) -> Bound<&T> {
        bound_ref(&self.0)
    }

    fn end_bound(&self) -> Bound<&T> {
        bound_ref(&self.1)
    }
}

fn bound_ref<T>(b: &Bound<T>) -> Bound<&T> {
    match b {
        Bound::Included(x) => Bound::Included(x),
        Bound::Excluded(x) => Bound::Excluded(x),
        Bound::Unbounded => Bound::Unbounded,
    }
}
