//! Overloadable operators, ranges and Deref.

pub trait Add<Rhs> { type Output; fn add(self, rhs: Rhs) -> Self::Output; }
pub trait Sub<Rhs> { type Output; fn sub(self, rhs: Rhs) -> Self::Output; }
pub trait Mul<Rhs> { type Output; fn mul(self, rhs: Rhs) -> Self::Output; }
pub trait Div<Rhs> { type Output; fn div(self, rhs: Rhs) -> Self::Output; }
pub trait Rem<Rhs> { type Output; fn rem(self, rhs: Rhs) -> Self::Output; }
pub trait Neg { type Output; fn neg(self) -> Self::Output; }
pub trait Not { type Output; fn not(self) -> Self::Output; }
pub trait BitAnd<Rhs> { type Output; fn bitand(self, rhs: Rhs) -> Self::Output; }
pub trait BitOr<Rhs> { type Output; fn bitor(self, rhs: Rhs) -> Self::Output; }
pub trait BitXor<Rhs> { type Output; fn bitxor(self, rhs: Rhs) -> Self::Output; }
pub trait Shl<Rhs> { type Output; fn shl(self, rhs: Rhs) -> Self::Output; }
pub trait Shr<Rhs> { type Output; fn shr(self, rhs: Rhs) -> Self::Output; }

pub trait AddAssign<Rhs> { fn add_assign(&mut self, rhs: Rhs); }
pub trait SubAssign<Rhs> { fn sub_assign(&mut self, rhs: Rhs); }
pub trait MulAssign<Rhs> { fn mul_assign(&mut self, rhs: Rhs); }
pub trait DivAssign<Rhs> { fn div_assign(&mut self, rhs: Rhs); }
pub trait RemAssign<Rhs> { fn rem_assign(&mut self, rhs: Rhs); }
pub trait BitAndAssign<Rhs> { fn bitand_assign(&mut self, rhs: Rhs); }
pub trait BitOrAssign<Rhs> { fn bitor_assign(&mut self, rhs: Rhs); }
pub trait BitXorAssign<Rhs> { fn bitxor_assign(&mut self, rhs: Rhs); }
pub trait ShlAssign<Rhs> { fn shl_assign(&mut self, rhs: Rhs); }
pub trait ShrAssign<Rhs> { fn shr_assign(&mut self, rhs: Rhs); }

pub trait Index<Idx> { type Output; fn index(&self, index: Idx) -> &Self::Output; }
pub trait IndexMut<Idx>: Index<Idx> { fn index_mut(&mut self, index: Idx) -> &mut Self::Output; }

pub trait Deref { type Target; fn deref(&self) -> &Self::Target; }
pub trait DerefMut: Deref { fn deref_mut(&mut self) -> &mut Self::Target; }

#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub struct Range<Idx> { pub start: Idx, pub end: Idx }
#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub struct RangeInclusive<Idx> { pub start: Idx, pub end: Idx }
#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub struct RangeFrom<Idx> { pub start: Idx }
#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub struct RangeTo<Idx> { pub end: Idx }
#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub struct RangeToInclusive<Idx> { pub end: Idx }
#[derive(Clone, PartialEq, Eq, Hash, Debug)]
pub struct RangeFull;
