//! Constants associated with the current target.
//!
//! The values are fixed when the program is compiled, for the target it is
//! compiled for.
//!
//! # Examples
//!
//! ```
//! use std::env::consts;
//!
//! println(`${consts::OS} on ${consts::ARCH} (${consts::FAMILY})`);
//! let exe = `navi${consts::EXE_SUFFIX}`.to_string();
//! assert(exe.starts_with("navi"));
//! ```

/// A string describing the specific operating system in use.
///
/// Example value is `linux`. Some possible values: `linux`, `macos`, `windows`
/// (the systems navi supports).
///
/// # Examples
///
/// ```
/// use std::env::consts;
///
/// assert(consts::OS == "linux" || consts::OS == "macos" || consts::OS == "windows");
/// ```
#[cfg(target_os = "macos")]
pub const OS: &str = "macos";
/// A string describing the specific operating system in use.
///
/// Example value is `linux`. Some possible values: `linux`, `macos`, `windows`
/// (the systems navi supports).
///
/// # Examples
///
/// ```
/// use std::env::consts;
///
/// assert(consts::OS == "linux" || consts::OS == "macos" || consts::OS == "windows");
/// ```
#[cfg(target_os = "linux")]
pub const OS: &str = "linux";
/// A string describing the specific operating system in use.
///
/// Example value is `linux`. Some possible values: `linux`, `macos`, `windows`
/// (the systems navi supports).
///
/// # Examples
///
/// ```
/// use std::env::consts;
///
/// assert(consts::OS == "linux" || consts::OS == "macos" || consts::OS == "windows");
/// ```
#[cfg(target_os = "windows")]
pub const OS: &str = "windows";

/// A string describing the architecture of the CPU that is currently in use.
///
/// Possible values: `aarch64`, `x86_64` (the architectures navi supports).
///
/// # Examples
///
/// ```
/// use std::env::consts;
///
/// assert(consts::ARCH == "aarch64" || consts::ARCH == "x86_64");
/// ```
#[cfg(target_arch = "aarch64")]
pub const ARCH: &str = "aarch64";
/// A string describing the architecture of the CPU that is currently in use.
///
/// Possible values: `aarch64`, `x86_64` (the architectures navi supports).
///
/// # Examples
///
/// ```
/// use std::env::consts;
///
/// assert(consts::ARCH == "aarch64" || consts::ARCH == "x86_64");
/// ```
#[cfg(target_arch = "x86_64")]
pub const ARCH: &str = "x86_64";

/// The family of the operating system: `unix` or `windows`.
///
/// # Examples
///
/// ```
/// use std::env::consts;
///
/// assert(consts::FAMILY == "unix" || consts::FAMILY == "windows");
/// ```
#[cfg(not(target_os = "windows"))]
pub const FAMILY: &str = "unix";
/// The family of the operating system: `unix` or `windows`.
///
/// # Examples
///
/// ```
/// use std::env::consts;
///
/// assert(consts::FAMILY == "unix" || consts::FAMILY == "windows");
/// ```
#[cfg(target_os = "windows")]
pub const FAMILY: &str = "windows";

/// Specifies the filename suffix used for executable binaries on this platform.
///
/// Some possible values: `.exe` (Windows), the empty string (Unix).
#[cfg(not(target_os = "windows"))]
pub const EXE_SUFFIX: &str = "";
/// Specifies the file extension, if any, used for executable binaries on this
/// platform.
///
/// Some possible values: `exe` (Windows), the empty string (Unix).
#[cfg(not(target_os = "windows"))]
pub const EXE_EXTENSION: &str = "";
/// Specifies the filename suffix used for executable binaries on this platform.
///
/// Some possible values: `.exe` (Windows), the empty string (Unix).
#[cfg(target_os = "windows")]
pub const EXE_SUFFIX: &str = ".exe";
/// Specifies the file extension, if any, used for executable binaries on this
/// platform.
///
/// Some possible values: `exe` (Windows), the empty string (Unix).
#[cfg(target_os = "windows")]
pub const EXE_EXTENSION: &str = "exe";

/// Specifies the filename prefix used for shared libraries on this platform.
///
/// Some possible values: `lib` (Unix), the empty string (Windows).
#[cfg(not(target_os = "windows"))]
pub const DLL_PREFIX: &str = "lib";
/// Specifies the filename prefix used for shared libraries on this platform.
///
/// Some possible values: `lib` (Unix), the empty string (Windows).
#[cfg(target_os = "windows")]
pub const DLL_PREFIX: &str = "";

/// Specifies the filename suffix used for shared libraries on this platform.
///
/// Some possible values: `.so` (Linux), `.dylib` (macOS), `.dll` (Windows).
#[cfg(target_os = "macos")]
pub const DLL_SUFFIX: &str = ".dylib";
/// Specifies the file extension used for shared libraries on this platform that
/// goes after the dot.
///
/// Some possible values: `so` (Linux), `dylib` (macOS), `dll` (Windows).
#[cfg(target_os = "macos")]
pub const DLL_EXTENSION: &str = "dylib";
/// Specifies the filename suffix used for shared libraries on this platform.
///
/// Some possible values: `.so` (Linux), `.dylib` (macOS), `.dll` (Windows).
#[cfg(target_os = "linux")]
pub const DLL_SUFFIX: &str = ".so";
/// Specifies the file extension used for shared libraries on this platform that
/// goes after the dot.
///
/// Some possible values: `so` (Linux), `dylib` (macOS), `dll` (Windows).
#[cfg(target_os = "linux")]
pub const DLL_EXTENSION: &str = "so";
/// Specifies the filename suffix used for shared libraries on this platform.
///
/// Some possible values: `.so` (Linux), `.dylib` (macOS), `.dll` (Windows).
#[cfg(target_os = "windows")]
pub const DLL_SUFFIX: &str = ".dll";
/// Specifies the file extension used for shared libraries on this platform that
/// goes after the dot.
///
/// Some possible values: `so` (Linux), `dylib` (macOS), `dll` (Windows).
#[cfg(target_os = "windows")]
pub const DLL_EXTENSION: &str = "dll";
