//! Inherent methods and constants of the integer and float types.
//! (Rust writes these with macros; this was generated once, by a Go tool
//! since removed.)

pub use crate::str::{ParseFloatError, ParseIntError};
use crate::{
    option::Option::{self, None, Some},
    result::Result::{self, Err, Ok},
};

mod ext;
pub use self::ext::{FpCategory, TryFromIntError};

impl i8 {
    /// The smallest value that can be represented by this integer type (−2⁷).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i8::MIN, -128);
    /// ```
    pub const MIN: i8 = -127 - 1;

    /// The largest value that can be represented by this integer type (2⁷ − 1).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i8::MAX, 127);
    /// ```
    pub const MAX: i8 = 127;

    /// The size of this integer type in bits.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i8::BITS, 8);
    /// ```
    pub const BITS: u32 = 8;

    /// Wrapping (modular) addition. Computes `self + rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i8.wrapping_add(27), 127);
    /// assert_eq(i8::MAX.wrapping_add(2), i8::MIN + 1);
    /// ```
    #[inline]
    pub fn wrapping_add(self, rhs: i8) -> i8 {
        crate::intrinsics::wrapping_add(self, rhs)
    }

    /// Wrapping (modular) subtraction. Computes `self - rhs`, wrapping around
    /// at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0i8.wrapping_sub(127), -127);
    /// assert_eq((-2i8).wrapping_sub(i8::MAX), i8::MAX);
    /// ```
    #[inline]
    pub fn wrapping_sub(self, rhs: i8) -> i8 {
        crate::intrinsics::wrapping_sub(self, rhs)
    }

    /// Wrapping (modular) multiplication. Computes `self * rhs`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i8.wrapping_mul(12), 120);
    /// assert_eq(i8::MAX.wrapping_mul(2), -2);
    /// ```
    #[inline]
    pub fn wrapping_mul(self, rhs: i8) -> i8 {
        crate::intrinsics::wrapping_mul(self, rhs)
    }

    /// Wrapping (modular) negation. Computes `-self`, wrapping around at the
    /// boundary of the type.
    ///
    /// The only case where such wrapping can occur is when one negates `MIN` on
    /// a signed type (where `MIN` is the negative minimal value for the type);
    /// this is a positive value that is too large to represent in the type. In
    /// such a case, this function returns `MIN` itself.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i8.wrapping_neg(), -100);
    /// assert_eq((-100i8).wrapping_neg(), 100);
    /// assert_eq(i8::MIN.wrapping_neg(), i8::MIN);
    /// ```
    #[inline]
    pub fn wrapping_neg(self) -> i8 {
        crate::intrinsics::wrapping_sub(0, self)
    }

    /// Calculates `self + rhs`.
    ///
    /// Returns a tuple of the addition along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would have occurred
    /// then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i8.overflowing_add(2), (7, false));
    /// assert_eq(i8::MAX.overflowing_add(1), (i8::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_add(self, rhs: i8) -> (i8, bool) {
        let r = self.wrapping_add(rhs);
        (r, (rhs > 0 && r < self) || (rhs < 0 && r > self))
    }

    /// Calculates `self - rhs`.
    ///
    /// Returns a tuple of the subtraction along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i8.overflowing_sub(2), (3, false));
    /// assert_eq(i8::MIN.overflowing_sub(1), (i8::MAX, true));
    /// ```
    #[inline]
    pub fn overflowing_sub(self, rhs: i8) -> (i8, bool) {
        let r = self.wrapping_sub(rhs);
        (r, (rhs > 0 && r > self) || (rhs < 0 && r < self))
    }

    /// Calculates the multiplication of `self` and `rhs`.
    ///
    /// Returns a tuple of the multiplication along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i8.overflowing_mul(2), (10, false));
    /// assert_eq(i8::MAX.overflowing_mul(2), (-2, true));
    /// ```
    #[inline]
    pub fn overflowing_mul(self, rhs: i8) -> (i8, bool) {
        let r = self.wrapping_mul(rhs);
        (
            r,
            self != 0 && (r.wrapping_div_exact(self) != rhs || self == -1 && rhs == i8::MIN),
        )
    }

    fn wrapping_div_exact(self, rhs: i8) -> i8 {
        if self == i8::MIN && rhs == -1 {
            self
        } else {
            self / rhs
        }
    }

    /// Checked integer addition. Computes `self + rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i8::MAX - 2).checked_add(1), Some(i8::MAX - 1));
    /// assert_eq((i8::MAX - 2).checked_add(3), None);
    /// ```
    #[inline]
    pub fn checked_add(self, rhs: i8) -> Option<i8> {
        let (r, o) = self.overflowing_add(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer subtraction. Computes `self - rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i8::MIN + 2).checked_sub(1), Some(i8::MIN + 1));
    /// assert_eq((i8::MIN + 2).checked_sub(3), None);
    /// ```
    #[inline]
    pub fn checked_sub(self, rhs: i8) -> Option<i8> {
        let (r, o) = self.overflowing_sub(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer multiplication. Computes `self * rhs`, returning `None`
    /// if overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i8::MAX.checked_mul(1), Some(i8::MAX));
    /// assert_eq(i8::MAX.checked_mul(2), None);
    /// ```
    #[inline]
    pub fn checked_mul(self, rhs: i8) -> Option<i8> {
        let (r, o) = self.overflowing_mul(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer division. Computes `self / rhs`, returning `None` if
    /// `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i8::MIN + 1).checked_div(-1), Some(i8::MAX));
    /// assert_eq(i8::MIN.checked_div(-1), None);
    /// assert_eq(1i8.checked_div(0), None);
    /// ```
    #[inline]
    pub fn checked_div(self, rhs: i8) -> Option<i8> {
        if rhs == 0 || self == i8::MIN && rhs == -1 {
            None
        } else {
            Some(self / rhs)
        }
    }

    /// Checked integer remainder. Computes `self % rhs`, returning `None` if
    /// `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i8.checked_rem(2), Some(1));
    /// assert_eq(5i8.checked_rem(0), None);
    /// assert_eq(i8::MIN.checked_rem(-1), None);
    /// ```
    #[inline]
    pub fn checked_rem(self, rhs: i8) -> Option<i8> {
        if rhs == 0 || self == i8::MIN && rhs == -1 {
            None
        } else {
            Some(self % rhs)
        }
    }

    /// Saturating integer addition. Computes `self + rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i8.saturating_add(1), 101);
    /// assert_eq(i8::MAX.saturating_add(100), i8::MAX);
    /// assert_eq(i8::MIN.saturating_add(-1), i8::MIN);
    /// ```
    #[inline]
    pub fn saturating_add(self, rhs: i8) -> i8 {
        match self.checked_add(rhs) {
            Some(r) => r,
            None => {
                if rhs < 0 {
                    i8::MIN
                } else {
                    i8::MAX
                }
            }
        }
    }

    /// Saturating integer subtraction. Computes `self - rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i8.saturating_sub(127), -27);
    /// assert_eq(i8::MIN.saturating_sub(100), i8::MIN);
    /// assert_eq(i8::MAX.saturating_sub(-1), i8::MAX);
    /// ```
    #[inline]
    pub fn saturating_sub(self, rhs: i8) -> i8 {
        match self.checked_sub(rhs) {
            Some(r) => r,
            None => {
                if rhs > 0 {
                    i8::MIN
                } else {
                    i8::MAX
                }
            }
        }
    }

    /// Saturating integer multiplication. Computes `self * rhs`, saturating at
    /// the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i8.saturating_mul(12), 120);
    /// assert_eq(i8::MAX.saturating_mul(10), i8::MAX);
    /// assert_eq(i8::MIN.saturating_mul(10), i8::MIN);
    /// ```
    #[inline]
    pub fn saturating_mul(self, rhs: i8) -> i8 {
        match self.checked_mul(rhs) {
            Some(r) => r,
            None => {
                if (self < 0) != (rhs < 0) {
                    i8::MIN
                } else {
                    i8::MAX
                }
            }
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// # Panics
    ///
    /// This function will panic if the result overflows (navi checks integer
    /// overflow in every build; Rust only in debug builds). Use `checked_pow`,
    /// `wrapping_pow`, `saturating_pow` or `overflowing_pow` when it may.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2i8;
    ///
    /// assert_eq(x.pow(5), 32);
    /// assert_eq(x.pow(0), 1);
    /// ```
    pub fn pow(self, exp: u32) -> i8 {
        if exp == 0 {
            return 1;
        }
        let mut base = self;
        let mut acc: i8 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc * base;
                if e == 1 {
                    return acc;
                }
            }
            e = e / 2;
            base = base * base;
        }
    }

    /// Wrapping (modular) exponentiation. Computes `self.pow(exp)`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3i8.wrapping_pow(4), 81);
    /// assert_eq(i8::MAX.wrapping_pow(2), 1);
    /// ```
    pub fn wrapping_pow(self, exp: u32) -> i8 {
        let mut base = self;
        let mut acc: i8 = 1;
        let mut e = exp;
        while e > 0 {
            if e & 1 == 1 {
                acc = acc.wrapping_mul(base);
            }
            e = e / 2;
            base = base.wrapping_mul(base);
        }
        acc
    }

    /// Returns the number of ones in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b01001100i8;
    /// assert_eq(n.count_ones(), 3);
    ///
    /// assert_eq(i8::MAX.count_ones(), 7);
    /// assert_eq((-1i8).count_ones(), 8);
    /// ```
    #[inline]
    pub fn count_ones(self) -> u32 {
        let mut v = self as u8;
        let mut n = 0u32;
        while v != 0 {
            n += (v & 1) as u32;
            v = v >> 1;
        }
        n
    }

    /// Returns the number of zeros in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i8::MAX.count_zeros(), 1);
    /// assert_eq((-1i8).count_zeros(), 0);
    /// ```
    #[inline]
    pub fn count_zeros(self) -> u32 {
        8 - self.count_ones()
    }

    /// Returns the number of leading zeros in the binary representation of
    /// `self`.
    ///
    /// Depending on what you're doing with the value, you might also be
    /// interested in the `ilog2` function which returns a consistent number,
    /// even if the type widens.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-1i8).leading_zeros(), 0);
    /// assert_eq(1i8.leading_zeros(), 7);
    /// assert_eq(0i8.leading_zeros(), 8);
    /// ```
    #[inline]
    pub fn leading_zeros(self) -> u32 {
        let v = self as u8;
        let mut n = 0u32;
        while n < 8 && (v >> (8 - 1 - n)) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Returns the number of trailing zeros in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-4i8).trailing_zeros(), 2);
    /// assert_eq(0i8.trailing_zeros(), 8);
    /// ```
    #[inline]
    pub fn trailing_zeros(self) -> u32 {
        let v = self as u8;
        let mut n = 0u32;
        while n < 8 && (v >> n) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Shifts the bits to the left by a specified amount, `n`, wrapping the
    /// truncated bits to the end of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `<<` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = -0x7ei8;
    /// let m = 0xa;
    ///
    /// assert_eq(n.rotate_left(2), m);
    /// ```
    #[inline]
    pub fn rotate_left(self, n: u32) -> i8 {
        let v = self as u8;
        let k = n % 8;
        if k == 0 {
            return self;
        }
        ((v << k) | (v >> (8 - k))) as i8
    }

    /// Shifts the bits to the right by a specified amount, `n`, wrapping the
    /// truncated bits to the beginning of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `>>` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0xai8;
    /// let m = -0x7e;
    ///
    /// assert_eq(n.rotate_right(2), m);
    /// ```
    #[inline]
    pub fn rotate_right(self, n: u32) -> i8 {
        let k = n % 8;
        if k == 0 {
            return self;
        }
        self.rotate_left(8 - k)
    }

    /// Returns `true` if and only if `self == 2^k` for some `k`.
    ///
    /// Zero and the negative numbers are not powers of two. (Rust has this
    /// method on the unsigned types only.)
    ///
    /// # Examples
    ///
    /// ```
    /// assert(16i8.is_power_of_two());
    /// assert(!10i8.is_power_of_two());
    /// assert(!0i8.is_power_of_two());
    /// assert(!i8::MIN.is_power_of_two());
    /// ```
    #[inline]
    pub fn is_power_of_two(self) -> bool {
        self > 0 && self.count_ones() == 1
    }

    /// Parses an integer from a string slice with digits in the given base.
    ///
    /// The string is expected to be an optional `+` or `-` sign followed by
    /// only digits. Leading and trailing non-digit characters (including
    /// whitespace) represent an error. Underscores (which can appear in
    /// literals) also represent an error.
    ///
    /// Digits are a subset of these characters, depending on `radix`: `0-9`,
    /// `a-z`, `A-Z`.
    ///
    /// # Panics
    ///
    /// This function panics if `radix` is not in the range from 2 to 36.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i8::from_str_radix("A", 16), Ok(10));
    /// assert_eq(i8::from_str_radix("-1111", 2), Ok(-15));
    /// assert(i8::from_str_radix("12 ", 10).is_err());
    /// assert(i8::from_str_radix("128", 10).is_err());
    /// ```
    pub fn from_str_radix(src: &str, radix: u32) -> Result<i8, ParseIntError> {
        match crate::str::parse_radix(src, radix, true) {
            Some((neg, mag)) => {
                let max = i8::MAX as u64;
                if neg {
                    if mag > max + 1 {
                        return Err(ParseIntError);
                    }
                    Ok((0u64.wrapping_sub(mag)) as i8)
                } else {
                    if mag > max {
                        return Err(ParseIntError);
                    }
                    Ok(mag as i8)
                }
            }
            None => Err(ParseIntError),
        }
    }

    /// Returns the memory representation of this integer as a byte array in
    /// little-endian byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x12i8.to_le_bytes();
    /// assert_eq(bytes, [0x12]);
    /// ```
    #[inline]
    pub fn to_le_bytes(self) -> [u8; 1] {
        let mut out = [0u8; 1];
        let v = self as u8;
        let mut i = 0;
        while i < 1 {
            out[i] = ((v >> (8 * i as u32)) & 255) as u8;
            i += 1;
        }
        out
    }

    /// Creates an integer value from its representation as a byte array in
    /// little endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = i8::from_le_bytes([0x12]);
    /// assert_eq(value, 0x12);
    /// ```
    #[inline]
    pub fn from_le_bytes(bytes: [u8; 1]) -> i8 {
        bytes[0] as i8
    }

    /// Computes the absolute value of `self`.
    ///
    /// The absolute value of `i8::MIN` cannot be represented as an `i8`, and
    /// attempting to calculate it will cause an overflow.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is `i8::MIN` (navi checks integer
    /// overflow in every build; Rust only in debug builds). `wrapping_abs`,
    /// `checked_abs`, `saturating_abs`, `overflowing_abs` and `unsigned_abs`
    /// handle it.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i8.abs(), 10);
    /// assert_eq((-10i8).abs(), 10);
    /// ```
    #[inline]
    pub fn abs(self) -> i8 {
        if self < 0 { -self } else { self }
    }

    /// Wrapping (modular) absolute value. Computes `self.abs()`, wrapping
    /// around at the boundary of the type.
    ///
    /// The only case where such wrapping can occur is when one takes the
    /// absolute value of the negative minimal value for the type; this is a
    /// positive value that is too large to represent in the type. In such a
    /// case, this function returns `MIN` itself.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i8.wrapping_abs(), 100);
    /// assert_eq((-100i8).wrapping_abs(), 100);
    /// assert_eq(i8::MIN.wrapping_abs(), i8::MIN);
    /// assert_eq(i8::MIN.wrapping_abs() as u8, i8::MAX as u8 + 1);
    /// ```
    #[inline]
    pub fn wrapping_abs(self) -> i8 {
        if self < 0 { self.wrapping_neg() } else { self }
    }

    /// Computes the absolute value of `self` without any wrapping or panicking.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i8.unsigned_abs(), 100u8);
    /// assert_eq((-100i8).unsigned_abs(), 100u8);
    /// assert_eq(i8::MIN.unsigned_abs(), i8::MAX as u8 + 1);
    /// ```
    #[inline]
    pub fn unsigned_abs(self) -> u8 {
        if self < 0 {
            (self as u8).wrapping_neg()
        } else {
            self as u8
        }
    }

    /// Returns a number representing sign of `self`.
    ///
    /// - `0` if the number is zero
    /// - `1` if the number is positive
    /// - `-1` if the number is negative
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i8.signum(), 1);
    /// assert_eq(0i8.signum(), 0);
    /// assert_eq((-10i8).signum(), -1);
    /// ```
    #[inline]
    pub fn signum(self) -> i8 {
        if self < 0 {
            -1
        } else if self > 0 {
            1
        } else {
            0
        }
    }

    /// Returns `true` if `self` is negative and `false` if the number is zero
    /// or positive.
    ///
    /// # Examples
    ///
    /// ```
    /// assert((-10i8).is_negative());
    /// assert(!10i8.is_negative());
    /// ```
    #[inline]
    pub fn is_negative(self) -> bool {
        self < 0
    }

    /// Returns `true` if `self` is positive and `false` if the number is zero
    /// or negative.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(10i8.is_positive());
    /// assert(!(-10i8).is_positive());
    /// ```
    #[inline]
    pub fn is_positive(self) -> bool {
        self > 0
    }
}

impl i16 {
    /// The smallest value that can be represented by this integer type (−2¹⁵).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i16::MIN, -32768);
    /// ```
    pub const MIN: i16 = -32767 - 1;

    /// The largest value that can be represented by this integer type (2¹⁵ −
    /// 1).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i16::MAX, 32767);
    /// ```
    pub const MAX: i16 = 32767;

    /// The size of this integer type in bits.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i16::BITS, 16);
    /// ```
    pub const BITS: u32 = 16;

    /// Wrapping (modular) addition. Computes `self + rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i16.wrapping_add(27), 127);
    /// assert_eq(i16::MAX.wrapping_add(2), i16::MIN + 1);
    /// ```
    #[inline]
    pub fn wrapping_add(self, rhs: i16) -> i16 {
        crate::intrinsics::wrapping_add(self, rhs)
    }

    /// Wrapping (modular) subtraction. Computes `self - rhs`, wrapping around
    /// at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0i16.wrapping_sub(127), -127);
    /// assert_eq((-2i16).wrapping_sub(i16::MAX), i16::MAX);
    /// ```
    #[inline]
    pub fn wrapping_sub(self, rhs: i16) -> i16 {
        crate::intrinsics::wrapping_sub(self, rhs)
    }

    /// Wrapping (modular) multiplication. Computes `self * rhs`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i16.wrapping_mul(12), 120);
    /// assert_eq(i16::MAX.wrapping_mul(2), -2);
    /// ```
    #[inline]
    pub fn wrapping_mul(self, rhs: i16) -> i16 {
        crate::intrinsics::wrapping_mul(self, rhs)
    }

    /// Wrapping (modular) negation. Computes `-self`, wrapping around at the
    /// boundary of the type.
    ///
    /// The only case where such wrapping can occur is when one negates `MIN` on
    /// a signed type (where `MIN` is the negative minimal value for the type);
    /// this is a positive value that is too large to represent in the type. In
    /// such a case, this function returns `MIN` itself.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i16.wrapping_neg(), -100);
    /// assert_eq((-100i16).wrapping_neg(), 100);
    /// assert_eq(i16::MIN.wrapping_neg(), i16::MIN);
    /// ```
    #[inline]
    pub fn wrapping_neg(self) -> i16 {
        crate::intrinsics::wrapping_sub(0, self)
    }

    /// Calculates `self + rhs`.
    ///
    /// Returns a tuple of the addition along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would have occurred
    /// then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i16.overflowing_add(2), (7, false));
    /// assert_eq(i16::MAX.overflowing_add(1), (i16::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_add(self, rhs: i16) -> (i16, bool) {
        let r = self.wrapping_add(rhs);
        (r, (rhs > 0 && r < self) || (rhs < 0 && r > self))
    }

    /// Calculates `self - rhs`.
    ///
    /// Returns a tuple of the subtraction along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i16.overflowing_sub(2), (3, false));
    /// assert_eq(i16::MIN.overflowing_sub(1), (i16::MAX, true));
    /// ```
    #[inline]
    pub fn overflowing_sub(self, rhs: i16) -> (i16, bool) {
        let r = self.wrapping_sub(rhs);
        (r, (rhs > 0 && r > self) || (rhs < 0 && r < self))
    }

    /// Calculates the multiplication of `self` and `rhs`.
    ///
    /// Returns a tuple of the multiplication along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i16.overflowing_mul(2), (10, false));
    /// assert_eq(i16::MAX.overflowing_mul(2), (-2, true));
    /// ```
    #[inline]
    pub fn overflowing_mul(self, rhs: i16) -> (i16, bool) {
        let r = self.wrapping_mul(rhs);
        (
            r,
            self != 0 && (r.wrapping_div_exact(self) != rhs || self == -1 && rhs == i16::MIN),
        )
    }

    fn wrapping_div_exact(self, rhs: i16) -> i16 {
        if self == i16::MIN && rhs == -1 {
            self
        } else {
            self / rhs
        }
    }

    /// Checked integer addition. Computes `self + rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i16::MAX - 2).checked_add(1), Some(i16::MAX - 1));
    /// assert_eq((i16::MAX - 2).checked_add(3), None);
    /// ```
    #[inline]
    pub fn checked_add(self, rhs: i16) -> Option<i16> {
        let (r, o) = self.overflowing_add(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer subtraction. Computes `self - rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i16::MIN + 2).checked_sub(1), Some(i16::MIN + 1));
    /// assert_eq((i16::MIN + 2).checked_sub(3), None);
    /// ```
    #[inline]
    pub fn checked_sub(self, rhs: i16) -> Option<i16> {
        let (r, o) = self.overflowing_sub(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer multiplication. Computes `self * rhs`, returning `None`
    /// if overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i16::MAX.checked_mul(1), Some(i16::MAX));
    /// assert_eq(i16::MAX.checked_mul(2), None);
    /// ```
    #[inline]
    pub fn checked_mul(self, rhs: i16) -> Option<i16> {
        let (r, o) = self.overflowing_mul(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer division. Computes `self / rhs`, returning `None` if
    /// `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i16::MIN + 1).checked_div(-1), Some(i16::MAX));
    /// assert_eq(i16::MIN.checked_div(-1), None);
    /// assert_eq(1i16.checked_div(0), None);
    /// ```
    #[inline]
    pub fn checked_div(self, rhs: i16) -> Option<i16> {
        if rhs == 0 || self == i16::MIN && rhs == -1 {
            None
        } else {
            Some(self / rhs)
        }
    }

    /// Checked integer remainder. Computes `self % rhs`, returning `None` if
    /// `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i16.checked_rem(2), Some(1));
    /// assert_eq(5i16.checked_rem(0), None);
    /// assert_eq(i16::MIN.checked_rem(-1), None);
    /// ```
    #[inline]
    pub fn checked_rem(self, rhs: i16) -> Option<i16> {
        if rhs == 0 || self == i16::MIN && rhs == -1 {
            None
        } else {
            Some(self % rhs)
        }
    }

    /// Saturating integer addition. Computes `self + rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i16.saturating_add(1), 101);
    /// assert_eq(i16::MAX.saturating_add(100), i16::MAX);
    /// assert_eq(i16::MIN.saturating_add(-1), i16::MIN);
    /// ```
    #[inline]
    pub fn saturating_add(self, rhs: i16) -> i16 {
        match self.checked_add(rhs) {
            Some(r) => r,
            None => {
                if rhs < 0 {
                    i16::MIN
                } else {
                    i16::MAX
                }
            }
        }
    }

    /// Saturating integer subtraction. Computes `self - rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i16.saturating_sub(127), -27);
    /// assert_eq(i16::MIN.saturating_sub(100), i16::MIN);
    /// assert_eq(i16::MAX.saturating_sub(-1), i16::MAX);
    /// ```
    #[inline]
    pub fn saturating_sub(self, rhs: i16) -> i16 {
        match self.checked_sub(rhs) {
            Some(r) => r,
            None => {
                if rhs > 0 {
                    i16::MIN
                } else {
                    i16::MAX
                }
            }
        }
    }

    /// Saturating integer multiplication. Computes `self * rhs`, saturating at
    /// the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i16.saturating_mul(12), 120);
    /// assert_eq(i16::MAX.saturating_mul(10), i16::MAX);
    /// assert_eq(i16::MIN.saturating_mul(10), i16::MIN);
    /// ```
    #[inline]
    pub fn saturating_mul(self, rhs: i16) -> i16 {
        match self.checked_mul(rhs) {
            Some(r) => r,
            None => {
                if (self < 0) != (rhs < 0) {
                    i16::MIN
                } else {
                    i16::MAX
                }
            }
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// # Panics
    ///
    /// This function will panic if the result overflows (navi checks integer
    /// overflow in every build; Rust only in debug builds). Use `checked_pow`,
    /// `wrapping_pow`, `saturating_pow` or `overflowing_pow` when it may.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2i16;
    ///
    /// assert_eq(x.pow(5), 32);
    /// assert_eq(x.pow(0), 1);
    /// ```
    pub fn pow(self, exp: u32) -> i16 {
        if exp == 0 {
            return 1;
        }
        let mut base = self;
        let mut acc: i16 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc * base;
                if e == 1 {
                    return acc;
                }
            }
            e = e / 2;
            base = base * base;
        }
    }

    /// Wrapping (modular) exponentiation. Computes `self.pow(exp)`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3i16.wrapping_pow(4), 81);
    /// assert_eq(i16::MAX.wrapping_pow(2), 1);
    /// ```
    pub fn wrapping_pow(self, exp: u32) -> i16 {
        let mut base = self;
        let mut acc: i16 = 1;
        let mut e = exp;
        while e > 0 {
            if e & 1 == 1 {
                acc = acc.wrapping_mul(base);
            }
            e = e / 2;
            base = base.wrapping_mul(base);
        }
        acc
    }

    /// Returns the number of ones in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b01001100i16;
    /// assert_eq(n.count_ones(), 3);
    ///
    /// assert_eq(i16::MAX.count_ones(), 15);
    /// assert_eq((-1i16).count_ones(), 16);
    /// ```
    #[inline]
    pub fn count_ones(self) -> u32 {
        let mut v = self as u16;
        let mut n = 0u32;
        while v != 0 {
            n += (v & 1) as u32;
            v = v >> 1;
        }
        n
    }

    /// Returns the number of zeros in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i16::MAX.count_zeros(), 1);
    /// assert_eq((-1i16).count_zeros(), 0);
    /// ```
    #[inline]
    pub fn count_zeros(self) -> u32 {
        16 - self.count_ones()
    }

    /// Returns the number of leading zeros in the binary representation of
    /// `self`.
    ///
    /// Depending on what you're doing with the value, you might also be
    /// interested in the `ilog2` function which returns a consistent number,
    /// even if the type widens.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-1i16).leading_zeros(), 0);
    /// assert_eq(1i16.leading_zeros(), 15);
    /// assert_eq(0i16.leading_zeros(), 16);
    /// ```
    #[inline]
    pub fn leading_zeros(self) -> u32 {
        let v = self as u16;
        let mut n = 0u32;
        while n < 16 && (v >> (16 - 1 - n)) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Returns the number of trailing zeros in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-4i16).trailing_zeros(), 2);
    /// assert_eq(0i16.trailing_zeros(), 16);
    /// ```
    #[inline]
    pub fn trailing_zeros(self) -> u32 {
        let v = self as u16;
        let mut n = 0u32;
        while n < 16 && (v >> n) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Shifts the bits to the left by a specified amount, `n`, wrapping the
    /// truncated bits to the end of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `<<` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = -0x5ffdi16;
    /// let m = 0x3a;
    ///
    /// assert_eq(n.rotate_left(4), m);
    /// ```
    #[inline]
    pub fn rotate_left(self, n: u32) -> i16 {
        let v = self as u16;
        let k = n % 16;
        if k == 0 {
            return self;
        }
        ((v << k) | (v >> (16 - k))) as i16
    }

    /// Shifts the bits to the right by a specified amount, `n`, wrapping the
    /// truncated bits to the beginning of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `>>` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x3ai16;
    /// let m = -0x5ffd;
    ///
    /// assert_eq(n.rotate_right(4), m);
    /// ```
    #[inline]
    pub fn rotate_right(self, n: u32) -> i16 {
        let k = n % 16;
        if k == 0 {
            return self;
        }
        self.rotate_left(16 - k)
    }

    /// Returns `true` if and only if `self == 2^k` for some `k`.
    ///
    /// Zero and the negative numbers are not powers of two. (Rust has this
    /// method on the unsigned types only.)
    ///
    /// # Examples
    ///
    /// ```
    /// assert(16i16.is_power_of_two());
    /// assert(!10i16.is_power_of_two());
    /// assert(!0i16.is_power_of_two());
    /// assert(!i16::MIN.is_power_of_two());
    /// ```
    #[inline]
    pub fn is_power_of_two(self) -> bool {
        self > 0 && self.count_ones() == 1
    }

    /// Parses an integer from a string slice with digits in the given base.
    ///
    /// The string is expected to be an optional `+` or `-` sign followed by
    /// only digits. Leading and trailing non-digit characters (including
    /// whitespace) represent an error. Underscores (which can appear in
    /// literals) also represent an error.
    ///
    /// Digits are a subset of these characters, depending on `radix`: `0-9`,
    /// `a-z`, `A-Z`.
    ///
    /// # Panics
    ///
    /// This function panics if `radix` is not in the range from 2 to 36.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i16::from_str_radix("A", 16), Ok(10));
    /// assert_eq(i16::from_str_radix("-1111", 2), Ok(-15));
    /// assert(i16::from_str_radix("12 ", 10).is_err());
    /// assert(i16::from_str_radix("32768", 10).is_err());
    /// ```
    pub fn from_str_radix(src: &str, radix: u32) -> Result<i16, ParseIntError> {
        match crate::str::parse_radix(src, radix, true) {
            Some((neg, mag)) => {
                let max = i16::MAX as u64;
                if neg {
                    if mag > max + 1 {
                        return Err(ParseIntError);
                    }
                    Ok((0u64.wrapping_sub(mag)) as i16)
                } else {
                    if mag > max {
                        return Err(ParseIntError);
                    }
                    Ok(mag as i16)
                }
            }
            None => Err(ParseIntError),
        }
    }

    /// Returns the memory representation of this integer as a byte array in
    /// little-endian byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x1234i16.to_le_bytes();
    /// assert_eq(bytes, [0x34, 0x12]);
    /// ```
    #[inline]
    pub fn to_le_bytes(self) -> [u8; 2] {
        let mut out = [0u8; 2];
        let v = self as u16;
        let mut i = 0;
        while i < 2 {
            out[i] = ((v >> (8 * i as u32)) & 255) as u8;
            i += 1;
        }
        out
    }

    /// Creates an integer value from its representation as a byte array in
    /// little endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = i16::from_le_bytes([0x34, 0x12]);
    /// assert_eq(value, 0x1234);
    /// ```
    #[inline]
    pub fn from_le_bytes(bytes: [u8; 2]) -> i16 {
        let mut v: u16 = 0;
        let mut i = 2;
        while i > 0 {
            i -= 1;
            v = (v << 8) | bytes[i] as u16;
        }
        v as i16
    }

    /// Computes the absolute value of `self`.
    ///
    /// The absolute value of `i16::MIN` cannot be represented as an `i16`, and
    /// attempting to calculate it will cause an overflow.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is `i16::MIN` (navi checks integer
    /// overflow in every build; Rust only in debug builds). `wrapping_abs`,
    /// `checked_abs`, `saturating_abs`, `overflowing_abs` and `unsigned_abs`
    /// handle it.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i16.abs(), 10);
    /// assert_eq((-10i16).abs(), 10);
    /// ```
    #[inline]
    pub fn abs(self) -> i16 {
        if self < 0 { -self } else { self }
    }

    /// Wrapping (modular) absolute value. Computes `self.abs()`, wrapping
    /// around at the boundary of the type.
    ///
    /// The only case where such wrapping can occur is when one takes the
    /// absolute value of the negative minimal value for the type; this is a
    /// positive value that is too large to represent in the type. In such a
    /// case, this function returns `MIN` itself.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i16.wrapping_abs(), 100);
    /// assert_eq((-100i16).wrapping_abs(), 100);
    /// assert_eq(i16::MIN.wrapping_abs(), i16::MIN);
    /// assert_eq(i16::MIN.wrapping_abs() as u16, i16::MAX as u16 + 1);
    /// ```
    #[inline]
    pub fn wrapping_abs(self) -> i16 {
        if self < 0 { self.wrapping_neg() } else { self }
    }

    /// Computes the absolute value of `self` without any wrapping or panicking.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i16.unsigned_abs(), 100u16);
    /// assert_eq((-100i16).unsigned_abs(), 100u16);
    /// assert_eq(i16::MIN.unsigned_abs(), i16::MAX as u16 + 1);
    /// ```
    #[inline]
    pub fn unsigned_abs(self) -> u16 {
        if self < 0 {
            (self as u16).wrapping_neg()
        } else {
            self as u16
        }
    }

    /// Returns a number representing sign of `self`.
    ///
    /// - `0` if the number is zero
    /// - `1` if the number is positive
    /// - `-1` if the number is negative
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i16.signum(), 1);
    /// assert_eq(0i16.signum(), 0);
    /// assert_eq((-10i16).signum(), -1);
    /// ```
    #[inline]
    pub fn signum(self) -> i16 {
        if self < 0 {
            -1
        } else if self > 0 {
            1
        } else {
            0
        }
    }

    /// Returns `true` if `self` is negative and `false` if the number is zero
    /// or positive.
    ///
    /// # Examples
    ///
    /// ```
    /// assert((-10i16).is_negative());
    /// assert(!10i16.is_negative());
    /// ```
    #[inline]
    pub fn is_negative(self) -> bool {
        self < 0
    }

    /// Returns `true` if `self` is positive and `false` if the number is zero
    /// or negative.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(10i16.is_positive());
    /// assert(!(-10i16).is_positive());
    /// ```
    #[inline]
    pub fn is_positive(self) -> bool {
        self > 0
    }
}

impl i32 {
    /// The smallest value that can be represented by this integer type (−2³¹).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i32::MIN, -2147483648);
    /// ```
    pub const MIN: i32 = -2147483647 - 1;

    /// The largest value that can be represented by this integer type (2³¹ −
    /// 1).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i32::MAX, 2147483647);
    /// ```
    pub const MAX: i32 = 2147483647;

    /// The size of this integer type in bits.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i32::BITS, 32);
    /// ```
    pub const BITS: u32 = 32;

    /// Wrapping (modular) addition. Computes `self + rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i32.wrapping_add(27), 127);
    /// assert_eq(i32::MAX.wrapping_add(2), i32::MIN + 1);
    /// ```
    #[inline]
    pub fn wrapping_add(self, rhs: i32) -> i32 {
        crate::intrinsics::wrapping_add(self, rhs)
    }

    /// Wrapping (modular) subtraction. Computes `self - rhs`, wrapping around
    /// at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0i32.wrapping_sub(127), -127);
    /// assert_eq((-2i32).wrapping_sub(i32::MAX), i32::MAX);
    /// ```
    #[inline]
    pub fn wrapping_sub(self, rhs: i32) -> i32 {
        crate::intrinsics::wrapping_sub(self, rhs)
    }

    /// Wrapping (modular) multiplication. Computes `self * rhs`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i32.wrapping_mul(12), 120);
    /// assert_eq(i32::MAX.wrapping_mul(2), -2);
    /// ```
    #[inline]
    pub fn wrapping_mul(self, rhs: i32) -> i32 {
        crate::intrinsics::wrapping_mul(self, rhs)
    }

    /// Wrapping (modular) negation. Computes `-self`, wrapping around at the
    /// boundary of the type.
    ///
    /// The only case where such wrapping can occur is when one negates `MIN` on
    /// a signed type (where `MIN` is the negative minimal value for the type);
    /// this is a positive value that is too large to represent in the type. In
    /// such a case, this function returns `MIN` itself.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i32.wrapping_neg(), -100);
    /// assert_eq((-100i32).wrapping_neg(), 100);
    /// assert_eq(i32::MIN.wrapping_neg(), i32::MIN);
    /// ```
    #[inline]
    pub fn wrapping_neg(self) -> i32 {
        crate::intrinsics::wrapping_sub(0, self)
    }

    /// Calculates `self + rhs`.
    ///
    /// Returns a tuple of the addition along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would have occurred
    /// then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i32.overflowing_add(2), (7, false));
    /// assert_eq(i32::MAX.overflowing_add(1), (i32::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_add(self, rhs: i32) -> (i32, bool) {
        let r = self.wrapping_add(rhs);
        (r, (rhs > 0 && r < self) || (rhs < 0 && r > self))
    }

    /// Calculates `self - rhs`.
    ///
    /// Returns a tuple of the subtraction along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i32.overflowing_sub(2), (3, false));
    /// assert_eq(i32::MIN.overflowing_sub(1), (i32::MAX, true));
    /// ```
    #[inline]
    pub fn overflowing_sub(self, rhs: i32) -> (i32, bool) {
        let r = self.wrapping_sub(rhs);
        (r, (rhs > 0 && r > self) || (rhs < 0 && r < self))
    }

    /// Calculates the multiplication of `self` and `rhs`.
    ///
    /// Returns a tuple of the multiplication along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i32.overflowing_mul(2), (10, false));
    /// assert_eq(i32::MAX.overflowing_mul(2), (-2, true));
    /// ```
    #[inline]
    pub fn overflowing_mul(self, rhs: i32) -> (i32, bool) {
        let r = self.wrapping_mul(rhs);
        (
            r,
            self != 0 && (r.wrapping_div_exact(self) != rhs || self == -1 && rhs == i32::MIN),
        )
    }

    fn wrapping_div_exact(self, rhs: i32) -> i32 {
        if self == i32::MIN && rhs == -1 {
            self
        } else {
            self / rhs
        }
    }

    /// Checked integer addition. Computes `self + rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i32::MAX - 2).checked_add(1), Some(i32::MAX - 1));
    /// assert_eq((i32::MAX - 2).checked_add(3), None);
    /// ```
    #[inline]
    pub fn checked_add(self, rhs: i32) -> Option<i32> {
        let (r, o) = self.overflowing_add(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer subtraction. Computes `self - rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i32::MIN + 2).checked_sub(1), Some(i32::MIN + 1));
    /// assert_eq((i32::MIN + 2).checked_sub(3), None);
    /// ```
    #[inline]
    pub fn checked_sub(self, rhs: i32) -> Option<i32> {
        let (r, o) = self.overflowing_sub(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer multiplication. Computes `self * rhs`, returning `None`
    /// if overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i32::MAX.checked_mul(1), Some(i32::MAX));
    /// assert_eq(i32::MAX.checked_mul(2), None);
    /// ```
    #[inline]
    pub fn checked_mul(self, rhs: i32) -> Option<i32> {
        let (r, o) = self.overflowing_mul(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer division. Computes `self / rhs`, returning `None` if
    /// `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i32::MIN + 1).checked_div(-1), Some(i32::MAX));
    /// assert_eq(i32::MIN.checked_div(-1), None);
    /// assert_eq(1i32.checked_div(0), None);
    /// ```
    #[inline]
    pub fn checked_div(self, rhs: i32) -> Option<i32> {
        if rhs == 0 || self == i32::MIN && rhs == -1 {
            None
        } else {
            Some(self / rhs)
        }
    }

    /// Checked integer remainder. Computes `self % rhs`, returning `None` if
    /// `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i32.checked_rem(2), Some(1));
    /// assert_eq(5i32.checked_rem(0), None);
    /// assert_eq(i32::MIN.checked_rem(-1), None);
    /// ```
    #[inline]
    pub fn checked_rem(self, rhs: i32) -> Option<i32> {
        if rhs == 0 || self == i32::MIN && rhs == -1 {
            None
        } else {
            Some(self % rhs)
        }
    }

    /// Saturating integer addition. Computes `self + rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i32.saturating_add(1), 101);
    /// assert_eq(i32::MAX.saturating_add(100), i32::MAX);
    /// assert_eq(i32::MIN.saturating_add(-1), i32::MIN);
    /// ```
    #[inline]
    pub fn saturating_add(self, rhs: i32) -> i32 {
        match self.checked_add(rhs) {
            Some(r) => r,
            None => {
                if rhs < 0 {
                    i32::MIN
                } else {
                    i32::MAX
                }
            }
        }
    }

    /// Saturating integer subtraction. Computes `self - rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i32.saturating_sub(127), -27);
    /// assert_eq(i32::MIN.saturating_sub(100), i32::MIN);
    /// assert_eq(i32::MAX.saturating_sub(-1), i32::MAX);
    /// ```
    #[inline]
    pub fn saturating_sub(self, rhs: i32) -> i32 {
        match self.checked_sub(rhs) {
            Some(r) => r,
            None => {
                if rhs > 0 {
                    i32::MIN
                } else {
                    i32::MAX
                }
            }
        }
    }

    /// Saturating integer multiplication. Computes `self * rhs`, saturating at
    /// the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i32.saturating_mul(12), 120);
    /// assert_eq(i32::MAX.saturating_mul(10), i32::MAX);
    /// assert_eq(i32::MIN.saturating_mul(10), i32::MIN);
    /// ```
    #[inline]
    pub fn saturating_mul(self, rhs: i32) -> i32 {
        match self.checked_mul(rhs) {
            Some(r) => r,
            None => {
                if (self < 0) != (rhs < 0) {
                    i32::MIN
                } else {
                    i32::MAX
                }
            }
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// # Panics
    ///
    /// This function will panic if the result overflows (navi checks integer
    /// overflow in every build; Rust only in debug builds). Use `checked_pow`,
    /// `wrapping_pow`, `saturating_pow` or `overflowing_pow` when it may.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2i32;
    ///
    /// assert_eq(x.pow(5), 32);
    /// assert_eq(x.pow(0), 1);
    /// ```
    pub fn pow(self, exp: u32) -> i32 {
        if exp == 0 {
            return 1;
        }
        let mut base = self;
        let mut acc: i32 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc * base;
                if e == 1 {
                    return acc;
                }
            }
            e = e / 2;
            base = base * base;
        }
    }

    /// Wrapping (modular) exponentiation. Computes `self.pow(exp)`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3i32.wrapping_pow(4), 81);
    /// assert_eq(i32::MAX.wrapping_pow(2), 1);
    /// ```
    pub fn wrapping_pow(self, exp: u32) -> i32 {
        let mut base = self;
        let mut acc: i32 = 1;
        let mut e = exp;
        while e > 0 {
            if e & 1 == 1 {
                acc = acc.wrapping_mul(base);
            }
            e = e / 2;
            base = base.wrapping_mul(base);
        }
        acc
    }

    /// Returns the number of ones in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b01001100i32;
    /// assert_eq(n.count_ones(), 3);
    ///
    /// assert_eq(i32::MAX.count_ones(), 31);
    /// assert_eq((-1i32).count_ones(), 32);
    /// ```
    #[inline]
    pub fn count_ones(self) -> u32 {
        let mut v = self as u32;
        let mut n = 0u32;
        while v != 0 {
            n += (v & 1) as u32;
            v = v >> 1;
        }
        n
    }

    /// Returns the number of zeros in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i32::MAX.count_zeros(), 1);
    /// assert_eq((-1i32).count_zeros(), 0);
    /// ```
    #[inline]
    pub fn count_zeros(self) -> u32 {
        32 - self.count_ones()
    }

    /// Returns the number of leading zeros in the binary representation of
    /// `self`.
    ///
    /// Depending on what you're doing with the value, you might also be
    /// interested in the `ilog2` function which returns a consistent number,
    /// even if the type widens.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-1i32).leading_zeros(), 0);
    /// assert_eq(1i32.leading_zeros(), 31);
    /// assert_eq(0i32.leading_zeros(), 32);
    /// ```
    #[inline]
    pub fn leading_zeros(self) -> u32 {
        let v = self as u32;
        let mut n = 0u32;
        while n < 32 && (v >> (32 - 1 - n)) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Returns the number of trailing zeros in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-4i32).trailing_zeros(), 2);
    /// assert_eq(0i32.trailing_zeros(), 32);
    /// ```
    #[inline]
    pub fn trailing_zeros(self) -> u32 {
        let v = self as u32;
        let mut n = 0u32;
        while n < 32 && (v >> n) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Shifts the bits to the left by a specified amount, `n`, wrapping the
    /// truncated bits to the end of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `<<` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x10000b3i32;
    /// let m = 0xb301;
    ///
    /// assert_eq(n.rotate_left(8), m);
    /// ```
    #[inline]
    pub fn rotate_left(self, n: u32) -> i32 {
        let v = self as u32;
        let k = n % 32;
        if k == 0 {
            return self;
        }
        ((v << k) | (v >> (32 - k))) as i32
    }

    /// Shifts the bits to the right by a specified amount, `n`, wrapping the
    /// truncated bits to the beginning of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `>>` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0xb301i32;
    /// let m = 0x10000b3;
    ///
    /// assert_eq(n.rotate_right(8), m);
    /// ```
    #[inline]
    pub fn rotate_right(self, n: u32) -> i32 {
        let k = n % 32;
        if k == 0 {
            return self;
        }
        self.rotate_left(32 - k)
    }

    /// Returns `true` if and only if `self == 2^k` for some `k`.
    ///
    /// Zero and the negative numbers are not powers of two. (Rust has this
    /// method on the unsigned types only.)
    ///
    /// # Examples
    ///
    /// ```
    /// assert(16i32.is_power_of_two());
    /// assert(!10i32.is_power_of_two());
    /// assert(!0i32.is_power_of_two());
    /// assert(!i32::MIN.is_power_of_two());
    /// ```
    #[inline]
    pub fn is_power_of_two(self) -> bool {
        self > 0 && self.count_ones() == 1
    }

    /// Parses an integer from a string slice with digits in the given base.
    ///
    /// The string is expected to be an optional `+` or `-` sign followed by
    /// only digits. Leading and trailing non-digit characters (including
    /// whitespace) represent an error. Underscores (which can appear in
    /// literals) also represent an error.
    ///
    /// Digits are a subset of these characters, depending on `radix`: `0-9`,
    /// `a-z`, `A-Z`.
    ///
    /// # Panics
    ///
    /// This function panics if `radix` is not in the range from 2 to 36.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i32::from_str_radix("A", 16), Ok(10));
    /// assert_eq(i32::from_str_radix("-1111", 2), Ok(-15));
    /// assert(i32::from_str_radix("12 ", 10).is_err());
    /// assert(i32::from_str_radix("2147483648", 10).is_err());
    /// ```
    pub fn from_str_radix(src: &str, radix: u32) -> Result<i32, ParseIntError> {
        match crate::str::parse_radix(src, radix, true) {
            Some((neg, mag)) => {
                let max = i32::MAX as u64;
                if neg {
                    if mag > max + 1 {
                        return Err(ParseIntError);
                    }
                    Ok((0u64.wrapping_sub(mag)) as i32)
                } else {
                    if mag > max {
                        return Err(ParseIntError);
                    }
                    Ok(mag as i32)
                }
            }
            None => Err(ParseIntError),
        }
    }

    /// Returns the memory representation of this integer as a byte array in
    /// little-endian byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x12345678i32.to_le_bytes();
    /// assert_eq(bytes, [0x78, 0x56, 0x34, 0x12]);
    /// ```
    #[inline]
    pub fn to_le_bytes(self) -> [u8; 4] {
        let mut out = [0u8; 4];
        let v = self as u32;
        let mut i = 0;
        while i < 4 {
            out[i] = ((v >> (8 * i as u32)) & 255) as u8;
            i += 1;
        }
        out
    }

    /// Creates an integer value from its representation as a byte array in
    /// little endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = i32::from_le_bytes([0x78, 0x56, 0x34, 0x12]);
    /// assert_eq(value, 0x12345678);
    /// ```
    #[inline]
    pub fn from_le_bytes(bytes: [u8; 4]) -> i32 {
        let mut v: u32 = 0;
        let mut i = 4;
        while i > 0 {
            i -= 1;
            v = (v << 8) | bytes[i] as u32;
        }
        v as i32
    }

    /// Computes the absolute value of `self`.
    ///
    /// The absolute value of `i32::MIN` cannot be represented as an `i32`, and
    /// attempting to calculate it will cause an overflow.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is `i32::MIN` (navi checks integer
    /// overflow in every build; Rust only in debug builds). `wrapping_abs`,
    /// `checked_abs`, `saturating_abs`, `overflowing_abs` and `unsigned_abs`
    /// handle it.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i32.abs(), 10);
    /// assert_eq((-10i32).abs(), 10);
    /// ```
    #[inline]
    pub fn abs(self) -> i32 {
        if self < 0 { -self } else { self }
    }

    /// Wrapping (modular) absolute value. Computes `self.abs()`, wrapping
    /// around at the boundary of the type.
    ///
    /// The only case where such wrapping can occur is when one takes the
    /// absolute value of the negative minimal value for the type; this is a
    /// positive value that is too large to represent in the type. In such a
    /// case, this function returns `MIN` itself.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i32.wrapping_abs(), 100);
    /// assert_eq((-100i32).wrapping_abs(), 100);
    /// assert_eq(i32::MIN.wrapping_abs(), i32::MIN);
    /// assert_eq(i32::MIN.wrapping_abs() as u32, i32::MAX as u32 + 1);
    /// ```
    #[inline]
    pub fn wrapping_abs(self) -> i32 {
        if self < 0 { self.wrapping_neg() } else { self }
    }

    /// Computes the absolute value of `self` without any wrapping or panicking.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i32.unsigned_abs(), 100u32);
    /// assert_eq((-100i32).unsigned_abs(), 100u32);
    /// assert_eq(i32::MIN.unsigned_abs(), i32::MAX as u32 + 1);
    /// ```
    #[inline]
    pub fn unsigned_abs(self) -> u32 {
        if self < 0 {
            (self as u32).wrapping_neg()
        } else {
            self as u32
        }
    }

    /// Returns a number representing sign of `self`.
    ///
    /// - `0` if the number is zero
    /// - `1` if the number is positive
    /// - `-1` if the number is negative
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i32.signum(), 1);
    /// assert_eq(0i32.signum(), 0);
    /// assert_eq((-10i32).signum(), -1);
    /// ```
    #[inline]
    pub fn signum(self) -> i32 {
        if self < 0 {
            -1
        } else if self > 0 {
            1
        } else {
            0
        }
    }

    /// Returns `true` if `self` is negative and `false` if the number is zero
    /// or positive.
    ///
    /// # Examples
    ///
    /// ```
    /// assert((-10i32).is_negative());
    /// assert(!10i32.is_negative());
    /// ```
    #[inline]
    pub fn is_negative(self) -> bool {
        self < 0
    }

    /// Returns `true` if `self` is positive and `false` if the number is zero
    /// or negative.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(10i32.is_positive());
    /// assert(!(-10i32).is_positive());
    /// ```
    #[inline]
    pub fn is_positive(self) -> bool {
        self > 0
    }
}

impl i64 {
    /// The smallest value that can be represented by this integer type (−2⁶³).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i64::MIN, -9223372036854775808);
    /// ```
    pub const MIN: i64 = -9223372036854775807 - 1;

    /// The largest value that can be represented by this integer type (2⁶³ −
    /// 1).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i64::MAX, 9223372036854775807);
    /// ```
    pub const MAX: i64 = 9223372036854775807;

    /// The size of this integer type in bits.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i64::BITS, 64);
    /// ```
    pub const BITS: u32 = 64;

    /// Wrapping (modular) addition. Computes `self + rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i64.wrapping_add(27), 127);
    /// assert_eq(i64::MAX.wrapping_add(2), i64::MIN + 1);
    /// ```
    #[inline]
    pub fn wrapping_add(self, rhs: i64) -> i64 {
        crate::intrinsics::wrapping_add(self, rhs)
    }

    /// Wrapping (modular) subtraction. Computes `self - rhs`, wrapping around
    /// at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0i64.wrapping_sub(127), -127);
    /// assert_eq((-2i64).wrapping_sub(i64::MAX), i64::MAX);
    /// ```
    #[inline]
    pub fn wrapping_sub(self, rhs: i64) -> i64 {
        crate::intrinsics::wrapping_sub(self, rhs)
    }

    /// Wrapping (modular) multiplication. Computes `self * rhs`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i64.wrapping_mul(12), 120);
    /// assert_eq(i64::MAX.wrapping_mul(2), -2);
    /// ```
    #[inline]
    pub fn wrapping_mul(self, rhs: i64) -> i64 {
        crate::intrinsics::wrapping_mul(self, rhs)
    }

    /// Wrapping (modular) negation. Computes `-self`, wrapping around at the
    /// boundary of the type.
    ///
    /// The only case where such wrapping can occur is when one negates `MIN` on
    /// a signed type (where `MIN` is the negative minimal value for the type);
    /// this is a positive value that is too large to represent in the type. In
    /// such a case, this function returns `MIN` itself.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i64.wrapping_neg(), -100);
    /// assert_eq((-100i64).wrapping_neg(), 100);
    /// assert_eq(i64::MIN.wrapping_neg(), i64::MIN);
    /// ```
    #[inline]
    pub fn wrapping_neg(self) -> i64 {
        crate::intrinsics::wrapping_sub(0, self)
    }

    /// Calculates `self + rhs`.
    ///
    /// Returns a tuple of the addition along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would have occurred
    /// then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i64.overflowing_add(2), (7, false));
    /// assert_eq(i64::MAX.overflowing_add(1), (i64::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_add(self, rhs: i64) -> (i64, bool) {
        let r = self.wrapping_add(rhs);
        (r, (rhs > 0 && r < self) || (rhs < 0 && r > self))
    }

    /// Calculates `self - rhs`.
    ///
    /// Returns a tuple of the subtraction along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i64.overflowing_sub(2), (3, false));
    /// assert_eq(i64::MIN.overflowing_sub(1), (i64::MAX, true));
    /// ```
    #[inline]
    pub fn overflowing_sub(self, rhs: i64) -> (i64, bool) {
        let r = self.wrapping_sub(rhs);
        (r, (rhs > 0 && r > self) || (rhs < 0 && r < self))
    }

    /// Calculates the multiplication of `self` and `rhs`.
    ///
    /// Returns a tuple of the multiplication along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i64.overflowing_mul(2), (10, false));
    /// assert_eq(i64::MAX.overflowing_mul(2), (-2, true));
    /// ```
    #[inline]
    pub fn overflowing_mul(self, rhs: i64) -> (i64, bool) {
        let r = self.wrapping_mul(rhs);
        (
            r,
            self != 0 && (r.wrapping_div_exact(self) != rhs || self == -1 && rhs == i64::MIN),
        )
    }

    fn wrapping_div_exact(self, rhs: i64) -> i64 {
        if self == i64::MIN && rhs == -1 {
            self
        } else {
            self / rhs
        }
    }

    /// Checked integer addition. Computes `self + rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i64::MAX - 2).checked_add(1), Some(i64::MAX - 1));
    /// assert_eq((i64::MAX - 2).checked_add(3), None);
    /// ```
    #[inline]
    pub fn checked_add(self, rhs: i64) -> Option<i64> {
        let (r, o) = self.overflowing_add(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer subtraction. Computes `self - rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i64::MIN + 2).checked_sub(1), Some(i64::MIN + 1));
    /// assert_eq((i64::MIN + 2).checked_sub(3), None);
    /// ```
    #[inline]
    pub fn checked_sub(self, rhs: i64) -> Option<i64> {
        let (r, o) = self.overflowing_sub(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer multiplication. Computes `self * rhs`, returning `None`
    /// if overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i64::MAX.checked_mul(1), Some(i64::MAX));
    /// assert_eq(i64::MAX.checked_mul(2), None);
    /// ```
    #[inline]
    pub fn checked_mul(self, rhs: i64) -> Option<i64> {
        let (r, o) = self.overflowing_mul(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer division. Computes `self / rhs`, returning `None` if
    /// `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i64::MIN + 1).checked_div(-1), Some(i64::MAX));
    /// assert_eq(i64::MIN.checked_div(-1), None);
    /// assert_eq(1i64.checked_div(0), None);
    /// ```
    #[inline]
    pub fn checked_div(self, rhs: i64) -> Option<i64> {
        if rhs == 0 || self == i64::MIN && rhs == -1 {
            None
        } else {
            Some(self / rhs)
        }
    }

    /// Checked integer remainder. Computes `self % rhs`, returning `None` if
    /// `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i64.checked_rem(2), Some(1));
    /// assert_eq(5i64.checked_rem(0), None);
    /// assert_eq(i64::MIN.checked_rem(-1), None);
    /// ```
    #[inline]
    pub fn checked_rem(self, rhs: i64) -> Option<i64> {
        if rhs == 0 || self == i64::MIN && rhs == -1 {
            None
        } else {
            Some(self % rhs)
        }
    }

    /// Saturating integer addition. Computes `self + rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i64.saturating_add(1), 101);
    /// assert_eq(i64::MAX.saturating_add(100), i64::MAX);
    /// assert_eq(i64::MIN.saturating_add(-1), i64::MIN);
    /// ```
    #[inline]
    pub fn saturating_add(self, rhs: i64) -> i64 {
        match self.checked_add(rhs) {
            Some(r) => r,
            None => {
                if rhs < 0 {
                    i64::MIN
                } else {
                    i64::MAX
                }
            }
        }
    }

    /// Saturating integer subtraction. Computes `self - rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i64.saturating_sub(127), -27);
    /// assert_eq(i64::MIN.saturating_sub(100), i64::MIN);
    /// assert_eq(i64::MAX.saturating_sub(-1), i64::MAX);
    /// ```
    #[inline]
    pub fn saturating_sub(self, rhs: i64) -> i64 {
        match self.checked_sub(rhs) {
            Some(r) => r,
            None => {
                if rhs > 0 {
                    i64::MIN
                } else {
                    i64::MAX
                }
            }
        }
    }

    /// Saturating integer multiplication. Computes `self * rhs`, saturating at
    /// the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i64.saturating_mul(12), 120);
    /// assert_eq(i64::MAX.saturating_mul(10), i64::MAX);
    /// assert_eq(i64::MIN.saturating_mul(10), i64::MIN);
    /// ```
    #[inline]
    pub fn saturating_mul(self, rhs: i64) -> i64 {
        match self.checked_mul(rhs) {
            Some(r) => r,
            None => {
                if (self < 0) != (rhs < 0) {
                    i64::MIN
                } else {
                    i64::MAX
                }
            }
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// # Panics
    ///
    /// This function will panic if the result overflows (navi checks integer
    /// overflow in every build; Rust only in debug builds). Use `checked_pow`,
    /// `wrapping_pow`, `saturating_pow` or `overflowing_pow` when it may.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2i64;
    ///
    /// assert_eq(x.pow(5), 32);
    /// assert_eq(x.pow(0), 1);
    /// ```
    pub fn pow(self, exp: u32) -> i64 {
        if exp == 0 {
            return 1;
        }
        let mut base = self;
        let mut acc: i64 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc * base;
                if e == 1 {
                    return acc;
                }
            }
            e = e / 2;
            base = base * base;
        }
    }

    /// Wrapping (modular) exponentiation. Computes `self.pow(exp)`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3i64.wrapping_pow(4), 81);
    /// assert_eq(i64::MAX.wrapping_pow(2), 1);
    /// ```
    pub fn wrapping_pow(self, exp: u32) -> i64 {
        let mut base = self;
        let mut acc: i64 = 1;
        let mut e = exp;
        while e > 0 {
            if e & 1 == 1 {
                acc = acc.wrapping_mul(base);
            }
            e = e / 2;
            base = base.wrapping_mul(base);
        }
        acc
    }

    /// Returns the number of ones in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b01001100i64;
    /// assert_eq(n.count_ones(), 3);
    ///
    /// assert_eq(i64::MAX.count_ones(), 63);
    /// assert_eq((-1i64).count_ones(), 64);
    /// ```
    #[inline]
    pub fn count_ones(self) -> u32 {
        let mut v = self as u64;
        let mut n = 0u32;
        while v != 0 {
            n += (v & 1) as u32;
            v = v >> 1;
        }
        n
    }

    /// Returns the number of zeros in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i64::MAX.count_zeros(), 1);
    /// assert_eq((-1i64).count_zeros(), 0);
    /// ```
    #[inline]
    pub fn count_zeros(self) -> u32 {
        64 - self.count_ones()
    }

    /// Returns the number of leading zeros in the binary representation of
    /// `self`.
    ///
    /// Depending on what you're doing with the value, you might also be
    /// interested in the `ilog2` function which returns a consistent number,
    /// even if the type widens.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-1i64).leading_zeros(), 0);
    /// assert_eq(1i64.leading_zeros(), 63);
    /// assert_eq(0i64.leading_zeros(), 64);
    /// ```
    #[inline]
    pub fn leading_zeros(self) -> u32 {
        let v = self as u64;
        let mut n = 0u32;
        while n < 64 && (v >> (64 - 1 - n)) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Returns the number of trailing zeros in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-4i64).trailing_zeros(), 2);
    /// assert_eq(0i64.trailing_zeros(), 64);
    /// ```
    #[inline]
    pub fn trailing_zeros(self) -> u32 {
        let v = self as u64;
        let mut n = 0u32;
        while n < 64 && (v >> n) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Shifts the bits to the left by a specified amount, `n`, wrapping the
    /// truncated bits to the end of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `<<` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0xaa00000000006e1i64;
    /// let m = 0x6e10aa;
    ///
    /// assert_eq(n.rotate_left(12), m);
    /// ```
    #[inline]
    pub fn rotate_left(self, n: u32) -> i64 {
        let v = self as u64;
        let k = n % 64;
        if k == 0 {
            return self;
        }
        ((v << k) | (v >> (64 - k))) as i64
    }

    /// Shifts the bits to the right by a specified amount, `n`, wrapping the
    /// truncated bits to the beginning of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `>>` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x6e10aai64;
    /// let m = 0xaa00000000006e1;
    ///
    /// assert_eq(n.rotate_right(12), m);
    /// ```
    #[inline]
    pub fn rotate_right(self, n: u32) -> i64 {
        let k = n % 64;
        if k == 0 {
            return self;
        }
        self.rotate_left(64 - k)
    }

    /// Returns `true` if and only if `self == 2^k` for some `k`.
    ///
    /// Zero and the negative numbers are not powers of two. (Rust has this
    /// method on the unsigned types only.)
    ///
    /// # Examples
    ///
    /// ```
    /// assert(16i64.is_power_of_two());
    /// assert(!10i64.is_power_of_two());
    /// assert(!0i64.is_power_of_two());
    /// assert(!i64::MIN.is_power_of_two());
    /// ```
    #[inline]
    pub fn is_power_of_two(self) -> bool {
        self > 0 && self.count_ones() == 1
    }

    /// Parses an integer from a string slice with digits in the given base.
    ///
    /// The string is expected to be an optional `+` or `-` sign followed by
    /// only digits. Leading and trailing non-digit characters (including
    /// whitespace) represent an error. Underscores (which can appear in
    /// literals) also represent an error.
    ///
    /// Digits are a subset of these characters, depending on `radix`: `0-9`,
    /// `a-z`, `A-Z`.
    ///
    /// # Panics
    ///
    /// This function panics if `radix` is not in the range from 2 to 36.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i64::from_str_radix("A", 16), Ok(10));
    /// assert_eq(i64::from_str_radix("-1111", 2), Ok(-15));
    /// assert(i64::from_str_radix("12 ", 10).is_err());
    /// assert(i64::from_str_radix("9223372036854775808", 10).is_err());
    /// ```
    pub fn from_str_radix(src: &str, radix: u32) -> Result<i64, ParseIntError> {
        match crate::str::parse_radix(src, radix, true) {
            Some((neg, mag)) => {
                let max = i64::MAX as u64;
                if neg {
                    if mag > max + 1 {
                        return Err(ParseIntError);
                    }
                    Ok((0u64.wrapping_sub(mag)) as i64)
                } else {
                    if mag > max {
                        return Err(ParseIntError);
                    }
                    Ok(mag as i64)
                }
            }
            None => Err(ParseIntError),
        }
    }

    /// Returns the memory representation of this integer as a byte array in
    /// little-endian byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x1234567890123456i64.to_le_bytes();
    /// assert_eq(bytes, [0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12]);
    /// ```
    #[inline]
    pub fn to_le_bytes(self) -> [u8; 8] {
        let mut out = [0u8; 8];
        let v = self as u64;
        let mut i = 0;
        while i < 8 {
            out[i] = ((v >> (8 * i as u32)) & 255) as u8;
            i += 1;
        }
        out
    }

    /// Creates an integer value from its representation as a byte array in
    /// little endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = i64::from_le_bytes([0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12]);
    /// assert_eq(value, 0x1234567890123456);
    /// ```
    #[inline]
    pub fn from_le_bytes(bytes: [u8; 8]) -> i64 {
        let mut v: u64 = 0;
        let mut i = 8;
        while i > 0 {
            i -= 1;
            v = (v << 8) | bytes[i] as u64;
        }
        v as i64
    }

    /// Computes the absolute value of `self`.
    ///
    /// The absolute value of `i64::MIN` cannot be represented as an `i64`, and
    /// attempting to calculate it will cause an overflow.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is `i64::MIN` (navi checks integer
    /// overflow in every build; Rust only in debug builds). `wrapping_abs`,
    /// `checked_abs`, `saturating_abs`, `overflowing_abs` and `unsigned_abs`
    /// handle it.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i64.abs(), 10);
    /// assert_eq((-10i64).abs(), 10);
    /// ```
    #[inline]
    pub fn abs(self) -> i64 {
        if self < 0 { -self } else { self }
    }

    /// Wrapping (modular) absolute value. Computes `self.abs()`, wrapping
    /// around at the boundary of the type.
    ///
    /// The only case where such wrapping can occur is when one takes the
    /// absolute value of the negative minimal value for the type; this is a
    /// positive value that is too large to represent in the type. In such a
    /// case, this function returns `MIN` itself.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i64.wrapping_abs(), 100);
    /// assert_eq((-100i64).wrapping_abs(), 100);
    /// assert_eq(i64::MIN.wrapping_abs(), i64::MIN);
    /// assert_eq(i64::MIN.wrapping_abs() as u64, i64::MAX as u64 + 1);
    /// ```
    #[inline]
    pub fn wrapping_abs(self) -> i64 {
        if self < 0 { self.wrapping_neg() } else { self }
    }

    /// Computes the absolute value of `self` without any wrapping or panicking.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i64.unsigned_abs(), 100u64);
    /// assert_eq((-100i64).unsigned_abs(), 100u64);
    /// assert_eq(i64::MIN.unsigned_abs(), i64::MAX as u64 + 1);
    /// ```
    #[inline]
    pub fn unsigned_abs(self) -> u64 {
        if self < 0 {
            (self as u64).wrapping_neg()
        } else {
            self as u64
        }
    }

    /// Returns a number representing sign of `self`.
    ///
    /// - `0` if the number is zero
    /// - `1` if the number is positive
    /// - `-1` if the number is negative
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i64.signum(), 1);
    /// assert_eq(0i64.signum(), 0);
    /// assert_eq((-10i64).signum(), -1);
    /// ```
    #[inline]
    pub fn signum(self) -> i64 {
        if self < 0 {
            -1
        } else if self > 0 {
            1
        } else {
            0
        }
    }

    /// Returns `true` if `self` is negative and `false` if the number is zero
    /// or positive.
    ///
    /// # Examples
    ///
    /// ```
    /// assert((-10i64).is_negative());
    /// assert(!10i64.is_negative());
    /// ```
    #[inline]
    pub fn is_negative(self) -> bool {
        self < 0
    }

    /// Returns `true` if `self` is positive and `false` if the number is zero
    /// or negative.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(10i64.is_positive());
    /// assert(!(-10i64).is_positive());
    /// ```
    #[inline]
    pub fn is_positive(self) -> bool {
        self > 0
    }
}

impl isize {
    /// The smallest value that can be represented by this integer type (−2⁶³).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(isize::MIN, -9223372036854775808);
    /// ```
    pub const MIN: isize = -9223372036854775807 - 1;

    /// The largest value that can be represented by this integer type (2⁶³ −
    /// 1). navi's targets are all 64-bit, so this is `i64::MAX`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(isize::MAX, 9223372036854775807);
    /// ```
    pub const MAX: isize = 9223372036854775807;

    /// The size of this integer type in bits.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(isize::BITS, 64);
    /// ```
    pub const BITS: u32 = 64;

    /// Wrapping (modular) addition. Computes `self + rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100isize.wrapping_add(27), 127);
    /// assert_eq(isize::MAX.wrapping_add(2), isize::MIN + 1);
    /// ```
    #[inline]
    pub fn wrapping_add(self, rhs: isize) -> isize {
        crate::intrinsics::wrapping_add(self, rhs)
    }

    /// Wrapping (modular) subtraction. Computes `self - rhs`, wrapping around
    /// at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0isize.wrapping_sub(127), -127);
    /// assert_eq((-2isize).wrapping_sub(isize::MAX), isize::MAX);
    /// ```
    #[inline]
    pub fn wrapping_sub(self, rhs: isize) -> isize {
        crate::intrinsics::wrapping_sub(self, rhs)
    }

    /// Wrapping (modular) multiplication. Computes `self * rhs`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10isize.wrapping_mul(12), 120);
    /// assert_eq(isize::MAX.wrapping_mul(2), -2);
    /// ```
    #[inline]
    pub fn wrapping_mul(self, rhs: isize) -> isize {
        crate::intrinsics::wrapping_mul(self, rhs)
    }

    /// Wrapping (modular) negation. Computes `-self`, wrapping around at the
    /// boundary of the type.
    ///
    /// The only case where such wrapping can occur is when one negates `MIN` on
    /// a signed type (where `MIN` is the negative minimal value for the type);
    /// this is a positive value that is too large to represent in the type. In
    /// such a case, this function returns `MIN` itself.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100isize.wrapping_neg(), -100);
    /// assert_eq((-100isize).wrapping_neg(), 100);
    /// assert_eq(isize::MIN.wrapping_neg(), isize::MIN);
    /// ```
    #[inline]
    pub fn wrapping_neg(self) -> isize {
        crate::intrinsics::wrapping_sub(0, self)
    }

    /// Calculates `self + rhs`.
    ///
    /// Returns a tuple of the addition along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would have occurred
    /// then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5isize.overflowing_add(2), (7, false));
    /// assert_eq(isize::MAX.overflowing_add(1), (isize::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_add(self, rhs: isize) -> (isize, bool) {
        let r = self.wrapping_add(rhs);
        (r, (rhs > 0 && r < self) || (rhs < 0 && r > self))
    }

    /// Calculates `self - rhs`.
    ///
    /// Returns a tuple of the subtraction along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5isize.overflowing_sub(2), (3, false));
    /// assert_eq(isize::MIN.overflowing_sub(1), (isize::MAX, true));
    /// ```
    #[inline]
    pub fn overflowing_sub(self, rhs: isize) -> (isize, bool) {
        let r = self.wrapping_sub(rhs);
        (r, (rhs > 0 && r > self) || (rhs < 0 && r < self))
    }

    /// Calculates the multiplication of `self` and `rhs`.
    ///
    /// Returns a tuple of the multiplication along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5isize.overflowing_mul(2), (10, false));
    /// assert_eq(isize::MAX.overflowing_mul(2), (-2, true));
    /// ```
    #[inline]
    pub fn overflowing_mul(self, rhs: isize) -> (isize, bool) {
        let r = self.wrapping_mul(rhs);
        (
            r,
            self != 0 && (r.wrapping_div_exact(self) != rhs || self == -1 && rhs == isize::MIN),
        )
    }

    fn wrapping_div_exact(self, rhs: isize) -> isize {
        if self == isize::MIN && rhs == -1 {
            self
        } else {
            self / rhs
        }
    }

    /// Checked integer addition. Computes `self + rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((isize::MAX - 2).checked_add(1), Some(isize::MAX - 1));
    /// assert_eq((isize::MAX - 2).checked_add(3), None);
    /// ```
    #[inline]
    pub fn checked_add(self, rhs: isize) -> Option<isize> {
        let (r, o) = self.overflowing_add(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer subtraction. Computes `self - rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((isize::MIN + 2).checked_sub(1), Some(isize::MIN + 1));
    /// assert_eq((isize::MIN + 2).checked_sub(3), None);
    /// ```
    #[inline]
    pub fn checked_sub(self, rhs: isize) -> Option<isize> {
        let (r, o) = self.overflowing_sub(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer multiplication. Computes `self * rhs`, returning `None`
    /// if overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(isize::MAX.checked_mul(1), Some(isize::MAX));
    /// assert_eq(isize::MAX.checked_mul(2), None);
    /// ```
    #[inline]
    pub fn checked_mul(self, rhs: isize) -> Option<isize> {
        let (r, o) = self.overflowing_mul(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer division. Computes `self / rhs`, returning `None` if
    /// `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((isize::MIN + 1).checked_div(-1), Some(isize::MAX));
    /// assert_eq(isize::MIN.checked_div(-1), None);
    /// assert_eq(1isize.checked_div(0), None);
    /// ```
    #[inline]
    pub fn checked_div(self, rhs: isize) -> Option<isize> {
        if rhs == 0 || self == isize::MIN && rhs == -1 {
            None
        } else {
            Some(self / rhs)
        }
    }

    /// Checked integer remainder. Computes `self % rhs`, returning `None` if
    /// `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5isize.checked_rem(2), Some(1));
    /// assert_eq(5isize.checked_rem(0), None);
    /// assert_eq(isize::MIN.checked_rem(-1), None);
    /// ```
    #[inline]
    pub fn checked_rem(self, rhs: isize) -> Option<isize> {
        if rhs == 0 || self == isize::MIN && rhs == -1 {
            None
        } else {
            Some(self % rhs)
        }
    }

    /// Saturating integer addition. Computes `self + rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100isize.saturating_add(1), 101);
    /// assert_eq(isize::MAX.saturating_add(100), isize::MAX);
    /// assert_eq(isize::MIN.saturating_add(-1), isize::MIN);
    /// ```
    #[inline]
    pub fn saturating_add(self, rhs: isize) -> isize {
        match self.checked_add(rhs) {
            Some(r) => r,
            None => {
                if rhs < 0 {
                    isize::MIN
                } else {
                    isize::MAX
                }
            }
        }
    }

    /// Saturating integer subtraction. Computes `self - rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100isize.saturating_sub(127), -27);
    /// assert_eq(isize::MIN.saturating_sub(100), isize::MIN);
    /// assert_eq(isize::MAX.saturating_sub(-1), isize::MAX);
    /// ```
    #[inline]
    pub fn saturating_sub(self, rhs: isize) -> isize {
        match self.checked_sub(rhs) {
            Some(r) => r,
            None => {
                if rhs > 0 {
                    isize::MIN
                } else {
                    isize::MAX
                }
            }
        }
    }

    /// Saturating integer multiplication. Computes `self * rhs`, saturating at
    /// the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10isize.saturating_mul(12), 120);
    /// assert_eq(isize::MAX.saturating_mul(10), isize::MAX);
    /// assert_eq(isize::MIN.saturating_mul(10), isize::MIN);
    /// ```
    #[inline]
    pub fn saturating_mul(self, rhs: isize) -> isize {
        match self.checked_mul(rhs) {
            Some(r) => r,
            None => {
                if (self < 0) != (rhs < 0) {
                    isize::MIN
                } else {
                    isize::MAX
                }
            }
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// # Panics
    ///
    /// This function will panic if the result overflows (navi checks integer
    /// overflow in every build; Rust only in debug builds). Use `checked_pow`,
    /// `wrapping_pow`, `saturating_pow` or `overflowing_pow` when it may.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2isize;
    ///
    /// assert_eq(x.pow(5), 32);
    /// assert_eq(x.pow(0), 1);
    /// ```
    pub fn pow(self, exp: u32) -> isize {
        if exp == 0 {
            return 1;
        }
        let mut base = self;
        let mut acc: isize = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc * base;
                if e == 1 {
                    return acc;
                }
            }
            e = e / 2;
            base = base * base;
        }
    }

    /// Wrapping (modular) exponentiation. Computes `self.pow(exp)`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3isize.wrapping_pow(4), 81);
    /// assert_eq(isize::MAX.wrapping_pow(2), 1);
    /// ```
    pub fn wrapping_pow(self, exp: u32) -> isize {
        let mut base = self;
        let mut acc: isize = 1;
        let mut e = exp;
        while e > 0 {
            if e & 1 == 1 {
                acc = acc.wrapping_mul(base);
            }
            e = e / 2;
            base = base.wrapping_mul(base);
        }
        acc
    }

    /// Returns the number of ones in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b01001100isize;
    /// assert_eq(n.count_ones(), 3);
    ///
    /// assert_eq(isize::MAX.count_ones(), 63);
    /// assert_eq((-1isize).count_ones(), 64);
    /// ```
    #[inline]
    pub fn count_ones(self) -> u32 {
        let mut v = self as usize;
        let mut n = 0u32;
        while v != 0 {
            n += (v & 1) as u32;
            v = v >> 1;
        }
        n
    }

    /// Returns the number of zeros in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(isize::MAX.count_zeros(), 1);
    /// assert_eq((-1isize).count_zeros(), 0);
    /// ```
    #[inline]
    pub fn count_zeros(self) -> u32 {
        64 - self.count_ones()
    }

    /// Returns the number of leading zeros in the binary representation of
    /// `self`.
    ///
    /// Depending on what you're doing with the value, you might also be
    /// interested in the `ilog2` function which returns a consistent number,
    /// even if the type widens.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-1isize).leading_zeros(), 0);
    /// assert_eq(1isize.leading_zeros(), 63);
    /// assert_eq(0isize.leading_zeros(), 64);
    /// ```
    #[inline]
    pub fn leading_zeros(self) -> u32 {
        let v = self as usize;
        let mut n = 0u32;
        while n < 64 && (v >> (64 - 1 - n)) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Returns the number of trailing zeros in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-4isize).trailing_zeros(), 2);
    /// assert_eq(0isize.trailing_zeros(), 64);
    /// ```
    #[inline]
    pub fn trailing_zeros(self) -> u32 {
        let v = self as usize;
        let mut n = 0u32;
        while n < 64 && (v >> n) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Shifts the bits to the left by a specified amount, `n`, wrapping the
    /// truncated bits to the end of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `<<` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = (0xaa00000000006e1i64 as isize);
    /// let m = 0x6e10aa;
    ///
    /// assert_eq(n.rotate_left(12), m);
    /// ```
    #[inline]
    pub fn rotate_left(self, n: u32) -> isize {
        let v = self as usize;
        let k = n % 64;
        if k == 0 {
            return self;
        }
        ((v << k) | (v >> (64 - k))) as isize
    }

    /// Shifts the bits to the right by a specified amount, `n`, wrapping the
    /// truncated bits to the beginning of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `>>` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = (0x6e10aai64 as isize);
    /// let m = 0xaa00000000006e1;
    ///
    /// assert_eq(n.rotate_right(12), m);
    /// ```
    #[inline]
    pub fn rotate_right(self, n: u32) -> isize {
        let k = n % 64;
        if k == 0 {
            return self;
        }
        self.rotate_left(64 - k)
    }

    /// Returns `true` if and only if `self == 2^k` for some `k`.
    ///
    /// Zero and the negative numbers are not powers of two. (Rust has this
    /// method on the unsigned types only.)
    ///
    /// # Examples
    ///
    /// ```
    /// assert(16isize.is_power_of_two());
    /// assert(!10isize.is_power_of_two());
    /// assert(!0isize.is_power_of_two());
    /// assert(!isize::MIN.is_power_of_two());
    /// ```
    #[inline]
    pub fn is_power_of_two(self) -> bool {
        self > 0 && self.count_ones() == 1
    }

    /// Parses an integer from a string slice with digits in the given base.
    ///
    /// The string is expected to be an optional `+` or `-` sign followed by
    /// only digits. Leading and trailing non-digit characters (including
    /// whitespace) represent an error. Underscores (which can appear in
    /// literals) also represent an error.
    ///
    /// Digits are a subset of these characters, depending on `radix`: `0-9`,
    /// `a-z`, `A-Z`.
    ///
    /// # Panics
    ///
    /// This function panics if `radix` is not in the range from 2 to 36.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(isize::from_str_radix("A", 16), Ok(10));
    /// assert_eq(isize::from_str_radix("-1111", 2), Ok(-15));
    /// assert(isize::from_str_radix("12 ", 10).is_err());
    /// assert(isize::from_str_radix("9223372036854775808", 10).is_err());
    /// ```
    pub fn from_str_radix(src: &str, radix: u32) -> Result<isize, ParseIntError> {
        match crate::str::parse_radix(src, radix, true) {
            Some((neg, mag)) => {
                let max = isize::MAX as u64;
                if neg {
                    if mag > max + 1 {
                        return Err(ParseIntError);
                    }
                    Ok((0u64.wrapping_sub(mag)) as isize)
                } else {
                    if mag > max {
                        return Err(ParseIntError);
                    }
                    Ok(mag as isize)
                }
            }
            None => Err(ParseIntError),
        }
    }

    /// Returns the memory representation of this integer as a byte array in
    /// little-endian byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = (0x1234567890123456i64 as isize).to_le_bytes();
    /// assert_eq(bytes, [0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12]);
    /// ```
    #[inline]
    pub fn to_le_bytes(self) -> [u8; 8] {
        let mut out = [0u8; 8];
        let v = self as usize;
        let mut i = 0;
        while i < 8 {
            out[i] = ((v >> (8 * i as u32)) & 255) as u8;
            i += 1;
        }
        out
    }

    /// Creates an integer value from its representation as a byte array in
    /// little endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = isize::from_le_bytes([0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12]);
    /// assert_eq(value, 0x1234567890123456);
    /// ```
    #[inline]
    pub fn from_le_bytes(bytes: [u8; 8]) -> isize {
        let mut v: usize = 0;
        let mut i = 8;
        while i > 0 {
            i -= 1;
            v = (v << 8) | bytes[i] as usize;
        }
        v as isize
    }

    /// Computes the absolute value of `self`.
    ///
    /// The absolute value of `isize::MIN` cannot be represented as an `isize`,
    /// and attempting to calculate it will cause an overflow.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is `isize::MIN` (navi checks integer
    /// overflow in every build; Rust only in debug builds). `wrapping_abs`,
    /// `checked_abs`, `saturating_abs`, `overflowing_abs` and `unsigned_abs`
    /// handle it.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10isize.abs(), 10);
    /// assert_eq((-10isize).abs(), 10);
    /// ```
    #[inline]
    pub fn abs(self) -> isize {
        if self < 0 { -self } else { self }
    }

    /// Wrapping (modular) absolute value. Computes `self.abs()`, wrapping
    /// around at the boundary of the type.
    ///
    /// The only case where such wrapping can occur is when one takes the
    /// absolute value of the negative minimal value for the type; this is a
    /// positive value that is too large to represent in the type. In such a
    /// case, this function returns `MIN` itself.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100isize.wrapping_abs(), 100);
    /// assert_eq((-100isize).wrapping_abs(), 100);
    /// assert_eq(isize::MIN.wrapping_abs(), isize::MIN);
    /// assert_eq(isize::MIN.wrapping_abs() as usize, isize::MAX as usize + 1);
    /// ```
    #[inline]
    pub fn wrapping_abs(self) -> isize {
        if self < 0 { self.wrapping_neg() } else { self }
    }

    /// Computes the absolute value of `self` without any wrapping or panicking.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100isize.unsigned_abs(), 100usize);
    /// assert_eq((-100isize).unsigned_abs(), 100usize);
    /// assert_eq(isize::MIN.unsigned_abs(), isize::MAX as usize + 1);
    /// ```
    #[inline]
    pub fn unsigned_abs(self) -> usize {
        if self < 0 {
            (self as usize).wrapping_neg()
        } else {
            self as usize
        }
    }

    /// Returns a number representing sign of `self`.
    ///
    /// - `0` if the number is zero
    /// - `1` if the number is positive
    /// - `-1` if the number is negative
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10isize.signum(), 1);
    /// assert_eq(0isize.signum(), 0);
    /// assert_eq((-10isize).signum(), -1);
    /// ```
    #[inline]
    pub fn signum(self) -> isize {
        if self < 0 {
            -1
        } else if self > 0 {
            1
        } else {
            0
        }
    }

    /// Returns `true` if `self` is negative and `false` if the number is zero
    /// or positive.
    ///
    /// # Examples
    ///
    /// ```
    /// assert((-10isize).is_negative());
    /// assert(!10isize.is_negative());
    /// ```
    #[inline]
    pub fn is_negative(self) -> bool {
        self < 0
    }

    /// Returns `true` if `self` is positive and `false` if the number is zero
    /// or negative.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(10isize.is_positive());
    /// assert(!(-10isize).is_positive());
    /// ```
    #[inline]
    pub fn is_positive(self) -> bool {
        self > 0
    }
}

impl u8 {
    /// The smallest value that can be represented by this integer type (0).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u8::MIN, 0);
    /// ```
    pub const MIN: u8 = 0;

    /// The largest value that can be represented by this integer type (2⁸ − 1).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u8::MAX, 255);
    /// ```
    pub const MAX: u8 = 255;

    /// The size of this integer type in bits.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u8::BITS, 8);
    /// ```
    pub const BITS: u32 = 8;

    /// Wrapping (modular) addition. Computes `self + rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(200u8.wrapping_add(55), 255);
    /// assert_eq(200u8.wrapping_add(u8::MAX), 199);
    /// ```
    #[inline]
    pub fn wrapping_add(self, rhs: u8) -> u8 {
        crate::intrinsics::wrapping_add(self, rhs)
    }

    /// Wrapping (modular) subtraction. Computes `self - rhs`, wrapping around
    /// at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u8.wrapping_sub(100), 0);
    /// assert_eq(100u8.wrapping_sub(u8::MAX), 101);
    /// ```
    #[inline]
    pub fn wrapping_sub(self, rhs: u8) -> u8 {
        crate::intrinsics::wrapping_sub(self, rhs)
    }

    /// Wrapping (modular) multiplication. Computes `self * rhs`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u8.wrapping_mul(12), 120);
    /// assert_eq(u8::MAX.wrapping_mul(2), u8::MAX - 1);
    /// ```
    #[inline]
    pub fn wrapping_mul(self, rhs: u8) -> u8 {
        crate::intrinsics::wrapping_mul(self, rhs)
    }

    /// Wrapping (modular) negation. Computes `-self`, wrapping around at the
    /// boundary of the type.
    ///
    /// Since unsigned types do not have negative equivalents all applications
    /// of this function will wrap (except for `-0`). For values smaller than
    /// the corresponding signed type's maximum the result is the same as
    /// casting the corresponding signed value. Any larger values are equivalent
    /// to `MAX + 1 - (val - MAX - 1)` where `MAX` is the corresponding signed
    /// type's maximum.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u8.wrapping_neg(), 0);
    /// assert_eq(u8::MAX.wrapping_neg(), 1);
    /// assert_eq(13u8.wrapping_neg(), (!13) + 1);
    /// assert_eq(42u8.wrapping_neg(), !(42 - 1));
    /// ```
    #[inline]
    pub fn wrapping_neg(self) -> u8 {
        crate::intrinsics::wrapping_sub(0, self)
    }

    /// Calculates `self + rhs`.
    ///
    /// Returns a tuple of the addition along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would have occurred
    /// then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u8.overflowing_add(2), (7, false));
    /// assert_eq(u8::MAX.overflowing_add(1), (u8::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_add(self, rhs: u8) -> (u8, bool) {
        let r = self.wrapping_add(rhs);
        (r, r < self)
    }

    /// Calculates `self - rhs`.
    ///
    /// Returns a tuple of the subtraction along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u8.overflowing_sub(2), (3, false));
    /// assert_eq(0u8.overflowing_sub(1), (u8::MAX, true));
    /// ```
    #[inline]
    pub fn overflowing_sub(self, rhs: u8) -> (u8, bool) {
        let r = self.wrapping_sub(rhs);
        (r, r > self)
    }

    /// Calculates the multiplication of `self` and `rhs`.
    ///
    /// Returns a tuple of the multiplication along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u8.overflowing_mul(2), (10, false));
    /// assert_eq(u8::MAX.overflowing_mul(2), (u8::MAX - 1, true));
    /// ```
    #[inline]
    pub fn overflowing_mul(self, rhs: u8) -> (u8, bool) {
        let r = self.wrapping_mul(rhs);
        (r, self != 0 && (r.wrapping_div_exact(self) != rhs))
    }

    fn wrapping_div_exact(self, rhs: u8) -> u8 {
        if false { self } else { self / rhs }
    }

    /// Checked integer addition. Computes `self + rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((u8::MAX - 2).checked_add(1), Some(u8::MAX - 1));
    /// assert_eq((u8::MAX - 2).checked_add(3), None);
    /// ```
    #[inline]
    pub fn checked_add(self, rhs: u8) -> Option<u8> {
        let (r, o) = self.overflowing_add(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer subtraction. Computes `self - rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(1u8.checked_sub(1), Some(0));
    /// assert_eq(0u8.checked_sub(1), None);
    /// ```
    #[inline]
    pub fn checked_sub(self, rhs: u8) -> Option<u8> {
        let (r, o) = self.overflowing_sub(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer multiplication. Computes `self * rhs`, returning `None`
    /// if overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u8::MAX.checked_mul(1), Some(u8::MAX));
    /// assert_eq(u8::MAX.checked_mul(2), None);
    /// ```
    #[inline]
    pub fn checked_mul(self, rhs: u8) -> Option<u8> {
        let (r, o) = self.overflowing_mul(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer division. Computes `self / rhs`, returning `None` if
    /// `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(128u8.checked_div(2), Some(64));
    /// assert_eq(1u8.checked_div(0), None);
    /// ```
    #[inline]
    pub fn checked_div(self, rhs: u8) -> Option<u8> {
        if rhs == 0 || false {
            None
        } else {
            Some(self / rhs)
        }
    }

    /// Checked integer remainder. Computes `self % rhs`, returning `None` if
    /// `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u8.checked_rem(2), Some(1));
    /// assert_eq(5u8.checked_rem(0), None);
    /// ```
    #[inline]
    pub fn checked_rem(self, rhs: u8) -> Option<u8> {
        if rhs == 0 || false {
            None
        } else {
            Some(self % rhs)
        }
    }

    /// Saturating integer addition. Computes `self + rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u8.saturating_add(1), 101);
    /// assert_eq(u8::MAX.saturating_add(127), u8::MAX);
    /// ```
    #[inline]
    pub fn saturating_add(self, rhs: u8) -> u8 {
        match self.checked_add(rhs) {
            Some(r) => r,
            None => {
                if false {
                    u8::MIN
                } else {
                    u8::MAX
                }
            }
        }
    }

    /// Saturating integer subtraction. Computes `self - rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u8.saturating_sub(27), 73);
    /// assert_eq(13u8.saturating_sub(127), 0);
    /// ```
    #[inline]
    pub fn saturating_sub(self, rhs: u8) -> u8 {
        match self.checked_sub(rhs) {
            Some(r) => r,
            None => {
                if true {
                    u8::MIN
                } else {
                    u8::MAX
                }
            }
        }
    }

    /// Saturating integer multiplication. Computes `self * rhs`, saturating at
    /// the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u8.saturating_mul(10), 20);
    /// assert_eq(u8::MAX.saturating_mul(10), u8::MAX);
    /// ```
    #[inline]
    pub fn saturating_mul(self, rhs: u8) -> u8 {
        match self.checked_mul(rhs) {
            Some(r) => r,
            None => {
                if false {
                    u8::MIN
                } else {
                    u8::MAX
                }
            }
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// # Panics
    ///
    /// This function will panic if the result overflows (navi checks integer
    /// overflow in every build; Rust only in debug builds). Use `checked_pow`,
    /// `wrapping_pow`, `saturating_pow` or `overflowing_pow` when it may.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2u8;
    ///
    /// assert_eq(x.pow(5), 32);
    /// assert_eq(x.pow(0), 1);
    /// ```
    pub fn pow(self, exp: u32) -> u8 {
        if exp == 0 {
            return 1;
        }
        let mut base = self;
        let mut acc: u8 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc * base;
                if e == 1 {
                    return acc;
                }
            }
            e = e / 2;
            base = base * base;
        }
    }

    /// Wrapping (modular) exponentiation. Computes `self.pow(exp)`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3u8.wrapping_pow(4), 81);
    /// assert_eq(u8::MAX.wrapping_pow(2), 1);
    /// ```
    pub fn wrapping_pow(self, exp: u32) -> u8 {
        let mut base = self;
        let mut acc: u8 = 1;
        let mut e = exp;
        while e > 0 {
            if e & 1 == 1 {
                acc = acc.wrapping_mul(base);
            }
            e = e / 2;
            base = base.wrapping_mul(base);
        }
        acc
    }

    /// Returns the number of ones in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b01001100u8;
    /// assert_eq(n.count_ones(), 3);
    ///
    /// assert_eq(u8::MAX.count_ones(), 8);
    /// ```
    #[inline]
    pub fn count_ones(self) -> u32 {
        let mut v = self as u8;
        let mut n = 0u32;
        while v != 0 {
            n += (v & 1) as u32;
            v = v >> 1;
        }
        n
    }

    /// Returns the number of zeros in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u8.count_zeros(), 8);
    /// assert_eq(u8::MAX.count_zeros(), 0);
    /// ```
    #[inline]
    pub fn count_zeros(self) -> u32 {
        8 - self.count_ones()
    }

    /// Returns the number of leading zeros in the binary representation of
    /// `self`.
    ///
    /// Depending on what you're doing with the value, you might also be
    /// interested in the `ilog2` function which returns a consistent number,
    /// even if the type widens.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = u8::MAX >> 2;
    /// assert_eq(n.leading_zeros(), 2);
    ///
    /// assert_eq(0u8.leading_zeros(), 8);
    /// assert_eq(u8::MAX.leading_zeros(), 0);
    /// ```
    #[inline]
    pub fn leading_zeros(self) -> u32 {
        let v = self as u8;
        let mut n = 0u32;
        while n < 8 && (v >> (8 - 1 - n)) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Returns the number of trailing zeros in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b0101000u8;
    /// assert_eq(n.trailing_zeros(), 3);
    ///
    /// assert_eq(0u8.trailing_zeros(), 8);
    /// assert_eq(u8::MAX.trailing_zeros(), 0);
    /// ```
    #[inline]
    pub fn trailing_zeros(self) -> u32 {
        let v = self as u8;
        let mut n = 0u32;
        while n < 8 && (v >> n) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Shifts the bits to the left by a specified amount, `n`, wrapping the
    /// truncated bits to the end of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `<<` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x82u8;
    /// let m = 0xa;
    ///
    /// assert_eq(n.rotate_left(2), m);
    /// ```
    #[inline]
    pub fn rotate_left(self, n: u32) -> u8 {
        let v = self as u8;
        let k = n % 8;
        if k == 0 {
            return self;
        }
        ((v << k) | (v >> (8 - k))) as u8
    }

    /// Shifts the bits to the right by a specified amount, `n`, wrapping the
    /// truncated bits to the beginning of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `>>` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0xau8;
    /// let m = 0x82;
    ///
    /// assert_eq(n.rotate_right(2), m);
    /// ```
    #[inline]
    pub fn rotate_right(self, n: u32) -> u8 {
        let k = n % 8;
        if k == 0 {
            return self;
        }
        self.rotate_left(8 - k)
    }

    /// Returns `true` if and only if `self == 2^k` for some `k`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(16u8.is_power_of_two());
    /// assert(!10u8.is_power_of_two());
    /// assert(!0u8.is_power_of_two());
    /// ```
    #[inline]
    pub fn is_power_of_two(self) -> bool {
        self > 0 && self.count_ones() == 1
    }

    /// Parses an integer from a string slice with digits in the given base.
    ///
    /// The string is expected to be an optional `+` sign followed by only
    /// digits. Leading and trailing non-digit characters (including whitespace)
    /// represent an error. Underscores (which can appear in literals) also
    /// represent an error.
    ///
    /// Digits are a subset of these characters, depending on `radix`: `0-9`,
    /// `a-z`, `A-Z`.
    ///
    /// # Panics
    ///
    /// This function panics if `radix` is not in the range from 2 to 36.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u8::from_str_radix("A", 16), Ok(10));
    /// assert_eq(u8::from_str_radix("+1111", 2), Ok(15));
    /// assert(u8::from_str_radix("12 ", 10).is_err());
    /// assert(u8::from_str_radix("256", 10).is_err());
    /// ```
    pub fn from_str_radix(src: &str, radix: u32) -> Result<u8, ParseIntError> {
        match crate::str::parse_radix(src, radix, false) {
            Some((neg, mag)) => {
                let max = u8::MAX as u64;
                if neg {
                    if mag > max + 1 {
                        return Err(ParseIntError);
                    }
                    Ok((0u64.wrapping_sub(mag)) as u8)
                } else {
                    if mag > max {
                        return Err(ParseIntError);
                    }
                    Ok(mag as u8)
                }
            }
            None => Err(ParseIntError),
        }
    }

    /// Returns the memory representation of this integer as a byte array in
    /// little-endian byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x12u8.to_le_bytes();
    /// assert_eq(bytes, [0x12]);
    /// ```
    #[inline]
    pub fn to_le_bytes(self) -> [u8; 1] {
        let mut out = [0u8; 1];
        let v = self as u8;
        let mut i = 0;
        while i < 1 {
            out[i] = ((v >> (8 * i as u32)) & 255) as u8;
            i += 1;
        }
        out
    }

    /// Creates an integer value from its representation as a byte array in
    /// little endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = u8::from_le_bytes([0x12]);
    /// assert_eq(value, 0x12);
    /// ```
    #[inline]
    pub fn from_le_bytes(bytes: [u8; 1]) -> u8 {
        bytes[0] as u8
    }

    /// Returns the smallest power of two greater than or equal to `self`.
    ///
    /// # Panics
    ///
    /// Panics when the return value overflows (that is, `self > (1 << 7)`),
    /// as Rust's debug builds do (Rust's release builds return 0). Use
    /// `checked_next_power_of_two` when it may not fit.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u8.next_power_of_two(), 2);
    /// assert_eq(3u8.next_power_of_two(), 4);
    /// assert_eq(0u8.next_power_of_two(), 1);
    /// ```
    #[inline]
    pub fn next_power_of_two(self) -> u8 {
        match self.checked_next_power_of_two() {
            Some(p) => p,
            None => crate::panic::panic("attempt to add with overflow"),
        }
    }

    /// Computes the absolute difference between `self` and `other`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u8.abs_diff(80), 20);
    /// assert_eq(100u8.abs_diff(110), 10);
    /// assert_eq(0u8.abs_diff(u8::MAX), u8::MAX);
    /// ```
    #[inline]
    pub fn abs_diff(self, other: u8) -> u8 {
        if self > other {
            self - other
        } else {
            other - self
        }
    }
}

impl u16 {
    /// The smallest value that can be represented by this integer type (0).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u16::MIN, 0);
    /// ```
    pub const MIN: u16 = 0;

    /// The largest value that can be represented by this integer type (2¹⁶ −
    /// 1).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u16::MAX, 65535);
    /// ```
    pub const MAX: u16 = 65535;

    /// The size of this integer type in bits.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u16::BITS, 16);
    /// ```
    pub const BITS: u32 = 16;

    /// Wrapping (modular) addition. Computes `self + rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(200u16.wrapping_add(55), 255);
    /// assert_eq(200u16.wrapping_add(u16::MAX), 199);
    /// ```
    #[inline]
    pub fn wrapping_add(self, rhs: u16) -> u16 {
        crate::intrinsics::wrapping_add(self, rhs)
    }

    /// Wrapping (modular) subtraction. Computes `self - rhs`, wrapping around
    /// at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u16.wrapping_sub(100), 0);
    /// assert_eq(100u16.wrapping_sub(u16::MAX), 101);
    /// ```
    #[inline]
    pub fn wrapping_sub(self, rhs: u16) -> u16 {
        crate::intrinsics::wrapping_sub(self, rhs)
    }

    /// Wrapping (modular) multiplication. Computes `self * rhs`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u16.wrapping_mul(12), 120);
    /// assert_eq(u16::MAX.wrapping_mul(2), u16::MAX - 1);
    /// ```
    #[inline]
    pub fn wrapping_mul(self, rhs: u16) -> u16 {
        crate::intrinsics::wrapping_mul(self, rhs)
    }

    /// Wrapping (modular) negation. Computes `-self`, wrapping around at the
    /// boundary of the type.
    ///
    /// Since unsigned types do not have negative equivalents all applications
    /// of this function will wrap (except for `-0`). For values smaller than
    /// the corresponding signed type's maximum the result is the same as
    /// casting the corresponding signed value. Any larger values are equivalent
    /// to `MAX + 1 - (val - MAX - 1)` where `MAX` is the corresponding signed
    /// type's maximum.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u16.wrapping_neg(), 0);
    /// assert_eq(u16::MAX.wrapping_neg(), 1);
    /// assert_eq(13u16.wrapping_neg(), (!13) + 1);
    /// assert_eq(42u16.wrapping_neg(), !(42 - 1));
    /// ```
    #[inline]
    pub fn wrapping_neg(self) -> u16 {
        crate::intrinsics::wrapping_sub(0, self)
    }

    /// Calculates `self + rhs`.
    ///
    /// Returns a tuple of the addition along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would have occurred
    /// then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u16.overflowing_add(2), (7, false));
    /// assert_eq(u16::MAX.overflowing_add(1), (u16::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_add(self, rhs: u16) -> (u16, bool) {
        let r = self.wrapping_add(rhs);
        (r, r < self)
    }

    /// Calculates `self - rhs`.
    ///
    /// Returns a tuple of the subtraction along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u16.overflowing_sub(2), (3, false));
    /// assert_eq(0u16.overflowing_sub(1), (u16::MAX, true));
    /// ```
    #[inline]
    pub fn overflowing_sub(self, rhs: u16) -> (u16, bool) {
        let r = self.wrapping_sub(rhs);
        (r, r > self)
    }

    /// Calculates the multiplication of `self` and `rhs`.
    ///
    /// Returns a tuple of the multiplication along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u16.overflowing_mul(2), (10, false));
    /// assert_eq(u16::MAX.overflowing_mul(2), (u16::MAX - 1, true));
    /// ```
    #[inline]
    pub fn overflowing_mul(self, rhs: u16) -> (u16, bool) {
        let r = self.wrapping_mul(rhs);
        (r, self != 0 && (r.wrapping_div_exact(self) != rhs))
    }

    fn wrapping_div_exact(self, rhs: u16) -> u16 {
        if false { self } else { self / rhs }
    }

    /// Checked integer addition. Computes `self + rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((u16::MAX - 2).checked_add(1), Some(u16::MAX - 1));
    /// assert_eq((u16::MAX - 2).checked_add(3), None);
    /// ```
    #[inline]
    pub fn checked_add(self, rhs: u16) -> Option<u16> {
        let (r, o) = self.overflowing_add(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer subtraction. Computes `self - rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(1u16.checked_sub(1), Some(0));
    /// assert_eq(0u16.checked_sub(1), None);
    /// ```
    #[inline]
    pub fn checked_sub(self, rhs: u16) -> Option<u16> {
        let (r, o) = self.overflowing_sub(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer multiplication. Computes `self * rhs`, returning `None`
    /// if overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u16::MAX.checked_mul(1), Some(u16::MAX));
    /// assert_eq(u16::MAX.checked_mul(2), None);
    /// ```
    #[inline]
    pub fn checked_mul(self, rhs: u16) -> Option<u16> {
        let (r, o) = self.overflowing_mul(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer division. Computes `self / rhs`, returning `None` if
    /// `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(128u16.checked_div(2), Some(64));
    /// assert_eq(1u16.checked_div(0), None);
    /// ```
    #[inline]
    pub fn checked_div(self, rhs: u16) -> Option<u16> {
        if rhs == 0 || false {
            None
        } else {
            Some(self / rhs)
        }
    }

    /// Checked integer remainder. Computes `self % rhs`, returning `None` if
    /// `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u16.checked_rem(2), Some(1));
    /// assert_eq(5u16.checked_rem(0), None);
    /// ```
    #[inline]
    pub fn checked_rem(self, rhs: u16) -> Option<u16> {
        if rhs == 0 || false {
            None
        } else {
            Some(self % rhs)
        }
    }

    /// Saturating integer addition. Computes `self + rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u16.saturating_add(1), 101);
    /// assert_eq(u16::MAX.saturating_add(127), u16::MAX);
    /// ```
    #[inline]
    pub fn saturating_add(self, rhs: u16) -> u16 {
        match self.checked_add(rhs) {
            Some(r) => r,
            None => {
                if false {
                    u16::MIN
                } else {
                    u16::MAX
                }
            }
        }
    }

    /// Saturating integer subtraction. Computes `self - rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u16.saturating_sub(27), 73);
    /// assert_eq(13u16.saturating_sub(127), 0);
    /// ```
    #[inline]
    pub fn saturating_sub(self, rhs: u16) -> u16 {
        match self.checked_sub(rhs) {
            Some(r) => r,
            None => {
                if true {
                    u16::MIN
                } else {
                    u16::MAX
                }
            }
        }
    }

    /// Saturating integer multiplication. Computes `self * rhs`, saturating at
    /// the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u16.saturating_mul(10), 20);
    /// assert_eq(u16::MAX.saturating_mul(10), u16::MAX);
    /// ```
    #[inline]
    pub fn saturating_mul(self, rhs: u16) -> u16 {
        match self.checked_mul(rhs) {
            Some(r) => r,
            None => {
                if false {
                    u16::MIN
                } else {
                    u16::MAX
                }
            }
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// # Panics
    ///
    /// This function will panic if the result overflows (navi checks integer
    /// overflow in every build; Rust only in debug builds). Use `checked_pow`,
    /// `wrapping_pow`, `saturating_pow` or `overflowing_pow` when it may.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2u16;
    ///
    /// assert_eq(x.pow(5), 32);
    /// assert_eq(x.pow(0), 1);
    /// ```
    pub fn pow(self, exp: u32) -> u16 {
        if exp == 0 {
            return 1;
        }
        let mut base = self;
        let mut acc: u16 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc * base;
                if e == 1 {
                    return acc;
                }
            }
            e = e / 2;
            base = base * base;
        }
    }

    /// Wrapping (modular) exponentiation. Computes `self.pow(exp)`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3u16.wrapping_pow(4), 81);
    /// assert_eq(u16::MAX.wrapping_pow(2), 1);
    /// ```
    pub fn wrapping_pow(self, exp: u32) -> u16 {
        let mut base = self;
        let mut acc: u16 = 1;
        let mut e = exp;
        while e > 0 {
            if e & 1 == 1 {
                acc = acc.wrapping_mul(base);
            }
            e = e / 2;
            base = base.wrapping_mul(base);
        }
        acc
    }

    /// Returns the number of ones in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b01001100u16;
    /// assert_eq(n.count_ones(), 3);
    ///
    /// assert_eq(u16::MAX.count_ones(), 16);
    /// ```
    #[inline]
    pub fn count_ones(self) -> u32 {
        let mut v = self as u16;
        let mut n = 0u32;
        while v != 0 {
            n += (v & 1) as u32;
            v = v >> 1;
        }
        n
    }

    /// Returns the number of zeros in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u16.count_zeros(), 16);
    /// assert_eq(u16::MAX.count_zeros(), 0);
    /// ```
    #[inline]
    pub fn count_zeros(self) -> u32 {
        16 - self.count_ones()
    }

    /// Returns the number of leading zeros in the binary representation of
    /// `self`.
    ///
    /// Depending on what you're doing with the value, you might also be
    /// interested in the `ilog2` function which returns a consistent number,
    /// even if the type widens.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = u16::MAX >> 2;
    /// assert_eq(n.leading_zeros(), 2);
    ///
    /// assert_eq(0u16.leading_zeros(), 16);
    /// assert_eq(u16::MAX.leading_zeros(), 0);
    /// ```
    #[inline]
    pub fn leading_zeros(self) -> u32 {
        let v = self as u16;
        let mut n = 0u32;
        while n < 16 && (v >> (16 - 1 - n)) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Returns the number of trailing zeros in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b0101000u16;
    /// assert_eq(n.trailing_zeros(), 3);
    ///
    /// assert_eq(0u16.trailing_zeros(), 16);
    /// assert_eq(u16::MAX.trailing_zeros(), 0);
    /// ```
    #[inline]
    pub fn trailing_zeros(self) -> u32 {
        let v = self as u16;
        let mut n = 0u32;
        while n < 16 && (v >> n) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Shifts the bits to the left by a specified amount, `n`, wrapping the
    /// truncated bits to the end of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `<<` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0xa003u16;
    /// let m = 0x3a;
    ///
    /// assert_eq(n.rotate_left(4), m);
    /// ```
    #[inline]
    pub fn rotate_left(self, n: u32) -> u16 {
        let v = self as u16;
        let k = n % 16;
        if k == 0 {
            return self;
        }
        ((v << k) | (v >> (16 - k))) as u16
    }

    /// Shifts the bits to the right by a specified amount, `n`, wrapping the
    /// truncated bits to the beginning of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `>>` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x3au16;
    /// let m = 0xa003;
    ///
    /// assert_eq(n.rotate_right(4), m);
    /// ```
    #[inline]
    pub fn rotate_right(self, n: u32) -> u16 {
        let k = n % 16;
        if k == 0 {
            return self;
        }
        self.rotate_left(16 - k)
    }

    /// Returns `true` if and only if `self == 2^k` for some `k`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(16u16.is_power_of_two());
    /// assert(!10u16.is_power_of_two());
    /// assert(!0u16.is_power_of_two());
    /// ```
    #[inline]
    pub fn is_power_of_two(self) -> bool {
        self > 0 && self.count_ones() == 1
    }

    /// Parses an integer from a string slice with digits in the given base.
    ///
    /// The string is expected to be an optional `+` sign followed by only
    /// digits. Leading and trailing non-digit characters (including whitespace)
    /// represent an error. Underscores (which can appear in literals) also
    /// represent an error.
    ///
    /// Digits are a subset of these characters, depending on `radix`: `0-9`,
    /// `a-z`, `A-Z`.
    ///
    /// # Panics
    ///
    /// This function panics if `radix` is not in the range from 2 to 36.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u16::from_str_radix("A", 16), Ok(10));
    /// assert_eq(u16::from_str_radix("+1111", 2), Ok(15));
    /// assert(u16::from_str_radix("12 ", 10).is_err());
    /// assert(u16::from_str_radix("65536", 10).is_err());
    /// ```
    pub fn from_str_radix(src: &str, radix: u32) -> Result<u16, ParseIntError> {
        match crate::str::parse_radix(src, radix, false) {
            Some((neg, mag)) => {
                let max = u16::MAX as u64;
                if neg {
                    if mag > max + 1 {
                        return Err(ParseIntError);
                    }
                    Ok((0u64.wrapping_sub(mag)) as u16)
                } else {
                    if mag > max {
                        return Err(ParseIntError);
                    }
                    Ok(mag as u16)
                }
            }
            None => Err(ParseIntError),
        }
    }

    /// Returns the memory representation of this integer as a byte array in
    /// little-endian byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x1234u16.to_le_bytes();
    /// assert_eq(bytes, [0x34, 0x12]);
    /// ```
    #[inline]
    pub fn to_le_bytes(self) -> [u8; 2] {
        let mut out = [0u8; 2];
        let v = self as u16;
        let mut i = 0;
        while i < 2 {
            out[i] = ((v >> (8 * i as u32)) & 255) as u8;
            i += 1;
        }
        out
    }

    /// Creates an integer value from its representation as a byte array in
    /// little endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = u16::from_le_bytes([0x34, 0x12]);
    /// assert_eq(value, 0x1234);
    /// ```
    #[inline]
    pub fn from_le_bytes(bytes: [u8; 2]) -> u16 {
        let mut v: u16 = 0;
        let mut i = 2;
        while i > 0 {
            i -= 1;
            v = (v << 8) | bytes[i] as u16;
        }
        v as u16
    }

    /// Returns the smallest power of two greater than or equal to `self`.
    ///
    /// # Panics
    ///
    /// Panics when the return value overflows (that is, `self > (1 << 15)`),
    /// as Rust's debug builds do (Rust's release builds return 0). Use
    /// `checked_next_power_of_two` when it may not fit.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u16.next_power_of_two(), 2);
    /// assert_eq(3u16.next_power_of_two(), 4);
    /// assert_eq(0u16.next_power_of_two(), 1);
    /// ```
    #[inline]
    pub fn next_power_of_two(self) -> u16 {
        match self.checked_next_power_of_two() {
            Some(p) => p,
            None => crate::panic::panic("attempt to add with overflow"),
        }
    }

    /// Computes the absolute difference between `self` and `other`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u16.abs_diff(80), 20);
    /// assert_eq(100u16.abs_diff(110), 10);
    /// assert_eq(0u16.abs_diff(u16::MAX), u16::MAX);
    /// ```
    #[inline]
    pub fn abs_diff(self, other: u16) -> u16 {
        if self > other {
            self - other
        } else {
            other - self
        }
    }
}

impl u32 {
    /// The smallest value that can be represented by this integer type (0).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u32::MIN, 0);
    /// ```
    pub const MIN: u32 = 0;

    /// The largest value that can be represented by this integer type (2³² −
    /// 1).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u32::MAX, 4294967295);
    /// ```
    pub const MAX: u32 = 4294967295;

    /// The size of this integer type in bits.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u32::BITS, 32);
    /// ```
    pub const BITS: u32 = 32;

    /// Wrapping (modular) addition. Computes `self + rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(200u32.wrapping_add(55), 255);
    /// assert_eq(200u32.wrapping_add(u32::MAX), 199);
    /// ```
    #[inline]
    pub fn wrapping_add(self, rhs: u32) -> u32 {
        crate::intrinsics::wrapping_add(self, rhs)
    }

    /// Wrapping (modular) subtraction. Computes `self - rhs`, wrapping around
    /// at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u32.wrapping_sub(100), 0);
    /// assert_eq(100u32.wrapping_sub(u32::MAX), 101);
    /// ```
    #[inline]
    pub fn wrapping_sub(self, rhs: u32) -> u32 {
        crate::intrinsics::wrapping_sub(self, rhs)
    }

    /// Wrapping (modular) multiplication. Computes `self * rhs`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u32.wrapping_mul(12), 120);
    /// assert_eq(u32::MAX.wrapping_mul(2), u32::MAX - 1);
    /// ```
    #[inline]
    pub fn wrapping_mul(self, rhs: u32) -> u32 {
        crate::intrinsics::wrapping_mul(self, rhs)
    }

    /// Wrapping (modular) negation. Computes `-self`, wrapping around at the
    /// boundary of the type.
    ///
    /// Since unsigned types do not have negative equivalents all applications
    /// of this function will wrap (except for `-0`). For values smaller than
    /// the corresponding signed type's maximum the result is the same as
    /// casting the corresponding signed value. Any larger values are equivalent
    /// to `MAX + 1 - (val - MAX - 1)` where `MAX` is the corresponding signed
    /// type's maximum.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u32.wrapping_neg(), 0);
    /// assert_eq(u32::MAX.wrapping_neg(), 1);
    /// assert_eq(13u32.wrapping_neg(), (!13) + 1);
    /// assert_eq(42u32.wrapping_neg(), !(42 - 1));
    /// ```
    #[inline]
    pub fn wrapping_neg(self) -> u32 {
        crate::intrinsics::wrapping_sub(0, self)
    }

    /// Calculates `self + rhs`.
    ///
    /// Returns a tuple of the addition along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would have occurred
    /// then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u32.overflowing_add(2), (7, false));
    /// assert_eq(u32::MAX.overflowing_add(1), (u32::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_add(self, rhs: u32) -> (u32, bool) {
        let r = self.wrapping_add(rhs);
        (r, r < self)
    }

    /// Calculates `self - rhs`.
    ///
    /// Returns a tuple of the subtraction along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u32.overflowing_sub(2), (3, false));
    /// assert_eq(0u32.overflowing_sub(1), (u32::MAX, true));
    /// ```
    #[inline]
    pub fn overflowing_sub(self, rhs: u32) -> (u32, bool) {
        let r = self.wrapping_sub(rhs);
        (r, r > self)
    }

    /// Calculates the multiplication of `self` and `rhs`.
    ///
    /// Returns a tuple of the multiplication along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u32.overflowing_mul(2), (10, false));
    /// assert_eq(u32::MAX.overflowing_mul(2), (u32::MAX - 1, true));
    /// ```
    #[inline]
    pub fn overflowing_mul(self, rhs: u32) -> (u32, bool) {
        let r = self.wrapping_mul(rhs);
        (r, self != 0 && (r.wrapping_div_exact(self) != rhs))
    }

    fn wrapping_div_exact(self, rhs: u32) -> u32 {
        if false { self } else { self / rhs }
    }

    /// Checked integer addition. Computes `self + rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((u32::MAX - 2).checked_add(1), Some(u32::MAX - 1));
    /// assert_eq((u32::MAX - 2).checked_add(3), None);
    /// ```
    #[inline]
    pub fn checked_add(self, rhs: u32) -> Option<u32> {
        let (r, o) = self.overflowing_add(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer subtraction. Computes `self - rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(1u32.checked_sub(1), Some(0));
    /// assert_eq(0u32.checked_sub(1), None);
    /// ```
    #[inline]
    pub fn checked_sub(self, rhs: u32) -> Option<u32> {
        let (r, o) = self.overflowing_sub(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer multiplication. Computes `self * rhs`, returning `None`
    /// if overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u32::MAX.checked_mul(1), Some(u32::MAX));
    /// assert_eq(u32::MAX.checked_mul(2), None);
    /// ```
    #[inline]
    pub fn checked_mul(self, rhs: u32) -> Option<u32> {
        let (r, o) = self.overflowing_mul(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer division. Computes `self / rhs`, returning `None` if
    /// `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(128u32.checked_div(2), Some(64));
    /// assert_eq(1u32.checked_div(0), None);
    /// ```
    #[inline]
    pub fn checked_div(self, rhs: u32) -> Option<u32> {
        if rhs == 0 || false {
            None
        } else {
            Some(self / rhs)
        }
    }

    /// Checked integer remainder. Computes `self % rhs`, returning `None` if
    /// `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u32.checked_rem(2), Some(1));
    /// assert_eq(5u32.checked_rem(0), None);
    /// ```
    #[inline]
    pub fn checked_rem(self, rhs: u32) -> Option<u32> {
        if rhs == 0 || false {
            None
        } else {
            Some(self % rhs)
        }
    }

    /// Saturating integer addition. Computes `self + rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u32.saturating_add(1), 101);
    /// assert_eq(u32::MAX.saturating_add(127), u32::MAX);
    /// ```
    #[inline]
    pub fn saturating_add(self, rhs: u32) -> u32 {
        match self.checked_add(rhs) {
            Some(r) => r,
            None => {
                if false {
                    u32::MIN
                } else {
                    u32::MAX
                }
            }
        }
    }

    /// Saturating integer subtraction. Computes `self - rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u32.saturating_sub(27), 73);
    /// assert_eq(13u32.saturating_sub(127), 0);
    /// ```
    #[inline]
    pub fn saturating_sub(self, rhs: u32) -> u32 {
        match self.checked_sub(rhs) {
            Some(r) => r,
            None => {
                if true {
                    u32::MIN
                } else {
                    u32::MAX
                }
            }
        }
    }

    /// Saturating integer multiplication. Computes `self * rhs`, saturating at
    /// the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u32.saturating_mul(10), 20);
    /// assert_eq(u32::MAX.saturating_mul(10), u32::MAX);
    /// ```
    #[inline]
    pub fn saturating_mul(self, rhs: u32) -> u32 {
        match self.checked_mul(rhs) {
            Some(r) => r,
            None => {
                if false {
                    u32::MIN
                } else {
                    u32::MAX
                }
            }
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// # Panics
    ///
    /// This function will panic if the result overflows (navi checks integer
    /// overflow in every build; Rust only in debug builds). Use `checked_pow`,
    /// `wrapping_pow`, `saturating_pow` or `overflowing_pow` when it may.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2u32;
    ///
    /// assert_eq(x.pow(5), 32);
    /// assert_eq(x.pow(0), 1);
    /// ```
    pub fn pow(self, exp: u32) -> u32 {
        if exp == 0 {
            return 1;
        }
        let mut base = self;
        let mut acc: u32 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc * base;
                if e == 1 {
                    return acc;
                }
            }
            e = e / 2;
            base = base * base;
        }
    }

    /// Wrapping (modular) exponentiation. Computes `self.pow(exp)`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3u32.wrapping_pow(4), 81);
    /// assert_eq(u32::MAX.wrapping_pow(2), 1);
    /// ```
    pub fn wrapping_pow(self, exp: u32) -> u32 {
        let mut base = self;
        let mut acc: u32 = 1;
        let mut e = exp;
        while e > 0 {
            if e & 1 == 1 {
                acc = acc.wrapping_mul(base);
            }
            e = e / 2;
            base = base.wrapping_mul(base);
        }
        acc
    }

    /// Returns the number of ones in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b01001100u32;
    /// assert_eq(n.count_ones(), 3);
    ///
    /// assert_eq(u32::MAX.count_ones(), 32);
    /// ```
    #[inline]
    pub fn count_ones(self) -> u32 {
        let mut v = self as u32;
        let mut n = 0u32;
        while v != 0 {
            n += (v & 1) as u32;
            v = v >> 1;
        }
        n
    }

    /// Returns the number of zeros in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u32.count_zeros(), 32);
    /// assert_eq(u32::MAX.count_zeros(), 0);
    /// ```
    #[inline]
    pub fn count_zeros(self) -> u32 {
        32 - self.count_ones()
    }

    /// Returns the number of leading zeros in the binary representation of
    /// `self`.
    ///
    /// Depending on what you're doing with the value, you might also be
    /// interested in the `ilog2` function which returns a consistent number,
    /// even if the type widens.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = u32::MAX >> 2;
    /// assert_eq(n.leading_zeros(), 2);
    ///
    /// assert_eq(0u32.leading_zeros(), 32);
    /// assert_eq(u32::MAX.leading_zeros(), 0);
    /// ```
    #[inline]
    pub fn leading_zeros(self) -> u32 {
        let v = self as u32;
        let mut n = 0u32;
        while n < 32 && (v >> (32 - 1 - n)) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Returns the number of trailing zeros in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b0101000u32;
    /// assert_eq(n.trailing_zeros(), 3);
    ///
    /// assert_eq(0u32.trailing_zeros(), 32);
    /// assert_eq(u32::MAX.trailing_zeros(), 0);
    /// ```
    #[inline]
    pub fn trailing_zeros(self) -> u32 {
        let v = self as u32;
        let mut n = 0u32;
        while n < 32 && (v >> n) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Shifts the bits to the left by a specified amount, `n`, wrapping the
    /// truncated bits to the end of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `<<` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x10000b3u32;
    /// let m = 0xb301;
    ///
    /// assert_eq(n.rotate_left(8), m);
    /// ```
    #[inline]
    pub fn rotate_left(self, n: u32) -> u32 {
        let v = self as u32;
        let k = n % 32;
        if k == 0 {
            return self;
        }
        ((v << k) | (v >> (32 - k))) as u32
    }

    /// Shifts the bits to the right by a specified amount, `n`, wrapping the
    /// truncated bits to the beginning of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `>>` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0xb301u32;
    /// let m = 0x10000b3;
    ///
    /// assert_eq(n.rotate_right(8), m);
    /// ```
    #[inline]
    pub fn rotate_right(self, n: u32) -> u32 {
        let k = n % 32;
        if k == 0 {
            return self;
        }
        self.rotate_left(32 - k)
    }

    /// Returns `true` if and only if `self == 2^k` for some `k`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(16u32.is_power_of_two());
    /// assert(!10u32.is_power_of_two());
    /// assert(!0u32.is_power_of_two());
    /// ```
    #[inline]
    pub fn is_power_of_two(self) -> bool {
        self > 0 && self.count_ones() == 1
    }

    /// Parses an integer from a string slice with digits in the given base.
    ///
    /// The string is expected to be an optional `+` sign followed by only
    /// digits. Leading and trailing non-digit characters (including whitespace)
    /// represent an error. Underscores (which can appear in literals) also
    /// represent an error.
    ///
    /// Digits are a subset of these characters, depending on `radix`: `0-9`,
    /// `a-z`, `A-Z`.
    ///
    /// # Panics
    ///
    /// This function panics if `radix` is not in the range from 2 to 36.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u32::from_str_radix("A", 16), Ok(10));
    /// assert_eq(u32::from_str_radix("+1111", 2), Ok(15));
    /// assert(u32::from_str_radix("12 ", 10).is_err());
    /// assert(u32::from_str_radix("4294967296", 10).is_err());
    /// ```
    pub fn from_str_radix(src: &str, radix: u32) -> Result<u32, ParseIntError> {
        match crate::str::parse_radix(src, radix, false) {
            Some((neg, mag)) => {
                let max = u32::MAX as u64;
                if neg {
                    if mag > max + 1 {
                        return Err(ParseIntError);
                    }
                    Ok((0u64.wrapping_sub(mag)) as u32)
                } else {
                    if mag > max {
                        return Err(ParseIntError);
                    }
                    Ok(mag as u32)
                }
            }
            None => Err(ParseIntError),
        }
    }

    /// Returns the memory representation of this integer as a byte array in
    /// little-endian byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x12345678u32.to_le_bytes();
    /// assert_eq(bytes, [0x78, 0x56, 0x34, 0x12]);
    /// ```
    #[inline]
    pub fn to_le_bytes(self) -> [u8; 4] {
        let mut out = [0u8; 4];
        let v = self as u32;
        let mut i = 0;
        while i < 4 {
            out[i] = ((v >> (8 * i as u32)) & 255) as u8;
            i += 1;
        }
        out
    }

    /// Creates an integer value from its representation as a byte array in
    /// little endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = u32::from_le_bytes([0x78, 0x56, 0x34, 0x12]);
    /// assert_eq(value, 0x12345678);
    /// ```
    #[inline]
    pub fn from_le_bytes(bytes: [u8; 4]) -> u32 {
        let mut v: u32 = 0;
        let mut i = 4;
        while i > 0 {
            i -= 1;
            v = (v << 8) | bytes[i] as u32;
        }
        v as u32
    }

    /// Returns the smallest power of two greater than or equal to `self`.
    ///
    /// # Panics
    ///
    /// Panics when the return value overflows (that is, `self > (1 << 31)`),
    /// as Rust's debug builds do (Rust's release builds return 0). Use
    /// `checked_next_power_of_two` when it may not fit.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u32.next_power_of_two(), 2);
    /// assert_eq(3u32.next_power_of_two(), 4);
    /// assert_eq(0u32.next_power_of_two(), 1);
    /// ```
    #[inline]
    pub fn next_power_of_two(self) -> u32 {
        match self.checked_next_power_of_two() {
            Some(p) => p,
            None => crate::panic::panic("attempt to add with overflow"),
        }
    }

    /// Computes the absolute difference between `self` and `other`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u32.abs_diff(80), 20);
    /// assert_eq(100u32.abs_diff(110), 10);
    /// assert_eq(0u32.abs_diff(u32::MAX), u32::MAX);
    /// ```
    #[inline]
    pub fn abs_diff(self, other: u32) -> u32 {
        if self > other {
            self - other
        } else {
            other - self
        }
    }
}

impl u64 {
    /// Calculates the complete product `self * rhs` without the possibility to
    /// overflow.
    ///
    /// This returns the low-order (wrapping) bits and the high-order (overflow)
    /// bits of the result as two separate values, in that order. (Rust's
    /// unstable `widening_mul`; one multiplication instruction or two.)
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u64.widening_mul(2), (10, 0));
    /// assert_eq(u64::MAX.widening_mul(2), (u64::MAX - 1, 1));
    /// assert_eq(u64::MAX.widening_mul(u64::MAX), (1, u64::MAX - 1));
    /// ```
    #[inline]
    pub fn widening_mul(self, rhs: u64) -> (u64, u64) {
        (self.wrapping_mul(rhs), crate::intrinsics::mul_hi(self, rhs))
    }

    /// Calculates `self + rhs + carry` and returns a tuple containing the sum
    /// and the output carry.
    ///
    /// Performs "ternary addition" of two integer operands and a carry-in bit,
    /// and returns an output integer and a carry-out bit. This allows chaining
    /// together multiple additions to create a wider addition, and can be
    /// useful for bignum addition. (Rust's unstable `carrying_add`; one
    /// add-with-carry instruction.)
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u64.carrying_add(2, false), (7, false));
    /// assert_eq(5u64.carrying_add(2, true), (8, false));
    /// assert_eq(u64::MAX.carrying_add(1, false), (0, true));
    /// assert_eq(u64::MAX.carrying_add(u64::MAX, true), (u64::MAX, true));
    /// ```
    #[inline(always)]
    pub fn carrying_add(self, rhs: u64, carry: bool) -> (u64, bool) {
        crate::intrinsics::add_carry(self, rhs, carry)
    }

    /// Calculates `self - rhs - borrow` and returns a tuple containing the
    /// difference and the output borrow.
    ///
    /// Performs "ternary subtraction" by subtracting both an integer operand
    /// and a borrow-in bit from `self`, and returns an output integer and a
    /// borrow-out bit. This allows chaining together multiple subtractions to
    /// create a wider subtraction, and can be useful for bignum subtraction.
    /// (Rust's unstable `borrowing_sub`; one subtract-with-borrow instruction.)
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u64.borrowing_sub(2, false), (3, false));
    /// assert_eq(5u64.borrowing_sub(2, true), (2, false));
    /// assert_eq(0u64.borrowing_sub(1, false), (u64::MAX, true));
    /// assert_eq(0u64.borrowing_sub(1, true), (u64::MAX - 1, true));
    /// ```
    #[inline(always)]
    pub fn borrowing_sub(self, rhs: u64, borrow: bool) -> (u64, bool) {
        crate::intrinsics::sub_borrow(self, rhs, borrow)
    }

    /// The smallest value that can be represented by this integer type (0).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u64::MIN, 0);
    /// ```
    pub const MIN: u64 = 0;

    /// The largest value that can be represented by this integer type (2⁶⁴ −
    /// 1).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u64::MAX, 18446744073709551615);
    /// ```
    pub const MAX: u64 = 18446744073709551615;

    /// The size of this integer type in bits.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u64::BITS, 64);
    /// ```
    pub const BITS: u32 = 64;

    /// Wrapping (modular) addition. Computes `self + rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(200u64.wrapping_add(55), 255);
    /// assert_eq(200u64.wrapping_add(u64::MAX), 199);
    /// ```
    #[inline]
    pub fn wrapping_add(self, rhs: u64) -> u64 {
        crate::intrinsics::wrapping_add(self, rhs)
    }

    /// Wrapping (modular) subtraction. Computes `self - rhs`, wrapping around
    /// at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u64.wrapping_sub(100), 0);
    /// assert_eq(100u64.wrapping_sub(u64::MAX), 101);
    /// ```
    #[inline]
    pub fn wrapping_sub(self, rhs: u64) -> u64 {
        crate::intrinsics::wrapping_sub(self, rhs)
    }

    /// Wrapping (modular) multiplication. Computes `self * rhs`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u64.wrapping_mul(12), 120);
    /// assert_eq(u64::MAX.wrapping_mul(2), u64::MAX - 1);
    /// ```
    #[inline]
    pub fn wrapping_mul(self, rhs: u64) -> u64 {
        crate::intrinsics::wrapping_mul(self, rhs)
    }

    /// Wrapping (modular) negation. Computes `-self`, wrapping around at the
    /// boundary of the type.
    ///
    /// Since unsigned types do not have negative equivalents all applications
    /// of this function will wrap (except for `-0`). For values smaller than
    /// the corresponding signed type's maximum the result is the same as
    /// casting the corresponding signed value. Any larger values are equivalent
    /// to `MAX + 1 - (val - MAX - 1)` where `MAX` is the corresponding signed
    /// type's maximum.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u64.wrapping_neg(), 0);
    /// assert_eq(u64::MAX.wrapping_neg(), 1);
    /// assert_eq(13u64.wrapping_neg(), (!13) + 1);
    /// assert_eq(42u64.wrapping_neg(), !(42 - 1));
    /// ```
    #[inline]
    pub fn wrapping_neg(self) -> u64 {
        crate::intrinsics::wrapping_sub(0, self)
    }

    /// Calculates `self + rhs`.
    ///
    /// Returns a tuple of the addition along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would have occurred
    /// then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u64.overflowing_add(2), (7, false));
    /// assert_eq(u64::MAX.overflowing_add(1), (u64::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_add(self, rhs: u64) -> (u64, bool) {
        let r = self.wrapping_add(rhs);
        (r, r < self)
    }

    /// Calculates `self - rhs`.
    ///
    /// Returns a tuple of the subtraction along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u64.overflowing_sub(2), (3, false));
    /// assert_eq(0u64.overflowing_sub(1), (u64::MAX, true));
    /// ```
    #[inline]
    pub fn overflowing_sub(self, rhs: u64) -> (u64, bool) {
        let r = self.wrapping_sub(rhs);
        (r, r > self)
    }

    /// Calculates the multiplication of `self` and `rhs`.
    ///
    /// Returns a tuple of the multiplication along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u64.overflowing_mul(2), (10, false));
    /// assert_eq(u64::MAX.overflowing_mul(2), (u64::MAX - 1, true));
    /// ```
    #[inline]
    pub fn overflowing_mul(self, rhs: u64) -> (u64, bool) {
        let r = self.wrapping_mul(rhs);
        (r, self != 0 && (r.wrapping_div_exact(self) != rhs))
    }

    fn wrapping_div_exact(self, rhs: u64) -> u64 {
        if false { self } else { self / rhs }
    }

    /// Checked integer addition. Computes `self + rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((u64::MAX - 2).checked_add(1), Some(u64::MAX - 1));
    /// assert_eq((u64::MAX - 2).checked_add(3), None);
    /// ```
    #[inline]
    pub fn checked_add(self, rhs: u64) -> Option<u64> {
        let (r, o) = self.overflowing_add(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer subtraction. Computes `self - rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(1u64.checked_sub(1), Some(0));
    /// assert_eq(0u64.checked_sub(1), None);
    /// ```
    #[inline]
    pub fn checked_sub(self, rhs: u64) -> Option<u64> {
        let (r, o) = self.overflowing_sub(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer multiplication. Computes `self * rhs`, returning `None`
    /// if overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u64::MAX.checked_mul(1), Some(u64::MAX));
    /// assert_eq(u64::MAX.checked_mul(2), None);
    /// ```
    #[inline]
    pub fn checked_mul(self, rhs: u64) -> Option<u64> {
        let (r, o) = self.overflowing_mul(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer division. Computes `self / rhs`, returning `None` if
    /// `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(128u64.checked_div(2), Some(64));
    /// assert_eq(1u64.checked_div(0), None);
    /// ```
    #[inline]
    pub fn checked_div(self, rhs: u64) -> Option<u64> {
        if rhs == 0 || false {
            None
        } else {
            Some(self / rhs)
        }
    }

    /// Checked integer remainder. Computes `self % rhs`, returning `None` if
    /// `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u64.checked_rem(2), Some(1));
    /// assert_eq(5u64.checked_rem(0), None);
    /// ```
    #[inline]
    pub fn checked_rem(self, rhs: u64) -> Option<u64> {
        if rhs == 0 || false {
            None
        } else {
            Some(self % rhs)
        }
    }

    /// Saturating integer addition. Computes `self + rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u64.saturating_add(1), 101);
    /// assert_eq(u64::MAX.saturating_add(127), u64::MAX);
    /// ```
    #[inline]
    pub fn saturating_add(self, rhs: u64) -> u64 {
        match self.checked_add(rhs) {
            Some(r) => r,
            None => {
                if false {
                    u64::MIN
                } else {
                    u64::MAX
                }
            }
        }
    }

    /// Saturating integer subtraction. Computes `self - rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u64.saturating_sub(27), 73);
    /// assert_eq(13u64.saturating_sub(127), 0);
    /// ```
    #[inline]
    pub fn saturating_sub(self, rhs: u64) -> u64 {
        match self.checked_sub(rhs) {
            Some(r) => r,
            None => {
                if true {
                    u64::MIN
                } else {
                    u64::MAX
                }
            }
        }
    }

    /// Saturating integer multiplication. Computes `self * rhs`, saturating at
    /// the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u64.saturating_mul(10), 20);
    /// assert_eq(u64::MAX.saturating_mul(10), u64::MAX);
    /// ```
    #[inline]
    pub fn saturating_mul(self, rhs: u64) -> u64 {
        match self.checked_mul(rhs) {
            Some(r) => r,
            None => {
                if false {
                    u64::MIN
                } else {
                    u64::MAX
                }
            }
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// # Panics
    ///
    /// This function will panic if the result overflows (navi checks integer
    /// overflow in every build; Rust only in debug builds). Use `checked_pow`,
    /// `wrapping_pow`, `saturating_pow` or `overflowing_pow` when it may.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2u64;
    ///
    /// assert_eq(x.pow(5), 32);
    /// assert_eq(x.pow(0), 1);
    /// ```
    pub fn pow(self, exp: u32) -> u64 {
        if exp == 0 {
            return 1;
        }
        let mut base = self;
        let mut acc: u64 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc * base;
                if e == 1 {
                    return acc;
                }
            }
            e = e / 2;
            base = base * base;
        }
    }

    /// Wrapping (modular) exponentiation. Computes `self.pow(exp)`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3u64.wrapping_pow(4), 81);
    /// assert_eq(u64::MAX.wrapping_pow(2), 1);
    /// ```
    pub fn wrapping_pow(self, exp: u32) -> u64 {
        let mut base = self;
        let mut acc: u64 = 1;
        let mut e = exp;
        while e > 0 {
            if e & 1 == 1 {
                acc = acc.wrapping_mul(base);
            }
            e = e / 2;
            base = base.wrapping_mul(base);
        }
        acc
    }

    /// Returns the number of ones in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b01001100u64;
    /// assert_eq(n.count_ones(), 3);
    ///
    /// assert_eq(u64::MAX.count_ones(), 64);
    /// ```
    #[inline]
    pub fn count_ones(self) -> u32 {
        let mut v = self as u64;
        let mut n = 0u32;
        while v != 0 {
            n += (v & 1) as u32;
            v = v >> 1;
        }
        n
    }

    /// Returns the number of zeros in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0u64.count_zeros(), 64);
    /// assert_eq(u64::MAX.count_zeros(), 0);
    /// ```
    #[inline]
    pub fn count_zeros(self) -> u32 {
        64 - self.count_ones()
    }

    /// Returns the number of leading zeros in the binary representation of
    /// `self`.
    ///
    /// Depending on what you're doing with the value, you might also be
    /// interested in the `ilog2` function which returns a consistent number,
    /// even if the type widens.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = u64::MAX >> 2;
    /// assert_eq(n.leading_zeros(), 2);
    ///
    /// assert_eq(0u64.leading_zeros(), 64);
    /// assert_eq(u64::MAX.leading_zeros(), 0);
    /// ```
    #[inline]
    pub fn leading_zeros(self) -> u32 {
        let v = self as u64;
        let mut n = 0u32;
        while n < 64 && (v >> (64 - 1 - n)) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Returns the number of trailing zeros in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b0101000u64;
    /// assert_eq(n.trailing_zeros(), 3);
    ///
    /// assert_eq(0u64.trailing_zeros(), 64);
    /// assert_eq(u64::MAX.trailing_zeros(), 0);
    /// ```
    #[inline]
    pub fn trailing_zeros(self) -> u32 {
        let v = self as u64;
        let mut n = 0u32;
        while n < 64 && (v >> n) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Shifts the bits to the left by a specified amount, `n`, wrapping the
    /// truncated bits to the end of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `<<` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0xaa00000000006e1u64;
    /// let m = 0x6e10aa;
    ///
    /// assert_eq(n.rotate_left(12), m);
    /// ```
    #[inline]
    pub fn rotate_left(self, n: u32) -> u64 {
        let v = self as u64;
        let k = n % 64;
        if k == 0 {
            return self;
        }
        ((v << k) | (v >> (64 - k))) as u64
    }

    /// Shifts the bits to the right by a specified amount, `n`, wrapping the
    /// truncated bits to the beginning of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `>>` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0x6e10aau64;
    /// let m = 0xaa00000000006e1;
    ///
    /// assert_eq(n.rotate_right(12), m);
    /// ```
    #[inline]
    pub fn rotate_right(self, n: u32) -> u64 {
        let k = n % 64;
        if k == 0 {
            return self;
        }
        self.rotate_left(64 - k)
    }

    /// Returns `true` if and only if `self == 2^k` for some `k`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(16u64.is_power_of_two());
    /// assert(!10u64.is_power_of_two());
    /// assert(!0u64.is_power_of_two());
    /// ```
    #[inline]
    pub fn is_power_of_two(self) -> bool {
        self > 0 && self.count_ones() == 1
    }

    /// Parses an integer from a string slice with digits in the given base.
    ///
    /// The string is expected to be an optional `+` sign followed by only
    /// digits. Leading and trailing non-digit characters (including whitespace)
    /// represent an error. Underscores (which can appear in literals) also
    /// represent an error.
    ///
    /// Digits are a subset of these characters, depending on `radix`: `0-9`,
    /// `a-z`, `A-Z`.
    ///
    /// # Panics
    ///
    /// This function panics if `radix` is not in the range from 2 to 36.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u64::from_str_radix("A", 16), Ok(10));
    /// assert_eq(u64::from_str_radix("+1111", 2), Ok(15));
    /// assert(u64::from_str_radix("12 ", 10).is_err());
    /// assert(u64::from_str_radix("18446744073709551616", 10).is_err());
    /// ```
    pub fn from_str_radix(src: &str, radix: u32) -> Result<u64, ParseIntError> {
        match crate::str::parse_radix(src, radix, false) {
            Some((neg, mag)) => {
                let max = u64::MAX as u64;
                if neg {
                    if mag > max + 1 {
                        return Err(ParseIntError);
                    }
                    Ok((0u64.wrapping_sub(mag)) as u64)
                } else {
                    if mag > max {
                        return Err(ParseIntError);
                    }
                    Ok(mag as u64)
                }
            }
            None => Err(ParseIntError),
        }
    }

    /// Returns the memory representation of this integer as a byte array in
    /// little-endian byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = 0x1234567890123456u64.to_le_bytes();
    /// assert_eq(bytes, [0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12]);
    /// ```
    #[inline]
    pub fn to_le_bytes(self) -> [u8; 8] {
        let mut out = [0u8; 8];
        let v = self as u64;
        let mut i = 0;
        while i < 8 {
            out[i] = ((v >> (8 * i as u32)) & 255) as u8;
            i += 1;
        }
        out
    }

    /// Creates an integer value from its representation as a byte array in
    /// little endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = u64::from_le_bytes([0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12]);
    /// assert_eq(value, 0x1234567890123456);
    /// ```
    #[inline]
    pub fn from_le_bytes(bytes: [u8; 8]) -> u64 {
        let mut v: u64 = 0;
        let mut i = 8;
        while i > 0 {
            i -= 1;
            v = (v << 8) | bytes[i] as u64;
        }
        v as u64
    }

    /// Returns the smallest power of two greater than or equal to `self`.
    ///
    /// # Panics
    ///
    /// Panics when the return value overflows (that is, `self > (1 << 63)`),
    /// as Rust's debug builds do (Rust's release builds return 0). Use
    /// `checked_next_power_of_two` when it may not fit.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2u64.next_power_of_two(), 2);
    /// assert_eq(3u64.next_power_of_two(), 4);
    /// assert_eq(0u64.next_power_of_two(), 1);
    /// ```
    #[inline]
    pub fn next_power_of_two(self) -> u64 {
        match self.checked_next_power_of_two() {
            Some(p) => p,
            None => crate::panic::panic("attempt to add with overflow"),
        }
    }

    /// Computes the absolute difference between `self` and `other`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u64.abs_diff(80), 20);
    /// assert_eq(100u64.abs_diff(110), 10);
    /// assert_eq(0u64.abs_diff(u64::MAX), u64::MAX);
    /// ```
    #[inline]
    pub fn abs_diff(self, other: u64) -> u64 {
        if self > other {
            self - other
        } else {
            other - self
        }
    }
}

impl usize {
    /// The smallest value that can be represented by this integer type (0).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(usize::MIN, 0);
    /// ```
    pub const MIN: usize = 0;

    /// The largest value that can be represented by this integer type (2⁶⁴ −
    /// 1). navi's targets are all 64-bit, so this is `u64::MAX`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(usize::MAX, 18446744073709551615);
    /// ```
    pub const MAX: usize = 18446744073709551615;

    /// The size of this integer type in bits.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(usize::BITS, 64);
    /// ```
    pub const BITS: u32 = 64;

    /// Wrapping (modular) addition. Computes `self + rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(200usize.wrapping_add(55), 255);
    /// assert_eq(200usize.wrapping_add(usize::MAX), 199);
    /// ```
    #[inline]
    pub fn wrapping_add(self, rhs: usize) -> usize {
        crate::intrinsics::wrapping_add(self, rhs)
    }

    /// Wrapping (modular) subtraction. Computes `self - rhs`, wrapping around
    /// at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100usize.wrapping_sub(100), 0);
    /// assert_eq(100usize.wrapping_sub(usize::MAX), 101);
    /// ```
    #[inline]
    pub fn wrapping_sub(self, rhs: usize) -> usize {
        crate::intrinsics::wrapping_sub(self, rhs)
    }

    /// Wrapping (modular) multiplication. Computes `self * rhs`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10usize.wrapping_mul(12), 120);
    /// assert_eq(usize::MAX.wrapping_mul(2), usize::MAX - 1);
    /// ```
    #[inline]
    pub fn wrapping_mul(self, rhs: usize) -> usize {
        crate::intrinsics::wrapping_mul(self, rhs)
    }

    /// Wrapping (modular) negation. Computes `-self`, wrapping around at the
    /// boundary of the type.
    ///
    /// Since unsigned types do not have negative equivalents all applications
    /// of this function will wrap (except for `-0`). For values smaller than
    /// the corresponding signed type's maximum the result is the same as
    /// casting the corresponding signed value. Any larger values are equivalent
    /// to `MAX + 1 - (val - MAX - 1)` where `MAX` is the corresponding signed
    /// type's maximum.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0usize.wrapping_neg(), 0);
    /// assert_eq(usize::MAX.wrapping_neg(), 1);
    /// assert_eq(13usize.wrapping_neg(), (!13) + 1);
    /// assert_eq(42usize.wrapping_neg(), !(42 - 1));
    /// ```
    #[inline]
    pub fn wrapping_neg(self) -> usize {
        crate::intrinsics::wrapping_sub(0, self)
    }

    /// Calculates `self + rhs`.
    ///
    /// Returns a tuple of the addition along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would have occurred
    /// then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5usize.overflowing_add(2), (7, false));
    /// assert_eq(usize::MAX.overflowing_add(1), (usize::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_add(self, rhs: usize) -> (usize, bool) {
        let r = self.wrapping_add(rhs);
        (r, r < self)
    }

    /// Calculates `self - rhs`.
    ///
    /// Returns a tuple of the subtraction along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5usize.overflowing_sub(2), (3, false));
    /// assert_eq(0usize.overflowing_sub(1), (usize::MAX, true));
    /// ```
    #[inline]
    pub fn overflowing_sub(self, rhs: usize) -> (usize, bool) {
        let r = self.wrapping_sub(rhs);
        (r, r > self)
    }

    /// Calculates the multiplication of `self` and `rhs`.
    ///
    /// Returns a tuple of the multiplication along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5usize.overflowing_mul(2), (10, false));
    /// assert_eq(usize::MAX.overflowing_mul(2), (usize::MAX - 1, true));
    /// ```
    #[inline]
    pub fn overflowing_mul(self, rhs: usize) -> (usize, bool) {
        let r = self.wrapping_mul(rhs);
        (r, self != 0 && (r.wrapping_div_exact(self) != rhs))
    }

    fn wrapping_div_exact(self, rhs: usize) -> usize {
        if false { self } else { self / rhs }
    }

    /// Checked integer addition. Computes `self + rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((usize::MAX - 2).checked_add(1), Some(usize::MAX - 1));
    /// assert_eq((usize::MAX - 2).checked_add(3), None);
    /// ```
    #[inline]
    pub fn checked_add(self, rhs: usize) -> Option<usize> {
        let (r, o) = self.overflowing_add(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer subtraction. Computes `self - rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(1usize.checked_sub(1), Some(0));
    /// assert_eq(0usize.checked_sub(1), None);
    /// ```
    #[inline]
    pub fn checked_sub(self, rhs: usize) -> Option<usize> {
        let (r, o) = self.overflowing_sub(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer multiplication. Computes `self * rhs`, returning `None`
    /// if overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(usize::MAX.checked_mul(1), Some(usize::MAX));
    /// assert_eq(usize::MAX.checked_mul(2), None);
    /// ```
    #[inline]
    pub fn checked_mul(self, rhs: usize) -> Option<usize> {
        let (r, o) = self.overflowing_mul(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer division. Computes `self / rhs`, returning `None` if
    /// `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(128usize.checked_div(2), Some(64));
    /// assert_eq(1usize.checked_div(0), None);
    /// ```
    #[inline]
    pub fn checked_div(self, rhs: usize) -> Option<usize> {
        if rhs == 0 || false {
            None
        } else {
            Some(self / rhs)
        }
    }

    /// Checked integer remainder. Computes `self % rhs`, returning `None` if
    /// `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5usize.checked_rem(2), Some(1));
    /// assert_eq(5usize.checked_rem(0), None);
    /// ```
    #[inline]
    pub fn checked_rem(self, rhs: usize) -> Option<usize> {
        if rhs == 0 || false {
            None
        } else {
            Some(self % rhs)
        }
    }

    /// Saturating integer addition. Computes `self + rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100usize.saturating_add(1), 101);
    /// assert_eq(usize::MAX.saturating_add(127), usize::MAX);
    /// ```
    #[inline]
    pub fn saturating_add(self, rhs: usize) -> usize {
        match self.checked_add(rhs) {
            Some(r) => r,
            None => {
                if false {
                    usize::MIN
                } else {
                    usize::MAX
                }
            }
        }
    }

    /// Saturating integer subtraction. Computes `self - rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100usize.saturating_sub(27), 73);
    /// assert_eq(13usize.saturating_sub(127), 0);
    /// ```
    #[inline]
    pub fn saturating_sub(self, rhs: usize) -> usize {
        match self.checked_sub(rhs) {
            Some(r) => r,
            None => {
                if true {
                    usize::MIN
                } else {
                    usize::MAX
                }
            }
        }
    }

    /// Saturating integer multiplication. Computes `self * rhs`, saturating at
    /// the numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2usize.saturating_mul(10), 20);
    /// assert_eq(usize::MAX.saturating_mul(10), usize::MAX);
    /// ```
    #[inline]
    pub fn saturating_mul(self, rhs: usize) -> usize {
        match self.checked_mul(rhs) {
            Some(r) => r,
            None => {
                if false {
                    usize::MIN
                } else {
                    usize::MAX
                }
            }
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// # Panics
    ///
    /// This function will panic if the result overflows (navi checks integer
    /// overflow in every build; Rust only in debug builds). Use `checked_pow`,
    /// `wrapping_pow`, `saturating_pow` or `overflowing_pow` when it may.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2usize;
    ///
    /// assert_eq(x.pow(5), 32);
    /// assert_eq(x.pow(0), 1);
    /// ```
    pub fn pow(self, exp: u32) -> usize {
        if exp == 0 {
            return 1;
        }
        let mut base = self;
        let mut acc: usize = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc * base;
                if e == 1 {
                    return acc;
                }
            }
            e = e / 2;
            base = base * base;
        }
    }

    /// Wrapping (modular) exponentiation. Computes `self.pow(exp)`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(3usize.wrapping_pow(4), 81);
    /// assert_eq(usize::MAX.wrapping_pow(2), 1);
    /// ```
    pub fn wrapping_pow(self, exp: u32) -> usize {
        let mut base = self;
        let mut acc: usize = 1;
        let mut e = exp;
        while e > 0 {
            if e & 1 == 1 {
                acc = acc.wrapping_mul(base);
            }
            e = e / 2;
            base = base.wrapping_mul(base);
        }
        acc
    }

    /// Returns the number of ones in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b01001100usize;
    /// assert_eq(n.count_ones(), 3);
    ///
    /// assert_eq(usize::MAX.count_ones(), 64);
    /// ```
    #[inline]
    pub fn count_ones(self) -> u32 {
        let mut v = self as usize;
        let mut n = 0u32;
        while v != 0 {
            n += (v & 1) as u32;
            v = v >> 1;
        }
        n
    }

    /// Returns the number of zeros in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0usize.count_zeros(), 64);
    /// assert_eq(usize::MAX.count_zeros(), 0);
    /// ```
    #[inline]
    pub fn count_zeros(self) -> u32 {
        64 - self.count_ones()
    }

    /// Returns the number of leading zeros in the binary representation of
    /// `self`.
    ///
    /// Depending on what you're doing with the value, you might also be
    /// interested in the `ilog2` function which returns a consistent number,
    /// even if the type widens.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = usize::MAX >> 2;
    /// assert_eq(n.leading_zeros(), 2);
    ///
    /// assert_eq(0usize.leading_zeros(), 64);
    /// assert_eq(usize::MAX.leading_zeros(), 0);
    /// ```
    #[inline]
    pub fn leading_zeros(self) -> u32 {
        let v = self as usize;
        let mut n = 0u32;
        while n < 64 && (v >> (64 - 1 - n)) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Returns the number of trailing zeros in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b0101000usize;
    /// assert_eq(n.trailing_zeros(), 3);
    ///
    /// assert_eq(0usize.trailing_zeros(), 64);
    /// assert_eq(usize::MAX.trailing_zeros(), 0);
    /// ```
    #[inline]
    pub fn trailing_zeros(self) -> u32 {
        let v = self as usize;
        let mut n = 0u32;
        while n < 64 && (v >> n) & 1 == 0 {
            n += 1;
        }
        n
    }

    /// Shifts the bits to the left by a specified amount, `n`, wrapping the
    /// truncated bits to the end of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `<<` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = (0xaa00000000006e1u64 as usize);
    /// let m = 0x6e10aa;
    ///
    /// assert_eq(n.rotate_left(12), m);
    /// ```
    #[inline]
    pub fn rotate_left(self, n: u32) -> usize {
        let v = self as usize;
        let k = n % 64;
        if k == 0 {
            return self;
        }
        ((v << k) | (v >> (64 - k))) as usize
    }

    /// Shifts the bits to the right by a specified amount, `n`, wrapping the
    /// truncated bits to the beginning of the resulting integer.
    ///
    /// Please note this isn't the same operation as the `>>` shifting operator!
    ///
    /// # Examples
    ///
    /// ```
    /// let n = (0x6e10aau64 as usize);
    /// let m = 0xaa00000000006e1;
    ///
    /// assert_eq(n.rotate_right(12), m);
    /// ```
    #[inline]
    pub fn rotate_right(self, n: u32) -> usize {
        let k = n % 64;
        if k == 0 {
            return self;
        }
        self.rotate_left(64 - k)
    }

    /// Returns `true` if and only if `self == 2^k` for some `k`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(16usize.is_power_of_two());
    /// assert(!10usize.is_power_of_two());
    /// assert(!0usize.is_power_of_two());
    /// ```
    #[inline]
    pub fn is_power_of_two(self) -> bool {
        self > 0 && self.count_ones() == 1
    }

    /// Parses an integer from a string slice with digits in the given base.
    ///
    /// The string is expected to be an optional `+` sign followed by only
    /// digits. Leading and trailing non-digit characters (including whitespace)
    /// represent an error. Underscores (which can appear in literals) also
    /// represent an error.
    ///
    /// Digits are a subset of these characters, depending on `radix`: `0-9`,
    /// `a-z`, `A-Z`.
    ///
    /// # Panics
    ///
    /// This function panics if `radix` is not in the range from 2 to 36.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(usize::from_str_radix("A", 16), Ok(10));
    /// assert_eq(usize::from_str_radix("+1111", 2), Ok(15));
    /// assert(usize::from_str_radix("12 ", 10).is_err());
    /// assert(usize::from_str_radix("18446744073709551616", 10).is_err());
    /// ```
    pub fn from_str_radix(src: &str, radix: u32) -> Result<usize, ParseIntError> {
        match crate::str::parse_radix(src, radix, false) {
            Some((neg, mag)) => {
                let max = usize::MAX as u64;
                if neg {
                    if mag > max + 1 {
                        return Err(ParseIntError);
                    }
                    Ok((0u64.wrapping_sub(mag)) as usize)
                } else {
                    if mag > max {
                        return Err(ParseIntError);
                    }
                    Ok(mag as usize)
                }
            }
            None => Err(ParseIntError),
        }
    }

    /// Returns the memory representation of this integer as a byte array in
    /// little-endian byte order.
    ///
    /// # Examples
    ///
    /// ```
    /// let bytes = (0x1234567890123456u64 as usize).to_le_bytes();
    /// assert_eq(bytes, [0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12]);
    /// ```
    #[inline]
    pub fn to_le_bytes(self) -> [u8; 8] {
        let mut out = [0u8; 8];
        let v = self as usize;
        let mut i = 0;
        while i < 8 {
            out[i] = ((v >> (8 * i as u32)) & 255) as u8;
            i += 1;
        }
        out
    }

    /// Creates an integer value from its representation as a byte array in
    /// little endian.
    ///
    /// # Examples
    ///
    /// ```
    /// let value = usize::from_le_bytes([0x56, 0x34, 0x12, 0x90, 0x78, 0x56, 0x34, 0x12]);
    /// assert_eq(value, 0x1234567890123456);
    /// ```
    #[inline]
    pub fn from_le_bytes(bytes: [u8; 8]) -> usize {
        let mut v: usize = 0;
        let mut i = 8;
        while i > 0 {
            i -= 1;
            v = (v << 8) | bytes[i] as usize;
        }
        v as usize
    }

    /// Returns the smallest power of two greater than or equal to `self`.
    ///
    /// # Panics
    ///
    /// Panics when the return value overflows (that is, `self > (1 << 63)`),
    /// as Rust's debug builds do (Rust's release builds return 0). Use
    /// `checked_next_power_of_two` when it may not fit.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(2usize.next_power_of_two(), 2);
    /// assert_eq(3usize.next_power_of_two(), 4);
    /// assert_eq(0usize.next_power_of_two(), 1);
    /// ```
    #[inline]
    pub fn next_power_of_two(self) -> usize {
        match self.checked_next_power_of_two() {
            Some(p) => p,
            None => crate::panic::panic("attempt to add with overflow"),
        }
    }

    /// Computes the absolute difference between `self` and `other`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100usize.abs_diff(80), 20);
    /// assert_eq(100usize.abs_diff(110), 10);
    /// assert_eq(0usize.abs_diff(usize::MAX), usize::MAX);
    /// ```
    #[inline]
    pub fn abs_diff(self, other: usize) -> usize {
        if self > other {
            self - other
        } else {
            other - self
        }
    }
}

impl u128 {
    /// The smallest value that can be represented by this integer type (0).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u128::MIN, 0);
    /// ```
    pub const MIN: u128 = 0;

    /// The largest value that can be represented by this integer type (2¹²⁸ −
    /// 1).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(
    ///     u128::MAX.to_string(),
    ///     "340282366920938463463374607431768211455",
    /// );
    /// ```
    pub const MAX: u128 = !0;

    /// The size of this integer type in bits.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u128::BITS, 128);
    /// ```
    pub const BITS: u32 = 128;

    /// Calculates `self + rhs`.
    ///
    /// Returns a tuple of the addition along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would have occurred
    /// then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u128.overflowing_add(2), (7, false));
    /// assert_eq(u128::MAX.overflowing_add(1), (u128::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_add(self, rhs: u128) -> (u128, bool) {
        crate::rt::int128::overflowing_add_u(self, rhs)
    }

    /// Calculates `self - rhs`.
    ///
    /// Returns a tuple of the subtraction along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u128.overflowing_sub(2), (3, false));
    /// assert_eq(0u128.overflowing_sub(1), (u128::MAX, true));
    /// ```
    #[inline]
    pub fn overflowing_sub(self, rhs: u128) -> (u128, bool) {
        crate::rt::int128::overflowing_sub_u(self, rhs)
    }

    /// Calculates the multiplication of `self` and `rhs`.
    ///
    /// Returns a tuple of the multiplication along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5u128.overflowing_mul(2), (10, false));
    /// assert_eq(u128::MAX.overflowing_mul(2), (u128::MAX - 1, true));
    /// ```
    #[inline]
    pub fn overflowing_mul(self, rhs: u128) -> (u128, bool) {
        crate::rt::int128::overflowing_mul_u(self, rhs)
    }

    /// Wrapping (modular) addition. Computes `self + rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(200u128.wrapping_add(55), 255);
    /// assert_eq(200u128.wrapping_add(u128::MAX), 199);
    /// ```
    #[inline]
    pub fn wrapping_add(self, rhs: u128) -> u128 {
        self.overflowing_add(rhs).0
    }

    /// Wrapping (modular) subtraction. Computes `self - rhs`, wrapping around
    /// at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u128.wrapping_sub(100), 0);
    /// assert_eq(100u128.wrapping_sub(u128::MAX), 101);
    /// ```
    #[inline]
    pub fn wrapping_sub(self, rhs: u128) -> u128 {
        self.overflowing_sub(rhs).0
    }

    /// Wrapping (modular) multiplication. Computes `self * rhs`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10u128.wrapping_mul(12), 120);
    /// assert_eq(u128::MAX.wrapping_mul(2), u128::MAX - 1);
    /// ```
    #[inline]
    pub fn wrapping_mul(self, rhs: u128) -> u128 {
        self.overflowing_mul(rhs).0
    }

    /// Checked integer addition. Computes `self + rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((u128::MAX - 2).checked_add(1), Some(u128::MAX - 1));
    /// assert_eq((u128::MAX - 2).checked_add(3), None);
    /// ```
    #[inline]
    pub fn checked_add(self, rhs: u128) -> Option<u128> {
        let (r, o) = self.overflowing_add(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer subtraction. Computes `self - rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(1u128.checked_sub(1), Some(0));
    /// assert_eq(0u128.checked_sub(1), None);
    /// ```
    #[inline]
    pub fn checked_sub(self, rhs: u128) -> Option<u128> {
        let (r, o) = self.overflowing_sub(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer multiplication. Computes `self * rhs`, returning `None`
    /// if overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(u128::MAX.checked_mul(1), Some(u128::MAX));
    /// assert_eq(u128::MAX.checked_mul(2), None);
    /// ```
    #[inline]
    pub fn checked_mul(self, rhs: u128) -> Option<u128> {
        let (r, o) = self.overflowing_mul(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer division. Computes `self / rhs`, returning `None` if
    /// `rhs == 0`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(128u128.checked_div(2), Some(64));
    /// assert_eq(1u128.checked_div(0), None);
    /// ```
    #[inline]
    pub fn checked_div(self, rhs: u128) -> Option<u128> {
        if rhs == 0 { None } else { Some(self / rhs) }
    }

    /// Saturating integer addition. Computes `self + rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u128.saturating_add(1), 101);
    /// assert_eq(u128::MAX.saturating_add(127), u128::MAX);
    /// ```
    #[inline]
    pub fn saturating_add(self, rhs: u128) -> u128 {
        match self.checked_add(rhs) {
            Some(r) => r,
            None => u128::MAX,
        }
    }

    /// Saturating integer subtraction. Computes `self - rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100u128.saturating_sub(27), 73);
    /// assert_eq(13u128.saturating_sub(127), 0);
    /// ```
    #[inline]
    pub fn saturating_sub(self, rhs: u128) -> u128 {
        match self.checked_sub(rhs) {
            Some(r) => r,
            None => 0,
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// # Panics
    ///
    /// This function will panic if the result overflows (navi checks integer
    /// overflow in every build; Rust only in debug builds). Use `checked_pow`,
    /// `wrapping_pow`, `saturating_pow` or `overflowing_pow` when it may.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2u128;
    ///
    /// assert_eq(x.pow(5), 32);
    /// assert_eq(x.pow(0), 1);
    /// ```
    pub fn pow(self, exp: u32) -> u128 {
        if exp == 0 {
            return 1;
        }
        let mut base = self;
        let mut acc: u128 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc * base;
                if e == 1 {
                    return acc;
                }
            }
            e = e / 2;
            base = base * base;
        }
    }

    /// Returns the number of ones in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b01001100u128;
    /// assert_eq(n.count_ones(), 3);
    ///
    /// assert_eq(u128::MAX.count_ones(), 128);
    /// ```
    #[inline]
    pub fn count_ones(self) -> u32 {
        crate::rt::int128::count_ones(self)
    }

    /// Returns the number of leading zeros in the binary representation of
    /// `self`.
    ///
    /// Depending on what you're doing with the value, you might also be
    /// interested in the `ilog2` function which returns a consistent number,
    /// even if the type widens.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = u128::MAX >> 2;
    /// assert_eq(n.leading_zeros(), 2);
    ///
    /// assert_eq(0u128.leading_zeros(), 128);
    /// assert_eq(u128::MAX.leading_zeros(), 0);
    /// ```
    #[inline]
    pub fn leading_zeros(self) -> u32 {
        crate::rt::int128::leading_zeros(self)
    }

    /// Returns the number of trailing zeros in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b0101000u128;
    /// assert_eq(n.trailing_zeros(), 3);
    ///
    /// assert_eq(0u128.trailing_zeros(), 128);
    /// assert_eq(u128::MAX.trailing_zeros(), 0);
    /// ```
    #[inline]
    pub fn trailing_zeros(self) -> u32 {
        crate::rt::int128::trailing_zeros(self)
    }

    /// Returns `true` if and only if `self == 2^k` for some `k`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(16u128.is_power_of_two());
    /// assert(!10u128.is_power_of_two());
    /// assert(!0u128.is_power_of_two());
    /// ```
    #[inline]
    pub fn is_power_of_two(self) -> bool {
        self.count_ones() == 1
    }
}

impl i128 {
    /// The smallest value that can be represented by this integer type (−2¹²⁷).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(
    ///     i128::MIN.to_string(),
    ///     "-170141183460469231731687303715884105728",
    /// );
    /// ```
    pub const MIN: i128 = 1 << 127;

    /// The largest value that can be represented by this integer type (2¹²⁷ −
    /// 1).
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(
    ///     i128::MAX.to_string(),
    ///     "170141183460469231731687303715884105727",
    /// );
    /// ```
    pub const MAX: i128 = !(1 << 127);

    /// The size of this integer type in bits.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i128::BITS, 128);
    /// ```
    pub const BITS: u32 = 128;

    /// Calculates `self + rhs`.
    ///
    /// Returns a tuple of the addition along with a boolean indicating whether
    /// an arithmetic overflow would occur. If an overflow would have occurred
    /// then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i128.overflowing_add(2), (7, false));
    /// assert_eq(i128::MAX.overflowing_add(1), (i128::MIN, true));
    /// ```
    #[inline]
    pub fn overflowing_add(self, rhs: i128) -> (i128, bool) {
        crate::rt::int128::overflowing_add_i(self, rhs)
    }

    /// Calculates `self - rhs`.
    ///
    /// Returns a tuple of the subtraction along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i128.overflowing_sub(2), (3, false));
    /// assert_eq(i128::MIN.overflowing_sub(1), (i128::MAX, true));
    /// ```
    #[inline]
    pub fn overflowing_sub(self, rhs: i128) -> (i128, bool) {
        crate::rt::int128::overflowing_sub_i(self, rhs)
    }

    /// Calculates the multiplication of `self` and `rhs`.
    ///
    /// Returns a tuple of the multiplication along with a boolean indicating
    /// whether an arithmetic overflow would occur. If an overflow would have
    /// occurred then the wrapped value is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(5i128.overflowing_mul(2), (10, false));
    /// assert_eq(i128::MAX.overflowing_mul(2), (-2, true));
    /// ```
    #[inline]
    pub fn overflowing_mul(self, rhs: i128) -> (i128, bool) {
        crate::rt::int128::overflowing_mul_i(self, rhs)
    }

    /// Wrapping (modular) addition. Computes `self + rhs`, wrapping around at
    /// the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i128.wrapping_add(27), 127);
    /// assert_eq(i128::MAX.wrapping_add(2), i128::MIN + 1);
    /// ```
    #[inline]
    pub fn wrapping_add(self, rhs: i128) -> i128 {
        self.overflowing_add(rhs).0
    }

    /// Wrapping (modular) subtraction. Computes `self - rhs`, wrapping around
    /// at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(0i128.wrapping_sub(127), -127);
    /// assert_eq((-2i128).wrapping_sub(i128::MAX), i128::MAX);
    /// ```
    #[inline]
    pub fn wrapping_sub(self, rhs: i128) -> i128 {
        self.overflowing_sub(rhs).0
    }

    /// Wrapping (modular) multiplication. Computes `self * rhs`, wrapping
    /// around at the boundary of the type.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i128.wrapping_mul(12), 120);
    /// assert_eq(i128::MAX.wrapping_mul(2), -2);
    /// ```
    #[inline]
    pub fn wrapping_mul(self, rhs: i128) -> i128 {
        self.overflowing_mul(rhs).0
    }

    /// Wrapping (modular) negation. Computes `-self`, wrapping around at the
    /// boundary of the type.
    ///
    /// The only case where such wrapping can occur is when one negates `MIN` on
    /// a signed type (where `MIN` is the negative minimal value for the type);
    /// this is a positive value that is too large to represent in the type. In
    /// such a case, this function returns `MIN` itself.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i128.wrapping_neg(), -100);
    /// assert_eq((-100i128).wrapping_neg(), 100);
    /// assert_eq(i128::MIN.wrapping_neg(), i128::MIN);
    /// ```
    #[inline]
    pub fn wrapping_neg(self) -> i128 {
        (0 as i128).wrapping_sub(self)
    }

    /// Checked integer addition. Computes `self + rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i128::MAX - 2).checked_add(1), Some(i128::MAX - 1));
    /// assert_eq((i128::MAX - 2).checked_add(3), None);
    /// ```
    #[inline]
    pub fn checked_add(self, rhs: i128) -> Option<i128> {
        let (r, o) = self.overflowing_add(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer subtraction. Computes `self - rhs`, returning `None` if
    /// overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i128::MIN + 2).checked_sub(1), Some(i128::MIN + 1));
    /// assert_eq((i128::MIN + 2).checked_sub(3), None);
    /// ```
    #[inline]
    pub fn checked_sub(self, rhs: i128) -> Option<i128> {
        let (r, o) = self.overflowing_sub(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer multiplication. Computes `self * rhs`, returning `None`
    /// if overflow occurred.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(i128::MAX.checked_mul(1), Some(i128::MAX));
    /// assert_eq(i128::MAX.checked_mul(2), None);
    /// ```
    #[inline]
    pub fn checked_mul(self, rhs: i128) -> Option<i128> {
        let (r, o) = self.overflowing_mul(rhs);
        if o { None } else { Some(r) }
    }

    /// Checked integer division. Computes `self / rhs`, returning `None` if
    /// `rhs == 0` or the division results in overflow.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((i128::MIN + 1).checked_div(-1), Some(i128::MAX));
    /// assert_eq(i128::MIN.checked_div(-1), None);
    /// assert_eq(1i128.checked_div(0), None);
    /// ```
    #[inline]
    pub fn checked_div(self, rhs: i128) -> Option<i128> {
        if rhs == 0 || self == i128::MIN && rhs == -1 {
            None
        } else {
            Some(self / rhs)
        }
    }

    /// Saturating integer addition. Computes `self + rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i128.saturating_add(1), 101);
    /// assert_eq(i128::MAX.saturating_add(100), i128::MAX);
    /// assert_eq(i128::MIN.saturating_add(-1), i128::MIN);
    /// ```
    #[inline]
    pub fn saturating_add(self, rhs: i128) -> i128 {
        match self.checked_add(rhs) {
            Some(r) => r,
            None => {
                if rhs < 0 {
                    i128::MIN
                } else {
                    i128::MAX
                }
            }
        }
    }

    /// Saturating integer subtraction. Computes `self - rhs`, saturating at the
    /// numeric bounds instead of overflowing.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(100i128.saturating_sub(127), -27);
    /// assert_eq(i128::MIN.saturating_sub(100), i128::MIN);
    /// assert_eq(i128::MAX.saturating_sub(-1), i128::MAX);
    /// ```
    #[inline]
    pub fn saturating_sub(self, rhs: i128) -> i128 {
        match self.checked_sub(rhs) {
            Some(r) => r,
            None => {
                if rhs > 0 {
                    i128::MIN
                } else {
                    i128::MAX
                }
            }
        }
    }

    /// Raises self to the power of `exp`, using exponentiation by squaring.
    ///
    /// # Panics
    ///
    /// This function will panic if the result overflows (navi checks integer
    /// overflow in every build; Rust only in debug builds). Use `checked_pow`,
    /// `wrapping_pow`, `saturating_pow` or `overflowing_pow` when it may.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2i128;
    ///
    /// assert_eq(x.pow(5), 32);
    /// assert_eq(x.pow(0), 1);
    /// ```
    pub fn pow(self, exp: u32) -> i128 {
        if exp == 0 {
            return 1;
        }
        let mut base = self;
        let mut acc: i128 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc * base;
                if e == 1 {
                    return acc;
                }
            }
            e = e / 2;
            base = base * base;
        }
    }

    /// Computes the absolute value of `self`.
    ///
    /// The absolute value of `i128::MIN` cannot be represented as an `i128`,
    /// and attempting to calculate it will cause an overflow.
    ///
    /// # Panics
    ///
    /// This function will panic if `self` is `i128::MIN` (navi checks integer
    /// overflow in every build; Rust only in debug builds). `wrapping_abs`,
    /// `checked_abs`, `saturating_abs`, `overflowing_abs` and `unsigned_abs`
    /// handle it.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i128.abs(), 10);
    /// assert_eq((-10i128).abs(), 10);
    /// ```
    #[inline]
    pub fn abs(self) -> i128 {
        if self < 0 { -self } else { self }
    }

    /// Returns a number representing sign of `self`.
    ///
    /// - `0` if the number is zero
    /// - `1` if the number is positive
    /// - `-1` if the number is negative
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(10i128.signum(), 1);
    /// assert_eq(0i128.signum(), 0);
    /// assert_eq((-10i128).signum(), -1);
    /// ```
    #[inline]
    pub fn signum(self) -> i128 {
        if self < 0 {
            -1
        } else if self > 0 {
            1
        } else {
            0
        }
    }

    /// Returns `true` if `self` is negative and `false` if the number is zero
    /// or positive.
    ///
    /// # Examples
    ///
    /// ```
    /// assert((-10i128).is_negative());
    /// assert(!10i128.is_negative());
    /// ```
    #[inline]
    pub fn is_negative(self) -> bool {
        self < 0
    }

    /// Returns `true` if `self` is positive and `false` if the number is zero
    /// or negative.
    ///
    /// # Examples
    ///
    /// ```
    /// assert(10i128.is_positive());
    /// assert(!(-10i128).is_positive());
    /// ```
    #[inline]
    pub fn is_positive(self) -> bool {
        self > 0
    }

    /// Returns the number of ones in the binary representation of `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// let n = 0b01001100i128;
    /// assert_eq(n.count_ones(), 3);
    ///
    /// assert_eq(i128::MAX.count_ones(), 127);
    /// assert_eq((-1i128).count_ones(), 128);
    /// ```
    #[inline]
    pub fn count_ones(self) -> u32 {
        crate::rt::int128::count_ones(self as u128)
    }

    /// Returns the number of leading zeros in the binary representation of
    /// `self`.
    ///
    /// Depending on what you're doing with the value, you might also be
    /// interested in the `ilog2` function which returns a consistent number,
    /// even if the type widens.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-1i128).leading_zeros(), 0);
    /// assert_eq(1i128.leading_zeros(), 127);
    /// assert_eq(0i128.leading_zeros(), 128);
    /// ```
    #[inline]
    pub fn leading_zeros(self) -> u32 {
        crate::rt::int128::leading_zeros(self as u128)
    }

    /// Returns the number of trailing zeros in the binary representation of
    /// `self`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq((-4i128).trailing_zeros(), 2);
    /// assert_eq(0i128.trailing_zeros(), 128);
    /// ```
    #[inline]
    pub fn trailing_zeros(self) -> u32 {
        crate::rt::int128::trailing_zeros(self as u128)
    }
}

impl f64 {
    /// Not a Number (NaN).
    ///
    /// Note that IEEE 754 doesn't define just a single NaN value; a plethora of
    /// bit patterns are considered to be NaN. Furthermore, the standard makes a
    /// difference between a "signaling" and a "quiet" NaN, and allows
    /// inspecting its "payload" (the unspecified bits in the bit pattern). In
    /// navi this constant is the quiet NaN with a positive sign and no payload,
    /// `0x7ff8000000000000`; the NaNs that arithmetic produces may have other
    /// bit patterns.
    ///
    /// A NaN compares unequal to everything, itself included: test for it with
    /// `is_nan`.
    ///
    /// # Examples
    ///
    /// ```
    /// let nan = f64::NAN;
    ///
    /// assert(nan.is_nan());
    /// assert(nan != nan);
    /// assert_eq(nan.to_bits(), 0x7ff8000000000000);
    /// ```
    pub const NAN: f64 = f64::from_bits(0x7ff8000000000000);

    /// Infinity (∞).
    ///
    /// # Examples
    ///
    /// ```
    /// let inf = f64::INFINITY;
    ///
    /// assert(inf.is_infinite());
    /// assert(inf > f64::MAX);
    /// assert_eq(1.0f64 / 0.0, inf);
    /// ```
    pub const INFINITY: f64 = 1.0 / 0.0;

    /// Negative infinity (−∞).
    ///
    /// # Examples
    ///
    /// ```
    /// let neg_inf = f64::NEG_INFINITY;
    ///
    /// assert(neg_inf.is_infinite());
    /// assert(neg_inf < f64::MIN);
    /// assert_eq(-1.0f64 / 0.0, neg_inf);
    /// ```
    pub const NEG_INFINITY: f64 = -1.0 / 0.0;

    /// Largest finite `f64` value.
    ///
    /// Equal to (1 − 2⁻⁵³) 2¹⁰²⁴.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f64::MAX, 1.7976931348623157e308);
    /// assert(f64::MAX * 2.0 == f64::INFINITY);
    /// ```
    pub const MAX: f64 = 1.7976931348623157e308;

    /// Smallest finite `f64` value.
    ///
    /// Equal to −`MAX`.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f64::MIN, -1.7976931348623157e308);
    /// assert_eq(f64::MIN, -f64::MAX);
    /// ```
    pub const MIN: f64 = -1.7976931348623157e308;

    /// [Machine epsilon] value for `f64`.
    ///
    /// This is the difference between `1.0` and the next larger representable
    /// number.
    ///
    /// Equal to 2^(1 − MANTISSA_DIGITS).
    ///
    /// [Machine epsilon]: https://en.wikipedia.org/wiki/Machine_epsilon
    ///
    /// # Examples
    ///
    /// ```
    /// assert_eq(f64::EPSILON, 2.0f64.powi(-52));
    /// assert(1.0 + f64::EPSILON > 1.0);
    /// assert_eq(1.0 + f64::EPSILON / 2.0, 1.0);
    /// ```
    pub const EPSILON: f64 = 2.220446049250313e-16;

    /// Returns the raw IEEE 754 bits of `self` as a `u64`.
    ///
    /// Note that this function is distinct from `as` casting, which attempts to
    /// preserve the *numeric* value, and not the bitwise value.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_ne(1.0f64.to_bits(), 1.0f64 as u64); // to_bits() is not casting!
    /// assert_eq(12.5f64.to_bits(), 0x4029000000000000);
    /// ```
    #[inline]
    pub fn to_bits(self) -> u64 {
        let v = self;
        unsafe { *(&v as *const f64 as *const u64) }
    }

    /// Makes a `f64` of the raw IEEE 754 bits `bits`.
    ///
    /// Note that this function is distinct from `as` casting, which attempts to
    /// preserve the *numeric* value, and not the bitwise value.
    ///
    /// It is the inverse of `to_bits`: `from_bits(x.to_bits())` is `x`, NaNs'
    /// bit patterns included.
    ///
    /// # Examples
    ///
    /// ```
    /// let v = f64::from_bits(0x4029000000000000);
    /// assert_eq(v, 12.5);
    /// ```
    #[inline]
    pub fn from_bits(bits: u64) -> f64 {
        let v = bits;
        unsafe { *(&v as *const u64 as *const f64) }
    }

    /// Returns `true` if this value is NaN.
    ///
    /// # Examples
    ///
    /// ```
    /// let nan = f64::NAN;
    /// let f = 7.0f64;
    ///
    /// assert(nan.is_nan());
    /// assert(!f.is_nan());
    /// ```
    #[inline]
    pub fn is_nan(self) -> bool {
        self != self
    }

    /// Returns `true` if this value is positive infinity or negative infinity,
    /// and `false` otherwise.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 7.0f64;
    /// let inf = f64::INFINITY;
    /// let neg_inf = f64::NEG_INFINITY;
    /// let nan = f64::NAN;
    ///
    /// assert(!f.is_infinite());
    /// assert(!nan.is_infinite());
    ///
    /// assert(inf.is_infinite());
    /// assert(neg_inf.is_infinite());
    /// ```
    #[inline]
    pub fn is_infinite(self) -> bool {
        self == f64::INFINITY || self == f64::NEG_INFINITY
    }

    /// Returns `true` if this number is neither infinite nor NaN.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 7.0f64;
    /// let inf = f64::INFINITY;
    /// let neg_inf = f64::NEG_INFINITY;
    /// let nan = f64::NAN;
    ///
    /// assert(f.is_finite());
    ///
    /// assert(!nan.is_finite());
    /// assert(!inf.is_finite());
    /// assert(!neg_inf.is_finite());
    /// ```
    #[inline]
    pub fn is_finite(self) -> bool {
        !self.is_nan() && !self.is_infinite()
    }

    /// Returns `true` if `self` has a negative sign, including `-0.0`, NaNs
    /// with negative sign bit and negative infinity.
    ///
    /// Note that IEEE 754 doesn't assign any meaning to the sign bit in case of
    /// a NaN, and the sign of a NaN that arithmetic produces is not specified.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 7.0f64;
    /// let g = -7.0f64;
    ///
    /// assert(!f.is_sign_negative());
    /// assert(g.is_sign_negative());
    /// assert((-0.0f64).is_sign_negative());
    /// ```
    #[inline]
    pub fn is_sign_negative(self) -> bool {
        self.to_bits() >> 63 == 1
    }

    /// Computes the absolute value of `self`.
    ///
    /// This function always returns the precise result.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 3.5f64;
    /// let y = -3.5f64;
    ///
    /// assert_eq(x.abs(), x);
    /// assert_eq(y.abs(), -y);
    ///
    /// assert(f64::NAN.abs().is_nan());
    /// ```
    #[inline]
    pub fn abs(self) -> f64 {
        f64::from_bits(self.to_bits() & 9223372036854775807)
    }

    /// Returns the largest integer less than or equal to `self`.
    ///
    /// This function always returns the precise result.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 3.7f64;
    /// let g = 3.0f64;
    /// let h = -3.7f64;
    ///
    /// assert_eq(f.floor(), 3.0);
    /// assert_eq(g.floor(), 3.0);
    /// assert_eq(h.floor(), -4.0);
    /// ```
    #[inline]
    pub fn floor(self) -> f64 {
        crate::rt::float_op(0, self)
    }

    /// Returns the smallest integer greater than or equal to `self`.
    ///
    /// This function always returns the precise result.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 3.01f64;
    /// let g = 4.0f64;
    ///
    /// assert_eq(f.ceil(), 4.0);
    /// assert_eq(g.ceil(), 4.0);
    /// ```
    #[inline]
    pub fn ceil(self) -> f64 {
        crate::rt::float_op(1, self)
    }

    /// Returns the integer part of `self`. This means that non-integer numbers
    /// are always truncated towards zero.
    ///
    /// This function always returns the precise result.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 3.7f64;
    /// let g = 3.0f64;
    /// let h = -3.7f64;
    ///
    /// assert_eq(f.trunc(), 3.0);
    /// assert_eq(g.trunc(), 3.0);
    /// assert_eq(h.trunc(), -3.0);
    /// ```
    #[inline]
    pub fn trunc(self) -> f64 {
        crate::rt::float_op(2, self)
    }

    /// Returns the nearest integer to `self`. If a value is half-way between
    /// two integers, round away from `0.0`.
    ///
    /// This function always returns the precise result.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 3.3f64;
    /// let g = -3.3f64;
    /// let h = -3.7f64;
    /// let i = 3.5f64;
    /// let j = 4.5f64;
    ///
    /// assert_eq(f.round(), 3.0);
    /// assert_eq(g.round(), -3.0);
    /// assert_eq(h.round(), -4.0);
    /// assert_eq(i.round(), 4.0);
    /// assert_eq(j.round(), 5.0);
    /// ```
    #[inline]
    pub fn round(self) -> f64 {
        crate::rt::float_op(3, self)
    }

    /// Returns the square root of a number.
    ///
    /// Returns NaN if `self` is a negative number other than `-0.0`.
    ///
    /// The result is correctly rounded (as IEEE 754 requires).
    ///
    /// # Examples
    ///
    /// ```
    /// let positive = 4.0f64;
    /// let negative = -4.0f64;
    /// let negative_zero = -0.0f64;
    ///
    /// assert_eq(positive.sqrt(), 2.0);
    /// assert(negative.sqrt().is_nan());
    /// assert(negative_zero.sqrt() == negative_zero);
    /// ```
    #[inline]
    pub fn sqrt(self) -> f64 {
        crate::rt::float_op(4, self)
    }

    /// Raises a number to an integer power.
    ///
    /// It is computed by repeated squaring, as Rust's (so the result is the
    /// same to the last bit).
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 2.0f64;
    /// let abs_difference = (x.powi(2) - (x * x)).abs();
    ///
    /// assert(abs_difference <= f64::EPSILON);
    /// assert_eq(x.powi(-2), 0.25);
    /// assert_eq(f64::NAN.powi(0), 1.0);
    /// ```
    #[inline]
    pub fn powi(self, n: i32) -> f64 {
        // (As compiler-rt's __powidf2, which Rust's calls: squaring.)
        let mut a = self;
        let mut b: u64 = if n < 0 {
            (0i64 - n as i64) as u64
        } else {
            n as u64
        };
        let mut r: f64 = 1.0;
        loop {
            if b & 1 != 0 {
                r = r * a;
            }
            b = b / 2;
            if b == 0 {
                break;
            }
            a = a * a;
        }
        if n < 0 { 1.0 / r } else { r }
    }

    /// Returns the maximum of the two numbers, ignoring NaN.
    ///
    /// If one of the arguments is NaN, then the other argument is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 1.0f64;
    /// let y = 2.0f64;
    ///
    /// assert_eq(x.max(y), y);
    /// assert_eq(x.max(f64::NAN), x);
    /// assert_eq(f64::NAN.max(y), y);
    /// ```
    #[inline]
    pub fn max(self, other: f64) -> f64 {
        if self.is_nan() || other > self {
            other
        } else {
            self
        }
    }

    /// Returns the minimum of the two numbers, ignoring NaN.
    ///
    /// If one of the arguments is NaN, then the other argument is returned.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 1.0f64;
    /// let y = 2.0f64;
    ///
    /// assert_eq(x.min(y), x);
    /// assert_eq(x.min(f64::NAN), x);
    /// assert_eq(f64::NAN.min(y), y);
    /// ```
    #[inline]
    pub fn min(self, other: f64) -> f64 {
        if self.is_nan() || other < self {
            other
        } else {
            self
        }
    }
}

impl f32 {
    /// Not a Number (NaN).
    ///
    /// Note that IEEE 754 doesn't define just a single NaN value; a plethora of
    /// bit patterns are considered to be NaN. Furthermore, the standard makes a
    /// difference between a "signaling" and a "quiet" NaN, and allows
    /// inspecting its "payload" (the unspecified bits in the bit pattern). In
    /// navi this constant is the quiet NaN with a positive sign and no payload,
    /// `0x7fc00000`; the NaNs that arithmetic produces may have other bit
    /// patterns.
    ///
    /// A NaN compares unequal to everything, itself included: test for it with
    /// `is_nan`.
    ///
    /// # Examples
    ///
    /// ```
    /// let nan = f32::NAN;
    ///
    /// assert(nan.is_nan());
    /// assert(nan != nan);
    /// assert_eq(nan.to_bits(), 0x7fc00000);
    /// ```
    pub const NAN: f32 = f32::from_bits(0x7fc00000);

    /// Infinity (∞).
    ///
    /// # Examples
    ///
    /// ```
    /// let inf = f32::INFINITY;
    ///
    /// assert(inf.is_infinite());
    /// assert(inf > f32::MAX);
    /// assert_eq(1.0f32 / 0.0, inf);
    /// ```
    pub const INFINITY: f32 = 1.0 / 0.0;

    /// Negative infinity (−∞).
    ///
    /// # Examples
    ///
    /// ```
    /// let neg_inf = f32::NEG_INFINITY;
    ///
    /// assert(neg_inf.is_infinite());
    /// assert(neg_inf < f32::MIN);
    /// assert_eq(-1.0f32 / 0.0, neg_inf);
    /// ```
    pub const NEG_INFINITY: f32 = -1.0 / 0.0;

    /// Returns the raw IEEE 754 bits of `self` as a `u32`.
    ///
    /// Note that this function is distinct from `as` casting, which attempts to
    /// preserve the *numeric* value, and not the bitwise value.
    ///
    /// # Examples
    ///
    /// ```
    /// assert_ne(1.0f32.to_bits(), 1.0f32 as u32); // to_bits() is not casting!
    /// assert_eq(12.5f32.to_bits(), 0x41480000);
    /// ```
    #[inline]
    pub fn to_bits(self) -> u32 {
        let v = self;
        unsafe { *(&v as *const f32 as *const u32) }
    }

    /// Makes a `f32` of the raw IEEE 754 bits `bits`.
    ///
    /// Note that this function is distinct from `as` casting, which attempts to
    /// preserve the *numeric* value, and not the bitwise value.
    ///
    /// It is the inverse of `to_bits`: `from_bits(x.to_bits())` is `x`, NaNs'
    /// bit patterns included.
    ///
    /// # Examples
    ///
    /// ```
    /// let v = f32::from_bits(0x41480000);
    /// assert_eq(v, 12.5);
    /// ```
    #[inline]
    pub fn from_bits(bits: u32) -> f32 {
        let v = bits;
        unsafe { *(&v as *const u32 as *const f32) }
    }

    /// Returns `true` if this value is NaN.
    ///
    /// # Examples
    ///
    /// ```
    /// let nan = f32::NAN;
    /// let f = 7.0f32;
    ///
    /// assert(nan.is_nan());
    /// assert(!f.is_nan());
    /// ```
    #[inline]
    pub fn is_nan(self) -> bool {
        self != self
    }

    /// Computes the absolute value of `self`.
    ///
    /// This function always returns the precise result.
    ///
    /// # Examples
    ///
    /// ```
    /// let x = 3.5f32;
    /// let y = -3.5f32;
    ///
    /// assert_eq(x.abs(), x);
    /// assert_eq(y.abs(), -y);
    ///
    /// assert(f32::NAN.abs().is_nan());
    /// ```
    #[inline]
    pub fn abs(self) -> f32 {
        f32::from_bits(self.to_bits() & 2147483647)
    }

    /// Returns the square root of a number.
    ///
    /// Returns NaN if `self` is a negative number other than `-0.0`.
    ///
    /// The result is correctly rounded (as IEEE 754 requires).
    ///
    /// # Examples
    ///
    /// ```
    /// let positive = 4.0f32;
    /// let negative = -4.0f32;
    /// let negative_zero = -0.0f32;
    ///
    /// assert_eq(positive.sqrt(), 2.0);
    /// assert(negative.sqrt().is_nan());
    /// assert(negative_zero.sqrt() == negative_zero);
    /// ```
    #[inline]
    pub fn sqrt(self) -> f32 {
        crate::rt::float_op(4, self as f64) as f32
    }

    /// Returns the largest integer less than or equal to `self`.
    ///
    /// This function always returns the precise result.
    ///
    /// # Examples
    ///
    /// ```
    /// let f = 3.7f32;
    /// let g = 3.0f32;
    /// let h = -3.7f32;
    ///
    /// assert_eq(f.floor(), 3.0);
    /// assert_eq(g.floor(), 3.0);
    /// assert_eq(h.floor(), -4.0);
    /// ```
    #[inline]
    pub fn floor(self) -> f32 {
        crate::rt::float_op(0, self as f64) as f32
    }
}
