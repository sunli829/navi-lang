        let mut i = 4;
        while i > 0 { i -= 1; v = (v << 8) | bytes[i] as u32; }
        v as u32
    }
    pub fn next_power_of_two(self) -> u32 {
        let mut p: u32 = 1;
        while p < self { p = p << 1; }
        p
    }
    pub fn abs_diff(self, other: u32) -> u32 { if self > other { self - other } else { other - self } }
}

impl u64 {
    pub const MIN: u64 = 0;
    pub const MAX: u64 = 18446744073709551615;
    pub const BITS: u32 = 64;

    pub fn wrapping_add(self, rhs: u64) -> u64 { crate::intrinsics::wrapping_add(self, rhs) }
    pub fn wrapping_sub(self, rhs: u64) -> u64 { crate::intrinsics::wrapping_sub(self, rhs) }
    pub fn wrapping_mul(self, rhs: u64) -> u64 { crate::intrinsics::wrapping_mul(self, rhs) }
    pub fn wrapping_neg(self) -> u64 { crate::intrinsics::wrapping_sub(0, self) }
    pub fn overflowing_add(self, rhs: u64) -> (u64, bool) { let r = self.wrapping_add(rhs); (r, r < self) }
    pub fn overflowing_sub(self, rhs: u64) -> (u64, bool) { let r = self.wrapping_sub(rhs); (r, r > self) }
    pub fn overflowing_mul(self, rhs: u64) -> (u64, bool) {
        let r = self.wrapping_mul(rhs);
        (r, self != 0 && (r.wrapping_div_exact(self) != rhs))
    }
    fn wrapping_div_exact(self, rhs: u64) -> u64 { if false { self } else { self / rhs } }
    pub fn checked_add(self, rhs: u64) -> Option<u64> { let (r, o) = self.overflowing_add(rhs); if o { None } else { Some(r) } }
    pub fn checked_sub(self, rhs: u64) -> Option<u64> { let (r, o) = self.overflowing_sub(rhs); if o { None } else { Some(r) } }
    pub fn checked_mul(self, rhs: u64) -> Option<u64> { let (r, o) = self.overflowing_mul(rhs); if o { None } else { Some(r) } }
    pub fn checked_div(self, rhs: u64) -> Option<u64> { if rhs == 0 || false { None } else { Some(self / rhs) } }
    pub fn checked_rem(self, rhs: u64) -> Option<u64> { if rhs == 0 || false { None } else { Some(self % rhs) } }
    pub fn saturating_add(self, rhs: u64) -> u64 {
        match self.checked_add(rhs) { Some(r) => r, None => if false { u64::MIN } else { u64::MAX } }
    }
    pub fn saturating_sub(self, rhs: u64) -> u64 {
        match self.checked_sub(rhs) { Some(r) => r, None => if true { u64::MIN } else { u64::MAX } }
    }
    pub fn saturating_mul(self, rhs: u64) -> u64 {
        match self.checked_mul(rhs) { Some(r) => r, None => if false { u64::MIN } else { u64::MAX } }
    }
    pub fn pow(self, exp: u32) -> u64 {
        if exp == 0 { return 1; }
        let mut base = self;
        let mut acc: u64 = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc * base;
                if e == 1 { return acc; }
            }
            e = e / 2;
            base = base * base;
        }
    }
    pub fn wrapping_pow(self, exp: u32) -> u64 {
        let mut base = self;
        let mut acc: u64 = 1;
        let mut e = exp;
        while e > 0 {
            if e & 1 == 1 { acc = acc.wrapping_mul(base); }
            e = e / 2;
            base = base.wrapping_mul(base);
        }
        acc
    }
    pub fn count_ones(self) -> u32 {
        let mut v = self as u64;
        let mut n = 0u32;
        while v != 0 { n += (v & 1) as u32; v = v >> 1; }
        n
    }
    pub fn count_zeros(self) -> u32 { 64 - self.count_ones() }
    pub fn leading_zeros(self) -> u32 {
        let v = self as u64;
        let mut n = 0u32;
        while n < 64 && (v >> (64 - 1 - n)) & 1 == 0 { n += 1; }
        n
    }
    pub fn trailing_zeros(self) -> u32 {
        let v = self as u64;
        let mut n = 0u32;
        while n < 64 && (v >> n) & 1 == 0 { n += 1; }
        n
    }
    pub fn rotate_left(self, n: u32) -> u64 {
        let v = self as u64;
        let k = n % 64;
        if k == 0 { return self; }
        ((v << k) | (v >> (64 - k))) as u64
    }
    pub fn rotate_right(self, n: u32) -> u64 {
        let k = n % 64;
        if k == 0 { return self; }
        self.rotate_left(64 - k)
    }
    pub fn is_power_of_two(self) -> bool { self > 0 && self.count_ones() == 1 }
    pub fn from_str_radix(src: &str, radix: u32) -> Result<u64, ParseIntError> {
        match crate::str::parse_radix(src, radix, false) {
            Some((neg, mag)) => {
                let max = u64::MAX as u64;
                if neg {
                    if mag > max + 1 { return Err(ParseIntError); }
                    Ok((0u64.wrapping_sub(mag)) as u64)
                } else {
                    if mag > max { return Err(ParseIntError); }
                    Ok(mag as u64)
                }
            }
            None => Err(ParseIntError),
        }
    }
    pub fn to_le_bytes(self) -> [u8; 8] {
        let mut out = [0u8; 8];
        let v = self as u64;
        let mut i = 0;
        while i < 8 { out[i] = ((v >> (8 * i as u32)) & 255) as u8; i += 1; }
        out
    }
    pub fn from_le_bytes(bytes: [u8; 8]) -> u64 {
        let mut v: u64 = 0;
        let mut i = 8;
        while i > 0 { i -= 1; v = (v << 8) | bytes[i] as u64; }
        v as u64
    }
    pub fn next_power_of_two(self) -> u64 {
        let mut p: u64 = 1;
        while p < self { p = p << 1; }
        p
    }
    pub fn abs_diff(self, other: u64) -> u64 { if self > other { self - other } else { other - self } }
}

