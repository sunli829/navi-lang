                    Ok(mag as i64)
                }
            }
            None => Err(ParseIntError),
        }
    }
    pub fn to_le_bytes(self) -> [u8; 8] {
        let mut out = [0u8; 8];
        let v = self as u64;
        let mut i = 0;
        while i < 8 { out[i] = ((v >> (8 * i as u32)) & 255) as u8; i += 1; }
        out
    }
    pub fn from_le_bytes(bytes: [u8; 8]) -> i64 {
        let mut v: u64 = 0;
        let mut i = 8;
        while i > 0 { i -= 1; v = (v << 8) | bytes[i] as u64; }
        v as i64
    }
    pub fn abs(self) -> i64 { if self < 0 { -self } else { self } }
    pub fn wrapping_abs(self) -> i64 { if self < 0 { self.wrapping_neg() } else { self } }
    pub fn unsigned_abs(self) -> u64 { if self < 0 { (self as u64).wrapping_neg() } else { self as u64 } }
    pub fn signum(self) -> i64 { if self < 0 { -1 } else if self > 0 { 1 } else { 0 } }
    pub fn is_negative(self) -> bool { self < 0 }
    pub fn is_positive(self) -> bool { self > 0 }
}

impl isize {
    pub const MIN: isize = -9223372036854775807 - 1;
    pub const MAX: isize = 9223372036854775807;
    pub const BITS: u32 = 64;

    pub fn wrapping_add(self, rhs: isize) -> isize { crate::intrinsics::wrapping_add(self, rhs) }
    pub fn wrapping_sub(self, rhs: isize) -> isize { crate::intrinsics::wrapping_sub(self, rhs) }
    pub fn wrapping_mul(self, rhs: isize) -> isize { crate::intrinsics::wrapping_mul(self, rhs) }
    pub fn wrapping_neg(self) -> isize { crate::intrinsics::wrapping_sub(0, self) }
    pub fn overflowing_add(self, rhs: isize) -> (isize, bool) { let r = self.wrapping_add(rhs); (r, (rhs > 0 && r < self) || (rhs < 0 && r > self)) }
    pub fn overflowing_sub(self, rhs: isize) -> (isize, bool) { let r = self.wrapping_sub(rhs); (r, (rhs > 0 && r > self) || (rhs < 0 && r < self)) }
    pub fn overflowing_mul(self, rhs: isize) -> (isize, bool) {
        let r = self.wrapping_mul(rhs);
        (r, self != 0 && (r.wrapping_div_exact(self) != rhs || self == -1 && rhs == isize::MIN))
    }
    fn wrapping_div_exact(self, rhs: isize) -> isize { if self == isize::MIN && rhs == -1 { self } else { self / rhs } }
    pub fn checked_add(self, rhs: isize) -> Option<isize> { let (r, o) = self.overflowing_add(rhs); if o { None } else { Some(r) } }
    pub fn checked_sub(self, rhs: isize) -> Option<isize> { let (r, o) = self.overflowing_sub(rhs); if o { None } else { Some(r) } }
    pub fn checked_mul(self, rhs: isize) -> Option<isize> { let (r, o) = self.overflowing_mul(rhs); if o { None } else { Some(r) } }
    pub fn checked_div(self, rhs: isize) -> Option<isize> { if rhs == 0 || self == isize::MIN && rhs == -1 { None } else { Some(self / rhs) } }
    pub fn checked_rem(self, rhs: isize) -> Option<isize> { if rhs == 0 || self == isize::MIN && rhs == -1 { None } else { Some(self % rhs) } }
    pub fn saturating_add(self, rhs: isize) -> isize {
        match self.checked_add(rhs) { Some(r) => r, None => if rhs < 0 { isize::MIN } else { isize::MAX } }
    }
    pub fn saturating_sub(self, rhs: isize) -> isize {
        match self.checked_sub(rhs) { Some(r) => r, None => if rhs > 0 { isize::MIN } else { isize::MAX } }
    }
    pub fn saturating_mul(self, rhs: isize) -> isize {
        match self.checked_mul(rhs) { Some(r) => r, None => if (self < 0) != (rhs < 0) { isize::MIN } else { isize::MAX } }
    }
    pub fn pow(self, exp: u32) -> isize {
        if exp == 0 { return 1; }
        let mut base = self;
        let mut acc: isize = 1;
        let mut e = exp;
        loop {
            if e & 1 == 1 {
                acc = acc * base;
                if e == 1 { return acc; }
            }
            e = e / 2;
            base = base * base;
        }
    }
    pub fn wrapping_pow(self, exp: u32) -> isize {
        let mut base = self;
        let mut acc: isize = 1;
        let mut e = exp;
        while e > 0 {
            if e & 1 == 1 { acc = acc.wrapping_mul(base); }
            e = e / 2;
            base = base.wrapping_mul(base);
        }
        acc
    }
    pub fn count_ones(self) -> u32 {
        let mut v = self as usize;
        let mut n = 0u32;
        while v != 0 { n += (v & 1) as u32; v = v >> 1; }
        n
    }
    pub fn count_zeros(self) -> u32 { 64 - self.count_ones() }
    pub fn leading_zeros(self) -> u32 {
        let v = self as usize;
        let mut n = 0u32;
        while n < 64 && (v >> (64 - 1 - n)) & 1 == 0 { n += 1; }
        n
    }
    pub fn trailing_zeros(self) -> u32 {
        let v = self as usize;
        let mut n = 0u32;
        while n < 64 && (v >> n) & 1 == 0 { n += 1; }
        n
    }
    pub fn rotate_left(self, n: u32) -> isize {
        let v = self as usize;
        let k = n % 64;
        if k == 0 { return self; }
        ((v << k) | (v >> (64 - k))) as isize
    }
    pub fn rotate_right(self, n: u32) -> isize {
        let k = n % 64;
        if k == 0 { return self; }
        self.rotate_left(64 - k)
    }
    pub fn is_power_of_two(self) -> bool { self > 0 && self.count_ones() == 1 }
    pub fn from_str_radix(src: &str, radix: u32) -> Result<isize, ParseIntError> {
        match crate::str::parse_radix(src, radix, true) {
            Some((neg, mag)) => {
                let max = isize::MAX as u64;
                if neg {
                    if mag > max + 1 { return Err(ParseIntError); }
                    Ok((0u64.wrapping_sub(mag)) as isize)
                } else {
                    if mag > max { return Err(ParseIntError); }
                    Ok(mag as isize)
                }
            }
            None => Err(ParseIntError),
        }
    }
    pub fn to_le_bytes(self) -> [u8; 8] {
        let mut out = [0u8; 8];
        let v = self as usize;
        let mut i = 0;
        while i < 8 { out[i] = ((v >> (8 * i as u32)) & 255) as u8; i += 1; }
        out
    }
    pub fn from_le_bytes(bytes: [u8; 8]) -> isize {
        let mut v: usize = 0;
        let mut i = 8;
        while i > 0 { i -= 1; v = (v << 8) | bytes[i] as usize; }
        v as isize
    }
    pub fn abs(self) -> isize { if self < 0 { -self } else { self } }
    pub fn wrapping_abs(self) -> isize { if self < 0 { self.wrapping_neg() } else { self } }
    pub fn unsigned_abs(self) -> usize { if self < 0 { (self as usize).wrapping_neg() } else { self as usize } }
    pub fn signum(self) -> isize { if self < 0 { -1 } else if self > 0 { 1 } else { 0 } }
    pub fn is_negative(self) -> bool { self < 0 }
    pub fn is_positive(self) -> bool { self > 0 }
}

