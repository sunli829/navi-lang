//! Green threads with Rust's std::thread API. A panic in any thread ends the
//! whole process (see spec/std-diff.md).

pub type Result<T> = crate::result::Result<T, JoinError>;

#[derive(Debug)]
pub struct JoinError;

pub struct JoinHandle<T> {
    state: &mut JoinState<T>,
}

struct JoinState<T> {
    result: Option<T>,
}

impl<T> JoinHandle<T> {
    pub fn join(self) -> Result<T> { todo() }
    pub fn is_finished(&self) -> bool { todo() }
}

pub fn spawn<T>(f: fn() -> T) -> JoinHandle<T> { todo() }

pub fn yield_now() { todo() }
