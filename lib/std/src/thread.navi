//! Threads, with the API of Rust's `std::thread`.
//!
//! navi's threads are green threads (M:N scheduling): [`spawn`] starts a thread
//! that the runtime's scheduler runs on a few OS threads (as many as
//! [`available_parallelism`] returns). Threads are cheap, and a thread that
//! waits (on a channel, a lock, [`sleep`] or I/O) parks only itself: its OS
//! thread runs other threads meanwhile.
//!
//! A panic ends only the thread it happens in: [`JoinHandle::join`] returns it
//! as `Err`, a [`PanicPayload`](crate::panic::PanicPayload) holding the
//! message.
//!
//! The function given to [`spawn`] captures variables by reference (there is no
//! `move`), and threads share data through plain references `&T` where Rust
//! uses `Arc<T>`. Synchronize them with the types of [`crate::sync`]: channels,
//! [`Mutex`](crate::sync::Mutex), atomics.
//!
//! # Examples
//!
//! ```
//! use std::{
//!     sync::atomic::{AtomicUsize, Ordering},
//!     thread,
//! };
//!
//! let total = &AtomicUsize::new(0);
//! let mut handles = Vec::new();
//! for i in 1..=4 {
//!     handles.push(thread::spawn(|| {
//!         total.fetch_add(i, Ordering::SeqCst);
//!     }));
//! }
//! for h in handles {
//!     h.join().unwrap();
//! }
//! assert_eq(total.load(Ordering::SeqCst), 10);
//! ```

/// A specialized [`Result`](crate::result::Result) type for threads: the `Err`
/// of [`JoinHandle::join`] is the [`PanicPayload`](crate::panic::PanicPayload)
/// of the panic that ended the thread.
///
/// Rust's error type is `Box<dyn Any + Send>`; navi's payload has the panic's
/// message and location.
pub type Result<T> = crate::result::Result<T, crate::panic::PanicPayload>;

/// An owned permission to join on a thread (wait for it to finish and take its
/// result).
///
/// A `JoinHandle` is returned by [`spawn`]. Not joining a thread does not stop
/// it: it keeps running, detached.
///
/// # Examples
///
/// ```
/// use std::thread;
///
/// let handle: thread::JoinHandle<i32> = thread::spawn(|| 6 * 7);
/// assert_eq(handle.join().unwrap(), 42);
/// ```
pub struct JoinHandle<T> {
    h: *mut u8,
    result: Option<T>,
}

impl<T> JoinHandle<T> {
    /// Waits for the associated thread to finish and returns its result.
    ///
    /// While it waits, the calling green thread is parked: its OS thread runs
    /// other threads.
    ///
    /// # Errors
    ///
    /// If the thread panicked, returns `Err` with the panic's
    /// [`PanicPayload`](crate::panic::PanicPayload) (its message and location).
    ///
    /// # Examples
    ///
    /// ```
    /// use std::thread;
    ///
    /// let ok = thread::spawn(|| String::from("done"));
    /// assert_eq(ok.join().unwrap(), "done");
    ///
    /// let failed = thread::spawn(|| -> i32 { panic("thread failed") });
    /// let payload = failed.join().unwrap_err();
    /// assert_eq(payload.message(), "thread failed");
    /// ```
    pub fn join(self) -> Result<T> {
        crate::rt::join::<Result<T>>(self.h)
    }
}

/// Spawns a new thread, returning a [`JoinHandle`] for it.
///
/// The new thread is a green thread that runs `f`; the join handle gives its
/// return value (or its panic) to [`JoinHandle::join`]. Unlike Rust's, the
/// function captures the variables it uses by reference (there is no `move`,
/// and no `'static` or `Send` bound): the spawning thread can share a `&T` with
/// it, and must synchronize their accesses (with a
/// [`Mutex`](crate::sync::Mutex), a channel or atomics) when one of them
/// writes.
///
/// # Examples
///
/// ```
/// use std::{sync::mpmc::channel, thread};
///
/// let (tx, rx) = channel();
/// let handle = thread::spawn(|| {
///     for i in 0..3 {
///         tx.send(i).unwrap();
///     }
///     tx.close();
///     "sent"
/// });
/// let got: Vec<i32> = rx.iter().collect();
/// assert_eq(got, Vec::from([0, 1, 2]));
/// assert_eq(handle.join().unwrap(), "sent");
/// ```
pub fn spawn<T>(f: fn() -> T) -> JoinHandle<T> {
    JoinHandle {
        h: crate::rt::spawn(|| crate::panic::catch_unwind(f)),
        result: None,
    }
}

/// Cooperatively gives up a timeslice to the scheduler.
///
/// The current green thread lets other threads that are ready to run take a
/// turn on its OS thread before it continues.
///
/// # Examples
///
/// ```
/// use std::thread;
///
/// thread::yield_now();
/// ```
pub fn yield_now() {
    crate::rt::yield_now();
}

/// A unique identifier for a running thread.
///
/// Obtained with [`Thread::id`]; ids are not reused while the program runs.
///
/// # Examples
///
/// ```
/// use std::thread;
///
/// let main_id = thread::current().id();
/// let other_id = thread::spawn(|| thread::current().id()).join().unwrap();
/// assert_ne(main_id, other_id);
/// assert_eq(main_id, thread::current().id());
/// ```
#[derive(Clone, PartialEq, Eq, Debug, Hash)]
pub struct ThreadId(u64);

impl ThreadId {
    /// Returns the id as a number, never 0.
    ///
    /// Rust's (unstable) `as_u64` returns a `NonZero<u64>`.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::thread;
    ///
    /// let id = thread::current().id();
    /// assert_ne(id.as_u64(), 0);
    /// ```
    pub fn as_u64(&self) -> u64 {
        self.0
    }
}

/// A handle to a thread, as returned by [`current`].
///
/// In this version it holds only the thread's [`ThreadId`]: Rust's `Thread`
/// also has a name and `unpark`.
///
/// # Examples
///
/// ```
/// use std::thread;
///
/// let t = thread::current();
/// assert_eq(t.id(), thread::current().id());
/// ```
pub struct Thread {
    id: ThreadId,
}

impl Thread {
    /// Gets the thread's unique identifier.
    ///
    /// # Examples
    ///
    /// ```
    /// use std::thread;
    ///
    /// let other = thread::spawn(|| thread::current().id());
    /// let other_id = other.join().unwrap();
    /// assert_ne(thread::current().id(), other_id);
    /// ```
    pub fn id(&self) -> ThreadId {
        self.id.clone()
    }
}

/// Gets a handle to the thread that invokes it.
///
/// # Examples
///
/// ```
/// use std::thread;
///
/// let id = thread::current().id();
/// assert_eq(id, thread::current().id());
/// ```
pub fn current() -> Thread {
    Thread {
        id: ThreadId(crate::rt::sched::current_id()),
    }
}

/// Returns an estimate of the amount of parallelism a program should use: how
/// many threads can run at once.
///
/// This is the number of OS threads the scheduler runs green threads on: the
/// `NAVI_MAXPROCS` environment variable if it is set, otherwise the number of
/// CPUs (as Go's `GOMAXPROCS`). Rust's returns a `NonZero<usize>`; this one is
/// at least 1.
///
/// # Errors
///
/// It does not fail in this version; the `Result` is there for compatibility
/// with Rust.
///
/// # Examples
///
/// ```
/// use std::thread;
///
/// fn main() -> std::io::Result<()> {
///     let n = thread::available_parallelism()?;
///     assert(n >= 1);
///     Ok(())
/// }
/// ```
pub fn available_parallelism() -> crate::io::Result<usize> {
    Ok(crate::rt::sched::procs())
}

/// Returns the number of CPUs, whatever `NAVI_MAXPROCS` says.
///
/// This is Go's `runtime.NumCPU` (Rust's std has no such function): use it to
/// size work across processes, each of which runs [`available_parallelism`]
/// threads at once.
///
/// # Examples
///
/// ```
/// use std::thread;
///
/// assert(thread::cpu_count() >= 1);
/// ```
pub fn cpu_count() -> usize {
    crate::rt::sched::cpus()
}

/// Puts the current thread to sleep for at least the specified amount of time.
///
/// The thread may sleep longer than `d`, never less. It is a green thread: its
/// OS thread runs other threads meanwhile.
///
/// # Examples
///
/// ```
/// use std::{
///     thread,
///     time::{Duration, Instant},
/// };
///
/// let start = Instant::now();
/// thread::sleep(Duration::from_millis(10));
/// assert(start.elapsed() >= Duration::from_millis(10));
/// ```
pub fn sleep(d: crate::time::Duration) {
    crate::rt::sched::sleep_ns(d.as_nanos() as u64);
}

/// Puts the current thread to sleep until the specified deadline has passed.
///
/// Returns at once if the deadline is now or in the past. As with [`sleep`],
/// the thread may sleep longer than asked, never less.
///
/// # Examples
///
/// ```
/// use std::{
///     thread,
///     time::{Duration, Instant},
/// };
///
/// let deadline = Instant::now() + Duration::from_millis(10);
/// thread::sleep_until(deadline);
/// assert(Instant::now() >= deadline);
/// ```
pub fn sleep_until(deadline: crate::time::Instant) {
    let now = crate::time::Instant::now();
    if deadline > now {
        sleep(deadline.duration_since(now));
    }
}
