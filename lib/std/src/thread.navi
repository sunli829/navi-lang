//! Green threads with Rust's std::thread API. A panic in any thread ends the
//! whole process (see spec/std-diff.md).

pub type Result<T> = crate::result::Result<T, JoinError>;

#[derive(Debug)]
pub struct JoinError;

pub struct JoinHandle<T> {
    h: *mut u8,
    result: Option<T>,
}

impl<T> JoinHandle<T> {
    /// Waits for the thread to finish and returns its result.
    pub fn join(self) -> Result<T> { Ok(crate::rt::join::<T>(self.h)) }
}

/// Starts a green thread running f.
pub fn spawn<T>(f: fn() -> T) -> JoinHandle<T> {
    JoinHandle { h: crate::rt::spawn(f), result: None }
}

pub fn yield_now() { crate::rt::yield_now(); }
