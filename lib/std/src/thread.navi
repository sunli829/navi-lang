//! Green threads with Rust's std::thread API. A panic ends its thread;
//! join() returns it as Err (the payload holds the message).

pub type Result<T> = crate::result::Result<T, crate::panic::PanicPayload>;

pub struct JoinHandle<T> {
    h: *mut u8,
    result: Option<T>,
}

impl<T> JoinHandle<T> {
    /// Waits for the thread to finish and returns its result.
    pub fn join(self) -> Result<T> { crate::rt::join::<Result<T>>(self.h) }
}

/// Starts a green thread running f.
pub fn spawn<T>(f: fn() -> T) -> JoinHandle<T> {
    JoinHandle { h: crate::rt::spawn(|| crate::panic::catch_unwind(f)), result: None }
}

pub fn yield_now() { crate::rt::yield_now(); }
