//! Green threads with Rust's std::thread API. A panic ends its thread;
//! join() returns it as Err (the payload holds the message).

pub type Result<T> = crate::result::Result<T, crate::panic::PanicPayload>;

pub struct JoinHandle<T> {
    h: *mut u8,
    result: Option<T>,
}

impl<T> JoinHandle<T> {
    /// Waits for the thread to finish and returns its result.
    pub fn join(self) -> Result<T> { crate::rt::join::<Result<T>>(self.h) }
}

/// Starts a green thread running f.
pub fn spawn<T>(f: fn() -> T) -> JoinHandle<T> {
    JoinHandle { h: crate::rt::spawn(|| crate::panic::catch_unwind(f)), result: None }
}

pub fn yield_now() { crate::rt::yield_now(); }

/// A thread's identity (unique while the program runs).
#[derive(Clone, PartialEq, Eq, Debug, Hash)]
pub struct ThreadId(u64);

impl ThreadId {
    /// The id as a number, never 0 (Rust's, unstable, returns NonZero<u64>).
    pub fn as_u64(&self) -> u64 { self.0 }
}

/// A handle on a thread (only its id in this version).
pub struct Thread {
    id: ThreadId,
}

impl Thread {
    pub fn id(&self) -> ThreadId { self.id.clone() }
}

/// The running thread.
pub fn current() -> Thread { Thread { id: ThreadId(crate::rt::sched::current_id()) } }

/// How many threads can run at once: the OS threads the scheduler uses
/// (NAVI_MAXPROCS, else the number of CPUs). Rust
/// returns NonZero<usize>.
pub fn available_parallelism() -> crate::io::Result<usize> { Ok(crate::rt::sched::procs()) }

/// The number of CPUs, whatever NAVI_MAXPROCS says (as Go's
/// runtime.NumCPU; not in Rust's std): for sizing work across processes,
/// each of which runs available_parallelism() threads.
pub fn cpu_count() -> usize { crate::rt::sched::cpus() }

/// Parks the current thread for at least d (a green thread: its OS thread
/// runs others meanwhile).
pub fn sleep(d: crate::time::Duration) { crate::rt::sched::sleep_ns(d.as_nanos() as u64); }

/// Parks the current thread until deadline.
pub fn sleep_until(deadline: crate::time::Instant) {
    let now = crate::time::Instant::now();
    if deadline > now { sleep(deadline.duration_since(now)); }
}

