//! The [`Clone`] trait for types that can make an independent copy of
//! themselves.
//!
//! Assignment in navi is always a shallow copy (as in Go): there is no move,
//! and no `Copy` trait. For plain values (numbers, structs of numbers) the
//! copy is already independent; collections such as [`Vec`] and
//! [`String`] are handles to a shared container, so a copy shares the
//! container. [`Clone::clone`] makes a deep, independent copy.
//!
//! # Examples
//!
//! ```
//! let a = Vec::from([1, 2, 3]);
//! let b = a; // b shares a's buffer
//! let mut c = a.clone(); // c is a new vector
//! c.push(4);
//! assert_eq(b.len(), 3);
//! assert_eq(c.len(), 4);
//! ```

/// A common trait for the ability to explicitly duplicate an object.
///
/// `clone` makes an independent copy of a value: changing the copy does not
/// change the original. For collections it creates a new container with
/// clones of the elements.
///
/// Calling `.clone()` on a reference `&T` or `&mut T` clones the referenced
/// `T` (as in Rust); to copy the reference itself, assign it.
///
/// `Clone` can be derived with `#[derive(Clone)]`, which clones each field.
///
/// # Examples
///
/// ```
/// #[derive(Clone, Debug, PartialEq)]
/// struct Stack {
///     items: Vec<i32>,
/// }
///
/// let a = Stack {
///     items: Vec::from([1, 2]),
/// };
/// let mut b = a.clone();
/// b.items.push(3);
/// assert_eq(a.items.len(), 2);
/// assert_eq(b.items.len(), 3);
/// ```
pub trait Clone {
    /// Returns a copy of the value.
    ///
    /// # Examples
    ///
    /// ```
    /// let hello = "Hello".to_string();
    /// assert_eq(hello.clone(), "Hello");
    /// ```
    fn clone(&self) -> Self;
}
